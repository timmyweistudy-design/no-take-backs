extends "res://scripts/ui/battle_view.gd"
## 兵種圖鑑（第二輪方案 R3）：五個兵種的故事、擅長／怕什麼、技能說明（數值取自 unit_defs），
## 每個技能有一段用「真的戰鬥模擬」跑的小劇場；派該兵種贏 5 場解鎖老兵觀察筆記。
## 入口：標題選單、擺放時兵種卡右上角的「?」（手把 Select）、結果頁右上角。

const CX = preload("res://scripts/game/codex.gd")

const CX_PANEL := Rect2(180, 96, 920, 628)
const CX_BOX := Rect2(596, 318, 474, 267)     # 小劇場畫面
const CX_VIEW := Rect2(2000, 1100, 12000, 6760)   # 小劇場看的戰場範圍（模擬座標，千分之一格）：中間 12×6.76 格，兵才夠大
const CX_PAUSE := 1.2
const CX_LEFT := Rect2(204, 204, 376, 388)     # 左欄可捲動區
const CX_DESC := Rect2(596, 256, 474, 58)      # 技能說明可捲動區                          # 一段示範結束後停多久再重播（秒）

var cx_unit := 0
var cx_skill := 0
var cx_sim = null
var cx_acc := 0.0
var cx_ticks := 0
var cx_wait := 0.0
var cx_prev := {}
var cx_atk := {}
var cx_hurt := {}
var cx_pops: Array = []        # 技能觸發時跳出的字：{p, s, t}
var cx_seen := false
var cx_scroll := {"left": 0.0, "desc": 0.0, "note": 0.0}   # 各捲動區的位移
var cx_content := {"left": 0.0, "desc": 0.0, "note": 0.0}  # 各捲動區的內容高度（上一幀量到的）
var cx_regions := {}                                         # 名稱 → 畫面上的矩形（滾輪判斷用）           # 這一輪示範有沒有出現預期的技能


func _open_codex(t: int) -> void:
	# 開圖鑑前取消擺放畫面的拖曳／塗兵狀態，不然關掉圖鑑後移動滑鼠會繼續放兵（Codex R3 審查 #3）
	painting = false
	drag_new = false
	drag_from = Vector2i(-1, -1)
	cx_unit = clampi(t, 0, D.total() - 1)
	cx_scroll["left"] = 0.0   # 每次打開都從頂端開始（Antigravity：沿用上次捲到底的位置，看起來像數值條不見了）
	cx_scroll["note"] = 0.0
	_cx_pick_skill(0)
	_open("codex")


func _cx_skills() -> Array:
	return CX.unit(cx_unit).get("skills", [])


func _cx_pick_unit(t: int) -> void:
	cx_unit = t
	cx_scroll["left"] = 0.0
	cx_scroll["note"] = 0.0
	_cx_pick_skill(0)


func _cx_pick_skill(i: int) -> void:
	cx_scroll["desc"] = 0.0
	cx_skill = clampi(i, 0, maxi(0, _cx_skills().size() - 1))
	_cx_restart()


func _cx_restart() -> void:
	var sks := _cx_skills()
	cx_sim = CX.demo_sim(sks[cx_skill]) if not sks.is_empty() else null
	cx_acc = 0.0
	cx_ticks = 0
	cx_wait = 0.0
extends Node
## 角色精靈圖快取（第二輪方案 R2、H；第八輪改分頁）：實測 48 隻時每幀直接程式繪製要 34ms（約 15fps），
## 所以用同一份 Art.unit 畫法，把兵種×隊伍×動作影格畫進圖集，戰鬥中只貼圖。
## 第八輪：一張大圖放 22 種會到 3072×11712，Compatibility 渲染器超過 4096 有風險。改成每頁 ≤4096（7 種兵），
## 開場只烘舊 10 種，新兵上場才烘；還沒烘好時呼叫端直接畫，不會缺圖。頁數有上限，超過丟最舊的新兵頁。
## 用同一份畫法烘焙，但不是逐像素等價（Codex R1 審查 #3、#4，已知且接受的差異）：
##  - 走路量化成 6 格、攻擊 8 格；攻擊中不再疊走路相位；走路／攻擊格固定睜眼（只在待機眨眼）。
## 表情疊加（受擊、暈眩、衝鋒、狂熱、潛行、頂住）不烘焙，貼完圖再用 Art.overlay 在同一個局部座標畫上去。
##  - 透明度（潛行）是對整張合成好的角色乘 alpha，重疊的部位不會像逐圖元那樣透出底下的線條。
## 待機呼吸位移在貼圖時加（烘焙時抵銷為 0）；受擊閃白跟著攻擊前衝與走路起伏。
## 沒有畫面（headless）或還沒建好時，呼叫端退回 Art.unit。

const Art = preload("res://scripts/ui/art.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const Gait = preload("res://scripts/ui/units/gait.gd")
const Save = preload("res://scripts/game/save.gd")

const CELL := 192          # 每格像素（以 RS 倍率畫）；比角色大一圈，避免相鄰格子滲色
const RS := 1.6            # 烘焙解析度倍率
const ORIGIN := Vector2(78, 160)   # 角色腳底在格子裡的位置（第七輪 C0：原本會超框被切掉）
const RING_ORIGIN := Vector2(96, 140)   # 腳底圈格子的中心（有影子，要留下方空間）
const WALK_FRAMES := 8     # V9 P2：6→8，另加拖行、暈眩
const POSE_FRAMES := 2
const ATK_FRAMES := 8      # 三段式攻擊（R5）要多幾格才看得出前搖／揮擊／後搖
# 每個兵種、隊伍的影格順序：0 待機、1 眨眼、2..7 走路、8..23 攻擊兩組（一般／交替或專屬）
const FRAMES_PER := 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * 2
const COLS := 16
const TYPES_PER_PAGE := 6  # 6×2×28＝336 格＝21 列×192＝4032px，不超過 4096
const MAX_PAGES := 5

var pages: Array = []      # 每頁 {tex, types}
var loc := {}              # 兵種 → [頁, 這一種在頁裡的起始格]
var ring_tex: Texture2D = null
var ready_cb := -1         # 這份快取是用哪種配色（一般／色盲）烘焙的
var _busy := false
var _gen := 0   # V1.2：每次 build（換色）加一；烘到一半世代變了就作廢（Codex v120-impl2：連切色盲的競態）
var _queue: Array = []
var _baking: Array = []

func is_ready(cb: bool) -> bool:
	return ring_tex != null and ready_cb == (1 if cb else 0)

func has_type(t: int) -> bool:
	return loc.has(t)

## 腳底在格子裡的位置：往前伸得很長的長槍兵靠左、很寬的小石魔靠右，其他都一樣。
static func origin_of(type: int) -> Vector2:
	return Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160))

## 全部清掉，烘舊 10 種和腳底圈。
func build(cb: bool) -> void:
	if DisplayServer.get_name() == "headless":
		return
	_gen += 1
	pages.clear()
	loc.clear()
	_queue.clear()
	_baking = []
	_busy = false
	ring_tex = null
	ready_cb = 1 if cb else 0
	var base: Array = []
	for t in D.COUNT:
		base.append(t)
	await _bake_ring(cb)
	await ensure(base)

## 這場要用到的兵種。缺的才烘；烘的時候呼叫端先直接畫。
func ensure(types: Array) -> void:
	if DisplayServer.get_name() == "headless" or ready_cb < 0:
		return
	for t in types:
		if not loc.has(t) and not t in _queue and not t in _baking:
			_queue.append(t)
	if _busy or _queue.is_empty():
		return
	_busy = true
	while not _queue.is_empty():
		var chunk: Array = _queue.slice(0, TYPES_PER_PAGE)
		_queue = _queue.slice(chunk.size())
	await get_tree().process_frame
	await get_tree().process_frame
	await RenderingServer.frame_post_draw
	var err := get_viewport().get_texture().get_image().save_png(capsule_path)
	if err != OK:
		printerr("CAPSULE 存檔失敗 ", capsule_path, " err=", err)
		get_tree().quit(1)
		return
	print("CAPSULE ", capsule_path)
	get_tree().quit()


# ───────────────────────── 截圖（驗證用） ─────────────────────────
## 版面檢查（第三輪 T4）：這張截圖的介面文字有沒有越界、小於 9px（Steam Deck 下限）、彼此重疊超過 15%。
## 第五輪 U4：新規則全部算違規——表外字級、小於字級表下限、戰場字小於 14、相同字串在不同位置重疊、點擊框小於 32px、
## 「要讀的文字」段數超過上限（控制項＝按鈕、兵卡裡的字不算）。
const TEXT_BUDGET := {"02_place.png": 30, "17_place_new.png": 30, "05_result.png": 20, "10_codex.png": 30, "19_codex_new.png": 30,
	"22_lobby.png": 25, "25_lobby_duel.png": 25, "08_settings.png": 25, "01_title.png": 12}

func _layout_report(name: String) -> void:
	var bad: Array = []
	for b in _btns:     # 第十輪 T5：按鈕不能跑出畫面（手把焦點會走到看不見的地方）
		if not Rect2(0, 0, 1280, 800).encloses(b["r"]):
			bad.append({"type": "按鈕超出畫面", "s": name, "r": str(b["r"])})
	var sizes: Array = []
	var ui_n := 0
	var free_n := 0
	var ctrls: Array = probe_btns + probe_ctrls
	for t in probe_texts:
		var r: Rect2 = t["r"]
		var sz := int(t["size"])
		if t.get("field", false):
			if sz < 14:
				bad.append({"type": "戰場字太小", "s": t["s"], "size": sz})
			if r.position.x < -2 or r.end.x > 1282 or r.position.y < -2 or r.end.y > 802:
				bad.append({"type": "戰場字越界", "s": t["s"], "r": str(r)})
			continue
		ui_n += 1
		sizes.append(sz)
		var in_ctrl: bool = t.get("btn", false)
		for c in probe_ctrls:
			if c.grow(1.0).encloses(r):
				in_ctrl = true   # 整段字都在卡片／空白標籤按鈕裡＝控制項內容
				break
		if not in_ctrl:
			free_n += 1
		if r.position.x < -2 or r.end.x > 1282 or r.position.y < -2 or r.end.y > 802:
			bad.append({"type": "越界", "s": t["s"], "r": str(r)})
		if sz < tz("C"):
			bad.append({"type": "小於字級表下限", "s": t["s"], "size": sz})
		if not size_ok(sz):
			bad.append({"type": "表外字級", "s": t["s"], "size": sz})
	for a in probe_texts.size():
		if probe_texts[a].get("field", false):
			continue
		for b in range(a + 1, probe_texts.size()):
			if probe_texts[b].get("field", false):
				continue
			var ra: Rect2 = probe_texts[a]["r"]
			var rb: Rect2 = probe_texts[b]["r"]
			var x := ra.intersection(rb)
			if not x.has_area():
				continue
			var ratio := x.get_area() / maxf(1.0, minf(ra.get_area(), rb.get_area()))
			if ratio <= 0.15:
				continue
			if probe_texts[a]["s"] != probe_texts[b]["s"]:
				bad.append({"type": "重疊", "a": probe_texts[a]["s"], "b": probe_texts[b]["s"], "ratio": snappedf(ratio, 0.01)})
			elif ra.position.distance_to(rb.position) > 2.0:
				bad.append({"type": "相同字串重疊", "s": probe_texts[a]["s"], "ratio": snappedf(ratio, 0.01)})
	# 第七輪 I3：按鈕框互撞（重疊但不是一個包住另一個）
	for bi in probe_btns.size():
		for bj in range(bi + 1, probe_btns.size()):
			var r1: Rect2 = probe_btns[bi]
			var r2: Rect2 = probe_btns[bj]
			var inter := r1.intersection(r2)
			if inter.get_area() > 6.0 and not r1.encloses(r2) and not r2.encloses(r1):
				bad.append({"type": "按鈕互撞", "a": str(r1), "b": str(r2)})
	for r in probe_btns:
		if r.size.x < 36.0 or r.size.y < 36.0:   # 方案 §5.3：點擊框 ≥36px
			bad.append({"type": "點擊框太小", "r": str(r)})
	# 第五輪（Antigravity 實作第 1 輪抓到自動檢查漏的）：按鈕外的文字壓到按鈕上
	for t in probe_texts:
		if t.get("field", false):
			continue
		var tr: Rect2 = t["r"]
		if t.get("btn", false):
			# 按鈕標籤：只豁免它自己的按鈕；要完整落在自己的框內，也不能壓到別顆按鈕（Codex 實作第 2 輪）
			var own: Rect2 = t.get("own", Rect2())
			if own.has_area() and not own.grow(2.0).encloses(tr):
				bad.append({"type": "按鈕標籤超出按鈕", "s": t["s"], "btn": str(own)})
			for br2 in probe_btns:
				if br2 == own:
					continue
				var x3 := tr.intersection(br2)
				if x3.has_area() and x3.get_area() > tr.get_area() * 0.10:
					bad.append({"type": "按鈕標籤壓到別的按鈕", "s": t["s"], "btn": str(br2)})
					break
			continue
		var inside := false
		for c in probe_ctrls:
			if c.grow(1.0).encloses(tr):
				inside = true
				break
		if inside:
			continue
		for br in probe_btns:
			var x2 := tr.intersection(br)
			if x2.has_area() and x2.get_area() > tr.get_area() * 0.10:
				bad.append({"type": "文字壓到按鈕", "s": t["s"], "btn": str(br)})
				break
	if TEXT_BUDGET.has(name) and int(Save.s("text_scale")) == 100 and free_n > int(TEXT_BUDGET[name]):
		bad.append({"type": "文字段數超過上限", "n": free_n, "max": TEXT_BUDGET[name]})
	sizes.sort()
	var line := JSON.stringify({"shot": name, "lang": L.lang, "scale": int(Save.s("text_scale")), "texts": ui_n, "free_texts": free_n,
		"median_size": sizes[sizes.size() / 2] if not sizes.is_empty() else 0, "min_size": sizes[0] if not sizes.is_empty() else 0,

