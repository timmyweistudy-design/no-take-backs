   491	func _next_puzzle() -> void:
   492		var list: Array = PZ.tutorials() if mode == Mode.TUTORIAL else PZ.all_puzzles()   # 第十三輪：照章節順序接下一關
   493		for i in list.size():
   494			if list[i]["id"] == puzzle_id and i + 1 < list.size():
   495				var nx: Dictionary = list[i + 1]
   496				if nx.has("unit") and not RS.available(int(nx["unit"]), _demo()):
   497					break   # 試玩版沒有下一關的兵
   498				if _demo() and mode == Mode.PUZZLE and i + 1 >= Presets.DEMO_PUZZLES:
   499					break   # 試玩版只有第一章前幾關
   500				puzzle_id = nx["id"]
   501				_start_mode(mode)
   502				return
   503		if mode == Mode.TUTORIAL and not PZ.puzzles().is_empty():
   504			puzzle_id = PZ.puzzles()[0]["id"]
   505			_start_mode(Mode.PUZZLE)
   506			return
   507		_go_title()
