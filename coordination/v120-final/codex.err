   329	## 第五輪：數字用等寬（tnum），金幣、秒數、百分比跳動時不會左右晃。
   330	func _tnum(f: Font) -> Font:
   331		var fv := FontVariation.new()
   332		fv.base_font = f
   333		fv.opentype_features = {TextServerManager.get_primary_interface().name_to_tag("tnum"): 1}
   334		return fv
