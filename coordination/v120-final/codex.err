   319	## V1.2 A1：英數字型疊在中文字型上（中文缺字落到後備）。沒有英數字型檔時直接用中文字型。
   320	func _latin_over(path: String, cjk: Font) -> Font:
   321		if ResourceLoader.exists(path):
   322			var lf = load(path)
   323			if lf is FontFile:
   324				var f2: FontFile = lf.duplicate()
   325				f2.fallbacks = [cjk]
   326				return f2
   327		return _tnum(cjk)
