   166	func _draw_codex() -> void:
   167		_panel(CX_PANEL)
   168		var u := CX.unit(cx_unit)
   169		var lang := L.lang
   170		_h1(Vector2(640, 96), L.t("codex_title"), 600)
   171		# 兵種分頁
   172		# 第四輪 §4.7：一排 10 個「頭像＋數字」頁籤；兵種全名在下面左欄的大標題
   173		# 第八輪：頁籤分兩頁（王國軍／奇幻軍），各 10 種
   174		var page_new: bool = cx_unit >= D.COUNT
   175		_btn(Rect2(204, 104, 110, 38), L.t("lb_army_kingdom"), func(): _cx_pick_unit(0), true, false, TH_ACTIVE if not page_new else Color(0, 0, 0, 0))
   176		_btn(Rect2(320, 104, 110, 38), L.t("lb_army_fantasy"), func(): _cx_pick_unit(D.COUNT), true, false, TH_ACTIVE if page_new else Color(0, 0, 0, 0))
   177		var tw := (866.0 - (D.COUNT - 1) * 6.0) / D.COUNT
   178		for t0 in D.COUNT:
   179			var t: int = t0 + (D.COUNT if page_new else 0)
   180			var r := Rect2(204 + t0 * (tw + 6.0), 150, tw, 50)
   181			_btn(r, "", _cx_pick_unit.bind(t), true, false, TH_ACTIVE if t == cx_unit else Color(0, 0, 0, 0))
   182			if t == cx_unit:
   183				draw_rect(r.grow(1.0), ACCENT, false, 3.0)   # 第七輪 E9：選中的兵種金框
   184			_unit_in(r, t, 0, 1.0, 0.6 if t != D.CAVALRY else 0.55)   # 人物在頁籤正中間（原本腳畫到框外）
   185			_text(r.position + Vector2(4, 2), str((t0 + 1) % 10), tcap(ts(12), 14), Color(1, 1, 1, 0.7), false, true)
   186		# 左欄（第三輪 U1）：可捲動區，字級＝基準×設定（150% 時正文 24px），不再縮字
   187		# 大頭照＋名字固定在上面，只有下面的屬性與文字捲動（Antigravity S3：捲動時大頭照整張消失像破圖）
   188		var items := _cx_left_items(u, lang)
   189		# 固定區的高度依名字、定位、口號實際換行後的高度決定（Antigravity S3 第 2 輪：英文 150% 口號被切）
   190		var head_h := 160.0
   191		var ty := 4.0
   192		for tx in items[0]["texts"]:
   193			ty += (_wrap(tx["s"], tx["size"], CX_LEFT.size.x - 168).count("\n") + 1) * tx["size"] * 1.3 + 3.0
   194		head_h = clampf(maxf(head_h, ty + 8.0), 160.0, 260.0)
   195		# V1.2 C2：左欄是一張羊皮紙卡，字用墨色
   196		if not bool(Save.s("plain_ui")):
   197			_tex_box(CX_LEFT.grow_individual(8, 0, 8, 8), "paper")   # 上緣和頁籤留空（Antigravity impl3）
   198			_ink_mode = true
   199		_scroll_draw("head", Rect2(CX_LEFT.position, Vector2(CX_LEFT.size.x, head_h)), [items[0]], false)
   200		draw_line(Vector2(CX_LEFT.position.x, CX_LEFT.position.y + head_h - 2), Vector2(CX_LEFT.end.x, CX_LEFT.position.y + head_h - 2), Color(INK, 0.25) if _ink_mode else Color(1, 1, 1, 0.12), 1.0)
   201		_scroll_draw("left", Rect2(CX_LEFT.position + Vector2(0, head_h + 4), CX_LEFT.size - Vector2(0, head_h + 4)), items.slice(1))
   202		_ink_mode = false
   203		# 右欄：技能分頁、說明、小劇場
   204		var sks := _cx_skills()
   205		var bw := (CX_BOX.size.x - (sks.size() - 1) * 8) / maxf(1.0, sks.size())
   206		for i in sks.size():
   207			var sd := CX.skill(sks[i])
   208			_btn(Rect2(CX_BOX.position.x + i * (bw + 8), 212, bw, 38), CX.text(sd, "", lang), _cx_pick_skill.bind(i), true, false,
   209				Color(0.45, 0.3, 0.12) if i == cx_skill else Color(0, 0, 0, 0))
   210		if not sks.is_empty():
   211			var desc := CX.skill_desc(sks[cx_skill], lang)
   212			_scroll_draw("desc", CX_DESC, [{"type": "text", "s": desc, "size": ts(15), "c": Color(1, 1, 1, 0.92), "x": 0.0, "w": CX_DESC.size.x - 12}])
   213		_draw_codex_demo()
   214		# 老兵觀察筆記
   215		var nr := Rect2(204, 600, 866, 66)
   216		draw_rect(nr, Color(0.2, 0.17, 0.1, 0.85))
   217		draw_rect(nr, Color(ACCENT, 0.35), false, 1.5)
   218		_text(nr.position + Vector2(12, 4), L.t("codex_note"), ts(14), ACCENT, false, true, 400)
   219		var note := CX.text(u, "veteran", lang)   # 第十一輪：筆記直接看得到
   220		_scroll_draw("note", Rect2(nr.position + Vector2(12, 4 + ts(14) * 1.4), Vector2(nr.size.x - 20, nr.size.y - 8 - ts(14) * 1.4)),
   221			[{"type": "text", "s": note, "size": ts(14), "c": Color(1, 1, 1, 0.9), "x": 0.0, "w": nr.size.x - 40}])
   222		_btn(Rect2(560, 676, 160, 38), L.t("back"), func(): overlay = "")
