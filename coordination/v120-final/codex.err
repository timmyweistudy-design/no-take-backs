   653	## 地圖縮圖：貼上烘好的地面，full 時標出雙方部署區。
   654	func _map_thumb(r: Rect2, map_id: int, size: int, full := false) -> void:
   655		if map_art == null:
   656			_map_tex()
   657		var tex: Texture2D = null
   658		if map_id != 0 and map_art != null and map_art.is_inside_tree():
   659			tex = map_art.texture(map_id, size)
   660		var w := float(MapDefs.width(size))
   140					word += ch
   141			if word != "":
   142				tokens.append(word)
   143			for tk in tokens:
   144				if line != "" and font.get_string_size(line + tk, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x > width:
   145					out.append(line.strip_edges(false, true))
   146					line = tk.strip_edges(true, false) if tk == " " else tk
   147				else:
   148					line += tk
   149			out.append(line)
   150		return "\n".join(out)
   151	
   152	
   153	## 一組段落要放進 max_h 高度：從 size 開始縮，直到換行後的總高度放得下（段落間距 gap）。最小 10px。
   154	func _fit_block(texts: Array, size: int, width: float, max_h: float, gap: float) -> int:
   155		var sz := size
   156		while sz > 10:
   157			var h := 0.0
   158			for tx in texts:
   159				h += (_wrap(tx, sz, width).count("\n") + 1) * sz * 1.3 + gap
   160			if h - gap <= max_h:
   161				return sz
   162			sz -= 1
   163		return sz
