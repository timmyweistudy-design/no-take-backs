    35	## 中線對比長條：rows＝[{label, b, r}]；兵種名在中間，藍往左、紅往右，數字標在條尾。
    36	static func diverging(ui, rect: Rect2, rows: Array, mid_w := 110.0) -> void:
    37		var cb: bool = ui.cbm()
    38		var maxv := 1
    39		for row in rows:
    40			maxv = maxi(maxv, maxi(int(row["b"]), int(row["r"])))
    41		var n := maxi(1, rows.size())
    42		var rh := rect.size.y / n
    43		var half := (rect.size.x - mid_w) / 2.0
    44		var cx := rect.position.x + half
    45		var fs: int = ui.tz("S")
    46		for i in rows.size():
    47			var row: Dictionary = rows[i]
    48			var y := rect.position.y + i * rh
    49			var bh := minf(rh * 0.62, 22.0)
    50			var by := y + (rh - bh) / 2
    51			if row.has("type"):
    52				ui._unit_in(Rect2(cx, y, 28.0, rh), int(row["type"]), 0, 1.0, minf(0.42, rh / 80.0))   # 兵種頭像（V9）
    53			ui._text(Vector2(cx + mid_w / 2 + (12.0 if row.has("type") else 0.0), y + (rh - fs * 1.1) / 2), str(row["label"]), fs, Color.WHITE, true, false, mid_w - 6)
    54			var lb := half * float(row["b"]) / maxv
    55			var lr := half * float(row["r"]) / maxv
    56			ui.draw_rect(Rect2(cx - lb, by, lb, bh), team_col(0, cb))
    57			var rr := Rect2(cx + mid_w, by, lr, bh)
    58			ui.draw_rect(rr, team_col(1, cb))
    59			if cb:
    60				hatch(ui, rr, Color(0, 0, 0, 0.35))
    61			var vb := str(int(row["b"]))
    62			var vr := str(int(row["r"]))
    63			var wb: float = ui._width(vb, fs)
    64			ui._text(Vector2(maxf(rect.position.x, cx - lb - wb - 6), y + (rh - fs * 1.1) / 2), vb, fs, MUTED)
    65			ui._text(Vector2(minf(rect.end.x - ui._width(vr, fs), cx + mid_w + lr + 6), y + (rh - fs * 1.1) / 2), vr, fs, MUTED)
    66	
    67	## 排名條：values＝這個指標在可比兵種裡的值（Dictionary type→值）；me＝這一種。
    68	## 灰點＝其他兵種的位置，亮點＝這一種；右邊標「值・第 N 高」。只傳可比的兵種（第五輪 §4.3）。
    69	static func rank_bar(ui, rect: Rect2, values: Dictionary, me: int, label: String, value_text: String, accent := Color("#ffd166")) -> void:
    70		var fs: int = ui.tz("S")
    71		ui._text(rect.position, label, fs, MUTED)
    72		var lx := maxf(rect.position.x + rect.size.x * 0.22, rect.position.x + ui._width(label, fs) + 10)   # 標籤長（英文、大字）就往右讓
    73		if values.size() <= 1:
    74			# 不排名的指標（價格、補血、光環）：只寫數值，不畫條（Antigravity：灰條看起來像最低分）
    75			ui._text(Vector2(lx, rect.position.y), value_text, fs, Color.WHITE, false, true, rect.end.x - lx)
    76			return
    77		# 數值文字放得下為優先：條的寬度＝剩下的空間（30%～最少 50px）
    78		var rank_guess := 1
    79		for t in values:
    80			if t != me and float(values[t]) > float(values.get(me, 0)):
    81				rank_guess += 1
    82		var rt0: String = value_text if values.size() <= 1 else load("res://scripts/game/strings.gd").t("rank_nth", [value_text, rank_guess])
    83		var lw := clampf(rect.end.x - lx - ui._width(rt0, fs, true) - 24, 40.0, rect.size.x * 0.30)
    84		var cy := rect.position.y + fs * 0.75
    85		var seg: bool = ui.has_method("_seg_bar") and not bool(ui.Save.s("plain_ui"))
    86		if not seg:
    87			ui.draw_line(Vector2(lx, cy), Vector2(lx + lw, cy), GRID, 4.0)
    88		var mx := 0.0
    89		var mn := 1e18
    90		for t in values:
    91			mx = maxf(mx, float(values[t]))
    92			mn = minf(mn, float(values[t]))
    93		var span := maxf(1e-6, mx - mn)
    94		var rank := 1
    95		for t in values:
    96			if t != me and float(values[t]) > float(values.get(me, 0)):
    97				rank += 1
    98			var px := lx + lw * (float(values[t]) - mn) / span
    99			if t != me and not seg:
   100				ui.draw_circle(Vector2(px, cy), 4.0, Color(1, 1, 1, 0.35))
   101		if seg:
   102			# V1.2 C2：8 格刻印條；其他兵種的位置改成條下緣的小刻痕（資訊保留、不像滑桿）
   103			var fr: float = (float(values.get(me, 0)) - mn) / span if values.has(me) else 0.0
   104			ui._seg_bar(Rect2(lx, cy - 5, lw, 10), maxf(0.06, fr), accent)
   105			for t2 in values:
   106				if t2 != me:
   107					var px2 := lx + lw * (float(values[t2]) - mn) / span
   108					ui.draw_line(Vector2(px2, cy + 6), Vector2(px2, cy + 9), Color(1, 1, 1, 0.35), 1.5)
   109		elif values.has(me):
   110			var pm := lx + lw * (float(values[me]) - mn) / span
   111			ui.draw_line(Vector2(lx, cy), Vector2(pm, cy), accent, 4.0)
   112			ui.draw_circle(Vector2(pm, cy), 7.0, accent)
   113		var rt: String = value_text if values.size() <= 1 else load("res://scripts/game/strings.gd").t("rank_nth", [value_text, rank])
   114		ui._text(Vector2(lx + lw + 12, rect.position.y), rt, fs, Color.WHITE, false, true, rect.end.x - (lx + lw + 12))
   115	
   116	## 戰力走勢：log2＝每 tick [藍戰力, 紅戰力] 交錯；b0／b1＝兩邊預算。
   117	## 值＝藍比例 ÷（藍比例＋紅比例），以 50% 為界上藍下紅；雙方都 0 時沿用上一點；最後一段做平滑（第五輪 §4.3）。
   118	## marks＝[{t, label}] 最多畫 3 個，標籤不重疊。回傳每個取樣點的 y（測試用）。
   119	static func momentum(ui, rect: Rect2, log2: PackedInt64Array, b0: int, b1: int, marks: Array, total_ticks := 0) -> Array:
   120		var cb: bool = ui.cbm()
   121		var n := log2.size() / 2
   122		var mid := rect.position.y + rect.size.y / 2
    45	
    46	## 腳底在格子裡的位置：往前伸得很長的長槍兵靠左、很寬的小石魔靠右，其他都一樣。
    47	static func origin_of(type: int) -> Vector2:
    48		return Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160))
    49	
    50	## 全部清掉，烘舊 10 種和腳底圈。
    51	func build(cb: bool) -> void:
    52		if DisplayServer.get_name() == "headless":
    53			return
    54		_gen += 1
    55		pages.clear()
    56		loc.clear()
    57		_queue.clear()
    58		_baking = []
    59		_busy = false
    60		ring_tex = null
    61		ready_cb = 1 if cb else 0
    62		var base: Array = []
    63		for t in D.COUNT:
    64			base.append(t)
    65		await _bake_ring(cb)
    66		await ensure(base)
    67	
    68	## 這場要用到的兵種。缺的才烘；烘的時候呼叫端先直接畫。
    69	func ensure(types: Array) -> void:
    70		if DisplayServer.get_name() == "headless" or ready_cb < 0:
    71			return
    72		for t in types:
    73			if not loc.has(t) and not t in _queue and not t in _baking:
    74				_queue.append(t)
    75		if _busy or _queue.is_empty():
    76			return
    77		_busy = true
    78		while not _queue.is_empty():
    79			var chunk: Array = _queue.slice(0, TYPES_PER_PAGE)
    80			_queue = _queue.slice(chunk.size())
    81			_baking = chunk
    82			await _bake_page(chunk)
    83			_baking = []
    84		_busy = false
    85	
    86	func _viewport(size: Vector2i, painter: Node) -> SubViewport:
    87		var vp := SubViewport.new()
    88		vp.size = size
    89		vp.transparent_bg = true
    90		vp.render_target_update_mode = SubViewport.UPDATE_ONCE
    91		vp.add_child(painter)
    92		add_child(vp)
    93		return vp
    94	
    95	func _bake_page(types: Array) -> void:
    96		var gen0 := _gen
    97		var cb := ready_cb == 1
    98		var total := types.size() * 2 * FRAMES_PER
    99		var rows := int(ceil(float(total) / COLS))
   100		var painter := _Painter.new()
   101		painter.cb = cb
   102		painter.types = types
   103		var vp := _viewport(Vector2i(COLS * CELL, rows * CELL), painter)
   104		await RenderingServer.frame_post_draw
   105		await RenderingServer.frame_post_draw
   106		var img := vp.get_texture().get_image()
   107		vp.queue_free()
   108		img = await _post(img)
   109		if (1 if cb else 0) != ready_cb or gen0 != _gen:
   110			return   # 烘的時候換了配色（或重建了）：這一批作廢
   111		# 新兵頁太多就丟最舊的（舊 10 種那兩頁不丟）
   112		if pages.size() >= MAX_PAGES:
   113			for i in pages.size():
   114				if pages[i] != null and int(pages[i]["types"][0]) >= D.COUNT:
   115					for t in pages[i]["types"]:
   116						if loc.has(t) and int(loc[t][0]) == i:
   117							loc.erase(t)
   118					pages[i] = null
   119					break
   120		var pn := pages.size()
   121		pages.append({"tex": ImageTexture.create_from_image(img), "types": types})
   122		for k in types.size():
   123			loc[types[k]] = [pn, k * 2 * FRAMES_PER]
   124	
   125	## V1.2 D1：烘好的整頁再跑一次後處理 shader（外輪廓＋頂亮底暗）。沒有 shader 檔或 plain_ui 時原樣。
   126	func _post(img: Image) -> Image:
   127		var sh_path := "res://shaders/unit_bake.gdshader"
   128		if not ResourceLoader.exists(sh_path) or bool(Save.s("plain_ui")):
   129			return img
   130		var tr := TextureRect.new()
   131		tr.texture = ImageTexture.create_from_image(img)
   132		tr.size = Vector2(img.get_width(), img.get_height())
   133		var mat := ShaderMaterial.new()
   134		mat.shader = load(sh_path)
   135		mat.set_shader_parameter("cell", float(CELL))
   136		mat.set_shader_parameter("per", float(FRAMES_PER))
   137		mat.set_shader_parameter("cols", float(COLS))
   138		tr.material = mat
   139		var vp := _viewport(Vector2i(img.get_width(), img.get_height()), tr)
   140		await RenderingServer.frame_post_draw
   141		await RenderingServer.frame_post_draw
   142		var out := vp.get_texture().get_image()
   143		vp.queue_free()
   144		return out
   145	
   146	func _bake_ring(cb: bool) -> void:
   147		var painter := _RingPainter.new()
   148		painter.cb = cb
   149		var vp := _viewport(Vector2i(4 * CELL, CELL), painter)
   150		await RenderingServer.frame_post_draw
   151		await RenderingServer.frame_post_draw
   152		ring_tex = ImageTexture.create_from_image(vp.get_texture().get_image())
   153		vp.queue_free()
   154	
   155	## variant 1（劍士交替招式）和 2（第四輪新兵的專屬動作）都用第二組攻擊格：新兵沒有交替招式，那一組烘的是專屬動作。
   156	func frame_index(type: int, team: int, walk: float, atk: float, t: float, px: float, variant := 0) -> int:
   157		var base: int = int(loc[type][1]) + team * FRAMES_PER
   158		if atk > 0.0:
   159			return base + 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * mini(variant, 1) + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
   160		if walk <= Gait.POSE_DAZE + 1.0:
   161			return base + 2 + WALK_FRAMES + 1
   162		if walk <= Gait.POSE_DRAG + 1.0:
   163			return base + 2 + WALK_FRAMES
   164		if walk != 0.0:
   165			return base + 2 + int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES
   166		var ex := 2.0 if type == D.CAVALRY else 3.5   # Art._eyes 的眼睛中心 x
   167		var blink := fmod(t + ex * 0.13, 3.7) <= 0.12   # 與 Art._eyes 相同的眨眼節奏
   168		return base + (1 if blink else 0)
   169	
   170	func draw_ring(ci: CanvasItem, p: Vector2, team: int, type: int, scale := 1.0) -> void:
   171		var idx := team * 2 + (1 if (type == D.SHIELD or type == D.CAVALRY or type == 19) else 0)
   172		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
   173		ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2(idx * CELL, 0, CELL, CELL))
   174		ci.draw_set_transform_matrix(Art.base)
   175	
   176	func _rect(idx: int) -> Rect2:
   177		return Rect2((idx % COLS) * CELL, (idx / COLS) * CELL, CELL, CELL)
   178	
   179	## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
   180	func quant_walk(walk: float) -> float:
   181		if walk == 0.0:
   182			return 0.0
   183		if walk < -50.0:
   184			return walk
   185		return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES
   186	
   187	func quant_atk(atk: float) -> float:
   188		if atk <= 0.0:
   189			return 0.0
   190		return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES
