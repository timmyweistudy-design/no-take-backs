   535	func _deck_save() -> void:
   536		var decks: Array = Save.data.get("decks", [])
   537		decks.append(int(lobby_r.pool[lobby_pool_team]))
   538		while decks.size() > 3:
   539			decks.pop_front()
   540		Save.data["decks"] = decks
   541		Save.save_data()
   542		_toast(L.t("lb_deck_saved"))
