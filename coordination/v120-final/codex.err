+## V1.2：紙上墨色。灰白字→焦茶墨；亮彩字（金、綠、紅）壓暗成同色系的深色，透明度保留。
+static func _ink(c: Color) -> Color:
+	var lum := c.get_luminance()
+	if lum < 0.45:
+		return c
+	if c.s < 0.25:
+		return Color(INK, clampf(c.a * 1.1, 0.0, 1.0))
+	return Color(c.darkened(0.58), c.a)
