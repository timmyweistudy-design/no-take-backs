   544	func _deck_load(i: int) -> void:
   545		var decks: Array = Save.data.get("decks", [])
   546		if i >= decks.size():
   547			return
   548		var sel: int = Presets.selectable(lobby_kind, _lobby_unlocked(), _demo())
   549		var p: int = int(decks[i]) & sel
   550		if p == 0 or not RuleSet.has_combat(p):
   551			_toast(L.t("lb_deck_locked"), true)
   552			return
   553		lobby_r.pool[lobby_pool_team] = p
   554		if lobby_r.ai_pool_same:
   555			lobby_r.pool[1] = p
   556		_lobby_touch()
