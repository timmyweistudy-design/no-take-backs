   450	func wrap_lines(s: String, size: int, maxw: float, bold := false) -> PackedStringArray:
   451		var out := PackedStringArray()
   452		for para in s.split("\n"):
   453			if maxw <= 0.0 or _width(para, size, bold) <= maxw:
   454				out.append(para)
   455				continue
   456			var cur := ""
   457			var i := 0
