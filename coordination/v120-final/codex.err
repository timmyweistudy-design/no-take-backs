   336	## 第五輪：載入三種字型角色。標題字缺的字由介面字型 Bold 補。
   337	## V1.2 A1：介面字＝「NTB Latin（Fredoka，英數、數字等寬）為主字型＋NTB Rounded（源泉圓體 TW）為後備」：
   338	## 主字型只有拉丁字，中文自動落到後備，所以同一行裡英數用 Fredoka、中文用源泉圓體，不用拆段。
   339	func _load_fonts() -> void:
   340		var reg := _load_font("res://fonts/NTBRounded-R-sub.otf")
   341		var bold := _load_font("res://fonts/NTBRounded-B-sub.otf")
   342		font = _latin_over("res://fonts/NTBLatin-M-sub.ttf", reg)
   343		font_bold = _latin_over("res://fonts/NTBLatin-B-sub.ttf", bold)
   344		if ResourceLoader.exists("res://fonts/ThenKhung-sub.ttf"):
   345			var tk = load("res://fonts/ThenKhung-sub.ttf")
   346			if tk is FontFile:
   347				tk.fallbacks = [bold]
   348				font_title = tk
