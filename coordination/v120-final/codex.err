   510	## 結果頁摘要第一行（勝負原因・時間｜剩餘戰力）；緞帶高度和正文共用（V1.2）。
   511	func _result_line1() -> String:
   512		var reason_key := {"全滅": "reason_wipe", "同時全滅": "reason_bothwipe", "時間到・戰力相當": "reason_time_even",
   513			"時間到・剩餘戰力較高": "reason_time_power", "有一方沒有兵": "reason_empty"}
   514		var p0 := roundi(sim.power(0) * 100.0 / (sim.budget_of(0) * 1000))
   515		var p1 := roundi(sim.power(1) * 100.0 / (sim.budget_of(1) * 1000))
   516		return "%s・%.1fs　｜　%s" % [L.t(reason_key.get(sim.reason, "draw")), sim.tick / 20.0, L.t("power_left", [p0, p1])]

