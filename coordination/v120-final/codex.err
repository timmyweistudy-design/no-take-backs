   351	func _apply_fullscreen() -> void:
   352		if shot_dir != "":
   353			return
   354		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN if Save.s("fullscreen") else DisplayServer.WINDOW_MODE_WINDOWED)
   355	
   356	
   357	## 舊介面寫的字級數字（11～84）吸附到字級表：11～14→註記、15→次要、16～18→內文、19～24→區塊標題、25～48→畫面標題、49 以上→展示。
   358	## 這樣全遊戲不會再出現表外字級，也不會小於 14（第五輪 §4.2）。新程式請直接用 tz("B") 這類語意名稱。
   359	static func role_of(px: int) -> String:
   360		if px <= 14:
   361			return "C"
   362		if px == 15:
   363			return "S"
   364		if px <= 18:
   365			return "B"
   366		if px <= 24:
   367			return "H2"
   368		if px <= 48:
   369			return "H1"
   370		return "D" if px < 80 else "DX"
   371	
   372	func _scale_key() -> int:
   373		var sc := int(Save.s("text_scale"))
   374		return 150 if sc >= 150 else (125 if sc >= 125 else 100)
   375	
   376	func tz(role: String) -> int:
   377		return int(TYPE_SCALE[_scale_key()][role])
   378	
   379	func ts(px: int) -> int:
   380		return tz(role_of(px))
   381	
   382	## 封頂（第五輪）：取字級表裡 ≤ 上限的最大值，但不低於「註記」。取代 tcap(ts(x), N)，避免封出表外字級。
   383	func tcap(sz: int, maxpx: int) -> int:
   384		var best := tz("C")
   385		for v in TYPE_SCALE[_scale_key()].values():
   386			if v <= mini(sz, maxpx) and v > best:
   387				best = v
   388		return best
   389	
   390	## 這個字級在不在字級表裡（版面檢查用）。
   391	func size_ok(sz: int) -> bool:
   392		return sz in TYPE_SCALE[_scale_key()].values()
