     1	extends RefCounted
     2	## 對戰代碼（第三輪 F3）：把雙方陣型、規則版本、數值摘要編成一串，貼給朋友就能看同一場。
     3	## 格式：NTB2.<base64url(JSON)>.<校驗 6 碼>。JSON：{a/b: 雙方陣型代碼, ba/bb: 雙方預算, r: 規則版本, d: 數值摘要}
     4	## 規則或數值不同時仍可以播，但結果可能不同，所以解碼會回報 mismatch 讓畫面提示。
     5	
     6	const Army = preload("res://scripts/core/army.gd")
     7	const D = preload("res://scripts/core/unit_defs.gd")
     8	
     9	static func encode(a0, a1) -> String:
    10		var j := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest()})
    11		var body := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
    12		return "NTB2.%s.%s" % [body, body.sha256_text().substr(0, 6)]
    13	
    14	## 回傳 {ok, why, a0, a1, mismatch}
    15	static func decode(code: String) -> Dictionary:
    16		var c := code.strip_edges()
    17		var parts := c.split(".")
    18		if parts.size() != 3 or parts[0] != "NTB2":
    19			return {"ok": false, "why": "format"}
    20		if parts[1].sha256_text().substr(0, 6) != parts[2]:
    21			return {"ok": false, "why": "checksum"}
    22		var b64 := parts[1].replace("-", "+").replace("_", "/")
    23		while b64.length() % 4 != 0:
    24			b64 += "="
    25		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
    26		if not j is Dictionary or not j.has("a") or not j.has("b"):
    27			return {"ok": false, "why": "body"}
    28		# 預算也編進去（Codex S5 #1：遠征敵軍超過 100 金、殘局低預算時，原本會被當成 100）
    29		var ba := int(j.get("ba", 100))
    30		var bb := int(j.get("bb", 100))
    31		if ba < 1 or ba > 400 or bb < 1 or bb > 400:
    32			return {"ok": false, "why": "budget"}
    33		var a0 := Army.new(0, ba)
    34		var a1 := Army.new(1, bb)
    35		if a0.load_code(str(j["a"])) != "" or a1.load_code(str(j["b"])) != "":
    36			return {"ok": false, "why": "army"}
    37		var mismatch: bool = str(j.get("r", "")) != D.RULES_VERSION or str(j.get("d", "")) != D.data_digest()
    38		return {"ok": true, "why": "", "a0": a0, "a1": a1, "mismatch": mismatch}
     1	extends RefCounted
     2	## 兵種開放（第四輪 §9 決定 1、2）：
     3	## ・新兵依「正式場數」逐一解鎖：前 3 場只用經典 5 種，之後每 2 場多一種（長槍兵→投彈兵→醫者→鼓手→狂戰士）
     4	## ・對 AI、遠征：開放數＝已解鎖數；AI 也只用這些兵種（不會拿你沒見過的兵打你）
     5	## ・朋友對戰：不看個人進度，由「兵種：經典 5 種／全部」設定決定（同一台電腦兩人共用）
     6	## ・對 AI 也可以選「經典 5 種」
     7	## ・試玩版：最多開到第一批新兵（7 種）；之後的兵卡標「正式版解鎖」
     8	## 純函式，進度存在 Save.data["stats"]["games"]，不另外存解鎖狀態（不用遷移存檔）。
     9	
    10	const D = preload("res://scripts/core/unit_defs.gd")
    11	
    12	const UNLOCK_GAMES := [3, 5, 7, 9, 11]   # 第 k 個新兵（編號 5＋k）需要的正式場數
    13	const DEMO_MAX := 7
    14	
    15	## 依場數算出已解鎖的兵種數（5～10）；demo＝試玩版上限。
    16	static func unlocked_count(games: int, demo := false) -> int:
    17		var n := D.CLASSIC
    18		for g in UNLOCK_GAMES:
    19			if games >= g:
    20				n += 1
    21		return mini(n, DEMO_MAX) if demo else n
    22	
    23	## 這一場開放幾種兵。mode_kind："duel"（朋友對戰）、"ai"（對 AI、遠征）、"all"（教學、殘局：由關卡自己限制）。
    24	static func ntypes_for(mode_kind: String, games: int, classic: bool, demo := false) -> int:
    25		var cap := DEMO_MAX if demo else D.COUNT
    26		match mode_kind:
    27			"duel":
    28				return D.CLASSIC if classic else cap
    29			"ai":
    30				return D.CLASSIC if classic else unlocked_count(games, demo)
    31		return cap
    32	
    33	## 第 t 種兵還要再打幾場才解鎖（已解鎖回 0；試玩版鎖住的回 -1）。
    34	static func games_to_unlock(t: int, games: int, demo := false) -> int:
    35		if t < D.CLASSIC:
    36			return 0
    37		if demo and t >= DEMO_MAX:
    38			return -1
    39		return maxi(0, int(UNLOCK_GAMES[t - D.CLASSIC]) - games)
    40	
    41	## 打完一場後新解鎖的兵種（給提示用）。
    42	static func newly_unlocked(games_before: int, games_after: int, demo := false) -> Array:
    43		var out: Array = []
    44		for t in range(unlocked_count(games_before, demo), unlocked_count(games_after, demo)):
    45			out.append(t)
