    23	## 新狀態在舊場次必須一直是初值（加了新欄位就在這裡登記初值）。回傳空字串＝正常。
    24	static func new_fields_untouched(s) -> String:
    25		for u in s.units:
    26			for k in NEW_FIELDS:
    27				if k in u and u.get(k) != NEW_FIELDS[k]:
