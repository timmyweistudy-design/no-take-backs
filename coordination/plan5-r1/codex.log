    16	## known：玩家上一局的兵（藍方座標）；entries：反制庫；回傳紅方陣型。
    17	static func build(known: Array, entries: Array, rng: RandomNumberGenerator, ntypes := D.COUNT) -> Army:
    18		var cands: Array = []
    19		cands.append(AI.build(1, 100, rng, -1, ntypes)["army"])
    20		if known.is_empty():
    21			return cands[0]
    22		cands.append(AI.build(1, 100, rng, -1, ntypes)["army"])
    23		cands.append(AIT.build_full(1, rng, 2, known, ntypes))
    24		var lib := pick_counter(entries, known, ntypes)
    25		if lib != null:
    26			cands.append(lib)
    27		var me := Army.new(0, 100)
    28		for u in known:
    29			me.units.append({"type": int(u["type"]), "col": int(u["col"]), "row": int(u["row"])})
    30		var best: Army = cands[0]
    31		var bs := -(1 << 40)
    32		for c in cands:
    33			var s = Sim.new(me.copy(), c.copy())
    34			s.fast = true
    35			s.run_to_end()
    36			var sc: int = (1000000 + s.power(1)) if s.winner == 1 else (s.power(1) - s.power(0))
    37			if sc > bs:
    38				bs = sc
    39				best = c
    40		return best
