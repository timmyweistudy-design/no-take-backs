    86	## 比對前 n 場；回傳 {ok, n, first_case, why}
    87	static func check(n: int) -> Dictionary:
    88		var g = JSON.parse_string(FileAccess.get_file_as_string(PATH))
    89		if not g is Dictionary:
    90			return {"ok": false, "why": "讀不到相容基準檔"}
