     8	
     9	src = sys.argv[1]
    10	root = os.path.join(os.path.dirname(__file__), "..")
    11	chars = set()
    12	for pat in ["data/*.csv", "data/*.json", "data/*.txt", "scripts/**/*.gd"]:
    13	    for f in glob.glob(os.path.join(root, pat), recursive=True):
    14	        chars.update(open(f, encoding="utf-8").read())
    15	chars.update(chr(c) for c in range(0x20, 0x7F))
    16	chars.update("★☆✓✗✦●◆■□｜・…×％（）：，。！？「」、")
    17	text = "".join(sorted(c for c in chars if c.isprintable()))
    18	os.makedirs(os.path.join(root, "fonts"), exist_ok=True)
    19	for w in ["Regular", "Bold"]:
    20	    out = os.path.join(root, "fonts", f"NotoSansTC-{w}-sub.otf")
    21	    opts = subset.Options()
    22	    opts.layout_features = ["*"]
    23	    opts.name_IDs = ["*"]
    24	    sub = subset.Subsetter(opts)
    25	    font = subset.load_font(os.path.join(src, f"NotoSansTC-{w}.otf"), opts)
    26	    sub.populate(text=text)
    27	    sub.subset(font)
    28	    subset.save_font(font, out, opts)
    29	    print(w, len(text), "字", os.path.getsize(out) // 1024, "KB")
