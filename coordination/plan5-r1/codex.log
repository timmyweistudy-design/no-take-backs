    70	func _make() -> void:
    71		if D.RULES_VERSION != "1.2.0":
    72			push_error("相容基準只能在規則 1.2.0（還沒加新兵）時產生")
    73			quit(1)
    74			return
    75		var g = JSON.parse_string(FileAccess.get_file_as_string(GOLDEN))
    76		var cases: Array = []
    77		for c in g["cases"]:
    78			var r := run_case(c["a"], c["b"])
    79			cases.append({"a": c["a"], "b": c["b"], "w": r["w"], "t": r["t"], "roll": r["roll"], "per": r["per"]})
    80		var f := FileAccess.open(PATH, FileAccess.WRITE)
    81		f.store_string(JSON.stringify({"from_rules": D.RULES_VERSION, "from_digest": D.data_digest(), "cases": cases}))
    82		f.close()
