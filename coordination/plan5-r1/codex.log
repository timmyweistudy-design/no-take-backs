    42	## 反制庫：組成最接近玩家陣型的原型的反制（距離 ≤40）；用到未開放兵種的不算。
    43	static func pick_counter(entries: Array, known: Array, ntypes: int) -> Army:
    44		if entries.is_empty():
    45			return null
    46		var mine := D.zeros()
    47		for u in known:
    48			mine[int(u["type"])] += D.cost(int(u["type"]))
    49		var best = null
    50		var bd := 1 << 30
    51		for e in entries:
    52			var pc: Array = e["proto_comp"]
    53			var d := 0
    54			for k in mine.size():
    55				d += absi((int(pc[k]) if k < pc.size() else 0) - int(mine[k]))
    56			if d < bd:
    57				bd = d
    58				best = e
    59		if best == null or bd > 40:
    60			return null
    61		var a := Army.new(1, 100)
    62		if a.load_code(str(best["code"])) != "":
    63			return null
    64		for u in a.units:
    65			if int(u["type"]) >= ntypes:
    66				return null
    67		return a
