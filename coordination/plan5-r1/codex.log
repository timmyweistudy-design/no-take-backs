    34	static func run_case(c0: String, c1: String) -> Dictionary:
    35		var a0 := Army.new(0, 100)
    36		var a1 := Army.new(1, 100)
    37		if a0.load_code(c0) != "" or a1.load_code(c1) != "":
    38			return {"error": "陣型代碼解不開"}
    39		var s = Sim.new(a0, a1)
    40		s.fast = true
    41		var h := HashingContext.new()
    42		h.start(HashingContext.HASH_SHA256)
    43		var untouched := ""
    44		while not s.finished:
    45			s.step()
    46			var buf := PackedInt64Array([s.tick])
    47			for u in s.units:
    48				buf.append_array(old_fields(u))
    49			h.update(buf.to_byte_array())
    50			if untouched == "":
    51				untouched = new_fields_untouched(s)
    52		var per := PackedStringArray()
    53		for u in s.units:
    54			per.append("%d:%d:%d:%d" % [u.id, u.kills, u.dmg_dealt, u.dmg_taken])
    55		return {"w": s.winner, "t": s.tick, "roll": h.finish().hex_encode().substr(0, 24), "per": ";".join(per), "untouched": untouched}
