   226	func _btn(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
   227		var idx := _btns.size()
   228		_btns.append({"r": r, "cb": action, "en": enabled})
   229		var hover := r.has_point(mouse) and not pad_mode
   230		var focus := pad_mode and idx == _focus
   231		var bg := Color(0.2, 0.22, 0.3) if not primary else Color(0.85, 0.52, 0.14)
   232		if tint.a > 0:
   233			bg = tint
   234		if not enabled:
   235			bg = Color(0.16, 0.16, 0.2)
   236		elif hover or focus:
   237			bg = bg.lightened(0.18)
   238		draw_rect(r, bg)
   239		draw_rect(r, ACCENT if focus else Color(1, 1, 1, 0.18), false, 3 if focus else 1.5)
   240		var sz := fit(label, ts(18) if r.size.y >= 40 else ts(15), r.size.x - 10, primary)
   241		sz = mini(sz, int(r.size.y * 0.8))
   242		_text(r.get_center() - Vector2(0, sz * 0.62), label, sz, Color.WHITE if enabled else Color(1, 1, 1, 0.4), true, primary)
