   193	## 字太寬就縮小（英文、大字設定時避免截字；最小 9px）。
   194	func fit(s: String, size: int, maxw: float, bold := false) -> int:
   195		var fnt := font_bold if bold else font
   196		var sz := size
   197		var w := 0.0
   198		for ln in s.split("\n"):
   199			w = maxf(w, fnt.get_string_size(ln, HORIZONTAL_ALIGNMENT_LEFT, -1, sz).x)
   200		while w > maxw and sz > 9:
   201			sz -= 1
   202			w = 0.0
   203			for ln in s.split("\n"):
   204				w = maxf(w, fnt.get_string_size(ln, HORIZONTAL_ALIGNMENT_LEFT, -1, sz).x)
   205		return sz
   206	
   207	
   208	func _text(p: Vector2, s: String, size: int, c: Color, center := false, bold := false, maxw := 0.0, outline := Color(0, 0, 0, -1)) -> void:
   209		var fnt := font_bold if bold else font
   210		if maxw > 0.0:
   211			size = fit(s, size, maxw, bold)
   212		var lines := s.split("\n")
   213		for i in lines.size():
   214			var w := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x if center else 0.0
   215			var q := p + Vector2(-w / 2, i * size * 1.3 + size * 0.85)
   216			if layout_probe and _probe_ui and c.a > 0.2 and lines[i].strip_edges() != "":
   217				var ww := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
   218				probe_texts.append({"r": Rect2(q.x, q.y - size * 0.85, ww, size * 1.1), "size": size, "s": lines[i]})
   219			var oc := Color(0, 0, 0, c.a * 0.75) if outline.a < 0.0 else outline
   220			if oc.a > 0.0:
   221				draw_string_outline(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, 5, oc)
   222			draw_string(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, c)
   223	
