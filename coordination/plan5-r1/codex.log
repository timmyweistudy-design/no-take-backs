    60			var a1: Army = AI.build(1, 100, rng)["army"] if i % 2 == 0 else F.random_formation(0, rng, "mixed", "", D.COUNT).mirrored()
    61			var c0 := a0.to_code()
    62			var c1 := a1.to_code()
    63			var r := run_case(c0, c1, false)
