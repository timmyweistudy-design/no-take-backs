   143	## 數值摘要：本檔所有常數的 SHA-256 前 16 碼。遊戲、AI、平衡工具、重播都記錄它，證明跑的是同一份數值。
   144	static func data_digest() -> String:
   145		if _digest == "":
   146			var m: Dictionary = load("res://scripts/core/unit_defs.gd").get_script_constant_map()
   147			# 常數名稱是 StringName，直接排序是比記憶體位址、不是字母順序 → 先轉成 String 再排
   148			var pairs: Array = []
   149			for k in m:
   150				pairs.append([String(k), m[k]])
   151			pairs.sort_custom(func(a, b): return a[0] < b[0])
   152			var txt := ""
   153			for pr in pairs:
   154				txt += "%s=%s;" % [pr[0], var_to_str(pr[1])]
   155			_digest = txt.sha256_text().substr(0, 16)
   156		return _digest
