     2	## 騎兵打轉偵測（第二輪方案 §1.4）：訓練池 120 場，40 tick 內走了 >3 格但淨位移 <0.8 格就算一次。
     3	## 同一隻騎兵觸發後隔 40 tick 重新武裝、繼續追蹤（不是第一次就永久放過；Codex R1 審查 #1）。
     4	## 分類看整個視窗，不只最後一刻：
     5	##   A＝視窗內任何時刻在繞翼途經點上（nav＝1）；
     6	##   T＝視窗內換過目標；
     7	##   N＝正常纏鬥：離目標在攻擊距離＋0.6 格內，而且視窗內真的出手過；
     8	##   B＝追擊移動中的目標（目標在視窗內淨移動 >0.8 格），且視窗內沒出手；
     9	##   C＝其他（沒換目標、沒出手、目標也沒怎麼動卻在原地繞）。
    10	## 上下 1 格內另標「邊緣」。門檻：A＝0、B≤8、C≤2；否則 exit 1。
    11	## 用法：godot --headless --path game --script res://tools/orbit_detect.gd
    12	const Sim = preload("res://scripts/core/battle_sim.gd")
    13	const F = preload("res://scripts/core/formations.gd")
    14	const D = preload("res://scripts/core/unit_defs.gd")
    15	const WIN := 40
    16	func _init() -> void:
    17		var pool := F.training_pool(0)
    18		var found := 0
    19		var cav_battles := 0
    20		var kinds := {"A": 0, "B": 0, "C": 0, "N": 0, "T": 0}
    21		var edge := 0
    22		var samples: Array = []
    23		for i in 120:
    24			var s := Sim.new(pool[i].copy(), pool[(i * 37 + 11) % pool.size()].mirrored())
    25			s.fast = true
    26			var hist := {}      # id → 最近 WIN tick 的 [x, y, target, nav, 出手數, 目標 x, 目標 y]
    27			var armed_at := {}  # id → 下一次可以再判定的 tick
    28			var has_cav := false
    29			while not s.finished:
    30				s.step()
    31				var hits := {}
    32				for e in s.events:
    33					if e.has("dmg"):
    34						hits[e["src"]] = hits.get(e["src"], 0) + 1
    35				for u in s.units:
    36					if u.type != D.CAVALRY or not u.alive:
    37						continue
    38					has_cav = true
    39					var tg = s.units[u.target] if u.target >= 0 else null
    40					var h: Array = hist.get(u.id, [])
    41					h.append([u.x, u.y, u.target, u.nav, hits.get(u.id, 0), tg.x if tg else u.x, tg.y if tg else u.y])
    42					if h.size() > WIN:
    43						h.pop_front()
    44					hist[u.id] = h
    45					if h.size() < WIN or s.tick < armed_at.get(u.id, 0):
    46						continue
    47					var path := 0.0
    48					for k in range(1, WIN):
    49						path += Vector2(h[k][0], h[k][1]).distance_to(Vector2(h[k - 1][0], h[k - 1][1]))
    50					if path <= 3000 or Vector2(h[WIN - 1][0], h[WIN - 1][1]).distance_to(Vector2(h[0][0], h[0][1])) >= 800:
    51						continue
    52					armed_at[u.id] = s.tick + WIN
    53					found += 1
    54					var any_nav := false
    55					var swapped := false
    56					var shots := 0
    57					for r in h:
    58						any_nav = any_nav or r[3] == 1
    59						swapped = swapped or r[2] != h[0][2]
    60						shots += r[4]
    61					var tgt_moved: float = Vector2(h[WIN - 1][5], h[WIN - 1][6]).distance_to(Vector2(h[0][5], h[0][6]))
    62					var near: bool = tg != null and Vector2(u.x, u.y).distance_to(Vector2(tg.x, tg.y)) <= u.reach + 600
    63					var k2 := "C"
    64					if any_nav:
    65						k2 = "A"
    66					elif swapped:
    67						k2 = "T"
    68					elif near and shots > 0:
    69						k2 = "N"
    70					elif tgt_moved > 800 and shots == 0:
    71						k2 = "B"
    72					kinds[k2] += 1
    73					if k2 == "C" and samples.size() < 5:
    74						samples.append([i, s.tick, u.x, u.y, tg.type if tg else -1, tg.x if tg else 0, tg.y if tg else 0, u.nav, shots, u.stun, u.slow, u.chasing])
    75					if u.y <= 1000 or u.y >= Sim.H - 1000:
    76						edge += 1
    77			if has_cav:
    78				cav_battles += 1
    79		print("ORBIT cav_battles=%d total=%d A=%d B=%d C(遠離目標)=%d N(正常纏鬥)=%d T(換目標)=%d edge=%d" % [cav_battles, found, kinds["A"], kinds["B"], kinds["C"], kinds["N"], kinds["T"], edge])
    80		for x in samples:
    81			print("  C 例：場%d tick%d 騎兵(%d,%d) 目標兵種%d(%d,%d) nav=%d 出手=%d stun=%d slow=%d chasing=%s" % x)
    82		quit(0 if kinds["A"] == 0 and kinds["B"] <= 8 and kinds["C"] <= 2 else 1)
     1	#!/usr/bin/env python3
     2	"""素材登記檢查（優化方案 R）：game/ 底下每個圖片／聲音／字型檔都要在 THIRD_PARTY_LICENSES.md 有對應的來源。
     3	結束碼 0＝全部登記；1＝有沒登記的檔案。"""
     4	import os, sys, fnmatch
     5	root = os.path.join(os.path.dirname(__file__), "..")
     6	rules = [  # (路徑樣式, 登記項目)
     7	    ("art/cainos/*.png", "Cainos"),
     8	    ("audio/*.wav", "本作程式合成"),
     9	    ("fonts/NotoSansTC-*.otf", "Noto Sans TC"),
    10	    ("icon.svg", "本作程式繪製"),
    11	]
    12	reg = open(os.path.join(root, "..", "THIRD_PARTY_LICENSES.md"), encoding="utf-8").read()
    13	bad = []
    14	for dp, dn, fn in os.walk(root):
    15	    if ".godot" in dp:
    16	        continue
    17	    for f in fn:
    18	        if not f.lower().endswith((".png", ".wav", ".ogg", ".otf", ".ttf", ".svg", ".jpg")):
    19	            continue
    20	        rel = os.path.relpath(os.path.join(dp, f), root).replace("\\", "/")
    21	        hit = [n for p, n in rules if fnmatch.fnmatch(rel, p)]
    22	        if not hit or not all(n.split("（")[0] in reg or n in ("本作程式合成", "本作程式繪製") for n in hit):
    23	            bad.append(rel)
    24	print("未登記：", bad if bad else "無")
    25	sys.exit(1 if bad else 0)

