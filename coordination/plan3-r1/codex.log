    46	## ×5/2 → ×2.5、×2/1 → ×2（手感輪 R3：分數讀起來像程式）
    47	static func _pretty_ratio(s: String) -> String:
    48		var re := RegEx.create_from_string("×(\\d+)/(\\d+)")
    49		var out := s
    50		for m in re.search_all(s):
    51			var v := float(m.get_string(1)) / float(m.get_string(2))
    52			var t := str(int(v)) if is_equal_approx(v, roundf(v)) else str(snappedf(v, 0.01))
    53			out = out.replace(m.get_string(0), "×" + t)
    54		return out
    55	
    56	static func _fill_raw(s: String) -> String:
    57		var out := s
    58		for m in _re().search_all(s):
    59			var v = value(m.get_string(2))
    60			if v == null:
    61				continue
    62			var shown := str(v)
    63			if m.get_string(1) != "":
    64				var cells := float(v) / 1000.0
    65				shown = str(int(cells)) if is_equal_approx(cells, roundf(cells)) else "%.1f" % cells
    66			out = out.replace(m.get_string(0), shown)
    67		return out
