  1286	## 動態判詞：用輸出最高的兵種、結束方式、懸念類型組一句話。
  1287	func _verdict(w: int) -> String:
  1288		var dealt: Array = report["dealt"][w]
  1289		var top := 0
  1290		for t in 5:
  1291			if dealt[t] > dealt[top]:
  1292				top = t
  1293		var sus: Dictionary = report["sus"]
  1294		var side := L.t("blue") if w == 0 else L.t("red")
  1295		var unit := L.t("unit_%d" % top)
  1296		var secs := int(sim.tick / 20)
  1297		if int(sus.get("max_swing_pct", 0)) >= 15:
  1298			return L.t("verdict_comeback", [side, unit, sus["max_swing_pct"]])
  1299		if sim.power(w) * 100 / (sim.budget * 1000) <= 10:
  1300			return L.t("verdict_close", [side, unit, secs])
  1301		if int(sus.get("lock_ratio_permille", 0)) <= 200:
  1302			return L.t("verdict_rout", [side, unit, secs])
  1303		return L.t("verdict_normal", [side, unit, secs])
