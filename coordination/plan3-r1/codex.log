  1306	func _next_round() -> void:
  1307		if series_over:
  1308			wins = [0, 0]
  1309			round_no = 1
  1310			series_over = false
  1311			last_player_formation = []
  1312			_reset_place(false)
  1313			return
  1314		round_no += 1
  1315		_reset_place(mode == Mode.VS_AI)
  1316	
