    53	## 選位置：依兵種角色欄位；騎兵往敵方弓手多、盾兵少的那一側；盾兵擋在敵方騎兵／弓手集中的列。
    54	static func choose_cell(mine: Army, t: int, enemy_units: Array, rng: RandomNumberGenerator) -> Vector2i:
    55		var want_row := 4
    56		if not enemy_units.is_empty():
    57			var sum := 0
    58			var cnt := 0
    59			for e in enemy_units:
    60				var et: int = e["type"]
    61				if t == D.CAVALRY and et == D.ARCHER:
    62					sum += e["row"] * 3
    63					cnt += 3
    64				elif t == D.CAVALRY and et == D.SHIELD:
    65					sum += (8 - e["row"]) * 2
    66					cnt += 2
    67				elif t == D.SHIELD and (et == D.CAVALRY or et == D.ARCHER):
    68					sum += e["row"] * 2
    69					cnt += 2
    70				else:
    71					sum += e["row"]
    72					cnt += 1
    73			want_row = clampi(int(round(float(sum) / cnt)), 0, 8)
    74		elif t == D.CAVALRY:
    75			want_row = 0 if rng.randf() < 0.5 else 8
    76		var cols: Array = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
    77		for c in cols:
    78			var col: int = c if mine.team == 0 else Army.COLS - 1 - c
    79			for dr in 9:
    80				for sgn in [1, -1]:
    81					var r: int = want_row + dr * sgn
    82					if r < 0 or r > 8:
    83						continue
    84					if mine.check_place(t, col, r) == "":
