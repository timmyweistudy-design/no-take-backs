     1	extends RefCounted
     2	## 陣型產生器（平衡工具 2.0 的訓練池／保留池，優化方案 B2）。全部由種子決定。
     3	
     4	const D = preload("res://scripts/core/unit_defs.gd")
     5	const Army = preload("res://scripts/core/army.gd")
     6	
     7	const STYLES := ["role", "random", "lane_top", "lane_bottom", "center", "front", "spread"]
     8	const ROLE_COLS := [
     9		[5, 4, 3], [5, 4], [0, 1, 2], [3, 2, 4], [2, 3, 1],
    10	]
    11	
    12	## 產生一套陣型。kind：
    13	##   "mixed" 隨機權重混編；"pure" 單一兵種；"duo" 兩種兵；"template" 用 ai_army 的原型權重。
    14	static func random_formation(team: int, rng: RandomNumberGenerator, kind := "mixed", style := "") -> Army:
    15		var a := Army.new(team, 100)
    16		var w: Array = [0, 0, 0, 0, 0]
    17		match kind:
    18			"pure":
    19				w[rng.randi_range(0, 4)] = 1
    20			"duo":
    21				var p := rng.randi_range(0, 4)
    22				var q := (p + rng.randi_range(1, 4)) % 5
    23				w[p] = rng.randi_range(1, 3)
    24				w[q] = rng.randi_range(1, 3)
    25			_:
    26				for t in 5:
    27					w[t] = rng.randi_range(0, 4)
    28				if w.max() == 0:
    29					w[rng.randi_range(0, 4)] = 1
    30		if style == "":
    31			style = STYLES[rng.randi_range(0, STYLES.size() - 1)]
    32		var picks: Array = []
    33		var budget_left := 100
    34		var guard := 0
    35		while picks.size() < Army.MAX_UNITS and guard < 100:
    36			guard += 1
    37			var total := 0
    38			for t in 5:
    39				if w[t] > 0 and D.cost(t) <= budget_left:
    40					total += w[t]
    41			if total == 0:
    42				break
    43			var r := rng.randi_range(1, total)
    44			for t in 5:
    45				if w[t] > 0 and D.cost(t) <= budget_left:
    46					r -= w[t]
    47					if r <= 0:
    48						picks.append(t)
    49						budget_left -= D.cost(t)
    50						break
    51		for t in picks:
    52			place_styled(a, t, style, rng)
    53		return a
    54	
    55	static func place_styled(a: Army, t: int, style: String, rng: RandomNumberGenerator) -> void:
    56		var cols: Array
    57		var rows: Array
    58		match style:
    59			"random":
    60				for _i in 60:
    61					var c := rng.randi_range(0, 5)
    62					var r := rng.randi_range(0, 8)
    63					if a.place(t, _abs_col(a, c), r):
    64						return
    65				cols = [5, 4, 3, 2, 1, 0]
    66				rows = [4, 3, 5, 2, 6, 1, 7, 0, 8]
    67			"lane_top":
    68				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
    69				rows = [0, 1, 2, 3, 4, 5, 6, 7, 8]
    70			"lane_bottom":
    71				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
    72				rows = [8, 7, 6, 5, 4, 3, 2, 1, 0]
    73			"front":
    74				cols = [5, 4, 3, 2, 1, 0]
    75				rows = [4, 3, 5, 2, 6, 1, 7, 0, 8]
    76			"spread":
    77				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
    78				rows = [0, 8, 4, 2, 6, 1, 7, 3, 5]
    79			_:   # role / center
    80				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
    81				rows = [4, 3, 5, 2, 6, 1, 7, 0, 8] if (style == "center" or t != D.CAVALRY) else [0, 8, 1, 7, 2, 6, 3, 5, 4]
    82		for c in cols:
    83			for r in rows:
    84				if a.place(t, _abs_col(a, c), r):
    85					return
    86	
    87	## 藍方 0＝最後排、5＝最前排；紅方鏡像。
    88	static func _abs_col(a: Army, c: int) -> int:
    89		return c if a.team == 0 else Army.COLS - 1 - c
    90	
    91	## 訓練池（200）與保留池（50）：不同種子範圍，保留池不參與調參。
    92	static func pool(team: int, count: int, seed_base: int) -> Array:
    93		var out: Array = []
    94		var rng := RandomNumberGenerator.new()
    95		var kinds := ["mixed", "mixed", "mixed", "duo", "pure"]
    96		for i in count:
    97			rng.seed = seed_base + i * 7919
    98			out.append(random_formation(team, rng, kinds[i % kinds.size()]))
    99		return out
   100	
   101	static func training_pool(team: int) -> Array:
   102		return pool(team, 200, 1000003)
   103	
   104	static func holdout_pool(team: int) -> Array:
   105		return pool(team, 50, 9000011)
   106	
   107	## 搜尋池：萬用陣搜尋演化時用的對手（跟保留池分開，避免資料洩漏）。
   108	static func search_pool(team: int) -> Array:
   109		return pool(team, 60, 5000017)
   110	
   111	## 兵種組成向量（每種兵的金額）。
   112	static func composition(a: Army) -> Array:
   113		var v := [0, 0, 0, 0, 0]
   114		for u in a.units:
   115			v[u["type"]] += D.cost(u["type"])
   116		return v
     1	extends SceneTree
     2	## 殘局／教學驗證（優化方案 D、附錄 A）：每關隨機抽樣擺法，檢查
     3	##  ① 什麼都不放（只有固定兵）會輸；② 至少兩類「兵種組合」能贏；③ 抽樣勝率 2%～70%（不太難也不太簡單；教學可到 95%）；
     4	##  ④ ★★、★★★ 門檻至少各有一個解達成。
     5	## 用法：godot --headless --path game --script res://tools/validate_puzzles.gd -- --id=p1 [--samples=300]
     6	## 每關一行 "V {json}"。
     7	
     8	const D = preload("res://scripts/core/unit_defs.gd")
     9	const Army = preload("res://scripts/core/army.gd")
    10	const Sim = preload("res://scripts/core/battle_sim.gd")
    11	const P = preload("res://scripts/game/puzzles.gd")
    12	
    13	func _init() -> void:
    14		var args := {}
    15		for a in OS.get_cmdline_user_args():
    16			if a.begins_with("--") and "=" in a:
    17				var kv := a.substr(2).split("=", true, 1)
    18				args[kv[0]] = kv[1]
    19		var samples := int(args.get("samples", "300"))
    20		var ids: Array = [args["id"]] if args.has("id") else P.all_ids()
    21		var all_ok := true
    22		for id in ids:
    23			var r := validate(P.get_puzzle(id), samples)
    24			all_ok = all_ok and bool(r["ok"])
    25			print("V ", JSON.stringify(r))
    26		quit(0 if all_ok else 1)
    27	
    28	func run(pz: Dictionary, extra: Array) -> Sim:
    29		var a0: Army = P.player_army(pz)
    30		for e in extra:
    31			a0.units.append({"type": e[0], "col": e[1], "row": e[2]})
    32		var s := Sim.new(a0, P.enemy_army(pz))
    33		s.fast = true
    34		s.run_to_end()
    35		return s
    36	
    37	func validate(pz: Dictionary, samples: int) -> Dictionary:
    38		var base := run(pz, [])
    39		var rng := RandomNumberGenerator.new()
    40		rng.seed = hash(pz["id"])
    41		var wins := 0
    42		var classes := {}
    43		var best_rem := 0
    44		var min_spend := 999
    45		var three_star := false
    46		var examples := {}
    47		var allowed: Array = pz["allowed"]
    48		var fixed_cells := {}
    49		for f in pz["fixed"]:
    50			fixed_cells[Vector2i(f[1], f[2])] = true
    51		for i in samples:
    52			var left: int = pz["budget"]
    53			var extra: Array = []
    54			var used := {}
    55			var n := rng.randi_range(1, 6)
    56			for k in n:
    57				var t: int = allowed[rng.randi_range(0, allowed.size() - 1)]
    58				if D.cost(t) > left:
    59					continue
    60				for tries in 20:
    61					var c := Vector2i(rng.randi_range(0, 5), rng.randi_range(0, 8))
    62					if not fixed_cells.has(c) and not used.has(c):
    63						used[c] = true
    64						extra.append([t, c.x, c.y])
    65						left -= D.cost(t)
    66						break
    67			if extra.is_empty():
    68				continue
    69			var s := run(pz, extra)
    70			if s.winner == 0:
    71				wins += 1
    72				var types := {}
    73				var spend := 0
    74				for e in extra:
    75					types[e[0]] = true
    76					spend += D.cost(e[0])
    77				var key := types.keys()
    78				key.sort()
    79				classes[str(key)] = classes.get(str(key), 0) + 1
    80				var rem: int = s.power(0) * 100 / (s.budget * 1000)
    81				best_rem = maxi(best_rem, rem)
    82				min_spend = mini(min_spend, spend)
    83				if rem >= int(pz["star2"]) and spend <= int(pz["star3"]):
    84					three_star = true
    85				if not examples.has(str(key)) and examples.size() < 2:
    86					examples[str(key)] = extra
    87		var rate := wins * 100 / maxi(1, samples)
    88		var max_rate := 95 if pz.get("tutorial", false) else 70
    89		var need_classes := 1 if pz.get("tutorial", false) else 2
    90		var ok: bool = base.winner != 0 and classes.size() >= need_classes and rate >= 2 and rate <= max_rate \
    91			and three_star
    92		return {"id": pz["id"], "ok": ok, "base_winner": base.winner, "win_rate": rate, "classes": classes.size(),
    93			"class_list": classes, "best_rem": best_rem, "min_spend": min_spend, "three_star": three_star, "star2": pz["star2"], "star3": pz["star3"], "solutions": examples.values()}
