     2	## 主場景腳本。這一層只放宣傳工具：自動截圖、商店膠囊圖、實機影片模式。
     3	
     4	
     5	## 商店膠囊圖（N6）：用目前視窗大小構圖——先畫標題帶，再把兩軍放在標題下方對衝，中間有分界線與對射的箭。
     6	## 只有遊戲標題文字（Steam 規定）。手感輪（收尾批）調整：標題帶不壓角色、中央不留白、小尺寸放大標題與角色、兩側留邊。
     7	func _draw_capsule() -> void:
     8		var vs := get_viewport_rect().size
     9		var tile := 64.0 * vs.y / 800.0
    10		for yy in int(vs.y / tile) + 1:
    11			for xx in int(vs.x / tile) + 1:
    12				var h := absi((xx * 73856093) ^ (yy * 19349663))
    13				draw_texture_rect_region(grass, Rect2(xx * tile, yy * tile, tile, tile), Rect2((h % 8) * 32, ((h / 8) % 4) * 32, 32, 32))
    14		draw_rect(Rect2(Vector2.ZERO, vs), Color(0.06, 0.09, 0.16, 0.22))
    15		var tall := vs.y > vs.x
    16		var tiny := get_window().size.y < 300   # 畫布邏輯高度固定 800，要看實際視窗大小
    17		# 標題帶（先畫，角色畫在它下方的區域）
    18		var big := int(vs.y * (0.12 if tall else (0.30 if tiny else 0.21)))
    19		var band_h := big * 1.75
    20		var band_y := vs.y * (0.05 if tall else 0.03)
    21		draw_rect(Rect2(0, band_y, vs.x, band_h), Color(0.05, 0.06, 0.1, 0.55))
    22		# 標題：立體投影＋金邊（R6）
    23		var tw := font_bold.get_string_size(L.t("title"), HORIZONTAL_ALIGNMENT_LEFT, -1, big).x
    24		var tp := Vector2(vs.x / 2 - tw / 2, band_y + big * 0.05 + big * 0.85)
    25		for d in 4:
    26			draw_string(font_bold, tp + Vector2(1, 1) * (d + 1) * big * 0.012, L.t("title"), HORIZONTAL_ALIGNMENT_LEFT, -1, big, Color(0.35, 0.18, 0.05, 0.9))
    27		draw_string_outline(font_bold, tp, L.t("title"), HORIZONTAL_ALIGNMENT_LEFT, -1, big, int(maxf(4.0, big * 0.07)), Color("#b8860b"))
    28		draw_string(font_bold, tp, L.t("title"), HORIZONTAL_ALIGNMENT_LEFT, -1, big, Color("#ffe8a3"))
    29		_text(Vector2(vs.x / 2, band_y + big * 1.12), "No Take-Backs", int(big * (0.42 if tiny else 0.34)), Color(1, 1, 1, 0.97), true, true)
    30		# 戰場區
    31		var top := band_y + band_h + vs.y * 0.02
    32		var bottom := vs.y * 0.97
    33		var mid := vs.x / 2
    34		draw_dashed_line(Vector2(mid, top), Vector2(mid, bottom), Color(1, 1, 1, 0.45), maxf(3.0, vs.y * 0.006) * (2.5 if tiny else 1.0), vs.y * 0.02)
    35		var sc := (bottom - top) / (110.0 if tiny else 260.0)
    36		if tall:
    37			sc = minf(sc, vs.x / 380.0)   # 直式：依寬度限制大小，同排兩隻不會擠在一起
    38		var cols := 3 if tiny else (2 if tall else 3)
    39		var rows := 1 if tiny else 3
    40		var margin := maxf(20.0, vs.x * 0.05)
    41		# 每邊固定 cols×rows 的整齊陣型；弓兵固定在最靠中線的那一欄，箭從弓兵射出
    42		# 兩軍在中線交鋒的瞬間（R6）：最前排近戰撞在中線，弓兵在後排放箭，身後有速度線
    43		var layout := [D.ARCHER, D.SHIELD, D.SWORD, D.ARCHER, D.ASSASSIN, D.CAVALRY, D.ARCHER, D.SHIELD, D.SWORD]
    44		var items: Array = []
    45		var archers: Array = []
    46		for team in 2:
    47			for r in rows:
    48				for c in cols:
    49					var t: int = layout[(r * cols + c) % layout.size()]
    50					if c == 0 and not tiny:
    51						t = D.ARCHER
    52					elif c == cols - 1 and t == D.ARCHER:
    53						t = D.SWORD   # 最前排一定是近戰撞在中線
    54					var span := (mid - margin) * 0.80 - sc * 30.0
    55					var x := margin + sc * 24.0 + c * span / maxf(1, cols - 1)
    56					if team == 1:
    57						x = vs.x - x
    58					var y := bottom - sc * 6.0 if tiny else top + sc * 62.0 + r * (bottom - top - sc * 72.0) / maxf(1, rows - 1)
    59					items.append([y, x, t, team])
    60					if t == D.ARCHER and c == 0 and not tall and not tiny:   # 後排弓兵放箭；直式太窄就不畫箭
    61						archers.append(Vector2(x, y))
    62		items.sort()
    63		# 速度線：每隻身後幾條往外拖的白線
    64		for it in items:
    65			var dirx := -1.0 if it[3] == 0 else 1.0
    66			for k in 3:
    67				var yy: float = it[0] - sc * (10.0 + k * 9.0)
    68				var x0: float = it[1] + dirx * sc * (22.0 + k * 4.0)
    69				draw_line(Vector2(x0, yy), Vector2(x0 + dirx * sc * (26.0 + k * 10.0), yy), Color(1, 1, 1, 0.22 - k * 0.05), maxf(1.5, sc * 1.6), true)
    70		for it in items:
    71			Art.ring(self, Vector2(it[1], it[0]), it[3], it[2], false, sc)
    72		for it in items:
    73			var face := 1.0 if it[3] == 0 else -1.0
    74			var front: bool = absf(it[1] - mid) < (mid - margin) * 0.45
    75			var mood := Art.M_SPARKLE if it[2] == D.CAVALRY else (Art.M_BROWS if front else 0)
    76			Art.unit(self, Vector2(it[1], it[0]), it[2], it[3], face, 2.0 + it[1] * 0.01, 0.42 if front and it[2] != D.ARCHER else (0.25 if it[2] == D.ARCHER else 0.0), 0.0, 1.0, 1.3, sc, false, mood, 0.2 if it[2] == D.CAVALRY else 0.0)
    77		# 中線撞擊光（每一排一個）
    78		var ys := {}
    79		for it in items:
    80			ys[snappedf(it[0], 1.0)] = true
    81		for yk in ys.keys():
    82			var c0 := Vector2(mid, float(yk) - sc * 24.0)
    83			var pts := PackedVector2Array()
    84			for i in 16:
    85				var an := i * TAU / 16.0
    86				pts.append(c0 + Vector2(cos(an), sin(an)) * sc * (16.0 if i % 2 == 0 else 6.0))
    87			draw_colored_polygon(pts, Color(1, 0.92, 0.6, 0.85))
    88			draw_circle(c0, sc * 5.0, Color.WHITE, true, -1.0, true)
    89		# 箭：從每個弓兵的弓往中線飛
    90		for ap: Vector2 in archers:
    91			var dir := 1.0 if ap.x < mid else -1.0
    92			var start := ap + Vector2(dir * sc * 28.0, -sc * 22.0)
    93			var p := Vector2(mid - dir * sc * 18.0, start.y - sc * 8.0)
    94			var tail := p - (p - start).normalized() * sc * 26.0
    95			draw_line(start, tail, Color(1, 1, 1, 0.28), sc * 1.5, true)
    96			draw_line(tail, p, Art.OUT, sc * 3.5, true)
    97			draw_line(tail, p, Color("#d97706"), sc * 2.0, true)
    98			var dv := (p - tail).normalized()
    99			var nv := dv.orthogonal()
   100			draw_colored_polygon(PackedVector2Array([p + dv * sc * 6.0, p + nv * sc * 3.0, p - nv * sc * 3.0]), Color("#e5e7eb"))
   101			var tc := Art.team_color(0 if dir > 0 else 1, false)
   102			draw_colored_polygon(PackedVector2Array([tail, tail - dv * sc * 6.0 + nv * sc * 4.0, tail + dv * sc * 3.0]), tc)
   103			draw_colored_polygon(PackedVector2Array([tail, tail - dv * sc * 6.0 - nv * sc * 4.0, tail + dv * sc * 3.0]), tc)
