   123	static func expect_hits(s, expect: String) -> Array:
   124		var out: Array = []
   125		for e in s.events:
   126			if not e.get("tags", []).has(expect):
   127				continue
   128			var who: int = int(e.get("src", e.get("tgt", -1)))
   129			if who < 0:
   130				continue
   131			var u = s.unit_by_id(who)
   132			if u != null:
   133				out.append(Vector2(u.x, u.y))
   134		return out
