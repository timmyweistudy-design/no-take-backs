   532	## 不能報錯、攻擊事件一定產生演出；圖鑑的 _codex_tick 每段示範都要真的跳字、跳在觸發者身上。
   533	func test_ui_consumers() -> void:
   534		var GS = load("res://scripts/ui/game_screens.gd")
   535		# 畫面腳本有語法錯誤時要紅，不能靜靜跳過後面的檢查（收尾時抓到過一次：79 通過 0 失敗但其實沒跑）
   536		ok(GS != null and GS.can_instantiate(), "畫面腳本（game_screens 繼承鏈）能載入")
   537		if GS == null or not GS.can_instantiate():
   538			return
   539		var g = GS.new()
   540		g.sfx = FakeSfx.new()
   541		var pool := F.training_pool(0)
   542		var attacks := 0
   543		var fx_seen := 0
   544		var kinds := {}
   545		var bad: Array = []
   546		for i in 6:
   547			g.sim = Sim.new(pool[i].copy(), pool[(i * 11 + 5) % pool.size()].mirrored())
   548			g.view = g.ViewBuffer.new(g.sim)
   549			g.atk_hit.clear()
   550			g.state = g.St.BATTLE
   551			g._pump_view()
   552			var guard := 0
   553			while not g.view.finished and guard < 2000:
   554				guard += 1
   555				g.fx.clear()
   556				g._sim_step(true)
   557				var n_att := 0
   558				var srcs := {}
   559				for f in g.fx:
   560					if f.has("src"):
   561						srcs[f["src"]] = int(srcs.get(f["src"], 0)) + 1
   562				for e in g.view.events:
   563					kinds[e["kind"]] = true
   564					if g.event_route(e) == "attack":
   565						n_att += 1
   566						# 逐事件核對：每一次攻擊都要有一個屬於攻擊者的砍擊／箭（Codex 收尾輪 #5）
   567						if int(srcs.get(e["src"], 0)) <= 0:
   568							bad.append("tick%d 單位 %d 的攻擊沒有演出" % [g.view.tick, e["src"]])
   569						else:
   570							srcs[e["src"]] -= 1
   571				attacks += n_att
   572				if n_att > 0:
   573					fx_seen += 1
   574			if g.view.tick != g.sim.tick or not g.sim.finished:
   575				bad.append("第 %d 場畫面沒有播到最後（畫面 %d／模擬 %d）" % [i, g.view.tick, g.sim.tick])
   576		ok(bad.is_empty() and attacks > 100 and kinds.has("rally_on") and kinds.has("death"), "戰鬥畫面消費真實事件：不報錯、攻擊都有演出、緩衝會排空", "%s attacks=%d kinds=%s" % [bad.slice(0, 3), attacks, kinds.keys()])
   577		# 前搖：攻擊者在命中那一格之前就已經開始動作（展示緩衝的目的）
   578		g.sim = Sim.new(army_from(0, [[D.SWORD, 5, 4]]), army_from(1, [[D.SHIELD, 5, 4]]))
   579		g.view = g.ViewBuffer.new(g.sim)
   580		g.atk_hit.clear()
   581		g._pump_view()
   582		var pre_ok := false
   583		for i in 200:
   584			var before_hit := false
   585			for fr in g.view.queue:
   586				for e in fr["events"]:
   587					if g.event_route(e) == "attack" and int(fr["tick"]) == g.view.tick + 1:
   588						before_hit = true
   589			if before_hit:
   590				var u = g.view.units[0]
   591				var hh: int = g.pick_hit(g.atk_hit[u.id], g._disp_tick(), u.type)
   592				var at: float = g.atk_progress(g._disp_tick() - (hh - g.ViewBuffer.DELAY), u.type) if hh >= 0 else 0.0
   593				if at > 0.0 and at < Art.ATK_WINDUP:
   594					pre_ok = true
   595					break
   596			g._sim_step(false)
   597		ok(pre_ok, "命中前一格畫面上已經在前搖")
   598		# 連續反擊（Codex R5 #2）：H 的揮擊不會被 H+1／H+2 的前搖吃掉；揮擊做完才換下一次
   599		var sw_t := D.SWORD
   600		ok(g.pick_hit([10, 11, 12], 10.0, sw_t) == 10 and g.pick_hit([10, 11, 12], 10.9, sw_t) == 10, "連續命中：前一次揮擊做完前不換")
   601		ok(g.pick_hit([10, 12], 11.5, sw_t) == 12 and g.pick_hit([10], 7.9, sw_t) == -1 and g.pick_hit([10], 8.0, sw_t) == 10, "連續命中：揮擊做完換下一次、前搖從命中前 2 tick 開始")
   602		# 播完之後（Codex R5 #1）：經過正式的 _battle_process，最後一格插值走完、展示時鐘繼續讓後搖演完、最後才進結果
   603		g.sim = Sim.new(army_from(0, [[D.SWORD, 5, 4], [D.SWORD, 5, 5]]), army_from(1, [[D.ARCHER, 5, 4]]))
   604		g.view = g.ViewBuffer.new(g.sim)
   605		g.atk_hit.clear()
   606		g.state = g.St.BATTLE
   607		g.speed = 1.0
   608		g.slow_used = true
   609		g.result_delay = 0.0
   610		g._pump_view()
   611		var steps := 0
   612		while not g.view.finished and steps < 4000:
   613			g._battle_process(0.05)
   614			steps += 1
   615		var tail_ok: bool = g.view.finished and g.state == g.St.BATTLE
   616		g._battle_process(0.1)
   617		var d1: float = g._disp_tick()
   618		g._battle_process(0.1)
   619		var d2: float = g._disp_tick()
   620		var pos_ok := true
   621		for u in g.view.units:
   622			var jit := Vector2(float((u.id * 37) % 9 - 4), float((u.id * 53) % 7 - 3))   # _upos 的固定錯開
   623			if u.alive and g._upos(u).distance_to(g.ORIGIN + Vector2(u.x, u.y) * g.CS / 1000.0 + jit) > 0.5:
   624				pos_ok = false
   625		ok(tail_ok and d2 > d1 and d1 > g.view.tick and pos_ok, "播完後展示時鐘繼續走、存活者插值到最後位置", "tail=%s d1=%.2f d2=%.2f tick=%d pos=%s" % [tail_ok, d1, d2, g.view.tick, pos_ok])
   626		# 直接造「最後一格確實有移動、最後一擊剛命中」的狀態（Codex 收尾輪 2 #5）：
   627		# 播完後經 _battle_process，位置要從上一格插值到最後一格，攻擊要經過後搖並完成（進度回到 0）。
   628		g.state = g.St.BATTLE
   629		g.accum = 0.0
   630		var mu = null
   631		for u in g.view.units:
   632			if u.alive:
   633				mu = u
   634				break
   635		var cur := Vector2(mu.x, mu.y)
   636		g.prev_pos[mu.id] = cur - Vector2(600, 0)          # 上一格在左邊 0.6 格
   637		g.atk_hit[mu.id] = [g.view.tick]                   # 最後一格剛命中
   638		var jit2 := Vector2(float((mu.id * 37) % 9 - 4), float((mu.id * 53) % 7 - 3))
   639		var start_dist: float = g._upos(mu).distance_to(g.ORIGIN + cur * g.CS / 1000.0 + jit2)
   640		var saw_recover := false
   641		var done := false
   642		for k in 12:
   643			g._battle_process(0.05)
   644			var hh2: int = g.pick_hit(g.atk_hit[mu.id], g._disp_tick(), mu.type)
   645			var at2: float = g.atk_progress(g._disp_tick() - (hh2 - g.ViewBuffer.DELAY), mu.type) if hh2 >= 0 else 0.0
   646			if at2 > Art.ATK_STRIKE:
   647				saw_recover = true
   648			if saw_recover and at2 == 0.0:
   649				done = true
   650		var end_dist: float = g._upos(mu).distance_to(g.ORIGIN + cur * g.CS / 1000.0 + jit2)
   651		ok(start_dist > 30.0 and end_dist < 0.5 and saw_recover and done, "播完後最後一格的移動插值走完、最後一擊演完後搖",
   652			"start=%.1f end=%.2f recover=%s done=%s" % [start_dist, end_dist, saw_recover, done])
   653		# 圖鑑小劇場真的跳字
   654		var pop_bad: Array = []
   655		for t in D.COUNT:
   656			g._open_codex(t)
   657			for k in g._cx_skills().size():
   658				g._cx_pick_skill(k)
   659				var seen := false
   660				for j in 400:
   661					g._codex_tick(0.05)
   662					if not g.cx_pops.is_empty():
   663						seen = true
   664						break
   665				if not seen:
   666					pop_bad.append(g._cx_skills()[k])
   667		ok(pop_bad.is_empty(), "圖鑑每段小劇場都真的跳字", str(pop_bad))
   668		g.free()
