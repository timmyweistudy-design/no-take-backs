   732			var d: int = power_log[t]
   733			var s := 0
   734			if d > thr:
   735				s = 1
   736			elif d < -thr:
   737				s = -1
   738			if s != 0:
   739				if side != 0 and s != side:
   740					changes += 1
   741				side = s
