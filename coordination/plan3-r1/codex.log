  1344		_reset_place(false)
     1	extends "res://scripts/ui/battle_view.gd"
     2	## 兵種圖鑑（第二輪方案 R3）：五個兵種的故事、擅長／怕什麼、技能說明（數值取自 unit_defs），
     3	## 每個技能有一段用「真的戰鬥模擬」跑的小劇場；派該兵種贏 5 場解鎖老兵觀察筆記。
     4	## 入口：標題選單、擺放時兵種卡右上角的「?」（手把 Select）、結果頁右上角。
     5	
     6	const CX = preload("res://scripts/game/codex.gd")
     7	
     8	const CX_PANEL := Rect2(180, 96, 920, 628)
     9	const CX_BOX := Rect2(596, 318, 474, 267)     # 小劇場畫面
    10	const CX_VIEW := Rect2(2000, 1100, 12000, 6760)   # 小劇場看的戰場範圍（模擬座標，千分之一格）：中間 12×6.76 格，兵才夠大
    11	const CX_PAUSE := 1.2                          # 一段示範結束後停多久再重播（秒）
    12	
    13	var cx_unit := 0
    14	var cx_skill := 0
    15	var cx_sim = null
    16	var cx_acc := 0.0
    17	var cx_ticks := 0
    18	var cx_wait := 0.0
    19	var cx_prev := {}
    20	var cx_atk := {}
    21	var cx_hurt := {}
    22	var cx_pops: Array = []        # 技能觸發時跳出的字：{p, s, t}
    23	var cx_seen := false           # 這一輪示範有沒有出現預期的技能
    24	
    25	
    26	func _open_codex(t: int) -> void:
    27		# 開圖鑑前取消擺放畫面的拖曳／塗兵狀態，不然關掉圖鑑後移動滑鼠會繼續放兵（Codex R3 審查 #3）
    28		painting = false
    29		drag_new = false
    30		drag_from = Vector2i(-1, -1)
    31		cx_unit = clampi(t, 0, D.COUNT - 1)
    32		_cx_pick_skill(0)
    33		_open("codex")
    34	
    35	
    36	func _cx_skills() -> Array:
    37		return CX.unit(cx_unit).get("skills", [])
    38	
    39	
    40	func _cx_pick_unit(t: int) -> void:
    41		cx_unit = t
    42		_cx_pick_skill(0)
    43	
    44	
    45	func _cx_pick_skill(i: int) -> void:
    46		cx_skill = clampi(i, 0, maxi(0, _cx_skills().size() - 1))
    47		_cx_restart()
    48	
    49	
    50	func _cx_restart() -> void:
    51		var sks := _cx_skills()
    52		cx_sim = CX.demo_sim(sks[cx_skill]) if not sks.is_empty() else null
    53		cx_acc = 0.0
    54		cx_ticks = 0
    55		cx_wait = 0.0
    56		cx_prev.clear()
    57		cx_atk.clear()
    58		cx_hurt.clear()
    59		cx_pops.clear()
    60		cx_seen = false
    61	
    62	
    63	## 每幀推進小劇場（20 tick／秒，跟正式戰鬥同速）。
    64	func _codex_tick(delta: float) -> void:
    65		for p in cx_pops:
    66			p["t"] += delta
    67		cx_pops = cx_pops.filter(func(p): return p["t"] < 1.1)
    68		if cx_sim == null:
    69			return
    70		var sk: String = _cx_skills()[cx_skill]
    71		var dm: Dictionary = CX.skill(sk).get("demo", {})
    72		var limit := int(dm.get("ticks", 120))
    73		if cx_sim.finished or cx_ticks >= limit:
    74			cx_wait += delta
    75			if cx_wait >= CX_PAUSE:
    76				_cx_restart()
    77			return
    78		cx_acc += delta
    79		while cx_acc >= 0.05 and not cx_sim.finished and cx_ticks < limit:
    80			cx_acc -= 0.05
    81			for u in cx_sim.units:
    82				cx_prev[u.id] = Vector2(u.x, u.y)
    83			cx_sim.step()
    84			cx_ticks += 1
    85			for e in cx_sim.events:
    86				if e.has("dmg"):
    87					cx_atk[e["src"]] = time
    88					cx_hurt[e["tgt"]] = time
    89			for hp in CX.expect_hits(cx_sim, str(dm.get("expect", ""))):
    90				cx_seen = true
    91				cx_pops.append({"p": hp, "s": CX.text(CX.skill(sk), "", L.lang) + "！", "t": 0.0})
    92				if cx_pops.size() > 4:
    93					cx_pops.pop_front()
    94	
    95	
    96	func _cx_pos(u) -> Vector2:
    97		var cur := Vector2(u.x, u.y)
    98		var p: Vector2 = cx_prev.get(u.id, cur).lerp(cur, clampf(cx_acc / 0.05, 0.0, 1.0))
    99		return _cx_map(p)
   100	
   101	
   102	func _cx_map(p: Vector2) -> Vector2:
   103		var q := CX_BOX.position + (p - CX_VIEW.position) * (CX_BOX.size.x / CX_VIEW.size.x)
   104		return q.clamp(CX_BOX.position + Vector2(10, 30), CX_BOX.end - Vector2(10, 4))
   105	
   106	
   107	## 依寬度換行：中文一字一字量，英文以空白為界。
   108	func _wrap(s: String, size: int, width: float) -> String:
   109		var out: PackedStringArray = []
   110		for para in s.split("\n"):
   111			var line := ""
   112			var tokens: Array = []
   113			var word := ""
   114			for ch in para:
   115				if ch == " ":
   116					tokens.append(word + " ")
   117					word = ""
   118				elif ch.unicode_at(0) > 0x2E80:
   119					if word != "":
   120						tokens.append(word)
   121						word = ""
   122					tokens.append(ch)
   123				else:
   124					word += ch
   125			if word != "":
   126				tokens.append(word)
   127			for tk in tokens:
   128				if line != "" and font.get_string_size(line + tk, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x > width:
   129					out.append(line.strip_edges(false, true))
   130					line = tk.strip_edges(true, false) if tk == " " else tk
   131				else:
   132					line += tk
   133			out.append(line)
   134		return "\n".join(out)
   135	
   136	
   137	## 一組段落要放進 max_h 高度：從 size 開始縮，直到換行後的總高度放得下（段落間距 gap）。最小 10px。
   138	func _fit_block(texts: Array, size: int, width: float, max_h: float, gap: float) -> int:
   139		var sz := size
   140		while sz > 10:
   141			var h := 0.0
   142			for tx in texts:
   143				h += (_wrap(tx, sz, width).count("\n") + 1) * sz * 1.3 + gap
   144			if h - gap <= max_h:
   145				return sz
   146			sz -= 1
   147		return sz
   148	
