  1326	func _next_puzzle() -> void:
  1327		var list: Array = PZ.tutorials() if mode == Mode.TUTORIAL else PZ.puzzles()
  1328		for i in list.size():
  1329			if list[i]["id"] == puzzle_id and i + 1 < list.size():
  1330				puzzle_id = list[i + 1]["id"]
  1331				_start_mode(mode)
  1332				return
  1333		if mode == Mode.TUTORIAL and not PZ.puzzles().is_empty():
  1334			puzzle_id = PZ.puzzles()[0]["id"]
  1335			_start_mode(Mode.PUZZLE)
  1336			return
  1337		_go_title()
