   160	## 字太寬就縮小（英文、大字設定時避免截字；最小 9px）。
   161	func fit(s: String, size: int, maxw: float, bold := false) -> int:
   162		var fnt := font_bold if bold else font
   163		var sz := size
   164		var w := 0.0
   165		for ln in s.split("\n"):
   166			w = maxf(w, fnt.get_string_size(ln, HORIZONTAL_ALIGNMENT_LEFT, -1, sz).x)
   167		while w > maxw and sz > 9:
   168			sz -= 1
   169			w = 0.0
   170			for ln in s.split("\n"):
   171				w = maxf(w, fnt.get_string_size(ln, HORIZONTAL_ALIGNMENT_LEFT, -1, sz).x)
   172		return sz
