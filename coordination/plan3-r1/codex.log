     1	extends RefCounted
     2	## 展示緩衝（第二輪方案 R5、§3）：戰鬥畫面固定比模擬晚 DELAY 個 tick。
     3	## 模擬先跑，每個 tick 存一份「畫面需要的狀態」快照＋事件；畫面依展示時鐘一格一格播。
     4	## 這樣命中事件在畫面上發生前 DELAY 個 tick 就知道了，可以先演前搖；
     5	## 血量、死亡、音效、HUD、跳字全部讀同一個延後的快照，所以一起延後，不會只有動作延後。
     6	## 純演出：模擬本身的計算、結果、指紋完全不受影響。
     7	
     8	const DELAY := 2
     9	
    10	class VUnit:
    11		var id: int
    12		var team: int
    13		var type: int
    14		var x: int
    15		var y: int
    16		var hp: int
    17		var max_hp: int
    18		var alive: bool
    19		var stealth: int
    20		var stun: int
    21		var fx: int
    22		var fy: int
    23		var mx: int
    24		var my: int
    25		var charge: int
    26		var target: int
    27	
    28	var units: Array = []          # 跟 sim.units 同順序
    29	var tick := 0
    30	var rally := [false, false]
    31	var frenzy := false
    32	var events: Array = []         # 這一格（畫面上剛發生）的事件
    33	var finished := false          # 畫面已經播到模擬的最後一 tick
    34	var budget := 100
    35	var _power := [0, 0]
    36	var _alive := [0, 0]
    37	var _by_id := {}
    38	var queue: Array = []          # 還沒播的快照（模擬已經跑到、畫面還沒到）
    39	
    40	## 把模擬當下的狀態存成一份快照。
    41	static func capture(sim) -> Dictionary:
    42		var us: Array = []
    43		for u in sim.units:
    44			us.append([u.id, u.team, u.type, u.x, u.y, u.hp, u.max_hp, u.alive, u.stealth, u.stun, u.fx, u.fy, u.mx, u.my, u.charge, u.target])
    45		return {"tick": sim.tick, "units": us, "events": sim.events.duplicate(true), "rally": sim.rally.duplicate(),
    46			"frenzy": sim.frenzy, "finished": sim.finished, "power": [sim.power(0), sim.power(1)],
    47			"alive": [sim.alive_count(0), sim.alive_count(1)]}
    48	
    49	func _init(sim = null) -> void:
    50		if sim != null:
    51			budget = sim.budget
    52			apply(capture(sim))
    53			events = []
    54	
    55	func apply(fr: Dictionary) -> void:
    56		var us: Array = fr["units"]
    57		if units.size() != us.size():
    58			units.clear()
    59			_by_id.clear()
    60			for i in us.size():
    61				var v := VUnit.new()
    62				units.append(v)
    63		for i in us.size():
    64			var a: Array = us[i]
    65			var v: VUnit = units[i]
    66			v.id = a[0]; v.team = a[1]; v.type = a[2]; v.x = a[3]; v.y = a[4]; v.hp = a[5]; v.max_hp = a[6]
    67			v.alive = a[7]; v.stealth = a[8]; v.stun = a[9]; v.fx = a[10]; v.fy = a[11]; v.mx = a[12]; v.my = a[13]
    68			v.charge = a[14]; v.target = a[15]
    69			_by_id[v.id] = v
    70		tick = fr["tick"]
    71		events = fr["events"]
    72		rally = fr["rally"]
    73		frenzy = fr["frenzy"]
    74		finished = fr["finished"]
    75		_power = fr["power"]
    76		_alive = fr["alive"]
    77	
    78	func power(t: int) -> int:
    79		return _power[t]
    80	
    81	func alive_count(t: int) -> int:
    82		return _alive[t]
    83	
    84	func unit_by_id(id: int):
    85		return _by_id.get(id)
    86	
    87	## 模擬往前跑，直到緩衝裡有 DELAY 份還沒播的快照（或模擬結束）。回傳這次新加的快照，給前搖預告用。
    88	func pump(sim) -> Array:
    89		var added: Array = []
    90		while queue.size() < DELAY and not sim.finished:
    91			sim.step()
    92			var fr := capture(sim)
    93			queue.append(fr)
    94			added.append(fr)
    95		return added
    96	
    97	## 畫面前進一格；沒有可播的就回傳 false。
    98	func advance() -> bool:
    99		if queue.is_empty():
