   151	static func validate() -> Array:
   152		var errs: Array = []
   153		var d := data()
   154		if int(d.get("schema_version", 0)) != 1:
   155			errs.append("schema_version 不是 1")
   156		var units: Array = d.get("units", [])
   157		if units.size() != D.COUNT:
   158			errs.append("兵種數 %d ≠ %d" % [units.size(), D.COUNT])
   159		var ids := {}
   160		var used_skills := {}
   161		for u in units:
   162			ids[int(u["id"])] = true
   163			for f in ["role", "story", "tagline", "good", "bad", "veteran"]:
   164				for suf in ["zh", "en"]:
   165					if str(u.get("%s_%s" % [f, suf], "")) == "":
   166						errs.append("兵種 %d 缺 %s_%s" % [int(u["id"]), f, suf])
   167			for sk in u.get("skills", []):
   168				used_skills[sk] = true
   169				if skill(sk).is_empty():
   170					errs.append("兵種 %d 的技能 %s 不存在" % [int(u["id"]), sk])
   171		for t in D.COUNT:
   172			if not ids.has(t):
   173				errs.append("缺兵種 %d" % t)
   174		for sk in d.get("skills", {}):
   175			if not used_skills.has(sk):
   176				errs.append("技能 %s 沒有兵種使用" % sk)
   177			var s: Dictionary = d["skills"][sk]
   178			for f in ["zh", "en", "desc_zh", "desc_en"]:
   179				if str(s.get(f, "")) == "":
   180					errs.append("技能 %s 缺 %s" % [sk, f])
   181			for f in ["desc_zh", "desc_en"]:
   182				for m in _re().search_all(str(s.get(f, ""))):
   183					if value(m.get_string(2)) == null:
   184						errs.append("技能 %s 的 %s 引用不存在的常數 %s" % [sk, f, m.get_string(2)])
   185			var dm: Dictionary = s.get("demo", {})
   186			if dm.is_empty() or str(dm.get("expect", "")) == "":
   187				errs.append("技能 %s 沒有示範或沒有 expect" % sk)
   188		return errs
