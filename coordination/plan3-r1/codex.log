     1	extends SceneTree
     2	## 平衡工具 2.0（優化方案 B2、A2、L2）。由 tools/balance.sh 多行程分片呼叫，每場一行 JSON（前綴 "R "）。
     3	##   --mode=matrix    純兵種 60 金方陣 5×5（剋制）
     4	##   --mode=league    訓練池 200 套，每套對 12 個對手、交換左右
     5	##   --mode=turns     輪流落子先後手測試（--rule=cap10|snake5|snake5c，--games=N）
     6	##   --mode=search    爬山搜尋萬用陣（對保留池評估）
     7	##   --mode=counter   離線反制庫：每個原型陣找訓練池裡最能剋它的陣型
     8	##   --mode=countersearch --target=<代碼>  針對一個（疑似萬用）陣型爬山找反制
     9	##   --shard=i --shards=N
    10	
    11	const D = preload("res://scripts/core/unit_defs.gd")
    12	const Army = preload("res://scripts/core/army.gd")
    13	const Sim = preload("res://scripts/core/battle_sim.gd")
    14	const F = preload("res://scripts/core/formations.gd")
    15	const AIT = preload("res://scripts/core/ai_turns.gd")
    16	const TP = preload("res://scripts/core/turn_placement.gd")
    17	const AI = preload("res://scripts/core/ai_army.gd")
    18	
    19	var args := {}
    20	
    21	func _init() -> void:
    22		for a in OS.get_cmdline_user_args():
    23			if a.begins_with("--") and "=" in a:
    24				var kv := a.substr(2).split("=", true, 1)
    25				args[kv[0]] = kv[1]
    26		var shard := int(args.get("shard", "0"))
    27		var shards := int(args.get("shards", "1"))
    28		match args.get("mode", "league"):
    29			"matrix": matrix(shard, shards)
    30			"league": league(shard, shards)
    31			"turns": turns(shard, shards)
    32			"search": search(shard, shards)
    33			"counter": counter(shard, shards)
    34			"countersearch": countersearch(shard, shards)
    35		quit(0)
    36	
    37	func emit(d: Dictionary) -> void:
    38		d["digest"] = D.data_digest()
    39		print("R ", JSON.stringify(d))
    40	
    41	## 打一場：a 是藍方陣型（team 0）、b 也是以藍方表示的陣型（會鏡像成紅方）。回傳以 a 的角度的結果。
    42	func fight(a: Army, b: Army) -> Dictionary:
    43		var s := Sim.new(a.copy(), b.mirrored())
    44		s.fast = true
    45		s.run_to_end()
    46		var m: Dictionary = s.suspense()
    47		var res := 0
    48		if s.winner == 0:
    49			res = 1
    50		elif s.winner == 1:
    51			res = -1
    52		var rem := 0
    53		if s.winner >= 0:
    54			rem = s.power(s.winner) * 100 / (s.budget * 1000)
    55		return {"res": res, "ticks": s.tick, "rem": rem, "timeout": s.reason.begins_with("時間到"),
    56			"lc": m["lead_changes"], "lock": m["lock_ratio_permille"], "swing": m["max_swing_pct"]}
    57	
    58	func block(t: int, gold: int) -> Army:
    59		var a := Army.new(0, 100)
    60		var n := gold / D.cost(t)
    61		var cols := [5, 4, 3, 2, 1, 0] if t != D.ARCHER else [0, 1, 2, 3, 4, 5]
    62		var rows := [4, 3, 5, 2, 6, 1, 7, 0, 8]
    63		var k := 0
    64		for c in cols:
    65			for r in rows:
    66				if k < n:
    67					a.units.append({"type": t, "col": c, "row": r})
    68					k += 1
    69		return a
    70	
    71	func matrix(shard: int, shards: int) -> void:
    72		var idx := 0
    73		for i in D.COUNT:
    74			for j in D.COUNT:
    75				if i == j:
    76					continue
    77				idx += 1
    78				if idx % shards != shard:
    79					continue
    80				var r := fight(block(i, 60), block(j, 60))
    81				r["mode"] = "matrix"; r["a"] = i; r["b"] = j
    82				emit(r)
    83	
    84	func league(shard: int, shards: int) -> void:
    85		var pool := F.training_pool(0)
    86		for i in pool.size():
    87			if i % shards != shard:
    88				continue
    89			for k in 12:
    90				var j := (i * 37 + k * 53 + 1) % pool.size()
    91				if j == i:
    92					j = (j + 1) % pool.size()
    93				# 交換左右各打一次：i 當藍方、i 當紅方（結果都以 i 的角度記錄）
    94				for side in 2:
    95					var r := fight(pool[i], pool[j]) if side == 0 else fight(pool[j], pool[i])
    96					if side == 1:
    97						r["res"] = -r["res"]
    98					r["mode"] = "league"; r["a"] = i; r["b"] = j; r["k"] = k; r["side"] = side; r["comp"] = F.composition(pool[i])
    99					emit(r)
   100	
   101	func turns(shard: int, shards: int) -> void:
   102		var rule: String = args.get("rule", "cap10")
   103		var games := int(args.get("games", "400"))   # 200 組×（同種子交換先手）
   104		var level := int(args.get("level", "1"))
   105		var rng := RandomNumberGenerator.new()
   106		for g in games:
   107			if g % shards != shard:
   108				continue
   109			# 成對：同一個種子打兩場，只交換先手（隔離先後手效果）
   110			rng.seed = 424242 + (g / 2) * 104729
   111			var first := g % 2
   112			var tp := TP.new(Army.new(0, 100), Army.new(1, 100), first, rule)
   113			var guard := 0
   114			while not tp.done() and guard < 100:
   115				guard += 1
   116				AIT.play_turn(tp, rng, level)
   117			var s := Sim.new(tp.armies[0], tp.armies[1])
   118			s.fast = true
   119			s.run_to_end()
   120			var first_won := 0
   121			if s.winner == first:
   122				first_won = 1
   123			elif s.winner == 1 - first:
   124				first_won = -1
   125			emit({"mode": "turns", "rule": rule, "game": g, "first": first, "first_won": first_won,
   126				"handoffs": tp.handoffs, "spent0": tp.armies[0].spent(), "spent1": tp.armies[1].spent(), "ticks": s.tick, "level": level})
   127	
   128	func fitness(a: Army, opps: Array) -> float:
   129		var w := 0.0
   130		for o in opps:
   131			var r := fight(a, o)
   132			w += 1.0 if r["res"] == 1 else (0.5 if r["res"] == 0 else 0.0)
   133			var r2 := fight(o, a)
   134			w += 1.0 if r2["res"] == -1 else (0.5 if r2["res"] == 0 else 0.0)
   135		return w / (opps.size() * 2)
   136	
   137	func mutate(a: Army, rng: RandomNumberGenerator) -> Army:
   138		var b: Army = a.copy()
   139		var op := rng.randi_range(0, 2)
   140		if b.units.is_empty():
   141			op = 2
   142		if op == 0:
   143			# 換一隻的兵種（守預算）
   144			var i := rng.randi_range(0, b.units.size() - 1)
   145			var old: int = b.units[i]["type"]
   146			var t := rng.randi_range(0, 4)
   147			if b.spent() - D.cost(old) + D.cost(t) <= 100:
   148				b.units[i]["type"] = t
   149		elif op == 1:
   150			# 移動一隻
   151			var i := rng.randi_range(0, b.units.size() - 1)
   152			var c := rng.randi_range(0, 5)
   153			var r := rng.randi_range(0, 8)
   154			if b.index_at(c, r) == -1:
   155				b.units[i]["col"] = c
   156				b.units[i]["row"] = r
   157		else:
   158			# 拿掉一隻、補別種
   159			if not b.units.is_empty():
   160				b.units.remove_at(rng.randi_range(0, b.units.size() - 1))
   161			var t := rng.randi_range(0, 4)
   162			F.place_styled(b, t, "role", rng)
   163		return b
   164	
   165	func search(shard: int, shards: int) -> void:
   166		var iters := int(args.get("iters", "12"))
   167		var nopp := int(args.get("opps", "24"))
   168		var hold := F.holdout_pool(0)
   169		var spool := F.search_pool(0)
   170		var opps: Array = []
   171		for k in nopp:
   172			opps.append(spool[(k * 2 + shard) % spool.size()])
   173		var rng := RandomNumberGenerator.new()
   174		rng.seed = 777 + shard * 1009
   175		var train := F.training_pool(0)
   176		var cur: Army = train[rng.randi_range(0, train.size() - 1)].copy()
   177		var cur_f := fitness(cur, opps)
   178		for it in iters:
   179			var cand := mutate(cur, rng)
   180			var f := fitness(cand, opps)
   181			if f >= cur_f:
   182				cur = cand
   183				cur_f = f
   184		# 最後對「沒參與演化」的保留池驗證
   185		var full := fitness(cur, hold)
   186		emit({"mode": "search", "shard": shard, "fit_sample": cur_f, "fit_holdout": full, "code": cur.to_code(), "comp": F.composition(cur)})
   187	
   188	## 反制搜尋：從訓練池不同起點爬山，找能打贏 target 的陣型。
   189	func countersearch(shard: int, shards: int) -> void:
   190		var target := Army.new(0, 100)
   191		if target.load_code(args.get("target", "")) != "":
   192			emit({"mode": "countersearch", "shard": shard, "error": "bad target"})
   193			return
   194		var rng := RandomNumberGenerator.new()
   195		rng.seed = 31337 + shard * 7717
   196		var train := F.training_pool(0)
   197		var cur: Army = train[(shard * 13) % train.size()].copy()
   198		var cur_f := fitness(cur, [target])
   199		for it in int(args.get("iters", "20")):
   200			var cand := mutate(cur, rng)
   201			var f := fitness(cand, [target])
   202			if f >= cur_f:
   203				cur = cand
   204				cur_f = f
   205		emit({"mode": "countersearch", "shard": shard, "fit": cur_f, "code": cur.to_code(), "comp": F.composition(cur)})
   206	
   207	## 離線反制庫：原型陣（AI 模板×種子）→ 訓練池中勝它最多的陣型代碼。
   208	func counter(shard: int, shards: int) -> void:
   209		var rng := RandomNumberGenerator.new()
   210		var train := F.training_pool(0)
   211		for ti in AI.TEMPLATES.size():
   212			if ti % shards != shard:
   213				continue
   214			rng.seed = 5150 + ti
   215			var proto: Army = AI.build(0, 100, rng, ti)["army"]
   216			var best := -1
   217			var best_f := -1.0
   218			for j in range(0, train.size(), 2):
   219				var f := fitness(train[j], [proto])
   220				if f > best_f:
   221					best_f = f
   222					best = j
   223			emit({"mode": "counter", "template": ti, "name": AI.TEMPLATES[ti]["name"], "proto_comp": F.composition(proto),
   224				"best": best, "best_fit": best_f, "code": train[best].to_code()})

