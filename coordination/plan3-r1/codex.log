    66	var frenzy := false
    67	var rally := [false, false]    # 這一 tick 哪一隊在「背水」（畫面提示用；計算用的是第④步當下的值）
    68	var power_log: PackedInt64Array = PackedInt64Array()   # 每 tick 的（藍戰力−紅戰力），懸念指標用
    69	var _hash := HashingContext.new()
    70	var _last_rank := 99          # 上一次 _choose_target 選中目標的優先級（1＝嘲諷）
    71	var _was_stealth := {}         # 刺客上一 tick 是否潛行（現形事件用）
    72	var _was_rally := [false, false]          # 上一 tick 哪一隊在背水（背水開／關事件用）
    73	var fast := false              # 平衡工具用：不算每 tick 指紋（結果完全一樣，只是沒有指紋）
    74	
    75	func _init(army0, army1) -> void:
    76		budget = army0.budget
    77		_hash.start(HashingContext.HASH_SHA256)
    78		var raw: Array = []
    79		for a in [army0, army1]:
    80			for u in a.units:
    81				raw.append([a.team * 1000 + u["row"] * COLS + u["col"], a.team, u])
    82		raw.sort_custom(func(p, q): return p[0] < q[0])
    83		for r in raw:
    84			var u = r[2]
    85			var s: Dictionary = D.STATS[u["type"]]
    86			var n := Unit.new()
    87			n.id = r[0]
    88			n.team = r[1]
    89			n.type = u["type"]
    90			n.x = u["col"] * CELL + CELL / 2
    91			n.y = u["row"] * CELL + CELL / 2
    92			n.hp = s["hp"]
    93			n.max_hp = s["hp"]
    94			n.cost = s["cost"]
    95			n.reach = s["reach"]
    96			n.speed = s["speed"]
    97			n.atk = s["atk"]
    98			n.cd_base = s["cd"]
    99			n.fx = 1000 if n.team == 0 else -1000
   100			if n.type == D.ASSASSIN:
   101				n.stealth = D.STEALTH_TICKS
   102			units.append(n)
   103		var hdr := PackedInt64Array([D.RULES_VERSION_INT, budget, units.size()])
   104		_hash.update(hdr.to_byte_array())
   105		_hash.update(D.data_digest().to_utf8_buffer())
   106		if alive_count(0) == 0 or alive_count(1) == 0:
   107			_finish(-1, "有一方沒有兵")
   108	
   109	func alive_count(team: int) -> int:
   110		var c := 0
   111		for u in units:
   112			if u.alive and u.team == team:
   113				c += 1
   114		return c
   115	
   116	## 剩餘戰力＝Σ⌊兵價×剩血×1000÷滿血⌋（企劃 §2.4）。
   117	func power(team: int) -> int:
   118		var p := 0
   119		for u in units:
   120			if u.alive and u.team == team:
   121				p += u.cost * u.hp * 1000 / u.max_hp
   122		return p
   123	
   124	func run_to_end() -> void:
   125		while not finished:
   126			step()
   127	
   128	# ───────────────────────── 一個 tick ─────────────────────────
   129	func step() -> void:
   130		if finished:
   131			return
   132		tick += 1
   133		frenzy = tick >= FRENZY_TICK
   134		events = []
   135		var n := units.size()
   136	
   137		# ① 快照（之後的選目標、碰撞都只讀這些陣列）
   138		var sx := PackedInt64Array()
   139		var sy := PackedInt64Array()
   140		var st := PackedInt64Array()     # 隊伍
   141		var sk := PackedInt64Array()     # 兵種
   142		var sh := PackedInt64Array()     # 血
   143		var sv := PackedByteArray()      # 可被選為目標（活著且沒潛行）
   144		sx.resize(n); sy.resize(n); st.resize(n); sk.resize(n); sh.resize(n); sv.resize(n)
   145		for i in n:
   146			var u := units[i]
   147			sx[i] = u.x
   148			sy[i] = u.y
   149			st[i] = u.team
   150			sk[i] = u.type
   151			sh[i] = u.hp
   152			sv[i] = 1 if (u.alive and u.stealth == 0) else 0
   153	
   154		# ② 選目標＋提出移動
   155		var nx := sx.duplicate()
   156		var ny := sy.duplicate()
   157		var new_target := PackedInt64Array()
   158		var new_fx := PackedInt64Array()
   159		var new_fy := PackedInt64Array()
   160		var new_lock := PackedInt64Array()
   161		new_target.resize(n); new_fx.resize(n); new_fy.resize(n); new_lock.resize(n)
   162		for i in n:
   163			var u := units[i]
   164			new_target[i] = u.target
   165			new_fx[i] = u.fx
   166			new_fy[i] = u.fy
   167			new_lock[i] = -1
   168			u.mx = 0
   169			u.my = 0
   170			if not u.alive:
   171				continue
   172			var t := _choose_target(i, sx, sy, st, sk, sh, sv)
   173			new_target[i] = t
   174			# 技能事件（只給畫面與圖鑑用，不進指紋）：被盾兵嘲諷吸走
   175			if t != -1 and t != u.target and _last_rank == 1:
   176				events.append({"kind": "taunt", "src": units[t].id, "tgt": u.id, "tags": ["taunt"]})
   177			if t == -1 or u.stun > 0:
   178				continue
   179			var tg := units[t]
   180			var reach := u.reach
   181			var d2 := M.dist2(u.x, u.y, tg.x, tg.y)
   182			var dest_x := tg.x
   183			var dest_y := tg.y
   184			var stop_at := reach - 50
   185			var flanking := false
   186			if u.type == D.ASSASSIN and u.stealth > 0:
   187				# 潛行中繞到目標背後（目的地夾在場內）
   188				dest_x = clampi(tg.x - tg.fx * D.BEHIND_DIST / 1000, EDGE, W - EDGE)
   189				dest_y = clampi(tg.y - tg.fy * D.BEHIND_DIST / 1000, EDGE, H - EDGE)
   190				stop_at = 0
   191			elif u.type == D.CAVALRY:
   192				var wp := _flank_waypoint(i, t)
   193				if wp.x >= 0:
   194					if d2 <= reach * reach:
   195						u.nav = 2            # 敵人已在射程內：結束繞翼直接開打，不卡在未完成狀態
   196					else:
   197						dest_x = wp.x
   198						dest_y = wp.y
   199						stop_at = 0
   200						flanking = true
   201			var need_move := d2 > reach * reach or (u.type == D.ASSASSIN and u.stealth > 0) or flanking
   202			if u.type == D.CAVALRY and not flanking:
   203				# 追擊遲滯：已經在追就追到 reach−CHASE_HYST 才停；停著的要超出 reach 才起步
   204				need_move = cav_chase(u.chasing, d2, reach)
   205				stop_at = reach - D.CHASE_HYST
   206				u.chasing = need_move
   207			if need_move:
   208				var dx := dest_x - u.x
   209				var dy := dest_y - u.y
   210				var l := M.isqrt(dx * dx + dy * dy)
   211				var spd := u.speed
   212				if u.slow > 0:
   213					spd = spd * D.SLOW_NUM / D.SLOW_DEN
   214				var stp := mini(spd, l - stop_at)
   215				if stp > 0 and l > 0:
   216					u.mx = dx * stp / l
   217					u.my = dy * stp / l
   218					nx[i] = u.x + u.mx
   219					ny[i] = u.y + u.my
   220			# 面向（優化方案 B1）：交戰中鎖定，只有換目標才重算；不交戰時朝移動方向
   221			var engage := reach + CELL
   222			if d2 <= engage * engage:
   223				new_lock[i] = t
   224				if u.face_lock != t:
   225					var f := M.unit1000(tg.x - u.x, tg.y - u.y)
   226					if f != Vector2i.ZERO:
   227						new_fx[i] = f.x
   228						new_fy[i] = f.y
   229			else:
   230				var f2 := M.unit1000(u.mx, u.my)
   231				if f2 != Vector2i.ZERO:
   232					new_fx[i] = f2.x
   233					new_fy[i] = f2.y
   234	
   235		# ③ 統一解碰撞（固定兩輪，所有推力加總後一次套用）
   236		for _pass in 2:
   237			var px := PackedInt64Array()
   238			var py := PackedInt64Array()
   239			px.resize(n)
   240			py.resize(n)
   241			for i in n:
   242				if sv[i] == 0:
   243					continue
   244				var xi := nx[i]
   245				var yi := ny[i]
   246				for j in range(i + 1, n):
   247					if sv[j] == 0:
   248						continue
   249					var dx := nx[j] - xi
   250					var dy := ny[j] - yi
   251					if dx >= MIN_SEP or dx <= -MIN_SEP or dy >= MIN_SEP or dy <= -MIN_SEP:
   252						continue
   253					var d2 := dx * dx + dy * dy
   254					if d2 >= MIN_SEP * MIN_SEP:
   255						continue
   256					var d := M.isqrt(d2)
   257					var ux := 0
   258					var uy := 0
   259					if d == 0:
   260						# 零距離：不同隊左右分開（藍往左、紅往右）；同隊上下分開
   261						if st[i] != st[j]:
   262							ux = 1000 if st[i] == 0 else -1000
   263						else:
   264							uy = 1000
   265					else:
   266						ux = dx * 1000 / d
   267						uy = dy * 1000 / d
   268					var half := (MIN_SEP - d) / 2 + 1
   269					px[i] -= ux * half / 1000
   270					py[i] -= uy * half / 1000

