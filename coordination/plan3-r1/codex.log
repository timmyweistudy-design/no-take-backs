    25	## 選一個兵種。level：0 簡單（隨機性高、不太看對方）、1 普通、2 困難。
    26	static func choose_type(mine: Army, enemy_units: Array, budget_left: int, rng: RandomNumberGenerator, level := 1) -> int:
    27		var best := -1
    28		var best_s := -1.0e9
    29		var have := [0, 0, 0, 0, 0]
    30		for u in mine.units:
    31			have[u["type"]] += 1
    32		var front: int = have[D.SWORD] + have[D.SHIELD]
    33		for t in D.COUNT:
    34			if D.cost(t) > budget_left:
    35				continue
    36			var s := 0.0
    37			var react := 0.4 if level == 0 else (1.0 if level == 1 else 1.6)
    38			for e in enemy_units:
    39				s += counter_score(t, e["type"]) * react
    40				# 已經有的兵也要能應付對方
    41			for u in mine.units:
    42				s -= 0.15 * (1 if u["type"] == t else 0)   # 避免全押同一種
    43			if front < 3 and (t == D.SWORD or t == D.SHIELD):
    44				s += 1.2
    45			s += float(D.cost(t)) * 0.05                       # 錢花得完
    46			var noise := 1.5 if level == 0 else (0.6 if level == 1 else 0.25)
    47			s += rng.randf() * noise
    48			if s > best_s:
    49				best_s = s
    50				best = t
    51		return best
