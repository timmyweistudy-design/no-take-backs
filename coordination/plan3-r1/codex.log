   193					cav_stunned = s.units[0].stun == D.STUN_TICKS and s.units[0].charge == 0
   194		ok(seen_brace and cav_stunned, "盾兵頂住衝鋒（騎兵被暈 20 tick、衝鋒歸零）")
   195		# 三條專屬倍率（平衡方案 F1）：拒馬、皮甲、射刺客加碼
   196		var exp_anticav: int = D.STATS[D.SHIELD]["atk"] * D.ANTICAV_NUM / D.ANTICAV_DEN
   197		var exp_hide: int = D.STATS[D.ARCHER]["atk"] * D.HIDE_ARROW_NUM / D.HIDE_ARROW_DEN
   198		var exp_alert: int = D.STATS[D.ARCHER]["atk"] * D.ALERT_NUM / D.ALERT_DEN
   199		var got := {}
   200		for pair in [[D.SHIELD, D.CAVALRY], [D.ARCHER, D.CAVALRY], [D.ARCHER, D.ASSASSIN]]:
   201			var q = Sim.new(army_from(0, [[pair[0], 5, 4]]), army_from(1, [[pair[1], 5, 4]]))
   202			for i in 400:
   203				q.step()
   204				for ev in q.events:
   205					if ev.has("src") and q.unit_by_id(ev["src"]).team == 0 and not got.has(pair):
   206						got[pair] = ev["dmg"]
   207		ok(got.get([D.SHIELD, D.CAVALRY], -1) == exp_anticav, "拒馬：盾兵打騎兵 %d" % exp_anticav, str(got.get([D.SHIELD, D.CAVALRY], -1)))
   208		ok(got.get([D.ARCHER, D.CAVALRY], -1) == exp_hide, "皮甲：弓箭射騎兵 %d" % exp_hide, str(got.get([D.ARCHER, D.CAVALRY], -1)))
   209		ok(got.get([D.ARCHER, D.ASSASSIN], -1) == exp_alert, "警覺：弓箭射刺客 %d" % exp_alert, str(got.get([D.ARCHER, D.ASSASSIN], -1)))
   210		# 刺客開場潛行，弓箭手打不到
   211		s = Sim.new(army_from(0, [[D.ARCHER, 0, 4]]), army_from(1, [[D.ASSASSIN, 5, 4]]))
   212		var first_seen := -1
   213		for i in 100:
   214			s.step()
   215			if first_seen == -1 and s.units[0].target != -1:
   216				first_seen = s.tick
   217		ok(first_seen == D.STEALTH_TICKS + 1, "刺客潛行 %d tick 內不能被指定" % D.STEALTH_TICKS, "first_seen=%d" % first_seen)
   218		# 劍士被刺客打會反擊
   219		s = Sim.new(army_from(0, [[D.SWORD, 5, 4]]), army_from(1, [[D.ASSASSIN, 5, 4]]))
   220		var counters := 0
   221		var bad := false
   222		for i in 300:
   223			s.step()
   224			var per_tick := 0
   225			for ev in s.events:
   226				if ev.get("kind") == "counter":
   227					per_tick += 1
   228					if ev["dmg"] != D.STATS[D.SWORD]["atk"] * D.COUNTER_PCT / 100:
   229						bad = true
   230			if per_tick > 1:
   231				bad = true
   232			counters += per_tick
   233		ok(counters > 0 and not bad, "劍士反擊刺客（傷害照 COUNTER_PCT、每 tick 最多一次）", "counters=%d" % counters)
