   178			size = fit(s, size, maxw, bold)
   179		var lines := s.split("\n")
   180		for i in lines.size():
   181			var w := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x if center else 0.0
   182			var q := p + Vector2(-w / 2, i * size * 1.3 + size * 0.85)
   183			draw_string_outline(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, 5, Color(0, 0, 0, c.a * 0.75))
   184			draw_string(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, c)
