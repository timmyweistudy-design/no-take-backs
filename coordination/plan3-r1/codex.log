    38	func in_zone(col: int, row: int) -> bool:
    39		if row < 0 or row >= ROWS:
    40			return false
    41		if team == 0:
    42			return col >= 0 and col < ZONE
    43		return col >= COLS - ZONE and col < COLS
    44	
    45	func index_at(col: int, row: int) -> int:
    46		for i in units.size():
    47			if units[i]["col"] == col and units[i]["row"] == row:
    48				return i
    49		return -1
    50	
    51	## 回傳空字串＝可以放；否則是不能放的原因（顯示給玩家）。
    52	func check_place(t: int, col: int, row: int) -> String:
    53		if not in_zone(col, row):
    54			return "只能放在自己的部署區"
    55		if index_at(col, row) != -1:
    56			return "這格已經有兵"
    57		if count() >= MAX_UNITS:
    58			return "最多 %d 隻" % MAX_UNITS
    59		if D.cost(t) > left():
    60			return "錢不夠"
    61		return ""
    62	
    63	func place(t: int, col: int, row: int) -> bool:
    64		if check_place(t, col, row) != "":
    65			return false
    66		units.append({"type": t, "col": col, "row": row})
    67		return true
    68	
    69	func remove_at(col: int, row: int) -> bool:
    70		var i := index_at(col, row)
    71		if i == -1:
    72			return false
    73		units.remove_at(i)
    74		return true
    75	
    76	func move(fc: int, fr: int, tc: int, tr: int) -> bool:
    77		var i := index_at(fc, fr)
    78		if i == -1 or not in_zone(tc, tr) or index_at(tc, tr) != -1:
    79			return false
    80		units[i]["col"] = tc
    81		units[i]["row"] = tr
    82		return true
    83	
    84	func clear() -> void:
    85		units.clear()
    86	
    87	func can_afford_any() -> bool:
    88		return count() < MAX_UNITS and left() >= D.cheapest()
    89	
    90	func copy():
    91		var a = get_script().new(team, budget)
    92		a.units = units.duplicate(true)
    93		return a
    94	
    95	## 左右鏡像並換隊（測試先手偏差用）。
    96	func mirrored():
    97		var a = get_script().new(1 - team, budget)
    98		for u in units:
    99			a.units.append({"type": u["type"], "col": COLS - 1 - u["col"], "row": u["row"]})
   100		return a
   101	
   102	## 陣型代碼（優化方案 E3）：NTB1.<base64url>.<校驗 4 碼>。
   103	## 位元組：[版本 1, 隻數, 每隻 (兵種<<4 | 以藍方表示的欄 0～5), 列]。欄位一律存成「自己這一側」，所以紅藍都能讀。
   104	const CODE_VERSION := 1
   105	
   106	func to_code() -> String:
   107		var b := PackedByteArray([CODE_VERSION, units.size()])
   108		for u in units:
   109			var c: int = u["col"] if team == 0 else COLS - 1 - u["col"]
   110			b.append((int(u["type"]) << 4) | c)
   111			b.append(u["row"])
   112		var body := Marshalls.raw_to_base64(b).replace("+", "-").replace("/", "_").replace("=", "")
   113		return "NTB1.%s.%s" % [body, body.sha256_text().substr(0, 4)]
   114	
   115	## 解碼並驗證；成功回傳 ""，失敗回傳原因（不改動目前陣型）。
   116	func load_code(code: String) -> String:
   117		var parts := code.strip_edges().split(".")
   118		if parts.size() != 3 or parts[0] != "NTB1":
   119			return "格式不對"
   120		if parts[1].sha256_text().substr(0, 4) != parts[2]:
   121			return "校驗碼不符"
   122		var b64 := parts[1].replace("-", "+").replace("_", "/")
   123		while b64.length() % 4 != 0:
   124			b64 += "="
   125		var b := Marshalls.base64_to_raw(b64)
   126		if b.size() < 2 or b[0] != CODE_VERSION or b.size() != 2 + b[1] * 2:
   127			return "版本或長度不對"
   128		var tmp = get_script().new(team, budget)
   129		for i in b[1]:
   130			var t: int = b[2 + i * 2] >> 4
   131			var c: int = b[2 + i * 2] & 15
   132			var r: int = b[3 + i * 2]
   133			if t >= D.COUNT or c > 5:
   134				return "內容不合法"
   135			var col: int = c if team == 0 else COLS - 1 - c
   136			if not tmp.place(t, col, r):
   137				return "超過預算、人數或格子重複"
   138		units = tmp.units
   139		return ""

