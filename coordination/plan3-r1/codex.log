   355	func _pstats(a: Array) -> Dictionary:
   356		var b := a.duplicate()
   357		b.sort()
   358		if b.is_empty():
   359			return {}
   360		return {"p50": snappedf(b[b.size() / 2], 0.01), "p95": snappedf(b[int(b.size() * 0.95)], 0.01), "max": snappedf(b[-1], 0.01)}
