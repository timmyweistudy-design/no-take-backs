    90	## 一場贏了：每個有派上場的兵種 +1（同一場同兵種只算一次）。
    91	static func record_win(save_data: Dictionary, types: Array) -> Array:
    92		var uw = save_data.get("unit_wins", {})
    93		if not uw is Dictionary:
    94			uw = {}
    95		var newly: Array = []
    96		var seen := {}
    97		for t in types:
    98			var k := str(int(t))
    99			if seen.has(k):
   100				continue
   101			seen[k] = true
   102			var before := int(uw.get(k, 0))
   103			uw[k] = before + 1
   104			if before + 1 == NOTE_WINS:
   105				newly.append(int(t))
   106		save_data["unit_wins"] = uw
