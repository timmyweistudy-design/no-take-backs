     1	extends RefCounted
     2	## 設定與進度存檔（優化方案 L1、N）：JSON、原子寫入（先寫暫存檔再改名）＋保留上一版備份。
     3	## 雲端：Steam Auto-Cloud 只同步 user://save.json（進度、陣型）；設定 user://settings.json 留在本機。
     4	
     5	const SAVE_VERSION := 2   # 存檔格式版本（schema_version）。2：加 unit_wins（圖鑑老兵筆記，第二輪方案 R3／R8）
     6	static var prefix := ""   # 截圖／測試模式用 "shot_"，不碰玩家真正的存檔
     7	
     8	const DEFAULT_SETTINGS := {
     9		"lang": "zh_TW", "text_scale": 100, "shake": true, "slowmo": true, "flash": true, "colorblind": false,
    10		"speed": 1.0, "music": 70, "sfx": 80, "duel_rule": "snake5", "fullscreen": false, "playtest": false,
    11	}
    12	const DEFAULT_SAVE := {
    13		"schema_version": SAVE_VERSION, "slots": ["", "", "", "", ""], "tutorial": 0, "puzzle_stars": {},
    14		"gauntlet_best": 0, "achievements": [], "stats": {"wins": 0, "games": 0}, "unit_wins": {},
    15	}
    16	
    17	static var settings := {}
    18	static var data := {}
    19	
    20	static func load_all() -> void:
    21		settings = _read(_sp(), DEFAULT_SETTINGS)
    22		data = migrate(_read(_dp(), {}))   # 先讀原始內容再遷移（遷移裡才補預設值），不然舊檔會被當成新版（Codex 收尾輪 #1）
    23	
    24	static func _sp() -> String:
    25		return "user://%ssettings.json" % prefix
    26	
    27	static func _dp() -> String:
    28		return "user://%ssave.json" % prefix
    29	
    30	static func _read(path: String, defaults: Dictionary) -> Dictionary:
    31		var out := defaults.duplicate(true)
    32		for p in [path, path + ".bak"]:
    33			if not FileAccess.file_exists(p):
    34				continue
    35			var txt := FileAccess.get_file_as_string(p)
    36			var parsed = JSON.parse_string(txt)
    37			if typeof(parsed) == TYPE_DICTIONARY:
    38				for k in parsed:
    39					out[k] = parsed[k]
    40				return out
    41		return out
    42	
    43	## 逐版遷移（純函式，測試用）：舊進度一律保留；不認得的欄位也保留（新版遊戲寫的存檔被舊版讀到時不會被刪掉）。
    44	## 比目前新的版本：原樣回傳，不降版。
    45	static func migrate(d: Dictionary) -> Dictionary:
    46		var out := d.duplicate(true)
    47		var v := int(out.get("schema_version", out.get("version", 1)))
    48		if v > SAVE_VERSION:
    49			return out
    50		if v < 2:
    51			# 1 → 2：欄位名 version 改成 schema_version；加 unit_wins
    52			out.erase("version")
    53			v = 2
    54		if not out.get("unit_wins", {}) is Dictionary:
    55			out["unit_wins"] = {}
    56		for k in DEFAULT_SAVE:
    57			if not out.has(k):
    58				out[k] = DEFAULT_SAVE[k].duplicate(true) if DEFAULT_SAVE[k] is Dictionary or DEFAULT_SAVE[k] is Array else DEFAULT_SAVE[k]
    59		out["schema_version"] = v
    60		return out
    61	
    62	static func _write(path: String, d: Dictionary) -> bool:
    63		var tmp := path + ".tmp"
    64		var f := FileAccess.open(tmp, FileAccess.WRITE)
    65		if f == null:
    66			return false
    67		var txt := JSON.stringify(d, "\t")
    68		f.store_string(txt)
    69		f.close()
    70		# 讀回驗證：內容不完整（磁碟滿、被中斷）就不覆蓋正式檔
    71		if FileAccess.get_file_as_string(tmp) != txt:
    72			return false
    73		if FileAccess.file_exists(path):
    74			DirAccess.copy_absolute(path, path + ".bak")
    75		return DirAccess.rename_absolute(tmp, path) == OK
    76	
    77	static func save_settings() -> bool:
    78		return _write(_sp(), settings)
    79	
    80	static func save_data() -> bool:
    81		return _write(_dp(), data)
    82	
    83	static func s(key: String):
    84		return settings.get(key, DEFAULT_SETTINGS.get(key))
    85	
    86	static func set_setting(key: String, v) -> void:
    87		settings[key] = v
    88		save_settings()
    89	
