   323	## 跟原本比改了幾隻（換兵種、移位、拿掉、新增都算一隻）。
   324	static func review_changes(orig, now) -> int:
   325		if orig.deploy == "free":
   326			var ma := {}
   327			for u in orig.units:
   328				ma[int(u.get("eid", -1))] = [int(u["type"]), int(u["x"]), int(u["y"])]
   329			var n := 0
   330			var seen := {}
   331			for u in now.units:
   332				var e := int(u.get("eid", -1))
   333				seen[e] = true
   334				if not ma.has(e) or ma[e] != [int(u["type"]), int(u["x"]), int(u["y"])]:
   335					n += 1
   336			for e in ma:
   337				if not seen.has(e):
   338					n += 1
   339			return n
   340		var a := {}
   341		var b := {}
   342		for u in orig.units:
   343			a["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   344		for u in now.units:
   345			b["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   500			var res: Dictionary = rv_thread.wait_to_finish()
   501			rv_thread = null
   502			if rv_thread_gen == rv_gen:
   503				rv_result = res
