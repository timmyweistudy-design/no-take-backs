   364	# ───────── 相等與差異 ─────────
   365	## 和規則相等判定有關的欄位（預設名稱、AI 難度這類顯示用的不算）。固定順序。
   366	func key_fields() -> Array:
   367		var sp: Array = []
   368		var keys := stat_pct.keys()
   369		keys.sort()
   370		for t in keys:
   371			sp.append([int(t), int(stat_pct[t][0]), int(stat_pct[t][1]), int(stat_pct[t][2])])
   372		var so := skills_off.duplicate()
   373		so.sort()
   374		var out: Array = [budget_of(0), budget_of(1), 1 if handicap else 0, ticks, unit_cap, type_cap, pool_of(0), pool_of(1), 1 if ai_pool_same else 0,
   375			rounds, place_rule, turns, 1 if carry else 0, 1 if keep_formation else 0, ai_level, sp, so]
   376		if not deploy_is_default():
   377			out.append_array([DEPLOYS.find(deploy), spacing, depth, fullfield])   # 第六輪 NTBR2 的 4 欄
   378		return out
   379	
   380	## 模擬那一層的摘要（非舊路徑時加進模擬雜湊）。
   381	func sim_digest() -> String:
   382		var sp: Array = []
   383		var keys := stat_pct.keys()
   384		keys.sort()
   385		for t in keys:
   386			sp.append([int(t), stat_pct[t]])
   387		var so := skills_off.duplicate()
   388		so.sort()
   389		var base: Array = [budget_of(0), budget_of(1), ticks, judge(), sp, so]
   390		if not map_is_default():
   391			base.append_array(["map", map_id, map_size, 1 if vents else 0, MapDefs.digest(map_id, map_size)])
   392		if cmd_on():
   393			base.append_array(["cmd", cmd_mask[0], cmd_mask[1], cmd_uses, cmd_cd, cmd_power])
   394		if deploy == "free":
   395			base.append_array(["free", spacing, depth, fullfield])   # 第六輪：自由部署進模擬摘要（格子部署時摘要不變）
   396		return JSON.stringify(base).sha256_text().substr(0, 16)
   397	
   398	func equals(o) -> bool:
   399		return JSON.stringify(key_fields()) == JSON.stringify(o.key_fields())
