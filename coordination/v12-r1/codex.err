   612	## 開一場戰鬥（S8 從 game_screens 移下來：重播、覆盤、截圖都會用到）
   613	func _begin_battle(a0, a1, kind := "official") -> void:
   614		_pre_drop()
   615		play_kind = kind
   616		_ensure_sprites([a0, a1])
   617		if kind == "official":
   618			last_armies = [a0.copy(), a1.copy()]
