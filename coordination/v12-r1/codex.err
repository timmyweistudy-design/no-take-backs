   234	func _follow_update(delta: float) -> void:
   235		if play_kind == "official":
   236			return
   237		if follow_id < 0 or view == null or state != St.BATTLE:
   238			return
   239		var u = view.unit_by_id(follow_id)
   240		if u == null or not u.alive:
   241			follow_id = -1
   242			return
   243		zoom_target = 1.45
   244		zoom_center = zoom_center.lerp(_upos(u), minf(1.0, delta * 6.0))
   245		zoom = lerpf(zoom, zoom_target, minf(1.0, delta * 4.0))

