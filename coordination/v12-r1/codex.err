    99	func _lobby_block() -> String:
   100		var bad: Array = lobby_r.validate()
   101		if not bad.is_empty():
   102			return L.t(bad[0])
   103		if _demo() and (not call("_demo_ok", lobby_r) or lobby_r.ai_level > 1):
   104			return L.t("demo_locked")     # 第十輪 R1：貼上的規則、舊的上次設定都走這裡
   105		# 第六輪（Codex 實作第 1 輪 #4）：明牌全場只給對 AI、輪流全場只給雙人（貼上的規則代碼也要擋）
   106		if (lobby_r.fullfield == RuleSet.FULL_DUEL and lobby_kind != "duel") or (lobby_r.fullfield == RuleSet.FULL_AI and lobby_kind != "ai"):
   107			return L.t("rr_full_kind")
   108		var lk := _lobby_locked_units()
   109		if not lk.is_empty():
   110			var names: Array = []
   111			for t in lk:
   112				names.append(L.t("unit_%d" % t))
   113			return L.t("lb_has_locked", ["、".join(names)])
   114		return ""
