  1374	## 新欄位的指紋（只有用到新兵的場次才有）。
  1375	## ── 第十二輪手動技能 ──
  1376	## 這一隊現在能不能用這一招。
  1377	func cmd_can(team: int, s: int) -> bool:
  1378		return cmd_on and not finished and s >= 0 and s < CMD.COUNT and int(cmd_left[team][s]) > 0 and tick >= int(cmd_ready[team][s])
  1379	
  1380	## 玩家按下：下一 tick 生效。重播時不接受。
  1381	func cast(team: int, s: int) -> bool:
  1382		if cmd_scripted or not cmd_can(team, s):
  1383			return false
  1384		for p in cmd_pending:
  1385			if p[0] == team and p[1] == s:
  1386				return false
  1387		cmd_pending.append([team, s])
  1388		return true
  1389	
  1390	## 重播：照紀錄在同一 tick 施放，AI 不再自己決定。
  1391	func cmd_play(log: Array) -> void:
  1392		cmd_scripted = true
  1393		cmd_script = {}
  1394		for e in log:
  1395			var t := int(e[0])
  1396			if not cmd_script.has(t):
  1397				cmd_script[t] = []
  1398			cmd_script[t].append([int(e[1]), int(e[2])])
  1399	
  1400	func _cmd_tick(n: int) -> void:
  1401		_cmd_dmg.resize(n)
  1402		_cmd_dmg.fill(0)
  1403		for u in units:
  1404			if u.shield_t > 0:
  1405				u.shield_t -= 1
  1406				if u.shield_t == 0:
  1407					u.shield = 0
  1408			if u.haste_t > 0:
  1409				u.haste_t -= 1
  1410		var casts: Array = []
  1411		if cmd_scripted:
  1412			casts = cmd_script.get(tick, [])
  1413		else:
  1414			casts = cmd_pending.duplicate()
  1415			cmd_pending.clear()
  1416			if tick % cmd_ai_every == 0:
  1417				for tm in 2:   # 都先讀這一 tick 開始前的狀態才決定，誰先算不佔便宜
  1418					if cmd_auto[tm]:
  1419						var want := _cmd_ai_pick(tm)
  1420						if want >= 0:
  1421							casts.append([tm, want])
  1422		for c in casts:
  1423			if cmd_can(int(c[0]), int(c[1])):
  1424				_cmd_apply(int(c[0]), int(c[1]))
  1425	
  1426	func _cmd_apply(team: int, s: int) -> void:
  1427		cmd_left[team][s] = int(cmd_left[team][s]) - 1
  1428		cmd_ready[team][s] = tick + cmd_cd
  1429		cmd_log.append([tick, team, s])
  1430		var ev := {"kind": EV.CMD, "team": team, "skill": s}
  1431		match s:
  1432			CMD.AEGIS:
  1433				for u in units:
  1434					if u.alive and u.team == team:
  1435						u.shield = maxi(u.shield, u.max_hp * CMD.scaled(CMD.AEGIS_PCT, cmd_power) / 100)
  1436						u.shield_t = CMD.AEGIS_TICKS
  1437			CMD.WARCRY:
  1438				for u in units:
  1439					if u.alive and u.team == team:
  1440						u.haste_t = CMD.scaled(CMD.WAR_TICKS, cmd_power)
  1441			CMD.HEAL:
  1442				for u in units:
  1443					if u.alive and u.team == team:
  1444						u.hp = mini(u.max_hp, u.hp + u.max_hp * CMD.scaled(CMD.HEAL_PCT, cmd_power) / 100)
  1445			CMD.METEOR:
  1446				var c: Array = _cmd_cluster(team)
  1447				if int(c[0]) > 0:
  1448					ev["x"] = c[1]
  1449					ev["y"] = c[2]
  1450					var r2: int = CMD.METEOR_R * CMD.METEOR_R
  1451					for i in units.size():
  1452						var v := units[i]
  1453						if v.alive and v.team != team and (v.x - c[1]) * (v.x - c[1]) + (v.y - c[2]) * (v.y - c[2]) <= r2:
  1454							_cmd_dmg[i] += CMD.scaled(CMD.METEOR_DMG, cmd_power)
  1455			CMD.FREEZE:
  1456				for u in units:
  1457					if u.alive and u.team != team:
  1458						u.stun = maxi(u.stun, CMD.scaled(CMD.FREEZE_TICKS, cmd_power))
  1459						u.charge = 0
  1460		events.append(ev)
