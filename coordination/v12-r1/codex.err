   203	static func series_done(w: Array, rn: int, r) -> bool:
   204		var need: int = r.wins_needed() if r != null else 2
   205		var cap_r: int = r.max_rounds() if r != null else 5
   206		return int(w[0]) >= need or int(w[1]) >= need or rn >= cap_r
