    63	func _lobby_pick(id: String) -> void:
    64		if id == "fantasy" and not RuleSet.has_new(Presets.selectable(lobby_kind, _lobby_unlocked(), _demo())):
    65			_toast(L.t("lb_fantasy_locked"), true)   # 第八輪：第 14 場才有第一種奇幻軍
    66			return
    67		var keep_level: int = lobby_r.ai_level
