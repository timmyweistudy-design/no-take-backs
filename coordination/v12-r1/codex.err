   501	## 部署分頁的陣型小圖：看得到間距和縱深實際長怎樣。
   502	func _draw_deploy_preview(r: Rect2) -> void:
   503		var w: float = lobby_r.field_w()
   504		var h: float = lobby_r.field_h()
   505		var k: float = minf(r.size.x / w, r.size.y / h)
   506		var q := Rect2(r.position, Vector2(w, h) * k)
   507		draw_rect(q, Color("#5f8a45"))
   508		var free_d: bool = lobby_r.deploy == "free"
   509		var dep: float = lobby_r.half_depth() if free_d else 6000.0
   510		var sp: float = lobby_r.spacing if free_d else 1000.0
   511		draw_rect(Rect2(q.position, Vector2(dep * k, q.size.y)), Color(Art.team_color(0, cbm()), 0.28))
   512		draw_rect(Rect2(q.end.x - dep * k, q.position.y, dep * k, q.size.y), Color(Art.team_color(1, cbm()), 0.28))
   513		var yy := 500.0
   514		while yy < h:
   515			var xx := 500.0
   516			while xx < dep:
   517				draw_circle(q.position + Vector2(xx, yy) * k, 2.2, Color.WHITE, true, -1.0, true)
   518				xx += sp
   519			yy += sp
   520		draw_rect(q, Color(0, 0, 0, 0.5), false, 1.5)
