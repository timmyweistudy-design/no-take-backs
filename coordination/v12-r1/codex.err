  1322	## 單位倒下：史萊姆分裂、石魔留碎石、羊排到下一 tick 爆。
  1323	func _v8_on_death(i: int, killer: int) -> void:
  1324		var u := units[i]
  1325		if u.type == F8.SHEEP and not u.exploded:
  1326			_pending_blast.append([i, killer])
  1327		elif u.type == F8.SLIME and not skill_off.has("split"):
  1328			for j in range(i + 1, units.size()):
  1329				var c := units[j]
  1330				if c.parent == i and c.dormant:
  1331					c.dormant = false
  1332					c.alive = true
  1333					c.x = u.x
  1334					c.y = clampi(u.y + (F8.SLIME_OFFSET if c.sub == 0 else -F8.SLIME_OFFSET), EDGE, fh - EDGE)
  1335					if terrain != null and terrain.blocked(c.x, c.y, c.team):
  1336						c.y = u.y     # 裂到牆裡：留在母體位置，碰撞會把它們推開
  1337					c.cd = c.cd_base * 4
  1338					events.append({"kind": EV.SPLIT, "src": c.id, "tgt": c.id, "tags": [EV.SPLIT]})
  1339		elif u.type == F8.GOLEM and not skill_off.has("stomp"):
  1340			zones.append([u.x, u.y, tick + F8.ROCK_TICKS, u.team])
  1341			events.append({"kind": EV.ROCK, "src": u.id, "tgt": u.id, "tags": [EV.ROCK]})
  1342	
  1343	## ⑤ 之後、判定結束之前：骷髏站起來（下一 tick 才行動）、碎石區到期。
  1344	func _v8_post_tick(raises: Array) -> void:
  1345		raises.sort_custom(func(a, b): return _tie_less(0, units[a[0]], 0, units[b[0]]))
  1346		for r in raises:
  1347			var m := units[r[0]]
  1348			var c := units[r[1]]
  1349			if not m.alive or c.raised or c.alive:
  1350				continue
  1351			var k := _v8_free_kid(r[0])
  1352			if k == -1:
  1353				continue
  1354			var s := units[k]
  1355			c.raised = true
  1356			s.dormant = false
  1357			s.alive = true
  1358			s.x = c.x
  1359			s.y = c.y
  1360			if terrain != null and terrain.blocked(s.x, s.y, s.team):
  1361				var sf: Vector2i = terrain.free_near(s.x, s.y, s.team)   # 幽靈死在牆裡
  1362				s.x = sf.x
  1363				s.y = sf.y
  1364			s.max_hp = mini(c.max_hp * F8.BONE_HP_PCT / 100, F8.BONE_HP_CAP)
  1365			s.hp = s.max_hp
  1366			s.cd = s.cd_base * 4
  1367			events.append({"kind": EV.RAISE, "src": s.id, "tgt": s.id, "by": m.id, "tags": [EV.RAISE]})
  1368		var live: Array = []
  1369		for z in zones:
  1370			if int(z[2]) > tick:
  1371				live.append(z)
  1372		zones = live

