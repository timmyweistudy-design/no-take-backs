   306		if rv_orig.deploy == "free":
   307			# 編輯識別（和戰鬥編號分開，Codex 第一輪）：覆盤時每隻帶 eid，「只改一隻」依 eid 比
   308			for i in rv_orig.units.size():
   309				rv_orig.units[i]["eid"] = i
   310				rv_army.units[i]["eid"] = i
