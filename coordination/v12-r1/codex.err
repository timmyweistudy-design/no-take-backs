  1462	## 敵人最密的位置：[範圍內幾隻, x, y]。平手用鏡像不變的鍵（列小、離自己底線近）。
  1463	func _cmd_cluster(team: int) -> Array:
  1464		var best := [0, 0, 0]
  1465		var best_d := 0
  1466		var r2: int = CMD.METEOR_R * CMD.METEOR_R
  1467		for a in units:
  1468			if not a.alive or a.team == team:
  1469				continue
  1470			var cnt := 0
  1471			for b in units:
  1472				if b.alive and b.team != team and (a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y) <= r2:
  1473					cnt += 1
  1474			var d: int = a.x if team == 0 else fw - a.x
  1475			if cnt > int(best[0]) or (cnt == int(best[0]) and (a.y < int(best[2]) or (a.y == int(best[2]) and d < best_d))):
  1476				best = [cnt, a.x, a.y]
  1477				best_d = d
  1478		return best
  1479	
  1480	## AI 這一 tick 要放哪一招（-1＝不放）。只看戰況，沒有亂數；左右對稱。
  1481	func _cmd_ai_pick(team: int) -> int:
  1482		for s in CMD.list_of(int(cmd_mask[team])):
  1483			if cmd_can(team, s) and _cmd_ai_wants(team, s):
  1484				return s
  1485		return -1
  1486	
  1487	func _cmd_ai_wants(team: int, s: int) -> bool:
  1488		var mine := 0
  1489		var contact := 0
  1490		var missing := 0
  1491		var total := 0
  1492		var g2 := 2000 * 2000
  1493		for u in units:
  1494			if not u.alive or u.team != team:
  1495				continue
  1496			mine += 1
  1497			missing += u.max_hp - u.hp
  1498			total += u.max_hp
  1499			for e in units:
  1500				if e.alive and e.team != team and (u.x - e.x) * (u.x - e.x) + (u.y - e.y) * (u.y - e.y) <= g2:
  1501					contact += 1
  1502					break
  1503		if mine == 0:
  1504			return false
  1505		match s:
  1506			CMD.AEGIS, CMD.WARCRY, CMD.FREEZE:
  1507				return contact >= 3 and contact * 2 >= mine
  1508			CMD.HEAL:
  1509				return missing * 100 >= total * 30
  1510			CMD.METEOR:
  1511				return int(_cmd_cluster(team)[0]) >= 4
  1512		return false
