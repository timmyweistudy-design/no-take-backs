  1514	func _hash_cmd() -> void:
  1515		var a := PackedInt64Array()
  1516		for u in units:
  1517			a.append_array(PackedInt64Array([u.shield, u.shield_t, u.haste_t]))
  1518		for e in cmd_log:
  1519			a.append_array(PackedInt64Array([int(e[0]), int(e[1]), int(e[2])]))
  1520		_hash.update(a.to_byte_array())
  1521	
