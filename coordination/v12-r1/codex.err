   627			# 重播／覆盤：先用確定性模擬算出整場長度，時間軸以實際秒數為滿（Antigravity S5）
   628			var pa0 = a0.copy()
   629			var pa1 = a1.copy()
   630			var pr = battle_rules.copy() if battle_rules != null else null
   631			var plog: Array = last_cmds.duplicate(true)
   632			var run_pre := func() -> int:
   633				var pre = Sim.new(pa0, pa1, pr)
   634				if pre.cmd_on:
   635					pre.cmd_play(plog)
   636				pre.fast = true
   637				pre.run_to_end()
   638				return pre.tick
   639			if _async_ok():
   640				pre_thread = Thread.new()
   641				pre_thread.start(run_pre)
   642			else:
   643				replay_total = run_pre.call()
   644		paused = false
