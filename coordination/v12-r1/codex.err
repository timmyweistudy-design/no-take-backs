    53			# 讓子局用各自預算的比例評分（Codex 實作第 1 輪）；標準局算式不變
    54			var sc: int = (1000000 + s.power(1)) if s.winner == 1 else (s.power(1) - s.power(0))
    55			if s.judge == 2:
    56				sc = (1000000 + s.power_permille(1)) if s.winner == 1 else (s.power_permille(1) - s.power_permille(0))
    57			if sc > bs:
    58				bs = sc
    59				best = c
    60		return best
