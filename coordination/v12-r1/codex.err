    26	## 打開大廳：沿用上次在這個模式用的規則（存檔裡的規則代碼）；沒有或不合法就用標準。
    27	func _open_lobby(kind: String) -> void:
    28		lobby_kind = kind
    29		var code := str(Save.data.get("last_rules", {}).get(kind, ""))
    30		var r = null
    31		if code != "":
    32			var d: Dictionary = RuleSet.from_code(code)
    33			if d["ok"]:
    34				r = d["rules"]
    35				r.preset = str(Save.data.get("last_rules", {}).get(kind + "_preset", "custom"))
    36				if r.preset == "standard":
    37					r.pool = Presets.make("standard", kind, _lobby_unlocked()).pool.duplicate()   # 舊存檔的標準可能只存到解鎖的幾種
    38				var ex = Save.data.get("last_rules", {}).get(kind + "_extra", [])
    39				if ex is Array and ex.size() >= 3:
    40					if ex.size() >= 4:
    41						r.time_of = clampi(int(ex[3]), 0, 2)
    42					r.ai_style = clampi(int(ex[0]), 0, RuleSet.AI_STYLES - 1)
    43					r.map_mode = clampi(int(ex[1]), 0, 2)
    44					r.bans = clampi(int(ex[2]), 0, 2)
    45		if r == null:
    46			r = Presets.make("standard", kind, _lobby_unlocked())
    47			# 第四輪的舊設定當作第一次打開大廳的初始值（Codex 第一輪）
    48			if str(Save.s("roster")) == "classic":
    49				r.pool = [31, 31]
    50			if kind == "duel":
    51				r.place_rule = str(Save.s("duel_rule")) if str(Save.s("duel_rule")) in RuleSet.PLACE_RULES else "snake5"
    52		lobby_r = r
    53		# 存過的規則照原樣保留（Codex 實作第 3 輪：重開雙人大廳不能把兩邊不同的卡池改成一樣）；含未解鎖兵由開戰鈕擋
    54		lobby_open = false
    55		lobby_menu = false
    56		lobby_item = ""
    57		lobby_tab = 0
    58		_open("lobby")
