    55	func _battle_process(delta: float) -> void:
    56		if pre_thread != null:
    57			if pre_thread.is_alive():
    58				return
    59			_pre_join()
    60		if view != null:
    61			_gait_frame(delta)   # 不能放在只有部分情況才跑的地方（Codex P2 #1）
    62		if start_hold > 0.0:
    63			start_hold -= delta
    64			return
    65		if call("_seek_pump"):
    66			return
    67		if skip_busy:
    68			_skip_step()
    69			return
    70		if paused:
    71			return
    72		if hitstop > 0:
    73			hitstop -= delta
    74			return
    75		var rate := speed
    76		if slow_left > 0:
    77			rate *= 0.5
    78			slow_left -= delta
    79		if final_left > 0:
    80			rate *= 0.25      # 第十輪 F1：最後一擊
    81			final_left -= delta
    82			_update_action_focus()
    83		accum += delta * rate
    84		while accum >= 0.05 and not view.finished:
    85			accum -= 0.05
    86			var was_slow := slow_left > 0 or final_left > 0
    87			_sim_step(true)
    88			if (slow_left > 0 or final_left > 0) and not was_slow:
    89				break   # 這一 tick 觸發慢動作：剩下的累積留到下一幀用慢速消耗（Codex S8 #3）
    90		# 播完之後展示時鐘繼續走（不再推進快照）：最後一格的位置插值與最後一擊的後搖要演完（Codex R5 #1）
    91		# 最後時刻只在 _sim_step 每個畫面 tick 判定（Codex S8 #1：每幀也判會讓觸發 tick 跟幀率有關）
    92		if slow_left > 0:
    93			_update_action_focus()
    94		sfx.set_muffled(slow_left > 0 and not view.finished)
    95		# 分軌音樂依戰況混音（第三輪 S1）
    96		var close := absf(view.power(0) * 100.0 / (view.budget_of(0) * 1000) - view.power(1) * 100.0 / (view.budget_of(1) * 1000)) <= 15.0
    97		sfx.set_layer_targets(sfx.layer_targets(close, slow_left > 0 and not view.finished))
    98		# 鏡頭只有一個決策點（Codex S5 #6）：跟拍優先於最後時刻框選，兩者都沒有才回到全景
    99		if follow_id >= 0:
   100			pass   # 由 _follow_update 決定
   101		elif slow_left > 0 and not view.finished:
   102			_frame_alive(delta)
   103		else:
   104			zoom_target = 1.0
   105			zoom_center = zoom_center.lerp(ORIGIN + fld_size / 2, minf(1.0, delta * 3))
   106		zoom = lerpf(zoom, zoom_target, delta * 3)
   107		if view.finished:
   108			result_delay += delta
   109			if result_delay > 1.4:
   110				on_battle_finished.call()
