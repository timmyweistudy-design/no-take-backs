   120			return
   121		var lr: Dictionary = Save.data.get("last_rules", {})
   122		lr[lobby_kind] = lobby_r.to_code()
   123		lr[lobby_kind + "_preset"] = lobby_r.preset
   124		lr[lobby_kind + "_extra"] = [lobby_r.ai_style, lobby_r.map_mode, lobby_r.bans, lobby_r.time_of]   # 系列選項不進規則碼，另外記（Codex #8）
   125		Save.data["last_rules"] = lr
   126		Save.save_data()
   127		rules = lobby_r.copy()
   128		set("challenge_army", null)
   129		if lobby_kind == "duel" and rules.bans > 0:
   130			call("_begin_bans", rules.bans)
   131			return
   132		call("_start_mode", Mode.VS_AI if lobby_kind == "ai" else Mode.DUEL)
