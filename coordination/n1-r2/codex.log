   286	## 困難 AI：第 1 局沒有資訊，用會讀對方的落子 AI 自己組；之後讀你上一局的陣型，
   287	## 先查離線反制庫（組成最接近的原型），查不到就用啟發式反制。不偷看你這一局。
   288	func _hard_ai(r: RandomNumberGenerator) -> Army:
   289		var known: Array = last_player_formation if round_no > 1 else []
   290		if not known.is_empty():
   291			var lib := _counter_lib()
   292			if not lib.is_empty():
   293				var mine := [0, 0, 0, 0, 0]
   294				for u in known:
   295					mine[u["type"]] += D.cost(u["type"])
   296				var best = null
   297				var bd := 1 << 30
   298				for e in lib:
   299					var d := 0
   300					for k in 5:
   301						d += absi(int(e["proto_comp"][k]) - mine[k])
   302					if d < bd:
   303						bd = d
   304						best = e
   305				if best != null and bd <= 40:
   306					var a := Army.new(1, 100)
   307					if a.load_code(best["code"]) == "":
   308						return a
   309		return AIT.build_full(1, r, 2, known)
