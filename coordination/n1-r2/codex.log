+	var cur_f := fitness(cur, [target])
+	for it in int(args.get("iters", "20")):
+		var cand := mutate(cur, rng)
+		var f := fitness(cand, [target])
+		if f >= cur_f:
+			cur = cand
+			cur_f = f
+	emit({"mode": "countersearch", "shard": shard, "fit": cur_f, "code": cur.to_code(), "comp": F.composition(cur)})
