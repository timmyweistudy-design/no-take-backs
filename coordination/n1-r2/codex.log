    58	func block(t: int, gold: int) -> Army:
    59		var a := Army.new(0, 100)
    60		var n := gold / D.cost(t)
    61		var cols := [5, 4, 3, 2, 1, 0] if t != D.ARCHER else [0, 1, 2, 3, 4, 5]
    62		var rows := [4, 3, 5, 2, 6, 1, 7, 0, 8]
    63		var k := 0
    64		for c in cols:
    65			for r in rows:
    66				if k < n:
    67					a.units.append({"type": t, "col": c, "row": r})
    68					k += 1
    69		return a
