    56		if f == null:
    57			return false
    58		var txt := JSON.stringify(d, "\t")
    59		f.store_string(txt)
    60		f.close()
    61		# 讀回驗證：內容不完整（磁碟滿、被中斷）就不覆蓋正式檔
    62		if FileAccess.get_file_as_string(tmp) != txt:
    63			return false
    64		var dir := DirAccess.open("user://")
    65		var name := path.get_file()
    66		if FileAccess.file_exists(path):
    67			dir.copy(name, name + ".bak")
    68		return dir.rename(tmp.get_file(), name) == OK
