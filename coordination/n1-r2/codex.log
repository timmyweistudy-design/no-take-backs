    14			map[u.id] = (1 - u.team) * 1000 + row * 16 + (15 - col)
    15		var byid := {}
    16		var idx2 := {}   # s2 的 id → 索引
    17		for k in s2.units.size():
    18			byid[s2.units[k].id] = s2.units[k]
    19			idx2[s2.units[k].id] = k
    20		# s1 索引 → 對應到 s2 的索引（目標、面向鎖定是索引）
    21		var imap := {-1: -1}
    22		for k in s1.units.size():
    23			imap[k] = idx2[map[s1.units[k].id]]
    24		while not s1.finished or not s2.finished:
    25			s1.step()
    26			s2.step()
    27			for u in s1.units:
    28				var v = byid[map[u.id]]
    29				var a := [Sim.W - u.x, u.y, u.hp, -u.fx, u.fy, imap[u.target], imap[u.face_lock], u.cd, u.stun, u.slow,
    30					u.stealth, u.charge, -u.cdx, u.cdy, -u.mx, u.my, (Sim.W - u.wp_x) if u.wp_x >= 0 else -1, u.wp_y, u.alive, u.dmg_dealt, u.dmg_taken]
    31				var b := [v.x, v.y, v.hp, v.fx, v.fy, v.target, v.face_lock, v.cd, v.stun, v.slow,
    32					v.stealth, v.charge, v.cdx, v.cdy, v.mx, v.my, v.wp_x, v.wp_y, v.alive, v.dmg_dealt, v.dmg_taken]
    33				if a != b:
    34					var names := ["x", "y", "hp", "fx", "fy", "target", "face_lock", "cd", "stun", "slow", "stealth", "charge", "cdx", "cdy", "mx", "my", "wp_x", "wp_y", "alive", "dealt", "taken"]
    35					var diff := []
    36					for k in a.size():
    37						if a[k] != b[k]:
    38							diff.append("%s %s≠%s" % [names[k], a[k], b[k]])
    39					return "tick %d 單位 %d（兵種 %d）：%s" % [s1.tick, u.id, u.type, ", ".join(diff)]
    40			if s1.finished != s2.finished:
    41				return "結束 tick 不同：%d vs %d" % [s1.tick, s2.tick]
    42		var expect: int = s1.winner if s1.winner == -1 else 1 - s1.winner
    43		if s2.winner != expect:
    44			return "勝方沒對調：%d vs %d" % [s1.winner, s2.winner]
    45		return ""
   370		# 狂熱耗損：第 1200+100k tick（k＝0～5）扣 (k+1)×STEP% 滿血（至少 1）
   371		if tick >= FRENZY_TICK and (tick - FRENZY_TICK) % 100 == 0 and (tick - FRENZY_TICK) / 100 <= 5:
   372			var k := (tick - FRENZY_TICK) / 100
   373			for i in n:
   374				if units[i].alive:
   375					dmg_in[i] += maxi(1, units[i].max_hp * (k + 1) * D.ATTRITION_STEP_PCT / 100)
   376			events.append({"kind": "attrition", "k": k})
   377		for kb in knock:
   378			var v := M.unit1000(kb[1], kb[2])
   379			var t: Unit = units[kb[0]]
   380			t.x = clampi(t.x + v.x * D.KNOCKBACK / 1000, EDGE, W - EDGE)
   381			t.y = clampi(t.y + v.y * D.KNOCKBACK / 1000, EDGE, H - EDGE)
   382		for i in n:
   383			var u := units[i]
   384			if not u.alive:
   385				continue
   386			u.hp -= dmg_in[i]
   387			if u.stun > 0:
   388				u.stun -= 1
   389			if u.slow > 0:
   390				u.slow -= 1
   391			if u.stealth > 0:
   392				u.stealth -= 1
   393			if reveal.has(i):
   394				u.stealth = 0
   395			if stun_set.has(i):
   396				u.stun = D.STUN_TICKS
   397				u.charge = 0
   398			if slow_set.has(i):
   399				u.slow = D.SLOW_TICKS
   400			# 騎兵這一 tick 沒動也沒出手（被擋、等待）→ 衝鋒歸零
   401			if u.type == D.CAVALRY and u.mx == 0 and u.my == 0 and attacked[i] == 0:
   402				u.charge = 0
   403		for i in n:
   404			var u := units[i]
   405			if u.alive and u.hp <= 0:
   406				u.alive = false
   407				u.hp = 0
   408				if last_hit[i] != -1:
   409					units[last_hit[i]].kills += 1
   410				events.append({"kind": "death", "id": u.id})
   411	
   412		power_log.append(power(0) - power(1))
   413		if not fast:
   414			_hash_state()
   415		_check_end()
