   510	func _err_key(why: String) -> String:
   511		if why == "":
   512			return ""
   513		if why.begins_with("只能放"):
   514			return L.t("err_zone")
   515		if why.begins_with("這格"):
   516			return L.t("err_taken")
   517		if why.begins_with("最多"):
   518			return L.t("err_max", [Army.MAX_UNITS])
   519		if why.begins_with("錢不夠"):
   520			return L.t("err_gold")
   521		if why.begins_with("這一手"):
   522			return L.t("err_hand", [tp.hand_cap() if tp else 10])
   523		return why
