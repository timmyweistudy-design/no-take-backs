   498	func _check_place(t: int, c: Vector2i) -> String:
   499		if _locked():
   500			return L.t("both_done")
   501		if not _allowed(t):
   502			return L.t("err_type")
   503		if mode == Mode.DUEL and tp != null:
   504			var why: String = tp.check_place(t, c.x, c.y)
   505			return _err_key(why)
   506		if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() + 1 > gauntlet_changes:
   507			return L.t("err_changes")
   508		return _err_key(_cur_army().check_place(t, c.x, c.y))
