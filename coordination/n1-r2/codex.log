   417	# ───────────────────────── 規則細節 ─────────────────────────
   418	
   419	## 選目標（企劃 §3.3）：排除潛行 → 弓手警覺 → 盾兵嘲諷（近戰）→ 兵種偏好 → 距離 → 剩血 → 列 → 深度 → 編號。
   420	## 只讀快照陣列，比較全部用整數（不配置陣列）。
   421	func _choose_target(i: int, sx: PackedInt64Array, sy: PackedInt64Array, st: PackedInt64Array,
   422			sk: PackedInt64Array, sh: PackedInt64Array, sv: PackedByteArray) -> int:
   423		var my_team: int = st[i]
   424		var my_type: int = sk[i]
   425		var ux: int = sx[i]
   426		var uy: int = sy[i]
   427		var reach: int = units[i].reach
   428		var reach2 := reach * reach
   429		var taunt2 := D.TAUNT_RANGE * D.TAUNT_RANGE
   430		var melee := my_type != D.ARCHER
   431		var best := -1
   432		var b_rank := 99
   433		var b_d2 := 0
   434		var b_hp := 0
   435		var b_y := 0
   436		var b_dep := 0
   437		var n := sx.size()
   438		for j in n:
   439			if sv[j] == 0 or st[j] == my_team:
   440				continue
   441			var dx: int = sx[j] - ux
   442			var dy: int = sy[j] - uy
   443			var d2 := dx * dx + dy * dy
   444			var et: int = sk[j]
   445			var rank := 3
   446			if my_type == D.ARCHER and et == D.ASSASSIN and d2 <= reach2:
   447				rank = 0
   448			elif melee and et == D.SHIELD and d2 <= taunt2:
   449				rank = 1
   450			elif my_type == D.CAVALRY and et == D.ARCHER:
   475			b_hp = sh[j]
   476			b_y = sy[j]
   477			b_dep = sx[j] if st[j] == 0 else W - sx[j]
   478		return best
   479	
   480	## 劍士反擊選人：打中它的刺客裡挑「最近→列小→離自己底線近」；只用鏡像不變的鍵，不用編號。
   481	func pick_counter(si: int, attackers: Array) -> int:
   482		var sw := units[si]
   483		var best := -1
   484		var bd := 0
   485		var by := 0
   486		var bdep := 0
   487		for ai in attackers:
   488			var a := units[ai]
   489			var d2 := M.dist2(sw.x, sw.y, a.x, a.y)
   490			var dep: int = a.x if a.team == 0 else W - a.x
   491			if best == -1 or d2 < bd or (d2 == bd and (a.y < by or (a.y == by and dep < bdep))):
   492				best = ai
   493				bd = d2
   494				by = a.y
   495				bdep = dep
   496		return best
   497	
   498	## 攻擊者是否在目標背後（以目標面向的內積判斷；剛好側面算正面）。
   499	func _is_behind(att: Unit, tg: Unit) -> bool:
   500		var dx := att.x - tg.x
   501		var dy := att.y - tg.y
   502		return dx * tg.fx + dy * tg.fy < 0
   503	
   504	func _same_dir(ax: int, ay: int, bx: int, by: int) -> bool:
   505		# 夾角小於約 25 度
   506		var dot := ax * bx + ay * by
   507		if dot <= 0:
   508			return false
   509		var la := ax * ax + ay * ay
   510		var lb := bx * bx + by * by
   511		return dot * dot * 100 >= la * lb * 82
   512	
   513	## 騎兵衝鋒累積（優化方案 B1）：只算「沿著這段衝鋒起始方向」的實際前進距離；
   514	## 被推開的位移不算；方向跟起始方向差太多（逐步轉彎也算）就重新開始；被擋住前進不到一半就歸零。
   515	func _update_charge(u: Unit, moved_x: int, moved_y: int) -> void:
   516		if u.mx == 0 and u.my == 0:
   517			return   # 沒有提出移動（停下攻擊或等待），在第⑤步處理
   518		var ml := M.isqrt(u.mx * u.mx + u.my * u.my)
   519		# 只算沿著自己提出方向的前進，而且最多算自己提出的距離（被往前推的部分不算）
   520		var along := mini(ml, (moved_x * u.mx + moved_y * u.my) / maxi(1, ml))
   521		if along * 2 < ml:
   522			u.charge = 0
   523			u.cdx = 0
   524			u.cdy = 0
   525			return
   526		if u.charge == 0 or not _same_dir(u.cdx, u.cdy, u.mx, u.my):
   527			u.charge = along
   528			u.cdx = u.mx
   529			u.cdy = u.my
   530		else:
   531			u.charge += along
   532	
   533	## 騎兵繞翼：目標是弓手、直線上 FLANK_DETECT 內有盾兵時，往敵兵較少的那側偏 FLANK_OFFSET 走途經點。
   534	func _flank_waypoint(i: int, t: int) -> Vector2i:
   535		var u := units[i]
   536		var tg := units[t]
   537		if tg.type != D.ARCHER:
   538			u.wp_for = -1
   539			return Vector2i(-1, -1)
   540		if u.wp_for == tg.id:
   541			if M.dist2(u.x, u.y, u.wp_x, u.wp_y) > 400 * 400:
   542				return Vector2i(u.wp_x, u.wp_y)
   543			return Vector2i(-1, -1)   # 已經到過途經點，直衝
   544		var dx := tg.x - u.x
   545		var dy := tg.y - u.y
   546		var l2 := dx * dx + dy * dy
   547		if l2 == 0:
   548			return Vector2i(-1, -1)
   549		var blocked := false
   550		var above := 0
   551		var below := 0
   552		for e in units:
   553			if e.team == u.team or not e.alive:
   554				continue
   555			if e.y < u.y:
   556				above += 1
   557			elif e.y > u.y:
   558				below += 1
   559			if e.type != D.SHIELD or e.stealth > 0:
   560				continue
   561			var ex: int = e.x - u.x
   562			var ey: int = e.y - u.y
   563			var proj: int = ex * dx + ey * dy
   564			if proj <= 0 or proj >= l2:
   565				continue
   566			var cross: int = ex * dy - ey * dx
   567			if cross * cross < D.FLANK_DETECT * D.FLANK_DETECT * l2:
   568				blocked = true
   569		if not blocked:
   570			return Vector2i(-1, -1)
   571		var wy: int
   572		if above <= below:
   573			wy = mini(u.y, tg.y) - D.FLANK_OFFSET
   574		else:
   575			wy = maxi(u.y, tg.y) + D.FLANK_OFFSET
   576		u.wp_for = tg.id
   577		u.wp_x = u.x + (tg.x - u.x) / 2   # 用差值往 0 截斷，左右鏡像才對稱
   578		u.wp_y = clampi(wy, EDGE, H - EDGE)
   579		return Vector2i(u.wp_x, u.wp_y)
   580	
   581	## 完整狀態指紋：每 tick 依 id 順序寫入固定 26 個 int64 欄位。
   582	func _hash_state() -> void:
   583		var a := PackedInt64Array()
   584		a.resize(units.size() * 26 + 1)
   585		a[0] = tick
   586		var k := 1
   587		for u in units:
   588			a[k] = u.x; a[k + 1] = u.y; a[k + 2] = u.hp; a[k + 3] = u.cd; a[k + 4] = u.target
   589			a[k + 5] = u.fx; a[k + 6] = u.fy; a[k + 7] = u.face_lock; a[k + 8] = u.mx; a[k + 9] = u.my
   590			a[k + 10] = u.cdx; a[k + 11] = u.cdy; a[k + 12] = u.stealth; a[k + 13] = u.charge; a[k + 14] = u.stun
   591			a[k + 15] = u.slow; a[k + 16] = u.wp_x; a[k + 17] = u.wp_y; a[k + 18] = u.wp_for; a[k + 19] = 1 if u.alive else 0
   592			a[k + 20] = u.dmg_dealt; a[k + 21] = u.dmg_taken; a[k + 22] = u.kills; a[k + 23] = u.id; a[k + 24] = u.team; a[k + 25] = u.type
   593			k += 26
   594		_hash.update(a.to_byte_array())
   595	
   596	func _check_end() -> void:
   597		var a0 := alive_count(0)
   598		var a1 := alive_count(1)
   599		if a0 == 0 and a1 == 0:
   600			_finish(-1, "同時全滅")
   601		elif a1 == 0:
   602			_finish(0, "全滅")
   603		elif a0 == 0:
   604			_finish(1, "全滅")
   605		elif tick >= MAX_TICKS:
   606			var p0 := power(0)
   607			var p1 := power(1)
   608			if absi(p0 - p1) < budget * 30:
   609				_finish(-1, "時間到・戰力相當")
   610			elif p0 > p1:
   611				_finish(0, "時間到・剩餘戰力較高")
   612			else:
   613				_finish(1, "時間到・剩餘戰力較高")
