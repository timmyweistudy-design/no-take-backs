   165	func search(shard: int, shards: int) -> void:
   166		var iters := int(args.get("iters", "12"))
   167		var nopp := int(args.get("opps", "24"))
   168		var hold := F.holdout_pool(0)
   169		var spool := F.search_pool(0)
   170		var opps: Array = []
   171		for k in nopp:
   172			opps.append(spool[(k * 2 + shard) % spool.size()])
   173		var rng := RandomNumberGenerator.new()
   174		rng.seed = 777 + shard * 1009
   175		var train := F.training_pool(0)
   176		var cur: Army = train[rng.randi_range(0, train.size() - 1)].copy()
   177		var cur_f := fitness(cur, opps)
   178		for it in iters:
   179			var cand := mutate(cur, rng)
   180			var f := fitness(cand, opps)
   181			if f >= cur_f:
   182				cur = cand
   183				cur_f = f
   184		# 最後對「沒參與演化」的保留池驗證
   185		var full := fitness(cur, hold)
   186		emit({"mode": "search", "shard": shard, "fit_sample": cur_f, "fit_holdout": full, "code": cur.to_code(), "comp": F.composition(cur)})
   187	
   188	## 反制搜尋：從訓練池不同起點爬山，找能打贏 target 的陣型。
   189	func countersearch(shard: int, shards: int) -> void:
   190		var target := Army.new(0, 100)
   191		if target.load_code(args.get("target", "")) != "":
   192			emit({"mode": "countersearch", "shard": shard, "error": "bad target"})
   193			return
   194		var rng := RandomNumberGenerator.new()
   195		rng.seed = 31337 + shard * 7717
   196		var train := F.training_pool(0)
   197		var cur: Army = train[(shard * 13) % train.size()].copy()
   198		var cur_f := fitness(cur, [target])
   199		for it in int(args.get("iters", "20")):
   200			var cand := mutate(cur, rng)
   201			var f := fitness(cand, [target])
   202			if f >= cur_f:
   203				cur = cand
   204				cur_f = f
   205		emit({"mode": "countersearch", "shard": shard, "fit": cur_f, "code": cur.to_code(), "comp": F.composition(cur)})
