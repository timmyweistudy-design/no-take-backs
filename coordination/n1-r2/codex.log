    84	func league(shard: int, shards: int) -> void:
    85		var pool := F.training_pool(0)
    86		for i in pool.size():
    87			if i % shards != shard:
    88				continue
    89			for k in 12:
    90				var j := (i * 37 + k * 53 + 1) % pool.size()
    91				if j == i:
    92					j = (j + 1) % pool.size()
    93				# 交換左右各打一次：i 當藍方、i 當紅方（結果都以 i 的角度記錄）
    94				for side in 2:
    95					var r := fight(pool[i], pool[j]) if side == 0 else fight(pool[j], pool[i])
    96					if side == 1:
    97						r["res"] = -r["res"]
    98					r["mode"] = "league"; r["a"] = i; r["b"] = j; r["k"] = k; r["side"] = side; r["comp"] = F.composition(pool[i])
    99					emit(r)
