   186	        fw = pct(sum(1 for r in dec if r["first_won"] == 1), len(dec))
   187	        ho = st.median([r["handoffs"] for r in T])
   188	        sp = st.median([r["spent0"] + r["spent1"] for r in T]) / 2
   189	        rule = T[0]["rule"]
   190	        blue = pct(sum(1 for r in dec if (r["first"] == 0) == (r["first_won"] == 1)), len(dec))
   191	        summary[f"{rule}_blue_win"] = blue
   192	        summary[f"{rule}_first_win"] = fw
   193	        summary[f"{rule}_handoffs"] = ho
   194	        md.append(f"\n## ③ 先後手（{rule}，{len(T)} 場，雙方同一個會讀對方的 AI）\n先手勝率 **{fw}%**、藍方（左邊）勝率 {blue}%（不含平手 {len(T)-len(dec)} 場）；每局換人次數中位數 {ho}；每方平均花 {sp:.0f} 金\n")
   195	        if fw > 55 or fw < 45:
