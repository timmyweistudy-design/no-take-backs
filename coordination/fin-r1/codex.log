   236	    open(os.path.join(folder, "report.md"), "w", encoding="utf-8").write("".join(md))
   237	    json.dump(summary, open(os.path.join(folder, "summary.json"), "w", encoding="utf-8"), ensure_ascii=False, indent=1)
