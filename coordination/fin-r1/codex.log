+	draw_rect(shade, Color(0.05, 0.06, 0.1, 0.45))
+	_text(Vector2(vs.x / 2, title_y), L.t("title"), big, Color("#ffe8a3"), true, true)
+	_text(Vector2(vs.x / 2, title_y + big * 1.18), "No Take-Backs", int(big * 0.36), Color(1, 1, 1, 0.95), true, true)
