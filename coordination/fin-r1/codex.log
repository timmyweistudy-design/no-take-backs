    90	## 數值摘要：本檔所有常數的 SHA-256 前 16 碼。遊戲、AI、平衡工具、重播都記錄它，證明跑的是同一份數值。
    91	static func data_digest() -> String:
    92		if _digest == "":
    93			var m: Dictionary = load("res://scripts/core/unit_defs.gd").get_script_constant_map()
    94			# 常數名稱是 StringName，直接排序是比記憶體位址、不是字母順序 → 先轉成 String 再排
    95			var pairs: Array = []
    96			for k in m:
    97				pairs.append([String(k), m[k]])
    98			pairs.sort_custom(func(a, b): return a[0] < b[0])
    99			var txt := ""
   100			for pr in pairs:
   101				txt += "%s=%s;" % [pr[0], var_to_str(pr[1])]
   102			_digest = txt.sha256_text().substr(0, 16)
   103		return _digest
