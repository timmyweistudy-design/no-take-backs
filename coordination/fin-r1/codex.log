   200	    if "search" in rows:
   201	        S = sorted(rows["search"], key=lambda r: -r["fit_holdout"])
   202	        best = S[0]
   203	        summary["search_best_holdout"] = round(best["fit_holdout"] * 100)
   204	        md.append(f"\n## ④ 萬用陣搜尋（{len(S)} 條爬山，各對 24 個保留陣演化，再對整個保留池 50 套驗證）\n")
   205	        md.append("| 名次 | 保留池勝率 | 組成（劍/盾/弓/騎/刺 金額） | 代碼 |\n|---|---|---|---|\n")
   206	        for i, r in enumerate(S[:5]):
   207	            md.append(f"| {i+1} | {round(r['fit_holdout']*100)}% | {r['comp']} | `{r['code']}` |\n")
   208	        md.append("\n「沒搜到」只代表在這個搜尋預算內沒找到，不等於證明不存在。\n")
   209	        if best["fit_holdout"] > 0.65:
   210	            warns.append(f"搜尋到保留池勝率 {round(best['fit_holdout']*100)}% 的陣型：要找至少兩種反制")
