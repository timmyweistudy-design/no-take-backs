    65		if call("_seek_pump"):
    66			return
    67		if skip_busy:
    68			_skip_step()
    69			return
    70		if paused:
    71			return
    72		if hitstop > 0:
    73			hitstop -= delta
    74			return
    75		var rate := speed
    76		if slow_left > 0:
    77			rate *= 0.5
    78			slow_left -= delta
    79		if final_left > 0:
    80			rate *= 0.25      # 第十輪 F1：最後一擊
    81			final_left -= delta
    82			_update_action_focus()
    83		accum += delta * rate
    84		while accum >= 0.05 and not view.finished:
    85			accum -= 0.05
    86			var was_slow := slow_left > 0 or final_left > 0
    87			_sim_step(true)
    88			if (slow_left > 0 or final_left > 0) and not was_slow:
    89				break   # 這一 tick 觸發慢動作：剩下的累積留到下一幀用慢速消耗（Codex S8 #3）
