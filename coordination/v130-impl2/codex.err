   240	## V1.1 B2：這一關「斬首」目標的單位 id（不是斬首關＝-1）。id 規則同 PZ.unit_alive。
   241	func _goal_target_id() -> int:
   242		var pz := PZ.get_puzzle(puzzle_id)
   243		if pz.is_empty() or PZ.goal(pz) != "kill" or not pz.has("goal_unit"):
   244			return -1
   245		return 1000 + int(pz["goal_unit"][1]) * Sim.COLS + int(pz["goal_unit"][0])
