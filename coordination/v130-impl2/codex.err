   291	## 烘焙用的畫家：一格一格呼叫 Art.unit（face＝+1，翻面由貼圖時處理）。
   292	class _Painter extends Node2D:
   293		var cb := false
   294		var types: Array = []
   295		func _draw() -> void:
   296			var Art2 = preload("res://scripts/ui/art.gd")
   297			var D2 = preload("res://scripts/core/unit_defs.gd")
   298			var saved: Transform2D = Art2.base
   299			Art2.base = Transform2D.IDENTITY
   300			var CELL2 := 192
   301			var RS2 := 1.6
   302			var W2 := 8
   303			var per := 2 + W2 + 2 + 8 + 8
   304			var cols := 16
   305			for k in types.size():
   306				var type: int = types[k]
   307				for team in 2:
   308					for f in per:
   309						var idx: int = (k * 2 + team) * per + f
   310						var cell_o := Vector2((idx % cols) * CELL2, (idx / cols) * CELL2)
   311						var walk := 0.0
   312						var atk := 0.0
   313						var vr := 0
   314						if f >= 2 and f < 2 + W2:
   315							walk = 0.0001 + (f - 2) * TAU / W2
   316						elif f == 2 + W2:
   317							walk = -100.0   # 拖行（Gait.POSE_DRAG）
   318						elif f == 3 + W2:
   319							walk = -200.0   # 暈眩（Gait.POSE_DAZE）
   320						elif f >= 4 + W2 + 8:
   321							atk = (f - (4 + W2 + 8) + 0.5) / 8.0
   322							vr = 1 if type < D2.CLASSIC else 2   # 第四輪新兵沒有交替招式，這一組放專屬動作（variant 2）
   323						elif f >= 4 + W2:
   324							atk = (f - (4 + W2) + 0.5) / 8.0
   325						var p := cell_o + (Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160)))
   326						var ex := 2.0 if type == D2.CAVALRY else 3.5
   327						# 眨眼那一格落在眨眼區間中間；其他格取 1.0（不在眨眼區間）
   328						var tt: float = (3.7 - ex * 0.13 + 0.05) if f == 1 else 1.0
   329						# 沒走路的格子（待機、眨眼、攻擊）Art.unit 會加呼吸位移；這裡反向抵銷，貼圖時再依當下時間加
   330						Art2.bake_no_bob = true   # V1.3：烘焙時不加呼吸（原本是反向抵銷），貼圖時再依當下時間與位置加
   331						Art2.unit(self, p, type, team, 1.0, walk, atk, 0.0, 1.0, tt, RS2, cb, 0, 0.0, 1.0, vr)
   332						Art2.bake_no_bob = false
   333			Art2.base = saved
   334	
   335	## V1.3 A1b：轉身頁。每種兵 × 兩隊 × 3 張中間姿勢（cos θ＝0.8、0.55、0.3），待機姿勢、face＝+1。
