   102		battle_marks.clear()
   103		_seek_stop = maxi(0, target - ViewBuffer.DELAY)
   104		_seek_target_now = target
   105	
   106	var _seek_target_now := 0
   107	
   108	## 算到時間用完或到達目標；到達回傳 true。
   109	func _seek_tick(budget_ms: int) -> bool:
   110		var t0 := Time.get_ticks_msec()
   111		while sim.tick < _seek_stop and not sim.finished:
   112			if Time.get_ticks_msec() - t0 >= budget_ms:
   113				return false
   114			sim.step()
   115			for ev in sim.events:   # 快轉時也要累計戰報次數與時間軸標記（Codex S5 #4：共用同一個收集函式）
   116				if ev.has("src"):
   117					var s = sim.unit_by_id(ev["src"])
   118					var key := "%s%d" % [ev["kind"], s.team]
   119					ev_count[key] = int(ev_count.get(key, 0)) + 1
   120					if ev["kind"] == EV.BLAST and not ev.has("dmg"):
   121						ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
   122				_collect_mark(ev, sim, sim.tick)
   123			if _seek_ct < 0 and not sim.finished and clutch_cond(sim):
   124				_seek_ct = sim.tick
   125		return true
   126	
   127	func _seek_finish() -> void:
   128		var target := _seek_target_now
   129		var keep_ct := _seek_ct
   130		var had_clutch := keep_ct >= 0
   131		view = ViewBuffer.new(sim)
   132		prev_pos.clear()
   133		_gait_reset()
   134		for u in view.units:
   135			prev_pos[u.id] = Vector2(u.x, u.y)
   136		fx.clear()
   137		dying.clear()
   138		graves.clear()
   139		atk_hit.clear()
   140		atk_seq.clear()
   141		atk_t.clear()
   142		hurt_t.clear()
   143		hurt_dir.clear()
   144		brace_t.clear()
   145		accum = 0.0
   146		result_delay = 0.0
   147		clutch_t = 0.0
   148		slow_left = 0.0
   149		final_left = 0.0     # Codex v10-r1 #4：跳回前段不能留著慢動作，再播到末擊要再演
   150		final_used = false
   151		key_used = false
   152		key_t = -10.0
   153		hitstop = 0.0
   154		# 演出狀態依目標時間重建（Codex S5 #5）：最後時刻是否已發生、是否已進狂熱、音樂
   155		slow_used = had_clutch
   156		clutch_tick = keep_ct if had_clutch else -1
   157		if had_clutch:
   158			battle_marks.append({"tick": keep_ct, "kind": "clutch", "team": -1})
   159		_pump_view()
   160		# 畫面推到剛好第 target tick（原本停在 target−DELAY）
   161		while view.tick < target and not view.finished:
   162			_sim_step(false)
   163		frenzy_seen = view.frenzy
   164		if sfx != null:
   165			sfx.play_music("music_frenzy" if view.frenzy else "music_battle")
   166	
   167	## 點戰場上的兵：鏡頭跟著它；點空地取消。
   168	func _battle_click(p: Vector2) -> void:
   169		if not _replay_controls_active() and not (paused and state == St.BATTLE):
   170			return
   171		var world := _cam.affine_inverse() * p
   172		var best := -1
   173		var bd := 40.0
   174		for u in view.units:
   175			if u.alive:
   176				var d := _upos(u).distance_to(world + Vector2(0, 20))
   177				if d < bd:
   178					bd = d
   179					best = u.id
   180		follow_id = best
   181		if play_kind == "official":
   182			return   # 正式對局暫停時只看資料，不動鏡頭
   183		if best < 0:
   184			zoom_target = 1.0   # 取消跟拍：回到全景（中心由 _battle_process 拉回）
   185	
   186	## 暫停（第七輪 A6）：正式對局也能停下來看；繼續時放掉選取。
   187	func _toggle_pause() -> void:
   188		paused = not paused
   189		if not paused and play_kind == "official":
   190			follow_id = -1
   191	
   192	
   193	## 進重播前存結算畫面（第七輪 A9）。
   194	func _replay_snapshot() -> void:
   195		if play_kind != "official" and not replay_snap.is_empty():
   196			return   # Codex r2：重播完再重播，返回目的地還是最早那個結算
   197		replay_snap = {"sim": sim, "view": view, "report": report, "marks": battle_marks.duplicate(true), "kind": play_kind,
   198			"tab": result_tab, "overlay": "", "ev_count": ev_count.duplicate(), "pt_rated": pt_rated, "pt_call": pt_call_tick}
   199	
   200	## 重播的「返回」：回到進來的地方。只還原畫面，比分、進度、成就、試玩紀錄都不寫。
   201	func _replay_back() -> void:
   202		call("_pre_drop")
   203		seek_target = -1   # Codex r1：算到一半返回，不能把下一場快轉到舊目標
   204		skip_busy = false
   205		paused = false
   206		follow_id = -1
   207		zoom = 1.0
   208		zoom_target = 1.0
   209		fx.clear()
   210		dying.clear()
   211		report_log.clear()
   212		sfx.set_muffled(false)
   213		if watch_mode or replay_snap.is_empty():
   214			call("_go_title")
   215			return
   216		sim = replay_snap["sim"]
   217		view = replay_snap["view"]
   218		report = replay_snap["report"]
   219		battle_marks = replay_snap["marks"]
   220		play_kind = replay_snap["kind"]
   221		result_tab = replay_snap["tab"]
   222		ev_count = replay_snap["ev_count"]   # Codex r1：戰報、評分狀態也要還原，不然同一局能再評一次
   223		pt_rated = replay_snap["pt_rated"]
   224		pt_call_tick = replay_snap["pt_call"]
   225		overlay = replay_snap["overlay"]
   226		result_delay = 0.0
   227		state = St.RESULT
   228		replay_snap = {}
   229	
   230	
   231	## 從關鍵時刻開始重播（第七輪 A7）。
   232	func _replay_from(t: int) -> void:
   233		call("_replay")
   234		_seek_async(t)
   235	
   236	
   237	func _follow_update(delta: float) -> void:
   238		if play_kind == "official":
   239			return
   240		if follow_id < 0 or view == null or state != St.BATTLE:
   241			return
   242		var u = view.unit_by_id(follow_id)
   243		if u == null or not u.alive:
   244			follow_id = -1
   245			return
   460	func _on_event(ev: Dictionary, with_fx: bool) -> void:
   461		var k: String = ev["kind"]
   462		if k == EV.CMD or k == EV.CMD_HIT:
   463			_cmd_event(ev, with_fx)
   464			return
   465		if _on_event_v8(ev, k, with_fx):
   466			return
   467		if k == EV.DEATH:
   468			var u = view.unit_by_id(ev["id"])
   469			dying.append({"pos": _upos(u), "type": u.type, "team": u.team, "face": signf(u.fx) if u.fx != 0 else 1.0, "t": 0.0})
   470			if with_fx:
   471				sfx.play("death", 0.7)
   472				_death_extra(u)
   473				# V1.1 B2：殘局「斬首」的目標倒下：頓格＋微震＋大字（只動播放，不進模擬）
   474				if mode == Mode.PUZZLE and _goal_target_id() == int(ev["id"]):
   475					if not bool(Save.s("reduce_fx")):
   476						hitstop = maxf(hitstop, 0.3)   # 簡化特效時不頓格（Codex v110-impl2）
   477					if _fx_on("shake"):
   478						shake = maxf(shake, 0.18)
   479					_fx_text(Vector2(640, 150), L.t("ev_behead"), ACCENT, 1.2, tz("H2"), true)
   480					sfx.play("bell", 0.9)
   481			return
   482		if k == EV.HEAL and with_fx:
   483			# 補血（第四輪 §4.4）：醫者到目標一條淡綠弧線＋綠色「+N」（不加黑底）
   484			var hs0 = view.unit_by_id(ev["src"])
   485			var ht0 = view.unit_by_id(ev["tgt"])
   486			if hs0 != null and ht0 != null:
   487				_add_fx({"kind": "healarc", "a": _upos(hs0) + Vector2(0, -40), "b": _upos(ht0) + Vector2(0, -26), "t": 0.0, "dur": 0.25})
   488				_merge_text(ht0.id, EV.HEAL, "+", int(ev["amt"]), _upos(ht0) + Vector2(0, -70), Color("#7dff8a"))
   489				sfx.play("heal", 0.35)
   490			return
   491		if k == EV.DRUM and with_fx:
   492			var dr0 = view.unit_by_id(ev["src"])
   493			if dr0 != null:
   494				_add_fx({"kind": "note", "p": _upos(dr0) + Vector2(6, -78), "t": 0.0, "dur": 0.8})
   495			return
   496		var route := event_route(ev)
   497		if route == "skip" or not with_fx:
   498			return
   499		match route:
   500			"taunt":
   501				var sh = view.unit_by_id(ev["src"])
   502				var vic = view.unit_by_id(ev["tgt"])
   503				_add_fx({"kind": "taunt", "p": _upos(sh), "t": 0.0, "dur": 0.6})
   504				sfx.play("taunt", 0.5)
   505				_add_fx({"kind": "bang", "p": _upos(vic) + Vector2(20, -66), "t": 0.0, "dur": 0.7})   # 第七輪 D1：移到頭頂側上方，不擋臉
   506				return
   507			"reveal":
   508				_add_fx({"kind": "puff", "p": _upos(view.unit_by_id(ev["src"])) + Vector2(0, -20), "t": 0.0, "dur": 0.45})
   509				sfx.play("reveal", 0.6)
   510				return
   511		var s = view.unit_by_id(ev["src"])
   512		var t = view.unit_by_id(ev["tgt"])
   513		var tags: Array = ev.get("tags", [])
   514		atk_t[s.id] = time
   515		hurt_t[t.id] = time
   516		var sp := _upos(s)
   517		var tpos := _upos(t)
   518		hurt_dir[t.id] = signf(tpos.x - sp.x) if tpos.x != sp.x else (1.0 if t.team == 1 else -1.0)
   519		if tags.has(EV.ALERT):
   520			sfx.play("alert", 0.5)
   521			_add_fx({"kind": "aim", "a": sp + Vector2(0, -24), "b": tpos + Vector2(0, -22), "t": 0.0, "dur": 0.32})
   522		if tags.has(EV.HIDE):
   523			_add_fx({"kind": "hide", "p": tpos + Vector2(0, -24), "dir": signf(sp.x - tpos.x) if sp.x != tpos.x else 1.0, "t": 0.0, "dur": 0.4})
   524		if tags.has(EV.TRIP):
   525			sfx.play("snap", 0.7)
   526			_add_fx({"kind": "trip", "p": tpos + Vector2(0, -4), "t": 0.0, "dur": 0.5})
   527		if s.type == D.BOMBER and k == EV.BOMB:
   528			_add_fx({"src": s.id, "kind": "boom", "p": tpos + Vector2(0, -6), "t": 0.0, "dur": 0.45})   # 帶攻擊者：同點多顆炸彈不被去重吃掉
   529			sfx.play("boom", 0.55)
   530		elif k == EV.SPLASH:
   531			pass   # 波及只靠爆炸圈和受擊閃白，不另外畫砍擊、不印字（Antigravity 第一輪 §6.2）
   532		elif s.type == D.ARCHER:
   533			_add_fx({"src": s.id, "kind": "arrow", "a": sp + Vector2(10 * signf(tpos.x - sp.x), -24), "b": tpos + Vector2(0, -22), "t": 0.0, "fly": 0.28, "dur": 0.46, "tc": Art.team_color(s.team, cbm())})   # V1.3：飛 0.28 秒＋釘住抖 0.18 秒
   534			sfx.play("arrow", 0.35)
   535		else:
   536			_add_fx({"src": s.id, "kind": "slash", "p": sp, "dir": signf(tpos.x - sp.x) if tpos.x != sp.x else 1.0, "t": 0.0, "dur": 0.18})
   537			sfx.play("hit" if k == EV.HIT else "slash", 0.4)
   538			_hit_material(int(ev.get("tgt", -1)))
   539		var col := Color.WHITE
   540		var label := ""
   541		match k:
   542			EV.CHARGE:
   543				label = L.t("ev_charge")
   544				col = ACCENT
   545				sfx.play("charge")
   546				sfx.play("bugle", 0.6)
   547				if _fx_on("shake"):
   548					shake = 0.12
   549				_add_fx({"kind": "dust", "p": tpos, "t": 0.0, "dur": 0.5})
   550			EV.BACKSTAB:
   551				label = L.t("ev_backstab")
   552				col = Color("#c77dff")
   553				sfx.play("backstab")
   554				sfx.play("aircut", 0.7)
   555				# 第七輪 D7：拿掉閃光 X（混戰疊成一片），只留方向斬痕
   556				_add_fx({"kind": "vslash", "p": tpos + Vector2(0, -26), "dir": signf(tpos.x - sp.x) if tpos.x != sp.x else 1.0, "t": 0.0, "dur": 0.2})
   557			EV.BRACED:
   558				label = L.t("ev_braced")
   559				col = Color("#9ad1ff")
   560				sfx.play("bell", 0.8)
   561				brace_t[t.id] = time
   562				_add_fx({"kind": "hex", "p": tpos + Vector2(10 * signf(sp.x - tpos.x), -24), "t": 0.0, "dur": 0.45})
   563			EV.ANTICAV:
   564				label = L.t("ev_anticav")
   565				col = Color("#9ad1ff")
   566				sfx.play("brace", 0.6)
   567			EV.BLOCKED:
   568				sfx.play("block", 0.5)
   569				_add_fx({"kind": "ripple", "p": tpos + Vector2(14 * signf(sp.x - tpos.x), -26), "c": Color("#cfe3ff"), "t": 0.0, "dur": 0.3})
   570			EV.COUNTER:
   571				label = L.t("ev_counter")
   572				col = Color("#80ffdb")
   573			EV.PIKE_BRACE:
   574				label = L.t("ev_pike_brace")
   575				col = Color("#ffd166")
   576				sfx.play("bell", 0.8)
   577				brace_t[t.id] = time   # 長槍兵頓槍（M_BRACE 疊加：槍尖銀光）
   578				_add_fx({"kind": "hex", "p": tpos + Vector2(10 * signf(sp.x - tpos.x), -24), "t": 0.0, "dur": 0.45})
   579			EV.BREACH:
   580				label = L.t("ev_breach")
   581				if not key_used:
   582					# V1.3 C4：每場第一次破陣是「關鍵時刻」：四周壓暗、向心墨圈，不動時間（預設開，簡化特效關）。
   583					# 跳播（with_fx＝false）時也記下「用過了」，跳過去之後的第二次破陣不會再演（Codex v130-impl1）
   584					key_used = true
   585					if with_fx:
   586						key_t = time
   587						key_p = tpos
   588				col = Color("#ff7a3d")
   589				sfx.play("shatter", 0.6)
   590				_add_fx({"kind": "shard", "p": tpos + Vector2(12, -26), "t": 0.0, "dur": 0.5})
   591			EV.BREAKER:
   592				sfx.play("shatter", 0.45)
   593				_add_fx({"kind": "shard", "p": tpos + Vector2(12, -26), "t": 0.0, "dur": 0.5})
   594		if label != "":
   595			_report_add(s.team, s.type, k, label, col, s)
   596			# 第七輪 D1：混戰（附近 3 隻以上）不再往上疊跳字，技能都進底部戰報列；稀疏時才跳字
   597			if int(TEXT_TIER.get(k, 1)) < 2:
   598				# V1.1 A5：一般狀態（反騎、反擊、破陣）不出字，只在頭頂閃一個小菱形，字留在底部戰報列
   599				_add_fx({"kind": "badge", "p": tpos + Vector2(0, -64), "c": col, "t": 0.0, "dur": 0.4})
   600			elif _crowd_at(t) < 3:
   601				_merge_text(t.id, k, label, int(ev["dmg"]), tpos + Vector2(0, -78), col)
   602			elif int(TEXT_TIER.get(k, 1)) >= 2:
   603				text_key_in += 1
   604				text_key_shown += 1   # 關鍵技能仍然有顯示，只是在戰報列（測試對帳用）
   605	
   606	
   607	
   608	# ── 戰鬥 HUD ──
   609	func _draw_battle_hud() -> void:
   610		_hud_bar(Rect2(0, 0, 1280, 96))   # V1.2：頂部資訊列改深木紋（原本是平塗深底）；V1.2.1 加高，大字級的下排小字（AI 名）也在木條內
   310				KEY_ESCAPE:
   311					if overlay == "ai_busy":
   312						pass      # 第十輪 I4：AI 計算中不能取消
   313					elif overlay != "":
   314						overlay = ""
   315					elif state == St.BATTLE:
   316						if play_kind != "official":
   317							_replay_back()   # 第七輪 A9：重播時 Esc＝返回
   318						else:
   319							_on_skip()
   320					elif state != St.TITLE:
   321						_request_leave()
   322			return
   323		pad_mode = true
   324		match k:
   325			KEY_UP: cursor.y = maxi(0, cursor.y - 1)
   326			KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
   327			KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
   328			KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
   329			KEY_F1:
   330				_open_codex(selected)
   331			KEY_H:
   332				if mode == Mode.PUZZLE:
   333					call("_puzzle_hint")   # 第十三輪：手把 L3
   334			KEY_P:
   335				if mode == Mode.PUZZLE and PZ.get_puzzle(puzzle_id).has("cmd"):
   336					overlay = "puzzle_plan"   # 第十三輪：手把 R3
   337			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0:
   338				# 第八輪：數字鍵對應這一排的第幾張卡，不是兵種編號
   339				var pos := 9 if k == KEY_0 else k - KEY_1
   340				var cards := _card_types()
   341				if pos < cards.size() and _allowed(cards[pos]):
   342					selected = cards[pos]
   343			KEY_Q, KEY_E:
   344				var cl := _card_types()
   345				if not cl.is_empty():
   346					var at := maxi(0, cl.find(selected))
   347					for _i in cl.size():
   348						at = (at + (cl.size() - 1 if k == KEY_Q else 1)) % cl.size()
   349						selected = cl[at]
   350						if _allowed(selected):
   351							break
   352			KEY_ENTER, KEY_KP_ENTER:
   353				if _cur_army().index_at(cursor.x, cursor.y) == -1:
   354					_try_place(cursor)
   355			KEY_BACKSPACE, KEY_DELETE:
   356				_try_remove(cursor)
   357			KEY_SPACE, KEY_TAB:
   358				_on_start()
   359			KEY_ESCAPE:
   360				_request_leave()
   361	
   362	
   363	
   364	func _throttle_when_minimized() -> void:
   365		var mini: bool = DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_MINIMIZED
   366		if mini != _was_minimized:
   367			_was_minimized = mini
   368			Engine.max_fps = 10 if mini else 0
   369	
   370	
   371	
   372	func _process(delta: float) -> void:
   373		_throttle_when_minimized()
   374		_rv_poll()
   375		_settings_hover()
   376		var _t0 := Time.get_ticks_usec()
   377		_process_inner(delta)
   378		perf_proc_us = Time.get_ticks_usec() - _t0
   379	
   380	
   381	func _process_inner(delta: float) -> void:
   382		_stick_repeat(delta)
   383		_process_cmds()
   384		time += delta
   385		SteamApi.run_callbacks()
   386		if toast_t > 0:
   387			toast_t -= delta
   388		if removed_banner_t > 0.0:
   389			removed_banner_t -= delta
   390		if ach_t > 0:
   391			ach_t -= delta
   392		elif not ach_queue.is_empty():
   393			toast = ach_queue.pop_front()
   394			toast_t = 2.5
   395			ach_t = 2.6
   396		shake = maxf(0.0, shake - delta)
   397		if not freeze_fx:
   398			for f in fx:
   399				f["t"] += delta
   400				if f.has("pop"):
   401					f["pop"] = maxf(0.0, f["pop"] - delta)
   402			fx = fx.filter(func(f): return f["t"] < f["dur"])
   403			clutch_t = maxf(0.0, clutch_t - delta)
   404		for g in dying:
   405			var t0: float = g["t"]
   406			g["t"] += delta
