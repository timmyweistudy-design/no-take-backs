   171				_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
   172				sfx.play("frenzy")
   173				sfx.play_music("music_frenzy")
   174		var deaths := 0
   175		for ev in view.events:
   176			var k: String = ev["kind"]
   177			if ev.has("src"):
   178				var s = view.unit_by_id(ev["src"])
   179				var key := "%s%d" % [k, s.team]
   180				ev_count[key] = int(ev_count.get(key, 0)) + 1
   181				if k == EV.BLAST and not ev.has("dmg"):   # 第八輪：爆炸演出一筆一次；逐目標傷害不算次數（BOOM_5）
   182					ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
