   235	func quant_walk(walk: float) -> float:
   236		if walk == 0.0:
   237			return 0.0
   238		if walk < -50.0:
   239			return walk
   240		return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES
