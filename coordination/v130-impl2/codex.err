   738			_unit(p, t, g["team"], face, 0.0, 0.0, hurt, lal * (1.0 - 0.2 * ft), time, UNIT_SCALE, 1 if k < 0.4 else 0, float(TOPPLE[t]) * (fe - bounce * ft), 1.0 - 0.1 * ft)
   739			return
   740		if al <= 0.0:
   741			return
   742		var lean := 0.0
   743		var crouch := 1.0
   744		match t:
   745			D.ASSASSIN:
   746				al *= 1.0 - u * 0.8      # 化煙
   747				for i in 5:
   748					var a0 := i * TAU / 5.0 + k * 2.0
   749					draw_circle(p + Vector2(cos(a0) * (6 + k * 30), -20 - k * 24 + sin(a0) * 6), 7.0 * (1.0 - k), Color(0.25, 0.2, 0.35, 0.5 * (1.0 - k)), true, -1.0, true)
   750			10:
   751				crouch = 1.0 - e * 0.7   # 孢子菇癟掉
   752			11:
   753				al *= 1.0 - u            # 羊：羊毛飛散
   754				for i in 7:
   755					var a1 := i * TAU / 7.0
   756					draw_circle(p + Vector2(cos(a1), sin(a1) * 0.6 - 0.8) * (8 + k * 46), 6.0 * (1.0 - k), Color(Art.team_color(g["team"], cbm()).lightened(0.3), 0.8 * (1.0 - k)), true, -1.0, true)
   757			12:
   758				lean = e * 0.5           # 箱子翻倒，鉚釘掉落
   759				for i in 4:
   760					draw_circle(p + Vector2((i - 1.5) * (6 + k * 14), -14 + k * k * 14), 1.8, Color(Art.GOLD, 1.0 - k), true, -1.0, true)
   761			13, 20:
   762				crouch = 1.0 - e * 0.8   # 史萊姆化開成一灘
   763				draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.4), 0, p))
   764				draw_circle(Vector2.ZERO, 8.0 + e * 16.0, Color(Art.team_color(g["team"], cbm()), 0.45 * (1.0 - k)), true, -1.0, true)
   765				draw_set_transform_matrix(_cam)
   766			14:
   767				p += Vector2(0, -e * 34.0)   # 幽靈往上消散
   768				al *= 1.0 - u * 0.7
   769			16, 17, 21, 15:
   770				crouch = 1.0 - e * 0.5   # 散開：骨頭、沙粒、布屑往外
   410			if f0 != 0.0 and signf(f1) != signf(f0):
   411				turn_t[u.id] = time   # V1.3 A1a：翻面那一刻（腳下揚塵、展開回彈從這裡算）
   412	
   413	## 轉身過場（V1.3 A1a）：像厚木牌俐落翻面，不是紙片等比夾扁。
   414	## 寬度不低於 TURN_MIN_W（窄位直接跳過去），展開段 X 微回彈 1.04；不做 Y 下壓（混戰時會像受擊）。
   415	const TURN_MIN_W := 0.45
   416	const TURN_BOUNCE := 0.04
   417	func _face_of(u) -> float:
   418		var f: float = face_now.get(u.id, signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0))
   419		var a := absf(f)
   420		if a < 0.9 and sprites != null and sprites.has_turn(u.type):
   421			# 有轉身影格的兵：傳原本的朝向，貼圖端選中間姿勢（不能是 0，退回直接繪製時才不會消失）
   422			return maxf(a, 0.18) * (1.0 if f >= 0.0 else -1.0)
   423		var w := TURN_MIN_W + (1.0 - TURN_MIN_W) * a
   424		if a < 1.0 and turn_t.has(u.id) and time - float(turn_t[u.id]) < 0.25:
   425			w *= 1.0 + TURN_BOUNCE * sin(clampf((a - 0.55) / 0.45, 0.0, 1.0) * PI)
   426		return w if f >= 0.0 else -w
