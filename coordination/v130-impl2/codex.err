   442		var cp: Vector2 = _upos(u) + Vector2(0, -26)
   443		match u.type:
   444			D.SHIELD:
   445				sfx.play("hit_metal", 0.22)
   446				call("_add_fx", {"kind": "chips", "p": cp, "t": 0.0, "dur": 0.32, "c": Color("#e8f0ff"), "spark": true})   # V1.1 A2：盾面火花
   447			19, 12:
   448				sfx.play("hit_wood", 0.3)
   449				if u.type == 19:
   450					call("_add_fx", {"kind": "chips", "p": cp, "t": 0.0, "dur": 0.38, "c": Color("#a89a86")})   # 小石魔碎屑
   451			13, 20:
   452				sfx.play("hit_soft", 0.3)
   453				call("_add_fx", {"kind": "chips", "p": cp, "t": 0.0, "dur": 0.4, "c": Color(0.45, 1.0, 0.55, 0.85), "drop": true})   # 史萊姆綠滴
