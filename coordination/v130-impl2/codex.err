   170	## 圖示膠囊標籤（R6）：kind＝"coin"／"unit"／"team"。回傳寬度。
   171	func _pill(p: Vector2, kind: String, label: String, col: Color, size := 16, cap := 99) -> float:
   172		var fsz := tcap(ts(size), cap)
   173		var tw := font_bold.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, fsz).x
   174		var w := tw + 40.0
   175		var h := fsz + 10.0
   176		draw_rect(Rect2(p, Vector2(w, h)), Color(0, 0, 0, 0.45))
   177		draw_rect(Rect2(p, Vector2(w, h)), Color(col, 0.6), false, 1.5)
   178		var ic := p + Vector2(15, h / 2)
   179		match kind:
   180			"coin":
   181				draw_circle(ic, 7.5, Color("#b8860b"), true, -1.0, true)
   182				draw_circle(ic, 5.5, ACCENT, true, -1.0, true)
   183				draw_line(ic + Vector2(0, -3), ic + Vector2(0, 3), Color("#b8860b"), 1.6, true)
   184			"unit":
   185				draw_circle(ic + Vector2(0, -3.5), 3.6, Color.WHITE, true, -1.0, true)
   186				draw_rect(Rect2(ic + Vector2(-5, 1), Vector2(10, 6)), Color.WHITE)
   187			_:
   188				draw_circle(ic, 6.5, col, true, -1.0, true)
   189		_text(p + Vector2(28, 5 - fsz * 0.05), label, fsz, Color.WHITE, false, true)
   190		return w
   191	
   192	
