   194	## 按鍵提示列（R6）：手把時顯示 [A]／[X] 等按鍵圖示，鍵盤時顯示鍵名。items＝[[鍵, 說明], ...]，置中於 cx。
   195	func _key_hints(cx: float, y: float, items: Array, size := 15) -> void:
   196		# 擺放畫面上方列高度固定 86px：大字設定時這一列最多放大到 17px，寬度不夠再縮（Codex 收尾輪 #3）
   197		var fs := tcap(ts(size), 17)
   198		var widths: Array = []
   199		var total := 0.0
   200		for it in items:
   201			var kw := font_bold.get_string_size(it[0], HORIZONTAL_ALIGNMENT_LEFT, -1, fs - 2).x + 14.0
   202			var lw := font.get_string_size(it[1], HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x
   203			widths.append([kw, lw])
   204			total += kw + 6 + lw + 18
   205		if total > 1260.0:
   206			_key_hints_scaled(cx, y, items, fs - 1)
   207			return
   208		var x := cx - total / 2.0
   209		for i in items.size():
   210			var kw: float = widths[i][0]
   211			var key: String = items[i][0]
   212			var kc: Color = {"×": Color("#42a5f5"), "O": Color("#ef5350"), "□": Color("#ec7fc1"), "▲": Color("#3ccf6e"), "A": Color("#3ccf6e"), "B": Color("#ef5350"), "X": Color("#42a5f5"), "Y": Color("#ffca28")}.get(key, Color(0.75, 0.78, 0.85))
   213			var r := Rect2(x, y, kw, fs + 6)
   214			if key.length() == 1 and pad_mode:
   215				draw_circle(r.get_center(), r.size.y / 2, kc, true, -1.0, true)
   216			else:
   217				draw_rect(r, Color(kc, 0.9))
   218			if pad_mode and key in PS_SYMS:
   219				_ps_glyph(r.get_center(), fs * 0.62, key)   # V1.2.1 G2：PS 鍵用向量符號（字型裡沒有 ○△，原本用字母 O／▲ 代替）
   220			else:
   221				_probe_glyph = true   # V1.2.1：鍵帽上的字母是符號，不算內文字級
   222				_text(Vector2(r.get_center().x, y + 1), key, fs - 2, Color(0.08, 0.08, 0.1), true, true)
   223				_probe_glyph = false
   224			x += kw + 6
   225			_text(Vector2(x, y + 1), items[i][1], fs, Color(1, 1, 1, 0.85))
   226			x += widths[i][1] + 18
   227	
   228	
   229	
   230	
   231	const PS_SYMS := ["×", "O", "□", "▲"]
   232	
   233	## V1.2.1 G2：PS 按鍵符號（叉、圈、方塊、三角）畫成向量，深色線條。
   234	func _ps_glyph(c: Vector2, s: float, key: String) -> void:
   235		var col := Color(0.08, 0.08, 0.1)
   236		var w := maxf(1.6, s * 0.2)
   237		var h := s * 0.5
   238		match key:
   239			"×":
   240				draw_line(c + Vector2(-h, -h), c + Vector2(h, h), col, w, true)
   241				draw_line(c + Vector2(-h, h), c + Vector2(h, -h), col, w, true)
   242			"O":
   243				draw_arc(c, h, 0.0, TAU, 20, col, w, true)
   244			"□":
   245				draw_rect(Rect2(c - Vector2(h, h) * 0.9, Vector2(h, h) * 1.8), col, false, w)
   246			"▲":
   247				draw_polyline(PackedVector2Array([c + Vector2(0, -h * 1.05), c + Vector2(h * 1.05, h * 0.8), c + Vector2(-h * 1.05, h * 0.8), c + Vector2(0, -h * 1.05)]), col, w, true)
   248	
   249	func _key_hints_scaled(cx: float, y: float, items: Array, fs: int) -> void:
   250		# 縮一號再排（以實際像素傳入，避免再乘一次字級）
   251		var widths: Array = []
   252		var total := 0.0
   253		for it in items:
   254			var kw := font_bold.get_string_size(it[0], HORIZONTAL_ALIGNMENT_LEFT, -1, fs - 2).x + 14.0
   255			var lw := font.get_string_size(it[1], HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x
   256			widths.append([kw, lw])
   257			total += kw + 6 + lw + 18
   258		if total > 1260.0 and fs > 10:
   259			_key_hints_scaled(cx, y, items, fs - 1)
   260			return
   261		var x := cx - total / 2.0
   262		for i in items.size():
   263			var kw: float = widths[i][0]
   264			var r := Rect2(x, y, kw, fs + 6)
   265			draw_rect(r, Color(0.75, 0.78, 0.85, 0.9))

