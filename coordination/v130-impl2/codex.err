   194	
   195	## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
   196	func _pump_view() -> void:
   197		for fr in view.pump(sim):
   198			for e in fr["events"]:
   199				# 第四輪：補血、戰鼓也走出手動畫；被貼身敲人、破陣、補血、戰鼓用專屬動作（variant 2）
   200				if e["kind"] == EV.HEAL or e["kind"] == EV.DRUM or e["kind"] == EV.BONK or e.get("tags", []).has(EV.BREACH):
   201					var ah: Dictionary = alt_hit.get(e["src"], {})
   202					ah[int(fr["tick"])] = true
   203					if ah.size() > 8:
   204						ah.erase(ah.keys().min())
   205					alt_hit[e["src"]] = ah
   206				if event_route(e) == "attack" or e["kind"] == EV.HEAL or e["kind"] == EV.DRUM:
   207					var hs: Array = atk_hit.get(e["src"], [])
   208					hs.append(int(fr["tick"]))
   209					if e["kind"] == EV.BOMB:
   210						# 投彈兵（第四輪 §4.4）：記下命中 tick → 目標，前搖期間畫火罐飛過去，命中那一刻剛好落地
   211						var bt: Dictionary = bomb_tgt.get(e["src"], {})
   212						bt[int(fr["tick"])] = e["tgt"]
   213						if bt.size() > 6:
   214							bt.erase(bt.keys().min())
   215						bomb_tgt[e["src"]] = bt
   216					# 每隻單位的第幾次出手（交替招式用，Codex S4 #2：原本用 tick 奇偶，連續反擊會同招）
   217					var sq: Dictionary = atk_seq.get(e["src"], {})
   218					sq[int(fr["tick"])] = sq.size()
   219					atk_seq[e["src"]] = sq   # 存序列，不覆蓋還沒播到的命中（Codex R5 #2：連續反擊）
   220					if hs.size() > 4:
   221						hs.pop_front()
   222					atk_hit[e["src"]] = hs
   223	
