   728			var ft := minf(k / 0.35, 1.0)
   729			var fe := ft * ft
   730			var bounce := 0.07 * sin(clampf((k - 0.35) / 0.18, 0.0, 1.0) * PI)
   731			var lal := 1.0 - clampf((k - 1.3) / 0.4, 0.0, 1.0)
   732			if lal <= 0.0:
   733				return
   734			if sprites != null and sprites.is_ready(cbm()):
