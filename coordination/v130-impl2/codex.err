   428	## 剛翻面的兵腳下的小揚塵：0～1（1＝剛翻），超過 0.25 秒＝0。
   429	func _turn_dust_k(u) -> float:
   430		if not turn_t.has(u.id):
   431			return 0.0
   432		var k: float = (time - float(turn_t[u.id])) / 0.25
   433		return 1.0 - k if k >= 0.0 and k < 1.0 else 0.0
   434	
   435	## 打到不同東西聲音不同：盾與石魔是硬的、史萊姆是軟的。
   436	func _hit_material(id: int) -> void:
   437		if id < 0 or view == null:
