diff --git a/game/tests/suites/ui.gd b/game/tests/suites/ui.gd
index 20c4442..820f4de 100644
--- a/game/tests/suites/ui.gd
+++ b/game/tests/suites/ui.gd
@@ -799,3 +799,69 @@ func test_replay_back_v7() -> void:
 		if FileAccess.file_exists(fn2):
 			DirAccess.remove_absolute(ProjectSettings.globalize_path(fn2))
 	SV.prefix = old_prefix
+
+
+class FakeTurnUnit:
+	var id := 0
+	var fx := 1
+	var team := 0
+	var type := 0
+	func _init(i: int, t: int) -> void:
+		id = i
+		type = t
+
+## V1.3：轉身寬度、呼吸錯開、倒棋時間、特效上限、擺陣沉降（只是畫面，不碰模擬）。
+func test_feel_v130() -> void:
+	var GS = load("res://scripts/ui/game_screens.gd")
+	var Art = load("res://scripts/ui/art.gd")
+	var D = load("res://scripts/core/unit_defs.gd")
+	var g = GS.new()
+	g.time = 10.0
+	var u := FakeTurnUnit.new(7, D.ARCHER)
+	for f in [0.0, 0.05, -0.05, 0.3, -0.3, 0.9, -1.0]:
+		g.face_now[u.id] = f
+		var w: float = g._face_of(u)
+		ok(absf(w) >= g.TURN_MIN_W - 0.001 and absf(w) <= 1.0 + g.TURN_BOUNCE + 0.001, "A1a：轉身寬度不低於 %.2f（朝向 %.2f → %.3f）" % [g.TURN_MIN_W, f, w])
+	g.face_now[u.id] = 0.5
+	g.turn_t[u.id] = 9.9
+	ok(g._turn_dust_k(u) > 0.0, "A1a：剛翻面有腳下揚塵")
+	g.time = 11.0
+	ok(g._turn_dust_k(u) == 0.0, "A1a：揚塵 0.25 秒後消失")
+	# 呼吸：同一欄（x 相同）不同列，相位不同
+	var b1: float = Art.idle_bob(3.0, Vector2(400, 300))
+	var b2: float = Art.idle_bob(3.0, Vector2(400, 364))
+	ok(absf(b1 - b2) > 0.05, "A2：同一欄上下兩隻呼吸不同步", "%.3f %.3f" % [b1, b2])
+	Art.bake_no_bob = true
+	ok(Art.idle_bob(3.0, Vector2(400, 300)) == 0.0, "A2：烘焙時不加呼吸")
+	Art.bake_no_bob = false
+	ok(Art.turn_c == 1.0 and Art.turn_s == 0.0, "A1b：平常 turn_c＝1（一般影格不受轉身影響）")
+	# 倒棋
+	ok(g.death_life(D.SWORD) > 1.5 and g.death_life(14) == 1.0, "A5：一般兵倒棋留 1.7 秒、幽靈等專屬死法 1 秒")
+	# 頭頂符號上限：滿了丟最舊的，新的留著
+	g.fx = []
+	for i in 9:
+		g._add_fx({"kind": "bang", "p": Vector2(100 + i * 60, 200), "t": 0.01 * (9 - i), "dur": 0.7, "tag": i})
+	var n_bang := 0
+	var has_last := false
+	for f in g.fx:
+		if f["kind"] == "bang":
+			n_bang += 1
+			if int(f.get("tag", -1)) == 8:
+				has_last = true
+	ok(n_bang <= int(g.OVERHEAD_CAP["bang"]) and has_last, "C：頭頂驚嘆號最多 %d 個、最新的一定在" % int(g.OVERHEAD_CAP["bang"]), str(n_bang))
+	# 跳字上限
+	g.fx = []
+	for i in 30:
+		g._fx_text(Vector2(100 + i * 20, 300), "-%d" % i, Color.WHITE, 1.0, 12)
+	var n_txt := 0
+	for f in g.fx:
+		if f["kind"] == "text":
+			n_txt += 1
+	ok(n_txt <= g.FX_TEXT_CAP, "P1：_fx_text 有上限", str(n_txt))
+	# 擺陣沉降
+	g.time = 5.0
+	g.settle_t[Vector2i(1000, 2000)] = 4.95
+	ok(g._settle_dy(Vector2i(1000, 2000)) < 0.0, "B3：剛放下時還在空中")
+	g.time = 5.5
+	ok(g._settle_dy(Vector2i(1000, 2000)) == 0.0 and not g.settle_t.has(Vector2i(1000, 2000)), "B3：沉降結束歸位並清掉")
+	g.free()
diff --git a/game/tools/anim_sheet.gd b/game/tools/anim_sheet.gd
index 31406c7..6941f8c 100644
--- a/game/tools/anim_sheet.gd
+++ b/game/tools/anim_sheet.gd
@@ -35,4 +35,31 @@ func _run() -> void:
 			sheet.blend_rect(imgs[pn], Rect2i(r), Vector2i(f * SC.CELL, ty * SC.CELL))
 	sheet.save_png(out + "/frames.png")
 	print("FRAMES ok ", per, " ", N)
+	# V1.3 A1b：轉身逐格條。每列一種試點兵（藍方）：正側面、cos 0.8／0.55／0.3、鏡像 0.3／0.55／0.8、反面
+	if cache.turn_tex != null:
+		var tim: Image = cache.turn_tex.get_image()
+		var nt: int = SC.TURN_TYPES.size()
+		var nc: int = SC.TURN_C.size()
+		var strip := Image.create(SC.CELL * (2 + nc * 2), SC.CELL * nt, false, Image.FORMAT_RGBA8)
+		strip.fill(Color("#7d9a58"))
+		for k in nt:
+			var ty: int = SC.TURN_TYPES[k]
+			var pn: int = cache.loc[ty][0]
+			if not imgs.has(pn):
+				imgs[pn] = cache.pages[pn]["tex"].get_image()
+			var side := Image.create(SC.CELL, SC.CELL, false, Image.FORMAT_RGBA8)
+			side.blit_rect(imgs[pn], Rect2i(cache._rect(int(cache.loc[ty][1]))), Vector2i.ZERO)
+			strip.blend_rect(side, Rect2i(0, 0, SC.CELL, SC.CELL), Vector2i(0, k * SC.CELL))
+			for j in nc:
+				var cell := Image.create(SC.CELL, SC.CELL, false, Image.FORMAT_RGBA8)
+				cell.blit_rect(tim, Rect2i(cache._rect(int(cache.turn_loc[ty]) + j)), Vector2i.ZERO)
+				strip.blend_rect(cell, Rect2i(0, 0, SC.CELL, SC.CELL), Vector2i((1 + j) * SC.CELL, k * SC.CELL))
+				var m := cell.duplicate()
+				m.flip_x()
+				strip.blend_rect(m, Rect2i(0, 0, SC.CELL, SC.CELL), Vector2i((nc * 2 - j) * SC.CELL, k * SC.CELL))
+			var ms := side.duplicate()
+			ms.flip_x()
+			strip.blend_rect(ms, Rect2i(0, 0, SC.CELL, SC.CELL), Vector2i((1 + nc * 2) * SC.CELL, k * SC.CELL))
+		strip.save_png(out + "/turn.png")
+		print("TURN ok ", nt)
 	quit()
diff --git a/tools/gen/gen_ui_tex.py b/tools/gen/gen_ui_tex.py
index baf8195..d5ec170 100644
--- a/tools/gen/gen_ui_tex.py
+++ b/tools/gen/gen_ui_tex.py
@@ -32,6 +32,50 @@ def rounded_mask(w, h, rad):
     return m
 
 
+def rough_mask(w, h, rad, amp=1.3, seed=1):
+    """V1.3 B1：手作邊。四個角半徑各不相同（±2），邊緣往內有 0～amp 像素的平滑起伏（磨損），4 倍超取樣再縮小。
+    只動最外 amp 像素，九宮格的內容內距（木 3／紙 5／凹槽 3）不受影響。"""
+    r = random.Random(seed)
+    S = 4
+    rads = [max(2.0, rad + r.uniform(-2.0, 2.0)) for _ in range(4)]   # 左上、右上、右下、左下
+    ph = [r.uniform(0, math.tau) for _ in range(6)]
+    pts = []
+    W, H = w * S, h * S
+    def bump(t):
+        # 低頻：每邊只有兩三處緩緩的削角／微凹（Antigravity v130-impl1：高頻像抗鋸齒失敗的毛邊）
+        v = 0.45 + 0.35 * math.sin(t * 3.0 + ph[0]) + 0.20 * math.sin(t * 7.0 + ph[1])
+        return max(0.0, min(1.0, v)) * amp * S
