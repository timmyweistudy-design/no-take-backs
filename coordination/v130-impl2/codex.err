   410		for g in graves:
   411			g["t"] += delta
   412		graves = graves.filter(func(g): return g["t"] < 3.0)
   413		if overlay == "codex":
   414			_codex_tick(delta)
   415		if overlay == "ai_busy":
   416			_ai_poll()
   417		if not pre_old.is_empty():
   418			_pre_reap()
   419		if state == St.TITLE and demo != null and shot_dir == "":
   420			demo_acc += delta
   421			while demo_acc >= 0.05:
   422				demo_acc -= 0.05
   423				demo.step()
   424			if demo.finished:
   425				_new_demo()

