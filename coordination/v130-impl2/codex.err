   226	## 事件分流（Codex R3 審查 #1）：只有帶 dmg 的才是攻擊；背水開關沒有 src；嘲諷、現形、繞翼只有演出。
   227	## 回傳 "death"／"skip"／"taunt"／"reveal"／"attack"。測試會把真實戰鬥的每一種事件都丟進來檢查。
   228	static func event_route(ev: Dictionary) -> String:
   229		var k: String = ev.get("kind", "")
   230		if k == EV.DEATH:
   231			return "death"
   232		if k == EV.TAUNT or k == EV.REVEAL:
   233			return k if ev.has("src") and ev.has("tgt") else "skip"
   234		if ev.has("dmg") and ev.has("src") and ev.has("tgt"):
   235			return "attack"
   236		return "skip"
   237	
