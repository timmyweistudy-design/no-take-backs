   155	static func build_full(team: int, rng: RandomNumberGenerator, level: int, known_enemy: Array, pool := -1, rules = null) -> Army:
   156		var a := Army.new(team, 100)
   157		if rules != null:
   158			a.apply_rules(rules, team)
   159		if pool >= 0:
   160			a.pool = pool
   161		if rules != null and rules.is_free():
   162			a.deploy = "grid"
   163			a.depth = 6000
   164			a.enemy_pos = []
   165			var g := fill_army(a, rng, level, _grid_known(known_enemy))
   166			return load("res://scripts/core/ai_army.gd").free_from_grid(g, rules)
   167		return fill_army(a, rng, level, known_enemy)
