   193	## 導航下一點（世界座標）。直線可達回 (-1, -1)＝直接走目的地。
   194	func nav_step(team: int, ux: int, uy: int, dx: int, dy: int) -> Vector2i:
   195		var ax: int = ux if team == 0 else w - ux
   196		var bx: int = dx if team == 0 else w - dx
   197		if _clear(ax, uy, bx, dy):
   198			return Vector2i(-1, -1)
   199		var goal := _nav_cell(clampi(bx / Q, 0, n - 1), clampi(dy / Q, 0, m - 1))
   200		var dist := _field(goal)
   201		var start := _nav_cell(clampi(ax / Q, 0, n - 1), clampi(uy / Q, 0, m - 1))
   202		if dist[start] >= INF:
   203			return Vector2i(-1, -1)      # 走不到（地圖驗證會擋；這裡退回直線，牆會擋住，時間到照判定）
   204		# 沿距離場走，取能直線看到的最遠一點（最多看 8 步），路線才不會鋸齒
   205		var cur := start
   206		var best := start
   207		for _k in 8:
   208			var c: int = cur % n
   209			var r: int = cur / n
   210			var nb := cur
   211			var nd: int = dist[cur]
   212			for d in N8:
   213				var dc: int = d[0]
   214				var dr: int = d[1]
   215				var a := c + dc
   216				var b := r + dr
   217				if a < 0 or a >= n or b < 0 or b >= m:
   218					continue
   219				var j := a + b * n
   220				if nav[j] == 1 or dist[j] >= nd:
   221					continue
   222				if dc != 0 and dr != 0 and (nav[c + dc + r * n] == 1 or nav[c + (r + dr) * n] == 1):
   223					continue
   224				nd = dist[j]
   225				nb = j
   226			if nb == cur:
   227				break
   228			cur = nb
   229			var px: int = cur % n * Q + Q / 2
   230			var py: int = cur / n * Q + Q / 2
   231			if _clear(ax, uy, px, py):
   232				best = cur
   233		var wx: int = best % n * Q + Q / 2
   234		var wy: int = best / n * Q + Q / 2
