   459	func _deck_load(i: int) -> void:
   460		var decks: Array = Save.data.get("decks", [])
   461		if i >= decks.size():
   462			return
   463		var sel: int = Presets.selectable(lobby_kind, _lobby_unlocked(), OS.has_feature("demo"))
   464		var p: int = int(decks[i]) & sel
   465		if p == 0 or not RuleSet.has_combat(p):
   466			_toast(L.t("lb_deck_locked"), true)
   650			var ms: Dictionary = lobby_r.max_spend(tm)
   651			if int(ms["unused"]) > 0:
   652				h += text_h("⚠ " + L.t("lb_unused", [ms["units"], ms["spend"], ms["unused"]]), tz("S"), w) + 4
   653		var df: Array = lobby_r.diff(_lobby_std())
   654		if not df.is_empty():
   655			h += tz("S") * 1.4
   656			for d in df:
   657				h += text_h("・" + _diff_text(d), tz("S"), w - 10)
   658		return h
