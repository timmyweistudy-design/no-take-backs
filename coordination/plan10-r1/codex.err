     2	## 音效與音樂（優化方案 H）：同類音效 80ms 內最多 2 個、音高 ±10% 隨機；音樂與音效分軌。
     3	## 優先權（第二輪方案 R8）：12 個聲道滿的時候，關鍵音（技能、死亡、最後時刻）會搶走優先權最低、播最久的普通命中音，
     4	## 不會被一堆砍擊聲擠掉。最後時刻慢動作時整體加低通濾波（悶住的心跳感）。
     5	
     6	const FILES := ["arrow", "backstab", "block", "brace", "charge", "clutch", "death", "frenzy", "hit", "lose",
     7		"place_heavy", "place_light", "place_mid", "slash", "start", "turn", "ui_click", "ui_deny", "win",
     8		"shatter", "bell", "bugle", "aircut", "alert", "snap", "taunt", "reveal", "boom", "heal",
     9		"poison", "baa", "chomp", "squish", "charge_up", "timestop", "raise", "vacuum", "stomp",
    10		"k_hover", "k_click", "k_back", "k_confirm", "k_tab", "k_toggle", "k_error", "k_open", "k_close", "k_unlock", "k_star", "k_place",
    11		"step_grass", "step_snow", "step_wood", "step_stone", "step_heavy", "hit_metal", "hit_wood", "hit_soft", "horn"]
    12	# 0 普通命中、1 防禦、2 技能／死亡、3 全場事件與介面
    13	const PRIO := {"hit": 0, "slash": 0, "arrow": 0, "block": 1, "brace": 1, "alert": 1, "taunt": 1, "reveal": 1,
    14		"shatter": 2, "bell": 2, "bugle": 2, "aircut": 2, "snap": 2, "charge": 2, "backstab": 2, "death": 2,
    15		"step_grass": 0, "step_snow": 0, "step_wood": 0, "step_stone": 0, "step_heavy": 1, "hit_metal": 0, "hit_wood": 0, "hit_soft": 0, "horn": 3,
    16		"k_hover": 3, "k_click": 3, "k_back": 3, "k_confirm": 3, "k_tab": 3, "k_toggle": 3, "k_error": 3, "k_open": 3, "k_close": 3, "k_unlock": 3, "k_star": 3, "k_place": 3,
    17		"poison": 0, "squish": 1, "charge_up": 1, "baa": 1, "chomp": 2, "timestop": 2, "raise": 2, "vacuum": 2, "stomp": 2, "clutch": 3, "frenzy": 3, "start": 3, "win": 3, "lose": 3, "turn": 3, "ui_click": 3, "ui_deny": 3}
    18	var _prio_of := {}       # 聲道 → 正在播的優先權
    19	var _started := {}       # 聲道 → 開始時間
    20	var _lowpass_idx := -1
    21	var streams := {}
    22	var players: Array[AudioStreamPlayer] = []
    23	var recent := {}   # 名稱 → [時間戳...]
    24	var music: AudioStreamPlayer
    25	var music_name := ""
    26	var amb: AudioStreamPlayer       # V9：地圖環境音
    27	var amb_name := ""
    28	var duck_t := 0.0                # V9：大招、號角時暫時壓低音樂
    29	var sfx_vol := 0.8
    30	var music_vol := 0.7
    31	var rng := RandomNumberGenerator.new()
    32	
    33	func _ready() -> void:
    34		for n in FILES:
    35			var st = load("res://audio/%s.wav" % n)
    36			if st:
    37				streams[n] = st
    38		for i in 12:
    39			var p := AudioStreamPlayer.new()
    40			add_child(p)
    41			players.append(p)
    42		music = AudioStreamPlayer.new()
    43		add_child(music)
    44		music.finished.connect(func(): music.play())
    45		amb = AudioStreamPlayer.new()
    46		add_child(amb)
    47		amb.finished.connect(func(): amb.play())
    48		var lp := AudioEffectLowPassFilter.new()
    49		lp.cutoff_hz = 900.0
    50		AudioServer.add_bus_effect(0, lp)
    51		_lowpass_idx = AudioServer.get_bus_effect_count(0) - 1
    52		AudioServer.set_bus_effect_enabled(0, _lowpass_idx, false)
    53	
    54	## 最後時刻：整體低通（慢動作開始時開、結束時關）。
    55	func set_muffled(on: bool) -> void:
    56		if _lowpass_idx >= 0 and AudioServer.is_bus_effect_enabled(0, _lowpass_idx) != on:
    57			AudioServer.set_bus_effect_enabled(0, _lowpass_idx, on)
    58	
    59	## 聲道選擇（純函式，測試用）：先找空的；滿了就搶優先權最低（同級取最早開始）且低於新音效的。沒有可搶的回 -1。
    60	static func pick_channel(busy: Array, prios: Array, starts: Array, prio: int) -> int:
    61		for i in busy.size():
    62			if not busy[i]:
    63				return i
    64		var best := -1
    65		for i in busy.size():
    66			if prios[i] < prio and (best < 0 or prios[i] < prios[best] or (prios[i] == prios[best] and starts[i] < starts[best])):
    67				best = i
    68		return best
    69	
    70	func set_volumes(sfx_pct: int, music_pct: int) -> void:
    71		sfx_vol = sfx_pct / 100.0
    72		music_vol = music_pct / 100.0
    73		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
    74	
    75	func play(name: String, vol := 1.0) -> void:
    76		if not streams.has(name) or sfx_vol <= 0.0:
    77			return
    78		if int(PRIO.get(name, 0)) >= 2 and not name.begins_with("k_"):
    79			duck(0.7)
    80		var now := Time.get_ticks_msec()
    81		var r: Array = recent.get(name, [])
    82		r = r.filter(func(t): return now - t < 80)
    83		if r.size() >= 2:
    84			return
    85		r.append(now)
    86		recent[name] = r
    87		var pr: int = PRIO.get(name, 1)
    88		var busy: Array = []
    89		var prios: Array = []
    90		var starts: Array = []
    91		for i in players.size():
    92			busy.append(players[i].playing)
    93			prios.append(_prio_of.get(i, 0))
    94			starts.append(_started.get(i, 0))
    95		var ch := pick_channel(busy, prios, starts, pr)
    96		if ch < 0:
    97			return
    98		var p := players[ch]
    99		p.stop()
   100		p.stream = streams[name]
   101		p.pitch_scale = 1.0 + rng.randf_range(-0.1, 0.1)
   102		p.volume_db = linear_to_db(maxf(0.0001, sfx_vol * vol))
   103		p.play()
   104		_prio_of[ch] = pr
   105		_started[ch] = now
   106	
   107	# ── 分軌戰鬥音樂（第三輪 S1）：低音、鼓、旋律三軌同時播、各自調音量 ──
   108	const LAYERS := ["music_battle_bass", "music_battle_drums", "music_battle_mel"]
   109	var layers: Array[AudioStreamPlayer] = []
   110	var layer_gain := [1.0, 0.35, 1.0]     # 目標
   111	var layer_cur := [1.0, 0.35, 1.0]      # 目前（平滑）
   112	
   113	func play_layers() -> void:
   114		music.stop()
   115		music_name = "layers"
   116		if layers.is_empty():
   117			for n in LAYERS:
   118				var p := AudioStreamPlayer.new()
   119				add_child(p)
   120				# 循環在匯入設定裡開（edit/loop_mode=2 整段循環）；檔案匯入時會壓縮，不能用位元組數自己算樣本數（Codex S7 #1）
   121				p.stream = load("res://audio/%s.wav" % n)
   122				layers.append(p)
   123		layer_cur = layer_gain.duplicate()
   124		for i in layers.size():
   125			layers[i].volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * layer_cur[i] * (0.45 if duck_t > 0.0 else 1.0)))
   126			layers[i].play(0.0)
   127	
   128	func stop_layers() -> void:
   129		for p in layers:
   130			p.stop()
   131	
   132	## 戰況 → 三軌目標音量：差距小（≤15%）鼓聲進來；最後時刻只留低音（心跳另外播）。
   133	static func layer_targets(close: bool, clutch: bool) -> Array:
   134		if clutch:
   135			return [1.0, 0.0, 0.0]
   136		return [1.0, 1.0 if close else 0.35, 1.0]
   137	
   138	func set_layer_targets(g: Array) -> void:
   139		layer_gain = g
   140	
   141	func _process(delta: float) -> void:
   142		if duck_t > 0.0:
   143			duck_t -= delta
   144			music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * (0.45 if duck_t > 0.0 else 1.0)))
   145		if music_name != "layers" or layers.is_empty():
   146			return
   147		for i in layers.size():
   148			layer_cur[i] = move_toward(layer_cur[i], layer_gain[i], delta * 1.5)
   149			layers[i].volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * layer_cur[i]))
   150	
   151	## V9：地圖環境音；空字串＝停。
   152	func play_ambience(name: String) -> void:
   153		if name == amb_name:
   154			return
   155		amb_name = name
   156		if name == "":
   157			amb.stop()
   158			return
   159		var st = load("res://audio/amb_%s.wav" % name)
   160		if st == null:
   161			amb.stop()
   162			return
   163		amb.stream = st
   164		amb.volume_db = linear_to_db(maxf(0.0001, sfx_vol * 0.22))
   165		amb.play()
   166	
   167	func duck(sec: float) -> void:
   168		duck_t = maxf(duck_t, sec)
   169	
   170	func play_music(name: String) -> void:
   171		if name == "music_battle":
   172			if music_name != "layers":
   173				play_layers()
   174			return
   175		if name == music_name:
   176			return
   177		stop_layers()
   178		music_name = name
   179		var st = load("res://audio/%s.wav" % name)
   180		if st == null:
   181			music.stop()
   182			return
   183		music.stream = st
   184		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
   185		music.play()

