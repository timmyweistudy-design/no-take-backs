    82	
    83	## ── 挑戰碼：把自己的陣型傳給朋友打（不需要伺服器）──
    84	func _challenge_encode() -> String:
    85		var r = rules if rules != null else RuleSet.standard()
    86		var j := JSON.stringify({"a": last_armies[0].to_code(), "r": r.to_code()})
    87		var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
    88		return "NTC1.%s.%s" % [b, b.sha256_text().substr(0, 6)]
    89	
    90	func _copy_challenge() -> void:
    91		DisplayServer.clipboard_set(_challenge_encode())
    92		_toast(L.t("ch_copied"))
    93	
    94	func _accept_challenge() -> void:
    95		var c := DisplayServer.clipboard_get().strip_edges()
    96		var d := _challenge_decode(c)
    97		if not d["ok"]:
    98			_toast(L.t("ch_bad"), true)
    99			return
   100		rules = d["rules"]
   101		challenge_army = d["army"]
   102		rules.rounds = 1
   103		_start_mode(Mode.VS_AI)
   104	
   105	## 回傳 {ok, rules, army}。陣型一定要照那組規則合法。
   106	func _challenge_decode(c: String) -> Dictionary:
   107		var bad := {"ok": false}
   108		var parts := c.split(".")
   109		if c.length() > 6000 or parts.size() != 3 or parts[0] != "NTC1" or parts[1].sha256_text().substr(0, 6) != parts[2]:
   110			return bad
   111		var b64 := parts[1].replace("-", "+").replace("_", "/")
   112		while b64.length() % 4 != 0:
   113			b64 += "="
   114		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
   115		if not j is Dictionary or not j.get("a") is String or not j.get("r") is String:
   116			return bad
   117		var rd: Dictionary = RuleSet.from_code(str(j["r"]))
   118		if not rd["ok"] or rd["rules"].fullfield != RuleSet.FULL_NONE:
   119			return bad      # 全場規則是雙方互相看得到才成立，不能當挑戰碼（Codex r2 #3）
   120		var r = rd["rules"]
   121		r.ai_pool_same = false
   122		# 碼是對方當藍軍排的，到這裡他變紅軍：兩邊的預算、卡池要對調（讓子局才有差，Codex #10）
   123		var b0: int = r.budget_of(0)
   124		var b1: int = r.budget_of(1)
   125		var p0: int = r.pool_of(0)
   126		var p1: int = r.pool_of(1)
   127		r.budget = [b1, b0]
   128		r.pool = [p1, p0]
   129		var a = Army.new(1, r.budget_of(1))
   130		a.apply_rules(r, 1)
   131		a.pool = RuleSet.full_pool()     # 朋友的牌不必在自己的解鎖範圍內
   132		if a.load_code(str(j["a"])) != "" or not a.has_combat():
   133			return bad
   134		return {"ok": true, "rules": r, "army": a}
   135	
