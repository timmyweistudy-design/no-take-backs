   179	## 把一支軍隊擺到買不起為止（第五輪：不再寫死 100 金、40 次）。
   180	static func fill_army(a: Army, rng: RandomNumberGenerator, level: int, known_enemy: Array) -> Army:
   181		var guard := 0
   182		var limit: int = (a.budget / 4 + 10) if a.guard_combat else 40   # 標準路徑維持 40 次（亂數呼叫次數不變）
   183		while a.can_afford_any() and guard < limit:
   184			guard += 1
   185			var t := choose_type(a, known_enemy if level == 2 else [], a.left(), rng, level)
   186			if t == -1:
   187				break
   188			var c := choose_cell(a, t, known_enemy if level >= 1 else [], rng)
   189			if c.x < 0:
   190				break
   191			a.place(t, c.x, c.y)
   192		return a
