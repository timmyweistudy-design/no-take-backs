    63	static func template_ok(ti: int, pool: int) -> bool:
    64		var w: Array = TEMPLATES[ti]["w"]
    65		for t in w.size():
    66			if w[t] > 0 and not RS.has(pool, t):
    67				return false
    68		return true
    69	
    70	static func eligible_templates(pool: int) -> Array:
    71		var out: Array = []
    72		for ti in TEMPLATES.size():
    73			if template_ok(ti, pool):
    74				out.append(ti)
    75		return out
    76	
    77	## pool：卡池遮罩（-1＝全部）；rules：第五輪 Ruleset（套人數／單種上限）。
    78	## 標準卡池時亂數呼叫次數與順序和 1.3.0 相同（金標準靠這個）。
    79	static func build(team: int, budget: int, rng: RandomNumberGenerator, template := -1, pool := -1, rules = null):
    80		if pool < 0:
    81			pool = RS.all_pool()
    82		var a = Army.new(team, budget)
    83		if RS.has_new(pool):
    84			a.pool = pool     # 第八輪：奇幻軍要明確開放（舊卡池維持原本的流程）
    85		if rules != null:
    86			a.apply_rules(rules, team)
    87			a.budget = budget
    88			a.pool = pool
    89			if rules.is_free():
    90				a.deploy = "grid"   # 先用格子擺，最後再拉開成自由座標（free_from_grid）
    91				a.depth = 6000
    92				a.enemy_pos = []
    93		var el := eligible_templates(pool)
    94		if template >= 0 and not template_ok(template, pool):
    95			template = -1   # 指定的模板用到未開放的兵種：改從可用的模板抽（Codex 實作審查 #3）
    96		if el.is_empty() and template < 0:
    97			# 第五輪：奇怪的卡池（例如只有刺客＋醫者）沒有合格模板 → 用落子 AI 的選兵邏輯在卡池內組陣
    98			var AIT = load("res://scripts/core/ai_turns.gd")
    99			var filled = AIT.fill_army(a, rng, 1, [])
   100			# V9：這條路一樣要轉成自由陣，否則雙方部署不同，開戰第 0 tick 就判無效（流程測試抓到）
   101			if rules != null and rules.is_free():
   102				filled = free_from_grid(filled, rules) if filled.deploy != "free" else filled
   103			return {"army": filled, "name": "—"}
   104		var ti := template if template >= 0 else int(el[rng.randi_range(0, el.size() - 1)])
   105		var w: Array = TEMPLATES[ti]["w"]
   106		var picks: Array = []
   107		var guard := 0
   108		while a.left() >= D.cheapest() and picks.size() < a.unit_cap and guard < 200:
   109			guard += 1
   110			var total := 0
   111			for t in D.total():
   112				if RS.has(pool, t) and D.cost(t) <= a.left() - _cost_sum(picks) and t < w.size() and w[t] > 0 and _cap_ok(a, picks, t):
   113					total += w[t]
   114			if total == 0:
   115				break
   116			var r := rng.randi_range(1, total)
   117			for t in D.total():
   118				if RS.has(pool, t) and D.cost(t) <= a.left() - _cost_sum(picks) and t < w.size() and w[t] > 0 and _cap_ok(a, picks, t):
   119					r -= w[t]
   120					if r <= 0:
   121						picks.append(t)
   122						break
   123			if _cost_sum(picks) > a.left():
   124				picks.pop_back()
   125				break
   126		# 先放盾兵、劍士，再放其他（讓前排先佔中間）
   127		picks.sort_custom(func(p, q): return PLACE_ORDER.find(p) < PLACE_ORDER.find(q))
   128		for t in picks:
   129			_place_pref(a, t)
   130		if rules != null and a.can_afford_any() and not load("res://scripts/game/presets.gd").deploy_standard(rules):
   131			# 自訂規則：模板比例填完還有錢（單種上限、小卡池）→ 落子 AI 補滿
   132			var AIT2 = load("res://scripts/core/ai_turns.gd")
   133			AIT2.fill_army(a, rng, 1, [])
   134		if rules != null and rules.is_free():
   135			a = free_from_grid(a, rules)
   136		return {"army": a, "name": TEMPLATES[ti]["name"]}
   137	
   138	## 第六輪：AI 的自由擺法——先用格子邏輯擺（亂數路徑不變），再依縱深把欄位等比拉開（§5「AI」）。
   139	static func free_from_grid(a, rules):
   140		var F = load("res://scripts/core/formations.gd")
   141		return F.to_free(a, rules, null, "stretch")
   142	
   143	static func _cap_ok(a, picks: Array, t: int) -> bool:
   144		var hc := D.hard_cap(t)
   145		if hc > 0 and picks.count(t) >= hc:
   146			return false
   147		if a.type_cap <= 0:
   148			return true
   149		return picks.count(t) < a.type_cap
   150	
   151	static func _cost_sum(picks: Array) -> int:
   152		var s := 0
   153		for t in picks:
   154			s += D.cost(t)
   155		return s
   156	
   157	static func _place_pref(a, t: int) -> void:
   158		var rows: Array = ROW_EDGE if t == D.CAVALRY else ROW_CENTER
   159		var cols: Array = PREF_COLS[t] + [5, 4, 3, 2, 1, 0]
   160		for c in cols:
   161			var col: int = c if a.team == 0 else Army.COLS - 1 - c
   162			for r in rows:
   163				if a.place(t, col, r):
   164					return
   165	
   166	# ── V9：AI 性格＝限定它偏好的兵種（交集後還要有戰鬥兵，否則用原卡池）──
   167	const STYLE_TYPES := {
   168		1: [1, 5, 0, 7, 8, 13, 19, 15],        # 鐵壁
   169		2: [2, 6, 17, 10, 7, 1],               # 遠程
   170		3: [4, 3, 14, 12, 11, 18, 9],          # 奇襲
   171		4: [13, 17, 0, 2, 10, 7, 12],          # 召喚
   172	}
   173	static func style_pool(pool: int, style: int, rng: RandomNumberGenerator) -> int:
   174		var p := 0
   175		if style == 5:
   176			var ts: Array = RS.types_of(pool)
   177			for k in mini(5, ts.size()):
   178				p |= 1 << int(ts[rng.randi_range(0, ts.size() - 1)])
   179		elif STYLE_TYPES.has(style):
   180			for t in STYLE_TYPES[style]:
   181				if RS.has(pool, t):
   182					p |= 1 << int(t)
   183		return p if p != 0 and RS.has_combat(p) else pool
     1	extends RefCounted
     2	## 陣型產生器（平衡工具 2.0 的訓練池／保留池，優化方案 B2）。全部由種子決定。
     3	
     4	const D = preload("res://scripts/core/unit_defs.gd")
     5	const Army = preload("res://scripts/core/army.gd")
     6	
     7	const STYLES := ["role", "random", "lane_top", "lane_bottom", "center", "front", "spread"]
     8	const ROLE_COLS := [
     9		[5, 4, 3], [5, 4], [0, 1, 2], [3, 2, 4], [2, 3, 1],
    10		[4, 3], [0, 1], [1, 2], [3, 2], [5, 4],   # 第四輪：槍、彈、醫、鼓、狂
    11		[4, 3, 5], [2, 3, 1], [5, 4], [5, 4], [3, 2], [5, 4], [2, 3], [0, 1], [3, 4], [5, 4],   # 第八輪
    12	]
    13	
    14	## 產生一套陣型。kind：
    15	##   "mixed" 隨機權重混編；"pure" 單一兵種；"duo" 兩種兵；"template" 用 ai_army 的原型權重。
    16	## ntypes：只用編號 0～ntypes−1 的兵種（預設全部）。亂數呼叫順序和 5 種時完全一樣，所以 ntypes＝5 會產生和舊版相同的池子。
    17	static func random_formation(team: int, rng: RandomNumberGenerator, kind := "mixed", style := "", ntypes := D.COUNT) -> Army:
    18		var a := Army.new(team, 100)
    19		var w: Array = D.zeros()
    20		var nt := ntypes
    21		# 第四輪：支援兵（醫者、鼓手）不能當主力。純兵種、雙兵種的第一種只從戰鬥兵抽；
    22		# 混編裡支援兵權重最多 1、每種最多 2 隻（不然一半的池子是「100 金全拿鼓手」這種沒人會擺的陣）。
    23		# nt ≤ 5 時沒有支援兵，亂數呼叫順序和舊版完全一樣。
    24		var fighters: Array = []
    25		for t in nt:
    26			if D.is_combat(t):
    27				fighters.append(t)
    28		match kind:
    29			"pure":
    30				w[fighters[rng.randi_range(0, fighters.size() - 1)]] = 1
    31			"duo":
    32				var p: int = fighters[rng.randi_range(0, fighters.size() - 1)]
    33				var q := (p + rng.randi_range(1, nt - 1)) % nt
    34				w[p] = rng.randi_range(1, 3)
    35				w[q] = rng.randi_range(1, 3)
    36			_:
    37				for t in nt:
    38					w[t] = rng.randi_range(0, 4)
    39					if D.is_support(t):
    40						w[t] = mini(w[t], 1)
    41				if w.max() == 0:
    42					w[rng.randi_range(0, nt - 1)] = 1
    43		if style == "":
    44			style = STYLES[rng.randi_range(0, STYLES.size() - 1)]
    45		var picks: Array = []
    46		var budget_left := 100
    47		var guard := 0
    48		while picks.size() < Army.MAX_UNITS and guard < 100:
    49			guard += 1
    50			var total := 0
    51			for t in nt:
    52				if w[t] > 0 and D.cost(t) <= budget_left and not (D.is_support(t) and picks.count(t) >= 2):
    53					total += w[t]
    54			if total == 0:
    55				break
    56			var r := rng.randi_range(1, total)
    57			for t in nt:
    58				if w[t] > 0 and D.cost(t) <= budget_left and not (D.is_support(t) and picks.count(t) >= 2):
    59					r -= w[t]
    60					if r <= 0:
    61						picks.append(t)
    62						budget_left -= D.cost(t)
    63						break
    64		for t in picks:
    65			place_styled(a, t, style, rng)
    66		return a
    67	
    68	## 指定權重的陣型（第四輪 unit_eval 用）：w 長度＝D.COUNT；權重 0 的兵種不出現。
    69	static func weighted_formation(team: int, rng: RandomNumberGenerator, w: Array, style := "") -> Army:
    70		var a := Army.new(team, 100)
    71		if style == "":
    72			style = STYLES[rng.randi_range(0, STYLES.size() - 1)]
    73		var picks: Array = []
    74		var budget_left := 100
    75		var guard := 0
    76		while picks.size() < Army.MAX_UNITS and guard < 100:
    77			guard += 1
    78			var total := 0
    79			for t in w.size():
    80				if w[t] > 0 and D.cost(t) <= budget_left:
    81					total += w[t]
    82			if total == 0:
    83				break
    84			var r := rng.randi_range(1, total)
    85			for t in w.size():
    86				if w[t] > 0 and D.cost(t) <= budget_left:
    87					r -= w[t]
    88					if r <= 0:
    89						picks.append(t)
    90						budget_left -= D.cost(t)
    91						break
    92		for t in picks:
    93			place_styled(a, t, style, rng)
    94		return a
