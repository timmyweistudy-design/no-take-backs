   292					elif state != St.TITLE:
   293						_go_title()
   294			return
   295		pad_mode = true
   296		match k:
   297			KEY_UP: cursor.y = maxi(0, cursor.y - 1)
   298			KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
   299			KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
   300			KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
   301			KEY_F1:
   302				_open_codex(selected)
