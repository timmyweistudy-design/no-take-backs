   511	## 手把按鍵提示列（第三輪 U7）：用手把時，每個畫面右下角顯示這個畫面能按的鍵（A／B／X／Y 圓形圖示）；
   512	## 用鍵盤滑鼠時不顯示手把圖示（Steam Deck 規定兩者不能同時出現）。擺放畫面已經在上方列顯示，這裡略過。
   513	func _draw_pad_footer() -> void:
   514		if not pad_mode or (state == St.PLACE and overlay == ""):
   515			return
   516		var items: Array = []
   517		if overlay == "codex":
   518			items = [["A", L.t("pk_select")], ["B", L.t("back")], ["R", L.t("pk_scroll")]]
   519		elif overlay != "":
   520			items = [["A", L.t("pk_select")], ["B", L.t("back")]]
   521		else:
   522			match state:
   523				St.TITLE:
   524					items = [["＋", L.t("pk_move")], ["A", L.t("pk_select")]]
   525				St.BATTLE:
   526					items = [["A", L.t("pk_select")], ["B", L.t("skip")]]
   527				St.RESULT:
   528					items = [["＋", L.t("pk_move")], ["A", L.t("pk_select")], ["B", L.t("menu")]]
   529		if items.is_empty():
   530			return
   531		draw_rect(Rect2(0, 770, 1280, 30), Color(0, 0, 0, 0.45))
   532		_key_hints(640, 773, items, 14)
