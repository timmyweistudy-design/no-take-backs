   345	## 字太寬就往下一級縮（第五輪：只在字級表內往下走，最小到「註記」，不再縮到 9px；還是太寬就由 _text 換行）。
   346	func fit(s: String, size: int, maxw: float, bold := false) -> int:
   347		var sz := size
   348		var levels: Array = TYPE_SCALE[_scale_key()].values()
   349		levels.sort()
   350		while _width(s, sz, bold) > maxw:
   351			var nxt := -1
   352			for v in levels:
   353				if v < sz:
   354					nxt = v
   355			if nxt < 0:
   356				break
   357			sz = nxt
   358		return sz
