    97	func _lobby_block() -> String:
    98		var bad: Array = lobby_r.validate()
    99		if not bad.is_empty():
   100			return L.t(bad[0])
   101		# 第六輪（Codex 實作第 1 輪 #4）：明牌全場只給對 AI、輪流全場只給雙人（貼上的規則代碼也要擋）
   102		if (lobby_r.fullfield == RuleSet.FULL_DUEL and lobby_kind != "duel") or (lobby_r.fullfield == RuleSet.FULL_AI and lobby_kind != "ai"):
   103			return L.t("rr_full_kind")
   104		var lk := _lobby_locked_units()
   105		if not lk.is_empty():
   106			var names: Array = []
   107			for t in lk:
   108				names.append(L.t("unit_%d" % t))
   109			return L.t("lb_has_locked", ["、".join(names)])
   110		return ""
