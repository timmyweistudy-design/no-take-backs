    26	## 打開大廳：沿用上次在這個模式用的規則（存檔裡的規則代碼）；沒有或不合法就用標準。
    27	func _open_lobby(kind: String) -> void:
    28		lobby_kind = kind
    29		var code := str(Save.data.get("last_rules", {}).get(kind, ""))
    30		var r = null
    31		if code != "":
    32			var d: Dictionary = RuleSet.from_code(code)
    33			if d["ok"]:
    34				r = d["rules"]
    35				r.preset = str(Save.data.get("last_rules", {}).get(kind + "_preset", "custom"))
    36				var ex = Save.data.get("last_rules", {}).get(kind + "_extra", [])
    37				if ex is Array and ex.size() >= 3:
    38					if ex.size() >= 4:
    39						r.time_of = clampi(int(ex[3]), 0, 2)
    40					r.ai_style = clampi(int(ex[0]), 0, RuleSet.AI_STYLES - 1)
    41					r.map_mode = clampi(int(ex[1]), 0, 2)
    42					r.bans = clampi(int(ex[2]), 0, 2)
    43		if r == null:
    44			r = Presets.make("standard", kind, _lobby_unlocked())
    45			# 第四輪的舊設定當作第一次打開大廳的初始值（Codex 第一輪）
    46			if str(Save.s("roster")) == "classic":
    47				r.pool = [31, 31]
    48			if kind == "duel":
    49				r.place_rule = str(Save.s("duel_rule")) if str(Save.s("duel_rule")) in RuleSet.PLACE_RULES else "snake5"
    50		lobby_r = r
    51		# 存過的規則照原樣保留（Codex 實作第 3 輪：重開雙人大廳不能把兩邊不同的卡池改成一樣）；含未解鎖兵由開戰鈕擋
    52		lobby_open = false
    53		lobby_menu = false
    54		lobby_item = ""
    55		lobby_tab = 0
    56		_open("lobby")
    57	
    58	func _lobby_clamp() -> void:
    59		Presets.clamp_pool(lobby_r, lobby_kind, _lobby_unlocked(), OS.has_feature("demo"))
