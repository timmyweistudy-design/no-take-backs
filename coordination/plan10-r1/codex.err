   512	## 部署區、中線對峙帶、（全場）敵兵禁區。
   513	func _fp_draw_zones() -> void:
   514		var a = _fp_army()
   515		var dep: int = a.depth
   516		var tc := Art.team_color(a.team, cbm())
   517		if dep < 15000:
   518			var x0: float = ORIGIN.x + (dep / 1000.0 if a.team == 0 else (a.fw - dep) / 1000.0) * CS
   519			draw_dashed_line(Vector2(x0, ORIGIN.y), Vector2(x0, ORIGIN.y + fld_size.y), Color(tc, 0.8), 3.0, 8.0)
   520			# 對峙帶（中線兩側到兩邊部署區的邊）
   521			var other: int = rules.depth_of() if rules != null and rules.fullfield == 0 else (rules.depth if rules != null else 6000)
   522			var xa: float = ORIGIN.x + other / 1000.0 * CS
   523			var xb: float = ORIGIN.x + (a.fw - other) / 1000.0 * CS
   524			if xb > xa:
   525				draw_rect(Rect2(xa, ORIGIN.y, xb - xa, fld_size.y), Color(0.85, 0.75, 0.55, 0.10))
   526		# 全場：敵兵 1.5 格禁區融合成一片均勻淡紅，只畫在戰場內（Antigravity 實作第 1 輪 #6）。
   527		# 0.125 格點陣，同一列連續的格子併成一個長方形；敵兵位置不變就用快取。
   528		if not a.enemy_pos.is_empty():
   529			var key: int = hash([a.enemy_pos, a.enemy_gap])
   530			if key != fp_zone_key:
   531				fp_zone_key = key
   532				fp_zone_rects = _fp_zone_raster(a.enemy_pos, a.enemy_gap)
   533			for r in fp_zone_rects:
   534				draw_rect(r, Color(1, 0.25, 0.25, 0.16))
   535	
   536	func _fp_zone_raster(ep: Array, gap: int) -> Array:
   537		var out: Array = []
   538		var cell := 125
   539		var g2 := gap * gap
   540		for j in fld_h / cell:
   424	func _draw_place_hud() -> void:
   425		# 第五輪 §4.4：頂部兩行。第一行＝模式／局數（左）、目前在做什麼＋金幣條＋人數（中）、規則徽章（右）；
   426		# 第二行＝選中兵種的資訊帶（名稱、一句定位、剋／怕頭像），完全在棋盤外，不蓋部署格。
   427		draw_rect(Rect2(0, 0, 1280, 92), UI_BG)
   428		draw_line(Vector2(0, 50), Vector2(1280, 50), Color(1, 1, 1, 0.08), 1.0)
   429		var a = _cur_army()
