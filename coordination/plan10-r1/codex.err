   133	## 自己視角的直線能不能走（格子取樣，不切角）。
   134	func _clear(ax: int, ay: int, bx: int, by: int) -> bool:
   135		var dx := bx - ax
   136		var dy := by - ay
   137		var steps: int = maxi(absi(dx), absi(dy)) / (Q / 2) + 1
   138		for i in range(1, steps + 1):
   139			var x: int = ax + dx * i / steps
   140			var y: int = ay + dy * i / steps
   141			if nav[clampi(x / Q, 0, n - 1) + clampi(y / Q, 0, m - 1) * n] == 1:
   142				return false
   143		return true
   144	
   145	## 目的格的距離場（BFS，直 10 斜 14，不切角）。
   146	func _field(goal: int) -> PackedInt32Array:
   147		if _fields.has(goal):
   148			return _fields[goal]
   149		var dist := PackedInt32Array()
