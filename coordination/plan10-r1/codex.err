   536	## 滑鼠停在哪一列：輸入狀態，每幀更新一次（第七輪 H7：原本在繪圖時改狀態）。
   537	func _settings_hover() -> void:
   538		if overlay != "settings":
   539			return
   540		var rows := _settings_rows()
   541		for i in rows.size():
   542			if Rect2(370, _settings_row_y(i), 520, 52).has_point(mouse):
