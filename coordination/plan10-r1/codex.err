   611		else:
   612			lines.append(L.t("place_hint_free"))
   613		var kt: Dictionary = Save.s("keys")
   614		lines.append(L.t("place_hint_keys", [Keymap.key_name(kt, "prev"), Keymap.key_name(kt, "next"), Keymap.key_name(kt, "start"), Keymap.key_name(kt, "codex")]))
   615		var body := "\n".join(lines)
   616		var w := 520.0
   617		var h := text_h(body, tz("S"), w - 28) + 24
   618		var r := Rect2(1280 - w - 12, 96, w, h)
   619		draw_rect(r, Color(0.06, 0.07, 0.1, 0.95))
   620		draw_rect(r, ACCENT, false, 1.5)
