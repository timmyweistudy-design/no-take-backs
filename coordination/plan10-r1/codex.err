   158			_btn(r, "", _take_reward.bind(i), true, false, TH_WOOD_L)
   159			_icon(items[i][0], r.position + Vector2(120, 58), 64.0, ACCENT)
   160			_text(r.position + Vector2(120, 104), L.t(items[i][1]), tz("B"), Color.WHITE, true, true, 220)
   161			_text(r.position + Vector2(120, 104 + tz("B") * 1.5), L.t(items[i][1] + "_d"), tz("C"), Color(1, 1, 1, 0.75), true, false, 220)
   162		_text(Vector2(640, 512), L.t("rw_now", [gauntlet_gold, gauntlet_cap]), tz("S"), Color(1, 1, 1, 0.75), true, false, 740)
