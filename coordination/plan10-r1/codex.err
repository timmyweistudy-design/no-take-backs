   164	## ── 雙人：輪流禁選 ──
   165	func _begin_bans(n: int) -> void:
   166		# 卡池太小時少禁幾張，至少留 3 種（Codex #6：5 種禁 2＋2 會卡死）
   167		n = mini(n, (mini(RuleSet.pool_count(rules.pool_of(0)), RuleSet.pool_count(rules.pool_of(1))) - 3) / 2)
   168		if n <= 0:
   169			_start_mode(Mode.DUEL)
   170			return
   171		ban_left = [n, n]
   172		ban_turn = 0
   173		overlay = "ban"
   174	
   175	func _ban_skip() -> void:
   176		ban_left[ban_turn] -= 1
   177		_ban_next()
   178	
   179	func _ban_next() -> void:
   180		ban_turn = 1 - ban_turn
   181		if ban_left[ban_turn] <= 0:
   182			ban_turn = 1 - ban_turn
   183		if ban_left[0] <= 0 and ban_left[1] <= 0:
   184			overlay = ""
   185			_start_mode(Mode.DUEL)
   186	
   187	func _ban(t: int) -> void:
   188		# 兩邊卡池可能不同：各自拿掉（Codex r2 #2）
   189		var np := [rules.pool_of(0) & ~(1 << t), rules.pool_of(1) & ~(1 << t)]
   190		for tm in 2:
   191			var p: int = np[tm]
   192			if not RuleSet.has_combat(p) or RuleSet.pool_count(p) < 3 or RuleSet.cheapest_combat_in(p) > rules.budget_of(tm):
   193				_toast(L.t("ban_no"), true)
   194				return
   195		rules.pool = np
   196		ban_left[ban_turn] -= 1
   197		sfx.play("k_error")
   198		_ban_next()
