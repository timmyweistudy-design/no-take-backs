   168	# ───────── 第六輪：自由陣型（方案 §6.3） ─────────
   169	## 把格子陣型轉成自由陣型。style：
   170	##   "stretch" 欄位依縱深等比拉開（AI 用的擺法）
   171	##   "jitter"  拉開後每隻再加 ±(1000−間距)/2 的偏移（保證間距）
   172	##   "dense"   同樣的兵依原本前後順序，用最小間距排成交錯（六角）密集陣
   173	## 結果一定合法（不合法的點略過）；部署限制照 r（deploy 必須是 free）。
   174	static func to_free(src: Army, r, rng: RandomNumberGenerator, style := "stretch") -> Army:
   175		var a := Army.new(src.team, src.budget)
   176		a.apply_rules(r, src.team)
   177		a.guard_combat = false
   178		a.depth = r.half_depth()   # 自己的半場（全場模式也一樣，AI 只擺自己這邊）
   179		var depth: int = r.half_depth()
   180		var j: int = (1000 - int(r.spacing)) / 2
   181		if style == "dense":
   182			# 依「自己視角 x 由大到小（前排先）」排序，用六角排列填
   183			var lst: Array = []
   184			for u in src.units:
   185				var p := Army.pos_of(u)
   186				lst.append([-src.own_x(p.x) * 10 + int(u["row"]) if u.has("row") else 0, int(u["type"])])
