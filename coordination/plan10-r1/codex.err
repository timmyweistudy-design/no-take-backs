   112	func _input(ev: InputEvent) -> void:
   113		if _keys_input(ev):
   114			return
   115		if ev is InputEventScreenTouch or ev is InputEventScreenDrag:
   116			fp_touch = true   # 第六輪：觸控時預覽畫在手指上方
   117			return
   118		if ev is InputEventMouseMotion:
   119			mouse = ev.position
   120			pad_mode = false
   121			if ev.device != InputEvent.DEVICE_ID_EMULATION:
   122				fp_touch = false
   123			hover_card = _card_at(mouse)
   124			_enqueue("paint", mouse)   # 一律排入，由執行端判斷有沒有在塗兵（同一幀按下再拖過也不漏格，Codex S3）
   125			return
   126		if ev is InputEventMouseButton:
   127			mouse = ev.position
   128			if overlay == "codex" and ev.pressed and (ev.button_index == MOUSE_BUTTON_WHEEL_UP or ev.button_index == MOUSE_BUTTON_WHEEL_DOWN):
   129				_scroll_at(mouse, -48.0 if ev.button_index == MOUSE_BUTTON_WHEEL_UP else 48.0)   # 圖鑑捲動（第三輪 U1）
   130				return
   131			_enqueue("mb", {"i": ev.button_index, "pressed": ev.pressed, "pos": ev.position})
   132			return
   133		if ev is InputEventKey and ev.pressed:
   134			if not ev.echo or ev.keycode in [KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT]:
   135				var dk: int = Keymap.key_to_default(Save.s("keys"), ev.keycode)
   136				if dk >= 0:
   137					_enqueue("key", dk)
   138			return
   139		if ev is InputEventJoypadButton:
   140			var db: int = Keymap.pad_to_default(Save.s("pad"), ev.button_index)
   141			if db < 0:
   142				return
   143			ev = ev.duplicate()
   144			ev.button_index = db
   145		if ev is InputEventJoypadButton and _is_free() and overlay != "" and not ev.pressed and ev.button_index in [JOY_BUTTON_A, JOY_BUTTON_X]:
   146			_fp_abort_drag()   # 覆蓋層開著時放開 A／X：清掉拖曳狀態（Antigravity 實作第 1 輪 #2）
   147		if ev is InputEventJoypadButton and _is_free() and overlay == "" and ev.button_index in [JOY_BUTTON_A, JOY_BUTTON_X, JOY_BUTTON_B, JOY_BUTTON_Y, JOY_BUTTON_LEFT_STICK, JOY_BUTTON_RIGHT_STICK, JOY_BUTTON_DPAD_UP, JOY_BUTTON_DPAD_DOWN, JOY_BUTTON_DPAD_LEFT, JOY_BUTTON_DPAD_RIGHT]:
   148			pad_mode = true
   149			_enqueue("padbtn", {"b": ev.button_index, "pressed": ev.pressed})   # 第六輪：自由排兵要知道按下與放開
   150			return
   151		if ev is InputEventJoypadButton and ev.pressed:
   152			pad_mode = true
   153			var map := {JOY_BUTTON_DPAD_UP: KEY_UP, JOY_BUTTON_DPAD_DOWN: KEY_DOWN, JOY_BUTTON_DPAD_LEFT: KEY_LEFT,
   154				JOY_BUTTON_DPAD_RIGHT: KEY_RIGHT, JOY_BUTTON_A: KEY_ENTER, JOY_BUTTON_B: KEY_ESCAPE, JOY_BUTTON_X: KEY_BACKSPACE,
   155				JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_Y: KEY_TAB, JOY_BUTTON_LEFT_SHOULDER: KEY_Q, JOY_BUTTON_RIGHT_SHOULDER: KEY_E,
   156				JOY_BUTTON_BACK: KEY_F1}
   157			if map.has(ev.button_index):
   158				_enqueue("key", map[ev.button_index])
   159			return
   160		if ev is InputEventJoypadMotion and ev.axis == JOY_AXIS_RIGHT_Y and overlay == "codex" and absf(ev.axis_value) > 0.3:
   161			pad_mode = true
   162			_scroll_by("left", ev.axis_value * 24.0)   # 右搖桿捲圖鑑左欄
   163			return
   164		if ev is InputEventJoypadMotion and (ev.axis == JOY_AXIS_LEFT_X or ev.axis == JOY_AXIS_LEFT_Y):
   165			# 左搖桿：只記下狀態，由 _stick_repeat 依固定節奏送方向鍵（Codex S1 #6：原本每個抖動事件都會送一次）
   166			stick[ev.axis] = ev.axis_value
   167			if absf(ev.axis_value) > 0.6:
   168				pad_mode = true
