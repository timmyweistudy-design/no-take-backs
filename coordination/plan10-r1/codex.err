   157			var h := 0.0
   158			for tx in texts:
   159				h += (_wrap(tx, sz, width).count("\n") + 1) * sz * 1.3 + gap
   160			if h - gap <= max_h:
   161				return sz
   162			sz -= 1
   163		return sz
