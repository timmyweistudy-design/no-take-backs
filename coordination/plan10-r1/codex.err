   314			return L.t("res_close", [side, unit, dmg, int(sim.tick / 20)])
   315		if int(sus.get("lock_ratio_permille", 0)) <= 200:
   316			return L.t("res_rout", [side, unit, dmg])
   317		return L.t("res_normal", [side, unit, dmg, lock_s])
   318	
   319	
   320	
   321	## V9：系列每局換地圖。換圖後舊陣型不一定放得下，所以不保留陣型。
   322	func _apply_map_mode() -> void:
   323		if rules == null or rules.map_mode == 0 or not rules.is_free():
   324			return
   325		var n: int = MapDefs.MAPS.size()
   326		rules.map_id = wrapi(rules.map_id + 1, 0, n) if rules.map_mode == 1 else rng.randi_range(0, n - 1)
   327		rules.keep_formation = false
   328		rules.vents = false
   329	
   330	func _next_round() -> void:
   331		if series_over:
   332			wins = [0, 0]
   333			round_no = 1
   334			series_over = false
   335			last_player_formation = []
   336			_reset_place(false)
   337			return
   338		round_no += 1
   339		_apply_map_mode()
   340		_reset_place(mode == Mode.VS_AI)
   341	
   342	
   343	
   344	func _replay() -> void:
   345		# 重播只看不算：比分、進度、成就、日誌都不動（第三輪 A1，原本會重複結算）
   346		replay_marks = _key_marks() if not report.is_empty() else []
   347		_replay_snapshot()
   348		if play_kind == "review" and rv_last.size() == 2:
   349			_begin_battle(rv_last[0].copy(), rv_last[1].copy(), "review")
   350			return
   351		_begin_battle(last_armies[0].copy(), last_armies[1].copy(), "replay")
   352	
   353	
   354	
   355	func _next_puzzle() -> void:
   356		var list: Array = PZ.tutorials() if mode == Mode.TUTORIAL else (PZ.fantasy_puzzles() if int(PZ.get_puzzle(puzzle_id).get("unit", 0)) >= D.COUNT else PZ.new_puzzles() if PZ.get_puzzle(puzzle_id).has("unit") else PZ.puzzles())
   357		for i in list.size():
   358			if list[i]["id"] == puzzle_id and i + 1 < list.size():
   359				var nx: Dictionary = list[i + 1]
   360				if nx.has("unit") and RS.games_to_unlock(int(nx["unit"]), _unlock_games(), OS.has_feature("demo")) != 0:
   361					break   # 下一關的新兵還沒解鎖
   362				puzzle_id = nx["id"]
   363				_start_mode(mode)
   364				return
   365		if mode == Mode.TUTORIAL and not PZ.puzzles().is_empty():
   366			puzzle_id = PZ.puzzles()[0]["id"]
   367			_start_mode(Mode.PUZZLE)
   368			return
   369		_go_title()
     1	extends RefCounted
     2	## 兵種開放（第四輪 §9 決定 1、2）：
     3	## ・新兵依「正式場數」逐一解鎖：前 3 場只用經典 5 種，之後每 2 場多一種（長槍兵→投彈兵→醫者→鼓手→狂戰士）
     4	## ・對 AI、遠征：開放數＝已解鎖數；AI 也只用這些兵種（不會拿你沒見過的兵打你）
     5	## ・朋友對戰：不看個人進度，由「兵種：經典 5 種／全部」設定決定（同一台電腦兩人共用）
     6	## ・對 AI 也可以選「經典 5 種」
     7	## ・試玩版：最多開到第一批新兵（7 種）；之後的兵卡標「正式版解鎖」
     8	## 純函式。進度：第五輪起看 Save.data["unlock_games"]（標準＋自訂局累計，存檔 v3 從舊的正式場數遷移）；設定「全部解鎖」時全開。
     9	
    10	const D = preload("res://scripts/core/unit_defs.gd")
    11	
    12	const UNLOCK_GAMES := [3, 5, 7, 9, 11]   # 第 k 個新兵（編號 5＋k）需要的正式場數
    13	const DEMO_MAX := 7
    14	
    15	## 依場數算出已解鎖的兵種數（5～10）；demo＝試玩版上限。
    16	static func unlocked_count(games: int, demo := false) -> int:
    17		var n := D.CLASSIC
    18		for g in UNLOCK_GAMES:
    19			if games >= g:
    20				n += 1
    21		return mini(n, DEMO_MAX) if demo else n
    22	
    23	## 這一場開放幾種兵。mode_kind："duel"（朋友對戰）、"ai"（對 AI、遠征）、"all"（教學、殘局：由關卡自己限制）。
    24	static func ntypes_for(mode_kind: String, games: int, classic: bool, demo := false) -> int:
    25		var cap := DEMO_MAX if demo else D.COUNT
    26		match mode_kind:
    27			"duel":
    28				return D.CLASSIC if classic else cap
    29			"ai":
    30				return D.CLASSIC if classic else unlocked_count(games, demo)
    31		return cap
    32	
    33	## 第 t 種兵還要再打幾場才解鎖（已解鎖回 0；試玩版鎖住的回 -1）。
    34	static func games_to_unlock(t: int, games: int, demo := false) -> int:
    35		if t < D.CLASSIC:
    36			return 0
    37		if t >= D.COUNT:
    38			if demo:
    39				return 0 if t == DEMO_SHOWCASE else -1
    40			return maxi(0, int(UNLOCK_NEW[t - D.COUNT]) - games)
    41		if demo and t >= DEMO_MAX:
    42			return -1
    43		return maxi(0, int(UNLOCK_GAMES[t - D.CLASSIC]) - games)
    44	
    45	## 打完一場後新解鎖的兵種（給提示用）。
    46	static func newly_unlocked(games_before: int, games_after: int, demo := false) -> Array:
    47		var out: Array = []
    48		for t in range(unlocked_count(games_before, demo), unlocked_count(games_after, demo)):
    49			out.append(t)
    50		return out
    51	
    52	
    53	# ───────── 第八輪：奇幻軍解鎖 ─────────
    54	## 第 11 場之後每 3 場開 1 種（編號 10～19）。
    55	const UNLOCK_NEW := [14, 17, 20, 23, 26, 29, 32, 35, 38, 41]
    56	const DEMO_SHOWCASE := 11      # 試玩版多開爆爆羊當賣點（非連號，所以試玩版不能只看 DEMO_MAX）
    57	
    58	## 最近一次解鎖的奇幻兵（大廳蓋「新」章，下一隻解鎖前都在）；還沒有回 -1。
    59	static func newest_new(games: int, demo := false) -> int:
    60		if demo:
    61			return DEMO_SHOWCASE
    62		var out := -1
    63		for i in UNLOCK_NEW.size():
    64			if games >= int(UNLOCK_NEW[i]):
    65				out = D.COUNT + i
    66		return out
    67	
    68	## 解鎖的兵種遮罩（新舊都算）。
    69	static func unlocked_mask(games: int, demo := false) -> int:
    70		var m := (1 << unlocked_count(games, demo)) - 1
    71		if demo:
    72			return m | (1 << DEMO_SHOWCASE)
    73		for k in UNLOCK_NEW.size():
    74			if games >= UNLOCK_NEW[k]:
    75				m |= 1 << (D.COUNT + k)
    76		return m
    77	
    78	static func is_unlocked(t: int, games: int, demo := false) -> bool:
    79		return (unlocked_mask(games, demo) >> t) & 1 == 1
    80	
    81	## 打完一場新解鎖的奇幻軍（給提示用）。
    82	static func newly_unlocked_new(games_before: int, games_after: int, demo := false) -> Array:
    83		var out: Array = []
    84		var a := unlocked_mask(games_before, demo)
    85		var b := unlocked_mask(games_after, demo)
    86		for t in range(D.COUNT, D.total()):
    87			if (b >> t) & 1 == 1 and (a >> t) & 1 == 0:
    88				out.append(t)
    89		return out
# 行銷時程、定價與商業試算（優化方案 P、Q）

> 數字只是規劃用的情境，不是預測。標 **【你】** 的是只有你能做的事。

## 目標場次（2026-11-04 決定）：2027 年 6 月 Next Fest
官方日期（[Steamworks](https://partner.steamgames.com/doc/marketing/upcoming_events/nextfest/june_2027)）：報名截止 **2027-04-25**；試玩版與商店頁送審 **05-10**（想趕上媒體預覽）、最晚 **05-24**；媒體預覽 06-03；活動 **06-14～06-21**。條件：商店頁要公開、活動開始前要有可玩試玩版、不能是 prologue／既有內容的試玩；每款遊戲只能參加一次。

依下面的節奏往回推（試玩版上架 3～4 個月後才參加）：
| 時間 | 事 | 誰 |
|---|---|---|
| 2026-12 中～2027-01 中 | 第一次真人試玩 10 人（T0−4 週） | 【你】找人 |
| 2027-01 | Steamworks 帳號、US$100、稅務、建 App（T0−2 週） | 【你】 |
| 2027-01 中～02 中 | 公開「即將推出」商店頁（T0） | 【你】 |
| 2027-02 中～03 中 | 上架試玩版（T0＋4 週） | Claude build；【你】發佈 |
| 2027-04-25 前 | 報名 Next Fest | 【你】 |
| 2027-05-10 前 | 試玩版、商店頁送審 | 【你】 |
| 2027-06-14 | Next Fest | |
| Next Fest 後 2～6 週 | 發售（首發 -15%） | 【你】決定日期 |

## 時程（以「開『即將推出』頁」為 T0）
| 時間 | 事 | 誰 |
|---|---|---|
| T0−4 週 | 正式素材路線定案（`legal.md` 素材段）；真人試玩 #1（`docs/playtest/protocol.md`） | 【你】找 10 位朋友；Claude 整理數據 |
| T0−2 週 | Steamworks 帳號、US$100 上架費、稅務與銀行資料、建 App | 【你】 |
| T0 | 開「即將推出」頁（`store-page.md`）、5 張截圖、預告片 | Claude 準備素材；【你】上傳與送審 |
| T0 起每週 | 一支 15～30 秒短片（X／Threads／YouTube Shorts／巴哈姆特）：一場最後時刻的翻盤 | Claude 錄影剪輯腳本；【你】發佈 |
| T0＋4 週 | 試玩版（教學 3 關＋殘局前 5 關＋對 AI 普通＋輪流落子；舊 7 種＋爆爆羊 1 種當賣點） | Claude build；【你】當次授權發佈 |
| T0＋4～16 週 | 每批邀 10 位小型實況主（中文 5、英文 5），附試玩版金鑰與「陣型代碼挑戰」 | 【你】寄信；Claude 準備信件模板與追蹤表 |
| 試玩版上架 3～4 個月後 | 報名 Steam 新品節（Next Fest） | 【你】 |
| Next Fest 後 2～6 週 | 發售（首發 -15%） | 【你】決定日期 |

**鉤子**（〔G〕）：
- 「輪流落子互嘴」很適合雙人實況。
- 觀眾可以貼陣型代碼挑戰實況主（代碼功能已做好）。

## 創作者邀請信模板（繁中）
> 主旨：可愛派兵自動對決《落子無悔》試玩邀請——擺好就不能反悔
>
> 你好，我是《落子無悔》的開發者。這是一款 2～4 分鐘一局的可愛派兵對決：擺好陣型按開戰就不能再動，只能看著它們打到最後一秒。
> 最適合實況的是「輪流落子」：兩個人公開輪流下兵，每人 5 手，擺下不能收回。也可以讓觀眾貼陣型代碼來挑戰你。
> 附上試玩版金鑰：XXXXX。如果有興趣做內容，任何形式都歡迎，不需要回覆或曝光承諾。

## 定價（〔G〕〔X〕）
- **建議 US$4.99**（台區約 NT$128～138，依 Steam 建議區域價格），首發 -15%。
- 理由：屬於衝動購買區間；評論對「純粹好玩的小品」容忍度高。競品 Mechabellum 是 US$14.99，但它是 3D、有線上天梯的大型作品，不同級距。
- 承諾：無課金、無局外養成、首發不承諾 DLC。

## 收入情境（未扣稅；Steam 分成 30%；退款率假設 8%；首發折扣影響已粗估）
| 情境 | 售出套數 | 毛收（US$4.99×0.9 均價） | 扣 Steam 30% 與退款 | 扣 US$100 上架費 |
|---|---|---|---|---|
| 保守 | 300 | ≈ 1,350 | ≈ 870 | ≈ 770 |
| 中位 | 1,000 | ≈ 4,490 | ≈ 2,890 | ≈ 2,790 |
| 樂觀 | 3,000 | ≈ 13,470 | ≈ 8,670 | ≈ 8,570 |

US$100 上架費在調整後總營收達 US$1,000 後由 Steam 回收給開發者（〔X〕更正：是回收，不是退款）。

**損益兩平**：目前沒有外包成本，只有上架費，所以約 **25 套**就打平。之後如果外包美術或音樂，要把成本加進來重算。

