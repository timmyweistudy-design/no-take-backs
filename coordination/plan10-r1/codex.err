   551	
   552	## ── 輸入命令佇列的執行端（第三輪 A2；S8 從 ui_base 移下來：基底不再用空函式呼叫上層）──
   553	func _process_cmds() -> int:
   554		var done := 0
   555		_update_gen()
   556		var q := _cmds
   557		_cmds = []
   558		for c in q:
   559			if c["gen"] != _gen:
   560				# 畫面已經換了：丟掉。但「放開滑鼠」一定要清掉拖曳／塗兵狀態（Codex S1 #2）
   561				if c["kind"] == "mb" and not c["data"]["pressed"]:
   562					_mb_release_cleanup()
   563				elif c["kind"] == "padbtn" and not c["data"]["pressed"]:
   564					_fp_abort_drag()   # 手把放開 A／X 的事件過期：同樣清掉（Codex 實作第 3 輪 #1）
   565				continue
   566			if c["kind"] == "click":
   567				done += _do_click(c["data"])
   568			elif c["kind"] == "mb":
   569				# 滑鼠按鍵（擺放、拖曳、移除）也走同一個佇列，和鍵盤選兵的先後順序一致（Codex S1 #2）
   570				_mb_cmd(c["data"])
   571				done += 1
   572			elif c["kind"] == "paint":
   573				_paint_cmd(c["data"])
   574			elif c["kind"] == "padbtn":
   575				if not _fp_pad_button(int(c["data"]["b"]), bool(c["data"]["pressed"])) and c["data"]["pressed"]:
   576					var mp := {JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_B: KEY_ESCAPE}
   577					if mp.has(int(c["data"]["b"])):
   578						_key(mp[int(c["data"]["b"])])
   579				done += 1
   580			elif c["kind"] == "key":
   581				_key(int(c["data"]))
   582				done += 1
   583			_update_gen()
   584		return done
   585	
   586	
   587	
   588	## 點擊：只對這個畫面世代畫出來的按鈕有效。回傳執行了幾個。
   589	func _do_click(p: Vector2) -> int:
   590		if _btns_gen != _gen:
   591			return 0
   592		for i in _btns.size():
   593			var b: Dictionary = _btns[i]
   594			if b["r"].has_point(p):
   595				if b["en"]:
   596					_focus = i
   597					if sfx != null:
   598						sfx.play(str(b.get("snd", "k_click")), 0.7)
   599					b["cb"].call()
   600					return 1
   601				return 0
   602		return 0

