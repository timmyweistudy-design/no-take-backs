   118	static func run_callbacks() -> void:
   119		if _steam != null:
   120			_steam.run_callbacks()
   121			if not store_ok:
   122				_retry_tick += 1
   123				if _retry_tick >= 600:
   124					_retry_tick = 0
   125					store_ok = bool(_steam.storeStats())

