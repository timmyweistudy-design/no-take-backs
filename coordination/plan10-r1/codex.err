     1	extends RefCounted
     2	## 展示緩衝（第二輪方案 R5、§3）：戰鬥畫面固定比模擬晚 DELAY 個 tick。
     3	## 模擬先跑，每個 tick 存一份「畫面需要的狀態」快照＋事件；畫面依展示時鐘一格一格播。
     4	## 這樣命中事件在畫面上發生前 DELAY 個 tick 就知道了，可以先演前搖；
     5	## 血量、死亡、音效、HUD、跳字全部讀同一個延後的快照，所以一起延後，不會只有動作延後。
     6	## 純演出：模擬本身的計算、結果、指紋完全不受影響。
     7	
     8	const DELAY := 2
     9	
    10	class VUnit:
    11		var hidden := false
    12		var link := -1
    13		var windup := 0
    14		var guard := 0
    15		var summon := false
    16		var id: int
    17		var team: int
    18		var type: int
    19		var x: int
    20		var y: int
    21		var hp: int
    22		var max_hp: int
    23		var alive: bool
    24		var stealth: int
    25		var stun: int
    26		var fx: int
    27		var fy: int
    28		var mx: int
    29		var my: int
    30		var charge: int
    31		var target: int
    32		var breach: int            # 第四輪：被破陣剩幾 tick
    33		var aura: int              # 第四輪：在鼓手光環內
    34		var bmode: int             # 第四輪：投彈兵模式
    35	
    36	var units: Array = []          # 跟 sim.units 同順序
    37	var tick := 0
    38	var rally := [false, false]
    39	var frenzy := false
    40	var events: Array = []         # 這一格（畫面上剛發生）的事件
    41	var finished := false          # 畫面已經播到模擬的最後一 tick
    42	var budget := 100
    43	var budgets := [100, 100]      # 第五輪：兩邊預算（讓子時不同；舊判定時兩格都＝藍方預算）
    44	var max_ticks := 1800          # 第五輪：這一局的長度（一局時間可調）
    45	
    46	func budget_of(t: int) -> int:
    47		return int(budgets[t])
    48	var zones: Array = []
    49	var _power := [0, 0]
    50	var _alive := [0, 0]
    51	var _by_id := {}
    52	var queue: Array = []          # 還沒播的快照（模擬已經跑到、畫面還沒到）
    53	
    54	## 把模擬當下的狀態存成一份快照。
    55	static func capture(sim) -> Dictionary:
    56		var us: Array = []
    57		for u in sim.units:
    58			us.append([u.id, u.team, u.type, u.x, u.y, u.hp, u.max_hp, u.alive, u.stealth, u.stun, u.fx, u.fy, u.mx, u.my, u.charge, u.target, u.breach, u.aura, u.bmode, 1 if u.hidden else 0, u.link, u.windup, u.guard, u.summon])
    59		return {"tick": sim.tick, "units": us, "events": sim.events.duplicate(true), "rally": sim.rally.duplicate(),
    60			"frenzy": sim.frenzy, "finished": sim.finished, "power": [sim.power(0), sim.power(1)],
    61			"alive": [sim.alive_count(0), sim.alive_count(1)], "zones": sim.zones.duplicate()}
    62	
    63	func _init(sim = null) -> void:
    64		if sim != null:
    65			budget = sim.budget
    66			budgets = sim.budgets.duplicate()
    67			max_ticks = sim.max_ticks
    68			apply(capture(sim))
    69			events = []
    70	
    71	func apply(fr: Dictionary) -> void:
    72		var us: Array = fr["units"]
    73		if units.size() != us.size():
    74			units.clear()
    75			_by_id.clear()
    76			for i in us.size():
    77				var v := VUnit.new()
    78				units.append(v)
    79		for i in us.size():
    80			var a: Array = us[i]
    81			var v: VUnit = units[i]
    82			v.id = a[0]; v.team = a[1]; v.type = a[2]; v.x = a[3]; v.y = a[4]; v.hp = a[5]; v.max_hp = a[6]
    83			v.alive = a[7]; v.stealth = a[8]; v.stun = a[9]; v.fx = a[10]; v.fy = a[11]; v.mx = a[12]; v.my = a[13]
    84			v.charge = a[14]; v.target = a[15]
    85			v.breach = a[16] if a.size() > 16 else 0
    86			v.aura = a[17] if a.size() > 17 else 0
    87			v.bmode = a[18] if a.size() > 18 else 0
    88			v.hidden = a[19] == 1 if a.size() > 19 else false
    89			v.link = a[20] if a.size() > 20 else -1
    90			v.windup = a[21] if a.size() > 21 else 0
    91			v.guard = a[22] if a.size() > 22 else 0
