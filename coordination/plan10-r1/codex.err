   144	## 困難 AI：第 1 局沒有資訊，用會讀對方的落子 AI 自己組；之後讀你上一局的陣型，
   145	## 先查離線反制庫（組成最接近的原型），查不到就用啟發式反制。不偷看你這一局。
   146	func _hard_ai(r: RandomNumberGenerator) -> Army:
   147		# 第四輪：候選陣型各和你上一局的陣型模擬一場，挑最好的（scripts/core/hard_ai.gd）
   148		var known: Array = last_player_formation if round_no > 1 else []
   149		return HardAI.build(known, _counter_lib(), r, rules.pool_of(1) if rules != null else _pool(), rules)
