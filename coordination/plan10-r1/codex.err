   169	## 困難 AI 讀上一局（自由座標）時，換成最近的格子給格子邏輯用。
   170	static func _grid_known(known: Array) -> Array:
   171		var out: Array = []
   172		for u in known:
   173			if u.has("col"):
   174				out.append(u)
   175			else:
   176				out.append({"type": u["type"], "col": clampi(int(u["x"]) / 1000, 0, 15), "row": clampi(int(u["y"]) / 1000, 0, 8)})
   177		return out
