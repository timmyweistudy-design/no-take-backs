    96	static func place_styled(a: Army, t: int, style: String, rng: RandomNumberGenerator) -> void:
    97		var cols: Array
    98		var rows: Array
    99		match style:
   100			"random":
   101				for _i in 60:
   102					var c := rng.randi_range(0, 5)
   103					var r := rng.randi_range(0, 8)
   104					if a.place(t, _abs_col(a, c), r):
   105						return
   106				cols = [5, 4, 3, 2, 1, 0]
   107				rows = [4, 3, 5, 2, 6, 1, 7, 0, 8]
   108			"lane_top":
   109				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
   110				rows = [0, 1, 2, 3, 4, 5, 6, 7, 8]
   111			"lane_bottom":
   112				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
   113				rows = [8, 7, 6, 5, 4, 3, 2, 1, 0]
   114			"front":
   115				cols = [5, 4, 3, 2, 1, 0]
   116				rows = [4, 3, 5, 2, 6, 1, 7, 0, 8]
   117			"spread":
   118				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
   119				rows = [0, 8, 4, 2, 6, 1, 7, 3, 5]
   120			_:   # role / center
   121				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
   122				rows = [4, 3, 5, 2, 6, 1, 7, 0, 8] if (style == "center" or t != D.CAVALRY) else [0, 8, 1, 7, 2, 6, 3, 5, 4]
   123		for c in cols:
   124			for r in rows:
   125				if a.place(t, _abs_col(a, c), r):
   126					return
