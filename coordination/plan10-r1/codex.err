   467	func _v8_achievements(w: int) -> void:
   468		if w < 0 or not (mode == Mode.VS_AI or mode == Mode.DUEL or mode == Mode.GAUNTLET):
   469			return
   470		if mode == Mode.VS_AI and w != 0:
   471			return
   472		if rules != null and rules.is_sandbox():
   473			return
   474		if int(ev_count.get("blast_fx%d" % w, 0)) >= 5:
   475			_ach("BOOM_5")
   476		if int(ev_count.get("raise%d" % w, 0)) >= 3:
   477			_ach("RAISE_3")
   478		var all_new: bool = armies.size() > w and not armies[w].units.is_empty()
   479		if all_new:
   480			for au in armies[w].units:
   481				if int(au["type"]) < D.COUNT:
   482					all_new = false
   483		if all_new:
   484			_ach("FANTASY_WIN")
