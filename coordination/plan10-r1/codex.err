   743	## 自訂模式：左邊分頁＋項目，右邊說明欄。
   744	func _draw_lobby_detail(R: Rect2) -> void:
   745		var tabs: Array = LOBBY_TABS.duplicate()
   746		if lobby_kind == "duel":
   747			tabs.erase("lb_tab_ai")
   748		for i in tabs.size():
   749			var idx: int = LOBBY_TABS.find(tabs[i])
   750			_btn(Rect2(R.position + Vector2(0, i * 58), Vector2(150, 50)), L.t(tabs[i]), func(): lobby_tab = idx, true, false,
   751				TH_ACTIVE if idx == lobby_tab else Color(0, 0, 0, 0))
   752		var L0 := Rect2(R.position + Vector2(170, 0), Vector2(600, R.size.y))
   753		var D0 := Rect2(Vector2(L0.end.x + 20, R.position.y), Vector2(R.end.x - L0.end.x - 20, R.size.y))
   754		draw_rect(D0, Color(0, 0, 0, 0.25))
   755		match lobby_tab:
   756			0:
   757				var rows: Array = [["budget", L.t("lb_gold_blue") if lobby_r.handicap else L.t("lb_gold"), L.t("lb_n_gold", [lobby_r.budget_of(0)])],
   758					["handicap", L.t("lb_handicap"), L.t("on") if lobby_r.handicap else L.t("off")]]
   759				if lobby_r.handicap:
   760					rows.append(["budget_red", L.t("lb_gold_red"), L.t("lb_n_gold", [lobby_r.budget_of(1)])])
   761				rows.append(["unit_cap", L.t("lb_cap"), L.t("lb_n_units", [lobby_r.unit_cap])])
   762				rows.append(["type_cap", L.t("lb_type_cap"), L.t("lb_nolimit") if lobby_r.type_cap == 0 else L.t("lb_n_units", [lobby_r.type_cap])])
   763				_rows(L0, rows)
   764			1:
   765				var fr: bool = lobby_r.deploy == "free"
   766				var rowsd: Array = [["deploy", L.t("lb_deploy"), L.t("lb_deploy_free") if fr else L.t("lb_deploy_grid")]]
   767				if fr:
   768					rowsd.append(["spacing", L.t("lb_spacing"), L.t("lb_cells", [lobby_r.spacing / 1000.0])])
   769					# 全場：雙人沒有縱深（整個戰場）；對 AI 的縱深只管 AI 自己擺多深（Antigravity 實作第 1 輪 #7）
   770					if lobby_r.fullfield == RuleSet.FULL_NONE:
   771						rowsd.append(["depth", L.t("lb_depth"), L.t("lb_cells", [lobby_r.depth / 1000.0])])
   772					elif lobby_kind == "ai":
   773						rowsd.append(["depth", L.t("lb_depth_ai"), L.t("lb_cells", [lobby_r.depth / 1000.0])])
   774					rowsd.append(["fullfield", L.t("lb_full_ai") if lobby_kind == "ai" else L.t("lb_full_duel"), L.t("on") if lobby_r.fullfield != 0 else L.t("off")])
   775				_rows(L0, rowsd)
     1	extends "res://scripts/ui/lobby_view.gd"
