    78	## 反制庫的陣型只能用這場開放的兵種（第四輪：不會拿你還沒解鎖的兵打你）。
    79	func _types_ok(a: Army) -> bool:
    80		for u in a.units:
    81			if int(u["type"]) >= _ntypes():
    82				return false
    83		return true
