   172	## 塗兵（佇列命令）：按住拖過格子連續擺。
   173	func _paint_cmd(p: Vector2) -> void:
   174		if _is_free():
   175			if overlay == "":
   176				_fp_motion(p)
   177			return
   178		if state != St.PLACE or overlay != "" or not painting:
   179			return
   180		if _cur_army().team != paint_team:
   181			painting = false
   182			return
   183		var c := _cell_at(p)
   184		if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   185			_try_place(c)
   186	
   187	
   188	
   189	func _mb_release_cleanup() -> void:
   190		_fp_abort_drag()
   191		drag_new = false
   192		painting = false
   193		drag_from = Vector2i(-1, -1)
   194	
   195	
   196	
   197	## 滑鼠按鍵（佇列命令，第三輪 A2）：按鈕點擊、擺放、拖曳、移除。
   198	func _mb_cmd(d: Dictionary) -> void:
   199		var mb := InputEventMouseButton.new()
   200		mb.button_index = d["i"]
   201		mb.pressed = d["pressed"]
   202		mb.position = d["pos"]
   203		mouse = d["pos"]
   204		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   205			if _do_click(mouse) > 0:
   206				_mb_release_cleanup()
   207				return
   208		if state == St.PLACE and overlay == "" and _fp_mb(d):
   209			return   # 第六輪：自由排兵處理掉了
   210		if overlay != "" or state != St.PLACE:
   211			if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
   212				_mb_release_cleanup()
   213				if overlay == "" and state == St.BATTLE and mb.button_index == MOUSE_BUTTON_LEFT:
   214					_battle_click(mouse)   # 重播時點兵讓鏡頭跟（第三輪 F2）
   215			return
   216		var c := _cell_at(mouse)
   217		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   218			var k := _card_at(mouse)
   219			if k >= 0 and _card_help_rect(k).has_point(mouse):
   220				return   # 放開時由「?」按鈕處理
   221			if k >= 0:
   222				if _allowed(k):
   223					selected = k
   224					drag_new = true
   225					sfx.play("k_click", 0.7)
   226				else:
   227					_toast(L.t("err_type"), true)
   228				return
   229			if c.x < 0:
   230				return
   231			if _can_edit_existing() and _cur_army().index_at(c.x, c.y) != -1:
   232				if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
   233					_toast(L.t("err_locked"), true)
   234					return
   235				drag_from = c
   236			else:
   237				painting = true
   238				paint_team = _cur_army().team
   239				_try_place(c)
   240		elif mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   241			if drag_new and c.x >= 0:
   242				_try_place(c)
   243			elif drag_from.x >= 0:
   244				if c.x < 0:
   245					_try_remove(drag_from)
   246				elif c != drag_from:
   247					if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() >= gauntlet_changes:
   248						_toast(L.t("err_changes"), true)
   249					elif not _cur_army().move(drag_from.x, drag_from.y, c.x, c.y):
   250						_toast(L.t("err_zone"), true)
   251					else:
   252						sfx.play("place_light")
   253			drag_new = false
   254			painting = false
   255			drag_from = Vector2i(-1, -1)
   256		elif mb.button_index == MOUSE_BUTTON_RIGHT and mb.pressed and c.x >= 0:
   257			_try_remove(c)
