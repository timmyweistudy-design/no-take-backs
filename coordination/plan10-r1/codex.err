   437	func _deck_random() -> void:
   438		var sel: Array = RuleSet.types_of(Presets.selectable(lobby_kind, _lobby_unlocked(), OS.has_feature("demo")))
   439		sel.shuffle()
   440		var p := 0
   441		for t in sel.slice(0, RuleSet.ROSTER_MAX):
   442			p |= 1 << int(t)
   443		if not RuleSet.has_combat(p):
   444			return
   445		lobby_r.pool[lobby_pool_team] = p
   446		if lobby_r.ai_pool_same:
   447			lobby_r.pool[1] = p
   448		_lobby_touch()
