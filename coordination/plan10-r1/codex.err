   112	## 模擬往前跑，直到緩衝裡有 DELAY 份還沒播的快照（或模擬結束）。回傳這次新加的快照，給前搖預告用。
   113	func pump(sim) -> Array:
   114		var added: Array = []
   115		while queue.size() < DELAY and not sim.finished:
   116			sim.step()
   117			var fr := capture(sim)
   118			queue.append(fr)
   119			added.append(fr)
   120		return added
   121	
   122	## 畫面前進一格；沒有可播的就回傳 false。
   123	func advance() -> bool:
   124		if queue.is_empty():
   125			return false
   126		apply(queue.pop_front())
   127		return true
