    82				var lvl := mini(2, (gauntlet_stage - 1) / 2)
    83				var e := AIT.build_full(1, r, lvl, gauntlet_prev, _pool())
    84				e.budget = 100 + 5 * (gauntlet_stage - 1)
    85				var guard := 0
    86				while e.can_afford_any() and guard < 20:
    87					guard += 1
    88					var t := AIT.choose_type(e, gauntlet_prev, e.left(), r, lvl, _pool())
    89					if t < 0:
    90						break
