   204		_h1(Vector2(640, 122), L.t("ban_title"))
   205		var who := L.t("blue") if ban_turn == 0 else L.t("red")
   206		_text(Vector2(640, 186), L.t("ban_turn", [who, ban_left[ban_turn]]), tz("H2"), Art.team_color(ban_turn, cbm()).lightened(0.2), true, true, 860)
   207		var ts0: Array = RuleSet.types_of(rules.pool_of(0) | rules.pool_of(1))
   208		for i in ts0.size():
   209			var t: int = ts0[i]
   210			var r := Rect2(200 + (i % 5) * 178, 250 + (i / 5) * 190, 168, 178)
   211			_btn(r, "", _ban.bind(t), true, false, TH_WOOD)
   212			_unit_in(Rect2(r.position, Vector2(r.size.x, 120)), t, 0, 1.0, 1.1)
   213			_text(r.position + Vector2(84, 128), L.t("unit_%d" % t), tz("B"), Color.WHITE, true, true, 160)
   214			if r.has_point(mouse) and not pad_mode:
   215				_icon("ban", r.position + Vector2(84, 62), 84.0)
   216		_btn(Rect2(1000, 124, 96, 40), L.t("ban_skip"), _ban_skip)
   217	
   218	## ── 戰績 ──
   219	func _record_match(w: int) -> void:
   220		if armies.is_empty() or armies[0] == null:
   221			return
   222		var ug: Dictionary = Save.data.get("unit_games", {})
   223		var seen := {}
   224		for u in armies[0].units:
   225			seen[str(int(u["type"]))] = true
   226		for k in seen:
   227			ug[k] = int(ug.get(k, 0)) + 1
   228		Save.data["unit_games"] = ug
   229		if w == 0:
   230			Save.data["streak"] = int(Save.data.get("streak", 0)) + 1
   231			Save.data["best_streak"] = maxi(int(Save.data.get("best_streak", 0)), int(Save.data["streak"]))
   232		else:
   233			Save.data["streak"] = 0
   234	
   235	func _draw_profile() -> void:
   236		var P := Rect2(50, 24, 1180, 752)
   237		_panel(P)
   238		_h1(Vector2(640, 34), L.t("pf_title"))
   239		var st: Dictionary = Save.data.get("stats", {})
   240		var cs: Dictionary = Save.data.get("custom_stats", {})
   241		var g: int = int(st.get("games", 0)) + int(cs.get("games", 0))
   242		var wn: int = int(st.get("wins", 0)) + int(cs.get("wins", 0))
   243		var trial := 0
   244		for v in Save.data.get("trial_stars", {}).values():
   245			trial += int(v)
   246		var tiles := [["swords", "pf_games", str(g)], ["trophy", "pf_wins", "%d%%" % (wn * 100 / maxi(1, g))], ["repeat", "pf_streak", "%d / %d" % [int(Save.data.get("streak", 0)), int(Save.data.get("best_streak", 0))]],
   247			["tower", "pf_trials", "%d / %d" % [trial, TRIALS.size() * 3]], ["road", "pf_gauntlet", "%d / 7" % int(Save.data.get("gauntlet_best", 0))]]
   248		var tw := 212.0
   249		for i in tiles.size():
   250			var r := Rect2(78 + i * (tw + 8), 92, tw, 80)
   251			_box(r, Color(0, 0, 0, 0.24), Color(0, 0, 0, 0), 7.0)
   252			_icon(tiles[i][0], r.position + Vector2(30, 40), 34.0, ACCENT)
   253			_text(r.position + Vector2(56, 10), L.t(tiles[i][1]), tz("C"), Color(1, 1, 1, 0.72), false, false, tw - 62)
   254			_text(r.position + Vector2(56, 34), tiles[i][2], tz("H2"), Color.WHITE, false, true, tw - 62)
   255		# 兵種勝率
   256		_text(Vector2(80, 184), L.t("pf_units"), tz("B"), ACCENT, false, true, 600)
   257		var ug: Dictionary = Save.data.get("unit_games", {})
   258		var uw: Dictionary = Save.data.get("unit_wins", {})
   259		var um := RS.unlocked_mask(_unlock_games(), OS.has_feature("demo"))
   260		var cw := 108.0
   261		for t in D.total():
   262			var r2 := Rect2(78 + (t % 10) * (cw + 4), 212 + (t / 10) * 116, cw, 110)
   263			_box(r2, Color(0, 0, 0, 0.2), Color(0, 0, 0, 0), 6.0)
   264			var open: bool = RuleSet.has(um, t)
   265			_unit_in(Rect2(r2.position, Vector2(cw, 70)), t, 0, 1.0 if open else 0.3, 0.62)
   266			var gg := int(ug.get(str(t), 0))
   267			var line := "—" if gg == 0 else "%d%%" % mini(100, int(uw.get(str(t), 0)) * 100 / gg)
   268			_text(r2.position + Vector2(cw / 2, 68), line, tz("B"), Color.WHITE, true, true, cw - 6)
   269			if gg > 0:
   270				pass
   271		# 成就
   272		var earned: Array = Save.data.get("achievements", [])
   273		var ach: Dictionary = SteamApi.ACHIEVEMENTS
   274		var keys := ach.keys()
   275		_text(Vector2(80, 448), L.t("pf_ach", [earned.size(), keys.size()]), tz("B"), ACCENT, false, true, 600)
   276		for i2 in keys.size():
   277			var k: String = keys[i2]
   278			var on: bool = k in earned
   279			var pos := Vector2(84 + (i2 % 3) * 372, 480 + (i2 / 3) * 30)
   280			_icon("star" if on else "lock", pos + Vector2(10, 12), 20.0, Color("#ffd166") if on else Color(1, 1, 1, 0.3))
   281			_text(pos + Vector2(26, 0), str(ach[k][0 if L.lang == "zh_TW" else 1]), tz("C"), Color.WHITE if on else Color(1, 1, 1, 0.66), false, false, 340)
   282		_btn(Rect2(560, 722, 160, 44), L.t("back"), func(): overlay = "")
   283	
   284	## ── 殘局提示：只給方向，不給解 ──
   285	func _puzzle_hint() -> void:
   286		var cnt := {}
   287		for u in armies[1].units:
   288			var t := int(u["type"])
   289			cnt[t] = int(cnt.get(t, 0)) + D.cost(t)
   290		var top := -1
   291		for t2 in cnt:
   292			if top < 0 or int(cnt[t2]) > int(cnt[top]):
   293				top = t2
   294		if top < 0:
   295			return
   296		var who := ""
   297		for x in D.total():
   298			if top in AIT.BEATS[x] and _allowed(x):
   299				who = L.t("unit_%d" % x)
   300				break
   301		_toast(L.t("hint_main", [L.t("unit_%d" % top)]) if who == "" else L.t("hint_counter", [L.t("unit_%d" % top), who]))
     1	extends RefCounted
     2	## 設定與進度存檔（優化方案 L1、N）：JSON、原子寫入（先寫暫存檔再改名）＋保留上一版備份。
     3	## 雲端：Steam Auto-Cloud 只同步 user://save.json（進度、陣型）；設定 user://settings.json 留在本機。
     4	
     5	const SAVE_VERSION := 3   # 存檔格式版本（schema_version）。2：加 unit_wins（圖鑑老兵筆記，第二輪方案 R3／R8）；3：第五輪自訂規則
     6	const MAX_PRESETS := 5
     7	static var prefix := ""   # 截圖／測試模式用 "shot_"，不碰玩家真正的存檔
     8	
     9	const DEFAULT_SETTINGS := {
    10		"lang": "zh_TW", "text_scale": 100, "shake": true, "slowmo": true, "flash": true, "colorblind": false, "plain_titles": false, "confirm_place": true,
    11		"speed": 1.0, "music": 70, "sfx": 80, "duel_rule": "snake5", "fullscreen": false, "playtest": false, "roster": "all", "unlock_all": false, "reduce_fx": false, "keys": {}, "pad": {},
    12	}
    13	const DEFAULT_SAVE := {
    14		"schema_version": SAVE_VERSION, "slots": ["", "", "", "", ""], "tutorial": 0, "puzzle_stars": {},
    15		"gauntlet_best": 0, "achievements": [], "stats": {"wins": 0, "games": 0}, "unit_wins": {},
    16		# 第五輪：解鎖累計場數（標準＋自訂局都算，沙盒不算）、自訂規則戰績、我的預設、上次在大廳用的規則（代碼）
    17		"unlock_games": 0, "custom_stats": {"wins": 0, "games": 0}, "rule_presets": [], "last_rules": {}, "gauntlet_pool": 0, "trial_stars": {}, "unit_games": {}, "streak": 0, "best_streak": 0, "decks": [], "free_intro_done": false,
    18	}
    19	
    20	static var settings := {}
    21	static var data := {}
    22	## 第七輪 R5：存檔來自比這一版新的遊戲。原檔不動、這次進度不寫入，畫面要告知玩家。
    23	static var data_locked := false
    24	## 第七輪 R6：這次讀到的來源："none"／"main"／"bak"（"bak"＝主檔壞了，已隔離）。
    25	static var data_source := "none"
    26	## 第七輪 R7：寫入失敗還沒補上的檔案（路徑）；retry_pending() 重試。
    27	static var pending := {}
    28	## 只給測試用：接下來幾次寫入要假裝失敗（"tmp"＝寫暫存失敗；"rotate"＝輪替備份失敗）。
    29	static var fail_inject := {}
    30	
    31	static func load_all() -> void:
    32		pending = {}
    33		settings = sanitize_settings(_read(_sp(), {}).get("value", {}))
    34		var r := _read(_dp(), {})
    35		data_source = r["source"]
    36		var raw: Dictionary = r["value"]
    37		data_locked = schema_of(raw) > SAVE_VERSION
    38		# 未來版存檔：記憶體用全新進度，檔案完全不碰（Codex plan7 R5）
    39		data = migrate({}) if data_locked else migrate(raw)   # 先讀原始內容再遷移（遷移裡才補預設值），不然舊檔會被當成新版（Codex 收尾輪 #1）
    40	
    41	## 檔名前綴：測試／截圖的 prefix 在前；試玩版另外一份，進度不帶進正式版（N1、§18-4）。
    42	static func file_prefix(demo := OS.has_feature("demo")) -> String:
    43		return prefix + ("demo_" if demo else "")
    44	
    45	static func _sp() -> String:
    46		return "user://%ssettings.json" % file_prefix()
    47	
    48	static func _dp() -> String:
    49		return "user://%ssave.json" % file_prefix()
    50	
    51	## 讀一個 JSON 檔；內容不是物件就回傳 null。
    52	static func _parse(path: String):
    53		var j := JSON.new()   # 不用 JSON.parse_string：壞檔是預期情況，不該在日誌印 ERROR
    54		if j.parse(FileAccess.get_file_as_string(path)) != OK:
    55			return null
    56		return j.data if typeof(j.data) == TYPE_DICTIONARY else null
    57	
    58	## 壞掉的主檔移到旁邊留證據，主檔位置空出來，下一次寫入才不會拿它蓋掉好備份（R6）。
    59	static func _quarantine(path: String) -> void:
    60		var n := 1
    61		while FileAccess.file_exists("%s.corrupt%d" % [path, n]) and n < 20:
    62			n += 1
    63		DirAccess.rename_absolute(path, "%s.corrupt%d" % [path, n])
    64	
    65	## 回傳 {value, source}。主檔壞 → 隔離 → 讀備份。
    66	static func _read(path: String, defaults: Dictionary) -> Dictionary:
    67		if FileAccess.file_exists(path):
    68			var m = _parse(path)
    69			if m != null:
    70				return {"value": m, "source": "main"}
    71			_quarantine(path)
    72		var bak := path + ".bak"
    73		if FileAccess.file_exists(bak):
    74			var b = _parse(bak)
    75			if b != null:
    76				return {"value": b, "source": "bak"}
    77		return {"value": defaults.duplicate(true), "source": "none"}
    78	
    79	static func _num(v, fallback := 0.0) -> float:
    80		return float(v) if (v is int or v is float) else float(fallback)
    81	
    82	static func _count(v, hi := 1000000000) -> int:
    83		return clampi(int(_num(v)), 0, hi)
    84	
    85	static func schema_of(d: Dictionary) -> int:
    86		return int(_num(d.get("schema_version", d.get("version", 1)), 1))
    87	
    88	## 設定逐欄驗型（R4）：型別不對用預設，數值夾在合法範圍；不認得的欄位保留。
    89	static func sanitize_settings(d: Dictionary) -> Dictionary:
    90		var out := d.duplicate(true)
    91		for k in DEFAULT_SETTINGS:
    92			var dv = DEFAULT_SETTINGS[k]
    93			var v = out.get(k, dv)
    94			if dv is bool:
    95				out[k] = v if v is bool else dv
    96			elif dv is String:
    97				out[k] = v if v is String else dv
    98			elif dv is int:
    99				out[k] = int(v) if (v is int or v is float) else dv
   100			elif dv is float:
   101				out[k] = float(v) if (v is int or v is float) else dv
   102		if not str(out["lang"]) in ["zh_TW", "en"]:
   103			out["lang"] = DEFAULT_SETTINGS["lang"]
   104		if not int(out["text_scale"]) in [100, 125, 150]:
   105			out["text_scale"] = DEFAULT_SETTINGS["text_scale"]
   106		out["music"] = clampi(int(out["music"]), 0, 100)
   107		out["sfx"] = clampi(int(out["sfx"]), 0, 100)
   108		out["speed"] = clampf(float(out["speed"]), 0.25, 8.0)
   109		if not str(out["duel_rule"]) in ["snake5", "snake5c", "cap10", "blind", "custom"]:
   110			out["duel_rule"] = DEFAULT_SETTINGS["duel_rule"]
   111		var KM = load("res://scripts/game/keymap.gd")
   112		out["keys"] = KM.sanitize(KM.ACTIONS, out.get("keys"))
   113		out["pad"] = KM.sanitize(KM.PAD_ACTIONS, out.get("pad"))
   114		if not str(out["roster"]) in ["all", "classic"]:
   115			out["roster"] = DEFAULT_SETTINGS["roster"]
   116		return out
   117	
   118	## 進度逐欄驗型（R4）：語法對但型別錯的欄位不能讓遊戲當掉；壞欄位改預設，其他進度保留。
   119	static func sanitize_data(out: Dictionary) -> void:
   120		var sl: Array = ["", "", "", "", ""]
   121		var raw_sl = out.get("slots", [])
   122		if raw_sl is Array:
   123			for i in mini(raw_sl.size(), sl.size()):
   124				if raw_sl[i] is String and str(raw_sl[i]).length() <= 8000:
   125					sl[i] = raw_sl[i]
   126		out["slots"] = sl
   127		for k in ["tutorial", "gauntlet_best", "unlock_games"]:
   128			out[k] = _count(out.get(k, 0))
   129		for k in ["stats", "custom_stats"]:
   130			var st = out.get(k, {})
   131			out[k] = {"wins": _count(st.get("wins", 0)), "games": _count(st.get("games", 0))} if st is Dictionary else {"wins": 0, "games": 0}
   132		var stars := {}
   133		var raw_st = out.get("puzzle_stars", {})
   134		if raw_st is Dictionary:
   135			for k in raw_st:
   136				stars[str(k)] = _count(raw_st[k], 3)
   137		out["puzzle_stars"] = stars
   138		var uw := {}
   139		var raw_uw = out.get("unit_wins", {})
   140		if raw_uw is Dictionary:
   141			for k in raw_uw:
   142				uw[str(k)] = _count(raw_uw[k])
   143		out["unit_wins"] = uw
   144		# V9：新欄位都是可有可無的統計，型別不對就歸零（不用升存檔版本：舊存檔沒有就用預設）
   145		for dk in ["trial_stars", "unit_games"]:
   146			var dv = out.get(dk, {})
   147			var clean := {}
   148			if dv is Dictionary:
   149				for k9 in dv:
   150					clean[str(k9)] = _count(dv[k9])
   151			out[dk] = clean
   152		for nk in ["streak", "best_streak"]:
   153			out[nk] = _count(out.get(nk, 0))
   154		var dk2 = out.get("decks", [])
   155		var clean2: Array = []
   156		if dk2 is Array:
   157			for v9 in dk2:
   158				if v9 is float or v9 is int:
   159					clean2.append(int(v9))
   160		out["decks"] = clean2.slice(0, 3)
   161		var ach: Array = []
   162		var raw_a = out.get("achievements", [])
   163		if raw_a is Array:
   164			for a in raw_a:
   165				if a is String and not a in ach:
   166					ach.append(a)
   167		out["achievements"] = ach
   168		var lr := {}
   169		var raw_lr = out.get("last_rules", {})
   170		if raw_lr is Dictionary:
   171			for k in raw_lr:
   172				if raw_lr[k] is String and str(raw_lr[k]).length() <= 2000:
   173					lr[str(k)] = raw_lr[k]
   174		out["last_rules"] = lr
   175	
   176	## 逐版遷移（純函式，測試用）：舊進度一律保留；不認得的欄位也保留（新版遊戲寫的存檔被舊版讀到時不會被刪掉）。
   177	## 比目前新的版本：原樣回傳，不降版。
   178	static func migrate(d: Dictionary) -> Dictionary:
   179		var out := d.duplicate(true)
   180		var v := schema_of(out)
   181		if v > SAVE_VERSION:
   182			return out
   183		if v < 2:
   184			# 1 → 2：欄位名 version 改成 schema_version；加 unit_wins
   185			out.erase("version")
   186			v = 2
   187		if v < 3:
   188			# 2 → 3：解鎖改看獨立的累計場數，初值＝原本的正式場數（已解鎖的兵不會被收回）
   189			var st = out.get("stats", {})
   190			out["unlock_games"] = _count(st.get("games", 0)) if st is Dictionary else 0
   191			v = 3
   192		# 我的預設：逐筆驗型、限長、最多 5 組（Codex 第一輪）
   193		var ps: Array = []
   194		var raw = out.get("rule_presets", [])
   195		if raw is Array:
   196			for e in raw:
   197				if e is Dictionary and e.get("name") is String and e.get("code") is String and str(e["code"]).length() <= 2000 and ps.size() < MAX_PRESETS:
   198					ps.append({"name": str(e["name"]).substr(0, 24), "code": str(e["code"])})
   199		out["rule_presets"] = ps
   200		for k in DEFAULT_SAVE:
   201			if not out.has(k):
   202				out[k] = DEFAULT_SAVE[k].duplicate(true) if DEFAULT_SAVE[k] is Dictionary or DEFAULT_SAVE[k] is Array else DEFAULT_SAVE[k]
   203		sanitize_data(out)
   204		out["schema_version"] = v
   205		return out
   206	
   207	## 原子寫入。R6：只有內容驗證過的主檔才輪替成備份；輪替失敗不覆蓋主檔。
   208	static func _write(path: String, d: Dictionary) -> bool:
   209		var tmp := path + ".tmp"
   210		if fail_inject.get("tmp", 0) > 0:
   211			fail_inject["tmp"] -= 1
   212			return false
   213		var f := FileAccess.open(tmp, FileAccess.WRITE)
   214		if f == null:
   215			return false
   216		var txt := JSON.stringify(d, "\t")
   217		f.store_string(txt)
   218		f.close()
   219		# 讀回驗證：內容不完整（磁碟滿、被中斷）就不覆蓋正式檔
   220		if FileAccess.get_file_as_string(tmp) != txt:
   221			DirAccess.remove_absolute(tmp)
   222			return false
   223		if FileAccess.file_exists(path):
   224			if _parse(path) == null:
   225				_quarantine(path)   # 遊戲開著時主檔被弄壞：不能拿它蓋備份
   226			else:
   227				var rotated := false
   228				if fail_inject.get("rotate", 0) > 0:
   229					fail_inject["rotate"] -= 1
   230				else:
   231					var bt := path + ".bak.tmp"
   232					rotated = DirAccess.copy_absolute(path, bt) == OK and _parse(bt) != null and DirAccess.rename_absolute(bt, path + ".bak") == OK
   233					if not rotated:
   234						DirAccess.remove_absolute(bt)
   235				if not rotated:
   236					DirAccess.remove_absolute(tmp)
   237					return false
   238		return DirAccess.rename_absolute(tmp, path) == OK
   239	
   240	static func _tracked_write(path: String, d: Dictionary) -> bool:
   241		var good := _write(path, d)
   242		if good:
   243			pending.erase(path)
   244		else:
   245			pending[path] = true
   246		return good
   247	
   248	static func save_settings() -> bool:
   249		return _tracked_write(_sp(), settings)
   250	
   251	## 未來版存檔（R5）一律不寫，回傳 true 是因為這不是「寫入失敗」，畫面已經常駐提示。
   252	static func save_data() -> bool:
   253		if data_locked:
   254			return true
   255		return _tracked_write(_dp(), data)
   256	
   257	static func has_unsaved() -> bool:
   258		return not pending.is_empty()
   259	
   260	## R7：上次寫入失敗就再試一次（換畫面、回標題時呼叫）。回傳 true＝現在沒有未存內容。
   261	static func retry_pending() -> bool:
   262		if pending.has(_sp()):
   263			save_settings()
   264		if pending.has(_dp()):
   265			save_data()
   266		return pending.is_empty()
   267	
   268	static func s(key: String):
   269		return settings.get(key, DEFAULT_SETTINGS.get(key))
   270	
   271	static func set_setting(key: String, v) -> void:
   272		settings[key] = v
   273		save_settings()
   274	
   275	
   276	## 試玩紀錄（優化方案 F5、N3）：只在設定開啟時寫在本機 user://playtest_log.jsonl，不上傳。
   277	static func playtest_log(entry: Dictionary) -> void:
   278		if not bool(s("playtest")):
   279			return
   280		var path := "user://%splaytest_log.jsonl" % file_prefix()

