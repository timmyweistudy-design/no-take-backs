   119	func _build_ai() -> void:
   120		if get("challenge_army") != null:
   121			armies[1] = get("challenge_army").copy()     # 挑戰碼：對手就是朋友排好的陣
   122			ai_name = L.t("ch_name")
   123			return
   124		if true:
   125			var r := RandomNumberGenerator.new()
   126			r.seed = rng.randi()
   127			var p1: int = rules.pool_of(1) if rules != null else _pool()
   128			if rules != null and rules.ai_style != 0:
   129				p1 = AI.style_pool(p1, rules.ai_style, r)
   130			match difficulty:
   131				0:
   132					armies[1] = AIT.build_full(1, r, 0, [], p1, rules)
   133					ai_name = L.t("diff_easy")
   134				1:
   135					var res = AI.build(1, rules.budget_of(1) if rules != null else 100, r, -1, p1, rules)
   136					armies[1] = res["army"]
   137					ai_name = "%s・%s" % [L.t("diff_normal"), res["name"]]
   138				_:
   139					armies[1] = _hard_ai(r)
   140					ai_name = L.t("diff_hard")
