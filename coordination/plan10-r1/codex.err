   450	func _deck_save() -> void:
   451		var decks: Array = Save.data.get("decks", [])
   452		decks.append(int(lobby_r.pool[lobby_pool_team]))
   453		while decks.size() > 3:
   454			decks.pop_front()
   455		Save.data["decks"] = decks
   456		Save.save_data()
   457		_toast(L.t("lb_deck_saved"))
