     2	## 兵種圖鑑（第二輪方案 R3）：讀 data/codex.json，驗證 ID 與示範，技能說明裡的 {常數名} 換成 unit_defs 的數值。
     3	## 數值只有一個來源（unit_defs.gd）：改平衡時圖鑑的說明自動跟著變，不會說謊。
     4	
     5	const D = preload("res://scripts/core/unit_defs.gd")
     6	const Sim = preload("res://scripts/core/battle_sim.gd")
     7	const Army = preload("res://scripts/core/army.gd")
     8	
     9	const NOTE_WINS := 5          # 派這個兵種贏幾場解鎖「老兵觀察筆記」
    10	
    11	static var _data := {}
    12	
    13	static func data() -> Dictionary:
    14		if _data.is_empty():
    15			var txt := FileAccess.get_file_as_string("res://data/codex.json")
    16			var v = JSON.parse_string(txt)
    17			if v is Dictionary:
    18				_data = v
    19			else:
    20				push_error("codex.json 讀不到或格式錯")
    21		return _data
    22	
    23	static func unit(t: int) -> Dictionary:
    24		for u in data().get("units", []):
    25			if int(u["id"]) == t:
    26				return u
    27		return {}
    28	
    29	static func skill(id: String) -> Dictionary:
    30		return data().get("skills", {}).get(id, {})
    31	
    32	## 取一個欄位的當前語言版本（xxx_zh／xxx_en；技能名稱是 zh／en）。
    33	static func text(d: Dictionary, field: String, lang: String) -> String:
    34		var suf := "zh" if lang == "zh_TW" else "en"
    35		var k := suf if field == "" else "%s_%s" % [field, suf]
    36		return str(d.get(k, d.get("zh" if field == "" else field + "_zh", "")))
    37	
    38	## 技能說明：把 {常數名} 換成 unit_defs 的值。找不到的常數原樣保留（validate 會抓出來）。
    39	static func skill_desc(id: String, lang: String) -> String:
    40		return fill(text(skill(id), "desc", lang))
    41	
    42	## {NAME} 換成 unit_defs 的常數；{REACH_n} 是兵種 n 的攻擊距離；前面加 C: 表示換算成格（÷1000，例如 {C:TAUNT_RANGE}→2）。
    43	static func fill(s: String) -> String:
    44		return _pretty_ratio(_fill_raw(s))
    45	
    46	## ×5/2 → ×2.5、×2/1 → ×2（手感輪 R3：分數讀起來像程式）
    47	static func _pretty_ratio(s: String) -> String:
    48		var re := RegEx.create_from_string("×(\\d+)/(\\d+)")
    49		var out := s
    50		for m in re.search_all(s):
    51			var v := float(m.get_string(1)) / float(m.get_string(2))
    52			var t := str(int(v)) if is_equal_approx(v, roundf(v)) else str(snappedf(v, 0.01))
    53			out = out.replace(m.get_string(0), "×" + t)
    54		return out
    55	
    56	static func _fill_raw(s: String) -> String:
    57		var out := s
    58		for m in _re().search_all(s):
    59			var v = value(m.get_string(2))
    60			if v == null:
    61				continue
    62			var shown := str(v)
    63			if m.get_string(1) != "":
    64				# C:＝千分之一格換成格；S:＝tick 換成秒（第四輪）
    65				var cells := float(v) / (1000.0 if m.get_string(1) == "C:" else 20.0)
    66				shown = str(int(cells)) if is_equal_approx(cells, roundf(cells)) else "%.1f" % cells
    67			out = out.replace(m.get_string(0), shown)
    68		return out
    69	
    70	static func _re() -> RegEx:
    71		return RegEx.create_from_string("\\{(C:|S:)?([A-Z_0-9]+)\\}")
    72	
    73	## 常數值；找不到回 null。
    74	static func value(name: String):
    75		if name.begins_with("REACH_"):
    76			var t := int(name.substr(6))
    77			return int(D.stat(t)["reach"]) if t >= 0 and t < D.total() else null
    78		var consts: Dictionary = (D as Script).get_script_constant_map()
    79		if consts.has(name):
    80			return consts[name]
    81		return (D.f8() as Script).get_script_constant_map().get(name)
    82	
    83	## 老兵筆記解鎖進度：派這個兵種贏了幾場。
    84	static func wins_with(save_data: Dictionary, t: int) -> int:
    85		var uw = save_data.get("unit_wins", {})
    86		if uw is Dictionary:
    87			return int(uw.get(str(t), 0))
    88		return 0
    89	
    90	static func note_unlocked(save_data: Dictionary, t: int) -> bool:
    91		return wins_with(save_data, t) >= NOTE_WINS
    92	
    93	## 一場贏了：每個有派上場的兵種 +1（同一場同兵種只算一次）。
    94	static func record_win(save_data: Dictionary, types: Array) -> Array:
    95		var uw = save_data.get("unit_wins", {})
    96		if not uw is Dictionary:
    97			uw = {}
    98		var newly: Array = []
    99		var seen := {}
   100		for t in types:
   101			var k := str(int(t))
   102			if seen.has(k):
   103				continue
   104			seen[k] = true
   105			var before := int(uw.get(k, 0))
   106			uw[k] = before + 1
   107			if before + 1 == NOTE_WINS:
   108				newly.append(int(t))
   109		save_data["unit_wins"] = uw
   110		return newly
   111	
   112	## 示範戰鬥：用真的模擬跑技能的小劇場。blue／red 都寫藍方視角（欄 0～5，5 是前排），紅方自動鏡像。
   113	static func demo_sim(id: String):
   114		var dm: Dictionary = skill(id).get("demo", {})
   115		var a0 := Army.new(0, 1000)
   116		var a1 := Army.new(0, 1000)   # 紅方先用藍方視角擺，再鏡像成紅方
   117		a0.pool = (1 << D.total()) - 1
   118		a1.pool = (1 << D.total()) - 1
   119		for e in dm.get("blue", []):
   120			a0.place(int(e[0]), int(e[1]), int(e[2]))
   121		for e in dm.get("red", []):
   122			a1.place(int(e[0]), int(e[1]), int(e[2]))
   123		var s = Sim.new(a0, a1.mirrored())
   124		s.fast = true
   125		return s
   126	
   127	## 這一 tick 觸發預期技能的位置（給小劇場跳字用）。事件裡的 src／tgt 是單位 id，不是 units 陣列的索引，要用 unit_by_id 查。
   128	static func expect_hits(s, expect: String) -> Array:
   129		var out: Array = []
   130		for e in s.events:
   131			if not e.get("tags", []).has(expect):
   132				continue
   133			var who: int = int(e.get("src", e.get("tgt", -1)))
   134			if who < 0:
   135				continue
   136			var u = s.unit_by_id(who)
   137			if u != null:
   138				out.append(Vector2(u.x, u.y))
   139		return out
