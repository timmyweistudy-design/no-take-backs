    87	func _keys_input(ev: InputEvent) -> bool:
    88		if keys_capture == "":
    89			return false
    90		var part := keys_capture.split(":")
    91		if ev is InputEventKey and ev.pressed and not ev.echo:
    92			if ev.keycode != KEY_ESCAPE and part[0] == "kb":
    93				if not Keymap.can_bind_key(ev.keycode):
    94					_toast(L.t("keys_reserved"), true)
    95					return true
    96				Save.settings["keys"] = Keymap.rebind(Keymap.ACTIONS, Save.s("keys"), part[1], ev.keycode)
    97				Save.save_settings()
    98			keys_capture = ""
    99			return true
   100		if ev is InputEventJoypadButton and ev.pressed and part[0] == "pad":
   101			if not Keymap.can_bind_pad(ev.button_index):
   102				_toast(L.t("keys_reserved"), true)
   103				return true
   104			Save.settings["pad"] = Keymap.rebind(Keymap.PAD_ACTIONS, Save.s("pad"), part[1], ev.button_index)
   105			Save.save_settings()
   106			keys_capture = ""
   107			return true
   108		return ev is InputEventKey or ev is InputEventJoypadButton
