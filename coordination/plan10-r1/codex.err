    12	const BADGE_FUN := "fun"         # 娛樂變體（黃）
    13	const BADGE_LAB := "lab"         # 沙盒（紫）
    14	# 第六輪：自由排兵的標準間距與縱深。全因子篩選 9 組全過（v6-screen/REPORT.md）；完整驗收 0.8×7.5 差 2 項沒過、
    15	# 0.8×6 全部通過（v6-accept-800-6000/REPORT.md）→ 定 0.8 格＋6 格。縱深 6.5～7.5 仍可在大廳自選（娛樂變體）。
    16	const FREE_SPACING := 800
    17	const FREE_DEPTH := 6000
    18	
    19	static func make(id: String, kind: String, unlocked: int):
    20		var r = RSET.standard(unlocked & RSET.all_pool())   # 標準只含舊 10 種
    21		r.preset = id
    22		r.rounds = 3
    23		r.place_rule = "snake5"
    24		# 第六輪（方案 §9-5）：大廳預設「自由排兵」；格子留在部署分頁當選項
    25		r.deploy = "free"
    26		r.spacing = FREE_SPACING
    27		r.depth = FREE_DEPTH
    28		match id:
    29			"standard":
    30				if kind == "duel":
    31					r.pool = [31, 31]       # 雙人標準＝經典 5 種（唯一驗證過公平的組合）
    32			"classic5":
    33				r.pool = [31, 31]
    34			"fantasy":
    35				var fp := fantasy_pool(unlocked)
    36				r.pool = [fp, fp]
    37			"small":
    38				r.budget = [50, 50]
    39				r.unit_cap = 12
    40				r.ticks = 1200
    41			"big":
    42				r.budget = [180, 180]
    43				r.unit_cap = 40
    44				r.ticks = 2400
    45			"single":
    46				# 單兵種對決：只開 1 種戰鬥兵（劍士）＋1 種支援兵（醫者）；卡池分頁可以換
    47				r.pool = [(1 << D.SWORD) | (1 << D.MEDIC), (1 << D.SWORD) | (1 << D.MEDIC)]
    48		if kind == "duel":
    49			r.ai_pool_same = true
    50		return r
    51	
    52	## 奇幻兵團預設（第八輪）：解鎖的奇幻軍優先，不足 10 種由舊兵補（先補戰鬥兵，免得全是奇襲兵開不了戰）。
    53	static func fantasy_pool(unlocked: int) -> int:
    54		var p := 0
    55		var n := 0
    56		for t in range(D.COUNT, D.total()):
    57			if RSET.has(unlocked, t):
    58				p |= 1 << t
    59				n += 1
    60		for t in [D.SWORD, D.SHIELD, D.ARCHER, D.CAVALRY, D.ASSASSIN, D.PIKE, D.BOMBER, D.BERSERKER, D.MEDIC, D.DRUMMER]:
    61			if n >= RSET.ROSTER_MAX:
    62				break
    63			if RSET.has(unlocked, t):
    64				p |= 1 << t
    65				n += 1
    66		return p
    67	
    68	## 卡池是不是「前 N 種、N≥5」（第四輪 AI 驗收只驗過經典 5 種到全部 10 種的前綴卡池）。
    69	static func is_prefix(p: int) -> bool:
    70		return p >= 31 and (p & (p + 1)) == 0
    71	
    72	## 徽章：動到沙盒＝沙盒；驗證過的組合＝平衡認證；其他＝娛樂變體。
    73	## 對 AI：100 金、24 隻、不限單種、90 秒、前綴卡池（第四輪驗收的條件）。
    74	## 雙人：再加上經典 5 種＋snake5（第四輪 snake5 三種 AI 強度都在 45～55%）。
    75	static func badge(r, kind: String) -> String:
    76		if r.is_sandbox():
    77			return BADGE_LAB
    78		var base: bool = r.budget_of(0) == 100 and r.budget_of(1) == 100 and r.unit_cap == 24 and r.type_cap == 0 and r.ticks == 1800
    79		# 第六輪：部署也要是驗過的——格子，或自由＋預設的間距與縱深；全場一律算娛樂變體
    80		base = base and deploy_certified(r)
    81		if kind == "ai":
    82			return BADGE_CERT if base and is_prefix(r.pool_of(0)) and r.pool_of(1) == r.pool_of(0) else BADGE_FUN
    83		return BADGE_CERT if base and r.pool_of(0) == 31 and r.pool_of(1) == 31 and r.place_rule == "snake5" and not r.carry else BADGE_FUN
    84	
    85	static func deploy_certified(r) -> bool:
    86		if r.fullfield != 0 or not r.map_is_default():
    87			return false   # V9：地圖是娛樂變體，平衡認證只給平原中型
    88		return r.deploy == "grid" or (r.spacing == FREE_SPACING and r.depth == FREE_DEPTH)
    89	
    90	## 算不算「標準紀錄」（標準戰績、標準成就；Codex 實作第 1 輪：和「平衡認證」分開判定）。
    91	## 除了認證條件，系列也要是標準的：三戰兩勝、保留陣型、沒有讓子；對 AI 卡池兩邊相同；雙人 snake5、不累積。
    92	static func is_standard_record(r, kind: String) -> bool:
    93		if badge(r, kind) != BADGE_CERT:
    94			return false
    95		if r.rounds != 3 or not r.keep_formation or r.handicap:
    96			return false
    97		if kind == "ai":
    98			return r.ai_pool_same
    99		return r.place_rule == "snake5" and not r.carry
   100	
   101	## 部署限制是不是「標準」（前 N 種卡池、24 隻、不限單種、100 金）：對戰代碼可以用舊格式 NTB2、AI 不額外補兵。
   102	static func deploy_standard(r) -> bool:
   103		return r.unit_cap == 24 and r.type_cap == 0 and r.budget_of(0) == 100 and r.budget_of(1) == 100 and is_prefix(r.pool_of(0)) and r.pool_of(1) == r.pool_of(0)
   104	
   105	## 大廳卡池能選的兵：對 AI＝已解鎖的；雙人＝全部（試玩版＝前 7 種）。
   106	static func selectable(kind: String, unlocked: int, demo: bool) -> int:
   107		var all_p: int = (RSET.prefix_pool(7) | (1 << 11)) if demo else RSET.full_pool()   # 試玩版：舊 7 種＋爆爆羊
   108		return (unlocked & all_p) if kind == "ai" else all_p
   109	
