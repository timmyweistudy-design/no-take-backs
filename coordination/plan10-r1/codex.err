   152		dist[goal] = 0
   153		# 小格網用簡單的桶佇列：成本只有 10／14，一輪輪掃就好
   154		var cur: Array = [goal]
   155		while not cur.is_empty():
   156			var nxt: Array = []
   157			for idx in cur:
   158				var c: int = idx % n
   159				var r: int = idx / n
   160				for d in N8:
   161					var dc: int = d[0]
   162					var dr: int = d[1]
