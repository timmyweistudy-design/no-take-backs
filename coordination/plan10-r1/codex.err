   261	func _key(k: int) -> void:
   262		if state == St.PLACE and _fp_key(k):
   263			return
   264		# 有按鈕焦點的畫面（標題、選單、結果、覆蓋層、戰鬥）：方向鍵移焦點、Enter 按下、Esc 返回
   265		if state != St.PLACE or overlay != "":
   266			match k:
   267				KEY_UP, KEY_LEFT:
   268					_move_focus(-1)
   269				KEY_DOWN, KEY_RIGHT:
   270					_move_focus(1)
   271				KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
   272					if _btns_gen == _gen and _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:   # 按鈕清單要是這個畫面的
   273						sfx.play("k_click", 0.7)
   274						_btns[_focus]["cb"].call()
   275				KEY_PAGEUP, KEY_PAGEDOWN:
   276					if overlay == "codex":
   277						_scroll_by("left", -160.0 if k == KEY_PAGEUP else 160.0)
   278				KEY_P, KEY_TAB:
   279					# 手把 Y 送的是 Tab：戰鬥中＝暫停（第七輪 A6）
   280					if state == St.BATTLE and overlay == "":
   281						_toggle_pause()
   282					elif k == KEY_TAB:
