   128	## 藍方 0＝最後排、5＝最前排；紅方鏡像。
   129	static func _abs_col(a: Army, c: int) -> int:
   130		return c if a.team == 0 else Army.COLS - 1 - c
   131	
   132	## 訓練池（200）與保留池（50）：不同種子範圍，保留池不參與調參。
   133	## ntypes：池子只用編號 0～ntypes−1 的兵種（第四輪；5＝經典池，和第三輪的池子完全相同）。
   134	static func pool(team: int, count: int, seed_base: int, ntypes := D.COUNT) -> Array:
   135		var out: Array = []
   136		var rng := RandomNumberGenerator.new()
   137		var kinds := ["mixed", "mixed", "mixed", "duo", "pure"]
   138		for i in count:
   139			rng.seed = seed_base + i * 7919
   140			out.append(random_formation(team, rng, kinds[i % kinds.size()], "", ntypes))
   141		return out
   142	
   143	static func training_pool(team: int, ntypes := D.COUNT) -> Array:
   144		return pool(team, 200, 1000003, ntypes)
   145	
   146	static func holdout_pool(team: int, ntypes := D.COUNT) -> Array:
   147		return pool(team, 50, 9000011, ntypes)
   148	
   149	## 驗證池（第三輪 B1）：從來沒有用來挑參數或調關卡的 200 套，用來確認結論不是對訓練池過擬合。
   150	static func validation_pool(team: int, ntypes := D.COUNT) -> Array:
   151		return pool(team, 200, 7000001, ntypes)
   152	
   153	## 封存終驗池（第四輪 §3.4）：只在最後跑一次，不拿來調參或挑冠軍。
