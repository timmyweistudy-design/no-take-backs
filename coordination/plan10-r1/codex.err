   180	## 離 (c, r) 最近、導航可走的格（固定順序）。
   181	func _nav_cell(c: int, r: int) -> int:
   182		if nav[c + r * n] == 0:
   183			return c + r * n
   184		for rad in range(1, maxi(n, m)):
   185			for dc in range(-rad, rad + 1):
   186				for dr in [-rad, rad] if absi(dc) != rad else range(-rad, rad + 1):
   187					var a: int = c + dc
   188					var b: int = r + int(dr)
   189					if a >= 0 and a < n and b >= 0 and b < m and nav[a + b * n] == 0:
   190						return a + b * n
   191		return c + r * n
