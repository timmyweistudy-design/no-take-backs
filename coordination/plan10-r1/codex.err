   110	## 這段只有接上 Steam 才跑得到，還沒實機驗（ClassDB 查過簽章：input_mode、line_input_mode、description、max_text、preset_text）。
   111	static func text_input(description: String, max_len: int, done: Callable) -> bool:
   112		if _steam == null or not _steam.has_method("showGamepadTextInput"):
   113			return false
   114		if not _steam.is_connected("gamepad_text_input_dismissed", done):
   115			_steam.connect("gamepad_text_input_dismissed", done, CONNECT_ONE_SHOT)
   116		return bool(_steam.showGamepadTextInput(0, 0, description, max_len, ""))
