     4	func _ready() -> void:
     5		on_battle_finished = _finish_battle
     6		for a in OS.get_cmdline_user_args():
     7			if a.begins_with("--shot=") or a.begins_with("--steam-test=") or a.begins_with("--perf=") or a == "--boot-check" or a.begins_with("--mem-check="):
     8				Save.prefix = "shot_"   # 不讀、不寫玩家真正的存檔
     9			elif a == "--self-check":
    10				Save.prefix = "smoke_"
    11		Save.load_all()
    12		for a in OS.get_cmdline_user_args():
    13			if a.begins_with("--steam-test="):
    14				var aid := int(a.substr(13))
    15				SteamApi.init(aid, false)
    16				var res: Dictionary = SteamApi.self_test(aid)
    17				print("STEAMTEST ", JSON.stringify(res))
    18				get_tree().quit(0 if res["ok"] else 1)
    19				return
    20		for a2 in OS.get_cmdline_user_args():   # 截圖驗證用：--shot-lang=en、--shot-text=150（只改這次記憶體中的設定）
    21			if a2.begins_with("--shot-lang="):
    22				Save.settings["lang"] = a2.substr(12)
    23			elif a2.begins_with("--shot-text="):
    24				Save.settings["text_scale"] = int(a2.substr(12))
    25			elif a2 == "--layout-check":
    26				layout_probe = true
    27		L.lang = Save.s("lang")
    28		duel_rule = Save.s("duel_rule")
    29		speed = float(Save.s("speed"))
    30		var _ua := OS.get_cmdline_user_args()
    31		var _special := "--video" in _ua
    32		for x in _ua:
    33			if x.begins_with("--perf=") or x.begins_with("--mem-check="):
    34				_special = true
    35		for x in _ua:
    36			if x.begins_with("--capsule="):
    37				_special = true
    38		if Save.prefix == "" and not _special:   # 截圖／影片／膠囊模式完全不碰 Steam
    39			SteamApi.init()
    40		_load_fonts()
    41		sfx = SfxScript.new()
    42		add_child(sfx)
    43		sprites = SpriteCache.new()
    44		add_child(sprites)
    45		if capsule_path == "":
    46			_rebuild_sprites.call_deferred()
    47		sfx.set_volumes(int(Save.s("sfx")), int(Save.s("music")))
    48		grass = load("res://art/cainos/TX_Tileset_Grass.png")
    49		for i in 9:
    50			var tex = load("res://art/cainos/plant_%02d.png" % i)
    51			if tex:
    52				plants.append(tex)
    53		for a in OS.get_cmdline_user_args():
    54			if a.begins_with("--shot="):
    55				shot_dir = a.substr(7)
    56			elif a.begins_with("--capsule="):
    57				capsule_path = a.substr(10)
    58			elif a == "--video":
    59				video_mode = true
    60			elif a.begins_with("--perf="):
    61				perf_path = a.substr(7)
    62		if "--boot-check" in OS.get_cmdline_user_args():
    63			_boot_check.call_deferred()
    64		if "--self-check" in OS.get_cmdline_user_args():
    65			_self_check.call_deferred()
    66		if capsule_path != "":
    67			get_window().content_scale_aspect = Window.CONTENT_SCALE_ASPECT_EXPAND
    68			return   # 膠囊圖由 main 接手
    69		_apply_fullscreen()
    70		rng.seed = Time.get_ticks_usec() if (shot_dir == "" and not video_mode) else 12345
    71		if video_mode:
    72			Save.prefix = "shot_"
    73			Save.load_all()
    74		_go_title()   # 截圖、影片、效能量測由 main 接手（S8）
