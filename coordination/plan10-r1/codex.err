   408	## 鍵盤：回傳 true＝處理掉了。
   409	func _fp_key(k: int) -> bool:
   410		if not _is_free() or overlay != "":
   411			return false
   412		match k:
   413			KEY_ENTER, KEY_KP_ENTER:
   414				if fp_stroking or fp_drag >= 0 or fp_box:
   415					return true   # 拖曳中按 Enter 不做事，免得蓋掉這一筆（Codex 實作第 2 輪新問題 1）
   416				# 自由模式：在鍵盤／手把游標處放一隻（格子查找不能用，Codex 實作第 1 輪 #9）
   417				var at: Vector2i = Vector2i(fp_cur) if (pad_mode or not _fp_in_field(mouse)) else _w_of(mouse)
   418				_fs_begin(at)
   419				_fs_commit()
   420				return true
   421			KEY_ESCAPE:
   422				if fp_stroking:
   423					_fs_cancel()
   424					return true
   425				if not fp_sel.is_empty():
   426					fp_sel = []
   427					return true
   428			KEY_DELETE:
   429				_fp_delete_sel()
   430				return true
   431			KEY_M:
   432				_fp_flip_sel()
   433				return true
   434			KEY_Z:
   435				if Input.is_key_pressed(KEY_CTRL):
   436					_fp_undo_do(false)
   437					return true
   438			KEY_Y:
   439				if Input.is_key_pressed(KEY_CTRL):
   440					_fp_undo_do(true)
   441					return true
   442		return false
