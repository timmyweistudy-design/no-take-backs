     9	const D = preload("res://scripts/core/unit_defs.gd")
    10	const Army = preload("res://scripts/core/army.gd")
    11	const Sim = preload("res://scripts/core/battle_sim.gd")
    12	const AI = preload("res://scripts/core/ai_army.gd")
    13	const AIT = preload("res://scripts/core/ai_turns.gd")
    14	const F = preload("res://scripts/core/formations.gd")
    15	const RS = preload("res://scripts/core/ruleset.gd")
    16	
    17	## known：玩家上一局的兵（藍方座標）；entries：反制庫；回傳紅方陣型。
    18	## pool：紅方卡池遮罩（-1＝全部）；rules：第五輪 Ruleset（null＝標準）。
    19	## 反制庫只在「規則和標準一樣」時用（第五輪 §3.2）；大軍或長局時少一個候選（效能探測：40＋40、150 秒一場可達數秒）。
    20	static func build(known: Array, entries: Array, rng: RandomNumberGenerator, pool := -1, rules = null) -> Army:
    21		if pool < 0:
    22			pool = RS.all_pool()
    23		var bud: int = 100 if rules == null else rules.budget_of(1)
    24		var cands: Array = []
    25		cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
    26		if known.is_empty():
    27			return cands[0]
    28		var heavy: bool = rules != null and (rules.unit_cap > 24 or rules.ticks > 1800)
    29		if not heavy:
    30			cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
    31		var full := AIT.build_full(1, rng, 2, known, pool, rules)
    32		cands.append(full)
    33		if rules == null or _standard_like(rules):
    34			var lib := pick_counter(entries, known, pool)
    35			if lib != null:
    36				cands.append(lib)
    37		var me := Army.new(0, 100 if rules == null else rules.budget_of(0))
    38		if rules != null and rules.is_free():
    39			me.deploy = "free"   # 第六輪：上一局是自由陣型，照原座標模擬
    40		for u in known:
    41			if u.has("x"):
    42				me.units.append({"type": int(u["type"]), "x": int(u["x"]), "y": int(u["y"])})
    43			elif me.deploy == "free":
    44				me.units.append({"type": int(u["type"]), "x": int(u["col"]) * 1000 + 500, "y": int(u["row"]) * 1000 + 500})
    45			else:
    46				me.units.append({"type": int(u["type"]), "col": int(u["col"]), "row": int(u["row"])})
    47		var best: Army = cands[0]
    48		var bs := -(1 << 40)
    49		for c in cands:
    50			var s = Sim.new(me.copy(), c.copy(), rules)
    51			s.fast = true
    52			s.run_to_end()
    53			# 讓子局用各自預算的比例評分（Codex 實作第 1 輪）；標準局算式不變
    54			var sc: int = (1000000 + s.power(1)) if s.winner == 1 else (s.power(1) - s.power(0))
    55			if s.judge == 2:
    56				sc = (1000000 + s.power_permille(1)) if s.winner == 1 else (s.power_permille(1) - s.power_permille(0))
    57			if sc > bs:
    58				bs = sc
    59				best = c
    60		return best
    61	
    62	## 反制庫：組成最接近玩家陣型的原型的反制（距離 ≤40）；用到未開放兵種的不算。
    63	## 反制庫只在「部署與模擬都標準」時用（集中用 Presets.deploy_standard 判定，Codex 實作第 2 輪）。
    64	static func _standard_like(r) -> bool:
    65		return r.sim_is_legacy() and load("res://scripts/game/presets.gd").deploy_standard(r)
    66	
    67	static func pick_counter(entries: Array, known: Array, pool: int) -> Army:
    68		if entries.is_empty():
    69			return null
    70		var mine := D.zeros()
    71		for u in known:
    72			mine[int(u["type"])] += D.cost(int(u["type"]))
    73		var best = null
    74		var bd := 1 << 30
    75		for e in entries:
    76			var pc: Array = e["proto_comp"]
    77			var d := 0
    78			for k in mine.size():
    79				d += absi((int(pc[k]) if k < pc.size() else 0) - int(mine[k]))
    80			if d < bd:
    81				bd = d
    82				best = e
    83		if best == null or bd > 40:
    84			return null
    85		var a := Army.new(1, 100)
    86		if a.load_code(str(best["code"])) != "":
    87			return null
    88		for u in a.units:
    89			if not RS.has(pool, int(u["type"])):
    90				return null
    91		return a
