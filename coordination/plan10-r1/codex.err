   112	func _lobby_start() -> void:
   113		var why := _lobby_block()
   114		if why != "":
   115			_toast(why, true)
   116			return
   117		var lr: Dictionary = Save.data.get("last_rules", {})
   118		lr[lobby_kind] = lobby_r.to_code()
   119		lr[lobby_kind + "_preset"] = lobby_r.preset
   120		lr[lobby_kind + "_extra"] = [lobby_r.ai_style, lobby_r.map_mode, lobby_r.bans, lobby_r.time_of]   # 系列選項不進規則碼，另外記（Codex #8）
   121		Save.data["last_rules"] = lr
   122		Save.save_data()
   123		rules = lobby_r.copy()
   124		set("challenge_army", null)
   125		if lobby_kind == "duel" and rules.bans > 0:
   126			call("_begin_bans", rules.bans)
   127			return
   128		call("_start_mode", Mode.VS_AI if lobby_kind == "ai" else Mode.DUEL)
