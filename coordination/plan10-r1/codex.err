   444	# ───────── 手把 ─────────
   445	func _fp_pad_process(delta: float, stick: Vector2) -> void:
   446		if not _is_free() or not pad_mode:
   447			return
   448		if stick.length() > 0.2:
   449			# 平滑游標＋輕推時減速（微調）
   450			var sp := 5200.0 * pow(stick.length(), 2.0)
   451			fp_cur += stick.normalized() * sp * delta
   452			fp_cur.x = clampf(fp_cur.x, 200.0, fld_w - 200.0)
   453			fp_cur.y = clampf(fp_cur.y, 200.0, fld_h - 200.0)
   454			var w := Vector2i(fp_cur)
   455			if fp_stroking:
   456				_fs_extend(w)
   457			elif fp_pad_x:
   458				_fp_erase_at(w)
   459	
   460	func _fp_pad_button(b: int, pressed: bool) -> bool:
   461		if not _is_free() or overlay != "":
   462			return false
   463		var w := Vector2i(fp_cur)
   464		match b:
   465			JOY_BUTTON_A:
   466				# 手把：A 和滑鼠左鍵同一套（點兵＝搬、按住 LT＝框選、其他＝畫筆）
   467				if pressed:
   468					fp_pad_a = true
   469					_fp_press(_fp_scr(w), w, Input.get_joy_axis(0, JOY_AXIS_TRIGGER_LEFT) > 0.5)
   470				else:
   471					fp_pad_a = false
   472					_fp_release(_fp_scr(w), w)
   473				return true
   474			JOY_BUTTON_X:
   475				fp_pad_x = pressed
   476				if pressed:
   477					fp_erasing = false
   478					_fp_erase_at(w)
   479				else:
   480					fp_erasing = false
   481				return true
   482			JOY_BUTTON_B:
   483				if pressed and fp_stroking:
   484					_fs_cancel()
   485					return true
   486			JOY_BUTTON_Y:
   487				if pressed:
   488					fp_tool = "line" if fp_tool == "brush" else "brush"
   489					return true
   490			JOY_BUTTON_LEFT_STICK:
   491				if pressed:
   492					fp_snap = not fp_snap
   493					return true
   494			JOY_BUTTON_RIGHT_STICK:
   495				if pressed:
   496					fp_dense = not fp_dense
   497					return true
   498			JOY_BUTTON_DPAD_UP, JOY_BUTTON_DPAD_DOWN, JOY_BUTTON_DPAD_LEFT, JOY_BUTTON_DPAD_RIGHT:
   499				if pressed:
   500					var dv := {JOY_BUTTON_DPAD_UP: Vector2(0, -500), JOY_BUTTON_DPAD_DOWN: Vector2(0, 500), JOY_BUTTON_DPAD_LEFT: Vector2(-500, 0), JOY_BUTTON_DPAD_RIGHT: Vector2(500, 0)}
   501					fp_cur = Vector2(round((fp_cur.x + dv[b].x) / 500.0) * 500.0, round((fp_cur.y + dv[b].y) / 500.0) * 500.0)
   502					fp_cur.x = clampf(fp_cur.x, 200.0, fld_w - 200.0)
   503					fp_cur.y = clampf(fp_cur.y, 200.0, fld_h - 200.0)
   504					if fp_stroking:
   505						_fs_extend(Vector2i(fp_cur))   # 按住 A＋十字鍵也能畫（Antigravity 實作第 1 輪 #4）
   506					elif fp_pad_x:
   507						_fp_erase_at(Vector2i(fp_cur))
   508					return true
   509		return false
