   193			var k := 0
   194			for e in lst:
   195				var col := k / rows_per_col
   196				var rr := k % rows_per_col
   197				var ox := depth - col * dx_col
   198				var y := 400 + rr * sp + (half if col % 2 == 1 else 0)
   199				if ox < Army.EDGE or not a.place_xy(e[1], a.world_x(ox), y):
   200					return to_free(src, r, rng, "stretch")   # 放不下（極端組成）就退回拉伸，不能少兵
   201				k += 1
   202			return a
   203		for u in src.units:
   204			var p := Army.pos_of(u)
   205			var ox: int = src.own_x(p.x)
