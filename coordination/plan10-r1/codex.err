    43	# ───────── 座標 ─────────
    44	func _is_free() -> bool:
    45		return rules != null and rules.is_free() and (mode == Mode.VS_AI or mode == Mode.DUEL) and state == St.PLACE
    46	
    47	func _w_of(p: Vector2) -> Vector2i:
    48		var lift := Vector2(0, -TOUCH_LIFT) if fp_touch else Vector2.ZERO
    49		var q := (_fld_xf().affine_inverse() * (p + lift) - ORIGIN) / CS * 1000.0
    50		return Vector2i(int(q.x), int(q.y))
    51	
    52	## 世界座標 → 畫面上「腳底」的位置（和格子模式一樣：中心往下 0.32 格）。
    53	func _s_of(w: Vector2i) -> Vector2:
    54		return ORIGIN + Vector2(w.x / 1000.0, w.y / 1000.0 + 0.32) * CS
    55	
   400		if not _is_free():
   401			return
   402		var w := _w_of(p)
   403		if fp_stroking:
   404			_fs_extend(w)
   405		elif fp_erasing and Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT):
   406			_fp_erase_at(w)
