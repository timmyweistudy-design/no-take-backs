   251		var st: Dictionary = Save.data.get(stat_key, {"wins": 0, "games": 0})
   252		st["games"] = int(st.get("games", 0)) + 1
   253		if w == 0 and mode != Mode.DUEL:
   254			st["wins"] = int(st.get("wins", 0)) + 1
   255		Save.data[stat_key] = st
   256		_v8_achievements(w)   # 奇幻軍是娛樂變體，要放在「自訂規則提前返回」之前（Codex 第 3 輪）
   257		if not standard:
   258			# 自訂規則專屬成就（標準成就只看標準局）
   259			if me_won and mode == Mode.VS_AI and w == 0:
   260				if rules.budget_of(0) <= 50:
   261					_ach("CUSTOM_LOWGOLD")
   262				if rules.budget_of(0) < rules.budget_of(1):
   263					_ach("CUSTOM_UNDERDOG")
   264			if me_won and rules.unit_cap >= 36:
   265				_ach("CUSTOM_BIG")
   266			_save()
   267			return
   268		if me_won:
   269			_ach("FIRST_WIN")
   270			if sim.alive_count(w) == 1:
   271				_ach("LONE_HERO")
   272			if int(report["sus"]["max_swing_pct"]) >= 15:
   273				_ach("COMEBACK")
   274			if sim.power(w) * 100 / (sim.budget * 1000) <= 5:
   275				_ach("CLOSE_CALL")
   276			if sim.tick >= Sim.FRENZY_TICK:
   277				_ach("FRENZY_WIN")
   278			var types := {}
   279			for u in sim.units:
   280				if u.team == w:
   281					types[D.report_type(u.type)] = true
   282			if types.size() == 5:
   283				_ach("ALL_TYPES")
   284			# 圖鑑老兵筆記：派這個兵種贏一場 +1（第二輪方案 R3）
   285			for t in CX.record_win(Save.data, types.keys()):
   286				ach_queue.append(L.t("codex_unlocked", [L.t("unit_%d" % t)]))
   287			if int(ev_count.get("charge%d" % w, 0)) >= 5:
   288				_ach("CHARGE_5")
   289			if int(ev_count.get("backstab%d" % w, 0)) >= 3:
   290				_ach("BACKSTAB_3")
   291		if mode == Mode.VS_AI and w == 0 and difficulty == 2:
   292			_ach("HARD_WIN")
   293		if mode == Mode.DUEL and tp != null and series_over:
   294			_ach("NO_TAKEBACKS")
   295		if series_over and ((mode == Mode.DUEL and (wins == [2, 0] or wins == [0, 2])) or (mode == Mode.VS_AI and wins == [2, 0])):
   296			_ach("SWEEP")
   297		if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
   298			var stars := int(report.get("stars", 0))
   299			var ps: Dictionary = Save.data.get("puzzle_stars", {})
   300			if stars > int(ps.get(puzzle_id, 0)):
   301				ps[puzzle_id] = stars
   302			Save.data["puzzle_stars"] = ps
   303			if mode == Mode.TUTORIAL and w == 0:
   304				var idx := 0
   305				for i in PZ.tutorials().size():
   306					if PZ.tutorials()[i]["id"] == puzzle_id:
   307						idx = i
   308				Save.data["tutorial"] = maxi(int(Save.data.get("tutorial", 0)), idx + 1)
   309				if int(Save.data["tutorial"]) >= PZ.tutorials().size():
   310					_ach("TUTORIAL")
   311			if stars == 3:
   312				_ach("PUZZLE_3STAR")
   313			var all_done := true
   314			for p in PZ.puzzles():
   315				if int(ps.get(p["id"], 0)) == 0:
   316					all_done = false
   317			if all_done:
   318				_ach("PUZZLE_ALL")
   319		if mode == Mode.GAUNTLET:
   320			if w == 0:
   321				if gauntlet_stage >= 7:
   322					_ach("GAUNTLET")
   323					Save.data["gauntlet_best"] = 7
   324			else:
   325				Save.data["gauntlet_best"] = maxi(int(Save.data.get("gauntlet_best", 0)), gauntlet_stage - 1)
   326		_save()
