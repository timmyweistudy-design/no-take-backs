static var _digest := ""

## 數值摘要：本檔所有常數的 SHA-256 前 16 碼。遊戲、AI、平衡工具、重播都記錄它，證明跑的是同一份數值。
static func data_digest() -> String:
	if _digest == "":
		var m: Dictionary = load("res://scripts/core/unit_defs.gd").get_script_constant_map()
		# 常數名稱是 StringName，直接排序是比記憶體位址、不是字母順序 → 先轉成 String 再排
		var pairs: Array = []
		for k in m:
			pairs.append([String(k), m[k]])
		pairs.sort_custom(func(a, b): return a[0] < b[0])
		var txt := ""
		for pr in pairs:
			txt += "%s=%s;" % [pr[0], var_to_str(pr[1])]
		_digest = txt.sha256_text().substr(0, 16)
	return _digest

static func cost(t: int) -> int:
	return STATS[t]["cost"]

static func is_melee(t: int) -> bool:
	return t != ARCHER

static func cheapest() -> int:
	var c := 999
	for s in STATS:
		c = mini(c, s["cost"])
	return c
extends SceneTree
## 偵測騎兵打轉：40 tick 內走的路程 > 3 格，但淨位移 < 0.8 格
const Sim = preload("res://scripts/core/battle_sim.gd")
const F = preload("res://scripts/core/formations.gd")
const AI = preload("res://scripts/core/ai_army.gd")
func _init():
	var pool := F.training_pool(0)
	var found := 0
	var battles := 0
	var cav_battles := 0
	var samples: Array = []
	var kinds := {}
	for i in 120:
		var a = pool[i]
		var b = pool[(i * 37 + 11) % pool.size()]
		var s = Sim.new(a.copy(), b.mirrored())
		s.fast = true
		battles += 1
		var hist := {}
		var has_cav := false
		var flagged := {}
		while not s.finished:
			s.step()
			for u in s.units:
				if u.type != 3 or not u.alive:
					continue
				has_cav = true
				var h: Array = hist.get(u.id, [])
				h.append(Vector3(u.x, u.y, 0))
				if h.size() > 40:
					h.pop_front()
				hist[u.id] = h
				if h.size() == 40 and not flagged.has(u.id):
					var path := 0.0
					for k in range(1, 40):
						path += Vector2(h[k].x, h[k].y).distance_to(Vector2(h[k-1].x, h[k-1].y))
					var net := Vector2(h[39].x, h[39].y).distance_to(Vector2(h[0].x, h[0].y))
					if path > 3000 and net < 800:
						flagged[u.id] = true
						found += 1
						var kind := "A_途經點" if u.wp_for != -1 else ("B_追擊抖動" if u.target >= 0 and s.units[u.target].mx != 0 else "C_其他")
						if u.y <= 1000 or u.y >= 8000:
							kind += "＋邊緣"
						kinds[kind] = kinds.get(kind, 0) + 1
						if samples.size() < 6:
							var tg = s.units[u.target] if u.target >= 0 else null
							samples.append({"battle": i, "tick": s.tick, "pos": [u.x, u.y], "target_type": tg.type if tg else -1,
								"target_pos": [tg.x, tg.y] if tg else [], "wp": [u.wp_x, u.wp_y, u.wp_for], "charge": u.charge, "stun": u.stun, "slow": u.slow})
		if has_cav:
			cav_battles += 1
	print("ORBIT battles=%d cav_battles=%d orbiting_cav=%d" % [battles, cav_battles, found])
	print("KINDS ", JSON.stringify(kinds))
	quit()

