## 懸念指標（優化方案 B2）：用每 tick 的戰力差 Δ(t) 算。只在結束後呼叫。
## lead_changes：開戰 5 秒後 Δ 跨過 ±5%（以總預算計）的次數；
## lock_ratio：勝方從這一 tick 起領先再也不低於 20% 的時間點 ÷ 全場；
## max_swing：贏家曾經落後的最大幅度（%）。
func suspense() -> Dictionary:
	var total := budget * 1000
	var thr := total * 5 / 100
	var lock_thr := total * 20 / 100
	var changes := 0
	var side := 0
	for t in range(100, power_log.size()):
		var d: int = power_log[t]
		var s := 0
		if d > thr:
			s = 1
		elif d < -thr:
			s = -1
		if s != 0:
			if side != 0 and s != side:
				changes += 1
			side = s
	var lock_t := power_log.size()
	var swing := 0
	if winner >= 0:
		var sign := 1 if winner == 0 else -1
		lock_t = 0
		for t in power_log.size():
			var lead: int = power_log[t] * sign
			if lead < lock_thr:
				lock_t = t + 1
			if -lead > swing:
				swing = -lead
	var ratio := lock_t * 1000 / maxi(1, power_log.size())
	return {"lead_changes": changes, "lock_ratio_permille": ratio, "max_swing_pct": swing * 100 / total}
const FRENZY_CD_RATE := 5       # 狂熱時冷卻每 tick 扣 5（平常 4）＝攻速 ×5/4
const ATTRITION_STEP_PCT := 2   # 狂熱耗損：第 k 次（k＝0～5，每 5 秒一次）扣 (k+1)×2% 滿血
const MIN_SEP := 450            # 兵與兵最小間距 0.45 格
const RALLY_RATIO_PCT := 60     # 背水（追趕機制）：自己的剩餘戰力 < 對方的這個百分比時觸發；0＝關閉。11/01 實驗 5 組後採用 60%／+2
const RALLY_CD_BONUS := 2       # 背水時冷卻每 tick 多扣幾：平常 4→6（攻速約 ×1.5）、狂熱 5→7（約 ×1.4）；實際間隔取整到 tick

static var _digest := ""

## 數值摘要：本檔所有常數的 SHA-256 前 16 碼。遊戲、AI、平衡工具、重播都記錄它，證明跑的是同一份數值。
static func data_digest() -> String:
	if _digest == "":
		var m: Dictionary = load("res://scripts/core/unit_defs.gd").get_script_constant_map()
		# 常數名稱是 StringName，直接排序是比記憶體位址、不是字母順序 → 先轉成 String 再排
		var pairs: Array = []
		for k in m:
			pairs.append([String(k), m[k]])
		pairs.sort_custom(func(a, b): return a[0] < b[0])
		var txt := ""
		for pr in pairs:
			txt += "%s=%s;" % [pr[0], var_to_str(pr[1])]
		_digest = txt.sha256_text().substr(0, 16)
	return _digest

