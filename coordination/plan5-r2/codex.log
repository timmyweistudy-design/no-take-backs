# 用法：tools/layout_check.sh <Godot 執行檔> <輸出資料夾（WSL 路徑）>
set -uo pipefail
cd "$(dirname "$0")/.."
EXE="$1"; OUT="$2"
rm -rf "$OUT"; mkdir -p "$OUT"
for lang in zh_TW en; do
  for sc in 100 125 150; do
    d="$OUT/${lang}_${sc}"; mkdir -p "$d"
