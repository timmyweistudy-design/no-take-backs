]
## 支援兵的協同對象（第四輪 §4.1：提示條「協同」顯示用）
const SYNERGY := {D.MEDIC: [D.SHIELD, D.SWORD], D.DRUMMER: [D.SWORD, D.PIKE]}
const ROLE_COLS := [[5, 4, 3], [5, 4], [0, 1, 2], [3, 2, 4], [2, 3, 1], [4, 3], [0, 1], [1, 2], [3, 2], [5, 4]]

static func counter_score(a: int, b: int) -> int:
	if b in BEATS[a]:
		return 1
	if a in BEATS[b]:
		return -1
	return 0

## 選一個兵種。level：0 簡單（隨機性高、不太看對方）、1 普通、2 困難。
static func choose_type(mine: Army, enemy_units: Array, budget_left: int, rng: RandomNumberGenerator, level := 1, ntypes := D.COUNT) -> int:
	var best := -1
	var best_s := -1.0e9
	var have := D.zeros()
	for u in mine.units:
		have[u["type"]] += 1
	var front: int = have[D.SWORD] + have[D.SHIELD] + have[D.PIKE] + have[D.BERSERKER]
	var fighters := 0
	for u in mine.units:
		if not D.is_support(u["type"]):
			fighters += 1
	for t in ntypes:
		if D.cost(t) > budget_left:
			continue
		var s := 0.0
		var react := 0.4 if level == 0 else (1.0 if level == 1 else 1.6)
		for e in enemy_units:
			s += counter_score(t, e["type"]) * react
			# 已經有的兵也要能應付對方
		for u in mine.units:
			s -= 0.15 * (1 if u["type"] == t else 0)   # 避免全押同一種
		if front < 3 and (t == D.SWORD or t == D.SHIELD):
			s += 1.2
		if D.is_support(t):
			# 支援兵：要有夠多戰鬥兵才值得帶，而且一種最多帶 2 隻
			s += 0.5 if fighters >= 5 and have[t] < 2 else -2.0
		s += float(D.cost(t)) * 0.05                       # 錢花得完
		var noise := 1.5 if level == 0 else (0.6 if level == 1 else 0.25)
		s += rng.randf() * noise
		if s > best_s:
			best_s = s
			best = t
	return best

## 選位置：依兵種角色欄位；騎兵往敵方弓手多、盾兵少的那一側；盾兵擋在敵方騎兵／弓手集中的列。
static func choose_cell(mine: Army, t: int, enemy_units: Array, rng: RandomNumberGenerator) -> Vector2i:
	var want_row := 4
	if not enemy_units.is_empty():
		var sum := 0
		var cnt := 0
		for e in enemy_units:
			var et: int = e["type"]
			if t == D.CAVALRY and et == D.ARCHER:
				sum += e["row"] * 3
				cnt += 3
			elif t == D.CAVALRY and et == D.SHIELD:
				sum += (8 - e["row"]) * 2
				cnt += 2
			elif t == D.SHIELD and (et == D.CAVALRY or et == D.ARCHER):
				sum += e["row"] * 2
				cnt += 2
			else:
				sum += e["row"]
				cnt += 1
		want_row = clampi(int(round(float(sum) / cnt)), 0, 8)
	elif t == D.CAVALRY:
		want_row = 0 if rng.randf() < 0.5 else 8
	var cols: Array = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
	for c in cols:
		var col: int = c if mine.team == 0 else Army.COLS - 1 - c
		for dr in 9:
			for sgn in [1, -1]:
				var r: int = want_row + dr * sgn
				if r < 0 or r > 8:
					continue
				if mine.check_place(t, col, r) == "":
					return Vector2i(col, r)
	return Vector2i(-1, -1)

## 在輪流落子裡走一手（可能擺多隻直到這一手花不下）。回傳擺了幾隻。
static func play_turn(tp, rng: RandomNumberGenerator, level := 1) -> int:
	var me: int = tp.current
	var mine: Army = tp.armies[me]
	var enemy: Army = tp.armies[1 - me]
	var placed := 0
	var guard := 0
	while not tp.done() and tp.current == me and guard < 30:
		guard += 1
		var t := choose_type(mine, enemy.units, tp.turn_left(), rng, level, tp.ntypes)
		if t == -1:
			break
		var c := choose_cell(mine, t, enemy.units, rng)
		if c.x < 0 or not tp.place(t, c.x, c.y):
			break
		placed += 1
		# 困難 AI 在「沒花完的錢會累積」的規則（snake5c）才會花到 60% 就收手、保留後手。
		# 第三輪 S6 抓到：原本所有規則都這樣做，snake5／cap10 沒花完的錢會直接浪費（每方只花 70 金），先手勝率被扭曲成 86%。
		if tp.current == me and level == 2 and tp.rule == "snake5c" and tp.spent_this_turn * 10 >= tp.hand_cap() * 6 and tp.can_end_turn():
			tp.end_turn()
			break
	if tp.current == me and not tp.done():
		tp.end_turn()
	return placed

## 自由擺放（對 AI 模式）：知道對方「上一局」的陣型（困難才用），一次擺滿。
static func build_full(team: int, rng: RandomNumberGenerator, level: int, known_enemy: Array, ntypes := D.COUNT) -> Army:
	var a := Army.new(team, 100)
	var guard := 0
	while a.can_afford_any() and guard < 40:
		guard += 1
		var t := choose_type(a, known_enemy if level == 2 else [], a.left(), rng, level, ntypes)
		if t == -1:
			break
		var c := choose_cell(a, t, known_enemy if level >= 1 else [], rng)
		if c.x < 0:
			break
		a.place(t, c.x, c.y)
	return a
extends RefCounted
## AI 陣型（原型＝企劃 §7 的「普通」：從原型陣型挑一套再隨機微調）。
## AI 只在擺放時用亂數；戰鬥本身沒有亂數。

const D = preload("res://scripts/core/unit_defs.gd")
const Army = preload("res://scripts/core/army.gd")

# 權重順序：劍、盾、弓、騎、刺、槍、彈、醫、鼓、狂（第四輪加後 5 種）。
# 模板只會在「用到的兵種都已開放」時被選（ntypes：開放編號 0～ntypes−1，經典模式＝5）。
const TEMPLATES := [
	{"name": "均衡軍", "w": [3, 2, 3, 1, 1, 0, 0, 0, 0, 0]},
	{"name": "鐵壁弓陣", "w": [1, 4, 5, 0, 0, 0, 0, 0, 0, 0]},
	{"name": "鐵騎突擊", "w": [2, 1, 0, 5, 0, 0, 0, 0, 0, 0]},
	{"name": "暗影刺殺", "w": [3, 0, 2, 0, 4, 0, 0, 0, 0, 0]},
	{"name": "劍海", "w": [5, 2, 2, 0, 0, 0, 0, 0, 0, 0]},
	{"name": "騎射混編", "w": [0, 2, 3, 3, 0, 0, 0, 0, 0, 0]},
	{"name": "槍盾方陣", "w": [1, 3, 2, 0, 0, 4, 0, 0, 0, 0]},
	{"name": "砲擊陣", "w": [2, 3, 1, 0, 0, 1, 4, 0, 0, 0]},
	{"name": "醫療鐵壁", "w": [2, 3, 2, 0, 0, 1, 0, 2, 0, 0]},
	{"name": "戰鼓衝陣", "w": [4, 1, 0, 2, 1, 0, 0, 0, 2, 0]},
	{"name": "破陣突擊", "w": [2, 0, 3, 0, 0, 1, 0, 0, 0, 4]},
]

# 每種兵偏好的欄（以藍方 0～5 表示，0＝最後排、5＝最前排；紅方自動鏡像）
const PREF_COLS := [
	[5, 4, 3],          # 劍士：前排
	[5, 4],             # 盾兵：最前排
	[0, 1, 2],          # 弓箭手：後排
	[3, 2, 4],          # 騎兵：中排兩翼
	[2, 3, 1],          # 刺客：中後排
	[4, 3],             # 長槍兵：第二排
	[0, 1],             # 投彈兵：最後排
	[1, 2],             # 醫者：後排
	[3, 2],             # 鼓手：中間
	[5, 4],             # 狂戰士：前排
]
# 擺放順序：前排先佔中間（盾、槍、劍、狂），再騎、刺、鼓、醫、彈、弓
const PLACE_ORDER := [1, 5, 0, 9, 3, 4, 8, 7, 6, 2]
const ROW_CENTER := [4, 3, 5, 2, 6, 1, 7, 0, 8]
const ROW_EDGE := [0, 8, 1, 7, 2, 6, 3, 5, 4]

## 這個模板用到的兵種是否都在 0～ntypes−1 裡。
static func template_ok(ti: int, ntypes: int) -> bool:
	var w: Array = TEMPLATES[ti]["w"]
	for t in range(ntypes, w.size()):
		if w[t] > 0:
			return false
	return true

static func eligible_templates(ntypes: int) -> Array:
	var out: Array = []
	for ti in TEMPLATES.size():
		if template_ok(ti, ntypes):
			out.append(ti)
	return out

static func build(team: int, budget: int, rng: RandomNumberGenerator, template := -1, ntypes := D.COUNT):
	var a = Army.new(team, budget)
	var el := eligible_templates(ntypes)
	if template >= 0 and not template_ok(template, ntypes):
		template = -1   # 指定的模板用到未開放的兵種：改從可用的模板抽（Codex 實作審查 #3）
	var ti := template if template >= 0 else int(el[rng.randi_range(0, el.size() - 1)])
	var w: Array = TEMPLATES[ti]["w"]
	var picks: Array = []
	var guard := 0
	while a.left() >= D.cheapest() and picks.size() < Army.MAX_UNITS and guard < 200:
		guard += 1
		var total := 0
		for t in ntypes:
			if D.cost(t) <= a.left() - _cost_sum(picks) and w[t] > 0:
				total += w[t]
		if total == 0:
			break
		var r := rng.randi_range(1, total)
		for t in ntypes:
			if D.cost(t) <= a.left() - _cost_sum(picks) and w[t] > 0:
				r -= w[t]
				if r <= 0:
					picks.append(t)
					break
		if _cost_sum(picks) > a.left():
			picks.pop_back()
			break
	# 先放盾兵、劍士，再放其他（讓前排先佔中間）
	picks.sort_custom(func(p, q): return PLACE_ORDER.find(p) < PLACE_ORDER.find(q))
	for t in picks:
		_place_pref(a, t)
	return {"army": a, "name": TEMPLATES[ti]["name"]}

static func _cost_sum(picks: Array) -> int:
	var s := 0
	for t in picks:
		s += D.cost(t)
	return s

static func _place_pref(a, t: int) -> void:
	var rows: Array = ROW_EDGE if t == D.CAVALRY else ROW_CENTER
	var cols: Array = PREF_COLS[t] + [5, 4, 3, 2, 1, 0]
	for c in cols:
		var col: int = c if a.team == 0 else Army.COLS - 1 - c
		for r in rows:
			if a.place(t, col, r):
				return

