+## 1.2.0 第 6 大類 D／E §5.4：晨昏色調＋天氣，只改畫面、畫在盤面上單位之下（不遮單位、不改隊色）。
+## 晨 5～10 點冷藍、昏 17～20 點橘、夜加深；午不加。天氣：冰湖＝雪（刨屑）、河谷／林間偶爾雨（水珠反光）、平原＝風（草葉）。
+## 截圖、減少特效、簡化介面、4 倍速以上不畫；色盲模式色調減半、不下天氣。全部解析式（時間＋格位雜湊），不存狀態。
+func tod_now() -> int:   # 0 晨、1 午、2 昏、3 夜
+	var hr := int(Time.get_datetime_dict_from_system()["hour"])
+	return 0 if hr >= 5 and hr < 10 else (1 if hr < 17 else (2 if hr < 20 else 3))
+
+func _draw_tod_weather() -> void:
+	if shot_dir != "" or layout_probe or bool(Save.s("reduce_fx")) or bool(Save.s("plain_ui")):
+		return
+	var fr := Rect2(ORIGIN, fld_size)
+	var cb := cbm()
+	var k := 0.5 if cb else 1.0
+	match tod_now():
+		0:
+			draw_rect(fr, Color(0.55, 0.7, 1.0, 0.06 * k))
+		2:
+			draw_rect(fr, Color(1.0, 0.6, 0.25, 0.08 * k))
+		3:
+			draw_rect(fr, Color(0.2, 0.22, 0.4, 0.12 * k))
+	if cb or speed >= 4.0 or MapDefs.MAPS.size() <= fld_map:
+		return
+	var biome := str(MapDefs.MAPS[fld_map]["biome"])
+	var wseed := fld_map * 7 + round_no * 13
+	if biome == "ice":   # 雪：細刨屑緩降（最多 60 顆）
+		for i in 60:
+			var hx := float((i * 7919 + wseed * 31) % 1000) / 1000.0
+			var ph := fmod(time * 0.06 + float((i * 104729) % 997) / 997.0, 1.0)
+			var px := fr.position.x + fr.size.x * fmod(hx + 0.03 * sin(time * 0.8 + i), 1.0)
+			draw_rect(Rect2(px, fr.position.y + fr.size.y * ph, 2.0, 1.2), Color(1, 1, 1, 0.55))
+	elif (biome == "river" or biome == "forest") and wseed % 3 == 0:   # 雨：盤上 20 顆水珠反光（一閃一閃）
+		for i in 20:
+			var qx := fr.position.x + fr.size.x * float((i * 6151 + wseed) % 1000) / 1000.0
+			var qy := fr.position.y + fr.size.y * float((i * 3571 + wseed * 7) % 1000) / 1000.0
+			var gl := 0.5 + 0.5 * sin(time * 2.0 + i * 1.7)
+			draw_circle(Vector2(qx, qy), 1.6, Color(0.85, 0.95, 1.0, 0.25 + 0.35 * gl), true, -1.0, true)
+	elif biome == "grass":   # 風：30 片小草葉往右下飄
+		for i in 30:
+			var ph2 := fmod(time * 0.08 + float((i * 7907) % 991) / 991.0, 1.0)
+			var y0 := fr.position.y + fr.size.y * float((i * 4441 + wseed) % 1000) / 1000.0
+			var lp := Vector2(fr.position.x + fr.size.x * ph2, y0 + 20.0 * ph2 + 4.0 * sin(time * 3.0 + i))
+			draw_line(lp, lp + Vector2(4, 1.5), Color(0.35, 0.5, 0.2, 0.45), 1.5, true)
+
