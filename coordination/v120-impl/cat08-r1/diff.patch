extends RefCounted
## 1.2.0 §11.3 分岔同步比較：時光機「如果」播放時，原本時間線（ghost）和現在這條在同一 tick 的存活數。
## 回傳 [原本藍, 原本紅, 如果藍, 如果紅]。只給數字，不說因果（一場模擬不能證明原因，§11.4 同原則）。
static func alive_pair(ghost, now) -> Array:
	return [_alive(ghost, 0), _alive(ghost, 1), _alive(now, 0), _alive(now, 1)]

static func _alive(sm, team: int) -> int:
	if sm == null:
		return 0
	var n := 0
	for u in sm.units:
		if u.alive and u.team == team and not u.get("summon"):
			n += 1
	return n
=== NEW game/scripts/game/songbook.gd
extends RefCounted
## 1.2.0 §11.8 名局棋譜本：把重播碼（對戰代碼）收成冊，最多 MAX 筆（新的在前，滿了丟最舊的）。
## 每筆 {"c": 代碼, "n": 標題（日期＋結果）, "note": 老闆批註（這場的關鍵時刻）, "t": 收進來的時間}。純資料。
const MAX := 6
const CODE_MAX := 6000

static func add(book: Array, code: String, title: String, note: String, now: int) -> Array:
	var out: Array = []
	for e in book:
		if e is Dictionary and str(e.get("c", "")) != code:
			out.append(e)
	out.push_front({"c": code, "n": title.left(80), "note": note.left(120), "t": now})
	return out.slice(0, MAX)

static func remove(book: Array, i: int) -> Array:
	var out := book.duplicate(true)
	if i >= 0 and i < out.size():
		out.remove_at(i)
	return out

## 存檔讀進來時逐筆驗型（壞的丟掉）
static func sanitize(raw) -> Array:
	var out: Array = []
	if not raw is Array:
		return out
	for e in raw:
		if out.size() >= MAX:
			break
		if e is Dictionary and e.get("c") is String and str(e["c"]).length() <= CODE_MAX and str(e["c"]) != "":
			out.append({"c": str(e["c"]), "n": str(e.get("n", "")).left(80), "note": str(e.get("note", "")).left(120), "t": int(e.get("t", 0)) if (e.get("t") is int or e.get("t") is float) else 0})
	return out
=== NEW game/scripts/game/recent.gd
extends RefCounted
## 1.2.0 §11.11 模式收藏與最近遊玩：記最近點過的主畫面卡片（hub 名、卡片字串鍵），新的在前、去重、最多 MAX。純資料。
const MAX := 3

static func push(list, hub: String, key: String) -> Array:
	var out: Array = [{"h": hub, "k": key}]
	for e in (list if list is Array else []):
		if e is Dictionary and not (str(e.get("h", "")) == hub and str(e.get("k", "")) == key):
			out.append({"h": str(e.get("h", "")), "k": str(e.get("k", ""))})
	return out.slice(0, MAX)

## 只留認得的 hub、型別正確的（存檔壞掉或舊版沒有的卡片不顯示）
static func valid(list, hubs: Array) -> Array:
	var out: Array = []
	for e in (list if list is Array else []):
		if e is Dictionary and e.get("h") is String and e.get("k") is String and str(e["h"]) in hubs and out.size() < MAX:
			out.append(e)
	return out
