+	if not preload("res://scripts/game/guide.gd").is_new(Save.data, "note_" + key):
+		return
+	note_key = key
+	overlay = "boss_note"
+	_focus = 0
+
+func _close_boss_note() -> void:
+	preload("res://scripts/game/guide.gd").see(Save.data, "note_" + note_key)
+	Save.save_data()
+	overlay = ""
