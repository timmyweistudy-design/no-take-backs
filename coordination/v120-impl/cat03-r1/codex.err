## ── 輸入命令佇列（第三輪 A2）──
## 輸入事件不再直接執行，也不在 _draw 裡派發：先排進佇列，在 _process 開頭依序處理。
## 每個命令記下排入時的「畫面世代」；畫面（狀態、覆蓋層、模式）一換，舊命令就丟掉，避免點到下一個畫面的按鈕。
## 點擊只對「這個世代畫出來的按鈕」有效（_btns_gen）。
func _enqueue(kind: String, data) -> void:
	_cmds.append({"kind": kind, "data": data, "gen": _gen})

func _update_gen() -> void:
	var key := "%d|%s|%d" % [state, overlay, mode]
	if key != _gen_key:
		_gen_key = key
		_gen += 1


## 自己畫框、不走 _panel 的模態面板也要登記（R1、漏登記守衛）
func probe_panel(r: Rect2) -> void:
	if layout_probe:
		probe_panels.append({"id": "P%d" % probe_panels.size(), "r": r, "skip": {}})

func _panel(r: Rect2) -> void:
	probe_panel(r)
	_dim(0.62)
	_box(Rect2(r.position + Vector2(5, 7), r.size).grow(4), Color(DIM_INK, 0.45), Color(0, 0, 0, 0), 14.0)      # 陰影（1.2.0：光源左上 → 影子往右下）
	_box(r, PANEL, Color(0, 0, 0, 0), 10.0)
	if not bool(Save.s("plain_ui")):
		_mat_box(r.grow(-6), "walnut", Color(0.62, 0.6, 0.58))   # 1.2.0 §2：面板底是胡桃木紋（壓暗，字照樣看得清）
	# V1.2 B3：深木外框＋四角銅釘（九宮格貼圖）；沒有貼圖時退回舊的細框
	var fx := _ui_tex(TEX_FRAME)
	if fx != null and not bool(Save.s("plain_ui")):
		var sb: StyleBoxTexture = _sb_cache.get("frame")
		if sb == null:
			sb = StyleBoxTexture.new()
			sb.texture = fx
			for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
				sb.set_texture_margin(side, 22.0)
			sb.draw_center = false
			_sb_cache["frame"] = sb
		draw_style_box(sb, r.grow(8))
	else:
		_box(r, Color(0, 0, 0, 0), TH_EDGE, 10.0, 3.0)


func _open(name: String) -> void:
	if overlay.begins_with("hub_"):
		nav_stack.append(overlay)   # 卡片面板開著時直接開下一頁（例如結果頁「試煉」）：記得回面板
	overlay = name
	_focus = 0

## V1.5.1 返回目的地：打開下一層之前記下「從哪來」，返回鈕、Esc、手把 B 都走 _nav_back（使用者回報：返回都跳回主畫面）。
## 卡片面板（hub）畫出來時清空堆疊；開戰也清空。nav_hub＝最後經過的卡片面板，打完回標題時重新打開它。
var nav_stack: Array = []
var nav_hub := ""

var nav_focus := {}   # V1.0.0：卡片面板 → 上次點的那張卡（返回時焦點回原卡）
func _nav_push(from: String) -> void:
	nav_stack.append(from)

func _nav_back(fallback := "") -> void:
	if overlay.begins_with("hub_") or overlay == "playroom":   # V1.0.0：遊戲間也是卡片面板
		nav_hub = ""   # 關掉卡片面板：之後打完不再自動打開它
	overlay = str(nav_stack.pop_back()) if not nav_stack.is_empty() else fallback
	_focus = int(nav_focus.get(overlay, 0))   # V1.0.0（Codex v100-i1 #8）：回到卡片面板時焦點回原卡


func _fmt_num(v: float) -> String:
	return str(int(v)) if v == floorf(v) else str(v)


func _onoff(k: String) -> String:
	return L.t("on") if bool(Save.s(k)) else L.t("off")


func _cycle_setting(k: String, opts: Array) -> void:
	var cur = Save.s(k)
	var i := 0
	for j in opts.size():
		if str(opts[j]) == str(cur):
			i = j
	Save.set_setting(k, opts[(i + 1) % opts.size()])

## 畫一隻角色：精靈圖快取好了就貼圖（快很多），否則直接用 Art 畫。畫面相同。
func _unit(p: Vector2, type: int, team: int, face: float, walk: float, atk: float, hurt: float, alpha: float, t: float, scale := 1.0,
		mood := 0, lean := 0.0, crouch := 1.0, variant := 0, fid := -1) -> void:
	if scale > 1.4 and alpha > 0.5 and not bool(Save.s("plain_ui")):
		_unit_base(p, scale)
	if scale <= 1.4 and sprites != null and sprites.is_ready(cbm()) and sprites.has_type(type):   # V1.2：大圖（圖鑑、MVP）直接向量畫，放大圖集會糊
		St.BATTLE:
			if play_kind != "official":
				return [[_pk("place"), L.t("pk_select")], [_pk("back"), L.t("back")], [_pk("codex"), L.t("br_title")]]   # 1.1.0 B10
			return [[_pk("place"), L.t("pk_select")], [_pk("back"), L.t("skip")]]
		St.RESULT:
			return [["＋", L.t("pk_move")], [_pk("place"), L.t("pk_select")], [_pk("back"), L.t("menu")]]
	return []

## 手把按鍵提示列（第三輪 U7）：用手把時，每個畫面右下角顯示這個畫面能按的鍵（A／B／X／Y 圓形圖示）；
## 用鍵盤滑鼠時不顯示手把圖示（Steam Deck 規定兩者不能同時出現）。擺放畫面已經在上方列顯示，這裡略過。
func _draw_pad_footer() -> void:
	if not pad_mode or (state == St.PLACE and overlay == ""):
		return
	var items: Array = _pad_footer_items()
	if items.is_empty():
		return
	draw_rect(Rect2(0, 770, 1280, 30), Color(0, 0, 0, 0.45))
	if layout_probe:
		probe_boxes.append({"r": Rect2(0, 770, 1280, 30), "inner": Rect2(0, 766, 1280, 34)})   # 提示列是最上層的底（不是底下兵卡的字）
	_key_hints(640, 773, items, 14)



## 滑鼠停在哪一列：輸入狀態，每幀更新一次（第七輪 H7：原本在繪圖時改狀態）。
func _settings_hover() -> void:
	if overlay != "settings":
		return
	var rows := _settings_rows()
	for i in rows.size():
		if Rect2(340, _settings_row_y(i) - 5, 560, 56).has_point(mouse):
			settings_item = rows[i][0]
	# 手把／鍵盤移焦點時，說明欄跟著焦點那一列（Antigravity v150-i1 #3）
	if pad_mode and _btns_gen == _gen and _focus >= 0 and _focus < _btns.size():
		var fy: float = _btns[_focus]["r"].position.y
		for i in rows.size():
			if absf(fy - _settings_row_y(i)) < 2.0:
				settings_item = rows[i][0]







## ── 輸入命令佇列的執行端（第三輪 A2；S8 從 ui_base 移下來：基底不再用空函式呼叫上層）──
func _process_cmds() -> int:
	var done := 0
	_update_gen()
	var q := _cmds
	_cmds = []
	for c in q:
		if c["gen"] != _gen:
			# 畫面已經換了：丟掉。但「放開滑鼠」一定要清掉拖曳／塗兵狀態（Codex S1 #2）
			if c["kind"] == "mb" and not c["data"]["pressed"]:
				_mb_release_cleanup()
			elif c["kind"] == "padbtn" and not c["data"]["pressed"]:
				_fp_abort_drag()   # 手把放開 A／X 的事件過期：同樣清掉（Codex 實作第 3 輪 #1）
			continue
		if c["kind"] == "click":
			done += _do_click(c["data"])
		elif c["kind"] == "mb":
			# 滑鼠按鍵（擺放、拖曳、移除）也走同一個佇列，和鍵盤選兵的先後順序一致（Codex S1 #2）
			_mb_cmd(c["data"])
			done += 1
		elif c["kind"] == "paint":
			_paint_cmd(c["data"])
		elif c["kind"] == "padbtn":
			if not _fp_pad_button(int(c["data"]["b"]), bool(c["data"]["pressed"])) and c["data"]["pressed"]:
				var mp := {JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_B: KEY_ESCAPE}
				if mp.has(int(c["data"]["b"])):
					_key(mp[int(c["data"]["b"])])
			done += 1
		elif c["kind"] == "key":
			_key(int(c["data"]))
			done += 1
		_update_gen()
	return done



## 點擊：只對這個畫面世代畫出來的按鈕有效。回傳執行了幾個。
extends RefCounted
## V1.6 #1 新手到試玩結尾：首頁「建議下一步」、入口「新」標記、試玩版結尾。純函式（測試共用）。
const Save = preload("res://scripts/game/save.gd")

## 建議下一步：依進度挑最前面還沒做的一件。回傳鍵（""＝都做過了，不顯示）
## data＝存檔、daily_done＝今天每日打過了、demo＝試玩版
static func next_step(data: Dictionary, daily_done: bool, demo: bool) -> String:
	var f: Dictionary = data.get("funnel", {})
	if int(data.get("tutorial", 0)) == 0 and not f.has("tutorial_done"):
		return "tut"
	if ai_count(data, "games") == 0:
		return "ai"
	if not demo and not (data.get("gauntlet_run", {}) as Dictionary).is_empty():
		return "gauntlet_cont"   # V1.0.0 N6：有沒打完的遠征，先接著打
	if (data.get("puzzle_stars", {}) as Dictionary).is_empty():
		return "puzzle"
	if (data.get("puzzle_stars", {}) as Dictionary).size() < PUZZLE_FIRST and ai_count(data, "wins") == 0:
		return "puzzle_more"   # V1.0.0 N6：第一小時先把殘局第 1 章打熟（5 關或贏一場 AI 後才推別的）
	if demo:
		return ""
	if not daily_done:
		return "daily"
	if int(data.get("gauntlet_best", 0)) == 0 and (data.get("gauntlet_run", {}) as Dictionary).is_empty():
		return "gauntlet"
	if not f.has("playroom_open"):
		return "playroom"
	if (data.get("trial_stars", {}) as Dictionary).is_empty():
		return "trials"
	if games_of(data) >= NEW_AFTER:
		for k in V16_ENTRIES:
			if is_new(data, k):
				return "v16:" + k   # V1.6.1 N1：玩滿門檻後才推新玩法（一次一個）
	return ""

const PUZZLE_FIRST := 5

## 對 AI 的場數／勝場（V1.0.0 起另記 ai_games、ai_wins；老存檔沒有就用舊的 stats，估多了只是少推一步）
static func ai_count(data: Dictionary, k: String) -> int:
	if data.has("ai_" + k):
		return int(data["ai_" + k])
	return int(data.get("stats", {}).get(k, 0))

## 「繼續殘局」：照章節順序第一個還沒過的殘局 id（全過了回 ""）。
static func next_puzzle_id(data: Dictionary, all: Array) -> String:
	var st: Dictionary = data.get("puzzle_stars", {})
	for p in all:
		if not st.has(str(p["id"])):
			return str(p["id"])
	return ""

## V1.6.1 N1（三方 v161d §0-2）：V1.6 新玩法要先完成 NEW_AFTER 場有效對局（stats.games：正式對局，不含教學、觀戰、重播）
## 才標「新」、才進建議清單；入口照舊全開。
const V16_ENTRIES := ["rush_open", "trio_open", "rift_open", "fog_open", "ed_open", "coop_open"]
const NEW_AFTER := 3
## 有效對局：V1.6.1 起另外計 eff_games（正式對局，不含教學、觀戰、重播、沙盒，標準與自訂規則都算；Codex v161-i1 #11）。
## 升級的老玩家第一次開：用舊統計（標準＋自訂）當起點（seed_eff）。這是估計（舊統計分不出教學重打），
## 只影響「什麼時候開始推新玩法」，估多了最多早一點推，不擋任何東西（Codex v161-i2 #3 的裁決見 ledger）。
static func games_of(data: Dictionary) -> int:
	return int(data.get("eff_games", 0))

static func seed_eff(data: Dictionary) -> void:
	if data.has("eff_games"):
		return
	var n := 0
	for k in ["stats", "custom_stats"]:
		var st = data.get(k, {})
		if st is Dictionary:
			n += int(st.get("games", 0))
	data["eff_games"] = n

## V1.6.1 N2：老玩家（V1.6.1 之前就玩過）第一次開，跳一次新玩法導覽
static func tour_due(data: Dictionary, demo: bool) -> bool:
	return not demo and games_of(data) >= NEW_AFTER and not (data.get("seen", []) as Array).has("tour161")

## V1.6 之前就有的入口（老玩家升級時直接算看過；V1.6 新入口對每個人都標「新」）
const OLD_ENTRIES := ["menu_tutorial", "menu_vs_ai", "menu_duel", "menu_puzzle", "menu_trials", "menu_daily", "wk_open", "gh_open",
	"menu_codex", "paint_open", "menu_profile", "nem_open", "pr_wager", "pr_draft", "pr_waves", "pr_sealed"]

## 第一次用 V1.6 開遊戲：老玩家把舊入口記成看過（新玩家全部都是新的，但新玩家看到滿滿「新」沒意義 → 新玩家也只標 V1.6 新入口）
static func seed_seen(data: Dictionary) -> void:
	if not data.has("seen"):
		data["seen"] = OLD_ENTRIES.duplicate()

## V1.0.0：入口換位置後新出現的卡片鍵，但玩法是老的（單人遠征原本是主畫面木牌）：不標「新」
const NEVER_NEW := ["menu_gauntlet"]
static func is_new(data: Dictionary, key: String) -> bool:
	if key in NEVER_NEW:
		return false
	if key in V16_ENTRIES and games_of(data) < NEW_AFTER:
		return false   # 新手前幾場先不標（資訊量），玩滿門檻才標
	return not (data.get("seen", OLD_ENTRIES) as Array).has(key)

static func see(data: Dictionary, key: String) -> void:
	var s: Array = data.get("seen", OLD_ENTRIES.duplicate())
	if not s.has(key):
		s.append(key)
	data["seen"] = s

## 試玩版結尾：試玩版打滿 DEMO_END_GAMES 場（含教學、殘局）且這次還沒出現過
const DEMO_END_GAMES := 4
