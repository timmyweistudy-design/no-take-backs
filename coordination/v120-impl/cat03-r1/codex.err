+## 1.2.0 §1.1 桌面世界：整個畫面底下是一張老胡桃木桌（螢幕座標，鏡頭之前畫）。
+## 光從左上來：左上一層暖光、右下一層暖暗；四角暖暗角；桌上固定 5 件低彩度小物（不搶焦點）。簡化介面時退回平塗。
+func _draw_desk() -> void:
+	if bool(Save.s("plain_ui")):
+		draw_rect(Rect2(0, 0, 1280, 800), Color("#3a281c"))
+		return
+	var wt := _ui_tex(MAT["walnut"])
+	if wt == null:
+		draw_rect(Rect2(0, 0, 1280, 800), Color("#3a281c"))
+		return
+	texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
+	draw_texture_rect(wt, Rect2(0, 0, 1280, 800), true, Color(0.78, 0.74, 0.7))
+	# 主光（左上暖）與右下暗：兩個大三角形的頂點色漸層
+	draw_polygon(PackedVector2Array([Vector2(0, 0), Vector2(1280, 0), Vector2(0, 800)]),
+		PackedColorArray([Color(1.0, 0.86, 0.6, 0.16), Color(1.0, 0.86, 0.6, 0.0), Color(1.0, 0.86, 0.6, 0.0)]))
+	draw_polygon(PackedVector2Array([Vector2(1280, 800), Vector2(1280, 0), Vector2(0, 800)]),
+		PackedColorArray([Color(DIM_INK, 0.42), Color(DIM_INK, 0.0), Color(DIM_INK, 0.0)]))
+	var vg := _ui_tex(TEX_VIGNETTE)
+	if vg != null:
+		draw_texture_rect(vg, Rect2(0, 0, 1280, 800), false, Color(0.11, 0.075, 0.05, 0.85))
+	_desk_props()
+
+## 桌上小物（固定位置、低彩度、一律在畫面邊角，UI 蓋在上面也沒關係）
+func _desk_props() -> void:
+	# 墨水瓶（左下）：深色玻璃＋左上高光＋軟木塞
+	var ink := Vector2(46, 742)
+	draw_circle(ink + Vector2(5, 7), 26.0, Color(DIM_INK, 0.45), true, -1.0, true)
+	draw_circle(ink, 24.0, Color("#1f2430"), true, -1.0, true)
+	draw_circle(ink - Vector2(8, 8), 6.0, Color(1, 1, 1, 0.18), true, -1.0, true)
+	draw_rect(Rect2(ink - Vector2(7, 34), Vector2(14, 12)), Color("#9c7a52"))
+	# 量尺（下緣，部分在畫面外）
+	var rr := Rect2(420, 786, 440, 28)
+	draw_rect(rr, Color("#c9a674"))
+	for i in 45:
+		draw_line(Vector2(rr.position.x + 6 + i * 9.6, rr.position.y), Vector2(rr.position.x + 6 + i * 9.6, rr.position.y + (8 if i % 5 == 0 else 4)), Color("#5a3f22", 0.8), 1.0)
+	# 棋罐（右上）：木碗＋碗口暗面
+	var bowl := Vector2(1244, 30)
+	draw_circle(bowl + Vector2(5, 7), 34.0, Color(DIM_INK, 0.45), true, -1.0, true)
+	draw_circle(bowl, 32.0, Color("#7a5434"), true, -1.0, true)
+	draw_circle(bowl, 22.0, Color("#3e2a1a"), true, -1.0, true)
+	draw_circle(bowl - Vector2(10, 10), 7.0, Color(1, 0.9, 0.7, 0.16), true, -1.0, true)
+	# 筆記本一角（左上）
	var y2 := y0 + 5 * (ph + gap) + 4
	var sys := [["menu_settings", func(): _open("settings")], ["menu_codes", func(): overlay = "codes"; _focus = 0], ["menu_quit", func(): call("_quit_mark"); get_tree().quit()]]
	for i in sys.size():
		_btn(Rect2(70 + i * 126, y2, 118, 40), L.t(sys[i][0]), sys[i][1], true, false, Color(TH_WOOD_D, 0.92))
	probe_align("home_col", [Rect2(HOME_CX - tw / 2 - 60, 40, tw + 120, tsz), Rect2(70, y0, PW, 5 * (ph + gap)), Rect2(70, y2, 2 * 126 + 118, 40)])
	call("_draw_next_step")   # V1.6 #1
	# 底部：最佳紀錄、版本
	_text(Vector2(70, 740), "%s　｜　v%s" % [L.t("gauntlet_best", [int(Save.data.get("gauntlet_best", 0))]), str(ProjectSettings.get_setting("application/config/version"))], tz("C"), TXT_DIM, false, false, 380)



func _pick_puzzle(id: String, tut: bool) -> void:
	puzzle_id = id
	_start_mode(Mode.TUTORIAL if tut else Mode.PUZZLE)
	if tut and id == "t1":
		_toast(tut_remove_text())   # V1.0.0 N6：教學第一關就講「擺錯可以拿掉重擺」
	elif tut and id == "t2":
		_toast(L.t("tut_counter"))   # V1.0.0 M1：剋制記號 ▲▼ 的互動說明（選一隻兵看敵兵頭上）

## 照現在的輸入方式講怎麼拿掉兵；並說清楚只有雙人輪流落子才不能收回（遊戲名叫落子無悔）。
func tut_remove_text() -> String:
	var how := L.t("tut_rm_mouse")
	if pad_mode:
		how = L.t("tut_rm_pad", [_pk("remove")])
	elif Save.s("place_mode") == "tap":
		how = L.t("tut_rm_tap")
	return L.t("tut_remove", [how])



# ── 覆蓋層 ──
extends "res://scripts/ui/battle/battle_units.gd"
## 其他層在同資料夾（V9 P1 拆檔）

func _on_skip() -> void:
	if skip_busy:
		return   # 防重入
	paused = false   # Codex r1：暫停中按直接看結果，算完要能進結算
	if DisplayServer.get_name() == "headless" or shot_dir != "":
		while not view.finished:
			_sim_step(false)
		result_delay = 9.0
		return
	skip_busy = true


func _skip_step() -> void:
	var t0 := Time.get_ticks_msec()
	while not view.finished and Time.get_ticks_msec() - t0 < 10:
		_sim_step(false)
	if view.finished:
		skip_busy = false
		result_delay = 9.0


## 第十輪 I4：重播的全長在背景算，算完才開始播。
func _pre_join() -> void:
	if pre_thread != null:
		var v = pre_thread.wait_to_finish()
		pre_thread = null
		if v != null:
			replay_total = int(v)

## 不要等：還在算就留給 _pre_reap 收。
func _pre_drop() -> void:
	if pre_thread != null:
		pre_old.append(pre_thread)
		pre_thread = null

func _pre_reap() -> void:
	for i in range(pre_old.size() - 1, -1, -1):
		if not pre_old[i].is_alive():
			pre_old[i].wait_to_finish()
			pre_old.remove_at(i)

func _exit_tree() -> void:
	if has_method("_rv_exit"):
		call("_rv_exit")   # 1.1.0 H1：覆盤重算、GIF 先叫停再等
	bg.drain()   # 1.1.0 N6：覆盤、GIF、教練、三考、出題碼的背景工作：全部叫停再等（各自 64 tick／每格內會停）
	_pre_join()
	_pre_drop()
	for th in pre_old:
		th.wait_to_finish()
	pre_old.clear()
	if ai_thread != null:
		ai_thread.wait_to_finish()
		ai_thread = null

func _battle_process(delta: float) -> void:
	if pre_thread != null:
		if pre_thread.is_alive():
			return
		_pre_join()
	if view != null:
		_gait_frame(delta)   # 不能放在只有部分情況才跑的地方（Codex P2 #1）
	if start_hold > 0.0:
		var ph0 := 1.0 - start_hold
		start_hold -= delta
		var ph1 := 1.0 - start_hold
		for at in [0.25, 0.55, 0.85]:   # 1.2.0 §9.1：三段落子各一聲厚重落子聲（全場只有 3 聲）
			if ph0 < at and ph1 >= at and sfx != null:
				sfx.play("place_heavy", 0.75)
		return
	if call("_seek_pump"):
		return
	if skip_busy:
		_skip_step()
		return
	if paused:
		return
	if hitstop > 0:
		hitstop -= delta
		return
	var rate := speed
	if slow_left > 0:
		rate *= 0.5
		slow_left -= delta
	if final_left > 0:
		rate *= 0.25      # 第十輪 F1：最後一擊
		final_left -= delta
		_update_action_focus()
	accum += delta * rate
	while accum >= 0.05 and not view.finished:
		accum -= 0.05
		var was_slow := slow_left > 0 or final_left > 0
		_sim_step(true)
		if (slow_left > 0 or final_left > 0) and not was_slow:
			break   # 這一 tick 觸發慢動作：剩下的累積留到下一幀用慢速消耗（Codex S8 #3）
	# 播完之後展示時鐘繼續走（不再推進快照）：最後一格的位置插值與最後一擊的後搖要演完（Codex R5 #1）
	# 最後時刻只在 _sim_step 每個畫面 tick 判定（Codex S8 #1：每幀也判會讓觸發 tick 跟幀率有關）
	if slow_left > 0:
		_update_action_focus()
	sfx.set_muffled(slow_left > 0 and not view.finished)
	# 分軌音樂依戰況混音（第三輪 S1）
	var close := absf(view.power(0) * 100.0 / (view.budget_of(0) * 1000) - view.power(1) * 100.0 / (view.budget_of(1) * 1000)) <= 15.0
	sfx.set_layer_targets(sfx.layer_targets(close, slow_left > 0 and not view.finished))
	# 鏡頭只有一個決策點（Codex S5 #6）：跟拍優先於最後時刻框選，兩者都沒有才回到全景
	if follow_id >= 0:
		pass   # 由 _follow_update 決定
	elif slow_left > 0 and not view.finished and bool(Save.s("clutch_zoom")) and not bool(Save.s("reduce_motion")):   # V1.5：最後時刻自動放大可關
		_frame_alive(delta)
			if su.alive:
				liv[su.team] += 1
		for gt in 2:
			var mine := float(liv[gt]) / maxf(1.0, cnt[gt])
			var theirs := float(liv[1 - gt]) / maxf(1.0, cnt[1 - gt])
			grim[gt] = mine < 0.25 and theirs > mine * 2.0
	# V1.3 P0-1：這一幀的畫面位置只算一次（排序比較器原本每次比較都重算 _upos）
	var pc := {}
	if live:
		for u in list:
			pc[u.id] = _upos(u) + _open_drop(u)
		list.sort_custom(func(a, b): return pc[a.id].y < pc[b.id].y)
	else:
		list.sort_custom(func(a, b): return a.y < b.y)
	_draw_v8_ground(s, live)
	# 第一層：腳底標記與影子（全部先畫，不會被別人的身體整個蓋住時也看得到外圈）
	var a_now := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
	var gm: Array = _goal_mark()
	if live and tm_ghost != null and play_kind == "review":
		# V1.4 #1 時光機：原本那條時間線的兵畫成地上的淡圈（隊伍色點＋白圈），看得出兩條時間線從哪裡分開
		for gu in tm_ghost.units:
			if not gu.alive:
				continue
			var gq: Vector2 = ORIGIN + Vector2(gu.x, gu.y) * CS / 1000.0
			# 粉筆虛線圈（米白、45%），不是 RTS 選取框（Antigravity v140-i1）
			draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.5), 0, gq))
			var rr := 15.0 * UNIT_SCALE
			for sgm in 8:
				var a0 := sgm * TAU / 8.0 + float(gu.id % 5) * 0.2
				draw_arc(Vector2.ZERO, rr, a0, a0 + TAU / 14.0, 4, Color("#e8dcc4", 0.45), 2.2, true)
			draw_set_transform_matrix(_cam)
			draw_circle(gq, 2.4, Color(Art.team_color(gu.team, cbm()), 0.5), true, -1.0, true)
	if live:
		# V1.3 C3：戰報墨圈畫在最底層（腳底三層之下）
		for f in fx:
			if f["kind"] == "inkring":
				var ik: float = f["t"] / f["dur"]
				draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.5), 0, f["p"] + Vector2(0, 2)))   # 貼在地上（壓扁成橢圓）
				_hand_ring(Vector2.ZERO, (26.0 + ik * 8.0) * UNIT_SCALE, Color(0.12, 0.07, 0.04, 0.55 * (1.0 - ik)), 2.6, false, 1)
				draw_set_transform_matrix(_cam)
	for u in list:
		var p0: Vector2 = pc[u.id] if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
		var air0: float = Gait.air(u.type, _walk_of(u, a_now)) if live else 0.0
		var ar0 := clampf(air0 * 0.05, 0.0, 1.0)
		var bsc: float = UNIT_SCALE * (BossD.DRAW_SCALE if u.boss else 1.0)   # V1.4 #12 巨獸畫大
		_ring(p0, u.team, u.type, bsc, ar0 if ar0 > 0.15 else 0.0)   # 小跳步不分層（效能：合成格一次貼完；1.1.0 B14 族群底座部件也烘在合成格裡）   # V1.3 A3：木座和隊伍圈留在地上，只有影子跟著跳起縮
		if u.st > 0:
			_sticker_badge(p0, u.st, UNIT_SCALE, u.ward or u.st != 3)   # V1.4 #9：護符用掉就淡掉
		if u.shield > 0:       # 第十二輪：手動技能的護盾、戰吼
			_hand_ring(p0 + Vector2(0, -24) * UNIT_SCALE, 28.0 * UNIT_SCALE, Color(0.55, 0.85, 1.0, 0.75), 2.5)
		if u.haste_t > 0:
			_hand_ring(p0, 19.0 * UNIT_SCALE, Color(1.0, 0.75, 0.25, 0.85), 2.5)
		if u.id == int(gm[0]) or (int(gm[0]) == -2 and u.team == 0 and u.type == int(gm[2]) and not u.summon):
			_goal_marker(p0, "protect" if int(gm[0]) == -2 else str(gm[1]))   # 第十三輪：要護送／斬首的那一隻；V1.1：不能倒的那種兵每隻都標
			if u.team == 0 and u.hp * 100 <= u.max_hp * 30 and not rfx:
				# V1.6.1 A2：要保住的兵殘血時框閃紅（白黑雙邊，色盲也看得出）
				var fl := 0.55 + 0.45 * sin(time * 6.0)   # 約 1 Hz 呼吸（Antigravity v161-i1：原本約 2 Hz 太累）
				_hand_ring(p0 + Vector2(0, -20) * UNIT_SCALE, 31.0 * UNIT_SCALE, Color(0, 0, 0, 0.5 * fl), 4.0)
				_hand_ring(p0 + Vector2(0, -20) * UNIT_SCALE, 30.0 * UNIT_SCALE, Color(1.0, 0.25, 0.2, fl), 2.5)
		if live and s.rally[u.team] and not s.finished:
			for k in 2:
				var ph := fmod(time * 1.6 + k * 0.5, 1.0)
				_hand_ring(p0, (14.0 + ph * 10.0) * UNIT_SCALE, Color(1, 0.42, 0.0, 0.55 * (1.0 - ph)), 2.0)
	# 陣亡痕跡：倒下處的小旗，3 秒淡出，畫在最底層（第三輪 R5）
	if live:
		for g in graves:
			var ga: float = 1.0 - g["t"] / 3.0
			var gp: Vector2 = g["pos"]
			draw_line(gp + Vector2(0, 2), gp + Vector2(0, -16), Color(0.35, 0.27, 0.2, 0.8 * ga), 2.0, true)
			draw_colored_polygon(PackedVector2Array([gp + Vector2(0, -16), gp + Vector2(10, -12), gp + Vector2(0, -8)]), Color(Art.team_color(g["team"], cbm()), 0.75 * ga))
			draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.4), 0, gp + Vector2(0, 2)))   # 疊在鏡頭上（Codex S4 #5）
			draw_circle(Vector2.ZERO, 7, Color(0, 0, 0, 0.25 * ga), true, -1.0, true)
			draw_set_transform_matrix(_cam)
	# 擁擠度：40px 內有幾隻（第三輪 V5，只在戰鬥中算）
	var crowd := {}
	if live:
		# V1.3 P0-1：40px 格子分桶，只比相鄰 9 格（判定與雙迴圈相同：距離平方 < 1600）
		var bk := {}
		for u in list:
			var q: Vector2 = pc[u.id]
			var key := Vector2i(floori(q.x / 40.0), floori(q.y / 40.0))
			if bk.has(key):
				bk[key].append(q)
			else:
				bk[key] = [q]
		for u in list:
			var q: Vector2 = pc[u.id]
			var cx := floori(q.x / 40.0)
			var cy := floori(q.y / 40.0)
			var n := -1   # 自己一定在同一格，先扣掉
			for dx in range(-1, 2):
				for dy in range(-1, 2):
					var cell = bk.get(Vector2i(cx + dx, cy + dy))
					if cell == null:
						continue
					for o in cell:
						if q.distance_squared_to(o) < 1600.0:
							n += 1
			crowd[u.id] = n
	# 第二層：身體（V9：地圖的前景物件依腳點 y 插進來，才有前後遮擋）
	var prop_i := 0
	var xray: Array = []   # V1.1 C5：[腳點, 參數]，給被下排蓋到臉的那隻補畫半透明
	for u in list:
		var p: Vector2 = pc[u.id] if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
		while prop_i < fld_props.size() and ORIGIN.y + float(fld_props[prop_i][0]) <= p.y:
			MapArt.draw_prop(self, ORIGIN, fld_props[prop_i], time)
			prop_i += 1
		var walk: float = _walk_of(u, a_now) if live else ((time * Gait.nominal_rate(u.type, float(D.stat(u.type)["speed"]), CS, UNIT_SCALE) + u.id) if (u.mx != 0 or u.my != 0) else 0.0)
		var moving: bool = walk > 0.0
		var at := 0.0
		var variant := 0
		var hit_now := -1
		if live and atk_hit.has(u.id):
			var dt0 := _disp_tick()
			# V1.5：遠程的「出手」提早 fly 個 tick（飛行物離手），命中 tick 不變；動作照出手時間演
			var ph := proj_phase(atk_hit[u.id], dt0, u.type, view.delay, proj_tgt.get(u.id, {}))
			var hr: int = ph[0]
			var h: int = ph[1]
			var fly: int = h - hr if hr >= 0 else 0
			hit_now = h
			if h >= 0:
				at = atk_progress(dt0 - float(ph[3]), u.type, float(ph[4]))   # V1.5.1：這一發自己的動作起點與前搖
				if float(ph[2]) >= 0.0 and proj_tgt.get(u.id, {}).has(h):
					var pt = view.unit_by_id(proj_tgt[u.id][h])
					if pt != null:
						var pk: float = ph[2]
						var psg: float = signf(_upos(pt).x - _upos(u).x) if _upos(pt).x != _upos(u).x else (signf(u.fx) if u.fx != 0 else 1.0)
						proj_draw.append([u.type, u.team, _upos(u) + proj_launch(u.type, psg) * UNIT_SCALE, _upos(pt) + Vector2(0, -22 if u.type != D.BOMBER else -10), pk])
				# V1.5：舊的「前搖 2 tick 火罐飛行」拿掉：火罐前搖時在手上，出手後由上面的飛行物畫（手動軍令局沒有餘裕就直接落點爆炸）
				if u.type == D.SWORD:
					variant = int(atk_seq.get(u.id, {}).get(h, 0)) % 2   # 劍士橫斬與上挑逐擊交替（第三輪 R4）
				elif u.type >= D.CLASSIC and alt_hit.get(u.id, {}).has(h):
					variant = 2
		var hurt := 0.0
		if live and hurt_t.has(u.id) and _fx_on("flash"):
			hurt = clampf(1.0 - (time - hurt_t[u.id]) / 0.15, 0, 1) * int(Save.s("flash_pct")) / 100.0   # V1.5：受擊閃白強度
		var alpha := 0.45 if u.stealth > 0 else 1.0
		if dim:
			alpha *= 0.6
		if live:
			alpha *= _focus_dim(p)
		var face := signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
		# 受擊後退 4px（第三輪 R2）：0.08 秒退、0.07 秒回，只是畫面
		if live and hurt_t.has(u.id):
			var hk: float = (time - float(hurt_t[u.id])) / 0.15
			if hk >= 0.0 and hk < 1.0:
				p.x += float(hurt_dir.get(u.id, 0.0)) * 4.0 * (sin(hk * PI) if hk < 1.0 else 0.0)
		if live and u.id == follow_id:
			_hand_ring(p + Vector2(0, 2), 22.0, Color(ACCENT, 0.9), 3.0, true)   # 跟拍中的那隻
		# 擠在一起時，正在出手或受擊的那隻加隊伍色光圈（第三輪 V5）
		if live and (at > 0.0 or hurt > 0.0) and crowd.get(u.id, 0) >= 3:
