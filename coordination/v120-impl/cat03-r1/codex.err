   850	## 點擊：只對這個畫面世代畫出來的按鈕有效。回傳執行了幾個。
   851	## ── 1.2.0 §9.4 宣紙戰報（結果頁前 1.2 秒）──
   852	## 盤面 0.3 秒淡成宣紙 → 陣亡點蓋 8px 朱砂小印、擊倒者到被擊倒者一道淡墨線（40%、最底層）→ 0.55 秒勝負大章蓋下 → 1.0 秒後才出結果面板。
   853	## 點任意處／任何按鍵跳過；截圖、減少特效、重播與覆盤不播。
   854	const INK_DUR := 1.0
   855	func _ink_active() -> bool:
   856		return _ink_k() < INK_DUR and (shot_dir == "" or ink_force) and not bool(Save.s("reduce_fx")) and play_kind == "official" and not bool(Save.s("plain_ui"))
   857	
   858	var ink_force := false   # 截圖流程專拍宣紙戰報時用
   859	func _ink_k() -> float:
   860		return 0.8 if ink_force else time - result_t   # 截圖專拍時停在蓋章後的瞬間（截圖等幀的實際時間不固定）
   861	
   862	func _draw_ink_report_field() -> void:
   863		var k := _ink_k()
   864		var pa := clampf(k / 0.3, 0.0, 1.0) * 0.82
   865		var pt := _ui_tex(MAT["card2"])
   866		var fr := Rect2(ORIGIN, fld_size)
   867		if pt != null:
   868			draw_texture_rect(pt, fr, false, Color(1, 1, 1, pa))
   869		else:
   870			draw_rect(fr, Color(Color("#e8d8c3"), pa))
   871		if k < 0.25 or view == null:
   872			return
   873		var a2 := clampf((k - 0.25) / 0.25, 0.0, 1.0)
   874		for u in view.units:
   875			if u.alive:
   876				continue
   877			var vp := _upos(u)
   878			var kid: int = int(last_hitter.get(u.id, -1))
   879			var ku = view.unit_by_id(kid) if kid >= 0 else null
   880			if ku != null:
   881				draw_line(_upos(ku), vp, Color(Color("#261c14"), 0.4 * a2), 3.0, true)   # 交戰墨線（最底層、40%）
   882		for u2 in view.units:
   883			if not u2.alive:
   884				var c := _upos(u2)
   885				draw_rect(Rect2(c - Vector2(4, 4), Vector2(8, 8)), Color(Color("#9b281b"), 0.9 * a2))   # 朱砂小印
   886	
   887	func _draw_ink_report_screen() -> void:
   888		var k := _ink_k()
   889		if k < 0.55 or sim == null:
   890			return
   891		var win: bool = sim.winner == 0 or (mode == Mode.DUEL and sim.winner == 1)
   892		var drop := clampf((k - 0.55) / 0.12, 0.0, 1.0)
   893		var sc := lerpf(1.6, 1.0, drop)
   894		var c := Vector2(640, 380)
   895		var sz := 120.0 * sc
   896		var col := Color("#9b281b") if sim.winner >= 0 else Color("#5a4630")
   897		var txt: String = L.t("ink_draw") if sim.winner < 0 else (L.t("ink_win") if win else L.t("ink_lose"))
   898		draw_rect(Rect2(c - Vector2(sz, sz) * 0.5, Vector2(sz, sz)), Color(col, 0.18 * drop))
   899		draw_rect(Rect2(c - Vector2(sz, sz) * 0.5, Vector2(sz, sz)), Color(col, 0.95 * drop), false, 6.0 * sc)
   900		_text(c - Vector2(0, tz("T") * sc * 0.62), txt, int(tz("T") * sc), Color(col, drop), true, true)
   901		if drop >= 1.0 and not ink_stamped:
   902			ink_stamped = true
   903			if sfx != null:
   904				sfx.play("place_heavy", 1.0)   # 蓋章聲
   905	
