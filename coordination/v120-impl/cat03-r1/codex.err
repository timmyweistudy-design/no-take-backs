@@ -834,8 +848,68 @@ func _process_cmds() -> int:
 
 
 ## 點擊：只對這個畫面世代畫出來的按鈕有效。回傳執行了幾個。
+## ── 1.2.0 §9.4 宣紙戰報（結果頁前 1.2 秒）──
+## 盤面 0.3 秒淡成宣紙 → 陣亡點蓋 8px 朱砂小印、擊倒者到被擊倒者一道淡墨線（40%、最底層）→ 0.55 秒勝負大章蓋下 → 1.0 秒後才出結果面板。
+## 點任意處／任何按鍵跳過；截圖、減少特效、重播與覆盤不播。
+const INK_DUR := 1.0
+func _ink_active() -> bool:
+	return _ink_k() < INK_DUR and (shot_dir == "" or ink_force) and not bool(Save.s("reduce_fx")) and play_kind == "official" and not bool(Save.s("plain_ui"))
+
+var ink_force := false   # 截圖流程專拍宣紙戰報時用
+func _ink_k() -> float:
+	return 0.8 if ink_force else time - result_t   # 截圖專拍時停在蓋章後的瞬間（截圖等幀的實際時間不固定）
+
+func _draw_ink_report_field() -> void:
+	var k := _ink_k()
+	var pa := clampf(k / 0.3, 0.0, 1.0) * 0.82
+	var pt := _ui_tex(MAT["card2"])
+	var fr := Rect2(ORIGIN, fld_size)
+	if pt != null:
+		draw_texture_rect(pt, fr, false, Color(1, 1, 1, pa))
+	else:
+		draw_rect(fr, Color(Color("#e8d8c3"), pa))
+	if k < 0.25 or view == null:
+		return
+	var a2 := clampf((k - 0.25) / 0.25, 0.0, 1.0)
+	for u in view.units:
+		if u.alive:
+			continue
+		var vp := _upos(u)
+		var kid: int = int(last_hitter.get(u.id, -1))
+		var ku = view.unit_by_id(kid) if kid >= 0 else null
+		if ku != null:
+			draw_line(_upos(ku), vp, Color(Color("#261c14"), 0.4 * a2), 3.0, true)   # 交戰墨線（最底層、40%）
+	for u2 in view.units:
+		if not u2.alive:
+			var c := _upos(u2)
+			draw_rect(Rect2(c - Vector2(4, 4), Vector2(8, 8)), Color(Color("#9b281b"), 0.9 * a2))   # 朱砂小印
+
+func _draw_ink_report_screen() -> void:
+	var k := _ink_k()
+	if k < 0.55 or sim == null:
+		return
+	var win: bool = sim.winner == 0 or (mode == Mode.DUEL and sim.winner == 1)
+	var drop := clampf((k - 0.55) / 0.12, 0.0, 1.0)
+	var sc := lerpf(1.6, 1.0, drop)
+	var c := Vector2(640, 380)
+	var sz := 120.0 * sc
+	var col := Color("#9b281b") if sim.winner >= 0 else Color("#5a4630")
+	var txt: String = L.t("ink_draw") if sim.winner < 0 else (L.t("ink_win") if win else L.t("ink_lose"))
+	draw_rect(Rect2(c - Vector2(sz, sz) * 0.5, Vector2(sz, sz)), Color(col, 0.18 * drop))
+	draw_rect(Rect2(c - Vector2(sz, sz) * 0.5, Vector2(sz, sz)), Color(col, 0.95 * drop), false, 6.0 * sc)
+	_text(c - Vector2(0, tz("T") * sc * 0.62), txt, int(tz("T") * sc), Color(col, drop), true, true)
+	if drop >= 1.0 and not ink_stamped:
+		ink_stamped = true
+		if sfx != null:
+			sfx.play("place_heavy", 1.0)   # 蓋章聲
+
+var ink_stamped := false
+
 func _do_click(p: Vector2) -> int:
 	_toast_dismiss()
+	if state == St.RESULT and _ink_active():
+		result_t -= INK_DUR   # 1.2.0 §9.4：點任意處跳過宣紙戰報演出
+		return 1
 	if _btns_gen != _gen:
 		return 0
 	for i in _btns.size():
diff --git a/game/scripts/ui/layout_rules.gd b/game/scripts/ui/layout_rules.gd
index ecc7445..d2f98a4 100644
--- a/game/scripts/ui/layout_rules.gd
+++ b/game/scripts/ui/layout_rules.gd
@@ -94,6 +94,16 @@ static func check(d: Dictionary) -> Dictionary:
 			"bottom":
 				if absf(r.position.y - h.end.y) > TOL_ATTACH:
 					_add(out, "fail", "R3", dc["id"], "%s 上緣 %.1f 沒貼齊宿主下緣 %.1f" % [dc["kind"], r.position.y, h.end.y])
+			"left":
+				# 1.2.0：跨在宿主左緣的裝飾（主按鈕的蠟封）：中心在左緣 ±1/4 寬內、垂直中心在宿主內
+				if absf(r.get_center().x - h.position.x) > r.size.x * 0.25 or r.get_center().y < h.position.y or r.get_center().y > h.end.y:
+					_add(out, "fail", "R3", dc["id"], "%s 沒跨在宿主左緣" % dc["kind"])
+				continue
+			"inside":
+				# 1.2.0：宿主內的裝飾（布標縫線）：整個在宿主裡
+				if not h.grow(TOL_ATTACH).encloses(r):
+					_add(out, "fail", "R3", dc["id"], "%s 跑出宿主" % dc["kind"])
+				continue
 		if r.position.x < h.position.x - TOL_ATTACH or r.end.x > h.end.x + TOL_ATTACH:
 			_add(out, "fail", "R3", dc["id"], "%s 水平超出宿主" % dc["kind"])
