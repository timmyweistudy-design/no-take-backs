diff --git a/game/tests/suites/battle_visual.gd b/game/tests/suites/battle_visual.gd
index ebf956c..67833ab 100644
--- a/game/tests/suites/battle_visual.gd
+++ b/game/tests/suites/battle_visual.gd
@@ -526,3 +526,81 @@ func test_review_base_async_v120() -> void:
 	ok(g.rv_base_thread == null, "離開覆盤就叫停交給回收")
 	g.bg.drain()
 	g.free()
+
+## 1.2.0 第 3 大類：宣紙戰報什麼時候演、開場三段落子的分段、老闆便條看過就不再出現
+func test_present_v120() -> void:
+	var g = load("res://scripts/ui/game_screens.gd").new()
+	g.sfx = FakeSfx.new()
+	var Sv = load("res://scripts/game/save.gd")
+	var Ls = load("res://scripts/game/strings.gd")
+	var keep_fx = Sv.settings.get("reduce_fx", false)
+	var keep_plain = Sv.settings.get("plain_ui", false)
+	Sv.settings["reduce_fx"] = false
+	Sv.settings["plain_ui"] = false
+	g.shot_dir = ""
+	g.play_kind = "official"
+	g.time = 10.0
+	g.result_t = 9.5
+	ok(g._ink_active(), "正式對戰剛結束 0.5 秒：演宣紙戰報")
+	g.result_t = 8.9
+	ok(not g._ink_active(), "超過 1 秒就結束")
+	g.result_t = 9.5
+	g.play_kind = "replay"
+	ok(not g._ink_active(), "重播不演")
+	g.play_kind = "official"
+	Sv.settings["reduce_fx"] = true
+	ok(not g._ink_active(), "減少特效不演")
+	Sv.settings["reduce_fx"] = false
+	Sv.settings["plain_ui"] = true
+	ok(not g._ink_active(), "簡化介面不演")
+	Sv.settings["plain_ui"] = false
+	g.shot_dir = "x"
+	ok(not g._ink_active(), "截圖平常不演")
+	g.ink_force = true
+	ok(g._ink_active(), "截圖專拍時強制演")
+	g.ink_force = false
+	g.shot_dir = ""
+	# 開場三段落子：離中線近的先落、遠的後落；沒有開場提示時不動
+	g.fld_w = 600
+	g.start_hold = 0.0
+	ok(g._open_drop({"x": 300.0}) == Vector2.ZERO, "沒有開場提示：不位移")
+	g.start_hold = 0.8   # 進度 0.2：第一段落到一半，二、三段還在上面
+	var near: Vector2 = g._open_drop({"x": 320.0})
+	var far: Vector2 = g._open_drop({"x": 20.0})
+	ok(near.y > far.y and far.y <= -21.9, "前排先落（%s／%s）" % [near.y, far.y])
+	g.start_hold = 0.05
+	ok(g._open_drop({"x": 20.0}).y > -0.5, "最後一段在 1 秒內落定")
+	g.play_kind = "replay"
+	g.start_hold = 0.8
+	ok(g._open_drop({"x": 20.0}) == Vector2.ZERO, "重播不演")
+	# 老闆便條：知道了＝記進 seen，之後不再畫
+	var G = load("res://scripts/game/guide.gd")
+	var d := {"seen": []}
+	ok(G.is_new(d, "note_lobby"), "第一次是新的")
+	G.see(d, "note_lobby")
+	ok(not G.is_new(d, "note_lobby") and "note_lobby" in d["seen"], "按知道了之後記住")
+	var keep_seen = Sv.data.get("seen", null)
+	Sv.data["seen"] = []
+	g.overlay = ""
+	g._boss_note("place")
+	ok(g.overlay == "boss_note" and g.note_key == "place", "第一次擺陣：跳便條疊層")
+	var keep_lock = Sv.data_locked
+	Sv.data_locked = true   # 不寫真的存檔
+	g._close_boss_note()
+	Sv.data_locked = keep_lock
+	ok(g.overlay == "" and "note_place" in Sv.data["seen"], "知道了：關掉並記住")
+	g._boss_note("place")
+	ok(g.overlay == "", "看過就不再跳")
+	g.shot_dir = "x"
+	g._boss_note("result")
+	ok(g.overlay == "", "截圖流程不跳")
+	g.shot_dir = ""
+	if keep_seen == null:
+		Sv.data.erase("seen")
+	else:
+		Sv.data["seen"] = keep_seen
+	for k in ["bn_lobby", "bn_place", "bn_result", "bn_ok"]:
+		ok(Ls.t(k) != k, "字串存在：" + k)
+	Sv.settings["reduce_fx"] = keep_fx
+	Sv.settings["plain_ui"] = keep_plain
+	g.free()
diff --git a/game/tools/dev_main.gd b/game/tools/dev_main.gd
index efd409c..e28e2e3 100644
--- a/game/tools/dev_main.gd
+++ b/game/tools/dev_main.gd
@@ -529,7 +529,33 @@ func _would_clutch(a0, a1) -> bool:
 ## 1.2.0：每組截圖從乾淨存檔開始後，流程裡第一次達成的成就會跳提示蓋到畫面（原本共用存檔時早就解鎖過）→ 截圖照樣解鎖、不排提示
 func _ach(id: String) -> void:
 	super._ach(id)
-	ach_queue.clear()
+	if shot_dir != "":
+		ach_queue.clear()   # 只在截圖模式（Codex cat02：不影響其他開發模式）
+
+## 1.2.0 元件庫展示（只在截圖流程用）
+func _draw_kit_demo() -> void:
+	var P := modal_rect(900, 520)
+	_panel(P)
+	var y := _h1(Vector2(640, P.position.y + 12), "Kit") + GAP_L
+	var x0 := P.position.x + 40
+	mouse = Vector2(x0 + 230 + 80, y + 22)   # 第二顆＝懸停
+	_btn(Rect2(x0, y, 200, 44), L.t("back"), func(): pass)
+	_btn(Rect2(x0 + 230, y, 200, 44), L.t("back"), func(): pass)
+	_btn(Rect2(x0 + 460, y, 200, 44), L.t("back"), func(): pass)   # 焦點（_focus=2，手把狀態才畫）
+	_btn(Rect2(x0 + 690, y, 160, 44), L.t("back"), func(): pass, false)
+	y += 64
+	_btn(Rect2(x0, y, 300, 50), L.t("start"), func(): pass, true, true)
+	_btn(Rect2(x0 + 330, y, 300, 50), L.t("start"), func(): pass, false, true)
+	y += 70
+	for i in 3:
+		btn_cloth = ["tab_indigo", "tab_linen", "tab_madder"][i]
+		_btn(Rect2(x0 + i * 220, y, 200, 48), L.t("set_tab_%d" % i), func(): pass)
+		btn_cloth = ""
+	y += 70
+	call("_brass_toggle", Vector2(x0 + 20, y + 20), true)
+	call("_brass_toggle", Vector2(x0 + 80, y + 20), false)
+	call("_brass_toggle", Vector2(x0 + 140, y + 20), true, false)
+	mouse = Vector2(-100, -100)
 
 func _run_screenshots() -> void:
 	# 全套截圖要跑很久：視窗移到畫面外、不搶焦點，不打擾正在用電腦的人。
@@ -684,6 +710,17 @@ func _run_screenshots() -> void:
 	zoom = 1.0
 	_finish_battle()
 	await _snap("05_result.png")
+	note_key = "result"   # 1.2.0 §12 老闆便條（截圖平常不跳，這張專拍）
+	overlay = "boss_note"
+	await _snap("v120_02_note.png")
+	overlay = ""
+	# 1.2.0 §9.4 宣紙戰報（截圖平常跳過演出；這一張強制拍蓋章後的瞬間）
+	ink_force = true
+	result_t = time - 0.8
+	ink_stamped = true
+	await _snap("v120_01_ink.png")
+	ink_force = false
+	result_t = time - 5.0
 	result_tab = 1
 	await _snap("05b_result_details.png")
 	if pc_shot != null:   # V1.4 #14 戰報明信片
@@ -827,6 +864,11 @@ func _run_screenshots() -> void:
 	_breport_open()   # 1.1.0 B10：手把重播戰報面板
