func _lobby_unlocked() -> int:
	return RS.mask(_demo())

func _lobby_std():
	return Presets.make("standard", lobby_kind, _lobby_unlocked())

## 打開大廳：沿用上次在這個模式用的規則（存檔裡的規則代碼）；沒有或不合法就用標準。
func _open_lobby(kind: String) -> void:
	lobby_kind = kind
	var code := str(Save.data.get("last_rules", {}).get(kind, ""))
	var r = null
	if code != "":
		var d: Dictionary = RuleSet.from_code(code)
		if d["ok"]:
			r = d["rules"]
			r.preset = str(Save.data.get("last_rules", {}).get(kind + "_preset", "custom"))
			if r.preset == "standard":
				r.pool = Presets.make("standard", kind, _lobby_unlocked()).pool.duplicate()   # 舊存檔的標準可能只存到解鎖的幾種
			var ex = Save.data.get("last_rules", {}).get(kind + "_extra", [])
			if ex is Array and ex.size() >= 3:
				if ex.size() >= 4:
					r.time_of = clampi(int(ex[3]), 0, 2)
				r.ai_style = clampi(int(ex[0]), 0, RuleSet.AI_STYLES - 1)
				r.map_mode = clampi(int(ex[1]), 0, 2)
				r.bans = clampi(int(ex[2]), 0, 2)
	if r == null:
		r = Presets.make("standard", kind, _lobby_unlocked())
		# 第四輪的舊設定當作第一次打開大廳的初始值（Codex 第一輪）
		if str(Save.s("roster")) == "classic":
			r.pool = [31, 31]
		if kind == "duel":
			r.place_rule = str(Save.s("duel_rule")) if str(Save.s("duel_rule")) in RuleSet.PLACE_RULES else "snake5"
	lobby_r = r
	# 存過的規則照原樣保留（Codex 實作第 3 輪：重開雙人大廳不能把兩邊不同的卡池改成一樣）；含未解鎖兵由開戰鈕擋
	lobby_open = false
	lobby_menu = false
# ── 覆蓋層 ──
func _draw_overlay() -> void:
	if overlay != "":
		_btns.clear()   # 覆蓋層底下畫面的按鈕不能被點到（例如擺放畫面的開戰、結果頁的按鈕）
		probe_texts.clear()   # 第五輪：底下畫面的字被遮罩蓋住，版面檢查只量覆蓋層本身
		probe_btns.clear()
		probe_ctrls.clear()
		probe_reset_geom()
		if state == St.TITLE:
			_dim(0.72)   # 第七輪：標題的示範戰場不透出來
	match overlay:
		"trials":
			_draw_trials()
		"puzzle_hint":
			_draw_puzzle_hint()
		"puzzle_plan":
			_draw_plan_overlay()
	elif fp_erasing and Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT):
		_fp_erase_at(w)

## 鍵盤：回傳 true＝處理掉了。
func _fp_key(k: int) -> bool:
	if not _is_free() or overlay != "":
		return false
	match k:
		KEY_ENTER, KEY_KP_ENTER:
			if fp_stroking or fp_drag >= 0 or fp_box:
				return true   # 拖曳中按 Enter 不做事，免得蓋掉這一筆（Codex 實作第 2 輪新問題 1）
			# 自由模式：在鍵盤／手把游標處放一隻（格子查找不能用，Codex 實作第 1 輪 #9）
			var at: Vector2i = Vector2i(fp_cur) if (pad_mode or not _fp_in_field(mouse)) else _w_of(mouse)
			_fs_begin(at)
			_fs_commit()
			return true
		KEY_ESCAPE:
			if fp_stroking:
				_fs_cancel()
				return true
			if not fp_sel.is_empty():
				fp_sel = []
				return true
		KEY_DELETE:
			_fp_delete_sel()
			return true
		KEY_M:
			_fp_flip_sel()
			return true
		KEY_Z:
			if Input.is_key_pressed(KEY_CTRL):
				_fp_undo_do(false)
				return true
		KEY_Y:
			if Input.is_key_pressed(KEY_CTRL):
				_fp_undo_do(true)
				return true
	return false

# ───────── 手把 ─────────
func _fp_pad_process(delta: float, stick: Vector2) -> void:
func _toggle_pause() -> void:
	paused = not paused
	if not paused and play_kind == "official":
		follow_id = -1


## 進重播前存結算畫面（第七輪 A9）。
func _replay_snapshot() -> void:
	if play_kind != "official" and not replay_snap.is_empty():
		return   # Codex r2：重播完再重播，返回目的地還是最早那個結算
	replay_snap = {"sim": sim, "view": view, "report": report, "marks": battle_marks.duplicate(true), "kind": play_kind,
		"tab": result_tab, "overlay": "", "ev_count": ev_count.duplicate(), "pt_rated": pt_rated, "pt_call": pt_call_tick}

## 重播的「返回」：回到進來的地方。只還原畫面，比分、進度、成就、試玩紀錄都不寫。
func _replay_back() -> void:
	tm_ghost = null   # V1.4 #1：回到結果頁，原本時間線的淡圈不能留下
	call("_pre_drop")
	seek_target = -1   # Codex r1：算到一半返回，不能把下一場快轉到舊目標
	skip_busy = false
	paused = false
	follow_id = -1
	zoom = 1.0
	zoom_target = 1.0
	fx.clear()
	dying.clear()
	report_log.clear()
	sfx.set_muffled(false)
	if watch_mode or replay_snap.is_empty():
		call("_go_title")
		return
	sim = replay_snap["sim"]
	view = replay_snap["view"]
	report = replay_snap["report"]
	battle_marks = replay_snap["marks"]
	play_kind = replay_snap["kind"]
	result_tab = replay_snap["tab"]
	ev_count = replay_snap["ev_count"]   # Codex r1：戰報、評分狀態也要還原，不然同一局能再評一次
	pt_rated = replay_snap["pt_rated"]
	pt_call_tick = replay_snap["pt_call"]
	overlay = replay_snap["overlay"]
	result_delay = 0.0
	state = St.RESULT
	replay_snap = {}


## 從關鍵時刻開始重播（第七輪 A7）。
func _replay_from(t: int) -> void:
	call("_replay")
	_seek_async(t)


func _follow_update(delta: float) -> void:
	if play_kind == "official":
		return
	if follow_id < 0 or view == null or state != St.BATTLE:
		return
	var u = view.unit_by_id(follow_id)
	if u == null or not u.alive:
