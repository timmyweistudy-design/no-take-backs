   145			bg = []
   146			for k in 24:
   147				var a := k * TAU / 24.0
   148				var pp := r.get_center() + Vector2(cos(a) * (r.size.x / 2.0 + 3.0), sin(a) * (r.size.y / 2.0 + 3.0))
   149				var px := clampi(int(pp.x * sx), 0, img.get_width() - 1)
   150				var py := clampi(int(pp.y * sy), 0, img.get_height() - 1)
   151				var p2 := img.get_pixel(px, py)
   152				if absf(p2.r - c.r) + absf(p2.g - c.g) + absf(p2.b - c.b) > 0.30:
   153					bg.append(p2)
   154			if bg.size() < 8:
   155				return null
   156		# 反鋸齒的邊緣像素是字色和背景的混色，不是背景：先用中位數估主背景，排除落在混色線上的像素
   157		var tmp := bg.duplicate()
   158		tmp.sort_custom(func(a, b): return rel_lum(a) < rel_lum(b))
   159		var med: Color = tmp[tmp.size() / 2]
   160		var segs: Array = [[c, med]]
   161		if oc.a > 0.0:
   162			segs.append([oc, med])
   163			segs.append([c, oc])
   164		var keep: Array = []
   165		for p in bg:
   166			var on_blend := false
   167			for sg in segs:
   168				if seg_dist(p, sg[0], sg[1]) < 0.06:
   169					on_blend = true
   170					break
   171			if not on_blend or seg_dist(p, med, med) < 0.06:
   172				keep.append(p)
   173		if keep.size() >= 6:
   174			bg = keep
   175		# 取「最接近字色亮度」那一側的 20% 分位：紙紋、木紋上局部低對比的地方也算進去（Codex v121-impl1：中位數會漏）
   176		var lt := rel_lum(c)
   177		bg.sort_custom(func(a, b): return absf(rel_lum(a) - lt) < absf(rel_lum(b) - lt))
   178		return bg[int(bg.size() * 0.2)]
   179	
   180	## 顏色 p 到線段 a–b（RGB 空間）的距離：判斷是不是兩色的混色（反鋸齒）。
   181	static func seg_dist(p: Color, a: Color, b: Color) -> float:
   182		var pv := Vector3(p.r, p.g, p.b)
   183		var av := Vector3(a.r, a.g, a.b)
   184		var bv := Vector3(b.r, b.g, b.b)
   185		var ab := bv - av
   186		var t := 0.0 if ab.length_squared() < 1e-6 else clampf((pv - av).dot(ab) / ab.length_squared(), 0.0, 1.0)
   187		return pv.distance_to(av + ab * t)
   188	
   189	## 一段字是否算大字（WCAG：24px 以上，或粗體 18.66px 以上；以 1280×800 顯示尺寸算）。
   190	static func large_text(size: int, bold: bool) -> bool:
   191		return size >= 24 or (bold and size >= 19)
   192	
   193	## F5：截圖上的文字對比。有足夠描邊的字比「字對描邊」，其他比「字對背景」（半透明字先疊在背景上）。
   194	func _contrast_issues(img: Image) -> Dictionary:
   195		var bad: Array = []
   196		var warn: Array = []
   197		if img == null:
   198			return {"bad": bad, "warn": warn}
   199		var sx := img.get_width() / 1280.0
   200		var sy := img.get_height() / 800.0
   201		for t in probe_texts:
   202			if t.get("field", false) or not t.has("c") or t.get("glyph", false):
   203				continue
   204			var c: Color = t["c"]
   205			var oc: Color = t["oc"]
   206			var size := int(t["size"])
   207			var need := 3.0 if large_text(size, bool(t.get("bold", false))) else 4.5
   208			var outlined: bool = oc.a >= 0.6 and float(t["ow"]) >= float(text_outline_w(size)) * 0.9
   209			var bgc = text_bg(img, t["r"], c, oc, sx, sy)
   210			var dis: bool = bool(t.get("dis", false))
   211			if bgc == null:
   212				(warn if dis else bad).append({"type": "背景未知", "s": t["s"]})   # 背景不可靠一律不算通過
   213				continue
   214			var over := func(fg: Color, bk: Color) -> Color: return Color(fg.r * fg.a + bk.r * (1.0 - fg.a), fg.g * fg.a + bk.g * (1.0 - fg.a), fg.b * fg.a + bk.b * (1.0 - fg.a))
   215			var ceff: Color = over.call(c, bgc)
   216			var ratio := contrast(ceff, bgc)
   217			if outlined:
   218				# 描邊字：描邊先疊在背景上、字再疊在描邊上；取「字對描邊」「字對背景」較好的（裁決 R8）
   219				var oeff: Color = over.call(oc, bgc)
   220				ratio = maxf(ratio, contrast(over.call(c, oeff), oeff))
   221			if ratio >= need:
   222				continue
   223			var item := {"type": "對比不足", "s": t["s"], "ratio": snappedf(ratio, 0.01), "need": need}
   224			if dis:
   225				warn.append(item)   # 只有登記為停用的元件另報（WCAG 豁免停用元件）
   226			else:
   227				bad.append(item)
   228		return {"bad": bad, "warn": warn}
   229	
   230	func _layout_report(name: String, img: Image = null) -> void:
   231		var bad: Array = []
   232		var cres := _contrast_issues(img)
   233		bad.append_array(cres["bad"])
   234		for mp in probe_missing:
   235			bad.append({"type": "缺圖", "s": mp})   # V1.2.1：材質缺檔不能默默退回平塗
   236		for b in _btns:     # 第十輪 T5：按鈕不能跑出畫面（手把焦點會走到看不見的地方）
   237			if not Rect2(0, 0, 1280, 800).encloses(b["r"]):
   238				bad.append({"type": "按鈕超出畫面", "s": name, "r": str(b["r"])})
   239		var sizes: Array = []
   240		var ui_n := 0
   241		var free_n := 0
   242		var ctrls: Array = probe_btns + probe_ctrls
   243		for t in probe_texts:
   244			var r: Rect2 = t["r"]
   245			var sz := int(t["size"])
   246			if t.get("field", false):
   247				if sz < 14:
   248					bad.append({"type": "戰場字太小", "s": t["s"], "size": sz})
   249				if r.position.x < -2 or r.end.x > 1282 or r.position.y < -2 or r.end.y > 802:
   250					bad.append({"type": "戰場字越界", "s": t["s"], "r": str(r)})
   251				continue
   252			ui_n += 1
   253			sizes.append(sz)
   254			var in_ctrl: bool = t.get("btn", false)
   255			for c in probe_ctrls:
   256				if c.grow(1.0).encloses(r):
   257					in_ctrl = true   # 整段字都在卡片／空白標籤按鈕裡＝控制項內容
   258					break
   259			if not in_ctrl:
   260				free_n += 1
   261			if r.position.x < -2 or r.end.x > 1282 or r.position.y < -2 or r.end.y > 802:
   262				bad.append({"type": "越界", "s": t["s"], "r": str(r)})
   263			if sz < tz("C") and not t.get("glyph", false):
   264				bad.append({"type": "小於字級表下限", "s": t["s"], "size": sz})
   265			if not size_ok(sz) and not t.get("glyph", false):
   266				bad.append({"type": "表外字級", "s": t["s"], "size": sz})
   267		for a in probe_texts.size():
   268			if probe_texts[a].get("field", false):
   269				continue
   270			for b in range(a + 1, probe_texts.size()):
   271				if probe_texts[b].get("field", false):
   272					continue
   273				var ra: Rect2 = probe_texts[a]["r"]
   274				var rb: Rect2 = probe_texts[b]["r"]
   275				var x := ra.intersection(rb)
   276				if not x.has_area():
   277					continue
   278				var ratio := x.get_area() / maxf(1.0, minf(ra.get_area(), rb.get_area()))
   279				if ratio <= 0.15:
   280					continue
   281				if probe_texts[a]["s"] != probe_texts[b]["s"]:
   282					bad.append({"type": "重疊", "a": probe_texts[a]["s"], "b": probe_texts[b]["s"], "ratio": snappedf(ratio, 0.01)})
   283				elif ra.position.distance_to(rb.position) > 2.0:
   284					bad.append({"type": "相同字串重疊", "s": probe_texts[a]["s"], "ratio": snappedf(ratio, 0.01)})
   285		# V1.2.1 F1：字要完整在九宮格的內容區裡（材質登記的實際斜邊內距）；只看包住字中心的最上層方塊，按鈕標籤也算
   286		for t in probe_texts:
   287			if t.get("field", false) or t.get("glyph", false):
   288				continue
   289			var tr2: Rect2 = t.get("gr", t["r"])   # 字形框
   290			var cc := tr2.get_center()
   291			var best = null
   292			for bx in probe_boxes:
   293				if bx["inner"].has_point(cc):
   294					best = bx   # 最上層（最後畫）的方塊：疊在別的面板上的視窗算自己的框
   295			if best != null and not best["inner"].grow(0.5).encloses(tr2):
   296				bad.append({"type": "字壓到九宮格邊", "s": t["s"], "box": str(best["r"])})
   297		# 第七輪 I3：按鈕框互撞（重疊但不是一個包住另一個）
   298		for bi in probe_btns.size():
   299			for bj in range(bi + 1, probe_btns.size()):
   300				var r1: Rect2 = probe_btns[bi]
   301				var r2: Rect2 = probe_btns[bj]
   302				var inter := r1.intersection(r2)
   303				if inter.get_area() > 6.0 and not r1.encloses(r2) and not r2.encloses(r1):
   304					bad.append({"type": "按鈕互撞", "a": str(r1), "b": str(r2)})
   305		for r in probe_btns:
   306			if r.size.x < 36.0 or r.size.y < 36.0:   # 方案 §5.3：點擊框 ≥36px
   307				bad.append({"type": "點擊框太小", "r": str(r)})
   308		# 第五輪（Antigravity 實作第 1 輪抓到自動檢查漏的）：按鈕外的文字壓到按鈕上
   309		for t in probe_texts:
   310			if t.get("field", false):
   311				continue
   312			var tr: Rect2 = t["r"]
   313			if t.get("btn", false):
   314				# 按鈕標籤：只豁免它自己的按鈕；要完整落在自己的框內，也不能壓到別顆按鈕（Codex 實作第 2 輪）
   315				var own: Rect2 = t.get("own", Rect2())
   316				if own.has_area() and not own.grow(2.0).encloses(tr):
   317					bad.append({"type": "按鈕標籤超出按鈕", "s": t["s"], "btn": str(own)})
   318				for br2 in probe_btns:
   319					if br2 == own:
   320						continue
   321					var x3 := tr.intersection(br2)
   322					if x3.has_area() and x3.get_area() > tr.get_area() * 0.10:
   323						bad.append({"type": "按鈕標籤壓到別的按鈕", "s": t["s"], "btn": str(br2)})
   324						break
   325				continue
   326			var inside := false
   327			for c in probe_ctrls:
   328				if c.grow(1.0).encloses(tr):
   329					inside = true
   330					break
   220			music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * single_cur * fade_in * (0.45 if duck_t > 0.0 else 1.0)))
   221	
   222	## V9：地圖環境音；空字串＝停。
   223	var amb_owner := 0   # V1.2.1：每次換環境音加一；設定試聽的計時器只在自己還是擁有者時才關（Codex v121-impl1）
   224	
   225	func play_ambience(name: String) -> void:
   226		if name == amb_name:
   227			return
   228		amb_owner += 1
   229		amb_name = name
   230		if name == "":
   231			amb.stop()
   232			return
   233		var st = load("res://audio/amb_%s.wav" % name)
   234		if st == null:
   235			amb.stop()
   236			return
   237		amb.stream = st
   238		amb.volume_db = linear_to_db(maxf(0.0001, amb_vol * 0.22))
   239		amb.play()
   240	
   241	func duck(sec: float) -> void:
   242		duck_t = maxf(duck_t, sec)
   243	
   244	func play_music(name: String) -> void:
   245		# V1.2 E：戰鬥曲是錄音單軌（music_battle.ogg）
   246		var src := name
   247		var pitch := 1.0
   248		if name == "music_frenzy":
   249			src = "music_battle"     # 狂熱：同一首加快一點，不換成合成音
   250			pitch = 1.08
   251		if name == music_name:
   252			return
   253		if src == "music_battle" and (music_name == "music_battle" or music_name == "music_frenzy") and music.playing:
   254			music_name = name     # 狂熱與一般戰鬥是同一首：只改音高、不從頭播（Codex v120-impl2）
   255			music.pitch_scale = pitch
   256			return
   257		# V1.2 E4：換曲交叉淡入淡出（上一首交給 music_old 淡出）
   258		if music.playing and music.stream != null:
   259			music_old.stream = music.stream
   260			music_old.pitch_scale = music.pitch_scale
