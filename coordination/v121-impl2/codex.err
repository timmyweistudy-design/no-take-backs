     5	## 第十輪 B10：玩家按離開。系列打到一半或遠征途中，先確認（自動導頁直接呼叫 _go_title，不跳確認）。
     6	func _leave_at_risk() -> bool:
     7		if state == St.TITLE or watch_mode:
     8			return false
     9		if mode == Mode.GAUNTLET:
    10			if state == St.RESULT and sim != null:
    11				return sim.winner == 0 and gauntlet_stage < 7
    12			return gauntlet_stage > 1
    13		if mode == Mode.VS_AI or mode == Mode.DUEL:
    14			return wins[0] + wins[1] > 0 and not series_over
    15		return false
    16	
    17	func _request_leave() -> void:
    18		if _leave_at_risk():
    19			overlay = "leave"
    20			_focus = 0
    21		else:
    22			_go_title()
    23	
    24	func _leave_confirm() -> void:
    25		overlay = ""
    26		_go_title()
