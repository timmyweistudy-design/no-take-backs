   501	func _text(p: Vector2, s: String, size: int, c: Color, center := false, bold := false, maxw := 0.0, outline := Color(0, 0, 0, -1)) -> void:
   502		if _ink_mode:
   503			c = _ink(c)
   504		elif outline.a < 0.0 and not (size >= 24 or (bold and size >= 19)) and c.s >= 0.25 and not (c.get_luminance() < 0.35 and c.s < 0.8):   # 深色低彩度的浮雕字不動
   505			c = Color(_legible(Color(c, 1.0)), c.a)   # V1.2.1 F5：深描邊上的彩色小字自動提亮到 4.5:1
   506		if maxw > 0.0:
   507			size = fit(s, size, maxw, bold)
   508		var lines := wrap_lines(s, size, maxw, bold) if maxw > 0.0 else s.split("\n")
   509		for i in lines.size():
   510			var fnt := _font_for(lines[i], size, bold)
   511			var w := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x if center else 0.0
   512			var q := p + Vector2(-w / 2, i * size * line_h(lines.size()) + size * 0.85)
   513			var oc := Color(INK, c.a * 0.85) if outline.a < 0.0 else outline
   514			# V1.2：深色、低彩度的「墨色字」（印在紙或布條上）不描深邊，改淺色浮雕；先決定樣式再登記探針（Codex v120-impl2）
   515			var emboss := outline.a < 0.0 and (_ink_mode or (c.get_luminance() < 0.35 and c.s < 0.8))
   516			if emboss:
   517				oc = Color(0, 0, 0, 0)
   518			var ow := text_outline_w(size)
   519			var sh := text_shadow_dy(size)
   520			# 版面探針（第五輪補洞）：介面層與戰場層都量、低透明度（>0.05）也量；戰場字標 field
   521			# V1.2 A3：外框算進描邊外擴（左右上各半個描邊、下方再加陰影位移），換字與換框才不會靜靜爆框
   522			if layout_probe and c.a > 0.05 and lines[i].strip_edges() != "":
   523				var ww := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
   524				var ex := ow * 0.5 if oc.a > 0.0 else 0.0
   525				# 直向：原本的框（1.1 倍字高）已經留了上下各約 0.05 字高的空，描邊與陰影只算超出的部分
   526				var ey := maxf(0.0, ex - size * 0.05)
   527				var eb := maxf(0.0, ey + (sh if oc.a > 0.0 else 0.0) - size * 0.05)
   528				probe_texts.append({"r": Rect2(q.x - ex, q.y - size * 0.85 - ey, ww + ex * 2.0, size * 1.1 + ey + eb), "size": size, "s": lines[i], "field": not _probe_ui, "a": c.a, "btn": _probe_btn_label, "own": _probe_btn_rect,
   529					"c": c, "oc": oc, "ow": ow if oc.a > 0.0 else 0.0, "bold": bold, "glyph": _probe_glyph, "dis": _probe_dis,
   530					"gr": Rect2(q.x, q.y - size * 0.80, ww, size * 0.98)})   # V1.2.1：字形框（不含描邊外擴、陰影與行距），九宮格內距用   # V1.2.1 F5：對比檢查要實際字色與描邊
   531			if emboss:
   532				draw_string(fnt, q + Vector2(0, 1), lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, Color(1.0, 0.96, 0.86, 0.45 * c.a))
   533			if oc.a > 0.0:
   534				# V1.2 A3：先畫柔和的下方陰影，再畫深焦茶描邊（取代純黑），最後正文
   535				draw_string_outline(fnt, q + Vector2(0, sh), lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, ow, Color(INK_SHADOW, oc.a * 0.55))
   536				draw_string_outline(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, ow, oc)
   537			draw_string(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, c)
   538	
   539	
   540	## V1.2 A3：描邊依字級減薄（小字描太粗會糊）、陰影位移依字級（純函式，測試與探針共用）。
   585		if c.s < 0.25:
   586			return Color(INK, a)
   587		return Color(c.darkened(0.74), a)
   588	
   589	func _btn(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
   590		if layout_probe and get("shot_dir") != "" and (get("shot_state") as Dictionary).has("dis"):
   591			enabled = false   # V1.2.1：版面檢查的「停用」狀態：全部按鈕畫成停用，檢查停用樣式（手把流程不受影響）
   592		var idx := _btns.size()
   593		_btns.append({"r": r, "cb": action, "en": enabled, "snd": "k_confirm" if primary else ("k_back" if label == L.t("back") or label == L.t("menu") else "k_click")})
   594		var hover := r.has_point(mouse) and not pad_mode
   595		var focus := pad_mode and idx == _focus
   596		var bg := TH_WOOD_L if not primary else TH_PRIMARY
   597		if tint.a > 0:
   598			bg = tint
   599		if not enabled:
   600			bg = Color(0.2, 0.17, 0.15)
   601		elif hover or focus:
   602			bg = bg.lightened(0.16)
   603			if hover:
   604				_hover_now = idx
   605		var pressed := hover and enabled and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
   606		var rd := r.grow(-minf(r.size.x, r.size.y) * 0.025) if pressed else r
   607		# V1.2 B3：按鈕下緣 3px 厚度（木牌的側面）；按下時往下沉、厚度消失
   608		var solid: bool = tint.a <= 0.0 or tint.a > 0.6
   609		if solid and r.size.y >= 20.0:
   610			# 厚度畫在按鈕框內（下緣 3px），命中框、探針與畫面一致（Codex v120-impl2）；按下時面板往下壓、厚度被蓋住
   611			_box(Rect2(rd.position, rd.size), Color(bg.darkened(0.55), 1.0), Color(0, 0, 0, 0), 7.0)
   612			rd = Rect2(rd.position + Vector2(0, 3.0 if pressed else 0.0), rd.size - Vector2(0, 3))
   613		var paper_face := btn_paper and enabled and not bool(Save.s("plain_ui"))
   614		last_btn_paper = paper_face
   615		if paper_face:
   616			# V1.2.1 R1：紙面卡片（例如已過關的殘局）；懸停時紙變亮
   617			_tex_box(rd, "paper", Color(1.12, 1.1, 1.04) if (hover or focus) else Color.WHITE)
   618			_box(rd, Color(0, 0, 0, 0), TH_EDGE.darkened(0.25), 7.0, 1.5)
   619		else:
   620			_box(rd, bg, TH_EDGE.darkened(0.25) if solid else Color(0, 0, 0, 0), 7.0, 1.5)
   621		if (tint.a <= 0.0 or tint.a > 0.6) and not paper_face:
   622			draw_line(rd.position + Vector2(6, 1.5), rd.position + Vector2(rd.size.x - 6, 1.5), Color(1, 1, 1, 0.16), 1.5)
   623			draw_line(rd.position + Vector2(6, rd.size.y - 1.5), rd.end - Vector2(6, 1.5), Color(0, 0, 0, 0.3), 2.0)
   624		if pressed:
   625			for k in 3:   # V1.2.1 R2：按下時上緣內陰影（像被壓進去）
   626				draw_rect(Rect2(rd.position + Vector2(3, 2 + k * 2.0), Vector2(rd.size.x - 6, 2.0)), Color(0, 0, 0, 0.22 - k * 0.07))
   627		if primary and enabled:
   628			_btn_shine(rd)
   629		if (focus or hover) and enabled and not plain_ui_now():
   630			# V1.2.1 R2：滑鼠懸停與手把焦點同一種樣式：深邊＋金亮邊（深邊讓金框在紙上也看得到，Codex v121-r2）
   631			_box(rd.grow(2.5), Color(0, 0, 0, 0), Color(INK, 0.7), 9.0, 1.5)
   632			_box(rd.grow(1), Color(0, 0, 0, 0), Color(ACCENT, 0.95 if focus else 0.75), 8.0, 2.5)
   633		elif focus:
   634			_box(rd.grow(1), Color(0, 0, 0, 0), ACCENT, 8.0, 3.0)
   635		if layout_probe:
   636			probe_btns.append(r)
   637			if label == "":
   638				probe_ctrls.append(r)   # 空白標籤的按鈕（卡片、頁籤）：裡面自己畫的字算按鈕內容
   639		var sz := fit(label, ts(18) if r.size.y >= 40 else ts(15), r.size.x - 10, primary)
   640		var lines := wrap_lines(label, sz, r.size.x - 10, primary)
   641		var h := lines.size() * sz * line_h(lines.size())
   642		_probe_btn_label = true   # 版面檢查：這段是按鈕自己的標籤（不用位置猜，Antigravity 實作第 2 輪抓到猜錯的情況）
   643		_probe_btn_rect = r
   644		_probe_dis = not enabled
   645		var ink0 := _ink_mode   # 按鈕是木頭，字維持白色（紙面按鈕用墨色）
   646		_ink_mode = paper_face
   647		_text(rd.get_center() - Vector2(0, h / 2 - sz * 0.03), "\n".join(lines), sz, Color.WHITE if enabled else Color(1, 1, 1, 0.4), true, primary)   # V1.2.1：對按鈕面置中（扣掉下緣厚度），按下時字跟著下沉
   648		_ink_mode = ink0
   649		_probe_btn_label = false
   650		_probe_dis = false
   651	
   652	static func plain_ui_now() -> bool:
   653		return bool(Save.s("plain_ui"))
   654	
   655	## 主按鈕的流光（可關）。
   704				sb.set_texture_margin(side, 22.0)
   705			sb.draw_center = false
   706			_sb_cache[key] = sb
   707		draw_style_box(sb, r.grow(grow))
   708	
   709	## 材質方塊：kind＝wood（染色）／groove（染色）／paper（原色）。沒有貼圖時退回平塗。
   710	func _tex_box(r: Rect2, kind: String, tint := Color.WHITE) -> bool:
   711		var path: String = {"wood": TEX_WOOD, "groove": TEX_GROOVE, "paper": TEX_PAPER}[kind]
   712		var tx := _ui_tex(path)
   713		if tx == null:
   714			return false
   715		tint = qcol(tint)   # V1.2.1 F1：量化後當鍵，淡出時不會每幀多一個樣式
   716		var k := "t|%s|%s" % [kind, tint.to_html()]
   717		var sb: StyleBoxTexture = _sb_cache.get(k)
   718		if sb == null:
   719			_sb_room()
   720			sb = StyleBoxTexture.new()
   721			sb.texture = tx
   722			var m := 10.0 if kind != "paper" else 14.0
   723			sb.texture_margin_left = m
   724			sb.texture_margin_right = m
   725			sb.texture_margin_top = m
   726			sb.texture_margin_bottom = m
   727			# 羊皮紙整張拉伸（紋理不能無縫平鋪，平鋪會出現直條接縫）；木紋、凹槽平鋪保持紋理比例
   728			var mode := StyleBoxTexture.AXIS_STRETCH_MODE_STRETCH if kind == "paper" else StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
   729			sb.axis_stretch_horizontal = mode
   730			sb.axis_stretch_vertical = mode
   731			sb.modulate_color = tint
   732			_sb_cache[k] = sb
   733		draw_style_box(sb, r)
   734		if layout_probe and minf(r.size.x, r.size.y) >= 20.0:
   735			# V1.2.1 F1：登記材質的內容內距（gen_ui_tex.py 的實際斜邊：木紋上 3／下 4／左右 3，紙 5，凹槽 3），字不能壓進去
   736			var ins: Array = {"wood": [3.0, 3.0, 3.0, 4.0], "paper": [5.0, 5.0, 5.0, 5.0], "groove": [3.0, 3.0, 3.0, 3.0]}[kind]
   737			probe_boxes.append({"r": r, "inner": r.grow_individual(-ins[0], -ins[1], -ins[2], -ins[3])})
   738		return true
   739	
    34	
    35	## 中線對比長條：rows＝[{label, b, r}]；兵種名在中間，藍往左、紅往右，數字標在條尾。
    36	static func diverging(ui, rect: Rect2, rows: Array, mid_w := 110.0) -> void:
    37		var cb: bool = ui.cbm()
    38		var maxv := 1
    39		for row in rows:
    40			maxv = maxi(maxv, maxi(int(row["b"]), int(row["r"])))
    41		var n := maxi(1, rows.size())
    42		var rh := rect.size.y / n
    43		# V1.2.1：中間兵種名欄依最長的名字算寬（英文 150% 的 Shieldbearer 原本被長條和數字蓋住）
    44		for row in rows:
    45			mid_w = maxf(mid_w, ui._width(str(row["label"]), ui.tz("S")) + (40.0 if row.has("type") else 16.0))
    46		mid_w = minf(mid_w, rect.size.x * 0.4)
    47		var half := (rect.size.x - mid_w) / 2.0
    48		var cx := rect.position.x + half
    49		var fs: int = ui.tz("S")
    50		# V1.2.1：最長的條也要在條尾外留出數字的位置（原本滿格時數字被夾進條內，和其他列不一致）
    51		var lab_w: float = ui._width(str(maxv), fs) + 8.0
    52		var bar_half := maxf(20.0, half - lab_w)
    53		for i in rows.size():
    54			var row: Dictionary = rows[i]
    55			var y := rect.position.y + i * rh
    56			var bh := minf(rh * 0.62, 22.0)
    57			var by := y + (rh - bh) / 2
    58			if row.has("type"):
    59				ui._unit_in(Rect2(cx, y, 28.0, rh), int(row["type"]), 0, 1.0, minf(0.42, rh / 80.0))   # 兵種頭像（V9）
    60			ui._text(Vector2(cx + mid_w / 2 + (12.0 if row.has("type") else 0.0), y + (rh - fs * 1.1) / 2), str(row["label"]), fs, Color.WHITE, true, false, mid_w - 6)
    61			var lb := bar_half * float(row["b"]) / maxv
    62			var lr := bar_half * float(row["r"]) / maxv
    63			ui.draw_rect(Rect2(cx - lb, by, lb, bh), team_col(0, cb))
    64			var rr := Rect2(cx + mid_w, by, lr, bh)
    65			ui.draw_rect(rr, team_col(1, cb))
    66			if cb:
    67				hatch(ui, rr, Color(0, 0, 0, 0.35))
    68			var vb := str(int(row["b"]))
    69			var vr := str(int(row["r"]))
    70			var wb: float = ui._width(vb, fs)
    71			ui._text(Vector2(cx - lb - wb - 6, y + (rh - fs * 1.1) / 2), vb, fs, MUTED)
    72			ui._text(Vector2(cx + mid_w + lr + 6, y + (rh - fs * 1.1) / 2), vr, fs, MUTED)
    73	
    74	## 排名條：values＝這個指標在可比兵種裡的值（Dictionary type→值）；me＝這一種。
    75	## 灰點＝其他兵種的位置，亮點＝這一種；右邊標「值・第 N 高」。只傳可比的兵種（第五輪 §4.3）。
    76	static func rank_bar(ui, rect: Rect2, values: Dictionary, me: int, label: String, value_text: String, accent := Color("#ffd166")) -> void:
    77		var fs: int = ui.tz("S")
    78		ui._text(rect.position, label, fs, MUTED)
    79		var lx := maxf(rect.position.x + rect.size.x * 0.22, rect.position.x + ui._width(label, fs) + 10)   # 標籤長（英文、大字）就往右讓
    80		if values.size() <= 1:
    81			# 不排名的指標（價格、補血、光環）：只寫數值，不畫條（Antigravity：灰條看起來像最低分）
    82			ui._text(Vector2(lx, rect.position.y), value_text, fs, Color.WHITE, false, true, rect.end.x - lx)
    83			return
    84		# 數值文字放得下為優先：條的寬度＝剩下的空間（30%～最少 50px）
    85		var rank_guess := 1
    86		for t in values:
    87			if t != me and float(values[t]) > float(values.get(me, 0)):
    88				rank_guess += 1
    89		var rt0: String = value_text if values.size() <= 1 else load("res://scripts/game/strings.gd").t("rank_nth", [value_text, rank_guess])
    90		var lw := clampf(rect.end.x - lx - ui._width(rt0, fs, true) - 24, 40.0, rect.size.x * 0.30)
    91		var cy := rect.position.y + fs * 0.75
    92		var seg: bool = ui.has_method("_seg_bar") and not bool(ui.Save.s("plain_ui"))
    93		if not seg:
    94			ui.draw_line(Vector2(lx, cy), Vector2(lx + lw, cy), GRID, 4.0)
    95		var mx := 0.0
    96		var mn := 1e18
    97		for t in values:
    98			mx = maxf(mx, float(values[t]))
    99			mn = minf(mn, float(values[t]))
   100		var span := maxf(1e-6, mx - mn)
coordination/v121-ledger.md:10:- Ruling R8：對比檢查找不到背景就判失敗、停用元件另報 — 避免漏測報零違規；WCAG 豁免停用元件 — 代價：初期可能多出要補登記的背景。
