   491	## 行距（第五輪 §4.2，XAG 101）：多行的段落 1.5 倍；單行照舊。
   492	static func line_h(n: int) -> float:
   493		return 1.5 if n > 1 else 1.3
   494	
   495	## 一段字換行後的高度（排版用）。
   496	func text_h(s: String, size: int, maxw := 0.0, bold := false) -> float:
   497		var n := wrap_lines(s, size, maxw, bold).size()
   498		return n * size * line_h(n)
