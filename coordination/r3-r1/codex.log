   358	## 第二輪方案 R1：騎兵打轉修正
   359	func test_nav_r1() -> void:
   360		# 繞翼狀態機：直接操作位置，驗「到過就記住」（舊版用「現在距離」判斷，離開後會回頭）
   361		var s = Sim.new(army_from(0, [[D.CAVALRY, 3, 4]]), army_from(1, [[D.SHIELD, 5, 4], [D.SHIELD, 5, 5], [D.ARCHER, 0, 4]]))
   362		var cav = s.units[0]
   363		var ai := -1
   364		for k in s.units.size():
   365			if s.units[k].type == D.ARCHER:
   366				ai = k
   367		var wp: Vector2i = s._flank_waypoint(0, ai)
   368		ok(cav.nav == 1 and wp.x >= 0, "被盾兵擋路時會規劃繞翼", str(wp))
   369		ok(wp.y >= Sim.EDGE + D.FLANK_EDGE_MARGIN and wp.y <= Sim.H - Sim.EDGE - D.FLANK_EDGE_MARGIN, "途經點離上下邊界至少 EDGE＋FLANK_EDGE_MARGIN", str(wp))
   370		cav.x = wp.x + 100
   371		cav.y = wp.y
   372		var r1: Vector2i = s._flank_waypoint(0, ai)
   373		cav.x = wp.x - 1500   # 離開途經點
   374		var r2: Vector2i = s._flank_waypoint(0, ai)
   375		ok(r1.x == -1 and r2.x == -1 and cav.nav == 2, "到過途經點就不再回頭（同一目標）", "r1=%s r2=%s nav=%d" % [r1, r2, cav.nav])
   376		# 貼邊：騎兵和弓手都在最上列 → 往上沒有空間，只能往下繞或直接追，途經點不會貼在邊界
   377		var e = Sim.new(army_from(0, [[D.CAVALRY, 3, 0]]), army_from(1, [[D.SHIELD, 5, 0], [D.ARCHER, 0, 0]]))
   378		var ea := 2
   379		var ewp: Vector2i = e._flank_waypoint(0, ea)
   380		ok(ewp.x == -1 or ewp.y >= Sim.EDGE + D.FLANK_EDGE_MARGIN, "上邊緣不會產生貼牆的途經點", str(ewp))
   381		# 追擊遲滯：目標往外走時，騎兵不會每隔一 tick 停一次
   382		var c2 = Sim.new(army_from(0, [[D.CAVALRY, 5, 4]]), army_from(1, [[D.ARCHER, 5, 4]]))
   383		var stops := 0
   384		var moves := 0
   385		var prev_moving := false
   386		var flips := 0
   387		for i in 120:
   388			c2.step()
   389			if not c2.units[0].alive or not c2.units[1].alive:
   390				break
   391			var moving: bool = c2.units[0].mx != 0 or c2.units[0].my != 0
   392			if i > 0 and moving != prev_moving:
   393				flips += 1
   394			prev_moving = moving
   395		ok(flips <= 6, "追擊不會走一步停一步（狀態切換次數少）", "flips=%d" % flips)
   396		# 不能靠「完全不動」過關：騎兵一定要追上並打到弓手（Codex R1 審查 #5）
   397		ok(c2.units[1].dmg_taken > 0 or not c2.units[1].alive, "追擊遲滯下騎兵仍然追上並出手", "弓手受傷=%d" % c2.units[1].dmg_taken)
   398		# 遲滯的邊界：在攻擊距離內不追；超出 reach 才起步；追到 reach−CHASE_HYST 以內才停
   399		var R := 1000
   400		var sq := func(v: int) -> int: return v * v
   401		ok(not Sim.cav_chase(false, sq.call(R - 10), R), "遲滯：停著時在攻擊距離內不起步")
   402		ok(Sim.cav_chase(false, sq.call(R + 10), R), "遲滯：停著時超出攻擊距離就起步")
   403		ok(Sim.cav_chase(true, sq.call(R - D.CHASE_HYST + 10), R), "遲滯：追擊中、還沒追進 reach−HYST 就繼續追")
   404		ok(not Sim.cav_chase(true, sq.call(R - D.CHASE_HYST - 10), R), "遲滯：追進 reach−HYST 才停")
