   407	## 殘局標準解回歸（第二輪方案 §1.4）：每關存的標準解都必須打贏；改戰鬥規則後有任何一關變不能過就會紅。
   408	func test_puzzle_solutions() -> void:
   409		var total := 0
   410		var bad: Array = []
   411		for pz in PZ.tutorials() + PZ.puzzles():
   412			var sols: Array = pz.get("solutions", [])
   413			if sols.is_empty():
   414				bad.append("%s 沒有標準解" % pz["id"])
   415			for sol in sols:
   416				var a0 = PZ.player_army(pz)
   417				var allowed: Array = []
   418				for v in pz.get("allowed", [0, 1, 2, 3, 4]):
   419					allowed.append(int(v))   # JSON 讀進來是 float，has(int) 會比不到
   420				for e in sol:
   421					# 用正式的擺放規則驗合法性：預算、格子在區內、沒有重疊、兵種允許（Codex R1 審查 #5）
   422					if not allowed.has(int(e[0])):
   423						bad.append("%s 標準解用了不允許的兵種 %d" % [pz["id"], int(e[0])])
   424					var why: String = a0.check_place(int(e[0]), int(e[1]), int(e[2]))
   425					if why != "":
   426						bad.append("%s 標準解不合法：%s" % [pz["id"], why])
   427					a0.place(int(e[0]), int(e[1]), int(e[2]))
   428				var sm = Sim.new(a0, PZ.enemy_army(pz))
   429				sm.fast = true
   430				sm.run_to_end()
   431				total += 1
   432				if sm.winner != 0:
   433					bad.append("%s 標準解輸了" % pz["id"])
   434		var n_pz: int = (PZ.tutorials() + PZ.puzzles()).size()
   435		for pz in PZ.puzzles():
   436			if pz.get("solutions", []).size() < 2:
   437				bad.append("%s 不到兩組解" % pz["id"])
   438		ok(total >= n_pz and bad.is_empty(), "%d 關殘局標準解合法且全部打贏、殘局每關 ≥2 解（%d 組）" % [n_pz, total], str(bad))
