   761	func _draw_place_units() -> void:
   762		var list: Array = []
   763		var hide_side := -1
   764		if mode == Mode.VS_AI:
   765			hide_side = 1
   766		elif mode == Mode.DUEL and tp == null:
   767			hide_side = 1 if blind_phase == 0 else (0 if blind_phase == 1 else -1)
   768		for a in armies:
   769			if a.team == hide_side:
   770				continue
     1	extends RefCounted
     2	## 設定與進度存檔（優化方案 L1、N）：JSON、原子寫入（先寫暫存檔再改名）＋保留上一版備份。
     3	## 雲端：Steam Auto-Cloud 只同步 user://save.json（進度、陣型）；設定 user://settings.json 留在本機。
     4	
     5	const SAVE_VERSION := 1
     6	static var prefix := ""   # 截圖／測試模式用 "shot_"，不碰玩家真正的存檔
     7	
     8	const DEFAULT_SETTINGS := {
     9		"lang": "zh_TW", "text_scale": 100, "shake": true, "slowmo": true, "flash": true, "colorblind": false,
    10		"speed": 1.0, "music": 70, "sfx": 80, "duel_rule": "snake5", "fullscreen": false, "playtest": false,
    11	}
    12	const DEFAULT_SAVE := {
    13		"version": SAVE_VERSION, "slots": ["", "", "", "", ""], "tutorial": 0, "puzzle_stars": {},
    14		"gauntlet_best": 0, "achievements": [], "stats": {"wins": 0, "games": 0},
    15	}
    16	
    17	static var settings := {}
    18	static var data := {}
    19	
    20	static func load_all() -> void:
    21		settings = _read(_sp(), DEFAULT_SETTINGS)
    22		data = _read(_dp(), DEFAULT_SAVE)
    23		if int(data.get("version", 0)) != SAVE_VERSION:
    24			data = _migrate(data)
    25	
    26	static func _sp() -> String:
    27		return "user://%ssettings.json" % prefix
    28	
    29	static func _dp() -> String:
    30		return "user://%ssave.json" % prefix
    31	
    32	static func _read(path: String, defaults: Dictionary) -> Dictionary:
    33		var out := defaults.duplicate(true)
    34		for p in [path, path + ".bak"]:
    35			if not FileAccess.file_exists(p):
    36				continue
    37			var txt := FileAccess.get_file_as_string(p)
    38			var parsed = JSON.parse_string(txt)
    39			if typeof(parsed) == TYPE_DICTIONARY:
    40				for k in parsed:
    41					out[k] = parsed[k]
    42				return out
    43		return out
    44	
    45	static func _migrate(d: Dictionary) -> Dictionary:
    46		var out := DEFAULT_SAVE.duplicate(true)
    47		for k in d:
    48			if out.has(k):
    49				out[k] = d[k]
    50		out["version"] = SAVE_VERSION
    51		return out
    52	
    53	static func _write(path: String, d: Dictionary) -> bool:
    54		var tmp := path + ".tmp"
    55		var f := FileAccess.open(tmp, FileAccess.WRITE)
    56		if f == null:
    57			return false
    58		var txt := JSON.stringify(d, "\t")
    59		f.store_string(txt)
    60		f.close()
    61		# 讀回驗證：內容不完整（磁碟滿、被中斷）就不覆蓋正式檔
    62		if FileAccess.get_file_as_string(tmp) != txt:
    63			return false
    64		if FileAccess.file_exists(path):
    65			DirAccess.copy_absolute(path, path + ".bak")
    66		return DirAccess.rename_absolute(tmp, path) == OK
    67	
    68	static func save_settings() -> bool:
    69		return _write(_sp(), settings)
    70	
    71	static func save_data() -> bool:
    72		return _write(_dp(), data)
    73	
    74	static func s(key: String):
    75		return settings.get(key, DEFAULT_SETTINGS.get(key))
    76	
    77	static func set_setting(key: String, v) -> void:
    78		settings[key] = v
    79		save_settings()
    80	
    81	
    82	## 試玩紀錄（優化方案 F5、N3）：只在設定開啟時寫在本機 user://playtest_log.jsonl，不上傳。
    83	static func playtest_log(entry: Dictionary) -> void:
    84		if not bool(s("playtest")):
    85			return
    86		var path := "user://%splaytest_log.jsonl" % prefix
    87		var f := FileAccess.open(path, FileAccess.READ_WRITE if FileAccess.file_exists(path) else FileAccess.WRITE)
    88		if f == null:
    89			return
    90		f.seek_end()
    91		entry["time"] = Time.get_datetime_string_from_system()
    92		f.store_line(JSON.stringify(entry))
