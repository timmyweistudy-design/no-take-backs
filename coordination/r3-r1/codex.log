   381		if mode == Mode.GAUNTLET:
   382			if w == 0:
   383				if gauntlet_stage >= 7:
   384					_ach("GAUNTLET")
   385					Save.data["gauntlet_best"] = 7
   386			else:
   387				Save.data["gauntlet_best"] = maxi(int(Save.data.get("gauntlet_best", 0)), gauntlet_stage - 1)
   388		_save()
