   318	func _progress_and_achievements() -> void:
   319		var w: int = sim.winner
   320		var st: Dictionary = Save.data.get("stats", {"wins": 0, "games": 0})
   321		st["games"] = int(st.get("games", 0)) + 1
   322		var me_won := w == 0 or (mode == Mode.DUEL and w >= 0)
   323		if w == 0 and mode != Mode.DUEL:
   324			st["wins"] = int(st.get("wins", 0)) + 1
   325		Save.data["stats"] = st
   326		if me_won:
   327			_ach("FIRST_WIN")
   328			if sim.alive_count(w) == 1:
   329				_ach("LONE_HERO")
   330			if int(report["sus"]["max_swing_pct"]) >= 15:
   331				_ach("COMEBACK")
   332			if sim.power(w) * 100 / (sim.budget * 1000) <= 5:
   333				_ach("CLOSE_CALL")
   334			if sim.tick >= Sim.FRENZY_TICK:
   335				_ach("FRENZY_WIN")
   336			var types := {}
