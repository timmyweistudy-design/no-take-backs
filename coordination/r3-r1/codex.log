   338				if u.team == w:
   339					types[u.type] = true
   340			if types.size() == 5:
   341				_ach("ALL_TYPES")
   342			# 圖鑑老兵筆記：派這個兵種贏一場 +1（第二輪方案 R3）
   343			for t in CX.record_win(Save.data, types.keys()):
   344				ach_queue.append(L.t("codex_unlocked", [L.t("unit_%d" % t)]))
   345			if int(ev_count.get("charge%d" % w, 0)) >= 5:
   346				_ach("CHARGE_5")
   347			if int(ev_count.get("backstab%d" % w, 0)) >= 3:
   348				_ach("BACKSTAB_3")
   349		if mode == Mode.VS_AI and w == 0 and difficulty == 2:
   350			_ach("HARD_WIN")
   351		if mode == Mode.DUEL and tp != null and series_over:
   352			_ach("NO_TAKEBACKS")
   353		if series_over and ((mode == Mode.DUEL and (wins == [2, 0] or wins == [0, 2])) or (mode == Mode.VS_AI and wins == [2, 0])):
   354			_ach("SWEEP")
   355		if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
   356			var pz := PZ.get_puzzle(puzzle_id)
   357			var extra_spent: int = armies[0].spent() - (armies[0].budget - int(pz["budget"]))
   358			var rem: int = sim.power(0) * 100 / (sim.budget * 1000) if w == 0 else 0
   359			var stars := PZ.stars(pz, w == 0, rem, extra_spent)
   360			var ps: Dictionary = Save.data.get("puzzle_stars", {})
   361			if stars > int(ps.get(puzzle_id, 0)):
   362				ps[puzzle_id] = stars
   363			Save.data["puzzle_stars"] = ps
   364			report["stars"] = stars
   365			if mode == Mode.TUTORIAL and w == 0:
   366				var idx := 0
   367				for i in PZ.tutorials().size():
   368					if PZ.tutorials()[i]["id"] == puzzle_id:
   369						idx = i
   370				Save.data["tutorial"] = maxi(int(Save.data.get("tutorial", 0)), idx + 1)
   371				if int(Save.data["tutorial"]) >= PZ.tutorials().size():
   372					_ach("TUTORIAL")
   373			if stars == 3:
   374				_ach("PUZZLE_3STAR")
   375			var all_done := true
   376			for p in PZ.puzzles():
   377				if int(ps.get(p["id"], 0)) == 0:
