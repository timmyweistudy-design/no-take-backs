   441	## 兵種圖鑑（第二輪方案 R3）：資料齊全、技能說明的數值都換得出來、每段示範用真模擬一定觸發預期的技能、老兵筆記贏 5 場解鎖。
   442	func test_codex() -> void:
   443		ok(CX.validate().is_empty(), "圖鑑資料自我檢查通過", str(CX.validate()))
   444		var bad: Array = []
   445		var n := 0
   446		for sk in CX.data()["skills"]:
   447			n += 1
   448			var ex: String = CX.skill(sk)["demo"]["expect"]
   449			var tags := CX.demo_tags(sk)
   450			if not tags.has(ex):
   451				bad.append("%s 沒有觸發 %s（%s）" % [sk, ex, tags])
   452			for lang in ["zh_TW", "en"]:
   453				var d := CX.skill_desc(sk, lang)
   454				if d.contains("{") or d.contains("}"):
   455					bad.append("%s 說明有沒換掉的常數：%s" % [sk, d])
   456		ok(n == 14 and bad.is_empty(), "14 個技能示範都觸發預期事件、說明數值都換好", str(bad))
   457		# 說明的數值真的來自 unit_defs：改常數名就會在上面紅；這裡再對一個值
   458		ok(CX.skill_desc("shield_block", "zh_TW").contains("×%d/%d" % [D.BLOCK_NUM, D.BLOCK_DEN]), "技能說明的數值取自 unit_defs")
   459		var sd := {}
   460		var newly: Array = []
   461		for i in CX.NOTE_WINS:
   462			if i == CX.NOTE_WINS - 1:
   463				ok(not CX.note_unlocked(sd, D.CAVALRY), "老兵筆記：贏 %d 場時還沒解鎖" % i)
   464			newly = CX.record_win(sd, [D.CAVALRY, D.CAVALRY, D.SWORD])
   465		ok(CX.note_unlocked(sd, D.CAVALRY) and CX.wins_with(sd, D.CAVALRY) == CX.NOTE_WINS, "老兵筆記：同一場同兵種只算一次、贏 5 場解鎖")
   466		ok(newly.has(D.CAVALRY) and newly.has(D.SWORD) and not CX.note_unlocked(sd, D.ARCHER), "老兵筆記：剛好第 5 場回報新解鎖、沒派的兵種不解鎖")
