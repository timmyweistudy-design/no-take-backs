    93	func _on_event(ev: Dictionary, with_fx: bool) -> void:
    94		var k: String = ev["kind"]
    95		if k == "death":
    96			var u = sim.unit_by_id(ev["id"])
    97			dying.append({"pos": _upos(u), "type": u.type, "team": u.team, "face": signf(u.fx) if u.fx != 0 else 1.0, "t": 0.0})
    98			if with_fx:
    99				sfx.play("death", 0.7)
   100			return
   101		if k == "attrition" or not with_fx:
   102			return
   103		var s = sim.unit_by_id(ev["src"])
   104		var t = sim.unit_by_id(ev["tgt"])
   105		atk_t[s.id] = time
   106		hurt_t[t.id] = time
   107		var sp := _upos(s)
   108		var tpos := _upos(t)
   109		if s.type == D.ARCHER:
   110			fx.append({"kind": "arrow", "a": sp + Vector2(10 * signf(tpos.x - sp.x), -24), "b": tpos + Vector2(0, -22), "t": 0.0, "dur": 0.28, "tc": Art.team_color(s.team, cbm())})
   111			sfx.play("arrow", 0.35)
   112		else:
   113			fx.append({"kind": "slash", "p": sp, "dir": signf(tpos.x - sp.x) if tpos.x != sp.x else 1.0, "t": 0.0, "dur": 0.18})
   114			sfx.play("hit" if k == "hit" else "slash", 0.4)
   115		var col := Color.WHITE
   116		var label := ""
   117		match k:
   118			"charge":
   119				label = L.t("ev_charge")
   120				col = ACCENT
   121				sfx.play("charge")
   122				if bool(Save.s("shake")):
   123					shake = 0.12
   124				fx.append({"kind": "dust", "p": tpos, "t": 0.0, "dur": 0.5})
   125			"backstab":
   126				label = L.t("ev_backstab")
   127				col = Color("#c77dff")
   128				sfx.play("backstab")
   129				fx.append({"kind": "flash", "p": tpos + Vector2(0, -26), "c": Color("#c77dff"), "t": 0.0, "dur": 0.25})
   130			"braced":
   131				label = L.t("ev_braced")
   132				col = Color("#9ad1ff")
   133				sfx.play("brace")
   134				fx.append({"kind": "ripple", "p": tpos + Vector2(10, -24), "c": ACCENT, "t": 0.0, "dur": 0.35})
   135			"anticav":
   136				label = L.t("ev_anticav")
   137				col = Color("#9ad1ff")
   138				sfx.play("brace", 0.6)
   139			"blocked":
   140				sfx.play("block", 0.5)
   141				fx.append({"kind": "ripple", "p": tpos + Vector2(14, -26), "c": ACCENT, "t": 0.0, "dur": 0.3})
   142			"counter":
   143				label = L.t("ev_counter")
   144				col = Color("#80ffdb")
   145			"breaker":
   146				fx.append({"kind": "shard", "p": tpos + Vector2(12, -26), "t": 0.0, "dur": 0.5})
   147		if label != "":
   148			_merge_text(t.id, k, label, int(ev["dmg"]), tpos + Vector2(0, -78), col)
