   211	## 困難 AI：第 1 局沒有資訊，用會讀對方的落子 AI 自己組；之後讀你上一局的陣型，
   212	## 先查離線反制庫（組成最接近的原型），查不到就用啟發式反制。不偷看你這一局。
   213	func _hard_ai(r: RandomNumberGenerator) -> Army:
   214		var known: Array = last_player_formation if round_no > 1 else []
   215		if not known.is_empty():
   216			var lib := _counter_lib()
   217			if not lib.is_empty():
   218				var mine := [0, 0, 0, 0, 0]
   219				for u in known:
   220					mine[u["type"]] += D.cost(u["type"])
   221				var best = null
   222				var bd := 1 << 30
   223				for e in lib:
   224					var d := 0
   225					for k in 5:
   226						d += absi(int(e["proto_comp"][k]) - mine[k])
   227					if d < bd:
   228						bd = d
   229						best = e
   230				if best != null and bd <= 40:
   231					var a := Army.new(1, 100)
   232					if a.load_code(best["code"]) == "":
   233						return a
   234		return AIT.build_full(1, r, 2, known)
