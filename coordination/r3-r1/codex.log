   614						_on_skip()
   615					elif state != St.TITLE:
   616						_go_title()
   617			return
   618		pad_mode = true
   619		match k:
   620			KEY_UP: cursor.y = maxi(0, cursor.y - 1)
   621			KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
   622			KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
   623			KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
   624			KEY_F1:
   625				_open_codex(selected)
   626			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5:
   627				var t := k - KEY_1
   628				if _allowed(t):
   629					selected = t
   630			KEY_Q, KEY_E:
   631				for i in 5:
   632					selected = (selected + (4 if k == KEY_Q else 1)) % 5
   633					if _allowed(selected):
   634						break
   635			KEY_ENTER, KEY_KP_ENTER:
   636				if _cur_army().index_at(cursor.x, cursor.y) == -1:
   637					_try_place(cursor)
   638			KEY_BACKSPACE, KEY_DELETE:
   639				_try_remove(cursor)
   640			KEY_SPACE, KEY_TAB:
   641				_on_start()
   642			KEY_ESCAPE:
   643				_go_title()
   644	
   645	
   646	# ───────────────────────── 每幀 ─────────────────────────
   647	func _process(delta: float) -> void:
   648		var _t0 := Time.get_ticks_usec()
   649		_process_inner(delta)
   650		perf_proc_us = Time.get_ticks_usec() - _t0
   651	
   652	func _process_inner(delta: float) -> void:
   653		time += delta
   654		SteamApi.run_callbacks()
   655		if toast_t > 0:
   656			toast_t -= delta
   657		if ach_t > 0:
   658			ach_t -= delta
   659		elif not ach_queue.is_empty():
   660			toast = ach_queue.pop_front()
   661			toast_t = 2.5
   662			ach_t = 2.6
   663		shake = maxf(0.0, shake - delta)
   664		for f in fx:
   665			f["t"] += delta
   666		fx = fx.filter(func(f): return f["t"] < f["dur"])
   667		for g in dying:
   668			g["t"] += delta
   669		dying = dying.filter(func(g): return g["t"] < 1.0)
   670		if overlay == "codex":
   671			_codex_tick(delta)
   672		if state == St.TITLE and demo != null and shot_dir == "":
   673			demo_acc += delta
   674			while demo_acc >= 0.05:
   675				demo_acc -= 0.05
   676				demo.step()
   677			if demo.finished:
   678				_new_demo()
   679		if state == St.BATTLE and shot_dir == "":
   680			_battle_process(delta)
   681		elif state == St.RESULT:
   682			zoom = lerpf(zoom, 1.0, delta * 4)
   683		queue_redraw()
   684	
   685	
   686	# ───────────────────────── 繪圖 ─────────────────────────
   687	func _draw() -> void:
   688		var _t0 := Time.get_ticks_usec()
   689		_draw_inner()
   690		perf_draw_us = Time.get_ticks_usec() - _t0
   691	
   692	func _draw_inner() -> void:
   693		_btns.clear()
   694		if capsule_path != "":
   695			_draw_capsule()
   696			return
   697		draw_rect(Rect2(0, 0, 1280, 800), Color("#1b2a1f"))
   698		var cam := Transform2D.IDENTITY
   699		if state == St.BATTLE or state == St.RESULT:
   700			var off := Vector2.ZERO
   701			if shake > 0 and bool(Save.s("shake")):
   702				off = Vector2(sin(time * 90) * 2, cos(time * 77) * 2)
   703			var w := clampf((zoom - 1.0) / 0.5, 0.0, 1.0)
   704			var c := (ORIGIN + FIELD / 2).lerp(zoom_center, w)
   705			var half := Vector2(640, 388) / zoom
   706			var lo := ORIGIN + half - Vector2(60, 100)
   707			var hi := ORIGIN + FIELD - half + Vector2(60, 100)
   708			c = Vector2(clampf(c.x, minf(lo.x, hi.x), maxf(lo.x, hi.x)), clampf(c.y, minf(lo.y, hi.y), maxf(lo.y, hi.y)))
   709			cam = Transform2D(0, Vector2(zoom, zoom), 0, Vector2(640, 388) - c * zoom + off)
   710		draw_set_transform_matrix(cam)
   711		Art.base = cam
   712		var _t := Time.get_ticks_usec()
   713		_draw_field()
   714		perf_parts["field"] = Time.get_ticks_usec() - _t
   715		_t = Time.get_ticks_usec()
   716		if state == St.TITLE:
   717			_draw_units_of(demo, true)
   718		elif state == St.PLACE:
   719			_draw_place_units()
   720			_draw_tactical()
   721		else:
   722			_draw_units_of(sim, false)
   723		perf_parts["units"] = Time.get_ticks_usec() - _t
   724		_t = Time.get_ticks_usec()
   725		for f in fx:
   726			if not f.get("screen", false):
   727				_draw_fx(f)
   728		perf_parts["fx"] = Time.get_ticks_usec() - _t
   729		draw_set_transform_matrix(Transform2D.IDENTITY)
   730		Art.base = Transform2D.IDENTITY
   731		if state == St.BATTLE and slow_left > 0:
   732			var va := clampf((8.0 - slow_left) / 0.3, 0.0, 1.0) * 0.45
   733			for i in 14:
   734				var c2 := Color(0, 0, 0, va * (1.0 - i / 14.0) * 0.35)
   735				draw_rect(Rect2(0, 86 + i * 9, 1280, 9), c2)
   736				draw_rect(Rect2(0, 800 - (i + 1) * 9, 1280, 9), c2)
   737				draw_rect(Rect2(i * 9, 86, 9, 714), c2)
   738				draw_rect(Rect2(1280 - (i + 1) * 9, 86, 9, 714), c2)
   739		if state != St.RESULT:
   740			for f in fx:
   741				if f.get("screen", false):
   742					_draw_fx(f)
   743		match state:
   744			St.TITLE: _draw_title()
   745			St.PLACE: _draw_place_hud()
   746			St.BATTLE: _draw_battle_hud()
   747			St.RESULT:
   748				_draw_battle_hud()
   749				_draw_result()
   750		_draw_overlay()
   751		if toast_t > 0:
   752			var a := minf(1.0, toast_t * 2)
   753			var tw := font.get_string_size(toast, HORIZONTAL_ALIGNMENT_LEFT, -1, ts(20)).x + 40
   754			draw_rect(Rect2(640 - tw / 2, 616, tw, 44), Color(0, 0, 0, 0.72 * a))
   755			_text(Vector2(640, 622), toast, ts(20), Color(1, 0.88, 0.5, a), true)
   756		if _focus >= _btns.size():
   757			_focus = 0
   758		_handle_click()
