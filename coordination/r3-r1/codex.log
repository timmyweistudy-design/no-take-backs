    53	static func _write(path: String, d: Dictionary) -> bool:
    54		var tmp := path + ".tmp"
    55		var f := FileAccess.open(tmp, FileAccess.WRITE)
    56		if f == null:
    57			return false
    58		var txt := JSON.stringify(d, "\t")
    59		f.store_string(txt)
