   135	static func most_common_other(a: Army, x: int) -> int:
   136		var comp := F.composition(a)
   137		var best := -1
   138		for t in D.CLASSIC:
   139			if t != x and comp[t] > 0 and (best == -1 or comp[t] > comp[best]):
   140				best = t
   141		return best if best >= 0 else D.SWORD
