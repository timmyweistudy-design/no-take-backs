    98	## 含 X 的陣型：從 ntypes 範圍的混編裡產生，X 的權重至少 2；第 i 套固定種子。
    99	static func with_unit(x: int, nt: int, i: int) -> Army:
   100		var rng := RandomNumberGenerator.new()
   101		rng.seed = 424242 + x * 100003 + i * 7919
   102		for tries in 50:
   103			var w := D.zeros()
   104			for t in nt:
   105				w[t] = rng.randi_range(0, 3)
   106			w[x] = maxi(2, w[x])
   107			if D.is_support(x):
   108				# 支援兵（醫者、鼓手）不疊加、AI 一種最多帶 2 隻：只取帶 1～2 隻的陣型（第四輪驗收時修正，見報告）
   109				w[x] = 1
   110			var a := F.weighted_formation(0, rng, w)
   111			if a.count_of(x) > 0 and (not D.is_support(x) or a.count_of(x) <= 2):
   112				return a
   113		return null
