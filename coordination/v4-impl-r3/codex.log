   102	## 在輪流落子裡走一手（可能擺多隻直到這一手花不下）。回傳擺了幾隻。
   103	static func play_turn(tp, rng: RandomNumberGenerator, level := 1) -> int:
   104		var me: int = tp.current
   105		var mine: Army = tp.armies[me]
   106		var enemy: Army = tp.armies[1 - me]
   107		var placed := 0
   108		var guard := 0
   109		while not tp.done() and tp.current == me and guard < 30:
   110			guard += 1
   111			var t := choose_type(mine, enemy.units, tp.turn_left(), rng, level, tp.ntypes)
   112			if t == -1:
   113				break
   114			var c := choose_cell(mine, t, enemy.units, rng)
   115			if c.x < 0 or not tp.place(t, c.x, c.y):
   116				break
   117			placed += 1
   118			# 困難 AI 在「沒花完的錢會累積」的規則（snake5c）才會花到 60% 就收手、保留後手。
   119			# 第三輪 S6 抓到：原本所有規則都這樣做，snake5／cap10 沒花完的錢會直接浪費（每方只花 70 金），先手勝率被扭曲成 86%。
   120			if tp.current == me and level == 2 and tp.rule == "snake5c" and tp.spent_this_turn * 10 >= tp.hand_cap() * 6 and tp.can_end_turn():
   121				tp.end_turn()
   122				break
   123		if tp.current == me and not tp.done():
   124			tp.end_turn()
   125		return placed
