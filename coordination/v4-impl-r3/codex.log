    55	def check_rows(m, mode, got, man):
    56	    c = man["contract"]
    57	    unit = int(m.split(":")[1]) if ":" in m else None
    58	    bad = []
    59	    for r in got:
    60	        if r.get("mode") != mode:
    61	            bad.append(f"模式不符 {r.get('mode')}")
    62	        if r.get("rules") != c["rules"] or r.get("digest") != c["digest"]:
    63	            bad.append(f"規則或數值摘要和契約不同（{r.get('rules')}/{r.get('digest')}）")
    64	        if unit is not None and r.get("unit") != unit:
    65	            bad.append(f"兵種不符 {r.get('unit')}")
    66	        if mode != "core" and r.get("nt") != man["ntypes"]:
    67	            bad.append(f"開放數 {r.get('nt')} ≠ {man['ntypes']}")
    68	        if "skip" in r:
    69	            if mode not in ("repl", "replshield") or not (0 <= int(r.get("i", -1)) < 200):
    70	                bad.append(f"不合法的跳過列 {r}")
    71	            continue
    72	        if r.get("s0") not in LEGAL or r.get("s1") not in LEGAL:
    73	            bad.append(f"分數不合法 {r.get('s0')}/{r.get('s1')}")
    74	        if mode != "core":
    75	            want_pool = c["pool_shield"] if mode == "replshield" else c["pool_val"]
    76	            if r.get("pool") != want_pool:
    77	                bad.append(f"對手池身分不符（{r.get('pool')} ≠ {want_pool}）")
    78	    if mode in ("repl", "replshield"):
    79	        skips = {r["i"] for r in got if "skip" in r}
    80	        if len(skips) > 10:
    81	            bad.append(f"跳過的陣型太多（{len(skips)}）")
    82	        data = [r for r in got if "skip" not in r]
    83	        want = {(i, k, pol) for i in range(200) if i not in skips for k in range(6) for pol in ("orig", "a", "b", "c")}
    84	        have = [(r["i"], r["k"], r["pol"]) for r in data]
    85	        if len(set(have)) != len(have):
    86	            bad.append("有重複的列")
    87	        if set(have) != want:
    88	            bad.append(f"鍵集合不對（少 {len(want - set(have))}、多 {len(set(have) - want)}）")
    89	        opp = {}
    90	        for r in data:
    91	            opp.setdefault((r["i"], r["k"]), set()).add(r.get("opp"))
    92	        mixed = [k for k, v in opp.items() if len(v) != 1 or None in v]
    93	        if mixed:
    94	            bad.append(f"有 {len(mixed)} 組的四種陣型對手不同")
    95	    elif mode == "cover":
    96	        want = {(i, kk, k) for i in range(120) for kk in range(5) for k in range(4)}
    97	        have = [(r["i"], r["kk"], r["k"]) for r in got]
    98	        if len(set(have)) != len(have) or set(have) != want:
    99	            bad.append("鍵集合不對或有重複")
   100	        wrong = [r for r in got if r.get("have") != r.get("kk")]
   101	        if wrong:
   102	            bad.append(f"有 {len(wrong)} 列實際支援兵數 ≠ 要求")
   103	    elif mode == "core":
   104	        have = [(r["r"], r["seed"]) for r in got]
   105	        if len(set(have)) != len(have) or set(have) != {(ri, sd) for ri in range(len(CORE)) for sd in range(40)}:
   106	            bad.append("鍵集合不對或有重複")
   107	    if bad:
   108	        die(f"{m} 資料錯誤：" + "；".join(sorted(set(bad))[:6]))
