    86				wx[D.SWORD] += 1
    87				wx[D.ARCHER] += 1
    88				var wy := D.zeros()
    89				wy[CORE[ri][1]] = 3
    90				wy[D.SWORD] += 1
    91				wy[D.ARCHER] += 1
    92				var style: String = F.STYLES[sd % F.STYLES.size()]
    93				var ax := F.weighted_formation(0, rng, wx, style)
    94				var ay := F.weighted_formation(0, rng, wy, style)
    95				var sc := duel2(ax, ay)
    96				emit({"mode": "core", "r": ri, "seed": sd, "s0": sc[0], "s1": sc[1]})
