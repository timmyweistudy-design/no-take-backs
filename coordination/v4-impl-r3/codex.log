   226	func cover(sup: int, nt: int, shard: int, shards: int) -> void:
   227		var opps := F.validation_pool(0, nt)
   228		pool_id = pool_hash(opps)
   229		var idx := 0
   230		for i in COVER_N:
   231			idx += 1
   232			if idx % shards != shard:
   233				continue
   234			var rng := RandomNumberGenerator.new()
   235			rng.seed = 515151 + sup * 100003 + i * 7919
   236			var w := D.zeros()
   237			for t in nt:
   238				if not D.is_support(t):
   239					w[t] = rng.randi_range(0, 3)
   240			if w.max() == 0:
   241				w[D.SWORD] = 1
   242			var base := F.weighted_formation(0, rng, w)
   243			for kk in 5:
   244				var v := with_supports(base, sup, kk)
   245				for k in COVER_OPPS:
   246					var opp: Army = opps[(i * 11 + k * 37) % opps.size()]
   247					var sc := duel2_cover(v, opp, sup)
   248					emit({"mode": "cover", "unit": sup, "i": i, "kk": kk, "k": k, "opp": (i * 11 + k * 37) % opps.size(), "s0": sc[0], "s1": sc[1], "have": v.count_of(sup), "nt": nt,
   249						"cov": sc[2]})
