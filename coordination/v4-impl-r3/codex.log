   225	            md.append("、".join(parts) + "\n")
   226	    md.append("\n## 結論\n\n" + ("全部門檻通過 ✓\n" if not fails else "".join(f"- ✗ {f}\n" for f in fails)))
   227	    open(os.path.join(folder, "report.md"), "w", encoding="utf-8").write("".join(md))
