   144	    # 經典範圍：同一次執行、同一個對手池
   145	    band = None
   146	    if all(u in deltas for u in CLASSIC_BAND):
   147	        band = {}
   148	        for pol in ("a", "b", "c"):
   149	            vals = [deltas[u][0][pol][0] for u in CLASSIC_BAND]
   150	            band[pol] = (min(vals) - 0.03, max(vals) + 0.03)
   151	        md.append("\n## 經典兵種範圍（同一個對手池）\n\n| 兵種 | 補法 a | 補法 b | 補法 c |\n|---|---|---|---|\n")
   152	        for u in CLASSIC_BAND:
   153	            d = deltas[u][0]
   154	            md.append(f"| {NAMES[u]} | {d['a'][0]*100:+.1f} | {d['b'][0]*100:+.1f} | {d['c'][0]*100:+.1f} |\n")
   155	        md.append("範圍（最小−3～最大+3）：" + "、".join(f"{k} {v[0]*100:+.1f}～{v[1]*100:+.1f}" for k, v in sorted(band.items())) + "\n")
   156	    for m in man["modes"]:
   157	        mode = m.split(":")[0]
   158	        got = rows[m.replace(":", "_", 1)]
   159	        if mode == "core":
   160	            md.append("\n## 核心剋制關係（X 為主＋同樣的劍弓填充，對 Y 為主；40 種排法 × 交換左右）\n\n| 關係 | X 得分 | 95% 區間 | 判定 |\n|---|---|---|---|\n")
   161	            for ri, name in enumerate(CORE):
   162	                mm, lo, hi = mean_ci([(r["s0"] + r["s1"]) / 2 for r in got if r["r"] == ri])
   163	                okk = lo > 0.5
   164	                if not okk:
   165	                    fails.append(f"核心關係「{name}」不成立（下界 {lo*100:.0f}%）")
   166	                md.append(f"| {name} | {mm*100:.0f}% | {lo*100:.0f}～{hi*100:.0f}% | {'✓' if okk else '✗'} |\n")
