    52	static func player_army(pz: Dictionary) -> Army:
    53		var fixed_cost := 0
    54		var a := Army.new(0, 100)
    55		for f in pz["fixed"]:
    56			a.units.append({"type": int(f[0]), "col": int(f[1]), "row": int(f[2])})
    57			fixed_cost += Army.D.cost(int(f[0]))
    58		a.budget = fixed_cost + int(pz["budget"])
