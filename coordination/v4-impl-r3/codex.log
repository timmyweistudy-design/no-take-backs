    32	## 選一個兵種。level：0 簡單（隨機性高、不太看對方）、1 普通、2 困難。
    33	static func choose_type(mine: Army, enemy_units: Array, budget_left: int, rng: RandomNumberGenerator, level := 1, ntypes := D.COUNT) -> int:
    34		var best := -1
    35		var best_s := -1.0e9
    36		var have := D.zeros()
    37		for u in mine.units:
    38			have[u["type"]] += 1
    39		var front: int = have[D.SWORD] + have[D.SHIELD] + have[D.PIKE] + have[D.BERSERKER]
    40		var fighters := 0
    41		for u in mine.units:
    42			if not D.is_support(u["type"]):
    43				fighters += 1
    44		for t in ntypes:
    45			if D.cost(t) > budget_left:
    46				continue
    47			var s := 0.0
    48			var react := 0.4 if level == 0 else (1.0 if level == 1 else 1.6)
    49			for e in enemy_units:
    50				s += counter_score(t, e["type"]) * react
    51				# 已經有的兵也要能應付對方
    52			for u in mine.units:
    53				s -= 0.15 * (1 if u["type"] == t else 0)   # 避免全押同一種
    54			if front < 3 and (t == D.SWORD or t == D.SHIELD):
    55				s += 1.2
    56			if D.is_support(t):
    57				# 支援兵：要有夠多戰鬥兵才值得帶，而且一種最多帶 2 隻
    58				s += 0.5 if fighters >= 5 and have[t] < 2 else -2.0
    59			s += float(D.cost(t)) * 0.05                       # 錢花得完
    60			var noise := 1.5 if level == 0 else (0.6 if level == 1 else 0.25)
    61			s += rng.randf() * noise
    62			if s > best_s:
    63				best_s = s
    64				best = t
    65		return best
