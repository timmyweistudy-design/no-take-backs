   115	## 整批拿掉 X，空出的錢與格子用 fill 兵種補回：先補原本 X 的格子（前排→後排、中間→兩邊），再補其他空格；錢不夠就留著。
   116	static func refill(a: Army, x: int, fill: int) -> Army:
   117		var b := Army.new(0, 100)
   118		var holes: Array = []
   119		for u in a.units:
   120			if u["type"] == x:
   121				holes.append(Vector2i(u["col"], u["row"]))
   122			else:
   123				b.units.append(u.duplicate())
   124		holes.sort_custom(func(p, q): return p.x > q.x or (p.x == q.x and absi(p.y - 4) < absi(q.y - 4)) or (p.x == q.x and absi(p.y - 4) == absi(q.y - 4) and p.y < q.y))
   125		for h in holes:
   126			b.place(fill, h.x, h.y)
   127		for c in [5, 4, 3, 2, 1, 0]:
   128			for r in [4, 3, 5, 2, 6, 1, 7, 0, 8]:
   129				if b.left() < D.cost(fill):
   130					return b
   131				b.place(fill, c, r)
   132		return b
