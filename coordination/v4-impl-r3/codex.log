   133			var t := choose_type(a, known_enemy if level == 2 else [], a.left(), rng, level, ntypes)
   134			if t == -1:
   135				break
   136			var c := choose_cell(a, t, known_enemy if level >= 1 else [], rng)
   137			if c.x < 0:
