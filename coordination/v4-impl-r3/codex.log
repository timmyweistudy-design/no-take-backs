   110	def repl_deltas(got):
   111	    cell = {}
   112	    for r in got:
   113	        if "skip" in r:
   114	            continue
   115	        cell.setdefault((r["i"], r["opp"], r["k"]), {})[r["pol"]] = (r["s0"] + r["s1"]) / 2
   116	    out = {}
   117	    for pol in ("a", "b", "c"):
   118	        out[pol] = twoway_ci([(k[0], k[1], v["orig"] - v[pol]) for k, v in cell.items()])
   119	    return out, len({k[0] for k in cell})
