   210	## 從後排（離自己底線近）、兩邊往中間拿掉戰鬥兵，直到空出 need 金；再把 k 隻支援兵照角色欄位擺上。
   211	static func with_supports(base: Army, sup: int, k: int) -> Army:
   212		var b: Army = base.copy()
   213		var need := k * D.cost(sup)
   214		var order := b.units.duplicate()
   215		order.sort_custom(func(p, q): return p["col"] < q["col"] or (p["col"] == q["col"] and absi(p["row"] - 4) > absi(q["row"] - 4)) or (p["col"] == q["col"] and absi(p["row"] - 4) == absi(q["row"] - 4) and p["row"] < q["row"]))
   216		for u in order:
   217			if b.left() >= need:
   218				break
   219			b.remove_at(u["col"], u["row"])
   220		var rng := RandomNumberGenerator.new()
   221		rng.seed = 1
   222		for j in k:
   223			F.place_styled(b, sup, "role", rng)
   224		return b
