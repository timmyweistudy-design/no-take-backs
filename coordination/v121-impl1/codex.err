   318	func _snap(name: String) -> void:
   319		if DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_MINIMIZED:
   320			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)   # 真的被縮下去就還原，否則永遠等不到繪製
   321		if shot_state.has("pad"):
   322			pad_mode = true   # V1.2.1：手把焦點狀態（焦點框畫在目前的按鈕上）
   323		queue_redraw()
   324		await get_tree().process_frame
   325		await get_tree().process_frame
   326		await RenderingServer.frame_post_draw
   327		var img := get_viewport().get_texture().get_image()
   328		img.save_png(shot_dir.path_join(name))
   329		print("SHOT ", name)
   330		if layout_probe:
   331			_layout_report(name, img)
   332	
