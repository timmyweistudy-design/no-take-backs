   536	func _draw_ban() -> void:
   537		var ts0: Array = RuleSet.types_of(rules.pool_of(0) | rules.pool_of(1))
   538		var P: Rect2 = _ban_panel(ts0.size())
   539		_panel(P)
   540		_box(P.grow(-3), Color(0, 0, 0, 0), Color("#b8393f"), 8.0, 3.0)   # 紅框：這裡是拿掉牌，不是選牌
   541		_h1(Vector2(640, 70), L.t("ban_title"))
   542		var who := L.t("blue") if ban_turn == 0 else L.t("red")
   543		_text(Vector2(640, 134), L.t("ban_turn", [who, ban_left[ban_turn]]), tz("H2"), Art.team_color(ban_turn, cbm()).lightened(0.2), true, true, 860)
   544		var ban_hot := -1
   545		for i in ts0.size():
   546			var t: int = ts0[i]
   547			var r: Rect2 = _ban_cell(i, ts0.size())
   548			var small: bool = ts0.size() > 10
   549			_btn(r, "", _ban.bind(t), true, false, TH_WOOD)
   550			if _brief_hot(r):
   551				ban_hot = t
   552			var nfs: int = tz("C") if small else tz("B")
   553			var nm: String = L.t("unit_%d" % t)
   554			var nh: float = text_h(nm, fit(nm, nfs, r.size.x - 16, true), r.size.x - 16, true)
   555			var ny: float = minf(76.0 if small else 116.0, r.size.y - nh - 8.0)   # V1.2.1：名字（含換行）從卡片底往上算（英文 150% 原本超出卡片）
   556			_unit_in(Rect2(r.position, Vector2(r.size.x, minf(74.0 if small else 112.0, ny - 2.0))), t, 0, 1.0, 0.72 if small else 1.05)
   557			_text(r.position + Vector2(r.size.x / 2, ny), L.t("unit_%d" % t), nfs, Color.WHITE, true, true, r.size.x - 16)
   558			if r.has_point(mouse) and not pad_mode:
   559				_icon("ban", r.position + Vector2(r.size.x / 2, 42 if small else 62), 60.0 if small else 84.0)
   560		_btn(Rect2(P.end.x - 110, 76, 96, 40), L.t("ban_skip"), _ban_skip)
   561		lobby_brief = _brief_pick(ts0, ban_hot)
   562		var last: Rect2 = _ban_cell(ts0.size() - 1, ts0.size())
   563		var by: float = last.end.y + 8
   564		_unit_brief(Rect2(P.position.x + 24, by, P.size.x - 48, P.end.y - by - 12), lobby_brief)
