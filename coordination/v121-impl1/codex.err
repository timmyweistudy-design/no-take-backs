   566	## ── 戰績 ──
   567	func _record_match(w: int) -> void:
   568		if armies.is_empty() or armies[0] == null:
   569			return
   570		var ug: Dictionary = Save.data.get("unit_games", {})
   571		var seen := {}
   572		for u in armies[0].units:
   573			seen[str(int(u["type"]))] = true
   574		if mode == Mode.DUEL and armies.size() > 1 and armies[1] != null:   # 第十輪 B4：雙人兩邊贏了都算勝場，場數也要兩邊算
   575			for u2 in armies[1].units:
   576				seen[str(int(u2["type"]))] = true
   577		for k in seen:
   578			ug[k] = int(ug.get(k, 0)) + 1
   579		Save.data["unit_games"] = ug
   580		if mode == Mode.DUEL:
   581			return    # 連勝只算單人
   582		if w == 0:
   583			Save.data["streak"] = int(Save.data.get("streak", 0)) + 1
   584			Save.data["best_streak"] = maxi(int(Save.data.get("best_streak", 0)), int(Save.data["streak"]))
   585		else:
   586			Save.data["streak"] = 0
   587	
   588	func _draw_profile() -> void:
   589		var P := Rect2(50, 24, 1180, 752)
   590		_panel(P)
   591		_h1(Vector2(640, 34), L.t("pf_title"))
   592		var st: Dictionary = Save.data.get("stats", {})
   593		var cs: Dictionary = Save.data.get("custom_stats", {})
   594		var g: int = int(st.get("games", 0)) + int(cs.get("games", 0))
   595		var wn: int = int(st.get("wins", 0)) + int(cs.get("wins", 0))
   596		var trial := 0
   597		for v in Save.data.get("trial_stars", {}).values():
   598			trial += int(v)
   599		var tiles := [["swords", "pf_games", str(g)], ["trophy", "pf_wins", "%d%%" % (wn * 100 / maxi(1, g))], ["repeat", "pf_streak", "%d / %d" % [int(Save.data.get("streak", 0)), int(Save.data.get("best_streak", 0))]],
   600			["tower", "pf_trials", "%d / %d" % [trial, TRIALS.size() * 3]], ["road", "pf_gauntlet", "%d / 7" % int(Save.data.get("gauntlet_best", 0))]]
   601		var tw := 212.0
   602		for i in tiles.size():
   603			var r := Rect2(78 + i * (tw + 8), 92, tw, 80)
   604			_box(r, Color(0, 0, 0, 0.24), Color(0, 0, 0, 0), 7.0)
   605			_icon(tiles[i][0], r.position + Vector2(30, 40), 34.0, ACCENT)
   606			_text(r.position + Vector2(56, 10), L.t(tiles[i][1]), tz("C"), TXT_DIM, false, false, tw - 62)
   607			_text(r.position + Vector2(56, 34), tiles[i][2], tz("H2"), Color.WHITE, false, true, tw - 62)
   608		# 兵種勝率
   609		_text(Vector2(80, 184), L.t("pf_units"), tz("B"), ACCENT, false, true, 600)
   610		var ug: Dictionary = Save.data.get("unit_games", {})
   611		var uw: Dictionary = Save.data.get("unit_wins", {})
   612		var um := RS.mask(_demo())
   613		var cw := 108.0
   614		for t in D.total():
   615			var r2 := Rect2(78 + (t % 10) * (cw + 4), 212 + (t / 10) * 116, cw, 110)
   616			_box(r2, Color(0, 0, 0, 0.2), Color(0, 0, 0, 0), 6.0)
   617			var open: bool = RuleSet.has(um, t)
   618			_unit_in(Rect2(r2.position, Vector2(cw, 70)), t, 0, 1.0 if open else 0.3, 0.62)
   619			var gg := int(ug.get(str(t), 0))
   620			if gg == 0:
   621				_text(r2.position + Vector2(cw / 2, 74), L.t("pf_none"), tz("C"), TXT_DIM, true, false, cw - 6)   # V1.1 C4：沒出戰不寫 0%
   622			else:
   623				_text(r2.position + Vector2(cw / 2, 68), "%d%%" % mini(100, int(uw.get(str(t), 0)) * 100 / gg), tz("B"), Color.WHITE, true, true, cw - 6)
   624			if gg > 0:
   625				pass
   626		# 成就
   627		var earned: Array = Save.data.get("achievements", [])
   628		var ach: Dictionary = SteamApi.ACHIEVEMENTS
   629		var keys := ach.keys()
   630		_text(Vector2(80, 448), L.t("pf_ach", [earned.size(), keys.size()]), tz("B"), ACCENT, false, true, 600)
   631		var hover_k := ""
   632		for i2 in keys.size():
   633			var k: String = keys[i2]
   634			var on: bool = k in earned
   635			var pos := Vector2(84 + (i2 % 3) * 372, 480 + (i2 / 3) * 30)
   636			var ar := Rect2(pos - Vector2(4, 1), Vector2(364, 26))
   637			if on:
   638				_box(ar, Color(1.0, 0.82, 0.4, 0.14), Color(1.0, 0.82, 0.4, 0.55), 4.0, 1.0)   # V1.1 C4：已解鎖加金框
   639			else:
   640				_box(ar, Color(0, 0, 0, 0.16), Color(1, 1, 1, 0.10), 4.0, 1.0)   # V1.2.1：未解鎖也有框（三欄對稱）
   641			if ar.has_point(mouse) and not pad_mode:
   642				hover_k = k
   643				_box(ar.grow(1), Color(0, 0, 0, 0), Color(ACCENT, 0.7), 5.0, 1.5)
   644			_icon("star" if on else "lock", pos + Vector2(10, 12), 20.0, Color("#ffd166") if on else Color(1, 1, 1, 0.3))
   645			_text(pos + Vector2(26, 0), str(L.pick(ach[k][0], ach[k][1])), tz("C"), Color.WHITE if on else TXT_DIM, false, false, 340)   # V1.2.1 F5：未解鎖原本 66% 白只有 1.7:1
   646		# V1.2.1：滑過成就，標題列右邊顯示解鎖條件（未解鎖的也看得到怎麼拿）
   647		var cond: String = L.t("pf_ach_hint") if hover_k == "" else str(L.pick(ACH_DESC.get(hover_k, ["", ""])[0], ACH_DESC.get(hover_k, ["", ""])[1]))
   648		var cw2 := 640.0
   649		_text(Vector2(1200 - minf(cw2, _width(cond, tz("S"))), 448 + (tz("B") - tz("S")) * 0.5), cond, tz("S"), TXT_DIM if hover_k == "" else Color.WHITE, false, false, cw2)
