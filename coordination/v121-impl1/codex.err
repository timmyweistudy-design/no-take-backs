   547	## V1.2.1 F5：彩色小字對深焦茶描邊至少 4.5:1；不夠就一點點提亮（依顏色快取）。
   548	static var _legible_cache := {}
   549	static func _legible(c: Color) -> Color:
   550		var k := c.to_html()
   551		if _legible_cache.has(k):
   552			return _legible_cache[k]
   553		var out := c
   554		for i in 12:
   555			if _wcag(out, INK) >= 4.5:
   556				break
   557			out = out.lightened(0.08)
   558		_legible_cache[k] = out
   559		return out
   560	
   561	static func _wcag(a: Color, b: Color) -> float:
   562		var f := func(v: float) -> float: return v / 12.92 if v <= 0.04045 else pow((v + 0.055) / 1.055, 2.4)
   563		var la: float = 0.2126 * f.call(a.r) + 0.7152 * f.call(a.g) + 0.0722 * f.call(a.b)
   564		var lb: float = 0.2126 * f.call(b.r) + 0.7152 * f.call(b.g) + 0.0722 * f.call(b.b)
   565		return (maxf(la, lb) + 0.05) / (minf(la, lb) + 0.05)
   566	
   567	## V1.2：紙上墨色。灰白字→焦茶墨；亮彩字（金、綠、紅）壓暗成同色系的深色，透明度保留。
   568	static func _ink(c: Color) -> Color:
