   570		if lum < 0.45:
   571			return c
   572		var a := c.a if c.a < 0.45 else maxf(c.a, 0.85)   # V1.2.1 F5：紙上墨字至少 85%；很淡的裝飾（空星）保持淡
   573		if c.s < 0.25:
   574			return Color(INK, a)
   575		return Color(c.darkened(0.74), a)
