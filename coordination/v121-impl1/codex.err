+	var a := c.a if c.a < 0.45 else maxf(c.a, 0.85)   # V1.2.1 F5：紙上墨字至少 85%；很淡的裝飾（空星）保持淡
 	if c.s < 0.25:
-		return Color(INK, c.a)
-	return Color(c.darkened(0.58), c.a)
+		return Color(INK, a)
+	return Color(c.darkened(0.74), a)
 
