   387	## V1.2.1 E1：四條音量套用並試聽那一軌（sample＝""不試聽、"amb"＝放 1.5 秒森林環境音）。
   388	func _apply_volumes(sample: String) -> void:
   389		if sfx == null:
   390			return
   391		sfx.set_volumes(int(Save.s("sfx")), int(Save.s("music")), int(Save.s("ui_vol")), int(Save.s("amb_vol")))
   392		if sample == "amb":
   393			if sfx.amb_name == "":
   394				sfx.play_ambience("forest")
   395				get_tree().create_timer(1.5).timeout.connect(func():
   396					if sfx != null and state != St.BATTLE:
   397						sfx.play_ambience(""))
   398		elif sample != "":
   399			sfx.play(sample)
