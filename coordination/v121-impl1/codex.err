   527	## 結果頁摘要第一行（勝負原因・時間｜剩餘戰力）；緞帶高度和正文共用（V1.2）。
   528	func _result_line1(maxw := 0.0) -> String:
   529		var reason_key := {"全滅": "reason_wipe", "同時全滅": "reason_bothwipe", "時間到・戰力相當": "reason_time_even",
   530			"時間到・剩餘戰力較高": "reason_time_power", "有一方沒有兵": "reason_empty"}
   531		var p0 := roundi(sim.power(0) * 100.0 / (sim.budget_of(0) * 1000))
   532		var p1 := roundi(sim.power(1) * 100.0 / (sim.budget_of(1) * 1000))
   533		var a := "%s・%.1fs" % [L.t(reason_key.get(sim.reason, "draw")), sim.tick / 20.0]
   534		var b := L.t("power_left", [p0, p1])
   535		var one := "%s　｜　%s" % [a, b]
   536		# V1.2.1 B1：放不下就在「｜」那裡分兩行（原因／戰力），不讓百分比孤零零掉到下一行
   537		if maxw > 0.0 and _width(one, tz("S")) > maxw:
   538			return a + "\n" + b
   539		return one
   165		var stars: Dictionary = Save.data.get("trial_stars", {})
   166		var pages: int = ceili(TRIALS.size() / float(TRIAL_PAGE))
   167		trial_page = clampi(trial_page, 0, pages - 1)
   168		# 第十三輪：30 關分 3 頁
   169		var tot := 0
   170		for k0 in TRIALS.size():
   171			tot += int(stars.get(str(k0), 0))
   172		_text(Vector2(184, 710), L.t("trial_page", [trial_page + 1, pages, tot, TRIALS.size() * 3]), tz("S"), TXT_DIM, false, false, 360)
   173		var cw := 524.0
   174		var ch := 98.0
   175		for k in TRIAL_PAGE:
   176			var i: int = trial_page * TRIAL_PAGE + k
   177			if i >= TRIALS.size():
   178				break
   179			var t: Array = TRIALS[i]
   180			var x := trial_x(i)
   181			var r := Rect2(116 + (k % 2) * (cw + 8), 164 + (k / 2) * (ch + 7), cw, ch)
   182			var got := int(stars.get(str(i), 0))
   183			btn_paper = got > 0   # V1.2.1 R1：過關的試煉卡是紙面
   184			_btn(r, "", _start_trial.bind(i), not _demo() or i in Presets.DEMO_TRIALS, false, TH_WOOD)
   185			btn_paper = false
   186			_ink_mode = got > 0 and not plain_ui_now() and (not _demo() or i in Presets.DEMO_TRIALS)
   187			call("_map_thumb", Rect2(r.position + Vector2(8, 8), Vector2(136, 84)), int(t[0]), int(t[1]))
   188			_text(r.position + Vector2(154, 8), "%d. %s" % [i + 1, trial_name(i)], tz("B"), Color.WHITE, false, true, cw - 240)
   189			var sz := "%s %d×%d" % [L.t("map_size_%d" % int(t[1])), MapDefs.SIZES[t[1]][0], MapDefs.SIZES[t[1]][1]]
   190			var diff: String = L.t(["diff_easy", "diff_normal", "diff_hard"][int(t[3])])
   191			# 第十三輪新關：第二行放主題規則＋難度（地圖看縮圖就知道），第三行只放星數條件，150% 字級才排得下
   192			var line2: String = "%s・%s・%s" % [sz, L.t("ai_style_%d" % int(t[2])), diff]
   193			if x.has("tag_zh"):
   194				line2 = L.t("name_sep_fmt", [L.field(x, "tag"), diff])
   195			_text(r.position + Vector2(154, 8 + tz("B") * 1.4), line2, tz("C"), TXT_DIM, false, false, cw - 160)
   196			var tb: int = int(x["budget"]) if x.has("budget") else int(MapDefs.SIZE_SUGGEST[int(t[1])][0])
   197			# V1.1 C3：條件改成「圖示＋數字」（♥ 剩餘戰力、金幣 花費），不寫長句
   198			var cy0: float = r.position.y + 8 + tz("B") * 1.4 + tz("C") * 1.35
   199			var cx0: float = r.position.x + 154
   200			_icon("heart", Vector2(cx0 + 9, cy0 + tz("C") * 0.62), 16.0, ACCENT)
   201			var c1s := "≥%d%%" % trial_rem(i)
   202			_text(Vector2(cx0 + 22, cy0), c1s, tz("C"), ACCENT, false, true, 120)
   203			var cx1: float = cx0 + 34 + font_bold.get_string_size(c1s, HORIZONTAL_ALIGNMENT_LEFT, -1, tz("C")).x
   204			_icon("coin", Vector2(cx1 + 9, cy0 + tz("C") * 0.62), 16.0, ACCENT)
   205			_text(Vector2(cx1 + 22, cy0), "≤%d" % (tb * trial_spend_pct(i) / 100), tz("C"), ACCENT, false, true, 120)
   206			for k2 in 3:
   207				_icon("star", r.position + Vector2(cw - 66 + k2 * 22, 20), 20.0, Color("#ffd166") if k2 < got else Color(1, 1, 1, 0.16))
   208			_ink_mode = false
   209		# 翻頁鈕放在關卡卡片後面：手把焦點先落在第一關（版面檢查 PADWALK）
   210		_btn(Rect2(116, 700, 52, 44), "◀", func(): trial_page -= 1, trial_page > 0 and not _demo())
   211		_btn(Rect2(1112, 700, 52, 44), "▶", func(): trial_page += 1, trial_page < pages - 1 and not _demo())
   212		_btn(Rect2(560, 700, 160, 44), L.t("back"), func(): overlay = "")
