   580		var hover := r.has_point(mouse) and not pad_mode
   581		var focus := pad_mode and idx == _focus
   582		var bg := TH_WOOD_L if not primary else TH_PRIMARY
   583		if tint.a > 0:
   584			bg = tint
   585		if not enabled:
   586			bg = Color(0.2, 0.17, 0.15)
   587		elif hover or focus:
   588			bg = bg.lightened(0.16)
   589			if hover:
   590				_hover_now = idx
   591		var pressed := hover and enabled and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
   592		var rd := r.grow(-minf(r.size.x, r.size.y) * 0.025) if pressed else r
   593		# V1.2 B3：按鈕下緣 3px 厚度（木牌的側面）；按下時往下沉、厚度消失
   594		var solid: bool = tint.a <= 0.0 or tint.a > 0.6
   595		if solid and r.size.y >= 20.0:
   596			# 厚度畫在按鈕框內（下緣 3px），命中框、探針與畫面一致（Codex v120-impl2）；按下時面板往下壓、厚度被蓋住
   597			_box(Rect2(rd.position, rd.size), Color(bg.darkened(0.55), 1.0), Color(0, 0, 0, 0), 7.0)
   598			rd = Rect2(rd.position + Vector2(0, 3.0 if pressed else 0.0), rd.size - Vector2(0, 3))
   599		var paper_face := btn_paper and enabled and not bool(Save.s("plain_ui"))
   600		if paper_face:
   601			# V1.2.1 R1：紙面卡片（例如已過關的殘局）；懸停時紙變亮
   602			_tex_box(rd, "paper", Color(1.12, 1.1, 1.04) if (hover or focus) else Color.WHITE)
   603			_box(rd, Color(0, 0, 0, 0), TH_EDGE.darkened(0.25), 7.0, 1.5)
   604		else:
   605			_box(rd, bg, TH_EDGE.darkened(0.25) if solid else Color(0, 0, 0, 0), 7.0, 1.5)
   606		if (tint.a <= 0.0 or tint.a > 0.6) and not paper_face:
   607			draw_line(rd.position + Vector2(6, 1.5), rd.position + Vector2(rd.size.x - 6, 1.5), Color(1, 1, 1, 0.16), 1.5)
   608			draw_line(rd.position + Vector2(6, rd.size.y - 1.5), rd.end - Vector2(6, 1.5), Color(0, 0, 0, 0.3), 2.0)
   609		if pressed:
   610			for k in 3:   # V1.2.1 R2：按下時上緣內陰影（像被壓進去）
   611				draw_rect(Rect2(rd.position + Vector2(3, 2 + k * 2.0), Vector2(rd.size.x - 6, 2.0)), Color(0, 0, 0, 0.22 - k * 0.07))
   612		if primary and enabled:
   613			_btn_shine(rd)
   614		if (focus or hover) and enabled and not plain_ui_now():
   615			# V1.2.1 R2：滑鼠懸停與手把焦點同一種樣式：深邊＋金亮邊（深邊讓金框在紙上也看得到，Codex v121-r2）
   616			_box(rd.grow(2.5), Color(0, 0, 0, 0), Color(INK, 0.7), 9.0, 1.5)
   617			_box(rd.grow(1), Color(0, 0, 0, 0), Color(ACCENT, 0.95 if focus else 0.75), 8.0, 2.5)
   618		elif focus:
   619			_box(rd.grow(1), Color(0, 0, 0, 0), ACCENT, 8.0, 3.0)
   620		if layout_probe:
   621			probe_btns.append(r)
   622			if label == "":
   623				probe_ctrls.append(r)   # 空白標籤的按鈕（卡片、頁籤）：裡面自己畫的字算按鈕內容
   624		var sz := fit(label, ts(18) if r.size.y >= 40 else ts(15), r.size.x - 10, primary)
   625		var lines := wrap_lines(label, sz, r.size.x - 10, primary)
   626		var h := lines.size() * sz * line_h(lines.size())
   627		_probe_btn_label = true   # 版面檢查：這段是按鈕自己的標籤（不用位置猜，Antigravity 實作第 2 輪抓到猜錯的情況）
   628		_probe_btn_rect = r
   629		var ink0 := _ink_mode   # 按鈕是木頭，字維持白色（紙面按鈕用墨色）
   630		_ink_mode = paper_face
   631		_text(r.get_center() - Vector2(0, h / 2 - sz * 0.03), "\n".join(lines), sz, Color.WHITE if enabled else Color(1, 1, 1, 0.4), true, primary)
   632		_ink_mode = ink0
   633		_probe_btn_label = false
   634	
   635	static func plain_ui_now() -> bool:
   636		return bool(Save.s("plain_ui"))
   637	
   638	## 主按鈕的流光（可關）。
   639	func _btn_shine(r: Rect2) -> void:
   640		if bool(Save.s("reduce_fx")):
   641			return
   642		var k := fposmod(time * 0.45, 1.0)
   643		if k > 0.5:
   644			return
   645		var x: float = r.position.x + (r.size.x + 60.0) * (k * 2.0) - 30.0
   646		# V1.2：斜的、窄的、淡的流光（直的半透明帶在截圖裡像破圖）
   647		var sk := r.size.y * 0.5
   648		var pts := PackedVector2Array([Vector2(x, r.end.y - 3), Vector2(x + 14, r.end.y - 3), Vector2(x + 14 + sk, r.position.y + 3), Vector2(x + sk, r.position.y + 3)])
   649		var clip := PackedVector2Array()
   650		for pp in pts:
   651			clip.append(Vector2(clampf(pp.x, r.position.x + 3, r.end.x - 3), pp.y))
   652		if clip[1].x > clip[0].x or clip[2].x > clip[3].x:
   653			draw_colored_polygon(clip, Color(1, 1, 1, 0.09))
   654	
   655	## V1.2 B3：材質貼圖（tools/gen/gen_ui_tex.py 生成）。木紋是灰階，用原本的底色染，配色不變、多了木紋與上亮下暗的斜角。
   656	const TEX_WOOD := "res://art/ui/wood.png"
   657	const TEX_FRAME := "res://art/ui/frame.png"
   658	const TEX_GROOVE := "res://art/ui/groove.png"
   659	const TEX_PAPER := "res://art/ui/paper.png"
   660	var _tex_cache := {}
   661	
   662	func _ui_tex(path: String) -> Texture2D:
   663		if not _tex_cache.has(path):
   664			_tex_cache[path] = load(path) if ResourceLoader.exists(path) else null
   665		if _tex_cache[path] == null and layout_probe and not path in probe_missing:
   666			probe_missing.append(path)
   667		return _tex_cache[path]
   668	
   669	## V1.2：頂部資訊列：深木紋＋下緣一條亮線與落影（沒有貼圖時照舊平塗）。
   670	func _hud_bar(r: Rect2) -> void:
   671		if bool(Save.s("plain_ui")) or not _tex_box(r.grow_individual(8, 8, 8, 0), "wood", Color(0.3, 0.21, 0.15, 0.97)):
   672			draw_rect(r, UI_BG)
   673			return
   674		draw_rect(Rect2(r.position.x, r.end.y - 2, r.size.x, 2), Color(0.55, 0.42, 0.28, 0.9))
   675		draw_rect(Rect2(r.position.x, r.end.y, r.size.x, 4), Color(0, 0, 0, 0.25))
   676	
   677	## V1.2：木製框（九宮格、四角銅釘、中間透明），面板、戰場、大廳沙盤預覽共用。grow＝往外擴多少。
   678	func _wood_frame(r: Rect2, grow := 8.0, key := "frame") -> void:
   679		var fx := _ui_tex(TEX_FRAME)
   680		if fx == null or bool(Save.s("plain_ui")):
   681			return
   682		var sb: StyleBoxTexture = _sb_cache.get(key)
   683		if sb == null:
   684			sb = StyleBoxTexture.new()
   685			sb.texture = fx
   686			for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
   687				sb.set_texture_margin(side, 22.0)
   688			sb.draw_center = false
   689			_sb_cache[key] = sb
   690		draw_style_box(sb, r.grow(grow))
   691	
   692	## 材質方塊：kind＝wood（染色）／groove（染色）／paper（原色）。沒有貼圖時退回平塗。
   693	func _tex_box(r: Rect2, kind: String, tint := Color.WHITE) -> bool:
   694		var path: String = {"wood": TEX_WOOD, "groove": TEX_GROOVE, "paper": TEX_PAPER}[kind]
   695		var tx := _ui_tex(path)
   696		if tx == null:
   697			return false
   698		tint = qcol(tint)   # V1.2.1 F1：量化後當鍵，淡出時不會每幀多一個樣式
   699		var k := "t|%s|%s" % [kind, tint.to_html()]
   700		var sb: StyleBoxTexture = _sb_cache.get(k)
   701		if sb == null:
   702			_sb_room()
   703			sb = StyleBoxTexture.new()
   704			sb.texture = tx
   705			var m := 10.0 if kind != "paper" else 14.0
   706			sb.texture_margin_left = m
   707			sb.texture_margin_right = m
   708			sb.texture_margin_top = m
   709			sb.texture_margin_bottom = m
   710			# 羊皮紙整張拉伸（紋理不能無縫平鋪，平鋪會出現直條接縫）；木紋、凹槽平鋪保持紋理比例
   711			var mode := StyleBoxTexture.AXIS_STRETCH_MODE_STRETCH if kind == "paper" else StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
   712			sb.axis_stretch_horizontal = mode
   713			sb.axis_stretch_vertical = mode
   714			sb.modulate_color = tint
   715			_sb_cache[k] = sb
   716		draw_style_box(sb, r)
   717		if layout_probe and minf(r.size.x, r.size.y) >= 20.0:
   718			probe_boxes.append(r)   # V1.2.1 F1：九宮格外圈斜邊，字不能壓進去
   719		return true
   720	
   721	## V1.2.1 F1：樣式快取的顏色量化（透明度 16 級、RGB 8 位元），鍵和實際樣式用同一個值。
   722	static func qcol(c: Color) -> Color:
   723		return Color(roundf(c.r * 255.0) / 255.0, roundf(c.g * 255.0) / 255.0, roundf(c.b * 255.0) / 255.0, roundf(clampf(c.a, 0.0, 1.0) * 15.0) / 15.0)
   724	
   725	const SB_CACHE_MAX := 512
   726	## 快取滿了整個清掉（用到再建；每個樣式只是幾個欄位，重建很便宜）。
   727	func _sb_room() -> void:
   728		if _sb_cache.size() >= SB_CACHE_MAX:
   729			_sb_cache.clear()
   730	
   731	## 圓角方塊（StyleBox 快取，不每幀配新物件）。
   732	## V1.2 B3：夠大、夠不透明的實心方塊改用木紋材質（用 bg 染色），外框線另外畫在上面；小東西與半透明的陰影維持平塗。
   733	func _box(r: Rect2, bg: Color, border := Color(0, 0, 0, 0), radius := 6.0, bw := 0.0) -> void:
   734		if bg.a >= 0.6 and minf(r.size.x, r.size.y) >= 20.0 and not bool(Save.s("plain_ui")) and _tex_box(r, "wood", Color(bg.r * 1.28, bg.g * 1.28, bg.b * 1.28, bg.a)):
   735			if bw > 0.0 and border.a > 0.0:
   736				_box(r, Color(0, 0, 0, 0), border, radius, bw)
   737			return
   738		draw_style_box(_flat_sb(bg, border, radius, bw), r)
   739	
   740	## 平塗方塊的樣式（量化後快取；測試可以直接呼叫，不必在繪製階段）。
   741	func _flat_sb(bg: Color, border: Color, radius: float, bw: float) -> StyleBoxFlat:
   742		bg = qcol(bg)
   743		border = qcol(border)
   744		var k := "%s|%s|%d|%d" % [bg.to_html(), border.to_html(), int(radius), int(bw * 10)]
   745		var sb: StyleBoxFlat = _sb_cache.get(k)
   746		if sb == null:
   747			_sb_room()
   748			sb = StyleBoxFlat.new()
   749			sb.bg_color = bg
   750			sb.border_color = border
   751			sb.set_corner_radius_all(int(radius))
   752			sb.set_border_width_all(int(ceilf(bw)))
   753			sb.anti_aliasing = true
   754			_sb_cache[k] = sb
   755		return sb
   756	
   757	## V1.2 C2：8 格刻印能力條（取代細長滑桿）：凹槽底＋一格一格填色，最後一格依比例部分填。
   758	func _seg_bar(r: Rect2, frac: float, col: Color, segs := 8) -> void:
   759		var gap := 2.0
   760		var sw := (r.size.x - gap * (segs - 1)) / segs
   761		var filled := clampf(frac, 0.0, 1.0) * segs
   762		for i in segs:
   763			var sr := Rect2(r.position.x + i * (sw + gap), r.position.y, sw, r.size.y)
   764			draw_rect(sr, Color(0.06, 0.04, 0.03, 0.75))
   765			draw_rect(Rect2(sr.position, Vector2(sw, 1.0)), Color(0, 0, 0, 0.5))
   766			var f := clampf(filled - i, 0.0, 1.0)
   767			if f > 0.0:
   768				var fr := Rect2(sr.position + Vector2(1, 1), Vector2((sw - 2.0) * f, sr.size.y - 2.0))
   769				draw_rect(fr, col)
   770				draw_rect(Rect2(fr.position, Vector2(fr.size.x, maxf(1.0, fr.size.y * 0.35))), Color(1, 1, 1, 0.28))
   771	
   772	const ICON_SOLID := ["people", "cards", "robot", "gear", "shield", "heart", "star", "lock", "trophy", "flag", "skull", "book", "puzzle", "tower", "dice", "save"]   # 有實心面、放得下高光點的圖示
   773	
   774	func _icon(name: String, c: Vector2, s: float, col := Color.WHITE) -> void:
   775		# V1.2 B4：圖示加深焦茶落影（像印上去的刻印），不再是平貼的單色圖形
   776		if _ink_mode:
   777			col = _ink(col)
   778		if col.a > 0.3 and s >= 14.0 and not bool(Save.s("plain_ui")) and not _ink_mode:   # 紙上的墨色圖示不厚塗（會糊成一團，Antigravity impl4）
   779			# V1.2 B4：Q 版厚塗刻印 ── 深焦茶粗外框（8 方向剪影）＋落影＋右下深一階的厚度（雙色塊）＋實心圖示左上高光點
   780			var ow := maxf(1.2, s * 0.06)
   781			var off := maxf(1.0, s * 0.07)
   782			Icons.force = Color(INK, col.a * 0.7)
   783			Icons.draw(self, name, c + Vector2(off, off) * 1.4, s, Icons.force)
   784			Icons.force = Color(INK, col.a)
   785			for k in 4:   # 四個斜角就夠成粗框（8 方向每幀太貴）
   786				var d := Vector2.from_angle(PI / 4.0 + k * TAU / 4.0) * ow * 1.15
   787				Icons.draw(self, name, c + d, s, Icons.force)
   788			var dk := Color(col.darkened(0.35), col.a)
   789			Icons.force = dk
   790			Icons.draw(self, name, c + Vector2(ow, ow) * 0.6, s, dk)
   791			Icons.force = Color(0, 0, 0, 0)
   792			Icons.draw(self, name, c, s, col)
   793			if name in ICON_SOLID:
   794				draw_circle(c + Vector2(-s * 0.2, -s * 0.22), maxf(1.2, s * 0.06), Color(1, 0.98, 0.9, 0.55 * col.a), true, -1.0, true)
   795			return
   796		Icons.draw(self, name, c, s, col)
   797	
   798	## 羊皮紙標題緞帶：畫面標題統一用它。
   799	func _h1(center: Vector2, s: String, maxw := 0.0) -> void:
   800		var sz := tz("H1")
   801		var w := minf(_width(s, sz, true) + 72.0, maxw if maxw > 0.0 else 900.0)
   802		var r := Rect2(center.x - w / 2, center.y - 2, w, sz * 1.45)
   803		var notch := 14.0
   804		for sgn in [-1.0, 1.0]:
   805			var ex: float = r.position.x if sgn < 0 else r.end.x
   806			draw_colored_polygon(PackedVector2Array([Vector2(ex - sgn * 4, r.position.y + 6), Vector2(ex + sgn * 20, r.position.y + 6), Vector2(ex + sgn * (20 - notch), r.get_center().y + 3), Vector2(ex + sgn * 20, r.end.y + 2), Vector2(ex - sgn * 4, r.end.y + 2)]), TH_PARCH.darkened(0.28))
   807		_box(r, TH_PARCH, TH_PARCH.darkened(0.45), 4.0, 2.0)
   808		_text(center + Vector2(0, sz * 0.07), s, sz, TH_INK, true, true, maxf(w - 20.0, 100.0))
   809	
   810	## 安靜的小按鈕（第七輪 N6）：點擊框維持可點的大小，平常只畫一個小記號，滑過才亮。
   811	func _btn_quiet(r: Rect2, label: String, action: Callable) -> void:
   812		var idx := _btns.size()
   813		_btns.append({"r": r, "cb": action, "en": true})
   814		var hot := (r.has_point(mouse) and not pad_mode) or (pad_mode and idx == _focus)
   815		var c := r.end - Vector2(12, 12)
   816		draw_circle(c, 9.0, Color(ACCENT, 0.9) if hot else Color(0, 0, 0, 0.55), true, -1.0, true)
   817		if layout_probe:
   818			probe_btns.append(r)
   819			probe_ctrls.append(r)
   820		var sz := ts(14)
   821		_probe_btn_label = true
   822		_probe_btn_rect = r
   823		_text(c - Vector2(0, sz * 0.62), label, sz, Color.BLACK if hot else TXT_DIM, true, true)
   824		_probe_btn_label = false
   825	
   826	
   827	## ── 輸入命令佇列（第三輪 A2）──
   828	## 輸入事件不再直接執行，也不在 _draw 裡派發：先排進佇列，在 _process 開頭依序處理。
   829	## 每個命令記下排入時的「畫面世代」；畫面（狀態、覆蓋層、模式）一換，舊命令就丟掉，避免點到下一個畫面的按鈕。
   830	## 點擊只對「這個世代畫出來的按鈕」有效（_btns_gen）。
   831	func _enqueue(kind: String, data) -> void:
   832		_cmds.append({"kind": kind, "data": data, "gen": _gen})
   833	
   834	func _update_gen() -> void:
   835		var key := "%d|%s|%d" % [state, overlay, mode]
   836		if key != _gen_key:
   837			_gen_key = key
   838			_gen += 1
   839	
   840	
   105	## 「要讀的文字」段數超過上限（控制項＝按鈕、兵卡裡的字不算）。
   106	const TEXT_BUDGET := {"02_place.png": 30, "17_place_new.png": 30, "05_result.png": 20, "10_codex.png": 30, "19_codex_new.png": 30,
   107		"22_lobby.png": 25, "25_lobby_duel.png": 25, "08_settings.png": 25, "01_title.png": 12}
   108	
   109	## V1.2.1 F5：WCAG 相對亮度（線性 sRGB）與對比。
   110	static func rel_lum(c: Color) -> float:
   111		var f := func(v: float) -> float: return v / 12.92 if v <= 0.04045 else pow((v + 0.055) / 1.055, 2.4)
   112		return 0.2126 * f.call(c.r) + 0.7152 * f.call(c.g) + 0.0722 * f.call(c.b)
   113	
   114	static func contrast(a: Color, b: Color) -> float:
   115		var la := rel_lum(a)
   116		var lb := rel_lum(b)
   117		return (maxf(la, lb) + 0.05) / (minf(la, lb) + 0.05)
   118	
   119	## 從截圖取一段字的背景色：字框內取樣，去掉像字色、像描邊色的像素，剩下的取亮度中位數。
   120	## 背景像素不到 15% 回傳 null（背景未知＝不能算通過）。
   121	static func text_bg(img: Image, r: Rect2, c: Color, oc: Color, sx: float, sy: float):
   122		var x0 := clampi(int(r.position.x * sx), 0, img.get_width() - 1)
   123		var y0 := clampi(int(r.position.y * sy), 0, img.get_height() - 1)
   124		var x1 := clampi(int(r.end.x * sx), 0, img.get_width() - 1)
   125		var y1 := clampi(int(r.end.y * sy), 0, img.get_height() - 1)
   126		if x1 <= x0 or y1 <= y0:
   127			return null
   128		var step := maxi(1, int(sqrt(float((x1 - x0) * (y1 - y0)) / 500.0)))
   129		var all := 0
   130		var bg: Array = []
   131		var y := y0
   132		while y <= y1:
   133			var x := x0
   134			while x <= x1:
   135				var p := img.get_pixel(x, y)
   136				all += 1
   137				var dc := absf(p.r - c.r) + absf(p.g - c.g) + absf(p.b - c.b)
   138				var do := absf(p.r - oc.r) + absf(p.g - oc.g) + absf(p.b - oc.b) if oc.a > 0.0 else 9.0
   139				if dc > 0.30 and do > 0.30:
   140					bg.append(p)
   141				x += step
   142			y += step
   143		if all == 0 or float(bg.size()) / all < 0.15:
   144			# 小字（例如單一數字）字框裡幾乎都是字：改取字框外圍一圈當背景
   145			bg = []
   146			for k in 24:
   147				var a := k * TAU / 24.0
   148				var pp := r.get_center() + Vector2(cos(a) * (r.size.x / 2.0 + 3.0), sin(a) * (r.size.y / 2.0 + 3.0))
   149				var px := clampi(int(pp.x * sx), 0, img.get_width() - 1)
   150				var py := clampi(int(pp.y * sy), 0, img.get_height() - 1)
   151				var p2 := img.get_pixel(px, py)
   152				if absf(p2.r - c.r) + absf(p2.g - c.g) + absf(p2.b - c.b) > 0.30:
   153					bg.append(p2)
   154			if bg.size() < 8:
   155				return null
   156		bg.sort_custom(func(a, b): return rel_lum(a) < rel_lum(b))
   157		return bg[bg.size() / 2]
   158	
   159	## 一段字是否算大字（WCAG：24px 以上，或粗體 18.66px 以上；以 1280×800 顯示尺寸算）。
   160	static func large_text(size: int, bold: bool) -> bool:
   161		return size >= 24 or (bold and size >= 19)
   162	
   163	## F5：截圖上的文字對比。有足夠描邊的字比「字對描邊」，其他比「字對背景」（半透明字先疊在背景上）。
   164	func _contrast_issues(img: Image) -> Dictionary:
   165		var bad: Array = []
   166		var warn: Array = []
   167		if img == null:
   168			return {"bad": bad, "warn": warn}
   169		var sx := img.get_width() / 1280.0
   170		var sy := img.get_height() / 800.0
   171		for t in probe_texts:
   172			if t.get("field", false) or not t.has("c"):
   173				continue
   174			var c: Color = t["c"]
   175			var oc: Color = t["oc"]
   176			var size := int(t["size"])
   177			var need := 3.0 if large_text(size, bool(t.get("bold", false))) else 4.5
   178			var outlined: bool = oc.a >= 0.6 and float(t["ow"]) >= float(text_outline_w(size)) * 0.9
   179			var bgc = text_bg(img, t["r"], c, oc, sx, sy)
   180			var ratio := 0.0
   181			if outlined:
   182				ratio = contrast(c, oc)
   183			elif bgc == null:
   184				bad.append({"type": "背景未知", "s": t["s"]})
   185				continue
   186			else:
   187				var eff := Color(c.r * c.a + bgc.r * (1.0 - c.a), c.g * c.a + bgc.g * (1.0 - c.a), c.b * c.a + bgc.b * (1.0 - c.a))
   188				ratio = contrast(eff, bgc)
   189			if ratio >= need:
   190				continue
   191			var item := {"type": "對比不足", "s": t["s"], "ratio": snappedf(ratio, 0.01), "need": need}
   192			if c.a < 0.5 or (t.get("btn", false) and c.a < 0.45):
   193				warn.append(item)   # 停用、淡化裝飾字另報（WCAG 豁免停用元件）
   194			else:
   195				bad.append(item)
   196		return {"bad": bad, "warn": warn}
   197	
   198	func _layout_report(name: String, img: Image = null) -> void:
   199		var bad: Array = []
   200		var cres := _contrast_issues(img)
   201		bad.append_array(cres["bad"])
   202		for mp in probe_missing:
   203			bad.append({"type": "缺圖", "s": mp})   # V1.2.1：材質缺檔不能默默退回平塗
   204		for b in _btns:     # 第十輪 T5：按鈕不能跑出畫面（手把焦點會走到看不見的地方）
   205			if not Rect2(0, 0, 1280, 800).encloses(b["r"]):
   206				bad.append({"type": "按鈕超出畫面", "s": name, "r": str(b["r"])})
   207		var sizes: Array = []
   208		var ui_n := 0
   209		var free_n := 0
   210		var ctrls: Array = probe_btns + probe_ctrls
   211		for t in probe_texts:
   212			var r: Rect2 = t["r"]
   213			var sz := int(t["size"])
   214			if t.get("field", false):
   215				if sz < 14:
   216					bad.append({"type": "戰場字太小", "s": t["s"], "size": sz})
   217				if r.position.x < -2 or r.end.x > 1282 or r.position.y < -2 or r.end.y > 802:
   218					bad.append({"type": "戰場字越界", "s": t["s"], "r": str(r)})
   219				continue
   220			ui_n += 1
   221			sizes.append(sz)
   222			var in_ctrl: bool = t.get("btn", false)
   223			for c in probe_ctrls:
   224				if c.grow(1.0).encloses(r):
   225					in_ctrl = true   # 整段字都在卡片／空白標籤按鈕裡＝控制項內容
   226					break
   227			if not in_ctrl:
   228				free_n += 1
   229			if r.position.x < -2 or r.end.x > 1282 or r.position.y < -2 or r.end.y > 802:
   230				bad.append({"type": "越界", "s": t["s"], "r": str(r)})
   231			if sz < tz("C") and not t.get("glyph", false):
   232				bad.append({"type": "小於字級表下限", "s": t["s"], "size": sz})
   233			if not size_ok(sz) and not t.get("glyph", false):
   234				bad.append({"type": "表外字級", "s": t["s"], "size": sz})
   235		for a in probe_texts.size():
   236			if probe_texts[a].get("field", false):
   237				continue
   238			for b in range(a + 1, probe_texts.size()):
   239				if probe_texts[b].get("field", false):
   240					continue
   241				var ra: Rect2 = probe_texts[a]["r"]
   242				var rb: Rect2 = probe_texts[b]["r"]
   243				var x := ra.intersection(rb)
   244				if not x.has_area():
   245					continue
   246				var ratio := x.get_area() / maxf(1.0, minf(ra.get_area(), rb.get_area()))
   247				if ratio <= 0.15:
   248					continue
   249				if probe_texts[a]["s"] != probe_texts[b]["s"]:
   250					bad.append({"type": "重疊", "a": probe_texts[a]["s"], "b": probe_texts[b]["s"], "ratio": snappedf(ratio, 0.01)})
   251				elif ra.position.distance_to(rb.position) > 2.0:
   252					bad.append({"type": "相同字串重疊", "s": probe_texts[a]["s"], "ratio": snappedf(ratio, 0.01)})
   253		# V1.2.1 F1：字壓進九宮格外圈斜邊（3px）——字的中心在方塊內、但字框跨進斜邊帶
   254		for t in probe_texts:
   255			if t.get("field", false) or t.get("btn", false):   # 按鈕標籤另外檢查（要在自己的框內）
   256				continue
   257			var tr2: Rect2 = t["r"]
   258			var cc := tr2.get_center()
   259			var best := Rect2()   # 只看包住字中心的最小方塊（緞帶標題跨在木條上時，算緞帶自己的框）
   260			for bx in probe_boxes:
   261				if bx.grow(-2.0).has_point(cc) and (not best.has_area() or bx.get_area() < best.get_area()):
   262					best = bx
   263			if best.has_area() and not best.grow(-2.0).encloses(tr2.grow(-2.0)) and best.encloses(tr2.grow(-4.0)):   # 字框含描邊與行高，內縮 2px 才是字形
   264				bad.append({"type": "字壓到九宮格邊", "s": t["s"], "box": str(best)})
   265			# 第七輪 I3：按鈕框互撞（重疊但不是一個包住另一個）
   266		for bi in probe_btns.size():
   267			for bj in range(bi + 1, probe_btns.size()):
   268				var r1: Rect2 = probe_btns[bi]
   269				var r2: Rect2 = probe_btns[bj]
   270				var inter := r1.intersection(r2)
   271				if inter.get_area() > 6.0 and not r1.encloses(r2) and not r2.encloses(r1):
   272					bad.append({"type": "按鈕互撞", "a": str(r1), "b": str(r2)})
   273		for r in probe_btns:
   274			if r.size.x < 36.0 or r.size.y < 36.0:   # 方案 §5.3：點擊框 ≥36px
   275				bad.append({"type": "點擊框太小", "r": str(r)})
   276		# 第五輪（Antigravity 實作第 1 輪抓到自動檢查漏的）：按鈕外的文字壓到按鈕上
   277		for t in probe_texts:
   278			if t.get("field", false):
   279				continue
   280			var tr: Rect2 = t["r"]
   281			if t.get("btn", false):
   282				# 按鈕標籤：只豁免它自己的按鈕；要完整落在自己的框內，也不能壓到別顆按鈕（Codex 實作第 2 輪）
   283				var own: Rect2 = t.get("own", Rect2())
   284				if own.has_area() and not own.grow(2.0).encloses(tr):
   285					bad.append({"type": "按鈕標籤超出按鈕", "s": t["s"], "btn": str(own)})
   286				for br2 in probe_btns:
   287					if br2 == own:
   288						continue
   289					var x3 := tr.intersection(br2)
   290					if x3.has_area() and x3.get_area() > tr.get_area() * 0.10:
   291						bad.append({"type": "按鈕標籤壓到別的按鈕", "s": t["s"], "btn": str(br2)})
   292						break
   293				continue
   294			var inside := false
   295			for c in probe_ctrls:
   296				if c.grow(1.0).encloses(tr):
   297					inside = true
   298					break
   299			if inside:
   300				continue
   301			for br in probe_btns:
   302				var x2 := tr.intersection(br)
   303				if x2.has_area() and x2.get_area() > tr.get_area() * 0.10:
   304					bad.append({"type": "文字壓到按鈕", "s": t["s"], "btn": str(br)})
   305					break
   306		if TEXT_BUDGET.has(name) and int(Save.s("text_scale")) == 100 and free_n > int(TEXT_BUDGET[name]):
   307			bad.append({"type": "文字段數超過上限", "n": free_n, "max": TEXT_BUDGET[name]})
   308		sizes.sort()
   309		var line := JSON.stringify({"shot": name, "lang": L.lang, "scale": int(Save.s("text_scale")), "texts": ui_n, "free_texts": free_n,
   310			"median_size": sizes[sizes.size() / 2] if not sizes.is_empty() else 0, "min_size": sizes[0] if not sizes.is_empty() else 0,
   311			"violations": bad, "warnings": cres["warn"]})
   312		var f := FileAccess.open(shot_dir.path_join("layout.jsonl"), FileAccess.READ_WRITE if FileAccess.file_exists(shot_dir.path_join("layout.jsonl")) else FileAccess.WRITE)
   313		f.seek_end()
   314		f.store_line(line)
   315		f.close()
   316	
