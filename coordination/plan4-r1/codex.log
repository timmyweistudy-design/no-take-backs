   752				if -lead > swing:
   753					swing = -lead
   754		var ratio := lock_t * 1000 / maxi(1, power_log.size())
   755		return {"lead_changes": changes, "lock_ratio_permille": ratio, "max_swing_pct": swing * 100 / total}

