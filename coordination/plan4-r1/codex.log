    71		if FileAccess.get_file_as_string(tmp) != txt:
    72			return false
    73		if FileAccess.file_exists(path):
    74			DirAccess.copy_absolute(path, path + ".bak")
    75		return DirAccess.rename_absolute(tmp, path) == OK
