   115	## 依寬度換行：中文一字一字量，英文以空白為界。
   116	func _wrap(s: String, size: int, width: float) -> String:
   117		var out: PackedStringArray = []
   118		for para in s.split("\n"):
   119			var line := ""
   120			var tokens: Array = []
   121			var word := ""
   122			for ch in para:
   123				if ch == " ":
   124					tokens.append(word + " ")
   125					word = ""
   126				elif ch.unicode_at(0) > 0x2E80:
   127					if word != "":
   128						tokens.append(word)
   129						word = ""
   130					tokens.append(ch)
   131				else:
   132					word += ch
   133			if word != "":
   134				tokens.append(word)
   135			for tk in tokens:
   136				if line != "" and font.get_string_size(line + tk, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x > width:
   137					out.append(line.strip_edges(false, true))
   138					line = tk.strip_edges(true, false) if tk == " " else tk
   139				else:
   140					line += tk
   141			out.append(line)
   142		return "\n".join(out)
   143	
