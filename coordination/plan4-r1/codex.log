   106	## 烘焙用的畫家：一格一格呼叫 Art.unit（face＝+1，翻面由貼圖時處理）。
   107	class _Painter extends Node2D:
   108		var cb := false
   109		var cols := 16
   110		func _draw() -> void:
   111			var Art2 = preload("res://scripts/ui/art.gd")
   112			var D2 = preload("res://scripts/core/unit_defs.gd")
   113			var saved: Transform2D = Art2.base
   114			Art2.base = Transform2D.IDENTITY
   115			var CELL2 := 160
   116			var RS2 := 1.6
   117			var org := Vector2(80, 124)
   118			var per := 2 + 6 + 8 + 8
   119			for type in D2.COUNT:
   120				for team in 2:
   121					for f in per:
   122						var idx: int = (type * 2 + team) * per + f
   123						var cell_o := Vector2((idx % cols) * CELL2, (idx / cols) * CELL2)
   124						var walk := 0.0
   125						var atk := 0.0
   126						var vr := 0
   127						if f >= 2 and f < 8:
   128							walk = 0.0001 + (f - 2) * TAU / 6.0
   129						elif f >= 16:
   130							atk = (f - 16 + 0.5) / 8.0
   131							vr = 1
   132						elif f >= 8:
   133							atk = (f - 8 + 0.5) / 8.0
   134						var p := cell_o + org
   135						var ex := 2.0 if type == D2.CAVALRY else 3.5
   136						# 眨眼那一格落在眨眼區間中間；其他格取 1.0（不在眨眼區間）
   137						var tt: float = (3.7 - ex * 0.13 + 0.05) if f == 1 else 1.0
   138						# 沒走路的格子（待機、眨眼、攻擊）Art.unit 會加呼吸位移；這裡反向抵銷，貼圖時再依當下時間加
   139						var pb := p
   140						if walk == 0.0:
   141							pb.y -= sin(tt * 3.0 + p.x * 0.05) * 0.8 * RS2
   142						Art2.unit(self, pb, type, team, 1.0, walk, atk, 0.0, 1.0, tt, RS2, cb, 0, 0.0, 1.0, vr)
   143			# 腳底圈
   144			var start: int = D2.COUNT * 2 * per
   145			for team in 2:
   146				for heavy in 2:
   147					var idx2: int = start + team * 2 + heavy
   148					var o := Vector2((idx2 % cols) * CELL2, (idx2 / cols) * CELL2) + org
   149					Art2.ring(self, o, team, D2.SHIELD if heavy == 1 else D2.SWORD, cb, RS2)
   150			Art2.base = saved

