     2	## 困難 AI 的離線反制庫（第三輪 A3）。
     3	## 原本只有 6 筆、沒有版本：改了平衡，反制庫會悄悄失效。現在：
     4	## ・原型陣＝AI 的 6 種模板 × 4 個種子＝24 種（不同主力兵種、不同排法）
     5	## ・每個原型在訓練池 200 套裡找「交換左右各打一場」勝最多的當反制；兩邊都要贏才收（勝率 ≥0.75）
     6	## ・檔案記下規則版本、數值摘要、產生參數；遊戲讀到版本不符就不用它（退回啟發式），不會用到過期的反制
     7	## ・另外量：困難 AI（有反制庫＋讀上一局）對驗證池 100 套的勝率，要高於普通 AI，附 95% 區間
     8	## 用法：godot --headless --path game --script res://tools/make_counter_lib.gd
     9	const Sim = preload("res://scripts/core/battle_sim.gd")
    10	const Army = preload("res://scripts/core/army.gd")
    11	const AI = preload("res://scripts/core/ai_army.gd")
    12	const AIT = preload("res://scripts/core/ai_turns.gd")
    13	const F = preload("res://scripts/core/formations.gd")
    14	const D = preload("res://scripts/core/unit_defs.gd")
    15	const PATH := "res://data/counter_lib.json"
    16	const SEEDS := 4
    17	const MIN_FIT := 0.75
    18	
    19	## a、b 都是藍方（team 0）表示。交換左右各打一場，回傳 a 的得分 0～1（平手算半場）。
    20	static func duel(a: Army, b: Army) -> float:
    21		var s1 = Sim.new(a.copy(), b.mirrored())
    22		s1.fast = true
    23		s1.run_to_end()
    24		var s2 = Sim.new(b.copy(), a.mirrored())
    25		s2.fast = true
    26		s2.run_to_end()
    27		var sc := (1.0 if s1.winner == 0 else (0.5 if s1.winner < 0 else 0.0)) + (1.0 if s2.winner == 1 else (0.5 if s2.winner < 0 else 0.0))
    28		return sc / 2.0
    29	
    30	func _init() -> void:
    31		var train := F.training_pool(0)
    32		var entries: Array = []
    33		var rng := RandomNumberGenerator.new()
    34		for ti in AI.TEMPLATES.size():
    35			for sd in SEEDS:
    36				rng.seed = 5150 + ti * 101 + sd * 7919
    37				var proto: Army = AI.build(0, 100, rng, ti)["army"]
    38				var best := -1
    39				var best_f := -1.0
    40				for j in range(0, train.size(), 2):   # 隔一套取一套（100 套候選），全部 200 套要跑 25 分鐘以上
    41					var f := duel(train[j], proto)
    42					if f > best_f:
    43						best_f = f
    44						best = j
    45				if best_f >= MIN_FIT:
    46					entries.append({"template": ti, "seed": sd, "name": AI.TEMPLATES[ti]["name"], "proto_comp": F.composition(proto),
    47						"code": train[best].to_code(), "fit": best_f})
    48		# 驗證：困難（反制庫）對普通，面對驗證池 100 套玩家陣型
    49		var val := F.validation_pool(0)
    50		var hard_w := 0.0
    51		var norm_w := 0.0
    52		var n := 0
    53		for i in 100:
    54			var player: Army = val[i]
    55			rng.seed = 777 + i
    56			var normal: Army = AI.build(1, 100, rng)["army"]
    57			var hard: Army = pick(entries, F.composition(player))
    58			if hard == null:
    59				rng.seed = 777 + i
    60				hard = AIT.build_full(1, rng, 2, player.units)
    61			hard_w += 1.0 - duel(player, hard.mirrored())
    62			norm_w += 1.0 - duel(player, normal.mirrored())
    63			n += 1
    64		var out := {"rules": D.RULES_VERSION, "digest": D.data_digest(), "seeds": SEEDS, "min_fit": MIN_FIT, "pool": "training_pool(0) 偶數套",
    65			"entries": entries, "check": {"vs_validation": n, "hard_winrate": snappedf(hard_w / n, 0.001), "normal_winrate": snappedf(norm_w / n, 0.001)}}
    66		var f := FileAccess.open(PATH, FileAccess.WRITE)
    67		f.store_string(JSON.stringify(out, " "))
    68		f.close()
    69		var types := {}
    70		for e in entries:
    71			var c: Array = e["proto_comp"]
    72			var mx := 0
    73			for k in 5:
    74				if c[k] > c[mx]:
    75					mx = k
    76			types[mx] = true
    77		print("COUNTERLIB %d 筆（原型 %d 種、主力兵種涵蓋 %d 種）；困難 AI 對驗證池勝率 %.1f%%、普通 %.1f%%" % [entries.size(), AI.TEMPLATES.size() * SEEDS, types.size(), hard_w / n * 100.0, norm_w / n * 100.0])
    78		quit(0 if entries.size() >= 12 and hard_w > norm_w else 1)
    79	
    80	## 依玩家的組成挑最接近的原型的反制（和遊戲裡的規則一樣：距離 ≤40 才用）。
    81	static func pick(entries: Array, mine: Array) -> Army:
    82		var best = null
    83		var bd := 1 << 30
    84		for e in entries:
    85			var d := 0
    86			for k in 5:
    87				d += absi(int(e["proto_comp"][k]) - int(mine[k]))
    88			if d < bd:
    89				bd = d
    90				best = e
    91		if best != null and bd <= 40:
    92			var a := Army.new(1, 100)
    93			if a.load_code(best["code"]) == "":
    94				return a
    95		return null
