    44	## 比目前新的版本：原樣回傳，不降版。
    45	static func migrate(d: Dictionary) -> Dictionary:
    46		var out := d.duplicate(true)
    47		var v := int(out.get("schema_version", out.get("version", 1)))
    48		if v > SAVE_VERSION:
    49			return out
    50		if v < 2:
    51			# 1 → 2：欄位名 version 改成 schema_version；加 unit_wins
    52			out.erase("version")
    53			v = 2
    54		if not out.get("unit_wins", {}) is Dictionary:
    55			out["unit_wins"] = {}
    56		for k in DEFAULT_SAVE:
    57			if not out.has(k):
    58				out[k] = DEFAULT_SAVE[k].duplicate(true) if DEFAULT_SAVE[k] is Dictionary or DEFAULT_SAVE[k] is Array else DEFAULT_SAVE[k]
    59		out["schema_version"] = v
    60		return out
