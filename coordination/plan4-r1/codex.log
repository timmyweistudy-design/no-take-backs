    69	## 比對前 n 場；回傳 {ok, n, first_case, first_tick, why}
    70	static func check(n: int) -> Dictionary:
    71		var g = JSON.parse_string(FileAccess.get_file_as_string(PATH))
    72		if not g is Dictionary:
    73			return {"ok": false, "why": "讀不到金標準檔"}
    74		if str(g["rules"]) != D.RULES_VERSION or str(g["digest"]) != D.data_digest():
    75			return {"ok": false, "why": "規則或數值變了（%s/%s → %s/%s）：若是刻意改規則，請重產金標準並在 commit 說明" % [g["rules"], g["digest"], D.RULES_VERSION, D.data_digest()]}
    76		var cases: Array = g["cases"]
    77		var every := int(g["check_every"])
    78		for i in mini(n, cases.size()):
    79			var c: Dictionary = cases[i]
    80			var r := run_case(c["a"], c["b"], false)
    81			var cps: Array = c["cps"]
    82			for k in mini(cps.size(), r["cps"].size()):
    83				if cps[k] != r["cps"][k]:
    84					return {"ok": false, "n": i + 1, "first_case": i, "first_tick": (k + 1) * every if k < cps.size() - 1 else int(c["t"]), "why": "狀態分歧"}
    85			if r["cps"].size() != cps.size() or int(r["winner"]) != int(c["w"]) or int(r["ticks"]) != int(c["t"]) or r["fp"] != c["fp"]:
    86				return {"ok": false, "n": i + 1, "first_case": i, "first_tick": int(c["t"]), "why": "結果或指紋不同"}
    87		return {"ok": true, "n": mini(n, cases.size())}
