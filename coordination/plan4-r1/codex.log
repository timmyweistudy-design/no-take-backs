   129	func fitness(a: Army, opps: Array) -> float:
   130		var w := 0.0
   131		for o in opps:
   132			var r := fight(a, o)
   133			w += 1.0 if r["res"] == 1 else (0.5 if r["res"] == 0 else 0.0)
   134			var r2 := fight(o, a)
   135			w += 1.0 if r2["res"] == -1 else (0.5 if r2["res"] == 0 else 0.0)
   136		return w / (opps.size() * 2)
