   145	## 一組段落要放進 max_h 高度：從 size 開始縮，直到換行後的總高度放得下（段落間距 gap）。最小 10px。
   146	func _fit_block(texts: Array, size: int, width: float, max_h: float, gap: float) -> int:
   147		var sz := size
   148		while sz > 10:
   149			var h := 0.0
   150			for tx in texts:
   151				h += (_wrap(tx, sz, width).count("\n") + 1) * sz * 1.3 + gap
   152			if h - gap <= max_h:
   153				return sz
   154			sz -= 1
   155		return sz
