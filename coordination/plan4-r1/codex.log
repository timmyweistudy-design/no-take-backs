    23	static func run_case(c0: String, c1: String, fast: bool) -> Dictionary:
    24		var a0 := Army.new(0, 100)
    25		var a1 := Army.new(1, 100)
    26		a0.load_code(c0)
    27		a1.load_code(c1)
    28		var s = Sim.new(a0, a1)
    29		s.fast = fast
    30		var cps: Array = []
    31		while not s.finished:
    32			s.step()
    33			if s.tick % CHECK_EVERY == 0:
    34				cps.append(state_sig(s))
    35		cps.append(state_sig(s))
    36		return {"winner": s.winner, "ticks": s.tick, "cps": cps, "fp": s.fingerprint}
