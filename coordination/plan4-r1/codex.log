    33	def wilson(k, n, z=1.96):
    34	    """比例的 95% 信賴區間（Wilson），回傳 (低%, 高%)。第三輪 B1：每個勝率都附區間。"""
    35	    if n == 0:
    36	        return (0, 0)
    37	    p = k / n
    38	    d = 1 + z * z / n
    39	    c = p + z * z / (2 * n)
    40	    h = z * ((p * (1 - p) / n + z * z / (4 * n * n)) ** 0.5)
    41	    return (round(100 * (c - h) / d), round(100 * (c + h) / d))
