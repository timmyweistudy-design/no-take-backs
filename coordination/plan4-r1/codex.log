   156		var nx := sx.duplicate()
   157		var ny := sy.duplicate()
   158		var new_target := PackedInt64Array()
   159		var new_fx := PackedInt64Array()
   160		var new_fy := PackedInt64Array()
   161		var new_lock := PackedInt64Array()
   162		new_target.resize(n); new_fx.resize(n); new_fy.resize(n); new_lock.resize(n)
   163		for i in n:
   164			var u := units[i]
   165			new_target[i] = u.target
   166			new_fx[i] = u.fx
   167			new_fy[i] = u.fy
   168			new_lock[i] = -1
   169			u.mx = 0
   170			u.my = 0
   171			if not u.alive:
   172				continue
   173			var t := _choose_target(i, sx, sy, st, sk, sh, sv)
   174			new_target[i] = t
   175			# 技能事件（只給畫面與圖鑑用，不進指紋）：被盾兵嘲諷吸走
   176			if t != -1 and t != u.target and _last_rank == 1:
   177				events.append({"kind": EV.TAUNT, "src": units[t].id, "tgt": u.id, "tags": [EV.TAUNT]})
   178			if t == -1 or u.stun > 0:
   179				continue
   180			var tg := units[t]
   181			var reach := u.reach
   182			var d2 := M.dist2(u.x, u.y, tg.x, tg.y)
   183			var dest_x := tg.x
   184			var dest_y := tg.y
   185			var stop_at := reach - 50
   186			var flanking := false
   187			if u.type == D.ASSASSIN and u.stealth > 0:
   188				# 潛行中繞到目標背後（目的地夾在場內）
   189				dest_x = clampi(tg.x - tg.fx * D.BEHIND_DIST / 1000, EDGE, W - EDGE)
   190				dest_y = clampi(tg.y - tg.fy * D.BEHIND_DIST / 1000, EDGE, H - EDGE)
   191				stop_at = 0
   192			elif u.type == D.CAVALRY:
   193				var wp := _flank_waypoint(i, t)
   194				if wp.x >= 0:
   195					if d2 <= reach * reach:
   196						u.nav = 2            # 敵人已在射程內：結束繞翼直接開打，不卡在未完成狀態
   197					else:
   198						dest_x = wp.x
   199						dest_y = wp.y
   200						stop_at = 0
   201						flanking = true
   202			var need_move := d2 > reach * reach or (u.type == D.ASSASSIN and u.stealth > 0) or flanking
   203			if u.type == D.CAVALRY and not flanking:
   204				# 追擊遲滯：已經在追就追到 reach−CHASE_HYST 才停；停著的要超出 reach 才起步
   205				need_move = cav_chase(u.chasing, d2, reach)
   206				stop_at = reach - D.CHASE_HYST
   207				u.chasing = need_move
   208			if need_move:
   209				var dx := dest_x - u.x
   210				var dy := dest_y - u.y
   211				var l := M.isqrt(dx * dx + dy * dy)
   212				var spd := u.speed
   213				if u.slow > 0:
   214					spd = spd * D.SLOW_NUM / D.SLOW_DEN
   215				var stp := mini(spd, l - stop_at)
   216				if stp > 0 and l > 0:
   217					u.mx = dx * stp / l
   218					u.my = dy * stp / l
   219					nx[i] = u.x + u.mx
   220					ny[i] = u.y + u.my
   221			# 面向（優化方案 B1）：交戰中鎖定，只有換目標才重算；不交戰時朝移動方向
   222			var engage := reach + CELL
   223			if d2 <= engage * engage:
   224				new_lock[i] = t
   225				if u.face_lock != t:
   226					var f := M.unit1000(tg.x - u.x, tg.y - u.y)
   227					if f != Vector2i.ZERO:
   228						new_fx[i] = f.x
   229						new_fy[i] = f.y
   230			else:
   231				var f2 := M.unit1000(u.mx, u.my)
   232				if f2 != Vector2i.ZERO:
   233					new_fx[i] = f2.x
   234					new_fy[i] = f2.y
   235	
   236		# ③ 統一解碰撞（固定兩輪，所有推力加總後一次套用）
   237		for _pass in 2:
   238			var px := PackedInt64Array()
   239			var py := PackedInt64Array()
   240			px.resize(n)
   241			py.resize(n)
   242			for i in n:
   243				if sv[i] == 0:
   244					continue
   245				var xi := nx[i]
   246				var yi := ny[i]
   247				for j in range(i + 1, n):
   248					if sv[j] == 0:
   249						continue
   250					var dx := nx[j] - xi
   251					var dy := ny[j] - yi
   252					if dx >= MIN_SEP or dx <= -MIN_SEP or dy >= MIN_SEP or dy <= -MIN_SEP:
   253						continue
   254					var d2 := dx * dx + dy * dy
   255					if d2 >= MIN_SEP * MIN_SEP:
   256						continue
   257					var d := M.isqrt(d2)
   258					var ux := 0
   259					var uy := 0
   260					if d == 0:
   261						# 零距離：不同隊左右分開（藍往左、紅往右）；同隊上下分開
   262						if st[i] != st[j]:
   263							ux = 1000 if st[i] == 0 else -1000
   264						else:
   265							uy = 1000
   266					else:
   267						ux = dx * 1000 / d
   268						uy = dy * 1000 / d
   269					var half := (MIN_SEP - d) / 2 + 1
   270					px[i] -= ux * half / 1000
   271					py[i] -= uy * half / 1000
   272					px[j] += ux * half / 1000
   273					py[j] += uy * half / 1000
   274			for i in n:
   275				nx[i] = clampi(nx[i] + px[i], EDGE, W - EDGE)
   276				ny[i] = clampi(ny[i] + py[i], EDGE, H - EDGE)
   277	
   278		# 套用移動、目標、面向
   279		for i in n:
   280			var u := units[i]
   281			if not u.alive:
   282				continue
   283			var moved_x: int = nx[i] - u.x
   284			var moved_y: int = ny[i] - u.y
   285			if u.type == D.CAVALRY:
   286				_update_charge(u, moved_x, moved_y)
   287			u.x = nx[i]
   288			u.y = ny[i]
   289			u.target = new_target[i]
   290			u.fx = new_fx[i]
   291			u.fy = new_fy[i]
   292			u.face_lock = new_lock[i]   # 只在第②步已經轉向目標之後才鎖定
   293	
   294		# ④ 產生攻擊（讀這一 tick 已確定的位置與面向）
   295		var hits: Array = []   # [來源, 目標, 傷害, 種類]
   296		var stun_set := {}
   297		var slow_set := {}
   298		var reveal := {}
   299		var knock: Array = []
   300		var attacked := PackedByteArray()
   301		attacked.resize(n)
   302		var sword_hit_by := {}   # 劍士索引 → 這一 tick 打中它的刺客索引們
   303		var dec := D.FRENZY_CD_RATE if frenzy else 4
   304		# 背水（追趕機制，預設關閉）：用這一 tick 開始時的戰力判斷，兩隊同時算
   305		var rally_bonus := [0, 0]
   306		rally = [false, false]
   307		if D.RALLY_RATIO_PCT > 0:
   308			var pw := [power(0), power(1)]
   309			for tm in 2:
   310				if pw[tm] * 100 < pw[1 - tm] * D.RALLY_RATIO_PCT:
   311					rally_bonus[tm] = D.RALLY_CD_BONUS
   312					rally[tm] = true
   313		for tm in 2:
   314			if rally[tm] != _was_rally[tm]:
   315				events.append({"kind": EV.RALLY_ON if rally[tm] else EV.RALLY_OFF, "team": tm, "tags": [EV.RALLY]})
   316				_was_rally[tm] = rally[tm]
   317		for i in n:
   318			var u := units[i]
   319			if not u.alive:
   320				continue
   321			if u.cd > 0:
   322				u.cd = maxi(0, u.cd - dec - rally_bonus[u.team])
   323			if u.stun > 0 or u.target == -1 or u.cd > 0:
   324				continue
   325			var tg := units[u.target]
   326			if M.dist2(u.x, u.y, tg.x, tg.y) > u.reach * u.reach:
   327				continue
   328			if u.type == D.ASSASSIN and u.stealth > 0 and not _is_behind(u, tg):
   329				continue
   330			var dmg := u.atk
   331			var kind: String = EV.HIT
   332			var tags: Array = []
   333			if u.type == D.SHIELD and tg.type == D.CAVALRY:
   334				dmg = dmg * D.ANTICAV_NUM / D.ANTICAV_DEN
   335				kind = EV.ANTICAV
   336				tags.append(EV.ANTICAV)
   337			if u.type == D.SWORD:
   338				if tg.type == D.SHIELD:
   339					dmg = dmg * D.BREAKER_NUM / D.BREAKER_DEN
   340					kind = EV.BREAKER
   341					tags.append(EV.BREAKER)
   342			elif u.type == D.ARCHER:
   343				kind = EV.ARROW
   344				tags.append(EV.ARROW)
   345				if tg.type == D.ASSASSIN:
   346					dmg = dmg * D.ALERT_NUM / D.ALERT_DEN
   347					tags.append(EV.ALERT)
   348				if tg.type == D.SHIELD and not _is_behind(u, tg):
   349					dmg = dmg * D.BLOCK_NUM / D.BLOCK_DEN
   350					kind = EV.BLOCKED
   351					tags.append(EV.BLOCKED)
   352				elif tg.type == D.CAVALRY:
   353					dmg = dmg * D.HIDE_ARROW_NUM / D.HIDE_ARROW_DEN
   354					tags.append(EV.HIDE)
   355			elif u.type == D.CAVALRY:
   356				if u.charge >= D.CHARGE_NEED:
   357					if tg.type == D.SHIELD and not _is_behind(u, tg):
   358						stun_set[i] = true
   359						kind = EV.BRACED
   360						tags.append(EV.BRACED)
   361					else:
   362						dmg = dmg * D.CHARGE_NUM / D.CHARGE_DEN
   363						kind = EV.CHARGE
   364						tags.append(EV.CHARGE)
   365						knock.append([u.target, tg.x - u.x, tg.y - u.y])
   366			elif u.type == D.ASSASSIN:
   367				if _is_behind(u, tg):
   368					dmg = dmg * D.BACKSTAB_NUM / D.BACKSTAB_DEN
   369					kind = EV.BACKSTAB
   370					tags.append(EV.BACKSTAB)
   371				if tg.type == D.CAVALRY:
   372					slow_set[u.target] = true
   373					tags.append(EV.TRIP)
   374				reveal[i] = true
   375				if tg.type == D.SWORD:
   376					if not sword_hit_by.has(u.target):
   377						sword_hit_by[u.target] = []
   378					sword_hit_by[u.target].append(i)
   379			if tags.is_empty():
   380				tags.append(EV.HIT)
   381			hits.append([i, u.target, dmg, kind, tags])
   382			attacked[i] = 1
   383			u.cd += u.cd_base * 4
   384			if u.type == D.CAVALRY:
   385				u.charge = 0   # 任何一擊之後都要重新直行才能再衝
   386		# 劍士反擊（優化方案 B1）：這一 tick 打中它的刺客裡，挑「最近→列小→離自己底線近」的那一隻，每 tick 最多一次
   387		var swords := sword_hit_by.keys()
   388		swords.sort()
   389		for si in swords:
   390			var sw := units[si]
   391			hits.append([si, pick_counter(si, sword_hit_by[si]), sw.atk * D.COUNTER_PCT / 100, EV.COUNTER, [EV.COUNTER]])
   392	
   393		# ⑤ 同時結算
   394		var dmg_in := PackedInt64Array()
   395		dmg_in.resize(n)
   396		var last_hit := PackedInt64Array()
   397		last_hit.resize(n)
   398		last_hit.fill(-1)
   399		var per_pair := {}   # (目標, 攻擊者) → 這一 tick 的傷害
   400		for h in hits:
   401			dmg_in[h[1]] += h[2]
   402			units[h[0]].dmg_dealt += h[2]
   403			units[h[1]].dmg_taken += h[2]
   404			var key: int = h[1] * 4096 + h[0]
   405			per_pair[key] = int(per_pair.get(key, 0)) + h[2]
   406			events.append({"src": units[h[0]].id, "tgt": units[h[1]].id, "dmg": h[2], "kind": h[3], "tags": h[4]})
   407		# 擊殺歸屬：傷害最高者；同傷害比列小、再比離自己底線近（只用鏡像不變的鍵）
   408		var best_d := PackedInt64Array()
   409		best_d.resize(n)
   410		for key in per_pair:
   411			var tgt: int = key / 4096
   412			var src: int = key % 4096
   413			var d: int = per_pair[key]
   414			var cur: int = last_hit[tgt]
   415			var better := cur == -1 or d > best_d[tgt]
   416			if not better and d == best_d[tgt]:
   417				var a := units[src]
   418				var b := units[cur]
   419				var da: int = a.x if a.team == 0 else W - a.x
   420				var db: int = b.x if b.team == 0 else W - b.x
   421				better = a.y < b.y or (a.y == b.y and da < db)
   422			if better:
   423				last_hit[tgt] = src
   424				best_d[tgt] = d
   425		# 狂熱耗損：第 1200+100k tick（k＝0～5）扣 (k+1)×STEP% 滿血（至少 1）
   426		if tick >= FRENZY_TICK and (tick - FRENZY_TICK) % 100 == 0 and (tick - FRENZY_TICK) / 100 <= 5:
   427			var k := (tick - FRENZY_TICK) / 100
   428			for i in n:
   429				if units[i].alive:
   430					dmg_in[i] += maxi(1, units[i].max_hp * (k + 1) * D.ATTRITION_STEP_PCT / 100)
   431			events.append({"kind": EV.ATTRITION, "k": k})
   432		for kb in knock:
   433			var v := M.unit1000(kb[1], kb[2])
   434			var t: Unit = units[kb[0]]
   435			t.x = clampi(t.x + v.x * D.KNOCKBACK / 1000, EDGE, W - EDGE)
   436			t.y = clampi(t.y + v.y * D.KNOCKBACK / 1000, EDGE, H - EDGE)
   437		for i in n:
   438			var u := units[i]
   439			if not u.alive:
   440				continue
   441			u.hp -= dmg_in[i]
   442			if u.stun > 0:
   443				u.stun -= 1
   444			if u.slow > 0:
   445				u.slow -= 1
   446			if u.stealth > 0:
   447				u.stealth -= 1
   448			if reveal.has(i):
   449				u.stealth = 0
   450			if stun_set.has(i):
   451				u.stun = D.STUN_TICKS
   452				u.charge = 0
   453			if slow_set.has(i):
   454				u.slow = D.SLOW_TICKS
   455			if u.type == D.ASSASSIN and u.stealth == 0 and _was_stealth.get(u.id, false):
   456				events.append({"kind": EV.REVEAL, "src": u.id, "tgt": u.id, "tags": [EV.REVEAL]})
   457			_was_stealth[u.id] = u.stealth > 0
   458			# 騎兵這一 tick 沒動也沒出手（被擋、等待）→ 衝鋒歸零
   459			if u.type == D.CAVALRY and u.mx == 0 and u.my == 0 and attacked[i] == 0:
   460				u.charge = 0
   461		for i in n:
   462			var u := units[i]
   463			if u.alive and u.hp <= 0:
   464				u.alive = false
   465				u.hp = 0
   466				if last_hit[i] != -1:
   467					units[last_hit[i]].kills += 1
   468				events.append({"kind": EV.DEATH, "id": u.id})
   469	
   470		power_log.append(power(0) - power(1))
   471		if not fast:
   472			_hash_state()
   473		_check_end()
   474	
   475	# ───────────────────────── 規則細節 ─────────────────────────
   476	
   477	## 選目標（企劃 §3.3）：排除潛行 → 弓手警覺 → 盾兵嘲諷（近戰）→ 兵種偏好 → 距離 → 剩血 → 列 → 深度 → 編號。
   478	## 只讀快照陣列，比較全部用整數（不配置陣列）。
   479	func _choose_target(i: int, sx: PackedInt64Array, sy: PackedInt64Array, st: PackedInt64Array,
   480			sk: PackedInt64Array, sh: PackedInt64Array, sv: PackedByteArray) -> int:
   481		var my_team: int = st[i]
   482		var my_type: int = sk[i]
   483		var ux: int = sx[i]
   484		var uy: int = sy[i]
   485		var reach: int = units[i].reach
   486		var reach2 := reach * reach
   487		var taunt2 := D.TAUNT_RANGE * D.TAUNT_RANGE
   488		var melee := my_type != D.ARCHER
   489		var best := -1
   490		var b_rank := 99
   491		_last_rank = 99
   492		var b_d2 := 0
   493		var b_hp := 0
   494		var b_y := 0
   495		var b_dep := 0
   496		var n := sx.size()
   497		for j in n:
   498			if sv[j] == 0 or st[j] == my_team:
   499				continue
   500			var dx: int = sx[j] - ux
   501			var dy: int = sy[j] - uy
   502			var d2 := dx * dx + dy * dy
   503			var et: int = sk[j]
   504			var rank := 3
   505			if my_type == D.ARCHER and et == D.ASSASSIN and d2 <= reach2:
   506				rank = 0
   507			elif melee and et == D.SHIELD and d2 <= taunt2:
   508				rank = 1
   509			elif my_type == D.CAVALRY and et == D.ARCHER:
   510				rank = 2
   511			elif my_type == D.ASSASSIN and (et == D.SHIELD or et == D.CAVALRY):
   512				rank = 2
   513			if best != -1:
   514				if rank > b_rank:
   515					continue
   516				if rank == b_rank:
   517					if d2 > b_d2:
   518						continue
   519					if d2 == b_d2:
   520						var hp: int = sh[j]
   521						if hp > b_hp:
   522							continue
   523						if hp == b_hp:
   524							var ey: int = sy[j]
   525							if ey > b_y:
   526								continue
   527							if ey == b_y:
   528								var dep: int = sx[j] if st[j] == 0 else W - sx[j]
   529								if dep >= b_dep:
   530									continue
   531			best = j
   532			b_rank = rank
   533			b_d2 = d2
   534			b_hp = sh[j]
   535			b_y = sy[j]
   536			b_dep = sx[j] if st[j] == 0 else W - sx[j]
   537		_last_rank = b_rank
   538		return best
   539	
   540	## 劍士反擊選人：打中它的刺客裡挑「最近→列小→離自己底線近」；只用鏡像不變的鍵，不用編號。
   541	func pick_counter(si: int, attackers: Array) -> int:
   542		var sw := units[si]
   543		var best := -1
   544		var bd := 0
   545		var by := 0
   546		var bdep := 0
   547		for ai in attackers:
   548			var a := units[ai]
   549			var d2 := M.dist2(sw.x, sw.y, a.x, a.y)
   550			var dep: int = a.x if a.team == 0 else W - a.x
   551			if best == -1 or d2 < bd or (d2 == bd and (a.y < by or (a.y == by and dep < bdep))):
   552				best = ai
   553				bd = d2
   554				by = a.y
   555				bdep = dep
   556		return best
   557	
   558	## 攻擊者是否在目標背後（以目標面向的內積判斷；剛好側面算正面）。
   559	func _is_behind(att: Unit, tg: Unit) -> bool:
   560		var dx := att.x - tg.x
   561		var dy := att.y - tg.y
   562		return dx * tg.fx + dy * tg.fy < 0
   563	
   564	func _same_dir(ax: int, ay: int, bx: int, by: int) -> bool:
   565		# 夾角小於約 25 度
   566		var dot := ax * bx + ay * by
   567		if dot <= 0:
   568			return false
   569		var la := ax * ax + ay * ay
   570		var lb := bx * bx + by * by
   571		return dot * dot * 100 >= la * lb * 82
   572	
   573	## 騎兵衝鋒累積（優化方案 B1）：只算「沿著這段衝鋒起始方向」的實際前進距離；
   574	## 被推開的位移不算；方向跟起始方向差太多（逐步轉彎也算）就重新開始；被擋住前進不到一半就歸零。
   575	func _update_charge(u: Unit, moved_x: int, moved_y: int) -> void:
   576		if u.mx == 0 and u.my == 0:
   577			return   # 沒有提出移動（停下攻擊或等待），在第⑤步處理
   578		var ml := M.isqrt(u.mx * u.mx + u.my * u.my)
