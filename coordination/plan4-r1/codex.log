   138	func mutate(a: Army, rng: RandomNumberGenerator) -> Army:
   139		var b: Army = a.copy()
   140		var op := rng.randi_range(0, 2)
   141		if b.units.is_empty():
   142			op = 2
   143		if op == 0:
   144			# 換一隻的兵種（守預算）
   145			var i := rng.randi_range(0, b.units.size() - 1)
   146			var old: int = b.units[i]["type"]
   147			var t := rng.randi_range(0, 4)
   148			if b.spent() - D.cost(old) + D.cost(t) <= 100:
   149				b.units[i]["type"] = t
   150		elif op == 1:
   151			# 移動一隻
   152			var i := rng.randi_range(0, b.units.size() - 1)
   153			var c := rng.randi_range(0, 5)
   154			var r := rng.randi_range(0, 8)
   155			if b.index_at(c, r) == -1:
   156				b.units[i]["col"] = c
   157				b.units[i]["row"] = r
   158		else:
   159			# 拿掉一隻、補別種
   160			if not b.units.is_empty():
   161				b.units.remove_at(rng.randi_range(0, b.units.size() - 1))
   162			var t := rng.randi_range(0, 4)
   163			F.place_styled(b, t, "role", rng)
   164		return b
