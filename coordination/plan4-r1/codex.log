    51	func _make() -> void:
    52		var rng := RandomNumberGenerator.new()
    53		var cases: Array = []
    54		for i in 1000:
    55			rng.seed = 20261102 + i * 7919
    56			var a0: Army = AI.build(0, 100, rng)["army"]
    57			var a1: Army = AI.build(1, 100, rng)["army"]
    58			var c0 := a0.to_code()
    59			var c1 := a1.to_code()
    60			var r := run_case(c0, c1, false)
    61			cases.append({"a": c0, "b": c1, "w": r["winner"], "t": r["ticks"], "cps": r["cps"], "fp": r["fp"]})
    62		var out := {"rules": D.RULES_VERSION, "digest": D.data_digest(), "check_every": CHECK_EVERY, "cases": cases}
    63		var f := FileAccess.open(PATH, FileAccess.WRITE)
