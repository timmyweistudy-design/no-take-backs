    15	static func state_sig(s) -> String:
    16		var parts := PackedStringArray()
    17		parts.append(str(s.tick))
    18		for u in s.units:
    19			parts.append("%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d" % [u.id, u.x, u.y, u.hp, 1 if u.alive else 0, u.target, u.stun,
    20				u.stealth, u.charge, u.slow, u.cd, u.fx, u.fy, u.nav, 1 if u.chasing else 0])
    21		return ",".join(parts).sha256_text().substr(0, 16)
