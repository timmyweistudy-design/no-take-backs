    71	## 每幀推進小劇場（20 tick／秒，跟正式戰鬥同速）。
    72	func _codex_tick(delta: float) -> void:
    73		for p in cx_pops:
    74			p["t"] += delta
    75		cx_pops = cx_pops.filter(func(p): return p["t"] < 1.1)
    76		if cx_sim == null:
    77			return
    78		var sk: String = _cx_skills()[cx_skill]
    79		var dm: Dictionary = CX.skill(sk).get("demo", {})
    80		var limit := int(dm.get("ticks", 120))
    81		if cx_sim.finished or cx_ticks >= limit:
    82			cx_wait += delta
    83			if cx_wait >= CX_PAUSE:
    84				_cx_restart()
    85			return
    86		cx_acc += delta
    87		while cx_acc >= 0.05 and not cx_sim.finished and cx_ticks < limit:
    88			cx_acc -= 0.05
    89			for u in cx_sim.units:
    90				cx_prev[u.id] = Vector2(u.x, u.y)
    91			cx_sim.step()
    92			cx_ticks += 1
    93			for e in cx_sim.events:
    94				if e.has("dmg"):
    95					cx_atk[e["src"]] = time
    96					cx_hurt[e["tgt"]] = time
    97			for hp in CX.expect_hits(cx_sim, str(dm.get("expect", ""))):
    98				cx_seen = true
    99				cx_pops.append({"p": hp, "s": CX.text(CX.skill(sk), "", L.lang) + "！", "t": 0.0})
