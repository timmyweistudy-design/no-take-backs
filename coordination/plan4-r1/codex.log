     2	## 角色精靈圖快取（第二輪方案 R2、H）：實測 48 隻時每幀直接程式繪製要 34ms（約 15fps），
     3	## 所以啟動時用同一份 Art.unit 畫法，把每個兵種×隊伍×動作影格一次畫進一張圖集，戰鬥中只貼圖。
     4	## 用同一份畫法烘焙，但不是逐像素等價（Codex R1 審查 #3、#4，已知且接受的差異）：
     5	##  - 走路量化成 6 格、攻擊 8 格；攻擊中不再疊走路相位；走路／攻擊格固定睜眼（只在待機眨眼）。
     6	## 表情疊加（受擊、暈眩、衝鋒、狂熱、潛行、頂住）不烘焙，貼完圖再用 Art.overlay 在同一個局部座標畫上去。
     7	##  - 透明度（潛行）是對整張合成好的角色乘 alpha，重疊的部位不會像逐圖元那樣透出底下的線條。
     8	## 待機呼吸位移在貼圖時加（烘焙時抵銷為 0）；受擊閃白跟著攻擊前衝與走路起伏。
     9	## 沒有畫面（headless）或還沒建好時，呼叫端退回 Art.unit。
    10	
    11	const Art = preload("res://scripts/ui/art.gd")
    12	const D = preload("res://scripts/core/unit_defs.gd")
    13	
    14	const CELL := 160          # 每格像素（以 RS 倍率畫）；比角色大一圈，避免相鄰格子滲色
    15	const RS := 1.6            # 烘焙解析度倍率
    16	const ORIGIN := Vector2(80, 124)   # 角色腳底在格子裡的位置
    17	const WALK_FRAMES := 6
    18	const ATK_FRAMES := 8      # 三段式攻擊（R5）要多幾格才看得出前搖／揮擊／後搖
    19	# 每個兵種、隊伍的影格順序：0 待機、1 眨眼、2..7 走路、8..13 攻擊
    20	const FRAMES_PER := 2 + WALK_FRAMES + ATK_FRAMES * 2   # 攻擊兩組：一般／交替招式（第三輪 R4）
    21	
    22	var tex: Texture2D = null
    23	var ring_tex: Texture2D = null
    24	var ready_cb := -1         # 這份快取是用哪種配色（一般／色盲）烘焙的
    25	var _cols := 16
    26	
    27	func is_ready(cb: bool) -> bool:
    28		return tex != null and ready_cb == (1 if cb else 0)
    29	
    30	## 烘焙：在 SubViewport 一次畫完所有影格，讀回成一張圖。
    31	func build(cb: bool) -> void:
    32		if DisplayServer.get_name() == "headless":
    33			return
    34		var total := D.COUNT * 2 * FRAMES_PER
    35		var rows := int(ceil(float(total) / _cols)) + 1   # 最後一列放腳底圈
    36		var vp := SubViewport.new()
    37		vp.size = Vector2i(_cols * CELL, rows * CELL)
    38		vp.transparent_bg = true
    39		vp.render_target_update_mode = SubViewport.UPDATE_ONCE
    40		var painter := _Painter.new()
    41		painter.cb = cb
    42		painter.cols = _cols
    43		vp.add_child(painter)
    44		add_child(vp)
    45		await RenderingServer.frame_post_draw
    46		await RenderingServer.frame_post_draw
    47		var img := vp.get_texture().get_image()
    48		tex = ImageTexture.create_from_image(img)
    49		ready_cb = 1 if cb else 0
    50		vp.queue_free()
    51	
    52	func frame_index(type: int, team: int, walk: float, atk: float, t: float, px: float, variant := 0) -> int:
    53		var base := (type * 2 + team) * FRAMES_PER
    54		if atk > 0.0:
    55			return base + 2 + WALK_FRAMES + ATK_FRAMES * variant + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
    56		if walk != 0.0:
    57			return base + 2 + int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES
    58		var ex := 2.0 if type == D.CAVALRY else 3.5   # Art._eyes 的眼睛中心 x
    59		var blink := fmod(t + ex * 0.13, 3.7) <= 0.12   # 與 Art._eyes 相同的眨眼節奏
    60		return base + (1 if blink else 0)
    61	
    62	## 腳底圈：隊伍×（一般／重兵）共 4 格，放在所有角色影格之後。
    63	func ring_index(team: int, heavy: bool) -> int:
    64		return D.COUNT * 2 * FRAMES_PER + team * 2 + (1 if heavy else 0)
    65	
    66	func draw_ring(ci: CanvasItem, p: Vector2, team: int, type: int, scale := 1.0) -> void:
    67		var idx := ring_index(team, type == D.SHIELD or type == D.CAVALRY)
    68		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
    69		ci.draw_texture_rect_region(tex, Rect2(-ORIGIN, Vector2(CELL, CELL)), _rect(idx))
    70		ci.draw_set_transform_matrix(Art.base)
    71	
    72	func _rect(idx: int) -> Rect2:
    73		return Rect2((idx % _cols) * CELL, (idx / _cols) * CELL, CELL, CELL)
    74	
    75	## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
    76	func quant_walk(walk: float) -> float:
    77		if walk == 0.0:
    78			return 0.0
    79		return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES
    80	
    81	func quant_atk(atk: float) -> float:
    82		if atk <= 0.0:
    83			return 0.0
    84		return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES
    85	
    86	## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
    87	func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
    88			hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false, variant := 0) -> void:
    89		var idx := frame_index(type, team, walk, atk, t, p.x, variant)
    90		if atk > 0.0:
    91			walk = 0.0   # 攻擊影格烘焙時沒有走路相位：貼圖與疊加都當成沒在走（Codex 收尾輪 #4）
    92		var bob := sin(t * 3.0 + p.x * 0.05) * 0.8 if walk == 0.0 else 0.0   # 與 Art.unit 相同：沒走路時（含攻擊）都有呼吸
    93		var xf := Art.base * Transform2D(lean * face, Vector2(scale * face / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale))
    94		ci.draw_set_transform_matrix(xf)
    95		ci.draw_texture_rect_region(tex, Rect2(-ORIGIN, Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
    96		if hurt > 0.0 or mood != 0:
    97			# 攻擊影格烘焙時沒有走路相位（Codex R5 #3）
    98			var qa := quant_atk(atk)
    99			ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, face, 0.0 if qa > 0.0 else quant_walk(walk), qa, t, scale, lean, crouch))
   100			if hurt > 0.0:
   101				ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, false)
   102			if mood != 0:
   103				Art.overlay(ci, type, team, mood, alpha, t, cb)
   104		ci.draw_set_transform_matrix(Art.base)
