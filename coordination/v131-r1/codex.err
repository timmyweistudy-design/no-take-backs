## 表情與狀態疊加：呼叫前畫布轉換要已經是這隻角色的局部座標（face＝+1 空間）。
static func overlay(ci: CanvasItem, type: int, team: int, mood: int, a: float, t: float, cb := false) -> void:
	var ec := Vector2(2.0, -43.0) if type == D.CAVALRY else (Vector2(5.5, -33.5) if type == D.ASSASSIN else Vector2(3.5, -32.0))
	if type >= D.COUNT:
		if not FEATURE_EYES.has(type):
			return   # 寶箱怪、羊、沙漏等臉在別處，不疊通用表情
		ec = FEATURE_EYES[type]
	var eyes := [ec + Vector2(-3.0 if type != D.ASSASSIN else -2.5, 0), ec + Vector2(4.0 if type != D.ASSASSIN else 2.5, 0)]
	var skin := Color("#2b2140") if type == D.ASSASSIN else SKIN
	if mood & M_HOOD:
		# 帽簷壓低：一條兜帽色的帽簷蓋到眼睛上緣；每 0.4 秒整個蓋住一下（眨眼）
		var shut := fmod(t, 0.4) < 0.07
		var drop := 4.6 if shut else 2.2
		ci.draw_rect(Rect2(ec + Vector2(-6.5, -4.8), Vector2(13.0, drop)), Color("#33304a", a))
	if mood & M_HURT:
		for i in 2:
			var e: Vector2 = eyes[i]
			ci.draw_circle(e, 3.3, Color(skin, a), true, -1.0, true)
			var sx := 1.0 if i == 0 else -1.0     # 左眼 >、右眼 <
			var col := Color("#ffe066", a) if type == D.ASSASSIN else Color(OUT, a)
			ci.draw_polyline(PackedVector2Array([e + Vector2(-1.8 * sx, -2.0), e + Vector2(1.6 * sx, 0), e + Vector2(-1.8 * sx, 2.0)]), col, 1.4, true)
	if mood & M_SPARKLE:
		for e in eyes:
			ci.draw_circle(e, 2.9, Color(OUT, a), true, -1.0, true)
			_star(ci, e + Vector2(0.4, -0.6), 2.2, Color(1, 1, 1, a))
		# 槍尖金光（長槍放平時的槍尖位置）
		var tip := Vector2(-6, -30) + Vector2(cos(-0.55), sin(-0.55)) * 40.0
		var g := 0.6 + 0.4 * sin(t * 18.0)
		_star(ci, tip, 14.0 * (0.8 + 0.2 * g), Color(1, 0.86, 0.3, a * g))   # 14px 十字閃芒（第三輪 R3）
		_star(ci, tip, 6.0, Color("#fff8a0", a))
	if mood & M_BROWS:
		for i in 2:
			var e2: Vector2 = eyes[i]
			var inward := 1.0 if i == 0 else -1.0
			var bc := Color("#ffe066", a) if type == D.ASSASSIN else Color(OUT, a)
			ci.draw_line(e2 + Vector2(-2.2, -4.2 - inward * 0.9), e2 + Vector2(2.2, -4.2 + inward * 0.9), bc, 1.8, true)
			ci.draw_circle(e2 + Vector2(0.6, -0.4), 1.2, Color(1, 0.25, 0.2, a), true, -1.0, true)   # 紅眼光點（第三輪 R3）
	if mood & M_BRACE and type == D.PIKE:
		# 長槍兵拒騎：槍尖位置爆一圈銀色十字閃光（第四輪）
		var g2 := 0.6 + 0.4 * sin(t * 20.0)
		_star(ci, Vector2(7, -17) + Vector2(cos(-0.8), sin(-0.8)) * 48.0, 13.0 * g2 + 4.0, Color(0.92, 0.96, 1.0, a))
	if mood & M_BRACE and type == D.SHIELD:
		# 頂住：盾放大 1.35 倍（以盾中心縮放）
		var cc := Vector2(11, -24)
		var k := 1.25
		var sh := PackedVector2Array()
		for q in [Vector2(1, -43), Vector2(21, -41), Vector2(21, -14), Vector2(11, -2), Vector2(1, -14)]:
			sh.append(cc + (q - cc) * k)
		_poly(ci, sh, STEEL, a)
		var inner := PackedVector2Array()
		for q2 in [Vector2(7, -33), Vector2(15, -32), Vector2(15, -17), Vector2(11, -11), Vector2(7, -17)]:
			inner.append(cc + (q2 - cc) * k)
		_poly(ci, inner, team_color(team, cb), a, false)


## 腳底隊伍標記：藍＝圓、紅＝菱形（色盲也分得出）；重兵（盾、騎）外框加粗。
## V1.3 A3：腳底三層，由下往上：厚木座（棋子底座，留在地上）→ 接觸影子（跳起來會縮）→ 隊伍圈。
## air＝離地程度 0～1（只縮影子）。
static func ring(ci: CanvasItem, p: Vector2, team: int, type: int, cb := false, scale := 1.0, air := 0.0) -> void:
	ring_base(ci, p, scale)
	ring_shadow(ci, p, scale * (1.0 - air * 0.35))
	ring_mark(ci, p, team, type, cb, scale)

## 厚木座：下緣 2.5px 深色厚度、頂面木色、上緣 1px 亮倒角（深色地面也看得出邊）。
static func ring_base(ci: CanvasItem, p: Vector2, scale := 1.0, a := 1.0) -> void:
	# 比隊伍圈寬一圈（rx 21），外露的木邊看得出是棋子底座（Antigravity v130-impl1：原本被隊伍圈蓋住）
	ci.draw_colored_polygon(_ell(p + Vector2(0, 3.2) * scale, 21.0 * scale, 10.5 * scale), Color(0.30, 0.20, 0.12, 0.85 * a))
	ci.draw_colored_polygon(_ell(p, 21.0 * scale, 10.5 * scale), Color(0.56, 0.41, 0.26, 0.92 * a))
	ci.draw_colored_polygon(_ell(p + Vector2(0, 0.6) * scale, 15.5 * scale, 7.4 * scale), Color(0.62, 0.47, 0.30, 0.6 * a))
	ci.draw_arc(p + Vector2(0, -0.2) * scale, 20.4 * scale, PI * 1.08, PI * 1.92, 14, Color(1.0, 0.9, 0.7, 0.5 * a), 1.1 * scale, true)

## 接觸影子（角色腳下）。
static func ring_shadow(ci: CanvasItem, p: Vector2, scale := 1.0) -> void:
	ci.draw_colored_polygon(_ell(p + Vector2(0, 0.5) * scale, 12.0 * scale, 5.6 * scale), Color(0.08, 0.05, 0.03, 0.34))

static func ring_mark(ci: CanvasItem, p: Vector2, team: int, type: int, cb := false, scale := 1.0) -> void:
	var tc := team_color(team, cb)
	var w := 4.0 if (type == D.SHIELD or type == D.CAVALRY or type == 19) else 3.0   # 第七輪 C2：腳底圈加粗
	var pts := PackedVector2Array()
	if team == 0:
		for i in 25:
			var ang := i * TAU / 24.0
			pts.append(p + Vector2(cos(ang) * 15.0, sin(ang) * 7.5) * scale)
	else:
		pts = PackedVector2Array([p + Vector2(-16, 0) * scale, p + Vector2(0, -8.5) * scale, p + Vector2(16, 0) * scale, p + Vector2(0, 8.5) * scale, p + Vector2(-16, 0) * scale])
	ci.draw_polyline(pts, OUT, w + (6.5 if cb else 2.5), true)   # 第十輪 V9：色盲配色黑邊加粗，黃底座在沙地、草地才分得開
	ci.draw_polyline(pts, tc, w, true)


## 頭頂小旗（8×10）。
static func flag(ci: CanvasItem, p: Vector2, team: int, cb := false) -> void:
	var tc := team_color(team, cb)
	ci.draw_line(p, p + Vector2(0, -12), OUT, 2.0, true)
	var pts := PackedVector2Array([p + Vector2(0, -12), p + Vector2(9, -9), p + Vector2(0, -5)])
	ci.draw_colored_polygon(pts, tc)


## 小靈魂（死亡演出）。
static func soul(ci: CanvasItem, p: Vector2, a: float) -> void:
	ci.draw_circle(p, 7.5, Color(0.86, 0.95, 1.0, a), true, -1.0, true)
	ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-7, 0), p + Vector2(7, 0), p + Vector2(3, 10), p + Vector2(0, 7), p + Vector2(-3, 10)]), Color(0.86, 0.95, 1.0, a))
	ci.draw_circle(p + Vector2(-2.5, -1), 1.3, Color(0.15, 0.15, 0.25, a), true, -1.0, true)
	ci.draw_circle(p + Vector2(2.5, -1), 1.3, Color(0.15, 0.15, 0.25, a), true, -1.0, true)


## 偽裝中的寶箱：闔上，只有偶爾睜一隻眼。不烘焙，直接畫。
static func mimic_closed(ci: CanvasItem, p: Vector2, team: int, face: float, a: float, t: float, cb := false, scale := 1.0) -> void:
	var tc := team_color(team, cb)
	ci.draw_set_transform_matrix(base * Transform2D(0.0, Vector2(scale * face, scale), 0.0, p))
	_poly(ci, PackedVector2Array([Vector2(-16, -3), Vector2(-16, -18), Vector2(16, -18), Vector2(16, -3)]), Color("#9c6b3c"), a)
	_poly(ci, PackedVector2Array([Vector2(-17, -17), Vector2(-15, -31), Vector2(15, -31), Vector2(17, -17)]), tc, a)
	_line(ci, Vector2(-16, -17), Vector2(16, -17), GOLD, 2.4, a)
	_poly(ci, PackedVector2Array([Vector2(-3, -21), Vector2(3, -21), Vector2(3, -13), Vector2(-3, -13)]), GOLD, a)
	if fmod(t, 3.1) < 0.35:
		ci.draw_circle(Vector2(8, -25), 2.6, Color(1, 1, 1, a), true, -1.0, true)
		ci.draw_circle(Vector2(8.6, -25), 1.3, Color(OUT, a), true, -1.0, true)
	ci.draw_set_transform_matrix(base)
	ci.draw_set_transform_matrix(Art.base)

## 倒棋用：只貼木座（帶透明度）。
func draw_base(ci: CanvasItem, p: Vector2, scale := 1.0, a := 1.0) -> void:
	ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
	ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2(4 * CELL, 0, CELL, CELL), Color(1, 1, 1, a))
	ci.draw_set_transform_matrix(Art.base)

func _rect(idx: int) -> Rect2:
	return Rect2((idx % COLS) * CELL, (idx / COLS) * CELL, CELL, CELL)

## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
func quant_walk(walk: float) -> float:
	if walk == 0.0:
		return 0.0
	if walk < -50.0:
		return walk
	return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES

func quant_atk(atk: float) -> float:
	if atk <= 0.0:
		return 0.0
	return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES

## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
		hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false, variant := 0) -> void:
	if absf(face) < 0.9 and has_turn(type):
		if atk <= 0.0:
			_draw_turn(ci, p, type, team, face, hurt, alpha, t, scale, lean, crouch, mood, cb)
			return
		face = (1.0 if face >= 0.0 else -1.0) * maxf(absf(face), 0.45)   # 轉到一半就出手：像厚木牌，不夾成 0.18（Codex v130-impl1）
	var idx := frame_index(type, team, walk, atk, t, p.x, variant)
	if atk > 0.0:
		walk = 0.0   # 攻擊影格烘焙時沒有走路相位：貼圖與疊加都當成沒在走（Codex 收尾輪 #4）
	var bob := Art.idle_bob(t, p) if walk == 0.0 else 0.0   # 與 Art.unit 相同：沒走路時（含攻擊）都有呼吸
	var xf := Art.base * Transform2D(lean * face, Vector2(scale * face / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale))
	ci.draw_set_transform_matrix(xf)
	ci.draw_texture_rect_region(pages[loc[type][0]]["tex"], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
	if hurt > 0.0:
		# V1.3 A6：受擊閃白改成整隻剪影變白（同一格再貼一次、顏色乘到飽和），不再是一顆白圓
		ci.draw_texture_rect_region(pages[loc[type][0]]["tex"], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(4, 4, 4, hurt * 0.55 * alpha))
	if mood != 0:
		# 攻擊影格烘焙時沒有走路相位（Codex R5 #3）
		var qa := quant_atk(atk)
		var qw := 0.0 if qa > 0.0 else quant_walk(walk)
		ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, face, qw, qa, t, scale, lean, crouch, type) * Gait.body_xf(type, qw))
		if mood != 0:
			Art.overlay(ci, type, team, mood, alpha, t, cb)
	ci.draw_set_transform_matrix(Art.base)

## V1.3 A1b：轉身中（|face|＜0.9）貼轉身頁：影格本身已經是轉到一半的姿勢，貼圖只翻正負、不再等比夾扁。
func _draw_turn(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, hurt: float, alpha: float, t: float, scale: float, lean: float, crouch: float, mood := 0, cb := false) -> void:
	var af := absf(face)
	var j := 0 if af >= 0.67 else (1 if af >= 0.42 else 2)
	var idx: int = int(turn_loc[type]) + team * TURN_C.size() + j
	var sg := -1.0 if face < 0.0 else 1.0
	var bob := Art.idle_bob(t, p)
	ci.draw_set_transform_matrix(Art.base * Transform2D(lean * sg, Vector2(scale * sg / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale)))
	ci.draw_texture_rect_region(turn_tex, Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
	if hurt > 0.0:
		ci.draw_texture_rect_region(turn_tex, Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(4, 4, 4, hurt * 0.55 * alpha))
	if mood != 0 and j == 0:
		# 表情疊加（受擊、狂熱…）：轉身中也要有（Codex v130-impl1）；只在接近側面那一格畫，
		if with_fx and gait_on.get(u.id, false):
			_gait_step_snd(u, d)

## 腳步聲：全場一起走會變噪音，所以限量（約每 0.11 秒最多一聲）、音量很小；小石魔例外。
var _step_cool := 0
func _gait_step_snd(u, d: Array) -> void:
	var k: int = Gait.kind(u.type)
	if k == Gait.FLOAT or k == Gait.ROOT or k == Gait.HOP:
		return
	var a: float = Gait.phase_of(u.type, d[0], CS, UNIT_SCALE, u.id)
	var b: float = Gait.phase_of(u.type, d[1], CS, UNIT_SCALE, u.id)
	if int(a / PI) == int(b / PI):
		return
	if u.type == 19:
		sfx.play("step_heavy", 0.55)
		return
	if view.tick <= _step_cool:
		return
	_step_cool = view.tick + 2
	var snd := "step_grass"
	match MapDefs.MAPS[fld_map]["biome"]:
		"ice":
			snd = "step_snow"
		"lava", "canyon":
			snd = "step_stone"
		"river":
			if absi(int(u.x) - fld_w / 2) < fld_w / 10:
				snd = "step_wood"
	sfx.play(snd, 0.16)

## 小石魔、馬、羊落地揚塵。
func _gait_step_fx(u, d: Array) -> void:
	if not gait_on.get(u.id, false):
		return
	var a: float = Gait.phase_of(u.type, d[0], CS, UNIT_SCALE, u.id)
	var b: float = Gait.phase_of(u.type, d[1], CS, UNIT_SCALE, u.id)
	if int(a / PI) != int(b / PI):
		fx.append({"kind": "step", "p": _upos(u), "t": 0.0, "dur": 0.35, "big": u.type == 19})

## 這一幀要畫的走路相位。
func _walk_of(u, a: float) -> float:
	var k: int = Gait.kind(u.type)
	if u.stun > 0 or (drag_t.get(u.id, 0.0) > 0.0):
		if drag_t.get(u.id, 0.0) > 0.0:
			return Gait.POSE_DRAG
		return Gait.POSE_DAZE
	if k == Gait.ROOT:
		return 0.0
	if gait_on.get(u.id, false):
		var d: Array = gait_d.get(u.id, [0.0, 0.0])
		return Gait.phase_of(u.type, lerpf(d[0], d[1], a), CS, UNIT_SCALE, u.id)
	if k == Gait.FLOAT:
		return 0.0001 + time * 4.0 + u.id * 0.37      # 飄浮的就算停著也在飄
	return 0.0

func _gait_frame(delta: float) -> void:
	for id in drag_t.keys():
		drag_t[id] -= delta
		if drag_t[id] <= 0.0:
			drag_t.erase(id)
	for u in view.units:
		var tgt: float = signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
		var f0: float = float(face_now.get(u.id, tgt))
		var f1: float = move_toward(f0, tgt, delta * 11.0)
		face_now[u.id] = f1
		if f0 != 0.0 and signf(f1) != signf(f0):
			turn_t[u.id] = time   # V1.3 A1a：翻面那一刻（腳下揚塵、展開回彈從這裡算）

## 轉身過場（V1.3 A1a）：像厚木牌俐落翻面，不是紙片等比夾扁。
## 寬度不低於 TURN_MIN_W（窄位直接跳過去），展開段 X 微回彈 1.04；不做 Y 下壓（混戰時會像受擊）。
const TURN_MIN_W := 0.45
const TURN_BOUNCE := 0.04
func _face_of(u) -> float:
	var f: float = face_now.get(u.id, signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0))
	var a := absf(f)
	if a < 0.9 and sprites != null and sprites.has_turn(u.type):
		# 有轉身影格的兵：傳原本的朝向，貼圖端選中間姿勢（不能是 0，退回直接繪製時才不會消失）
		return maxf(a, 0.18) * (1.0 if f >= 0.0 else -1.0)
	var w := TURN_MIN_W + (1.0 - TURN_MIN_W) * a
	if a < 1.0 and turn_t.has(u.id) and time - float(turn_t[u.id]) < 0.25:
		w *= 1.0 + TURN_BOUNCE * sin(clampf((a - 0.55) / 0.45, 0.0, 1.0) * PI)
	return w if f >= 0.0 else -w

## 剛翻面的兵腳下的小揚塵：0～1（1＝剛翻），超過 0.25 秒＝0。
func _turn_dust_k(u) -> float:
	if not turn_t.has(u.id):
		return 0.0
	var k: float = (time - float(turn_t[u.id])) / 0.25
	return 1.0 - k if k >= 0.0 and k < 1.0 else 0.0

## 打到不同東西聲音不同：盾與石魔是硬的、史萊姆是軟的。
func _hit_material(id: int) -> void:
	if id < 0 or view == null:
		return
	var u = view.unit_by_id(id)
	if u == null:
		return
	var cp: Vector2 = _upos(u) + Vector2(0, -26)
	match u.type:
		D.SHIELD:
			sfx.play("hit_metal", 0.22)
			call("_add_fx", {"kind": "chips", "p": cp, "t": 0.0, "dur": 0.32, "c": Color("#e8f0ff"), "spark": true})   # V1.1 A2：盾面火花
		19, 12:
			sfx.play("hit_wood", 0.3)
			if u.type == 19:
				call("_add_fx", {"kind": "chips", "p": cp, "t": 0.0, "dur": 0.38, "c": Color("#a89a86")})   # 小石魔碎屑
		13, 20:
			sfx.play("hit_soft", 0.3)
			call("_add_fx", {"kind": "chips", "p": cp, "t": 0.0, "dur": 0.4, "c": Color(0.45, 1.0, 0.55, 0.85), "drop": true})   # 史萊姆綠滴
		var walk: float = _walk_of(u, a_now) if live else ((time * Gait.nominal_rate(u.type, float(D.stat(u.type)["speed"]), CS, UNIT_SCALE) + u.id) if (u.mx != 0 or u.my != 0) else 0.0)
		var moving: bool = walk > 0.0
		var at := 0.0
		var variant := 0
		if live and atk_hit.has(u.id):
			var dt0 := _disp_tick()
			var h := pick_hit(atk_hit[u.id], dt0, u.type)
			if h >= 0:
				at = atk_progress(dt0 - (h - ViewBuffer.DELAY), u.type)
				# 火罐飛行（第四輪 §4.4）：前搖期間從手上飛向目標，命中那一刻落地（模擬不受影響）
				if u.type == D.BOMBER and at > 0.0 and at < Art.ATK_WINDUP and bomb_tgt.get(u.id, {}).has(h):
					var bt = view.unit_by_id(bomb_tgt[u.id][h])
					if bt != null:
						var fk := at / Art.ATK_WINDUP
						var src_p: Vector2 = _upos(u) + Vector2(0, -50)
						var dst_p: Vector2 = _upos(bt) + Vector2(0, -10)
						var pp := src_p.lerp(dst_p, fk) + Vector2(0, -sin(fk * PI) * minf(70.0, src_p.distance_to(dst_p) * 0.3))
						pot_draw.append(pp)
				if u.type == D.SWORD:
					variant = int(atk_seq.get(u.id, {}).get(h, 0)) % 2   # 劍士橫斬與上挑逐擊交替（第三輪 R4）
				elif u.type >= D.CLASSIC and alt_hit.get(u.id, {}).has(h):
					variant = 2
		var hurt := 0.0
		if live and hurt_t.has(u.id) and _fx_on("flash"):
			hurt = clampf(1.0 - (time - hurt_t[u.id]) / 0.15, 0, 1)
		var alpha := 0.45 if u.stealth > 0 else 1.0
		if dim:
			alpha *= 0.6
		if live:
			alpha *= _focus_dim(p)
		var face := signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
		# 受擊後退 4px（第三輪 R2）：0.08 秒退、0.07 秒回，只是畫面
		if live and hurt_t.has(u.id):
			var hk: float = (time - float(hurt_t[u.id])) / 0.15
			if hk >= 0.0 and hk < 1.0:
				p.x += float(hurt_dir.get(u.id, 0.0)) * 4.0 * (sin(hk * PI) if hk < 1.0 else 0.0)
				D.MEDIC:   # 醫者：綠色小十字往上飄
					var mk := fmod(time * 1.2 + u.id * 0.4, 1.0)
					var mc := p + Vector2(-16, -44 - mk * 24 - hop)
					draw_line(mc - Vector2(4, 0), mc + Vector2(4, 0), Color(0.5, 1.0, 0.55, 1.0 - mk), 2.5)
					draw_line(mc - Vector2(0, 4), mc + Vector2(0, 4), Color(0.5, 1.0, 0.55, 1.0 - mk), 2.5)
		p.y -= hop
		if u.hidden:
			Art.mimic_closed(self, p, u.team, face, alpha, time, cbm(), UNIT_SCALE)   # 偽裝中的寶箱怪
			continue
		if u.type == F8.GHOST:
			alpha *= 0.9
			p.y -= 3.0 + 2.5 * sin(time * 2.2 + u.id * 0.9)   # V1.1 A4：幽靈上下漂
		# 待機小動作（V9 P2）：重心換腳、偶爾縮一下身子
		if live and walk == 0.0 and at == 0.0:
			lean += sin(time * 1.1 + u.id * 1.7) * 0.018
			var idle_k := fmod(time + u.id * 1.37, 7.3)
			if idle_k < 0.3:
				crouch *= 1.0 - sin(idle_k / 0.3 * PI) * 0.05
		if live:
			face = _face_of(u)
			var tdk := _turn_dust_k(u)
			if tdk > 0.0 and not rfx:
				# V1.3 A1a：翻面時腳下踩出一小團塵土（畫在身體下面）
				for i in 3:
					var dx := (float(i) - 1.0) * (6.0 + (1.0 - tdk) * 8.0)
					draw_circle(p + Vector2(dx, 1.0 - (1.0 - tdk) * 3.0) , (2.0 + (1.0 - tdk) * 2.5) * UNIT_SCALE, Color(0.85, 0.75, 0.55, 0.55 * tdk), true, -1.0, true)
		if u.stealth > 0:
			# 潛行：身後兩道暗紫殘影
			for g in 2:
				var gp := p + Vector2(-(8 + g * 8) * face, 0)
				draw_circle(gp + Vector2(0, -22), 11.0 - g * 2.0, Color(0.3, 0.15, 0.45, 0.22 - g * 0.08), true, -1.0, true)
				_unit(gp, u.type, u.team, face, 0.0, 0.0, 0.0, 0.14 - g * 0.06, time, UNIT_SCALE)
		if live and walk <= Gait.POSE_DAZE + 1.0:
			# 暈眩：頭上轉圈的星星
			for sk0 in 3:
				var sa0 := time * 5.0 + sk0 * TAU / 3.0
				_icon("star", p + Vector2(cos(sa0) * 15.0, -60.0 + sin(sa0) * 5.0), 13.0, Color("#ffd166"))
		_unit(p, u.type, u.team, face, walk, at, hurt, alpha, time, UNIT_SCALE, mood, lean, crouch, variant)
		if live and not u.hidden:
			xray.append([p, [u.type, u.team, face, walk, at, alpha, lean, crouch, variant]])
		# 揮擊殘影（第三輪 R1、S4 依兵種分開）
		if live and at >= Art.ATK_WINDUP and at < Art.ATK_STRIKE + 0.12:
			var sk := clampf((at - Art.ATK_WINDUP) / (Art.ATK_STRIKE + 0.12 - Art.ATK_WINDUP), 0.0, 1.0)
			_draw_smear(p, u.type, u.team, face, sk, alpha, variant, 1.0)
		# 衝鋒就緒的金色拖尾（第三輪 R3）
		if u.type == D.CAVALRY and moving and u.charge >= D.CHARGE_NEED:
			var phand := Vector2(7 + (w * 6.0 if w < 0.0 else w * 9.0), -17)
			if variant == 2:
				pang = -1.2
				phand = Vector2(9, -14)
			var pdir := Vector2(cos(pang), sin(pang))
			var pbutt := phand - pdir * 14.0
			var ptip := phand + pdir * 40.0
			_line(ci, pbutt, ptip, WOOD, 2.4, a)
			_poly(ci, PackedVector2Array([ptip + pdir * 11.0, ptip + pdir.orthogonal() * 4.4, ptip - pdir.orthogonal() * 4.4]), STEEL, a)   # 第七輪 C1-6：槍尖放大
			var tas := ptip - pdir * 2.0
			_poly(ci, PackedVector2Array([tas, tas + Vector2(-4.6, 8.0), tas + Vector2(0, 6.0), tas + Vector2(3.2, 8.5)]), tc, a)   # 第七輪：槍纓改隊伍色
			if variant == 2:
				_star(ci, ptip + pdir * 6.0, 9.0, Color(0.92, 0.95, 1.0, a))   # 拒騎：槍尖銀色十字閃光
			_c(ci, phand, 3.0, SKIN, a)
			_part_end(ci)
		D.BOMBER:
			# 橘紅頭巾＋黃銅護目鏡（推在額頭上）
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.0, PI * 2.0, 18, Color(OUT, a), 6.5, true)
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.0, PI * 2.0, 18, Color("#ff7a3d", a), 4.0, true)
			_poly(ci, PackedVector2Array([Vector2(-11, hy - 2), Vector2(-17, hy + 4), Vector2(-12, hy + 5)]), Color("#ff7a3d"), a)
			_c(ci, Vector2(1.5, hy - 7.5), 3.4, Color("#d9a441"), a)
			_c(ci, Vector2(8.5, hy - 7.5), 3.4, Color("#d9a441"), a)
			ci.draw_circle(Vector2(1.5, hy - 7.5), 1.8, Color("#9fe3ff", a), true, -1.0, true)
			ci.draw_circle(Vector2(8.5, hy - 7.5), 1.8, Color("#9fe3ff", a), true, -1.0, true)
			# 肩上托一顆帶引線的黑色大圓火罐：前搖往後拉、揮擊時丟出去（手上就空了）；專屬＝被貼身：火罐收到背後、拿點火棒往前敲
			if variant == 2:
