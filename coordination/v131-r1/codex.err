## 單位：p＝腳底；face＝±1；walk＝走路相位（0＝沒走）；atk＝攻擊動作進度 0～1（見上）；hurt＝受擊閃白 0～1；
## alpha＝透明度（潛行）；t＝時間（待機呼吸）；scale＝縮放；mood＝表情疊加（M_*）；lean／crouch 見 unit_xf。
static func unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
		hurt: float, alpha: float, t: float, scale := 1.0, cb := false, mood := 0, lean := 0.0, crouch := 1.0, variant := 0) -> void:
	var tc := team_color(team, cb)
	_team_now = team
	var w: float = pose(atk, type)[0]
	if atk > 0.0:
		walk = 0.0   # 和精靈圖一致：攻擊格沒有走路相位
	_xf = base * unit_xf(p, face, walk, atk, t, scale, lean, crouch, type)
	_b_now = Transform2D.IDENTITY
	if turn_c < 1.0:
		_xf0 = _xf
		# 史萊姆轉向鏡頭時微微拉高（Antigravity v130-impl1：只有眼睛動看不出在轉）
		var sy := 1.0 + 0.06 * (1.0 - turn_c) if type == 13 else 1.0
		_xf = _xf * Transform2D(0.0, Vector2(turn_body_w(type) * (0.97 if type == 13 else 1.0), sy), 0.0, Vector2.ZERO)
	_cur_xf = _xf
	ci.draw_set_transform_matrix(_xf)
	# 以 face＝+1 畫（水平鏡像由 transform 處理）
	if type == D.CAVALRY:
		_cavalry(ci, tc, walk, w, alpha, t, atk > 0.0)
	elif type >= D.COUNT:
		_fantasy(ci, type, tc, walk, w, alpha, t, atk > 0.0, variant)
	else:
		_infantry(ci, type, tc, walk, w, alpha, t, atk > 0.0, variant)
	if hurt > 0.0:
			var phand := Vector2(7 + (w * 6.0 if w < 0.0 else w * 9.0), -17)
			if variant == 2:
				pang = -1.2
				phand = Vector2(9, -14)
			var pdir := Vector2(cos(pang), sin(pang))
			var pbutt := phand - pdir * 14.0
			var ptip := phand + pdir * 40.0
			_line(ci, pbutt, ptip, WOOD, 2.4, a)
			_poly(ci, PackedVector2Array([ptip + pdir * 11.0, ptip + pdir.orthogonal() * 4.4, ptip - pdir.orthogonal() * 4.4]), STEEL, a)   # 第七輪 C1-6：槍尖放大
			var tas := ptip - pdir * 2.0
			_poly(ci, PackedVector2Array([tas, tas + Vector2(-4.6, 8.0), tas + Vector2(0, 6.0), tas + Vector2(3.2, 8.5)]), tc, a)   # 第七輪：槍纓改隊伍色
			if variant == 2:
				_star(ci, ptip + pdir * 6.0, 9.0, Color(0.92, 0.95, 1.0, a))   # 拒騎：槍尖銀色十字閃光
			_c(ci, phand, 3.0, SKIN, a)
			_part_end(ci)
		D.BOMBER:
			# 橘紅頭巾＋黃銅護目鏡（推在額頭上）
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.0, PI * 2.0, 18, Color(OUT, a), 6.5, true)
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.0, PI * 2.0, 18, Color("#ff7a3d", a), 4.0, true)
			_poly(ci, PackedVector2Array([Vector2(-11, hy - 2), Vector2(-17, hy + 4), Vector2(-12, hy + 5)]), Color("#ff7a3d"), a)
			_c(ci, Vector2(1.5, hy - 7.5), 3.4, Color("#d9a441"), a)
			_c(ci, Vector2(8.5, hy - 7.5), 3.4, Color("#d9a441"), a)
			ci.draw_circle(Vector2(1.5, hy - 7.5), 1.8, Color("#9fe3ff", a), true, -1.0, true)
			ci.draw_circle(Vector2(8.5, hy - 7.5), 1.8, Color("#9fe3ff", a), true, -1.0, true)
			# 肩上托一顆帶引線的黑色大圓火罐：前搖往後拉、揮擊時丟出去（手上就空了）；專屬＝被貼身：火罐收到背後、拿點火棒往前敲
3:> 第七輪 J3 建立，V1.3.0 更新。這份只寫「現在是什麼」，不寫過程。數字來源都在程式裡，有衝突以程式為準；改規則、數值、模式時要同步這份。
96:## 活起來、像手作（V1.3.0）
121:- V1.3：轉身中間姿勢只有 6 種兵（其他 16 種用最窄 0.45 的厚木牌翻面）；中間姿勢是用部件轉換推算，不是畫師畫的。轉身中出手仍用最窄 0.45。轉身中更窄的兩格不畫表情疊加（約 0.1 秒）。
122:- V1.3：效能 p95 和 V1.2.1 同機交錯量測持平（10.15 對 10.2 ms，這天機器較慢），p50 多約 0.2 ms；絕對值高於 9.79 的舊參考線（同一台機器 V1.2.1 也是 10.2）。
123:- V1.3：沒有真人看過去紙片、手作感的效果；方案 D 的連環畫、預判、新挑戰型別、慢放選項不做（理由見 `coordination/v130-ledger.md`）。
140:## 最後一次驗收（2026-11-08，V1.3.0 收尾）
144:- 三方：方案三輪；實作 Codex、Antigravity 各審兩輪，必修全修（`coordination/v130-*`）。沒有真人看過 V1.3.0。
