extends RefCounted
## 由 art.gd 拆出（V9 P1，行為不變）
## 程式繪製的 Q 版角色與戰場（優化方案 G：美術先用程式能做到的先做）。
## 全部是向量圖形＋抗鋸齒，沒有外部角色素材。辨識靠三層視覺錨點：腳底隊伍標記、上半身／武器剪影、動態特效。

const D = preload("res://scripts/core/unit_defs.gd")
const Gait = preload("res://scripts/ui/units/gait.gd")

const OUT := Color("#2b2236")   # V1.2 D1：內線色（較淡）；外輪廓改在圖集烘焙時用隊伍墨色加粗（shaders/unit_bake.gdshader）
const INNER_W := 1.2              # V1.2 D1：部件內線寬（原 1.6／3.2／+3）
const SKIN := Color("#ffe1c4")
const BLUSH := Color(1.0, 0.55, 0.6, 0.55)
const STEEL := Color("#c9d3e3")
const STEEL_D := Color("#8c97ab")
const WOOD := Color("#b7814e")
const GOLD := Color("#ffd166")

# 隊伍色（一般／色盲高對比）
## 呼叫端目前的畫布轉換（鏡頭）。角色繪製要「疊加」在它上面，不能覆蓋掉（手感輪 2 抓到的錯位 bug）。
static var base := Transform2D.IDENTITY
static var _xf := Transform2D.IDENTITY   # 目前角色的畫布轉換（腳底座標），上半身另外疊 Gait.body_xf
static var _team_now := 0   # 目前在畫哪一隊（分隊小披風用）

# V1.3 A1b：轉身中間影格（只在烘焙轉身頁時用；平常 turn_c＝1，下面的函式都不動作，畫出來和以前一模一樣）。
# 不是整張等比夾扁：身體依兵種只縮一部分（圓的頭、史萊姆不縮），往前伸的武器跟著透視縮短，
# 近側（z＞0，畫在身體前面）的武器／盾往後移、遠側的往前移，前後遮擋關係就會改變，看起來是轉身不是紙片翻面。
static var turn_c := 1.0     # cos θ：1＝正側面，越小越轉向鏡頭
static var turn_s := 0.0     # sin θ
static var _xf0 := Transform2D.IDENTITY   # 轉身時沒縮過的角色轉換
static var _b_now := Transform2D.IDENTITY # 目前的上半身轉換（_push_body 設）
static var _cur_xf := Transform2D.IDENTITY # 目前畫布轉換（部件之間切換用；_eyes 畫完要還原成這個）
const TURN_FWD := {3: 0.6, 13: 0.0, 19: 0.3}   # 騎兵的馬最窄約 0.58（Antigravity v130-impl1：太窄像插在木棍上）   # 身體跟著縮的比例（沒列＝0.4）：騎兵的馬是長的、史萊姆是圓的

static func turn_body_w(type: int) -> float:
	return lerpf(1.0, turn_c, float(TURN_FWD.get(type, 0.4)))

## 接下來畫的部件：z＝側向深度（＋近側），fwd＝沿前後方向的長度比例（1＝整個跟著透視縮短，0＝不縮）。
static func _part(ci: CanvasItem, z: float, fwd: float) -> void:
	if turn_c >= 1.0:
		return
	_cur_xf = _xf0 * _b_now * Transform2D(0.0, Vector2(lerpf(1.0, turn_c, fwd), 1.0), 0.0, Vector2(-z * turn_s, 0.0))
	ci.draw_set_transform_matrix(_cur_xf)

## 回到身體的轉換。
static func _part_end(ci: CanvasItem) -> void:
	if turn_c >= 1.0:
		return
	_cur_xf = _xf * _b_now
	ci.draw_set_transform_matrix(_cur_xf)

const TEAM := [[Color("#45acff"), Color("#d93a44")], [Color("#2f80ff"), Color("#ffb000")]]   # 第七輪：紅壓暗，灰階下敵我也分得開（小樣通過條件 ②）

# ── 三段式攻擊（第二輪方案 R5）──
# atk（0～1）＝一次攻擊動作的進度：0～ATK_WINDUP 前搖、ATK_WINDUP～ATK_STRIKE 揮擊（命中就在 ATK_WINDUP 那一刻）、之後後搖。
const ATK_WINDUP := 0.3125
const ATK_STRIKE := 0.53125
const LEAN_BACK := 0.2618     # 前搖身體後傾 15°（第三輪 R1，原 12°）
const LEAN_FWD := 0.3840      # 揮擊前撲 22°（第三輪 R1，原 18°）

# 臉部疊加（表情）：同一份畫法同時給直接繪製與精靈圖快取用，兩條路看起來一樣
const M_HURT := 1             # 受擊／暈眩：>< 眼
const M_SPARKLE := 2          # 騎兵衝鋒蓄滿：亮晶晶眼＋槍尖金光
const M_BROWS := 4            # 狂熱：眉毛內傾
const M_HOOD := 8             # 刺客潛行：帽簷壓低、黃眼每 0.4 秒眨一次
const M_BRACE := 16           # 盾兵頂住：盾放大 1.35 倍

# 第八輪：通用表情疊加用的眼睛位置（其他新兵的臉不適合疊）
const FEATURE_EYES := {10: Vector2(1.5, -13), 13: Vector2(3, -17), 18: Vector2(3, -33), 19: Vector2(1, -31), 20: Vector2(2, -11)}


static func team_color(team: int, cb := false) -> Color:
	return TEAM[1 if cb else 0][team]


static func _smooth(u: float) -> float:
	return u * u * (3.0 - 2.0 * u)


static func _star(ci: CanvasItem, c: Vector2, r: float, col: Color) -> void:
	ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0, -r), c + Vector2(r * 0.28, -r * 0.28), c + Vector2(r, 0), c + Vector2(r * 0.28, r * 0.28),
		c + Vector2(0, r), c + Vector2(-r * 0.28, r * 0.28), c + Vector2(-r, 0), c + Vector2(-r * 0.28, -r * 0.28)]), col)


static func _c(ci: CanvasItem, c: Vector2, r: float, col: Color, a: float, outline := true) -> void:
	if outline:
		ci.draw_circle(c, r + INNER_W, Color(OUT, a), true, -1.0, true)
	ci.draw_circle(c, r, Color(col, col.a * a), true, -1.0, true)


static func _poly(ci: CanvasItem, pts: PackedVector2Array, col: Color, a: float, outline := true) -> void:
	if outline:
		var closed := pts.duplicate()
		closed.append(pts[0])
		ci.draw_polyline(closed, Color(OUT, a), INNER_W * 2.0, true)
	ci.draw_colored_polygon(pts, Color(col, col.a * a))


static func _line(ci: CanvasItem, a: Vector2, b: Vector2, col: Color, w: float, al: float) -> void:
	ci.draw_line(a, b, Color(OUT, al), w + INNER_W * 1.9, true)
	ci.draw_line(a, b, Color(col, col.a * al), w, true)


static func _eyes(ci: CanvasItem, c: Vector2, a: float, t: float, angry := false) -> void:
	var blink := 1.0 if fmod(t + c.x * 0.13, 3.7) > 0.12 else 0.15
	if turn_c < 1.0:
		# V1.3 A1b：轉向鏡頭時臉往中間移，眼睛不跟著身體壓扁（保持圓的）
		ci.draw_set_transform_matrix(_xf0 * _b_now)
		c = Vector2(c.x * turn_c, c.y)
		_eyes_draw(ci, c, a, blink, angry)
		ci.draw_set_transform_matrix(_cur_xf)   # 還原成呼叫前的部件轉換（頭盔接著畫，Codex v130-impl1）
		return
	_eyes_draw(ci, c, a, blink, angry)

static func _eyes_draw(ci: CanvasItem, c: Vector2, a: float, blink: float, angry: bool) -> void:
	for dx in [-3.0, 4.0]:
		var e := c + Vector2(dx, 0)
		ci.draw_circle(e, 2.6, Color(OUT, a), true, -1.0, true)
		if blink > 0.5:
			ci.draw_circle(e + Vector2(0.7, -0.8), 0.9, Color(1, 1, 1, a), true, -1.0, true)
		else:
			ci.draw_rect(Rect2(e - Vector2(2.6, 0.6), Vector2(5.2, 1.2)), Color(SKIN, a))
	ci.draw_circle(c + Vector2(-6.5, 4.0), 2.4, Color(BLUSH, BLUSH.a * a), true, -1.0, true)
	ci.draw_circle(c + Vector2(7.5, 4.0), 2.4, Color(BLUSH, BLUSH.a * a), true, -1.0, true)
	if angry:
		# 攻擊：眉毛內傾＋嘴巴張開
		ci.draw_line(c + Vector2(-5.2, -4.4), c + Vector2(-1.0, -3.2), Color(OUT, a), 1.5, true)
		ci.draw_line(c + Vector2(6.2, -4.4), c + Vector2(2.0, -3.2), Color(OUT, a), 1.5, true)
		ci.draw_circle(c + Vector2(0.5, 4.6), 1.7, Color(OUT, a), true, -1.0, true)
		ci.draw_circle(c + Vector2(0.5, 5.2), 0.9, Color("#e05a6a", a), true, -1.0, true)
	else:
		ci.draw_arc(c + Vector2(0.5, 4.2), 1.8, 0.2, PI - 0.2, 6, Color(OUT, a), 1.2, true)


static func _ell(c: Vector2, rx: float, ry: float, a0 := 0.0, a1 := TAU, n := 20) -> PackedVector2Array:
	var pts := PackedVector2Array()
	for i in n:
		var ang := a0 + (a1 - a0) * i / float(n - (0 if is_equal_approx(a1 - a0, TAU) else 1))
		pts.append(c + Vector2(cos(ang) * rx, sin(ang) * ry))
	return pts

## 上半身：腳畫完後呼叫，之後畫的東西跟著起伏與傾身。
## 第十輪 F3：攻擊時整隻壓扁、前衝。腳底為原點，所以不會和腿分離。up＝彈起（往上拉長）。
static func _atk_xf(b: Transform2D, w: float, sq: float, lunge := 0.0, up := false) -> Transform2D:
	if w == 0.0:
		return b
	var sx := 1.0
	var sy := 1.0
	var dx := 0.0
	if w < 0.0:
		sx = 1.0 - w * sq
		sy = 1.0 + w * sq
		dx = w * lunge * 0.3
	elif up:
		sx = 1.0 - w * sq * 0.4
		sy = 1.0 + w * sq * 0.6
	else:
		sx = 1.0 + w * sq * 0.6
		sy = 1.0 - w * sq * 0.3
		dx = w * lunge
	return Transform2D(0.0, Vector2(sx, sy), 0.0, Vector2(dx, 0.0)) * b

static func _push_body(ci: CanvasItem, b: Transform2D) -> void:
	_b_now = b
	_cur_xf = _xf * b
	ci.draw_set_transform_matrix(_xf * b)
extends "res://scripts/ui/units/kit.gd"
## 由 art.gd 拆出（V9 P1，行為不變）

## variant：0 一般招式、1 交替招式（劍士上挑；其他兵種同一般）。第三輪 R4。
## 第四輪：variant 2＝新兵的專屬動作（長槍兵拒騎頓槍、投彈兵被貼身拿點火棒敲、醫者舉杖施法、鼓手大力敲、狂戰士雙斧高舉）。
static func _infantry(ci: CanvasItem, type: int, tc: Color, walk: float, w: float, a: float, t: float, angry := false, variant := 0) -> void:
	# 腿（V9 P2）：腳踩地不動，上半身另外起伏；腿從腰連到腳，分隔不會斷開
	var ft: Array = Gait.feet(type, walk)
	var bx: Transform2D = Gait.body_xf(type, walk)
	var hip_y := -9.0 + bx.origin.y
	var legc := Color("#4a3b5c")
	_line(ci, Vector2(-3.5, hip_y), Vector2(-4 + ft[0], -4.0 - ft[1]), legc, 3.4, a)
	_c(ci, Vector2(-4 + ft[0], -3.0 - ft[1]), 3.6, legc, a)
	_line(ci, Vector2(3.5, hip_y), Vector2(4 + ft[2], -3.0 - ft[3]), legc, 3.4, a)
	_c(ci, Vector2(4 + ft[2], -2.0 - ft[3]), 3.6, legc, a)
	_push_body(ci, bx)
	var wk := Gait.ph(walk)
	var sway: float = Gait.swing(type, walk)
	var fl := sin(wk + 1.0) * 2.5 if wk != 0.0 else 0.0   # 披風延遲擺動
	# 第七輪 C2：小披風分隊，藍方圓角、紅方燕尾（除了圍巾已經很明顯的刺客與騎兵）
	if type != D.ASSASSIN:
		var cape := PackedVector2Array([Vector2(-6, -23), Vector2(-14 - fl * 0.4, -18), Vector2(-16 - fl, -8 + fl * 0.3), Vector2(-12 - fl, -6), Vector2(-7, -9)]) if _team_now == 0 else PackedVector2Array([Vector2(-6, -23), Vector2(-15 - fl * 0.4, -18), Vector2(-18 - fl, -6 + fl * 0.3), Vector2(-13 - fl * 0.8, -10), Vector2(-11 - fl, -5), Vector2(-7, -9)])
		_poly(ci, cape, tc.darkened(0.08), a)
	# 背後的東西（箭筒）
	if type == D.ARCHER:
		# 第七輪 C1-3：箭筒放大、露白羽
		_poly(ci, PackedVector2Array([Vector2(-14, -30), Vector2(-7, -33), Vector2(-3, -11), Vector2(-9, -9)]), WOOD, a)
		for fi in 3:
			var fx0 := Vector2(-12.0 + fi * 3.0, -32.0 - fi * 0.8)
			_line(ci, fx0, fx0 + Vector2(-3 - fl * 0.5, -7), Color.WHITE, 1.8, a)
	# 背後的東西（投彈兵的備用火罐包）
	if type == D.BOMBER:
		_c(ci, Vector2(-10, -20 + fl * 0.8), 7.5, Color("#3a3346"), a)   # 第七輪 C1-7：火罐包放大（V9：跟著跑步彈）
		_line(ci, Vector2(-11, -27 + fl * 0.8), Vector2(-14, -31 + fl * 0.8), Color("#c9a26b"), 1.3, a)
	# 身體（圓胖的上衣，隊伍色；狂戰士赤膊，隊伍色只留在獸皮披肩與褲頭；醫者白袍）
	var bw0 := 13.0 if type == D.SHIELD else 10.5   # 第七輪 C1-2：盾兵身體加寬
	var body := PackedVector2Array()
	for i in 13:
		var ang := PI + i * PI / 12.0
		body.append(Vector2(cos(ang) * bw0, -16 + sin(ang) * 9.0))
	if type == D.MEDIC:
		body.append(Vector2(13, -5)); body.append(Vector2(-13, -5))   # 第七輪 C1-8：A 字長袍
	else:
		body.append(Vector2(bw0 - 0.5, -5)); body.append(Vector2(-bw0 + 0.5, -5))
	_poly(ci, body, SKIN.darkened(0.06) if type == D.BERSERKER else (Color("#f4f1ea") if type == D.MEDIC else tc), a)
	if type == D.BERSERKER:
		# 第七輪 C1-10：披肩加寬＋交叉肩帶＋整條褲頭，隊伍色面積拉大
		_poly(ci, PackedVector2Array([Vector2(-12, -24), Vector2(-2, -27), Vector2(12, -15), Vector2(5, -8), Vector2(-3, -15), Vector2(-11, -13)]), tc, a, false)
		_poly(ci, PackedVector2Array([Vector2(8, -24), Vector2(11, -21), Vector2(-7, -7), Vector2(-10, -10)]), tc.darkened(0.15), a, false)
		_poly(ci, PackedVector2Array([Vector2(-10, -14), Vector2(10, -14), Vector2(10, -5), Vector2(-10, -5)]), tc, a, false)
	elif type == D.MEDIC:
		_poly(ci, PackedVector2Array([Vector2(-12, -11), Vector2(12, -11), Vector2(13, -5), Vector2(-13, -5)]), tc, a, false)   # 白袍下擺露出隊伍色
		_poly(ci, PackedVector2Array([Vector2(-10, -24), Vector2(-3, -26), Vector2(8, -22), Vector2(10, -16), Vector2(0, -19), Vector2(-11, -15)]), tc, a)   # 第七輪 C1-8：大面積隊伍色披肩
	ci.draw_line(Vector2(-9, -11), Vector2(9, -11), Color(OUT, 0.35 * a), 2.0, true)   # 腰帶
	# 頭（V1.3 A1b：轉身時頭不壓扁）
	var hy := -33.0
	_part(ci, 0.0, 0.0)
	_c(ci, Vector2(0, hy), 11.5, SKIN, a)
	# 臉（朝右）
	if type != D.ASSASSIN:
		_eyes(ci, Vector2(3.5, hy + 1), a, t, angry)
	# 兵種特徵
	match type:
		D.SWORD:
			# 頭盔＋羽飾
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.05, PI * 1.95, 18, Color(OUT, a), 6.5, true)
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.05, PI * 1.95, 18, Color(STEEL, a), 4.0, true)
			_poly(ci, PackedVector2Array([Vector2(-2, hy - 12), Vector2(4, hy - 21), Vector2(7, hy - 19), Vector2(3, hy - 11)]), tc.lightened(0.2), a)
			_part_end(ci)
			# 劍：斜舉的亮刃（攻擊時往前揮）
			# 前搖往後拉 35°、揮擊揮到 +60° 以上
			var ang := -1.15 + (w * 0.9 if w < 0.0 else w * 1.95) + sway   # 第十輪 F3：揮幅加大
			if variant == 1:
				# 上挑：前搖把劍壓低到身前下方，揮擊時往上撩過頭頂
				ang = 0.6 + (-w * 0.35 if w < 0.0 else -w * 2.6)
			# 第七輪 C1-1：隊伍色短領巾；劍身加寬、十字護手
			_poly(ci, PackedVector2Array([Vector2(-9, -24), Vector2(8, -24), Vector2(6, -20), Vector2(-3, -19), Vector2(-5, -14), Vector2(-9, -17)]), tc.lightened(0.15), a, true)
			_part(ci, -4.0, 1.0)   # V1.3 A1b：劍透視縮短、留在臉的前方（不橫切五官，Antigravity v130-impl1）
			var hand := Vector2(9, -17 + sway * 8.0)
			var dir := Vector2(cos(ang), sin(ang))
			var tip := hand + dir * 24.0
			var side := dir.orthogonal() * 3.6
			_poly(ci, PackedVector2Array([hand + side, tip + side * 0.3, tip + dir * 3.0, tip - side * 0.3, hand - side]), Color("#f4f7ff"), a)
			_line(ci, hand - dir.orthogonal() * 7.0, hand + dir.orthogonal() * 7.0, GOLD, 3.0, a)
			_c(ci, hand, 3.0, SKIN, a)
			_part_end(ci)
		D.SHIELD:
			# 圓頭盔＋面罩
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 0.95, PI * 2.05, 20, Color(OUT, a), 7.0, true)
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 0.95, PI * 2.05, 20, Color(STEEL_D, a), 4.5, true)
			_line(ci, Vector2(-9, hy - 3), Vector2(11, hy - 3), STEEL_D, 2.0, a)
			_part(ci, -3.0, 0.0)   # V1.3 A1b：大盾朝前，轉向鏡頭時不跟著變窄（Antigravity v130-impl1）
			# 大方盾（佔身體一半寬，正面）
			var push := (w * 12.0 if w > 0.0 else w * 5.0) + sway * 14.0 + 3.0   # V1.3：盾往外 3px，剪影不再是圓膠囊（Antigravity v130-impl1）   # 盾擊：揮擊時整面盾往前推（第三輪 R4）；走路時盾微晃
			# 第七輪 C1-2：盾放大（遮身體六成）、上寬下尖、深鐵色外框，混戰時不會融進隊伍色塊
			var sh := PackedVector2Array([Vector2(1 + push, -43), Vector2(21 + push, -41), Vector2(21 + push, -14), Vector2(11 + push, -2), Vector2(1 + push, -14)])
			_poly(ci, sh, Color("#4a5468"), a)
			var shi := PackedVector2Array([Vector2(4 + push, -39), Vector2(18 + push, -38), Vector2(18 + push, -15), Vector2(11 + push, -6), Vector2(4 + push, -15)])
			_poly(ci, shi, STEEL, a, false)
			_poly(ci, PackedVector2Array([Vector2(7 + push, -33), Vector2(15 + push, -32), Vector2(15 + push, -17), Vector2(11 + push, -11), Vector2(7 + push, -17)]), tc, a, false)
			_part_end(ci)
		D.ARCHER:
			# 綠兜帽＋羽毛
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 0.9, PI * 2.1, 20, Color(OUT, a), 7.0, true)
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 0.9, PI * 2.1, 20, Color(Color("#5aa364"), a), 4.5, true)
			_poly(ci, PackedVector2Array([Vector2(-6, hy - 10), Vector2(-14, hy - 22), Vector2(-9, hy - 10)]), tc.lightened(0.3), a)
			# 長弓
			var pull := 2.0 + 7.0 * -w if w <= 0.0 else 2.0 * (1.0 - w)   # 前搖拉弦、揮擊放箭
			# 第七輪 C1-3：弓放大、淺樺木色，草地上看得到
			var bc := Vector2(12, -22 + sway * 18.0)
			ci.draw_arc(bc, 18.0, -1.3, 1.3, 18, Color(OUT, a), 6.0, true)
			ci.draw_arc(bc, 18.0, -1.3, 1.3, 18, Color(Color("#ecd9a8"), a), 3.4, true)
			var top := bc + Vector2(cos(-1.3), sin(-1.3)) * 18.0
			var bot := bc + Vector2(cos(1.3), sin(1.3)) * 18.0
			var mid := Vector2(bc.x - pull, bc.y)
			ci.draw_line(top, mid, Color(1, 1, 1, 0.9 * a), 1.2, true)
			ci.draw_line(mid, bot, Color(1, 1, 1, 0.9 * a), 1.2, true)
			if w < 0.0:
				# 拉弓時看得到搭在弦上的箭（第三輪 R4）
				_line(ci, mid, Vector2(bc.x + 16, bc.y), WOOD, 1.6, a)
				_poly(ci, PackedVector2Array([Vector2(bc.x + 20, bc.y), Vector2(bc.x + 15, bc.y - 2.5), Vector2(bc.x + 15, bc.y + 2.5)]), STEEL, a, false)
			_c(ci, Vector2(bc.x + 12, bc.y), 3.0, SKIN, a)
		D.ASSASSIN:
			# 尖兜帽＋面罩，只露發光的眼睛
			# 第七輪 C1-5：不再戴紫色尖帽（蓋掉隊伍色、又高又像法師）。貼頭的深色頭巾＋隊伍色長圍巾往後飄
			var flow := sin(t * 5.0 + walk) * 2.0
			_poly(ci, PackedVector2Array([Vector2(-8, hy + 7), Vector2(-24, hy + 3 + flow), Vector2(-29, hy + 9 + flow), Vector2(-21, hy + 12 + flow * 0.5), Vector2(-7, hy + 13)]), tc, a)
			var hood := PackedVector2Array([Vector2(-12, hy + 5), Vector2(-13, hy - 6), Vector2(-5, hy - 13), Vector2(6, hy - 13), Vector2(12, hy - 5), Vector2(12, hy + 5)])
			_poly(ci, hood, Color("#33304a"), a)
			_poly(ci, PackedVector2Array([Vector2(-12, hy - 7), Vector2(-5, hy - 12), Vector2(6, hy - 12), Vector2(11, hy - 7), Vector2(11, hy - 4), Vector2(-12, hy - 4)]), tc, a, false)
			_poly(ci, PackedVector2Array([Vector2(-5, hy - 3), Vector2(11, hy - 3), Vector2(11, hy + 6), Vector2(-5, hy + 6)]), Color("#2b2140"), a, false)
			_poly(ci, PackedVector2Array([Vector2(-11, hy + 5), Vector2(12, hy + 5), Vector2(12, hy + 11), Vector2(-11, hy + 11)]), tc, a)
			_c(ci, Vector2(3.0, hy - 0.5), 1.8, Color("#ffe066"), a, false)
			_c(ci, Vector2(8.0, hy - 0.5), 1.8, Color("#ffe066"), a, false)
			if angry:
				ci.draw_line(Vector2(1.0, hy - 3.6), Vector2(5.0, hy - 2.4), Color("#ffe066", a), 1.3, true)
				ci.draw_line(Vector2(10.0, hy - 3.6), Vector2(6.0, hy - 2.4), Color("#ffe066", a), 1.3, true)
			# 雙短刃
			var sw := w * 6.0 + sway * 10.0
			_line(ci, Vector2(10, -18 - sw), Vector2(21, -8 + sw), Color("#f0f0ff"), 2.8, a)   # 反手短刃：刃往前下，剪影露得出刀尖
			# 後手的刀：揮擊時往前交叉斬（第三輪 R4）
			var bw := maxf(0.0, w)
			_line(ci, Vector2(-8 + bw * 18, -16 - bw * 6), Vector2(-15 + bw * 44, -21 + bw * 16), Color("#f0f0ff"), 2.8, a)   # 加長加粗，看得出交叉
			_c(ci, Vector2(10, -18 - sw), 2.8, Color("#2b2140"), a)
		D.PIKE:
			# 暖銅色扁鍋盔（寬帽簷，避開劍士的銀盔）
			# 第七輪 C1-6：尖角錐笠，輪廓和圓頭盔分得開
			_poly(ci, PackedVector2Array([Vector2(-16, hy - 5), Vector2(0, hy - 18), Vector2(16, hy - 5)]), Color("#c7834a"), a)
			ci.draw_line(Vector2(-8, hy - 7), Vector2(0, hy - 15), Color(1.0, 0.86, 0.55, 0.9 * a), 1.8, true)
			_part(ci, -9.0, 1.0)   # V1.3 A1b：長槍透視縮短、整支移到臉的前方（Antigravity v130-impl2：cos 0.3 時貫穿雙眼）
			# 長槍：平常斜前上方 45° 伸出頭頂；前搖收槍、揮擊放平直刺（第四輪）；專屬＝拒騎：槍幾乎直立、槍尾頓地
			var pang := -0.8 + (w * -0.25 if w < 0.0 else w * 0.75) + sway * 0.8
			var phand := Vector2(7 + (w * 6.0 if w < 0.0 else w * 9.0), -17)
			if variant == 2:
				pang = -1.2
				phand = Vector2(9, -14)
			var pdir := Vector2(cos(pang), sin(pang))
			var pbutt := phand - pdir * 14.0
			var ptip := phand + pdir * 40.0
			_line(ci, pbutt, ptip, WOOD, 2.4, a)
			_poly(ci, PackedVector2Array([ptip + pdir * 11.0, ptip + pdir.orthogonal() * 4.4, ptip - pdir.orthogonal() * 4.4]), STEEL, a)   # 第七輪 C1-6：槍尖放大
			var tas := ptip - pdir * 2.0
			_poly(ci, PackedVector2Array([tas, tas + Vector2(-4.6, 8.0), tas + Vector2(0, 6.0), tas + Vector2(3.2, 8.5)]), tc, a)   # 第七輪：槍纓改隊伍色
			if variant == 2:
				_star(ci, ptip + pdir * 6.0, 9.0, Color(0.92, 0.95, 1.0, a))   # 拒騎：槍尖銀色十字閃光
			_c(ci, phand, 3.0, SKIN, a)
			_part_end(ci)
		D.BOMBER:
			# 橘紅頭巾＋黃銅護目鏡（推在額頭上）
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.0, PI * 2.0, 18, Color(OUT, a), 6.5, true)
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.0, PI * 2.0, 18, Color("#ff7a3d", a), 4.0, true)
			_poly(ci, PackedVector2Array([Vector2(-11, hy - 2), Vector2(-17, hy + 4), Vector2(-12, hy + 5)]), Color("#ff7a3d"), a)
			_c(ci, Vector2(1.5, hy - 7.5), 3.4, Color("#d9a441"), a)
			_c(ci, Vector2(8.5, hy - 7.5), 3.4, Color("#d9a441"), a)
			ci.draw_circle(Vector2(1.5, hy - 7.5), 1.8, Color("#9fe3ff", a), true, -1.0, true)
			ci.draw_circle(Vector2(8.5, hy - 7.5), 1.8, Color("#9fe3ff", a), true, -1.0, true)
			# 肩上托一顆帶引線的黑色大圓火罐：前搖往後拉、揮擊時丟出去（手上就空了）；專屬＝被貼身：火罐收到背後、拿點火棒往前敲
			if variant == 2:
				var sa := -0.9 + maxf(0.0, w) * 1.6
				var sh0 := Vector2(10, -18)
				var sd := Vector2(cos(sa), sin(sa))
				_line(ci, sh0, sh0 + sd * 14.0, Color("#6b4a2b"), 2.4, a)
				_star(ci, sh0 + sd * 16.0, 3.6, Color(1, 0.7, 0.2, a))
				_c(ci, sh0, 3.0, SKIN, a)
			elif w <= 0.25:
				var bp := Vector2(17 + w * 9.0, -24 + (-w) * 4.0 + sway * 12.0)   # 第七輪 C1-7：火罐托在身前、和頭拉開（縮小後不再像髮髻）
				_c(ci, bp, 7.5, Color("#2a2533"), a)
				ci.draw_circle(bp + Vector2(-2.5, -2.5), 2.0, Color(1, 1, 1, 0.35 * a), true, -1.0, true)
				_line(ci, bp + Vector2(2, -7), bp + Vector2(5, -11), Color("#c9a26b"), 1.3, a)
				var sp := 0.6 + 0.4 * sin(t * 22.0)
				_star(ci, bp + Vector2(5.5, -12), 3.2 * sp + 1.0, Color(1, 0.85, 0.3, a))
				_c(ci, Vector2(14 + w * 6.0, -17), 3.0, SKIN, a)
			else:
				# 甩臂：火罐出手後手臂往前下甩（Antigravity P2 #6）
				_line(ci, Vector2(7, -20), Vector2(12 + w * 12.0, -24 + w * 14.0), SKIN, 2.6, a)
				_c(ci, Vector2(12 + w * 12.0, -24 + w * 14.0), 3.0, SKIN, a)
		D.MEDIC:
			# 白色高方帽＋綠十字
			_poly(ci, PackedVector2Array([Vector2(-9, hy - 7), Vector2(-8, hy - 24), Vector2(8, hy - 24), Vector2(9, hy - 7)]), Color("#fbfbf7"), a)
			ci.draw_rect(Rect2(Vector2(-1.6, hy - 21), Vector2(3.2, 10)), Color("#2fbf71", a))
			ci.draw_rect(Rect2(Vector2(-5, hy - 17.6), Vector2(10, 3.2)), Color("#2fbf71", a))
			# 頂端發綠光的長杖：補血時舉高（w 往前＝舉杖）
			var lift := maxf(0.0, w) * 16.0 + (-w * 4.0 if w < 0.0 else 0.0) + sway * 14.0
			if variant == 2:
				lift = 18.0   # 專屬＝施法：雙手把杖高舉過頭
			var sbase := Vector2(15, -4 - lift)
			var stop := Vector2(21, -48 - lift)   # 第七輪：杖往外斜，剪影和方帽分開
			_line(ci, sbase, stop, WOOD, 2.2, a)
			var glow := 0.65 + 0.35 * sin(t * 4.0)
			ci.draw_circle(stop, 7.0 + lift * 0.5, Color(0.4, 1.0, 0.55, (0.28 + lift * 0.02) * glow * a), true, -1.0, true)
			# 第七輪 C1-8：杖頂大十字，遠看也知道是醫者
			_poly(ci, PackedVector2Array([stop + Vector2(-2, -6), stop + Vector2(2, -6), stop + Vector2(2, -2), stop + Vector2(6, -2), stop + Vector2(6, 2), stop + Vector2(2, 2), stop + Vector2(2, 6), stop + Vector2(-2, 6), stop + Vector2(-2, 2), stop + Vector2(-6, 2), stop + Vector2(-6, -2), stop + Vector2(-2, -2)]), Color("#7dffa0"), a)
			if variant == 2:
				_c(ci, Vector2(9.0, -24 - lift), 2.8, SKIN, a)   # 第二隻手也扶著杖
			_c(ci, Vector2(17.0, -20 - lift), 3.0, SKIN, a)
		D.DRUMMER:
			# 紅白羽毛高帽（全兵種最高）
			var hatc := tc.darkened(0.12)   # 第七輪 C1-9：帽子用隊伍色（原本藍方戴紅帽，一眼像紅軍）
			_poly(ci, PackedVector2Array([Vector2(-8, hy - 8), Vector2(-7, hy - 20), Vector2(7, hy - 20), Vector2(8, hy - 8)]), hatc, a)
			_line(ci, Vector2(-8, hy - 10), Vector2(8, hy - 10), GOLD, 1.8, a)
			_poly(ci, PackedVector2Array([Vector2(-2, hy - 20), Vector2(-6 - fl, hy - 36), Vector2(1 - fl * 0.6, hy - 30), Vector2(3, hy - 20)]), Color("#ffffff"), a)
			_poly(ci, PackedVector2Array([Vector2(1, hy - 20), Vector2(4, hy - 33), Vector2(6, hy - 20)]), tc.lightened(0.35), a, false)
			# 胸前大圓鼓
			var dc := Vector2(9, -15)   # 第七輪 C1-9：鼓放大、往前凸
			_c(ci, dc, 11.5, Color("#e9d8a6"), a)
			ci.draw_arc(dc, 11.5, 0.0, TAU, 28, Color(tc, a), 3.2, true)
			_line(ci, dc + Vector2(-6, -6), dc + Vector2(6, 6), Color("#b7814e"), 1.0, a)
			# 鼓棒：平常輕敲、揮擊時舉高大力敲兩下
			var beat := absf(sin(t * 6.0 + wk * 2.0)) * 4.0
			var raise := maxf(0.0, -w) * 16.0 + (beat if w == 0.0 else 0.0) - maxf(0.0, w) * 4.0
			if variant == 2:
				raise = 18.0   # 專屬＝大力連敲：鼓棒舉高
			for k in 2:
				var hx := 2.0 + k * 9.0
				_line(ci, Vector2(hx, -20 - raise), Vector2(hx + 5, -26 - raise - k * 2), Color("#f4e3c1"), 1.8, a)
				_c(ci, Vector2(hx + 5, -26 - raise - k * 2), 2.0, Color("#f4e3c1"), a)
		D.BERSERKER:
			# 火紅刺蝟頭
			var hair := PackedVector2Array([Vector2(-12, hy - 1), Vector2(-15, hy - 10), Vector2(-9, hy - 9), Vector2(-10, hy - 19), Vector2(-3, hy - 13),
				Vector2(0, hy - 23), Vector2(4, hy - 13), Vector2(10, hy - 19), Vector2(9, hy - 9), Vector2(15, hy - 9), Vector2(12, hy - 1), Vector2(0, hy - 8)])
			_poly(ci, hair, Color("#ff5a2a"), a)
			# 左右手各一把闊斧：揮擊時雙斧往下劈（交叉）
			# 待機時雙斧垂在身體兩側往外（不擋臉）；前搖舉過頭、揮擊往前下劈
			var aang := -0.35 + (w * 1.3 if w < 0.0 else w * 1.4) + sway
			if variant == 2:
				aang = -1.75   # 專屬＝破陣：雙斧高舉過頭
			for k2 in 2:
				var ah := Vector2(9, -15) if k2 == 0 else Vector2(-8, -16)
				var aa := aang if k2 == 0 else (PI - aang if w <= 0.0 else aang - 0.4)
				var adir := Vector2(cos(aa), sin(aa))
				var atip := ah + adir * 20.0
				_line(ci, ah, atip, WOOD, 2.4, a)
				var ao := adir.orthogonal()
				var blade := PackedVector2Array([atip - adir * 3.0 + ao * 1.5, atip - adir * 12.0 + ao * 11.0, atip + adir * 5.0 + ao * 10.5])   # 第七輪 C1-10：斧刃放大
				_poly(ci, blade, STEEL, a)
				ci.draw_line(blade[1], blade[2], Color(1, 1, 1, a), 1.6, true)   # 亮銀刃口
				_c(ci, ah, 3.0, SKIN, a)
	if type != D.ASSASSIN and type != D.ARCHER and type != D.SWORD and type != D.PIKE and type != D.BOMBER and type != D.MEDIC and type != D.BERSERKER:
		_c(ci, Vector2(-9, -17 - sway * 8.0), 3.0, SKIN, a)


static func _cavalry(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry := false) -> void:
	var wk := Gait.ph(walk)
	var gallop := sin(wk) * 3.5 if wk != 0.0 else 0.0
	var pony := Color("#d9a066")
	# 腿（V9 P2）：前後腿成對的木馬步，腳踩地不滑
	var ft: Array = Gait.feet(D.CAVALRY, walk)
	var k_leg := 0
	for lx in [-11.0, -5.0, 6.0, 12.0]:
		var front: bool = lx > 0.0
		var fx: float = ft[0] if front else ft[2]
		var fy: float = ft[1] if front else ft[3]
		var lift := maxf(0.0, w) * 12.0 if front else 0.0   # 命中時馬前蹄抬起（第三輪 R4；Antigravity S4 加大）
		fx += 0.6 if k_leg % 2 == 0 else -0.6   # 同一對腿微微錯開（不縮步長，否則又會滑）
		_line(ci, Vector2(lx, -12), Vector2(lx + fx + lift * 0.6, -2 - lift - fy), Color("#9c6b3c"), 3.0, a)
		k_leg += 1
	_push_body(ci, Gait.body_xf(D.CAVALRY, walk))
	# 身體（圓滾滾）
	var body := PackedVector2Array()
	for i in 20:
		var ang := i * TAU / 20.0
		body.append(Vector2(cos(ang) * 16.0, -17 + sin(ang) * 8.5))
	_poly(ci, body, pony, a)
	# 尾巴（隊伍色）
	_poly(ci, PackedVector2Array([Vector2(-15, -20), Vector2(-24, -24 + gallop), Vector2(-22, -14), Vector2(-15, -15)]), tc, a)
	# 頭與鬃毛
	_poly(ci, PackedVector2Array([Vector2(10, -22), Vector2(17, -36), Vector2(27, -33), Vector2(28, -26), Vector2(17, -19)]), pony, a)
	_poly(ci, PackedVector2Array([Vector2(10, -24), Vector2(14, -37), Vector2(18, -36), Vector2(14, -23)]), tc, a, false)
	_c(ci, Vector2(23, -31), 1.8, OUT, a, false)
	ci.draw_circle(Vector2(23.6, -31.6), 0.7, Color(1, 1, 1, a), true, -1.0, true)
	# 鞍布
	_poly(ci, PackedVector2Array([Vector2(-7, -25), Vector2(6, -25), Vector2(7, -15), Vector2(-8, -15)]), tc, a)
	# 騎士（小一號；V1.3 A1b：轉身時騎士不跟著馬壓扁）
	var hy := -44.0
	_part(ci, 0.0, 0.3)
	_c(ci, Vector2(-1, -30), 6.5, tc.darkened(0.15), a)
	_part(ci, 0.0, 0.0)
	_c(ci, Vector2(-1, hy), 9.0, SKIN, a)
	_eyes(ci, Vector2(2.0, hy + 1), a, t, angry)
	ci.draw_arc(Vector2(-1, hy), 9.5, PI * 1.0, PI * 2.0, 18, Color(OUT, a), 6.0, true)
	ci.draw_arc(Vector2(-1, hy), 9.5, PI * 1.0, PI * 2.0, 18, Color(GOLD, a), 3.5, true)
	# 長槍＋小旗（衝鋒時放平前刺）
	var tilt: float = (-0.55 + w * 0.3 if w < 0.0 else -0.55 * (1.0 - w)) + Gait.swing(D.CAVALRY, walk)   # 前搖舉高、揮擊放平前刺
	_part(ci, -9.0, 1.0)   # 騎槍透視縮短、整支移到臉的前方
	var base := Vector2(-6, -30)
	var dir := Vector2(cos(tilt), sin(tilt))
	var tip := base + dir * 50.0   # 第七輪 C1-4：騎槍加長
	_line(ci, base, tip, WOOD, 2.6, a)
	_poly(ci, PackedVector2Array([tip, tip - dir * 7.0 + dir.orthogonal() * 3.0, tip - dir * 7.0 - dir.orthogonal() * 3.0]), STEEL, a)
	var f0 := base + dir * 32.0
	_poly(ci, PackedVector2Array([f0, f0 + dir * 11.0, f0 + dir * 3.0 + dir.orthogonal() * 10.0]), tc.lightened(0.2), a)   # 隊伍色小旗放大
	_part_end(ci)
extends "res://scripts/ui/units/kingdom.gd"
## 由 art.gd 拆出（V9 P1，行為不變）

# ───────────────────────── 第八輪奇幻軍 ─────────────────────────
## 隊伍色放上半身、面積要夠（§6）。全部 Q 版二頭身、粗黑框、白眼黑瞳。
static func _fantasy(ci: CanvasItem, type: int, tc: Color, walk: float, w: float, a: float, t: float, angry := false, variant := 0) -> void:
	match type:
		10: _f_spore(ci, tc, walk, w, a, t, angry)
		11: _f_sheep(ci, tc, walk, w, a, t, angry)
		12: _f_mimic(ci, tc, walk, w, a, t, angry)
		13: _f_slime(ci, tc, walk, w, a, t, angry, 1.0)
		14: _f_ghost(ci, tc, walk, w, a, t, angry)
		15: _f_doll(ci, tc, walk, w, a, t, angry)
		16: _f_sprite(ci, tc, walk, w, a, t, angry)
		17: _f_bone(ci, tc, walk, w, a, t, angry, variant)
		18: _f_cat(ci, tc, walk, w, a, t, angry, variant)
		19: _f_golem(ci, tc, walk, w, a, t, angry, variant)
		20: _f_slime(ci, tc, walk, w, a, t, angry, 0.66)
		21: _f_skeleton(ci, tc, walk, w, a, t, angry)


static func _f_spore(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
	_push_body(ci, _atk_xf(Gait.body_xf(10, walk), maxf(w, 0.0), 0.3, 0.0, true))
	# 短胖的柄＋超大菇傘；攻擊（噴毒）時整朵壓扁再彈起，底下兩朵小芽
	var sq := 1.0 + maxf(0.0, w) * 0.22 - minf(0.0, w) * 0.1
	var low := 1.0 - maxf(0.0, w) * 0.2
	for s in [[-14.0, 4.0], [14.0, 3.2]]:
		_poly(ci, PackedVector2Array([Vector2(s[0] - 1.6, -2), Vector2(s[0] - 1.2, -6), Vector2(s[0] + 1.2, -6), Vector2(s[0] + 1.6, -2)]), Color("#f2e6cf"), a, false)
		ci.draw_circle(Vector2(s[0], -7), s[1], Color(OUT, a), true, -1.0, true)
		ci.draw_circle(Vector2(s[0], -7), s[1] - 1.4, Color(tc, a), true, -1.0, true)
	_poly(ci, PackedVector2Array([Vector2(-10, -3), Vector2(-8, -22 * low), Vector2(8, -22 * low), Vector2(10, -3)]), Color("#f2e6cf"), a)
	ci.draw_line(Vector2(-6, -8), Vector2(6, -8), Color("#d9c6a3", a), 1.4, true)
	_eyes(ci, Vector2(1.5, -13 * low), a, t, angry)
	var cy := -22.0 * low
	var cap := _ell(Vector2(0, cy), 22.0 * sq, 19.0 * low, PI, TAU, 16)
	cap.append(Vector2(15 * sq, cy + 5)); cap.append(Vector2(-15 * sq, cy + 5))
	_poly(ci, cap, tc, a)
	ci.draw_arc(Vector2(0, cy), 16.0 * sq, PI * 1.15, PI * 1.5, 8, Color(1, 1, 1, 0.4 * a), 2.6, true)
	for d in [[-11, -8, 3.6], [3, -14, 4.4], [13, -6, 3.0], [-3, -4, 2.6]]:
		_c(ci, Vector2(d[0] * sq, cy + d[1] * low), d[2], Color("#fff7e6"), a, false)
	if w > 0.0:
		for k in 5:
			var an := -PI + k * PI / 4.0
			ci.draw_circle(Vector2(cos(an) * (24 + w * 8), cy + sin(an) * (17 + w * 8)), 2.6, Color(0.7, 1.0, 0.45, 0.85 * a), true, -1.0, true)


static func _f_sheep(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
	var wk := Gait.ph(walk)
	var ft: Array = Gait.feet(11, walk)
	for lx in [-11.0, -4.0, 5.0, 12.0]:
		var front: bool = lx > 0.0
		var sw: float = (ft[0] if front else ft[2])
		var up: float = (ft[1] if front else ft[3])
		_line(ci, Vector2(lx, -10), Vector2(lx + sw, -3 - up), Color("#4a4258"), 3.0, a)
		_c(ci, Vector2(lx + sw, -2.5 - up), 2.4, Color("#1d1a2b"), a, false)   # 黑蹄
	_push_body(ci, Gait.body_xf(11, walk))
	# 羊毛染隊伍色（白毛會被特效洗掉）
	var wool := tc.lightened(0.14)
	var blobs := [[-11, -18, 9.5], [0, -23, 11.5], [11, -18, 9.0], [-5, -13, 8.5], [6, -13, 8.5], [-1, -30, 8.5], [-9, -26, 7.5], [8, -27, 7.5]]
	for b in blobs:
		_c(ci, Vector2(b[0], b[1]), b[2], wool, a)
	for b2 in blobs:
		ci.draw_circle(Vector2(b2[0], b2[1]), b2[2], Color(wool, a), true, -1.0, true)
	for h in [[-5, -28, 3.6], [6, -25, 2.8], [-9, -18, 2.4]]:
		ci.draw_circle(Vector2(h[0], h[1]), h[2], Color(1, 1, 1, 0.4 * a), true, -1.0, true)
	# 臉
	_c(ci, Vector2(16, -22), 8.5, Color("#3a3346"), a)
	_poly(ci, PackedVector2Array([Vector2(9, -27), Vector2(4, -30), Vector2(7, -24)]), Color("#3a3346"), a)   # 耳朵
	for ex in [13.0, 19.0]:
		ci.draw_circle(Vector2(ex, -23), 2.9, Color(1, 1, 1, a), true, -1.0, true)
		ci.draw_circle(Vector2(ex + 0.7, -23), 1.4, Color(OUT, a), true, -1.0, true)
	ci.draw_arc(Vector2(16, -18), 2.6, 0.3, PI - 0.3, 6, Color(1, 1, 1, 0.8 * a), 1.2, true)
	# 頭上的引線（招牌）：越接近爆炸火花越大
	_line(ci, Vector2(-1, -37), Vector2(4, -47), Color("#c9a26b"), 1.8, a)
	var sp := 0.7 + 0.3 * sin(t * 18.0 + wk * 3.0) + maxf(0.0, w)
	_star(ci, Vector2(5, -49), 5.0 * sp + 1.0, Color(1, 0.8, 0.25, a))


static func _f_mimic(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
	# V9 P2：走路時閉蓋貼地跳（整隻離地在 Gait.air），只有箱蓋輕敲；接敵才張嘴
	var wk := Gait.ph(walk)
	_push_body(ci, Gait.body_xf(12, walk))
	var open := 0.45 + maxf(0.0, w) * 0.55 - minf(0.0, w) * 0.2
	if wk != 0.0 and w == 0.0:
		open = 0.04 + absf(sin(wk)) * 0.26   # 跳到最高才張嘴露一點舌（Antigravity P2 #1）
	var by := -3.0
	_poly(ci, PackedVector2Array([Vector2(-16, by), Vector2(-16, by - 15), Vector2(16, by - 15), Vector2(16, by)]), Color("#9c6b3c"), a)
	ci.draw_line(Vector2(-16, by - 7), Vector2(16, by - 7), Color(OUT, 0.5 * a), 1.6, true)
	for rv in [[-14, by - 2], [14, by - 2], [-14, by - 13], [14, by - 13]]:
		ci.draw_circle(Vector2(rv[0], rv[1]), 1.5, Color(GOLD, a), true, -1.0, true)   # 鉚釘
	# 舌頭與牙
	var mouth := by - 15.0
	_poly(ci, PackedVector2Array([Vector2(-13, mouth), Vector2(13, mouth), Vector2(13, mouth - 4 - open * 10), Vector2(-13, mouth - 4 - open * 10)]), Color("#3b0f1e"), a, false)
	var lick := maxf(0.0, w) * 8.0
	if open > 0.2:
		_poly(ci, PackedVector2Array([Vector2(2, mouth), Vector2(19 + lick, mouth + 2), Vector2(23 + lick, mouth - 3), Vector2(19 + lick, mouth - 7), Vector2(4, mouth - 5)]), Color("#ff6b81"), a)
	for k in 4:
		var tx := -10.0 + k * 7.0
		ci.draw_colored_polygon(PackedVector2Array([Vector2(tx, mouth), Vector2(tx + 5, mouth), Vector2(tx + 2.5, mouth - 5)]), Color(1, 1, 1, a))
	# 箱蓋（隊伍色，面積最大）
	var ly := mouth - 4 - open * 12
	_poly(ci, PackedVector2Array([Vector2(-19, ly), Vector2(-17, ly - 17), Vector2(17, ly - 19), Vector2(19, ly)]), tc, a)
	_line(ci, Vector2(-17, ly - 1), Vector2(17, ly - 1), GOLD, 2.0, a)
	_poly(ci, PackedVector2Array([Vector2(-16, by - 15), Vector2(-9, by - 15), Vector2(-9, by), Vector2(-16, by)]), tc.darkened(0.1), a, false)
	_poly(ci, PackedVector2Array([Vector2(9, by - 15), Vector2(16, by - 15), Vector2(16, by), Vector2(9, by)]), tc.darkened(0.1), a, false)
	for k2 in 2:
		var ex := -6.0 + k2 * 12.0
		ci.draw_circle(Vector2(ex, ly - 9), 3.6, Color(1, 1, 1, a), true, -1.0, true)
		ci.draw_circle(Vector2(ex + 1, ly - 9), 1.8, Color(OUT, a), true, -1.0, true)
	if angry:
		ci.draw_line(Vector2(-10, ly - 14), Vector2(-3, ly - 12), Color(OUT, a), 1.6, true)
		ci.draw_line(Vector2(10, ly - 14), Vector2(3, ly - 12), Color(OUT, a), 1.6, true)


static func _f_slime(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool, k: float) -> void:
	# 果凍：底部微扁、頂上一小尖，走路和攻擊時壓扁彈起
	var wk := Gait.ph(walk)
	# 落地壓扁、騰空拉長（Antigravity P2 #2）：拉長時整隻離地（Gait.air）
	var sq := (1.14 - absf(sin(wk)) * 0.26 if wk != 0.0 else 1.0) + maxf(0.0, w) * 0.3 - minf(0.0, w) * 0.12
	if walk < -150.0:
		sq = 1.22
	var rx := 20.0 * k * sq
	var ry := 17.0 * k / sq
	var cy := -ry - 1.0
	var pts := _ell(Vector2(0, cy), rx, ry * 1.02, 0.08, PI - 0.08, 12)
	pts.append(Vector2(-rx * 0.9, cy - ry * 0.5))
	pts.append(Vector2(-rx * 0.45, cy - ry * 1.0))
	pts.append(Vector2(0.5 * k, cy - ry * 1.5))
	pts.append(Vector2(rx * 0.45, cy - ry * 1.0))
	pts.append(Vector2(rx * 0.9, cy - ry * 0.5))
	_poly(ci, pts, tc.lightened(0.05), a)
	ci.draw_arc(Vector2(0, cy - ry * 0.1), rx * 0.82, 0.55, PI - 0.55, 10, Color(tc.darkened(0.25), 0.55 * a), 2.6 * k, true)
	ci.draw_circle(Vector2(-rx * 0.45, cy - ry * 0.4), 3.8 * k, Color(1, 1, 1, 0.6 * a), true, -1.0, true)
	ci.draw_circle(Vector2(-rx * 0.18, cy - ry * 0.85), 1.8 * k, Color(1, 1, 1, 0.6 * a), true, -1.0, true)
	for b in [[0.5, 0.45, 2.2], [-0.25, 0.65, 1.6], [0.62, -0.1, 1.5]]:
		ci.draw_arc(Vector2(rx * b[0], cy + ry * b[1]), b[2] * k, 0, TAU, 8, Color(1, 1, 1, 0.35 * a), 1.0, true)
	_eyes(ci, Vector2(3.0 * k, cy + 1.0), a, t, angry)


static func _f_ghost(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
	# 無腳飄浮：飄逸的長裙擺，隊伍色披巾在肩上；攻擊時張大嘴
	var body := tc.lightened(0.3)
	var wk := Gait.ph(walk)
	var lean := w * 4.0 + (4.5 if wk != 0.0 else 0.0)   # 前進要看得出來（Antigravity P2 #7）
	var sway := sin(t * 2.0 + wk) * 2.6
	_push_body(ci, Gait.body_xf(14, walk))
	var top := -48.0
	var pts := _ell(Vector2(lean, top + 15), 16.0, 15.0, PI, TAU, 14)
	for s in [[16.0, -24.0], [17.0, -14.0], [11.0, -5.0 + sway], [7.0, -11.0], [2.0, -3.0 - sway], [-3.0, -11.0], [-8.0, -4.0 + sway], [-13.0, -11.0], [-18.0, -7.0 - sway], [-16.0, -24.0]]:
		pts.append(Vector2(s[0] + lean * (0.2 + (-s[1]) * 0.02), s[1]))
	_poly(ci, pts, Color(body, 0.94), a)
	_poly(ci, PackedVector2Array([Vector2(-16 + lean, -33), Vector2(16 + lean, -33), Vector2(17 + lean * 0.7, -24), Vector2(4 + lean * 0.5, -21), Vector2(-16 + lean * 0.7, -24)]), tc, a, false)
	ci.draw_line(Vector2(-16 + lean, -33), Vector2(16 + lean, -33), Color(tc.darkened(0.25), a), 1.6, true)
	var ey := -40.0
	for ex in [-2.0 + lean, 7.0 + lean]:
		ci.draw_circle(Vector2(ex, ey), 3.3, Color(OUT, a), true, -1.0, true)
		ci.draw_circle(Vector2(ex + 0.9, ey - 1.0), 1.1, Color(1, 1, 1, a), true, -1.0, true)
		ci.draw_arc(Vector2(ex, ey), 4.8, 0.4, PI - 0.4, 6, Color(tc.darkened(0.2), 0.6 * a), 1.4, true)   # 黑眼圈
	if angry or w > 0.0:
		ci.draw_circle(Vector2(2.5 + lean, ey + 7), 3.2, Color(OUT, a), true, -1.0, true)
	else:
		ci.draw_arc(Vector2(2.5 + lean, ey + 5), 2.2, 0.3, PI - 0.3, 6, Color(OUT, a), 1.3, true)
	var hd := sin(wk + 0.9) * 2.0 if wk != 0.0 else 0.0   # 手延遲
	_c(ci, Vector2(-15 + lean + w * 5.0 - hd, -25 + hd), 3.6, body, a)
	_c(ci, Vector2(16 + lean + maxf(0.0, w) * 10.0 - hd, -26 - hd), 3.6, body, a)


static func _f_doll(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
	var ft: Array = Gait.feet(15, walk)
	var bx: Transform2D = Gait.body_xf(15, walk)
	_line(ci, Vector2(-5, -11 + bx.origin.y), Vector2(-5 + ft[0], -2 - ft[1]), Color("#c9a26b"), 3.2, a)
	_line(ci, Vector2(5, -11 + bx.origin.y), Vector2(5 + ft[2], -2 - ft[3]), Color("#c9a26b"), 3.2, a)
	_push_body(ci, bx)
	var sway: float = Gait.swing(15, walk)
	# 隊伍色布身，粗縫線
	var body := PackedVector2Array([Vector2(-11, -8), Vector2(-13, -24), Vector2(13, -24), Vector2(11, -8)])
	_poly(ci, body, tc, a)
	for k in 3:
		var y := -21.0 + k * 5.0
		ci.draw_line(Vector2(-3, y), Vector2(3, y + 2.2), Color(OUT, 0.8 * a), 1.5, true)
		ci.draw_line(Vector2(3, y), Vector2(-3, y + 2.2), Color(OUT, 0.8 * a), 1.5, true)
	_line(ci, Vector2(-12, -21), Vector2(-17 - sway * 12.0, -15 - w * 5.0 + sway * 6.0), tc.darkened(0.15), 3.2, a)
	_line(ci, Vector2(12, -21), Vector2(18 + sway * 12.0, -15 + w * -5.0 + sway * 6.0), tc.darkened(0.15), 3.2, a)
	# 麻布頭、一邊大鈕扣、一邊 X
	_c(ci, Vector2(0, -35), 12.5, Color("#e8d3a8"), a)
	_c(ci, Vector2(6, -35), 4.6, tc.lightened(0.3), a)
	ci.draw_circle(Vector2(5, -36), 1.1, Color(OUT, a), true, -1.0, true)
	ci.draw_circle(Vector2(7.5, -34), 1.1, Color(OUT, a), true, -1.0, true)
	ci.draw_line(Vector2(-8, -38), Vector2(-3, -33), Color(OUT, a), 2.0, true)
	ci.draw_line(Vector2(-3, -38), Vector2(-8, -33), Color(OUT, a), 2.0, true)
	ci.draw_line(Vector2(-4, -28), Vector2(5, -28), Color(OUT, a), 1.5, true)
	# 頭上插一根大針（招牌）
	var nd := sway * 14.0
	_line(ci, Vector2(-3, -40), Vector2(-11 - nd, -54), STEEL, 1.8, a)
	_c(ci, Vector2(-12 - nd, -56), 3.4, Color("#ff4d6d"), a)


static func _f_sprite(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
	var wk := Gait.ph(walk)
	_push_body(ci, Gait.body_xf(16, walk))
	# 飄浮的大沙漏，不畫人形（免得和鼓手、醫者撞）；弧形翅膀、沙子往下流
	var flap := sin(t * 9.0 + wk * 3.0) * 4.5 - minf(w, 0.0) * 6.0
	for s in [-1.0, 1.0]:
		var wing := PackedVector2Array([Vector2(s * 8, -32), Vector2(s * 18, -47 + flap), Vector2(s * 29, -48 + flap), Vector2(s * 33, -37 + flap), Vector2(s * 28, -26 + flap * 0.6), Vector2(s * 19, -19), Vector2(s * 9, -22)])
		_poly(ci, wing, Color(tc.lightened(0.42), 0.97), a)
		ci.draw_line(Vector2(s * 11, -30), Vector2(s * 27, -41 + flap), Color(tc, 0.7 * a), 1.6, true)
		ci.draw_line(Vector2(s * 11, -26), Vector2(s * 26, -31 + flap * 0.8), Color(tc, 0.7 * a), 1.6, true)
	var glass := Color("#e8f4ff")
	_poly(ci, PackedVector2Array([Vector2(-13, -47), Vector2(13, -47), Vector2(2, -27), Vector2(13, -8), Vector2(-13, -8), Vector2(-2, -27)]), glass, a)
	_poly(ci, PackedVector2Array([Vector2(-9, -41), Vector2(9, -41), Vector2(1, -29), Vector2(-1, -29)]), tc, a, false)
	_poly(ci, PackedVector2Array([Vector2(-11, -9), Vector2(11, -9), Vector2(6, -17), Vector2(0, -22), Vector2(-6, -17)]), tc, a, false)
	var flow := fmod(t * 2.0 + wk / TAU, 1.0)
	for k in 3:
		ci.draw_circle(Vector2(0, -28 + fmod(flow + k * 0.33, 1.0) * 8.0), 1.1, Color(tc, a), true, -1.0, true)
	ci.draw_line(Vector2(-8, -44), Vector2(-4, -36), Color(1, 1, 1, 0.8 * a), 1.6, true)
	for fy in [-50.0, -7.0]:
		_line(ci, Vector2(-16, fy), Vector2(16, fy), GOLD, 4.0, a)
	# 臉畫在上半部玻璃裡（放頂框上面像多擺一顆頭，也會頂到圓框）
	_c(ci, Vector2(0, -38), 6.5, Color("#fff3d6"), a)
	_eyes(ci, Vector2(0.5, -38.0), a, t, angry)


static func _f_bone(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool, variant: int) -> void:
	# 駝背骷髏＋破斗篷，高舉攤開的魔法書（不拿杖，和醫者分開）；身旁飄一顆小骷髏燈
	var ft: Array = Gait.feet(17, walk)
	var wk := Gait.ph(walk)
	_c(ci, Vector2(-5 + ft[0], -3 - ft[1]), 3.2, Color("#ece6d6"), a)
	_c(ci, Vector2(4 + ft[2], -3 - ft[3]), 3.2, Color("#ece6d6"), a)
	_push_body(ci, _atk_xf(Gait.body_xf(17, walk), w, 0.1, 3.0))
	var hem := sin(wk + 1.0) * 2.5 if wk != 0.0 else 0.0   # 袍擺延遲
	var cape := PackedVector2Array([Vector2(-17 - hem, -4), Vector2(-19 - hem * 0.5, -26), Vector2(-9, -40), Vector2(9, -32), Vector2(13 - hem * 0.6, -7), Vector2(7 - hem * 0.6, -10), Vector2(2 - hem, -4), Vector2(-4 - hem, -10), Vector2(-11 - hem, -4)])
	_poly(ci, cape, tc, a)
	for x0 in [-14.0, -3.0]:
		ci.draw_line(Vector2(x0, -24), Vector2(x0 + 1, -9), Color(tc.darkened(0.25), a), 1.6, true)
	# 兜帽＋骷髏臉，頭往前探
	_poly(ci, _ell(Vector2(2, -39), 15.0, 14.0, PI * 0.72, PI * 2.05, 14), tc.darkened(0.15), a)
	_c(ci, Vector2(6, -35), 10.5, Color("#f5f0e0"), a)
	for ex in [2.0, 10.0]:
		ci.draw_circle(Vector2(ex, -36), 3.2, Color(OUT, a), true, -1.0, true)
		ci.draw_circle(Vector2(ex + 0.4, -36), 1.1, Color("#c77dff", a), true, -1.0, true)
	ci.draw_colored_polygon(PackedVector2Array([Vector2(6, -33), Vector2(4.5, -30), Vector2(7.5, -30)]), Color(OUT, a))
	for k in 4:
		ci.draw_line(Vector2(2.0 + k * 2.6, -28), Vector2(2.0 + k * 2.6, -25), Color(OUT, a), 1.2, true)
	# 高舉的書與紫火：專屬動作舉更高
	var lift: float = 6.0 + maxf(0.0, -w) * 8.0 + maxf(0.0, w) * 3.0 + (10.0 if variant == 2 else 0.0) + Gait.swing(17, walk) * 12.0
	var bk := Vector2(20, -22 - lift)
	_line(ci, Vector2(9, -20), bk + Vector2(-2, 4), Color("#ece6d6"), 2.4, a)
	_poly(ci, PackedVector2Array([bk + Vector2(-10, -2), bk + Vector2(0, 0), bk + Vector2(10, -2), bk + Vector2(10, 4), bk + Vector2(0, 6), bk + Vector2(-10, 4)]), Color("#6b4a2b"), a)
	ci.draw_line(bk + Vector2(0, 0), bk + Vector2(0, 6), Color(OUT, a), 1.2, true)
	var fl := 8.0 + absf(w) * 7.0 + sin(t * 12.0 + wk * 3.0) * 1.8
	_poly(ci, PackedVector2Array([bk + Vector2(-6, -1), bk + Vector2(6, -1), bk + Vector2(3, -2 - fl), bk + Vector2(0, -6 - fl), bk + Vector2(-3, -2 - fl)]), Color("#b14dff"), a)
	ci.draw_circle(bk + Vector2(0, -4 - fl * 0.3), 2.4, Color(1, 0.85, 1, 0.9 * a), true, -1.0, true)


static func _f_cat(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool, variant: int) -> void:
	var ft: Array = Gait.feet(18, walk)
	var wk := Gait.ph(walk)
	var leg := sin(wk) * 4.0 if wk != 0.0 else 0.0
	# 腳先畫，上半身（尾巴、吸塵器、頭）跟著起伏
	_c(ci, Vector2(-4 + ft[0], -3 - ft[1]), 3.4, tc.darkened(0.2), a)
	_c(ci, Vector2(5 + ft[2], -3 - ft[3]), 3.4, tc.darkened(0.2), a)
	_push_body(ci, _atk_xf(Gait.body_xf(18, walk), w, 0.14, 5.0))
	# 尾巴、背上的吸塵器桶
	_line(ci, Vector2(-11, -8), Vector2(-20 - leg * 0.4, -18 + leg), tc.darkened(0.1), 3.0, a)
	_poly(ci, PackedVector2Array([Vector2(-20, -32), Vector2(-7, -32), Vector2(-7, -8), Vector2(-20, -8)]), Color("#b7bfcc"), a)
	_poly(ci, PackedVector2Array([Vector2(-20, -24), Vector2(-7, -24), Vector2(-7, -17), Vector2(-20, -17)]), tc, a, false)
	_poly(ci, _ell(Vector2(0, -14), 11.0, 10.0, 0.0, TAU, 16), tc.lightened(0.15), a)
	# 大頭＋貓耳
	var hy := -33.0
	for s in [-1.0, 1.0]:
		_poly(ci, PackedVector2Array([Vector2(s * 3.5, hy - 11), Vector2(s * 13, hy - 8), Vector2(s * 11, hy - 21)]), tc, a)
	_c(ci, Vector2(0, hy), 12.0, tc.lightened(0.3), a)
	_eyes(ci, Vector2(3.0, hy), a, t, angry)
	for s2 in [-1.0, 1.0]:
		ci.draw_line(Vector2(s2 * 9 + 2, hy + 4), Vector2(s2 * 16 + 2, hy + 3), Color(OUT, 0.7 * a), 1.0, true)
	# 吸管與吸頭
	var aim: float = -0.1 - w * 0.25 - (0.5 if variant == 2 else 0.0) + Gait.swing(18, walk)
	var nz := Vector2(10, -14) + Vector2(cos(aim), sin(aim)) * 13.0
	_line(ci, Vector2(-6, -18), Vector2(8, -13), Color("#55606f"), 2.6, a)
	_line(ci, Vector2(8, -13), nz, Color("#9aa4b4"), 3.0, a)
	_poly(ci, PackedVector2Array([nz + Vector2(0, -3), nz + Vector2(9, -7), nz + Vector2(9, 7), nz + Vector2(0, 3)]), STEEL, a)


static func _f_golem(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool, variant: int) -> void:
	# 無頸寬扁巨岩，頭嵌在胸口（和盾兵的前排人形分開）；肩甲、胸口石紋都是隊伍色；攻擊雙臂高舉下砸
	var rock := Color("#8d8a80")
	var ft: Array = Gait.feet(19, walk)
	var lf: float = ft[0]
	var rf: float = ft[2]
	_poly(ci, PackedVector2Array([Vector2(-14 + lf, -2 - ft[1]), Vector2(-5 + lf, -2 - ft[1]), Vector2(-5, -14), Vector2(-14, -14)]), rock.darkened(0.2), a)
	_poly(ci, PackedVector2Array([Vector2(5 + rf, -2 - ft[3]), Vector2(14 + rf, -2 - ft[3]), Vector2(14, -14), Vector2(5, -14)]), rock.darkened(0.2), a)
	_push_body(ci, Gait.body_xf(19, walk))
	var lift: float = maxf(0.0, -w) * 24.0 - maxf(0.0, w) * 8.0 + (20.0 if variant == 2 else 0.0) - absf(Gait.swing(19, walk)) * 25.0   # 走路雙臂下沉
	# V1.3 A1b：轉身時遠側手臂往前、近側往後（左右手的位置交錯，才看得出是轉身）
	_part(ci, -6.0, 0.3)
	_line(ci, Vector2(-20, -34), Vector2(-23, -22 - lift), rock.darkened(0.15), 7.0, a)
	_c(ci, Vector2(-23, -19 - lift), 8.0, rock.darkened(0.1), a)
	_part(ci, 6.0, 0.3)
	_line(ci, Vector2(20, -34), Vector2(23, -22 - lift), rock.darkened(0.15), 7.0, a)
	_c(ci, Vector2(23, -19 - lift), 8.0, rock.darkened(0.1), a)
	_part_end(ci)
	_poly(ci, PackedVector2Array([Vector2(-21, -10), Vector2(-24, -36), Vector2(-11, -47), Vector2(11, -47), Vector2(24, -36), Vector2(21, -10)]), rock, a)
	# 岩石裂紋
	ci.draw_polyline(PackedVector2Array([Vector2(-19, -28), Vector2(-14, -24), Vector2(-17, -18)]), Color(0.2, 0.18, 0.15, 0.7 * a), 1.6, true)
	ci.draw_polyline(PackedVector2Array([Vector2(17, -14), Vector2(13, -18), Vector2(17, -22)]), Color(0.2, 0.18, 0.15, 0.7 * a), 1.6, true)
	# 隊伍色肩甲（面積要大）與胸前帶子
	_poly(ci, PackedVector2Array([Vector2(-27, -28), Vector2(-26, -46), Vector2(-8, -52), Vector2(-4, -40), Vector2(-13, -28)]), tc, a)
