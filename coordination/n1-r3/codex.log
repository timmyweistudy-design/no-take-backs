    51		var alive := true
    52		var dmg_dealt := 0
    53		var dmg_taken := 0
    54		var kills := 0
    55	
    56	var units: Array[Unit] = []    # 依 id 排序
    57	var tick := 0
    58	var budget := 100
    59	var finished := false
    60	var winner := -2               # -2 進行中；-1 平手；0／1 勝方
    61	var reason := ""
    62	var fingerprint := ""          # 結束時的 SHA-256（十六進位）
    63	var events: Array = []         # 這一 tick 的事件（給畫面演出用，不影響計算）
    64	var frenzy := false
    65	var rally := [false, false]    # 這一 tick 哪一隊在「背水」（畫面提示用；計算用的是第④步當下的值）
    66	var power_log: PackedInt64Array = PackedInt64Array()   # 每 tick 的（藍戰力−紅戰力），懸念指標用
    67	var _hash := HashingContext.new()
    68	var fast := false              # 平衡工具用：不算每 tick 指紋（結果完全一樣，只是沒有指紋）
    69	
    70	func _init(army0, army1) -> void:
    71		budget = army0.budget
    72		_hash.start(HashingContext.HASH_SHA256)
    73		var raw: Array = []
    74		for a in [army0, army1]:
    75			for u in a.units:
    76				raw.append([a.team * 1000 + u["row"] * COLS + u["col"], a.team, u])
    77		raw.sort_custom(func(p, q): return p[0] < q[0])
    78		for r in raw:
