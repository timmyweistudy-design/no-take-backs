    41	    man_path = os.path.join(folder, "manifest.json")
    42	    if not os.path.exists(man_path):
    43	        print("✗ 沒有 manifest.json，無法確認資料完整"); sys.exit(2)
    44	    man = json.load(open(man_path))
    45	    if not isinstance(man.get("modes"), list) or not man["modes"] or not isinstance(man.get("shards"), int) or man["shards"] <= 0:
    46	        print("✗ manifest.json 不合法"); sys.exit(2)
    47	    shards = man["shards"]
    48	    errs = [r for v in rows.values() for r in v if "error" in r]
    49	    if errs:
    50	        print(f"✗ 有 {len(errs)} 筆執行錯誤（例：{errs[0]}）"); sys.exit(2)
    51	    expect = {"matrix": 20, "league": 200 * 12 * 2, "search": shards, "counter": 6, "countersearch": shards}
    52	    keyset = {
    53	        "matrix": {(a, b) for a in range(5) for b in range(5) if a != b},
    54	        "league": {(a, k, s) for a in range(200) for k in range(12) for s in range(2)},
    55	        "search": {(s,) for s in range(shards)},
    56	        "counter": {(t,) for t in range(6)},
    57	        "countersearch": {(s,) for s in range(shards)},
    58	    }
    59	    keyf = {"matrix": ("a", "b"), "league": ("a", "k", "side"), "search": ("shard",), "counter": ("template",),
    60	            "countersearch": ("shard",)}
    61	    for m in man["modes"]:
    62	        key = m.replace(":", "_")
    63	        got = rows.get(key, [])
    64	        base = m.split(":")[0]
    65	        exp = 400 if base == "turns" else expect.get(base)
    66	        want = {(g,) for g in range(400)} if base == "turns" else keyset.get(base)
    67	        kf = ("game",) if base == "turns" else keyf.get(base, ())
    68	        keys = [tuple(r.get(k) for k in kf) for r in got]
    69	        if exp is not None and len(got) != exp:
    70	            print(f"✗ {m} 筆數 {len(got)}，預期 {exp}"); sys.exit(2)
    71	        if len(set(keys)) != len(keys):
    72	            print(f"✗ {m} 有重複的場次"); sys.exit(2)
    73	        if want is not None and set(keys) != want:
    74	            print(f"✗ {m} 場次鍵集合不對（少 {len(want - set(keys))}、多 {len(set(keys) - want)}）"); sys.exit(2)
    75	        rows[key] = [r for _, r in sorted(zip(keys, got), key=lambda kv: kv[0])]
    76	    digests = {r.get("digest") for v in rows.values() for r in v}
    77	    if len(digests) != 1:
    78	        print("✗ 數值摘要不一致：", digests); sys.exit(2)
    79	    md = [f"# 平衡報表 2.0\n", f"- 數值摘要 `{digests.pop()}`、共 {total} 筆、耗時 {secs} 秒\n"]
