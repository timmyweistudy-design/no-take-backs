const SwapDuel = preload("res://scripts/game/swap_duel.gd")
var swap_on := false
var sw_pts := [0, 0]    # 玩家 A、B 的分數（剩餘戰力百分比合計）
var sw_dead := [0, 0]   # 玩家 A、B 兩局合計倒下數

func _swap_start() -> void:
	var r = RuleSet.standard()
	var dm: int = RS.mask(_demo())
	r.pool = [int(r.pool_of(0)) & dm, int(r.pool_of(1)) & dm]   # 標準卡池再扣掉試玩版沒有的兵（Codex cat10 #5）
	r.rounds = 3   # 用三戰兩勝的局數上限，實際由換邊雙局在第 2 局結束
	rules = r
	challenge_army = null
	overlay = ""
	_start_mode(Mode.DUEL)
	swap_on = true
	sw_pts = [0, 0]
	sw_dead = [0, 0]
	_toast(L.t("sw_intro"))

## 每局正式打完（_finish_battle）：記分；第 2 局後系列結束
func _swap_settle() -> void:
	if not swap_on or mode != Mode.DUEL or play_kind != "official" or sim == null:
		return
	var r: Array = SwapDuel.settle(sw_pts, sw_dead, round_no, sim)
	sw_pts = r[0]
	sw_dead = r[1]
	series_over = round_no >= SwapDuel.ROUNDS

## 擺陣頂部：誰是哪一色（第 2 局換過來）
func _swap_who() -> String:
	return L.t("sw_who", [L.t("blue") if SwapDuel.owner(round_no, 0) == 0 else L.t("red"), L.t("red") if SwapDuel.owner(round_no, 0) == 0 else L.t("blue")])

## 結果頁第一條事實
func _swap_fact() -> String:
	if not series_over:
		return L.t("sw_round", [int(sw_pts[0]), int(sw_pts[1])])
	var v := SwapDuel.verdict(sw_pts, sw_dead)
	return L.t("sw_final", [int(sw_pts[0]), int(sw_pts[1]), L.t("sw_a") if v == 0 else (L.t("sw_b") if v == 1 else L.t("sw_tie"))])

## 揭封：第 k 封放回兩邊（鎖定，不能改），之後照一般「開戰」。
func _sealed_reveal(k: int) -> void:
	armies[0].units = sealed[0][k].duplicate(true)
	armies[1].units = sealed[1][k].duplicate(true)
	blind_phase = 2
## 這週的題目：卡池（舊 10 種裡抽 6 種，一定有戰鬥兵）、預算、對手幽靈。同一週大家一樣。
static func weekly_spec(wk: int) -> Dictionary:
	var r := RandomNumberGenerator.new()
	r.seed = 1400000 + wk
	var mask := 0
	for _try in 50:
		var types := range(D.COUNT)
		mask = 0
		for k in 6:
			var j := r.randi_range(0, types.size() - 1)
			mask |= 1 << int(types[j])
			types.remove_at(j)
		if RuleSet.has_combat(mask):
			break
	var gs := ghosts()
	return {"wk": wk, "pool": mask, "budget": [80, 90, 100, 110, 120][posmod(wk, 5)], "ghost": posmod(wk * 7, maxi(1, gs.size()))}

func _ghost_start(i: int) -> void:
	var gs := ghosts()
	if i < 0 or i >= gs.size():
		return
	var r = RuleSet.standard()
	r.rounds = 1
const SB = preload("res://scripts/game/songbook.gd")

func _sb_add_current() -> void:
	if last_armies.size() != 2:
		return
	var code := BattleCode.encode(last_armies[0], last_armies[1], battle_rules, last_cmds)
	var w: int = sim.winner if sim != null else -1
	var res := L.t("sb_win") if w == 0 else (L.t("sb_lose") if w == 1 else L.t("sb_draw"))
	var title := "%s　%s" % [Time.get_date_string_from_system(), res]
	var marks: Array = _key_marks() if not report.is_empty() else []
	var note := L.t("sb_note_none") if marks.is_empty() else L.t("sb_note", [str(marks[marks.size() - 1]["label"])])
	Save.data["songbook"] = SB.add(Save.data.get("songbook", []), code, title, note, int(Time.get_unix_time_from_system()))
	if Save.save_data():
		_toast(L.t("sb_added"))
	else:
		_toast(L.t("save_failed"), true)
	overlay = "songbook"
	_focus = 0

func _draw_songbook() -> void:
	_boss_note("songbook", "songbook")   # 1.2.0 §12.2：這個系統第一次出現時一張便條
	_dim(0.6)
	var book: Array = Save.data.get("songbook", [])
	var rowh := 12.0 + tz("B") * 1.3 + tz("S") * 1.3 + 12.0
	var P := modal_rect(760, 12.0 + h1_help_h(L.t("sb_help", [SB.MAX]), tz("S"), 680) + GAP_L + maxf(1.0, book.size()) * (rowh + 8.0) + GAP_L + 44.0 + GAP_L)
	_panel(P)
	var y := _h1_help(Vector2(640, P.position.y + 12), L.t("sb_title"), L.t("sb_help", [SB.MAX]), tz("S"), 680) + GAP_L
	if book.is_empty():
		_text(Vector2(640, y + 10), L.t("sb_empty"), tz("S"), Color(1, 1, 1, 0.88), true, false, 680)   # Antigravity cat08 #4：空狀態要讀得到
	for i in book.size():
		var e: Dictionary = book[i]
		var r := Rect2(P.position.x + 30, y, P.size.x - 60, rowh)
		# Antigravity cat08 #3：每筆是一張夾在冊子裡的紙頁（墨字），不是深色資料列
		var paper_ok: bool = not bool(Save.s("plain_ui")) and _tex_box(r, "paper")
		if not paper_ok:
			draw_rect(r, Color(0, 0, 0, 0.18))
		_ink_mode = paper_ok
		_text(r.position + Vector2(14, 10), str(e["n"]), tz("B"), INK if paper_ok else Color.WHITE, false, true, r.size.x - 270)
		_text(r.position + Vector2(14, 10 + tz("B") * 1.3), str(e["note"]), tz("S"), INK if paper_ok else TXT_DIM, false, false, r.size.x - 270)
		_ink_mode = false
		var c := str(e["c"])
		var idx := i
		_btn(Rect2(r.end.x - 244, r.position.y + (rowh - 44.0) / 2.0, 120, 44), L.t("sb_watch"), func(): overlay = ""; _watch_code_str(c))
		_btn(Rect2(r.end.x - 116, r.position.y + (rowh - 44.0) / 2.0, 104, 44), L.t("sb_del"), func(): Save.data["songbook"] = SB.remove(Save.data.get("songbook", []), idx); Save.save_data())
		y += rowh + 8.0
	_btn(Rect2(560, P.end.y - GAP_L - 44.0, 160, 44), L.t("back"), func(): overlay = "")

## 1.3.0 §2 精華：最多三段、去重、終局排最後；不足兩個獨立事件只出一段（director_rules.pick_reel）。
func _highlights() -> Array:
	var marks: Array = _key_marks() if not report.is_empty() else []
	var ft := maxi(0, int(sim.tick) - 30) if (sim != null and sim.winner >= 0) else -1


# ── 1.4.0 §11.1 無盡塔（1.3.0 延伸，stash 補完）──
const Tower = preload("res://scripts/game/tower.gd")
var tower_on := false
var tower_floor := 1
var tower_result := -1   # 這一層的正式結算（-1＝還沒、0＝過、1＝沒過）；結果頁的按鈕只看它（覆盤改陣贏了不能跳層，Codex cat11 #2）

## 結果頁的無盡塔按鈕：照正式結算，不照畫面上這一場（覆盤、重播）→ [文字鍵, 下一次的層]
static func tower_button(result: int, floor_no: int) -> Array:
	if result == 0:
		return ["tw_next", floor_no + 1]
	if result == 1:
		return ["tw_again", 1]
	return []

## 遠征牌上的入口：有進行中的塔就從那一層繼續（回標題也保留，方案 §11.11）
func _tower_open() -> void:
	var run := int(Save.data.get("tower_run", 0))
	if run > 1:
		_toast(L.t("tw_resume", [run]))
	_tower_start(maxi(1, run))

func _tower_start(floor_no: int) -> void:
	if _demo():
		_toast(L.t("demo_locked"), true)
		return
	var sp: Dictionary = Tower.spec(floor_no)
	var r = Tower.make_rules(sp, RS.mask(false))
	if not r.validate().is_empty():
		_toast(L.t("ch_bad"), true)   # 規則不合法＝提示並回第 1 層（方案 §11.11）
		if floor_no > 1:
			Save.data["tower_run"] = 0
			_tower_start(1)
		return
	set("daily_spec", {})        # 從每日挑戰／每日練習直接進塔：不帶每日狀態（不記每日紀錄、不跳過塔結算，Codex cat11 #1）
	set("daily_practice", false)
	rules = r
	challenge_army = Tower.enemy(sp, r)   # 這一層固定的敵陣（走挑戰碼那條路）
	overlay = ""
	_start_mode(Mode.VS_AI)
	tower_on = true
	tower_floor = int(sp["floor"])
	tower_result = -1
	Save.data["tower_run"] = tower_floor
	Save.save_data()   # 續局寫進存檔（中途關遊戲也從這一層繼續，Codex cat11 #3）
	_toast(L.t("tw_head", [tower_floor, L.t("daily_mut_%d" % int(sp["mut"]))]))

func _tower_finish(w: int) -> void:
	if not tower_on or mode != Mode.VS_AI or play_kind != "official":
		return
	var best := int(Save.data.get("tower_best", 0))
	Save.data["tower_run"] = Tower.next_run(int(Save.data.get("tower_run", 0)), tower_floor, w == 0)
	tower_result = 0 if w == 0 else 1
	if w == 0:
		var r: Array = Tower.record(best, tower_floor)
		Save.data["tower_best"] = r[0]
		_toast(L.t("tw_floor_clear", [tower_floor]))
	else:
		_toast(L.t("tw_over", [tower_floor, best]))

