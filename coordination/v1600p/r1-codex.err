#!/usr/bin/env bash
# 1.2.0 §14.8：效能 ABBA 交錯比較（不能用不同時段的單次絕對值下結論）。
# 用法：GODOT=<win exe> tools/perf_ab.sh <A 的 game 資料夾> <B 的 game 資料夾> <輪數> <輸出資料夾>
# 每輪跑 A B B A；兩邊都要先 --import 過（快照資料夾自己先匯入）。輸出每次的 json 與 summary.json／結論。
set -u
A=$(realpath "$1"); B=$(realpath "$2"); N=${3:-2}; OUT=$(realpath -m "$4")
mkdir -p "$OUT"; rm -f "$OUT"/run_*.json "$OUT"/run_*.log "$OUT"/summary.json   # 1.2.0（Codex cat01 #7）：不能混到上一次的殘留輸出
winpath() { if command -v wslpath >/dev/null 2>&1 && [[ "$GODOT" == *.exe ]]; then wslpath -w "$1"; else printf '%s' "$1"; fi; }
i=0
for r in $(seq 1 "$N"); do
  for side in A B B A; do
    i=$((i+1)); d=$A; [ "$side" = B ] && d=$B
    f="$OUT/run_$(printf %02d $i)_$side.json"
    timeout 900 "$GODOT" --path "$(winpath "$d")" --resolution 1280x800 -- --perf="$(winpath "$f")" --perf-commit="$side" </dev/null > "${f%.json}.log" 2>&1
    [ -s "$f" ] || { echo "PERFAB FAIL：第 $i 次（$side）沒有輸出，見 ${f%.json}.log"; exit 1; }
  done
done
python3 "$(dirname "$0")/perf_ab_sum.py" "$OUT"
	selected = D.ASSASSIN
	mouse = ORIGIN + Vector2(10.5, 4.5) * CS
	toast_t = 0.0
	await _snap("28_free_full_ai.png")
	# 雙人輪流全場
	rules = _free_rules(1)
	_start_mode(Mode.DUEL)
	tp.place_batch([[D.SHIELD, 6000, 4000], [D.SHIELD, 6000, 5000]])
	tp.end_turn()
	tp.place_batch([[D.CAVALRY, 9500, 4500], [D.ARCHER, 12500, 4500]])
	tp.end_turn()
	selected = D.PIKE
	mouse = ORIGIN + Vector2(5.0, 6.0) * CS
	toast_t = 0.0
	await _snap("29_free_duel_full.png")
	# 大廳：部署分頁
	rules = null
	_go_title()
	_open_lobby("ai")
	lobby_open = true
	lobby_tab = 1
	lobby_r.deploy = "free"
	lobby_r.spacing = Presets.FREE_SPACING
	lobby_r.depth = Presets.FREE_DEPTH
	lobby_r.fullfield = 2
	_lobby_touch()
	lobby_item = "fullfield"
	mouse = Vector2(-100, -100)
	toast_t = 0.0
	await _snap("30_lobby_deploy.png")
	overlay = ""


## 1.1.0 A19：圖集有界快取的量測。依序模擬「每場帶不同新兵」：每輪要求 3 種奇幻兵（含召喚物）＋轉身出手格，
## 記每輪後的貼圖記憶體與烘焙期間最長一幀；全部 12 種奇幻兵輪過兩次（第二次會丟舊頁），看峰值有沒有被頁數上限壓住。
func _perf_atlas_sweep() -> Dictionary:
	if sprites == null:
		return {}
	var fan: Array = range(D.COUNT, 22)
	var rounds: Array = []
	var peak := 0.0
	var worst_frame := 0.0
	for rep in 2:
		for i in range(0, fan.size(), 3):
			var want: Array = fan.slice(i, i + 3)
			var t0 := Time.get_ticks_msec()
			sprites.ensure(want)
			sprites.ensure_turn_atk(want)
			var last := Time.get_ticks_usec()
			var longest := 0.0
			var guard := 0
			while (sprites._busy or sprites._ta_busy) and guard < 600:
				guard += 1
				await RenderingServer.frame_post_draw
				var now := Time.get_ticks_usec()
				longest = maxf(longest, (now - last) / 1000.0)
				last = now
			var mem := Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED) / 1048576.0
			peak = maxf(peak, mem)
			worst_frame = maxf(worst_frame, longest)
			rounds.append({"types": want, "ms": Time.get_ticks_msec() - t0, "tex_mib": snappedf(mem, 0.1), "longest_frame_ms": snappedf(longest, 0.1),
				"pages": sprites.pages.filter(func(p): return p != null).size(), "ta": sprites.ta_tex.size()})
	return {"peak_tex_mib": snappedf(peak, 0.1), "worst_bake_frame_ms": snappedf(worst_frame, 0.1), "max_pages": sprites.MAX_PAGES, "ta_max": sprites.TA_MAX, "rounds": rounds}

## 繪圖效能量測（第二輪 R2、第三輪 T3）：
        # 1.2.0（Codex cat01 #2）：任何 res:// 字串常數（shader、字型、貼圖、音效、const 路徑）都算依賴
        for m in RES.findall(txt):
            deps(m, seen)
    return seen


DYN = re.compile(r"\bload\(\s*[A-Za-z_]")   # 1.2.0 §14.1：用變數動態 load（音效、字型、貼圖、shader 路徑）＝依賴表推不出來
ASSET_DIRS = ["art", "audio", "fonts", "shaders"]


def key_of(ver: str, entries: list, extra_dirs: list) -> str:
    files = set()
    for e in entries:
        deps(e, files)
    # 1.2.0 §14.1：相依的腳本裡有動態 load → 這一步的鍵把素材資料夾整個算進去（未知依賴＝保守地當成都依賴）
    if any(f.endswith(".gd") and DYN.search((GAME / f).read_text(encoding="utf-8", errors="ignore")) for f in files):
        extra_dirs = list(extra_dirs) + [d for d in ASSET_DIRS if d not in extra_dirs]
    for d in extra_dirs:
        p = GAME / d
        if p.is_dir():
            files |= {str(x.relative_to(GAME)).replace("\\", "/") for x in p.rglob("*") if x.is_file() and x.suffix != ".import"}
        elif p.is_file():
            files.add(d)
    h = hashlib.sha256(ver.encode())
    for f in sorted(files):
        h.update(f.encode())
        h.update(sha(GAME / f).encode())
    return h.hexdigest()[:20]


def suite_map() -> dict:
    """run_tests.gd 的 FILES（JSON 相容）＋別名 new＝units。"""
    src = (GAME / "tests/run_tests.gd").read_text(encoding="utf-8")
    m = re.search(r"^const FILES := (\{.*\})$", src, re.M)
    files = json.loads(m.group(1)) if m else {}
    if "units" in files:
        files["new"] = files["units"]
extends "res://scripts/ui/codex_view.gd"
## 回味（第三輪 S5）：重播控制、對戰代碼、覆盤。
## ・重播控制（F2）：重播與覆盤的戰鬥底部有控制列：暫停、0.5／1／2 倍速、點時間軸跳到任一秒（從頭快轉，
##   展示與音效狀態全部清空重建）、點一隻兵讓鏡頭跟它（再點空地取消）。
## ・對戰代碼（F3）：結果頁複製；標題「觀看對戰代碼」從剪貼簿讀，版本不同會提示。
## ・覆盤（F1）：只限「對 AI」。結果頁按「覆盤」，改一隻兵（換兵種、移一格或拿掉），按「重算」並排兩條時間軸；
##   可以「播放如果」看那一場。覆盤只看不算：比分、進度、成就、日誌都不寫（副作用矩陣 review）。

const BattleCode = preload("res://scripts/game/battle_code.gd")
const RC_BAR := Rect2(330, 708, 900, 28)   # 時間軸拖曳條

# 覆盤狀態
var rv_army = null          # 正在改的藍方陣型
var rv_orig = null          # 原本的藍方陣型
var rv_enemy = null         # 對手陣型（不變）
var rv_sel := Vector2i(-1, -1)
var rv_result := {}         # {winner, rem, log}
var rv_base := {}           # 原本那一場（打開覆盤時用同一組陣型重算，不依賴目前的 sim）
var rv_div := -1            # V1.4 #1 時光機：原本與如果第一次不一樣的 tick（-1＝還沒算或完全一樣）
var rv_last: Array = []     # 覆盤播放用的雙方陣型（重播覆盤時用）


# ── 重播控制 ──
func _replay_controls_active() -> bool:
	return state == St.BATTLE and play_kind != "official" and view != null

func _draw_replay_controls() -> void:
	if not _replay_controls_active():
		return
	draw_rect(Rect2(0, 696, 1280, 52), Color(TH_WOOD_D, 0.94))
	_btn(Rect2(20, 704, 70, 36), "▶" if paused else "Ⅱ", func(): paused = not paused)
	# V1.5.1：速度 −／目前／＋，走 0.25～8 倍的共用表（點中間回 1 倍）
	_btn(Rect2(98, 704, 68, 36), "−", func(): speed = speed_step(speed, -1), speed > float(SPEEDS[0]))
	_btn(Rect2(172, 704, 68, 36), "%s×" % _fmt_num(speed), func(): speed = 1.0, true, false, Color(0.45, 0.3, 0.12))
	_btn(Rect2(246, 704, 68, 36), "+", func(): speed = speed_step(speed, 1), speed < float(SPEEDS[SPEEDS.size() - 1]))
	# 時間軸：拉鋸色帶（模擬已跑到的部分）＋目前位置
	var total := float(maxi(1, replay_total if replay_total > 0 else view.max_ticks))   # 以這一場實際長度為滿
	draw_rect(RC_BAR, Color(0, 0, 0, 0.5))
	var tot := 1000.0
	var n: int = sim.power_log.size()
	for i in int(RC_BAR.size.x / 3.0):
		var t := int(i * 3.0 / RC_BAR.size.x * total)
		if t >= n:
			break
		var d: float = clampf(float(sim.diff_permille(t)) / tot * 2.0, -1.0, 1.0)
		var h := absf(d) * RC_BAR.size.y / 2.0
		draw_rect(Rect2(RC_BAR.position.x + i * 3.0, RC_BAR.get_center().y - (h if d > 0 else 0.0), 3.0, h), Color(Art.team_color(0 if d > 0 else 1, cbm()), 0.8))
	var cx := RC_BAR.position.x + RC_BAR.size.x * clampf(float(view.tick) / total, 0.0, 1.0)
	draw_line(Vector2(cx, RC_BAR.position.y - 3), Vector2(cx, RC_BAR.end.y + 3), ACCENT, 3.0)
	var hz := fit(L.t("rc_hint"), tz("C"), 560)   # V1.2.1 B2：走字級表
