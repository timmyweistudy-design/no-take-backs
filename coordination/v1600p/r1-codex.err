extends RefCounted
## 展示緩衝（第二輪方案 R5、§3）：戰鬥畫面固定比模擬晚 DELAY 個 tick。
## 模擬先跑，每個 tick 存一份「畫面需要的狀態」快照＋事件；畫面依展示時鐘一格一格播。
## 這樣命中事件在畫面上發生前 DELAY 個 tick 就知道了，可以先演前搖；
## 血量、死亡、音效、HUD、跳字全部讀同一個延後的快照，所以一起延後，不會只有動作延後。
## 純演出：模擬本身的計算、結果、指紋完全不受影響。

const DELAY := 2            # 前搖長度（tick）；也是有手動軍令時的緩衝長度
const DELAY_LONG := 8       # V1.5：沒有手動軍令的對局緩衝 8 tick，讓遠程「出手→飛行→命中」都在命中前演完
var delay := DELAY

class VUnit:
	var hidden := false
	var link := -1
	var windup := 0
	var guard := 0
	var summon := false
	var id: int
	var team: int
	var type: int
	var x: int
	var y: int
	var hp: int
	var max_hp: int
	var alive: bool
	var stealth: int
	var stun: int
	var shield := 0
	var haste_t := 0
	var fx: int
	var fy: int
	var mx: int
	var my: int
	var charge: int
	var target: int
	var breach: int            # 第四輪：被破陣剩幾 tick
	var aura: int              # 第四輪：在鼓手光環內
	var bmode: int             # 第四輪：投彈兵模式
	var st := 0                # V1.4 #9 貼紙
	var ward := false
	var boss := false          # V1.4 #12 巨獸與部位
	var arm_hp := 0
	var plate_hp := 0
	var cd := 0                # 1.3.0：暫停資料卡、放大鏡小窗要的冷卻與戰績（原本沒帶，資料卡讀 cd 會出錯；只給畫面，不進雜湊）
	var dmg_dealt := 0
	var kills := 0

var units: Array = []          # 跟 sim.units 同順序
var tick := 0
var rally := [false, false]
var frenzy := false
var events: Array = []         # 這一格（畫面上剛發生）的事件
var finished := false          # 畫面已經播到模擬的最後一 tick
var budget := 100
var budgets := [100, 100]      # 第五輪：兩邊預算（讓子時不同；舊判定時兩格都＝藍方預算）
var max_ticks := 1800          # 第五輪：這一局的長度（一局時間可調）

func budget_of(t: int) -> int:
	return int(budgets[t])
var zones: Array = []
var _power := [0, 0]
var _alive := [0, 0]
var _by_id := {}
var queue: Array = []          # 還沒播的快照（模擬已經跑到、畫面還沒到）
var cmd_snap: Array = []       # V1.5.1：[cmd_left, cmd_ready]（畫面這一格當下）

## 把模擬當下的狀態存成一份快照。
static func capture(sim) -> Dictionary:
	var us: Array = []
	var ux: Array = []
	for u in sim.units:
		ux.append([u.cd, u.dmg_dealt, u.kills])
		us.append([u.id, u.team, u.type, u.x, u.y, u.hp, u.max_hp, u.alive, u.stealth, u.stun, u.fx, u.fy, u.mx, u.my, u.charge, u.target, u.breach, u.aura, u.bmode, 1 if u.hidden else 0, u.link, u.windup, u.guard, u.summon, u.st, 1 if u.ward else 0, 1 if u.boss else 0, u.arm_hp, u.plate_hp, u.shield, u.haste_t])
	var cmd: Array = []
	if bool(sim.get("cmd_on")):
		cmd = [sim.cmd_left.duplicate(true), sim.cmd_ready.duplicate(true)]   # V1.5.1：軍令欄照畫面時間顯示（長緩衝時不提早跳）
	return {"cmd": cmd, "tick": sim.tick, "units": us, "ux": ux, "events": sim.events.duplicate(true), "rally": sim.rally.duplicate(),
		"frenzy": sim.frenzy, "finished": sim.finished, "power": [sim.power(0), sim.power(1)],
		"alive": [sim.alive_count(0), sim.alive_count(1)], "zones": sim.zones.duplicate()}

func _init(sim = null) -> void:
	if sim != null:
		budget = sim.budget
		# 手動軍令要即時：維持短緩衝。V1.5.1 B1b：照紀錄施放（殘局第 12 章、軍令局重播）沒有即時輸入，用長緩衝讓遠程完整飛行
		delay = DELAY if (bool(sim.get("cmd_on")) and not bool(sim.get("cmd_scripted"))) else DELAY_LONG
		budgets = sim.budgets.duplicate()
		max_ticks = sim.max_ticks
		apply(capture(sim))
		events = []

func apply(fr: Dictionary) -> void:
	cmd_snap = fr.get("cmd", [])
	var us: Array = fr["units"]
	if units.size() != us.size():
		units.clear()
		_by_id.clear()
		for i in us.size():
			var v := VUnit.new()
			units.append(v)
	for i in us.size():
		var a: Array = us[i]
		var v: VUnit = units[i]
		v.id = a[0]; v.team = a[1]; v.type = a[2]; v.x = a[3]; v.y = a[4]; v.hp = a[5]; v.max_hp = a[6]
		v.shield = a[a.size() - 2]; v.haste_t = a[a.size() - 1]
		v.alive = a[7]; v.stealth = a[8]; v.stun = a[9]; v.fx = a[10]; v.fy = a[11]; v.mx = a[12]; v.my = a[13]
		v.charge = a[14]; v.target = a[15]
		v.breach = a[16] if a.size() > 16 else 0
		v.aura = a[17] if a.size() > 17 else 0
		v.bmode = a[18] if a.size() > 18 else 0
		v.hidden = a[19] == 1 if a.size() > 19 else false
		v.link = a[20] if a.size() > 20 else -1
		v.windup = a[21] if a.size() > 21 else 0
		v.guard = a[22] if a.size() > 22 else 0
		v.summon = a[23] if a.size() > 23 else false
		if a.size() > 30:
			v.st = a[24]; v.ward = a[25] == 1; v.boss = a[26] == 1; v.arm_hp = a[27]; v.plate_hp = a[28]
		_by_id[v.id] = v
	var ux: Array = fr.get("ux", [])
	for i in mini(ux.size(), units.size()):
		var v: VUnit = units[i]
		v.cd = ux[i][0]; v.dmg_dealt = ux[i][1]; v.kills = ux[i][2]
	tick = fr["tick"]
	events = fr["events"]
	rally = fr["rally"]
	frenzy = fr["frenzy"]
	finished = fr["finished"]
	_power = fr["power"]
	_alive = fr["alive"]
	zones = fr.get("zones", [])

func power(t: int) -> int:
	return _power[t]

func alive_count(t: int) -> int:
	return _alive[t]

func unit_by_id(id: int):
	return _by_id.get(id)

## 模擬往前跑，直到緩衝裡有 DELAY 份還沒播的快照（或模擬結束）。回傳這次新加的快照，給前搖預告用。
func pump(sim) -> Array:
	var added: Array = []
	while queue.size() < delay and not sim.finished:
		sim.step()
		var fr := capture(sim)
		queue.append(fr)
		added.append(fr)
	return added

## 畫面前進一格；沒有可播的就回傳 false。
func advance() -> bool:
	if queue.is_empty():
		return false
	apply(queue.pop_front())
	return true
var _hash := HashingContext.new()
var _last_rank := 99          # 上一次 _choose_target 選中目標的優先級（1＝嘲諷）
var _was_stealth := {}         # 刺客上一 tick 是否潛行（現形事件用）
var _was_rally := [false, false]          # 上一 tick 哪一隊在背水（背水開／關事件用）
var v8 := false                # 這一場用到第八輪新兵
var has_st := false            # V1.4 #9：有沒有任何一隻貼了貼紙
var has_boss := false          # V1.4 #12：場上有巨獸
var fw := W                    # V9：場地大小（標準＝舊常數，舊場次完全相同）
var fh := H
var terrain = null             # V9：地形（null＝平原，舊路徑不碰）
var map_ev: Array = []           # V1.4 #10：這張圖的定時機關（空＝沒有，舊路徑不碰）
var fire_until: Array = []       # 正在燒的火牆：[矩形, 燒到第幾 tick]
var _nav_wp := {}              # V9：單位索引 → 導航途經點（每 4 tick 重算）
var zones: Array = []          # 碎石區：[x, y, 到期 tick]
var _pending_blast: Array = [] # 半路被打死、下一 tick 才炸的爆爆羊（索引）
var fast := false              # 平衡工具用：不算每 tick 指紋（結果完全一樣，只是沒有指紋）

## rules：第五輪 Ruleset（可省略）。省略或是舊路徑規則時，雜湊位元組、判定都和 1.3.0 完全相同。
# ── 第十二輪手動技能 ──
var cmd_on := false
var cmd_mask := [0, 0]
var cmd_cd := 0
var cmd_power := 100
var cmd_left := [[], []]         # 每隊每種還能用幾次
var cmd_ready := [[], []]        # 每隊每種第幾 tick 起能再用
var cmd_pending: Array = []      # 玩家按了、下一 tick 生效：[隊, 技能]
var cmd_log: Array = []          # 實際施放：[tick, 隊, 技能]；重播靠它
var cmd_script := {}             # 重播用：tick → [[隊, 技能]…]
var cmd_scripted := false
var cmd_auto := [false, false]   # 哪一隊由 AI 決定
var cmd_ai_every := 20
var _cmd_dmg := PackedInt64Array()

func _init(army0, army1, p_rules = null) -> void:
	budget = army0.budget
	budgets = [budget, budget]
	var legacy: bool = p_rules == null or p_rules.sim_is_legacy()
	if not legacy:
		rules = p_rules.copy()
		max_ticks = rules.ticks
		frenzy_at = rules.frenzy_tick()
		attr_step = rules.attrition_step()
		judge = rules.judge()
		if judge == 2:
			budgets = [army0.budget, army1.budget]
		for k in rules.skills_off:
			skill_off[k] = true
		fw = rules.field_w()
		fh = rules.field_h()
		terrain = rules.terrain()
		map_ev = MapDefs.events(rules.map_id) if not rules.map_is_default() else []
		if not map_ev.is_empty() and terrain != null:
extends "res://scripts/ui/codex_view.gd"
## 回味（第三輪 S5）：重播控制、對戰代碼、覆盤。
## ・重播控制（F2）：重播與覆盤的戰鬥底部有控制列：暫停、0.5／1／2 倍速、點時間軸跳到任一秒（從頭快轉，
##   展示與音效狀態全部清空重建）、點一隻兵讓鏡頭跟它（再點空地取消）。
## ・對戰代碼（F3）：結果頁複製；標題「觀看對戰代碼」從剪貼簿讀，版本不同會提示。
