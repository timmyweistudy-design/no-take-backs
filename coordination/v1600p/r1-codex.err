var _queue: Array = []
var _baking: Array = []

func is_ready(cb: bool) -> bool:
	return ring_tex != null and ready_cb == (1 if cb else 0) and ready_paint == Art.paint_sig()

func has_type(t: int) -> bool:
func build(cb: bool) -> void:
	if DisplayServer.get_name() == "headless":
		return
	_gen += 1
	pages.clear()
	loc.clear()
	_queue.clear()
	_baking = []
	_busy = false
	ring_tex = null
	turn_tex = null
	turn_loc.clear()
	wt_pages.clear()
	wt_loc.clear()
	fid_tex = null
	fid_loc.clear()
	ta_tex.clear()
	bw_tex.clear()
	bw_order.clear()
	ta_order.clear()
	_ta_queue.clear()
	_ta_busy = false
	ready_cb = 1 if cb else 0
	ready_paint = Art.paint_sig()
	var base: Array = []
	for t in D.COUNT:
		base.append(t)
	var g0 := _gen
	await _bake_ring(cb)
	if g0 != _gen:
		return   # 烘腳底圈時又重建了：交給新的那次
	await ensure(base)
	if g0 != _gen:
		return
	await _bake_turn(cb)
	if g0 == _gen and not ta_wanted.is_empty():
		ensure_turn_atk(ta_wanted.duplicate())

func _bake_turn(cb: bool) -> void:
func ensure_turn_atk(types: Array) -> void:
	for t in types:
		ta_wanted.erase(t)
		ta_wanted.append(t)
	while ta_wanted.size() > TA_MAX:
		ta_wanted.pop_front()
	if DisplayServer.get_name() == "headless" or ready_cb < 0:
		return
	for t in types:
		if ta_tex.has(t) and bw_tex.has(t):
			ta_order.erase(t)
			ta_order.append(t)
			bw_order.erase(t)
			bw_order.append(t)   # 背面頁和轉身出手頁一起刷新（Codex cat05 #3）
		elif not t in _ta_queue:
			_ta_queue.append(t)
	if _ta_busy or _ta_queue.is_empty():
		return
	_ta_busy = true
	var g0 := _gen
	while not _ta_queue.is_empty():
		var t: int = _ta_queue.pop_front()
		var pt := _ExtraPainter.new()
		pt.cb = ready_cb == 1
		pt.mode = 3
		pt.types = [t]
		var vp: SubViewport = await _paint_steps(Vector2i(COLS * CELL, 2 * CELL), pt, ATK_FRAMES * 2 * 2)
		var img: Image = await _post_vp(vp, ATK_FRAMES * 2)   # 第 11 大類：直接拿視窗貼圖跑後處理，省一次讀回＋上傳
		if g0 != _gen:
			return
		ta_tex[t] = ImageTexture.create_from_image(img)
		ta_order.erase(t)
		ta_order.append(t)
		while ta_order.size() > TA_MAX:
			ta_tex.erase(ta_order.pop_front())   # 超過上限：丟最久沒用的
		if not bw_tex.has(t):
			var pb := _ExtraPainter.new()
			pb.cb = ready_cb == 1
			pb.mode = 4
			pb.types = [t]
			var vpb: SubViewport = await _paint_steps(Vector2i(COLS * CELL, CELL), pb, 2 * WT_PH)
			var imb: Image = await _post_vp(vpb, WT_PH)
			if g0 != _gen:
				return
			bw_tex[t] = ImageTexture.create_from_image(imb)
			bw_order.erase(t)
			bw_order.append(t)
			while bw_order.size() > BW_MAX:
				bw_tex.erase(bw_order.pop_front())
	_ta_busy = false

## 1.3.0 §5.4 往北走（背對鏡頭）：有背面走路頁就畫，回傳 true；沒有（還沒烘好、簡化介面）回 false，呼叫端照舊畫側面。
func draw_back_walk(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, hurt: float, alpha: float, t: float, scale := 1.0, lean := 0.0, crouch := 1.0, cb := false) -> bool:
func _paint_steps(size: Vector2i, painter: Node, total: int) -> SubViewport:
	painter.cell_from = 0
	painter.cell_to = PAINT_CHUNK
	var vp := _viewport(size, painter)
	vp.render_target_clear_mode = SubViewport.CLEAR_MODE_ONCE
	await RenderingServer.frame_post_draw
	var c0 := PAINT_CHUNK
	while c0 < total:
		painter.cell_from = c0
		painter.cell_to = c0 + PAINT_CHUNK
		painter.queue_redraw()
		vp.render_target_update_mode = SubViewport.UPDATE_ONCE
		await RenderingServer.frame_post_draw
		c0 += PAINT_CHUNK
	await RenderingServer.frame_post_draw
	return vp

func _bake_page(types: Array) -> void:
	var gen0 := _gen
	var cb := ready_cb == 1
	var total := types.size() * 2 * FRAMES_PER
	var rows := int(ceil(float(total) / COLS))
	var painter := _Painter.new()
	painter.cb = cb
	painter.types = types
	# 1.2.0 §15.2：一整頁（6 種×2 隊×28 格＝336 個向量角色）在同一幀畫完就是開戰前的長幀（136～215 ms，ABBA 量過不是讀回造成）。
	# 改成分段：每幀只畫 PAINT_CHUNK 格，視窗第一次清空、之後不清（累積），畫完整頁才讀回。
	var vp: SubViewport = await _paint_steps(Vector2i(COLS * CELL, rows * CELL), painter, total)
	var img: Image = await _post_vp(vp)   # 第 11 大類：直接拿視窗貼圖跑後處理，省一次讀回＋上傳
	if (1 if cb else 0) != ready_cb or gen0 != _gen:
		return   # 烘的時候換了配色（或重建了）：這一批作廢
	# 新兵頁太多就丟最舊的（舊 10 種那兩頁不丟）
	if pages.size() >= MAX_PAGES:
		for i in pages.size():
			if pages[i] != null and int(pages[i]["types"][0]) >= D.COUNT:
				for t in pages[i]["types"]:
					if loc.has(t) and int(loc[t][0]) == i:
						loc.erase(t)
				pages[i] = null
				break
	var pn := pages.size()
	pages.append({"tex": ImageTexture.create_from_image(img), "types": types})
	for k in types.size():
		loc[types[k]] = [pn, k * 2 * FRAMES_PER]

## 1.2.0 第 11 大類（§15.2 A2 後續）：畫好的視窗直接當後處理的輸入（ViewportTexture），只在最後讀回一次。
## 原本是「讀回 → 建 ImageTexture 上傳 → 後處理 → 再讀回」，每頁多一次整頁讀回與上傳。讀完才釋放來源視窗。
func _post_vp(src: SubViewport, per := FRAMES_PER) -> Image:
	var sh_path := "res://shaders/unit_bake.gdshader"
	if not ResourceLoader.exists(sh_path) or bool(Save.s("plain_ui")):
		var raw := src.get_texture().get_image()
		src.queue_free()
		return raw
	var out := await _post_tex(src.get_texture(), src.size, per)
	src.queue_free()
	return out

## V1.2 D1：烘好的整頁再跑一次後處理 shader（外輪廓＋頂亮底暗）。
func _post_tex(tex: Texture2D, size: Vector2i, per: int) -> Image:
	var tr := TextureRect.new()
	tr.texture = tex
	tr.size = Vector2(size)
	var mat := ShaderMaterial.new()
	mat.shader = load("res://shaders/unit_bake.gdshader")
	mat.set_shader_parameter("cell", float(CELL))
	mat.set_shader_parameter("per", float(per))
	mat.set_shader_parameter("cols", float(COLS))
	mat.set_shader_parameter("sh_amt", float(Art.WASH[clampi(int(Art.paint[2]), 0, 2)]))   # V1.4 #15 漬洗
	mat.set_shader_parameter("hi_amt", float(Art.DRY[clampi(int(Art.paint[3]), 0, 2)]))    # 乾掃
	tr.material = mat
	var vp := _viewport(size, tr)
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	var out := vp.get_texture().get_image()
	vp.queue_free()
	return out

func _bake_ring(cb: bool) -> void:
	var painter := _RingPainter.new()
	painter.cb = cb
	var vp := _viewport(Vector2i(15 * CELL, CELL), painter)   # 1.3.0：第 15 格＝紅方八角木座（跳起來分層畫時用）   # V1.3 A3：4 種隊伍圈＋木座＋影子＋4 種合成（木座＋影子＋圈）；1.1.0 B14：合成再分王國／奇幻（底座部件烘進去）
	var g0 := _gen
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	if g0 == _gen:
		ring_tex = ImageTexture.create_from_image(vp.get_texture().get_image())
	vp.queue_free()

					D.CAVALRY:
						mood = Art.M_SPARKLE; lean = 0.26; walk = 1.0
					D.ASSASSIN:
						mood = Art.M_HOOD; crouch = 0.9; alpha = 0.45
					D.SHIELD:
						mood = Art.M_BRACE
			if c == 5:   # 狂熱氣場
				draw_arc(p + Vector2(0, -36), 26.0, 0, TAU, 24, Color(1.0, 0.33, 0.2, 0.6), 3.0, true)
			_ring(p, 0, t, 1.6)
			_unit(p, t, 0, 1.0, walk, at, 0.0, alpha, 1.0, 1.6, mood, lean, crouch, (2 if t >= D.CLASSIC else 0) if c == 6 else (1 if c == 8 else 0))
			if c == 2 or c == 8:   # 揮擊殘影（依兵種，實際只有 0.12 秒）
				_draw_smear(p, t, 0, 1.0, 0.45, 1.0, 1 if c == 8 else 0, 1.6)

# ── 第十輪 T5：只用手把走主要流程。失敗印 PADWALK FAIL，版面檢查會擋 ──
var _pw_bad: Array = []

func _pw_check(cond: bool, what: String) -> void:
	if not cond:
		_pw_bad.append(what)

func _pw_btn(b: int) -> void:
	if ov_trans_k() < 1.0:
		_ov_t = time - 1.0   # 1.4.0 §2.2：轉場中的第一下會被吃掉（設計如此）；走訪時等轉場結束再按（等於玩家等 0.25 秒）
	_trans_reset_input()
	for pressed in [true, false]:
		var ev := InputEventJoypadButton.new()
		ev.button_index = b
		ev.pressed = pressed
		ev.device = 0
		_input(ev)
		await _pw_frames(2)

func _pw_frames(n: int) -> void:
	for i in n:
		await get_tree().process_frame

## 方向鍵走到第 i 顆再按 A；同時確認焦點走得到。
func _pw_pick(i: int, what: String) -> void:
	await _pw_frames(2)
	_pw_check(i < _btns.size(), "%s：沒有第 %d 顆按鈕（共 %d）" % [what, i, _btns.size()])
	var guard := 0
	while _focus != i and guard < 60:
		guard += 1
		await _pw_btn(JOY_BUTTON_DPAD_DOWN)
	_pw_check(_focus == i, "%s：焦點走不到第 %d 顆" % [what, i])
	await _pw_btn(JOY_BUTTON_A)
	await _pw_frames(3)

## 這個畫面的每顆按鈕都走得到、都在畫面內。
func _pw_cycle(what: String) -> void:
	await _pw_frames(2)
	var n: int = _btns.size()
	_pw_check(n > 0, "%s：沒有按鈕" % what)
	for b in _btns:
		_pw_check(Rect2(0, 0, 1280, 800).encloses(b["r"]), "%s：按鈕超出畫面 %s" % [what, str(b["r"])])
	var seen := {}
	for k in n:
		seen[_focus] = true
		await _pw_btn(JOY_BUTTON_DPAD_DOWN)
	_pw_check(seen.size() == n, "%s：焦點只走到 %d／%d 顆" % [what, seen.size(), n])

func _pad_walk() -> void:
	_pw_bad = []
	layout_probe = false
	shot_dir = ""
	rules = null
	overlay = ""
	for nk in ["lobby", "place", "result"]:   # 1.2.0：老闆便條是第一次才跳的疊層，手把流程先當看過（便條本身另有截圖與測試）
		preload("res://scripts/game/guide.gd").see(Save.data, "note_" + nk)
	_go_title()
	await _pw_frames(3)
	await _pw_cycle("標題")
	for step in [[0, "hub_play"], [1, "hub_gauntlet"], [2, "hub_challenge"], [3, "playroom"], [4, "hub_collect"], [5, "settings"]]:   # V1.5：五塊木牌（0～4）＋系統列（5 設定、6 離開；1.5.0 代碼移到收藏，下面另走）
		_go_title()
		await _pw_pick(step[0], "標題→" + str(step[1]))
		_pw_check(overlay == step[1], "標題→%s：現在是 %s" % [step[1], overlay])
		await _pw_cycle(str(step[1]))
		await _pw_btn(JOY_BUTTON_B)
		_pw_check(overlay == "", "%s：B 關不掉" % step[1])
	_go_title()
	await _pw_pick(4, "標題→收藏")
	await _pw_pick(7, "收藏→代碼")   # 1.5.0：代碼在收藏第 8 張
	_pw_check(overlay == "codes", "收藏→代碼：現在是 %s" % overlay)
	await _pw_cycle("codes")
	_go_title()
	await _pw_pick(0, "標題→對戰")
	await _pw_pick(1, "對戰→對 AI 大廳")
	await _pw_cycle("大廳")
	# 1.5.0 §1.2 大廳三步：RB 下一步、LB 上一步、Y 進階折頁；換步後焦點在主鈕（Codex v150 cat03 #5）
	_go_title()
	_open_lobby("ai")   # 上面巡過每顆鈕之後畫面不在大廳了：重新打開
	lobby_step = 0
	lobby_open = false
	lobby_menu = false
	await _pw_frames(3)
	_ov_t = time - 1.0   # 等疊層開始畫、轉場直接到終態（第一下不要被轉場吃掉）
	for st in [1, 2]:
		await _pw_btn(JOY_BUTTON_RIGHT_SHOULDER)
		await _pw_frames(3)
		_pw_check(lobby_step == st, "大廳 RB：應該到第 %d 步，現在 %d（overlay=%s menu=%s open=%s state=%d cmds=%d）" % [st + 1, lobby_step + 1, overlay, str(lobby_menu), str(lobby_open), state, _cmds.size()])
		_pw_check(_focus >= 0 and _focus < _btns.size() and _btns[_focus]["r"].position.x >= 960.0, "大廳換步後焦點不在主鈕（第 %d 步）" % [st + 1])
		await _pw_cycle("大廳第 %d 步" % [st + 1])
	await _pw_btn(JOY_BUTTON_LEFT_SHOULDER)
	await _pw_frames(3)
	_pw_check(lobby_step == 1, "大廳 LB：應該回第 2 步")
	await _pw_btn(JOY_BUTTON_Y)
	await _pw_frames(3)
	_pw_check(lobby_open, "大廳 Y：應該打開進階折頁")
	await _pw_btn(JOY_BUTTON_Y)
	await _pw_frames(3)
	_pw_check(not lobby_open, "大廳 Y：應該收起進階折頁")
	_go_title()
	overlay = "reward"
	await _pw_cycle("獎勵")
	overlay = ""
	rules = RuleSet.standard()
	rules.ai_pool_same = false
	rules.pool = [1023, ~1023 & ((1 << 20) - 1)]
	ban_left = [1, 1]
	overlay = "ban"
	await _pw_cycle("禁牌 20 張")
	overlay = ""
	rules = null
	# 試煉從頭打到結果：擺一隻、開戰、跳過、看結果、回主選單
	_go_title()
	_open("trials")
	await _pw_pick(0, "試煉第 1 關")
	_pw_check(state == St.PLACE, "試煉沒有進擺放")
	await _pw_btn(JOY_BUTTON_LEFT_SHOULDER)
	var ev := InputEventJoypadButton.new()
	ev.button_index = JOY_BUTTON_A
	ev.pressed = true
	_input(ev)
	await _pw_frames(3)
	var ev2 := InputEventJoypadButton.new()
	ev2.button_index = JOY_BUTTON_A
	ev2.pressed = false
	_input(ev2)
	await _pw_frames(3)
	if armies[0].units.is_empty():
		_pw_bad.append("手把 A 擺不下兵")
		armies[0].place_xy(0, armies[0].world_x(3000), 3000)
	await _pw_btn(JOY_BUTTON_START)
	await _pw_frames(5)
	_pw_check(state == St.BATTLE, "Start 沒有開戰，現在 %d" % state)
	await _pw_btn(JOY_BUTTON_B)   # V1.5：B 打開暫停選單（第二項＝直接看結果）
	await _pw_frames(3)
	_pw_check(overlay == "pause_menu" and paused, "B 沒有打開暫停選單，現在 %s" % overlay)
	await _pw_btn(JOY_BUTTON_DPAD_DOWN)
	await _pw_frames(2)
	await _pw_btn(JOY_BUTTON_A)
#!/usr/bin/env bash
# 版面檢查（第三輪 T4）：用 Windows 版 Godot 跑截圖模式，兩種語言 × 三種字級，彙整 layout.jsonl。
# 用法：tools/layout_check.sh <Godot 執行檔> <輸出資料夾（WSL 路徑）>
set -uo pipefail
cd "$(dirname "$0")/.."
EXE="$1"; OUT="$2"
# 第七輪 I5：只准清自己產生的輸出夾（有記號檔），或空資料夾；其他一律拒絕，不再無條件 rm -rf
MARK=".ntb-layout-output"
if [ -d "$OUT" ] && [ -n "$(ls -A "$OUT" 2>/dev/null)" ]; then
  if [ ! -f "$OUT/$MARK" ]; then
    echo "LAYOUT FAIL：$OUT 已有內容但不是版面檢查的輸出夾，不會刪除。請換一個新資料夾。"; exit 2
  fi
  rm -rf "$OUT"
fi
mkdir -p "$OUT"; : > "$OUT/$MARK"
# Windows／WSL／Linux 都能跑：有 wslpath 才轉路徑
winpath() { if command -v wslpath >/dev/null 2>&1 && [[ "$EXE" == *.exe ]]; then wslpath -w "$1"; else printf '%s' "$1"; fi; }
# WSL 的 timeout 只殺得到包裝程序，Windows 上的視窗會留著繼續跑：逾時要連它一起關（只關這次輸出夾的）
kill_win() { if [[ "$EXE" == *.exe ]]; then powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name like 'Godot%'\" | Where-Object { \$_.CommandLine -like '*--shot=$(winpath "$1")*' } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force }" >/dev/null 2>&1; fi; }
# 第九輪 P0：LAYOUT_QUICK=1 只跑中文 100%＋英文 150%（最容易出事的兩組）＋一組狀態；里程碑跑 8 組
# V1.2.1：第三欄是狀態（plain＝簡化介面、cb＝色盲、pad＝手把焦點），固定在這組全部截圖
# 完整：兩語 × 三字級，加上四種狀態（簡化、色盲、手把、停用）各在兩語的 150%（最容易擠）各跑一次＝14 組
# V1.4 #17：加簡中、日文各 100％／150％（共 18 組）；快速版多跑日文 150％
COMBOS="zh_TW:100 zh_TW:125 zh_TW:150 en:100 en:125 en:150 zh_TW:150:plain en:150:plain zh_TW:150:cb en:150:cb zh_TW:150:pad en:150:pad zh_TW:150:dis en:150:dis zh_CN:100 zh_CN:125 zh_CN:150 ja:100 ja:125 ja:150 ja:150:plain,cb,pad zh_TW:100:plain,cb,pad en:125:plain,cb,pad en:100:dis"   # 1.1.0 B9：狀態組合補 100％／125％（共 24 組）
[ "${LAYOUT_QUICK:-0}" = "1" ] && COMBOS="zh_TW:100 en:150 en:150:plain,cb,pad zh_TW:150:dis ja:150"
[ -n "${LAYOUT_COMBOS:-}" ] && COMBOS="$LAYOUT_COMBOS"   # 只重跑指定組（修版面時用）
export LAYOUT_N=$(echo $COMBOS | wc -w)
# 1.2.0 §14.5：LAYOUT_JOBS=N 平行跑 N 組（各組本來就是獨立行程）；預設 1（量過一致才調高，見 coordination/v120-impl）
JOBS=${LAYOUT_JOBS:-2}   # 1.2.0：同一 commit 1 工 vs 2 工 350 張畫面 ID 與違規完全一致、399→223 秒
FAILS="$OUT/.fails"; : > "$FAILS"
run_combo() {
  local combo=$1 lang sc st d
  IFS=: read -r lang sc st <<< "$combo"
  d="$OUT/${lang}_${sc}${st:+_${st//,/-}}"; mkdir -p "$d"
  timeout 600 "$EXE" --path "$(winpath .)" --resolution 1280x800 -- --shot="$(winpath "$d")" --shot-lang=$lang --shot-text=$sc ${st:+--shot-state=$st} ${LAYOUT_SHOTS:+--shot-only=$LAYOUT_SHOTS} ${LAYOUT_FIXED:+--shot-fixed} --shot-prefix="shot_${lang}_${sc}${st:+_${st//,/-}}__" --layout-check > "$d/run.log" 2>&1 \
    || { echo "LAYOUT FAIL：$lang $sc% 截圖程式 exit 非 0" >> "$FAILS"; kill_win "$d"; return; }
  grep -E "SCRIPT ERROR|Parse Error" "$d/run.log" >/dev/null && { echo "LAYOUT FAIL：$lang $sc% 有腳本錯誤" >> "$FAILS"; return; }
  grep -q "^SHOTFAIL" "$d/run.log" && { echo "LAYOUT FAIL：$lang $sc% 截圖存檔失敗：$(grep SHOTFAIL "$d/run.log" | head -3 | tr '\n' ' ')" >> "$FAILS"; return; }
  grep -q "PADWALK OK" "$d/run.log" || echo "LAYOUT FAIL：$lang $sc% 手把流程：$(grep PADWALK "$d/run.log" | cut -c1-400)" >> "$FAILS"
}
for combo in $COMBOS; do
  while [ "$(jobs -rp | wc -l)" -ge "$JOBS" ]; do wait -n; done
  run_combo "$combo" &
done
wait
if [ -s "$FAILS" ]; then cat "$FAILS"; exit 1; fi
EXPECT=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | wc -l)
NAMES=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | sed 's/_snap("//; s/")//' | sort | tr '\n' ',')
# 1.2.0 §14.4：LAYOUT_SHOTS=a.png,b.png 只存、只檢查這些畫面（流程照跑）；開發中快速看用，每日與發版一律全量
if [ -n "${LAYOUT_SHOTS:-}" ]; then NAMES="$LAYOUT_SHOTS,"; EXPECT=$(echo "$LAYOUT_SHOTS" | tr ',' '\n' | grep . | sort -u | wc -l); fi
# 1.2.0 §14.4：畫面狀態清冊（tools/screens.json）要和 dev_main 的截圖清單完全一致（新畫面一定要登記入口與狀態）
python3 - "$(grep -o '_snap("[^"]*")' tools/dev_main.gd | sed 's/_snap("//; s/")//' | sort | tr '\n' ',')" <<'PY' || exit 1
import json, sys
names = {x for x in sys.argv[1].split(',') if x}
reg = json.load(open('tools/screens.json', encoding='utf-8'))
miss = sorted(names - set(reg)); extra = sorted(set(reg) - names)
if miss or extra:
    print('LAYOUT FAIL：畫面清冊 tools/screens.json 和截圖清單不一致（沒登記 %s、多登記 %s）' % (miss, extra)); sys.exit(1)
bad = [k for k, v in reg.items() if not v.get('entry') or not isinstance(v.get('states'), list)]
if bad:
    print('LAYOUT FAIL：清冊缺入口或狀態：%s' % bad[:10]); sys.exit(1)
PY
python3 - "$OUT" "$EXPECT" "$NAMES" <<'PY' && RC=0 || RC=$?
import json,sys,glob,os
out=sys.argv[1]; expect=int(sys.argv[2]); names=set(x for x in sys.argv[3].split(',') if x); total=0; rows=[]
for f in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    for line in open(f,encoding='utf-8'):
        d=json.loads(line); total+=len(d['violations']); rows.append(d)
warns=sum(len(d.get('warnings',[])) for d in rows)
# 第五輪：每組都要剛好是 dev_main.gd 列出的那些畫面（不能用重複畫面湊張數）
for f2 in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    got=[json.loads(l)['shot'] for l in open(f2,encoding='utf-8')]
    if sorted(got)!=sorted(names) or len(set(got))!=len(got):
        print('LAYOUT FAIL：%s 的畫面集合不對（少了 %s、多了 %s）' % (f2, sorted(names-set(got)), sorted(set(got)-names))); sys.exit(1)
    pngs={p for p in os.listdir(os.path.dirname(f2)) if p.endswith('.png')}
    if not names <= pngs:
        print('LAYOUT FAIL：%s 缺圖檔 %s（JSONL 有、PNG 沒存出來）' % (os.path.dirname(f2), sorted(names-pngs)[:10])); sys.exit(1)
by={}
for d in rows: by.setdefault((d['lang'],d['scale']),[]).append(d['median_size'])
print('LAYOUT 截圖 %d 張、違規 %d' % (len(rows), total))
for d in rows:
    for v in d['violations']: print('  %s %s %d%%：%s' % (d['shot'], d['lang'], d['scale'], v))
for lang in ['zh_TW','en','zh_CN','ja']:
    if (lang,100) in by and (lang,150) in by:
        a=sorted(by[(lang,100)]); b=sorted(by[(lang,150)])
        print('  %s 中位字級 100%%=%s 150%%=%s' % (lang, a[len(a)//2], b[len(b)//2]))
# V1.5.2：排版幾何警告逐條列出（不再只算數）；宣告的例外也列出理由。LAYOUT_STRICT_WARN=1（收尾驗收）時未豁免的排版警告也算失敗
gw=0
for d in rows:
    for v in d.get('geo_warn',[]):
        gw+=1; print('  警告 %s %s %d%%：%s %s' % (d['shot'], d['lang'], d['scale'], v['type'], v['s']))
exs=set()
for d in rows:
    for e in d.get('geo_exempt',[]): exs.add((d['shot'], e['rule'], e['why']))
print('LAYOUT 排版警告 %d、宣告例外 %d（明細：python3 tools/layout_table.py %s）' % (gw, len(exs), out))
def _run_all(a, godot, out, cache, ver, gate, marker, t0, fail):
    f_load = gate.submit(serial, godot, out, "load", ["--headless", "--path", ".", "--script", "res://tools/load_all.gd"], r"^LOADALL .*失敗 0：", marker)
    f_boot = gate.submit(serial, godot, out, "boot", ["--headless", "--path", ".", "--", "--boot-check"], r"^BOOTOK", marker)
    steps = plan(a)
    if a.only:
        want = a.only.split(",")
        steps = [s for s in steps if any(s["name"].startswith(w) for w in want)]
    res, todo = [], []
    for s in steps:
        s["key"] = key_of(ver + json.dumps(s.get("args", [])) + s["name"], s["entries"], s["dirs"])
        hit = cache / f"{s['name']}-{s['key']}.log"
        if not a.no_cache and hit.is_file():
            shutil.copy(hit, out / f"{s['name']}.log")
            res.append({"name": s["name"], "ok": True, "why": "", "sec": 0.0, "cached": True})
        else:
            todo.append(s)
    # V1.1 E1：最久的先開跑（用上一次的秒數；沒有紀錄的排前面），整體完工時間最短
    prev = {}
    for f in [out / "summary.json", GAME.parent / "build/tmp/check/summary.json"]:
        try:
            for r0 in json.loads(f.read_text(encoding="utf-8")).get("steps", []):
                if not r0.get("cached") and r0.get("sec", 0) > prev.get(r0["name"], 0):
                    prev[r0["name"]] = r0["sec"]
        except (OSError, ValueError):
            pass
    todo.sort(key=lambda s: -prev.get(s["name"], 10 ** 6))
    ex = cf.ThreadPoolExecutor(a.jobs)   # 載入／啟動檢查只佔前 20 秒，不另外扣名額
    try:
        res = _run_steps(ex, todo, godot, out, a, marker, res, cache)
    except BaseException:
        kill_marker(godot, marker)   # 中斷時先砍子程序，再不等工作直接關池（Codex v110-i2 #6）
        ex.shutdown(wait=False, cancel_futures=True)
        raise
    ex.shutdown(wait=True)
    return _finish(a, godot, out, steps, res, t0, fail, f_load, f_boot, gate)


def _run_steps(ex, todo, godot, out, a, marker, res, cache):

