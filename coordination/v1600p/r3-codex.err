#!/usr/bin/env bash
# 1.2.0 §14.8：效能 ABBA 交錯比較（不能用不同時段的單次絕對值下結論）。
# 用法：GODOT=<win exe> tools/perf_ab.sh <A 的 game 資料夾> <B 的 game 資料夾> <輪數> <輸出資料夾>
# 每輪跑 A B B A；兩邊都要先 --import 過（快照資料夾自己先匯入）。輸出每次的 json 與 summary.json／結論。
set -u
A=$(realpath "$1"); B=$(realpath "$2"); N=${3:-2}; OUT=$(realpath -m "$4")
mkdir -p "$OUT"; rm -f "$OUT"/run_*.json "$OUT"/run_*.log "$OUT"/summary.json   # 1.2.0（Codex cat01 #7）：不能混到上一次的殘留輸出
winpath() { if command -v wslpath >/dev/null 2>&1 && [[ "$GODOT" == *.exe ]]; then wslpath -w "$1"; else printf '%s' "$1"; fi; }
i=0
for r in $(seq 1 "$N"); do
  for side in A B B A; do
    i=$((i+1)); d=$A; [ "$side" = B ] && d=$B
    f="$OUT/run_$(printf %02d $i)_$side.json"
    timeout 900 "$GODOT" --path "$(winpath "$d")" --resolution 1280x800 -- --perf="$(winpath "$f")" --perf-commit="$side" </dev/null > "${f%.json}.log" 2>&1
    [ -s "$f" ] || { echo "PERFAB FAIL：第 $i 次（$side）沒有輸出，見 ${f%.json}.log"; exit 1; }
  done
done
python3 "$(dirname "$0")/perf_ab_sum.py" "$OUT"
func _perf_atlas_sweep() -> Dictionary:
	if sprites == null:
		return {}
	var fan: Array = range(D.COUNT, 22)
	var rounds: Array = []
	var peak := 0.0
	var worst_frame := 0.0
	for rep in 2:
		for i in range(0, fan.size(), 3):
			var want: Array = fan.slice(i, i + 3)
			var t0 := Time.get_ticks_msec()
			sprites.ensure(want)
			sprites.ensure_turn_atk(want)
			var last := Time.get_ticks_usec()
			var longest := 0.0
			var guard := 0
			while (sprites._busy or sprites._ta_busy) and guard < 600:
				guard += 1
				await RenderingServer.frame_post_draw
				var now := Time.get_ticks_usec()
				longest = maxf(longest, (now - last) / 1000.0)
				last = now
			var mem := Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED) / 1048576.0
			peak = maxf(peak, mem)
			worst_frame = maxf(worst_frame, longest)
			rounds.append({"types": want, "ms": Time.get_ticks_msec() - t0, "tex_mib": snappedf(mem, 0.1), "longest_frame_ms": snappedf(longest, 0.1),
				"pages": sprites.pages.filter(func(p): return p != null).size(), "ta": sprites.ta_tex.size()})
	return {"peak_tex_mib": snappedf(peak, 0.1), "worst_bake_frame_ms": snappedf(worst_frame, 0.1), "max_pages": sprites.MAX_PAGES, "ta_max": sprites.TA_MAX, "rounds": rounds}

## 繪圖效能量測（第二輪 R2、第三輪 T3）：
## ・啟動時間（引擎啟動到量測開始）、色盲切換的圖集重建時間
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--out="):
			out = a.substr(6)
		elif a.begins_with("--only="):
			for x in a.substr(7).split(","):
				only.append(int(x))
	_run.call_deferred()

## 一格的參數：[face, turn_c, atk, t]
func _frames() -> Array:
	var fr: Array = []
	for i in 16:
		var cf := cos(i / 16.0 * TAU)
		fr.append([1.0 if cf >= 0.0 else -1.0, maxf(absf(cf), 0.3) if absf(cf) < 0.95 else 1.0, 0.0, 0.5, sin(i / 16.0 * TAU) < -0.01])   # 後半圈看背面（人形兵）
	for i in 14:
		fr.append([1.0, 1.0, 0.001 + i / 13.0 * 0.999, 0.5, false])
	for i in 6:
		fr.append([1.0, 1.0, 0.0, 0.5 + i * 0.4, false])
	return fr

func _snap(vp: SubViewport, pn: Painter, f: Array) -> Image:
	pn.face = f[0]
	pn.tc = f[1]
	pn.atk = f[2]
	pn.t = f[3]
	pn.bk = f[4]
	pn.queue_redraw()
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	var img := vp.get_texture().get_image()
	img.convert(Image.FORMAT_RGBA8)
	return img

func _run() -> void:
	var N: int = F8.DRAW_TOTAL
	var types: Array = only if not only.is_empty() else range(N)
	var frs := _frames()
	var pick := [0, 2, 4, 6, 8, 10, 12, 14, 16, 19, 21, 23, 26, 29]   # 拼表取的 14 格
	var sheet := Image.create(W * pick.size(), H * types.size(), false, Image.FORMAT_RGBA8)
	var vp := SubViewport.new()
	vp.size = Vector2i(W, H)
	vp.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	var pn := Painter.new()
	vp.add_child(pn)
	root.add_child(vp)
	var row := 0
	for ty in types:
		pn.ty = int(ty)
		var imgs: Array = []
		for f in frs:
			imgs.append(await _snap(vp, pn, f))

exec
