#!/usr/bin/env python3
"""統一檢查（第九輪 P0）：平行跑、可快取、輸出一行結論。check_all.sh 是它的入口。

用法：GODOT=<godot> python3 tools/check.py [--out 資料夾] [--quick] [--no-cache] [--jobs N] [--only 名稱,...]
  --quick     改動時用：載入、框架、UI、金標準 30 場、字串、字型
  --no-cache  驗收用：全部重跑（快取只在改動時省時間）
環境變數 GOLDEN_N、COMPAT_N 和舊版相同。
快取鍵＝引擎版本＋該步驟腳本的 preload 相依樹＋資料檔的內容雜湊；細節在 <out>/summary.json。
"""
import argparse, concurrent.futures as cf, hashlib, json, os, re, shutil, subprocess, sys, time, uuid
from pathlib import Path

GAME = Path(__file__).resolve().parent.parent
EXPECT = "4.6.2.stable"
ERR = re.compile(r"SCRIPT ERROR|Parse Error|Compile Error|Failed to load script")
PRE = re.compile(r'(?:preload|load)\(\s*"res://([^"]+\.(?:gd|json|csv))"|^extends\s+"res://([^"]+\.gd)"', re.M)   # V1.1（Codex v110-impl #3）：也追繼承鏈
RES = re.compile(r'"res://([^"*%]+\.[A-Za-z0-9]+)"')   # 1.2.0：所有 res:// 字面路徑
TEST_DONE = re.compile(r"^—— ([1-9]\d*) 通過 / 0 失敗", re.M)
# 這些組會碰存檔（固定檔名、靜態狀態），放同一個行程
STATEFUL = ["fantasy", "rules", "save", "ui", "modes"] + ["coach_lab", "share_codes", "reports_platform", "modes_live", "battle_visual"]   # 1.1.0 A4：v16／v161／v100 拆成功能組


def sha(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def deps(entry: str, seen=None) -> set:
    seen = set() if seen is None else seen
    if entry in seen or not (GAME / entry).is_file():
        return seen
    seen.add(entry)
    if entry.endswith(".gd") or entry.endswith(".gdshader"):
        txt = (GAME / entry).read_text(encoding="utf-8", errors="ignore")
        for m in PRE.findall(txt):
            deps(m[0] or m[1], seen)
        # 1.2.0（Codex cat01 #2）：任何 res:// 字串常數（shader、字型、貼圖、音效、const 路徑）都算依賴
        for m in RES.findall(txt):
            deps(m, seen)
    return seen


DYN = re.compile(r"\bload\(\s*[A-Za-z_]")   # 1.2.0 §14.1：用變數動態 load（音效、字型、貼圖、shader 路徑）＝依賴表推不出來
ASSET_DIRS = ["art", "audio", "fonts", "shaders"]


def key_of(ver: str, entries: list, extra_dirs: list) -> str:
    files = set()
    for e in entries:
        deps(e, files)
    # 1.2.0 §14.1：相依的腳本裡有動態 load → 這一步的鍵把素材資料夾整個算進去（未知依賴＝保守地當成都依賴）
    if any(f.endswith(".gd") and DYN.search((GAME / f).read_text(encoding="utf-8", errors="ignore")) for f in files):
        extra_dirs = list(extra_dirs) + [d for d in ASSET_DIRS if d not in extra_dirs]
    for d in extra_dirs:
        p = GAME / d
        if p.is_dir():
            files |= {str(x.relative_to(GAME)).replace("\\", "/") for x in p.rglob("*") if x.is_file() and x.suffix != ".import"}
        elif p.is_file():
            files.add(d)
    h = hashlib.sha256(ver.encode())
    for f in sorted(files):
        h.update(f.encode())
        h.update(sha(GAME / f).encode())
    return h.hexdigest()[:20]


def suite_map() -> dict:
    """run_tests.gd 的 FILES（JSON 相容）＋別名 new＝units。"""
    src = (GAME / "tests/run_tests.gd").read_text(encoding="utf-8")
    m = re.search(r"^const FILES := (\{.*\})$", src, re.M)
    files = json.loads(m.group(1)) if m else {}
    if "units" in files:
        files["new"] = files["units"]
    return files


FULL_GOLDEN = False


def plan(a) -> list:
    gn = int(os.environ.get("GOLDEN_N", "1000"))
    cn = int(os.environ.get("COMPAT_N", "1000"))
    t = "tests/run_tests.gd"
    suites = [f"tests/suites/{x.stem}.gd" for x in (GAME / "tests/suites").glob("*.gd")]
    data = ["data", "tests/golden"]
    st = []

    def gd(name, script, args, ok, entries=None, dirs=None):
        st.append({"name": name, "kind": "gd", "script": script, "args": args, "ok": ok,
                   "entries": entries or [script], "dirs": data if dirs is None else dirs})

    sim_only = ["tests/golden"]   # V1.1 E1：純模擬的工具不讀 data/（已查：相依樹與字面路徑都沒有），改字串不必重跑

    def shards(name, script, args, ok, m):
        for k in range(m):
            gd(f"{name}{k}", script, args + [f"--shard={k}/{m}"], ok, dirs=sim_only)

    files = suite_map()

    def test(name, only):
        # V1.1 E1：快取鍵只含這一步會跑到的測試組（以前是全部 suites，改一個測試檔全部重跑）
        groups = set()
        for k in only.split(","):
            k = k.lstrip("-")
            if k in files:
                groups.add(k)
            else:
                groups |= {g for g, fns in files.items() if k in fns}
        if "harness" in groups or not groups:
            ent = suites   # 框架測試會載入每個測試組
        else:
            ent = [f"tests/suites/{g}.gd" for g in sorted(groups)]
        gd(name, t, [f"--only={only}"], TEST_DONE.pattern, [t, "tests/test_base.gd"] + ent, data + ["fonts"])

    if a.quick:
        test("t_harness", "harness,anim")
        test("t_ui", "ui")
        test("t_lab", "coach_lab")   # 1.1.0 A4：原 t_v16／t_v161／t_v100，改依功能組；教練／三考最慢，自己一個行程
        test("t_live", "modes_live,reports_platform,share_codes")
        test("t_visual", "battle_visual")
        gd("golden", "tools/golden.gd", ["--n=30"], r'^GOLDEN \{.*"ok":true')
    else:
        for s in ["maps", "anim", "units", "free", "content", "harness"]:
            test(f"t_{s}", s)
        # 最慢的幾項各開一個行程（都不碰存檔）；其他留在原組
        test("t_golden", "test_golden")
        test("t_determinism", "test_determinism_and_mirror")
        test("t_core", "core,-test_golden,-test_determinism_and_mirror")
        test("t_sandbox", "test_sandbox_v5")
        # V1.1 E1：t_stateful 是關鍵路徑（845 秒）。不寫存檔的慢測試拆成各自的行程（三星解有鎖存檔、另兩個不碰存檔）
        for nm, fn in [("t_star", "test_star_solutions"), ("t_fmirror", "test_fantasy_mirror_v8"), ("t_events", "test_event_routes")]:
            test(nm, fn)
        # V1.6 #4：存檔組再拆兩個行程，各用自己的存檔前綴（rules、save 內部自訂的前綴互不重疊）
        skip = ",-test_sandbox_v5,-test_star_solutions,-test_fantasy_mirror_v8,-test_event_routes"
        gd("t_stateful", "tests/run_tests.gd", ["--only=rules,save" + skip, "--prefix=ta_"], TEST_DONE.pattern, ["tests/run_tests.gd", "tests/test_base.gd"] + [f"tests/suites/{g}.gd" for g in STATEFUL], data + ["fonts"])
        # 1.1.0 B1：t_stateful2 是最長的單步（626 秒），拆成兩個行程、各用自己的存檔前綴（總工作量不變，關鍵路徑變短）
        gd("t_stateful2", "tests/run_tests.gd", ["--only=fantasy,ui" + skip, "--prefix=tb_"], TEST_DONE.pattern, ["tests/run_tests.gd", "tests/test_base.gd"] + [f"tests/suites/{g}.gd" for g in STATEFUL], data + ["fonts"])
        gd("t_stateful3", "tests/run_tests.gd", ["--only=modes,coach_lab,share_codes,reports_platform,modes_live,battle_visual" + skip, "--prefix=tc_"], TEST_DONE.pattern, ["tests/run_tests.gd", "tests/test_base.gd"] + [f"tests/suites/{g}.gd" for g in STATEFUL], data + ["fonts"])
        shards("mirror", "tools/mirror_100.gd", [], r"^MIRROR100 100/100", 4)
        # V1.1 E1：最慢的兩組各切 8 片（每片太長，最後幾分鐘只剩少數工作在跑）
        global FULL_GOLDEN
        FULL_GOLDEN = gn >= 20   # 完整 golden 步驟涵蓋測試裡的前 20 場
        shards("golden", "tools/golden.gd", [f"--n={gn}"], r'^GOLDEN \{.*"ok":true', 8)
        shards("compat", "tools/compat.gd", [f"--n={cn}"], r'^COMPAT \{.*"ok":true', 8)
        gd("sealcodes", "tools/seal_codes.gd", [], r'^SEALCODES \{"n":40,"ok":true', dirs=sim_only)
        shards("goldenfree", "tools/golden_free.gd", [], r'^GOLDENFREE \{.*"ok":true', 3)
	if result == 0:
		return ["tw_next", floor_no + 1]
	if result == 1:
		return ["tw_again", 1]
	return []

## 遠征牌上的入口：有進行中的塔就從那一層繼續（回標題也保留，方案 §11.11）
func _tower_open() -> void:
	var run := int(Save.data.get("tower_run", 0))
	if run > 1:
		_toast(L.t("tw_resume", [run]))
	_tower_start(maxi(1, run))

func _tower_start(floor_no: int) -> void:
	if _demo():
		_toast(L.t("demo_locked"), true)
		return
	var sp: Dictionary = Tower.spec(floor_no)
	var r = Tower.make_rules(sp, RS.mask(false))
	if not r.validate().is_empty():
		_toast(L.t("ch_bad"), true)   # 規則不合法＝提示並回第 1 層（方案 §11.11）
		if floor_no > 1:
			Save.data["tower_run"] = 0
			_tower_start(1)
		return
	set("daily_spec", {})        # 從每日挑戰／每日練習直接進塔：不帶每日狀態（不記每日紀錄、不跳過塔結算，Codex cat11 #1）
	set("daily_practice", false)
	rules = r
	challenge_army = Tower.enemy(sp, r)   # 這一層固定的敵陣（走挑戰碼那條路）
	overlay = ""
	_start_mode(Mode.VS_AI)
	tower_on = true
	tower_floor = int(sp["floor"])
	tower_result = -1
	Save.data["tower_run"] = tower_floor
	Save.save_data()   # 續局寫進存檔（中途關遊戲也從這一層繼續，Codex cat11 #3）
	_toast(L.t("tw_head", [tower_floor, L.t("daily_mut_%d" % int(sp["mut"]))]))

func _tower_finish(w: int) -> void:
	if not tower_on or mode != Mode.VS_AI or play_kind != "official":
		return
	var best := int(Save.data.get("tower_best", 0))
	Save.data["tower_run"] = Tower.next_run(int(Save.data.get("tower_run", 0)), tower_floor, w == 0)
	tower_result = 0 if w == 0 else 1
	if w == 0:
		var r: Array = Tower.record(best, tower_floor)
		Save.data["tower_best"] = r[0]
		_toast(L.t("tw_floor_clear", [tower_floor]))
	else:
		_toast(L.t("tw_over", [tower_floor, best]))
		if un.has("col") and not PZ.is_fixed(pz, int(un["col"]), int(un["row"])):
			u.append([int(un["type"]), int(un["col"]), int(un["row"])])
	if u.is_empty():
		return
	var SC = load("res://scripts/game/solution_code.gd")
	var plan: Array = (get("puzzle_plan") as Array).duplicate() if pz.has("cmd") and get("puzzle_plan") is Array else []   # 時序關卡要連軍令一起存（Codex v110-i1 #2）
	Save.data["pz_sol"] = SC.merge(Save.data.get("pz_sol", {}), pid, stars, PZ.rem_pct(sim.power(0), sim.budget_of(0)), last_armies[0].spent(), u, plan)

func _puzzle_record(pid: String, spent: int, units: int, ticks: int) -> void:
	var all: Dictionary = Save.data.get("pz_best", {})
	var old: Array = all.get(pid, [])
	var nw := record_merge(old, spent, units, ticks)
	var better: Array = []
	if old.size() == 3:
		if nw[0] < int(old[0]):
			better.append(L.t("rec_gold", [int(old[0]) - nw[0]]))
		if nw[1] < int(old[1]):
			better.append(L.t("rec_units", [int(old[1]) - nw[1]]))
		if nw[2] < int(old[2]):
			better.append(L.t("rec_time", [_fmt_num(snappedf((int(old[2]) - nw[2]) / 20.0, 0.1))]))
	all[pid] = nw
	Save.data["pz_best"] = all
	report["rec_line"] = L.t("rec_line", [spent, units, _fmt_num(snappedf(ticks / 20.0, 0.1)), nw[0], nw[1], _fmt_num(snappedf(nw[2] / 20.0, 0.1))])
	report["rec_new"] = L.t("rec_new", ["、".join(better)]) if not better.is_empty() else ""

func _gauntlet_next() -> void:
	gauntlet_prev = last_armies[0].units.duplicate(true)
	gauntlet_stage += 1
	gauntlet_changes = 3
	_reset_place(false)
	armies[0].budget += int(get("gauntlet_gold"))
	armies[0].unit_cap += int(get("gauntlet_cap"))

## 第十輪 I5：遠征只在每戰之間存檔。
func _gauntlet_save() -> void:
	var prev: Array = []
	for u in gauntlet_prev:
		var o := {}
		for k in u:
			o[str(k)] = int(u[k])
		prev.append(o)
	Save.data["gauntlet_run"] = {"stage": gauntlet_stage, "seed": gauntlet_seed, "gold": int(get("gauntlet_gold")), "cap": int(get("gauntlet_cap")),
		"changes": gauntlet_changes, "pool": _gauntlet_pool(), "prev": prev,
		"foe_gold": int(get("gauntlet_foe_gold")), "foe_cap": int(get("gauntlet_foe_cap")), "contract": int(get("gauntlet_contract")), "coop": 1 if bool(get("ga_coop")) else 0, "clog": get("coop_log").duplicate() if get("coop_log") is Array else []}   # V1.1 D1：舊存檔沒有這兩欄＝0   # 存實際卡池：之後改大廳不會影響這次遠征（Codex v10-r1 #2）
	Save.save_data()

func _gauntlet_clear() -> void:
	Save.data["gauntlet_run"] = {}

func _gauntlet_resume() -> void:
	var g: Dictionary = Save.data.get("gauntlet_run", {})
	if g.is_empty():
		return
	Save.data["gauntlet_pool"] = int(g["pool"])
	call("_start_mode", Mode.GAUNTLET)
	set("gauntlet_gold", int(g["gold"]))
	set("gauntlet_cap", int(g["cap"]))
	gauntlet_stage = int(g["stage"])
	gauntlet_seed = int(g["seed"])
	gauntlet_prev = g["prev"].duplicate(true)
	set("gauntlet_foe_gold", int(g.get("foe_gold", 0)))
	set("gauntlet_foe_cap", int(g.get("foe_cap", 0)))
	set("gauntlet_contract", int(g.get("contract", -1)))   # V1.4 #3：舊存檔沒有＝沒簽
	set("ga_coop", int(g.get("coop", 0)) == 1)   # V1.6 #21：雙人接力（舊存檔沒有＝單人）
	set("coop_log", (g.get("clog", []) as Array).duplicate())   # V1.6.1 D4：每站誰擺、勝負、MVP
	_reset_place(false)
	armies[0].budget += int(g["gold"])
	armies[0].unit_cap += int(g["cap"])
	call("_apply_contract_cost")
	gauntlet_changes = int(g["changes"])



## 匯出成品自我檢查（第七輪 S3）：tools/export_check.sh 對匯出的 exe 跑，印 SELFCHECK 一行 JSON。
func _self_check() -> void:
	for i in 3:
		await get_tree().process_frame
	var demo := _demo()
	var out := {"demo": demo, "exported": OS.has_feature("template"), "engine": Engine.get_version_info().string}
	out["strings"] = L.has("title") and L.t("title") != "title"
	out["data"] = FileAccess.file_exists("res://data/puzzles.json") and FileAccess.file_exists("res://data/codex.json") and FileAccess.file_exists("res://data/strings.csv")
	out["fonts"] = font_title != null and font_bold != null
	out["audio"] = sfx != null and sfx.get_child_count() > 0
	out["art"] = grass != null and plants.size() > 0
	Save.data["tutorial"] = 2
	var w: bool = Save.save_data()
	Save.load_all()
	out["save_roundtrip"] = w and int(Save.data["tutorial"]) == 2 and Save.file_prefix().ends_with("demo_") == demo
	var a0 := Army.new(0, 100)
	a0.place(0, 0, 0)
	var a1 := Army.new(1, 100)
