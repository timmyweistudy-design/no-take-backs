#!/usr/bin/env bash
# 改 game/ 之前跑：有進行中的驗收鏈就印出來並回傳 1（以每條鏈 .last 指的那一輪有沒有 state= 判斷）
cd "$(dirname "$0")/../../game" || exit 2
busy=0
for f in ../build/tmp/chains/*/; do
  n=$(basename "$f")
  if ! tools/run_chain.sh --status "$n" 2>/dev/null | grep -q '^state='; then echo "BUSY $n"; busy=1; fi
done
exit $busy

