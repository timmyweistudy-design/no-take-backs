   188	## ── 挑戰碼：把自己的陣型傳給朋友打（不需要伺服器）──
   189	func _challenge_encode() -> String:
   190		var r = rules if rules != null else RuleSet.standard()
   191		var j := JSON.stringify({"a": last_armies[0].to_code(), "r": r.to_code()})
   192		var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
   193		return "NTC1.%s.%s" % [b, b.sha256_text().substr(0, 6)]
   194	
   195	func _copy_challenge() -> void:
   196		DisplayServer.clipboard_set(_challenge_encode())
   197		_toast(L.t("ch_copied"))
   198	
   199	func _accept_challenge(c := "") -> void:
   200		var from_clip := c == ""
   201		if from_clip:
   202			c = DisplayServer.clipboard_get().strip_edges()
   203		var d := _challenge_decode(c.strip_edges())
   204		if not d["ok"]:
   205			if not (from_clip and _ask_code(L.t("ch_accept"), _accept_challenge)):
   206				_toast(L.t("ch_bad"), true)
   207			return
   208		rules = d["rules"]
   209		challenge_army = d["army"]
   210		rules.rounds = 1
   211		_start_mode(Mode.VS_AI)
   212	
   213	## 回傳 {ok, rules, army}。陣型一定要照那組規則合法。
   214	func _challenge_decode(c: String) -> Dictionary:
   215		var bad := {"ok": false}
   216		var parts := c.split(".")
   217		if c.length() > 6000 or parts.size() != 3 or parts[0] != "NTC1" or parts[1].sha256_text().substr(0, 6) != parts[2]:
   218			return bad
   219		var b64 := parts[1].replace("-", "+").replace("_", "/")
   220		while b64.length() % 4 != 0:
   221			b64 += "="
   222		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
   223		if not j is Dictionary or not j.get("a") is String or not j.get("r") is String:
   224			return bad
   225		var rd: Dictionary = RuleSet.from_code(str(j["r"]))
   226		if not rd["ok"] or rd["rules"].fullfield != RuleSet.FULL_NONE:
   227			return bad      # 全場規則是雙方互相看得到才成立，不能當挑戰碼（Codex r2 #3）
   228		var r = rd["rules"]
   229		r.ai_pool_same = false
   230		# 碼是對方當藍軍排的，到這裡他變紅軍：兩邊的預算、卡池要對調（讓子局才有差，Codex #10）
   231		var b0: int = r.budget_of(0)
   232		var b1: int = r.budget_of(1)
   233		var p0: int = r.pool_of(0)
   234		var p1: int = r.pool_of(1)
   235		r.budget = [b1, b0]
   236		r.pool = [p1, p0]
   237		r.cmd_mask = [int(r.cmd_mask[1]), int(r.cmd_mask[0])]   # 第十二輪：手動技能也要對調
   238		var a = Army.new(1, r.budget_of(1))
   239		a.apply_rules(r, 1)
   240		a.pool = RuleSet.full_pool()     # 朋友的牌不必在自己的解鎖範圍內
   241		if a.load_code(str(j["a"])) != "" or not a.has_combat():
   242			return bad
   243		if _demo() and not _demo_ok(r, a):
   244			return bad      # 第十輪 B7：試玩版不能靠挑戰碼帶進正式版內容
   245		return {"ok": true, "rules": r, "army": a}
   246	
   247	## 第十輪 R1：試玩版的範圍集中在這裡。匯入的規則與陣型都走這條。
   248	func _demo_ok(r, a = null) -> bool:
   249		var mask: int = RS.mask(true)
   250		if r != null:
   251			if not r.map_id in Presets.DEMO_MAPS:
   252				return false
   253			if r.pool_of(0) & ~mask != 0 or r.pool_of(1) & ~mask != 0:
   254				return false
   255		if a != null:
   256			for u in a.units:
   257				if not RuleSet.has(mask, int(u["type"])):
   258					return false
   259		return true
   260	
