   176			var mid: String = L.t("ai_style_%d" % int(t[2])) if x.is_empty() else L.t("map_" + str(MapDefs.MAPS[t[0]]["key"]))
   177			_text(r.position + Vector2(154, 8 + tz("B") * 1.4), "%s・%s・%s" % [sz, mid, L.t(["diff_easy", "diff_normal", "diff_hard"][int(t[3])])], tz("C"), Color(1, 1, 1, 0.72), false, false, cw - 160)
   178			var tb: int = int(x["budget"]) if x.has("budget") else int(MapDefs.SIZE_SUGGEST[int(t[1])][0])
