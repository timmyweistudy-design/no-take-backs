   678	## 第十三輪：時序殘局的施放時間（戰鬥中不能按，照這裡設定的秒數放）。每格 0.5 秒。
   679	func _draw_plan_panel(R: Rect2) -> void:
   680		var pz := PZ.get_puzzle(puzzle_id)
   681		var c: Dictionary = pz["cmd"]
   682		_box(R, Color(0, 0, 0, 0.45), TH_EDGE, 8.0, 1.5)
   683		var nm: String = L.t("cmd_%d" % int(c["skill"]))
   684		var en_list: Array = []
   685		for e in c.get("enemy", []):
   686			en_list.append(L.t("plan_enemy_item", [_fmt_num(int(e[0]) / 20.0), L.t("cmd_%d" % int(e[1]))]))
   687		var head := L.t("plan_head", [nm])
   688		if not en_list.is_empty():
   689			head += "　" + L.t("plan_enemy", [", ".join(en_list)])
   690		_text(R.position + Vector2(10, 6), head, tz("C"), ACCENT, false, false, R.size.x - 20)
   691		if pad_mode and overlay == "":
   692			_text(Vector2(R.position.x + 10, R.position.y - tz("C") * 1.4), L.t("plan_pad"), tz("C"), Color(1, 1, 1, 0.7), false, false, R.size.x)
   693		var lim: int = int(pz.get("goal_ticks", Sim.MAX_TICKS)) - 10
   694		var rows: int = puzzle_plan.size()
   695		var rh: float = minf(40.0, (R.size.y - tz("C") * 1.6 - 10) / maxf(1.0, rows))
   696		for i in rows:
   697			var y: float = R.position.y + tz("C") * 1.6 + 6 + i * rh
   698			var idx := i
   699			_text(Vector2(R.position.x + 12, y + 6), L.t("plan_row", [i + 1, _fmt_num(int(puzzle_plan[i]) / 20.0)]), tz("S"), Color.WHITE, false, true, 200)
   700			var lo_hi := _plan_range(idx)
   701			_btn(Rect2(R.end.x - 104, y, 44, rh - 4), "◀", func(): _plan_nudge(idx, -10), int(puzzle_plan[idx]) > int(lo_hi[0]))
   702			_btn(Rect2(R.end.x - 54, y, 44, rh - 4), "▶", func(): _plan_nudge(idx, 10), int(puzzle_plan[idx]) < int(lo_hi[1]))
   703	
   704	## 第 i 次能設的範圍：不早於開場可放的時間、和前後兩次至少隔一個冷卻，不晚於局長（Codex v13-r1 #4）。
   705	func _plan_range(i: int) -> Array:
   706		var pz := PZ.get_puzzle(puzzle_id)
   707		var cd: int = PZ.rules_of(pz).cmd_cd
   708		var lo: int = CmdD.START_TICKS if i == 0 else int(puzzle_plan[i - 1]) + cd
   709		var hi: int = int(pz.get("goal_ticks", Sim.MAX_TICKS)) - 10
   710		if i + 1 < puzzle_plan.size():
   711			hi = mini(hi, int(puzzle_plan[i + 1]) - cd)
   712		return [lo, hi]
   713	
   714	func _plan_nudge(i: int, d: int) -> void:
   715		var lo_hi := _plan_range(i)
   716		puzzle_plan[i] = clampi(int(puzzle_plan[i]) + d, int(lo_hi[0]), maxi(int(lo_hi[0]), int(lo_hi[1])))
   717		sfx.play("k_click", 0.6)
   718	
