    94	## 位置以外的條件（卡池、人數、單種、錢、防卡死），格子與自由共用。
    95	func _check_common(t: int) -> String:
    96		if t < 0 or t >= D.total() or (pool >> t) & 1 == 0:
    97			return E_POOL
    98		if count() >= unit_cap:
    99			return E_CAP_PREFIX + " %d 隻" % unit_cap
   100		if type_cap > 0 and count_of(t) >= type_cap:
   101			return E_TYPE_CAP_PREFIX + " %d 隻" % type_cap
   102		var hc := D.hard_cap(t)     # 第八輪：奇幻兵一隊的硬上限
   103		if hc > 0 and count_of(t) >= hc:
   104			return E_TYPE_CAP_PREFIX + " %d 隻" % hc
   105		if D.cost(t) > left():
   106			return E_GOLD
   107		if guard_combat and not D.is_combat(t) and not has_combat():
   108			var cc := cheapest_combat()
   109			if count() + 1 >= unit_cap or left() - D.cost(t) < cc:
   110				return E_RESERVE
   111		return ""
