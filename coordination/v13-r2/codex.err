  1405	func _cmd_tick(n: int) -> void:
  1406		_cmd_dmg.resize(n)
  1407		_cmd_dmg.fill(0)
  1408		for u in units:
  1409			if u.shield_t > 0:
  1410				u.shield_t -= 1
  1411				if u.shield_t == 0:
  1412					u.shield = 0
  1413			if u.haste_t > 0:
  1414				u.haste_t -= 1
  1415		var casts: Array = []
  1416		if cmd_scripted:
  1417			casts = cmd_script.get(tick, [])
  1418		else:
  1419			casts = cmd_pending.duplicate()
  1420			cmd_pending.clear()
  1421			if tick % cmd_ai_every == 0:
  1422				for tm in 2:   # 都先讀這一 tick 開始前的狀態才決定，誰先算不佔便宜
  1423					if cmd_auto[tm]:
  1424						var want := _cmd_ai_pick(tm)
  1425						if want >= 0:
  1426							casts.append([tm, want])
  1427		for c in casts:
  1428			if cmd_can(int(c[0]), int(c[1])):
  1429				_cmd_apply(int(c[0]), int(c[1]))
  1430	
  1431	func _cmd_apply(team: int, s: int) -> void:
  1432		cmd_left[team][s] = int(cmd_left[team][s]) - 1
  1433		cmd_ready[team][s] = tick + cmd_cd
  1434		cmd_log.append([tick, team, s])
  1435		var ev := {"kind": EV.CMD, "team": team, "skill": s}
  1436		match s:
  1437			CMD.AEGIS:
  1438				for u in units:
  1439					if u.alive and u.team == team:
  1440						u.shield = maxi(u.shield, u.max_hp * CMD.scaled(CMD.AEGIS_PCT, cmd_power) / 100)
  1441						u.shield_t = CMD.AEGIS_TICKS
  1442			CMD.WARCRY:
  1443				for u in units:
  1444					if u.alive and u.team == team:
  1445						u.haste_t = CMD.scaled(CMD.WAR_TICKS, cmd_power)
#!/usr/bin/env python3
"""把量產結果併進 game/data/puzzles.json（第十三輪）。

python3 tools/gen/puzzle_merge.py <草稿.json> <FORGE 輸出檔...>
- 草稿＋forge 算出的 star2、star3、solutions、best（三星解）→ "extra"，章內依難度排序（隨機擺法過關率高的在前）。
- 舊 25 關的 "best" 從 tests/golden/star_solutions.json 帶入（提示第二、三層用）。
- 寫入章節名稱與開場小故事。
- 沒找到解、或什麼都不放就過的關卡不併，印出來。
"""
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
DATA = ROOT / "game/data/puzzles.json"
STARS = ROOT / "game/tests/golden/star_solutions.json"

CHAPTERS = [
    ("王國基礎", "Kingdom Basics",
     "公會剛開張，只招得到王國的老兵。先學會盾、弓、騎、劍、刺客怎麼互相剋。",
     "The guild has just opened and only kingdom veterans have signed up. Learn how shields, bows, horses, swords and assassins beat each other."),
    ("王國新兵", "Kingdom Recruits",
     "長槍兵、投彈兵、醫者、鼓手、狂戰士來報到了。每一位都有一招別人學不來的。",
     "Pikes, bombers, medics, drummers and berserkers report for duty. Each has one trick nobody else can do."),
    ("魔物報到", "Monsters Apply",
     "連魔物都來應徵了。牠們不懂規矩，但很好用。",
     "Even monsters want the job. They don't follow the rules, but they get results."),
    ("跨界連鎖", "Strange Partners",
     "王國兵和魔物一起上場。有些組合放在一起，會發生意想不到的事。",
     "Soldiers and monsters side by side. Some pairs do things neither could alone."),
    ("連鎖大作戰", "Chain Reactions",
     "三四種兵一起配合，敵人也開始混搭了。",
     "Three or four kinds working together, and now the enemy mixes too."),
    ("護送・死守・斬首", "Escort, Hold, Strike",
     "委託不再只是打贏：有人要保護、有時間要撐、有頭目要拿下。",
     "Contracts get specific: someone to protect, a clock to beat, a leader to take down."),
    ("地利", "Lay of the Land",
     "河、樹林、冰湖、熔岩、峽谷。地形會擋路、會拖慢、也會加速。",
     "Rivers, woods, ice, lava and canyons. Terrain blocks, slows and speeds."),
    ("限制與借力", "Less Is More",
     "兵不能多帶，或乾脆借敵人的力。",
     "Bring fewer units, or turn the enemy's tricks against them."),
    ("時序", "Timing",
     "公會發下技能卷軸。戰前寫好第幾秒放，開打後就改不了。",
     "The guild hands out skill scrolls. Write down when to cast before battle; once it starts, no changes."),
    ("宗師", "Grandmaster",
     "最後的委託，什麼都可能出現。落子無悔。",
     "The final contracts. Anything goes. No take-backs."),
]


def main():
    drafts = {d["id"]: d for d in json.load(open(sys.argv[1], encoding="utf-8"))}
    order = [d["id"] for d in json.load(open(sys.argv[1], encoding="utf-8"))]
    res = {}
    for f in sys.argv[2:]:
        for line in open(f, encoding="utf-8", errors="ignore"):
            if line.startswith("FORGE "):
                r = json.loads(line[6:])
                res[r["id"]] = r
    data = json.load(open(DATA, encoding="utf-8"))
    stars = json.load(open(STARS, encoding="utf-8"))
    for key in ("puzzles", "new_units", "fantasy_units"):
        for p in data[key]:
            if p["id"] in stars["puzzles"]:
                p["best"] = {"u": stars["puzzles"][p["id"]], "p": []}
    data["chapters"] = [{"zh": a, "en": b, "story_zh": c, "story_en": d} for a, b, c, d in CHAPTERS]
    extra, skipped = [], []
    for i in order:
        d = dict(drafts[i])
        r = res.get(i)
        if r is None or "best" not in r:
            skipped.append((i, "沒有找到解" if r else "沒有結果"))
            continue
        if r["metrics"].get("empty_ok"):
            skipped.append((i, "什麼都不放就過"))
            continue
        d["star2"] = r["star2"]
        d["star3"] = r["star3"]
        d["solutions"] = r["solutions"]
        d["best"] = r["best"]
        if "sol_plans" in r:
            d["sol_plans"] = r["sol_plans"]
        d["_m"] = {k: r["metrics"][k] for k in ("rand_pct", "kinds", "tol", "ticks") if k in r["metrics"]}
        if "hero_free_ok" in r["metrics"]:
            d["_m"]["hero_free_ok"] = r["metrics"]["hero_free_ok"]
        extra.append(d)
    # 章內依難度：隨機擺法過關率高的在前；同率照草稿順序
    pos = {i: k for k, i in enumerate(order)}
    extra.sort(key=lambda d: (d["ch"], -d["_m"].get("rand_pct", 0), pos[d["id"]]))
    data["extra"] = extra
    json.dump(data, open(DATA, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    print("併入", len(extra), "關")
    for i, why in skipped:
        print("略過", i, why)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""第十三輪主題試煉第 11～30 關的規格（敵陣卡池、規則變形、名稱）。
game/tools/balance/trial_forge.gd 依這份用固定種子生成敵陣並凍結、找三星解、訂門檻，結果再寫成 game/data/trials.json。
用法：python3 tools/gen/trial_specs.py <輸出.json>
"""
import json
import sys

SW, SH, AR, CV, AS, PK, BM, MD, DR, BS = range(10)
SP, SHP, MM, SL, GH, VD, HG, SK, CAT, GO = range(10, 20)
FANT = list(range(10, 20))
ALL = list(range(20))
AEGIS, WAR, HEAL, METEOR, FREEZE = range(5)

T = []


def tr(i, zh, en, tag_zh, tag_en, enemy_pool, **kw):
    d = {"i": i, "zh": zh, "en": en, "tag_zh": tag_zh, "tag_en": tag_en, "enemy_pool": enemy_pool}
    d.update(kw)
    T.append(d)


# 限定卡池
tr(10, "魔物限定", "Monsters Only", "只能帶魔物", "Monsters only", ALL, pool0=FANT)
tr(11, "沒有肉盾", "No Tanks", "不准帶肉盾", "No tanks", ALL, pool0=[t for t in ALL if t not in (SH, PK, SL, GO)])
tr(12, "奇兵突襲", "Ambush Party", "奇襲兵加劍士", "Raiders + swords", ALL, pool0=[SP, SHP, MM, SW])
tr(13, "近身肉搏", "Close Quarters", "不准帶遠程", "No ranged", ALL, pool0=[t for t in ALL if t not in (AR, BM, SK, SP)])
# 單主題頭目
tr(14, "羊群奔騰", "Stampede", "頭目：爆爆羊", "Boss: boom sheep", [SHP, SH, AR])
tr(15, "死靈圖書館", "Necro Library", "頭目：骷髏法師", "Boss: skeleton mage", [SK, SW, SL, MD])
tr(16, "石魔雙壁", "Twin Golems", "頭目：小石魔", "Boss: golems", [GO, SH, AR, MD])
tr(17, "刺客夜襲", "Night Raid", "頭目：刺客", "Boss: assassins", [AS, GH, BM])
tr(18, "貓窩", "Cat Den", "頭目：吸塵貓", "Boss: cats", [CAT, BM, SHP, SH])
# 混搭頭目
tr(19, "鐵桶陣", "Iron Barrel", "巫毒娃娃＋小石魔", "Voodoo + golems", [VD, GO, SH, MD])
tr(20, "切後排", "Backline Hunt", "幽靈＋刺客", "Ghosts + assassins", [GH, AS, SW])
tr(21, "控場煉獄", "Control Hell", "沙漏精靈＋孢子菇", "Sprite + spores", [HG, SP, AR, SH])
tr(22, "破盾潮", "Shieldbreaker Tide", "狂戰士＋騎兵＋鼓手", "Berserkers + riders + drums", [BS, CV, DR, SW])
tr(23, "不倒軍", "The Undying", "骷髏法師＋史萊姆", "Skeleton mage + slimes", [SK, SL, MD, SH])
tr(24, "史萊姆海", "Slime Sea", "史萊姆＋投彈兵", "Slimes + bombers", [SL, BM, SH])
tr(25, "吸塵連鎖", "Vacuum Chain", "吸塵貓＋爆爆羊", "Cats + boom sheep", [CAT, SHP, AR])
# 規則變形
tr(26, "窮兵", "Lean Purse", "雙方 60 金", "60 gold each", ALL, budget=60)
tr(27, "窄縱深", "Narrow Front", "部署縱深 3 格", "3-cell deploy depth", ALL, depth=3000)
tr(28, "技能對決", "Skill Duel", "雙方都有護盾和隕石", "Both sides: shield + meteor", ALL, cmd=(1 << AEGIS) | (1 << METEOR))
tr(29, "一種兩隻", "Two of a Kind", "每種兵最多 2 隻", "Max 2 per unit type", ALL, type_cap=2)

if __name__ == "__main__":
    assert len(T) == 20
    json.dump(T, open(sys.argv[1], "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    print(len(T), "specs")
