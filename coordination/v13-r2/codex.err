   263	func _key(k: int) -> void:
   264		if state == St.PLACE and _fp_key(k):
   265			return
   266		if state == St.BATTLE and overlay == "" and _cmd_key(k):
   267			return
   268		# 有按鈕焦點的畫面（標題、選單、結果、覆蓋層、戰鬥）：方向鍵移焦點、Enter 按下、Esc 返回
   269		if state != St.PLACE or overlay != "":
   270			match k:
   271				KEY_UP, KEY_LEFT:
   272					_move_focus(-1)
   273				KEY_DOWN, KEY_RIGHT:
   274					_move_focus(1)
   275				KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
   276					if _btns_gen == _gen and _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:   # 按鈕清單要是這個畫面的
   277						sfx.play("k_click", 0.7)
   278						_btns[_focus]["cb"].call()
   279				KEY_PAGEUP, KEY_PAGEDOWN:
   280					if overlay == "codex":
   281						_scroll_by("left", -160.0 if k == KEY_PAGEUP else 160.0)
   282				KEY_P, KEY_TAB:
   283					# 手把 Y 送的是 Tab：戰鬥中＝暫停（第七輪 A6）
   284					if state == St.BATTLE and overlay == "":
   285						_toggle_pause()
   286					elif k == KEY_TAB:
   287						_move_focus(1)
   288				KEY_ESCAPE:
   289					if overlay == "ai_busy":
   290						pass      # 第十輪 I4：AI 計算中不能取消
   291					elif overlay != "":
   292						overlay = ""
   293					elif state == St.BATTLE:
   294						if play_kind != "official":
   295							_replay_back()   # 第七輪 A9：重播時 Esc＝返回
   296						else:
   297							_on_skip()
   298					elif state != St.TITLE:
   299						_request_leave()
   300			return
   301		pad_mode = true
   302		match k:
   303			KEY_UP: cursor.y = maxi(0, cursor.y - 1)
   304			KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
   305			KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
   306			KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
   307			KEY_F1:
   308				_open_codex(selected)
   309			KEY_H:
   310				if mode == Mode.PUZZLE:
   311					call("_puzzle_hint")   # 第十三輪：手把 L3
   312			KEY_P:
   313				if mode == Mode.PUZZLE and PZ.get_puzzle(puzzle_id).has("cmd"):
   314					overlay = "puzzle_plan"   # 第十三輪：手把 R3
   315			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0:
   260				_text(Vector2(640, 294), L.t("leave_title"), tz("H2"), Color.WHITE, true, true, 540)
   261				_text(Vector2(640, 354), L.t("leave_body_gauntlet") if mode == Mode.GAUNTLET else L.t("leave_body_series"), tz("B"), Color(1, 1, 1, 0.85), true, false, 540)
   262				_btn(Rect2(380, 450, 250, 52), L.t("leave_stay"), func(): overlay = "", true, true)
   263				_btn(Rect2(650, 450, 250, 52), L.t("leave_go"), func(): _leave_confirm())
   264			"tutorial", "puzzles":
   265				var tut := overlay == "tutorial"
   266				puzzle_tab = clampi(puzzle_tab, 0, PZ.CHAPTERS - 1)
   267				var chap: Array = PZ.chapter(puzzle_tab + 1)
   268				var list: Array = PZ.tutorials() if tut else chap
   269				var stars: Dictionary = Save.data.get("puzzle_stars", {})
   270				_panel(Rect2(240, 110, 800, 580))
   271				_text(Vector2(640, 114), L.t("menu_tutorial") if tut else L.t("puzzle_title"), ts(26), Color.WHITE, true, true)
   272				var y0 := 210.0
   273				var idx: Array = []
   274				for i0 in list.size():
   275					idx.append(i0)
   276				if not tut:
