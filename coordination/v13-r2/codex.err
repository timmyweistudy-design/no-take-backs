   120	static func goal(pz: Dictionary) -> String:
   121		return str(pz.get("goal", "win"))
   122	
   123	## 這關要不要用規則（地形、撐住秒數、技能）。不用就回 null，走舊模擬路徑。
   124	static func rules_of(pz: Dictionary):
   125		if not pz.has("map") and goal(pz) != "survive" and not pz.has("cmd"):
   126			return null
   127		var r = RS.standard()
   128		r.preset = "custom"
   129		r.map_id = int(pz.get("map", 0))
   130		r.map_size = MAP_SIZE
   131		if goal(pz) == "survive":
   132			r.ticks = int(pz["goal_ticks"])
   133		if pz.has("cmd"):
   134			var c: Dictionary = pz["cmd"]
   135			var em := 0
   136			for e in c.get("enemy", []):
   137				em |= 1 << int(e[1])
   138			r.cmd_mask = [1 << int(c["skill"]), em]
   139			r.cmd_uses = int(c.get("uses", 1))
   140			r.cmd_cd = int(c.get("cd", CMD.CD_TICKS[0]))
   141			r.cmd_power = 100
   142		return r
   143	
   144	## 技能關：玩家設定的施放 tick（plan）＋敵方寫死的時間 → 重播紀錄。
   145	static func cmd_log(pz: Dictionary, plan: Array) -> Array:
   146		if not pz.has("cmd"):
   147			return []
   148		var log: Array = []
   149		for t in plan:
   150			log.append([int(t), 0, int(pz["cmd"]["skill"])])
   175	static func outcome(pz: Dictionary, sim, spent_extra: int) -> Dictionary:
   176		var g := goal(pz)
   177		var won: bool = sim.winner == 0
   178		var ok := won
   179		match g:
   180			"protect":
   181				ok = won and unit_alive(sim, 0, pz["goal_unit"])
   182			"kill":
   183				ok = won and not unit_alive(sim, 1, pz["goal_unit"])
   184			"survive":
   185				ok = sim.alive_count(0) > 0
   186		var rem: int = rem_pct(sim.power(0), sim.budget) if ok else 0
   187		return {"ok": ok, "won": won, "goal": g, "rem": rem, "spent": spent_extra, "stars": stars(pz, ok, rem, spent_extra)}
   188	
   189	## 擺法合不合法（extra＝[[兵種, 欄, 列], ...]；還會檢查可用兵種）。合法回 ""。
   190	static func check_extra(pz: Dictionary, extra: Array) -> String:
   191		var a0: Army = player_army(pz)
   192		var allowed: Array = []
   193		for v in pz.get("allowed", []):
   194			allowed.append(int(v))
   195		for e in extra:
   196			if not allowed.has(int(e[0])):
   197				return "兵種 %d 不能用" % int(e[0])
   198			var why: String = a0.check_place(int(e[0]), int(e[1]), int(e[2]))
   199			if why != "":
   200				return why
   201			a0.place(int(e[0]), int(e[1]), int(e[2]))
   202		return ""
   203	
   204	## 直接打一場（工具、測試用；遊戲裡是畫面上的模擬，最後一樣呼叫 outcome）。不合法回 {"ok": false, "illegal": 原因}。
   205	static func play(pz: Dictionary, extra: Array, plan: Array = [], check := true) -> Dictionary:
   206		if check:
   207			var why := check_extra(pz, extra)
   208			if why != "":
   209				return {"ok": false, "illegal": why, "stars": 0, "rem": 0, "spent": 0}
   210		var a0: Army = player_army(pz)
   211		var fixed_budget: int = a0.budget - int(pz["budget"])
   212		for e in extra:
   213			a0.units.append({"type": int(e[0]), "col": int(e[1]), "row": int(e[2])})
   214		var s = Sim.new(a0, enemy_army(pz), rules_of(pz))
   215		if s.cmd_on:
   216			s.cmd_play(cmd_log(pz, plan if not plan.is_empty() else default_plan(pz)))
   217		s.fast = true
   218		s.run_to_end()
   219		var out := outcome(pz, s, a0.spent() - fixed_budget)
   220		out["ticks"] = s.tick
   221		return out
   222	
   223	## 三星編制提示：三星解用了哪些兵（不給位置）。回 [[兵種, 隻數], ...]，照兵種編號。
   224	static func best_lineup(pz: Dictionary) -> Array:
   225		var cnt := {}
   226		for e in pz.get("best", {}).get("u", []):
   227			cnt[int(e[0])] = int(cnt.get(int(e[0]), 0)) + 1
   228		var ks: Array = cnt.keys()
   229		ks.sort()
   230		var out: Array = []
   231		for k in ks:
   232			out.append([k, cnt[k]])
   233		return out
   234	
   235	static func is_fixed(pz: Dictionary, col: int, row: int) -> bool:
   236		for f in pz["fixed"]:
   237			if int(f[1]) == col and int(f[2]) == row:
   238				return true
   239		return false
