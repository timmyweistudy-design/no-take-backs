   199	## 滑鼠按鍵（佇列命令，第三輪 A2）：按鈕點擊、擺放、拖曳、移除。
   200	func _mb_cmd(d: Dictionary) -> void:
   201		var mb := InputEventMouseButton.new()
   202		mb.button_index = d["i"]
   203		mb.pressed = d["pressed"]
   204		mb.position = d["pos"]
   205		mouse = d["pos"]
   206		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   207			if _do_click(mouse) > 0:
   208				_mb_release_cleanup()
   209				return
   210		if state == St.PLACE and overlay == "" and _fp_mb(d):
   211			return   # 第六輪：自由排兵處理掉了
   212		if overlay != "" or state != St.PLACE:
   213			if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
   214				_mb_release_cleanup()
   215				if overlay == "" and state == St.BATTLE and mb.button_index == MOUSE_BUTTON_LEFT:
   216					_battle_click(mouse)   # 重播時點兵讓鏡頭跟（第三輪 F2）
   217			return
   218		var c := _cell_at(mouse)
   219		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   220			var k := _card_at(mouse)
   221			if k >= 0 and _card_help_rect(k).has_point(mouse):
   222				return   # 放開時由「?」按鈕處理
   223			if k >= 0:
   224				if _allowed(k):
   225					selected = k
   226					drag_new = true
   227					sfx.play("k_click", 0.7)
   228				else:
   229					_toast(L.t("err_type"), true)
   230				return
   231			if c.x < 0:
   232				return
   233			if _can_edit_existing() and _cur_army().index_at(c.x, c.y) != -1:
   234				if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
   235					_toast(L.t("err_locked"), true)
   236					return
   237				drag_from = c
   238			else:
   239				painting = true
   240				paint_team = _cur_army().team
   241				_try_place(c)
   242		elif mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   243			if drag_new and c.x >= 0:
   244				_try_place(c)
   245			elif drag_from.x >= 0:
   246				if c.x < 0:
   247					_try_remove(drag_from)
   248				elif c != drag_from:
   249					if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() >= gauntlet_changes:
   250						_toast(L.t("err_changes"), true)
   251					elif not _cur_army().move(drag_from.x, drag_from.y, c.x, c.y):
   252						_toast(L.t("err_zone"), true)
   253					else:
   254						sfx.play("place_light")
   255			drag_new = false
   256			painting = false
   257			drag_from = Vector2i(-1, -1)
   258		elif mb.button_index == MOUSE_BUTTON_RIGHT and mb.pressed and c.x >= 0:
   259			_try_remove(c)
