   361	## ── 戰績 ──
   362	func _record_match(w: int) -> void:
   363		if armies.is_empty() or armies[0] == null:
   364			return
   365		var ug: Dictionary = Save.data.get("unit_games", {})
   366		var seen := {}
   367		for u in armies[0].units:
   368			seen[str(int(u["type"]))] = true
   369		if mode == Mode.DUEL and armies.size() > 1 and armies[1] != null:   # 第十輪 B4：雙人兩邊贏了都算勝場，場數也要兩邊算
   370			for u2 in armies[1].units:
   371				seen[str(int(u2["type"]))] = true
   372		for k in seen:
   373			ug[k] = int(ug.get(k, 0)) + 1
   374		Save.data["unit_games"] = ug
   375		if mode == Mode.DUEL:
   376			return    # 連勝只算單人
   377		if w == 0:
   378			Save.data["streak"] = int(Save.data.get("streak", 0)) + 1
   379			Save.data["best_streak"] = maxi(int(Save.data.get("best_streak", 0)), int(Save.data["streak"]))
   380		else:
   381			Save.data["streak"] = 0
