    95	## 自己視角的欄：隊伍 1 從右邊數。
    96	func _col(x: int, team: int) -> int:
    97		var ox: int = x if team == 0 else w - x
    98		var c: int = clampi(ox / Q, 0, n - 1)
    99		return c if team == 0 else n - 1 - c
   100	
   101	func _row(y: int) -> int:
   102		return clampi(y / Q, 0, m - 1)
   103	
   104	func kind_at(x: int, y: int, team: int) -> int:
   105		return grid[_col(x, team) + _row(y) * n]
   106	
   107	func blocked(x: int, y: int, team: int) -> bool:
   108		return kind_at(x, y, team) == BLOCK
   109	
   110	func speed_pct(x: int, y: int, team: int) -> int:
   111		match kind_at(x, y, team):
   112			SLOW:
   113				return SLOW_PCT
   114			FAST:
   115				return FAST_PCT
   116		return 100
   117	
   118	## 最近的可站點（世界座標）。同距用固定順序，隊伍 1 鏡像。
   119	func free_near(x: int, y: int, team: int) -> Vector2i:
   120		var ox: int = x if team == 0 else w - x
   121		var c: int = clampi(ox / Q, 0, n - 1)
   122		var r: int = _row(y)
   123		for rad in range(0, maxi(n, m)):
   124			for dc in range(-rad, rad + 1):
   125				for dr in [-rad, rad] if absi(dc) != rad else range(-rad, rad + 1):
   126					var a: int = c + dc
   127					var b: int = r + int(dr)
   128					if a >= 0 and a < n and b >= 0 and b < m and grid[a + b * n] != BLOCK:
   129						var cx: int = a * Q + Q / 2
   130						return Vector2i(cx if team == 0 else w - cx, b * Q + Q / 2)
