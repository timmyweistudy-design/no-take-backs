    87	func _on_start() -> void:
    88		_fp_abort_drag()   # 第六輪：拖曳中按開戰／準備好，拖曳作廢（Codex 實作第 2 輪 #2）
    89		if mode == Mode.DUEL and tp != null and not tp.done():
    90			if not tp.end_turn():
    91				_toast(L.t("err_cantskip"), true)
    92			else:
    93				sfx.play("turn")
    94			return
    95		if mode == Mode.DUEL and tp == null and blind_phase < 2:
    96			if _cur_army().count() == 0:
    97				_toast(L.t("err_empty"), true)
    98				return
    99			if rules != null and not _cur_army().has_combat():
   100				_toast(L.t("err_need_combat"), true)
   101				return
   102			blind_phase += 1
   103			sfx.play("turn")
   104			return
   105		if armies[0].count() == 0 and not _full_blocked_ok():
   106			_toast(L.t("err_empty"), true)
   107			return
   108		if rules != null and not _full_blocked_ok() and (not armies[0].has_combat() or (mode == Mode.DUEL and not armies[1].has_combat())):
   109			_toast(L.t("err_need_combat"), true)
   110			return
   111		for u in armies[0].units:   # 開戰前再驗一次（Codex 實作審查 #1）
   112			if not _allowed(int(u["type"])) and not (mode == Mode.TUTORIAL or mode == Mode.PUZZLE):
   113				_toast(L.t("code_locked"), true)
   114				return
   115		if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() > gauntlet_changes:
   116			_toast(L.t("err_changes"), true)
   117			return
   118		if mode == Mode.VS_AI and not ai_prebuilt:
   119			if _build_ai_async():
   120				return
   121			_build_ai()
   122		_on_start_go()
