extends SceneTree
## 第十三輪：主題試煉第 11～30 關量產。依規格（tools/gen/trial_specs.py）：
##   ① 用規則變形＋敵方卡池、固定種子讓 AI 組敵陣，凍結成資料 ② 走遊戲同一條路開關（_start_trial、_build_ai）
##   ③ 多起點爬山收集過關解（技能關：敵方照遊戲一樣自動施放）④ 從前緣挑三星解，訂剩餘％與花費％門檻
## godot --headless --path game --script res://tools/balance/trial_forge.gd -- --in=<規格.json> [--id=10] [--iters=600]
const Sim = preload("res://scripts/core/battle_sim.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const P = preload("res://scripts/game/puzzles.gd")
const AI = preload("res://scripts/core/ai_army.gd")
const RS = preload("res://scripts/core/ruleset.gd")
const GM = preload("res://scripts/ui/screens/game_modes.gd")
const FAKE = preload("res://tests/test_base.gd")

func judge(g, spec: Array, e) -> Dictionary:
	var a = g.armies[0].copy()
	a.units = []
	for u in spec:
		a.place_xy(int(u[0]), a.world_x(int(u[1])), int(u[2]))
	if a.units.is_empty() or not a.has_combat():
		return {"won": false, "rem": 0, "spent": 0, "pct": 0, "diff": -1000000}
	var s = Sim.new(a.copy(), e.copy(), g.rules)
	if s.cmd_on:
		s.cmd_auto = [false, true]   # 和遊戲一樣：對 AI 時紅方自動放，玩家不放也要拿得到星
	s.fast = true
	s.run_to_end()
	return {"won": s.winner == 0, "rem": P.rem_pct(s.power(0), s.budget_of(0)), "spent": a.spent(), "pct": a.spent() * 100 / a.budget,
		"diff": s.power(0) - s.power(1), "real": a.units.map(func(u): return [int(u["type"]), a.world_x(int(u["x"])), int(u["y"])])}

func rand_spec(types: Array, g, r: RandomNumberGenerator) -> Array:
	var out: Array = []
	var a = g.armies[0]
	var left: int = a.budget
	for k in 30:
		var t: int = types[r.randi_range(0, types.size() - 1)]
		if D.cost(t) > left:
			continue
		out.append([t, 200 + r.randi_range(0, (a.depth - 400) / 50) * 50, 400 + r.randi_range(0, (a.fh - 800) / 50) * 50])
		left -= D.cost(t)
	return out

func mutate(sp: Array, types: Array, g, r: RandomNumberGenerator) -> Array:
	var s2: Array = sp.duplicate(true)
	var fh: int = g.armies[0].fh
	var dx: int = g.armies[0].depth - 200
	var op := r.randi_range(0, 3)
	if s2.is_empty():
		op = 3
	match op:
		0:
			var i := r.randi_range(0, s2.size() - 1)
			s2[i][1] = clampi(int(s2[i][1]) + r.randi_range(-20, 20) * 50, 200, dx)
			s2[i][2] = clampi(int(s2[i][2]) + r.randi_range(-20, 20) * 50, 300, fh - 300)
		1:
			s2[r.randi_range(0, s2.size() - 1)][0] = types[r.randi_range(0, types.size() - 1)]
		2:
			s2.remove_at(r.randi_range(0, s2.size() - 1))
		3:
			s2.append([types[r.randi_range(0, types.size() - 1)], 200 + r.randi_range(0, (dx - 200) / 50) * 50, 400 + r.randi_range(0, (fh - 800) / 50) * 50])
	return s2

func score(j: Dictionary, w: int) -> int:
	if not bool(j["won"]):
		return -10000000 + int(j["diff"]) / 10
	return 10000000 + int(j["rem"]) * (10 - w) * 10 - int(j["pct"]) * w * 10

func _init() -> void:
	var args := {}
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--") and "=" in a:
			var kv := a.substr(2).split("=", true, 1)
			args[kv[0]] = kv[1]
	var specs: Array = JSON.parse_string(FileAccess.get_file_as_string(str(args.get("in", ""))))
	var want := int(args.get("id", "-1"))
	var iters := int(args.get("iters", "600"))
	var g = load("res://scripts/ui/game_screens.gd").new()
	g.sfx = FAKE.FakeSfx.new()
	g.time = 1.0
	load("res://scripts/game/save.gd").data_locked = true
	for sp in specs:
		var i: int = int(sp["i"])
		if want >= 0 and i != want:
			continue
		var x: Dictionary = sp.duplicate(true)
		# ① 敵陣：規則變形＋敵方卡池，固定種子
		var r = g._trial_rules(i, x)
		var ep := 0
		for t in x["enemy_pool"]:
			ep |= 1 << int(t)
		r.pool[1] = ep
		var rr := RandomNumberGenerator.new()
		rr.seed = 13000 + i
		var ea = AI.build(1, r.budget_of(1), rr, -1, ep, r)["army"]
		x["enemy"] = ea.units.map(func(u): return [int(u["type"]), int(u["x"]), int(u["y"])])
		x.erase("enemy_pool")
		GM._trial_x[i] = x
		g._start_trial(i)
		g._build_ai()
		var e = g.armies[1].copy()
		var types: Array = RS.types_of(g.armies[0].pool)
		# ③ 爬山
		var found: Array = []
		var rng := RandomNumberGenerator.new()
		rng.seed = 880 + i
		for restart in 6:
			var w: int = [2, 5, 8, 0, 3, 6][restart]
			var cur: Array = rand_spec(types, g, rng)
			var cj := judge(g, cur, e)
			var cs := score(cj, w)
			for it in iters / 6:
				var c2: Array = mutate(cur, types, g, rng)
				var j2 := judge(g, c2, e)
				if bool(j2["won"]):
					found.append(j2)
				var s2 := score(j2, w)
				if s2 >= cs:
					cur = c2
					cj = j2
					cs = s2
		var out := {"i": i, "found": found.size(), "spec": x}
		if not found.is_empty():
			# ④ 前緣上挑「剩餘＋省下」最大的當三星解
			var pick: Dictionary = found[0]
			var bv := -99999
			for f in found:
				var v: int = int(f["rem"]) + (100 - int(f["pct"]))
				if v > bv:
					bv = v
					pick = f
			x["rem"] = maxi(5, int(pick["rem"]) / 5 * 5)
			x["spend"] = clampi(ceili(int(pick["spent"]) * 100.0 / g.armies[0].budget), 40, 100)
			x["best"] = pick["real"]
			out["pick"] = {"rem": pick["rem"], "pct": pick["pct"], "spent": pick["spent"]}
			out["spec"] = x
		print("TFORGE ", JSON.stringify(out))
	g.free()
	quit()
#!/usr/bin/env python3
"""第十三輪：把 trial_forge 的 TFORGE 輸出寫成 game/data/trials.json（索引 10～29）。

python3 tools/gen/trial_merge.py <tf_*.txt...>
沒找到解的關印出來、不寫入（測試會抓到缺關）。
"""
import json
import sys
from pathlib import Path

OUT = Path(__file__).resolve().parents[2] / "game/data/trials.json"
KEYS = ("i", "zh", "en", "tag_zh", "tag_en", "pool0", "budget", "depth", "type_cap", "cmd", "enemy", "rem", "spend", "best")


def main():
    res = {}
    for f in sys.argv[1:]:
        for line in open(f, encoding="utf-8", errors="ignore"):
            if line.startswith("TFORGE "):
                r = json.loads(line[7:])
                res[int(r["i"])] = r
    out, bad = [], []
    for i in sorted(res):
        r = res[i]
        if r["found"] == 0:
            bad.append(i)
            continue
        sp = r["spec"]
        d = {k: sp[k] for k in KEYS if k in sp}
        for k in ("i", "budget", "depth", "type_cap", "cmd", "rem", "spend"):
            if k in d:
                d[k] = int(d[k])
        d["enemy"] = [[int(v) for v in u] for u in d["enemy"]]
        d["best"] = [[int(v) for v in u] for u in d["best"]]
        out.append(d)
    json.dump(out, open(OUT, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    print("寫入", len(out), "關", "缺", bad)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""把量產結果併進 game/data/puzzles.json（第十三輪）。

python3 tools/gen/puzzle_merge.py <草稿.json> <FORGE 輸出檔...>
- 草稿＋forge 算出的 star2、star3、solutions、best（三星解）→ "extra"，章內依難度排序（隨機擺法過關率高的在前）。
- 舊 25 關的 "best" 從 tests/golden/star_solutions.json 帶入（提示第二、三層用）。
- 寫入章節名稱與開場小故事。
- 沒找到解、或什麼都不放就過的關卡不併，印出來。
"""
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
DATA = ROOT / "game/data/puzzles.json"
STARS = ROOT / "game/tests/golden/star_solutions.json"

CHAPTERS = [
    ("王國基礎", "Kingdom Basics",
     "公會剛開張，只招得到王國的老兵。先學會盾、弓、騎、劍、刺客怎麼互相剋。",
     "The guild has just opened and only kingdom veterans have signed up. Learn how shields, bows, horses, swords and assassins beat each other."),
    ("王國新兵", "Kingdom Recruits",
     "長槍兵、投彈兵、醫者、鼓手、狂戰士來報到了。每一位都有一招別人學不來的。",
     "Pikes, bombers, medics, drummers and berserkers report for duty. Each has one trick nobody else can do."),
    ("魔物報到", "Monsters Apply",
     "連魔物都來應徵了。牠們不懂規矩，但很好用。",
     "Even monsters want the job. They don't follow the rules, but they get results."),
    ("跨界連鎖", "Strange Partners",
     "王國兵和魔物一起上場。有些組合放在一起，會發生意想不到的事。",
     "Soldiers and monsters side by side. Some pairs do things neither could alone."),
    ("連鎖大作戰", "Chain Reactions",
     "三四種兵一起配合，敵人也開始混搭了。",
     "Three or four kinds working together, and now the enemy mixes too."),
    ("護送・死守・斬首", "Escort, Hold, Strike",
     "委託不再只是打贏：有人要保護、有時間要撐、有頭目要拿下。",
     "Contracts get specific: someone to protect, a clock to beat, a leader to take down."),
    ("地利", "Lay of the Land",
     "河、樹林、冰湖、熔岩、峽谷。地形會擋路、會拖慢、也會加速。",
     "Rivers, woods, ice, lava and canyons. Terrain blocks, slows and speeds."),
    ("限制與借力", "Less Is More",
     "兵不能多帶，或乾脆借敵人的力。",
     "Bring fewer units, or turn the enemy's tricks against them."),
    ("時序", "Timing",
     "公會發下技能卷軸。戰前寫好第幾秒放，開打後就改不了。",
     "The guild hands out skill scrolls. Write down when to cast before battle; once it starts, no changes."),
    ("宗師", "Grandmaster",
     "最後的委託，什麼都可能出現。落子無悔。",
     "The final contracts. Anything goes. No take-backs."),
]


def main():
    drafts = {d["id"]: d for d in json.load(open(sys.argv[1], encoding="utf-8"))}
    order = [d["id"] for d in json.load(open(sys.argv[1], encoding="utf-8"))]
    res = {}
    for f in sys.argv[2:]:
        for line in open(f, encoding="utf-8", errors="ignore"):
            if line.startswith("FORGE "):
                r = json.loads(line[6:])
                res[r["id"]] = r
    data = json.load(open(DATA, encoding="utf-8"))
    stars = json.load(open(STARS, encoding="utf-8"))
    for key in ("puzzles", "new_units", "fantasy_units"):
        for p in data[key]:
            if p["id"] in stars["puzzles"]:
                p["best"] = {"u": stars["puzzles"][p["id"]], "p": []}
    data["chapters"] = [{"zh": a, "en": b, "story_zh": c, "story_en": d} for a, b, c, d in CHAPTERS]
    extra, skipped = [], []
    for i in order:
        d = dict(drafts[i])
        r = res.get(i)
        if r is None or "best" not in r:
            skipped.append((i, "沒有找到解" if r else "沒有結果"))
            continue
        if r["metrics"].get("empty_ok"):
            skipped.append((i, "什麼都不放就過"))
            continue
        d["star2"] = r["star2"]
        d["star3"] = r["star3"]
        d["solutions"] = r["solutions"]
        d["best"] = r["best"]
        if "sol_plans" in r:
            d["sol_plans"] = r["sol_plans"]
        d["_m"] = {k: r["metrics"][k] for k in ("rand_pct", "kinds", "tol", "ticks") if k in r["metrics"]}
        if "hero_free_ok" in r["metrics"]:
            d["_m"]["hero_free_ok"] = r["metrics"]["hero_free_ok"]
        extra.append(d)
    # 章內依難度：隨機擺法過關率高的在前；同率照草稿順序
    pos = {i: k for k, i in enumerate(order)}
    extra.sort(key=lambda d: (d["ch"], -d["_m"].get("rand_pct", 0), pos[d["id"]]))
    data["extra"] = extra
    json.dump(data, open(DATA, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    print("併入", len(extra), "關")
    for i, why in skipped:
        print("略過", i, why)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""第十三輪：自動調殘局預算（粗跑 → 找不到解就加錢、太簡單就減錢 → 只重跑有改的）。

python3 tools/gen/puzzle_tune.py <草稿.json> <粗跑輸出資料夾> <回合數>
- 找不到解：預算 ×1.25（至少 +4）。
- 隨機擺法過關率 > 45%：預算 ×0.85（至少 -2）。
- 其他不動。每回合把草稿寫回、只跑要重算的關，結果累積在資料夾的 tune_<回合>_<分片>.txt。
需要 GODOT 環境變數；在 build/cg/game 快照上跑（不碰 game/）。
"""
import glob
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
SNAP = ROOT / "build/cg/game"


def latest(folder):
    res = {}
    files = sorted(glob.glob(str(Path(folder) / "probe_*.txt"))) + sorted(glob.glob(str(Path(folder) / "tune_*.txt")))
    files.sort(key=os.path.getmtime)
    for f in files:
        for line in open(f, encoding="utf-8", errors="ignore"):
            if line.startswith("FORGE "):
                r = json.loads(line[6:])
                res[r["id"]] = r
    return res


def main():
    draft_path, folder, rounds = sys.argv[1], sys.argv[2], int(sys.argv[3])
    godot = os.environ["GODOT"]
    for rnd in range(rounds):
        drafts = json.load(open(draft_path, encoding="utf-8"))
        res = latest(folder)
        redo = []
        for d in drafts:
            r = res.get(d["id"])
            if r is None:
                continue
            m = r["metrics"]
            if m.get("empty_ok"):
                d["budget"] = max(4, int(d["budget"] * 0.7))
                redo.append(d)
            elif "best" not in r:
                d["budget"] = max(d["budget"] + 4, int(d["budget"] * 1.25))
                redo.append(d)
            elif m.get("rand_pct", 0) > 45:
                d["budget"] = min(d["budget"] - 2, int(d["budget"] * 0.85))
                redo.append(d)
        json.dump(drafts, open(draft_path, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
        print("回合", rnd, "重算", [(d["id"], d["budget"]) for d in redo], flush=True)
        if not redo:
            break
        sub = Path(folder) / f"redo_{rnd}.json"
        json.dump(redo, open(sub, "w", encoding="utf-8"), ensure_ascii=False)
        n = min(14, len(redo))
        procs = []
        for i in range(n):
            out = open(Path(folder) / f"tune_{rnd}_{i}.txt", "w", encoding="utf-8")
            rel = os.path.relpath(sub, SNAP).replace(os.sep, "/")   # Windows 版 Godot 吃相對路徑
            procs.append(subprocess.Popen([godot, "--headless", "--path", ".", "--script", "res://tools/balance/puzzle_forge.gd", "--",
                                           f"--in={rel}", "--iters=400", "--seeds=1", f"--shard={i}", f"--shards={n}"],
                                          cwd=str(SNAP), stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT))
        for p in procs:
            p.wait()


if __name__ == "__main__":
    main()

