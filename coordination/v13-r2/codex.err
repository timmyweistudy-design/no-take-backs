   503	## 把三星解直接擺上去（固定兵留著），技能關連施放時間一起帶。
   504	func _apply_best() -> void:
   505		var pz := PZ.get_puzzle(puzzle_id)
   506		var best: Dictionary = pz.get("best", {})
   507		armies[0] = PZ.player_army(pz)
   508		for e in best.get("u", []):
   509			armies[0].place(int(e[0]), int(e[1]), int(e[2]))
   510		if not best.get("p", []).is_empty():
   511			puzzle_plan = best["p"].duplicate()
   512		puzzle_reveal = false
   513		overlay = ""
   514		_toast(L.t("ph_applied"))
   180		if state != St.PLACE or overlay != "" or not painting:
   181			return
   182		if _cur_army().team != paint_team:
   183			painting = false
   184			return
   185		var c := _cell_at(p)
   186		if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   187			_try_place(c)
