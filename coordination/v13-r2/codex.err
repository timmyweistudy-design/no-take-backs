   387	func _cell_at(p: Vector2) -> Vector2i:
   388		var q := (p - ORIGIN) / CS
   389		if q.x < 0 or q.y < 0 or q.x >= 16 or q.y >= 9:
   390			return Vector2i(-1, -1)

