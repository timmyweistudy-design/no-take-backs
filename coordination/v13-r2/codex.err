   290	## ── 雙人：輪流禁選 ──
   291	func _begin_bans(n: int) -> void:
   292		# 卡池太小時少禁幾張，至少留 3 種（Codex #6：5 種禁 2＋2 會卡死）
   293		n = mini(n, (mini(RuleSet.pool_count(rules.pool_of(0)), RuleSet.pool_count(rules.pool_of(1))) - 3) / 2)
   294		if n <= 0:
   295			_start_mode(Mode.DUEL)
   296			return
   297		ban_left = [n, n]
   298		ban_turn = 0
   299		overlay = "ban"
   300	
   301	func _ban_skip() -> void:
   302		ban_left[ban_turn] -= 1
   303		_ban_next()
   304	
   305	func _ban_next() -> void:
   306		ban_turn = 1 - ban_turn
   307		if ban_left[ban_turn] <= 0:
   308			ban_turn = 1 - ban_turn
   309		if ban_left[0] <= 0 and ban_left[1] <= 0:
   310			overlay = ""
   311			_start_mode(Mode.DUEL)
   312	
   313	func _ban(t: int) -> void:
   314		# 兩邊卡池可能不同：各自拿掉（Codex r2 #2）
   315		var np := [rules.pool_of(0) & ~(1 << t), rules.pool_of(1) & ~(1 << t)]
   316		for tm in 2:
   317			var p: int = np[tm]
   318			if not RuleSet.has_combat(p) or RuleSet.pool_count(p) < 3 or RuleSet.cheapest_combat_in(p) > rules.budget_of(tm):
   319				_toast(L.t("ban_no"), true)
   320				return
   321		rules.pool = np
   322		ban_left[ban_turn] -= 1
   323		sfx.play("k_error")
   324		_ban_next()
   325	
   326	## 第十輪 B2：雙方卡池不同時最多 20 張；超過 10 張改小格，全部留在面板內。
   327	func _ban_cell(i: int, n: int) -> Rect2:
   328		if n <= 10:
   329			return Rect2(200 + (i % 5) * 178, 196 + (i / 5) * 172, 168, 164)
   330		return Rect2(76 + (i % 7) * 162, 192 + (i / 7) * 136, 156, 130)
   275			_save()
   276			return
   277		var standard: bool = rules == null or Presets.is_standard_record(rules, kind)
   278		if free_intro:
   279			Save.data["free_intro_done"] = true
   280			free_intro = false
   281		Save.data["unlock_games"] = int(Save.data.get("unlock_games", 0)) + 1   # 只是累計場數（判斷新玩家用），不解鎖任何東西
   282		var me_won := w == 0 or (mode == Mode.DUEL and w >= 0)
   283		var stat_key := "stats" if standard else "custom_stats"
   284		var st: Dictionary = Save.data.get(stat_key, {"wins": 0, "games": 0})
   285		st["games"] = int(st.get("games", 0)) + 1
   286		if w == 0 and mode != Mode.DUEL:
   287			st["wins"] = int(st.get("wins", 0)) + 1
   288		Save.data[stat_key] = st
   289		_v8_achievements(w)   # 奇幻軍是娛樂變體，要放在「自訂規則提前返回」之前（Codex 第 3 輪）
   290		# 圖鑑老兵筆記：派這個兵種贏一場 +1（第二輪方案 R3）。第十輪 B4：自訂規則、奇幻軍也算（放在提前返回之前）
   291		var types := {}
   292		if me_won:
   293			for u in sim.units:
   294				if u.team == w:
   295					types[D.report_type(u.type)] = true
   296			CX.record_win(Save.data, types.keys())
   297		if not standard:
   298			# 自訂規則專屬成就（標準成就只看標準局）
   299			if me_won and mode == Mode.VS_AI and w == 0:
   300				if rules.budget_of(0) <= 50:
   301					_ach("CUSTOM_LOWGOLD")
   302				if rules.budget_of(0) < rules.budget_of(1):
   303					_ach("CUSTOM_UNDERDOG")
   304			if me_won and rules.unit_cap >= 36:
   305				_ach("CUSTOM_BIG")
   306			_save()
   307			return
   308		if me_won:
   309			_ach("FIRST_WIN")
   310			if sim.alive_count(w) == 1:
   311				_ach("LONE_HERO")
   312			if int(report["sus"]["max_swing_pct"]) >= 15:
   313				_ach("COMEBACK")
   314			if sim.power(w) * 100 / (sim.budget * 1000) <= 5:
   315				_ach("CLOSE_CALL")
   316			if sim.tick >= Sim.FRENZY_TICK:
   317				_ach("FRENZY_WIN")
   318			if types.size() == 5:
   319				_ach("ALL_TYPES")
   320			if int(ev_count.get("charge%d" % w, 0)) >= 5:
   321				_ach("CHARGE_5")
   322			if int(ev_count.get("backstab%d" % w, 0)) >= 3:
   323				_ach("BACKSTAB_3")
   324		if mode == Mode.VS_AI and w == 0 and difficulty == 2:
   325			_ach("HARD_WIN")
   326		if mode == Mode.DUEL and tp != null and series_over:
   327			_ach("NO_TAKEBACKS")
   328		if series_over and ((mode == Mode.DUEL and (wins == [2, 0] or wins == [0, 2])) or (mode == Mode.VS_AI and wins == [2, 0])):
   329			_ach("SWEEP")
   330		if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
   331			var stars := int(report.get("stars", 0))
   332			var ps: Dictionary = Save.data.get("puzzle_stars", {})
   333			if stars > int(ps.get(puzzle_id, 0)):
   334				ps[puzzle_id] = stars
   335			Save.data["puzzle_stars"] = ps
   336			if mode == Mode.TUTORIAL and w == 0:
   337				var idx := 0
   338				for i in PZ.tutorials().size():
   339					if PZ.tutorials()[i]["id"] == puzzle_id:
   340						idx = i
   341				Save.data["tutorial"] = maxi(int(Save.data.get("tutorial", 0)), idx + 1)
   342				if int(Save.data["tutorial"]) >= PZ.tutorials().size():
   343					_ach("TUTORIAL")
   344			if stars == 3:
   345				_ach("PUZZLE_3STAR")
   346			var all_done := true
   347			for p in PZ.puzzles():
   348				if int(ps.get(p["id"], 0)) == 0:
   349					all_done = false
   350			if all_done:
   351				_ach("PUZZLE_ALL")
   352			var cleared := 0
   353			var perfect := 0
   354			for p2 in PZ.all_puzzles():
   355				cleared += 1 if int(ps.get(p2["id"], 0)) > 0 else 0
   356				perfect += 1 if int(ps.get(p2["id"], 0)) >= 3 else 0
   357			if cleared >= 100:
   358				_ach("PUZZLE_100")   # 第十三輪
   359			if perfect >= 100:
   360				_ach("PUZZLE_ALL3")
   361		if mode == Mode.GAUNTLET:
   362			if w == 0:
   363				if gauntlet_stage >= 7:
   364					_ach("GAUNTLET")
   365					Save.data["gauntlet_best"] = 7
   366					_gauntlet_clear()
   367			else:
   368				_gauntlet_clear()
   369				Save.data["gauntlet_best"] = maxi(int(Save.data.get("gauntlet_best", 0)), gauntlet_stage - 1)
   370		_save()
   371	
