    53		_seal_pockets()
    54	
    55	## 貼牆一圈算不可走之後會隔出小死角：只留最大的連通區，其他也標成不走，
    56	## 站在死角的單位會先走到最近的主要區域。
    57	func _seal_pockets() -> void:
    58		var comp := PackedInt32Array()
    59		comp.resize(n * m)
    60		comp.fill(-1)
    61		var best_id := -1
    62		var best_n := 0
    63		var cid := 0
    64		for start in n * m:
    65			if nav[start] == 1 or comp[start] != -1:
    66				continue
    67			var stack: Array = [start]
    68			comp[start] = cid
    69			var cnt := 0
    70			while not stack.is_empty():
    71				var idx: int = stack.pop_back()
    72				cnt += 1
    73				var c: int = idx % n
    74				var r: int = idx / n
    75				for d in N8:
    76					var a: int = c + int(d[0])
    77					var b: int = r + int(d[1])
    78					if a < 0 or a >= n or b < 0 or b >= m:
    79						continue
    80					var j := a + b * n
    81					if nav[j] == 0 and comp[j] == -1:
    82						comp[j] = cid
    83						stack.append(j)
    84			if cnt > best_n:
    85				best_n = cnt
    86				best_id = cid
    87			cid += 1
    88		for k in n * m:
    89			if nav[k] == 0 and comp[k] != best_id:
    90				nav[k] = 1
