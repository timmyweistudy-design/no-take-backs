    86	static func rebind(list: Array, table: Dictionary, action: String, code: int) -> Dictionary:
    87		if (list == ACTIONS and not can_bind_key(code)) or (list == PAD_ACTIONS and not can_bind_pad(code)):
    88			return table.duplicate()
    89		var out := table.duplicate()
    90		var old := int(out.get(action, _default_of(list, action)))
    91		for a in list:
    92			if a[0] != action and int(out.get(a[0], a[1])) == code:
    93				out[a[0]] = old
    94		out[action] = code
    95		return out
