   241	## 剩餘戰力 %：和結果頁顯示同一個數字（四捨五入），畫面寫 25% 就算 25%。
   242	static func rem_pct(power: int, budget: int) -> int:
   243		return (power * 200 + budget * 1000) / (budget * 2000)
   244	
   245	## 星數：獲勝、剩 ≥star2%、花費 ≤star3，每達成一項一顆星（沒贏就是 0）。
   246	static func stars(pz: Dictionary, won: bool, rem_pct: int, spent_extra: int) -> int:
   247		if not won:
   248			return 0
   249		var s := 1
   250		if rem_pct >= int(pz["star2"]):
   251			s += 1
   252		if spent_extra <= int(pz["star3"]):
