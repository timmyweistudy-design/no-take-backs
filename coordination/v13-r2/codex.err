   105	## 玩家陣：固定兵已經擺好；預算＝固定兵花費＋可再花的錢，所以「剩餘戰力」照總投入算。
   106	static func player_army(pz: Dictionary) -> Army:
   107		var fixed_cost := 0
   108		var a := Army.new(0, 100)
   109		a.pool = (1 << D_TOTAL) - 1
   110		for f in pz["fixed"]:
   111			a.units.append({"type": int(f[0]), "col": int(f[1]), "row": int(f[2])})
   112			fixed_cost += Army.D.cost(int(f[0]))
   113		a.budget = fixed_cost + int(pz["budget"])
   114		if pz.has("cap"):
   115			a.unit_cap = pz["fixed"].size() + int(pz["cap"])   # 限隻數：可再放 cap 隻
   116		if pz.has("map"):
   117			a.terrain = rules_of(pz).terrain()   # 牆內格子不能放
   118		return a
