var fullfield := FULL_NONE
# 只是顯示用，不參與相等判定
var preset := "standard"

# ───────── 卡池工具（static，給 AI／Army 用） ─────────
static func _not_combat(t: int) -> bool:
	return not D.is_combat(t)   # 第八輪：奇襲兵也不算戰鬥兵

static func all_pool() -> int:
	return (1 << D.COUNT) - 1      # 舊 10 種。標準、AI、舊規則都看這個，不能跟著新兵變大

## 第八輪：新舊 20 種全部（只給驗證與大廳用）。
static func full_pool() -> int:
	return (1 << D.total()) - 1

## 這個卡池有沒有用到新兵。
static func has_new(p: int) -> bool:
	return p > all_pool()

static func prefix_pool(n: int) -> int:
	return (1 << clampi(n, 0, D.COUNT)) - 1
		out.append(["rr_budget", std.budget_of(0), budget_of(0)])
	if handicap:
		out.append(["rr_handicap", std.budget_of(1), budget_of(1)])
	if ticks != std.ticks:
		out.append(["rr_time", std.ticks / 20, ticks / 20])
	if unit_cap != std.unit_cap:
		out.append(["rr_cap", std.unit_cap, unit_cap])
	if type_cap != std.type_cap:
		out.append(["rr_type_cap", std.type_cap, type_cap])
	if pool_of(0) != std.pool_of(0):
		out.append(["rr_pool", pool_count(std.pool_of(0)), pool_count(pool_of(0))])
	if pool_of(1) != pool_of(0):
		out.append(["rr_ai_pool", pool_count(pool_of(0)), pool_count(pool_of(1))])
	if rounds != std.rounds:
		out.append(["rr_rounds", std.rounds, rounds])
	if place_rule != std.place_rule or (place_rule == "custom" and turns != std.turns):
		out.append(["rr_place", std.place_rule, place_rule])
	if carry != std.carry:
		out.append(["rr_carry", std.carry, carry])
	if is_sandbox():
		out.append(["rr_sandbox", 0, 1])
	if deploy != std.deploy:
		out.append(["rr_deploy", std.deploy, deploy])
	if spacing != std.spacing and deploy == "free":
		out.append(["rr_spacing", std.spacing, spacing])
	if depth != std.depth and deploy == "free" and fullfield != FULL_DUEL:   # 雙人全場不用縱深
		out.append(["rr_depth", std.depth, depth])
	if fullfield != std.fullfield:
		out.append(["rr_full", std.fullfield, fullfield])
	if cmd_on():
		out.append(["rr_cmd", 0, 1])
	return out

# ───────── 代碼 ─────────
## NTBR1.<base64url(JSON 陣列)>.<校驗 6 碼>；固定欄序、整數型別。
func to_code() -> String:
	var j := JSON.stringify(key_fields())
	var body := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
	if cmd_on():
		var j5 := JSON.stringify((key_fields() if not deploy_is_default() else key_fields() + [DEPLOYS.find(deploy), spacing, depth, fullfield]) + [map_id, map_size, 1 if vents else 0, int(cmd_mask[0]), int(cmd_mask[1]), cmd_uses, cmd_cd, cmd_power])
		var b5 := Marshalls.utf8_to_base64(j5).replace("+", "-").replace("/", "_").replace("=", "")
		return "%s.%s.%s" % [CODE_PREFIX5, b5, b5.sha256_text().substr(0, 6)]
	if not map_is_default():
		var j4 := JSON.stringify((key_fields() if not deploy_is_default() else key_fields() + [DEPLOYS.find(deploy), spacing, depth, fullfield]) + [map_id, map_size, 1 if vents else 0])
		var b4 := Marshalls.utf8_to_base64(j4).replace("+", "-").replace("/", "_").replace("=", "")
		return "%s.%s.%s" % [CODE_PREFIX4, b4, b4.sha256_text().substr(0, 6)]
	# 用到新兵一律 NTBR3（欄位同 NTBR2：21 欄）
	if has_new(int(pool[0])) or has_new(int(pool[1])) or _skills_new():
		var j3 := JSON.stringify(key_fields() if not deploy_is_default() else key_fields() + [DEPLOYS.find(deploy), spacing, depth, fullfield])
		var b3 := Marshalls.utf8_to_base64(j3).replace("+", "-").replace("/", "_").replace("=", "")
		return "%s.%s.%s" % [CODE_PREFIX3, b3, b3.sha256_text().substr(0, 6)]
extends RefCounted
## 對戰代碼（第三輪 F3）：把雙方陣型、規則版本、數值摘要編成一串，貼給朋友就能看同一場。
## 格式：NTB2.<base64url(JSON)>.<校驗 6 碼>。JSON：{a/b: 雙方陣型代碼, ba/bb: 雙方預算, r: 規則版本, d: 數值摘要}
## 規則或數值不同時仍可以播，但結果可能不同，所以解碼會回報 mismatch 讓畫面提示。

const Army = preload("res://scripts/core/army.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const RSET = preload("res://scripts/core/ruleset.gd")
## 第五輪：自訂規則的對戰代碼用 NTB3（多一欄 rules＝規則代碼）。標準規則仍輸出 NTB2，位元組和 1.3.0 相同。

## 這組規則能不能用舊格式 NTB2 重播（模擬走舊路徑、陣型在舊的人數上限內）。
static func needs_v3(rules) -> bool:
	# Codex 實作第 1 輪：卡池、人數、單種上限有任何不標準就用 NTB3，分享後規則不會遺失
	return rules != null and (not rules.sim_is_legacy() or not load("res://scripts/game/presets.gd").deploy_standard(rules))

static func encode(a0, a1, rules = null, cmds: Array = []) -> String:
	if rules != null and rules.cmd_on():
		# 第十二輪 NTB7：手動技能要連施放紀錄一起存，才播得出同一場
		var j7 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.version_of([a0, a1]), "d": D.digest_of([a0, a1]), "rules": rules.to_code(), "c": cmds})
		var body7 := Marshalls.utf8_to_base64(j7).replace("+", "-").replace("/", "_").replace("=", "")
		return "NTB7.%s.%s" % [body7, body7.sha256_text().substr(0, 6)]
	if D.uses_new([a0, a1]):
		# 第八輪：用到新兵走 NTB4（新版 NTB2／3／4 都讀；舊版讀到會回報格式不對）
		var j4 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.version_of([a0, a1]), "d": D.digest_of([a0, a1]), "rules": rules.to_code() if rules != null else ""})
		var body4 := Marshalls.utf8_to_base64(j4).replace("+", "-").replace("/", "_").replace("=", "")
		return "NTB4.%s.%s" % [body4, body4.sha256_text().substr(0, 6)]
	if needs_v3(rules):
		var j3 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest(), "rules": rules.to_code()})
		var body3 := Marshalls.utf8_to_base64(j3).replace("+", "-").replace("/", "_").replace("=", "")
		return "NTB3.%s.%s" % [body3, body3.sha256_text().substr(0, 6)]
	var j := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest()})
	var body := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
	return "NTB2.%s.%s" % [body, body.sha256_text().substr(0, 6)]

## 回傳 {ok, why, a0, a1, mismatch, rules}（NTB2 的 rules＝null＝用 1.3.0 舊判定重播）
static func decode(code: String) -> Dictionary:
	var c := code.strip_edges()
	if c.length() > 8000:
		return {"ok": false, "why": "format"}
	var parts := c.split(".")
	if parts.size() != 3 or (parts[0] != "NTB2" and parts[0] != "NTB3" and parts[0] != "NTB4" and parts[0] != "NTB7"):
		return {"ok": false, "why": "format"}
	if parts[1].sha256_text().substr(0, 6) != parts[2]:
		return {"ok": false, "why": "checksum"}
	var b64 := parts[1].replace("-", "+").replace("_", "/")
	while b64.length() % 4 != 0:
		b64 += "="
	var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
	if not j is Dictionary or not j.has("a") or not j.has("b"):
		return {"ok": false, "why": "body"}
	# 預算也編進去（Codex S5 #1：遠征敵軍超過 100 金、殘局低預算時，原本會被當成 100）
	# 第七輪 N2：外部資料先驗型，int([]) 會讓整個解碼中斷，不會回報「代碼錯誤」
	for bk in ["ba", "bb"]:
		var bv = j.get(bk, 100)
		if not (bv is int or bv is float) or float(bv) != floorf(float(bv)) or absf(float(bv)) > 1000:
			return {"ok": false, "why": "budget"}
	if not j["a"] is String or not j["b"] is String or not j.get("rules", "") is String:
		return {"ok": false, "why": "body"}
	var ba := int(j.get("ba", 100))
	var bb := int(j.get("bb", 100))
	if ba < 1 or ba > 400 or bb < 1 or bb > 400:
		return {"ok": false, "why": "budget"}
	var a0 := Army.new(0, ba)
	var a1 := Army.new(1, bb)
	var rules = null
	var cmds: Array = []
	if parts[0] == "NTB7":
		var raw_c = j.get("c", [])
		if not raw_c is Array or raw_c.size() > 200 or str(j.get("rules", "")) == "":
			return {"ok": false, "why": "body"}
		for e in raw_c:
			if not e is Array or e.size() != 3:
				return {"ok": false, "why": "body"}
			for v0 in e:
				if not (v0 is int or v0 is float) or float(v0) != floorf(float(v0)) or float(v0) < 0 or float(v0) > 100000:
					return {"ok": false, "why": "body"}
			if int(e[1]) > 1 or int(e[2]) >= 5:
				return {"ok": false, "why": "body"}
			cmds.append([int(e[0]), int(e[1]), int(e[2])])
	if parts[0] == "NTB4" or parts[0] == "NTB7":
		a0.pool = RSET.full_pool()
		a1.pool = RSET.full_pool()
	if parts[0] == "NTB3" or parts[0] == "NTB7" or (parts[0] == "NTB4" and str(j.get("rules", "")) != ""):
		var rd: Dictionary = RSET.from_code(str(j.get("rules", "")))
		if not rd["ok"]:
			return {"ok": false, "why": "rules"}
		rules = rd["rules"]
		if rules.budget_of(0) != ba or rules.budget_of(1) != bb:
			return {"ok": false, "why": "budget"}
		for pair in [[a0, 0], [a1, 1]]:
			pair[0].apply_rules(rules, pair[1])
	if a0.load_code(str(j["a"])) != "" or a1.load_code(str(j["b"])) != "":
		return {"ok": false, "why": "army"}
	var full_duel: bool = rules != null and rules.is_free() and rules.fullfield == RSET.FULL_DUEL
	if rules != null and not full_duel and (not a0.has_combat() or not a1.has_combat()):
		return {"ok": false, "why": "army"}   # NTB3（第五輪新格式）：雙方各至少 1 隻戰鬥兵；舊 NTB2 不加這條（相容）
	if rules != null and rules.is_free() and rules.fullfield != RSET.FULL_NONE:
		# 第六輪（Codex 實作第 1 輪 #3）：全場的跨隊條件——兩軍任兩隻至少隔 ENEMY_GAP；明牌全場的 AI（紅）只在自己半場
		var g2: int = RSET.ENEMY_GAP * RSET.ENEMY_GAP
		for u in a0.units:
			stop_at = 0
		elif u.type == D.CAVALRY:
			var wp := _flank_waypoint(i, t)
			if wp.x >= 0:
				if d2 <= reach * reach:
					u.nav = 2            # 敵人已在射程內：結束繞翼直接開打，不卡在未完成狀態
				else:
					dest_x = wp.x
					dest_y = wp.y
					stop_at = 0
					flanking = true
		var need_move := d2 > reach * reach or (u.type == D.ASSASSIN and u.stealth > 0) or flanking
		if u.type == D.CAVALRY and not flanking:
			# 追擊遲滯：已經在追就追到 reach−CHASE_HYST 才停；停著的要超出 reach 才起步
			need_move = cav_chase(u.chasing, d2, reach)
			stop_at = reach - D.CHASE_HYST
			u.chasing = need_move
		if need_move:
			if terrain != null and (u.type != F8.GHOST or skill_off.has("ghost")):
				var nw := _t_nav(i, u, dest_x, dest_y)
				if nw.x != dest_x or nw.y != dest_y:
					dest_x = nw.x
					dest_y = nw.y
					stop_at = 0
			var dx := dest_x - u.x
			var dy := dest_y - u.y
			var l := M.isqrt(dx * dx + dy * dy)
			var spd := u.speed
			if u.slow > 0:
				spd = spd * D.SLOW_NUM / D.SLOW_DEN
			spd = spd * u.zone / 100
			var stp := mini(spd, l - stop_at)
			if stp > 0 and l > 0:
				u.mx = dx * stp / l
				u.my = dy * stp / l
				nx[i] = u.x + u.mx
				ny[i] = u.y + u.my
		# 面向（優化方案 B1）：交戰中鎖定，只有換目標才重算；不交戰時朝移動方向
		var engage := reach + CELL
		if d2 <= engage * engage:
			new_lock[i] = t
			if u.face_lock != t:
				var f := M.unit1000(tg.x - u.x, tg.y - u.y)
				if f != Vector2i.ZERO:
