extends RefCounted
## 戰鬥核心（純邏輯、全整數、確定性）。企劃 §2.3、§2.4、§3.3；優化方案 B1、L1。
## 每 tick 固定五步：①讀快照 ②選目標＋提出移動 ③統一解碰撞 ④產生攻擊 ⑤同時結算。
## 任何一步都只讀「這一步開始前」的狀態，所以不會因為誰先算就佔便宜。
## 禁止新增浮點運算（imath.isqrt 內的浮點估計之後一定用整數修正）。
## 指紋＝每 tick 完整狀態（固定欄位、int64 小端序）串接後的 SHA-256。

const D = preload("res://scripts/core/unit_defs.gd")
const Army = preload("res://scripts/core/army.gd")
const EV = preload("res://scripts/core/events.gd")
const F8 = preload("res://scripts/core/fantasy_defs.gd")
const M = preload("res://scripts/core/imath.gd")
const CMD = preload("res://scripts/core/cmd_defs.gd")

const TPS := 20
const MAX_TICKS := D.MATCH_TICKS
const FRENZY_TICK := D.FRENZY_TICK
const CELL := 1000
const COLS := 16
const ROWS := 9
const W := COLS * CELL
const H := ROWS * CELL
const MIN_SEP := D.MIN_SEP
const EDGE := 200

class Unit:
	var id: int
	var team: int
	var type: int
	var x: int
	var y: int
	var hp: int
	var max_hp: int
	var cost: int
	var reach: int
	var speed: int
	var atk: int
	var cd_base: int
	var cd := 0                # 子刻度（×4）；平常每 tick 扣 4，狂熱扣 FRENZY_CD_RATE
	var target := -1           # 目標的索引
	var fx := 0                # 面向（長度約 1000）
	var fy := 0
	var face_lock := -1        # 面向鎖定中的目標索引（交戰中只在換目標時重算面向）
	var mx := 0                # 這一 tick 提出的移動
	var my := 0
	var cdx := 0               # 騎兵這段衝鋒的起始方向
	var cdy := 0
	var stealth := 0
	var charge := 0
	var stun := 0
	var slow := 0
	var wp_x := -1             # 騎兵繞翼途經點
	var wp_y := -1
	var wp_for := -1           # 這條繞翼路線是為了哪個目標（id）
	var nav := 0               # 繞翼導航：0 沒有／直衝、1 繞翼中、2 已完成（同一個目標不再繞）
	var chasing := false       # 騎兵追擊遲滯狀態
	var alive := true
	# ── 第四輪新兵種的狀態（舊 5 種永遠維持初值，tools/compat.gd 會檢查）──
	var hcd := 0               # 醫者補血冷卻（tick，不吃加速）
	var aura := 0              # 這一 tick 是否在鼓手光環內（1／0）
	var breach := 0            # 被狂戰士破陣的剩餘 tick（盾兵、長槍兵）
	var bmode := 0             # 投彈兵這一 tick 的模式：0 無、1 丟彈、2 敲人
	var heal_done := 0         # 醫者實際補進去的總量（結果頁用）
	var drum_cover := 0        # 鼓手：累計「鼓舞到的友軍 × tick」（結果頁用，不含自己）
	var follow := -1           # 支援兵這一 tick 跟隨的友軍索引（-1＝重心或沒有）
	var slot := 0              # 部署格（以自己隊伍視角：列×16＋欄），平手規則用，鏡像不變
	var dmg_dealt := 0
	var dmg_taken := 0
	var kills := 0
	# ── 第八輪（舊場次維持初值，也不進舊指紋）
	var dormant := false       # 還沒生出來的預留單位
	var summon := false        # 戰鬥中生出來的
	var parent := -1           # 預留給誰（索引）
	var sub := 0               # 第幾個子單位
	var raised := false        # 屍體已被復活
	var hidden := false        # 寶箱怪偽裝中
	# ── 第十二輪手動技能（沒開技能時維持初值，也不進指紋）
	var shield := 0
	var shield_t := 0
	var haste_t := 0
	var bite := false          # 下一擊是現身咬
	var exploded := false      # 爆爆羊炸過了
	var link := -1             # 巫毒綁定的目標（索引）
	var link_wait := 0         # 重綁倒數
	var skill_cd := 0          # 大招冷卻（tick）
	var windup := 0            # 大招前搖（tick）
	var used := false          # 每場一次的大招用掉了
	var guard := 0             # 時停減傷剩餘 tick
	var zone := 100            # 這一 tick 的移速百分比（毒圈、碎石區）
	var pull_x := 0            # 被吸塵貓拉的每 tick 位移
	var pull_y := 0
	var pull_t := 0

var units: Array[Unit] = []    # 依 id 排序
var tick := 0
var budget := 100
var budgets := [100, 100]      # 第五輪：兩邊各自的預算（judge 1 時兩格都等於 budget，畫面算比例才一致）
var judge := 1                 # 第五輪：1＝1.3.0 舊判定（只看藍方預算）；2＝讓子時的比例判定
var max_ticks := MAX_TICKS     # 第五輪：一局 tick 數、狂熱時間表改成每場參數（標準值＝1.3.0 常數）
var frenzy_at := FRENZY_TICK
var attr_step := 100
var rules = null               # 第五輪：這一場凍結的規則（null＝標準）
var free := false              # 第六輪：自由部署（起始座標不在格子上、編號依座標排序）
var power_log2: PackedInt64Array = PackedInt64Array()  # 第五輪：每 tick 兩方戰力（藍、紅交錯），戰力走勢圖用
# 第五輪沙盒（R3）：每場一份，存在這個實例上（不改全域常數，同時跑兩場不同規則不會互相污染）
var skill_off := {}            # 關掉的技能 → true
var atk_pct: Array = []        # 每種兵的攻擊倍率（％）：波及、敲人、補血這些獨立常數也照這個比例
var finished := false
var winner := -2               # -2 進行中；-1 平手；0／1 勝方
var reason := ""
var fingerprint := ""          # 結束時的 SHA-256（十六進位）
var events: Array = []         # 這一 tick 的事件（給畫面演出用，不影響計算）
var frenzy := false
var rally := [false, false]    # 這一 tick 哪一隊在「背水」（畫面提示用；計算用的是第④步當下的值）
var power_log: PackedInt64Array = PackedInt64Array()   # 每 tick 的（藍戰力−紅戰力），懸念指標用
var _hash := HashingContext.new()
var _last_rank := 99          # 上一次 _choose_target 選中目標的優先級（1＝嘲諷）
var _was_stealth := {}         # 刺客上一 tick 是否潛行（現形事件用）
var _was_rally := [false, false]          # 上一 tick 哪一隊在背水（背水開／關事件用）
var v8 := false                # 這一場用到第八輪新兵
var fw := W                    # V9：場地大小（標準＝舊常數，舊場次完全相同）
var fh := H
var terrain = null             # V9：地形（null＝平原，舊路徑不碰）
var _nav_wp := {}              # V9：單位索引 → 導航途經點（每 4 tick 重算）
var zones: Array = []          # 碎石區：[x, y, 到期 tick]
var _pending_blast: Array = [] # 半路被打死、下一 tick 才炸的爆爆羊（索引）
var fast := false              # 平衡工具用：不算每 tick 指紋（結果完全一樣，只是沒有指紋）

## rules：第五輪 Ruleset（可省略）。省略或是舊路徑規則時，雜湊位元組、判定都和 1.3.0 完全相同。
# ── 第十二輪手動技能 ──
var cmd_on := false
var cmd_mask := [0, 0]
var cmd_cd := 0
var cmd_power := 100
var cmd_left := [[], []]         # 每隊每種還能用幾次
var cmd_ready := [[], []]        # 每隊每種第幾 tick 起能再用
var cmd_pending: Array = []      # 玩家按了、下一 tick 生效：[隊, 技能]
var cmd_log: Array = []          # 實際施放：[tick, 隊, 技能]；重播靠它
var cmd_script := {}             # 重播用：tick → [[隊, 技能]…]
var cmd_scripted := false
var cmd_auto := [false, false]   # 哪一隊由 AI 決定
var cmd_ai_every := 20
var _cmd_dmg := PackedInt64Array()

func _init(army0, army1, p_rules = null) -> void:
	budget = army0.budget
	budgets = [budget, budget]
	var legacy: bool = p_rules == null or p_rules.sim_is_legacy()
	if not legacy:
		rules = p_rules.copy()
				n += 1
		for e in ma:
			if not seen.has(e):
				n += 1
		return n
	var a := {}
	var b := {}
	for u in orig.units:
		a["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
	for u in now.units:
		b["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
	var gone := 0
	var added := 0
	for k in a:
		if not b.has(k) or b[k] != a[k]:
			gone += 1
	for k in b:
		if not a.has(k) or a[k] != b[k]:
			added += 1
	return maxi(gone, added)

func _rv_try(edit: Callable) -> void:
	var before = rv_army.copy()
	edit.call()
	if review_changes(rv_orig, rv_army) > 1:
		rv_army = before
		_toast(L.t("rv_one"), true)
		return
	_rv_dirty()

func _rv_cell(c: Vector2i) -> void:
	if rv_sel.x >= 0 and rv_army.index_at(rv_sel.x, rv_sel.y) != -1 and rv_army.index_at(c.x, c.y) == -1:
		var from := rv_sel
		_rv_try(func(): rv_army.move(from.x, from.y, c.x, c.y))
		rv_sel = c
		return
	rv_sel = c

## 第六輪：自由陣型覆盤——點小戰場：點到兵就選它；選了之後點空地就搬過去。
func _rv_free_click(w: Vector2i) -> void:
	var hit: int = rv_army.index_near(w.x, w.y, 450)
	if hit >= 0:
		rv_fsel = hit
		return
	if rv_fsel < 0:
		return
	var trial = rv_army.copy()
	if not trial.move_xy(rv_fsel, trial.world_x(Army.quant(trial.own_x(w.x))), Army.quant(w.y)):
		_toast(L.t("err_zone"), true)
		return
	if review_changes(rv_orig, trial) > 1:
		_toast(L.t("rv_one"), true)
		return
	rv_army = trial
	_rv_dirty()

func _rv_free_set_type(t: int) -> void:
	if rv_fsel < 0 or rv_fsel >= rv_army.units.size():
		return
	var trial = rv_army.copy()
	var u: Dictionary = trial.units[rv_fsel]
	var p := Vector2i(int(u["x"]), int(u["y"]))
	trial.units.remove_at(rv_fsel)
	if t >= 0:
		trial.guard_combat = false
		if trial.check_place_xy(t, p.x, p.y) != "":
			_toast(L.t("rv_cant", [L.t("unit_%d" % t)]), true)
			return
		trial.units.insert(rv_fsel, {"type": t, "x": p.x, "y": p.y, "eid": u.get("eid", -1)})
	if review_changes(rv_orig, trial) > 1:
		_toast(L.t("rv_one"), true)
		return
	rv_army = trial
	if t < 0:
		rv_fsel = -1
	_rv_dirty()

func _rv_set_type(t: int) -> void:
	if rv_orig.deploy == "free":
		_rv_free_set_type(t)
		return
	if rv_sel.x < 0:
		return
	# 在副本上換，買不起或不合法就保留原兵並提示（Codex S5 #3：原本會變成直接刪兵）
	var c := rv_sel
	var trial = rv_army.copy()
	trial.remove_at(c.x, c.y)
	if t >= 0:
		var why: String = trial.check_place(t, c.x, c.y)
		if why != "":
			_toast(L.t("rv_cant", [L.t("unit_%d" % t)]), true)
			return
		trial.place(t, c.x, c.y)
	if review_changes(rv_orig, trial) > 1:
		_toast(L.t("rv_one"), true)
		return
	rv_army = trial
	_rv_dirty()

## 改了什麼（給畫面顯示）：例如「弓箭手 → 劍士（第 3 列第 5 欄）」
func review_desc() -> String:
	if rv_orig.deploy == "free":
		for u in rv_orig.units:
			var e := int(u.get("eid", -1))
			var now = null
			for v in rv_army.units:
				if int(v.get("eid", -2)) == e:
					now = v
			if now == null:
				return L.t("rv_f_removed", [L.t("unit_%d" % int(u["type"]))])
			if int(now["type"]) != int(u["type"]):
				return L.t("rv_f_swapped", [L.t("unit_%d" % int(u["type"])), L.t("unit_%d" % int(now["type"]))])
			if int(now["x"]) != int(u["x"]) or int(now["y"]) != int(u["y"]):
				return L.t("rv_f_moved", [L.t("unit_%d" % int(u["type"])), Vector2(int(now["x"]) - int(u["x"]), int(now["y"]) - int(u["y"])).length() / 1000.0])
		return ""
	for u in rv_orig.units:
		var i: int = rv_army.index_at(u["col"], u["row"])
		if i == -1:
			# 被移走或拿掉
			for v in rv_army.units:
				if rv_orig.index_at(v["col"], v["row"]) == -1 and int(v["type"]) == int(u["type"]):
					return L.t("rv_moved", [L.t("unit_%d" % int(u["type"])), int(u["row"]) + 1, int(u["col"]) + 1, int(v["row"]) + 1, int(v["col"]) + 1])
			return L.t("rv_removed", [L.t("unit_%d" % int(u["type"])), int(u["row"]) + 1, int(u["col"]) + 1])
		if int(rv_army.units[i]["type"]) != int(u["type"]):
			return L.t("rv_swapped", [L.t("unit_%d" % int(u["type"])), L.t("unit_%d" % int(rv_army.units[i]["type"])), int(u["row"]) + 1, int(u["col"]) + 1])
	for v in rv_army.units:
		if rv_orig.index_at(v["col"], v["row"]) == -1:
			return L.t("rv_added", [L.t("unit_%d" % int(v["type"])), int(v["row"]) + 1, int(v["col"]) + 1])
	return ""

## 重算「如果」：同一個對手、改過的陣型，用確定性模擬直接跑到結束。
static func review_run(a0, a1, p_rules = null, cmds: Array = []) -> Dictionary:
	var s = Sim.new(a0.copy(), a1.copy(), p_rules)
	if s.cmd_on:
		s.cmd_play(cmds)
	s.fast = true
	s.run_to_end()
	var rem := roundi(s.power(s.winner) * 100.0 / (s.budget_of(s.winner) * 1000)) if s.winner >= 0 else 0
	return {"winner": s.winner, "rem": rem, "log": s.power_log, "log2": s.power_log2, "b": [s.budget_of(0), s.budget_of(1)], "ticks": s.tick}

## 第七輪 M3：覆盤重算開背景執行緒（模擬是純計算），畫面不卡；算的時候按鈕不能再按（防重入）。
var rv_thread: Thread = null
var rv_gen := 0          # 陣型改一次加一；算完時世代不同就丟掉（Codex r1：舊陣型的結果不能配新陣型）
var rv_thread_gen := 0

func _rv_dirty() -> void:
	rv_result = {}
	rv_gen += 1

func _rv_recalc() -> void:
	if rv_thread != null:
		return
	if DisplayServer.get_name() == "headless" or shot_dir != "":
		rv_result = review_run(rv_army, rv_enemy, battle_rules, last_cmds)
		return
	var a: Variant = rv_army.copy()
	var e: Variant = rv_enemy.copy()
	var r: Variant = battle_rules.copy() if battle_rules != null else null
	rv_thread_gen = rv_gen
	rv_thread = Thread.new()
	var lg: Array = last_cmds.duplicate(true)
	rv_thread.start(func(): return review_run(a, e, r, lg))

func _rv_poll() -> void:
	if rv_thread != null and not rv_thread.is_alive():
		var res: Dictionary = rv_thread.wait_to_finish()
		rv_thread = null
		if rv_thread_gen == rv_gen:
			rv_result = res

func _rv_play() -> void:
	rv_last = [rv_army.copy(), rv_enemy.copy()]
	_replay_snapshot()
	replay_snap["overlay"] = "review"
	replay_marks = []
	overlay = ""
	_begin_battle(rv_army.copy(), rv_enemy.copy(), "review")

