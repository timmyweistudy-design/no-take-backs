		return   # 烘腳底圈時又重建了：交給新的那次
	await ensure(base)
	if g0 != _gen:
		return
	await _bake_turn(cb)

func _bake_turn(cb: bool) -> void:
	var g0 := _gen
	var painter := _TurnPainter.new()
	painter.cb = cb
	var n := TURN_TYPES.size() * 2 * TURN_C.size()
	var vp := _viewport(Vector2i(COLS * CELL, int(ceil(float(n) / COLS)) * CELL), painter)
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	var img := vp.get_texture().get_image()
	vp.queue_free()
	img = await _post(img, TURN_C.size())
	if g0 != _gen or (1 if cb else 0) != ready_cb:
		return
	turn_tex = ImageTexture.create_from_image(img)
	for k in TURN_TYPES.size():
extends RefCounted
## V1.1 D2：每日挑戰＋每週突變。純函式，不碰畫面（遊戲、測試共用）。
## 不改模擬：只用現有規則參數（預算、隻數、每種上限、卡池、地圖、縱深、局長、雙方手動技能）＋AI 用固定種子組敵陣。
## 日期用 UTC 日數，跨時區同一天同一題。紀錄鍵＝日數＋VER：AI 或這份產生器一改就升 VER（測試 test_daily_v11 釘住幾天的敵陣，改了會紅）。

const VER := 1
const MUTATORS := 8
const KEEP_DAYS := 10          # 存檔只留最近幾天的最佳紀錄
const CMD = preload("res://scripts/core/cmd_defs.gd")
const Presets = preload("res://scripts/game/presets.gd")
const MapDefs = preload("res://scripts/core/map_defs.gd")
const AI = preload("res://scripts/core/ai_army.gd")

static func today() -> int:
	return int(Time.get_unix_time_from_system()) / 86400

## 這一天的題目規格。mut＝這週的突變（每 7 天換一個），map／style 每天換。
static func spec(day: int) -> Dictionary:
	var mut := posmod(day / 7, MUTATORS)
	var map_id := 3 if mut == 3 else posmod(day * 5 + 1, 6)
	return {"day": day, "key": "%d-v%d" % [day, VER], "mut": mut, "map": map_id, "style": posmod(day * 7 + 3, 5),
		"level": 1, "seed": 90000 + posmod(day * 2654435761, 1000003)}

static func pool_of(types: Array) -> int:
	var p := 0
	for t in types:
		p |= 1 << int(t)
	return p

## 把突變套到一組（已經是自由部署、單局的）規則上。r＝RuleSet。
static func apply(r, sp: Dictionary) -> void:
	r.map_id = int(sp["map"])
	r.map_size = 1
	r.ai_style = int(sp["style"])
	r.ai_level = int(sp["level"])
	r.ai_pool_same = false
	r.rounds = 1
	r.preset = "custom"
	var kingdom := (1 << 10) - 1
	var fantasy := ((1 << 20) - 1) & ~kingdom
	var pool := kingdom
	match int(sp["mut"]):
		0:   # 貼臉肉搏：近戰卡池、最深縱深、60 秒
			pool = pool_of([0, 1, 3, 4, 5, 7, 8, 9])
			r.depth = 7500
			r.ticks = 1200
		1:   # 精兵演武：只能 8 隻、每種 1 隻、高預算
			r.unit_cap = 8
			r.type_cap = 1
			r.budget = [140, 140]
		2:   # 人海戰術：40 隻、只有便宜的兵
			pool = pool_of([0, 1, 2, 5, 8])
			r.unit_cap = 40
		3:   # 禁魔死鬥：冰原、不開技能（map 已在 spec 固定）
			pass
		4:   # 百家爭鳴：每種 1 隻、預算 150
			r.type_cap = 1
			r.budget = [150, 150]
		5:   # 閃電決戰：60 秒、雙方技能全開（護盾、戰吼、隕石）
			r.ticks = 1200
			var m5 := (1 << CMD.AEGIS) | (1 << CMD.WARCRY) | (1 << CMD.METEOR)
			r.cmd_mask = [m5, m5]
		6:   # 孤軍深入：最深縱深、低預算、每種最多 2 隻
			r.depth = 7500
			r.budget = [70, 70]
			r.type_cap = 2
		7:   # 神仙打架：奇幻卡池、高預算、隻數少、技能全開
			pool = fantasy
			r.budget = [150, 150]
			r.unit_cap = 12
			var m7 := (1 << CMD.AEGIS) | (1 << CMD.HEAL) | (1 << CMD.METEOR)
			r.cmd_mask = [m7, m7]
	r.pool = [pool, pool]

## 成績比較：剩餘戰力高的好，一樣就花得少的好。rec＝[剩餘%, 花費]。
static func better(a: Array, b: Array) -> bool:
	if b.is_empty():
		return true
	return int(a[0]) > int(b[0]) or (int(a[0]) == int(b[0]) and int(a[1]) < int(b[1]))

## 記一場（贏了才記）。回傳 true＝新紀錄。best＝存檔的 daily_best（會被修改、只留最近 KEEP_DAYS 天）。
static func record(best: Dictionary, sp: Dictionary, rem: int, spent: int) -> bool:
	var k: String = sp["key"]
	var cur: Array = best.get(k, [])
	var nw := better([rem, spent], cur)
	if nw:
		best[k] = [rem, spent]
	var keys: Array = best.keys()
	keys.sort_custom(func(a, b): return int(str(a).get_slice("-", 0)) > int(str(b).get_slice("-", 0)))
	for i in range(KEEP_DAYS, keys.size()):
extends RefCounted
## 困難 AI（第四輪）：真的「讀你上一局」。
## 第 1 局沒有資訊 → 用原型模板組（和普通 AI 同一套，不會比普通弱）。
## 第 2 局起 → 準備幾個候選陣型（反制庫裡最接近的那筆、兩套模板陣、會讀對方的落子 AI 陣），
## 各拿去和你上一局的陣型模擬一場，挑打得最好的。只看你「上一局」公開過的陣型，不偷看這一局。
## 遊戲（game_screens._hard_ai）和反制庫驗證（tools/balance/make_counter_lib.gd）共用這一個函式。
## 第三輪的做法（查不到反制就退回落子 AI）在第四輪新模板加入後，對驗證池反而比普通 AI 弱（73.0% vs 74.0%），所以改成這樣。

const D = preload("res://scripts/core/unit_defs.gd")
const Army = preload("res://scripts/core/army.gd")
const Sim = preload("res://scripts/core/battle_sim.gd")
const AI = preload("res://scripts/core/ai_army.gd")
const AIT = preload("res://scripts/core/ai_turns.gd")
const F = preload("res://scripts/core/formations.gd")
const RS = preload("res://scripts/core/ruleset.gd")

## known：玩家上一局的兵（藍方座標）；entries：反制庫；回傳紅方陣型。
## pool：紅方卡池遮罩（-1＝全部）；rules：第五輪 Ruleset（null＝標準）。
## 反制庫只在「規則和標準一樣」時用（第五輪 §3.2）；大軍或長局時少一個候選（效能探測：40＋40、150 秒一場可達數秒）。
static func build(known: Array, entries: Array, rng: RandomNumberGenerator, pool := -1, rules = null) -> Army:
	if pool < 0:
		pool = RS.all_pool()
	var bud: int = 100 if rules == null else rules.budget_of(1)
	var cands: Array = []
	cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
	if known.is_empty():
		return cands[0]
	var heavy: bool = rules != null and (rules.unit_cap > 24 or rules.ticks > 1800)
	if not heavy:
		cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
	var full := AIT.build_full(1, rng, 2, known, pool, rules)
	cands.append(full)
	if rules == null or _standard_like(rules):
		var lib := pick_counter(entries, known, pool)
		if lib != null:
			cands.append(lib)
	var me := Army.new(0, 100 if rules == null else rules.budget_of(0))
	if rules != null and rules.is_free():
		me.deploy = "free"   # 第六輪：上一局是自由陣型，照原座標模擬
	for u in known:
		if u.has("x"):
			me.units.append({"type": int(u["type"]), "x": int(u["x"]), "y": int(u["y"])})
		elif me.deploy == "free":
			me.units.append({"type": int(u["type"]), "x": int(u["col"]) * 1000 + 500, "y": int(u["row"]) * 1000 + 500})
		else:
			me.units.append({"type": int(u["type"]), "col": int(u["col"]), "row": int(u["row"])})
	var best: Army = cands[0]
	var bs := -(1 << 40)
	var seen := {}   # V1.1 E5：一樣的候選陣型只算一次（分數一定相同，後到的又不會取代，結果不變）
	for c in cands:
		var ck: String = c.to_code()
		if seen.has(ck):
			continue
		seen[ck] = true
		var s = Sim.new(me.copy(), c.copy(), rules)
		s.fast = true
		s.cmd_auto = [false, true]     # 第十二輪：評估時紅方照實戰放技能（Codex v12-r1 #5）
		s.run_to_end()
		# 讓子局用各自預算的比例評分（Codex 實作第 1 輪）；標準局算式不變
		var sc: int = (1000000 + s.power(1)) if s.winner == 1 else (s.power(1) - s.power(0))
		if s.judge == 2:
			sc = (1000000 + s.power_permille(1)) if s.winner == 1 else (s.power_permille(1) - s.power_permille(0))
		if sc > bs:
			bs = sc
			best = c
	return best

## 反制庫：組成最接近玩家陣型的原型的反制（距離 ≤40）；用到未開放兵種的不算。
