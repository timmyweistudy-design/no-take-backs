   551			var lsz: int = tz("B")
   552			if two:
   553				lab = balance_two_lines(lab)
   554				# 兩行時字級取字級表裡第二行字形下緣（5＋2.53×字級）還在色條上方 2px 的最大一級（Antigravity 實作第 3 輪：平衡後一行變短，fit 不會縮）
   555				lsz = tz("C")
   556				for c in [tz("B"), tz("S"), tz("C")]:
   557					if 5.0 + 2.53 * c <= h - 11.0 and _width(lab, c, true) <= tw:
   558						lsz = c
   559						break
   560			_ink_mode = on_paper
   561			_text(r.position + Vector2(tx, 5 if two else 8), lab, lsz, Color.WHITE, true, true, tw)
   562			_ink_mode = false
