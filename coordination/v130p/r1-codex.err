   287	## V1.2 D1：烘好的整頁再跑一次後處理 shader（外輪廓＋頂亮底暗）。
   288	func _post_tex(tex: Texture2D, size: Vector2i, per: int) -> Image:
   289		var tr := TextureRect.new()
   290		tr.texture = tex
   291		tr.size = Vector2(size)
   292		var mat := ShaderMaterial.new()
   293		mat.shader = load("res://shaders/unit_bake.gdshader")
   294		mat.set_shader_parameter("cell", float(CELL))
   295		mat.set_shader_parameter("per", float(per))
   296		mat.set_shader_parameter("cols", float(COLS))
   297		mat.set_shader_parameter("sh_amt", float(Art.WASH[clampi(int(Art.paint[2]), 0, 2)]))   # V1.4 #15 漬洗
   298		mat.set_shader_parameter("hi_amt", float(Art.DRY[clampi(int(Art.paint[3]), 0, 2)]))    # 乾掃
   299		tr.material = mat
   300		var vp := _viewport(size, tr)
   301		await RenderingServer.frame_post_draw
   302		await RenderingServer.frame_post_draw
   303		var out := vp.get_texture().get_image()
   304		vp.queue_free()
   305		return out
