     1	#!/usr/bin/env python3
     2	"""1.3.0 方案盤點（使用者第 10 點「文字在格子裡面要置中對齊」）：讀 dev_main --geom-dump 寫的 geom.jsonl，
     3	量每段「在格子裡」的字和格子中心的偏移。
     4	- 按鈕標籤：字形框中心 vs 按鈕框中心（水平、垂直）。
     5	- 方塊裡的字（九宮格方塊、沒有按鈕的格子）：只看單行、整段落在一個方塊內、而且方塊不大（寬 ≤ 420、高 ≤ 120，像格子不像面板）。
     6	門檻：水平偏移 > max(3px, 4% 格寬) 或垂直偏移 > max(3px, 12% 格高) 算不置中。刻意靠左的列（字從格子左邊 ≤ 24px 開始、而且右邊留很多）另外標「靠左」，不算錯，列給人看。
     7	用法：python3 tools/gen/center_audit.py <截圖夾> [輸出.md]"""
     8	import json, sys, os
     9	
    10	def inside(g, b, pad=2):
    11	    return g[0] >= b[0] - pad and g[1] >= b[1] - pad and g[0] + g[2] <= b[0] + b[2] + pad and g[1] + g[3] <= b[1] + b[3] + pad
    12	
    13	def off(g, b):
    14	    return (g[0] + g[2] / 2) - (b[0] + b[2] / 2), (g[1] + g[3] / 2) - (b[1] + b[3] / 2)
    15	
    16	def main():
    17	    d = sys.argv[1]
    18	    rows = []
    19	    stats = {"btn": 0, "btn_bad": 0, "box": 0, "box_bad": 0, "box_left": 0}
    20	    for line in open(os.path.join(d, "geom.jsonl"), encoding="utf-8"):
    21	        j = json.loads(line)
    22	        # 同一個框裡有兩段以上的字＝卡片（標題＋星、頭像＋價錢），排版本來就不是置中；只量「一格一段字」
    23	        def key(r): return tuple(round(v) for v in r)
    24	        cnt = {}
    25	        for t in j["texts"]:
    26	            if t.get("field"):
    27	                continue
    28	            if t.get("own"):
    29	                cnt[key(t["own"])] = cnt.get(key(t["own"]), 0) + 1
    30	            else:
    31	                for b in j["boxes"]:
    32	                    if inside(t["g"], b):
    33	                        cnt[key(b)] = cnt.get(key(b), 0) + 1
    34	        for t in j["texts"]:
    35	            if t.get("field"):
    36	                continue
    37	            g = t["g"]
    38	            if t.get("own"):
    39	                b = t["own"]
    40	                kind = "btn"
    41	            else:
    42	                cand = [b for b in j["boxes"] if inside(g, b) and b[2] <= 420 and b[3] <= 120]
    43	                if not cand:
    44	                    continue
    45	                b = min(cand, key=lambda r: r[2] * r[3])
    46	                kind = "box"
    47	            if cnt.get(key(b), 0) > 1:
    48	                stats["card"] = stats.get("card", 0) + 1
    49	                continue
    50	            stats[kind] += 1
    51	            dx, dy = off(g, b)
    52	            tx = max(3.0, b[2] * 0.04)
    53	            ty = max(3.0, b[3] * 0.12)
    54	            left = kind == "box" and g[0] - b[0] <= 24 and (b[0] + b[2]) - (g[0] + g[2]) > 40
    55	            if left:
    56	                stats["box_left"] += 1
    57	                rows.append((j["shot"], kind + "/靠左", t["s"], dx, dy, b))
    58	                continue
    59	            if abs(dx) > tx or abs(dy) > ty:
    60	                stats[kind + "_bad"] += 1
    61	                rows.append((j["shot"], kind, t["s"], dx, dy, b))
    62	    out = ["# 格子內文字置中盤點：" + d, "",
    63	           "按鈕標籤 %d 段、不置中 %d；方塊內單行字 %d 段、不置中 %d、刻意靠左 %d；卡片（一框多段字，不量）%d 段" % (stats["btn"], stats["btn_bad"], stats["box"], stats["box_bad"], stats["box_left"], stats.get("card", 0)), "",
    64	           "| 畫面 | 類型 | 字 | 水平偏移 | 垂直偏移 | 格子 [x,y,w,h] |", "|---|---|---|---|---|---|"]
    65	    for r in sorted(rows, key=lambda r: (r[1].endswith("靠左"), -abs(r[3]) - abs(r[4]))):
    66	        out.append("| %s | %s | %s | %+.1f | %+.1f | %s |" % (r[0], r[1], r[2].replace("|", "／")[:28], r[3], r[4], [round(v) for v in r[5]]))
    67	    txt = "\n".join(out) + "\n"
    68	    if len(sys.argv) > 2:
    69	        open(sys.argv[2], "w", encoding="utf-8").write(txt)
    70	    print(out[2])
    71	
    72	if __name__ == "__main__":
    73	    main()
   174	
   175	## 設定、無障礙、輸入
   176	- 設定七頁（畫面、介面、聲音、操作、戰場與觀戰、無障礙、資料）：`_settings_rows`；列位置 `_settings_row_y`。無障礙頁三個一鍵預設（可疊加、可撤回）。資料頁：設定碼 `NTS1.`（匯入先預覽）、進度備份 `user://backup/`（留 10 份，同秒加流水號）、還原（確認框、`Save.restorable` 驗身分與版本、唯讀存檔不還原）、分項清除（先自動備份，備份失敗不清）。首次啟動三個問題（`first_done`；老玩家自動略過）。多項一起改用 `Save.set_settings`（只寫一次）＋`_apply_all_settings`。
   177	- 新設定鍵與合法值：`Save.DEFAULT_SETTINGS`、`Save.ENUMS`；新安裝畫面震動 25%、閃白 50%，老玩家照原本開關。提示停留可「手動關」（`toast_mult` 0）。
   178	- 設定：速度表 `SPEEDS`（0.25～8）、死區觸發＝死區＋25%、修改標記與單項／整頁恢復預設（`SET_KEYS`）、預設套用前預覽（舊→新）、擺兵方式 `place_mode`（只點選：不連續塗、點一下自己的兵拿掉）、全螢幕 10 秒自動還原（`_guard_fs` 也管匯入／恢復／預設）、戰鬥中生效時機、還原與清除先寫檔（`_commit_data`）。
   179	- 無障礙：按住確認（`hold_confirm`，0.6 秒）、文字放大鏡（`magnify`，只跟滑鼠）。
   180	- 觸控：長按 0.5 秒＝右鍵（覆蓋層內不觸發）、雙指／觸控板捏合縮放戰場 1～2 倍；Deck 實機清單 `docs/release/deck-checklist.md`。
   181	- **V1.0.0**：無障礙對照表 `docs/accessibility.md`（GAG 基本／中級逐條）。
   182	- **1.1.0**：設定「操作」頁「掌機建議」一鍵（30 fps、字級 125%、只點選擺兵；可撤回）。PS 手把用正確的 ○△。色覺模擬工具 `tools/gen/cb_sim.py`（結果寫在 `docs/accessibility.md`）。
   183	
   184	## 語言
   185	- 本地化前置：`L.field(資料, 後綴)`、`L.pick`、`LANGS`／`SUFFIX`；加語言看 `docs/localization.md`。
   186	- 語言：繁中、英文、簡中（OpenCC 轉換＋用語修正）、日文（Codex 翻譯）；簡中與日文未經母語校對（設定說明欄寫明）。字型：繁中源泉圓體 TW、簡中 Resource Han Rounded CN、日文源泉圓體 JP（各自子集 `fontchars.py`）；日文行首禁則；程式內二元陣列走 `data/l10n_extra.csv`；翻譯流程 `tools/gen/l10n_extract.py` → Codex → `l10n_build.py`（原文改過會擋舊譯稿）。
   187	
   188	## 聲音
   189	- 聲音匯流排 Music／SFX／UI／Ambience（都送 Master，最後時刻低通掛 Master）；換曲 0.6 秒交叉淡入淡出。
   190	- 聲音：OpenGameArt CC0 配樂 3 首（`music_title`／`music_place`／`music_battle`，Ogg，執行時設循環）、音效 47 個（`名稱__2` 變體隨機、不連抽）；`tools/gen/import_audio.py`（`build/venv-audio`）。戰鬥曲是錄音單軌，狂熱同曲 1.08 倍音高（舊合成三分軌已移除）。

