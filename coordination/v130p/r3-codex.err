     1	extends SceneTree
     2	## 100 組隨機陣型的左右交換逐 tick 比對（N1 驗收）。godot --headless --path game --script res://tools/mirror_100.gd
     3	const AI = preload("res://scripts/core/ai_army.gd")
     4	const MC = preload("res://scripts/core/mirror_check.gd")
     5	func _init() -> void:
     6		var rng := RandomNumberGenerator.new()
     7		var bad := 0
     8		var sh := [0, 1]
     9		for a in OS.get_cmdline_user_args():
    10			if a.begins_with("--shard="):
    11				sh = [int(a.substr(8).split("/")[0]), int(a.substr(8).split("/")[1])]
    12		for i in 100:
    13			if i % int(sh[1]) != int(sh[0]):
    14				continue
    15			rng.seed = 100003 * i + 17
    16			var why: String = MC.check(AI.build(0, 100, rng)["army"], AI.build(1, 100, rng)["army"])
    17			if why != "":
    18				bad += 1
    19				print("case ", i, ": ", why)
    20		print("MIRROR100 %d/100 一致" % (100 - bad))   # 分片時 100 是全部案例數，只比自己那片
    21		quit(1 if bad > 0 else 0)
