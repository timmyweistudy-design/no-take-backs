        if best["fit_holdout"] > 0.65:
            warns.append(f"搜尋到保留池勝率 {round(best['fit_holdout']*100)}% 的陣型：要找至少兩種反制")

    if "countersearch" in rows:
        CS = [r for r in rows["countersearch"] if "fit" in r]
        good = {}
        for r in CS:
            if r["fit"] >= 0.6:
