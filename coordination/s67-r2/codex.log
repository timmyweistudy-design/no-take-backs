+func _process_cmds() -> int:
+	var done := 0
+	_update_gen()
+	var q := _cmds
+	_cmds = []
+	for c in q:
+		if c["gen"] != _gen:
+			# 畫面已經換了：丟掉。但「放開滑鼠」一定要清掉拖曳／塗兵狀態（Codex S1 #2）
+			if c["kind"] == "mb" and not c["data"]["pressed"]:
+				_mb_release_cleanup()
+			continue
+		if c["kind"] == "click":
+			done += _do_click(c["data"])
+		elif c["kind"] == "mb":
+			# 滑鼠按鍵（擺放、拖曳、移除）也走同一個佇列，和鍵盤選兵的先後順序一致（Codex S1 #2）
+			_mb_cmd(c["data"])
+			done += 1
+		elif c["kind"] == "paint":
+			_paint_cmd(c["data"])
+		elif c["kind"] == "key":
+			_key(int(c["data"]))
+			done += 1
+		_update_gen()
+	return done
+
+
+## 點擊：只對這個畫面世代畫出來的按鈕有效。回傳執行了幾個。
+func _do_click(p: Vector2) -> int:
+	if _btns_gen != _gen:
+		return 0
+	for i in _btns.size():
+		var b: Dictionary = _btns[i]
+		if b["r"].has_point(p):
+			if b["en"]:
+				_focus = i
+				if sfx != null:
+					sfx.play("ui_click")
+				b["cb"].call()
+				return 1
+			return 0
+	return 0
