#!/usr/bin/env python3
"""平衡工具 2.0 報表：合併 balance.sh 各分片的 JSONL，檢查紅線，寫 report.md 與 summary.json。
用法：balance_report.py <資料夾> [總秒數]
結束碼：0＝紅線全過；1＝有紅線失敗；2＝資料錯誤（零筆、數值摘要不一致）。
紅線（優化方案 M）：
  - 剋制五角形 10/10（matrix：剋的一方左右各打一次都要贏）
  - 碾壓局（勝方剩 >50%）< 20%
  - 戰鬥秒數中位數 35～75
  - 勝方剩餘戰力中位數 ≤ 30%
警示（列入調查，不算失敗）：
  - 先手或後手勝率 > 55%
  - 搜尋到保留池勝率 > 65% 的陣型
  - 鎖定時間比中位數 < 0.4（垃圾時間太長）
"""
import json, sys, glob, os, statistics as st

NAMES = ["劍士", "盾兵", "弓箭手", "騎兵", "刺客"]
BEATS = {0: [4, 1], 1: [3, 2], 2: [0, 4], 3: [2, 0], 4: [1, 3]}

def load(folder):
    rows = {}
    for f in sorted(glob.glob(os.path.join(folder, "*.jsonl"))):
        key = os.path.basename(f).rsplit("_", 1)[0]
        for line in open(f, encoding="utf-8"):
            line = line.strip()
            if line:
                rows.setdefault(key, []).append(json.loads(line))
    return rows

def pct(a, b):
    return 0 if b == 0 else round(100 * a / b)

def wilson(k, n, z=1.96):
    """比例的 95% 信賴區間（Wilson），回傳 (低%, 高%)。第三輪 B1：每個勝率都附區間。"""
    if n == 0:
        return (0, 0)
    p = k / n
    d = 1 + z * z / n
    c = p + z * z / (2 * n)
    h = z * ((p * (1 - p) / n + z * z / (4 * n * n)) ** 0.5)
    return (round(100 * (c - h) / d), round(100 * (c + h) / d))

def ci(k, n):
    lo, hi = wilson(k, n)
    return f"{pct(k, n)}%（95% 區間 {lo}～{hi}%）"

def main():
    folder = sys.argv[1]
    secs = sys.argv[2] if len(sys.argv) > 2 else "?"
    rows = load(folder)
    total = sum(len(v) for v in rows.values())
    if total == 0:
        print("✗ 零筆結果"); sys.exit(2)
    # 完整性（Codex N1-r1 #6）：每個模式的筆數要對、不能有重複鍵；依鍵排序
    man_path = os.path.join(folder, "manifest.json")
    if not os.path.exists(man_path):
        print("✗ 沒有 manifest.json，無法確認資料完整"); sys.exit(2)
    man = json.load(open(man_path))
    if not isinstance(man.get("modes"), list) or not man["modes"] or not isinstance(man.get("shards"), int) or man["shards"] <= 0:
        print("✗ manifest.json 不合法"); sys.exit(2)
    shards = man["shards"]
    allowed = {"matrix", "league", "valleague", "turns:cap10", "turns:snake5", "turns:snake5c", "search", "counter", "countersearch"}
    def ok_mode(m):
        if m in allowed:
            return True
        if m.startswith("turns:") and "@" in m:   # turns:<規則>@<AI 等級>
            r, lv = m[6:].split("@", 1)
            return f"turns:{r}" in allowed and lv in ("0", "1", "2")
        return False
    bad_modes = [m for m in man["modes"] if not ok_mode(m)]
    if bad_modes:
        print(f"✗ manifest 有不合法的模式：{bad_modes}"); sys.exit(2)
    # 分片檔完整性（Codex N1-r3 #6）：每個模式 0～shards-1 片都要在，也不能有 manifest 以外的檔案
