## 戰場、單位、特效、戰鬥 HUD、最後時刻鏡頭（演出層：不影響戰鬥結果）。


func _on_skip() -> void:
	while not view.finished:
		_sim_step(false)
	result_delay = 9.0


func _battle_process(delta: float) -> void:
	if hitstop > 0:
		hitstop -= delta
		return
	var rate := speed
	if slow_left > 0:
		rate *= 0.5
		slow_left -= delta
	accum += delta * rate
	while accum >= 0.05 and not view.finished:
		accum -= 0.05
		_sim_step(true)
