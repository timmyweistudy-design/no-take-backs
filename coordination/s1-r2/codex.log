     2	# 版面檢查（第三輪 T4）：用 Windows 版 Godot 跑截圖模式，兩種語言 × 三種字級，彙整 layout.jsonl。
     3	# 用法：tools/layout_check.sh <Godot 執行檔> <輸出資料夾（WSL 路徑）>
     4	set -uo pipefail
     5	cd "$(dirname "$0")/.."
     6	EXE="$1"; OUT="$2"
     7	rm -rf "$OUT"; mkdir -p "$OUT"
     8	for lang in zh_TW en; do
     9	  for sc in 100 125 150; do
    10	    d="$OUT/${lang}_${sc}"; mkdir -p "$d"
    11	    timeout 300 "$EXE" --path "$(wslpath -w .)" --resolution 1280x800 -- --shot="$(wslpath -w "$d")" --shot-lang=$lang --shot-text=$sc --layout-check > "$d/run.log" 2>&1
    12	  done
    13	done
    14	python3 - "$OUT" <<'PY'
    15	import json,sys,glob,os
    16	out=sys.argv[1]; total=0; rows=[]
    17	for f in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    18	    for line in open(f,encoding='utf-8'):
    19	        d=json.loads(line); total+=len(d['violations']); rows.append(d)
    20	by={}
    21	for d in rows: by.setdefault((d['lang'],d['scale']),[]).append(d['median_size'])
    22	print('LAYOUT 截圖 %d 張、違規 %d' % (len(rows), total))
    23	for d in rows:
    24	    for v in d['violations']: print('  %s %s %d%%：%s' % (d['shot'], d['lang'], d['scale'], v))
    25	for lang in ['zh_TW','en']:
    26	    if (lang,100) in by and (lang,150) in by:
    27	        a=sorted(by[(lang,100)]); b=sorted(by[(lang,150)])
    28	        print('  %s 中位字級 100%%=%s 150%%=%s' % (lang, a[len(a)//2], b[len(b)//2]))
    29	sys.exit(1 if total else 0)
