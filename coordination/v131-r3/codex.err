    61	const M_HURT := 1             # 受擊／暈眩：>< 眼
    62	const M_SPARKLE := 2          # 騎兵衝鋒蓄滿：亮晶晶眼＋槍尖金光
    63	const M_BROWS := 4            # 狂熱：眉毛內傾
