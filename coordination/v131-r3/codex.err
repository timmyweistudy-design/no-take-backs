   161	func _post(img: Image, per := FRAMES_PER) -> Image:
   162		var sh_path := "res://shaders/unit_bake.gdshader"
   163		if not ResourceLoader.exists(sh_path) or bool(Save.s("plain_ui")):
   164			return img
   165		var tr := TextureRect.new()
   166		tr.texture = ImageTexture.create_from_image(img)
   167		tr.size = Vector2(img.get_width(), img.get_height())
   168		var mat := ShaderMaterial.new()
   169		mat.shader = load(sh_path)
   170		mat.set_shader_parameter("cell", float(CELL))
   171		mat.set_shader_parameter("per", float(per))
   172		mat.set_shader_parameter("cols", float(COLS))
   173		tr.material = mat
   174		var vp := _viewport(Vector2i(img.get_width(), img.get_height()), tr)
   175		await RenderingServer.frame_post_draw
   176		await RenderingServer.frame_post_draw
   177		var out := vp.get_texture().get_image()
   178		vp.queue_free()
   179		return out
