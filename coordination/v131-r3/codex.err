     1	extends RefCounted
     2	## 由 art.gd 拆出（V9 P1，行為不變）
     3	## 程式繪製的 Q 版角色與戰場（優化方案 G：美術先用程式能做到的先做）。
     4	## 全部是向量圖形＋抗鋸齒，沒有外部角色素材。辨識靠三層視覺錨點：腳底隊伍標記、上半身／武器剪影、動態特效。
     5	
     6	const D = preload("res://scripts/core/unit_defs.gd")
     7	const Gait = preload("res://scripts/ui/units/gait.gd")
     8	
     9	const OUT := Color("#2b2236")   # V1.2 D1：內線色（較淡）；外輪廓改在圖集烘焙時用隊伍墨色加粗（shaders/unit_bake.gdshader）
    10	const INNER_W := 1.2              # V1.2 D1：部件內線寬（原 1.6／3.2／+3）
    11	const SKIN := Color("#ffe1c4")
    12	const BLUSH := Color(1.0, 0.55, 0.6, 0.55)
    13	const STEEL := Color("#c9d3e3")
    14	const STEEL_D := Color("#8c97ab")
    15	const WOOD := Color("#b7814e")
    16	const GOLD := Color("#ffd166")
    17	
    18	# 隊伍色（一般／色盲高對比）
    19	## 呼叫端目前的畫布轉換（鏡頭）。角色繪製要「疊加」在它上面，不能覆蓋掉（手感輪 2 抓到的錯位 bug）。
    20	static var base := Transform2D.IDENTITY
    21	static var _xf := Transform2D.IDENTITY   # 目前角色的畫布轉換（腳底座標），上半身另外疊 Gait.body_xf
    22	static var _team_now := 0   # 目前在畫哪一隊（分隊小披風用）
    23	
    24	# V1.3 A1b：轉身中間影格（只在烘焙轉身頁時用；平常 turn_c＝1，下面的函式都不動作，畫出來和以前一模一樣）。
    25	# 不是整張等比夾扁：身體依兵種只縮一部分（圓的頭、史萊姆不縮），往前伸的武器跟著透視縮短，
    26	# 近側（z＞0，畫在身體前面）的武器／盾往後移、遠側的往前移，前後遮擋關係就會改變，看起來是轉身不是紙片翻面。
    27	static var turn_c := 1.0     # cos θ：1＝正側面，越小越轉向鏡頭
    28	static var turn_s := 0.0     # sin θ
    29	static var _xf0 := Transform2D.IDENTITY   # 轉身時沒縮過的角色轉換
    30	static var _b_now := Transform2D.IDENTITY # 目前的上半身轉換（_push_body 設）
    31	static var _cur_xf := Transform2D.IDENTITY # 目前畫布轉換（部件之間切換用；_eyes 畫完要還原成這個）
    32	const TURN_FWD := {3: 0.6, 13: 0.0, 19: 0.3}   # 騎兵的馬最窄約 0.58（Antigravity v130-impl1：太窄像插在木棍上）   # 身體跟著縮的比例（沒列＝0.4）：騎兵的馬是長的、史萊姆是圓的
    33	
    34	static func turn_body_w(type: int) -> float:
    35		return lerpf(1.0, turn_c, float(TURN_FWD.get(type, 0.4)))
    36	
    37	## 接下來畫的部件：z＝側向深度（＋近側），fwd＝沿前後方向的長度比例（1＝整個跟著透視縮短，0＝不縮）。
    38	static func _part(ci: CanvasItem, z: float, fwd: float) -> void:
    39		if turn_c >= 1.0:
    40			return
    41		_cur_xf = _xf0 * _b_now * Transform2D(0.0, Vector2(lerpf(1.0, turn_c, fwd), 1.0), 0.0, Vector2(-z * turn_s, 0.0))
    42		ci.draw_set_transform_matrix(_cur_xf)
    43	
    44	## 回到身體的轉換。
    45	static func _part_end(ci: CanvasItem) -> void:
    46		if turn_c >= 1.0:
    47			return
    48		_cur_xf = _xf * _b_now
    49		ci.draw_set_transform_matrix(_cur_xf)
