#!/usr/bin/env bash
# 版面檢查（第三輪 T4）：用 Windows 版 Godot 跑截圖模式，兩種語言 × 三種字級，彙整 layout.jsonl。
# 用法：tools/layout_check.sh <Godot 執行檔> <輸出資料夾（WSL 路徑）>
set -uo pipefail
cd "$(dirname "$0")/.."
EXE="$1"; OUT="$2"
# 第七輪 I5：只准清自己產生的輸出夾（有記號檔），或空資料夾；其他一律拒絕，不再無條件 rm -rf
MARK=".ntb-layout-output"
if [ -d "$OUT" ] && [ -n "$(ls -A "$OUT" 2>/dev/null)" ]; then
  if [ ! -f "$OUT/$MARK" ]; then
    echo "LAYOUT FAIL：$OUT 已有內容但不是版面檢查的輸出夾，不會刪除。請換一個新資料夾。"; exit 2
  fi
  rm -rf "$OUT"
fi
mkdir -p "$OUT"; : > "$OUT/$MARK"
# Windows／WSL／Linux 都能跑：有 wslpath 才轉路徑
winpath() { if command -v wslpath >/dev/null 2>&1 && [[ "$EXE" == *.exe ]]; then wslpath -w "$1"; else printf '%s' "$1"; fi; }
# WSL 的 timeout 只殺得到包裝程序，Windows 上的視窗會留著繼續跑：逾時要連它一起關（只關這次輸出夾的）
kill_win() { if [[ "$EXE" == *.exe ]]; then powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name like 'Godot%'\" | Where-Object { \$_.CommandLine -like '*--shot=$(winpath "$1")*' } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force }" >/dev/null 2>&1; fi; }
# 第九輪 P0：LAYOUT_QUICK=1 只跑中文 100%＋英文 150%（最容易出事的兩組）＋一組狀態；里程碑跑 8 組
# V1.2.1：第三欄是狀態（plain＝簡化介面、cb＝色盲、pad＝手把焦點），固定在這組全部截圖
# 完整：兩語 × 三字級，加上四種狀態（簡化、色盲、手把、停用）各在兩語的 150%（最容易擠）各跑一次＝14 組
COMBOS="zh_TW:100 zh_TW:125 zh_TW:150 en:100 en:125 en:150 zh_TW:150:plain en:150:plain zh_TW:150:cb en:150:cb zh_TW:150:pad en:150:pad zh_TW:150:dis en:150:dis"
[ "${LAYOUT_QUICK:-0}" = "1" ] && COMBOS="zh_TW:100 en:150 en:150:plain,cb,pad zh_TW:150:dis"
for combo in $COMBOS; do
  IFS=: read -r lang sc st <<< "$combo"
  {
    d="$OUT/${lang}_${sc}${st:+_${st//,/-}}"; mkdir -p "$d"
    timeout 600 "$EXE" --path "$(winpath .)" --resolution 1280x800 -- --shot="$(winpath "$d")" --shot-lang=$lang --shot-text=$sc ${st:+--shot-state=$st} --layout-check > "$d/run.log" 2>&1 \
      || { echo "LAYOUT FAIL：$lang $sc% 截圖程式 exit 非 0"; kill_win "$d"; exit 1; }
    grep -E "SCRIPT ERROR|Parse Error" "$d/run.log" >/dev/null && { echo "LAYOUT FAIL：$lang $sc% 有腳本錯誤"; exit 1; }
    grep -q "PADWALK OK" "$d/run.log" || { echo "LAYOUT FAIL：$lang $sc% 手把流程：$(grep PADWALK "$d/run.log" | cut -c1-400)"; exit 1; }
  }
done
EXPECT=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | wc -l)
NAMES=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | sed 's/_snap("//; s/")//' | sort | tr '\n' ',')
python3 - "$OUT" "$EXPECT" "$NAMES" <<'PY'
import json,sys,glob,os
out=sys.argv[1]; expect=int(sys.argv[2]); names=set(x for x in sys.argv[3].split(',') if x); total=0; rows=[]
for f in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    for line in open(f,encoding='utf-8'):
        d=json.loads(line); total+=len(d['violations']); rows.append(d)
warns=sum(len(d.get('warnings',[])) for d in rows)
# 第五輪：每組都要剛好是 dev_main.gd 列出的那些畫面（不能用重複畫面湊張數）
for f2 in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    got=[json.loads(l)['shot'] for l in open(f2,encoding='utf-8')]
    if sorted(got)!=sorted(names) or len(set(got))!=len(got):
        print('LAYOUT FAIL：%s 的畫面集合不對（少了 %s、多了 %s）' % (f2, sorted(names-set(got)), sorted(set(got)-names))); sys.exit(1)
by={}
for d in rows: by.setdefault((d['lang'],d['scale']),[]).append(d['median_size'])
print('LAYOUT 截圖 %d 張、違規 %d' % (len(rows), total))
for d in rows:
    for v in d['violations']: print('  %s %s %d%%：%s' % (d['shot'], d['lang'], d['scale'], v))
for lang in ['zh_TW','en']:
    if (lang,100) in by and (lang,150) in by:
        a=sorted(by[(lang,100)]); b=sorted(by[(lang,150)])
        print('  %s 中位字級 100%%=%s 150%%=%s' % (lang, a[len(a)//2], b[len(b)//2]))
runs=glob.glob(os.path.join(out,'*','layout.jsonl'))
want=len(runs) if os.environ.get('LAYOUT_QUICK')=='1' else 14
if len(runs)!=want or len(rows)!=want*expect:
    print('LAYOUT FAIL：應有 14 組 × %d 張，實得 %d 組、%d 張（截圖沒跑完也算失敗）' % (expect, len(runs), len(rows))); sys.exit(1)
sys.exit(1 if total else 0)
PY
     1	extends SceneTree
     2	## 第五輪 P0：效能探測。人數上限、一局時間要依這裡的數字定，不憑感覺。
     3	## 情境：標準 24＋24、大軍 32／40／48 隻、支援兵密集、困難 AI 候選模擬。
     4	## 模擬直接塞兵（繞過 MAX_UNITS），只量模擬本身；畫面 fps 另用截圖模式量。
     5	## 用法：godot --headless --path game --script res://tools/perf_probe.gd
     6	const Sim = preload("res://scripts/core/battle_sim.gd")
     7	const Army = preload("res://scripts/core/army.gd")
     8	const D = preload("res://scripts/core/unit_defs.gd")
     9	const AI = preload("res://scripts/core/ai_army.gd")
    10	const HardAI = preload("res://scripts/core/hard_ai.gd")
    11	const RSET = preload("res://scripts/core/ruleset.gd")
    12	
    13	static func fill(team: int, n: int, rng: RandomNumberGenerator, types: Array) -> Army:
    14		var a := Army.new(team, 1000)
    15		var cells: Array = []
    16		for c in Army.ZONE:
    17			for r in Army.ROWS:
    18				cells.append(Vector2i(c if team == 0 else Army.COLS - 1 - c, r))
    19		for i in range(cells.size() - 1, 0, -1):
    20			var j := rng.randi_range(0, i)
    21			var t = cells[i]; cells[i] = cells[j]; cells[j] = t
    22		for i in mini(n, cells.size()):
    23			a.units.append({"type": types[rng.randi_range(0, types.size() - 1)], "col": cells[i].x, "row": cells[i].y})
    24		return a
    25	
    26	static func bench(n: int, types: Array, reps: int, rules = null) -> Dictionary:
    27		var tot := 0
    28		var worst := 0
    29		var ticks := 0
    30		for k in reps:
    31			var rng := RandomNumberGenerator.new()
    32			rng.seed = 777 + k * 31 + n
    33			var s = Sim.new(fill(0, n, rng, types), fill(1, n, rng, types), rules)
    34			s.fast = true
    35			var t0 := Time.get_ticks_usec()
    36			s.run_to_end()
    37			var us := Time.get_ticks_usec() - t0
    38			tot += us
    39			worst = maxi(worst, us)
    40			ticks += s.tick
    41		return {"n": n, "avg_ms": tot / reps / 1000, "worst_ms": worst / 1000, "avg_ticks": ticks / reps, "us_per_tick": tot / maxi(1, ticks)}
    42	
    43	func _init() -> void:
    44		var all: Array = []
    45		for t in D.COUNT:
    46			all.append(t)
    47		var out := {}
    48		if "--fantasy" in OS.get_cmdline_user_args():
    49			# 第八輪：一局每邊最多 10 種；最壞是大量生兵與大招
    50			var fant: Array = []
    51			for t8 in range(D.COUNT, D.total()):
    52				fant.append(t8)
    53			out["fantasy_24"] = bench(24, fant, 6)
    54			out["fantasy_40"] = bench(40, fant, 6)
    55			out["fantasy_summon_40"] = bench(40, [13, 13, 17, 13, 17, D.SWORD], 6)
    56			out["fantasy_spore_40"] = bench(40, [10, 10, D.SWORD, D.ARCHER], 6)
    57			out["fantasy_cat_40"] = bench(40, [18, 18, 19, 16, D.SWORD], 6)
    58			out["old_support_40"] = bench(40, [D.SWORD, D.SHIELD, 7, 8, 7, 8], 6)
    59			print("PERF ", JSON.stringify(out))
    60			quit()
    61			return
    62		for n in [24, 32, 40, 48]:
    63			out["mixed_%d" % n] = bench(n, all, 6)
    64		out["support_40"] = bench(40, [D.SWORD, D.SHIELD, 7, 8, 7, 8], 6)   # 醫者 7、鼓手 8 密集
    65		out["archers_40"] = bench(40, [D.ARCHER, D.ARCHER, D.SHIELD], 6)
    66		# 困難 AI：候選陣型各和玩家上一局模擬一場（標準 24 隻）
    67		var rng := RandomNumberGenerator.new()
    68		rng.seed = 99
    69		var known: Array = AI.build(0, 100, rng)["army"].units
    70		var t0 := Time.get_ticks_usec()
