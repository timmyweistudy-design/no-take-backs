    52	
    53	# ── 三段式攻擊（第二輪方案 R5）──
    54	# atk（0～1）＝一次攻擊動作的進度：0～ATK_WINDUP 前搖、ATK_WINDUP～ATK_STRIKE 揮擊（命中就在 ATK_WINDUP 那一刻）、之後後搖。
    55	const ATK_WINDUP := 0.3125
