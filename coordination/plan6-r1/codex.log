    60	static func pick_counter(entries: Array, known: Array, pool: int) -> Army:
    61		if entries.is_empty():
    62			return null
    63		var mine := D.zeros()
    64		for u in known:
    65			mine[int(u["type"])] += D.cost(int(u["type"]))
    66		var best = null
    67		var bd := 1 << 30
    68		for e in entries:
    69			var pc: Array = e["proto_comp"]
    70			var d := 0
    71			for k in mine.size():
    72				d += absi((int(pc[k]) if k < pc.size() else 0) - int(mine[k]))
