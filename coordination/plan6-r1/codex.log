   615		var a := {}
   616		for u in gauntlet_prev:
   617			a["%d,%d,%d" % [u["type"], u["col"], u["row"]]] = true
   618		var d := 0
   619		for u in armies[0].units:
   620			if not a.has("%d,%d,%d" % [u["type"], u["col"], u["row"]]):
   621				d += 1
   622		return d
