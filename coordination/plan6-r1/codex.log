  1785				return "重複格"
  1786			seen[Vector2i(c, row)] = true
  1787			if (r.pool_of(team) >> t) & 1 == 0:
  1788				return "不在卡池 %d" % t
  1789			per[t] = int(per.get(t, 0)) + 1
  1790			if r.type_cap > 0 and per[t] > r.type_cap:
  1791				return "超過單種上限"
  1792			spent += D.cost(t)
