   889		return dx * tg.fx + dy * tg.fy < 0
   890	
   891	func _same_dir(ax: int, ay: int, bx: int, by: int) -> bool:
   892		# 夾角小於約 25 度
   893		var dot := ax * bx + ay * by
   894		if dot <= 0:
   895			return false
   896		var la := ax * ax + ay * ay
   897		var lb := bx * bx + by * by
   898		return dot * dot * 100 >= la * lb * 82
