    16	static func encode(a0, a1, rules = null) -> String:
    17		if needs_v3(rules):
    18			var j3 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest(), "rules": rules.to_code()})
    19			var body3 := Marshalls.utf8_to_base64(j3).replace("+", "-").replace("/", "_").replace("=", "")
    20			return "NTB3.%s.%s" % [body3, body3.sha256_text().substr(0, 6)]
    21		var j := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest()})
    22		var body := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
    23		return "NTB2.%s.%s" % [body, body.sha256_text().substr(0, 6)]
