   162			if u.alive and u.team == team:
   163				c += 1
   164		return c
   165	
   166	## 剩餘戰力＝Σ兵價×剩血×1000÷滿血（企劃 §2.4）。
   167	func power(team: int) -> int:
   168		var p := 0
   169		for u in units:
   170			if u.alive and u.team == team:
   171				p += u.cost * u.hp * 1000 / u.max_hp
   172		return p
   173	
   174	## 第五輪：這一隊的預算（judge 1 時兩隊都回傳藍方預算，和 1.3.0 畫面一致）。
   175	func budget_of(team: int) -> int:
   176		return int(budgets[team])
   177	
   178	## 剩餘戰力占自己預算的千分比（0～1000）。
   179	func power_permille(team: int) -> int:
   180		return power(team) / maxi(1, budget_of(team))
   181	
   182	## 第五輪：第 t 個 tick 的戰力差，換算成「每 1000 單位預算」的尺度（讓子時用各自預算的比例；畫面、時間軸用）。
   183	func diff_permille(t: int) -> int:
   184		if judge == 2 and 2 * t + 1 < power_log2.size():
   185			return power_log2[2 * t] * 1000 / budgets[0] - power_log2[2 * t + 1] * 1000 / budgets[1]
   186		return power_log[t] * 1000 / maxi(1, budget) if t < power_log.size() else 0
   187	
   188	func run_to_end() -> void:
   189		while not finished:
   190			step()
   300						u.nav = 2            # 敵人已在射程內：結束繞翼直接開打，不卡在未完成狀態
   301					else:
   302						dest_x = wp.x
   303						dest_y = wp.y
   304						stop_at = 0
   305						flanking = true
   306			var need_move := d2 > reach * reach or (u.type == D.ASSASSIN and u.stealth > 0) or flanking
   307			if u.type == D.CAVALRY and not flanking:
   308				# 追擊遲滯：已經在追就追到 reach−CHASE_HYST 才停；停著的要超出 reach 才起步
   309				need_move = cav_chase(u.chasing, d2, reach)
   310				stop_at = reach - D.CHASE_HYST
   311				u.chasing = need_move
   312			if need_move:
   313				var dx := dest_x - u.x
   314				var dy := dest_y - u.y
   315				var l := M.isqrt(dx * dx + dy * dy)
   316				var spd := u.speed
   317				if u.slow > 0:
   318					spd = spd * D.SLOW_NUM / D.SLOW_DEN
   319				var stp := mini(spd, l - stop_at)
   320				if stp > 0 and l > 0:
   321					u.mx = dx * stp / l
   322					u.my = dy * stp / l
   323					nx[i] = u.x + u.mx
   324					ny[i] = u.y + u.my
