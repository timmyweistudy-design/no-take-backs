   574	func _check_place(t: int, c: Vector2i) -> String:
   575		if _locked():
   576			return L.t("both_done")
   577		if not _allowed(t):
   578			return L.t("err_type")
   579		if mode == Mode.DUEL and tp != null:
   580			var why: String = tp.check_place(t, c.x, c.y)
   581			return _err_key(why)
   582		if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() + 1 > gauntlet_changes:
   583			return L.t("err_changes")
   584		return _err_key(_cur_army().check_place(t, c.x, c.y))
