   102					var r := fight(pool[i], pool[j]) if side == 0 else fight(pool[j], pool[i])
   103					if side == 1:
   104						r["res"] = -r["res"]
   105					r["mode"] = "sealleague" if sealed else ("valleague" if val else "league"); r["a"] = i; r["b"] = j; r["k"] = k; r["side"] = side; r["comp"] = F.composition(pool[i])
