   293	## NTBR1.<base64url(JSON 陣列)>.<校驗 6 碼>；固定欄序、整數型別。
   294	func to_code() -> String:
   295		var j := JSON.stringify(key_fields())
   296		var body := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
