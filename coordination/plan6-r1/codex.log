    56			a.units.append({"type": int(f[0]), "col": int(f[1]), "row": int(f[2])})
    57			fixed_cost += Army.D.cost(int(f[0]))
    58		a.budget = fixed_cost + int(pz["budget"])
    59		return a
    60	
    61	static func is_fixed(pz: Dictionary, col: int, row: int) -> bool:
    62		for f in pz["fixed"]:
    63			if int(f[1]) == col and int(f[2]) == row:
    64				return true
    65		return false
    66	
    67	## 星數：1 勝；2 勝方剩 ≥star2%；3 花費 ≤star3。
    68	static func stars(pz: Dictionary, won: bool, rem_pct: int, spent_extra: int) -> int:
    69		if not won:
    70			return 0
    71		var s := 1
    72		if rem_pct >= int(pz["star2"]):
    73			s += 1
    74		if spent_extra <= int(pz["star3"]):
    75			s += 1
    76		return s
    77	
    78	
    79	## 這關的「主角」兵種（殘局選單小頭像用）：標準解裡最常出現的兵種；同數取編號小的。
    80	static func hero_type(pz: Dictionary) -> int:
    81		var cnt := D.zeros()
    82		for sol in pz.get("solutions", []):
    83			for e in sol:
    84				cnt[int(e[0])] += 1
    85		var best := int(pz["allowed"][0]) if not pz.get("allowed", []).is_empty() else 0
    86		for t in D.COUNT:
    87			if cnt[t] > cnt[best]:
    88				best = t
    89		return best
     1	extends SceneTree
     2	## 確定性金標準（第三輪 T2）。
     3	## 產生：godot --headless --path game --script res://tools/golden.gd -- --make
     4	##   用固定種子讓 AI 擺 1000 組陣，存成陣型代碼＋每 100 tick 的狀態雜湊＋最終指紋，寫到 tests/golden/golden.json，並記下規則版本與數值摘要。
     5	##   只有「刻意改了戰鬥規則」才重產，而且要在 commit 裡說明。
     6	## 檢查：godot --headless --path game --script res://tools/golden.gd [-- --n=1000]
     7	##   逐場重算比對，回報第一個分歧的場次與 tick；任何分歧 exit 1。規則版本或數值摘要不同也 exit 1（提示要不要重產）。
     8	const Sim = preload("res://scripts/core/battle_sim.gd")
     9	const Army = preload("res://scripts/core/army.gd")
    10	const AI = preload("res://scripts/core/ai_army.gd")
    11	const D = preload("res://scripts/core/unit_defs.gd")
    12	const F = preload("res://scripts/core/formations.gd")
    13	const PATH := "res://tests/golden/golden.json"
    14	const CHECK_EVERY := 100
    15	const LOCK := "res://tests/golden/golden.lock"   # 第五輪 P0：基準檔的 sha256＋案例數，防止金標準被換成縮水或空的版本
    16	const CASES := 1000
    17	
    18	static func state_sig(s) -> String:
    19		var parts := PackedStringArray()
    20		parts.append(str(s.tick))
    21		for u in s.units:
    22			parts.append("%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d" % [u.id, u.x, u.y, u.hp, 1 if u.alive else 0, u.target, u.stun,
    23				u.stealth, u.charge, u.slow, u.cd, u.fx, u.fy, u.nav, 1 if u.chasing else 0, u.kills, u.dmg_dealt, u.dmg_taken,
    24				u.hcd, u.aura, u.breach, u.bmode, u.heal_done, u.follow])   # 第四輪 N0a：補擊殺與傷害統計；1.3.0：新兵種狀態   # 第四輪 N0a：補擊殺與傷害統計
    25		return ",".join(parts).sha256_text().substr(0, 16)
    26	
    27	static func run_case(c0: String, c1: String, fast: bool) -> Dictionary:
    28		var a0 := Army.new(0, 100)
    29		var a1 := Army.new(1, 100)
    30		a0.load_code(c0)
    31		a1.load_code(c1)
    32		var s = Sim.new(a0, a1)
    33		s.fast = fast
    34		var cps: Array = []
    35		while not s.finished:
    36			s.step()
    37			if s.tick % CHECK_EVERY == 0:
    38				cps.append(state_sig(s))
    39		cps.append(state_sig(s))
    40		return {"winner": s.winner, "ticks": s.tick, "cps": cps, "fp": s.fingerprint}
    41	
    42	func _init() -> void:
    43		var args := OS.get_cmdline_user_args()
    44		if "--make" in args:
    45			_make()
    46			return
    47		var n := 1000
    48		for a in args:
    49			if a.begins_with("--n="):
    50				n = int(a.substr(4))
    51		var res := check(n)
    52		print("GOLDEN %s" % JSON.stringify(res))
    53		quit(0 if res["ok"] else 1)
    54	
    55	func _make() -> void:
    56		var rng := RandomNumberGenerator.new()
    57		var cases: Array = []
    58		for i in 1000:
    59			rng.seed = 20261102 + i * 7919
    60			# 第四輪：一半用 AI 模板（含新兵模板）、一半用十種兵的隨機混編，確保至少一半場次有新兵
    61			var a0: Army = AI.build(0, 100, rng)["army"] if i % 2 == 0 else F.random_formation(0, rng, "mixed", "", D.COUNT)
    62			var a1: Army = AI.build(1, 100, rng)["army"] if i % 2 == 0 else F.random_formation(0, rng, "mixed", "", D.COUNT).mirrored()
    63			var c0 := a0.to_code()
    64			var c1 := a1.to_code()
    65			var r := run_case(c0, c1, false)
    66			cases.append({"a": c0, "b": c1, "w": r["winner"], "t": r["ticks"], "cps": r["cps"], "fp": r["fp"]})
    67		var out := {"rules": D.RULES_VERSION, "digest": D.data_digest(), "check_every": CHECK_EVERY, "cases": cases}
    68		var f := FileAccess.open(PATH, FileAccess.WRITE)
    69		f.store_string(JSON.stringify(out))
    70		f.close()
    71		var lk := FileAccess.open(LOCK, FileAccess.WRITE)
    72		lk.store_string(JSON.stringify({"sha256": FileAccess.get_file_as_string(PATH).sha256_text(), "cases": cases.size()}))
    73		lk.close()
    74		print("GOLDEN 已產生 %d 場（規則 %s、摘要 %s）" % [cases.size(), D.RULES_VERSION, D.data_digest()])
    75		quit(0)
    76	
    77	## 比對前 n 場；回傳 {ok, n, first_case, first_tick, why}
    78	static func check(n: int) -> Dictionary:
    79		var raw := FileAccess.get_file_as_string(PATH)
    80		var lk = JSON.parse_string(FileAccess.get_file_as_string(LOCK))
    81		if not lk is Dictionary or str(lk.get("sha256", "")) != raw.sha256_text() or int(lk.get("cases", 0)) != CASES:
    82			return {"ok": false, "why": "金標準檔和鎖檔不符（檔案被換過、縮水，或沒有用 --make 重產）"}
    83		var g = JSON.parse_string(raw)
    84		if not g is Dictionary or not g.get("cases") is Array or g["cases"].size() != CASES:
    85			return {"ok": false, "why": "讀不到金標準檔，或案例數不是 %d" % CASES}
    86		if n <= 0 or n > CASES:
    87			return {"ok": false, "why": "n 要在 1～%d" % CASES}
    88		if str(g["rules"]) != D.RULES_VERSION or str(g["digest"]) != D.data_digest():
    89			return {"ok": false, "why": "規則或數值變了（%s/%s → %s/%s）：若是刻意改規則，請重產金標準並在 commit 說明" % [g["rules"], g["digest"], D.RULES_VERSION, D.data_digest()]}
    90		var cases: Array = g["cases"]
    91		var every := int(g["check_every"])
    92		for i in mini(n, cases.size()):
    93			var c: Dictionary = cases[i]
    94			var r := run_case(c["a"], c["b"], false)
    95			var cps: Array = c["cps"]
    96			for k in mini(cps.size(), r["cps"].size()):
    97				if cps[k] != r["cps"][k]:
    98					return {"ok": false, "n": i + 1, "first_case": i, "first_tick": (k + 1) * every if k < cps.size() - 1 else int(c["t"]), "why": "狀態分歧"}
    99			if r["cps"].size() != cps.size() or int(r["winner"]) != int(c["w"]) or int(r["ticks"]) != int(c["t"]) or r["fp"] != c["fp"]:
   100				return {"ok": false, "n": i + 1, "first_case": i, "first_tick": int(c["t"]), "why": "結果或指紋不同"}
   101		var ran := mini(n, cases.size())
   102		return {"ok": ran == n, "n": ran}
     1	extends SceneTree
     2	## 舊兵種相容檢查（第四輪方案 §3.1～3.2）。
     3	## 目的：加新兵種之後，「只用舊 5 種兵」的對戰行為必須一模一樣。
     4	## 最終指紋包含規則版本和數值摘要，加兵後一定會變，所以這裡不比指紋，改比：
     5	##   ・逐 tick 累積摘要：每 tick 把每隻兵的「舊欄位」（第三輪就有的 28 個狀態）寫進同一個 SHA-256
     6	##   ・勝方、結束 tick、每隻兵的擊殺數、造成／承受傷害
     7	## 基準檔 tests/golden/compat_v1.2.json 是在 N0a（規則 1.2.0、還沒加兵）時用同一套程式產生的，
     8	## 之後不重產；陣型代碼存在檔案裡，不重新呼叫 AI 造陣（AI 之後會改）。
     9	## 用法：godot --headless --path game --script res://tools/compat.gd -- [--make] [--n=1000]
    10	const Sim = preload("res://scripts/core/battle_sim.gd")
    11	const Army = preload("res://scripts/core/army.gd")
    12	const D = preload("res://scripts/core/unit_defs.gd")
    13	const PATH := "res://tests/golden/compat_v1.2.json"
    14	const GOLDEN := "res://tests/golden/golden.json"
    15	## 基準的 1000 組陣型代碼的身分（"a|b" 以逗號串接後 SHA-256 前 16 碼）；換了一組就不是同一個基準（Codex 第 2 輪 #10）
    16	const SET_HASH := "76b34d76d7431f12"
    17	
    18	## 舊欄位（第三輪 _hash_state 的 28 個欄位）。新兵種加的狀態不放這裡，另外檢查它們在舊場次一直是初值。
    19	static func old_fields(u) -> PackedInt64Array:
    20		return PackedInt64Array([u.x, u.y, u.hp, u.cd, u.target, u.fx, u.fy, u.face_lock, u.mx, u.my, u.cdx, u.cdy, u.stealth, u.charge, u.stun,
    21			u.slow, u.wp_x, u.wp_y, u.wp_for, 1 if u.alive else 0, u.dmg_dealt, u.dmg_taken, u.kills, u.id, u.team, u.type, u.nav, 1 if u.chasing else 0])
    22	
    23	## 新狀態在舊場次必須一直是初值（加了新欄位就在這裡登記初值）。回傳空字串＝正常。
    24	static func new_fields_untouched(s) -> String:
    25		for u in s.units:
    26			for k in NEW_FIELDS:
    27				if k in u and u.get(k) != NEW_FIELDS[k]:
    28					return "id %d 的 %s=%s（應為 %s）" % [u.id, k, u.get(k), NEW_FIELDS[k]]
    29		return ""
    30	
    31	## 第四輪新增的單位狀態與它們的初值（舊 5 種兵永遠不會用到）
    32	const NEW_FIELDS := {"hcd": 0, "aura": 0, "breach": 0, "bmode": 0, "heal_done": 0, "follow": -1, "drum_cover": 0}
    33	
    34	static func run_case(c0: String, c1: String) -> Dictionary:
    35		var a0 := Army.new(0, 100)
    36		var a1 := Army.new(1, 100)
    37		if a0.load_code(c0) != "" or a1.load_code(c1) != "":
    38			return {"error": "陣型代碼解不開"}
    39		var s = Sim.new(a0, a1)
    40		s.fast = true
    41		var h := HashingContext.new()
    42		h.start(HashingContext.HASH_SHA256)
    43		var untouched := ""
    44		while not s.finished:
    45			s.step()
    46			var buf := PackedInt64Array([s.tick])
    47			for u in s.units:
    48				buf.append_array(old_fields(u))
    49			h.update(buf.to_byte_array())
    50			if untouched == "":
    51				untouched = new_fields_untouched(s)
    52		var per := PackedStringArray()
    53		for u in s.units:
    54			per.append("%d:%d:%d:%d" % [u.id, u.kills, u.dmg_dealt, u.dmg_taken])
    55		return {"w": s.winner, "t": s.tick, "roll": h.finish().hex_encode().substr(0, 24), "per": ";".join(per), "untouched": untouched}
    56	
    57	func _init() -> void:
    58		var args := OS.get_cmdline_user_args()
    59		var n := 1000
    60		for a in args:
    61			if a.begins_with("--n="):
    62				n = int(a.substr(4))
    63		if "--make" in args:
    64			_make()
    65			return
    66		var res := check(n)
    67		print("COMPAT %s" % JSON.stringify(res))
    68		quit(0 if res["ok"] else 1)
    69	
    70	func _make() -> void:
    71		if D.RULES_VERSION != "1.2.0":
    72			push_error("相容基準只能在規則 1.2.0（還沒加新兵）時產生")
    73			quit(1)
    74			return
    75		var g = JSON.parse_string(FileAccess.get_file_as_string(GOLDEN))
    76		var cases: Array = []
    77		for c in g["cases"]:
    78			var r := run_case(c["a"], c["b"])
    79			cases.append({"a": c["a"], "b": c["b"], "w": r["w"], "t": r["t"], "roll": r["roll"], "per": r["per"]})
    80		var f := FileAccess.open(PATH, FileAccess.WRITE)
    81		f.store_string(JSON.stringify({"from_rules": D.RULES_VERSION, "from_digest": D.data_digest(), "cases": cases}))
    82		f.close()
    83		print("COMPAT 已產生 %d 場基準（規則 %s）" % [cases.size(), D.RULES_VERSION])
    84		quit(0)
    85	
    86	## 比對前 n 場；回傳 {ok, n, first_case, why}
    87	static func check(n: int) -> Dictionary:
    88		var g = JSON.parse_string(FileAccess.get_file_as_string(PATH))
    89		if not g is Dictionary:
    90			return {"ok": false, "why": "讀不到相容基準檔"}
    91		var cases: Array = g["cases"]
    92		# 基準必須是完整的 1000 場、而且至少要比 1 場（Codex 實作審查 #10：空的或縮水的基準不能回報成功）
    93		if cases.size() != 1000 or str(g.get("from_rules", "")) != "1.2.0":
    94			return {"ok": false, "why": "相容基準不完整或來源規則不是 1.2.0（%d 場）" % cases.size()}
    95		var ids := PackedStringArray()
    96		for c in cases:
    97			ids.append("%s|%s" % [c["a"], c["b"]])
    98		if ",".join(ids).sha256_text().substr(0, 16) != SET_HASH:
    99			return {"ok": false, "why": "相容基準的陣型組合不是原本那 1000 組"}
   100		if n < 1 or n > cases.size():
   101			return {"ok": false, "why": "要比的場數 %d 不合法" % n}
   102		for i in n:
   103			var c: Dictionary = cases[i]
   104			var r := run_case(c["a"], c["b"])
   105			if r.has("error"):
   106				return {"ok": false, "n": i + 1, "first_case": i, "why": r["error"]}
   107			if r["untouched"] != "":
   108				return {"ok": false, "n": i + 1, "first_case": i, "why": "新狀態在舊場次被動到：" + r["untouched"]}
   109			if int(r["w"]) != int(c["w"]) or int(r["t"]) != int(c["t"]):
   110				return {"ok": false, "n": i + 1, "first_case": i, "why": "勝負或結束 tick 不同"}
   111			if r["per"] != str(c["per"]):
   112				return {"ok": false, "n": i + 1, "first_case": i, "why": "擊殺或傷害統計不同"}
   113			if r["roll"] != c["roll"]:
   114				return {"ok": false, "n": i + 1, "first_case": i, "why": "逐 tick 狀態分歧"}
   115		return {"ok": true, "n": n}
     1	extends SceneTree
     2	## 第五輪 P0：封存舊格式對戰代碼（NTB2）＋預期結果。
     3	## 自訂規則上線後，舊代碼要用舊判定（judge=1）播出完全相同的一場；這裡存的是「當時的字串」，不是用新版自己編再自己解。
     4	## 產生（只在 1.3.0 規則下做一次；第五輪改成逐 tick 指紋後重封一次——金標準 1000 場證明當時模擬器和 1.3.0 位元組相同）：godot --headless --path game --script res://tools/seal_codes.gd -- --make
     5	## 檢查：godot --headless --path game --script res://tools/seal_codes.gd
     6	const Sim = preload("res://scripts/core/battle_sim.gd")
     7	const AI = preload("res://scripts/core/ai_army.gd")
     8	const F = preload("res://scripts/core/formations.gd")
     9	const D = preload("res://scripts/core/unit_defs.gd")
    10	const BC = preload("res://scripts/game/battle_code.gd")
    11	const PATH := "res://tests/golden/battle_codes_v2.json"
    12	const N := 40
    13	# 預算組合：一般 100／100，加上遠征、殘局會出現的不等預算（含 30 對 160 這類極端值）
    14	const BUDGETS := [[100, 100], [100, 100], [100, 100], [100, 100], [30, 160], [160, 30], [60, 100], [100, 140], [25, 25], [200, 120]]
    15	
    16	static func play(code: String) -> Dictionary:
    17		var d := BC.decode(code)
    18		if not d["ok"]:
    19			return {"ok": false, "why": d["why"]}
    20		# 逐 tick 雜湊（不用 fast）：指紋涵蓋整個戰鬥過程，不只終局（Codex 第五輪實作第 1 輪）；解出來的規則照樣傳進模擬器（NTB2＝null）
    21		var s = Sim.new(d["a0"], d["a1"], d.get("rules"))
    22		s.run_to_end()
    23		return {"ok": true, "w": s.winner, "t": s.tick, "fp": s.fingerprint, "p0": s.power(0), "p1": s.power(1)}
    24	
    25	func _init() -> void:
    26		if "--make" in OS.get_cmdline_user_args():
    27			var rng := RandomNumberGenerator.new()
    28			var rows: Array = []
    29			for i in N:
    30				rng.seed = 5050 + i * 104729
    31				var bud: Array = BUDGETS[i % BUDGETS.size()]
    32				var a0 = AI.build(0, bud[0], rng)["army"] if (i % 3 != 2 or bud[0] < 100) else F.random_formation(0, rng, "mixed", "", D.COUNT)
    33				var a1 = AI.build(1, bud[1], rng)["army"]
    34				a0.budget = bud[0]
    35				a1.budget = bud[1]
    36				var code := BC.encode(a0, a1)
    37				var r := play(code)
    38				if not r["ok"]:
    39					push_error("封存失敗：第 %d 筆 %s" % [i, r["why"]])
    40					quit(1)
    41					return
    42				rows.append({"code": code, "w": r["w"], "t": r["t"], "fp": r["fp"], "p0": r["p0"], "p1": r["p1"]})
    43			var f := FileAccess.open(PATH, FileAccess.WRITE)
    44			f.store_string(JSON.stringify({"rules": D.RULES_VERSION, "digest": D.data_digest(), "rows": rows}))
    45			f.close()
    46			print("SEALCODES 已封存 %d 筆" % rows.size())
    47			quit(0)
    48			return
    49		var g = JSON.parse_string(FileAccess.get_file_as_string(PATH))
    50		if not g is Dictionary or not g.get("rows") is Array or g["rows"].size() != N:
    51			print("SEALCODES 失敗：封存檔不存在或筆數不是 %d" % N)
    52			quit(1)
    53			return
    54		var bad := 0
    55		for row in g["rows"]:
    56			var r := play(str(row["code"]))
    57			if not r["ok"] or int(r["w"]) != int(row["w"]) or int(r["t"]) != int(row["t"]) or str(r["fp"]) != str(row["fp"]) \
    58					or int(r["p0"]) != int(row["p0"]) or int(r["p1"]) != int(row["p1"]):
    59				bad += 1
    60				if bad <= 3:
    61					print("  分歧：", str(row["code"]).substr(0, 40), "… ", r)
    62		print("SEALCODES %s" % JSON.stringify({"n": g["rows"].size(), "ok": bad == 0}))
