   587	func _err_key(why: String) -> String:
   588		if why == "":
   589			return ""
   590		if why.begins_with("只能放"):
   591			return L.t("err_zone")
   592		if why.begins_with("這格"):
   593			return L.t("err_taken")
   594		if why.begins_with("最多"):
   595			return L.t("err_max", [_cur_army().unit_cap])
   596		if why.begins_with("這種兵最多"):
   597			return L.t("err_type_cap", [_cur_army().type_cap])
   598		if why.begins_with("這種兵不在"):
   599			return L.t("err_type")
   600		if why.begins_with("要留錢"):
   601			return L.t("err_reserve")
   602		if why.begins_with("最後一手"):
   603			return L.t("err_last_hand")
   604		if why.begins_with("錢不夠"):
   605			return L.t("err_gold")
   606		if why.begins_with("這一手"):
   607			return L.t("err_hand", [tp.hand_cap() if tp else 10])
   608		return why
