   340		# ③ 統一解碰撞（固定兩輪，所有推力加總後一次套用）
   341		for _pass in 2:
   342			var px := PackedInt64Array()
   343			var py := PackedInt64Array()
   344			px.resize(n)
   345			py.resize(n)
   346			for i in n:
   347				if sv[i] == 0:
   348					continue
   349				var xi := nx[i]
   350				var yi := ny[i]
   351				for j in range(i + 1, n):
   352					if sv[j] == 0:
   353						continue
   354					var dx := nx[j] - xi
   355					var dy := ny[j] - yi
   356					if dx >= MIN_SEP or dx <= -MIN_SEP or dy >= MIN_SEP or dy <= -MIN_SEP:
   357						continue
   358					var d2 := dx * dx + dy * dy
   359					if d2 >= MIN_SEP * MIN_SEP:
   360						continue
   361					var d := M.isqrt(d2)
   362					var ux := 0
   363					var uy := 0
   364					if d == 0:
   365						# 零距離：不同隊左右分開（藍往左、紅往右）；同隊上下分開
   366						if st[i] != st[j]:
   367							ux = 1000 if st[i] == 0 else -1000
   368						else:
   369							uy = 1000
   370					else:
   371						ux = dx * 1000 / d
   372						uy = dy * 1000 / d
   373					var half := (MIN_SEP - d) / 2 + 1
   374					px[i] -= ux * half / 1000
   375					py[i] -= uy * half / 1000
   376					px[j] += ux * half / 1000
   377					py[j] += uy * half / 1000
   378			for i in n:
   379				nx[i] = clampi(nx[i] + px[i], EDGE, W - EDGE)
   380				ny[i] = clampi(ny[i] + py[i], EDGE, H - EDGE)
   381	
   382		# 套用移動、目標、面向
   383		for i in n:
   384			var u := units[i]
   385			if not u.alive:
   386				continue
   387			var moved_x: int = nx[i] - u.x
   388			var moved_y: int = ny[i] - u.y
   389			if u.type == D.CAVALRY:
   390				_update_charge(u, moved_x, moved_y)
   391			u.x = nx[i]
   392			u.y = ny[i]
   393			u.target = new_target[i]
   394			u.fx = new_fx[i]
   395			u.fy = new_fy[i]
   396			u.face_lock = new_lock[i]   # 只在第②步已經轉向目標之後才鎖定
   397	
   398		# ④ 產生攻擊（讀這一 tick 已確定的位置與面向）
   399		var hits: Array = []   # [來源, 目標, 傷害, 種類]
   400		var stun_set := {}
   401		var slow_set := {}
   402		var reveal := {}
   403		var knock: Array = []
   404		var attacked := PackedByteArray()
   405		attacked.resize(n)
   406		var sword_hit_by := {}   # 劍士索引 → 這一 tick 打中它的刺客索引們
   407		var dec := D.FRENZY_CD_RATE if frenzy else 4
   408		# 背水（追趕機制，預設關閉）：用這一 tick 開始時的戰力判斷，兩隊同時算
   409		var rally_bonus := [0, 0]
   410		rally = [false, false]
   411		if D.RALLY_RATIO_PCT > 0 and not skill_off.has("rally"):
   412			var pw := [power(0), power(1)] if judge == 1 else [power_permille(0), power_permille(1)]   # 讓子時比各自預算的比例
   413			for tm in 2:
   414				if pw[tm] * 100 < pw[1 - tm] * D.RALLY_RATIO_PCT:
   415					rally_bonus[tm] = D.RALLY_CD_BONUS
   416					rally[tm] = true
   417		for tm in 2:
   418			if rally[tm] != _was_rally[tm]:
   419				events.append({"kind": EV.RALLY_ON if rally[tm] else EV.RALLY_OFF, "team": tm, "tags": [EV.RALLY]})
   420				_was_rally[tm] = rally[tm]
   960				above += 1
   961			elif e.y > u.y:
   962				below += 1
   963			if e.type != D.SHIELD or e.stealth > 0:
   964				continue
   965			var ex: int = e.x - u.x
   966			var ey: int = e.y - u.y
   967			var proj: int = ex * dx + ey * dy
   968			if proj <= 0 or proj >= l2:
   969				continue
   970			var cross: int = ex * dy - ey * dx
   971			if cross * cross < D.FLANK_DETECT * D.FLANK_DETECT * l2:
   972				blocked = true
   973		if not blocked:
   974			return Vector2i(-1, -1)
   975		# 上下兩個候選點都先夾在離邊界有餘裕的範圍；夾完之後如果離直線不到 FLANK_DETECT（沒有真的繞開）就不採用
   976		var lo := EDGE + D.FLANK_EDGE_MARGIN
   977		var hi := H - EDGE - D.FLANK_EDGE_MARGIN
   978		var mid_x := u.x + (tg.x - u.x) / 2   # 用差值往 0 截斷，左右鏡像才對稱
   979		var line_y := u.y + (tg.y - u.y) / 2
   980		var up_y := clampi(mini(u.y, tg.y) - D.FLANK_OFFSET, lo, hi)
   981		var dn_y := clampi(maxi(u.y, tg.y) + D.FLANK_OFFSET, lo, hi)
   982		# 用叉積算候選點到「騎兵→目標」直線的垂直距離（不是只比 y 差），近乎垂直的路線也判得對（Codex R1 審查 #2）
   983		var cu: int = (mid_x - u.x) * dy - (up_y - u.y) * dx
   984		var cd: int = (mid_x - u.x) * dy - (dn_y - u.y) * dx
   985		var need: int = D.FLANK_DETECT * D.FLANK_DETECT * l2
   986		var up_ok := up_y < line_y and cu * cu >= need
   987		var dn_ok := dn_y > line_y and cd * cd >= need
   988		var wy := -1
   989		if up_ok and (not dn_ok or above <= below):
   990			wy = up_y
   991		elif dn_ok:
   992			wy = dn_y
   993		if wy < 0:
   994			return Vector2i(-1, -1)   # 兩側都沒有空間繞：直接追
   995		u.nav = 1
   996		events.append({"kind": EV.FLANK, "src": u.id, "tgt": tg.id, "tags": [EV.FLANK]})
   997		u.wp_x = mid_x
   998		u.wp_y = wy
   999		return Vector2i(u.wp_x, u.wp_y)
