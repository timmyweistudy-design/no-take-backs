    92		var pool := F.sealed_pool(0, NT) if sealed else (F.validation_pool(0, NT) if val else F.training_pool(0, NT))
    93		for i in pool.size():
    94			if i % shards != shard:
    95				continue
    96			for k in 12:
    97				var j := (i * 37 + k * 53 + 1) % pool.size()
