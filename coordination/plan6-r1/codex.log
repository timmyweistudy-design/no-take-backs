    78	static func clamp_pool(r, kind: String, unlocked: int, demo: bool) -> Array:
    79		var sel := selectable(kind, unlocked, demo)
    80		var removed: Array = []
    81		for tm in 2:
    82			var p := int(r.pool[tm])
    83			for t in D.COUNT:
    84				if RSET.has(p, t) and not RSET.has(sel, t) and not t in removed:
    85					removed.append(t)
    86			p &= sel
    87			if not RSET.has_combat(p):
    88				p = sel
    89			r.pool[tm] = p
    90		return removed
