   774	func _key(k: int) -> void:
   775		# 有按鈕焦點的畫面（標題、選單、結果、覆蓋層、戰鬥）：方向鍵移焦點、Enter 按下、Esc 返回
   776		if state != St.PLACE or overlay != "":
   777			match k:
   778				KEY_UP, KEY_LEFT:
   779					_move_focus(-1)
   780				KEY_DOWN, KEY_RIGHT, KEY_TAB:
   781					_move_focus(1)
   782				KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
   783					if _btns_gen == _gen and _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:   # 按鈕清單要是這個畫面的
   784						sfx.play("ui_click")
   785						_btns[_focus]["cb"].call()
   786				KEY_PAGEUP, KEY_PAGEDOWN:
   787					if overlay == "codex":
   788						_scroll_by("left", -160.0 if k == KEY_PAGEUP else 160.0)
   789				KEY_ESCAPE:
   790					if overlay != "":
   791						overlay = ""
   792					elif state == St.BATTLE:
   793						_on_skip()
   794					elif state != St.TITLE:
   795						_go_title()
   796			return
   797		pad_mode = true
   798		match k:
   799			KEY_UP: cursor.y = maxi(0, cursor.y - 1)
   800			KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
   801			KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
   802			KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
   803			KEY_F1:
   804				_open_codex(selected)
   805			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0:
   806				var t := 9 if k == KEY_0 else k - KEY_1
   807				if t < D.COUNT and _allowed(t):
   808					selected = t
   809			KEY_Q, KEY_E:
   810				for i in D.COUNT:
   811					selected = (selected + (D.COUNT - 1 if k == KEY_Q else 1)) % D.COUNT
   812					if _allowed(selected):
   813						break
   814			KEY_ENTER, KEY_KP_ENTER:
   815				if _cur_army().index_at(cursor.x, cursor.y) == -1:
   816					_try_place(cursor)
   817			KEY_BACKSPACE, KEY_DELETE:
   818				_try_remove(cursor)
   819			KEY_SPACE, KEY_TAB:
   820				_on_start()
   821			KEY_ESCAPE:
   822				_go_title()
