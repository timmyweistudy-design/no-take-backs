  1001	## 完整狀態指紋：每 tick 依 id 順序寫入固定 35 個 int64 欄位（第四輪加 7 個）。
  1002	func _hash_state() -> void:
  1003		var a := PackedInt64Array()
  1004		a.resize(units.size() * 35 + 1)
  1005		a[0] = tick
  1006		var k := 1
  1007		for u in units:
  1008			a[k] = u.x; a[k + 1] = u.y; a[k + 2] = u.hp; a[k + 3] = u.cd; a[k + 4] = u.target
  1009			a[k + 5] = u.fx; a[k + 6] = u.fy; a[k + 7] = u.face_lock; a[k + 8] = u.mx; a[k + 9] = u.my
  1010			a[k + 10] = u.cdx; a[k + 11] = u.cdy; a[k + 12] = u.stealth; a[k + 13] = u.charge; a[k + 14] = u.stun
  1011			a[k + 15] = u.slow; a[k + 16] = u.wp_x; a[k + 17] = u.wp_y; a[k + 18] = u.wp_for; a[k + 19] = 1 if u.alive else 0
  1012			a[k + 20] = u.dmg_dealt; a[k + 21] = u.dmg_taken; a[k + 22] = u.kills; a[k + 23] = u.id; a[k + 24] = u.team; a[k + 25] = u.type
  1013			a[k + 26] = u.nav; a[k + 27] = 1 if u.chasing else 0
  1014			a[k + 28] = u.hcd; a[k + 29] = u.aura; a[k + 30] = u.breach; a[k + 31] = u.bmode; a[k + 32] = u.heal_done; a[k + 33] = u.follow
  1015			a[k + 34] = u.drum_cover
  1016			k += 35
  1017		_hash.update(a.to_byte_array())
  1018	
  1019	func _check_end() -> void:
  1020		var a0 := alive_count(0)
  1021		var a1 := alive_count(1)
  1022		if a0 == 0 and a1 == 0:
  1023			_finish(-1, "同時全滅")
  1024		elif a1 == 0:
  1025			_finish(0, "全滅")
  1026		elif a0 == 0:
  1027			_finish(1, "全滅")
  1028		elif tick >= max_ticks:
  1029			var p0 := power(0)
  1030			var p1 := power(1)
  1031			if judge == 2:
  1032				# 讓子：比「剩餘戰力占自己預算」；整數交叉相乘避免截斷（Codex 第一輪）
  1033				var b0: int = budgets[0]
  1034				var b1: int = budgets[1]
  1035				var dlt: int = p0 * b1 - p1 * b0
  1036				if 100 * absi(dlt) < 3 * 1000 * b0 * b1:
  1037					_finish(-1, "時間到・戰力相當")
  1038				elif dlt > 0:
  1039					_finish(0, "時間到・剩餘戰力較高")
  1040				else:
  1041					_finish(1, "時間到・剩餘戰力較高")
  1042			elif absi(p0 - p1) < budget * 30:
  1043				_finish(-1, "時間到・戰力相當")
  1044			elif p0 > p1:
  1045				_finish(0, "時間到・剩餘戰力較高")
  1046			else:
  1047				_finish(1, "時間到・剩餘戰力較高")
  1048	
  1049	func _finish(w: int, r: String) -> void:
  1050		finished = true
  1051		winner = w
  1052		reason = r
  1053		_hash.update(PackedInt64Array([tick, w]).to_byte_array())
  1054		fingerprint = _hash.finish().hex_encode()
  1055	
  1056	func unit_by_id(id: int) -> Unit:
  1057		for u in units:
  1058			if u.id == id:
  1059				return u
  1060		return null
  1061	
  1062	## 懸念指標（優化方案 B2）：用每 tick 的戰力差 Δ(t) 算。只在結束後呼叫。
  1063	## lead_changes：開戰 5 秒後 Δ 跨過 ±5%（以總預算計）的次數；
  1064	## lock_ratio：勝方從這一 tick 起領先再也不低於 20% 的時間點 ÷ 全場；
  1065	## max_swing：贏家曾經落後的最大幅度（%）。
  1066	func suspense() -> Dictionary:
  1067		var total := budget * 1000
  1068		var lg: PackedInt64Array = power_log
  1069		if judge == 2:
  1070			# 讓子：用「占自己預算的比例」差，換算到 1000×1000 的尺度
  1071			total = 1000 * 1000
  1072			lg = PackedInt64Array()
  1073			for t in power_log2.size() / 2:
  1074				lg.append(power_log2[2 * t] * 1000 / budgets[0] - power_log2[2 * t + 1] * 1000 / budgets[1])
  1075		var thr := total * 5 / 100
  1076		var lock_thr := total * 20 / 100
  1077		var changes := 0
  1078		var side := 0
  1079		for t in range(100, lg.size()):
  1080			var d: int = lg[t]
  1081			var s := 0
  1082			if d > thr:
  1083				s = 1
  1084			elif d < -thr:
  1085				s = -1
  1086			if s != 0:
  1087				if side != 0 and s != side:
  1088					changes += 1
  1089				side = s
  1090		var lock_t := lg.size()
  1091		var swing := 0
  1092		if winner >= 0:
  1093			var sign := 1 if winner == 0 else -1
  1094			lock_t = 0
  1095			for t in lg.size():
  1096				var lead: int = lg[t] * sign
  1097				if lead < lock_thr:
  1098					lock_t = t + 1
  1099				if -lead > swing:
  1100					swing = -lead
  1101		var ratio := lock_t * 1000 / maxi(1, lg.size())
  1102		return {"lead_changes": changes, "lock_ratio_permille": ratio, "max_swing_pct": swing * 100 / total}
     1	extends RefCounted
     2	## 左右交換逐 tick 比對（優化方案 B1／L1）：原本 (隊,列,欄) ↔ 鏡像 (1-隊,列,15-欄)，每 tick 比位置、血、面向、存活。
     3	## 回傳 ""＝完全鏡像一致；否則是第一個分歧的描述。
     4	
     5	const Sim = preload("res://scripts/core/battle_sim.gd")
     6	
     7	static func check(a0, a1) -> String:
     8		var s1 = Sim.new(a0.copy(), a1.copy())
     9		var s2 = Sim.new(a1.mirrored(), a0.mirrored())
    10		var map := {}
    11		for u in s1.units:
    12			var row: int = (u.id % 1000) / 16
    13			var col: int = (u.id % 1000) % 16
    14			map[u.id] = (1 - u.team) * 1000 + row * 16 + (15 - col)
    15		var byid := {}
    16		var idx2 := {}   # s2 的 id → 索引
    17		for k in s2.units.size():
    18			byid[s2.units[k].id] = s2.units[k]
    19			idx2[s2.units[k].id] = k
    20		# s1 索引 → 對應到 s2 的索引（目標、面向鎖定是索引）
    21		var imap := {-1: -1}
    22		for k in s1.units.size():
    23			imap[k] = idx2[map[s1.units[k].id]]
    24		while not s1.finished or not s2.finished:
    25			s1.step()
    26			s2.step()
    27			if s1.rally[0] != s2.rally[1] or s1.rally[1] != s2.rally[0]:
    28				return "tick %d 背水狀態不對稱：%s vs %s" % [s1.tick, s1.rally, s2.rally]
    29			for u in s1.units:
    30				var v = byid[map[u.id]]
    31				var a := [Sim.W - u.x, u.y, u.hp, -u.fx, u.fy, imap[u.target], imap[u.face_lock], u.cd, u.stun, u.slow,
    32					u.stealth, u.charge, -u.cdx, u.cdy, -u.mx, u.my, (Sim.W - u.wp_x) if u.wp_x >= 0 else -1, u.wp_y, u.alive, u.dmg_dealt, u.dmg_taken, map.get(u.wp_for, -1), u.kills, u.nav, u.chasing,
    33					u.hcd, u.aura, u.breach, u.bmode, u.heal_done, imap[u.follow], u.drum_cover]
    34				var b := [v.x, v.y, v.hp, v.fx, v.fy, v.target, v.face_lock, v.cd, v.stun, v.slow,
    35					v.stealth, v.charge, v.cdx, v.cdy, v.mx, v.my, v.wp_x, v.wp_y, v.alive, v.dmg_dealt, v.dmg_taken, v.wp_for, v.kills, v.nav, v.chasing,
    36					v.hcd, v.aura, v.breach, v.bmode, v.heal_done, v.follow, v.drum_cover]
    37				if a != b:
    38					var names := ["x", "y", "hp", "fx", "fy", "target", "face_lock", "cd", "stun", "slow", "stealth", "charge", "cdx", "cdy", "mx", "my", "wp_x", "wp_y", "alive", "dealt", "taken", "wp_for", "kills", "nav", "chasing", "hcd", "aura", "breach", "bmode", "heal_done", "follow", "drum_cover"]
    39					var diff := []
    40					for k in a.size():
    41						if a[k] != b[k]:
    42							diff.append("%s %s≠%s" % [names[k], a[k], b[k]])
    43					return "tick %d 單位 %d（兵種 %d）：%s" % [s1.tick, u.id, u.type, ", ".join(diff)]
    44			if s1.finished != s2.finished:
    45				return "結束 tick 不同：%d vs %d" % [s1.tick, s2.tick]
    46		var expect: int = s1.winner if s1.winner == -1 else 1 - s1.winner
    47		if s2.winner != expect:
    48			return "勝方沒對調：%d vs %d" % [s1.winner, s2.winner]
    49		return ""
