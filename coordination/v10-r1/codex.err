    83	func _stick_repeat(delta: float) -> void:
    84		if _is_free() and overlay == "":
    85			_fp_pad_process(delta, Vector2(stick[JOY_AXIS_LEFT_X], stick[JOY_AXIS_LEFT_Y]))   # 第六輪：平滑游標
    86			return
    87		var d := _stick_dir
    88		for ax in [JOY_AXIS_LEFT_X, JOY_AXIS_LEFT_Y]:
    89			var v: float = stick[ax]
    90			var cur: int = d.x if ax == JOY_AXIS_LEFT_X else d.y
    91			var nv := cur
    92			if absf(v) > 0.6:
    93				nv = 1 if v > 0 else -1
    94			elif absf(v) < 0.35:
    95				nv = 0
    96			if ax == JOY_AXIS_LEFT_X:
    97				d.x = nv
    98			else:
    99				d.y = nv
   100		if d != _stick_dir:
   101			_stick_dir = d
   102			_stick_t = 0.35
   103			_stick_fire()
   104		elif d != Vector2i.ZERO:
   105			_stick_t -= delta
   106			if _stick_t <= 0.0:
   107				_stick_t += 0.12
   108				_stick_fire()
   109	
   110	
   111	func _stick_fire() -> void:
   112		if _stick_dir.x != 0:
   113			_enqueue("key", KEY_RIGHT if _stick_dir.x > 0 else KEY_LEFT)
   114		if _stick_dir.y != 0:
   115			_enqueue("key", KEY_DOWN if _stick_dir.y > 0 else KEY_UP)
