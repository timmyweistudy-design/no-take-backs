   140	func _check_place(t: int, c: Vector2i) -> String:
   141		if _locked():
   142			return L.t("both_done")
   143		if not _allowed(t):
   144			return L.t("err_type")
   145		if mode == Mode.DUEL and tp != null:
   146			var why: String = tp.check_place(t, c.x, c.y)
   147			return _err_key(why)
   148		if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() + 1 > gauntlet_changes:
   149			return L.t("err_changes")
   150		return _err_key(_cur_army().check_place(t, c.x, c.y))
   151	
