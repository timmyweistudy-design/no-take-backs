   262	func _key(k: int) -> void:
   263		if state == St.PLACE and _fp_key(k):
   264			return
   265		# 有按鈕焦點的畫面（標題、選單、結果、覆蓋層、戰鬥）：方向鍵移焦點、Enter 按下、Esc 返回
   266		if state != St.PLACE or overlay != "":
   267			match k:
   268				KEY_UP, KEY_LEFT:
   269					_move_focus(-1)
   270				KEY_DOWN, KEY_RIGHT:
   271					_move_focus(1)
   272				KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
   273					if _btns_gen == _gen and _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:   # 按鈕清單要是這個畫面的
   274						sfx.play("k_click", 0.7)
   275						_btns[_focus]["cb"].call()
   276				KEY_PAGEUP, KEY_PAGEDOWN:
   277					if overlay == "codex":
   278						_scroll_by("left", -160.0 if k == KEY_PAGEUP else 160.0)
   279				KEY_P, KEY_TAB:
   280					# 手把 Y 送的是 Tab：戰鬥中＝暫停（第七輪 A6）
   281					if state == St.BATTLE and overlay == "":
   282						_toggle_pause()
   283					elif k == KEY_TAB:
   284						_move_focus(1)
   285				KEY_ESCAPE:
   286					if overlay == "ai_busy":
   287						pass      # 第十輪 I4：AI 計算中不能取消
   288					elif overlay != "":
   289						overlay = ""
   290					elif state == St.BATTLE:
   291						if play_kind != "official":
   292							_replay_back()   # 第七輪 A9：重播時 Esc＝返回
   293						else:
   294							_on_skip()
   295					elif state != St.TITLE:
   296						_request_leave()
   297			return
   298		pad_mode = true
   299		match k:
   300			KEY_UP: cursor.y = maxi(0, cursor.y - 1)
   301			KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
   302			KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
   303			KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
   304			KEY_F1:
   305				_open_codex(selected)
   306			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0:
   307				# 第八輪：數字鍵對應這一排的第幾張卡，不是兵種編號
   308				var pos := 9 if k == KEY_0 else k - KEY_1
   309				var cards := _card_types()
   310				if pos < cards.size() and _allowed(cards[pos]):
   311					selected = cards[pos]
   312			KEY_Q, KEY_E:
   313				var cl := _card_types()
   314				if not cl.is_empty():
   315					var at := maxi(0, cl.find(selected))
   316					for _i in cl.size():
   317						at = (at + (cl.size() - 1 if k == KEY_Q else 1)) % cl.size()
   318						selected = cl[at]
   319						if _allowed(selected):
   320							break
   321			KEY_ENTER, KEY_KP_ENTER:
   322				if _cur_army().index_at(cursor.x, cursor.y) == -1:
   323					_try_place(cursor)
   324			KEY_BACKSPACE, KEY_DELETE:
   325				_try_remove(cursor)
   326			KEY_SPACE, KEY_TAB:
   327				_on_start()
   328			KEY_ESCAPE:
   329				_request_leave()
