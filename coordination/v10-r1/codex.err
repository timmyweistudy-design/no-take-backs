   240				var d0 := Vector2(cos(a0) * rx, sin(a0) * ry)
   241				var d1 := Vector2(cos(a1) * rx, sin(a1) * ry)
   242				draw_primitive(PackedVector2Array([c + d0 * k0, c + d1 * k0, c + d1 * k1, c + d0 * k1]), PackedColorArray([c0, c0, c1, c1]), PackedVector2Array())
