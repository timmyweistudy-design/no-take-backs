   173	func _update_action_focus() -> void:
   174		var sum := Vector2.ZERO
   175		var n := 0
   176		for u in view.units:
   177			if u.alive and ((hurt_t.has(u.id) and time - hurt_t[u.id] < 0.8) or (atk_t.has(u.id) and time - atk_t[u.id] < 0.8)):
   178				sum += _upos(u)
   179				n += 1
   180		action_focus = sum / n if n > 0 else zoom_center
