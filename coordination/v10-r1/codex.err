    82	## 回傳空字串＝可以放；否則是不能放的原因（顯示給玩家）。
    83	func check_place(t: int, col: int, row: int) -> String:
    84		if deploy == "free":
    85			return check_place_xy(t, col * 1000 + 500, row * 1000 + 500)
    86		if not in_zone(col, row):
    87			return E_ZONE
    88		if index_at(col, row) != -1:
    89			return E_TAKEN
    90		return _check_common(t)
