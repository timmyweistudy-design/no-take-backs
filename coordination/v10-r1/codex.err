    88		return BADGE_CERT if base and r.pool_of(0) == 31 and r.pool_of(1) == 31 and r.place_rule == "snake5" and not r.carry else BADGE_FUN
    89	
    90	static func deploy_certified(r) -> bool:
    91		if r.fullfield != 0 or not r.map_is_default():
