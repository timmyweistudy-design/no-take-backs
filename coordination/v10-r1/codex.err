   458		g2._gauntlet_resume()
   459		ok(g2.mode == g2.Mode.GAUNTLET and g2.gauntlet_stage == 2 and g2.armies[0].budget == bud and g2.armies[0].units.size() == n and g2.overlay == "", "I5 接回來狀態相同")
   460		ok(g2.armies[1].to_code() == enemy, "I5 接回來對手相同")
   461		ok(SaveS.sanitize_run({"stage": "x"}).is_empty() and SaveS.sanitize_run({"stage": 99, "seed": 1, "gold": 0, "cap": 0, "changes": 3, "pool": 0, "prev": []}).is_empty(), "I5 壞存點當沒有")
   462		g2._gauntlet_clear()
   463		g2.free()
   464		g.free()
   465		SaveS.data["gauntlet_run"] = {}
   539	func test_v10_demo() -> void:
   540		var was: bool = SaveS.data_locked
   541		SaveS.data_locked = true
   542		var g = GS.new()
   543		g.sfx = FakeSfx.new()
   544		g.time = 1.0
   545		g.force_demo = true
   546		var P = load("res://scripts/game/presets.gd")
   547		g.overlay = ""
   548		g._enter_gauntlet()
   549		ok(g.overlay == "" and g.toast == L.t("demo_locked"), "R1 試玩版不開遠征")
   550		g.toast = ""
   551		g._start_trial(1)
   552		ok(g.toast == L.t("demo_locked") and g.trial_id != 1, "R1 不開的試煉進不去")
   553		var mask: int = load("res://scripts/game/roster.gd").unlocked_mask(1 << 20, true)
   554		for i in P.DEMO_TRIALS:
   555			g._start_trial(i)
   556			ok(g.trial_id == i and g.rules.map_id in P.DEMO_MAPS, "R1 試煉 %d 開得起來、地圖有開放" % i)
   557			g._build_ai()
   558			var off: Array = []
   559			for u in g.armies[1].units:
   560				if not RS9.has(mask, int(u["type"])):
   561					off.append(int(u["type"]))
   562			ok(off.is_empty() and not g.armies[1].units.is_empty(), "R1 試煉 %d 對手沒有正式版兵" % i, str(off))
   563		g._open_lobby("ai")
   564		for _i in 8:
   565			g._lobby_adj("map", 1)
   566			ok(g.lobby_r.map_id in P.DEMO_MAPS, "R1 大廳換圖只有開放的", str(g.lobby_r.map_id))
   567		g.lobby_r.ai_level = 1
   568		g._lobby_adj("ai_level", 1)
   569		ok(g.lobby_r.ai_level == 1, "R1 大廳選不到困難")
   570		for _j in 20:
   571			g._lobby_random()
   572			ok(g.lobby_r.map_id in P.DEMO_MAPS and g.lobby_r.ai_level <= 1, "R1 隨機一切不超出範圍")
   573		g.lobby_r.map_id = 0
   574		g.lobby_r.ai_level = 0
   575		var ok_block: String = g._lobby_block()
