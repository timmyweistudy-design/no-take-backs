extends RefCounted
## 困難 AI（第四輪）：真的「讀你上一局」。
## 第 1 局沒有資訊 → 用原型模板組（和普通 AI 同一套，不會比普通弱）。
## 第 2 局起 → 準備幾個候選陣型（反制庫裡最接近的那筆、兩套模板陣、會讀對方的落子 AI 陣），
## 各拿去和你上一局的陣型模擬一場，挑打得最好的。只看你「上一局」公開過的陣型，不偷看這一局。
## 遊戲（game_screens._hard_ai）和反制庫驗證（tools/balance/make_counter_lib.gd）共用這一個函式。
## 第三輪的做法（查不到反制就退回落子 AI）在第四輪新模板加入後，對驗證池反而比普通 AI 弱（73.0% vs 74.0%），所以改成這樣。

const D = preload("res://scripts/core/unit_defs.gd")
const Army = preload("res://scripts/core/army.gd")
const Sim = preload("res://scripts/core/battle_sim.gd")
const AI = preload("res://scripts/core/ai_army.gd")
const AIT = preload("res://scripts/core/ai_turns.gd")
const F = preload("res://scripts/core/formations.gd")
const RS = preload("res://scripts/core/ruleset.gd")

## known：玩家上一局的兵（藍方座標）；entries：反制庫；回傳紅方陣型。
## pool：紅方卡池遮罩（-1＝全部）；rules：第五輪 Ruleset（null＝標準）。
## 反制庫只在「規則和標準一樣」時用（第五輪 §3.2）；大軍或長局時少一個候選（效能探測：40＋40、150 秒一場可達數秒）。
static func build(known: Array, entries: Array, rng: RandomNumberGenerator, pool := -1, rules = null) -> Army:
	if pool < 0:
		pool = RS.all_pool()
	var bud: int = 100 if rules == null else rules.budget_of(1)
	var cands: Array = []
	cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
	if known.is_empty():
		return cands[0]
	var heavy: bool = rules != null and (rules.unit_cap > 24 or rules.ticks > 1800)
	if not heavy:
		cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
	var full := AIT.build_full(1, rng, 2, known, pool, rules)
	cands.append(full)
	if rules == null or _standard_like(rules):
		var lib := pick_counter(entries, known, pool)
		if lib != null:
			cands.append(lib)
	var me := Army.new(0, 100 if rules == null else rules.budget_of(0))
	if rules != null and rules.is_free():
		me.deploy = "free"   # 第六輪：上一局是自由陣型，照原座標模擬
	for u in known:
		if u.has("x"):
			me.units.append({"type": int(u["type"]), "x": int(u["x"]), "y": int(u["y"])})
		elif me.deploy == "free":
			me.units.append({"type": int(u["type"]), "x": int(u["col"]) * 1000 + 500, "y": int(u["row"]) * 1000 + 500})
		else:
			me.units.append({"type": int(u["type"]), "col": int(u["col"]), "row": int(u["row"])})
	var best: Army = cands[0]
	var bs := -(1 << 40)
	for c in cands:
		var s = Sim.new(me.copy(), c.copy(), rules)
		s.fast = true
		s.run_to_end()
		# 讓子局用各自預算的比例評分（Codex 實作第 1 輪）；標準局算式不變
		var sc: int = (1000000 + s.power(1)) if s.winner == 1 else (s.power(1) - s.power(0))
		if s.judge == 2:
			sc = (1000000 + s.power_permille(1)) if s.winner == 1 else (s.power_permille(1) - s.power_permille(0))
		if sc > bs:
			bs = sc
			best = c
	return best

## 反制庫：組成最接近玩家陣型的原型的反制（距離 ≤40）；用到未開放兵種的不算。
## 反制庫只在「部署與模擬都標準」時用（集中用 Presets.deploy_standard 判定，Codex 實作第 2 輪）。
static func _standard_like(r) -> bool:
	return r.sim_is_legacy() and load("res://scripts/game/presets.gd").deploy_standard(r)

static func pick_counter(entries: Array, known: Array, pool: int) -> Army:
	if entries.is_empty():
		return null
	var mine := D.zeros()
	for u in known:
		mine[int(u["type"])] += D.cost(int(u["type"]))
	var best = null
	var bd := 1 << 30
	for e in entries:
		var pc: Array = e["proto_comp"]
		var d := 0
		for k in mine.size():
			d += absi((int(pc[k]) if k < pc.size() else 0) - int(mine[k]))
		if d < bd:
			bd = d
			best = e
	if best == null or bd > 40:
		return null
	var a := Army.new(1, 100)
	if a.load_code(str(best["code"])) != "":
		return null
	for u in a.units:
		if not RS.has(pool, int(u["type"])):
			return null
	return a
     1	extends "res://scripts/ui/battle/battle_fx.gd"
     2	## 由 battle_view.gd 拆出（V9 P1，行為不變）
     3	
     4	## 時間軸標記（首次衝鋒／背刺／頂住，每隊各一次）：正常播放與重播跳轉共用（Codex S5 #4）。
     5	## 頂住的 src 是被頂住的騎兵，功勞算盾兵那一隊。
     6	func _collect_mark(ev: Dictionary, lookup, tick: int) -> void:
     7		var k: String = ev["kind"]
     8		# 第七輪 A7：加首殺、破陣、背水
     9		if k != EV.CHARGE and k != EV.BACKSTAB and k != EV.BRACED and k != EV.DEATH and k != EV.BREACH and k != EV.RALLY_ON:
    10			return
    11		var team := -1
    12		if k == EV.DEATH:
    13			team = lookup.unit_by_id(ev["id"]).team
    14			for m0 in battle_marks:
    15				if m0["kind"] == k:
    16					return   # 首殺只記一次（不分隊）
    17		elif k == EV.RALLY_ON:
    18			team = int(ev["team"])
    19		else:
    20			team = lookup.unit_by_id(ev["tgt"] if k == EV.BRACED else ev["src"]).team
    21		for m in battle_marks:
    22			if m["kind"] == k and m["team"] == team:
    23				return
    24		battle_marks.append({"tick": tick, "kind": k, "team": team})
    25	
    26	
    27	
    28	## 揮擊殘影（Antigravity S4：五兵種不能共用同一個圓弧）：
    29	## 劍士＝月牙（上挑時從下往上）；刺客＝兩道交叉的短斬痕（X）；盾兵＝往前推的三道衝擊線；
    30	## 騎兵＝水平突刺的槍芒；弓手＝沒有（箭本身就是演出）。sk＝0～1 的進度，sc＝縮放（樣品圖用）。
    31	func _draw_smear(p: Vector2, type: int, team: int, face: float, sk: float, alpha: float, variant: int, sc: float) -> void:
    32		var sa := (1.0 - sk) * alpha
    33		var tc := Art.team_color(team, cbm())
    34		match type:
    35			D.SWORD:
    36				var c := p + Vector2(face * 12.0, -26) * sc
    37				var a0 := (-1.2 if face > 0 else PI - 1.2) if variant == 0 else (0.2 if face > 0 else PI - 2.6)
    38				var span := deg_to_rad(140.0) * minf(1.0, sk * 2.0)
    39				var start := a0 if face > 0 else a0 + deg_to_rad(140.0) - span
    40				draw_arc(c, 20.0 * sc, start, start + span, 18, Color(tc, 0.85 * sa), 6.0 * sc, true)
    41				draw_arc(c, 20.0 * sc, start, start + span, 18, Color(1, 1, 1, 0.9 * sa), 3.0 * sc, true)
    42			D.ASSASSIN:
    43				var c2 := p + Vector2(face * 16.0, -26) * sc
    44				var e := minf(1.0, sk * 2.5)
    45				for k in 2:
    46					var d := Vector2(10, -10 if k == 0 else 10) * sc
    47					var a := c2 - Vector2(d.x * face, d.y)
    48					var b := a.lerp(c2 + Vector2(d.x * face, d.y), e)
    49					draw_line(a, b, Color(0.78, 0.49, 1.0, 0.9 * sa), 4.0 * sc, true)
    50					draw_line(a, b, Color(1, 1, 1, 0.9 * sa), 1.6 * sc, true)
    51			D.SHIELD:
    52				var c3 := p + Vector2(face * 24.0, -24) * sc
    53				for k in 3:
    54					var off := Vector2(face * (4.0 + sk * 10.0 + k * 3.0), (k - 1) * 9.0) * sc
    55					draw_line(c3 + off, c3 + off + Vector2(face * 10.0, 0) * sc, Color(0.75, 0.88, 1.0, 0.9 * sa), 3.0 * sc, true)
    56			D.PIKE:
    57				# 長槍直刺：一道細長的突刺線（第四輪）
    58				var ptip := p + Vector2(face * 52.0, -24) * sc
    59				var plen := 40.0 * minf(1.0, sk * 2.0) * sc
    60				draw_line(ptip - Vector2(face * plen, 0), ptip, Color(tc, 0.8 * sa), 5.0 * sc, true)
    61				draw_line(ptip - Vector2(face * plen, 0), ptip, Color(1, 0.95, 0.85, 0.95 * sa), 2.0 * sc, true)
    62			D.BERSERKER:
    63				# 雙斧往下劈：兩道交叉的橘紅弧光（和刺客的紫 X 區分）
    64				var bc := p + Vector2(face * 12.0, -24) * sc
    65				var bspan := deg_to_rad(110.0) * minf(1.0, sk * 2.0)
    66				for k in 2:
    67					var b0 := (-1.0 + k * 0.5) if face > 0 else (PI + 1.0 - k * 0.5 - bspan)
    68					draw_arc(bc + Vector2(face * k * 6.0, 0) * sc, 18.0 * sc, b0, b0 + bspan, 14, Color(1.0, 0.45, 0.15, 0.85 * sa), 5.0 * sc, true)
    69					draw_arc(bc + Vector2(face * k * 6.0, 0) * sc, 18.0 * sc, b0, b0 + bspan, 14, Color(1, 0.95, 0.8, 0.9 * sa), 2.0 * sc, true)
    70			D.CAVALRY:
    71				var tip := p + Vector2(face * 34.0, -34) * sc
    72				var len := 34.0 * minf(1.0, sk * 2.0) * sc
    73				draw_line(tip - Vector2(face * len, 0), tip, Color(tc, 0.85 * sa), 6.0 * sc, true)
    74				draw_line(tip - Vector2(face * len, 0), tip, Color(1, 1, 1, 0.95 * sa), 2.5 * sc, true)
    75				draw_circle(tip, 4.0 * sc * (1.0 - sk), Color(1, 1, 1, sa), true, -1.0, true)
    76	
