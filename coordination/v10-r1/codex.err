    88	
    89	## 第八輪地面層：毒圈、碎石區。淡色，畫在單位底下。
    90	func _draw_v8_ground(s, live: bool) -> void:
    91		if not live:
    92			return
    93		for z in s.zones:
    94			var c := ORIGIN + Vector2(int(z[0]), int(z[1])) * CS / 1000.0
    95			var rr: float = float(F8.ROCK_R) * CS / 1000.0
    96			draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.55), 0, c))
    97			draw_circle(Vector2.ZERO, rr, Color(0.55, 0.45, 0.3, 0.22), true, -1.0, true)
    98			for k in 7:
    99				var an := k * TAU / 7.0 + 0.4
   100				var a0 := Vector2(cos(an), sin(an)) * rr * 0.2
   101				var a1 := Vector2(cos(an + 0.3), sin(an + 0.3)) * rr * 0.62
   102				var a2 := Vector2(cos(an - 0.1), sin(an - 0.1)) * rr * 0.95
   103				draw_polyline(PackedVector2Array([a0, a1, a2]), Color(0.42, 0.33, 0.22, 0.8), 2.5, true)
   104			draw_set_transform_matrix(_cam)
   105		for u in s.units:
   106			if u.alive and u.type == F8.SPORE:
   107				var c2 := _upos(u)
   108				var r2: float = float(F8.STATS[0]["reach"]) * CS / 1000.0
   109				draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.55), 0, c2))
   110				draw_circle(Vector2.ZERO, r2, Color(Art.team_color(u.team, cbm()), 0.08), true, -1.0, true)
   111				draw_arc(Vector2.ZERO, r2, 0, TAU, 40, Color(0.6, 0.95, 0.4, 0.35), 1.6, true)
   112				draw_set_transform_matrix(_cam)
   113				if not bool(Save.s("reduce_fx")):
   114					for k2 in 3:
   115						var ph := fmod(time * 0.5 + k2 * 0.33 + u.id * 0.07, 1.0)
   116						var an2 := k2 * TAU / 3.0 + time * 0.4
   117						draw_circle(c2 + Vector2(cos(an2) * r2 * 0.55, sin(an2) * r2 * 0.3 - ph * 26.0), 3.0, Color(0.7, 1.0, 0.45, 0.45 * (1.0 - ph)), true, -1.0, true)
   118	
   119	
   120	## 第八輪上層：巫毒連線、大招前搖、時停減傷。
   121	func _draw_v8_top(s, u, p: Vector2) -> void:
   122		if u.type == F8.DOLL and u.link >= 0 and u.link < s.units.size() and s.units[u.link].alive:
   123			var q := _upos(s.units[u.link])
   124			var col := Color(1.0, 0.42, 0.7, 0.55 + 0.2 * sin(time * 6.0))
   125			draw_dashed_line(p + Vector2(0, -26), q + Vector2(0, -26), Color(1.0, 0.7, 0.9, 0.3), 4.5, 7.0)
   126			draw_dashed_line(p + Vector2(0, -26), q + Vector2(0, -26), col, 2.0, 7.0)
   127		if u.windup > 0:
   128			var k := 1.0 - float(u.windup) / F8.WINDUP
   129			var rc := Color("#ffe08a") if u.type == F8.SPRITE else (Color("#c77dff") if u.type == F8.BONE else (Color("#9ad1ff") if u.type == F8.CAT else Color("#d9c9a3")))
   130			draw_arc(p + Vector2(0, -24), 26.0, -PI / 2, -PI / 2 + TAU * k, 28, Color(Art.OUT, 0.7), 5.0, true)
   131			draw_arc(p + Vector2(0, -24), 26.0, -PI / 2, -PI / 2 + TAU * k, 28, rc, 3.0, true)
   132		if u.guard > 0:
   133			draw_arc(p + Vector2(0, -24), 20.0, 0, TAU, 24, Color(1.0, 0.88, 0.5, 0.65), 2.5, true)
