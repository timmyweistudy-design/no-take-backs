    28	var guard_combat := false        # 防卡死：還沒擺戰鬥兵時，不准擺到買不起戰鬥兵（只有玩家擺放與 AI 用，載入舊代碼不開）
    29	# 第六輪：自由排兵（docs/2026-11-03-free-placement-plan-v6.md §3）
