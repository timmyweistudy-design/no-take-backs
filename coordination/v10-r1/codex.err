   598	## 點擊：只對這個畫面世代畫出來的按鈕有效。回傳執行了幾個。
   599	func _do_click(p: Vector2) -> int:
   600		if _btns_gen != _gen:
   601			return 0
   602		for i in _btns.size():
   603			var b: Dictionary = _btns[i]
   604			if b["r"].has_point(p):
   605				if b["en"]:
   606					_focus = i
   607					if sfx != null:
   608						sfx.play(str(b.get("snd", "k_click")), 0.7)
   609					b["cb"].call()
   610					return 1
