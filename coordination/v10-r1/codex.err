   234			var k1 := k0 + 0.06 * 1.25
   235			var c0 := Color(0.20, 0.12, 0.0, strength * 0.14 * ring)
   236			var c1 := Color(0.20, 0.12, 0.0, strength * 0.14 * (ring + 1))
