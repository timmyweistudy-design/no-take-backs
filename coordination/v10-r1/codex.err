    92	## 位置以外的條件（卡池、人數、單種、錢、防卡死），格子與自由共用。
    93	func _check_common(t: int) -> String:
    94		if t < 0 or t >= D.total() or (pool >> t) & 1 == 0:
    95			return E_POOL
    96		if count() >= unit_cap:
    97			return E_CAP_PREFIX + " %d 隻" % unit_cap
    98		if type_cap > 0 and count_of(t) >= type_cap:
    99			return E_TYPE_CAP_PREFIX + " %d 隻" % type_cap
   100		var hc := D.hard_cap(t)     # 第八輪：奇幻兵一隊的硬上限
   101		if hc > 0 and count_of(t) >= hc:
   102			return E_TYPE_CAP_PREFIX + " %d 隻" % hc
   103		if D.cost(t) > left():
   104			return E_GOLD
   105		if guard_combat and not D.is_combat(t) and not has_combat():
   106			var cc := cheapest_combat()
   107			if count() + 1 >= unit_cap or left() - D.cost(t) < cc:
   108				return E_RESERVE
   109		return ""
   110	
   111	## 第五輪：有沒有擺戰鬥兵（開戰條件：雙方各至少 1 隻）。
   112	func has_combat() -> bool:
   113		for u in units:
   114			if D.is_combat(int(u["type"])):
   115				return true

