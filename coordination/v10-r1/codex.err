   563	func _process_cmds() -> int:
   564		var done := 0
   565		_update_gen()
   566		var q := _cmds
   567		_cmds = []
   568		for c in q:
   569			if c["gen"] != _gen:
   570				# 畫面已經換了：丟掉。但「放開滑鼠」一定要清掉拖曳／塗兵狀態（Codex S1 #2）
   571				if c["kind"] == "mb" and not c["data"]["pressed"]:
   572					_mb_release_cleanup()
   573				elif c["kind"] == "padbtn" and not c["data"]["pressed"]:
   574					_fp_abort_drag()   # 手把放開 A／X 的事件過期：同樣清掉（Codex 實作第 3 輪 #1）
   575				continue
   576			if c["kind"] == "click":
   577				done += _do_click(c["data"])
   578			elif c["kind"] == "mb":
   579				# 滑鼠按鍵（擺放、拖曳、移除）也走同一個佇列，和鍵盤選兵的先後順序一致（Codex S1 #2）
   580				_mb_cmd(c["data"])
   581				done += 1
   582			elif c["kind"] == "paint":
   583				_paint_cmd(c["data"])
   584			elif c["kind"] == "padbtn":
   585				if not _fp_pad_button(int(c["data"]["b"]), bool(c["data"]["pressed"])) and c["data"]["pressed"]:
   586					var mp := {JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_B: KEY_ESCAPE}
   587					if mp.has(int(c["data"]["b"])):
   588						_key(mp[int(c["data"]["b"])])
   589				done += 1
   590			elif c["kind"] == "key":
   591				_key(int(c["data"]))
   592				done += 1
   593			_update_gen()
   594		return done
