    57	## 奇幻兵團預設（第八輪）：解鎖的奇幻軍優先，不足 10 種由舊兵補（先補戰鬥兵，免得全是奇襲兵開不了戰）。
    58	static func fantasy_pool(unlocked: int) -> int:
    59		var p := 0
    60		var n := 0
    61		for t in range(D.COUNT, D.total()):
    62			if RSET.has(unlocked, t):
    63				p |= 1 << t
    64				n += 1
    65		for t in [D.SWORD, D.SHIELD, D.ARCHER, D.CAVALRY, D.ASSASSIN, D.PIKE, D.BOMBER, D.BERSERKER, D.MEDIC, D.DRUMMER]:
    66			if n >= RSET.ROSTER_MAX:
    67				break
    68			if RSET.has(unlocked, t):
    69				p |= 1 << t
    70				n += 1
    71		return p
