    89	static func atk_progress(dt: float, type: int) -> float:
    90		var tm := atk_timing(type)
    91		var tot: float = tm[0]
    92		var w: float = tm[1]
    93		var st: float = tm[2]
    94		var rc := tot - w - st
    95		if dt < 0.0 or dt >= tot:
    96			return 0.0
    97		var a: float
    98		if dt < w:
    99			a = Art.ATK_WINDUP * dt / w
   100		elif dt < w + st:
   101			a = Art.ATK_WINDUP + (Art.ATK_STRIKE - Art.ATK_WINDUP) * (dt - w) / st
   102		else:
   103			a = Art.ATK_STRIKE + (1.0 - Art.ATK_STRIKE) * (dt - w - st) / rc
   104		return maxf(a, 0.001)
