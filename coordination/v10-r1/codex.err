   134			if not ev.echo or ev.keycode in [KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT]:
   135				var dk: int = Keymap.key_to_default(Save.s("keys"), ev.keycode)
   136				if dk >= 0:
   137					_enqueue("key", dk)
   138			return
   139		if ev is InputEventJoypadButton:
   140			var db: int = Keymap.pad_to_default(Save.s("pad"), ev.button_index)
   141			if db < 0:
   142				return
   143			ev = ev.duplicate()
   144			ev.button_index = db
   145		if ev is InputEventJoypadButton and _is_free() and overlay != "" and not ev.pressed and ev.button_index in [JOY_BUTTON_A, JOY_BUTTON_X]:
   146			_fp_abort_drag()   # 覆蓋層開著時放開 A／X：清掉拖曳狀態（Antigravity 實作第 1 輪 #2）
   147		if ev is InputEventJoypadButton and _is_free() and overlay == "" and ev.button_index in [JOY_BUTTON_A, JOY_BUTTON_X, JOY_BUTTON_B, JOY_BUTTON_Y, JOY_BUTTON_LEFT_STICK, JOY_BUTTON_RIGHT_STICK, JOY_BUTTON_DPAD_UP, JOY_BUTTON_DPAD_DOWN, JOY_BUTTON_DPAD_LEFT, JOY_BUTTON_DPAD_RIGHT]:
   148			pad_mode = true
   149			_enqueue("padbtn", {"b": ev.button_index, "pressed": ev.pressed})   # 第六輪：自由排兵要知道按下與放開
   150			return
   151		if ev is InputEventJoypadButton and ev.pressed:
   152			pad_mode = true
   153			last_joy = ev.device
   154			var map := {JOY_BUTTON_DPAD_UP: KEY_UP, JOY_BUTTON_DPAD_DOWN: KEY_DOWN, JOY_BUTTON_DPAD_LEFT: KEY_LEFT,
   155				JOY_BUTTON_DPAD_RIGHT: KEY_RIGHT, JOY_BUTTON_A: KEY_ENTER, JOY_BUTTON_B: KEY_ESCAPE, JOY_BUTTON_X: KEY_BACKSPACE,
   156				JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_Y: KEY_TAB, JOY_BUTTON_LEFT_SHOULDER: KEY_Q, JOY_BUTTON_RIGHT_SHOULDER: KEY_E,
   157				JOY_BUTTON_BACK: KEY_F1}
   158			if map.has(ev.button_index):
   159				_enqueue("key", map[ev.button_index])
   160			return
   161		if ev is InputEventJoypadMotion and ev.axis == JOY_AXIS_RIGHT_Y and overlay == "codex" and absf(ev.axis_value) > 0.3:
   162			pad_mode = true
   163			_scroll_by("left", ev.axis_value * 24.0)   # 右搖桿捲圖鑑左欄
   164			return
   165		if ev is InputEventJoypadMotion and (ev.axis == JOY_AXIS_LEFT_X or ev.axis == JOY_AXIS_LEFT_Y):
   166			# 左搖桿：只記下狀態，由 _stick_repeat 依固定節奏送方向鍵（Codex S1 #6：原本每個抖動事件都會送一次）
   167			stick[ev.axis] = ev.axis_value
   168			if absf(ev.axis_value) > 0.6:
   169				pad_mode = true
