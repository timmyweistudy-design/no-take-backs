   173	## 塗兵（佇列命令）：按住拖過格子連續擺。
   174	func _paint_cmd(p: Vector2) -> void:
   175		if _is_free():
   176			if overlay == "":
   177				_fp_motion(p)
   178			return
   179		if state != St.PLACE or overlay != "" or not painting:
   180			return
   181		if _cur_army().team != paint_team:
   182			painting = false
   183			return
   184		var c := _cell_at(p)
   185		if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   186			_try_place(c)
   187	
