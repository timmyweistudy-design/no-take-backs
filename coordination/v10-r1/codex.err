   146	## 第十輪 R1：試玩版的範圍集中在這裡。匯入的規則與陣型都走這條。
   147	func _demo_ok(r, a = null) -> bool:
   148		var mask: int = RS.unlocked_mask(1 << 20, true)
   149		if r != null:
   150			if not r.map_id in Presets.DEMO_MAPS:
   151				return false
   152			if r.pool_of(0) & ~mask != 0 or r.pool_of(1) & ~mask != 0:
   153				return false
   154		if a != null:
   155			for u in a.units:
   156				if not RuleSet.has(mask, int(u["type"])):
   157					return false
   158		return true
