    23	
    24	static func make(id: String, kind: String, unlocked: int):
    25		var r = RSET.standard(unlocked & RSET.all_pool())   # 標準只含舊 10 種
    26		r.preset = id
    27		r.rounds = 3
    28		r.place_rule = "snake5"
    29		# 第六輪（方案 §9-5）：大廳預設「自由排兵」；格子留在部署分頁當選項
    30		r.deploy = "free"
    31		r.spacing = FREE_SPACING
    32		r.depth = FREE_DEPTH
    33		match id:
    34			"standard":
    35				if kind == "duel":
    36					r.pool = [31, 31]       # 雙人標準＝經典 5 種（唯一驗證過公平的組合）
    37			"classic5":
    38				r.pool = [31, 31]
    39			"fantasy":
    40				var fp := fantasy_pool(unlocked)
    41				r.pool = [fp, fp]
    42			"small":
    43				r.budget = [50, 50]
    44				r.unit_cap = 12
    45				r.ticks = 1200
    46			"big":
    47				r.budget = [180, 180]
    48				r.unit_cap = 40
    49				r.ticks = 2400
    50			"single":
    51				# 單兵種對決：只開 1 種戰鬥兵（劍士）＋1 種支援兵（醫者）；卡池分頁可以換
    52				r.pool = [(1 << D.SWORD) | (1 << D.MEDIC), (1 << D.SWORD) | (1 << D.MEDIC)]
    53		if kind == "duel":
    54			r.ai_pool_same = true
    55		return r
