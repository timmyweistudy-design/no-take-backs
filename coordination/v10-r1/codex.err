   179	## 第十輪 I5：遠征存點。少欄位或型別不對就當沒有。
   180	static func sanitize_run(g) -> Dictionary:
   181		if not g is Dictionary:
   182			return {}
   183		var out := {}
   184		for k in ["stage", "seed", "gold", "cap", "changes", "pool"]:
   185			var v = g.get(k)
   186			if not (v is int or v is float):
   187				return {}
   188			out[k] = int(v)
   189		if out["stage"] < 2 or out["stage"] > 7 or out["gold"] < 0 or out["gold"] > 70 or out["cap"] < 0 or out["cap"] > 14:
   190			return {}
   191		var raw = g.get("prev")
   192		if not raw is Array or raw.size() > 80:
   193			return {}
   194		var prev: Array = []
   195		for u in raw:
   196			if not u is Dictionary or not u.has("type"):
   197				return {}
   198			var o := {}
   199			for k2 in u:
   200				var v2 = u[k2]
   201				if not (v2 is int or v2 is float):
   202					return {}
   203				o[str(k2)] = int(v2)
   204			prev.append(o)
   205		out["prev"] = prev
   206		return out
