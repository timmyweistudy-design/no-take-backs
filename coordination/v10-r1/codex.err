    79	func _star_above(c: Vector2) -> void:
    80		var r := 6.0 + sin(time * 6.0) * 1.0
    81		var pts := PackedVector2Array()
    82		for i in 10:
    83			var an := -PI / 2 + i * TAU / 10.0
    84			pts.append(c + Vector2(cos(an), sin(an)) * (r if i % 2 == 0 else r * 0.45))
    85		draw_colored_polygon(pts, Color(1, 0.88, 0.3))
    86	
