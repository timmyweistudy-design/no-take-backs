   112	
   113	## 回傳 {ok, rules, army}。陣型一定要照那組規則合法。
   114	func _challenge_decode(c: String) -> Dictionary:
   115		var bad := {"ok": false}
   116		var parts := c.split(".")
   117		if c.length() > 6000 or parts.size() != 3 or parts[0] != "NTC1" or parts[1].sha256_text().substr(0, 6) != parts[2]:
   118			return bad
   119		var b64 := parts[1].replace("-", "+").replace("_", "/")
   120		while b64.length() % 4 != 0:
   121			b64 += "="
   122		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
   123		if not j is Dictionary or not j.get("a") is String or not j.get("r") is String:
   124			return bad
   125		var rd: Dictionary = RuleSet.from_code(str(j["r"]))
   126		if not rd["ok"] or rd["rules"].fullfield != RuleSet.FULL_NONE:
   127			return bad      # 全場規則是雙方互相看得到才成立，不能當挑戰碼（Codex r2 #3）
   128		var r = rd["rules"]
   129		r.ai_pool_same = false
   130		# 碼是對方當藍軍排的，到這裡他變紅軍：兩邊的預算、卡池要對調（讓子局才有差，Codex #10）
   131		var b0: int = r.budget_of(0)
   132		var b1: int = r.budget_of(1)
   133		var p0: int = r.pool_of(0)
   134		var p1: int = r.pool_of(1)
   135		r.budget = [b1, b0]
   136		r.pool = [p1, p0]
   137		var a = Army.new(1, r.budget_of(1))
   138		a.apply_rules(r, 1)
   139		a.pool = RuleSet.full_pool()     # 朋友的牌不必在自己的解鎖範圍內
   140		if a.load_code(str(j["a"])) != "" or not a.has_combat():
   141			return bad
   142		if _demo() and not _demo_ok(r, a):
   143			return bad      # 第十輪 B7：試玩版不能靠挑戰碼帶進正式版內容
   144		return {"ok": true, "rules": r, "army": a}
