   246	func _add_fx(d: Dictionary) -> void:
   247		if bool(Save.s("reduce_fx")) and d["kind"] in ["dust", "puff", "shard", "ripple", "note", "hex", "aim", "trip", "spore", "wool", "soulrise"]:
   248			return   # 第七輪 K3：簡化特效少掉粒子與裝飾，保留攻擊本身與嘲諷
   249		var pr: int = FX_PRIO.get(d["kind"], 1)
   250		# 同一處同種特效去重（Antigravity S2 #2）：24px 內、0.15 秒內最多 2 個
   251		var dp = d.get("p", d.get("b", null))
   252		if dp != null and not d.has("src"):   # 帶攻擊者的（砍擊、箭）不去重：每一次攻擊都要有演出
   253			var same := 0
   254			for f0 in fx:
   255				if f0["kind"] == d["kind"] and f0["t"] < 0.15:
   256					var fp = f0.get("p", f0.get("b", null))
   257					if fp != null and fp.distance_to(dp) < 24.0:
   258						same += 1
   259			if same >= 2:
   260				fx_deduped += 1
   261				return
   262		var n := 0
   263		for f in fx:
   264			if f["kind"] != "text":
   265				n += 1
   266		if n >= FX_CAP:
   267			var victim := -1
   268			for k in fx.size():
   269				var f2: Dictionary = fx[k]
   270				if f2["kind"] == "text":
   271					continue
   272				var p2: int = FX_PRIO.get(f2["kind"], 1)
   273				if p2 < 2 and (victim < 0 or p2 < FX_PRIO.get(fx[victim]["kind"], 1) or (p2 == FX_PRIO.get(fx[victim]["kind"], 1) and f2["t"] > fx[victim]["t"])):
   274					victim = k
   275			if victim >= 0 and FX_PRIO.get(fx[victim]["kind"], 1) <= pr:
   276				fx.remove_at(victim)
   277				fx_dropped += 1
   278			elif pr < 2:
   279				fx_dropped += 1
   280				return
   281			else:
   282				# 全部都是關鍵特效：取代最舊的那個（硬上限，Codex S1 #5）
   283				var oldest := -1
   284				for k3 in fx.size():
   285					if fx[k3]["kind"] != "text" and (oldest < 0 or fx[k3]["t"] > fx[oldest]["t"]):
   286						oldest = k3
   287				fx.remove_at(oldest)
   288				fx_dropped += 1
   289		fx.append(d)
   290	
