   110	## 大廳卡池能選的兵：對 AI＝已解鎖的；雙人＝全部（試玩版＝前 7 種）。
   111	static func selectable(kind: String, unlocked: int, demo: bool) -> int:
   112		var all_p: int = (RSET.prefix_pool(7) | (1 << 11)) if demo else RSET.full_pool()   # 試玩版：舊 7 種＋爆爆羊
   113		return (unlocked & all_p) if kind == "ai" else all_p
