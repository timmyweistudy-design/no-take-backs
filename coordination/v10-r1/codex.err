    99	func _accept_challenge(c := "") -> void:
   100		var from_clip := c == ""
   101		if from_clip:
   102			c = DisplayServer.clipboard_get().strip_edges()
   103		var d := _challenge_decode(c.strip_edges())
   104		if not d["ok"]:
   105			if not (from_clip and _ask_code(L.t("ch_accept"), _accept_challenge)):
   106				_toast(L.t("ch_bad"), true)
   107			return
