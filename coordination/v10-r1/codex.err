   148	## 暫停時點一隻兵看狀態（第七輪 A6）。
   149	func _draw_unit_info() -> void:
   150		if not paused or follow_id < 0 or view == null:
   151			return
   152		var u = view.unit_by_id(follow_id)
   153		if u == null:
   154			return
   155		var tname := L.t("ui_none")
   156		if u.target >= 0 and u.target < view.units.size() and view.units[u.target].alive:
   157			tname = L.t("unit_%d" % view.units[u.target].type)
   158		var lines: Array = [
   159			"%s（%s）" % [L.t("unit_%d" % u.type), L.t("blue") if u.team == 0 else L.t("red")],
   160			L.t("ui_hp", [u.hp, u.max_hp]),
   161			L.t("ui_target", [tname]),
   162			L.t("ui_cd", ["%.1f" % (u.cd / 80.0)]),
   163			L.t("ui_stats", [u.dmg_dealt, u.kills]),
   164		]
   165		var R := Rect2(980, 96, 286, 16 + lines.size() * tz("S") * 1.4)
   166		draw_rect(R, Color(TH_WOOD_D, 0.94))
   167		draw_rect(R, Color(Art.team_color(u.team, cbm()), 0.9), false, 2.0)
   168		for i in lines.size():
   169			_text(R.position + Vector2(10, 8 + i * tz("S") * 1.4), lines[i], tz("S"), Color.WHITE, false, i == 0, 266)
