+## 第十輪 R1：試玩版的範圍集中在這裡。匯入的規則與陣型都走這條。
+func _demo_ok(r, a = null) -> bool:
+	var mask: int = RS.unlocked_mask(1 << 20, true)
+	if r != null:
+		if not r.map_id in Presets.DEMO_MAPS:
