   115	## 把規則裡不能選的兵拿掉（解鎖進度、試玩版）；拿掉後沒有戰鬥兵就退回可選的全部。回傳被拿掉的兵種。
   116	static func clamp_pool(r, kind: String, unlocked: int, demo: bool) -> Array:
   117		var sel := selectable(kind, unlocked, demo)
   118		var removed: Array = []
   119		for tm in 2:
   120			var p := int(r.pool[tm])
   121			for t in D.total():
   122				if RSET.has(p, t) and not RSET.has(sel, t) and not t in removed:
   123					removed.append(t)
   124			p &= sel
   125			if not RSET.has_combat(p):
   126				p = sel
   127			r.pool[tm] = p
   128		return removed
