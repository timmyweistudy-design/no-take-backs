   333	func _throttle_when_minimized() -> void:
   334		var mini: bool = DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_MINIMIZED
   335		if mini != _was_minimized:
   336			_was_minimized = mini
   337			Engine.max_fps = 10 if mini else 0
   338	
   339	
   340	
   341	func _process(delta: float) -> void:
   342		_throttle_when_minimized()
   343		_rv_poll()
   344		_settings_hover()
   345		var _t0 := Time.get_ticks_usec()
   346		_process_inner(delta)
   347		perf_proc_us = Time.get_ticks_usec() - _t0
   348	
   349	
   350	func _process_inner(delta: float) -> void:
   351		_stick_repeat(delta)
   352		_process_cmds()
   353		time += delta
   354		SteamApi.run_callbacks()
   355		if toast_t > 0:
   356			toast_t -= delta
   357		if removed_banner_t > 0.0:
   358			removed_banner_t -= delta
   359		if ach_t > 0:
   360			ach_t -= delta
   361		elif not ach_queue.is_empty():
   362			toast = ach_queue.pop_front()
   363			toast_t = 2.5
   364			ach_t = 2.6
   365		shake = maxf(0.0, shake - delta)
   366		if not freeze_fx:
   367			for f in fx:
   368				f["t"] += delta
   369				if f.has("pop"):
   370					f["pop"] = maxf(0.0, f["pop"] - delta)
   371			fx = fx.filter(func(f): return f["t"] < f["dur"])
   372			clutch_t = maxf(0.0, clutch_t - delta)
   373		for g in dying:
   374			g["t"] += delta
   375			if g["t"] >= 1.0:
   376				graves.append({"pos": g["pos"], "team": g["team"], "t": 0.0})
   377		dying = dying.filter(func(g): return g["t"] < 1.0)
   378		for g in graves:
   379			g["t"] += delta
   380		graves = graves.filter(func(g): return g["t"] < 3.0)
   381		if overlay == "codex":
   382			_codex_tick(delta)
   383		if overlay == "ai_busy":
   384			_ai_poll()
   385		if state == St.TITLE and demo != null and shot_dir == "":
   386			demo_acc += delta
   387			while demo_acc >= 0.05:
   388				demo_acc -= 0.05
   389				demo.step()
   390			if demo.finished:
   391				_new_demo()
   392		if state == St.BATTLE and shot_dir == "":
   393			_battle_process(delta)
   394			_follow_update(delta)
   395		elif state == St.RESULT:
   396			zoom = lerpf(zoom, 1.0, delta * 4)
   397		if font_bold != null:
   398			_layout_texts()   # 戰鬥事件產生跳字之後才排版，新跳字第一幀就有位置（Codex S1 #3）
   399		queue_redraw()
   400	
   401	
