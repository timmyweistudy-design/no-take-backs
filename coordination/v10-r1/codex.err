   181	func _try_place(c: Vector2i) -> void:
   182		var why := _check_place(selected, c)
   183		if why == "":
   184			if mode == Mode.DUEL and tp != null:
   185				# 第五輪防手滑（Antigravity 第二輪）：輪流落子時先點一下出現預覽，再點同一格才落子；設定可關。擺下仍不能收回。
   186				if bool(Save.s("confirm_place")) and pending_cell != c:
   187					pending_cell = c
   188					sfx.play("k_click", 0.7)
   189					return
   190				pending_cell = Vector2i(-1, -1)
   191				tp.place(selected, c.x, c.y)
   192			else:
   193				_cur_army().place(selected, c.x, c.y)
   194			show_place_help = false
   195			sfx.play(["place_mid", "place_heavy", "place_light", "place_heavy", "place_light", "place_heavy", "place_light", "place_light", "place_light", "place_heavy"][selected])
   196		elif why != L.t("err_taken"):
   197			_toast(why, true)
