    69	func in_zone(col: int, row: int) -> bool:
    70		if row < 0 or row >= ROWS:
    71			return false
    72		if team == 0:
    73			return col >= 0 and col < ZONE
    74		return col >= COLS - ZONE and col < COLS
    75	
    76	func index_at(col: int, row: int) -> int:
