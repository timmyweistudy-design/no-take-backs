   184	func _draw_field() -> void:
   185		var free_f: bool = rules != null and rules.is_free() and (mode == Mode.VS_AI or mode == Mode.DUEL)   # 第六輪：自由排兵不畫格子
   410	func _draw_inner() -> void:
   411		_btns.clear()
   412		probe_texts.clear()
   413		probe_btns.clear()
   414		probe_ctrls.clear()
   415		_probe_ui = false
   416		draw_rect(Rect2(0, 0, 1280, 800), Color("#1b2a1f"))
   417		_sync_field()
   418		var fxf := _fld_xf()
   419		var cam := fxf
   420		if state == St.BATTLE or state == St.RESULT:
   421			var off := Vector2.ZERO
   422			if shake > 0 and _fx_on("shake"):
   423				off = Vector2(sin(time * 90) * 2, cos(time * 77) * 2)
   424			var w := clampf((zoom - 1.0) / 0.5, 0.0, 1.0)
   425			var c := (ORIGIN + FIELD / 2).lerp(fxf * zoom_center, w)
   426			var half := Vector2(640, 388) / zoom
   427			var anchor := Vector2(640, 388 + BATTLE_DY)
   428			var lo := ORIGIN + half - Vector2(60, 100)
   429			var hi := ORIGIN + FIELD - half + Vector2(60, 100)
   430			c = Vector2(clampf(c.x, minf(lo.x, hi.x), maxf(lo.x, hi.x)), clampf(c.y, minf(lo.y, hi.y), maxf(lo.y, hi.y)))
   431			cam = Transform2D(0, Vector2(zoom, zoom), 0, anchor - c * zoom + off) * fxf
   432		if state == St.TITLE:
   433			# 第七輪 D4：示範戰場縮小放右邊，不被左側面板壓到
   434			cam = Transform2D(0, Vector2(0.72, 0.72), 0, Vector2(1270.0 - (ORIGIN.x + FIELD.x) * 0.72, 400.0 - (ORIGIN.y + FIELD.y / 2.0) * 0.72))
   435		draw_set_transform_matrix(cam)
   436		_cam = cam
   437		Art.base = cam
   438		var _t := Time.get_ticks_usec()
   439		_draw_field()
   440		perf_parts["field"] = Time.get_ticks_usec() - _t
   441		_t = Time.get_ticks_usec()
   442		if state == St.TITLE:
   443			_draw_units_of(demo, true)
   444		elif state == St.PLACE:
   445			if _is_free():
   446				_fp_draw_zones()   # 第六輪：自由排兵
   447				_fp_draw()
   448			else:
   449				_draw_place_units()
   450				_draw_tactical()
