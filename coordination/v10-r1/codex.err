   153	
   154	func _err_key(why: String) -> String:
   155		if why == "":
   156			return ""
   157		if why == Army.E_ZONE:
   158			return L.t("err_zone")
   159		if why == Army.E_TERRAIN:
   160			return L.t("err_terrain")
   161		if why == Army.E_TAKEN:
   162			return L.t("err_taken")
   163		if why.begins_with(Army.E_CAP_PREFIX):
   164			return L.t("err_max", [_cur_army().unit_cap])
   165		if why.begins_with("這種兵最多"):
   166			return L.t("err_type_cap", [_cur_army().type_cap])
   167		if why.begins_with("這種兵不在"):
   168			return L.t("err_type")
   169		if why.begins_with("要留錢"):
   170			return L.t("err_reserve")
   171		if why.begins_with("最後一手"):
   172			return L.t("err_last_hand")
   173		if why == Army.E_GOLD:
   174			return L.t("err_gold")
   175		if why.begins_with("這一手"):
   176			return L.t("err_hand", [tp.hand_cap() if tp else 10])
   177		return why
