    16	func _skip_step() -> void:
    17		var t0 := Time.get_ticks_msec()
    18		while not view.finished and Time.get_ticks_msec() - t0 < 10:
    19			_sim_step(false)
    20		if view.finished:
    21			skip_busy = false
    22			result_delay = 9.0
    23	
    24	
    25	## 第十輪 I4：重播的全長在背景算，算完才開始播。
    26	func _pre_join() -> void:
    27		if pre_thread != null:
    28			var v = pre_thread.wait_to_finish()
    29			pre_thread = null
    30			if v != null:
    31				replay_total = int(v)
    32	
    33	func _exit_tree() -> void:
    34		_pre_join()
    35		if ai_thread != null:
    36			ai_thread.wait_to_finish()
    37			ai_thread = null
    38	
    39	func _battle_process(delta: float) -> void:
    40		if pre_thread != null:
    41			if pre_thread.is_alive():
    42				return
    43			_pre_join()
    44		if view != null:
    45			_gait_frame(delta)   # 不能放在只有部分情況才跑的地方（Codex P2 #1）
    46		if start_hold > 0.0:
    47			start_hold -= delta
    48			return
    49		if call("_seek_pump"):
    50			return
    51		if skip_busy:
    52			_skip_step()
    53			return
    54		if paused:
    55			return
    56		if hitstop > 0:
    57			hitstop -= delta
    58			return
    59		var rate := speed
    60		if slow_left > 0:
    61			rate *= 0.5
    62			slow_left -= delta
    63		if final_left > 0:
    64			rate *= 0.25      # 第十輪 F1：最後一擊
    65			final_left -= delta
    66			_update_action_focus()
    67		accum += delta * rate
    68		while accum >= 0.05 and not view.finished:
    69			accum -= 0.05
    70			var was_slow := slow_left > 0
    71			_sim_step(true)
    72			if slow_left > 0 and not was_slow:
    73				break   # 這一 tick 觸發慢動作：剩下的累積留到下一幀用慢速消耗（Codex S8 #3）
    74		# 播完之後展示時鐘繼續走（不再推進快照）：最後一格的位置插值與最後一擊的後搖要演完（Codex R5 #1）
    75		# 最後時刻只在 _sim_step 每個畫面 tick 判定（Codex S8 #1：每幀也判會讓觸發 tick 跟幀率有關）
    76		if slow_left > 0:
    77			_update_action_focus()
    78		sfx.set_muffled(slow_left > 0 and not view.finished)
    79		# 分軌音樂依戰況混音（第三輪 S1）
    80		var close := absf(view.power(0) * 100.0 / (view.budget_of(0) * 1000) - view.power(1) * 100.0 / (view.budget_of(1) * 1000)) <= 15.0
    81		sfx.set_layer_targets(sfx.layer_targets(close, slow_left > 0 and not view.finished))
    82		# 鏡頭只有一個決策點（Codex S5 #6）：跟拍優先於最後時刻框選，兩者都沒有才回到全景
    83		if follow_id >= 0:
    84			pass   # 由 _follow_update 決定
    85		elif slow_left > 0 and not view.finished:
    86			_frame_alive(delta)
    87		else:
    88			zoom_target = 1.0
    89			zoom_center = zoom_center.lerp(ORIGIN + fld_size / 2, minf(1.0, delta * 3))
    90		zoom = lerpf(zoom, zoom_target, delta * 3)
    91		if view.finished:
    92			result_delay += delta
    93			if result_delay > 1.4:
    94				on_battle_finished.call()
    95	
    96	
    97	
    98	## with_fx＝false（直接看結果、重播跳轉補播）只記狀態與標記，不放慢動作、不播音效、不出橫幅（Codex S8 #2）。
    99	func _check_clutch(with_fx := true) -> void:
   100		if slow_used or view.finished:
   101			return
   102		if clutch_cond(view):
   103			slow_used = true
   104			clutch_tick = view.tick
   105			battle_marks.append({"tick": view.tick, "kind": "clutch", "team": -1})
   106			if not with_fx:
   107				return
   108			if _fx_on("slowmo"):
   109				slow_left = 8.0
   110			clutch_t = 1.6   # 最後時刻橫幅（第三輪 V2）：獨立一層畫在 _draw_clutch_banner
   111			sfx.play("clutch")
   112	
   113	
   114	
   115	## 鏡頭安全框（優化方案 F2）：把所有存活單位框進畫面，四周留 15%。
   116	func _frame_alive(delta: float) -> void:
   117		var lo := Vector2(1e9, 1e9)
   118		var hi := Vector2(-1e9, -1e9)
   119		for u in view.units:
   120			if u.alive:
   121				var p := _upos(u)
   122				lo = lo.min(p - Vector2(30, 70))
   123				hi = hi.max(p + Vector2(30, 20))
   124		var size := (hi - lo) / 0.7
   125		zoom_target = clampf(minf(1280.0 / maxf(1, size.x), 620.0 / maxf(1, size.y)) * 1.05, 1.08, 1.55)   # 再往勝負焦點收 5%（V2）
   126		zoom_center = zoom_center.lerp((lo + hi) / 2, minf(1.0, delta * 3))
   127	
   128	
   129	
   130	## 第十輪 F1：模擬領先畫面 DELAY 個 tick，已知全滅就在倒下前放慢。和局、逾時、同歸於盡都不演。
   131	func _check_final(with_fx: bool) -> void:
   132		if final_used or not with_fx or not sim.finished or sim.winner < 0 or sim.reason != "全滅":
   133			return
   134		final_used = true
   135		if _fx_on("slowmo"):
   136			final_left = 0.6
   137	
   138	## 畫面前進一個 tick：模擬保持領先 DELAY 個 tick，畫面播最舊的那一份快照（R5 展示緩衝）。
   139	func _sim_step(with_fx: bool) -> void:
   140		_pump_view()
   141		_check_final(with_fx)
   142		for u in view.units:
   143			prev_pos[u.id] = Vector2(u.x, u.y)
   144		if not view.advance():
   145			view.finished = true
   146			return
   147		_gait_tick(with_fx)
   148		_pump_view()
   149		_check_clutch(with_fx)   # 每一個畫面 tick 都判定（原本每一幀判一次，觸發的 tick 會跟幀率有關）
   150		if view.frenzy and not frenzy_seen:
   151			frenzy_seen = true
   152			if with_fx:
   153				_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
   154				sfx.play("frenzy")
   155				sfx.play_music("music_frenzy")
   156		var deaths := 0
   157		for ev in view.events:
   158			var k: String = ev["kind"]
   159			if ev.has("src"):
   160				var s = view.unit_by_id(ev["src"])
   161				var key := "%s%d" % [k, s.team]
   162				ev_count[key] = int(ev_count.get(key, 0)) + 1
   163				if k == EV.BLAST and not ev.has("dmg"):   # 第八輪：爆炸演出一筆一次；逐目標傷害不算次數（BOOM_5）
   164					ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
   165			if k == EV.DEATH:
   166				deaths += 1
   167			_collect_mark(ev, view, view.tick)
   168			_on_event(ev, with_fx)
   169		# 碾壓局最後一擊（優化方案 F1）：0.2 秒頓格＋微震，直接進結算
   170		if view.finished and (not slow_used or final_used) and deaths > 0 and with_fx:
   171			hitstop = 0.2
   172			if bool(Save.s("shake")):
   173				shake = 0.15
   174	
   175	
   176	
   177	## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
   178	func _pump_view() -> void:
   179		for fr in view.pump(sim):
   180			for e in fr["events"]:
   181				# 第四輪：補血、戰鼓也走出手動畫；被貼身敲人、破陣、補血、戰鼓用專屬動作（variant 2）
   182				if e["kind"] == EV.HEAL or e["kind"] == EV.DRUM or e["kind"] == EV.BONK or e.get("tags", []).has(EV.BREACH):
   183					var ah: Dictionary = alt_hit.get(e["src"], {})
   184					ah[int(fr["tick"])] = true
   185					if ah.size() > 8:
   186						ah.erase(ah.keys().min())
   187					alt_hit[e["src"]] = ah
   188				if event_route(e) == "attack" or e["kind"] == EV.HEAL or e["kind"] == EV.DRUM:
   189					var hs: Array = atk_hit.get(e["src"], [])
   190					hs.append(int(fr["tick"]))
   191					if e["kind"] == EV.BOMB:
   192						# 投彈兵（第四輪 §4.4）：記下命中 tick → 目標，前搖期間畫火罐飛過去，命中那一刻剛好落地
   193						var bt: Dictionary = bomb_tgt.get(e["src"], {})
   194						bt[int(fr["tick"])] = e["tgt"]
   195						if bt.size() > 6:
   196							bt.erase(bt.keys().min())
   197						bomb_tgt[e["src"]] = bt
   198					# 每隻單位的第幾次出手（交替招式用，Codex S4 #2：原本用 tick 奇偶，連續反擊會同招）
   199					var sq: Dictionary = atk_seq.get(e["src"], {})
   200					sq[int(fr["tick"])] = sq.size()
   201					atk_seq[e["src"]] = sq   # 存序列，不覆蓋還沒播到的命中（Codex R5 #2：連續反擊）
   202					if hs.size() > 4:
   203						hs.pop_front()
   204					atk_hit[e["src"]] = hs
   205	
   206	
   207	
   208	## 事件分流（Codex R3 審查 #1）：只有帶 dmg 的才是攻擊；背水開關沒有 src；嘲諷、現形、繞翼只有演出。
   209	## 回傳 "death"／"skip"／"taunt"／"reveal"／"attack"。測試會把真實戰鬥的每一種事件都丟進來檢查。
   210	static func event_route(ev: Dictionary) -> String:
   211		var k: String = ev.get("kind", "")
   212		if k == EV.DEATH:
   213			return "death"
   214		if k == EV.TAUNT or k == EV.REVEAL:
   215			return k if ev.has("src") and ev.has("tgt") else "skip"
   216		if ev.has("dmg") and ev.has("src") and ev.has("tgt"):
   217			return "attack"
   218		return "skip"
   219	
   220	
   221	
   222	## 第八輪的事件演出。回傳 true＝處理掉了。全部受簡化特效限制（_add_fx 會擋裝飾性的）。
   223	func _on_event_v8(ev: Dictionary, k: String, with_fx: bool) -> bool:
   224		if not k in [EV.POISON, EV.BLAST, EV.VOODOO, EV.BITE, EV.MIMIC_OPEN, EV.SPLIT, EV.CAST, EV.TIMESTOP, EV.RAISE, EV.VACUUM, EV.STOMP, EV.ROCK]:
   225			return false
     1	extends "res://scripts/ui/codex_view.gd"
     2	## 回味（第三輪 S5）：重播控制、對戰代碼、覆盤。
     3	## ・重播控制（F2）：重播與覆盤的戰鬥底部有控制列：暫停、0.5／1／2 倍速、點時間軸跳到任一秒（從頭快轉，
     4	##   展示與音效狀態全部清空重建）、點一隻兵讓鏡頭跟它（再點空地取消）。
     5	## ・對戰代碼（F3）：結果頁複製；標題「觀看對戰代碼」從剪貼簿讀，版本不同會提示。
     6	## ・覆盤（F1）：只限「對 AI」。結果頁按「覆盤」，改一隻兵（換兵種、移一格或拿掉），按「重算」並排兩條時間軸；
     7	##   可以「播放如果」看那一場。覆盤只看不算：比分、進度、成就、日誌都不寫（副作用矩陣 review）。
     8	
     9	const BattleCode = preload("res://scripts/game/battle_code.gd")
    10	const RC_BAR := Rect2(330, 708, 900, 28)   # 時間軸拖曳條
    11	
    12	# 覆盤狀態
    13	var rv_army = null          # 正在改的藍方陣型
    14	var rv_orig = null          # 原本的藍方陣型
    15	var rv_enemy = null         # 對手陣型（不變）
    16	var rv_sel := Vector2i(-1, -1)
    17	var rv_result := {}         # {winner, rem, log}
    18	var rv_base := {}           # 原本那一場（打開覆盤時用同一組陣型重算，不依賴目前的 sim）
    19	var rv_last: Array = []     # 覆盤播放用的雙方陣型（重播覆盤時用）
    20	
    21	
    22	# ── 重播控制 ──
    23	func _replay_controls_active() -> bool:
    24		return state == St.BATTLE and play_kind != "official" and view != null
    25	
    26	func _draw_replay_controls() -> void:
    27		if not _replay_controls_active():
    28			return
    29		draw_rect(Rect2(0, 696, 1280, 52), Color(TH_WOOD_D, 0.94))
    30		_btn(Rect2(20, 704, 70, 36), "▶" if paused else "Ⅱ", func(): paused = not paused)
    31		var sp := [0.5, 1.0, 2.0]
    32		for i in 3:
    33			_btn(Rect2(98 + i * 74, 704, 68, 36), "%s×" % _fmt_num(sp[i]), func(): speed = sp[i], true, false,
    34				Color(0.45, 0.3, 0.12) if is_equal_approx(speed, sp[i]) else Color(0, 0, 0, 0))
    35		# 時間軸：拉鋸色帶（模擬已跑到的部分）＋目前位置
    36		var total := float(maxi(1, replay_total if replay_total > 0 else view.max_ticks))   # 以這一場實際長度為滿
    37		draw_rect(RC_BAR, Color(0, 0, 0, 0.5))
    38		var tot := 1000.0
    39		var n: int = sim.power_log.size()
    40		for i in int(RC_BAR.size.x / 3.0):
    41			var t := int(i * 3.0 / RC_BAR.size.x * total)
    42			if t >= n:
    43				break
    44			var d: float = clampf(float(sim.diff_permille(t)) / tot * 2.0, -1.0, 1.0)
    45			var h := absf(d) * RC_BAR.size.y / 2.0
    46			draw_rect(Rect2(RC_BAR.position.x + i * 3.0, RC_BAR.get_center().y - (h if d > 0 else 0.0), 3.0, h), Color(Art.team_color(0 if d > 0 else 1, cbm()), 0.8))
    47		var cx := RC_BAR.position.x + RC_BAR.size.x * clampf(float(view.tick) / total, 0.0, 1.0)
    48		draw_line(Vector2(cx, RC_BAR.position.y - 3), Vector2(cx, RC_BAR.end.y + 3), ACCENT, 3.0)
    49		var hz := fit(L.t("rc_hint"), ts(12), 560)
    50		var hw := font.get_string_size(L.t("rc_hint"), HORIZONTAL_ALIGNMENT_LEFT, -1, hz).x
    51		_text(Vector2(RC_BAR.end.x - hw, RC_BAR.position.y - hz * 1.5), L.t("rc_hint"), hz, Color(1, 1, 1, 0.6))
    52		# 第七輪 A7：時間軸上的關鍵時刻刻度
    53		for m in replay_marks:
    54			var mx := RC_BAR.position.x + RC_BAR.size.x * clampf(float(m["t"]) / total, 0.0, 1.0)
    55			draw_line(Vector2(mx, RC_BAR.position.y), Vector2(mx, RC_BAR.end.y), Color("#ffd166"), 2.0)
    56			draw_colored_polygon(PackedVector2Array([Vector2(mx - 5, RC_BAR.position.y - 7), Vector2(mx + 5, RC_BAR.position.y - 7), Vector2(mx, RC_BAR.position.y)]), Color("#ffd166"))
    57		# 整條是一個按鈕：點哪裡就跳到哪一秒
    58		_btns.append({"r": RC_BAR, "cb": func(): _seek_async(int(clampf((mouse.x - RC_BAR.position.x) / RC_BAR.size.x, 0.0, 1.0) * total)), "en": true})
    59		_text(Vector2(RC_BAR.position.x, RC_BAR.end.y + 2), "%.1f／%.1f 秒" % [view.tick / 20.0, total / 20.0] if L.lang == "zh_TW" else "%.1f / %.1fs" % [view.tick / 20.0, total / 20.0], ts(12), Color(1, 1, 1, 0.75))
    60		if play_kind == "review":
    61			_text(Vector2(640, 92), L.t("review_tag"), ts(16), ACCENT, true, true, 600)
    62		if follow_id >= 0:
    63			_text(Vector2(640, 92 + ts(16) * 1.4), L.t("rc_following"), ts(14), Color(1, 1, 1, 0.85), true, false, 600)
    64	
    65	## 跳到某個 tick：同一組陣型從頭快轉（確定性模擬，結果一定一樣），畫面與音效狀態清空重建。
    66	func _seek(target: int) -> void:
    67		_seek_begin(target)
    68		while not _seek_tick(1000000):
    69			pass
    70		_seek_finish()
    71	
    72	
    73	## 第七輪 M3：時間軸點下去不再卡畫面，分批算。headless 測試直接走 _seek。
    74	var _seek_stop := 0
    75	var _seek_ct := -1
    76	
    77	func _seek_async(target: int) -> void:
    78		if seek_target >= 0:
    79			return
    80		if DisplayServer.get_name() == "headless" or shot_dir != "":
    81			_seek(target)
    82			return
    83		seek_target = target
    84		_seek_begin(target)
    85	
    86	## 這一幀還在算就回傳 true（戰鬥畫面這一幀不動）。
    87	func _seek_pump() -> bool:
    88		if seek_target < 0:
    89			return false
    90		if _seek_tick(10):
    91			seek_target = -1
    92			_seek_finish()
    93		return true
    94	
    95	func _seek_begin(target: int) -> void:
    96		var armies2: Array = rv_last if play_kind == "review" and not rv_last.is_empty() else last_armies
    97		sim = Sim.new(armies2[0].copy(), armies2[1].copy(), battle_rules)
    98		ev_count = {}
    99		_seek_ct = -1
   100		battle_marks.clear()
   101		_seek_stop = maxi(0, target - ViewBuffer.DELAY)
   102		_seek_target_now = target
   103	
   104	var _seek_target_now := 0
   105	
   106	## 算到時間用完或到達目標；到達回傳 true。
   107	func _seek_tick(budget_ms: int) -> bool:
   108		var t0 := Time.get_ticks_msec()
   109		while sim.tick < _seek_stop and not sim.finished:
   110			if Time.get_ticks_msec() - t0 >= budget_ms:
   111				return false
   112			sim.step()
   113			for ev in sim.events:   # 快轉時也要累計戰報次數與時間軸標記（Codex S5 #4：共用同一個收集函式）
   114				if ev.has("src"):
   115					var s = sim.unit_by_id(ev["src"])
   116					var key := "%s%d" % [ev["kind"], s.team]
   117					ev_count[key] = int(ev_count.get(key, 0)) + 1
   118					if ev["kind"] == EV.BLAST and not ev.has("dmg"):
   119						ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
   120				_collect_mark(ev, sim, sim.tick)
   121			if _seek_ct < 0 and not sim.finished and clutch_cond(sim):
   122				_seek_ct = sim.tick
   123		return true
   124	
   125	func _seek_finish() -> void:
   126		var target := _seek_target_now
   127		var keep_ct := _seek_ct
   128		var had_clutch := keep_ct >= 0
   129		view = ViewBuffer.new(sim)
   130		prev_pos.clear()
   131		_gait_reset()
   132		for u in view.units:
   133			prev_pos[u.id] = Vector2(u.x, u.y)
   134		fx.clear()
   135		dying.clear()
   136		graves.clear()
   137		atk_hit.clear()
   138		atk_seq.clear()
   139		atk_t.clear()
   140		hurt_t.clear()
   141		hurt_dir.clear()
   142		brace_t.clear()
   143		accum = 0.0
   144		result_delay = 0.0
   145		clutch_t = 0.0
   146		slow_left = 0.0
   147		hitstop = 0.0
   148		# 演出狀態依目標時間重建（Codex S5 #5）：最後時刻是否已發生、是否已進狂熱、音樂
   149		slow_used = had_clutch
   150		clutch_tick = keep_ct if had_clutch else -1
   151		if had_clutch:
   152			battle_marks.append({"tick": keep_ct, "kind": "clutch", "team": -1})
   153		_pump_view()
   154		# 畫面推到剛好第 target tick（原本停在 target−DELAY）
   155		while view.tick < target and not view.finished:
   156			_sim_step(false)
