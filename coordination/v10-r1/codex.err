   137	## 這隻兵附近（60px 內）有幾隻活著的兵，不算自己。
   138	func _crowd_at(u) -> int:
   139		var n := 0
   140		var p := _upos(u)
   141		for v in view.units:
   142			if v.alive and v.id != u.id and _upos(v).distance_squared_to(p) < 3600.0:
   143				n += 1
   144		return n
