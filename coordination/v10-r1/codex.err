   198	## 滑鼠按鍵（佇列命令，第三輪 A2）：按鈕點擊、擺放、拖曳、移除。
   199	func _mb_cmd(d: Dictionary) -> void:
   200		var mb := InputEventMouseButton.new()
   201		mb.button_index = d["i"]
   202		mb.pressed = d["pressed"]
   203		mb.position = d["pos"]
   204		mouse = d["pos"]
   205		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   206			if _do_click(mouse) > 0:
   207				_mb_release_cleanup()
   208				return
   209		if state == St.PLACE and overlay == "" and _fp_mb(d):
   210			return   # 第六輪：自由排兵處理掉了
   211		if overlay != "" or state != St.PLACE:
   212			if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
   213				_mb_release_cleanup()
   214				if overlay == "" and state == St.BATTLE and mb.button_index == MOUSE_BUTTON_LEFT:
   215					_battle_click(mouse)   # 重播時點兵讓鏡頭跟（第三輪 F2）
   216			return
   217		var c := _cell_at(mouse)
   218		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   219			var k := _card_at(mouse)
   220			if k >= 0 and _card_help_rect(k).has_point(mouse):
   221				return   # 放開時由「?」按鈕處理
   222			if k >= 0:
   223				if _allowed(k):
   224					selected = k
   225					drag_new = true
   226					sfx.play("k_click", 0.7)
   227				else:
   228					_toast(L.t("err_type"), true)
   229				return
   230			if c.x < 0:
   231				return
   232			if _can_edit_existing() and _cur_army().index_at(c.x, c.y) != -1:
   233				if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
   234					_toast(L.t("err_locked"), true)
   235					return
   236				drag_from = c
   237			else:
   238				painting = true
   239				paint_team = _cur_army().team
   240				_try_place(c)
   241		elif mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   242			if drag_new and c.x >= 0:
   243				_try_place(c)
   244			elif drag_from.x >= 0:
   245				if c.x < 0:
   246					_try_remove(drag_from)
   247				elif c != drag_from:
   248					if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() >= gauntlet_changes:
   249						_toast(L.t("err_changes"), true)
   250					elif not _cur_army().move(drag_from.x, drag_from.y, c.x, c.y):
   251						_toast(L.t("err_zone"), true)
   252					else:
   253						sfx.play("place_light")
   254			drag_new = false
   255			painting = false
   256			drag_from = Vector2i(-1, -1)
   257		elif mb.button_index == MOUSE_BUTTON_RIGHT and mb.pressed and c.x >= 0:
   258			_try_remove(c)
