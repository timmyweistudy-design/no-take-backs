const HEAL_FIRST := 20          # 開戰後第一次補血前的等待
const HEAL_RANGE := 3000        # 補血距離
# 支援走位（醫者、鼓手）：跟隨點往自己底線退 1 格、離目的地 0.3 格內就停
const SUPPORT_BACK := 1000
const SUPPORT_STOP := 300

# ─── 鼓手（第四輪）───
const DRUM_RANGE := 2100        # 光環 2.1 格（含自己）
