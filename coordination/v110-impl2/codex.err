extends "res://scripts/ui/free_place.gd"
## 由 game_screens.gd 拆出（V9 P1，行為不變）
## 狀態機、模式、輸入、擺放、標題、選單、設定、結果、成就。

## 第七輪 S7：每次啟動一個 session、每局一個 game；彙整工具靠這兩個去重（評分和對戰是兩行，不能重複算局數）。
var pt_session := str(Time.get_unix_time_from_system()) + "-" + str(randi())
var pt_game := 0

var keys_capture := ""   # 第七輪 K1：正在改哪個按鍵（"kb:start"／"pad:place"）

# ───────────────────────── 每幀 ─────────────────────────
## 最小化時 Godot 不繪製，也就沒有垂直同步節流，主迴圈會空轉吃滿一核；降到 10 fps，模擬照常跑（用 delta 累積）。
var _was_minimized := false
## 搖桿連發（第三輪 A2）：超過 0.6 才算推、低於 0.35 才算放開（遲滯）；推下立刻一次，0.35 秒後每 0.12 秒一次。
var stick := {JOY_AXIS_LEFT_X: 0.0, JOY_AXIS_LEFT_Y: 0.0}
var _stick_dir := Vector2i.ZERO
var _stick_t := 0.0

## 結果頁的技能徽章（第四輪）：候選裡雙方合計次數最多的 6 種；不夠 6 種就用經典的預設順序補。支援兵的補血、戰鼓也在候選裡（對支援兵公平）。
const BADGE_KEYS := ["breaker", "charge", "backstab", "braced", "anticav", "counter", "pike_brace", "splash", "breach", "heal", "drum"]
const EV_DEATH := "death"


func _reset_place(keep_blue := false) -> void:
	state = St.PLACE
	sim = null
	view = null
	pending_cell = Vector2i(-1, -1)
	ai_prebuilt = false
	_fp_reset()
	# 第一次進擺放畫面自動打開操作說明（第五輪：說明從頂部移到「?」）
	if not bool(Save.data.get("seen_place_help", false)) and (mode == Mode.VS_AI or mode == Mode.DUEL) and shot_dir == "":
		show_place_help = true
		Save.data["seen_place_help"] = true
	fx.clear()
	dying.clear()
	zoom = 1.0
	tp = null
	blind_phase = 0
	_focus = 0
	var keep_ok: bool = keep_blue and not armies.is_empty() and (rules == null or rules.keep_formation)
	var blue_keep = armies[0].copy() if keep_ok else null
	armies = [Army.new(0, 100), Army.new(1, 100)]
	if rules != null and (mode == Mode.VS_AI or mode == Mode.DUEL):
		armies[0].apply_rules(rules, 0)
		armies[1].apply_rules(rules, 1)
	if mode == Mode.GAUNTLET:
		armies[0].pool = _gauntlet_pool()
		armies[1].pool = _gauntlet_pool()
	match mode:
		Mode.VS_AI:
			if blue_keep != null:
				armies[0] = blue_keep
			if rules != null and rules.fullfield == 2:
				# 第六輪：對 AI 明牌全場——AI 先在自己半場擺好並公開，你在全場離敵兵 1.5 格外擺
				_build_ai()
				ai_prebuilt = true
				armies[0].enemy_pos = []
				for u in armies[1].units:
					armies[0].enemy_pos.append(armies[1].pos_of(u))
				var keep: Array = armies[0].units.duplicate(true)
				armies[0].units = []
				for u in keep:
					var pp: Vector2i = armies[0].pos_of(u)
					armies[0].place_xy(int(u["type"]), pp.x, pp.y)   # 保留的陣型和新的明牌陣衝突的就拿掉
		Mode.DUEL:
			if duel_rule != "blind":
				tp = TP.new(armies[0], armies[1], (round_no + 1) % 2, duel_rule, rules)
				if rules == null:
					tp.armies[0].pool = _pool()
					tp.armies[1].pool = _pool()
		Mode.TUTORIAL, Mode.PUZZLE:
			var pz := PZ.get_puzzle(puzzle_id)
			armies[0] = PZ.player_army(pz)
			armies[1] = PZ.enemy_army(pz)
			selected = int(pz["allowed"][0])
			if puzzle_plan_id != puzzle_id:
				puzzle_plan = PZ.default_plan(pz)   # 第十三輪：同一關重來保留上次設定的時間，換關重設
				puzzle_plan_id = puzzle_id
		Mode.GAUNTLET:
			if not gauntlet_prev.is_empty():
				armies[0].units = gauntlet_prev.duplicate(true)
			var r := RandomNumberGenerator.new()
			r.seed = gauntlet_seed + gauntlet_stage * 7919
			var node: String = call("ga_node", gauntlet_stage)
			var lvl := 2 if node == "boss" else mini(2, (gauntlet_stage - 1) / 2 + (1 if node == "elite" else 0))
			var e := AIT.build_full(1, r, lvl, gauntlet_prev, _pool())
			# V1.1 D1：菁英 +10、首領 +20；斥候劫掠／截斷補給只影響這一戰
			e.budget = 100 + 5 * (gauntlet_stage - 1) + int(get("GA_NODE_GOLD")[node]) + int(get("gauntlet_foe_gold"))
			e.unit_cap = maxi(4, e.unit_cap + int(get("gauntlet_foe_cap")))
			# Codex v110-impl #2：先組好的陣可能超出調低後的預算／隻數，從最後放的往回拿掉（至少留一隻戰鬥兵）
			while e.units.size() > 1 and (e.spent() > e.budget or e.units.size() > e.unit_cap):
				e.units.pop_back()
			var guard := 0
			while e.can_afford_any() and guard < 20:
				guard += 1
				var t := AIT.choose_type(e, gauntlet_prev, e.left(), r, lvl, _pool())
				if t < 0:
					break
				var c := AIT.choose_cell(e, t, gauntlet_prev, r)
				if c.x < 0 or not e.place(t, c.x, c.y):
					break
			armies[1] = e
	sfx.play_music("music_place")
	sfx.play_ambience(str(MapArt.BIOME.get(MapDefs.MAPS[rules.map_id if rules != null and rules.is_free() else 0]["biome"], {}).get("sound", "")))



func _cur_army():
	if mode == Mode.DUEL:
		if tp != null:
			return tp.armies[tp.current]
		return armies[0] if blind_phase == 0 else armies[1]
	return armies[0]



func _enemy_visible() -> bool:
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE or mode == Mode.GAUNTLET:
		return true
	if mode == Mode.DUEL:
		return tp != null
	return false



func _ai_pool(r: RandomNumberGenerator) -> int:
	var p1: int = rules.pool_of(1) if rules != null else _pool()
	if rules != null and rules.ai_style != 0:
		p1 = AI.style_pool(p1, rules.ai_style, r)
	Save.data[stat_key] = st
	_v8_achievements(w)   # 奇幻軍是娛樂變體，要放在「自訂規則提前返回」之前（Codex 第 3 輪）
	# 圖鑑老兵筆記：派這個兵種贏一場 +1（第二輪方案 R3）。第十輪 B4：自訂規則、奇幻軍也算（放在提前返回之前）
	var types := {}
	if me_won:
		for u in sim.units:
			if u.team == w:
				types[D.report_type(u.type)] = true
		CX.record_win(Save.data, types.keys())
	if not standard:
		# 自訂規則專屬成就（標準成就只看標準局）
		if me_won and mode == Mode.VS_AI and w == 0:
			if rules.budget_of(0) <= 50:
				_ach("CUSTOM_LOWGOLD")
			if rules.budget_of(0) < rules.budget_of(1):
				_ach("CUSTOM_UNDERDOG")
		if me_won and rules.unit_cap >= 36:
			_ach("CUSTOM_BIG")
		_save()
		return
	if me_won:
		_ach("FIRST_WIN")
		if sim.alive_count(w) == 1:
			_ach("LONE_HERO")
		if int(report["sus"]["max_swing_pct"]) >= 15:
			_ach("COMEBACK")
		if sim.power(w) * 100 / (sim.budget * 1000) <= 5:
			_ach("CLOSE_CALL")
		if sim.tick >= Sim.FRENZY_TICK:
			_ach("FRENZY_WIN")
		if types.size() == 5:
			_ach("ALL_TYPES")
		if int(ev_count.get("charge%d" % w, 0)) >= 5:
			_ach("CHARGE_5")
		if int(ev_count.get("backstab%d" % w, 0)) >= 3:
			_ach("BACKSTAB_3")
	if mode == Mode.VS_AI and w == 0 and difficulty == 2:
		_ach("HARD_WIN")
	if mode == Mode.DUEL and tp != null and series_over:
		_ach("NO_TAKEBACKS")
	if series_over and ((mode == Mode.DUEL and (wins == [2, 0] or wins == [0, 2])) or (mode == Mode.VS_AI and wins == [2, 0])):
		_ach("SWEEP")
	if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and puzzle_id != "ws":   # V1.1 D3：工坊殘局不存星數
		var stars := int(report.get("stars", 0))
		var ps: Dictionary = Save.data.get("puzzle_stars", {})
		if stars > int(ps.get(puzzle_id, 0)):
			ps[puzzle_id] = stars
		Save.data["puzzle_stars"] = ps
		if mode == Mode.PUZZLE:
			Save.note_try("puzzle", puzzle_id, stars >= 1, armies[0].spent())   # V1.1 F2
		if mode == Mode.TUTORIAL and w == 0:
			var idx := 0
			for i in PZ.tutorials().size():
				if PZ.tutorials()[i]["id"] == puzzle_id:
					idx = i
			Save.data["tutorial"] = maxi(int(Save.data.get("tutorial", 0)), idx + 1)
			if int(Save.data["tutorial"]) >= PZ.tutorials().size():
				_ach("TUTORIAL")
		if stars == 3:
			_ach("PUZZLE_3STAR")
		var all_done := true
		for p in PZ.puzzles():
			if int(ps.get(p["id"], 0)) == 0:
				all_done = false
		if all_done:
			_ach("PUZZLE_ALL")
		var cleared := 0
		var perfect := 0
		for p2 in PZ.all_puzzles():
			cleared += 1 if int(ps.get(p2["id"], 0)) > 0 else 0
			perfect += 1 if int(ps.get(p2["id"], 0)) >= 3 else 0
		if cleared >= 100:
			_ach("PUZZLE_100")   # 第十三輪
		if perfect >= 100:
			_ach("PUZZLE_ALL3")
	if mode == Mode.GAUNTLET:
		if w == 0:
			if gauntlet_stage >= 7:
				_ach("GAUNTLET")
				Save.data["gauntlet_best"] = 7
				_gauntlet_clear()
		else:
			_gauntlet_clear()
			Save.data["gauntlet_best"] = maxi(int(Save.data.get("gauntlet_best", 0)), gauntlet_stage - 1)
	_save()

	return Vector2i(int(q.x), int(q.y))



## 兵種卡的矩形：繪製、點擊、焦點、版面探針共用這一個函式（第四輪 §4.1）。
## 卡列要顯示哪些兵種（第五輪 §4.4）：只放這局用得到的兵。
## 自訂規則：卡池；教學／殘局：關卡允許的；遠征與沒有規則的模式：全部（未解鎖的上鎖，提示還要幾場）。
func _card_types() -> Array:
	var out: Array = []
	if mode == Mode.GAUNTLET:
		return RuleSet.types_of(_gauntlet_pool())   # 第八輪：遠征沿用對 AI 的出戰名單
	for t in D.total():
		if t >= D.COUNT and rules == null and mode != Mode.TUTORIAL and mode != Mode.PUZZLE:
			continue
		if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
			if _allowed(t):
				out.append(t)
		elif rules != null and (mode == Mode.VS_AI or mode == Mode.DUEL):
			if RuleSet.has(_cur_army().pool, t):
				out.append(t)
		else:
			out.append(t)
	return out



func _card_rect(i: int) -> Rect2:
	var types := _card_types()
	var k := types.find(i)
	if k < 0:
		return Rect2()
	var n := types.size()
	var w := minf(CARD_W * 1.5, (860.0 - CARD_GAP * (n - 1)) / n)   # 卡少時卡片變大（最寬 120）
	return Rect2(CARD_X0 + k * (w + CARD_GAP), CARD_Y, w, CARD_H)



## 兵種卡右下角的「?」：開圖鑑到這個兵種（第二輪方案 R3）。第五輪：點擊框 32px。
func _card_help_rect(i: int) -> Rect2:
	var r := _card_rect(i)
	if not r.has_area():
		return Rect2()
	return Rect2(r.end.x - 38, r.end.y - 38, 36, 36)



func _card_at(p: Vector2) -> int:
	for i in _card_types():
		if _card_rect(i).has_point(p):
			return i
	return -1



## 這一場開放幾種兵（第四輪 §9）：朋友對戰看「兵種」設定；對 AI、遠征看解鎖進度（也可選經典 5 種）；教學與殘局由關卡限制。
func _ntypes() -> int:
	var classic := str(Save.s("roster")) == "classic"
	var kind := "all"
	if mode == Mode.DUEL:
		kind = "duel"
	elif mode == Mode.VS_AI or mode == Mode.GAUNTLET:
		kind = "ai"
	return RS.ntypes_for(kind, classic, _demo())



## 第五輪：這一場的卡池遮罩（R1 前＝前 N 種）。
func _pool() -> int:
	if rules != null:
		return rules.pool_of(0)
	if mode == Mode.GAUNTLET:
		return _gauntlet_pool()
	return RuleSet.prefix_pool(_ntypes())



func _allowed(t: int) -> bool:
	if rules != null and (mode == Mode.VS_AI or mode == Mode.DUEL):
		return RuleSet.has(_cur_army().pool, t)
	if mode == Mode.GAUNTLET:
		return RuleSet.has(_gauntlet_pool(), t)
	if t >= _ntypes() and (t < D.COUNT or not (mode == Mode.TUTORIAL or mode == Mode.PUZZLE)):
		return false
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
		for x in PZ.get_puzzle(puzzle_id)["allowed"]:
			if int(x) == t:
				return true
		return false
	return true



## 遠征的出戰名單（第八輪）：上次對 AI 用的名單，拿掉沒解鎖的；沒有就是解鎖的舊兵。
func _gauntlet_pool() -> int:
	var base := RuleSet.prefix_pool(_ntypes())
	# 第八輪：開打前在「遠征用哪支軍隊」選的，整趟沿用；存檔被改壞就當沒選
	var chosen = Save.data.get("gauntlet_pool", 0)
	if (chosen is int or chosen is float) and int(chosen) > 0:
		var cp: int = int(chosen) & RS.mask(_demo())
		if RuleSet.has_combat(cp) and RuleSet.pool_count(cp) <= RuleSet.ROSTER_MAX:
			return cp
func _v8_setup() -> void:
	var base := units.size()
	for i in base:
		var p := units[i]
		var kids := 0
		var kt := -1
		if p.type == F8.SLIME and not skill_off.has("split"):
			kids = F8.SLIME_KIDS
			kt = F8.MINI_SLIME
		elif p.type == F8.BONE and not skill_off.has("raise"):
			kids = F8.BONE_KIDS
			kt = F8.SKELETON
		for k in kids:
			var c := Unit.new()
			var st: Dictionary = D.stat(kt)
			c.id = p.team * 1000 + 600 + i * 4 + k
			c.team = p.team
			c.type = kt
			c.x = p.x
			c.y = p.y
			c.hp = st["hp"]
			c.max_hp = st["hp"]
			c.cost = 0
			c.reach = st["reach"]
			c.speed = st["speed"]
			c.atk = st["atk"]
			c.cd_base = st["cd"]
			c.fx = p.fx
			c.alive = false
			c.dormant = true
			c.summon = true
			c.parent = i
			c.sub = k
			c.slot = p.slot * 8 + k + 1000
			units.append(c)
		if p.type == F8.MIMIC and not skill_off.has("bite"):
			p.hidden = true
		if p.type == F8.BONE or p.type == F8.CAT or p.type == F8.GOLEM:
			p.skill_cd = F8.FIRST_CD
		if p.type == F8.DOLL:
			p.link_wait = 1

## ① 之後：寶箱怪偽裝、現身，毒圈與碎石區的移速，巫毒綁定。只讀快照。
func _v8_pre_tick(n: int, sx: PackedInt64Array, sy: PackedInt64Array, st: PackedInt64Array, sv: PackedByteArray) -> void:
	# 誰還能打（寶箱怪判斷要不要自動現身）：活著、不是孢子菇、不是偽裝中
	var able := [0, 0]
	for i in n:
		var u := units[i]
		if u.alive and u.type != F8.SPORE and not u.hidden:
			able[u.team] += 1
	# 先用這一 tick 開始的狀態決定誰現身，再一起套用（一隻現身不會連帶觸發別隻，鏡像才對稱）
	var opening: Array = []
	for i in n:
		var u := units[i]
		if not u.alive or not u.hidden:
			continue
		var open: bool = able[u.team] == 0
		if not open:
			for j in n:
				if sv[j] == 1 and st[j] != st[i] and not units[j].hidden and M.dist2(sx[i], sy[i], sx[j], sy[j]) <= F8.MIMIC_TRIGGER * F8.MIMIC_TRIGGER:
					open = true
					break
		if open:
			opening.append(i)
		else:
			sv[i] = 0
	for i in opening:
		var u := units[i]
		u.hidden = false
		u.bite = true
		events.append({"kind": EV.MIMIC_OPEN, "src": u.id, "tgt": u.id, "tags": [EV.MIMIC_OPEN]})
	# 先列出活著的孢子菇：沒有菇的場次這段就是空迴圈（最壞情況 100 隻，不能每隻都掃一遍）
	var spores: Array = []
	if not skill_off.has("poison"):
		for j in n:
			if units[j].type == F8.SPORE and units[j].alive:
				spores.append(units[j])
	for i in n:
		var u := units[i]
		u.zone = 100
		if not u.alive:
			continue
		var pct := 100
		for s in spores:
			if s.team != u.team and M.dist2(s.x, s.y, u.x, u.y) <= s.reach * s.reach:
				pct = F8.SPORE_SLOW_PCT
				break
		for z in zones:
			if int(z[3]) != u.team and M.dist2(int(z[0]), int(z[1]), u.x, u.y) <= F8.ROCK_R * F8.ROCK_R:
				pct = mini(pct, F8.ROCK_SLOW_PCT)
				if u.type == D.CAVALRY:
					u.charge = 0
				break
		u.zone = pct
	if skill_off.has("voodoo"):
		return
	for i in n:
		var u := units[i]
		if u.type != F8.DOLL or not u.alive:
			continue
		if u.link >= 0 and not units[u.link].alive:
			u.link = -1
			u.link_wait = F8.DOLL_REBIND
		if u.link < 0:
			if u.link_wait > 0:
				u.link_wait -= 1
			if u.link_wait <= 0:
				u.link = _v8_doll_target(i, sx, sy, st, sv)

## 巫毒綁誰：隊伍前向半平面、同列走廊內最近；同距比 y、再比離自己底線的深度（鏡像不變）；走廊沒人就全場最近。
func _v8_doll_target(i: int, sx: PackedInt64Array, sy: PackedInt64Array, st: PackedInt64Array, sv: PackedByteArray) -> int:
	var dir := 1 if st[i] == 0 else -1
	var best := -1
	var best_lane := false
	var bd := 0
	for j in sx.size():
		if sv[j] == 0 or st[j] == st[i]:
			continue
		var d2 := M.dist2(sx[i], sy[i], sx[j], sy[j])
		var lane: bool = (sx[j] - sx[i]) * dir >= 0 and absi(sy[j] - sy[i]) <= F8.DOLL_LANE
		var better := best == -1
		if not better and lane != best_lane:
			better = lane
		elif not better and lane == best_lane:
			better = _tie_less(d2, units[j], bd, units[best])
		if better:
			best = j
			best_lane = lane
			bd = d2
	return best

## ② 之後：被吸塵貓拉的位移併進移動意圖，再統一解碰撞。
func _v8_apply_pull(n: int, nx: PackedInt64Array, ny: PackedInt64Array) -> void:
	for i in n:
		var u := units[i]
		if u.alive and u.pull_t > 0:
			nx[i] += u.pull_x
			ny[i] += u.pull_y
			extra.append([i, u.link, total, EV.VOODOO, [EV.VOODOO]])
	hits.append_array(extra)

## 單位倒下：史萊姆分裂、石魔留碎石、羊排到下一 tick 爆。
func _v8_on_death(i: int, killer: int) -> void:
	var u := units[i]
	if u.type == F8.SHEEP and not u.exploded:
		_pending_blast.append([i, killer])
	elif u.type == F8.SLIME and not skill_off.has("split"):
		for j in range(i + 1, units.size()):
			var c := units[j]
			if c.parent == i and c.dormant:
				c.dormant = false
				c.alive = true
				c.x = u.x
				c.y = clampi(u.y + (F8.SLIME_OFFSET if c.sub == 0 else -F8.SLIME_OFFSET), EDGE, fh - EDGE)
				if terrain != null and terrain.blocked(c.x, c.y, c.team):
					c.y = u.y     # 裂到牆裡：留在母體位置，碰撞會把它們推開
				c.cd = c.cd_base * 4
				events.append({"kind": EV.SPLIT, "src": c.id, "tgt": c.id, "tags": [EV.SPLIT]})
	elif u.type == F8.GOLEM and not skill_off.has("stomp"):
		zones.append([u.x, u.y, tick + F8.ROCK_TICKS, u.team])
		events.append({"kind": EV.ROCK, "src": u.id, "tgt": u.id, "tags": [EV.ROCK]})

## ⑤ 之後、判定結束之前：骷髏站起來（下一 tick 才行動）、碎石區到期。
func _v8_post_tick(raises: Array) -> void:
	raises.sort_custom(func(a, b): return _tie_less(0, units[a[0]], 0, units[b[0]]))
	for r in raises:
		var m := units[r[0]]
		var c := units[r[1]]
		if not m.alive or c.raised or c.alive:
			continue
		var k := _v8_free_kid(r[0])
		if k == -1:
			continue
		var s := units[k]
		c.raised = true
		s.dormant = false
		s.alive = true
		s.x = c.x
		s.y = c.y
		if terrain != null and terrain.blocked(s.x, s.y, s.team):
			var sf: Vector2i = terrain.free_near(s.x, s.y, s.team)   # 幽靈死在牆裡
			s.x = sf.x
			s.y = sf.y
		s.max_hp = mini(c.max_hp * F8.BONE_HP_PCT / 100, F8.BONE_HP_CAP)
		s.hp = s.max_hp
		s.cd = s.cd_base * 4
		events.append({"kind": EV.RAISE, "src": s.id, "tgt": s.id, "by": m.id, "tags": [EV.RAISE]})
	var live: Array = []
	for z in zones:
		if int(z[2]) > tick:
			live.append(z)
	zones = live

## 新欄位的指紋（只有用到新兵的場次才有）。
## ── 第十二輪手動技能 ──
## 這一隊現在能不能用這一招。
func cmd_can(team: int, s: int) -> bool:
	return cmd_on and not finished and s >= 0 and s < CMD.COUNT and int(cmd_left[team][s]) > 0 and tick >= int(cmd_ready[team][s])

## 玩家按下：下一 tick 生效。重播時不接受。
func cast(team: int, s: int) -> bool:
	if cmd_scripted or not cmd_can(team, s):
		return false
	for p in cmd_pending:
		if p[0] == team and p[1] == s:
			return false
	cmd_pending.append([team, s])
	return true

## 重播：照紀錄在同一 tick 施放，AI 不再自己決定。
func cmd_play(log: Array) -> void:
	cmd_scripted = true
	cmd_script = {}
	for e in log:
extends Node
## 角色精靈圖快取（第二輪方案 R2、H；第八輪改分頁）：實測 48 隻時每幀直接程式繪製要 34ms（約 15fps），
## 所以用同一份 Art.unit 畫法，把兵種×隊伍×動作影格畫進圖集，戰鬥中只貼圖。
## 第八輪：一張大圖放 22 種會到 3072×11712，Compatibility 渲染器超過 4096 有風險。改成每頁 ≤4096（7 種兵），
## 開場只烘舊 10 種，新兵上場才烘；還沒烘好時呼叫端直接畫，不會缺圖。頁數有上限，超過丟最舊的新兵頁。
## 用同一份畫法烘焙，但不是逐像素等價（Codex R1 審查 #3、#4，已知且接受的差異）：
##  - 走路量化成 6 格、攻擊 8 格；攻擊中不再疊走路相位；走路／攻擊格固定睜眼（只在待機眨眼）。
## 表情疊加（受擊、暈眩、衝鋒、狂熱、潛行、頂住）不烘焙，貼完圖再用 Art.overlay 在同一個局部座標畫上去。
##  - 透明度（潛行）是對整張合成好的角色乘 alpha，重疊的部位不會像逐圖元那樣透出底下的線條。
## 待機呼吸位移在貼圖時加（烘焙時抵銷為 0）；受擊閃白跟著攻擊前衝與走路起伏。
## 沒有畫面（headless）或還沒建好時，呼叫端退回 Art.unit。

const Art = preload("res://scripts/ui/art.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const Gait = preload("res://scripts/ui/units/gait.gd")

const CELL := 192          # 每格像素（以 RS 倍率畫）；比角色大一圈，避免相鄰格子滲色
const RS := 1.6            # 烘焙解析度倍率
const ORIGIN := Vector2(78, 160)   # 角色腳底在格子裡的位置（第七輪 C0：原本會超框被切掉）
const RING_ORIGIN := Vector2(96, 140)   # 腳底圈格子的中心（有影子，要留下方空間）
const WALK_FRAMES := 8     # V9 P2：6→8，另加拖行、暈眩
const POSE_FRAMES := 2
const ATK_FRAMES := 8      # 三段式攻擊（R5）要多幾格才看得出前搖／揮擊／後搖
# 每個兵種、隊伍的影格順序：0 待機、1 眨眼、2..7 走路、8..23 攻擊兩組（一般／交替或專屬）
const FRAMES_PER := 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * 2
const COLS := 16
const TYPES_PER_PAGE := 6  # 6×2×28＝336 格＝21 列×192＝4032px，不超過 4096
const MAX_PAGES := 5

var pages: Array = []      # 每頁 {tex, types}
var loc := {}              # 兵種 → [頁, 這一種在頁裡的起始格]
var ring_tex: Texture2D = null
var ready_cb := -1         # 這份快取是用哪種配色（一般／色盲）烘焙的
var _busy := false
var _queue: Array = []
var _baking: Array = []

func is_ready(cb: bool) -> bool:
	return ring_tex != null and ready_cb == (1 if cb else 0)

func has_type(t: int) -> bool:
	return loc.has(t)

## 腳底在格子裡的位置：往前伸得很長的長槍兵靠左、很寬的小石魔靠右，其他都一樣。
static func origin_of(type: int) -> Vector2:
	return Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160))

## 全部清掉，烘舊 10 種和腳底圈。
func build(cb: bool) -> void:
	if DisplayServer.get_name() == "headless":
		return
	pages.clear()
	loc.clear()
	_queue.clear()
	ring_tex = null
	ready_cb = 1 if cb else 0
	var base: Array = []
	for t in D.COUNT:
		base.append(t)
	await _bake_ring(cb)
	await ensure(base)

## 這場要用到的兵種。缺的才烘；烘的時候呼叫端先直接畫。
func ensure(types: Array) -> void:
	if DisplayServer.get_name() == "headless" or ready_cb < 0:
		return
	for t in types:
		if not loc.has(t) and not t in _queue and not t in _baking:
			_queue.append(t)
	if _busy or _queue.is_empty():
		return
	_busy = true
	while not _queue.is_empty():
		var chunk: Array = _queue.slice(0, TYPES_PER_PAGE)
		_queue = _queue.slice(chunk.size())
		_baking = chunk
		await _bake_page(chunk)
		_baking = []
	_busy = false

func _viewport(size: Vector2i, painter: Node) -> SubViewport:
	var vp := SubViewport.new()
	vp.size = size
	vp.transparent_bg = true
	vp.render_target_update_mode = SubViewport.UPDATE_ONCE
	vp.add_child(painter)
	add_child(vp)
	return vp

func _bake_page(types: Array) -> void:
	var cb := ready_cb == 1
	var total := types.size() * 2 * FRAMES_PER
	var rows := int(ceil(float(total) / COLS))
	var painter := _Painter.new()
	painter.cb = cb
	painter.types = types
	var vp := _viewport(Vector2i(COLS * CELL, rows * CELL), painter)
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	var img := vp.get_texture().get_image()
	vp.queue_free()
	if (1 if cb else 0) != ready_cb:
		return   # 烘的時候換了配色：這一批作廢
	# 新兵頁太多就丟最舊的（舊 10 種那兩頁不丟）
	if pages.size() >= MAX_PAGES:
		for i in pages.size():
			if pages[i] != null and int(pages[i]["types"][0]) >= D.COUNT:
				for t in pages[i]["types"]:
					if loc.has(t) and int(loc[t][0]) == i:
						loc.erase(t)
				pages[i] = null
				break
	var pn := pages.size()
	pages.append({"tex": ImageTexture.create_from_image(img), "types": types})
	for k in types.size():
		loc[types[k]] = [pn, k * 2 * FRAMES_PER]

func _bake_ring(cb: bool) -> void:
	var painter := _RingPainter.new()
	painter.cb = cb
	var vp := _viewport(Vector2i(4 * CELL, CELL), painter)
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	ring_tex = ImageTexture.create_from_image(vp.get_texture().get_image())
	vp.queue_free()

## variant 1（劍士交替招式）和 2（第四輪新兵的專屬動作）都用第二組攻擊格：新兵沒有交替招式，那一組烘的是專屬動作。
func frame_index(type: int, team: int, walk: float, atk: float, t: float, px: float, variant := 0) -> int:
	var base: int = int(loc[type][1]) + team * FRAMES_PER
	if atk > 0.0:
		return base + 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * mini(variant, 1) + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
	if walk <= Gait.POSE_DAZE + 1.0:
		return base + 2 + WALK_FRAMES + 1
	if walk <= Gait.POSE_DRAG + 1.0:
		return base + 2 + WALK_FRAMES
	if walk != 0.0:
		return base + 2 + int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES
	var ex := 2.0 if type == D.CAVALRY else 3.5   # Art._eyes 的眼睛中心 x
	var blink := fmod(t + ex * 0.13, 3.7) <= 0.12   # 與 Art._eyes 相同的眨眼節奏
	return base + (1 if blink else 0)

func draw_ring(ci: CanvasItem, p: Vector2, team: int, type: int, scale := 1.0) -> void:
	var idx := team * 2 + (1 if (type == D.SHIELD or type == D.CAVALRY or type == 19) else 0)
	ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
	ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2(idx * CELL, 0, CELL, CELL))
	ci.draw_set_transform_matrix(Art.base)

func _rect(idx: int) -> Rect2:
	return Rect2((idx % COLS) * CELL, (idx / COLS) * CELL, CELL, CELL)

## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
func quant_walk(walk: float) -> float:
	if walk == 0.0:
		return 0.0
	if walk < -50.0:
		return walk
	return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES

func quant_atk(atk: float) -> float:
	if atk <= 0.0:
		return 0.0
	return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES

## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
		hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false, variant := 0) -> void:
	var idx := frame_index(type, team, walk, atk, t, p.x, variant)
	if atk > 0.0:
		walk = 0.0   # 攻擊影格烘焙時沒有走路相位：貼圖與疊加都當成沒在走（Codex 收尾輪 #4）
	var bob := Art.idle_bob(t, p.x) if walk == 0.0 else 0.0   # 與 Art.unit 相同：沒走路時（含攻擊）都有呼吸
	var xf := Art.base * Transform2D(lean * face, Vector2(scale * face / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale))
	ci.draw_set_transform_matrix(xf)
	ci.draw_texture_rect_region(pages[loc[type][0]]["tex"], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
	if hurt > 0.0 or mood != 0:
		# 攻擊影格烘焙時沒有走路相位（Codex R5 #3）
		var qa := quant_atk(atk)
		var qw := 0.0 if qa > 0.0 else quant_walk(walk)
		ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, face, qw, qa, t, scale, lean, crouch, type) * Gait.body_xf(type, qw))
		if hurt > 0.0:
			ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, false)
		if mood != 0:
			Art.overlay(ci, type, team, mood, alpha, t, cb)
	ci.draw_set_transform_matrix(Art.base)

## 烘焙用的畫家：一格一格呼叫 Art.unit（face＝+1，翻面由貼圖時處理）。
class _Painter extends Node2D:
	var cb := false
	var types: Array = []
	func _draw() -> void:
		var Art2 = preload("res://scripts/ui/art.gd")
		var D2 = preload("res://scripts/core/unit_defs.gd")
		var saved: Transform2D = Art2.base
		Art2.base = Transform2D.IDENTITY
		var CELL2 := 192
		var RS2 := 1.6
		var W2 := 8
		var per := 2 + W2 + 2 + 8 + 8
		var cols := 16
		for k in types.size():
			var type: int = types[k]
			for team in 2:
				for f in per:
					var idx: int = (k * 2 + team) * per + f
					var cell_o := Vector2((idx % cols) * CELL2, (idx / cols) * CELL2)
					var walk := 0.0
					var atk := 0.0
					var vr := 0
					if f >= 2 and f < 2 + W2:
						walk = 0.0001 + (f - 2) * TAU / W2
					elif f == 2 + W2:
						walk = -100.0   # 拖行（Gait.POSE_DRAG）
					elif f == 3 + W2:
						walk = -200.0   # 暈眩（Gait.POSE_DAZE）
					elif f >= 4 + W2 + 8:
						atk = (f - (4 + W2 + 8) + 0.5) / 8.0
						vr = 1 if type < D2.CLASSIC else 2   # 第四輪新兵沒有交替招式，這一組放專屬動作（variant 2）
					elif f >= 4 + W2:
						atk = (f - (4 + W2) + 0.5) / 8.0
					var p := cell_o + (Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160)))
					var ex := 2.0 if type == D2.CAVALRY else 3.5
					# 眨眼那一格落在眨眼區間中間；其他格取 1.0（不在眨眼區間）
					var tt: float = (3.7 - ex * 0.13 + 0.05) if f == 1 else 1.0
					# 沒走路的格子（待機、眨眼、攻擊）Art.unit 會加呼吸位移；這裡反向抵銷，貼圖時再依當下時間加
					var pb := p
					if walk == 0.0:
						pb.y -= sin(tt * 3.0 + p.x * 0.05) * 0.8 * RS2
					Art2.unit(self, pb, type, team, 1.0, walk, atk, 0.0, 1.0, tt, RS2, cb, 0, 0.0, 1.0, vr)
		Art2.base = saved

class _RingPainter extends Node2D:
	var cb := false
	func _draw() -> void:
		var Art2 = preload("res://scripts/ui/art.gd")
		var D2 = preload("res://scripts/core/unit_defs.gd")
		var saved: Transform2D = Art2.base
		Art2.base = Transform2D.IDENTITY
		for team in 2:
			for heavy in 2:
				var o := Vector2((team * 2 + heavy) * 192, 0) + Vector2(96, 140)
				Art2.ring(self, o, team, D2.SHIELD if heavy == 1 else D2.SWORD, cb, 1.6)
		Art2.base = saved

