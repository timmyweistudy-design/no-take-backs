    64		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
    65		if not j is Dictionary or int(j.get("v", 0)) != 1:
    66			return bad
    67		var e := _clean(j.get("e"), 10, 15)
    68		var s := _clean(j.get("s"), 0, 5)
    69		if e.is_empty() or s.is_empty() or not j.get("a") is Array:
    70			return bad
    71		var allowed: Array = []
    72		for t in j["a"]:
    73			if not (t is int or t is float) or int(t) < 0 or int(t) >= D.total():
    74				return bad
    75			allowed.append(int(t))
    76		var spent := 0
    77		for u in s:
    78			if not int(u[0]) in allowed:
    79				return bad
    80			spent += D.cost(int(u[0]))
    81		if spent > 200:
    82			return bad
    83		var pz := {"id": ID, "ch": 0, "zh": "工坊殘局", "en": "Workshop Puzzle",
    84			"hint_zh": "朋友打贏過這一關。用一樣的兵種、一樣多的錢，打得比他漂亮就是三星。",
    85			"hint_en": "A friend beat this one. Same units, same gold: beat their result for 3 stars.",
    86			"enemy": e, "fixed": [], "budget": spent, "allowed": allowed, "star2": 0, "star3": spent}
    87		var r: Dictionary = PZ.play(pz, s)
    88		if not bool(r.get("ok", false)):
    89			return {"ok": false, "why": "ws_unsolved"}
    90		pz["star2"] = int(r["rem"])
    91		pz["best"] = {"u": s, "p": []}
    92		return {"ok": true, "pz": pz, "sol": s, "why": ""}
		out[k] = _count(out.get(k, 0))
	for k in ["stats", "custom_stats"]:
