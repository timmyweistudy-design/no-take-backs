extends Node
## 角色精靈圖快取（第二輪方案 R2、H；第八輪改分頁）：實測 48 隻時每幀直接程式繪製要 34ms（約 15fps），
## 所以用同一份 Art.unit 畫法，把兵種×隊伍×動作影格畫進圖集，戰鬥中只貼圖。
## 第八輪：一張大圖放 22 種會到 3072×11712，Compatibility 渲染器超過 4096 有風險。改成每頁 ≤4096（7 種兵），
## 開場只烘舊 10 種，新兵上場才烘；還沒烘好時呼叫端直接畫，不會缺圖。頁數有上限，超過丟最舊的新兵頁。
## 用同一份畫法烘焙，但不是逐像素等價（Codex R1 審查 #3、#4，已知且接受的差異）：
##  - 走路量化成 6 格、攻擊 8 格；攻擊中不再疊走路相位；走路／攻擊格固定睜眼（只在待機眨眼）。
## 表情疊加（受擊、暈眩、衝鋒、狂熱、潛行、頂住）不烘焙，貼完圖再用 Art.overlay 在同一個局部座標畫上去。
##  - 透明度（潛行）是對整張合成好的角色乘 alpha，重疊的部位不會像逐圖元那樣透出底下的線條。
## 待機呼吸位移在貼圖時加（烘焙時抵銷為 0）；受擊閃白跟著攻擊前衝與走路起伏。
## 沒有畫面（headless）或還沒建好時，呼叫端退回 Art.unit。

const Art = preload("res://scripts/ui/art.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const Gait = preload("res://scripts/ui/units/gait.gd")

const CELL := 192          # 每格像素（以 RS 倍率畫）；比角色大一圈，避免相鄰格子滲色
const RS := 1.6            # 烘焙解析度倍率
const ORIGIN := Vector2(78, 160)   # 角色腳底在格子裡的位置（第七輪 C0：原本會超框被切掉）
const RING_ORIGIN := Vector2(96, 140)   # 腳底圈格子的中心（有影子，要留下方空間）
const WALK_FRAMES := 8     # V9 P2：6→8，另加拖行、暈眩
const POSE_FRAMES := 2
const ATK_FRAMES := 8      # 三段式攻擊（R5）要多幾格才看得出前搖／揮擊／後搖
# 每個兵種、隊伍的影格順序：0 待機、1 眨眼、2..7 走路、8..23 攻擊兩組（一般／交替或專屬）
const FRAMES_PER := 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * 2
const COLS := 16
const TYPES_PER_PAGE := 6  # 6×2×28＝336 格＝21 列×192＝4032px，不超過 4096
const MAX_PAGES := 5

var pages: Array = []      # 每頁 {tex, types}
var loc := {}              # 兵種 → [頁, 這一種在頁裡的起始格]
var ring_tex: Texture2D = null
var ready_cb := -1         # 這份快取是用哪種配色（一般／色盲）烘焙的
var _busy := false
var _queue: Array = []
var _baking: Array = []

func is_ready(cb: bool) -> bool:
	return ring_tex != null and ready_cb == (1 if cb else 0)

func has_type(t: int) -> bool:
	return loc.has(t)

## 腳底在格子裡的位置：往前伸得很長的長槍兵靠左、很寬的小石魔靠右，其他都一樣。
static func origin_of(type: int) -> Vector2:
	return Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160))

## 全部清掉，烘舊 10 種和腳底圈。
func build(cb: bool) -> void:
	if DisplayServer.get_name() == "headless":
		return
	pages.clear()
	loc.clear()
	_queue.clear()
	ring_tex = null
	ready_cb = 1 if cb else 0
	var base: Array = []
	for t in D.COUNT:
		base.append(t)
	await _bake_ring(cb)
	await ensure(base)

## 這場要用到的兵種。缺的才烘；烘的時候呼叫端先直接畫。
func ensure(types: Array) -> void:
	if DisplayServer.get_name() == "headless" or ready_cb < 0:
			_text(Vector2(640, 354), L.t("leave_body_gauntlet") if mode == Mode.GAUNTLET else L.t("leave_body_series"), tz("B"), Color(1, 1, 1, 0.85), true, false, 540)
			_btn(Rect2(380, 450, 250, 52), L.t("leave_stay"), func(): overlay = "", true, true)
			_btn(Rect2(650, 450, 250, 52), L.t("leave_go"), func(): _leave_confirm())
		"tutorial", "puzzles":
			var tut := overlay == "tutorial"
			puzzle_tab = clampi(puzzle_tab, 0, PZ.CHAPTERS - 1)
			var chap: Array = PZ.chapter(puzzle_tab + 1)
			var list: Array = PZ.tutorials() if tut else chap
			var stars: Dictionary = Save.data.get("puzzle_stars", {})
			_panel(Rect2(240, 110, 800, 580))
			_text(Vector2(640, 114), L.t("menu_tutorial") if tut else L.t("puzzle_title"), ts(26), Color.WHITE, true, true)
			var y0 := 210.0
			var idx: Array = []
			for i0 in list.size():
				idx.append(i0)
			if not tut:
				# 第十三輪：10 章，左右切換；章名旁寫這章的星數，下面一行是開場小故事
				var total := 0
				var all_total := 0
				for pz0 in chap:
					total += int(stars.get(pz0["id"], 0))
				for pz1 in PZ.all_puzzles():
					all_total += int(stars.get(pz1["id"], 0))
				var info := PZ.chapter_info(puzzle_tab + 1)
				var cname: String = str(info.get("zh" if L.lang == "zh_TW" else "en", ""))
				_btn(Rect2(280, 158, 48, 40), "◀", func(): puzzle_tab = wrapi(puzzle_tab - 1, 0, PZ.CHAPTERS), puzzle_tab > 0 and not _demo())
				_btn(Rect2(952, 158, 48, 40), "▶", func(): puzzle_tab = wrapi(puzzle_tab + 1, 0, PZ.CHAPTERS), puzzle_tab < PZ.CHAPTERS - 1 and not _demo())
				_text(Vector2(640, 162), L.t("chapter_head", [puzzle_tab + 1, cname, total, chap.size() * 3]), tz("B"), ACCENT, true, true, 600)
				var story: String = str(info.get("story_zh" if L.lang == "zh_TW" else "story_en", ""))
				_text(Vector2(640, 162 + tz("B") * 1.5), story, tz("C"), Color(1, 1, 1, 0.75), true, false, 700)
				y0 = 162 + tz("B") * 1.5 + text_h(story, tz("C"), 700) + 10
				_text(Vector2(280, 648), L.t("puzzle_all_stars", [all_total, PZ.all_puzzles().size() * 3]), tz("C"), Color(1, 1, 1, 0.7), false, false, 260)
				_btn(Rect2(800, 640, 200, 36), ("✓ " if puzzle_only_open else "") + L.t("puzzle_only_open"), func(): puzzle_only_open = not puzzle_only_open)
				if puzzle_only_open:
					idx = idx.filter(func(k): return int(stars.get(list[k]["id"], 0)) < 3)
			var step: float = minf(82.0, (632.0 - y0) / 5.0)
			for k in idx.size():
				var i: int = idx[k]
				var pz: Dictionary = list[i]
				var r := Rect2(280 + (k % 2) * 370, y0 + (k / 2) * step, 350, step - 14)
				var name: String = pz["zh"] if L.lang == "zh_TW" else pz["en"]
				var st := int(stars.get(pz["id"], 0))
				var en: bool = not _demo() or tut or (puzzle_tab == 0 and i < Presets.DEMO_PUZZLES)   # 第十一輪：關卡全開，只有試玩版有範圍
				var line := "%s%d. %s　%s" % ["✓ " if st > 0 else "", i + 1, name, "★".repeat(st) + "☆".repeat(3 - st)]
				if pz.has("unit") and not RS.available(int(pz["unit"]), _demo()):
					en = false
					line = "%d. %s（%s）" % [i + 1, name, L.t("locked_demo")]
				# 第七輪：標籤靠左、讓開左邊的迷你敵陣（原本置中會被縮圖蓋住）
				_btn(r, "", _pick_puzzle.bind(pz["id"], tut), en, false,
					Color(0.15, 0.32, 0.22) if st > 0 else Color(0, 0, 0, 0))
				_probe_btn_label = true
				_probe_btn_rect = r
				_text(r.position + Vector2(64, 8), line, tz("S"), Color.WHITE if en else Color(1, 1, 1, 0.4), false, false, r.size.x - 72)
				_probe_btn_label = false
				# 第七輪 E12：關卡鈕直接看得到預算、可用兵種、星級條件
				# 關卡名稱換行時（英文大字）就不再放預覽，避免互壓
