## 第十輪 R1：試玩版的範圍集中在這裡。匯入的規則與陣型都走這條。
func _demo_ok(r, a = null) -> bool:
	var mask: int = RS.mask(true)
	if r != null:
		if not r.map_id in Presets.DEMO_MAPS:
			return false
		if r.pool_of(0) & ~mask != 0 or r.pool_of(1) & ~mask != 0:
			return false
	if a != null:
		for u in a.units:
			if not RuleSet.has(mask, int(u["type"])):
				return false
	return true

