     1	extends RefCounted
     2	## V1.1 D3：殘局工坊碼 NTP1。打贏一場格子對戰 → 把敵陣＋自己的解做成殘局碼傳給朋友解。
     3	## 作者的解就是「可解」的證明：匯入時先驗格式與合法性，再用殘局同一套判定（PZ.play）重跑作者解，要過關才收。
     4	## 星數門檻＝作者的成績：剩餘戰力 ≥ 作者（2 星）、花費 ≤ 作者（3 星）。不寫進存檔、不算殘局進度。
     5	## 格式：NTP1.<base64url(JSON {"v":1,"e":敵陣,"s":作者解,"a":可用兵種})>.<sha256 前 6 碼>；敵陣欄 10～15、解欄 0～5、列 0～8。
     6	
     7	const PZ = preload("res://scripts/game/puzzles.gd")
     8	const D = preload("res://scripts/core/unit_defs.gd")
     9	const PREFIX := "NTP1"
    10	const MAX_UNITS := 40
    11	const MAX_LEN := 6000
    12	const ID := "ws"
    13	
    14	static func _clean(list, c0: int, c1: int) -> Array:
    15		if not list is Array or list.is_empty() or list.size() > MAX_UNITS:
    16			return []
    17		var out: Array = []
    18		var seen := {}
    19		for e in list:
    20			if not e is Array or e.size() != 3:
    21				return []
    22			for v in e:
    23				if not (v is int or v is float) or float(v) != floorf(float(v)):
    24					return []
    25			var t := int(e[0])
    26			var c := int(e[1])
    27			var r := int(e[2])
    28			if t < 0 or t >= D.total() or c < c0 or c > c1 or r < 0 or r >= 9:
    29				return []
    30			var key := c * 16 + r
    31			if seen.has(key):
    32				return []
    33			seen[key] = true
    34			out.append([t, c, r])
    35		return out
    36	
