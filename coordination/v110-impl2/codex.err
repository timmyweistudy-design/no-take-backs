const BOMB_SHIELD_NUM := 5      # 火罐專拆盾牆：主擊與波及打盾兵 ×5/2（第四輪平衡：沒有這條時投彈兵打不贏盾兵為主的陣）
const BOMB_SHIELD_DEN := 2
