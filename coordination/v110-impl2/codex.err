    54	## 解碼＋驗證＋重跑作者解。回傳 {ok, pz, sol, why}。
    55	static func decode(code: String) -> Dictionary:
    56		var bad := {"ok": false, "why": "ws_bad"}
    57		code = code.strip_edges()
    58		var parts := code.split(".")
    59		if code.length() > MAX_LEN or parts.size() != 3 or parts[0] != PREFIX or parts[1].sha256_text().substr(0, 6) != parts[2]:
    60			return bad
