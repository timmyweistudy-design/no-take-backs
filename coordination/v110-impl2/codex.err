func _draw_units_of(s, dim: bool) -> void:
	var list: Array = []
	for u in s.units:
		if u.alive:
			list.append(u)
	var live: bool = s == view
	if live:
		list.sort_custom(func(a, b): return _upos(a).y < _upos(b).y)
	else:
		list.sort_custom(func(a, b): return a.y < b.y)
	_draw_v8_ground(s, live)
	# 第一層：腳底標記與影子（全部先畫，不會被別人的身體整個蓋住時也看得到外圈）
	var a_now := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
	var gm: Array = _goal_mark()
	for u in list:
		var p0: Vector2 = _upos(u) if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
		var air0: float = Gait.air(u.type, _walk_of(u, a_now)) if live else 0.0
		_ring(p0, u.team, u.type, UNIT_SCALE * (1.0 - air0 * 0.018))   # 跳起來影子縮一點
		if u.shield > 0:       # 第十二輪：手動技能的護盾、戰吼
			draw_arc(p0 + Vector2(0, -24) * UNIT_SCALE, 28.0 * UNIT_SCALE, 0, TAU, 24, Color(0.55, 0.85, 1.0, 0.75), 2.5, true)
		if u.haste_t > 0:
			draw_arc(p0, 19.0 * UNIT_SCALE, 0, TAU, 20, Color(1.0, 0.75, 0.25, 0.85), 2.5, true)
		if u.id == int(gm[0]):
			_goal_marker(p0, str(gm[1]))   # 第十三輪：要護送／斬首的那一隻
		if live and s.rally[u.team] and not s.finished:
			for k in 2:
				var ph := fmod(time * 1.6 + k * 0.5, 1.0)
				draw_arc(p0, (14.0 + ph * 10.0) * UNIT_SCALE, 0, TAU, 20, Color(1, 0.42, 0.0, 0.55 * (1.0 - ph)), 2.0, true)
	# 陣亡痕跡：倒下處的小旗，3 秒淡出，畫在最底層（第三輪 R5）
	if live:
		for g in graves:
			var ga: float = 1.0 - g["t"] / 3.0
			var gp: Vector2 = g["pos"]
			draw_line(gp + Vector2(0, 2), gp + Vector2(0, -16), Color(0.35, 0.27, 0.2, 0.8 * ga), 2.0, true)
			draw_colored_polygon(PackedVector2Array([gp + Vector2(0, -16), gp + Vector2(10, -12), gp + Vector2(0, -8)]), Color(Art.team_color(g["team"], cbm()), 0.75 * ga))
			draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.4), 0, gp + Vector2(0, 2)))   # 疊在鏡頭上（Codex S4 #5）
			draw_circle(Vector2.ZERO, 7, Color(0, 0, 0, 0.25 * ga), true, -1.0, true)
			draw_set_transform_matrix(_cam)
	# 擁擠度：40px 內有幾隻（第三輪 V5，只在戰鬥中算）
	var crowd := {}
	if live:
		var pos: Array = []
		for u in list:
			pos.append(_upos(u))
		for a in list.size():
			var n := 0
			for b in list.size():
				if a != b and pos[a].distance_squared_to(pos[b]) < 1600.0:
					n += 1
			crowd[list[a].id] = n
	# 第二層：身體（V9：地圖的前景物件依腳點 y 插進來，才有前後遮擋）
	var prop_i := 0
	var xray: Array = []   # V1.1 C5：[腳點, 參數]，給被下排蓋到臉的那隻補畫半透明
	for u in list:
		var p: Vector2 = _upos(u) if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
		while prop_i < fld_props.size() and ORIGIN.y + float(fld_props[prop_i][0]) <= p.y:
			MapArt.draw_prop(self, ORIGIN, fld_props[prop_i], time)
			prop_i += 1
		var walk: float = _walk_of(u, a_now) if live else ((time * Gait.nominal_rate(u.type, float(D.stat(u.type)["speed"]), CS, UNIT_SCALE) + u.id) if (u.mx != 0 or u.my != 0) else 0.0)
		var moving: bool = walk > 0.0
		# 表情與兵種專屬動作（R5）
		var mood := 0
		var lean := 0.0
		var crouch := 1.0
		if hurt > 0.3 or u.stun > 0:
			mood |= Art.M_HURT
		if hurt > 0.0:
			crouch *= 1.0 - 0.12 * hurt                 # V1.1 A2：受擊壓扁（縱 0.88），配合後退與閃白
			lean -= 0.06 * hurt * float(hurt_dir.get(u.id, 0.0)) * face
		if live and u.windup > 0 and at == 0.0:
			# V1.1 A3：大招前搖的身體預警。小石魔高舉拉長、吸塵貓吸氣鼓脹、沙漏精靈與骷髏法師浮起
			var wk := 1.0 - float(u.windup) / F8.WINDUP
			if u.type == F8.GOLEM:
				at = Art.ATK_WINDUP * minf(1.0, wk * 1.4) * 0.999
			elif u.type == F8.CAT:
				crouch *= 1.0 + 0.14 * sin(minf(1.0, wk) * PI * 0.5)
			else:
				p.y -= 4.0 * sin(minf(1.0, wk) * PI * 0.5)
		if u.type == D.CAVALRY and moving and u.charge >= D.CHARGE_NEED:
			mood |= Art.M_SPARKLE
			lean = 0.26                      # 衝鋒蓄滿前傾 15°
			for k in 3:                      # 馬蹄噴土
				var ph := fmod(time * 4.0 + k * 0.33 + u.id * 0.1, 1.0)
				draw_circle(p + Vector2(-face * (14 + ph * 16), -2 - ph * 6), 3.2 * (1.0 - ph), Color(0.85, 0.75, 0.55, 0.7 * (1.0 - ph)), true, -1.0, true)
		if s.frenzy and at == 0.0 and not s.finished:
			mood |= Art.M_BROWS
			# 狂熱氣場（第三輪 R3）：身邊橘紅脈衝圈
			var pulse := 0.5 + 0.5 * sin(time * 7.0 + u.id)
			draw_arc(p + Vector2(0, -22), 15.0 + pulse * 3.0, 0, TAU, 20, Color(1.0, 0.33, 0.2, (0.35 + 0.3 * pulse) * alpha), 2.0, true)
		if u.type == D.ASSASSIN and u.stealth > 0:
			mood |= Art.M_HOOD
			crouch = 0.9                     # 潛行蹲身
		if live and brace_t.has(u.id) and time - brace_t[u.id] < 0.35:
			mood |= Art.M_BRACE
		# 勝利：存活的勝方每 0.45 秒原地跳 10px、武器高舉
		var hop := 0.0
		if live and sim != null and u.team == sim.winner and (state == St.RESULT or (state == St.BATTLE and view != null and view.finished)):
			hop = absf(sin((time + u.id * 0.05) * PI / 0.45)) * 10.0
			at = Art.ATK_WINDUP
			lean = Art.windup_lean(u.type)      # 抵銷前搖的後仰（V1.1：依兵種）：站直、武器高舉（和前搖分得開，Antigravity S4）
			crouch = 1.06
			_star_above(p + Vector2(0, -hop - (74 if u.type == D.CAVALRY else 66)))
			# V1.1 A7：兵種專屬的勝利小動作
			match u.type:
				D.DRUMMER:   # 鼓手：頭邊冒音符
					var nk := fmod(time * 1.6 + u.id * 0.3, 1.0)
					_icon("sound", p + Vector2(18 + nk * 8, -48 - nk * 22 - hop), 14.0, Color(1.0, 0.85, 0.4, 1.0 - nk))
				D.BERSERKER:   # 狂戰士：雙斧互敲的火花圈
					var bk := absf(sin((time + u.id * 0.05) * PI / 0.45))
					draw_arc(p + Vector2(0, -50 - hop), 8.0 + bk * 6.0, 0, TAU, 16, Color(1.0, 0.55, 0.2, 0.8 * bk), 2.5, true)
				D.MEDIC:   # 醫者：綠色小十字往上飄
					var mk := fmod(time * 1.2 + u.id * 0.4, 1.0)
					var mc := p + Vector2(-16, -44 - mk * 24 - hop)
					draw_line(mc - Vector2(4, 0), mc + Vector2(4, 0), Color(0.5, 1.0, 0.55, 1.0 - mk), 2.5)
					draw_line(mc - Vector2(0, 4), mc + Vector2(0, 4), Color(0.5, 1.0, 0.55, 1.0 - mk), 2.5)
		p.y -= hop
		if u.hidden:
			Art.mimic_closed(self, p, u.team, face, alpha, time, cbm(), UNIT_SCALE)   # 偽裝中的寶箱怪
			continue
		if u.type == F8.GHOST:
			alpha *= 0.9
	var taken := [D.zeros(), D.zeros()]
	var mvp = null
	for u in sim.units:
		dealt[u.team][D.report_type(u.type)] += u.dmg_dealt
		taken[u.team][D.report_type(u.type)] += u.dmg_taken
		# MVP：勝方輸出最高的兵（平手時看全場）
		if (sim.winner < 0 or u.team == sim.winner) and (mvp == null or u.dmg_dealt > mvp.dmg_dealt):
			mvp = u
	var sus: Dictionary = sim.suspense()
	report = {"dealt": dealt, "taken": taken, "mvp": mvp, "sus": sus,
		"lock_sec": int(sus["lock_ratio_permille"]) * sim.tick / 1000 / 20}
	# 時間軸的領先交換點（第三輪 U5）：戰力差換號（忽略 1% 以內的小波動），最多 4 個
	var leads: Array = []
	var last_sign := 0
	var eps: int = sim.budget * 1000 / 100
	if sim.judge == 2:
		eps = 10   # 讓子：用各自預算的比例（每千分之十＝1%）
	for t in sim.power_log.size():
		var d: int = sim.power_log[t] if sim.judge == 1 else sim.diff_permille(t)
		var sg := 0 if absi(d) <= eps else (1 if d > 0 else -1)
		if sg != 0 and last_sign != 0 and sg != last_sign and leads.size() < 4:
			leads.append(t + 1)
		if sg != 0:
			last_sign = sg
	report["leads"] = leads
	# 殘局星等算在報告裡（重播也看得到），只有「寫進存檔」才受副作用矩陣管（Codex S1 #8）
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
		var pz := PZ.get_puzzle(puzzle_id)
		var extra_spent: int = armies[0].spent() - (armies[0].budget - int(pz["budget"]))
		var oc := PZ.outcome(pz, sim, extra_spent)   # 第十三輪：和工具、測試同一套判定（含護送、撐住、斬首）
		report["stars"] = int(oc["stars"])
		report["goal_ok"] = bool(oc["ok"])
		report["star_lines"] = _star_lines(bool(oc["ok"]), int(oc["rem"]), int(pz["star2"]), extra_spent, int(pz["star3"]), _goal_text(pz))



func _progress_and_achievements() -> void:
	var w: int = sim.winner
	# 第五輪：紀錄分欄。平衡認證的規則（或沒有規則的模式）＝標準戰績；其他自訂規則記在自訂戰績；沙盒什麼都不記。
	var kind := "duel" if mode == Mode.DUEL else "ai"
	var badge: String = Presets.badge(rules, kind) if rules != null else Presets.BADGE_CERT
	if badge == Presets.BADGE_LAB:
		_save()
extends RefCounted
## 一方的陣型：預算、人數上限、部署區、格子佔用。純資料，不碰畫面。

## 擺放錯誤碼（第七輪 H6）：畫面靠這些常數判斷，不再比對中文字串。查過：這些字串沒有進任何代碼或存檔。
const E_ZONE := "只能放在自己的部署區"
const E_TAKEN := "這格已經有兵"
const E_POOL := "這種兵不在這局的卡池裡"
const E_GOLD := "錢不夠"
const E_RESERVE := "要留錢和名額給至少 1 隻戰鬥兵"
const E_NEAR := "離其他兵太近"
const E_NEAR_ENEMY := "離敵兵太近"
const E_CAP_PREFIX := "最多"
const E_TYPE_CAP_PREFIX := "這種兵最多"
const D = preload("res://scripts/core/unit_defs.gd")

const COLS := 16
const ROWS := 9
const ZONE := 6          # 每邊部署區 6 欄
const MAX_UNITS := 24

var team: int
var budget: int
var units: Array = []    # 每筆 {"type", "col", "row"}
# 第五輪：自訂規則的部署限制（預設值＝1.3.0 行為）
var pool := (1 << D.COUNT) - 1   # 可用兵種遮罩
var unit_cap := MAX_UNITS
var type_cap := 0                # 單種上限，0＝不限
var guard_combat := false        # 防卡死：還沒擺戰鬥兵時，不准擺到買不起戰鬥兵（只有玩家擺放與 AI 用，載入舊代碼不開）
# 第六輪：自由排兵（docs/2026-11-03-free-placement-plan-v6.md §3）
# 自由部署的 units 每筆是 {"type", "x", "y"}（世界座標、量化到 50）；格子部署照舊 {"type", "col", "row"}。
const W := COLS * 1000
const H := ROWS * 1000
const EDGE := 200
const QUANT := 50
const E_TERRAIN := "err_terrain"
var deploy := "grid"
var spacing := 1000              # 己方兩隻的最小中心距離
var depth := 6000                # 自己視角 x 上限（全場＝15800）
var enemy_pos: Array = []        # 全場時：敵兵的世界座標（Vector2i），離它們至少 ENEMY_GAP
var enemy_gap := 1500
# V9 地圖：場地大小與地形（標準＝16×9、沒有地形）
var fw := W
var fh := H
var terrain = null

func _init(p_team: int = 0, p_budget: int = 100) -> void:
	team = p_team
	budget = p_budget

func spent() -> int:
	var s := 0
	for u in units:
		s += D.cost(u["type"])
	return s

func left() -> int:
	return budget - spent()

func count() -> int:
	return units.size()

func count_of(t: int) -> int:
	var n := 0
	for u in units:
		if u["type"] == t:
			n += 1
	return n

func in_zone(col: int, row: int) -> bool:
	if row < 0 or row >= ROWS:
		return false
	if team == 0:
		return col >= 0 and col < ZONE
	return col >= COLS - ZONE and col < COLS

func index_at(col: int, row: int) -> int:
	for i in units.size():
		if units[i]["col"] == col and units[i]["row"] == row:
			return i
	return -1

## 回傳空字串＝可以放；否則是不能放的原因（顯示給玩家）。
func check_place(t: int, col: int, row: int) -> String:
	if deploy == "free":
		return check_place_xy(t, col * 1000 + 500, row * 1000 + 500)
	if not in_zone(col, row):
		return E_ZONE
	if index_at(col, row) != -1:
		return E_TAKEN
	if terrain != null and terrain.blocked(col * 1000 + 500, row * 1000 + 500, team):
		return E_TERRAIN   # 第十三輪：地形殘局（格子放在地圖上），牆內格子不能放
	return _check_common(t)

## 位置以外的條件（卡池、人數、單種、錢、防卡死），格子與自由共用。
func _check_common(t: int) -> String:
	if t < 0 or t >= D.total() or (pool >> t) & 1 == 0:
		return E_POOL
	if count() >= unit_cap:
		return E_CAP_PREFIX + " %d 隻" % unit_cap
	if type_cap > 0 and count_of(t) >= type_cap:
		return E_TYPE_CAP_PREFIX + " %d 隻" % type_cap
	var hc := D.hard_cap(t)     # 第八輪：奇幻兵一隊的硬上限
	if hc > 0 and count_of(t) >= hc:
		return E_TYPE_CAP_PREFIX + " %d 隻" % hc
	if D.cost(t) > left():

