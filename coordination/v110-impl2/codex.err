func run_to_end() -> void:
	while not finished:
		step()

# ───────────────────────── 一個 tick ─────────────────────────
func step() -> void:
	if finished:
		return
	tick += 1
	frenzy = tick >= frenzy_at and not skill_off.has("frenzy")
	events = []
	var n := units.size()
	if cmd_on:
		_cmd_tick(n)

	# ① 快照（之後的選目標、碰撞都只讀這些陣列）
	var sx := PackedInt64Array()
	var sy := PackedInt64Array()
	var st := PackedInt64Array()     # 隊伍
	var sk := PackedInt64Array()     # 兵種
	var sh := PackedInt64Array()     # 血
	var sv := PackedByteArray()      # 可被選為目標（活著且沒潛行）
	sx.resize(n); sy.resize(n); st.resize(n); sk.resize(n); sh.resize(n); sv.resize(n)
	for i in n:
		var u := units[i]
		sx[i] = u.x
		sy[i] = u.y
		st[i] = u.team
		sk[i] = u.type
		sh[i] = u.hp
		sv[i] = 1 if (u.alive and u.stealth == 0) else 0
	var sc := sv        # 碰撞用（舊場次就是 sv）
	var sa := sv        # 範圍傷害用（舊場次就是 sv）
	if v8:
		sa = sv.duplicate()
		_v8_pre_tick(n, sx, sy, st, sv)
		sc = sv.duplicate()
		for i in n:
			if units[i].alive and units[i].type == F8.GHOST and not skill_off.has("ghost"):
				sc[i] = 0      # 幽靈穿過所有兵
				sa[i] = 0      # 火罐波及打不到幽靈
	if terrain != null:
		if not v8:
			for u0 in units:
				u0.zone = 100
		_t_pre_tick(n)
	# 每隊還活著的戰鬥兵（非支援）數量：支援兵用來決定「支援模式」還是「自己打」（第四輪）
	var fighters := [0, 0]
	for i in n:
		if units[i].alive and D.is_combat(units[i].type):
			fighters[units[i].team] += 1

	# ② 選目標＋提出移動
	# V1.1 E4：每隊「可被選的敵人」索引先列好（遞增順序，和原本逐一掃描跳過的結果完全一樣），選目標只掃這份
	_foes = [PackedInt32Array(), PackedInt32Array()]
	for j0 in n:
		if sv[j0] != 0:
			_foes[1 - st[j0]].append(j0)
	var nx := sx.duplicate()
	var ny := sy.duplicate()
	var new_target := PackedInt64Array()
	var new_fx := PackedInt64Array()
	var new_fy := PackedInt64Array()
	var new_lock := PackedInt64Array()
	new_target.resize(n); new_fx.resize(n); new_fy.resize(n); new_lock.resize(n)
	for i in n:
		var u := units[i]
		new_target[i] = u.target
		new_fx[i] = u.fx
		new_fy[i] = u.fy
		new_lock[i] = -1
		u.mx = 0
		u.my = 0
		if not u.alive:
			continue
		u.follow = -1
		u.bmode = 0
		if D.is_support(u.type) and fighters[u.team] > 0:
			# 支援模式（第四輪 §2.3／§2.5）：不選敵人，跟隨友軍
			new_target[i] = -1
			if u.stun > 0:
				continue
			var fp := _support_point(i, sx, sy, sh)
			var bx := fp.x - D.SUPPORT_BACK if u.team == 0 else fp.x + D.SUPPORT_BACK
			var dest_sx := clampi(bx, EDGE, fw - EDGE)
			var dest_sy := clampi(fp.y, EDGE, fh - EDGE)
			if terrain != null:
				var sw := _t_nav(i, u, dest_sx, dest_sy)
				dest_sx = sw.x
				dest_sy = sw.y
			var sdx := dest_sx - u.x
			var sdy := dest_sy - u.y
			var sl := M.isqrt(sdx * sdx + sdy * sdy)
			if sl > D.SUPPORT_STOP:
				var sstp := mini(u.speed * u.zone / 100, sl)
				u.mx = sdx * sstp / sl
				u.my = sdy * sstp / sl
				nx[i] = u.x + u.mx
				ny[i] = u.y + u.my
			var sf := M.unit1000(fp.x - u.x, fp.y - u.y)
			if sf != Vector2i.ZERO:
				new_fx[i] = sf.x
				new_fy[i] = sf.y
			continue
		if v8 and (u.type == F8.SPORE or u.hidden):
			new_target[i] = -1   # 孢子菇不動；寶箱怪偽裝中不動
			continue
		var t := -1
		if u.type == D.BOMBER:
			# 投彈兵（第四輪 §2.2）：最近的「可見」敵人在 1.5 格內 → 這一 tick 敲人；否則只從 ≥1.5 格的敵人裡選丟彈目標
			var near2 := _nearest_visible_enemy_d2(i, sx, sy, st, sv)
			if near2 >= 0 and near2 < D.BOMB_MIN * D.BOMB_MIN:
				u.bmode = 2
				t = _choose_target(i, sx, sy, st, sk, sh, sv)
			elif near2 >= 0:
				u.bmode = 1
				t = _choose_target(i, sx, sy, st, sk, sh, sv, D.BOMB_MIN * D.BOMB_MIN)
		else:
			t = _choose_target(i, sx, sy, st, sk, sh, sv)
		new_target[i] = t
		# 技能事件（只給畫面與圖鑑用，不進指紋）：被盾兵嘲諷吸走
		if t != -1 and t != u.target and _last_rank == 1:
			events.append({"kind": EV.TAUNT, "src": units[t].id, "tgt": u.id, "tags": [EV.TAUNT]})
		if t == -1 or u.stun > 0:
			continue
		var tg := units[t]
		var reach := u.reach if u.bmode != 2 else D.BONK_REACH
		var d2 := M.dist2(u.x, u.y, tg.x, tg.y)
		var dest_x := tg.x
		var dest_y := tg.y
		var stop_at := reach - 50
		var flanking := false
		if u.type == D.ASSASSIN and u.stealth > 0:
			# 潛行中繞到目標背後（目的地夾在場內）
			dest_x = clampi(tg.x - tg.fx * D.BEHIND_DIST / 1000, EDGE, fw - EDGE)
			dest_y = clampi(tg.y - tg.fy * D.BEHIND_DIST / 1000, EDGE, fh - EDGE)
			stop_at = 0
		elif u.type == D.CAVALRY:
			var wp := _flank_waypoint(i, t)
			if wp.x >= 0:
				if d2 <= reach * reach:
					u.nav = 2            # 敵人已在射程內：結束繞翼直接開打，不卡在未完成狀態
				else:
					dest_x = wp.x
					dest_y = wp.y
					stop_at = 0
					flanking = true

## 選目標（企劃 §3.3）：排除潛行 → 弓手警覺 → 盾兵嘲諷（近戰）→ 兵種偏好 → 距離 → 剩血 → 列 → 深度 → 編號。
## 只讀快照陣列，比較全部用整數（不配置陣列）。
var _foes: Array = [PackedInt32Array(), PackedInt32Array()]   # V1.1 E4：這一 tick 每隊可選的敵人（只在 step 的 ② 有效）

func _choose_target(i: int, sx: PackedInt64Array, sy: PackedInt64Array, st: PackedInt64Array,
		sk: PackedInt64Array, sh: PackedInt64Array, sv: PackedByteArray, min_d2 := 0) -> int:
	var my_team: int = st[i]
	var my_type: int = sk[i]
	var ux: int = sx[i]
	var uy: int = sy[i]
	var reach: int = units[i].reach
	var reach2 := reach * reach
	var taunt2 := -1 if skill_off.has("taunt") else D.TAUNT_RANGE * D.TAUNT_RANGE
	var melee := D.is_melee(my_type) and my_type != F8.GHOST   # 幽靈不受嘲諷
	var no_ghost: bool = v8 and (my_type == D.ARCHER or my_type == D.BOMBER) and not skill_off.has("ghost")   # 箭、火罐打不到幽靈
	var best := -1
	var b_rank := 99
	_last_rank = 99
	var b_d2 := 0
	var b_hp := 0
	var b_y := 0
	var b_dep := 0
	var foes: PackedInt32Array = _foes[my_team]
	# V1.1 E4：這種攻擊者最好能給到的優先級。目前最佳已經是這一級時，比它遠的敵人不可能勝出（優先級只會 ≥、距離又較遠），直接跳過
	var min_r := 3
	if my_type == D.ARCHER:
		min_r = 0
	elif melee and taunt2 >= 0:
		min_r = 1
	elif my_type == F8.GHOST or my_type == D.CAVALRY or my_type == D.ASSASSIN:
		min_r = 2
	for j in foes:
		var dx: int = sx[j] - ux
		var dy: int = sy[j] - uy
		var d2 := dx * dx + dy * dy
		if best != -1 and d2 > b_d2:
			# 這隻敵人「最好」能拿到的優先級：嘲諷（1）只在嘲諷距離內、弓手盯刺客（0）只在射程內，超出就退回這種攻擊者的次一級
			var cmin := min_r
			if cmin == 0 and d2 > reach2:
				cmin = 3
			elif cmin == 1 and d2 > taunt2:
				cmin = 2 if (my_type == D.CAVALRY or my_type == D.ASSASSIN) else 3
			if b_rank <= cmin:
				continue
		if d2 < min_d2:
			continue   # 投彈兵丟彈：最短射程內的不選（第四輪）
		var et: int = sk[j]
		if no_ghost and et == F8.GHOST:
			continue
		var rank := 3
		if my_type == F8.GHOST and (et == D.ARCHER or et == D.BOMBER or et == F8.BONE or D.is_support(et)):
			rank = 2   # 幽靈優先打遠程與支援
		if my_type == D.ARCHER and et == D.ASSASSIN and d2 <= reach2:
			rank = 0
		elif rank == 2:
			pass
		elif melee and et == D.SHIELD and d2 <= taunt2 and units[j].breach == 0:
			rank = 1   # 被破陣的盾兵不嘲諷（第四輪）
		elif my_type == D.CAVALRY and (et == D.ARCHER or et == D.MEDIC or et == D.BOMBER):
			rank = 2
		elif my_type == D.ASSASSIN and (et == D.SHIELD or et == D.CAVALRY or et == D.MEDIC):
			rank = 2
		if best != -1:
			if rank > b_rank:
				continue
			if rank == b_rank:
				if d2 > b_d2:
					continue
				if d2 == b_d2:
					var hp: int = sh[j]
					if hp > b_hp:
						continue
					if hp == b_hp:
						var ey: int = sy[j]
						if ey > b_y:
							continue
						if ey == b_y:
							var dep: int = sx[j] if st[j] == 0 else fw - sx[j]
							if dep >= b_dep:
								continue
		best = j
		b_rank = rank
		b_d2 = d2
		b_hp = sh[j]
		b_y = sy[j]
		b_dep = sx[j] if st[j] == 0 else fw - sx[j]
	_last_rank = b_rank
	return best

## ───────────────────────── 第四輪新兵種 ─────────────────────────

## ───────────────────────── 第八輪新兵 ─────────────────────────

## 開戰前：預留生出來的兵（alive=false、不佔位置、不被選），索引和指紋欄位數固定；生兵絕不會因為沒位置失敗。
func _v8_setup() -> void:
extends RefCounted
const D_TOTAL := 20
## 教學與殘局關卡資料（data/puzzles.json）。

const Army = preload("res://scripts/core/army.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const RS = preload("res://scripts/core/ruleset.gd")
const Sim = preload("res://scripts/core/battle_sim.gd")
const CMD = preload("res://scripts/core/cmd_defs.gd")
## 第十三輪：10 章，每章 10 關（V1.1 加第 11 章）。1＝經典 p、2＝新兵 n＋extra、3＝奇幻 f，其他都在 extra（"ch" 欄）。
const CHAPTERS := 11   # V1.1：第 11 章完美主義
const GOALS := ["win", "protect", "survive", "kill", "flawless", "margin"]   # V1.1 D5：後兩種只看戰後狀態
const MAP_SIZE := 1             # 地形殘局只用中尺寸（16×9＝格子殘局的場地）

static var _data := {}
static var _custom := {}   # V1.1 D3：工坊碼匯入的那一關（id "ws"），不進清單、不存星數

static func set_custom(pz: Dictionary) -> void:
	_custom = pz

static func _load() -> void:
	if not _data.is_empty():
		return
	var parsed = JSON.parse_string(FileAccess.get_file_as_string("res://data/puzzles.json"))
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("puzzles.json 讀不到")
		return
	_data = parsed
	for p in _data["tutorial"]:
		p["tutorial"] = true

static func tutorials() -> Array:
	_load()
	return _data["tutorial"]

static func puzzles() -> Array:
	_load()
	return _data["puzzles"]

## 新兵試玩（第四輪 §4.8）：每種新兵一關，unit＝主角兵種；兵種解鎖後才能玩。
static func new_puzzles() -> Array:
	_load()
	return _data.get("new_units", [])

## 奇幻軍試玩（第八輪）：每種一關。
static func fantasy_puzzles() -> Array:
	_load()
	return _data.get("fantasy_units", [])

## 第十三輪新增的關卡（每關有 "ch"）。
static func extra_puzzles() -> Array:
	_load()
	return _data.get("extra", [])

## 第 n 章（1 起算）的關卡，照資料順序。
static func chapter(n: int) -> Array:
	var out: Array = []
	match n:
		1:
			out = puzzles().duplicate()
		2:
			out = new_puzzles().duplicate()
		3:
			out = fantasy_puzzles().duplicate()
	for p in extra_puzzles():
		if int(p.get("ch", 0)) == n:
			out.append(p)
	return out

## 全部殘局（不含教學），依章節順序。
static func all_puzzles() -> Array:
	var out: Array = []
	for n in range(1, CHAPTERS + 1):
		out += chapter(n)
	return out

## 章節資訊（名稱、開場小故事）。
static func chapter_info(n: int) -> Dictionary:
	_load()
	var cs: Array = _data.get("chapters", [])
	return cs[n - 1] if n >= 1 and n <= cs.size() else {}

## 這關在第幾章（教學回 0）。
static func chapter_of(id: String) -> int:
	for n in range(1, CHAPTERS + 1):
		for p in chapter(n):
			if p["id"] == id:
				return n
	return 0

static func all_ids() -> Array:
	var out: Array = []
	for p in tutorials() + all_puzzles():
		out.append(p["id"])
	return out

static func get_puzzle(id: String) -> Dictionary:
	if id == "ws":
		return _custom
	for p in tutorials() + all_puzzles():
		if p["id"] == id:
			return p
	return {}

static func enemy_army(pz: Dictionary) -> Army:
	var a := Army.new(1, 200)
	for e in pz["enemy"]:
		a.units.append({"type": int(e[0]), "col": int(e[1]), "row": int(e[2])})
	return a

## 玩家陣：固定兵已經擺好；預算＝固定兵花費＋可再花的錢，所以「剩餘戰力」照總投入算。
static func player_army(pz: Dictionary) -> Army:
	var fixed_cost := 0
	var a := Army.new(0, 100)
	a.pool = (1 << D_TOTAL) - 1
	for f in pz["fixed"]:
		a.units.append({"type": int(f[0]), "col": int(f[1]), "row": int(f[2])})
		fixed_cost += Army.D.cost(int(f[0]))
	a.budget = fixed_cost + int(pz["budget"])
	if pz.has("cap"):
		a.unit_cap = pz["fixed"].size() + int(pz["cap"])   # 限隻數：可再放 cap 隻
	if pz.has("map"):
		a.terrain = rules_of(pz).terrain()   # 牆內格子不能放
	return a

static func goal(pz: Dictionary) -> String:
	return str(pz.get("goal", "win"))

## 這關要不要用規則（地形、撐住秒數、技能）。不用就回 null，走舊模擬路徑。
static func rules_of(pz: Dictionary):
	if not pz.has("map") and goal(pz) != "survive" and not pz.has("cmd"):
		return null
	var r = RS.standard()
	r.preset = "custom"
	r.map_id = int(pz.get("map", 0))
	r.map_size = MAP_SIZE
	if goal(pz) == "survive":
		r.ticks = int(pz["goal_ticks"])
	if pz.has("cmd"):
		var c: Dictionary = pz["cmd"]
		var em := 0
		for e in c.get("enemy", []):
			em |= 1 << int(e[1])
		r.cmd_mask = [1 << int(c["skill"]), em]
		r.cmd_uses = int(c.get("uses", 1))
		r.cmd_cd = int(c.get("cd", CMD.CD_TICKS[0]))
		r.cmd_power = 100
	return r

## 技能關：玩家設定的施放 tick（plan）＋敵方寫死的時間 → 重播紀錄。
static func cmd_log(pz: Dictionary, plan: Array) -> Array:
	if not pz.has("cmd"):
		return []
	var log: Array = []
	for t in plan:
		log.append([int(t), 0, int(pz["cmd"]["skill"])])
	for e in pz["cmd"].get("enemy", []):
		log.append([int(e[0]), 1, int(e[1])])
	log.sort_custom(func(a, b): return a[0] < b[0] or (a[0] == b[0] and a[1] < b[1]))
	return log

## 預設施放時間（還沒調整時）：開場能放的最早時間起，每次隔一個冷卻。
static func default_plan(pz: Dictionary) -> Array:
	var out: Array = []
	if not pz.has("cmd"):
		return out
	var r = rules_of(pz)
	for i in int(pz["cmd"].get("uses", 1)):
		out.append(CMD.START_TICKS + i * r.cmd_cd)
	return out

## 格子座標的單位在模擬裡還活著嗎（team 0 用自己的欄，敵方用絕對欄）。
static func unit_alive(sim, team: int, cell: Array) -> bool:
	var id: int = team * 1000 + int(cell[1]) * Sim.COLS + int(cell[0])
	for u in sim.units:
		if u.id == id:
			return u.alive
	return false

## 我方某兵種倒了幾隻（召喚物不算我方擺的兵）。
static func lost_of_type(sim, t: int) -> int:
	var n := 0
	for u in sim.units:
		if u.team == 0 and u.type == t and not u.alive and not u.summon:
			n += 1
	return n

## 打完之後：這關算不算過、剩餘戰力、星數、各條件（遊戲、工具、測試共用）。
static func outcome(pz: Dictionary, sim, spent_extra: int) -> Dictionary:
	var g := goal(pz)
	var won: bool = sim.winner == 0
	var ok := won
	match g:
		"protect":
			ok = won and unit_alive(sim, 0, pz["goal_unit"])
		"kill":
			ok = won and not unit_alive(sim, 1, pz["goal_unit"])
		"survive":
			ok = sim.alive_count(0) > 0
		"flawless":
			ok = won and lost_of_type(sim, int(pz["goal_type"])) == 0   # V1.1 D5：這種兵一隻都不能倒
		"margin":
			ok = won and rem_pct(sim.power(0), sim.budget) >= int(pz["goal_rem"])   # V1.1 D5：贏得夠漂亮
	var rem: int = rem_pct(sim.power(0), sim.budget) if ok else 0
	return {"ok": ok, "won": won, "goal": g, "rem": rem, "spent": spent_extra, "stars": stars(pz, ok, rem, spent_extra)}

## 擺法合不合法（extra＝[[兵種, 欄, 列], ...]；還會檢查可用兵種）。合法回 ""。
static func check_extra(pz: Dictionary, extra: Array) -> String:
	var a0: Army = player_army(pz)
	var allowed: Array = []
	for v in pz.get("allowed", []):
		allowed.append(int(v))
	for e in extra:
		if not allowed.has(int(e[0])):
			return "兵種 %d 不能用" % int(e[0])
		var why: String = a0.check_place(int(e[0]), int(e[1]), int(e[2]))
		if why != "":
			return why
		a0.place(int(e[0]), int(e[1]), int(e[2]))
	return ""

## 直接打一場（工具、測試用；遊戲裡是畫面上的模擬，最後一樣呼叫 outcome）。不合法回 {"ok": false, "illegal": 原因}。
static func play(pz: Dictionary, extra: Array, plan: Array = [], check := true) -> Dictionary:
	if check:
		var why := check_extra(pz, extra)
		if why != "":
			return {"ok": false, "illegal": why, "stars": 0, "rem": 0, "spent": 0}
	var a0: Army = player_army(pz)
	var fixed_budget: int = a0.budget - int(pz["budget"])
	for e in extra:
		a0.units.append({"type": int(e[0]), "col": int(e[1]), "row": int(e[2])})
	var s = Sim.new(a0, enemy_army(pz), rules_of(pz))
	if s.cmd_on:
		s.cmd_play(cmd_log(pz, plan if not plan.is_empty() else default_plan(pz)))
	s.fast = true
	s.run_to_end()
	var out := outcome(pz, s, a0.spent() - fixed_budget)
	out["ticks"] = s.tick
	return out

## 三星編制提示：三星解用了哪些兵（不給位置）。回 [[兵種, 隻數], ...]，照兵種編號。
static func best_lineup(pz: Dictionary) -> Array:
	var cnt := {}
	for e in pz.get("best", {}).get("u", []):
		cnt[int(e[0])] = int(cnt.get(int(e[0]), 0)) + 1
	var ks: Array = cnt.keys()
	ks.sort()
	var out: Array = []
	for k in ks:
		out.append([k, cnt[k]])
	return out

static func is_fixed(pz: Dictionary, col: int, row: int) -> bool:
	for f in pz["fixed"]:
		if int(f[1]) == col and int(f[2]) == row:
			return true
	return false

## 剩餘戰力 %：和結果頁顯示同一個數字（四捨五入），畫面寫 25% 就算 25%。
static func rem_pct(power: int, budget: int) -> int:
	return (power * 200 + budget * 1000) / (budget * 2000)

## 星數：獲勝、剩 ≥star2%、花費 ≤star3，每達成一項一顆星（沒贏就是 0）。
static func stars(pz: Dictionary, won: bool, rem_pct: int, spent_extra: int) -> int:
	if not won:
		return 0
	var s := 1
	if rem_pct >= int(pz["star2"]):
		s += 1
	if spent_extra <= int(pz["star3"]):
		s += 1
	return s


## 這關的「主角」兵種（殘局選單小頭像用）：標準解裡最常出現的兵種；同數取編號小的。
static func hero_type(pz: Dictionary) -> int:
	if pz.has("unit"):
		return int(pz["unit"])
	var cnt := D.zeros()
	for sol in pz.get("solutions", []):
		for e in sol:
			cnt[int(e[0])] += 1
	var best := int(pz["allowed"][0]) if not pz.get("allowed", []).is_empty() else 0
	for t in D.total():
		if cnt[t] > cnt[best]:
			best = t
	return best
extends RefCounted
## ════════════════════════════════════════════════════════════════════
##  《落子無悔》兵種數值表 —— 要調平衡只改這個檔案
## ════════════════════════════════════════════════════════════════════
## 單位換算（全部整數，才能保證兩台電腦算出一樣的結果）：
##   距離：1000 ＝ 1 格        例：reach 700 ＝ 0.7 格
##   時間：1 tick ＝ 1/20 秒   例：cd 20 ＝ 1 秒攻擊一次
##   速度：千分之一格／tick     例：speed 60 ＝ 每秒 1.2 格（60×20÷1000）
##   倍率：寫成「分子／分母」   例：NUM 5、DEN 2 ＝ ×2.5
## 改完跑：cd game && godot --headless --path . --script res://tools/balance/balance.gd

enum { SWORD, SHIELD, ARCHER, CAVALRY, ASSASSIN, PIKE, BOMBER, MEDIC, DRUMMER, BERSERKER }

## 規則版本：改了戰鬥規則（不是只改數值）就要升版；重播與陣型代碼會帶這個版本。
const RULES_VERSION := "1.3.0"     # 1.3.0：第四輪新增五種兵（長槍兵、投彈兵、醫者、鼓手、狂戰士）；1.2.0：繞翼狀態機、途經點離邊、騎兵追擊遲滯
const RULES_VERSION_INT := 10300

const COUNT := 10
const CLASSIC := 5      # 經典 5 種（編號 0～4）；第四輪新兵是 5～9
const NAMES := ["劍士", "盾兵", "弓箭手", "騎兵", "刺客", "長槍兵", "投彈兵", "醫者", "鼓手", "狂戰士"]
const BLURB := [
	"破盾、被刺客打會反擊",
	"正面擋箭、頂住衝鋒、拒馬（打騎兵×2）、嘲諷近戰",
	"遠程拋射、優先射現形刺客（傷害×1.5）",
	"直衝 3 格後重擊、皮甲（箭傷減半）、繞過盾兵找弓手",
	"開場潛行、背刺×2、絆馬",
	"長柄 1.3 格、隔著前排出手、拒騎",
	"拋火罐範圍傷害、無視舉盾、被貼身只能敲人",
	"補附近血最少的友軍、友軍在時不出手",
	"附近友軍攻速提升、友軍在時不出手",
	"打中盾兵／長槍兵讓它破陣（嘲諷、舉盾、拒騎失效）",
]

# ─── 基本數值 ───
#   cost  ＝ 價錢（金）
