static func _not_combat(t: int) -> bool:
	return not D.is_combat(t)   # 第八輪：奇襲兵也不算戰鬥兵

static func all_pool() -> int:
	return (1 << D.COUNT) - 1      # 舊 10 種。標準、AI、舊規則都看這個，不能跟著新兵變大

## 第八輪：新舊 20 種全部（只給驗證與大廳用）。
static func full_pool() -> int:
	return (1 << D.total()) - 1

## 這個卡池有沒有用到新兵。
static func has_new(p: int) -> bool:
	return p > all_pool()

static func prefix_pool(n: int) -> int:
		pre_thread = null
		if v != null:
			replay_total = int(v)

## 不要等：還在算就留給 _pre_reap 收。
func _pre_drop() -> void:
	if pre_thread != null:
		pre_old.append(pre_thread)
		pre_thread = null

func _pre_reap() -> void:
	for i in range(pre_old.size() - 1, -1, -1):
		if not pre_old[i].is_alive():
			pre_old[i].wait_to_finish()
			pre_old.remove_at(i)

func _exit_tree() -> void:
	_pre_join()
	_pre_drop()
	for th in pre_old:
		th.wait_to_finish()
	pre_old.clear()
	if ai_thread != null:
		ai_thread.wait_to_finish()
		ai_thread = null

func _battle_process(delta: float) -> void:
	if pre_thread != null:
		if pre_thread.is_alive():
			return
		_pre_join()
	if view != null:
		_gait_frame(delta)   # 不能放在只有部分情況才跑的地方（Codex P2 #1）
	if start_hold > 0.0:
		start_hold -= delta
		return
	if call("_seek_pump"):
game/scripts/ui/ui_base.gd:221:func _fx_on(k: String) -> bool:
func to_code() -> String:
	if D.uses_new([self]):
		return to_code6()   # 第八輪：用到新兵才用新格式；只有舊兵時輸出不變，舊版還讀得懂
	if deploy == "free":
		return to_code5()
	var b := PackedByteArray([CODE_VERSION, units.size()])
	for u in units:
		var c: int = u["col"] if team == 0 else COLS - 1 - u["col"]
		b.append((int(u["type"]) << 4) | c)
		b.append(u["row"])
	var body := Marshalls.raw_to_base64(b).replace("+", "-").replace("/", "_").replace("=", "")
	return "NTB1.%s.%s" % [body, body.sha256_text().substr(0, 4)]

## 解碼並驗證；成功回傳 ""，失敗回傳原因（不改動目前陣型）。
func load_code(code: String) -> String:
	var parts := code.strip_edges().split(".")
	if parts.size() == 3 and parts[0] == "NTB5":
		return load_code5(code)
	if parts.size() == 3 and parts[0] == "NTB6":
		return load_code6(code)
	if parts.size() != 3 or parts[0] != "NTB1":
		return "格式不對"
