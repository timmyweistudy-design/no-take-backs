# 擺放順序：前排先佔中間（盾、槍、劍、狂），再騎、刺、鼓、醫、彈、弓
const PLACE_ORDER := [1, 5, 0, 9, 3, 4, 8, 7, 6, 2, 19, 13, 15, 12, 10, 18, 14, 16, 11, 17]
const ROW_CENTER := [4, 3, 5, 2, 6, 1, 7, 0, 8]
const ROW_EDGE := [0, 8, 1, 7, 2, 6, 3, 5, 4]

## 這個模板用到的兵種是否都在卡池裡。
static func template_ok(ti: int, pool: int) -> bool:
	var w: Array = TEMPLATES[ti]["w"]
	for t in w.size():
		if w[t] > 0 and not RS.has(pool, t):
			return false
	return true

static func eligible_templates(pool: int) -> Array:
	var out: Array = []
	for ti in TEMPLATES.size():
		if template_ok(ti, pool):
			out.append(ti)
	return out

## pool：卡池遮罩（-1＝全部）；rules：第五輪 Ruleset（套人數／單種上限）。
## 標準卡池時亂數呼叫次數與順序和 1.3.0 相同（金標準靠這個）。
static func build(team: int, budget: int, rng: RandomNumberGenerator, template := -1, pool := -1, rules = null):
	if pool < 0:
		pool = RS.all_pool()
	var a = Army.new(team, budget)
	if RS.has_new(pool):
		a.pool = pool     # 第八輪：奇幻軍要明確開放（舊卡池維持原本的流程）
	if rules != null:
		a.apply_rules(rules, team)
		a.budget = budget
		a.pool = pool
		if rules.is_free():
			a.deploy = "grid"   # 先用格子擺，最後再拉開成自由座標（free_from_grid）
func _go_title() -> void:
	call("_pre_drop")
	Save.retry_pending()   # 第七輪 R7：上次沒寫成功的補寫；還是失敗，標題頁會常駐提示
	sfx.set_muffled(false)
	watch_mode = false
	clutch_t = 0.0
	state = St.TITLE
	overlay = ""
	sim = null
	view = null
	zoom = 1.0
	_focus = 0
	_new_demo()
	sfx.play_music("music_title")
	sfx.play_ambience("")



func _new_demo() -> void:
	var r := RandomNumberGenerator.new()
	r.seed = rng.randi()
	demo = Sim.new(AI.build(0, 100, r)["army"], AI.build(1, 100, r)["army"])
	demo.fast = true
	demo_acc = 0.0



## 第六輪（Codex 實作第 1 輪 #5）：雙人全場被封鎖到跳完手、一方沒有戰鬥兵時，照樣按「開戰」——
## 模擬在第 0 tick 就依 §3.8 判定（有戰鬥兵的一方勝、雙方都沒有＝和局），不能卡在開戰鈕永久灰掉。
func _full_blocked_ok() -> bool:
	return mode == Mode.DUEL and tp != null and tp.done() and rules != null and rules.is_free() and rules.fullfield == RuleSet.FULL_DUEL


func _ready_to_fight() -> bool:
	if mode == Mode.DUEL:
		if tp != null:
			return tp.done() and (rules == null or _full_blocked_ok() or (armies[0].has_combat() and armies[1].has_combat()))
		return blind_phase == 2
	if rules != null:
		return armies[0].has_combat()
	return armies[0].count() > 0



## 第五輪：開戰鈕灰掉時要直接寫的原因（空字串＝可以開戰）。
func _start_block_reason() -> String:
	if state != St.PLACE:
		var lw := font.get_string_size(it[1], HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x
		widths.append([kw, lw])
		total += kw + 6 + lw + 18
	if total > 1260.0 and fs > 10:
		_key_hints_scaled(cx, y, items, fs - 1)
		return
	var x := cx - total / 2.0
	for i in items.size():
		var kw: float = widths[i][0]
		var r := Rect2(x, y, kw, fs + 6)
		draw_rect(r, Color(0.75, 0.78, 0.85, 0.9))
		_text(Vector2(r.get_center().x, y + 1), items[i][0], fs - 2, Color(0.08, 0.08, 0.1), true, true)
		x += kw + 6
		_text(Vector2(x, y + 1), items[i][1], fs, Color(1, 1, 1, 0.85))
		x += widths[i][1] + 18


## 這場用到的新兵才烘圖（含生出來的兵）；舊 10 種開遊戲就有。
func _ensure_sprites(armies_: Array) -> void:
	if sprites == null:
		return
	var need := {}
	for a in armies_:
		for u in a.units:
			var t: int = int(u["type"])
			if t >= D.COUNT:
				need[t] = true
				if t == F8.SLIME:
					need[F8.MINI_SLIME] = true
				if t == F8.BONE:
					need[F8.SKELETON] = true
	if not need.is_empty():
		sprites.ensure(need.keys())

# ── V9 P2 步態驅動：相位由真實位移算，只影響畫面 ──
const Gait = preload("res://scripts/ui/units/gait.gd")
var gait_d := {}       # id → [前一 tick 累積距離, 這一 tick 累積距離]（世界單位）
var gait_on := {}      # id → 這一 tick 算在走路
var gait_land := {}    # id → 停步後還在收腳幾 tick
var drag_t := {}       # id → 被擊退、吸走的拖行姿勢還剩幾秒
var face_now := {}     # id → 目前朝向（轉身有過場）
extends RefCounted
## 困難 AI（第四輪）：真的「讀你上一局」。
## 第 1 局沒有資訊 → 用原型模板組（和普通 AI 同一套，不會比普通弱）。
## 第 2 局起 → 準備幾個候選陣型（反制庫裡最接近的那筆、兩套模板陣、會讀對方的落子 AI 陣），
## 各拿去和你上一局的陣型模擬一場，挑打得最好的。只看你「上一局」公開過的陣型，不偷看這一局。
## 遊戲（game_screens._hard_ai）和反制庫驗證（tools/balance/make_counter_lib.gd）共用這一個函式。
## 第三輪的做法（查不到反制就退回落子 AI）在第四輪新模板加入後，對驗證池反而比普通 AI 弱（73.0% vs 74.0%），所以改成這樣。

const D = preload("res://scripts/core/unit_defs.gd")
const Army = preload("res://scripts/core/army.gd")
const Sim = preload("res://scripts/core/battle_sim.gd")
const AI = preload("res://scripts/core/ai_army.gd")
const AIT = preload("res://scripts/core/ai_turns.gd")
const F = preload("res://scripts/core/formations.gd")
const RS = preload("res://scripts/core/ruleset.gd")

## known：玩家上一局的兵（藍方座標）；entries：反制庫；回傳紅方陣型。
## pool：紅方卡池遮罩（-1＝全部）；rules：第五輪 Ruleset（null＝標準）。
## 反制庫只在「規則和標準一樣」時用（第五輪 §3.2）；大軍或長局時少一個候選（效能探測：40＋40、150 秒一場可達數秒）。
static func build(known: Array, entries: Array, rng: RandomNumberGenerator, pool := -1, rules = null) -> Army:
	if pool < 0:
		pool = RS.all_pool()
	var bud: int = 100 if rules == null else rules.budget_of(1)
	var cands: Array = []
	cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
	if known.is_empty():
		return cands[0]
	var heavy: bool = rules != null and (rules.unit_cap > 24 or rules.ticks > 1800)
	if not heavy:
		cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
	var full := AIT.build_full(1, rng, 2, known, pool, rules)
	cands.append(full)
	if rules == null or _standard_like(rules):
		var lib := pick_counter(entries, known, pool)
		if lib != null:
			cands.append(lib)
	var me := Army.new(0, 100 if rules == null else rules.budget_of(0))
	if rules != null and rules.is_free():
		me.deploy = "free"   # 第六輪：上一局是自由陣型，照原座標模擬
	for u in known:
		if u.has("x"):
			me.units.append({"type": int(u["type"]), "x": int(u["x"]), "y": int(u["y"])})
		elif me.deploy == "free":
			me.units.append({"type": int(u["type"]), "x": int(u["col"]) * 1000 + 500, "y": int(u["row"]) * 1000 + 500})
		else:
			me.units.append({"type": int(u["type"]), "col": int(u["col"]), "row": int(u["row"])})
	var best: Army = cands[0]
	var bs := -(1 << 40)
	var seen := {}   # V1.1 E5：一樣的候選陣型只算一次（分數一定相同，後到的又不會取代，結果不變）
	for c in cands:
		var ck: String = c.to_code()
		if seen.has(ck):
			continue
		seen[ck] = true
		var s = Sim.new(me.copy(), c.copy(), rules)
		s.fast = true
		s.cmd_auto = [false, true]     # 第十二輪：評估時紅方照實戰放技能（Codex v12-r1 #5）
		s.run_to_end()
		# 讓子局用各自預算的比例評分（Codex 實作第 1 輪）；標準局算式不變
		var sc: int = (1000000 + s.power(1)) if s.winner == 1 else (s.power(1) - s.power(0))
		if s.judge == 2:
			sc = (1000000 + s.power_permille(1)) if s.winner == 1 else (s.power_permille(1) - s.power_permille(0))
		if sc > bs:
			bs = sc
			best = c
	return best

## 反制庫：組成最接近玩家陣型的原型的反制（距離 ≤40）；用到未開放兵種的不算。
## 反制庫只在「部署與模擬都標準」時用（集中用 Presets.deploy_standard 判定，Codex 實作第 2 輪）。
static func _standard_like(r) -> bool:
	return r.sim_is_legacy() and load("res://scripts/game/presets.gd").deploy_standard(r)

static func pick_counter(entries: Array, known: Array, pool: int) -> Army:
	if entries.is_empty():
		return null
	var mine := D.zeros()
	for u in known:
		mine[int(u["type"])] += D.cost(int(u["type"]))
	var best = null
	var bd := 1 << 30
	for e in entries:
		var pc: Array = e["proto_comp"]
		var d := 0
		for k in mine.size():
			d += absi((int(pc[k]) if k < pc.size() else 0) - int(mine[k]))
		if d < bd:
			bd = d
			best = e
	if best == null or bd > 40:
		return null
	var a := Army.new(1, 100)
	if a.load_code(str(best["code"])) != "":
		return null
	for u in a.units:
		if not RS.has(pool, int(u["type"])):
			return null
	return a
