# ─── 狂戰士（第四輪）───
const BREACH_TICKS := 60        # 破陣：打中盾兵／長槍兵後 3 秒內嘲諷、正面舉盾、拒騎失效（重複打中刷新）
const BREACH_SPREAD := 1000     # 破陣擴散：目標 1 格內的其他敵方盾兵／長槍兵一起破陣（劈開一段牆）
const BREACH_VULN_NUM := 3      # 破陣中受到的所有傷害 ×3/2（第四輪平衡：讓「替隊友開路」真的有用）
const BREACH_VULN_DEN := 2
const BERSERK_ARROW_NUM := 5    # 沒穿甲：被弓箭射中 ×5/4
const BERSERK_ARROW_DEN := 4
# 不被擊退：騎兵衝鋒的擊退對狂戰士無效

# ─── 全場規則 ───
const MATCH_TICKS := 1800       # 一局最長 90 秒
const FRENZY_TICK := 1200       # 60 秒起狂熱
const FRENZY_CD_RATE := 5       # 狂熱時冷卻每 tick 扣 5（平常 4）＝攻速 ×5/4
const ATTRITION_STEP_PCT := 2   # 狂熱耗損：第 k 次（k＝0～5，每 5 秒一次）扣 (k+1)×2% 滿血
const MIN_SEP := 450            # 兵與兵最小間距 0.45 格
const RALLY_RATIO_PCT := 60     # 背水（追趕機制）：自己的剩餘戰力 < 對方的這個百分比時觸發；0＝關閉。11/01 實驗 5 組後採用 60%／+2
const RALLY_CD_BONUS := 2       # 背水時冷卻每 tick 多扣幾：平常 4→6（攻速約 ×1.5）、狂熱 5→7（約 ×1.4）；實際間隔取整到 tick

static var _digest := ""

## 數值摘要：本檔所有常數的 SHA-256 前 16 碼。遊戲、AI、平衡工具、重播都記錄它，證明跑的是同一份數值。
static func data_digest() -> String:
	if _digest == "":
		var m: Dictionary = load("res://scripts/core/unit_defs.gd").get_script_constant_map()
		# 常數名稱是 StringName，直接排序是比記憶體位址、不是字母順序 → 先轉成 String 再排
		var pairs: Array = []
		for k in m:
			pairs.append([String(k), m[k]])
		pairs.sort_custom(func(a, b): return a[0] < b[0])
		var txt := ""
		for pr in pairs:
			txt += "%s=%s;" % [pr[0], var_to_str(pr[1])]
		_digest = txt.sha256_text().substr(0, 16)
	return _digest

## 每種兵一格的 0 陣列（取代到處寫死的 [0, 0, 0, 0, 0]）。
static func zeros() -> Array:
	var a: Array = []
	a.resize(total())
	a.fill(0)
	return a

# 第八輪：新兵在 fantasy_defs.gd。這裡不能用 const preload（常數會進舊的數值摘要），一律走下面的函式。
static var _f8 = null

static func f8():
	if _f8 == null:
		_f8 = load("res://scripts/core/fantasy_defs.gd")
	return _f8

## 可以擺的兵種總數（新舊合計）。COUNT 維持 10：舊規則、舊 AI 的迴圈都靠它不變。
static func total() -> int:
	return 20

static func stat(t: int) -> Dictionary:
	return STATS[t] if t < COUNT else f8().STATS[t - COUNT]

static func name_of(t: int) -> String:
	return NAMES[t] if t < COUNT else f8().NAMES[t - COUNT]

## 用到新兵的場次用的數值摘要。舊場次仍是 data_digest()，一個位元組都不變。
static var _digest_v8 := ""
static func digest_v8() -> String:
	if _digest_v8 == "":
		var m: Dictionary = f8().get_script_constant_map()
		var pairs: Array = []
		for k in m:
			pairs.append([String(k), m[k]])
		pairs.sort_custom(func(a, b): return a[0] < b[0])
		var txt := data_digest()
		for pr in pairs:
			txt += "%s=%s;" % [pr[0], var_to_str(pr[1])]
		_digest_v8 = txt.sha256_text().substr(0, 16)
	return _digest_v8

static func uses_new(armies: Array) -> bool:
	for a in armies:
		for u in a.units:
			if int(u["type"]) >= COUNT:
				return true
	return false

static func version_of(armies: Array) -> String:
	return "1.4.1" if uses_new(armies) else RULES_VERSION   # 1.4.1：第十二輪吸塵貓改成拉向自己

static func digest_of(armies: Array) -> String:
	return digest_v8() if uses_new(armies) else data_digest()

## 結果頁、老兵筆記把生出來的兵算回母體的兵種。
static func report_type(t: int) -> int:
	return 13 if t == 20 else (17 if t == 21 else t)

static func cost(t: int) -> int:
	return stat(t)["cost"]

static func is_melee(t: int) -> bool:
	return t != ARCHER and t != BOMBER and t != 17   # 17＝骷髏法師

## 支援兵（第四輪）：隊上還有戰鬥兵活著時不攻擊，只做支援走位。
static func is_support(t: int) -> bool:
	return t == MEDIC or t == DRUMMER or t == 16   # 16＝沙漏精靈

## 戰鬥兵：開戰至少要有 1 隻。支援兵和奇襲兵（孢子菇、爆爆羊、寶箱怪）都不算。
static func is_combat(t: int) -> bool:
	return not is_support(t) and t != 10 and t != 11 and t != 12

## 一隊的硬上限（0＝沒有）。
static func hard_cap(t: int) -> int:
	return 0 if t < COUNT else int(f8().HARD_CAP.get(t, 0))

static func cheapest() -> int:
	var c := 999
	for s in STATS:
		c = mini(c, s["cost"])
	return c

