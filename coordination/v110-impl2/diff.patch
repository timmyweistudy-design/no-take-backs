+         "enemy": [list(e) for e in enemy], "fixed": [list(f) for f in fixed],
+         "budget": budget, "allowed": list(allowed)}
+    if unit is not None:
+        d["unit"] = unit
+    d.update(kw)
+    P.append(d)
+
