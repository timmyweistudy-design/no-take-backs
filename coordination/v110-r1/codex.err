func _v8_setup() -> void:
	var base := units.size()
	for i in base:
		var p := units[i]
		var kids := 0
		var kt := -1
		if p.type == F8.SLIME and not skill_off.has("split"):
			kids = F8.SLIME_KIDS
			kt = F8.MINI_SLIME
		elif p.type == F8.BONE and not skill_off.has("raise"):
			kids = F8.BONE_KIDS
			kt = F8.SKELETON
		for k in kids:
			var c := Unit.new()
			var st: Dictionary = D.stat(kt)
			c.id = p.team * 1000 + 600 + i * 4 + k
			c.team = p.team
			c.type = kt
			c.x = p.x
			c.y = p.y
			c.hp = st["hp"]
			c.max_hp = st["hp"]
			c.cost = 0
			c.reach = st["reach"]
			c.speed = st["speed"]
			c.atk = st["atk"]
			c.cd_base = st["cd"]
			c.fx = p.fx
			c.alive = false
			c.dormant = true
			c.summon = true
			c.parent = i
			c.sub = k
			c.slot = p.slot * 8 + k + 1000
			units.append(c)
		if p.type == F8.MIMIC and not skill_off.has("bite"):
			p.hidden = true
		if p.type == F8.BONE or p.type == F8.CAT or p.type == F8.GOLEM:
			p.skill_cd = F8.FIRST_CD
		if p.type == F8.DOLL:
			p.link_wait = 1

## ① 之後：寶箱怪偽裝、現身，毒圈與碎石區的移速，巫毒綁定。只讀快照。
func test_star_solutions() -> void:
	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://tests/golden/star_solutions.json"))
	var PZ = load("res://scripts/game/puzzles.gd")
	var Sim = load("res://scripts/core/battle_sim.gd")
	var seen := 0
	var ids := {}
	for pz in PZ.all_puzzles():
		ok(not ids.has(pz["id"]), "殘局 ID 不重複", str(pz["id"]))
		ids[pz["id"]] = true
		# 第十三輪：遊戲用 get_puzzle(ID) 開關；和教學關撞 ID（t1～t3）時會開成教學（截圖抓到）
		ok(str(PZ.get_puzzle(pz["id"]).get("zh", "")) == str(pz["zh"]), "用 ID 開得到同一關（不和教學撞）", str(pz["id"]))
		var best: Dictionary = pz.get("best", {})
		ok(not best.is_empty(), "殘局有三星解紀錄", str(pz["id"]))
		var r: Dictionary = PZ.play(pz, best.get("u", []), best.get("p", []))
		ok(not r.has("illegal"), "三星解擺法合法", "%s %s" % [pz["id"], str(r.get("illegal", ""))])
		ok(int(r["stars"]) == 3, "殘局三星拿得到", "%s 剩 %d 花 %d" % [pz["id"], int(r["rem"]), int(r["spent"])])
		seen += 1
	ok(seen == PZ.CHAPTERS * 10, "殘局 %d 關都驗到" % (PZ.CHAPTERS * 10), str(seen))
	for n in range(1, PZ.CHAPTERS + 1):
		ok(PZ.chapter(n).size() == 10 and not PZ.chapter_info(n).is_empty(), "第 %d 章 10 關、有名稱與故事" % n, str(PZ.chapter(n).size()))
	var was: bool = SaveS.data_locked
	SaveS.data_locked = true
	var g = load("res://scripts/ui/game_screens.gd").new()
	g.sfx = FakeSfx.new()
	g.time = 1.0
	for i in g.TRIALS.size():
		g._start_trial(i)
		g._build_ai()
		var a = g.armies[0].copy()
		a.units = []
		var spec: Array = data["trials"][str(i)] if data["trials"].has(str(i)) else g.trial_x(i).get("best", [])
		ok(not spec.is_empty(), "試煉有三星解紀錄", str(i + 1))
		for u in spec:
			ok(a.place_xy(int(u[0]), a.world_x(int(u[1])), int(u[2])), "試煉三星解擺法合法", "第 %d 關 %s" % [i + 1, str(u)])
		var s2 = Sim.new(a.copy(), g.armies[1].copy(), g.rules)
		if s2.cmd_on:
			s2.cmd_auto = [false, true]   # 和遊戲一樣：紅方自動放技能
		s2.fast = true
		s2.run_to_end()
		var rem2: int = PZ.rem_pct(s2.power(0), s2.budget_of(0))
		var st: int = g.trial_stars(int(g.TRIALS[i][3]), rem2, a.spent(), a.budget, g.trial_spend_pct(i), g.trial_rem(i)) if s2.winner == 0 else 0
		ok(st == 3, "試煉三星拿得到", "第 %d 關 %d 星，剩 %d 花 %d" % [i + 1, st, rem2, a.spent()])
extends "res://tests/test_base.gd"

## 殘局標準解回歸（第二輪方案 §1.4）：每關存的標準解都必須打贏；改戰鬥規則後有任何一關變不能過就會紅。
func test_puzzle_solutions() -> void:
	var total := 0
	var bad: Array = []
	for pz in PZ.tutorials() + PZ.puzzles() + PZ.new_puzzles() + PZ.fantasy_puzzles():
		var sols: Array = pz.get("solutions", [])
		if sols.is_empty():
			bad.append("%s 沒有標準解" % pz["id"])
		for sol in sols:
			var a0 = PZ.player_army(pz)
			var allowed: Array = []
			for v in pz.get("allowed", [0, 1, 2, 3, 4]):
				allowed.append(int(v))   # JSON 讀進來是 float，has(int) 會比不到
			for e in sol:
				# 用正式的擺放規則驗合法性：預算、格子在區內、沒有重疊、兵種允許（Codex R1 審查 #5）
				if not allowed.has(int(e[0])):
					bad.append("%s 標準解用了不允許的兵種 %d" % [pz["id"], int(e[0])])
				var why: String = a0.check_place(int(e[0]), int(e[1]), int(e[2]))
				if why != "":
					bad.append("%s 標準解不合法：%s" % [pz["id"], why])
				a0.place(int(e[0]), int(e[1]), int(e[2]))
			var sm = Sim.new(a0, PZ.enemy_army(pz))
			sm.fast = true
			sm.run_to_end()
			total += 1
			if sm.winner != 0:
				bad.append("%s 標準解輸了" % pz["id"])
	# 第十三輪新增的關：可能有目標、技能、地形，一律用和遊戲同一套的 PZ.play（含合法性）判定
	for pz in PZ.extra_puzzles():
		var plans: Array = pz.get("sol_plans", [])
		for si in pz.get("solutions", []).size():
			var r: Dictionary = PZ.play(pz, pz["solutions"][si], plans[si] if si < plans.size() else [])
			total += 1
			if r.has("illegal"):
				bad.append("%s 標準解不合法：%s" % [pz["id"], r["illegal"]])
			elif not bool(r["ok"]):
				bad.append("%s 標準解沒過關" % pz["id"])
		if pz.get("solutions", []).is_empty():
			bad.append("%s 沒有標準解" % pz["id"])
		if bool(PZ.play(pz, [])["ok"]):
			bad.append("%s 什麼都不放就過關" % pz["id"])
	var n_pz: int = (PZ.tutorials() + PZ.all_puzzles()).size()
	for pz in PZ.new_puzzles() + PZ.fantasy_puzzles():
		# 新兵試玩：主角兵種一定要在允許清單、每組標準解都要用到它（第四輪 §4.8）
		for sol in pz.get("solutions", []):
			if sol.filter(func(e): return int(e[0]) == int(pz["unit"])).is_empty():
