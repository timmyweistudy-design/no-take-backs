extends Node
## 角色精靈圖快取（第二輪方案 R2、H；第八輪改分頁）：實測 48 隻時每幀直接程式繪製要 34ms（約 15fps），
## 所以用同一份 Art.unit 畫法，把兵種×隊伍×動作影格畫進圖集，戰鬥中只貼圖。
## 第八輪：一張大圖放 22 種會到 3072×11712，Compatibility 渲染器超過 4096 有風險。改成每頁 ≤4096（7 種兵），
## 開場只烘舊 10 種，新兵上場才烘；還沒烘好時呼叫端直接畫，不會缺圖。頁數有上限，超過丟最舊的新兵頁。
## 用同一份畫法烘焙，但不是逐像素等價（Codex R1 審查 #3、#4，已知且接受的差異）：
##  - 走路量化成 6 格、攻擊 8 格；攻擊中不再疊走路相位；走路／攻擊格固定睜眼（只在待機眨眼）。
## 表情疊加（受擊、暈眩、衝鋒、狂熱、潛行、頂住）不烘焙，貼完圖再用 Art.overlay 在同一個局部座標畫上去。
##  - 透明度（潛行）是對整張合成好的角色乘 alpha，重疊的部位不會像逐圖元那樣透出底下的線條。
## 待機呼吸位移在貼圖時加（烘焙時抵銷為 0）；受擊閃白跟著攻擊前衝與走路起伏。
## 沒有畫面（headless）或還沒建好時，呼叫端退回 Art.unit。

const Art = preload("res://scripts/ui/art.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const Gait = preload("res://scripts/ui/units/gait.gd")

const CELL := 192          # 每格像素（以 RS 倍率畫）；比角色大一圈，避免相鄰格子滲色
const RS := 1.6            # 烘焙解析度倍率
const ORIGIN := Vector2(78, 160)   # 角色腳底在格子裡的位置（第七輪 C0：原本會超框被切掉）
const RING_ORIGIN := Vector2(96, 140)   # 腳底圈格子的中心（有影子，要留下方空間）
const WALK_FRAMES := 8     # V9 P2：6→8，另加拖行、暈眩
const POSE_FRAMES := 2
const ATK_FRAMES := 8      # 三段式攻擊（R5）要多幾格才看得出前搖／揮擊／後搖
# 每個兵種、隊伍的影格順序：0 待機、1 眨眼、2..7 走路、8..23 攻擊兩組（一般／交替或專屬）
const FRAMES_PER := 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * 2
const COLS := 16
const TYPES_PER_PAGE := 6  # 6×2×28＝336 格＝21 列×192＝4032px，不超過 4096
const MAX_PAGES := 5

var pages: Array = []      # 每頁 {tex, types}
var loc := {}              # 兵種 → [頁, 這一種在頁裡的起始格]
var ring_tex: Texture2D = null
var ready_cb := -1         # 這份快取是用哪種配色（一般／色盲）烘焙的
var _busy := false
var _queue: Array = []
var _baking: Array = []

func is_ready(cb: bool) -> bool:
	return ring_tex != null and ready_cb == (1 if cb else 0)

func has_type(t: int) -> bool:
	return loc.has(t)

## 腳底在格子裡的位置：往前伸得很長的長槍兵靠左、很寬的小石魔靠右，其他都一樣。
static func origin_of(type: int) -> Vector2:
	return Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160))

## 全部清掉，烘舊 10 種和腳底圈。
func build(cb: bool) -> void:
	if DisplayServer.get_name() == "headless":
		return
	pages.clear()
	loc.clear()
	_queue.clear()
	ring_tex = null
	ready_cb = 1 if cb else 0
	var base: Array = []
	for t in D.COUNT:
		base.append(t)
	await _bake_ring(cb)
	await ensure(base)

## 這場要用到的兵種。缺的才烘；烘的時候呼叫端先直接畫。
func ensure(types: Array) -> void:
	if DisplayServer.get_name() == "headless" or ready_cb < 0:
		return
	for t in types:
		if not loc.has(t) and not t in _queue and not t in _baking:
			_queue.append(t)
	if _busy or _queue.is_empty():
		return
	_busy = true
extends "res://tests/test_base.gd"

## 殘局標準解回歸（第二輪方案 §1.4）：每關存的標準解都必須打贏；改戰鬥規則後有任何一關變不能過就會紅。
func test_puzzle_solutions() -> void:
	var total := 0
	var bad: Array = []
	for pz in PZ.tutorials() + PZ.puzzles() + PZ.new_puzzles() + PZ.fantasy_puzzles():
		var sols: Array = pz.get("solutions", [])
		if sols.is_empty():
			bad.append("%s 沒有標準解" % pz["id"])
		for sol in sols:
			var a0 = PZ.player_army(pz)
			var allowed: Array = []
			for v in pz.get("allowed", [0, 1, 2, 3, 4]):
				allowed.append(int(v))   # JSON 讀進來是 float，has(int) 會比不到
			for e in sol:
				# 用正式的擺放規則驗合法性：預算、格子在區內、沒有重疊、兵種允許（Codex R1 審查 #5）
				if not allowed.has(int(e[0])):
					bad.append("%s 標準解用了不允許的兵種 %d" % [pz["id"], int(e[0])])
				var why: String = a0.check_place(int(e[0]), int(e[1]), int(e[2]))
				if why != "":
					bad.append("%s 標準解不合法：%s" % [pz["id"], why])
				a0.place(int(e[0]), int(e[1]), int(e[2]))
			var sm = Sim.new(a0, PZ.enemy_army(pz))
			sm.fast = true
			sm.run_to_end()
			total += 1
			if sm.winner != 0:
				bad.append("%s 標準解輸了" % pz["id"])
	# 第十三輪新增的關：可能有目標、技能、地形，一律用和遊戲同一套的 PZ.play（含合法性）判定
	for pz in PZ.extra_puzzles():
		var plans: Array = pz.get("sol_plans", [])
		for si in pz.get("solutions", []).size():
			var r: Dictionary = PZ.play(pz, pz["solutions"][si], plans[si] if si < plans.size() else [])
			total += 1
			if r.has("illegal"):
				bad.append("%s 標準解不合法：%s" % [pz["id"], r["illegal"]])
			elif not bool(r["ok"]):
				bad.append("%s 標準解沒過關" % pz["id"])
		if pz.get("solutions", []).is_empty():
			bad.append("%s 沒有標準解" % pz["id"])
		if bool(PZ.play(pz, [])["ok"]):
			bad.append("%s 什麼都不放就過關" % pz["id"])
	var n_pz: int = (PZ.tutorials() + PZ.all_puzzles()).size()
	for pz in PZ.new_puzzles() + PZ.fantasy_puzzles():
		# 新兵試玩：主角兵種一定要在允許清單、每組標準解都要用到它（第四輪 §4.8）
		for sol in pz.get("solutions", []):
			if sol.filter(func(e): return int(e[0]) == int(pz["unit"])).is_empty():
				bad.append("%s 的標準解沒用到主角兵種" % pz["id"])
	for pz in PZ.puzzles():
		if pz.get("solutions", []).size() < 2:
			bad.append("%s 不到兩組解" % pz["id"])
	ok(total >= n_pz and bad.is_empty(), "%d 關殘局標準解合法且全部打贏、殘局每關 ≥2 解（%d 組）" % [n_pz, total], str(bad))


## 兵種圖鑑（第二輪方案 R3）：資料齊全、技能說明的數值都換得出來、每段示範用真模擬一定觸發預期的技能、老兵筆記贏 5 場解鎖。
func test_star_solutions() -> void:
	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://tests/golden/star_solutions.json"))
	var PZ = load("res://scripts/game/puzzles.gd")
	var Sim = load("res://scripts/core/battle_sim.gd")
	var seen := 0
	var ids := {}
	for pz in PZ.all_puzzles():
		ok(not ids.has(pz["id"]), "殘局 ID 不重複", str(pz["id"]))
		ids[pz["id"]] = true
		# 第十三輪：遊戲用 get_puzzle(ID) 開關；和教學關撞 ID（t1～t3）時會開成教學（截圖抓到）
		ok(str(PZ.get_puzzle(pz["id"]).get("zh", "")) == str(pz["zh"]), "用 ID 開得到同一關（不和教學撞）", str(pz["id"]))
		var best: Dictionary = pz.get("best", {})
		ok(not best.is_empty(), "殘局有三星解紀錄", str(pz["id"]))
		var r: Dictionary = PZ.play(pz, best.get("u", []), best.get("p", []))
		ok(not r.has("illegal"), "三星解擺法合法", "%s %s" % [pz["id"], str(r.get("illegal", ""))])
		ok(int(r["stars"]) == 3, "殘局三星拿得到", "%s 剩 %d 花 %d" % [pz["id"], int(r["rem"]), int(r["spent"])])
		seen += 1
	ok(seen == PZ.CHAPTERS * 10, "殘局 %d 關都驗到" % (PZ.CHAPTERS * 10), str(seen))
	for n in range(1, PZ.CHAPTERS + 1):
		ok(PZ.chapter(n).size() == 10 and not PZ.chapter_info(n).is_empty(), "第 %d 章 10 關、有名稱與故事" % n, str(PZ.chapter(n).size()))
	var was: bool = SaveS.data_locked
	SaveS.data_locked = true
	var g = load("res://scripts/ui/game_screens.gd").new()
	g.sfx = FakeSfx.new()
	g.time = 1.0
	for i in g.TRIALS.size():
		g._start_trial(i)
		g._build_ai()
		var a = g.armies[0].copy()
		a.units = []
		var spec: Array = data["trials"][str(i)] if data["trials"].has(str(i)) else g.trial_x(i).get("best", [])
		ok(not spec.is_empty(), "試煉有三星解紀錄", str(i + 1))
		for u in spec:
			ok(a.place_xy(int(u[0]), a.world_x(int(u[1])), int(u[2])), "試煉三星解擺法合法", "第 %d 關 %s" % [i + 1, str(u)])
		var s2 = Sim.new(a.copy(), g.armies[1].copy(), g.rules)
		if s2.cmd_on:
			s2.cmd_auto = [false, true]   # 和遊戲一樣：紅方自動放技能
		s2.fast = true
		s2.run_to_end()
		var rem2: int = PZ.rem_pct(s2.power(0), s2.budget_of(0))
		var st: int = g.trial_stars(int(g.TRIALS[i][3]), rem2, a.spent(), a.budget, g.trial_spend_pct(i), g.trial_rem(i)) if s2.winner == 0 else 0
		ok(st == 3, "試煉三星拿得到", "第 %d 關 %d 星，剩 %d 花 %d" % [i + 1, st, rem2, a.spent()])
	g.free()
	SaveS.data_locked = was

## 第十三輪（Codex v13-r2 #1）：每關試煉的規則要能通過規則驗證（對戰代碼才讀得回），
## 固定敵陣要照敵方規則一隻隻擺得進去（卡池、預算、隻數、每種上限、位置、間距）。
func test_trial_rules_valid() -> void:
