#!/usr/bin/env python3
"""統一檢查（第九輪 P0）：平行跑、可快取、輸出一行結論。check_all.sh 是它的入口。

用法：GODOT=<godot> python3 tools/check.py [--out 資料夾] [--quick] [--no-cache] [--jobs N] [--only 名稱,...]
  --quick     改動時用：載入、框架、UI、金標準 30 場、字串、字型
  --no-cache  驗收用：全部重跑（快取只在改動時省時間）
環境變數 GOLDEN_N、COMPAT_N 和舊版相同。
快取鍵＝引擎版本＋該步驟腳本的 preload 相依樹＋資料檔的內容雜湊；細節在 <out>/summary.json。
"""
import argparse, concurrent.futures as cf, hashlib, json, os, re, shutil, subprocess, sys, time, uuid
from pathlib import Path

GAME = Path(__file__).resolve().parent.parent
EXPECT = "4.6.2.stable"
ERR = re.compile(r"SCRIPT ERROR|Parse Error|Compile Error|Failed to load script")
PRE = re.compile(r'(?:preload|load)\(\s*"res://([^"]+\.(?:gd|json|csv))"')
TEST_DONE = re.compile(r"^—— ([1-9]\d*) 通過 / 0 失敗", re.M)
# 這些組會碰存檔（固定檔名、靜態狀態），放同一個行程
STATEFUL = ["fantasy", "rules", "save", "ui", "modes"]


def sha(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def deps(entry: str, seen=None) -> set:
    seen = set() if seen is None else seen
    if entry in seen or not (GAME / entry).is_file():
        return seen
    seen.add(entry)
    if entry.endswith(".gd"):
        for m in PRE.findall((GAME / entry).read_text(encoding="utf-8", errors="ignore")):
            deps(m, seen)
    return seen


def key_of(ver: str, entries: list, extra_dirs: list) -> str:
    files = set()
    for e in entries:
        deps(e, files)
    for d in extra_dirs:
        p = GAME / d
        if p.is_dir():
            files |= {str(x.relative_to(GAME)).replace("\\", "/") for x in p.rglob("*") if x.is_file() and x.suffix != ".import"}
        elif p.is_file():
            files.add(d)
    h = hashlib.sha256(ver.encode())
    for f in sorted(files):
        h.update(f.encode())
        h.update(sha(GAME / f).encode())
    return h.hexdigest()[:20]


def plan(a) -> list:
    gn = int(os.environ.get("GOLDEN_N", "1000"))
    cn = int(os.environ.get("COMPAT_N", "1000"))
    t = "tests/run_tests.gd"
    suites = [f"tests/suites/{x.stem}.gd" for x in (GAME / "tests/suites").glob("*.gd")]
    data = ["data", "tests/golden"]
    st = []

    def gd(name, script, args, ok, entries=None, dirs=None):
        st.append({"name": name, "kind": "gd", "script": script, "args": args, "ok": ok,
                   "entries": entries or [script], "dirs": data if dirs is None else dirs})

    def shards(name, script, args, ok, m):
        for k in range(m):
            gd(f"{name}{k}", script, args + [f"--shard={k}/{m}"], ok)

    def test(name, only):
        gd(name, t, [f"--only={only}"], TEST_DONE.pattern, [t] + suites, data + ["fonts"])

    if a.quick:
        test("t_harness", "harness,anim")
        test("t_ui", "ui")
        gd("golden", "tools/golden.gd", ["--n=30"], r'^GOLDEN \{.*"ok":true')
    else:
        for s in ["maps", "anim", "units", "free", "content", "harness"]:
            test(f"t_{s}", s)
        # 最慢的幾項各開一個行程（都不碰存檔）；其他留在原組
        test("t_golden", "test_golden")
        test("t_determinism", "test_determinism_and_mirror")
        test("t_core", "core,-test_golden,-test_determinism_and_mirror")
        test("t_sandbox", "test_sandbox_v5")
        test("t_stateful", ",".join(STATEFUL) + ",-test_sandbox_v5")
        shards("mirror", "tools/mirror_100.gd", [], r"^MIRROR100 100/100", 4)
        shards("golden", "tools/golden.gd", [f"--n={gn}"], r'^GOLDEN \{.*"ok":true', 4)
        shards("compat", "tools/compat.gd", [f"--n={cn}"], r'^COMPAT \{.*"ok":true', 4)
        gd("sealcodes", "tools/seal_codes.gd", [], r'^SEALCODES \{"n":40,"ok":true')
        shards("goldenfree", "tools/golden_free.gd", [], r'^GOLDENFREE \{.*"ok":true', 3)
        shards("goldenv8", "tools/golden_v8.gd", [], r'^GOLDENV8 \{.*"ok":true', 3)
        shards("goldenmap", "tools/golden_map.gd", [], r'^GOLDENMAP \{.*"ok":true', 3)
        gd("orbit", "tools/orbit_detect.gd", [], r"^ORBIT cav_battles=")
    for name, py in [("strings", "check_strings.py"), ("assets", "check_assets.py"), ("font", "check_font_coverage.py")]:
        if a.quick and name == "assets":
            continue
        st.append({"name": name, "kind": "py", "script": f"tools/{py}", "dirs": ["data", "scripts", "fonts", "art", "audio", "licenses", f"tools/{py}"], "entries": []})
    return st


def kill_marker(godot: str, marker: str) -> None:
    """WSL 的子行程被殺只砍外層，Windows 上的 Godot 還活著：用命令列裡的記號收掉。"""
    if godot.endswith(".exe") and shutil.which("powershell.exe"):
        ps = ("Get-CimInstance Win32_Process -Filter \"Name like 'Godot%'\" | "
              f"Where-Object {{ $_.CommandLine -like '*{marker}*' }} | ForEach-Object {{ Stop-Process -Id $_.ProcessId -Force }}")
        subprocess.run(["powershell.exe", "-NoProfile", "-Command", ps], capture_output=True, timeout=60)


def godot_cmd(godot: str, args: list, marker: str) -> list:
    return [godot] + args + ([] if "--" in args else ["--"]) + [f"--ntb-run={marker}"]


def run_step(s, godot, out, timeout, marker):
    os.environ["PYTHONUTF8"] = "1"
    log = out / f"{s['name']}.log"
#!/usr/bin/env bash
# 版面檢查（第三輪 T4）：用 Windows 版 Godot 跑截圖模式，兩種語言 × 三種字級，彙整 layout.jsonl。
# 用法：tools/layout_check.sh <Godot 執行檔> <輸出資料夾（WSL 路徑）>
set -uo pipefail
cd "$(dirname "$0")/.."
EXE="$1"; OUT="$2"
# 第七輪 I5：只准清自己產生的輸出夾（有記號檔），或空資料夾；其他一律拒絕，不再無條件 rm -rf
MARK=".ntb-layout-output"
if [ -d "$OUT" ] && [ -n "$(ls -A "$OUT" 2>/dev/null)" ]; then
  if [ ! -f "$OUT/$MARK" ]; then
    echo "LAYOUT FAIL：$OUT 已有內容但不是版面檢查的輸出夾，不會刪除。請換一個新資料夾。"; exit 2
  fi
  rm -rf "$OUT"
fi
mkdir -p "$OUT"; : > "$OUT/$MARK"
# Windows／WSL／Linux 都能跑：有 wslpath 才轉路徑
winpath() { if command -v wslpath >/dev/null 2>&1 && [[ "$EXE" == *.exe ]]; then wslpath -w "$1"; else printf '%s' "$1"; fi; }
# WSL 的 timeout 只殺得到包裝程序，Windows 上的視窗會留著繼續跑：逾時要連它一起關（只關這次輸出夾的）
kill_win() { if [[ "$EXE" == *.exe ]]; then powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name like 'Godot%'\" | Where-Object { \$_.CommandLine -like '*--shot=$(winpath "$1")*' } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force }" >/dev/null 2>&1; fi; }
# 第九輪 P0：LAYOUT_QUICK=1 只跑中文 100%＋英文 150%（最容易出事的兩組）；里程碑跑 6 組
COMBOS="zh_TW:100 zh_TW:125 zh_TW:150 en:100 en:125 en:150"
[ "${LAYOUT_QUICK:-0}" = "1" ] && COMBOS="zh_TW:100 en:150"
for combo in $COMBOS; do
  lang="${combo%%:*}"; sc="${combo##*:}"
  {
    d="$OUT/${lang}_${sc}"; mkdir -p "$d"
    timeout 600 "$EXE" --path "$(winpath .)" --resolution 1280x800 -- --shot="$(winpath "$d")" --shot-lang=$lang --shot-text=$sc --layout-check > "$d/run.log" 2>&1 \
      || { echo "LAYOUT FAIL：$lang $sc% 截圖程式 exit 非 0"; kill_win "$d"; exit 1; }
    grep -E "SCRIPT ERROR|Parse Error" "$d/run.log" >/dev/null && { echo "LAYOUT FAIL：$lang $sc% 有腳本錯誤"; exit 1; }
    grep -q "PADWALK OK" "$d/run.log" || { echo "LAYOUT FAIL：$lang $sc% 手把流程：$(grep PADWALK "$d/run.log" | cut -c1-400)"; exit 1; }
  }
done
EXPECT=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | wc -l)
NAMES=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | sed 's/_snap("//; s/")//' | sort | tr '\n' ',')
python3 - "$OUT" "$EXPECT" "$NAMES" <<'PY'
import json,sys,glob,os
out=sys.argv[1]; expect=int(sys.argv[2]); names=set(x for x in sys.argv[3].split(',') if x); total=0; rows=[]
for f in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    for line in open(f,encoding='utf-8'):
        d=json.loads(line); total+=len(d['violations']); rows.append(d)
warns=sum(len(d.get('warnings',[])) for d in rows)
# 第五輪：每組都要剛好是 dev_main.gd 列出的那些畫面（不能用重複畫面湊張數）
for f2 in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    got=[json.loads(l)['shot'] for l in open(f2,encoding='utf-8')]
    if sorted(got)!=sorted(names) or len(set(got))!=len(got):
        print('LAYOUT FAIL：%s 的畫面集合不對（少了 %s、多了 %s）' % (f2, sorted(names-set(got)), sorted(set(got)-names))); sys.exit(1)
by={}
for d in rows: by.setdefault((d['lang'],d['scale']),[]).append(d['median_size'])
print('LAYOUT 截圖 %d 張、違規 %d' % (len(rows), total))
for d in rows:
    for v in d['violations']: print('  %s %s %d%%：%s' % (d['shot'], d['lang'], d['scale'], v))
for lang in ['zh_TW','en']:
    if (lang,100) in by and (lang,150) in by:
        a=sorted(by[(lang,100)]); b=sorted(by[(lang,150)])
        print('  %s 中位字級 100%%=%s 150%%=%s' % (lang, a[len(a)//2], b[len(b)//2]))
runs=glob.glob(os.path.join(out,'*','layout.jsonl'))
want=len(runs) if os.environ.get('LAYOUT_QUICK')=='1' else 6
if len(runs)!=want or len(rows)!=want*expect:
    print('LAYOUT FAIL：應有 6 組 × %d 張，實得 %d 組、%d 張（截圖沒跑完也算失敗）' % (expect, len(runs), len(rows))); sys.exit(1)
sys.exit(1 if total else 0)
PY
func _ensure_sprites(armies_: Array) -> void:
	if sprites == null:
		return
	var need := {}
	for a in armies_:
		for u in a.units:
			var t: int = int(u["type"])
			if t >= D.COUNT:
				need[t] = true
				if t == F8.SLIME:
					need[F8.MINI_SLIME] = true
				if t == F8.BONE:
					need[F8.SKELETON] = true
	if not need.is_empty():
		sprites.ensure(need.keys())

# ── V9 P2 步態驅動：相位由真實位移算，只影響畫面 ──
const Gait = preload("res://scripts/ui/units/gait.gd")
var gait_d := {}       # id → [前一 tick 累積距離, 這一 tick 累積距離]（世界單位）
var gait_on := {}      # id → 這一 tick 算在走路
var gait_land := {}    # id → 停步後還在收腳幾 tick
var drag_t := {}       # id → 被擊退、吸走的拖行姿勢還剩幾秒
var face_now := {}     # id → 目前朝向（轉身有過場）

func _gait_reset() -> void:
			draw_circle(Vector2.ZERO, 7, Color(0, 0, 0, 0.25 * ga), true, -1.0, true)
			draw_set_transform_matrix(_cam)
	# 擁擠度：40px 內有幾隻（第三輪 V5，只在戰鬥中算）
	var crowd := {}
	if live:
		var pos: Array = []
		for u in list:
			pos.append(_upos(u))
		for a in list.size():
			var n := 0
			for b in list.size():
				if a != b and pos[a].distance_squared_to(pos[b]) < 1600.0:
					n += 1
			crowd[list[a].id] = n
	# 第二層：身體（V9：地圖的前景物件依腳點 y 插進來，才有前後遮擋）
	var prop_i := 0
	for u in list:
		var p: Vector2 = _upos(u) if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
		while prop_i < fld_props.size() and ORIGIN.y + float(fld_props[prop_i][0]) <= p.y:
			MapArt.draw_prop(self, ORIGIN, fld_props[prop_i], time)
			prop_i += 1
		var walk: float = _walk_of(u, a_now) if live else ((time * Gait.nominal_rate(u.type, float(D.stat(u.type)["speed"]), CS, UNIT_SCALE) + u.id) if (u.mx != 0 or u.my != 0) else 0.0)
		var moving: bool = walk > 0.0
		var at := 0.0
		var variant := 0
		if live and atk_hit.has(u.id):
			var dt0 := _disp_tick()
			var h := pick_hit(atk_hit[u.id], dt0, u.type)
			if h >= 0:
				at = atk_progress(dt0 - (h - ViewBuffer.DELAY), u.type)
				# 火罐飛行（第四輪 §4.4）：前搖期間從手上飛向目標，命中那一刻落地（模擬不受影響）
				if u.type == D.BOMBER and at > 0.0 and at < Art.ATK_WINDUP and bomb_tgt.get(u.id, {}).has(h):
					var bt = view.unit_by_id(bomb_tgt[u.id][h])
					if bt != null:
						var fk := at / Art.ATK_WINDUP
						var src_p: Vector2 = _upos(u) + Vector2(0, -50)
						var dst_p: Vector2 = _upos(bt) + Vector2(0, -10)
						var pp := src_p.lerp(dst_p, fk) + Vector2(0, -sin(fk * PI) * minf(70.0, src_p.distance_to(dst_p) * 0.3))
						pot_draw.append(pp)
				if u.type == D.SWORD:
					variant = int(atk_seq.get(u.id, {}).get(h, 0)) % 2   # 劍士橫斬與上挑逐擊交替（第三輪 R4）
				elif u.type >= D.CLASSIC and alt_hit.get(u.id, {}).has(h):
					variant = 2
		var hurt := 0.0
		if live and hurt_t.has(u.id) and _fx_on("flash"):
			hurt = clampf(1.0 - (time - hurt_t[u.id]) / 0.15, 0, 1)
		var alpha := 0.45 if u.stealth > 0 else 1.0
		if dim:
			alpha *= 0.6
		if live:
			alpha *= _focus_dim(p)
		var face := signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
		# 受擊後退 4px（第三輪 R2）：0.08 秒退、0.07 秒回，只是畫面
		if live and hurt_t.has(u.id):
			var hk: float = (time - float(hurt_t[u.id])) / 0.15
			if hk >= 0.0 and hk < 1.0:
				p.x += float(hurt_dir.get(u.id, 0.0)) * 4.0 * (sin(hk * PI) if hk < 1.0 else 0.0)
		if live and u.id == follow_id:
			draw_arc(p + Vector2(0, 2), 22.0, 0, TAU, 28, Color(ACCENT, 0.9), 3.0, true)   # 跟拍中的那隻
		# 擠在一起時，正在出手或受擊的那隻加隊伍色光圈（第三輪 V5）
		if live and (at > 0.0 or hurt > 0.0) and crowd.get(u.id, 0) >= 3:
			draw_arc(p + Vector2(0, -24 if u.type != D.CAVALRY else -28), 19.0, 0, TAU, 24, Color(Art.team_color(u.team, cbm()), 0.75 * alpha), 2.0, true)
		# 表情與兵種專屬動作（R5）
		var mood := 0
		var lean := 0.0
		var crouch := 1.0
		if hurt > 0.3 or u.stun > 0:
			mood |= Art.M_HURT
		if u.type == D.CAVALRY and moving and u.charge >= D.CHARGE_NEED:
			mood |= Art.M_SPARKLE
			lean = 0.26                      # 衝鋒蓄滿前傾 15°
			for k in 3:                      # 馬蹄噴土
				var ph := fmod(time * 4.0 + k * 0.33 + u.id * 0.1, 1.0)
				draw_circle(p + Vector2(-face * (14 + ph * 16), -2 - ph * 6), 3.2 * (1.0 - ph), Color(0.85, 0.75, 0.55, 0.7 * (1.0 - ph)), true, -1.0, true)
		if s.frenzy and at == 0.0 and not s.finished:
			mood |= Art.M_BROWS
			# 狂熱氣場（第三輪 R3）：身邊橘紅脈衝圈
			var pulse := 0.5 + 0.5 * sin(time * 7.0 + u.id)
			draw_arc(p + Vector2(0, -22), 15.0 + pulse * 3.0, 0, TAU, 20, Color(1.0, 0.33, 0.2, (0.35 + 0.3 * pulse) * alpha), 2.0, true)
		if u.type == D.ASSASSIN and u.stealth > 0:
			mood |= Art.M_HOOD
			crouch = 0.9                     # 潛行蹲身
		if live and brace_t.has(u.id) and time - brace_t[u.id] < 0.35:
			mood |= Art.M_BRACE
		# 勝利：存活的勝方每 0.45 秒原地跳 10px、武器高舉
		var hop := 0.0
		if live and sim != null and u.team == sim.winner and (state == St.RESULT or (state == St.BATTLE and view != null and view.finished)):
			hop = absf(sin((time + u.id * 0.05) * PI / 0.45)) * 10.0
			at = Art.ATK_WINDUP
			lean = Art.LEAN_BACK      # 抵銷前搖的後仰：站直、武器高舉（和前搖分得開，Antigravity S4）
			crouch = 1.06
			_star_above(p + Vector2(0, -hop - (74 if u.type == D.CAVALRY else 66)))
		p.y -= hop
		if u.hidden:
			Art.mimic_closed(self, p, u.team, face, alpha, time, cbm(), UNIT_SCALE)   # 偽裝中的寶箱怪
			continue
		if u.type == F8.GHOST:
			alpha *= 0.9
		# 待機小動作（V9 P2）：重心換腳、偶爾縮一下身子
		if live and walk == 0.0 and at == 0.0:
			lean += sin(time * 1.1 + u.id * 1.7) * 0.018
			var idle_k := fmod(time + u.id * 1.37, 7.3)
			if idle_k < 0.3:
				crouch *= 1.0 - sin(idle_k / 0.3 * PI) * 0.05
		if live:
			face = _face_of(u)
		if u.stealth > 0:
			# 潛行：身後兩道暗紫殘影
			for g in 2:
				var gp := p + Vector2(-(8 + g * 8) * face, 0)
				draw_circle(gp + Vector2(0, -22), 11.0 - g * 2.0, Color(0.3, 0.15, 0.45, 0.22 - g * 0.08), true, -1.0, true)
				_unit(gp, u.type, u.team, face, 0.0, 0.0, 0.0, 0.14 - g * 0.06, time, UNIT_SCALE)
		if live and walk <= Gait.POSE_DAZE + 1.0:
			# 暈眩：頭上轉圈的星星
			for sk0 in 3:
				var sa0 := time * 5.0 + sk0 * TAU / 3.0
