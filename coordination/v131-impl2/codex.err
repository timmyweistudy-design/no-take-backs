   118	## 表情與狀態疊加：呼叫前畫布轉換要已經是這隻角色的局部座標（face＝+1 空間）。
   119	static func overlay(ci: CanvasItem, type: int, team: int, mood: int, a: float, t: float, cb := false) -> void:
   120		if mood & M_HAPPY:
   121			mood &= ~M_HURT   # V1.3.1：歡呼優先於受擊眼
   122		var ec := Vector2(2.0, -43.0) if type == D.CAVALRY else (Vector2(5.5, -33.5) if type == D.ASSASSIN else Vector2(3.5, -32.0))
   123		if type >= D.COUNT:
   124			if not FEATURE_EYES.has(type):
   125				return   # 寶箱怪、羊、沙漏等臉在別處，不疊通用表情
   126			ec = FEATURE_EYES[type]
   127		var eyes := [ec + Vector2(-3.0 if type != D.ASSASSIN else -2.5, 0), ec + Vector2(4.0 if type != D.ASSASSIN else 2.5, 0)]
   128		var skin := Color("#2b2140") if type == D.ASSASSIN else SKIN
   129		if mood & (M_HAPPY | M_SURPRISE | M_GRIM):
   130			for e in eyes:
   131				ci.draw_circle(e, 3.4, Color(skin, a), true, -1.0, true)   # 先蓋掉原本的眼睛
   132				if mood & M_HAPPY:
   133					ci.draw_arc(e + Vector2(0, 1.2), 2.6, PI * 1.15, PI * 1.85, 6, Color(OUT, a), 1.7, true)
   134				elif mood & M_SURPRISE:
   135					ci.draw_circle(e, 3.0, Color(OUT, a), true, -1.0, true)
   136					ci.draw_circle(e + Vector2(0.6, -0.7), 1.2, Color(1, 1, 1, a), true, -1.0, true)
   137				else:
   138					ci.draw_circle(e + Vector2(0, 0.6), 2.2, Color(OUT, a), true, -1.0, true)
   139					ci.draw_line(e + Vector2(-2.6, -3.4), e + Vector2(2.6, -2.2), Color(OUT, a), 1.4, true)
   140			var mc: Vector2 = (eyes[0] + eyes[1]) * 0.5 + Vector2(0, 6.0)
   141			if mood & M_SURPRISE:
   142				ci.draw_circle(mc, 1.6, Color(OUT, a), true, -1.0, true)
   143			elif mood & M_GRIM:
   144				ci.draw_arc(mc + Vector2(0, 2.0), 2.4, PI * 1.2, PI * 1.8, 6, Color(OUT, a), 1.3, true)
   145		if mood & M_HOOD:
   146			# 帽簷壓低：一條兜帽色的帽簷蓋到眼睛上緣；每 0.4 秒整個蓋住一下（眨眼）
   147			var shut := fmod(t, 0.4) < 0.07
   148			var drop := 4.6 if shut else 2.2
   149			ci.draw_rect(Rect2(ec + Vector2(-6.5, -4.8), Vector2(13.0, drop)), Color("#33304a", a))
   150		if mood & M_HURT:
   151			for i in 2:
   152				var e: Vector2 = eyes[i]
   153				ci.draw_circle(e, 3.3, Color(skin, a), true, -1.0, true)
   154				var sx := 1.0 if i == 0 else -1.0     # 左眼 >、右眼 <
   155				var col := Color("#ffe066", a) if type == D.ASSASSIN else Color(OUT, a)
   156				ci.draw_polyline(PackedVector2Array([e + Vector2(-1.8 * sx, -2.0), e + Vector2(1.6 * sx, 0), e + Vector2(-1.8 * sx, 2.0)]), col, 1.4, true)
   157		if mood & M_SPARKLE:
   158			for e in eyes:
   159				ci.draw_circle(e, 2.9, Color(OUT, a), true, -1.0, true)
   160				_star(ci, e + Vector2(0.4, -0.6), 2.2, Color(1, 1, 1, a))
   161			# 槍尖金光（長槍放平時的槍尖位置）
   162			var tip := Vector2(-6, -30) + Vector2(cos(-0.55), sin(-0.55)) * 40.0
   163			var g := 0.6 + 0.4 * sin(t * 18.0)
   164			_star(ci, tip, 14.0 * (0.8 + 0.2 * g), Color(1, 0.86, 0.3, a * g))   # 14px 十字閃芒（第三輪 R3）
   165			_star(ci, tip, 6.0, Color("#fff8a0", a))
   166		if mood & M_BROWS:
   167			for i in 2:
   168				var e2: Vector2 = eyes[i]
   169				var inward := 1.0 if i == 0 else -1.0
   170				var bc := Color("#ffe066", a) if type == D.ASSASSIN else Color(OUT, a)
   171				ci.draw_line(e2 + Vector2(-2.2, -4.2 - inward * 0.9), e2 + Vector2(2.2, -4.2 + inward * 0.9), bc, 1.8, true)
   172				ci.draw_circle(e2 + Vector2(0.6, -0.4), 1.2, Color(1, 0.25, 0.2, a), true, -1.0, true)   # 紅眼光點（第三輪 R3）
   173		if mood & M_BRACE and type == D.PIKE:
   174			# 長槍兵拒騎：槍尖位置爆一圈銀色十字閃光（第四輪）
   175			var g2 := 0.6 + 0.4 * sin(t * 20.0)
   176			_star(ci, Vector2(7, -17) + Vector2(cos(-0.8), sin(-0.8)) * 48.0, 13.0 * g2 + 4.0, Color(0.92, 0.96, 1.0, a))
   177		if mood & M_BRACE and type == D.SHIELD:
   178			# 頂住：盾放大 1.35 倍（以盾中心縮放）
   179			var cc := Vector2(11, -24)
   180			var k := 1.25
   181			var sh := PackedVector2Array()
   182			for q in [Vector2(1, -43), Vector2(21, -41), Vector2(21, -14), Vector2(11, -2), Vector2(1, -14)]:
   183				sh.append(cc + (q - cc) * k)
   184			_poly(ci, sh, STEEL, a)
   185			var inner := PackedVector2Array()
   186			for q2 in [Vector2(7, -33), Vector2(15, -32), Vector2(15, -17), Vector2(11, -11), Vector2(7, -17)]:
   187				inner.append(cc + (q2 - cc) * k)
   188			_poly(ci, inner, team_color(team, cb), a, false)
