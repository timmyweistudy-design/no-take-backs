   289		ci.draw_circle(q + Vector2(-3.6 * k, -31.5 * k - 1.0) * scale, 1.8 * k * scale, Color(1, 1, 1, 0.6 * alpha), true, -1.0, true)
   290	
   291	## V1.3.1：貼額外頁的一格（小動作、受擊帽子、走路轉身）。bob＝要不要加待機呼吸。
   292	func _draw_cell(ci: CanvasItem, tex: Texture2D, idx: int, p: Vector2, type: int, team: int, face: float, hurt: float, alpha: float, t: float, scale: float, lean: float, crouch: float, bob: bool, mood := 0, cb := false, oc := 1.0) -> void:
   293		var sg := -1.0 if face < 0.0 else 1.0
   294		var by := Art.idle_bob(t, p) if bob else 0.0
   295		ci.draw_set_transform_matrix(Art.base * Transform2D(lean * sg, Vector2(scale * sg / RS, scale * crouch / RS), 0.0, p + Vector2(0, by * scale)))
   296		ci.draw_texture_rect_region(tex, Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
