    63	static func _part(ci: CanvasItem, z: float, fwd: float) -> void:
    64		if turn_c >= 1.0:
    65			return
    66		# 往前伸的武器最多縮到一半（Antigravity v131-impl1：cos 0.3 時刀、吸嘴、手臂短到看不見）
    67		var sxp := lerpf(1.0, turn_c, fwd)
    68		if fwd >= 0.5:
    69			sxp = maxf(sxp, 0.5)
    70		_cur_xf = _xf0 * _b_now * Transform2D(0.0, Vector2(sxp, 1.0), 0.0, Vector2(-z * turn_s, 0.0))
    71		_cur_weapon = anchor_on and fwd >= 0.5 and z != 0.0
    72		ci.draw_set_transform_matrix(_cur_xf)
    73	
    74	## V1.3.1：圓的部件（羊頭、幽靈臉、骷髏頭）只移到轉過去的位置，不壓扁。x0＝部件中心的 x。
    75	static func _part_at(ci: CanvasItem, x0: float) -> void:
    76		if turn_c >= 1.0:
    77			return
    78		_cur_xf = _xf0 * _b_now * Transform2D(0.0, Vector2.ONE, 0.0, Vector2(x0 * (turn_c - 1.0), 0.0))
    79		_cur_weapon = false
    80		ci.draw_set_transform_matrix(_cur_xf)
    81	
    82	## 回到身體的轉換。
    83	static func _part_end(ci: CanvasItem) -> void:
    84		if turn_c >= 1.0:
    85			return
    86		_cur_xf = _xf * _b_now
    87		_cur_weapon = false
    88		ci.draw_set_transform_matrix(_cur_xf)
