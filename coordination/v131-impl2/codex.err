   348				_draw_turn(ci, p, type, team, face, hurt, alpha, t, scale, lean, crouch, mood, cb)
   349				return
   350			face = (1.0 if face >= 0.0 else -1.0) * maxf(absf(face), 0.45)   # 轉到一半就出手：像厚木牌，不夾成 0.18（Codex v130-impl1）
   351		var idx := frame_index(type, team, walk, atk, t, p.x, variant)
