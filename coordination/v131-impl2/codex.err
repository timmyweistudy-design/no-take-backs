+	ci.draw_set_transform_matrix(_cur_xf)
+
+## V1.3.1：圓的部件（羊頭、幽靈臉、骷髏頭）只移到轉過去的位置，不壓扁。x0＝部件中心的 x。
+static func _part_at(ci: CanvasItem, x0: float) -> void:
+	if turn_c >= 1.0:
