    85		var open := 0.45 + maxf(0.0, w) * 0.55 - minf(0.0, w) * 0.2
    86		if wk != 0.0 and w == 0.0:
    87			open = 0.04 + absf(sin(wk)) * 0.26   # 跳到最高才張嘴露一點舌（Antigravity P2 #1）
    88		var by := -3.0
    89		_poly(ci, PackedVector2Array([Vector2(-16, by), Vector2(-16, by - 15), Vector2(16, by - 15), Vector2(16, by)]), Color("#9c6b3c"), a)
    90		ci.draw_line(Vector2(-16, by - 7), Vector2(16, by - 7), Color(OUT, 0.5 * a), 1.6, true)
   150			var cr := Vector2(0.5, cy - ry * 1.42)
   151			_poly(ci, PackedVector2Array([cr + Vector2(-6, 2), cr + Vector2(-6, -5), cr + Vector2(-3, -1.5), cr + Vector2(0, -7), cr + Vector2(3, -1.5), cr + Vector2(6, -5), cr + Vector2(6, 2)]), GOLD, a)
   152	
   153	
   154	static func _f_ghost(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
   155		# 無腳飄浮：飄逸的長裙擺，隊伍色披巾在肩上；攻擊時張大嘴
   156		var body := tc.lightened(0.3)
   157		var wk := Gait.ph(walk)
   158		var lean := w * 4.0 + (4.5 if wk != 0.0 else 0.0)   # 前進要看得出來（Antigravity P2 #7）
   159		var sway := sin(t * 2.0 + wk) * 2.6
   160		_push_body(ci, Gait.body_xf(14, walk))
   161		var top := -48.0
   162		var pts := _ell(Vector2(lean, top + 15), 16.0, 15.0, PI, TAU, 14)
   163		for s in [[16.0, -24.0], [17.0, -14.0], [11.0, -5.0 + sway], [7.0, -11.0], [2.0, -3.0 - sway], [-3.0, -11.0], [-8.0, -4.0 + sway], [-13.0, -11.0], [-18.0, -7.0 - sway], [-16.0, -24.0]]:
   164			pts.append(Vector2(s[0] + lean * (0.2 + (-s[1]) * 0.02), s[1]))
   165		_poly(ci, pts, Color(body, 0.94), a)
   166		_poly(ci, PackedVector2Array([Vector2(-16 + lean, -33), Vector2(16 + lean, -33), Vector2(17 + lean * 0.7, -24), Vector2(4 + lean * 0.5, -21), Vector2(-16 + lean * 0.7, -24)]), tc, a, false)
   167		ci.draw_line(Vector2(-16 + lean, -33), Vector2(16 + lean, -33), Color(tc.darkened(0.25), a), 1.6, true)
   168		var ey := -40.0
   169		_part_at(ci, 2.5 + lean)   # V1.3.1：臉轉向鏡頭時移到中間
   170		for ex in [-2.0 + lean, 7.0 + lean]:
   171			ci.draw_circle(Vector2(ex, ey), 3.3, Color(OUT, a), true, -1.0, true)
   172			ci.draw_circle(Vector2(ex + 0.9, ey - 1.0), 1.1, Color(1, 1, 1, a), true, -1.0, true)
   173			ci.draw_arc(Vector2(ex, ey), 4.8, 0.4, PI - 0.4, 6, Color(tc.darkened(0.2), 0.6 * a), 1.4, true)   # 黑眼圈
   174		if angry or w > 0.0:
   175			ci.draw_circle(Vector2(2.5 + lean, ey + 7), 3.2, Color(OUT, a), true, -1.0, true)
   176		else:
   177			ci.draw_arc(Vector2(2.5 + lean, ey + 5), 2.2, 0.3, PI - 0.3, 6, Color(OUT, a), 1.3, true)
   178		var hd := sin(wk + 0.9) * 2.0 if wk != 0.0 else 0.0   # 手延遲
   179		_part(ci, 4.0, 0.5)   # 遠側的手
   180		_c(ci, Vector2(-15 + lean + w * 5.0 - hd, -25 + hd), 3.6, body, a)
   181		_part(ci, -4.0, 0.5)  # 近側的手
   182		_c(ci, Vector2(16 + lean + maxf(0.0, w) * 10.0 - hd, -26 - hd), 3.6, body, a)
   183		_part_end(ci)
   184	
