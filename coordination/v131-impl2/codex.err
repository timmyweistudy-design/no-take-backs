   306	
   307	## 倒棋用：只貼木座（帶透明度）。
   308	func draw_base(ci: CanvasItem, p: Vector2, scale := 1.0, a := 1.0) -> void:
   309		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
   310		ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2(4 * CELL, 0, CELL, CELL), Color(1, 1, 1, a))
   311		ci.draw_set_transform_matrix(Art.base)
   312	
   313	func _rect(idx: int) -> Rect2:
   314		return Rect2((idx % COLS) * CELL, (idx / COLS) * CELL, CELL, CELL)
   315	
   316	## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
   317	func quant_walk(walk: float) -> float:
   318		if walk == 0.0:
   319			return 0.0
   320		if walk < -50.0:
   321			return walk
   322		return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES
   323	
   324	func quant_atk(atk: float) -> float:
   325		if atk <= 0.0:
   326			return 0.0
   327		return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES
   328	
   329	## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
   330	func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
   331			hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false, variant := 0, fid := -1) -> void:
   332		if hurt > 0.5 and atk <= 0.0 and walk == 0.0 and absf(face) >= 0.9 and fid_loc.has(type):
   333			# 受擊那一下帽子彈起（只在待機：帽子格是待機腿，走路、拖行、暈眩不能被蓋掉；受擊優先於小動作）
   334			_draw_cell(ci, fid_tex, int(fid_loc[type]) + team * FID_PER + FID_PER - 1, p, type, team, face, hurt, alpha, t, scale, lean, crouch, true, mood, cb)
   335			return
   336		if fid >= 0 and hurt <= 0.0 and atk <= 0.0 and walk == 0.0 and absf(face) >= 0.9 and fid_loc.has(type):
   337			_draw_cell(ci, fid_tex, int(fid_loc[type]) + team * FID_PER + clampi(fid, 0, FID_PER - 2), p, type, team, face, hurt, alpha, t, scale, lean, crouch, true, mood, cb)
   338			return
   339		if absf(face) < 0.9 and atk <= 0.0 and walk > 0.0 and wt_loc.has(type):
   340			# 走路中轉身：依步相取格（不重設腳步）
   341			var wl: Array = wt_loc[type]
   342			var ai := 0 if absf(face) >= 0.55 else 1
   343			var ph := int(fposmod(walk, TAU) / TAU * WT_PH) % WT_PH
   344			_draw_cell(ci, wt_pages[wl[0]], int(wl[1]) + team * WT_C.size() * WT_PH + ai * WT_PH + ph, p, type, team, face, hurt, alpha, t, scale, lean, crouch, false, mood, cb, float(WT_C[ai]))
   345			return
   346		if absf(face) < 0.9 and has_turn(type):
