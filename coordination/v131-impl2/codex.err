+const TURN_FWD := {3: 0.6, 13: 0.0, 19: 0.3, 10: 0.0, 11: 0.3, 12: 0.45, 14: 0.2, 16: 0.0, 18: 0.3, 20: 0.0, 21: 0.3}   # 騎兵的馬最窄約 0.58；V1.3.1：羊長身、寶箱方體會縮，孢子菇、沙漏、小史萊姆不縮
+static var baking := false
