   221	static func _f_sprite(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
   222		var wk := Gait.ph(walk)
   223		_push_body(ci, Gait.body_xf(16, walk))
   224		# 飄浮的大沙漏，不畫人形（免得和鼓手、醫者撞）；弧形翅膀、沙子往下流
   225		var flap := sin(t * 9.0 + wk * 3.0) * 4.5 - minf(w, 0.0) * 6.0
   226		for s in [-1.0, 1.0]:
   227			_part(ci, -4.0 * s, 0.6)   # V1.3.1：翅膀一遠一近，轉身時翼展壓窄
   228			var wing := PackedVector2Array([Vector2(s * 8, -32), Vector2(s * 18, -47 + flap), Vector2(s * 29, -48 + flap), Vector2(s * 33, -37 + flap), Vector2(s * 28, -26 + flap * 0.6), Vector2(s * 19, -19), Vector2(s * 9, -22)])
   229			_poly(ci, wing, Color(tc.lightened(0.42), 0.97), a)
   230			ci.draw_line(Vector2(s * 11, -30), Vector2(s * 27, -41 + flap), Color(tc, 0.7 * a), 1.6, true)
   231			ci.draw_line(Vector2(s * 11, -26), Vector2(s * 26, -31 + flap * 0.8), Color(tc, 0.7 * a), 1.6, true)
   232		_part_end(ci)
   233		var glass := Color("#e8f4ff")
   234		_poly(ci, PackedVector2Array([Vector2(-13, -47), Vector2(13, -47), Vector2(2, -27), Vector2(13, -8), Vector2(-13, -8), Vector2(-2, -27)]), glass, a)
   235		_poly(ci, PackedVector2Array([Vector2(-9, -41), Vector2(9, -41), Vector2(1, -29), Vector2(-1, -29)]), tc, a, false)
   236		_poly(ci, PackedVector2Array([Vector2(-11, -9), Vector2(11, -9), Vector2(6, -17), Vector2(0, -22), Vector2(-6, -17)]), tc, a, false)
   237		var flow := fmod(t * 2.0 + wk / TAU, 1.0)
   238		for k in 3:
   239			ci.draw_circle(Vector2(0, -28 + fmod(flow + k * 0.33, 1.0) * 8.0), 1.1, Color(tc, a), true, -1.0, true)
   240		ci.draw_line(Vector2(-8, -44), Vector2(-4, -36), Color(1, 1, 1, 0.8 * a), 1.6, true)
   241		for fy in [-50.0, -7.0]:
   242			_line(ci, Vector2(-16, fy), Vector2(16, fy), GOLD, 4.0, a)
   243		# 臉畫在上半部玻璃裡（放頂框上面像多擺一顆頭，也會頂到圓框）
   244		_c(ci, Vector2(0, -38), 6.5, Color("#fff3d6"), a)
   245		_eyes(ci, Vector2(0.5, -38.0), a, t, angry)
   246	
   247	
   248	static func _f_bone(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool, variant: int) -> void:
   249		# 駝背骷髏＋破斗篷，高舉攤開的魔法書（不拿杖，和醫者分開）；身旁飄一顆小骷髏燈
   250		var ft: Array = Gait.feet(17, walk)
   251		var wk := Gait.ph(walk)
   252		_c(ci, Vector2(-5 + ft[0], -3 - ft[1]), 3.2, Color("#ece6d6"), a)
   253		_c(ci, Vector2(4 + ft[2], -3 - ft[3]), 3.2, Color("#ece6d6"), a)
   254		_push_body(ci, _atk_xf(Gait.body_xf(17, walk), w, 0.1, 3.0))
   255		var hem := sin(wk + 1.0) * 2.5 if wk != 0.0 else 0.0   # 袍擺延遲
   256		var cape := PackedVector2Array([Vector2(-17 - hem, -4), Vector2(-19 - hem * 0.5, -26), Vector2(-9, -40), Vector2(9, -32), Vector2(13 - hem * 0.6, -7), Vector2(7 - hem * 0.6, -10), Vector2(2 - hem, -4), Vector2(-4 - hem, -10), Vector2(-11 - hem, -4)])
   257		_poly(ci, cape, tc, a)
   258		for x0 in [-14.0, -3.0]:
   259			ci.draw_line(Vector2(x0, -24), Vector2(x0 + 1, -9), Color(tc.darkened(0.25), a), 1.6, true)
   260		# 兜帽＋骷髏臉，頭往前探
   261		_poly(ci, PackedVector2Array([Vector2(-9, -50), Vector2(-21, -46), Vector2(-11, -40)]), tc.darkened(0.15), a)   # V1.3.1 剪影：兜帽尖往後翹
   262		_poly(ci, _ell(Vector2(2, -39), 15.0, 14.0, PI * 0.72, PI * 2.05, 14), tc.darkened(0.15), a)
   263		_part_at(ci, 6.0)   # V1.3.1：骷髏頭移到中間、不壓扁
   264		_c(ci, Vector2(6, -35), 10.5, Color("#f5f0e0"), a)
   265		for ex in [2.0, 10.0]:
   266			ci.draw_circle(Vector2(ex, -36), 3.2, Color(OUT, a), true, -1.0, true)
   267			ci.draw_circle(Vector2(ex + 0.4, -36), 1.1, Color("#c77dff", a), true, -1.0, true)
   268		ci.draw_colored_polygon(PackedVector2Array([Vector2(6, -33), Vector2(4.5, -30), Vector2(7.5, -30)]), Color(OUT, a))
   269		for k in 4:
   270			ci.draw_line(Vector2(2.0 + k * 2.6, -28), Vector2(2.0 + k * 2.6, -25), Color(OUT, a), 1.2, true)
   271		# 高舉的書與紫火：專屬動作舉更高
   272		_part_end(ci)   # 臉到這裡
   273		var lift: float = 6.0 + maxf(0.0, -w) * 8.0 + maxf(0.0, w) * 3.0 + (10.0 if variant == 2 else 0.0) + Gait.swing(17, walk) * 12.0
   274		_part(ci, -5.0, 0.5)   # 書與紫火在近側、留在臉前
   275		var bk := Vector2(24, -22 - lift)   # V1.3.1 剪影：書與紫火往前探 4px
   276		_line(ci, Vector2(9, -20), bk + Vector2(-2, 4), Color("#ece6d6"), 2.4, a)
   277		_poly(ci, PackedVector2Array([bk + Vector2(-10, -2), bk + Vector2(0, 0), bk + Vector2(10, -2), bk + Vector2(10, 4), bk + Vector2(0, 6), bk + Vector2(-10, 4)]), Color("#6b4a2b"), a)
   278		ci.draw_line(bk + Vector2(0, 0), bk + Vector2(0, 6), Color(OUT, a), 1.2, true)
   279		var fl := 8.0 + absf(w) * 7.0 + sin(t * 12.0 + wk * 3.0) * 1.8
   280		_poly(ci, PackedVector2Array([bk + Vector2(-6, -1), bk + Vector2(6, -1), bk + Vector2(3, -2 - fl), bk + Vector2(0, -6 - fl), bk + Vector2(-3, -2 - fl)]), Color("#b14dff"), a)
   281		ci.draw_circle(bk + Vector2(0, -4 - fl * 0.3), 2.4, Color(1, 0.85, 1, 0.9 * a), true, -1.0, true)
   282		_part_end(ci)
   283	
   284	
   285	static func _f_cat(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool, variant: int) -> void:
   286		var ft: Array = Gait.feet(18, walk)
   287		var wk := Gait.ph(walk)
   288		var leg := sin(wk) * 4.0 if wk != 0.0 else 0.0
   289		# 腳先畫，上半身（尾巴、吸塵器、頭）跟著起伏
   290		_c(ci, Vector2(-4 + ft[0], -3 - ft[1]), 3.4, tc.darkened(0.2), a)
   291		_c(ci, Vector2(5 + ft[2], -3 - ft[3]), 3.4, tc.darkened(0.2), a)
   292		_push_body(ci, _atk_xf(Gait.body_xf(18, walk), w, 0.14, 5.0))
     1	extends "res://scripts/ui/units/kit.gd"
     2	## 由 art.gd 拆出（V9 P1，行為不變）
     3	
     4	## variant：0 一般招式、1 交替招式（劍士上挑；其他兵種同一般）。第三輪 R4。
     5	## 第四輪：variant 2＝新兵的專屬動作（長槍兵拒騎頓槍、投彈兵被貼身拿點火棒敲、醫者舉杖施法、鼓手大力敲、狂戰士雙斧高舉）。
     6	static func _infantry(ci: CanvasItem, type: int, tc: Color, walk: float, w: float, a: float, t: float, angry := false, variant := 0) -> void:
     7		# 腿（V9 P2）：腳踩地不動，上半身另外起伏；腿從腰連到腳，分隔不會斷開
     8		var ft: Array = Gait.feet(type, walk)
     9		var bx: Transform2D = Gait.body_xf(type, walk)
    10		var hip_y := -9.0 + bx.origin.y
    11		var legc := Color("#4a3b5c")
    12		_line(ci, Vector2(-3.5, hip_y), Vector2(-4 + ft[0], -4.0 - ft[1]), legc, 3.4, a)
    13		_c(ci, Vector2(-4 + ft[0], -3.0 - ft[1]), 3.6, legc, a)
    14		_line(ci, Vector2(3.5, hip_y), Vector2(4 + ft[2], -3.0 - ft[3]), legc, 3.4, a)
    15		_c(ci, Vector2(4 + ft[2], -2.0 - ft[3]), 3.6, legc, a)
    16		_push_body(ci, bx)
    17		var wk := Gait.ph(walk)
    18		var sway: float = Gait.swing(type, walk)
    19		var fl := sin(wk + 1.0) * 2.5 if wk != 0.0 else 0.0   # 披風延遲擺動
    20		# 第七輪 C2：小披風分隊，藍方圓角、紅方燕尾（除了圍巾已經很明顯的刺客與騎兵）
    21		if type != D.ASSASSIN:
    22			var cape := PackedVector2Array([Vector2(-6, -23), Vector2(-14 - fl * 0.4, -18), Vector2(-16 - fl, -8 + fl * 0.3), Vector2(-12 - fl, -6), Vector2(-7, -9)]) if _team_now == 0 else PackedVector2Array([Vector2(-6, -23), Vector2(-15 - fl * 0.4, -18), Vector2(-18 - fl, -6 + fl * 0.3), Vector2(-13 - fl * 0.8, -10), Vector2(-11 - fl, -5), Vector2(-7, -9)])
    23			_poly(ci, cape, tc.darkened(0.08), a)
    24		# 背後的東西（箭筒）
    25		if type == D.ARCHER:
    26			# 第七輪 C1-3：箭筒放大、露白羽
    27			_poly(ci, PackedVector2Array([Vector2(-14, -30), Vector2(-7, -33), Vector2(-3, -11), Vector2(-9, -9)]), WOOD, a)
    28			for fi in 3:
    29				var fx0 := Vector2(-12.0 + fi * 3.0, -32.0 - fi * 0.8)
    30				_line(ci, fx0, fx0 + Vector2(-3 - fl * 0.5, -7), Color.WHITE, 1.8, a)
    31		# 背後的東西（投彈兵的備用火罐包）
    32		if type == D.BOMBER:
    33			# V1.3.1 剪影：肩後多一個木火藥桶，頂端高出肩膀（和盾兵、劍士的圓輪廓分開）
    34			var bb := Vector2(-13, -30 + fl * 0.8)
    35			_poly(ci, PackedVector2Array([bb + Vector2(-5, -9), bb + Vector2(5, -9), bb + Vector2(6, 7), bb + Vector2(-6, 7)]), Color("#8a5a32"), a)
    36			_line(ci, bb + Vector2(-5.5, -3), bb + Vector2(5.5, -3), Color("#5b3a1e"), 1.4, a)
    37			_line(ci, bb + Vector2(0, -9), bb + Vector2(2, -15), Color("#c9a26b"), 1.3, a)
    38			_c(ci, Vector2(-10, -20 + fl * 0.8), 7.5, Color("#3a3346"), a)   # 第七輪 C1-7：火罐包放大（V9：跟著跑步彈）
    39			_line(ci, Vector2(-11, -27 + fl * 0.8), Vector2(-14, -31 + fl * 0.8), Color("#c9a26b"), 1.3, a)
    40		# 身體（圓胖的上衣，隊伍色；狂戰士赤膊，隊伍色只留在獸皮披肩與褲頭；醫者白袍）
    41		var bw0 := 13.0 if type == D.SHIELD else 10.5   # 第七輪 C1-2：盾兵身體加寬
    42		var body := PackedVector2Array()
    43		for i in 13:
    44			var ang := PI + i * PI / 12.0
    45			body.append(Vector2(cos(ang) * bw0, -16 + sin(ang) * 9.0))
    46		if type == D.MEDIC:
    47			body.append(Vector2(13, -5)); body.append(Vector2(-13, -5))   # 第七輪 C1-8：A 字長袍
    48		else:
    49			body.append(Vector2(bw0 - 0.5, -5)); body.append(Vector2(-bw0 + 0.5, -5))
    50		_poly(ci, body, SKIN.darkened(0.06) if type == D.BERSERKER else (Color("#f4f1ea") if type == D.MEDIC else tc), a)
    51		if type == D.BERSERKER:
    52			# 第七輪 C1-10：披肩加寬＋交叉肩帶＋整條褲頭，隊伍色面積拉大
   180				_line(ci, pbutt, ptip, WOOD, 2.4, a)
   181				_poly(ci, PackedVector2Array([ptip + pdir * 11.0, ptip + pdir.orthogonal() * 4.4, ptip - pdir.orthogonal() * 4.4]), STEEL, a)   # 第七輪 C1-6：槍尖放大
   182				var tas := ptip - pdir * 2.0
   183				_poly(ci, PackedVector2Array([tas, tas + Vector2(-4.6, 8.0), tas + Vector2(0, 6.0), tas + Vector2(3.2, 8.5)]), tc, a)   # 第七輪：槍纓改隊伍色
   184				if variant == 2:
   185					_star(ci, ptip + pdir * 6.0, 9.0, Color(0.92, 0.95, 1.0, a))   # 拒騎：槍尖銀色十字閃光
   186				_c(ci, phand, 3.0, SKIN, a)
   187				_part_end(ci)
   188			D.BOMBER:
   189				# 橘紅頭巾＋黃銅護目鏡（推在額頭上）
   190				_hat_on(ci)   # V1.3.1：受擊時帽子彈起（只在受擊影格）
   191				ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.0, PI * 2.0, 18, Color(OUT, a), 6.5, true)
   192				ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.0, PI * 2.0, 18, Color("#ff7a3d", a), 4.0, true)
   193				_poly(ci, PackedVector2Array([Vector2(-11, hy - 2), Vector2(-17, hy + 4), Vector2(-12, hy + 5)]), Color("#ff7a3d"), a)
   194				_c(ci, Vector2(1.5, hy - 7.5), 3.4, Color("#d9a441"), a)
   195				_c(ci, Vector2(8.5, hy - 7.5), 3.4, Color("#d9a441"), a)
   196				ci.draw_circle(Vector2(1.5, hy - 7.5), 1.8, Color("#9fe3ff", a), true, -1.0, true)
   197				ci.draw_circle(Vector2(8.5, hy - 7.5), 1.8, Color("#9fe3ff", a), true, -1.0, true)
   198				_hat_off(ci)
   199				# 肩上托一顆帶引線的黑色大圓火罐：前搖往後拉、揮擊時丟出去（手上就空了）；專屬＝被貼身：火罐收到背後、拿點火棒往前敲
   200				_part(ci, -5.0, 0.0)   # V1.3.1：火罐手在近側，圓罐不縮
   201				if variant == 2:
   202					var sa := -0.9 + maxf(0.0, w) * 1.6
   203					var sh0 := Vector2(10, -18)
   204					var sd := Vector2(cos(sa), sin(sa))
   205					_line(ci, sh0, sh0 + sd * 14.0, Color("#6b4a2b"), 2.4, a)
   206					_star(ci, sh0 + sd * 16.0, 3.6, Color(1, 0.7, 0.2, a))
   207					_c(ci, sh0, 3.0, SKIN, a)
   208				elif w == 0.0:   # V1.3.1：前搖一開始火罐就離手飛出（飛行在 battle_units 畫），手上不再同時拿著一顆
   209					var bp := Vector2(17 + w * 9.0, -24 + (-w) * 4.0 + sway * 12.0)   # 第七輪 C1-7：火罐托在身前、和頭拉開（縮小後不再像髮髻）
   210					_c(ci, bp, 7.5, Color("#2a2533"), a)
   211					ci.draw_circle(bp + Vector2(-2.5, -2.5), 2.0, Color(1, 1, 1, 0.35 * a), true, -1.0, true)
   212					_line(ci, bp + Vector2(2, -7), bp + Vector2(5, -11), Color("#c9a26b"), 1.3, a)
   213					var sp := 0.6 + 0.4 * sin(t * 22.0)
   214					_star(ci, bp + Vector2(5.5, -12), 3.2 * sp + 1.0, Color(1, 0.85, 0.3, a))
   215					_c(ci, Vector2(14 + w * 6.0, -17), 3.0, SKIN, a)
   216				else:
   217					# 甩臂：火罐出手後手臂往前下甩（Antigravity P2 #6）
   218					_line(ci, Vector2(7, -20), Vector2(12 + w * 12.0, -24 + w * 14.0), SKIN, 2.6, a)
   219					_c(ci, Vector2(12 + w * 12.0, -24 + w * 14.0), 3.0, SKIN, a)
   220				_part_end(ci)
   221			D.MEDIC:
   222				# 白色高方帽＋綠十字
   223				_hat_on(ci)   # V1.3.1：受擊時帽子彈起（只在受擊影格）
   224				_poly(ci, PackedVector2Array([Vector2(-9, hy - 7), Vector2(-8, hy - 24), Vector2(8, hy - 24), Vector2(9, hy - 7)]), Color("#fbfbf7"), a)
   225				ci.draw_rect(Rect2(Vector2(-1.6, hy - 21), Vector2(3.2, 10)), Color("#2fbf71", a))
   226				ci.draw_rect(Rect2(Vector2(-5, hy - 17.6), Vector2(10, 3.2)), Color("#2fbf71", a))
   227				_hat_off(ci)
   228				# 頂端發綠光的長杖：補血時舉高（w 往前＝舉杖）
   229				var lift := maxf(0.0, w) * 16.0 + (-w * 4.0 if w < 0.0 else 0.0) + sway * 14.0
   230				if variant == 2:
   231					lift = 18.0   # 專屬＝施法：雙手把杖高舉過頭
   232				_part(ci, -4.0, 0.6)   # V1.3.1：法杖在近側
   233				var sbase := Vector2(15, -4 - lift)
   234				var stop := Vector2(21, -48 - lift)   # 第七輪：杖往外斜，剪影和方帽分開
   235				_line(ci, sbase, stop, WOOD, 2.2, a)
   236				var glow := 0.65 + 0.35 * sin(t * 4.0)
   237				ci.draw_circle(stop, 7.0 + lift * 0.5, Color(0.4, 1.0, 0.55, (0.28 + lift * 0.02) * glow * a), true, -1.0, true)
   238				# 第七輪 C1-8：杖頂大十字，遠看也知道是醫者
   239				_poly(ci, PackedVector2Array([stop + Vector2(-2, -6), stop + Vector2(2, -6), stop + Vector2(2, -2), stop + Vector2(6, -2), stop + Vector2(6, 2), stop + Vector2(2, 2), stop + Vector2(2, 6), stop + Vector2(-2, 6), stop + Vector2(-2, 2), stop + Vector2(-6, 2), stop + Vector2(-6, -2), stop + Vector2(-2, -2)]), Color("#7dffa0"), a)
   240				if variant == 2:
     1	extends RefCounted
     2	## 展示緩衝（第二輪方案 R5、§3）：戰鬥畫面固定比模擬晚 DELAY 個 tick。
     3	## 模擬先跑，每個 tick 存一份「畫面需要的狀態」快照＋事件；畫面依展示時鐘一格一格播。
     4	## 這樣命中事件在畫面上發生前 DELAY 個 tick 就知道了，可以先演前搖；
     5	## 血量、死亡、音效、HUD、跳字全部讀同一個延後的快照，所以一起延後，不會只有動作延後。
     6	## 純演出：模擬本身的計算、結果、指紋完全不受影響。
     7	
     8	const DELAY := 2
     9	
    10	class VUnit:
    11		var hidden := false
    12		var link := -1
    13		var windup := 0
    14		var guard := 0
    15		var summon := false
    16		var id: int
    17		var team: int
    18		var type: int
    19		var x: int
    20		var y: int
    21		var hp: int
    22		var max_hp: int
    23		var alive: bool
    24		var stealth: int
    25		var stun: int
    26		var shield := 0
    27		var haste_t := 0
    28		var fx: int
    29		var fy: int
    30		var mx: int
    31		var my: int
    32		var charge: int
    33		var target: int
    34		var breach: int            # 第四輪：被破陣剩幾 tick
    35		var aura: int              # 第四輪：在鼓手光環內
    36		var bmode: int             # 第四輪：投彈兵模式
    37	
    38	var units: Array = []          # 跟 sim.units 同順序
    39	var tick := 0
    40	var rally := [false, false]
    41	var frenzy := false
    42	var events: Array = []         # 這一格（畫面上剛發生）的事件
    43	var finished := false          # 畫面已經播到模擬的最後一 tick
    44	var budget := 100
    45	var budgets := [100, 100]      # 第五輪：兩邊預算（讓子時不同；舊判定時兩格都＝藍方預算）
    46	var max_ticks := 1800          # 第五輪：這一局的長度（一局時間可調）
    47	
    48	func budget_of(t: int) -> int:
    49		return int(budgets[t])
    50	var zones: Array = []
    51	var _power := [0, 0]
    52	var _alive := [0, 0]
    53	var _by_id := {}
    54	var queue: Array = []          # 還沒播的快照（模擬已經跑到、畫面還沒到）
    55	
    56	## 把模擬當下的狀態存成一份快照。
    57	static func capture(sim) -> Dictionary:
    58		var us: Array = []
    59		for u in sim.units:
    60			us.append([u.id, u.team, u.type, u.x, u.y, u.hp, u.max_hp, u.alive, u.stealth, u.stun, u.fx, u.fy, u.mx, u.my, u.charge, u.target, u.breach, u.aura, u.bmode, 1 if u.hidden else 0, u.link, u.windup, u.guard, u.summon, u.shield, u.haste_t])
    61		return {"tick": sim.tick, "units": us, "events": sim.events.duplicate(true), "rally": sim.rally.duplicate(),
    62			"frenzy": sim.frenzy, "finished": sim.finished, "power": [sim.power(0), sim.power(1)],
    63			"alive": [sim.alive_count(0), sim.alive_count(1)], "zones": sim.zones.duplicate()}
    64	
    65	func _init(sim = null) -> void:
    66		if sim != null:
    67			budget = sim.budget
    68			budgets = sim.budgets.duplicate()
    69			max_ticks = sim.max_ticks
    70			apply(capture(sim))
    71			events = []
    72	
    73	func apply(fr: Dictionary) -> void:
    74		var us: Array = fr["units"]
    75		if units.size() != us.size():
    76			units.clear()
    77			_by_id.clear()
    78			for i in us.size():
    79				var v := VUnit.new()
    80				units.append(v)
    81		for i in us.size():
    82			var a: Array = us[i]
    83			var v: VUnit = units[i]
    84			v.id = a[0]; v.team = a[1]; v.type = a[2]; v.x = a[3]; v.y = a[4]; v.hp = a[5]; v.max_hp = a[6]
    85			v.shield = a[a.size() - 2]; v.haste_t = a[a.size() - 1]
    86			v.alive = a[7]; v.stealth = a[8]; v.stun = a[9]; v.fx = a[10]; v.fy = a[11]; v.mx = a[12]; v.my = a[13]
    87			v.charge = a[14]; v.target = a[15]
    88			v.breach = a[16] if a.size() > 16 else 0
    89			v.aura = a[17] if a.size() > 17 else 0
    90			v.bmode = a[18] if a.size() > 18 else 0
    91			v.hidden = a[19] == 1 if a.size() > 19 else false
    92			v.link = a[20] if a.size() > 20 else -1
    93			v.windup = a[21] if a.size() > 21 else 0
    94			v.guard = a[22] if a.size() > 22 else 0
    95			v.summon = a[23] if a.size() > 23 else false
    96			_by_id[v.id] = v
    97		tick = fr["tick"]
    98		events = fr["events"]
    99		rally = fr["rally"]
   100		frenzy = fr["frenzy"]
   101		finished = fr["finished"]
   102		_power = fr["power"]
   103		_alive = fr["alive"]
   104		zones = fr.get("zones", [])
   105	
   106	func power(t: int) -> int:
   107		return _power[t]
   108	
   109	func alive_count(t: int) -> int:
   110		return _alive[t]
   111	
   112	func unit_by_id(id: int):
   113		return _by_id.get(id)
