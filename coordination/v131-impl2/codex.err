   379	## 小石魔、馬、羊落地揚塵。
   380	func _gait_step_fx(u, d: Array) -> void:
   381		if not gait_on.get(u.id, false):
   382			return
   383		var a: float = Gait.phase_of(u.type, d[0], CS, UNIT_SCALE, u.id)
   384		var b: float = Gait.phase_of(u.type, d[1], CS, UNIT_SCALE, u.id)
   385		if int(a / PI) != int(b / PI):
   386			fx.append({"kind": "step", "p": _upos(u), "t": 0.0, "dur": 0.35, "big": u.type == 19})
   387	
   388	## 這一幀要畫的走路相位。
   389	func _walk_of(u, a: float) -> float:
   390		var k: int = Gait.kind(u.type)
   391		if u.stun > 0 or (drag_t.get(u.id, 0.0) > 0.0):
   392			if drag_t.get(u.id, 0.0) > 0.0:
   393				return Gait.POSE_DRAG
   394			return Gait.POSE_DAZE
   395		if k == Gait.ROOT:
   396			return 0.0
   397		if gait_on.get(u.id, false):
   398			var d: Array = gait_d.get(u.id, [0.0, 0.0])
   399			return Gait.phase_of(u.type, lerpf(d[0], d[1], a), CS, UNIT_SCALE, u.id)
   400		if k == Gait.FLOAT:
   401			return 0.0001 + time * 4.0 + u.id * 0.37      # 飄浮的就算停著也在飄
   402		return 0.0
   403	
   404	func _gait_frame(delta: float) -> void:
   405		for id in drag_t.keys():
   406			drag_t[id] -= delta
   407			if drag_t[id] <= 0.0:
   408				drag_t.erase(id)
   409		# V1.3.1 P1：全場只剩最後一隻、而且沒在出手也沒在走時，左右張望（用轉身影格）
   410		var alive := [0, 0]
   411		for u0 in view.units:
   412			if u0.alive:
   413				alive[u0.team] += 1
   414		for u in view.units:
   415			var tgt: float = signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
   416			if u.mx != 0 or u.my != 0 or u.stun > 0 or atk_face.has(u.id) or not idle_since.has(u.id):   # 出手、暈眩也不算站定
   417				idle_since[u.id] = time
   418			if u.alive and alive[u.team] == 1 and not view.finished and time - float(idle_since[u.id]) > 1.5 and not atk_face.has(u.id):
   419				tgt = 1.0 if sin(time * PI / 1.1 + u.id) >= 0.0 else -1.0   # 站定 1.5 秒後才開始張望
   420			var f0: float = float(face_now.get(u.id, tgt))
   421			var f1: float = move_toward(f0, tgt, delta * 11.0)
   422			face_now[u.id] = f1
   423			if f0 != 0.0 and signf(f1) != signf(f0):
   424				turn_t[u.id] = time   # V1.3 A1a：翻面那一刻（腳下揚塵、展開回彈從這裡算）
   425	
   426	## 轉身過場（V1.3 A1a）：像厚木牌俐落翻面，不是紙片等比夾扁。
   427	## 寬度不低於 TURN_MIN_W（窄位直接跳過去），展開段 X 微回彈 1.04；不做 Y 下壓（混戰時會像受擊）。
   428	const TURN_MIN_W := 0.45
   429	const TURN_BOUNCE := 0.04
   430	func _face_of(u) -> float:
   431		var f: float = face_now.get(u.id, signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0))
   432		var a := absf(f)
   433		if a < 0.9 and sprites != null and sprites.has_turn(u.type):
   434			# 有轉身影格的兵：傳原本的朝向，貼圖端選中間姿勢（不能是 0，退回直接繪製時才不會消失）
   435			return maxf(a, 0.18) * (1.0 if f >= 0.0 else -1.0)
