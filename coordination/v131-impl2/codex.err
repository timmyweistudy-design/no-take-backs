    57	## 前搖到底的後仰角（勝利姿勢用來抵銷，站直）。
    58	static func windup_lean(type: int) -> float:
    59		return float(POSE_PROFILE[type][2]) if POSE_PROFILE.has(type) else LEAN_BACK
    60	
    61	static func _pose_prof(atk: float, f: Array) -> Array:
    62		if atk < ATK_WINDUP:
    63			var e := _smooth(atk / ATK_WINDUP)
    64			return [-e, -f[2] * e, lerpf(1.0, f[0], e), lerpf(1.0, f[1], e), f[3] * e]
    65		if atk < ATK_STRIKE:
    66			var u := (atk - ATK_WINDUP) / (ATK_STRIKE - ATK_WINDUP)
    67			var e2 := 1.0 - (1.0 - u) * (1.0 - u)
    68			return [lerpf(-1.0, 1.0, e2), lerpf(-f[2], f[6], e2), lerpf(f[0], f[4], e2), lerpf(f[1], f[5], e2), lerpf(f[3], f[7], e2)]
    69		var r := (atk - ATK_STRIKE) / (1.0 - ATK_STRIKE)
    70		var e3 := _smooth(clampf((r - f[8]) / (1.0 - f[8]), 0.0, 1.0))   # 先停在命中姿勢 f[8]，再收回
    71		return [lerpf(1.0, 0.0, e3), lerpf(f[6], 0.0, e3), lerpf(f[4], 1.0, e3), lerpf(f[5], 1.0, e3), lerpf(f[7], 0.0, e3)]
    72	
    73	
    74	## 角色的局部座標轉換（以腳底為原點、face＝+1 畫）：呼吸／走路起伏、前撲、傾身、壓扁拉長、翻面。
    75	## lean＝額外傾角（騎兵衝鋒前傾）、crouch＝縱向縮放（刺客潛行蹲身）。
    76	static func unit_xf(p: Vector2, face: float, walk: float, atk: float, t: float, scale := 1.0, lean := 0.0, crouch := 1.0, gtype := 0) -> Transform2D:
    77		# 外層（位置、起伏、翻面、縮放、額外傾身／蹲身）× 內層（攻擊姿勢，face＝+1 空間）。
    78		# 精靈圖快取烘焙的是內層，貼圖時套外層，所以兩條路的順序完全一樣（Codex R5 #3）。
    79		var ps := pose(atk, gtype)
    80		var bob := idle_bob(t, p) if walk == 0.0 else -Gait.air(gtype, walk)
    81		var outer := Transform2D(lean * face, Vector2(scale * face, scale * crouch), 0.0, p + Vector2(0, bob * scale))
    82		return outer * Transform2D(ps[1], Vector2(ps[2], ps[3]), 0.0, Vector2(ps[4], 0))
    83	
    84	
    85	## 單位：p＝腳底；face＝±1；walk＝走路相位（0＝沒走）；atk＝攻擊動作進度 0～1（見上）；hurt＝受擊閃白 0～1；
    86	## alpha＝透明度（潛行）；t＝時間（待機呼吸）；scale＝縮放；mood＝表情疊加（M_*）；lean／crouch 見 unit_xf。
    87	static func unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
    88			hurt: float, alpha: float, t: float, scale := 1.0, cb := false, mood := 0, lean := 0.0, crouch := 1.0, variant := 0) -> void:
    89		var tc := team_color(team, cb)
    90		_team_now = team
    91		var w: float = pose(atk, type)[0]
    92		if atk > 0.0:
    93			walk = 0.0   # 和精靈圖一致：攻擊格沒有走路相位
    94		_xf = base * unit_xf(p, face, walk, atk, t, scale, lean, crouch, type)
    95		_b_now = Transform2D.IDENTITY
    96		if turn_c < 1.0:
    97			_xf0 = _xf
    98			# 史萊姆轉向鏡頭時微微拉高（Antigravity v130-impl1：只有眼睛動看不出在轉）
    99			var sy := 1.0 + 0.06 * (1.0 - turn_c) if type == 13 else 1.0
   100			_xf = _xf * Transform2D(0.0, Vector2(turn_body_w(type) * (0.97 if type == 13 else 1.0), sy), 0.0, Vector2.ZERO)
   101		_cur_xf = _xf
   102		ci.draw_set_transform_matrix(_xf)
   103		# 以 face＝+1 畫（水平鏡像由 transform 處理）
   104		if type == D.CAVALRY:
   105			_cavalry(ci, tc, walk, w, alpha, t, atk > 0.0 and not calm)
   106		elif type >= D.COUNT:
   107			_fantasy(ci, type, tc, walk, w, alpha, t, atk > 0.0 and not calm, variant)
   108		else:
   109			_infantry(ci, type, tc, walk, w, alpha, t, atk > 0.0 and not calm, variant)
   110		if hurt > 0.0:
   111			# 受擊閃白：在身體位置疊一層白
   112			ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, true)
   113		if mood != 0:
   114			overlay(ci, type, team, mood, alpha, t, cb)
   115		ci.draw_set_transform_matrix(base)
