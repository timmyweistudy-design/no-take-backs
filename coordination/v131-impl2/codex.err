   355	
   356	
   357	static func _f_skeleton(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
   358		var bone := Color("#ece6d6")
   359		var ft: Array = Gait.feet(21, walk)
   360		var bx: Transform2D = _atk_xf(Gait.body_xf(21, walk), w, 0.08, 4.0)
   361		_line(ci, Vector2(-4, -10 + bx.origin.y), Vector2(-4 + ft[0], -2 - ft[1]), bone, 2.2, a)
   362		_line(ci, Vector2(4, -10 + bx.origin.y), Vector2(4 + ft[2], -2 - ft[3]), bone, 2.2, a)
   363		_push_body(ci, bx)
   364		_poly(ci, PackedVector2Array([Vector2(-8, -24), Vector2(8, -24), Vector2(7, -11), Vector2(-7, -11)]), tc, a)
   365		for k in 2:
   366			ci.draw_line(Vector2(-5, -21 + k * 4.0), Vector2(5, -21 + k * 4.0), Color(bone, a), 1.6, true)
   367		_part_at(ci, 1.0)   # V1.3.1：頭骨不壓扁
   368		_c(ci, Vector2(1, -33), 9.5, Color("#f5f0e0"), a)
   369		for ex in [-2.5, 5.0]:
   370			ci.draw_circle(Vector2(ex, -33), 2.6, Color(OUT, a), true, -1.0, true)
   371		ci.draw_line(Vector2(-1, -27), Vector2(5, -27), Color(OUT, a), 1.2, true)
   372		var ang: float = -1.0 + (w * 0.5 if w < 0.0 else w * 1.4) + Gait.swing(21, walk) * 1.6
   373		var hand := Vector2(8, -18)
   374		_part(ci, -4.0, 1.0)   # 骨刀在近側
   375		_line(ci, hand, hand + Vector2(cos(ang), sin(ang)) * 16.0, bone, 2.6, a)
   376		_c(ci, hand + Vector2(cos(ang), sin(ang)) * 17.0, 3.0, bone, a)
   377		_part_end(ci)

