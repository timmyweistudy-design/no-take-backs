   299		if mood != 0:
   300			# 表情疊加（Codex v131-impl1：走路轉身、小動作原本漏畫）；轉身格的臉依 oc 往中間移
   301			ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, sg * oc, 0.0, 0.0, t, scale, lean, crouch, type))
   302			Art.overlay(ci, type, team, mood, alpha, t, cb)
   303		ci.draw_set_transform_matrix(Art.base)
