   186	static func _f_doll(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
   187		var ft: Array = Gait.feet(15, walk)
   188		var bx: Transform2D = Gait.body_xf(15, walk)
   189		_line(ci, Vector2(-5, -11 + bx.origin.y), Vector2(-5 + ft[0], -2 - ft[1]), Color("#c9a26b"), 3.2, a)
   190		_line(ci, Vector2(5, -11 + bx.origin.y), Vector2(5 + ft[2], -2 - ft[3]), Color("#c9a26b"), 3.2, a)
   191		_push_body(ci, bx)
   192		var sway: float = Gait.swing(15, walk)
   193		# 隊伍色布身，粗縫線
   194		var body := PackedVector2Array([Vector2(-11, -8), Vector2(-13, -24), Vector2(13, -24), Vector2(11, -8)])
   195		_poly(ci, body, tc, a)
   195		_poly(ci, body, tc, a)
   196		for k in 3:
   197			var y := -21.0 + k * 5.0
   198			ci.draw_line(Vector2(-3, y), Vector2(3, y + 2.2), Color(OUT, 0.8 * a), 1.5, true)
   199			ci.draw_line(Vector2(3, y), Vector2(-3, y + 2.2), Color(OUT, 0.8 * a), 1.5, true)
   200		_part(ci, 4.0, 0.6)   # V1.3.1：遠側手
   201		_line(ci, Vector2(-12, -21), Vector2(-17 - sway * 12.0, -15 - w * 5.0 + sway * 6.0), tc.darkened(0.15), 3.2, a)
   202		_part(ci, -4.0, 0.6)  # 近側手
   203		_line(ci, Vector2(12, -21), Vector2(18 + sway * 12.0, -15 + w * -5.0 + sway * 6.0), tc.darkened(0.15), 3.2, a)
   204		# 麻布頭、一邊大鈕扣、一邊 X
   205		_part(ci, 0.0, 0.0)   # 圓頭不壓扁
   206		_c(ci, Vector2(0, -35), 12.5, Color("#e8d3a8"), a)
   207		_c(ci, Vector2(6, -35), 4.6, tc.lightened(0.3), a)
   208		ci.draw_circle(Vector2(5, -36), 1.1, Color(OUT, a), true, -1.0, true)
   209		ci.draw_circle(Vector2(7.5, -34), 1.1, Color(OUT, a), true, -1.0, true)
   210		ci.draw_line(Vector2(-8, -38), Vector2(-3, -33), Color(OUT, a), 2.0, true)
   211		ci.draw_line(Vector2(-3, -38), Vector2(-8, -33), Color(OUT, a), 2.0, true)
   212		ci.draw_line(Vector2(-4, -28), Vector2(5, -28), Color(OUT, a), 1.5, true)
   213		# 頭上插一根大針（招牌）
   214		var nd := sway * 14.0
   215		_part(ci, 3.0, 0.8)   # 頭上的針往後斜（遠側）
   216		_line(ci, Vector2(-3, -40), Vector2(-11 - nd, -54), STEEL, 1.8, a)
   217		_c(ci, Vector2(-12 - nd, -56), 3.4, Color("#ff4d6d"), a)
   218		_part_end(ci)
   219	
