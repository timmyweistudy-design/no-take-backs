   190	
   191	## 腳底隊伍標記：藍＝圓、紅＝菱形（色盲也分得出）；重兵（盾、騎）外框加粗。
   192	## V1.3 A3：腳底三層，由下往上：厚木座（棋子底座，留在地上）→ 接觸影子（跳起來會縮）→ 隊伍圈。
   193	## air＝離地程度 0～1（只縮影子）。
   194	static func ring(ci: CanvasItem, p: Vector2, team: int, type: int, cb := false, scale := 1.0, air := 0.0) -> void:
   195		ring_base(ci, p, scale)
   196		ring_shadow(ci, p, scale * (1.0 - air * 0.35))
   197		ring_mark(ci, p, team, type, cb, scale)
   198	
   199	## 厚木座：下緣 2.5px 深色厚度、頂面木色、上緣 1px 亮倒角（深色地面也看得出邊）。
   200	static func ring_base(ci: CanvasItem, p: Vector2, scale := 1.0, a := 1.0) -> void:
   201		# 比隊伍圈寬一圈（rx 21），外露的木邊看得出是棋子底座（Antigravity v130-impl1：原本被隊伍圈蓋住）
   202		ci.draw_colored_polygon(_ell(p + Vector2(0, 3.2) * scale, 21.0 * scale, 10.5 * scale), Color(0.30, 0.20, 0.12, 0.85 * a))
   203		ci.draw_colored_polygon(_ell(p, 21.0 * scale, 10.5 * scale), Color(0.56, 0.41, 0.26, 0.92 * a))
   204		ci.draw_colored_polygon(_ell(p + Vector2(0, 0.6) * scale, 15.5 * scale, 7.4 * scale), Color(0.62, 0.47, 0.30, 0.6 * a))
   205		ci.draw_arc(p + Vector2(0, -0.2) * scale, 20.4 * scale, PI * 1.08, PI * 1.92, 14, Color(1.0, 0.9, 0.7, 0.5 * a), 1.1 * scale, true)
   206	
   207	## 接觸影子（角色腳下）。
   208	static func ring_shadow(ci: CanvasItem, p: Vector2, scale := 1.0) -> void:
   209		ci.draw_colored_polygon(_ell(p + Vector2(0, 0.5) * scale, 12.0 * scale, 5.6 * scale), Color(0.08, 0.05, 0.03, 0.34))
   210	
   211	static func ring_mark(ci: CanvasItem, p: Vector2, team: int, type: int, cb := false, scale := 1.0) -> void:
   212		var tc := team_color(team, cb)
   213		var w := 4.0 if (type == D.SHIELD or type == D.CAVALRY or type == 19) else 3.0   # 第七輪 C2：腳底圈加粗
   214		var pts := PackedVector2Array()
   215		if team == 0:
   216			for i in 25:
   217				var ang := i * TAU / 24.0
   218				pts.append(p + Vector2(cos(ang) * 15.0, sin(ang) * 7.5) * scale)
   219		else:
   220			pts = PackedVector2Array([p + Vector2(-16, 0) * scale, p + Vector2(0, -8.5) * scale, p + Vector2(16, 0) * scale, p + Vector2(0, 8.5) * scale, p + Vector2(-16, 0) * scale])
   221		ci.draw_polyline(pts, OUT, w + (6.5 if cb else 2.5), true)   # 第十輪 V9：色盲配色黑邊加粗，黃底座在沙地、草地才分得開
   222		ci.draw_polyline(pts, tc, w, true)
   223	
   224	
   225	## 頭頂小旗（8×10）。
   226	static func flag(ci: CanvasItem, p: Vector2, team: int, cb := false) -> void:
   227		var tc := team_color(team, cb)
   228		ci.draw_line(p, p + Vector2(0, -12), OUT, 2.0, true)
   229		var pts := PackedVector2Array([p + Vector2(0, -12), p + Vector2(9, -9), p + Vector2(0, -5)])
   230		ci.draw_colored_polygon(pts, tc)
   231	
   232	
   233	## 小靈魂（死亡演出）。
   234	static func soul(ci: CanvasItem, p: Vector2, a: float) -> void:
   235		ci.draw_circle(p, 7.5, Color(0.86, 0.95, 1.0, a), true, -1.0, true)
   236		ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-7, 0), p + Vector2(7, 0), p + Vector2(3, 10), p + Vector2(0, 7), p + Vector2(-3, 10)]), Color(0.86, 0.95, 1.0, a))
   237		ci.draw_circle(p + Vector2(-2.5, -1), 1.3, Color(0.15, 0.15, 0.25, a), true, -1.0, true)
   238		ci.draw_circle(p + Vector2(2.5, -1), 1.3, Color(0.15, 0.15, 0.25, a), true, -1.0, true)
   239	
   240	
   300		# 大頭＋貓耳
   301		var hy := -33.0
   302		_part(ci, 0.0, 0.0)   # 頭與耳朵不壓扁
   303		for s in [-1.0, 1.0]:
   304			_poly(ci, PackedVector2Array([Vector2(s * 3.5, hy - 11), Vector2(s * 13, hy - 8), Vector2(s * 11, hy - 21)]), tc, a)
   305		_c(ci, Vector2(0, hy), 12.0, tc.lightened(0.3), a)
   306		_eyes(ci, Vector2(3.0, hy), a, t, angry)
   307		for s2 in [-1.0, 1.0]:
   308			ci.draw_line(Vector2(s2 * 9 + 2, hy + 4), Vector2(s2 * 16 + 2, hy + 3), Color(OUT, 0.7 * a), 1.0, true)
   309		# 吸管與吸頭
   310		var aim: float = -0.1 - w * 0.25 - (0.5 if variant == 2 else 0.0) + Gait.swing(18, walk)
   311		var nz := Vector2(10, -14) + Vector2(cos(aim), sin(aim)) * 13.0
   312		_part(ci, -4.0, 1.0)   # 吸嘴在近側，轉正時透視縮短
   313		_line(ci, Vector2(-6, -18), Vector2(8, -13), Color("#55606f"), 2.6, a)
   314		_line(ci, Vector2(8, -13), nz, Color("#9aa4b4"), 3.0, a)
   315		_poly(ci, PackedVector2Array([nz + Vector2(0, -3), nz + Vector2(9, -7), nz + Vector2(9, 7), nz + Vector2(0, 3)]), STEEL, a)
   316		_part_end(ci)
