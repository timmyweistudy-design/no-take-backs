     1	#!/usr/bin/env bash
     2	# 版面檢查（第三輪 T4）：用 Windows 版 Godot 跑截圖模式，兩種語言 × 三種字級，彙整 layout.jsonl。
     3	# 用法：tools/layout_check.sh <Godot 執行檔> <輸出資料夾（WSL 路徑）>
     4	set -uo pipefail
     5	cd "$(dirname "$0")/.."
     6	EXE="$1"; OUT="$2"
     7	# 第七輪 I5：只准清自己產生的輸出夾（有記號檔），或空資料夾；其他一律拒絕，不再無條件 rm -rf
     8	MARK=".ntb-layout-output"
     9	if [ -d "$OUT" ] && [ -n "$(ls -A "$OUT" 2>/dev/null)" ]; then
    10	  if [ ! -f "$OUT/$MARK" ]; then
    11	    echo "LAYOUT FAIL：$OUT 已有內容但不是版面檢查的輸出夾，不會刪除。請換一個新資料夾。"; exit 2
    12	  fi
    13	  rm -rf "$OUT"
    14	fi
    15	mkdir -p "$OUT"; : > "$OUT/$MARK"
    16	# Windows／WSL／Linux 都能跑：有 wslpath 才轉路徑
    17	winpath() { if command -v wslpath >/dev/null 2>&1 && [[ "$EXE" == *.exe ]]; then wslpath -w "$1"; else printf '%s' "$1"; fi; }
    18	# WSL 的 timeout 只殺得到包裝程序，Windows 上的視窗會留著繼續跑：逾時要連它一起關（只關這次輸出夾的）
    19	kill_win() { if [[ "$EXE" == *.exe ]]; then powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name like 'Godot%'\" | Where-Object { \$_.CommandLine -like '*--shot=$(winpath "$1")*' } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force }" >/dev/null 2>&1; fi; }
    20	# 第九輪 P0：LAYOUT_QUICK=1 只跑中文 100%＋英文 150%（最容易出事的兩組）＋一組狀態；里程碑跑 8 組
    21	# V1.2.1：第三欄是狀態（plain＝簡化介面、cb＝色盲、pad＝手把焦點），固定在這組全部截圖
    22	# 完整：兩語 × 三字級，加上四種狀態（簡化、色盲、手把、停用）各在兩語的 150%（最容易擠）各跑一次＝14 組
    23	# V1.4 #17：加簡中、日文各 100％／150％（共 18 組）；快速版多跑日文 150％
    24	COMBOS="zh_TW:100 zh_TW:125 zh_TW:150 en:100 en:125 en:150 zh_TW:150:plain en:150:plain zh_TW:150:cb en:150:cb zh_TW:150:pad en:150:pad zh_TW:150:dis en:150:dis zh_CN:100 zh_CN:125 zh_CN:150 ja:100 ja:125 ja:150 ja:150:plain,cb,pad zh_TW:100:plain,cb,pad en:125:plain,cb,pad en:100:dis"   # 1.1.0 B9：狀態組合補 100％／125％（共 24 組）
    25	[ "${LAYOUT_QUICK:-0}" = "1" ] && COMBOS="zh_TW:100 en:150 en:150:plain,cb,pad zh_TW:150:dis ja:150"
    26	[ -n "${LAYOUT_COMBOS:-}" ] && COMBOS="$LAYOUT_COMBOS"   # 只重跑指定組（修版面時用）
    27	export LAYOUT_N=$(echo $COMBOS | wc -w)
    28	# 1.2.0 §14.5：LAYOUT_JOBS=N 平行跑 N 組（各組本來就是獨立行程）；預設 1（量過一致才調高，見 coordination/v120-impl）
    29	JOBS=${LAYOUT_JOBS:-2}   # 1.2.0：同一 commit 1 工 vs 2 工 350 張畫面 ID 與違規完全一致、399→223 秒
    30	FAILS="$OUT/.fails"; : > "$FAILS"
    31	run_combo() {
    32	  local combo=$1 lang sc st d
    33	  IFS=: read -r lang sc st <<< "$combo"
    34	  d="$OUT/${lang}_${sc}${st:+_${st//,/-}}"; mkdir -p "$d"
    35	  timeout 600 "$EXE" --path "$(winpath .)" --resolution 1280x800 -- --shot="$(winpath "$d")" --shot-lang=$lang --shot-text=$sc ${st:+--shot-state=$st} ${LAYOUT_SHOTS:+--shot-only=$LAYOUT_SHOTS} ${LAYOUT_FIXED:+--shot-fixed} --shot-prefix="shot_${lang}_${sc}${st:+_${st//,/-}}__" --layout-check > "$d/run.log" 2>&1 \
    36	    || { echo "LAYOUT FAIL：$lang $sc% 截圖程式 exit 非 0" >> "$FAILS"; kill_win "$d"; return; }
    37	  grep -E "SCRIPT ERROR|Parse Error" "$d/run.log" >/dev/null && { echo "LAYOUT FAIL：$lang $sc% 有腳本錯誤" >> "$FAILS"; return; }
    38	  grep -q "^SHOTFAIL" "$d/run.log" && { echo "LAYOUT FAIL：$lang $sc% 截圖存檔失敗：$(grep SHOTFAIL "$d/run.log" | head -3 | tr '\n' ' ')" >> "$FAILS"; return; }
    39	  grep -q "PADWALK OK" "$d/run.log" || echo "LAYOUT FAIL：$lang $sc% 手把流程：$(grep PADWALK "$d/run.log" | cut -c1-400)" >> "$FAILS"
    40	}
    41	for combo in $COMBOS; do
    42	  while [ "$(jobs -rp | wc -l)" -ge "$JOBS" ]; do wait -n; done
    43	  run_combo "$combo" &
    44	done
    45	wait
    46	if [ -s "$FAILS" ]; then cat "$FAILS"; exit 1; fi
    47	EXPECT=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | wc -l)
    48	NAMES=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | sed 's/_snap("//; s/")//' | sort | tr '\n' ',')
    49	# 1.2.0 §14.4：LAYOUT_SHOTS=a.png,b.png 只存、只檢查這些畫面（流程照跑）；開發中快速看用，每日與發版一律全量
    50	if [ -n "${LAYOUT_SHOTS:-}" ]; then NAMES="$LAYOUT_SHOTS,"; EXPECT=$(echo "$LAYOUT_SHOTS" | tr ',' '\n' | grep -c .); fi
    51	# 1.2.0 §14.4：畫面狀態清冊（tools/screens.json）要和 dev_main 的截圖清單完全一致（新畫面一定要登記入口與狀態）
    52	python3 - "$(grep -o '_snap("[^"]*")' tools/dev_main.gd | sed 's/_snap("//; s/")//' | sort | tr '\n' ',')" <<'PY' || exit 1
    53	import json, sys
    54	names = {x for x in sys.argv[1].split(',') if x}
    55	reg = json.load(open('tools/screens.json', encoding='utf-8'))
    56	miss = sorted(names - set(reg)); extra = sorted(set(reg) - names)
    57	if miss or extra:
    58	    print('LAYOUT FAIL：畫面清冊 tools/screens.json 和截圖清單不一致（沒登記 %s、多登記 %s）' % (miss, extra)); sys.exit(1)
    59	bad = [k for k, v in reg.items() if not v.get('entry') or not isinstance(v.get('states'), list)]
    60	if bad:
    61	    print('LAYOUT FAIL：清冊缺入口或狀態：%s' % bad[:10]); sys.exit(1)
    62	PY
    63	python3 - "$OUT" "$EXPECT" "$NAMES" <<'PY'
    64	import json,sys,glob,os
    65	out=sys.argv[1]; expect=int(sys.argv[2]); names=set(x for x in sys.argv[3].split(',') if x); total=0; rows=[]
    66	for f in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    67	    for line in open(f,encoding='utf-8'):
    68	        d=json.loads(line); total+=len(d['violations']); rows.append(d)
    69	warns=sum(len(d.get('warnings',[])) for d in rows)
    70	# 第五輪：每組都要剛好是 dev_main.gd 列出的那些畫面（不能用重複畫面湊張數）
    71	for f2 in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
