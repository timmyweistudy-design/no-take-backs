   315		var out := await _post_tex(src.get_texture(), src.size, per)
   316		src.queue_free()
   317		return out
   318	
   319	## V1.2 D1：烘好的整頁再跑一次後處理 shader（外輪廓＋頂亮底暗）。
   320	func _post_tex(tex: Texture2D, size: Vector2i, per: int) -> Image:
   321		var tr := TextureRect.new()
   322		tr.texture = tex
   323		tr.size = Vector2(size)
   324		var mat := ShaderMaterial.new()
   325		mat.shader = load("res://shaders/unit_bake.gdshader")
   326		mat.set_shader_parameter("cell", float(CELL))
   327		mat.set_shader_parameter("per", float(per))
   328		mat.set_shader_parameter("cols", float(COLS))
   329		mat.set_shader_parameter("sh_amt", float(Art.WASH[clampi(int(Art.paint[2]), 0, 2)]))   # V1.4 #15 漬洗
   330		mat.set_shader_parameter("hi_amt", float(Art.DRY[clampi(int(Art.paint[3]), 0, 2)]))    # 乾掃
   331		tr.material = mat
   332		var vp := _viewport(size, tr)
   333		await RenderingServer.frame_post_draw
   334		await RenderingServer.frame_post_draw
   335		var out := vp.get_texture().get_image()
   336		vp.queue_free()
   337		return out
   338	
   339	func _bake_ring(cb: bool) -> void:
   340		var painter := _RingPainter.new()
   341		painter.cb = cb
   342		var vp := _viewport(Vector2i(15 * CELL, CELL), painter)   # 1.3.0：第 15 格＝紅方八角木座（跳起來分層畫時用）   # V1.3 A3：4 種隊伍圈＋木座＋影子＋4 種合成（木座＋影子＋圈）；1.1.0 B14：合成再分王國／奇幻（底座部件烘進去）
   343		var g0 := _gen
   344		await RenderingServer.frame_post_draw
   345		await RenderingServer.frame_post_draw
   346		if g0 == _gen:
   347			ring_tex = ImageTexture.create_from_image(vp.get_texture().get_image())
   348		vp.queue_free()
   349	
   350	## variant 1（劍士交替招式）和 2（第四輪新兵的專屬動作）都用第二組攻擊格：新兵沒有交替招式，那一組烘的是專屬動作。
   351	func frame_index(type: int, team: int, walk: float, atk: float, t: float, px: float, variant := 0) -> int:
   352		var base: int = int(loc[type][1]) + team * FRAMES_PER
   353		if atk > 0.0:
   354			return base + 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * mini(variant, 1) + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
   355		if walk <= Gait.POSE_DAZE + 1.0:
   356			return base + 2 + WALK_FRAMES + 1
   357		if walk <= Gait.POSE_DRAG + 1.0:
   358			return base + 2 + WALK_FRAMES
   359		if walk != 0.0:
   360			return base + 2 + int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES
   361		var ex := 2.0 if type == D.CAVALRY else 3.5   # Art._eyes 的眼睛中心 x
   362		var blink := fmod(t + ex * 0.13 + fposmod(px * 0.731, 3.7), 3.7) <= 0.12   # V1.3 A2：依位置錯開，同種兵不再一起眨眼
   363		return base + (1 if blink else 0)
   364	
   365	func draw_ring(ci: CanvasItem, p: Vector2, team: int, type: int, scale := 1.0, air := 0.0) -> void:
   366		var idx := team * 2 + (1 if (type == D.SHIELD or type == D.CAVALRY or type == 19) else 0)
   367		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
   368		if air <= 0.0:
   369			# 站在地上（絕大多數）：一次貼好預先合成的三層（效能：每隻 1 次貼圖，不是 3 次）
   370			var fan := 4 if type >= D.COUNT else 0   # 1.1.0 B14：奇幻兵用樹皮部件那一組合成格
   371			ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2((6 + fan + idx) * CELL, 0, CELL, CELL))
   372			ci.draw_set_transform_matrix(Art.base)
   373			return
   374		ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2((14 if team == 1 else 4) * CELL, 0, CELL, CELL))   # 木座（紅方八角）
   375		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale, scale), 0.0, p))
   376		Art.base_trim(ci, Vector2.ZERO, type, 1.0)   # 1.1.0 B14：跳起來（少數）才分層畫部件
   377		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
   378		if air > 0.0:
   379			var ss := scale * (1.0 - air * 0.35)
   380			ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(ss / RS, ss / RS), 0.0, p))
   381		ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2(5 * CELL, 0, CELL, CELL))   # 影子（跳起來縮）
   382		if air > 0.0:
   383			ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
   384		ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2(idx * CELL, 0, CELL, CELL))
   385		ci.draw_set_transform_matrix(Art.base)
   386	
   387	## V1.3.1：史萊姆高光不烘進圖集，貼圖後固定畫在世界的左上（翻面不跳邊）。
   388	static func slime_shine(ci: CanvasItem, p: Vector2, type: int, scale: float, alpha: float, bob: float) -> void:
   389		if type != 13 and type != 20:
   390			return
   158	- 剪影：投彈兵肩桶、骷髏法師書前探＋兜帽尖、大史萊姆王冠、刺客雙燕尾、狂戰士待機 V 斧。史萊姆高光不烘進圖集，貼圖後畫在世界左上。
   159	- 圖鑑大圖：點角色轉一圈＋小動作（`codex_view.gd` `_cx_portrait`）。
   160	- 收尾效果：每種兵出手／倒下音高不同（`sfx.gd` `UNIT_PITCH`，0.82～1.25＋±5%）；最後一擊定格 0.2 秒後勝方從中線往後排波浪歡呼（每格 0.06 秒）；巫毒娃娃的針、骷髏頭骨、寶箱金幣倒下時落地（`_draw_relic`，同畫面最多 4 組）；孢子菇、投彈兵火罐、沙漏玻璃的高光在正上方。擊倒者用「目標最後被誰打」推算（模擬的死亡事件不帶擊倒者）。
   161	- 角色：握持三層（`_grip`、`_fist`）；人形 9 種有背面（`Art.back`、`BACK_OK`：不畫五官、後腦勺、背後物件畫在身上、近遠側互換）。圖鑑固定縮放 `CX_FIT`；檢視控制：左右轉（人形 16 格一整圈、其他 9 格半圈）、0.25 倍慢動作（`cx_clock` 累積）、出手一次含飛行物。驗收圖 `tools/unit_review.gd` → `docs/review/v150/units/`。
   162	- 角色：22 種都有背面（`Art.BACK_OK` 全部）。戰場轉身中出手用轉身攻擊格（`SpriteCache.ensure_turn_atk`：1 個中繼角 0.55 ×（一般＋交替）8 格 × 兩隊，只烘本局兵種、上限 10 種、重烘自動補回）；轉身插值用畫面 tick。
   163	- 圖鑑：大圖與近看用 `codex_bake.gd`（向量→`unit_bake.gdshader`，著色器 `y_off` 只給圖鑑）；近看模式（假人靶、逐格、0.25 倍、放大、一般／特殊）；召喚物分頁；小劇場走展示緩衝（遠程命中前射出）。
   164	- AI 人設：6 種性格的名號、頭像、開場／輸贏台詞（`v16_persona.gd`），首領與宿敵嗆聲。熟練度（`mastery`，5 級）顯示在圖鑑，3 級起兵卡有星章。
   165	- 熟練度：兵卡外框（3、4 級銀、5 級金）、圖鑑大圖腳下木牌（等級＋戰功章 3 個：出場 20、擊倒 50、MVP 5，`medals`）、戰場只有標記的兵腳下畫星。
   166	- **V1.0.0 剪影辨識**：`tools/dev_main.gd --sil=`＋`tools/gen/sil_report.py` 量 22 種兵 50% 大小的輪廓相似度；最難分的 5 種（孢子菇、幽靈、投彈兵、盾兵、史萊姆）補事件表現：幽靈移動時身後淡煙、孢子毒改濁紫（綠留給補血）、投彈兵落點焦痕 0.25 秒；盾兵擋箭漣漪、嘲諷腳底弧、史萊姆分裂「啵」原本就有。其餘 17 種的逐兵表見 V1.0.0 方案 §3（P2，未做）。
   167	- **1.1.0**：劍士反擊木屑（`chips`）、醫者被補者腳下藥膏環（`healring`）、巫毒分傷線改暗紅（紫留給毒）。其餘方案 §5 表現多數原本就有（逐兵盤點見 `coordination/v110-impl/ledger.md`）。
   168	- **1.2.0**：攻擊姿勢 22 種全部走資料（`data/poses/*.json`，`tools/gen/pose_gen.py` 由 POSE_PROFILE 產生，`scripts/ui/pose_files.gd`；hit 事件＝ATK_STRIKE，演出不延後）；落子壓扁回彈、不倒翁搖、倒下連座離地；待機與歡呼定格 1/12 秒（設定「平滑動作」可關）；王國上發條、奇幻呼吸；圖鑑表情輪播；棋子上漆高光與磨損烘焙。
   169	
   170	## 介面材質與排版
   171	- 字型：`fonts/NTBRounded-{R,B}-sub.otf`（源泉圓體 TW，中文）＋`fonts/NTBLatin-{M,B}-sub.ttf`（Fredoka，英數主字型，中文落到後備；0～9 等寬置中）；ThenKhung 只給粗體 ≥H2 標題。來源字型在 `build/fontsrc`，`tools/gen/build_font.py` 重建。
   172	- 文字：深焦茶描邊（3／4／5px 依字級）＋下方陰影；深色字（含紙上墨色字）不描邊、改淺浮雕。`_ink_mode` 時淺色字自動轉墨色、彩色字壓暗，`_btn` 內固定白字。
   173	- 材質：`art/ui/` 木紋、凹槽、羊皮紙、銅釘木框、暈影、游標由 `tools/gen/gen_ui_tex.py` 生成（雜訊非決定性，重跑會變檔）。`_box` 對夠大夠實的方塊畫染色木紋；面板、戰場、大廳預覽有木框；大廳左欄、圖鑑左欄是羊皮紙頁；結果頁勝負字墊隊色緞帶。
   174	- 兵：圖集烘焙後跑 `shaders/unit_bake.gdshader`（隊伍墨色外輪廓、頂亮底暗）；縮放 >1.4 倍改向量直畫＋木底座。換色重烘有世代保護。
   175	- 設定 `plain_ui`（預設 false）：關掉材質、緞帶、紙頁、外輪廓烘焙、暈影等，回到 V1.1 平面介面。
   176	- 大廳是攤開的雙頁筆記（木書殼、兩頁羊皮紙、書脊、紅書籤）；戰報條是深木槽＋隊色小章（藍圓、紅菱）；圖示 Q 版厚塗（`Icons.force` 畫剪影）。
   177	- 地塊烘焙（`map_art.gd`）含手繪筆觸、邊緣裝飾、紙紋 5% 與調色（`shaders/grade_bake.gdshader`）；快取分簡化介面與否兩份。亮的特效墊放射柔光。
   178	- 文字：次要字用不透明暖灰 `TXT_DIM`；彩色小字在 `_text` 自動提亮（對描邊 5:1）；紙上墨字至少 85% 不透明。
   179	- 按鈕：懸停與手把焦點同一樣式（深邊＋金亮邊）、按下內陰影；`btn_paper` 畫紙面，`last_btn_paper`／`last_btn_enabled` 給呼叫端決定卡片內文字。
   180	- 版面檢查（`tools/dev_main.gd`）：文字對比用截圖取樣（反鋸齒排除、透明度合成、描邊三種比法取最好、背景未知必敗、停用另報）；九宮格依材質登記的斜邊內距（木紋上 3／下 4／左右 3、紙 5、凹槽 3）檢查字形框；缺圖算違規；狀態 `--shot-state=plain,cb,pad,dis`。
   181	- 規則：`docs/ui-layout-rules.md`（間距階 4／8／12／16／24／32／48＝`GAP_XS`～`GAP_XL`；R1 模態面板置中、R2 緞帶下距 ≥16、R3 依附裝飾貼齊、R4 底部按鈕群組、R6 留白、R7 副標置中、R8 不出面板／不跨欄／焦點框在畫面內、R9 文字到按鈕、R10 同欄中線、G 漏登記守衛）。例外：`docs/ui-layout-exceptions.md`（4 條）。
   182	- 偵測器：`scripts/ui/layout_rules.gd`（純矩形）；`_panel`／`probe_panel`、`_h1` 自動登記，`probe_deco`、`probe_columns`、`probe_align`、`probe_axis`、`probe_skip` 由畫面宣告；`tools/dev_main.gd` 的 `layout_geom_input()` 交給規則，`OVERLAY_RIBBON`／`OVERLAY_PANEL` 是每個覆蓋層的必要角色（新覆蓋層要加）。
   183	- 排版工具：`modal_rect(寬, 高)`（置中、照內容高）、`_h1` 回傳緞帶完整下緣、`_h1_help`／`h1_help_h`、`below_head`、`btn_deco`（按鈕底面之後、焦點框之前畫依附裝飾）、`_btn_small`（可見面不變、點擊區 44）、`btn_ring_clip`（加強焦點外圈的可畫範圍）、`balance_two_lines`。
   184	- 大廳紅書籤（A 案）：選中預設分頁右側（右緣−34、寬 20），上緣貼分頁上緣、長 30；只有選中的分頁讓書籤槽（`BM_SLOT` 42），未選中的不畫書籤、字整格置中。
   185	- 備份資料夾跟存檔前綴（`backup_dir()`；正式遊戲仍是 `user://backup`）。
   186	- 版面檢查 21 組（四語 × 三字級＋狀態；補了簡中、日文 125%）；空／滿資料截圖名帶 `@`；`LAYOUT_STRICT_WARN=1` 時排版警告也算失敗；違規全表 `tools/layout_table.py`、接觸表 `tools/layout_sheet.py`（畫中線、修前修後並排、標 commit）。
   187	- **V1.0.0**：版面檢查加「字形實高 < 9px（Deck，字級 × 0.7）」違規（`dev_main.gd` `DECK_CAP`／`DECK_MIN_PX`），符號也算。圖鑑左欄多一塊範圍格網（`cx_ranges`：射程或支援範圍＋爆爆羊／吸塵貓／小石魔技能範圍，數值取兵種常數）。
   188	- **1.2.0**：材質 `art/mat/`（`tools/gen/materials.py`，ambientCG CC0，manifest 契約由 `check_assets.py` 檢查，≤64 MiB）；「工藝」字型組為預設（Noto Sans→NTB Sans、霞鶩文楷→NTB Title；圓體可在設定切回）；字級表 2.0（100%：C15 S16 B18 H2 24 H1 34 T44）；元件庫 2.0（木牌按鈕、朱漆主按鈕＋蠟封、布標分頁、黃銅撥片、暖墨暗幕 `_dim`）；每個疊層一個實物外框（`OBJ_OF`），打開前 0.3 秒演開合（只疊畫，截圖／版面／減少特效／簡化不演；開發截圖 `--shot-open`）。
   189	
   190	## 設定、無障礙、輸入
   191	- 設定七頁（畫面、介面、聲音、操作、戰場與觀戰、無障礙、資料）：`_settings_rows`；列位置 `_settings_row_y`。無障礙頁三個一鍵預設（可疊加、可撤回）。資料頁：設定碼 `NTS1.`（匯入先預覽）、進度備份 `user://backup/`（留 10 份，同秒加流水號）、還原（確認框、`Save.restorable` 驗身分與版本、唯讀存檔不還原）、分項清除（先自動備份，備份失敗不清）。首次啟動三個問題（`first_done`；老玩家自動略過）。多項一起改用 `Save.set_settings`（只寫一次）＋`_apply_all_settings`。
   192	- 新設定鍵與合法值：`Save.DEFAULT_SETTINGS`、`Save.ENUMS`；新安裝畫面震動 25%、閃白 50%，老玩家照原本開關。提示停留可「手動關」（`toast_mult` 0）。
   193	- 設定：速度表 `SPEEDS`（0.25～8）、死區觸發＝死區＋25%、修改標記與單項／整頁恢復預設（`SET_KEYS`）、預設套用前預覽（舊→新）、擺兵方式 `place_mode`（只點選：不連續塗、點一下自己的兵拿掉）、全螢幕 10 秒自動還原（`_guard_fs` 也管匯入／恢復／預設）、戰鬥中生效時機、還原與清除先寫檔（`_commit_data`）。

