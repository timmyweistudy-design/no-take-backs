     2	"""1.4.0 方案盤點（使用者第 10 點「文字在格子裡上下左右要有空、不要太緊；圖示要在框框裡、上下留空」）：
     3	讀 dev_main --geom-dump 寫的 geom.jsonl（字形框 g、所屬按鈕框 own、九宮格方塊 boxes、圖示框 icons、按鈕框 btns），量內距。
     4	- 格子字：按鈕標籤（own）＋落在小方塊（寬 ≤ 420、高 ≤ 120）裡的單段字；量字形框到格子四邊的距離。
     5	  太緊＝上或下 < max(4px, 格高×12%)，或左或右 < max(6px, 格寬×6%)（刻意靠左的列只看右、上、下）。
     6	- 圖示：找包住圖示中心的最小按鈕／方塊；出框＝圖示框超出容器；太緊＝上或下 < max(3px, 容器高×10%)。
     7	用法：python3 tools/gen/padding_audit.py <截圖夾> [輸出.md]"""
     8	import json, sys, os
     9	
    10	def inside_pt(p, b):
    11	    return b[0] <= p[0] <= b[0] + b[2] and b[1] <= p[1] <= b[1] + b[3]
    12	
    13	def margins(g, b):
    14	    return (g[0] - b[0], (b[0] + b[2]) - (g[0] + g[2]), g[1] - b[1], (b[1] + b[3]) - (g[1] + g[3]))   # 左 右 上 下
    15	
    16	def main():
    17	    d = sys.argv[1]
    18	    out = sys.argv[2] if len(sys.argv) > 2 else None
    19	    rows_t, rows_i = [], []
    20	    st = {"cells": 0, "tight": 0, "over": 0, "icons": 0, "icon_out": 0, "icon_tight": 0, "icon_free": 0}
    21	    for line in open(os.path.join(d, "geom.jsonl"), encoding="utf-8"):
    22	        j = json.loads(line)
    23	        shot = j["shot"]
    24	        boxes = [b for b in j.get("boxes", []) if b[2] <= 420 and b[3] <= 120]
    25	        btns = [b for b in j.get("btns", []) if b[2] > 0]
    26	        for t in j["texts"]:
    27	            if t.get("field"):
    28	                continue
    29	            g = t["g"]
    30	            cell = t.get("own")
    31	            if not cell:
    32	                c = (g[0] + g[2] / 2, g[1] + g[3] / 2)
    33	                cand = [b for b in boxes if inside_pt(c, b)]
    34	                if not cand:
    35	                    continue
    36	                cell = min(cand, key=lambda b: b[2] * b[3])
    37	            l, r, tp, bt = margins(g, cell)
    38	            st["cells"] += 1
    39	            left_aligned = l <= 24 and r > cell[2] * 0.3
    40	            need_v = max(4.0, cell[3] * 0.12)
    41	            need_h = max(6.0, cell[2] * 0.06)
    42	            bad = []
    43	            if min(l, r, tp, bt) < -0.5:
    44	                bad.append("出框")
    45	                st["over"] += 1
    46	            if tp < need_v or bt < need_v:
    47	                bad.append("上下太緊")
    48	            if (not left_aligned and l < need_h) or r < need_h:
    49	                bad.append("左右太緊")
    50	            if bad:
    51	                st["tight"] += 1
    52	                rows_t.append((shot, t["s"][:24].replace("\n", " "), "、".join(bad), l, r, tp, bt, cell[2], cell[3]))
    53	        for ic in j.get("icons", []):
    54	            r0 = ic["r"]
    55	            st["icons"] += 1
    56	            c = (r0[0] + r0[2] / 2, r0[1] + r0[3] / 2)
    57	            cand = [b for b in btns + boxes if inside_pt(c, b) and b[2] * b[3] > r0[2] * r0[3] * 1.2]
    58	            if not cand:
    59	                st["icon_free"] += 1
    60	                continue
    61	            b = min(cand, key=lambda x: x[2] * x[3])
    62	            l, r, tp, bt = margins(r0, b)
    63	            bad = []
    64	            if min(l, r, tp, bt) < -0.5:
    65	                bad.append("出框")
    66	                st["icon_out"] += 1
    67	            elif min(tp, bt) < max(3.0, b[3] * 0.10):
    68	                bad.append("上下太緊")
    69	                st["icon_tight"] += 1
    70	            if bad:
    71	                rows_i.append((shot, ic["n"], "、".join(bad), l, r, tp, bt, b[2], b[3]))
    72	    lines = ["# 內距盤點（%s）" % os.path.basename(os.path.normpath(d)), "",
    73	             "格子字 %d 段：太緊或出框 %d 段（其中出框 %d）。圖示 %d 個（不在任何框裡 %d）：出框 %d、上下太緊 %d。" % (
    74	                 st["cells"], st["tight"], st["over"], st["icons"], st["icon_free"], st["icon_out"], st["icon_tight"]), "",
    75	             "## 格子字（左／右／上／下 px，格子寬×高）", "| 畫面 | 字 | 問題 | 左 | 右 | 上 | 下 | 格 |", "|---|---|---|---|---|---|---|---|"]
    76	    rows_t.sort(key=lambda x: min(x[5], x[6]))
