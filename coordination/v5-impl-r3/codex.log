   393				y += text_h(line, tz("S"), R.size.x) + 4
   394		var df: Array = lobby_r.diff(_lobby_std())
   395		if not df.is_empty() and y + tz("S") * 1.4 <= R.end.y:
   396			_text(Vector2(R.position.x, y), L.t("lb_diff_n", [df.size()]), tz("S"), Color(1, 1, 1, 0.8), false, true, R.size.x)
   397			y += tz("S") * 1.4
