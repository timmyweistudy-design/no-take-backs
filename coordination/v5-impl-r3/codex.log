   212	## 實機影片（N6 預告素材）：用 Godot 錄影模式跑（--write-movie 絕對路徑 --fixed-fps 30），全程自動。
   213	func _run_video() -> void:
   214		await get_tree().create_timer(2.5).timeout
   215		difficulty = 1
   216		_start_mode(Mode.VS_AI)
   217		var plan := [[D.SHIELD, 5, 3], [D.SHIELD, 5, 5], [D.SWORD, 4, 2], [D.SWORD, 4, 6], [D.SWORD, 4, 4],
   218			[D.ARCHER, 1, 3], [D.ARCHER, 1, 5], [D.ARCHER, 0, 4], [D.CAVALRY, 3, 0], [D.CAVALRY, 3, 8], [D.ASSASSIN, 2, 4],
     1	extends SceneTree
     2	## 第五輪 P0：效能探測。人數上限、一局時間要依這裡的數字定，不憑感覺。
     3	## 情境：標準 24＋24、大軍 32／40／48 隻、支援兵密集、困難 AI 候選模擬。
     4	## 模擬直接塞兵（繞過 MAX_UNITS），只量模擬本身；畫面 fps 另用截圖模式量。
     5	## 用法：godot --headless --path game --script res://tools/perf_probe.gd
     6	const Sim = preload("res://scripts/core/battle_sim.gd")
     7	const Army = preload("res://scripts/core/army.gd")
     8	const D = preload("res://scripts/core/unit_defs.gd")
     9	const AI = preload("res://scripts/core/ai_army.gd")
    10	const HardAI = preload("res://scripts/core/hard_ai.gd")
    11	const RSET = preload("res://scripts/core/ruleset.gd")
    12	
    13	static func fill(team: int, n: int, rng: RandomNumberGenerator, types: Array) -> Army:
    14		var a := Army.new(team, 1000)
    15		var cells: Array = []
    16		for c in Army.ZONE:
    17			for r in Army.ROWS:
    18				cells.append(Vector2i(c if team == 0 else Army.COLS - 1 - c, r))
    19		for i in range(cells.size() - 1, 0, -1):
    20			var j := rng.randi_range(0, i)
    21			var t = cells[i]; cells[i] = cells[j]; cells[j] = t
    22		for i in mini(n, cells.size()):
    23			a.units.append({"type": types[rng.randi_range(0, types.size() - 1)], "col": cells[i].x, "row": cells[i].y})
    24		return a
    25	
    26	static func bench(n: int, types: Array, reps: int, rules = null) -> Dictionary:
    27		var tot := 0
    28		var worst := 0
    29		var ticks := 0
    30		for k in reps:
    31			var rng := RandomNumberGenerator.new()
    32			rng.seed = 777 + k * 31 + n
    33			var s = Sim.new(fill(0, n, rng, types), fill(1, n, rng, types), rules)
    34			s.fast = true
    35			var t0 := Time.get_ticks_usec()
    36			s.run_to_end()
    37			var us := Time.get_ticks_usec() - t0
    38			tot += us
    39			worst = maxi(worst, us)
    40			ticks += s.tick
    41		return {"n": n, "avg_ms": tot / reps / 1000, "worst_ms": worst / 1000, "avg_ticks": ticks / reps, "us_per_tick": tot / maxi(1, ticks)}
    42	
    43	func _init() -> void:
    44		var all: Array = []
    45		for t in D.COUNT:
    46			all.append(t)
    47		var out := {}
    48		for n in [24, 32, 40, 48]:
    49			out["mixed_%d" % n] = bench(n, all, 6)
    50		out["support_40"] = bench(40, [D.SWORD, D.SHIELD, 7, 8, 7, 8], 6)   # 醫者 7、鼓手 8 密集
    51		out["archers_40"] = bench(40, [D.ARCHER, D.ARCHER, D.SHIELD], 6)
    52		# 困難 AI：候選陣型各和玩家上一局模擬一場（標準 24 隻）
    53		var rng := RandomNumberGenerator.new()
    54		rng.seed = 99
    55		var known: Array = AI.build(0, 100, rng)["army"].units
    56		var t0 := Time.get_ticks_usec()
    57		for k in 5:
    58			HardAI.build(known, [], rng)
    59		out["hard_ai_build_ms"] = (Time.get_ticks_usec() - t0) / 5 / 1000
    60		# 第五輪（Codex 實作第 1 輪）：最大規則情境——40＋40、150 秒、支援兵密集；困難 AI 在最大規則下組陣；重播跳轉到最後
    61		var big = RSET.standard()
    62		big.budget = [200, 200]
    63		big.unit_cap = 40
    64		big.ticks = 3000
    65		out["max_rules_40_150s"] = bench(40, all, 4, big)
    66		out["max_rules_support_40_150s"] = bench(40, [D.SWORD, D.SHIELD, 7, 8, 7, 8], 4, big)
    67		# 合法的最大陣（Codex 實作第 2 輪：上面兩項是繞過預算直接塞兵的壓力測試）：200 金、40 隻上限、照規則擺
    68		var legal_t := 0
    69		var legal_worst := 0
    70		for k in 4:
    71			var lr := RandomNumberGenerator.new()
    72			lr.seed = 300 + k
    73			var la = AI.build(0, 200, lr, -1, -1, big)["army"]
    74			var lb = AI.build(1, 200, lr, -1, -1, big)["army"]
    75			var ls = Sim.new(la, lb, big)
    76			ls.fast = true
    77			var t3 := Time.get_ticks_usec()
    78			ls.run_to_end()
    79			var us3 := Time.get_ticks_usec() - t3
    80			legal_t += us3
    81			legal_worst = maxi(legal_worst, us3)
    82		out["legal_max_ai_armies"] = {"avg_ms": legal_t / 4 / 1000, "worst_ms": legal_worst / 1000}
    83		# 合法的支援兵密集：10 劍士＋醫者／鼓手交替擺到買不起（200 金、40 隻）
    84		var mk := func(team: int) -> Army:
    85			var a := Army.new(team, 200)
    86			a.apply_rules(big, team)
    87			var cells: Array = []
    88			for c in Army.ZONE:
    89				for r in Army.ROWS:
    90					cells.append(Vector2i(c if team == 0 else Army.COLS - 1 - c, r))
    91			var i := 0
    92			for k in 10:
    93				a.place(D.SWORD, cells[i].x, cells[i].y)
    94				i += 1
    95			var t := 7
    96			while a.can_afford_any() and i < cells.size():
    97				a.place(t, cells[i].x, cells[i].y)
    98				t = 15 - t
    99				i += 1
   100			return a
   101		var sup0: Army = mk.call(0)
   102		var sup1: Army = mk.call(1)
   103		var ss = Sim.new(sup0, sup1, big)
   104		ss.fast = true
   105		var t4 := Time.get_ticks_usec()
   106		ss.run_to_end()
   107		out["legal_support_dense"] = {"units": sup0.count(), "ms": (Time.get_ticks_usec() - t4) / 1000, "ticks": ss.tick}
   108		var known2: Array = AI.build(0, 200, rng, -1, -1, big)["army"].units
   109		var t1 := Time.get_ticks_usec()
   110		for k in 3:
   111			HardAI.build(known2, [], rng, -1, big)
   112		out["hard_ai_build_max_rules_ms"] = (Time.get_ticks_usec() - t1) / 3 / 1000
   113		# 重播跳轉：從頭快轉到最後一 tick（畫面的 _seek 也是這樣做）
   114		rng.seed = 4242
   115		var sa := fill(0, 40, rng, [D.SWORD, D.SHIELD, 7, 8, 7, 8])
   116		var sb := fill(1, 40, rng, [D.SWORD, D.SHIELD, 7, 8, 7, 8])
   117		var t2 := Time.get_ticks_usec()
   118		var sk = Sim.new(sa, sb, big)
   119		while not sk.finished:
   120			sk.step()
   121		out["seek_to_end_max_ms"] = (Time.get_ticks_usec() - t2) / 1000
   122		print("PERF ", JSON.stringify(out))
   123		quit()

