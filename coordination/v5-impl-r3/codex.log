   304	func _width(s: String, size: int, bold := false) -> float:
   305		var w := 0.0
   306		for ln in s.split("\n"):
   307			w = maxf(w, _font_for(ln, size, bold).get_string_size(ln, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x)
   308		return w
   309	
   310	## 換行（第五輪）：中日韓逐字斷、英文逐詞斷；保留原本的 \n。回傳行陣列。
   311	func wrap_lines(s: String, size: int, maxw: float, bold := false) -> PackedStringArray:
   312		var out := PackedStringArray()
   313		for para in s.split("\n"):
   314			if maxw <= 0.0 or _width(para, size, bold) <= maxw:
   315				out.append(para)
   316				continue
   317			var cur := ""
   318			var i := 0
   319			while i < para.length():
   320				var tok := para[i]
   321				if tok.unicode_at(0) < 0x2E80 and tok != " ":
   322					# 拉丁字：整個詞一起
   323					var j := i + 1
   324					while j < para.length() and para[j].unicode_at(0) < 0x2E80 and para[j] != " ":
   325						j += 1
   326					tok = para.substr(i, j - i)
   327					i = j
   328				else:
   329					i += 1
   330				if cur != "" and _width(cur + tok, size, bold) > maxw:
   331					out.append(cur.strip_edges(false, true))
   332					cur = tok.strip_edges(true, false) if tok == " " else tok
   333				else:
   334					cur += tok
   335			if cur != "":
   336				out.append(cur)
   337		return out
   338	
   339	## 行距（第五輪 §4.2，XAG 101）：多行的段落 1.5 倍；單行照舊。
   340	static func line_h(n: int) -> float:
   341		return 1.5 if n > 1 else 1.3
   342	
   343	## 一段字換行後的高度（排版用）。
   344	func text_h(s: String, size: int, maxw := 0.0, bold := false) -> float:
   345		var n := wrap_lines(s, size, maxw, bold).size()
   346		return n * size * line_h(n)
