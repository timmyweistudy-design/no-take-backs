   349	func _text(p: Vector2, s: String, size: int, c: Color, center := false, bold := false, maxw := 0.0, outline := Color(0, 0, 0, -1)) -> void:
   350		if maxw > 0.0:
   351			size = fit(s, size, maxw, bold)
   352		var lines := wrap_lines(s, size, maxw, bold) if maxw > 0.0 else s.split("\n")
   353		for i in lines.size():
   354			var fnt := _font_for(lines[i], size, bold)
   355			var w := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x if center else 0.0
   356			var q := p + Vector2(-w / 2, i * size * line_h(lines.size()) + size * 0.85)
   357			# 版面探針（第五輪補洞）：介面層與戰場層都量、低透明度（>0.05）也量；戰場字標 field
   358			if layout_probe and c.a > 0.05 and lines[i].strip_edges() != "":
   359				var ww := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
   360				probe_texts.append({"r": Rect2(q.x, q.y - size * 0.85, ww, size * 1.1), "size": size, "s": lines[i], "field": not _probe_ui, "a": c.a, "btn": _probe_btn_label, "own": _probe_btn_rect})
   361			var oc := Color(0, 0, 0, c.a * 0.75) if outline.a < 0.0 else outline
   362			if oc.a > 0.0:
   363				draw_string_outline(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, 5, oc)
   364			draw_string(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, c)
