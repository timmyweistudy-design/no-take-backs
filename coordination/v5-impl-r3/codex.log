    17	## known：玩家上一局的兵（藍方座標）；entries：反制庫；回傳紅方陣型。
    18	## pool：紅方卡池遮罩（-1＝全部）；rules：第五輪 Ruleset（null＝標準）。
    19	## 反制庫只在「規則和標準一樣」時用（第五輪 §3.2）；大軍或長局時少一個候選（效能探測：40＋40、150 秒一場可達數秒）。
    20	static func build(known: Array, entries: Array, rng: RandomNumberGenerator, pool := -1, rules = null) -> Army:
    21		if pool < 0:
    22			pool = RS.all_pool()
    23		var bud: int = 100 if rules == null else rules.budget_of(1)
    24		var cands: Array = []
    25		cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
    26		if known.is_empty():
    27			return cands[0]
    28		var heavy: bool = rules != null and (rules.unit_cap > 24 or rules.ticks > 1800)
    29		if not heavy:
    30			cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
    31		var full := AIT.build_full(1, rng, 2, known, pool, rules)
    32		cands.append(full)
    33		if rules == null or _standard_like(rules):
    34			var lib := pick_counter(entries, known, pool)
    35			if lib != null:
    36				cands.append(lib)
    37		var me := Army.new(0, 100 if rules == null else rules.budget_of(0))
    38		for u in known:
    39			me.units.append({"type": int(u["type"]), "col": int(u["col"]), "row": int(u["row"])})
    40		var best: Army = cands[0]
    41		var bs := -(1 << 40)
    42		for c in cands:
    43			var s = Sim.new(me.copy(), c.copy(), rules)
    44			s.fast = true
    45			s.run_to_end()
    46			# 讓子局用各自預算的比例評分（Codex 實作第 1 輪）；標準局算式不變
    47			var sc: int = (1000000 + s.power(1)) if s.winner == 1 else (s.power(1) - s.power(0))
    48			if s.judge == 2:
    49				sc = (1000000 + s.power_permille(1)) if s.winner == 1 else (s.power_permille(1) - s.power_permille(0))
    50			if sc > bs:
    51				bs = sc
    52				best = c
    53		return best
