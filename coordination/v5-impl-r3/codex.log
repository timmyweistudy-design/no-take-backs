   108	func _layout_report(name: String) -> void:
   109		var bad: Array = []
   110		var sizes: Array = []
   111		var ui_n := 0
   112		var free_n := 0
   113		var ctrls: Array = probe_btns + probe_ctrls
   114		for t in probe_texts:
   115			var r: Rect2 = t["r"]
   116			var sz := int(t["size"])
   117			if t.get("field", false):
   118				if sz < 14:
   119					bad.append({"type": "戰場字太小", "s": t["s"], "size": sz})
   120				if r.position.x < -2 or r.end.x > 1282 or r.position.y < -2 or r.end.y > 802:
   121					bad.append({"type": "戰場字越界", "s": t["s"], "r": str(r)})
   122				continue
   123			ui_n += 1
   124			sizes.append(sz)
   125			var in_ctrl: bool = t.get("btn", false)
   126			for c in probe_ctrls:
   127				if c.grow(1.0).encloses(r):
   128					in_ctrl = true   # 整段字都在卡片／空白標籤按鈕裡＝控制項內容
   129					break
   130			if not in_ctrl:
   131				free_n += 1
   132			if r.position.x < -2 or r.end.x > 1282 or r.position.y < -2 or r.end.y > 802:
   133				bad.append({"type": "越界", "s": t["s"], "r": str(r)})
   134			if sz < tz("C"):
   135				bad.append({"type": "小於字級表下限", "s": t["s"], "size": sz})
   136			if not size_ok(sz):
   137				bad.append({"type": "表外字級", "s": t["s"], "size": sz})
   138		for a in probe_texts.size():
   139			if probe_texts[a].get("field", false):
   140				continue
   141			for b in range(a + 1, probe_texts.size()):
   142				if probe_texts[b].get("field", false):
   143					continue
   144				var ra: Rect2 = probe_texts[a]["r"]
   145				var rb: Rect2 = probe_texts[b]["r"]
   146				var x := ra.intersection(rb)
   147				if not x.has_area():
   148					continue
   149				var ratio := x.get_area() / maxf(1.0, minf(ra.get_area(), rb.get_area()))
   150				if ratio <= 0.15:
   151					continue
   152				if probe_texts[a]["s"] != probe_texts[b]["s"]:
   153					bad.append({"type": "重疊", "a": probe_texts[a]["s"], "b": probe_texts[b]["s"], "ratio": snappedf(ratio, 0.01)})
   154				elif ra.position.distance_to(rb.position) > 2.0:
   155					bad.append({"type": "相同字串重疊", "s": probe_texts[a]["s"], "ratio": snappedf(ratio, 0.01)})
   156		for r in probe_btns:
   157			if r.size.x < 36.0 or r.size.y < 36.0:   # 方案 §5.3：點擊框 ≥36px
   158				bad.append({"type": "點擊框太小", "r": str(r)})
   159		# 第五輪（Antigravity 實作第 1 輪抓到自動檢查漏的）：按鈕外的文字壓到按鈕上
   160		for t in probe_texts:
   161			if t.get("field", false):
   162				continue
   163			var tr: Rect2 = t["r"]
   164			if t.get("btn", false):
   165				# 按鈕標籤：只豁免它自己的按鈕；要完整落在自己的框內，也不能壓到別顆按鈕（Codex 實作第 2 輪）
   166				var own: Rect2 = t.get("own", Rect2())
   167				if own.has_area() and not own.grow(2.0).encloses(tr):
   168					bad.append({"type": "按鈕標籤超出按鈕", "s": t["s"], "btn": str(own)})
   169				for br2 in probe_btns:
   170					if br2 == own:
   171						continue
   172					var x3 := tr.intersection(br2)
   173					if x3.has_area() and x3.get_area() > tr.get_area() * 0.10:
   174						bad.append({"type": "按鈕標籤壓到別的按鈕", "s": t["s"], "btn": str(br2)})
   175						break
   176				continue
   177			var inside := false
   178			for c in probe_ctrls:
   179				if c.grow(1.0).encloses(tr):
   180					inside = true
   181					break
   182			if inside:
   183				continue
   184			for br in probe_btns:
   185				var x2 := tr.intersection(br)
   186				if x2.has_area() and x2.get_area() > tr.get_area() * 0.10:
   187					bad.append({"type": "文字壓到按鈕", "s": t["s"], "btn": str(br)})
   188					break
   189		if TEXT_BUDGET.has(name) and int(Save.s("text_scale")) == 100 and free_n > int(TEXT_BUDGET[name]):
   190			bad.append({"type": "文字段數超過上限", "n": free_n, "max": TEXT_BUDGET[name]})
   191		sizes.sort()
   192		var line := JSON.stringify({"shot": name, "lang": L.lang, "scale": int(Save.s("text_scale")), "texts": ui_n, "free_texts": free_n,
   193			"median_size": sizes[sizes.size() / 2] if not sizes.is_empty() else 0, "min_size": sizes[0] if not sizes.is_empty() else 0,
   194			"violations": bad, "warnings": []})
   195		var f := FileAccess.open(shot_dir.path_join("layout.jsonl"), FileAccess.READ_WRITE if FileAccess.file_exists(shot_dir.path_join("layout.jsonl")) else FileAccess.WRITE)
   196		f.seek_end()
   197		f.store_line(line)
   198		f.close()
