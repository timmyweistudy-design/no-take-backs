     9	## 第五輪：自訂規則的對戰代碼用 NTB3（多一欄 rules＝規則代碼）。標準規則仍輸出 NTB2，位元組和 1.3.0 相同。
    10	
    11	## 這組規則能不能用舊格式 NTB2 重播（模擬走舊路徑、陣型在舊的人數上限內）。
    12	static func needs_v3(rules) -> bool:
    13		# Codex 實作第 1 輪：卡池、人數、單種上限有任何不標準就用 NTB3，分享後規則不會遺失
    14		return rules != null and (not rules.sim_is_legacy() or not load("res://scripts/game/presets.gd").deploy_standard(rules))
    15	
    16	static func encode(a0, a1, rules = null) -> String:
    17		if needs_v3(rules):
    18			var j3 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest(), "rules": rules.to_code()})
    19			var body3 := Marshalls.utf8_to_base64(j3).replace("+", "-").replace("/", "_").replace("=", "")
    20			return "NTB3.%s.%s" % [body3, body3.sha256_text().substr(0, 6)]
    21		var j := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest()})
    22		var body := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
    23		return "NTB2.%s.%s" % [body, body.sha256_text().substr(0, 6)]
    24	
    25	## 回傳 {ok, why, a0, a1, mismatch, rules}（NTB2 的 rules＝null＝用 1.3.0 舊判定重播）
    26	static func decode(code: String) -> Dictionary:
    27		var c := code.strip_edges()
    28		if c.length() > 8000:
    29			return {"ok": false, "why": "format"}
    30		var parts := c.split(".")
    31		if parts.size() != 3 or (parts[0] != "NTB2" and parts[0] != "NTB3"):
    32			return {"ok": false, "why": "format"}
    33		if parts[1].sha256_text().substr(0, 6) != parts[2]:
    34			return {"ok": false, "why": "checksum"}
    35		var b64 := parts[1].replace("-", "+").replace("_", "/")
    36		while b64.length() % 4 != 0:
    37			b64 += "="
    38		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
    39		if not j is Dictionary or not j.has("a") or not j.has("b"):
    40			return {"ok": false, "why": "body"}
    41		# 預算也編進去（Codex S5 #1：遠征敵軍超過 100 金、殘局低預算時，原本會被當成 100）
    42		var ba := int(j.get("ba", 100))
    43		var bb := int(j.get("bb", 100))
    44		if ba < 1 or ba > 400 or bb < 1 or bb > 400:
    45			return {"ok": false, "why": "budget"}
    46		var a0 := Army.new(0, ba)
    47		var a1 := Army.new(1, bb)
    48		var rules = null
    49		if parts[0] == "NTB3":
    50			var rd: Dictionary = RSET.from_code(str(j.get("rules", "")))
    51			if not rd["ok"]:
    52				return {"ok": false, "why": "rules"}
    53			rules = rd["rules"]
    54			if rules.budget_of(0) != ba or rules.budget_of(1) != bb:
    55				return {"ok": false, "why": "budget"}
    56			for pair in [[a0, 0], [a1, 1]]:
    57				pair[0].apply_rules(rules, pair[1])
    58		if a0.load_code(str(j["a"])) != "" or a1.load_code(str(j["b"])) != "":
    59			return {"ok": false, "why": "army"}
    60		if rules != null and (not a0.has_combat() or not a1.has_combat()):
    61			return {"ok": false, "why": "army"}   # NTB3（第五輪新格式）：雙方各至少 1 隻戰鬥兵；舊 NTB2 不加這條（相容）
    62		var mismatch: bool = str(j.get("r", "")) != D.RULES_VERSION or str(j.get("d", "")) != D.data_digest()
    63		return {"ok": true, "why": "", "a0": a0, "a1": a1, "mismatch": mismatch, "rules": rules}
