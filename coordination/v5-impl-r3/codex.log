    97	## 第五輪：套用規則（部署層）。
    98	func apply_rules(r, p_team: int) -> void:
    99		budget = r.budget_of(p_team)
   100		pool = r.pool_of(p_team)
   101		unit_cap = r.unit_cap
   102		type_cap = r.type_cap
   103		guard_combat = true
   104	
   105	func _copy_limits(a) -> void:
   106		a.pool = pool
   107		a.unit_cap = unit_cap
   108		a.type_cap = type_cap
   109		a.guard_combat = guard_combat
   110	
   111	func place(t: int, col: int, row: int) -> bool:
   112		if check_place(t, col, row) != "":
   113			return false
   114		units.append({"type": t, "col": col, "row": row})
   115		return true
   116	
   117	func remove_at(col: int, row: int) -> bool:
   118		var i := index_at(col, row)
   119		if i == -1:
   120			return false
   121		units.remove_at(i)
   122		return true
   123	
   124	func move(fc: int, fr: int, tc: int, tr: int) -> bool:
   125		var i := index_at(fc, fr)
   126		if i == -1 or not in_zone(tc, tr) or index_at(tc, tr) != -1:
   127			return false
   128		units[i]["col"] = tc
   129		units[i]["row"] = tr
   130		return true
   131	
   132	func clear() -> void:
   133		units.clear()
   134	
   135	func can_afford_any() -> bool:
   136		if count() >= unit_cap:
   137			return false
   138		if guard_combat and not has_combat():
   139			return left() >= cheapest_combat()
   140		return left() >= cheapest_in_pool()
   141	
   142	func copy():
   143		var a = get_script().new(team, budget)
   144		a.units = units.duplicate(true)
   145		_copy_limits(a)
   146		return a
   147	
   148	## 左右鏡像並換隊（測試先手偏差用）。
   149	func mirrored():
   150		var a = get_script().new(1 - team, budget)
   151		_copy_limits(a)
   152		for u in units:
   153			a.units.append({"type": u["type"], "col": COLS - 1 - u["col"], "row": u["row"]})
   154		return a
   155	
   156	## 陣型代碼（優化方案 E3）：NTB1.<base64url>.<校驗 4 碼>。
   157	## 位元組：[版本 1, 隻數, 每隻 (兵種<<4 | 以藍方表示的欄 0～5), 列]。欄位一律存成「自己這一側」，所以紅藍都能讀。
   158	const CODE_VERSION := 1
   159	
   160	func to_code() -> String:
   161		var b := PackedByteArray([CODE_VERSION, units.size()])
   162		for u in units:
   163			var c: int = u["col"] if team == 0 else COLS - 1 - u["col"]
   164			b.append((int(u["type"]) << 4) | c)
   165			b.append(u["row"])
   166		var body := Marshalls.raw_to_base64(b).replace("+", "-").replace("/", "_").replace("=", "")
   167		return "NTB1.%s.%s" % [body, body.sha256_text().substr(0, 4)]
   168	
   169	## 解碼並驗證；成功回傳 ""，失敗回傳原因（不改動目前陣型）。
   170	func load_code(code: String) -> String:
   171		var parts := code.strip_edges().split(".")
   172		if parts.size() != 3 or parts[0] != "NTB1":
   173			return "格式不對"
   174		if parts[1].sha256_text().substr(0, 4) != parts[2]:
   175			return "校驗碼不符"
   176		var b64 := parts[1].replace("-", "+").replace("_", "/")
   177		while b64.length() % 4 != 0:
   178			b64 += "="
   179		var b := Marshalls.base64_to_raw(b64)
   180		if b.size() < 2 or b[0] != CODE_VERSION or b.size() != 2 + b[1] * 2:
   181			return "版本或長度不對"
   182		var tmp = get_script().new(team, budget)
   183		_copy_limits(tmp)
   184		tmp.guard_combat = false
   185		for i in b[1]:
   186			var t: int = b[2 + i * 2] >> 4
   187			var c: int = b[2 + i * 2] & 15
   188			var r: int = b[3 + i * 2]
   189			if t >= D.COUNT or c > 5:
   190				return "內容不合法"
   191			var col: int = c if team == 0 else COLS - 1 - c
   192			if not tmp.place(t, col, r):
   193				return "超過預算、人數或格子重複"
   194		units = tmp.units
   195		return ""
