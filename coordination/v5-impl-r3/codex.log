   152	# ───────── 數值調整 ─────────
   153	static func _step_in(v: int, opts: Array, d: int) -> int:
   154		var i := opts.find(v)
   155		if i < 0:
   156			i = 0
   157		return opts[clampi(i + d, 0, opts.size() - 1)]
   158	
   159	func _lobby_adj(id: String, d: int) -> void:
   160		var r = lobby_r
   161		lobby_item = id
   162		match id:
   163			"budget":
   164				r.budget[0] = clampi(int(r.budget[0]) + 10 * d, RuleSet.BUDGET_MIN, RuleSet.BUDGET_MAX)
   165				if not r.handicap:
   166					r.budget[1] = r.budget[0]
   167			"handicap":
   168				r.handicap = not r.handicap
   169				if not r.handicap:
   170					r.budget[1] = r.budget[0]
   171			"budget_red":
   172				r.budget[1] = clampi(int(r.budget[1]) + 10 * d, RuleSet.BUDGET_MIN, RuleSet.BUDGET_MAX)
   173			"unit_cap":
   174				r.unit_cap = clampi(r.unit_cap + 2 * d, RuleSet.UNIT_CAP_MIN, RuleSet.UNIT_CAP_MAX)
   175			"type_cap":
   176				r.type_cap = clampi(r.type_cap + d, 0, RuleSet.TYPE_CAP_MAX)
   177			"ticks":
   178				r.ticks = _step_in(r.ticks, RuleSet.TICK_CHOICES, d)
   179			"rounds":
   180				r.rounds = _step_in(r.rounds, RuleSet.ROUND_CHOICES, d)
   181			"place_rule":
   182				var opts := RuleSet.PLACE_RULES
   183				r.place_rule = opts[posmod(opts.find(r.place_rule) + d, opts.size())]
   184			"turns":
   185				r.turns = clampi(r.turns + d, RuleSet.TURNS_MIN, RuleSet.TURNS_MAX)
   186			"carry":
   187				r.carry = not r.carry
   188			"ai_level":
   189				r.ai_level = clampi(r.ai_level + d, 0, 2)
   190			"keep":
   191				r.keep_formation = not r.keep_formation
   192			"ai_pool_same":
   193				r.ai_pool_same = not r.ai_pool_same
   194				if not r.ai_pool_same:
   195					r.pool[1] = r.pool[0]
   196		_lobby_touch()
