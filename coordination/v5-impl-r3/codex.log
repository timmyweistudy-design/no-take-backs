   364	func _lobby_notes_h(w: float) -> float:
   365		var h := 0.0
   366		for k in lobby_r.validate():
   367			h += text_h("× " + L.t(k), tz("B"), w, true) + 4
   368		var two: bool = lobby_r.handicap or not lobby_r.ai_pool_same
   369		for tm in (2 if two else 1):
   370			var ms: Dictionary = lobby_r.max_spend(tm)
   371			if int(ms["unused"]) > 0:
   372				h += text_h("⚠ " + L.t("lb_unused", [ms["units"], ms["spend"], ms["unused"]]), tz("S"), w) + 4
   373		var df: Array = lobby_r.diff(_lobby_std())
   374		if not df.is_empty():
   375			h += tz("S") * 1.4
   376			for d in df:
   377				h += text_h("・" + _diff_text(d), tz("S"), w - 10)
   378		return h
