+	var locked_ticks := 0
+	var changed := 0
+	var last := Vector2i.ZERO
+	for i in 300:
+		s.step()
+		var u = s.units[0]
+		if u.face_lock != -1:
+			var f := Vector2i(u.fx, u.fy)
+			if locked_ticks > 0 and f != last:
+				changed += 1
+			last = f
+			locked_ticks += 1
+	ok(locked_ticks > 20 and changed == 0, "交戰中面向鎖定（不隨推擠改變）", "locked=%d changed=%d" % [locked_ticks, changed])
+	# 衝鋒：騎兵往盾兵衝、被頂住後歸零；衝鋒距離只算沿起始方向的前進
