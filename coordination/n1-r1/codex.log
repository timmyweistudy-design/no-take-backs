#!/usr/bin/env bash
# 平衡工具 2.0 多行程分片執行器（優化方案 L2）。
# 用法：tools/balance.sh [輸出資料夾] [模式...]
#   預設模式：matrix league turns:cap10 turns:snake5 turns:snake5c search
# 每個模式開 SHARDS 個 headless 行程（預設 16），每片寫自己的檔案，最後 balance_report.py 依場次合併、檢查紅線。
# 結束碼：0＝紅線全過；1＝有紅線失敗；2＝執行錯誤（任何一片失敗、零筆結果都算錯）。
set -uo pipefail
cd "$(dirname "$0")/.."
OUT="${1:-../docs/balance-runs/latest}"
shift || true
MODES=("$@")
[ ${#MODES[@]} -eq 0 ] && MODES=(matrix league turns:cap10 turns:snake5 turns:snake5c search)
SHARDS="${SHARDS:-16}"
GODOT="${GODOT:-godot}"
mkdir -p "$OUT"
rm -f "$OUT"/*.jsonl
t0=$(date +%s)
fail=0
for m in "${MODES[@]}"; do
  mode="${m%%:*}"; extra=""
  [ "$mode" = "turns" ] && extra="--rule=${m#*:}"
  pids=()
  for ((s=0; s<SHARDS; s++)); do
    "$GODOT" --headless --path . --script res://tools/balance2.gd -- "--mode=$mode" "--shard=$s" "--shards=$SHARDS" $extra \
      > "$OUT/${m/:/_}_$s.raw" 2>&1 &
    pids+=($!)
  done
  for p in "${pids[@]}"; do wait "$p" || fail=1; done
  for ((s=0; s<SHARDS; s++)); do
    grep '^R ' "$OUT/${m/:/_}_$s.raw" | sed 's/^R //' > "$OUT/${m/:/_}_$s.jsonl"
    if grep -q 'SCRIPT ERROR\|Parse Error' "$OUT/${m/:/_}_$s.raw"; then echo "✗ $m 第 $s 片有腳本錯誤" >&2; fail=1; fi
    rm -f "$OUT/${m/:/_}_$s.raw"
  done
  echo "· $m 完成（累計 $(( $(date +%s) - t0 )) 秒）"
done
[ $fail -ne 0 ] && { echo "✗ 有分片失敗" >&2; exit 2; }
python3 tools/balance_report.py "$OUT" "$(( $(date +%s) - t0 ))"
extends SceneTree
## 平衡工具 2.0（優化方案 B2、A2、L2）。由 tools/balance.sh 多行程分片呼叫，每場一行 JSON（前綴 "R "）。
##   --mode=matrix    純兵種 60 金方陣 5×5（剋制）
##   --mode=league    訓練池 200 套，每套對 12 個對手、交換左右
##   --mode=turns     輪流落子先後手測試（--rule=cap10|snake5|snake5c，--games=N）
##   --mode=search    爬山搜尋萬用陣（對保留池評估）
##   --mode=counter   離線反制庫：每個原型陣找訓練池裡最能剋它的陣型
##   --shard=i --shards=N

const D = preload("res://scripts/core/unit_defs.gd")
const Army = preload("res://scripts/core/army.gd")
const Sim = preload("res://scripts/core/battle_sim.gd")
const F = preload("res://scripts/core/formations.gd")
const AIT = preload("res://scripts/core/ai_turns.gd")
const TP = preload("res://scripts/core/turn_placement.gd")
const AI = preload("res://scripts/core/ai_army.gd")

var args := {}

func _init() -> void:
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--") and "=" in a:
			var kv := a.substr(2).split("=", true, 1)
			args[kv[0]] = kv[1]
	var shard := int(args.get("shard", "0"))
	var shards := int(args.get("shards", "1"))
	match args.get("mode", "league"):
		"matrix": matrix(shard, shards)
		"league": league(shard, shards)
		"turns": turns(shard, shards)
		"search": search(shard, shards)
		"counter": counter(shard, shards)
	quit(0)

func emit(d: Dictionary) -> void:
	d["digest"] = D.data_digest()
	print("R ", JSON.stringify(d))

## 打一場：a 是藍方陣型（team 0）、b 也是以藍方表示的陣型（會鏡像成紅方）。回傳以 a 的角度的結果。
func fight(a: Army, b: Army) -> Dictionary:
	var s := Sim.new(a.copy(), b.mirrored())
	s.fast = true
	s.run_to_end()
	var m: Dictionary = s.suspense()
	var res := 0
	if s.winner == 0:
		res = 1
	elif s.winner == 1:
		res = -1
	var rem := 0
	if s.winner >= 0:
		rem = s.power(s.winner) * 100 / (s.budget * 1000)
	return {"res": res, "ticks": s.tick, "rem": rem, "timeout": s.reason.begins_with("時間到"),
		"lc": m["lead_changes"], "lock": m["lock_ratio_permille"], "swing": m["max_swing_pct"]}

func block(t: int, gold: int) -> Army:
	var a := Army.new(0, 100)
	var n := gold / D.cost(t)
	var cols := [5, 4, 3, 2, 1, 0] if t != D.ARCHER else [0, 1, 2, 3, 4, 5]
	var rows := [4, 3, 5, 2, 6, 1, 7, 0, 8]
	var k := 0
	for c in cols:
		for r in rows:
			if k < n:
				a.units.append({"type": t, "col": c, "row": r})
				k += 1
	return a

func matrix(shard: int, shards: int) -> void:
	var idx := 0
	for i in D.COUNT:
		for j in D.COUNT:
			if i == j:
				continue
			idx += 1
			if idx % shards != shard:
				continue
			var r := fight(block(i, 60), block(j, 60))
			r["mode"] = "matrix"; r["a"] = i; r["b"] = j
			emit(r)

func league(shard: int, shards: int) -> void:
	var pool := F.training_pool(0)
	for i in pool.size():
		if i % shards != shard:
			continue
		for k in 12:
			var j := (i * 37 + k * 53 + 1) % pool.size()
			if j == i:
				j = (j + 1) % pool.size()
			var r := fight(pool[i], pool[j])
			r["mode"] = "league"; r["a"] = i; r["b"] = j; r["comp"] = F.composition(pool[i])
			emit(r)

func turns(shard: int, shards: int) -> void:
	var rule: String = args.get("rule", "cap10")
	var games := int(args.get("games", "200"))
	var level := int(args.get("level", "1"))
	var rng := RandomNumberGenerator.new()
	for g in games:
		if g % shards != shard:
			continue
		rng.seed = 424242 + g * 104729
		var first := g % 2
		var tp := TP.new(Army.new(0, 100), Army.new(1, 100), first, rule)
		var guard := 0
		while not tp.done() and guard < 100:
			guard += 1
			AIT.play_turn(tp, rng, level)
		var s := Sim.new(tp.armies[0], tp.armies[1])
		s.fast = true
		s.run_to_end()
		var first_won := 0
		if s.winner == first:
			first_won = 1
		elif s.winner == 1 - first:
			first_won = -1
		emit({"mode": "turns", "rule": rule, "game": g, "first": first, "first_won": first_won,
			"handoffs": tp.handoffs, "spent0": tp.armies[0].spent(), "spent1": tp.armies[1].spent(), "ticks": s.tick, "level": level})

func fitness(a: Army, opps: Array) -> float:
	var w := 0.0
	for o in opps:
		var r := fight(a, o)
		w += 1.0 if r["res"] == 1 else (0.5 if r["res"] == 0 else 0.0)
		var r2 := fight(o, a)
		w += 1.0 if r2["res"] == -1 else (0.5 if r2["res"] == 0 else 0.0)
	return w / (opps.size() * 2)

func mutate(a: Army, rng: RandomNumberGenerator) -> Army:
	var b: Army = a.copy()
	var op := rng.randi_range(0, 2)
	if b.units.is_empty():
		op = 2
	if op == 0:
		# 換一隻的兵種（守預算）
		var i := rng.randi_range(0, b.units.size() - 1)
		var old: int = b.units[i]["type"]
		var t := rng.randi_range(0, 4)
		if b.spent() - D.cost(old) + D.cost(t) <= 100:
			b.units[i]["type"] = t
	elif op == 1:
		# 移動一隻
		var i := rng.randi_range(0, b.units.size() - 1)
		var c := rng.randi_range(0, 5)
		var r := rng.randi_range(0, 8)
		if b.index_at(c, r) == -1:
			b.units[i]["col"] = c
			b.units[i]["row"] = r
	else:
		# 拿掉一隻、補別種
		if not b.units.is_empty():
			b.units.remove_at(rng.randi_range(0, b.units.size() - 1))
		var t := rng.randi_range(0, 4)
		F.place_styled(b, t, "role", rng)
	return b

func search(shard: int, shards: int) -> void:
	var iters := int(args.get("iters", "12"))
	var nopp := int(args.get("opps", "24"))
	var hold := F.holdout_pool(0)
	var opps: Array = []
	for k in nopp:
		opps.append(hold[(k * 2 + shard) % hold.size()])
	var rng := RandomNumberGenerator.new()
	rng.seed = 777 + shard * 1009
	var train := F.training_pool(0)
	var cur: Army = train[rng.randi_range(0, train.size() - 1)].copy()
	var cur_f := fitness(cur, opps)
	for it in iters:
		var cand := mutate(cur, rng)
		var f := fitness(cand, opps)
		if f >= cur_f:
			cur = cand
			cur_f = f
	# 最後對整個保留池驗證
	var full := fitness(cur, hold)
	emit({"mode": "search", "shard": shard, "fit_sample": cur_f, "fit_holdout": full, "code": cur.to_code(), "comp": F.composition(cur)})

## 離線反制庫：原型陣（AI 模板×種子）→ 訓練池中勝它最多的陣型代碼。
func counter(shard: int, shards: int) -> void:
	var rng := RandomNumberGenerator.new()
	var train := F.training_pool(0)
	for ti in AI.TEMPLATES.size():
		if ti % shards != shard:
			continue
		rng.seed = 5150 + ti
		var proto: Army = AI.build(0, 100, rng, ti)["army"]
		var best := -1
		var best_f := -1.0
		for j in range(0, train.size(), 2):
			var f := fitness(train[j], [proto])
			if f > best_f:
				best_f = f
				best = j
		emit({"mode": "counter", "template": ti, "name": AI.TEMPLATES[ti]["name"], "proto_comp": F.composition(proto),
			"best": best, "best_fit": best_f, "code": train[best].to_code()})
#!/usr/bin/env python3
"""平衡工具 2.0 報表：合併 balance.sh 各分片的 JSONL，檢查紅線，寫 report.md 與 summary.json。
用法：balance_report.py <資料夾> [總秒數]
結束碼：0＝紅線全過；1＝有紅線失敗；2＝資料錯誤（零筆、數值摘要不一致）。
紅線（優化方案 M）：
  - 剋制五角形 10/10（matrix：剋的一方左右各打一次都要贏）
  - 碾壓局（勝方剩 >50%）< 20%
  - 戰鬥秒數中位數 35～75
  - 勝方剩餘戰力中位數 ≤ 30%
警示（列入調查，不算失敗）：
  - 先手或後手勝率 > 55%
  - 搜尋到保留池勝率 > 65% 的陣型
  - 鎖定時間比中位數 < 0.4（垃圾時間太長）
"""
import json, sys, glob, os, statistics as st

NAMES = ["劍士", "盾兵", "弓箭手", "騎兵", "刺客"]
BEATS = {0: [4, 1], 1: [3, 2], 2: [0, 4], 3: [2, 0], 4: [1, 3]}

def load(folder):
    rows = {}
    for f in sorted(glob.glob(os.path.join(folder, "*.jsonl"))):
        key = os.path.basename(f).rsplit("_", 1)[0]
        for line in open(f, encoding="utf-8"):
            line = line.strip()
            if line:
                rows.setdefault(key, []).append(json.loads(line))
    return rows

def pct(a, b):
    return 0 if b == 0 else round(100 * a / b)

def main():
    folder = sys.argv[1]
    secs = sys.argv[2] if len(sys.argv) > 2 else "?"
    rows = load(folder)
    total = sum(len(v) for v in rows.values())
    if total == 0:
        print("✗ 零筆結果"); sys.exit(2)
    digests = {r.get("digest") for v in rows.values() for r in v}
    if len(digests) != 1:
        print("✗ 數值摘要不一致：", digests); sys.exit(2)
    md = [f"# 平衡報表 2.0\n", f"- 數值摘要 `{digests.pop()}`、共 {total} 筆、耗時 {secs} 秒\n"]
    fails, warns, summary = [], [], {}

    if "matrix" in rows:
        m = {}
        for r in rows["matrix"]:
            m[(r["a"], r["b"])] = r
        ok = 0
        md.append("\n## ① 剋制矩陣（各 60 金；列兵種對行兵種：勝/平/負，括號＝勝方剩餘%）\n\n| | " + " | ".join(NAMES) + " |\n|" + "---|" * 6 + "\n")
        for a in range(5):
            cells = []
            for b in range(5):
                if a == b:
                    cells.append("—"); continue
                r1, r2 = m.get((a, b)), m.get((b, a))
                wins = (r1["res"] == 1) + (r2["res"] == -1)
                loss = (r1["res"] == -1) + (r2["res"] == 1)
                cells.append(f"{wins}/{2-wins-loss}/{loss} ({r1['rem']})")
            md.append(f"| {NAMES[a]} | " + " | ".join(cells) + " |\n")
        for a, bs in BEATS.items():
            for b in bs:
                r1, r2 = m[(a, b)], m[(b, a)]
                if r1["res"] == 1 and r2["res"] == -1:
                    ok += 1
        md.append(f"\n剋制成立 **{ok}/10**\n")
        summary["pentagon"] = ok
        if ok < 10:
            fails.append(f"剋制只成立 {ok}/10")

    if "league" in rows:
        L = rows["league"]
        dec = [r for r in L if r["res"] != 0]
        rem = [r["rem"] for r in dec]
        sec = [r["ticks"] / 20 for r in L]
        lock = [r["lock"] / 1000 for r in dec]
        lc = [r["lc"] for r in L]
        swing = [r["swing"] for r in dec]
        blow = pct(sum(1 for x in rem if x > 50), len(rem))
        close = pct(sum(1 for x in rem if x <= 30), len(rem))
        med_rem = st.median(rem) if rem else 0
        med_sec = st.median(sec)
        med_lock = st.median(lock) if lock else 0
        summary.update(league_games=len(L), median_rem=med_rem, blowout_pct=blow, close_pct=close, median_secs=med_sec,
                       median_lock=med_lock, lead_change_pct=pct(sum(1 for x in lc if x >= 1), len(lc)),
                       comeback_pct=pct(sum(1 for x in swing if x >= 15), len(swing)),
                       draw_pct=pct(len(L) - len(dec), len(L)), timeout_pct=pct(sum(1 for r in L if r["timeout"]), len(L)))
        md.append(f"\n## ② 陣型聯賽（訓練池 200 套 × 12 對手 × 交換左右 = {len(L)} 場）\n\n")
        md.append(f"| 指標 | 數值 | 目標 |\n|---|---|---|\n")
        md.append(f"| 勝方剩餘戰力中位數 | {med_rem}% | ≤30% |\n| 接近局（勝方剩 ≤30%） | {close}% | — |\n| 碾壓局（勝方剩 >50%） | {blow}% | <20% |\n")
        md.append(f"| 戰鬥秒數中位數 | {med_sec:.1f} | 35～75 |\n| 鎖定時間比中位數 | {med_lock:.2f} | ≥0.65 理想、<0.4 警示 |\n")
        md.append(f"| 有領先交換的場次 | {summary['lead_change_pct']}% | — |\n| 翻盤局（贏家曾落後 ≥15%） | {summary['comeback_pct']}% | — |\n")
        md.append(f"| 平手 | {summary['draw_pct']}% | — |\n| 時間到 | {summary['timeout_pct']}% | — |\n")
        if blow >= 20: fails.append(f"碾壓局 {blow}%")
        if not (35 <= med_sec <= 75): fails.append(f"秒數中位數 {med_sec:.1f}")
        if med_rem > 30: fails.append(f"勝方剩餘中位數 {med_rem}%")
        if med_lock < 0.4: warns.append(f"鎖定時間比中位數 {med_lock:.2f} < 0.4")
        # 兵種出場與勝率：依組成金額加權
        tw = [0.0] * 5; tg = [0.0] * 5
        for r in L:
            comp = r["comp"]; s = sum(comp) or 1
            for t in range(5):
                share = comp[t] / s
                tg[t] += share
                tw[t] += share * (1 if r["res"] == 1 else 0.5 if r["res"] == 0 else 0)
        md.append("\n兵種（依陣中金額比例加權）勝率：" + "、".join(f"{NAMES[t]} {pct(tw[t], tg[t])}%" for t in range(5)) + "\n")
        summary["type_winrate"] = [pct(tw[t], tg[t]) for t in range(5)]
        # 每套陣型勝率前 5
        per = {}
        for r in L:
            per.setdefault(r["a"], []).append(1 if r["res"] == 1 else 0.5 if r["res"] == 0 else 0)
        top = sorted(per.items(), key=lambda kv: -sum(kv[1]) / len(kv[1]))[:5]
        md.append("訓練池勝率前 5：" + "、".join(f"#{k} {pct(sum(v), len(v))}%" for k, v in top) + "\n")

    for key in sorted(k for k in rows if k.startswith("turns")):
        T = rows[key]
        dec = [r for r in T if r["first_won"] != 0]
        fw = pct(sum(1 for r in dec if r["first_won"] == 1), len(dec))
        ho = st.median([r["handoffs"] for r in T])
        sp = st.median([r["spent0"] + r["spent1"] for r in T]) / 2
        rule = T[0]["rule"]
        blue = pct(sum(1 for r in dec if (r["first"] == 0) == (r["first_won"] == 1)), len(dec))
        summary[f"{rule}_blue_win"] = blue
        summary[f"{rule}_first_win"] = fw
        summary[f"{rule}_handoffs"] = ho
        md.append(f"\n## ③ 先後手（{rule}，{len(T)} 場，雙方同一個會讀對方的 AI）\n先手勝率 **{fw}%**、藍方（左邊）勝率 {blue}%（不含平手 {len(T)-len(dec)} 場）；每局換人次數中位數 {ho}；每方平均花 {sp:.0f} 金\n")
        if fw > 55 or fw < 45:
            warns.append(f"{rule} 先手勝率 {fw}%（>55% 或 <45% 列入調查）")
        if blue > 55 or blue < 45:
            warns.append(f"{rule} 藍方（左邊）勝率 {blue}%：AI 或規則有左右偏差")

    if "search" in rows:
        S = sorted(rows["search"], key=lambda r: -r["fit_holdout"])
        best = S[0]
        summary["search_best_holdout"] = round(best["fit_holdout"] * 100)
        md.append(f"\n## ④ 萬用陣搜尋（{len(S)} 條爬山，各對 24 個保留陣演化，再對整個保留池 50 套驗證）\n")
        md.append("| 名次 | 保留池勝率 | 組成（劍/盾/弓/騎/刺 金額） | 代碼 |\n|---|---|---|---|\n")
        for i, r in enumerate(S[:5]):
            md.append(f"| {i+1} | {round(r['fit_holdout']*100)}% | {r['comp']} | `{r['code']}` |\n")
        md.append("\n「沒搜到」只代表在這個搜尋預算內沒找到，不等於證明不存在。\n")
        if best["fit_holdout"] > 0.65:
            warns.append(f"搜尋到保留池勝率 {round(best['fit_holdout']*100)}% 的陣型：要找至少兩種反制")

    if "counter" in rows:
        md.append("\n## ⑤ 離線反制庫\n| 原型 | 最佳反制勝率 | 代碼 |\n|---|---|---|\n")
        for r in sorted(rows["counter"], key=lambda r: r["template"]):
            md.append(f"| {r['name']} | {round(r['best_fit']*100)}% | `{r['code']}` |\n")

    md.append("\n## 紅線\n" + ("\n".join(f"- ✗ {x}" for x in fails) if fails else "- ✓ 全過") + "\n")
    md.append("\n## 警示（列入調查）\n" + ("\n".join(f"- ⚠ {x}" for x in warns) if warns else "- 無") + "\n")
    summary["fails"] = fails; summary["warns"] = warns
    open(os.path.join(folder, "report.md"), "w", encoding="utf-8").write("".join(md))
    json.dump(summary, open(os.path.join(folder, "summary.json"), "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    print("".join(md))
    sys.exit(1 if fails else 0)

if __name__ == "__main__":
    main()
extends SceneTree
## 殘局／教學驗證（優化方案 D、附錄 A）：每關隨機抽樣擺法，檢查
##  ① 什麼都不放（只有固定兵）會輸；② 至少兩類「兵種組合」能贏；③ 抽樣勝率 2%～70%（不太難也不太簡單；教學可到 95%）；
##  ④ ★★、★★★ 門檻至少各有一個解達成。
## 用法：godot --headless --path game --script res://tools/validate_puzzles.gd -- --id=p1 [--samples=300]
## 每關一行 "V {json}"。

const D = preload("res://scripts/core/unit_defs.gd")
const Army = preload("res://scripts/core/army.gd")
const Sim = preload("res://scripts/core/battle_sim.gd")
const P = preload("res://scripts/game/puzzles.gd")

func _init() -> void:
	var args := {}
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--") and "=" in a:
			var kv := a.substr(2).split("=", true, 1)
			args[kv[0]] = kv[1]
	var samples := int(args.get("samples", "300"))
	var ids: Array = [args["id"]] if args.has("id") else P.all_ids()
	for id in ids:
		print("V ", JSON.stringify(validate(P.get_puzzle(id), samples)))
	quit(0)

func run(pz: Dictionary, extra: Array) -> Sim:
	var a0: Army = P.player_army(pz)
	for e in extra:
		a0.units.append({"type": e[0], "col": e[1], "row": e[2]})
	var s := Sim.new(a0, P.enemy_army(pz))
	s.fast = true
	s.run_to_end()
	return s

func validate(pz: Dictionary, samples: int) -> Dictionary:
	var base := run(pz, [])
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(pz["id"])
	var wins := 0
	var classes := {}
	var best_rem := 0
	var min_spend := 999
	var example := []
	var allowed: Array = pz["allowed"]
	var fixed_cells := {}
	for f in pz["fixed"]:
		fixed_cells[Vector2i(f[1], f[2])] = true
	for i in samples:
		var left: int = pz["budget"]
		var extra: Array = []
		var used := {}
		var n := rng.randi_range(1, 6)
		for k in n:
			var t: int = allowed[rng.randi_range(0, allowed.size() - 1)]
			if D.cost(t) > left:
				continue
			for tries in 20:
				var c := Vector2i(rng.randi_range(0, 5), rng.randi_range(0, 8))
				if not fixed_cells.has(c) and not used.has(c):
					used[c] = true
					extra.append([t, c.x, c.y])
					left -= D.cost(t)
					break
		if extra.is_empty():
			continue
		var s := run(pz, extra)
		if s.winner == 0:
			wins += 1
			var types := {}
			var spend := 0
			for e in extra:
				types[e[0]] = true
				spend += D.cost(e[0])
			var key := types.keys()
			key.sort()
			classes[str(key)] = classes.get(str(key), 0) + 1
			var rem: int = s.power(0) * 100 / (s.budget * 1000)
			best_rem = maxi(best_rem, rem)
			min_spend = mini(min_spend, spend)
			if example.is_empty():
				example = extra
	var rate := wins * 100 / maxi(1, samples)
	var max_rate := 95 if pz.get("tutorial", false) else 70
	var need_classes := 1 if pz.get("tutorial", false) else 2
	var ok: bool = base.winner != 0 and classes.size() >= need_classes and rate >= 2 and rate <= max_rate \
		and best_rem >= int(pz["star2"]) and min_spend <= int(pz["star3"])
	return {"id": pz["id"], "ok": ok, "base_winner": base.winner, "win_rate": rate, "classes": classes.size(),
		"class_list": classes, "best_rem": best_rem, "min_spend": min_spend, "star2": pz["star2"], "star3": pz["star3"], "example": example}

