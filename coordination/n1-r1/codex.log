## 騎兵衝鋒累積（優化方案 B1）：只算「沿著這段衝鋒起始方向」的實際前進距離；
## 被推開的位移不算；方向跟起始方向差太多（逐步轉彎也算）就重新開始；被擋住前進不到一半就歸零。
func _update_charge(u: Unit, moved_x: int, moved_y: int) -> void:
	if u.mx == 0 and u.my == 0:
		return   # 沒有提出移動（停下攻擊或等待），在第⑤步處理
	var ml := M.isqrt(u.mx * u.mx + u.my * u.my)
	var along := (moved_x * u.mx + moved_y * u.my) / maxi(1, ml)
	if along * 2 < ml:
		u.charge = 0
		u.cdx = 0
		u.cdy = 0
		return
	if u.charge == 0 or not _same_dir(u.cdx, u.cdy, u.mx, u.my):
		u.charge = along
		u.cdx = u.mx
		u.cdy = u.my
	else:
		u.charge += along

## 騎兵繞翼：目標是弓手、直線上 FLANK_DETECT 內有盾兵時，往敵兵較少的那側偏 FLANK_OFFSET 走途經點。
func _flank_waypoint(i: int, t: int) -> Vector2i:
	var u := units[i]
	var tg := units[t]
	if tg.type != D.ARCHER:
		u.wp_for = -1
		return Vector2i(-1, -1)
	if u.wp_for == tg.id:
		if M.dist2(u.x, u.y, u.wp_x, u.wp_y) > 400 * 400:
			return Vector2i(u.wp_x, u.wp_y)
		return Vector2i(-1, -1)   # 已經到過途經點，直衝
	var dx := tg.x - u.x
	var dy := tg.y - u.y
	var l2 := dx * dx + dy * dy
#!/usr/bin/env python3
"""平衡工具 2.0 報表：合併 balance.sh 各分片的 JSONL，檢查紅線，寫 report.md 與 summary.json。
用法：balance_report.py <資料夾> [總秒數]
結束碼：0＝紅線全過；1＝有紅線失敗；2＝資料錯誤（零筆、數值摘要不一致）。
紅線（優化方案 M）：
  - 剋制五角形 10/10（matrix：剋的一方左右各打一次都要贏）
  - 碾壓局（勝方剩 >50%）< 20%
  - 戰鬥秒數中位數 35～75
  - 勝方剩餘戰力中位數 ≤ 30%
