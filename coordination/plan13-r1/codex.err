  1382	func cmd_can(team: int, s: int) -> bool:
  1383		return cmd_on and not finished and s >= 0 and s < CMD.COUNT and int(cmd_left[team][s]) > 0 and tick >= int(cmd_ready[team][s])
  1384	
  1385	## 玩家按下：下一 tick 生效。重播時不接受。
  1386	func cast(team: int, s: int) -> bool:
  1387		if cmd_scripted or not cmd_can(team, s):
  1388			return false
  1389		for p in cmd_pending:
  1390			if p[0] == team and p[1] == s:
  1391				return false
  1392		cmd_pending.append([team, s])
  1393		return true
