     1	extends SceneTree
     2	## 殘局／教學驗證（優化方案 D、附錄 A）：每關隨機抽樣擺法，檢查
     3	##  ① 什麼都不放（只有固定兵）會輸；② 至少兩類「兵種組合」能贏；③ 抽樣勝率 2%～70%（不太難也不太簡單；教學可到 95%）；
     4	##  ④ ★★、★★★ 門檻至少各有一個解達成。
     5	## 用法：godot --headless --path game --script res://tools/validate_puzzles.gd -- --id=p1 [--samples=300]
     6	## 每關一行 "V {json}"。
     7	
     8	const D = preload("res://scripts/core/unit_defs.gd")
     9	const Army = preload("res://scripts/core/army.gd")
    10	const Sim = preload("res://scripts/core/battle_sim.gd")
    11	const P = preload("res://scripts/game/puzzles.gd")
    12	
    13	func _init() -> void:
    14		var args := {}
    15		for a in OS.get_cmdline_user_args():
    16			if a.begins_with("--") and "=" in a:
    17				var kv := a.substr(2).split("=", true, 1)
    18				args[kv[0]] = kv[1]
    19		var samples := int(args.get("samples", "300"))
    20		var ids: Array = [args["id"]] if args.has("id") else P.all_ids()
    21		var all_ok := true
    22		for id in ids:
    23			var r := validate(P.get_puzzle(id), samples)
    24			all_ok = all_ok and bool(r["ok"])
    25			print("V ", JSON.stringify(r))
    26		quit(0 if all_ok else 1)
    27	
    28	func run(pz: Dictionary, extra: Array) -> Sim:
    29		var a0: Army = P.player_army(pz)
    30		for e in extra:
    31			a0.units.append({"type": e[0], "col": e[1], "row": e[2]})
    32		var s := Sim.new(a0, P.enemy_army(pz))
    33		s.fast = true
    34		s.run_to_end()
    35		return s
    36	
    37	func validate(pz: Dictionary, samples: int) -> Dictionary:
    38		var base := run(pz, [])
    39		var rng := RandomNumberGenerator.new()
    40		rng.seed = hash(pz["id"])
    41		var wins := 0
    42		var classes := {}
    43		var best_rem := 0
    44		var min_spend := 999
    45		var three_star := false
    46		var examples := {}
    47		var allowed: Array = pz["allowed"]
    48		var fixed_cells := {}
    49		for f in pz["fixed"]:
    50			fixed_cells[Vector2i(f[1], f[2])] = true
    51		for i in samples:
    52			var left: int = pz["budget"]
    53			var extra: Array = []
    54			var used := {}
    55			var n := rng.randi_range(1, 6)
    56			for k in n:
    57				var t: int = allowed[rng.randi_range(0, allowed.size() - 1)]
    58				if D.cost(t) > left:
    59					continue
    60				for tries in 20:
    61					var c := Vector2i(rng.randi_range(0, 5), rng.randi_range(0, 8))
    62					if not fixed_cells.has(c) and not used.has(c):
    63						used[c] = true
    64						extra.append([t, c.x, c.y])
    65						left -= D.cost(t)
    66						break
    67			if extra.is_empty():
    68				continue
    69			var s := run(pz, extra)
    70			if s.winner == 0:
    71				wins += 1
    72				var types := {}
    73				var spend := 0
    74				for e in extra:
    75					types[e[0]] = true
    76					spend += D.cost(e[0])
    77				var key := types.keys()
    78				key.sort()
    79				classes[str(key)] = classes.get(str(key), 0) + 1
    80				var rem: int = s.power(0) * 100 / (s.budget * 1000)
    81				best_rem = maxi(best_rem, rem)
    82				min_spend = mini(min_spend, spend)
    83				if rem >= int(pz["star2"]) and spend <= int(pz["star3"]):
    84					three_star = true
    85				if not examples.has(str(key)) and examples.size() < 2:
    86					examples[str(key)] = extra
    87		var rate := wins * 100 / maxi(1, samples)
    88		# 新兵試玩（第四輪 trial）：和教學一樣只要一類解、勝率上限 95%；隨機抽樣很難抽中時，用標準解確認三星可達、勝率下限 1%
    89		var easy: bool = pz.get("tutorial", false) or pz.get("trial", false)
    90		var max_rate := 95 if easy else 70
    91		var need_classes := 1 if easy else 2
    92		var min_rate := 1 if pz.get("trial", false) else 2
    93		if pz.get("trial", false) and not three_star:
    94			for sol in pz.get("solutions", []):
    95				var chk: Army = P.player_army(pz)
    96				var legal := true
    97				for e in sol:
    98					if chk.check_place(int(e[0]), int(e[1]), int(e[2])) != "" or not pz["allowed"].has(float(e[0])) and not pz["allowed"].has(int(e[0])):
    99						legal = false
   100					chk.place(int(e[0]), int(e[1]), int(e[2]))
   101				if not legal:
   102					continue   # 不合法的標準解不能拿來證明三星可達（Codex 第 3 輪 #7）
   103				var ss := run(pz, sol)
   104				var sp := 0
   105				for e in sol:
   106					sp += D.cost(int(e[0]))
   107				if ss.winner == 0 and ss.power(0) * 100 / (ss.budget * 1000) >= int(pz["star2"]) and sp <= int(pz["star3"]):
   108					three_star = true
   109		var ok: bool = base.winner != 0 and classes.size() >= need_classes and rate >= min_rate and rate <= max_rate \
   110			and three_star
   111		return {"id": pz["id"], "ok": ok, "base_winner": base.winner, "win_rate": rate, "classes": classes.size(),
   112			"class_list": classes, "best_rem": best_rem, "min_spend": min_spend, "three_star": three_star, "star2": pz["star2"], "star3": pz["star3"], "solutions": examples.values()}

