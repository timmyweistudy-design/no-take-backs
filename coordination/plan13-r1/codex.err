    10	func judge(g, spec: Array, e) -> Array:
    11		var a = g.armies[0].copy()
    12		a.units = []
    13		for u in spec:
    14			a.place_xy(int(u[0]), a.world_x(int(u[1])), int(u[2]))
    15		if a.units.is_empty() or not a.has_combat():
    16			return [0, 0, 0, a, -1000000]
    17		var s = Sim.new(a.copy(), e.copy(), g.rules)
    18		s.fast = true
    19		s.run_to_end()
    20		var st := 0
    21		var rem: int = P.rem_pct(s.power(0), s.budget_of(0))
    22		if s.winner == 0:
    23			st = g.trial_stars(int(g.TRIALS[g.trial_id][3]), rem, a.spent(), a.budget, g.trial_spend_pct(g.trial_id))
    24		return [st, rem, a.spent() * 100 / a.budget, a, s.power(0) - s.power(1)]
    25	
    26	func score(j: Array) -> int:
    27		var over: int = maxi(0, int(j[2]) - 80)      # 第 8 關門檻 85% 不特別處理，搜尋只會更保守
    28		return int(j[0]) * 100000000 + int(j[4]) / 10 + int(j[1]) * 100 - over * 300
    29	
    30	func rand_spec(types: Array, g, r: RandomNumberGenerator) -> Array:
    31		var out: Array = []
    32		var a = g.armies[0]
    33		var left: int = a.budget      # 先用滿預算找贏法，爬山再省錢
    34		for k in 30:
    35			var t: int = types[r.randi_range(0, types.size() - 1)]
    36			if D.cost(t) > left:
    37				continue
    38			out.append([t, 200 + r.randi_range(0, 110) * 50, 400 + r.randi_range(0, (a.fh - 800) / 50) * 50])
    39			left -= D.cost(t)
    40		return out
    41	
    42	func mutate(sp: Array, types: Array, g, r: RandomNumberGenerator) -> Array:
    43		var s2: Array = sp.duplicate(true)
    44		var fh: int = g.armies[0].fh
    45		match r.randi_range(0, 3):
    46			0:
    47				if not s2.is_empty():
    48					var i := r.randi_range(0, s2.size() - 1)
    49					s2[i][1] = clampi(int(s2[i][1]) + r.randi_range(-20, 20) * 50, 200, 5800)
    50					s2[i][2] = clampi(int(s2[i][2]) + r.randi_range(-20, 20) * 50, 300, fh - 300)
    51			1:
    52				if not s2.is_empty():
    53					s2[r.randi_range(0, s2.size() - 1)][0] = types[r.randi_range(0, types.size() - 1)]
    54			2:
    55				if not s2.is_empty():
    56					s2.remove_at(r.randi_range(0, s2.size() - 1))
    57			3:
    58				s2.append([types[r.randi_range(0, types.size() - 1)], 200 + r.randi_range(0, 110) * 50, 400 + r.randi_range(0, (fh - 800) / 50) * 50])
    59		return s2
    60	
    61	func _init() -> void:
    62		var want := -1
    63		var iters := 240
    64		var seed_off := 0
    65		for x in OS.get_cmdline_user_args():
    66			if x.begins_with("--id="):
    67				want = int(x.substr(5))
    68			if x.begins_with("--iters="):
    69				iters = int(x.substr(8))
    70			if x.begins_with("--seed="):
    71				seed_off = int(x.substr(7))
    72		var g = load("res://scripts/ui/game_screens.gd").new()
    73		g.sfx = FAKE.FakeSfx.new()
    74		g.time = 1.0
    75		load("res://scripts/game/save.gd").data_locked = true
    76		for i in g.TRIALS.size():
    77			if want >= 0 and i != want:
    78				continue
    79			g._start_trial(i)
    80			g._build_ai()
    81			var e = g.armies[1].copy()
    82			var types: Array = load("res://scripts/core/ruleset.gd").types_of(g.armies[0].pool)
    83			var rr := RandomNumberGenerator.new()
    84			rr.seed = 880 + i + seed_off
    85			var best: Array = []
    86			var bj: Array = [0, 0, 0, null, 0]
    87			var bs: int = LOW
    88			for restart in 6:
    89				var cur: Array = rand_spec(types, g, rr)
    90				var cj: Array = judge(g, cur, e)
    91				var cs: int = score(cj)
    92				for it in iters / 4:
    93					var c2: Array = mutate(cur, types, g, rr)
    94					var j2: Array = judge(g, c2, e)
    95					var s2: int = score(j2)
    96					if s2 >= cs:
    97						cur = c2
    98						cj = j2
    99						cs = s2
   100					if int(cj[0]) == 3:
   101						break
   102				if cs > bs:
   103					bs = cs
   104					best = cur
   105					bj = cj
   106				if int(bj[0]) == 3:
   107					break
   108			var names: Dictionary = {}
   109			for u in best:
   110				names[int(u[0])] = int(names.get(int(u[0]), 0)) + 1
   111			print("TRIAL ", JSON.stringify({"i": i + 1, "map": g.TRIALS[i][0], "size": g.TRIALS[i][1], "style": g.TRIALS[i][2], "level": g.TRIALS[i][3], "budget": g.armies[0].budget, "enemy_n": e.units.size(), "stars": bj[0], "rem": bj[1], "spent_pct": bj[2], "types": names, "spec": best}))
   112		g.free()
   113		quit()

