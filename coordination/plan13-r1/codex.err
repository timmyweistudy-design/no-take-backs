   117	func _accept_challenge(c := "") -> void:
   118		var from_clip := c == ""
   119		if from_clip:
   120			c = DisplayServer.clipboard_get().strip_edges()
   121		var d := _challenge_decode(c.strip_edges())
   122		if not d["ok"]:
   123			if not (from_clip and _ask_code(L.t("ch_accept"), _accept_challenge)):
   124				_toast(L.t("ch_bad"), true)
   125			return
   126		rules = d["rules"]
   127		challenge_army = d["army"]
   128		rules.rounds = 1
   129		_start_mode(Mode.VS_AI)
   130	
   131	## 回傳 {ok, rules, army}。陣型一定要照那組規則合法。
   132	func _challenge_decode(c: String) -> Dictionary:
   133		var bad := {"ok": false}
   134		var parts := c.split(".")
   135		if c.length() > 6000 or parts.size() != 3 or parts[0] != "NTC1" or parts[1].sha256_text().substr(0, 6) != parts[2]:
   136			return bad
   137		var b64 := parts[1].replace("-", "+").replace("_", "/")
   138		while b64.length() % 4 != 0:
   139			b64 += "="
   140		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
   141		if not j is Dictionary or not j.get("a") is String or not j.get("r") is String:
   142			return bad
   143		var rd: Dictionary = RuleSet.from_code(str(j["r"]))
   144		if not rd["ok"] or rd["rules"].fullfield != RuleSet.FULL_NONE:
   145			return bad      # 全場規則是雙方互相看得到才成立，不能當挑戰碼（Codex r2 #3）
   146		var r = rd["rules"]
   147		r.ai_pool_same = false
   148		# 碼是對方當藍軍排的，到這裡他變紅軍：兩邊的預算、卡池要對調（讓子局才有差，Codex #10）
   149		var b0: int = r.budget_of(0)
   150		var b1: int = r.budget_of(1)
