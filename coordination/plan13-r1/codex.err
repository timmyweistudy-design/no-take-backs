    48				var c := Vector2i(rng.randi_range(0, 5), rng.randi_range(0, 8))
    49				if not fixed.has(c) and extra.filter(func(e): return e[1] == c.x and e[2] == c.y).is_empty():
    50					extra.append([t, c.x, c.y])
    51					left -= D.cost(t)
    52					break
    53		return extra
