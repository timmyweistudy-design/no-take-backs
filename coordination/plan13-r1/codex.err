   171						cmd_ready[tm].append(CMD.START_TICKS)
   172		atk_pct.resize(F8.DRAW_TOTAL)
   173		atk_pct.fill(100)
   174		if rules != null:
   175			for t in rules.stat_pct:
   176				atk_pct[int(t)] = int(rules.stat_pct[t][1])
   177		_hash.start(HashingContext.HASH_SHA256)
   178		var raw: Array = []
