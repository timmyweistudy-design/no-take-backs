     1	extends SceneTree
     2	## 新兵試玩殘局的設計輔助（第四輪 §4.8）。每關：
     3	##   ① 隨機抽樣（和 validate_puzzles 相同的抽法）量勝率與兵種組合數
     4	##   ② 爬山搜尋「最好的擺法」兩次：允許全部兵種、拿掉新兵。新兵要真的是解題關鍵（有新兵的最佳解明顯比較好）
     5	##   ③ 找兩組含新兵、組合不同的標準解
     6	## 用法：godot --headless --path game --script res://tools/balance/design_new_puzzles.gd [-- --id=n1 --samples=400 --iters=300]
     7	const D = preload("res://scripts/core/unit_defs.gd")
     8	const Army = preload("res://scripts/core/army.gd")
     9	const Sim = preload("res://scripts/core/battle_sim.gd")
    10	const P = preload("res://scripts/game/puzzles.gd")
    11	
    12	func run(pz: Dictionary, extra: Array) -> Sim:
    13		var a0: Army = P.player_army(pz)
    14		for e in extra:
    15			a0.units.append({"type": e[0], "col": e[1], "row": e[2]})
    16		var s := Sim.new(a0, P.enemy_army(pz))
    17		s.fast = true
    18		s.run_to_end()
    19		return s
    20	
    21	## 分數：輸＝剩餘戰力差（負）；贏＝1000＋剩餘%。
    22	func score(pz: Dictionary, extra: Array) -> Array:
    23		var s := run(pz, extra)
    24		var tot: int = s.budget * 1000
    25		if s.winner == 0:
    26			return [1000 + s.power(0) * 100 / tot, s.power(0) * 100 / tot]
    27		return [(s.power(0) - s.power(1)) * 100 / tot, -1]
    28	
    29	func legal(pz: Dictionary, extra: Array) -> bool:
    30		var a0: Army = P.player_army(pz)
    31		for e in extra:
    32			if a0.check_place(int(e[0]), int(e[1]), int(e[2])) != "":
    33				return false
    34			a0.place(int(e[0]), int(e[1]), int(e[2]))
    35		return true
    36	
    37	func random_extra(pz: Dictionary, allowed: Array, rng: RandomNumberGenerator) -> Array:
    38		var left: int = pz["budget"]
    39		var extra: Array = []
    40		var fixed := {}
    41		for f in pz["fixed"]:
    42			fixed[Vector2i(f[1], f[2])] = true
    43		for k in 8:
    44			var t: int = allowed[rng.randi_range(0, allowed.size() - 1)]
    45			if D.cost(t) > left:
    46				continue
    47			for tries in 20:
    48				var c := Vector2i(rng.randi_range(0, 5), rng.randi_range(0, 8))
    49				if not fixed.has(c) and extra.filter(func(e): return e[1] == c.x and e[2] == c.y).is_empty():
    50					extra.append([t, c.x, c.y])
    51					left -= D.cost(t)
    52					break
    53		return extra
    54	
    55	func mutate(pz: Dictionary, extra: Array, allowed: Array, rng: RandomNumberGenerator) -> Array:
    56		var e2: Array = extra.duplicate(true)
    57		var op := rng.randi_range(0, 3)
    58		if e2.is_empty():
    59			op = 3
    60		match op:
    61			0:
    62				var i := rng.randi_range(0, e2.size() - 1)
    63				e2[i][1] = clampi(int(e2[i][1]) + rng.randi_range(-1, 1), 0, 5)
    64				e2[i][2] = clampi(int(e2[i][2]) + rng.randi_range(-2, 2), 0, 8)
    65			1:
    66				var i2 := rng.randi_range(0, e2.size() - 1)
    67				e2[i2][0] = allowed[rng.randi_range(0, allowed.size() - 1)]
    68			2:
    69				e2.remove_at(rng.randi_range(0, e2.size() - 1))
    70			3:
    71				e2.append([allowed[rng.randi_range(0, allowed.size() - 1)], rng.randi_range(0, 5), rng.randi_range(0, 8)])
    72		return e2 if legal(pz, e2) else extra
    73	
    74	func climb(pz: Dictionary, allowed: Array, iters: int, seed_: int) -> Dictionary:
    75		var rng := RandomNumberGenerator.new()
    76		rng.seed = seed_
    77		var best: Array = []
    78		var bs := [-9999, -1]
    79		for restart in 4:
    80			var cur := random_extra(pz, allowed, rng)
    81			var cs := score(pz, cur)
    82			for it in iters / 4:
    83				var cand := mutate(pz, cur, allowed, rng)
    84				var sc := score(pz, cand)
    85				if sc[0] >= cs[0]:
    86					cur = cand
    87					cs = sc
    88			if cs[0] > bs[0]:
    89				bs = cs
    90				best = cur
    91		return {"score": bs[0], "rem": bs[1], "extra": best}
    92	
    93	func _init() -> void:
    94		var args := {}
