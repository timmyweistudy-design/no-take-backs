    66		rng.seed = 4242
    67		for restart in 6:
    68			var cur: Array = best.duplicate(true) if restart < 2 else []
    69			var cs: int = score(pz, cur) if not cur.is_empty() else LOW
    70			for it in iters / 6:
    71				var c2: Array = mutate(pz, cur, allowed, rng)
    72				var s2: int = score(pz, c2) if not c2.is_empty() else LOW
    73				if s2 >= cs:
    74					cur = c2
    75					cs = s2
    76				if cs >= 300000:
    77					break
    78			if cs > bs:
    79				bs = cs
    80				best = cur
    81			if bs >= 300000:
    82				break
    83		return best
