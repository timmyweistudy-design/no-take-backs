    56	func search(pz: Dictionary, iters: int) -> Array:
    57		var allowed: Array = pz["allowed"]
    58		var best: Array = []
    59		var bs: int = LOW
    60		for sol in pz.get("solutions", []):
    61			var sc: int = score(pz, sol)
    62			if sc > bs:
    63				bs = sc
    64				best = sol
