   180		# 格子部署走原本的 id（隊伍×1000＋列×16＋欄），雜湊位元組和 1.3.0 相同。
   181		free = str(army0.get("deploy")) == "free" or str(army1.get("deploy")) == "free"
   182		var mixed: bool = str(army0.get("deploy")) != str(army1.get("deploy"))
   183		for a in [army0, army1]:
   184			if free:
   185				var lst: Array = []
   186				for u in a.units:
   187					var pp: Vector2i = Army.pos_of(u)
   188					var ox: int = pp.x if a.team == 0 else fw - pp.x
   189					lst.append([pp.y * 100000 + ox, u, pp])
   190				lst.sort_custom(func(p, q): return p[0] < q[0])
   191				for k in lst.size():
   192					raw.append([a.team * 1000 + k, a.team, lst[k][1], lst[k][2], k])
   193			else:
   194				for u in a.units:
   195					raw.append([a.team * 1000 + u["row"] * COLS + u["col"], a.team, u, Vector2i(u["col"] * CELL + CELL / 2, u["row"] * CELL + CELL / 2), -1])
   196		raw.sort_custom(func(p, q): return p[0] < q[0])
   197		for r in raw:
   198			var u = r[2]
   199			var s: Dictionary = D.stat(u["type"])
   200			var n := Unit.new()
   201			n.id = r[0]
   202			n.team = r[1]
