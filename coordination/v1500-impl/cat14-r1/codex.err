   364					var dm: Array = Presets.DEMO_MAPS
   365					r.map_id = dm[wrapi(dm.find(r.map_id) + d, 0, dm.size())]
   366				else:
   367					r.map_id = wrapi(r.map_id + d, 0, MapDefs.MAPS.size())
   368				if not r.map_is_default() and r.deploy != "free":
   369					r.deploy = "free"
   370					r.spacing = 800
   371					r.depth = 6000
   372					r.fullfield = 0
   373			"ai_style":
   374				r.ai_style = wrapi(r.ai_style + d, 0, RuleSet.AI_STYLES)
   375			"map_mode":
   376				r.map_mode = wrapi(r.map_mode + d, 0, 3)
   377			"bans":
   378				r.bans = wrapi(r.bans + d, 0, 3)
   379			"time_of":
   380				r.time_of = wrapi(r.time_of + d, 0, 3)
   381			"budget":
   382				r.budget[0] = clampi(int(r.budget[0]) + 10 * d, RuleSet.BUDGET_MIN, RuleSet.BUDGET_MAX)
   383				if not r.handicap:
   384					r.budget[1] = r.budget[0]
   385			"handicap":
   386				r.handicap = not r.handicap
   387				if not r.handicap:
   388					r.budget[1] = r.budget[0]
   389			"budget_red":
   390				r.budget[1] = clampi(int(r.budget[1]) + 10 * d, RuleSet.BUDGET_MIN, RuleSet.BUDGET_MAX)
   391			"unit_cap":
   392				r.unit_cap = clampi(r.unit_cap + 2 * d, RuleSet.UNIT_CAP_MIN, RuleSet.UNIT_CAP_MAX)
   393			"type_cap":
   394				r.type_cap = clampi(r.type_cap + d, 0, RuleSet.TYPE_CAP_MAX)
   395			"ticks":
   396				r.ticks = _step_in(r.ticks, RuleSet.TICK_CHOICES, d)
   397			"rounds":
   398				r.rounds = _step_in(r.rounds, RuleSet.ROUND_CHOICES, d)
   399			"place_rule":
   400				var opts := RuleSet.PLACE_RULES
   401				r.place_rule = opts[posmod(opts.find(r.place_rule) + d, opts.size())]
   402			"turns":
   403				r.turns = clampi(r.turns + d, RuleSet.TURNS_MIN, RuleSet.TURNS_MAX)
   404			"carry":
   405				r.carry = not r.carry
   406			"ai_level":
   407				r.ai_level = clampi(r.ai_level + d, 0, 1 if _demo() else 2)
   408			"keep":
   409				r.keep_formation = not r.keep_formation
   410			"adj":
   411				r.adj = not r.adj   # V1.6 #22 相鄰陣法
   412				if r.adj:
   413					r.synergy = false   # 1.2.0：協同技和相鄰陣法互斥，開相鄰就關協同（不然輸出讀不回的碼）
   414			"deploy":
   415				# 第六輪：格子／自由；切到格子時部署欄位回到舊值（NTBR1）
   416				if r.deploy == "grid":
   417					r.deploy = "free"
   418					r.spacing = Presets.FREE_SPACING
   419					r.depth = Presets.FREE_DEPTH
   420				else:
   421					r.deploy = "grid"
   422					r.spacing = 1000
   423					r.depth = RuleSet.DEPTH_GRID
   424					r.fullfield = RuleSet.FULL_NONE
   425			"spacing":
   426				if r.deploy == "free":
   427					r.spacing = clampi(r.spacing + 50 * d, RuleSet.SPACING_MIN, RuleSet.SPACING_MAX)
   428			"depth":
   429				if r.deploy == "free":
   430					r.depth = clampi(r.depth + 500 * d, RuleSet.DEPTH_MIN, RuleSet.DEPTH_MAX)
   431			"fullfield":
   432				if r.deploy == "free":
   433					var want := RuleSet.FULL_AI if lobby_kind == "ai" else RuleSet.FULL_DUEL
   434					r.fullfield = RuleSet.FULL_NONE if r.fullfield != RuleSet.FULL_NONE else want
   435					if r.fullfield == RuleSet.FULL_DUEL and r.place_rule == "blind":
   436						r.place_rule = "snake5"
   437			"ai_pool_same":
   438				r.ai_pool_same = not r.ai_pool_same
   439				if not r.ai_pool_same:
   440					r.pool[1] = r.pool[0]
   441		_lobby_touch()
