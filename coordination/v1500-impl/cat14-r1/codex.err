   443	func _lobby_toggle_unit(team: int, t: int) -> void:
   444		lobby_item = "pool"
   445		lobby_brief = t      # 觸控沒有懸停：點一下也會講這隻
   446		var sel := Presets.selectable(lobby_kind, _lobby_unlocked(), _demo())
   447		if not RuleSet.has(sel, t):
   448			_toast(L.t("lb_locked_unit"), true)
   449			return
   450		# 第八輪：一局每邊最多 10 種
   451		if not RuleSet.has(int(lobby_r.pool[team]), t) and RuleSet.pool_count(int(lobby_r.pool[team])) >= RuleSet.ROSTER_MAX:
   452			_toast(L.t("lb_roster_full"), true)
   453			return
   454		lobby_r.pool[team] = int(lobby_r.pool[team]) ^ (1 << t)
   455		if lobby_r.ai_pool_same:
   456			lobby_r.pool[1] = lobby_r.pool[0]
   457		_lobby_touch()
