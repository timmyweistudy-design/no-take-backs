   592	## 1.4.0 R12：預設分頁高度——字級 150% 時兩行字要上下各留 max(4, 12%)，分頁從 68 長到 78。
   593	func lobby_tab_h() -> float:
   594		if tz("B") < 22:
   595			return 68.0
   596		# 只有真的有分頁要換兩行時才長高（日文改短後全部一行，就不留空，Antigravity v140 cat01 #5）
   597		var tw_min := 154.0 - 6.0 - BM_SLOT
   598		var te := tw_min - 2.0 * (maxf(6.0, tw_min * 0.06) + 1.0)
   599		for id in Presets.IDS:
   600			if wrap_lines(L.t("lb_p_" + id), fit(L.t("lb_p_" + id), tz("B"), te, true), te, true).size() > 1:
   601				return 78.0
   602		return 68.0
