  1028				if not _fp_pad_button(int(c["data"]["b"]), bool(c["data"]["pressed"])) and c["data"]["pressed"]:
  1029					var mp := {JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_B: KEY_ESCAPE}
  1030					if mp.has(int(c["data"]["b"])):
  1031						_key(mp[int(c["data"]["b"])])
  1032				done += 1
  1033			elif c["kind"] == "key":
  1034				_key(int(c["data"]))
  1035				done += 1
  1036			elif c["kind"] == "pan":
  1037				cam_pan(c["data"])
  1038			elif c["kind"] == "tool":
  1039				if state == St.PLACE and overlay == "":
  1040					call("_deploy_tool", str(c["data"]))
  1041				done += 1
  1042			_update_gen()
  1043		return done
