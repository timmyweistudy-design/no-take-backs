  1036			_box(rd.grow(8).intersection(scr), Color(0, 0, 0, 0), Color(INK, 0.9), 12.0, 2.0)
  1037		if layout_probe:
  1038			probe_btns.append(r)
  1039			if label == "":
  1040				probe_ctrls.append(r)   # 空白標籤的按鈕（卡片、頁籤）：裡面自己畫的字算按鈕內容
  1041		# 1.2.0：按鈕字級看實際面高（扣下緣厚度與木牌毛邊）：放得下正文字就用正文字，不然用小一級（都在字級表內，比 1.1.0 同層大）
  1042		var face_h: float = r.size.y - 3.0 - 6.0
  1043		var lw := r.size.x - 2.0 * (maxf(6.0, r.size.x * 0.06) + 1.0)   # 1.4.0 R12：標籤左右各留 max(6, 6% 寬)（原本只留 5px）
  1044		# 字級照原本的寬度選（不因為加內距而多降一級，Codex v140 cat01 #4）；內距只影響換行
  1045		var sz := fit(label, ts(18) if r.size.y >= 40 and face_h >= ts(18) * 1.3 else ts(15), r.size.x - 10, primary)
  1046		var lines := wrap_lines(label, sz, lw, primary)
  1047		if lines.size() > 1 and lines.size() * sz * 1.25 > face_h:
  1048			# 加了內距會換成放不下的兩行：退回原本的寬度（這顆按鈕要靠加寬或改短解決，R12 會擋）
  1049			lines = wrap_lines(label, sz, r.size.x - 10, primary)
  1050		_probe_btn_label = true   # 版面檢查：這段是按鈕自己的標籤（不用位置猜，Antigravity 實作第 2 輪抓到猜錯的情況）
  1051		_probe_btn_rect = r
  1052		if wax_face_cut > 0.0:
  1053			rd = rd.grow_individual(-wax_face_cut, 0.0, 0.0, 0.0)
  1054			wax_face_cut = 0.0
  1055		_probe_face = rd
  1056		_probe_cell_id = "btn%d" % idx
  1057		_probe_dis = not enabled
  1058		var ink0 := _ink_mode   # 按鈕是木頭，字維持白色（紙面按鈕用墨色）
  1059		_ink_mode = paper_face or (plaque and not primary and enabled) or (cloth and btn_cloth == "tab_linen" and enabled)   # 1.2.0：淺色木牌、原胚布用墨色字
  1060		var lab := "\n".join(lines)
  1061		# 1.3.0 R11：字的墨跡中心對準按鈕面中心（扣掉下緣厚度；按下時字跟著下沉）——光學置中，不是名目行高置中
  1062		_text(ink_center_p(rd, lab, sz, primary), lab, sz, Color.WHITE if enabled else (Color(0.16, 0.11, 0.07, 0.62) if plaque else Color(1, 1, 1, 0.4)), true, primary)
