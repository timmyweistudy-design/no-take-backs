   555			_btn(Rect2(244, by, 200, 48), L.t("lb_expand"), func(): lobby_open = not lobby_open)
   556		if not lobby_open:
   557			_btn(Rect2(458, by, 190, 48), L.t("lb_random"), _lobby_random)   # 隨機＝底列一顆有字的鈕（不再像第 4 個步驟；骰子圖示看不懂，Antigravity v150 cat03 r2 #2）
   558		var why := _lobby_block()
