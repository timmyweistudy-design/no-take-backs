   604	func _draw_lobby_presets(o: Vector2) -> void:
   605		btn_group = "lb_modes"   # 1.5.0 R14：頂緣模式紙籤＋「我的預設」＝一組分頁
   606		var w := 154.0
   607		var h := lobby_tab_h()
   608		for i in Presets.IDS.size():
   609			var id: String = Presets.IDS[i]
   610			var p = Presets.make(id, lobby_kind, _lobby_unlocked())
   611			Presets.clamp_pool(p, lobby_kind, _lobby_unlocked(), _demo())
   612			var r := Rect2(o + Vector2(i * (w + 10), 0), Vector2(w, h))
   613			var on: bool = lobby_r.preset == id
   614			# V1.5.2 L2（A 案）：選中分頁的紅書籤上緣貼分頁上緣、在右側垂下；畫在分頁底面之後、焦點框之前（不蓋手把焦點框）
   615			if on:
   616				btn_deco = _draw_bookmark
   617			btn_cloth = "tab_indigo" if on else "tab_linen"   # 1.2.0 第 4 大類：預設分頁是布標（和設定分頁同一套；選中靛藍、未選原胚布）
   618			_btn(r, "", _lobby_pick.bind(id), true, false, TH_ACTIVE if on else TH_WOOD)
   619			btn_cloth = ""
   620			var on_paper := last_btn_paper   # 原胚布：字用墨色
   621			btn_deco = Callable()
   622			if on:
   623				draw_rect(r, ACCENT, false, 3.0)
   624			# 只有選中的分頁讓出書籤槽（可用區 [6, w−BM_SLOT]）；沒選中的照整格置中（實作審查第 2 輪看圖：六格一律讓槽時
   625			# 沒書籤的分頁字明顯偏左）。要換兩行時中日文從中間斷（不留「決」「種」單字一行），從上緣 5 起排，色條在 h−9
   626			var lab := L.t("lb_p_" + id)
   627			var tw := (w - 6.0 - BM_SLOT) if on else (w - 12.0)
   628			var tx := (6.0 + tw / 2) if on else w / 2
   629			var te := tw - 2.0 * (maxf(6.0, tw * 0.06) + 1.0)   # 1.4.0 R12：分頁字左右各留 max(6, 6% 寬)
   630			var two := wrap_lines(lab, fit(lab, tz("B"), te, true), te, true).size() > 1
   631			var lsz: int = tz("B")
   632			if two:
   633				lab = balance_two_lines(lab)
   634				# 兩行時字級取字級表裡第二行字形下緣（5＋2.53×字級）還在色條上方 2px 的最大一級（Antigravity 實作第 3 輪：平衡後一行變短，fit 不會縮）
   635				lsz = tz("C")
   636				for c in [tz("B"), tz("S"), tz("C")]:
   637					if 5.0 + 2.53 * c <= h - 11.0 and 2.3 * c <= (h - 14.0) * 0.76 and _width(lab, c, true) <= te:   # 1.4.0 R12：兩行墨跡上下也要留 12%
   638						lsz = c
   639						break
   640			_ink_mode = on_paper
   641			# 1.3.0 R11：字放在「色條以上」的文字區正中（原本從上緣固定 5／8 起排，字擠在上半）；選中時扣掉書籤槽
   642			var lsz2: int = fit(lab, lsz, te, true)
   643			var lab2: String = lab if two else "\n".join(wrap_lines(lab, lsz2, te, true))
   644			var tcell := Rect2(r.position.x + tx - tw / 2, r.position.y + 3, tw, h - 9 - 2 - 3)
   645			probe_cell_begin(tcell)
   646			_text(ink_center_p(tcell, lab2, lsz2, true), lab2, lsz2, Color.WHITE, true, true)
   647			probe_cell_end()
   648			_ink_mode = false
   649			var b := Presets.badge(p, lobby_kind)
   650			var bc: Color = {"cert": Color("#3fbf6a"), "fun": Color("#e8b33a"), "lab": Color("#a46be0")}[b]
   651			_box(Rect2(r.position + Vector2(8, h - 9), Vector2(w - 16, 4)), bc, Color(0, 0, 0, 0), 2.0)
   652		if layout_probe and Presets.IDS.has(lobby_r.preset):
   653			probe_need["bookmark"] = 1   # 漏登記守衛：選了內建預設就一定要畫出紅書籤
   654		btn_group = ""   # 「我的預設」開下拉選單，和模式紙籤（直接切換）語意不同：單獨計數（Codex v150 cat03 #4）
   655		var mr := Rect2(o + Vector2(6 * (w + 10), 0), Vector2(1120 - 6 * (w + 10), h))
   656		_btn(mr, L.t("lb_mine"), func(): lobby_menu = not lobby_menu, true, false, TH_ACTIVE if lobby_r.preset == "custom" else TH_WOOD)
   657	
   658	func _draw_lobby_menu(o: Vector2) -> void:
   659		var ps: Array = Save.data.get("rule_presets", [])
   660		var rows: int = clampi(ps.size(), 1, 5)
   661		var cols := 2 if ps.size() > 5 else 1
   662		o.x -= 240.0 * (cols - 1) + 30.0
   663		var act := 56.0   # 1.5.0 §1.2：複製／貼上規則、存成預設搬進這個選單（原本在折頁底列）
   664		var r := Rect2(o, Vector2(maxf(12 + cols * 240, 3 * 156 + 12), 12 + rows * 50 + act))
   665		if r.end.x > 1200.0:
   666			r.position.x = 1200.0 - r.size.x
   667		# 下拉選單蓋住的底層按鈕不能被點到（Antigravity v150-i2 #6）
   668		for bi in range(_btns.size() - 1, -1, -1):
   669			if r.intersects(_btns[bi]["r"]):
   670				_btns.remove_at(bi)
   671		if layout_probe:
   672			# 選單蓋住的底層字也不算（看不到；版面檢查不知道疊放順序）
   673			for ti in range(probe_texts.size() - 1, -1, -1):
   674				if r.intersects(probe_texts[ti]["r"]):
   675					probe_texts.remove_at(ti)
   676			for pi in range(probe_btns.size() - 1, -1, -1):
   677				if r.intersects(probe_btns[pi]):
   678					probe_btns.remove_at(pi)
   679		draw_rect(r, PANEL)
   680		draw_rect(r, Color(1, 1, 1, 0.3), false, 1.5)
   681		var acts := [["lb_copy", _lobby_copy_code], ["lb_save", _lobby_save_preset], ["lb_paste", _lobby_paste_code]]
   682		for ai in 3:
   683			_btn(Rect2(r.position + Vector2(6 + ai * 156, 6), Vector2(150, 44)), L.t(acts[ai][0]), acts[ai][1])
   684		draw_line(r.position + Vector2(6, act + 2), Vector2(r.end.x - 6, r.position.y + act + 2), Color(1, 1, 1, 0.2), 1.0)
   685		if ps.is_empty():
   686			_text(r.position + Vector2(r.size.x * 0.5, act + 18), L.t("lb_mine_empty"), tz("S"), TXT_DIM, true, false, r.size.x - 20)
   687			return
   688		for i in ps.size():
   689			var cp := r.position + Vector2(6 + (i / 5) * 240, act + 6 + (i % 5) * 50)
   690			_btn(Rect2(cp, Vector2(144, 44)), str(ps[i]["name"]), _lobby_load_preset.bind(i))
   691			_btn(Rect2(cp + Vector2(148, 0), Vector2(44, 44)), "", func(): DisplayServer.clipboard_set(str(ps[i]["code"])); _toast(L.t("lb_copied")))
   692			_icon("copy", cp + Vector2(170, 22), 18.0, Color.WHITE)
   693			_btn(Rect2(cp + Vector2(196, 0), Vector2(40, 44)), "×", _lobby_delete_preset.bind(i))
   694	
   695	## 卡池唯讀摘要：「10 種・近戰 4・遠程 3・支援 2・奇襲 1」（類別跟篩選膠囊同一套）
   696	func pool_summary(mask: int) -> String:
   697		var n := [0, 0, 0, 0]
   698		var tot := 0
   699		for t in D.total():
   700			if not RuleSet.has(mask, t):
   701				continue
   702			tot += 1
   703			if t in Presets.F8.RAID:
   704				n[3] += 1
   705			elif D.is_support(t):
   706				n[2] += 1
   707			elif D.is_melee(t):
   708				n[0] += 1
   709			else:
   710				n[1] += 1
   711		var parts: Array = [L.t("lb_pool_n", [tot])]
   712		for k in 4:
   713			if n[k] > 0:
   714				parts.append("%s %d" % [L.t("lb_filter_%d" % (k + 1)), n[k]])
   715		return "・".join(parts) if (L.lang.begins_with("zh") or L.lang == "ja") else " · ".join(parts)
   716	
   717	func _filter_hit(t: int) -> bool:
   718		match lobby_filter:
   719			1:
   720				return D.is_melee(t) and not D.is_support(t) and not t in Presets.F8.RAID
   721			2:
   722				return not D.is_melee(t) and not D.is_support(t) and not t in Presets.F8.RAID
   723			3:
   724				return D.is_support(t)
   725			4:
   726				return t in Presets.F8.RAID
   727		return true
   728	
   729	## 部署分頁的陣型小圖：看得到間距和縱深實際長怎樣。
   730	func _draw_deploy_preview(r: Rect2) -> void:
   731		var w: float = lobby_r.field_w()
   732		var h: float = lobby_r.field_h()
   733		var k: float = minf(r.size.x / w, r.size.y / h)
   734		var q := Rect2(r.position, Vector2(w, h) * k)
   735		draw_rect(q, Color("#5f8a45"))
