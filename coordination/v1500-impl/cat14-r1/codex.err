   563			_btn(Rect2(966, by, 234, 48), L.t("lb_next"), func(): _lobby_step_by(1), true, true)   # 1.5.0 §1.2：下一步
   564		else:
   565			btn_seal_square = true
   566			_btn(Rect2(966, by, 234, 48), L.t("lb_start"), _lobby_start, why == "", true)
   567			btn_seal_square = false
   568		var lb_why := ""
   569		if lobby_open:
   570			# 1.5.0 第 10、14 批：子分頁、卡池、類別、牌組、步進器、將領／軍令／技能格各算一組，代碼與存預設進「我的預設」選單，
   571			# 底列只剩收起＋開戰——折頁從 18～48 個控制降到 10～13；剩下是每一頁自己的規則列，再減要把規則列分頁
   572			lb_why = "進階折頁：每一頁自己的規則列（5 列以上）"
   573		elif lobby_menu:
   574			lb_why = "「我的預設」下拉選單展開時：選單本身是一張清單（每列讀取／存入／刪除）"
   575		screen_register("lobby", "lb_next" if (not lobby_open and lobby_step < 2) else "lb_start", lb_why)
   576		if not bool(Save.s("plain_ui")) and not lobby_open:
   577			# 1.4.0 §1.1：每次開戰在手帳右頁右下蓋一記方印，最多留 3 記（下次打開還在）
   578			var ns := mini(3, int(Save.data.get("lobby_stamps", 0)))
   579			for k in ns:
   580				var sc := Vector2(1150.0 - k * 34.0, 660.0 - (k % 2) * 8.0)
   581				draw_set_transform_matrix(ui_xf * Transform2D(0.08 * (k - 1), sc))
   582				draw_rect(Rect2(-13, -13, 26, 26), Color(PAL.TRINKET_RED, 0.42), false, 2.5)
   583				draw_rect(Rect2(-8, -8, 16, 16), Color(PAL.TRINKET_RED, 0.26))
   584				draw_set_transform_matrix(ui_xf)
