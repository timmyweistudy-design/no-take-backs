   548		if lobby_open:
   549			_btn(Rect2(80, by, 200, 48), L.t("lb_collapse"), func(): lobby_open = not lobby_open)   # 1.5.0 §1.2：折頁裡回去的路只有「收起」（Esc 照舊返回）
   550		else:
