  1020				done += _do_click(c["data"])
  1021			elif c["kind"] == "mb":
  1022				# 滑鼠按鍵（擺放、拖曳、移除）也走同一個佇列，和鍵盤選兵的先後順序一致（Codex S1 #2）
  1023				_mb_cmd(c["data"])
  1024				done += 1
  1025			elif c["kind"] == "paint":
