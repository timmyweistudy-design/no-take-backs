   191			k += 1   # 刪過中間那格也不會撞名
   192		var nm := L.t("lb_my_n", [k])
   193		ps.append({"name": nm, "code": lobby_r.to_code()})
   194		Save.data["rule_presets"] = ps
   195		Save.save_data()
   196		_toast(L.t("lb_saved", [nm]))
