diff --git a/game/tests/suites/ui.gd b/game/tests/suites/ui.gd
index a1b0c26..4bf0a1f 100644
--- a/game/tests/suites/ui.gd
+++ b/game/tests/suites/ui.gd
@@ -2337,3 +2337,52 @@ func test_input_matrix_v150() -> void:
 		Save.settings[k] = keep[k]
 	ok(n == 124, "輸入矩陣 124 組：來源 6 × 時機 4 × 組合 5＋回歸 4（%d）" % n)
 	ok(bad.is_empty(), "輸入矩陣全過：轉場中零穿透、放開零卡鎖、之後正常點擊不被吃", "\n".join(bad.slice(0, 20)))
+
+
+## 1.5.0 第 2 批：主動作登記＋R14、標題、結果首屏、兩步開戰
+func test_r14_v150() -> void:
+	var LR = load("res://scripts/ui/layout_rules.gd")
+	var has := func(out: Dictionary, lvl: String) -> bool:
+		for v in out[lvl]:
+			if str(v["type"]) == "R14":
+				return true
+		return false
+	ok(not has.call(LR.check({"screen": {"cls": "title", "main": "plaque_battle", "skip": ""}, "clicks": 9}), "fail"), "標題 9 個可點元件：通過")
+	ok(has.call(LR.check({"screen": {"cls": "title", "main": "plaque_battle", "skip": ""}, "clicks": 10}), "fail"), "標題 10 個：失敗（已改造的類別）")
+	var ex: Dictionary = LR.check({"screen": {"cls": "result", "main": "x", "skip": "測試理由"}, "clicks": 9})
+	ok(not has.call(ex, "fail") and not (ex["exempt"] as Array).is_empty(), "登記豁免理由：不算失敗、列進宣告例外")
+	ok(has.call(LR.check({"screen": {"cls": "settings", "main": "x", "skip": ""}, "clicks": 30}), "warn") and not has.call(LR.check({"screen": {"cls": "settings", "main": "x", "skip": ""}, "clicks": 30}), "fail"), "還沒改造的類別：超標只警告")
+	ok(has.call(LR.check({"screen": {"cls": "title", "main": "", "skip": ""}, "clicks": 3}), "fail"), "登記了類別卻沒有主動作：失敗")
+	ok(LR.check({"clicks": 99})["fail"].is_empty(), "沒登記的畫面不查 R14")
+	var GS = load("res://scripts/ui/game_screens.gd")
+	var g = GS.new()
+	g._btns.append({"r": Rect2(), "cb": func(): pass, "en": true})
+	g._btns.append({"r": Rect2(), "cb": func(): pass, "en": true, "grid": true})
+	ok(g.click_count() == 1, "棋盤格這類 grid 不算可點元件")
+	g.free()
+	var gm: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_menus.gd")
+	ok(gm.find("screen_register(\"title\", \"plaque_battle\")") >= 0 and gm.find("[\"menu_codes\", func(): overlay = \"codes\"") < 0, "標題登記主動作；代碼不在標題系統列")
+	ok(gm.find("[\"menu_codes\", \"hc_codes_d\", \"copy\"") >= 0, "代碼移到收藏第二層")
+	var gr: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_result.gd")
+	ok(gr.find("screen_register(\"result\"") >= 0 and gr.find("while bs.size() > RES_MAIN_MAX:") >= 0, "結果登記主動作；主動作最多 2 顆，其他進「更多」")
+
+func test_quick_rematch_v150() -> void:
+	var GS = load("res://scripts/ui/game_screens.gd")
+	var g = GS.new()
+	var Save = load("res://scripts/game/save.gd")
+	var keep = Save.data.get("last_rules", {})
+	Save.data["last_rules"] = {}
+	ok(not g.quick_rematch_ok(), "沒有上次的大廳設定：不走兩步開戰（照舊進大廳）")
+	var keep_f = Save.data.get("last_form", "")
+	Save.data["last_rules"] = {"ai": load("res://scripts/core/ruleset.gd").standard().to_code()}
+	Save.data["last_form"] = ""
+	ok(not g.quick_rematch_ok(), "有規則但沒有上次陣型：照舊進大廳（Codex v150 cat02 #4）")
+	Save.data["last_form"] = "x"
+	ok(g.quick_rematch_ok(), "有上次規則與陣型：最近玩的直接進擺陣")
+	Save.data["last_rules"] = {"ai": "壞掉的碼"}
+	ok(not g.quick_rematch_ok(), "上次規則讀不回來：照舊進大廳（不悄悄換成標準）")
+	Save.data["last_rules"] = keep
+	Save.data["last_form"] = keep_f
+	g.free()
+	var gm: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_menus.gd")
+	ok(gm.find("if ek == \"menu_vs_ai\" and call(\"quick_rematch_ok\"):") >= 0, "最近玩的：對 AI 快速對戰走兩步開戰")
diff --git a/game/tools/dev_main.gd b/game/tools/dev_main.gd
index 5c3c01d..3f880c2 100644
--- a/game/tools/dev_main.gd
+++ b/game/tools/dev_main.gd
@@ -249,7 +249,7 @@ func layout_geom_input() -> Dictionary:
 	return {"panels": probe_panels, "ribbons": probe_ribbons, "decos": probe_decos, "aligns": probe_aligns,
 		"texts": probe_texts.filter(func(t): return not t.get("field", false)), "btns": probe_btns, "focus_out": 3.0,
 		"boxes": probe_boxes.map(func(b): return b["r"]), "overlay": overlay, "need": need, "icons": probe_icons,
-		"panelless_ok": overlay in PANELLESS_OVERLAYS}
+		"panelless_ok": overlay in PANELLESS_OVERLAYS, "screen": probe_screen, "clicks": click_count()}
 
 
 ## 1.2.0 §14.7 美感自動檢查（第一批，先當報表、不擋）：
@@ -802,7 +802,13 @@ func _run_screenshots() -> void:
 	ink_force = false
 	result_t = time - 5.0
 	result_tab = 1
+	await _snap("v150_05e_result_flow.png")   # 1.5.0 §1.5：走勢與事件（原本首屏的曲線、事實）
+	result_tab = 2
 	await _snap("05b_result_details.png")
+	result_tab = 0
+	overlay = "res_more"   # 1.5.0 §1.5：底列「更多」
+	await _snap("v150_05f_result_more.png")
+	overlay = ""
 	if pc_shot != null:   # V1.4 #14 戰報明信片
 		overlay = "postcard"
 		await _snap("05c_postcard.png")
@@ -1744,7 +1750,7 @@ func _pad_walk() -> void:
 	_go_title()
 	await _pw_frames(3)
 	await _pw_cycle("標題")
-	for step in [[0, "hub_play"], [1, "hub_gauntlet"], [2, "hub_challenge"], [3, "playroom"], [4, "hub_collect"], [5, "settings"], [6, "codes"]]:   # V1.5：五塊木牌（0～4）＋系統列（5 設定、6 代碼、7 離開）
+	for step in [[0, "hub_play"], [1, "hub_gauntlet"], [2, "hub_challenge"], [3, "playroom"], [4, "hub_collect"], [5, "settings"]]:   # V1.5：五塊木牌（0～4）＋系統列（5 設定、6 離開；1.5.0 代碼移到收藏，下面另走）
 		_go_title()
 		await _pw_pick(step[0], "標題→" + str(step[1]))
 		_pw_check(overlay == step[1], "標題→%s：現在是 %s" % [step[1], overlay])
@@ -1752,6 +1758,11 @@ func _pad_walk() -> void:
 		await _pw_btn(JOY_BUTTON_B)
 		_pw_check(overlay == "", "%s：B 關不掉" % step[1])
 	_go_title()
+	await _pw_pick(4, "標題→收藏")
+	await _pw_pick(7, "收藏→代碼")   # 1.5.0：代碼在收藏第 8 張
+	_pw_check(overlay == "codes", "收藏→代碼：現在是 %s" % overlay)
+	await _pw_cycle("codes")
+	_go_title()
 	await _pw_pick(0, "標題→對戰")
 	await _pw_pick(1, "對戰→對 AI 大廳")
 	await _pw_cycle("大廳")
diff --git a/game/tools/run_chain.sh b/game/tools/run_chain.sh
index 1c906fa..00df475 100644
--- a/game/tools/run_chain.sh
+++ b/game/tools/run_chain.sh
@@ -26,7 +26,12 @@ win_godot_since() {   # 這條鏈開始之後啟動的 Windows Godot（WSL 砍
 }
 leftover() {   # 這一輪是否還有殘留：程序群裡除了收尾者自己以外的程序、或這輪開始後啟動的 Windows Godot（查詢失敗也算有殘留）
   local pg="$1" st="$2" self="${3:-}" others w
-  others=$(sess_pids "$pg" | grep -v "^${self:-x}$" | grep -v '^$' || true)
+  # 收尾者自己與它開的子程序（這裡的 ps／grep 管線也在同一個 session）不算殘留
+  others=$(ps -eo pid=,sid=,ppid= 2>/dev/null | awk -v s="$pg" -v me="${self:-0}" -v sh="$$" '
+    { pid[$1]=$1; sid[$1]=$2; par[$1]=$3 }
+    END { for (p in pid) { if (sid[p]!=s) continue; q=p; mine=0; n=0
+            while (q!="" && q>1 && n<50) { if (q==me || q==sh) { mine=1; break } q=par[q]; n++ }
+            if (!mine) print p } }' || true)
   w=$(win_godot_since "$st") || { echo "Windows 查詢失敗"; return 0; }
   [ -n "$others$w" ] && { echo "程序群：$others Windows：$w"; return 0; }
   return 1
