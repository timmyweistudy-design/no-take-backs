func _scale_key() -> int:
	var sc := int(Save.s("text_scale"))
	return 150 if sc >= 150 else (125 if sc >= 125 else 100)

func tz(role: String) -> int:
	return int(TYPE_SCALE[_scale_key()][role])

func ts(px: int) -> int:
	return tz(role_of(px))

## 封頂（第五輪）：取字級表裡 ≤ 上限的最大值，但不低於「註記」。取代 tcap(ts(x), N)，避免封出表外字級。
func tcap(sz: int, maxpx: int) -> int:
	var best := tz("C")
	for v in TYPE_SCALE[_scale_key()].values():
		if v <= mini(sz, maxpx) and v > best:
			best = v
	return best

## 這個字級在不在字級表裡（版面檢查用）。
func size_ok(sz: int) -> bool:
	return sz in TYPE_SCALE[_scale_key()].values()


## 第五輪：解鎖用的累計場數（設定「全部解鎖」時視為全開；試玩版上限由 roster 管）。


func cbm() -> bool:
	return bool(Save.s("colorblind"))
static func balance_two_lines(s: String) -> String:
	if "\n" in s or s.length() < 4:
		return s
	if " " in s:   # 英文：換在最靠近中間的空白
		var best := -1
		for i in s.length():
			if s[i] == " " and (best < 0 or absi(i - s.length() / 2) < absi(best - s.length() / 2)):
				best = i
		return s.substr(0, best) + "\n" + s.substr(best + 1)
	var k := ceili(s.length() / 2.0)
	return s.substr(0, k) + "\n" + s.substr(k)

## V1.5.2 R9：一行置中小標題（字級 sz）下方的控制項起點：字形下緣（約 1.03 字高）＋GAP_M
func below_head(sz: int) -> float:
	return ceilf(sz * 1.05) + GAP_M

## V1.5.2 R1／L7：模態面板水平置中、高度照內容（垂直置中，距畫面邊 ≥16）
func modal_rect(w: float, h: float) -> Rect2:
	var hh := minf(h, 800.0 - 32.0)
	return Rect2(roundf((1280.0 - w) * 0.5), roundf(maxf(16.0, (800.0 - hh) * 0.5)), w, hh)

## V1.5.2：可見面小於 44 的按鈕（大廳選牌、技能、篩選、陣營、沙盤技能）：點擊區擴到 44 高，可見面不變
func _btn_small(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
	btn_hit_min = 44.0
	_btn(r, label, action, enabled, primary, tint)
	btn_hit_min = 0.0

## 安靜的小按鈕（第七輪 N6）：點擊框維持可點的大小，平常只畫一個小記號，滑過才亮。
func _btn_quiet(r: Rect2, label: String, action: Callable) -> void:
	var idx := _btns.size()
	_btns.append({"r": r, "cb": action, "en": true})
	var hot := (r.has_point(mouse) and not pad_mode) or (pad_mode and idx == _focus)
	var sz := ts(14)
	var rad := maxf(9.0, maxf(sz * 0.62, label_ink(label, sz, true).size.y * 0.5 + 4.5))   # 1.3.0 R11：圓跟著字級長大；1.4.0 R12：墨跡上下各留 ≥4px
	var c := r.end - Vector2(rad + 3.0, rad + 3.0)
	draw_circle(c, rad, Color(ACCENT, 0.9) if hot else Color(0, 0, 0, 0.55), true, -1.0, true)
	if layout_probe:
		probe_btns.append(r)
		probe_ctrls.append(r)
			_text(br.position + Vector2(8, tz("S") * 0.3), lab, tz("S"), Color.WHITE, false, true)
			x += bw + 6
		y += tz("S") * 2.1
	_text(Vector2(640, y + 4), L.t("fingerprint", [sim.fingerprint.substr(0, 12)]), tz("C"), TXT_DIM, true, false, 760)   # V1.2.1 F5：原 45% 白只有 2:1



## 一句描述（第五輪：只講事實、和 MVP 一致，不宣稱因果——Codex 第二輪）。主角＝MVP（勝方傷害最高的那一隻）。
## V1.1 B1：藍方（玩家）輸了才有。傷害最多的敵方兵種與占比；能帶的兵裡剋它最強的那種當建議。雙人、觀戰不顯示。
func _loss_line(w: int, goal_mode: bool) -> String:
	if mode == Mode.DUEL or watch_mode or play_kind == "review":
		return ""
	var lost: bool = (bool(report.get("goal_ok", true)) == false) if goal_mode else (w == 1)
	if not lost:
		return ""
	var line := loss_summary(ev_count, _loss_pool())
	var st: Dictionary = Save.data.get("stats", {})
	if line != "" and int(st.get("wins", 0)) == 0 and int(st.get("games", 0)) <= 2 and (mode == Mode.VS_AI or mode == Mode.TUTORIAL):
		line = L.t("loss_first", [line])   # V1.0.0 N6：前兩場還沒贏過：先講「輸很正常」再給建議
	return line

func _loss_pool() -> Array:
	if mode == Mode.PUZZLE or mode == Mode.TUTORIAL:
		return PZ.get_puzzle(puzzle_id).get("allowed", [])
	var out: Array = []
	var pool: int = int(armies[0].pool) if not armies.is_empty() else 0
	for ty in 20:
		if RuleSet.has(pool, ty):
			out.append(ty)
	return out
	if keep.deploy == "free":
		return keep.place_xy(int(u["type"]), Army.quant(p.x), Army.quant(p.y))
	return keep.place(int(u["type"]), clampi(p.x / 1000, 0, 15), clampi(p.y / 1000, 0, 8))


## 載入陣型（存檔格、貼上代碼）：先解碼到暫存陣型，全軍都是這場開放的兵種才替換（Codex 實作審查 #1）。
## 回傳 ""＝成功、"locked"＝含未開放兵種、其他＝格式錯誤。
func _load_checked(code: String) -> String:
	if rules != null:
		# 第五輪：自訂規則下，存檔格的陣型照這局的限制重新驗證——合法的放上去、不合法的拿掉，並用橫幅列出來
		var raw = _decode_any(code)
		if raw is String:
			return raw
		var keep = armies[0].copy()
		keep.units = []
		keep.guard_combat = true   # 保留戰鬥兵需要的錢與名額（Codex 實作第 2 輪：不會載入成只剩支援兵）
		var gone := {}
		var ordered: Array = raw.units.duplicate()
		ordered.sort_custom(func(p, q): return (0 if not D.is_support(int(p["type"])) else 1) < (0 if not D.is_support(int(q["type"])) else 1))
		for u in ordered:
			var t := int(u["type"])
			if not _place_from(keep, u):
				gone[t] = int(gone.get(t, 0)) + 1
		armies[0].units = keep.units
		_fp_abort_drag()
		fp_sel = []   # 換了陣型，舊的框選索引作廢（Codex 實作第 2 輪 #8）
		if not gone.is_empty():
			var bits: Array = []
			for t in gone:
				bits.append("%s×%d" % [L.t("unit_%d" % t), gone[t]])
			removed_banner = L.t("removed_by_rules", ["、".join(bits)])
func _deploy_tools_ok() -> bool:
	return _can_edit_existing() and not _cp_on() and mode != Mode.TUTORIAL and mode != Mode.PUZZLE and not (mode == Mode.GAUNTLET and gauntlet_stage > 1) and not (mode == Mode.VS_AI and bool(get("wv_active")))

func _deploy_tool(id: String) -> bool:
	if not _deploy_tools_ok():
		return false
	call("_mb_release_cleanup")   # 拖曳／框選／塗兵進行中用工具：先取消那個操作（不然放開時用舊起點再位移；Codex cat11 #4）
	var a = _cur_army()
	var ok := false
	match id:
		"flip":
			if a.deploy == "free":
				return false   # 自由模式的 M 是翻轉選取（free_place.gd）
			ok = a.flip_all()
		"fwd", "back":
			if a.deploy == "free":
				return false
			ok = a.shift_all(1 if id == "fwd" else -1)
		"align":
			if a.deploy != "free":
				return false
			var snap: Array = a.units.duplicate(true)
			ok = a.align_rows(fp_sel)
			if ok:
				_undo_commit(a, snap)   # 成功而且真的有變才記復原（失敗不動復原／重做歷史；Codex cat08 #2）
		"last":
			if a != armies[0]:
				return false   # 上一陣是藍方（玩家）的陣；暗擺紅方、雙人紅方不給（_load_checked 只換藍方；Codex cat08 #1）
			var code := str(Save.data.get("last_form", ""))
			if code == "":
				_toast(L.t("dt_no_last"), true)
				return true
			var snap2: Array = a.units.duplicate(true)
			ok = _load_checked(code) == ""
			if ok and a.deploy == "free":
				_undo_commit(a, snap2)
	if ok:
		sfx.play("k_click", 0.7)
		if id != "last":
			_toast(L.t("dt_" + id))
		else:
			_toast(L.t("code_loaded"))
