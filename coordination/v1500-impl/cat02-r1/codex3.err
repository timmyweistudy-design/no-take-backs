## 1.3.0 §2：雙擊回全景只認盤面範圍（按鈕列、HUD 不算）。
func _field_hit(p: Vector2) -> bool:
	if p.y <= 96.0 or p.y >= (640.0 if _replay_controls_active() else 760.0):
		return false
	for b in _btns:
		if (b["r"] as Rect2).has_point(p):
			return false   # 按鈕上雙擊不算（Codex cat06 #4）
	var lo: Vector2 = _cam * ORIGIN
	var hi: Vector2 = _cam * (ORIGIN + fld_size)
	return Rect2(lo, hi - lo).has_point(p)

func _mb_cmd(d: Dictionary) -> void:
	var mb := InputEventMouseButton.new()
	mb.button_index = d["i"]
	mb.pressed = d["pressed"]
	mb.position = d["pos"]
	mouse = d["pos"]
func _star_lines(won: bool, rem: int, need_rem: int, spent: int, need_spent: int, goal := "") -> String:
	var yes := "✓"
	var no := "×"
	return "%s %s　%s %s　%s %s" % [yes if won else no, goal if goal != "" else L.t("star_c_win"),
		yes if won and rem >= need_rem else no, L.t("star_c_rem", [need_rem, rem]),
		yes if spent <= need_spent else no, L.t("star_c_spent", [need_spent, spent])]

## 戰力走勢的標記：最多 3 個，優先「勝負已定」「領先交換」「最後時刻」，再補第一個技能時刻。
func _key_marks() -> Array:
	var out: Array = []
	var lock_t := int(report.get("lock_sec", 0)) * 20
	if lock_t > 0 and sim.winner >= 0:
		out.append({"t": lock_t, "label": "%s %ds" % [L.t("tl_lock"), lock_t / 20]})
	var leads: Array = report.get("leads", [])
	if not leads.is_empty():
		out.append({"t": int(leads[leads.size() - 1]), "label": "%s %ds" % [L.t("tl_lead"), int(leads[leads.size() - 1]) / 20]})
#!/usr/bin/env bash
# 1.5.0 §12：背景驗收鏈。整條鏈綁 run ID 與提交雜湊、跑在自己的程序群；中止時整條停（含這條鏈開的 Windows Godot），確認退出才准開新輪。
# 用法（game/ 下）：
#   tools/run_chain.sh <名稱> '<步驟1>' '<步驟2>' …     # 依序跑，任一步失敗就停；紀錄 ../build/tmp/chains/<名稱>/<run>/
#   tools/run_chain.sh --stop <名稱>                     # 停掉整條鏈（Linux 程序群＋這條鏈開始之後啟動的 Windows Godot），確認退出
#   tools/run_chain.sh --status <名稱>
# 互斥：所有「看狀態→改狀態」（啟動登記、停止、子程序收尾）都在同一個 flock 裡（../build/tmp/chains/<名稱>.mutex），
# 「誰在跑」只看 <名稱>.active（內容＝run ID）；沒有 mkdir 鎖、沒有回收競態（Codex v150 cat01 r3／r4）。
set -u
cd "$(dirname "$0")/.." || exit 2
D="$(cd .. && pwd)/build/tmp/chains"
mkdir -p "$D"
runinfo() { sed -n "s/^$2=//p" "$D/$1/$3/run" 2>/dev/null | head -1; }
# 整個 session（setsid 開的）都算這一輪：步驟裡 set -m 開的背景程序會換程序群、但不換 session（Codex v150 cat01 r6 #1）
sess_pids() { [ -n "$1" ] && ps -eo pid=,sid= 2>/dev/null | awk -v s="$1" '$2==s{print $1}'; }
alive_pg() { [ -n "$(sess_pids "$1")" ]; }
kill_sess() { local p; for p in $(sess_pids "$1"); do kill -"$2" "$p" 2>/dev/null; done; }
others_active() { local f n; for f in "$D"/*.active; do [ -e "$f" ] || continue; n=$(basename "$f" .active); [ "$n" = "$1" ] || echo "$n"; done; }
win_godot_since() {   # 這條鏈開始之後啟動的 Windows Godot（WSL 砍不到 Windows 程序，只能從這邊找）。
  # 查詢失敗＝回傳非零（不能當成「沒有」）：PowerShell 退出碼要是 0、而且輸出 QUERY_OK；「沒有 Godot」不是錯誤
  local raw rc
  raw=$(powershell.exe -NoProfile -c "\$ErrorActionPreference='Stop'; try { \$t=[datetime]::Parse('$1', \$null, [Globalization.DateTimeStyles]::RoundtripKind); Get-Process | Where-Object { \$_.ProcessName -like 'Godot*' -and \$_.StartTime -ge \$t } | ForEach-Object { \$_.Id }; 'QUERY_OK'; exit 0 } catch { 'QUERY_FAIL'; exit 1 }" 2>/dev/null); rc=$?
  raw=$(printf '%s' "$raw" | tr -d '\r')
  [ $rc -eq 0 ] && printf '%s\n' "$raw" | grep -q '^QUERY_OK$' || return 1
  printf '%s\n' "$raw" | grep -v '^QUERY_OK$' | grep -v '^$' || true
}
leftover() {   # 這一輪是否還有殘留：程序群裡除了收尾者自己以外的程序、或這輪開始後啟動的 Windows Godot（查詢失敗也算有殘留）
  local pg="$1" st="$2" self="${3:-}" others w
  # 收尾者自己與它開的子程序（這裡的 ps／grep 管線也在同一個 session）不算殘留
  others=$(ps -eo pid=,sid=,ppid= 2>/dev/null | awk -v s="$pg" -v me="${self:-0}" -v sh="$$" '
    { pid[$1]=$1; sid[$1]=$2; par[$1]=$3 }
    END { for (p in pid) { if (sid[p]!=s) continue; q=p; mine=0; n=0
            while (q!="" && q>1 && n<50) { if (q==me || q==sh) { mine=1; break } q=par[q]; n++ }
            if (!mine) print p } }' || true)
  w=$(win_godot_since "$st") || { echo "Windows 查詢失敗"; return 0; }
  [ -n "$others$w" ] && { echo "程序群：$others Windows：$w"; return 0; }
  return 1
}
case "${1:-}" in
--finish)   # 子程序收尾（內部用）：在互斥裡核對 active＝自己，確認整輪沒有殘留才清 active
  name="$2"; rid="$3"; self="$4"
  exec 9>"$D/$name.mutex"; flock -x 9
  [ "$(cat "$D/$name.active" 2>/dev/null)" = "$rid" ] || exit 0
  pg=$(runinfo "$name" pgid "$rid"); st=$(runinfo "$name" started_win "$rid")
  for i in $(seq 1 20); do why=$(leftover "$pg" "$st" "$self") || break; sleep 0.5; done
  if why=$(leftover "$pg" "$st" "$self"); then echo "leftover=$why" >> "$D/$name/$rid/run"; exit 1; fi   # 有殘留：active 留著，要 --stop
  echo "$rid" > "$D/$name.last"; rm -f "$D/$name.active"; exit 0 ;;
--status)
  rid=$(cat "$D/$2.active" 2>/dev/null); last=$(cat "$D/$2.last" 2>/dev/null)
  r=${rid:-$last}; [ -n "$r" ] && cat "$D/$2/$r/run" || echo "CHAIN 沒有 $2"; exit 0 ;;
--stop)
  name="$2"
  exec 9>"$D/$name.mutex"; flock -x 9   # 停止全程持有互斥：啟動與收尾都得等
  rid=$(cat "$D/$name.active" 2>/dev/null)
  [ -n "$rid" ] || { echo "CHAIN $name 沒有在跑"; exit 0; }
  pg=$(runinfo "$name" pgid "$rid"); st=$(runinfo "$name" started_win "$rid")
  [ -n "$pg" ] || { echo "CHAIN $name 紀錄缺程序群（$rid）"; exit 1; }
  kill_sess "$pg" TERM
  for i in $(seq 1 20); do alive_pg "$pg" || break; sleep 0.5; done
  alive_pg "$pg" && kill_sess "$pg" KILL
  ids=$(win_godot_since "$st") || { echo "CHAIN $name 查不到 Windows 程序（查詢失敗），沒有確認退出"; exit 1; }
  oth=$(others_active "$name")
  if [ -n "$ids" ] && [ -n "$oth" ]; then
    # WSL 查不到 Windows 程序是哪條鏈開的：有別條鏈在跑時不自動殺（不誤殺別人的 Godot），列出來請人處理（Codex v150 cat01 r6 #2）
    echo "CHAIN $name 的 Linux 程序已停；這輪開始後還有 Windows Godot（$ids），但別條鏈（$oth）也在跑，無法確認歸屬、沒有自動停止"; exit 1
  fi
  for id in $ids; do powershell.exe -NoProfile -c "Stop-Process -Id $id -Force" >/dev/null 2>&1; done
  sleep 1
  left=$(win_godot_since "$st") || { echo "CHAIN $name 查不到 Windows 程序（查詢失敗），沒有確認退出"; exit 1; }
  if alive_pg "$pg" || [ -n "$left" ]; then echo "CHAIN $name 還沒停乾淨（Linux 程序群 $pg、Windows Godot：$left）"; exit 1; fi
  echo "state=stopped" >> "$D/$name/$rid/run"
  echo "$rid" > "$D/$name.last"; rm -f "$D/$name.active"
  echo "CHAIN $name 已停（run $rid）"; exit 0 ;;
esac
name="$1"; shift
[ $# -ge 1 ] || { echo "用法：tools/run_chain.sh <名稱> '<步驟>' …"; exit 2; }
exec 9>"$D/$name.mutex"; flock -x 9   # 啟動登記：看有沒有人在跑→開新輪→寫 active，全部在互斥裡
old=$(cat "$D/$name.active" 2>/dev/null)
if [ -n "$old" ]; then
  opg=$(runinfo "$name" pgid "$old")
  if alive_pg "$opg"; then echo "CHAIN $name 還在跑（run $old），先 --stop"; exit 1; fi
  if why=$(leftover "$opg" "$(runinfo "$name" started_win "$old")"); then echo "CHAIN $name 上一輪還有殘留（$why），先 --stop"; exit 1; fi
  echo "$old" > "$D/$name.last"; rm -f "$D/$name.active"   # 上一輪異常結束、也確認沒有殘留
fi
rid="$(date +%Y%m%d-%H%M%S)-$$"
R="$D/$name/$rid"; mkdir -p "$R"
commit="$(git rev-parse --short HEAD 2>/dev/null)$(git diff --quiet 2>/dev/null || echo +dirty)"
stw=$(powershell.exe -NoProfile -c "(Get-Date).ToString('o')" 2>/dev/null | tr -d '\r')   # 精確起點（不倒退、不截斷）
[ -n "$stw" ] || { echo "CHAIN $name 取不到 Windows 時間"; exit 1; }
printf 'run=%s\ncommit=%s\nstarted=%s\nstarted_win=%s\n' "$rid" "$commit" "$(date '+%F %T')" "$stw" > "$R/run"
SELF="$(pwd)/tools/run_chain.sh"; export SELF
setsid bash -c '
  R="$1"; D="$2"; name="$3"; rid="$4"; shift 4
  exec 9>&-   # 不繼承啟動者的互斥
  echo "pgid=$(ps -o sid= $$ | tr -d " ")" >> "$R/run"
  for i in $(seq 1 50); do [ "$(cat "$D/$name.active" 2>/dev/null)" = "$rid" ] && break; sleep 0.2; done
  [ "$(cat "$D/$name.active" 2>/dev/null)" = "$rid" ] || { echo "state=aborted_unregistered" >> "$R/run"; exit 3; }   # 啟動者沒登記成功：不跑（Codex v150 cat01 r5 #1）
  n=0; rc=0
  for step in "$@"; do
    n=$((n+1)); echo "step$n=$step" >> "$R/run"
func _res_seals() -> Array:
	if sim == null or not (mode == Mode.VS_AI or mode == Mode.DUEL) or not series_over or watch_mode:
		return []
	# 頒給勝方（和局、對 AI 都頒藍方；雙人紅方勝就頒紅方，Codex v140 cat02 #2）；三枚一定都在，沒人合格＝「無得主」灰章（#3）
	var tm: int = sim.winner if sim.winner >= 0 else 0
	var best_d = null
	var best_t = null
	for u in sim.units:
		if u.team != tm or u.summon:
			continue
		if best_d == null or u.dmg_dealt > best_d.dmg_dealt:
			best_d = u
		if u.alive and u.dmg_taken > 0 and (best_t == null or u.dmg_taken > best_t.dmg_taken):
			best_t = u
	var mvp = report.get("mvp")
	return [["trophy", "seal_mvp", int(mvp.type) if mvp != null else -1, int(mvp.dmg_dealt) if mvp != null else 0, int(mvp.team) if mvp != null else tm],
		["swords", "seal_dmg", int(best_d.type) if best_d != null else -1, int(best_d.dmg_dealt) if best_d != null else 0, tm],
		["shield", "seal_tank", int(best_t.type) if best_t != null else -1, int(best_t.dmg_taken) if best_t != null else 0, tm]]

func _draw_res_seals(mr: Rect2, seals: Array) -> void:
	for k in seals.size():
		var c := Vector2(mr.end.x - 34.0 - (seals.size() - 1 - k) * 50.0, mr.get_center().y)
		var rr := 21.0
		draw_circle(c + Vector2(1.5, 2.5), rr, Color(DIM_INK, 0.45), true, -1.0, true)
		var sk: Array = seals[k]
		var has: bool = int(sk[2]) >= 0
		draw_circle(c, rr, PAL.WOOD_TYPE if has else Color(0.6, 0.57, 0.52), true, -1.0, true)
		draw_arc(c, rr - 3.0, 0, TAU, 32, Color(PAL.TRINKET_RED if has else Color(0.35, 0.33, 0.3), 0.75), 2.0, true)   # 印面一圈朱砂（無得主＝灰章）
		_icon(str(sk[0]), c, 22.0, PAL.TRINKET_RED.darkened(0.1) if has else Color(0.3, 0.28, 0.26))
		var who := (L.t("blue") if int(sk[4]) == 0 else L.t("red")) + L.t("unit_%d" % int(sk[2])) if has else ""
		var msg := L.t(str(sk[1]), [who, int(sk[3])]) if has else L.t("seal_none")
		var idx := _btns.size()
		_btns.append({"r": Rect2(c - Vector2(rr, rr), Vector2(rr, rr) * 2.0), "cb": func(): _toast(msg), "en": true})
		if idx == _focus and pad_mode:
			draw_arc(c, rr + 4.0, 0, TAU, 32, ACCENT, 3.0, true)   # 手把焦點框（Codex v140 cat02 #4）
			if bool(Save.s("focus_strong")):
				draw_arc(c, rr + 8.0, 0, TAU, 32, Color.WHITE, 3.0, true)

