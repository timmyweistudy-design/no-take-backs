func coach_ok() -> bool:
	if play_kind != "official" or watch_mode or sim == null or sim.winner == 0 or last_armies.size() != 2:
		return false
	if bool(rush.get("on", false)) or not (mode == Mode.PUZZLE or mode == Mode.VS_AI):
		return false
	if not (get("daily_spec") as Dictionary).is_empty():
