/bin/bash -lc "sed -n '777,895p' game/scripts/ui/screens/game_core.gd; rg -n 'func _result_facts|func _result_obs' game/scripts/ui; nl -ba game/scripts/ui/screens/game_result.gd | sed -n '311,354p'" in /mnt/c/Users/timmy/projects/no-take-backs
 succeeded in 0ms:
		out.append({"t": int(leads[leads.size() - 1]), "label": "%s %ds" % [L.t("tl_lead"), int(leads[leads.size() - 1]) / 20]})
	for m in battle_marks:
		if out.size() >= 3:
			break
		if str(m["kind"]) == "clutch":
			out.append({"t": int(m["tick"]), "label": "%s %ds" % [L.t("tl_clutch"), int(m["tick"]) / 20]})
	for m in battle_marks:
		if out.size() >= 3:
			break
		if str(m["kind"]) != "clutch":
			out.append({"t": int(m["tick"]), "label": "%s %ds" % [L.t("tl_" + str(m["kind"])), int(m["tick"]) / 20]})
	out.sort_custom(func(a, b): return int(a["t"]) < int(b["t"]))
	return out



## V1.4 #6 最小成本懸賞：每一關記三項最佳（花費、兵數、時間），各自取最小。破紀錄就在結果頁說出來。
static func record_merge(old: Array, spent: int, units: int, ticks: int) -> Array:
	if old.size() != 3:
		return [spent, units, ticks]
	return [mini(int(old[0]), spent), mini(int(old[1]), units), mini(int(old[2]), ticks)]

## 1.1.0 N5：存「最佳解」的部署（玩家擺的兵，不含固定兵），排序同實驗簿
func _best_sol_record(pid: String, stars: int) -> void:
	var pz := PZ.get_puzzle(pid)
	var u: Array = []
	for un in last_armies[0].units if not last_armies.is_empty() else []:
		if un.has("col") and not PZ.is_fixed(pz, int(un["col"]), int(un["row"])):
			u.append([int(un["type"]), int(un["col"]), int(un["row"])])
	if u.is_empty():
		return
	var SC = load("res://scripts/game/solution_code.gd")
	var plan: Array = (get("puzzle_plan") as Array).duplicate() if pz.has("cmd") and get("puzzle_plan") is Array else []   # 時序關卡要連軍令一起存（Codex v110-i1 #2）
	Save.data["pz_sol"] = SC.merge(Save.data.get("pz_sol", {}), pid, stars, PZ.rem_pct(sim.power(0), sim.budget_of(0)), last_armies[0].spent(), u, plan)

func _puzzle_record(pid: String, spent: int, units: int, ticks: int) -> void:
	var all: Dictionary = Save.data.get("pz_best", {})
	var old: Array = all.get(pid, [])
	var nw := record_merge(old, spent, units, ticks)
	var better: Array = []
	if old.size() == 3:
		if nw[0] < int(old[0]):
			better.append(L.t("rec_gold", [int(old[0]) - nw[0]]))
		if nw[1] < int(old[1]):
			better.append(L.t("rec_units", [int(old[1]) - nw[1]]))
		if nw[2] < int(old[2]):
			better.append(L.t("rec_time", [_fmt_num(snappedf((int(old[2]) - nw[2]) / 20.0, 0.1))]))
	all[pid] = nw
	Save.data["pz_best"] = all
	report["rec_line"] = L.t("rec_line", [spent, units, _fmt_num(snappedf(ticks / 20.0, 0.1)), nw[0], nw[1], _fmt_num(snappedf(nw[2] / 20.0, 0.1))])
	report["rec_new"] = L.t("rec_new", ["、".join(better)]) if not better.is_empty() else ""

func _gauntlet_next() -> void:
	gauntlet_prev = last_armies[0].units.duplicate(true)
	gauntlet_stage += 1
	gauntlet_changes = 3
	_reset_place(false)
	armies[0].budget += int(get("gauntlet_gold"))
	armies[0].unit_cap += int(get("gauntlet_cap"))

## 第十輪 I5：遠征只在每戰之間存檔。
func _gauntlet_save() -> void:
	var prev: Array = []
	for u in gauntlet_prev:
		var o := {}
		for k in u:
			o[str(k)] = int(u[k])
		prev.append(o)
	Save.data["gauntlet_run"] = {"stage": gauntlet_stage, "seed": gauntlet_seed, "gold": int(get("gauntlet_gold")), "cap": int(get("gauntlet_cap")),
		"changes": gauntlet_changes, "pool": _gauntlet_pool(), "prev": prev,
		"foe_gold": int(get("gauntlet_foe_gold")), "foe_cap": int(get("gauntlet_foe_cap")), "contract": int(get("gauntlet_contract")), "coop": 1 if bool(get("ga_coop")) else 0, "clog": get("coop_log").duplicate() if get("coop_log") is Array else []}   # V1.1 D1：舊存檔沒有這兩欄＝0   # 存實際卡池：之後改大廳不會影響這次遠征（Codex v10-r1 #2）
	Save.save_data()

func _gauntlet_clear() -> void:
	Save.data["gauntlet_run"] = {}

func _gauntlet_resume() -> void:
	var g: Dictionary = Save.data.get("gauntlet_run", {})
	if g.is_empty():
		return
	Save.data["gauntlet_pool"] = int(g["pool"])
	call("_start_mode", Mode.GAUNTLET)
	set("gauntlet_gold", int(g["gold"]))
	set("gauntlet_cap", int(g["cap"]))
	gauntlet_stage = int(g["stage"])
	gauntlet_seed = int(g["seed"])
	gauntlet_prev = g["prev"].duplicate(true)
	set("gauntlet_foe_gold", int(g.get("foe_gold", 0)))
	set("gauntlet_foe_cap", int(g.get("foe_cap", 0)))
	set("gauntlet_contract", int(g.get("contract", -1)))   # V1.4 #3：舊存檔沒有＝沒簽
	set("ga_coop", int(g.get("coop", 0)) == 1)   # V1.6 #21：雙人接力（舊存檔沒有＝單人）
	set("coop_log", (g.get("clog", []) as Array).duplicate())   # V1.6.1 D4：每站誰擺、勝負、MVP
	_reset_place(false)
	armies[0].budget += int(g["gold"])
	armies[0].unit_cap += int(g["cap"])
	call("_apply_contract_cost")
	gauntlet_changes = int(g["changes"])



## 匯出成品自我檢查（第七輪 S3）：tools/export_check.sh 對匯出的 exe 跑，印 SELFCHECK 一行 JSON。
func _self_check() -> void:
	for i in 3:
		await get_tree().process_frame
	var demo := _demo()
	var out := {"demo": demo, "exported": OS.has_feature("template"), "engine": Engine.get_version_info().string}
	out["strings"] = L.has("title") and L.t("title") != "title"
	out["data"] = FileAccess.file_exists("res://data/puzzles.json") and FileAccess.file_exists("res://data/codex.json") and FileAccess.file_exists("res://data/strings.csv")
	out["fonts"] = font_title != null and font_bold != null
	out["audio"] = sfx != null and sfx.get_child_count() > 0
	out["art"] = grass != null and plants.size() > 0
	Save.data["tutorial"] = 2
	var w: bool = Save.save_data()
	Save.load_all()
	out["save_roundtrip"] = w and int(Save.data["tutorial"]) == 2 and Save.file_prefix().ends_with("demo_") == demo
	var a0 := Army.new(0, 100)
	a0.place(0, 0, 0)
	var a1 := Army.new(1, 100)
	a1.place(0, 15, 0)
