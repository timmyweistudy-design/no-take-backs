func _reset_place(keep_blue := false) -> void:
	state = St.PLACE
	if bool(get("cp_on")):
		call("_cp_reset")   # 1.2.0 §11.6：每一局重新輪手（藍軍保留時，已有的兵不算任何人這一手）
	sim = null
	view = null
	pending_cell = Vector2i(-1, -1)
	ai_prebuilt = false
	_fp_reset()
	# 第一次進擺放畫面自動打開操作說明（第五輪：說明從頂部移到「?」）
	if not bool(Save.data.get("seen_place_help", false)) and (mode == Mode.VS_AI or mode == Mode.DUEL) and shot_dir == "":
		show_place_help = true
		Save.data["seen_place_help"] = true
	fx.clear()
	frags.clear()   # 1.2.0 §8.2
	dying.clear()
	zoom = 1.0
	tp = null
	blind_phase = 0
	_focus = 0
	var keep_ok: bool = keep_blue and not armies.is_empty() and (rules == null or rules.keep_formation)
	var blue_keep = armies[0].copy() if keep_ok else null
	armies = [Army.new(0, 100), Army.new(1, 100)]
	if rules != null and (mode == Mode.VS_AI or mode == Mode.DUEL):
		armies[0].apply_rules(rules, 0)
		armies[1].apply_rules(rules, 1)
	if mode == Mode.GAUNTLET:
		armies[0].pool = _gauntlet_pool()
		armies[1].pool = _gauntlet_pool()
	match mode:
		Mode.VS_AI:
			if blue_keep != null:
				armies[0] = blue_keep
			if rules != null and rules.fullfield == 2:
				# 第六輪：對 AI 明牌全場——AI 先在自己半場擺好並公開，你在全場離敵兵 1.5 格外擺
				_build_ai()
				ai_prebuilt = true
				armies[0].enemy_pos = []
				for u in armies[1].units:
					armies[0].enemy_pos.append(armies[1].pos_of(u))
				var keep: Array = armies[0].units.duplicate(true)
				armies[0].units = []
				for u in keep:
					var pp: Vector2i = armies[0].pos_of(u)
					armies[0].place_xy(int(u["type"]), pp.x, pp.y)   # 保留的陣型和新的明牌陣衝突的就拿掉
		Mode.DUEL:
			if duel_rule != "blind":
				tp = TP.new(armies[0], armies[1], (round_no + 1) % 2, duel_rule, rules)
				if rules == null:
					tp.armies[0].pool = _pool()
					tp.armies[1].pool = _pool()
				# 1.1.0 B2：輪序紀錄碼要開局（禁牌後）的卡池與預算
				duel_start = {"pools": [tp.armies[0].pool, tp.armies[1].pool], "budgets": [tp.armies[0].budget, tp.armies[1].budget], "rules": rules.copy() if rules != null else null}
		Mode.TUTORIAL, Mode.PUZZLE:
			var pz := PZ.get_puzzle(puzzle_id)
			armies[0] = PZ.player_army(pz)
			armies[1] = PZ.enemy_army(pz)
			selected = int(pz["allowed"][0])
			if puzzle_plan_id != puzzle_id:
				puzzle_plan = PZ.default_plan(pz)   # 第十三輪：同一關重來保留上次設定的時間，換關重設
				puzzle_plan_id = puzzle_id
		Mode.GAUNTLET:
			if not gauntlet_prev.is_empty():
				armies[0].units = gauntlet_prev.duplicate(true)
			var r := RandomNumberGenerator.new()
			r.seed = gauntlet_seed + gauntlet_stage * 7919
			var node: String = call("ga_node", gauntlet_stage)
			var lvl := 2 if node == "boss" else mini(2, (gauntlet_stage - 1) / 2 + (1 if node == "elite" else 0))
			var e := AIT.build_full(1, r, lvl, gauntlet_prev, _pool())
			set("gauntlet_nemesis", call("_nemesis_for_stage"))   # V1.4 #2：菁英站可能遇到宿敵
			# V1.1 D1：菁英 +10、首領 +20；斥候劫掠／截斷補給只影響這一戰
			e.budget = 100 + 5 * (gauntlet_stage - 1) + int(get("GA_NODE_GOLD")[node]) + int(get("gauntlet_foe_gold"))
			if node == "boss" and not _demo():
				e.budget -= BossD.BUDGET_CUT   # V1.4 #12：巨獸是送的，敵方其他兵少一點錢
			e.unit_cap = maxi(4, e.unit_cap + int(get("gauntlet_foe_cap")))
			# Codex v110-impl #2：先組好的陣可能超出調低後的預算／隻數，從最後放的往回拿掉（至少留一隻戰鬥兵）
			while e.units.size() > 1 and (e.spent() > e.budget or e.units.size() > e.unit_cap):
				e.units.pop_back()
			var guard := 0
			while e.can_afford_any() and guard < 20:
				guard += 1
				var t := AIT.choose_type(e, gauntlet_prev, e.left(), r, lvl, _pool())
				if t < 0:
					break
				var c := AIT.choose_cell(e, t, gauntlet_prev, r)
				if c.x < 0 or not e.place(t, c.x, c.y):
					break
			armies[1] = e
			if node == "boss" and not _demo():
				call("add_boss", armies[1])   # V1.4 #12：遠征終點多一隻巨獸
				_toast(L.t("boss_here") + "\n" + L.t("ps_boss"))   # V1.6 #11 首領嗆聲
			if int(get("gauntlet_nemesis")) >= 0:
				armies[1] = call("_nemesis_army", int(get("gauntlet_nemesis")))
				var nt: String = call("nemesis_title", Save.data["nemeses"][int(get("gauntlet_nemesis"))])
				ai_name = nt
				_toast(L.t("nem_back", [nt, int(Save.data["nemeses"][int(get("gauntlet_nemesis"))].get("losses", 1))]) + "\n" + L.t("ps_nemesis", [nt]))   # V1.6 #11
	if not retry_key.begins_with("tr:"):
	if keep.deploy == "free":
		return keep.place_xy(int(u["type"]), Army.quant(p.x), Army.quant(p.y))
	return keep.place(int(u["type"]), clampi(p.x / 1000, 0, 15), clampi(p.y / 1000, 0, 8))


## 載入陣型（存檔格、貼上代碼）：先解碼到暫存陣型，全軍都是這場開放的兵種才替換（Codex 實作審查 #1）。
## 回傳 ""＝成功、"locked"＝含未開放兵種、其他＝格式錯誤。
func _load_checked(code: String) -> String:
	if rules != null:
		# 第五輪：自訂規則下，存檔格的陣型照這局的限制重新驗證——合法的放上去、不合法的拿掉，並用橫幅列出來
		var raw = _decode_any(code)
		if raw is String:
			return raw
		var keep = armies[0].copy()
		keep.units = []
		keep.guard_combat = true   # 保留戰鬥兵需要的錢與名額（Codex 實作第 2 輪：不會載入成只剩支援兵）
		var gone := {}
		var ordered: Array = raw.units.duplicate()
		ordered.sort_custom(func(p, q): return (0 if not D.is_support(int(p["type"])) else 1) < (0 if not D.is_support(int(q["type"])) else 1))
		for u in ordered:
			var t := int(u["type"])
			if not _place_from(keep, u):
				gone[t] = int(gone.get(t, 0)) + 1
		armies[0].units = keep.units
		_fp_abort_drag()
		fp_sel = []   # 換了陣型，舊的框選索引作廢（Codex 實作第 2 輪 #8）
		if not gone.is_empty():
			var bits: Array = []
			for t in gone:
				bits.append("%s×%d" % [L.t("unit_%d" % t), gone[t]])
			removed_banner = L.t("removed_by_rules", ["、".join(bits)])
			removed_banner_t = 4.0
		return ""
	var tmp := Army.new(armies[0].team, armies[0].budget)
	var why := tmp.load_code(code)
	if why != "":
		return why
	for u in tmp.units:
		if not _allowed(int(u["type"])):
			return "locked"
		u.erase("st")     # V1.4 #9 #12：貼紙只在遠征裡貼，貼上陣型碼不帶進來（Codex v140-i5）
		u.erase("boss")
	armies[0].units = tmp.units
	fp_sel = []
	return ""



# ── 擺放 HUD ──
func _draw_place_hud() -> void:
	# 第五輪 §4.4：頂部兩行。第一行＝模式／局數（左）、目前在做什麼＋金幣條＋人數（中）、規則徽章（右）；
	# 第二行＝選中兵種的資訊帶（名稱、一句定位、剋／怕頭像），完全在棋盤外，不蓋部署格。
	_hud_bar(Rect2(0, 0, 1280, 92))   # V1.2：頂部資訊列改深木紋（原本是平塗深底）
	draw_line(Vector2(0, 50), Vector2(1280, 50), Color(1, 1, 1, 0.08), 1.0)
	var a = _cur_army()
	var tcol := Art.team_color(a.team, cbm())
	var a = _cur_army()
	var ok := false
	match id:
		"flip":
			if a.deploy == "free":
				return false   # 自由模式的 M 是翻轉選取（free_place.gd）
			ok = a.flip_all()
		"fwd", "back":
			if a.deploy == "free":
				return false
			ok = a.shift_all(1 if id == "fwd" else -1)
		"align":
			if a.deploy != "free":
				return false
			var snap: Array = a.units.duplicate(true)
			ok = a.align_rows(fp_sel)
			if ok:
				_undo_commit(a, snap)   # 成功而且真的有變才記復原（失敗不動復原／重做歷史；Codex cat08 #2）
		"last":
			if a != armies[0]:
				return false   # 上一陣是藍方（玩家）的陣；暗擺紅方、雙人紅方不給（_load_checked 只換藍方；Codex cat08 #1）
			var code := str(Save.data.get("last_form", ""))
			if code == "":
				_toast(L.t("dt_no_last"), true)
				return true
			var snap2: Array = a.units.duplicate(true)
			ok = _load_checked(code) == ""
			if ok and a.deploy == "free":
				_undo_commit(a, snap2)
	if ok:
		sfx.play("k_click", 0.7)
		if id != "last":
			_toast(L.t("dt_" + id))
		else:
			_toast(L.t("code_loaded"))
	else:
		_toast(L.t("dt_bad"), true)
	return true

## 工具成功後補一筆復原：把「改之前」的陣型推進復原堆疊（不改目前陣型）；沒變就不推。
func _undo_commit(a, before: Array) -> void:
	if a.deploy != "free" or a.units == before:
		return
var co_ctl := {}       # V1.6.1 F5：和背景搜尋共用的 {"stop", "until", "done"}（取消、期限、進度）

func _coach_pz() -> Dictionary:
	return PZ.get_puzzle(puzzle_id) if mode == Mode.PUZZLE else {}

func coach_ok() -> bool:
	if play_kind != "official" or watch_mode or sim == null or sim.winner == 0 or last_armies.size() != 2:
		return false
	if bool(rush.get("on", false)) or not (mode == Mode.PUZZLE or mode == Mode.VS_AI):
		return false
	if not (get("daily_spec") as Dictionary).is_empty():
		return false   # V1.6.1 A4：每日挑戰不給教練（大家同一題、上排行榜）
	if mode == Mode.PUZZLE and bool(report.get("goal_ok", false)):
		return false
	return Coach.supported(last_armies[0], battle_rules, _coach_pz())

func _coach_open() -> void:
	var key := "%d:%s:%d:%d:%s:%d" % [mode, puzzle_id, last_armies[0].units.hash(), last_armies[1].units.hash(), battle_rules.to_code() if battle_rules != null else "", _coach_pz().hash()]
	if co_thread != null:
		if key != co_key:
			co_key = key   # 換場了：舊的答案算完不收（_v16_jobs 比對 co_thread_key），算完再重開會重算

