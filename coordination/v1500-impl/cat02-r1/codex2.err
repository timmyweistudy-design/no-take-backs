@@ -604,6 +672,29 @@ func _loss_pool() -> Array:
 			out.append(ty)
 	return out
 
+## 1.5.0：敗因卡用的兩個兵種 [主要傷害來源, 建議改帶]（-1＝沒有）；和 loss_summary 同一套判斷
+static func loss_pair(counts: Dictionary, pool: Array) -> Array:
+	var total := 0
+	var top := -1
+	var top_v := 0
+	for k in counts:
+		if str(k).begins_with("dmgby0_"):
+			var v := int(counts[k])
+			total += v
+			if v > top_v:
+				top_v = v
+				top = int(str(k).substr(7))
+	if top < 0 or total <= 0:
+		return [-1, -1]
+	var best := -1
+	var best_sc := 0
+	for ty in pool:
+		var sc: int = AIT.counter_score(int(ty), top)
+		if sc > best_sc:
+			best_sc = sc
+			best = int(ty)
+	return [top, best]
+
 ## 純函式（測試用）。counts＝ev_count（含 dmgby0_<兵種>）、pool＝可以帶的兵種。
