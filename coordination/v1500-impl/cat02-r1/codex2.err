## 一句描述（第五輪：只講事實、和 MVP 一致，不宣稱因果——Codex 第二輪）。主角＝MVP（勝方傷害最高的那一隻）。
## V1.1 B1：藍方（玩家）輸了才有。傷害最多的敵方兵種與占比；能帶的兵裡剋它最強的那種當建議。雙人、觀戰不顯示。
func _loss_line(w: int, goal_mode: bool) -> String:
	if mode == Mode.DUEL or watch_mode or play_kind == "review":
		return ""
	var lost: bool = (bool(report.get("goal_ok", true)) == false) if goal_mode else (w == 1)
	if not lost:
		return ""
	var line := loss_summary(ev_count, _loss_pool())
	var st: Dictionary = Save.data.get("stats", {})
	if line != "" and int(st.get("wins", 0)) == 0 and int(st.get("games", 0)) <= 2 and (mode == Mode.VS_AI or mode == Mode.TUTORIAL):
		line = L.t("loss_first", [line])   # V1.0.0 N6：前兩場還沒贏過：先講「輸很正常」再給建議
	return line

func _loss_pool() -> Array:
	if mode == Mode.PUZZLE or mode == Mode.TUTORIAL:
		return PZ.get_puzzle(puzzle_id).get("allowed", [])
	var out: Array = []
	var pool: int = int(armies[0].pool) if not armies.is_empty() else 0
	for ty in 20:
		if RuleSet.has(pool, ty):
			out.append(ty)
	return out

## 1.5.0：敗因卡用的兩個兵種 [主要傷害來源, 建議改帶]（-1＝沒有）；和 loss_summary 同一套判斷
static func loss_pair(counts: Dictionary, pool: Array) -> Array:
	var total := 0
	var top := -1
	var top_v := 0
	for k in counts:
		if str(k).begins_with("dmgby0_"):
			var v := int(counts[k])
			total += v
			if v > top_v:
				top_v = v
				top = int(str(k).substr(7))
	if top < 0 or total <= 0:
		return [-1, -1]
	var best := -1
	var best_sc := 0
	for ty in pool:
		var sc: int = AIT.counter_score(int(ty), top)
		if sc > best_sc:
			best_sc = sc
			best = int(ty)
	return [top, best]

## 純函式（測試用）。counts＝ev_count（含 dmgby0_<兵種>）、pool＝可以帶的兵種。
static func loss_summary(counts: Dictionary, pool: Array) -> String:
	var total := 0
	var top := -1
	var top_v := 0
	for k in counts:
		if str(k).begins_with("dmgby0_"):
			var v := int(counts[k])
			total += v
			if v > top_v:
				top_v = v
				top = int(str(k).substr(7))
	if top < 0 or total <= 0:
		return ""
	var best := -1
	var best_sc := 0
	for ty in pool:
		var sc: int = AIT.counter_score(int(ty), top)
		if sc > best_sc:
			best_sc = sc
			best = int(ty)
	var pct := roundi(top_v * 100.0 / total)
	if best >= 0:
		return L.t("loss_hint", [L.t("unit_%d" % top), pct, L.t("unit_%d" % best)])
	return L.t("loss_hint_n", [L.t("unit_%d" % top), pct])

