+## 1.5.0 §1.5 結果頁「更多」：次要動作的清單（每顆一列，紙籤）
+func _draw_res_more() -> void:
+	var rowh := maxf(48.0, tz("S") * 2.0 + 8.0)
+	var w := 520.0
+	var P := modal_rect(w, 12.0 + h1_bottom(0.0) + GAP_L + res_more_items.size() * (rowh + GAP_S) - GAP_S + GAP_L + 44.0 + GAP_L)
+	_panel(P)
