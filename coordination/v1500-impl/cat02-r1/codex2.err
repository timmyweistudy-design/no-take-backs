func _h1_help(center: Vector2, title: String, help: String, sz: int, maxw: float) -> float:
func _lobby_start() -> void:
	var why := _lobby_block()
	if why == "":
		Save.data["lobby_stamps"] = mini(99, int(Save.data.get("lobby_stamps", 0)) + 1)   # 1.4.0 §1.1 手帳上的印跡
		if sfx != null:
			sfx.play_pitched("place_heavy", 0.5, 0.8)   # 蓋印的悶響
	if why != "":
		_toast(why, true)
		return
	var lr: Dictionary = Save.data.get("last_rules", {})
	lr[lobby_kind] = lobby_r.to_code()
	lr[lobby_kind + "_preset"] = lobby_r.preset
	lr[lobby_kind + "_extra"] = [lobby_r.ai_style, lobby_r.map_mode, lobby_r.bans, lobby_r.time_of]   # 系列選項不進規則碼，另外記（Codex #8）
	Save.data["last_rules"] = lr
	Save.save_data()
	rules = lobby_r.copy()
	set("challenge_army", null)
	if lobby_kind == "duel" and rules.bans > 0:
		call("_begin_bans", rules.bans)
		return
	call("_start_mode", Mode.VS_AI if lobby_kind == "ai" else Mode.DUEL)

func _lobby_copy_code() -> void:
	DisplayServer.clipboard_set(lobby_r.to_code())
	_toast(L.t("lb_code_copied"))

func _lobby_paste_code(text := "") -> void:
	var from_clip := text == ""
	var d: Dictionary = RuleSet.from_code(DisplayServer.clipboard_get() if from_clip else text)
	if not d["ok"]:
		if from_clip and _ask_code(L.t("lb_paste"), _lobby_paste_code):
			return
		_toast(L.t(d["why"]) if d["why"].begins_with("rr_") else L.t("lb_code_bad"), true)
		return
	if _demo() and not call("_demo_ok", d["rules"]):
		_toast(L.t("bc_demo_locked"), true)
		return
	lobby_r = d["rules"]
	if not _lobby_locked_units().is_empty():
		_toast(_lobby_block(), true)   # 照原樣保留，開戰鈕會灰掉並寫原因
	else:
		_toast(L.t("lb_code_loaded"))

func _lobby_save_preset() -> void:
	var ps: Array = Save.data.get("rule_presets", [])
		pt_game += 1
	return {"v": 2, "session": pt_session, "game": pt_game, "code": BattleCode.encode(last_armies[0], last_armies[1], battle_rules, last_cmds),
		"event": "rating" if rating > 0 else "battle", "mode": _mode_label(), "round": round_no, "winner": sim.winner,
		"ticks": sim.tick, "reason": sim.reason, "blue": last_armies[0].to_code(), "red": last_armies[1].to_code(),
		"power": [sim.power(0), sim.power(1)], "suspense": report.get("sus", {}), "call_tick": pt_call_tick,
		"rating": rating, "rules": D.RULES_VERSION, "digest": D.data_digest()}



func _build_report() -> void:
	var dealt := [D.zeros(), D.zeros()]
	var taken := [D.zeros(), D.zeros()]
	var mvp = null
	for u in sim.units:
		dealt[u.team][D.report_type(u.type)] += u.dmg_dealt
		taken[u.team][D.report_type(u.type)] += u.dmg_taken
		# MVP：勝方輸出最高的兵（平手時看全場）
		if (sim.winner < 0 or u.team == sim.winner) and (mvp == null or u.dmg_dealt > mvp.dmg_dealt):
			mvp = u
	var sus: Dictionary = sim.suspense()
	report = {"dealt": dealt, "taken": taken, "mvp": mvp, "sus": sus,
		"lock_sec": int(sus["lock_ratio_permille"]) * sim.tick / 1000 / 20}
	# 時間軸的領先交換點（第三輪 U5）：戰力差換號（忽略 1% 以內的小波動），最多 4 個
	var leads: Array = []
	var last_sign := 0
	var eps: int = sim.budget * 1000 / 100
