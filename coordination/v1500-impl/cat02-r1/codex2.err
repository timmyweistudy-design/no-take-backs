			return



## 結果頁第二層：中線對比長條（輸出／承傷切換）＋技能徽章（只列有發生的）＋指紋。
var res_facts_all: Array = []
## 1.2.0：結果頁放不下時的完整事實清單（小面板）
## 1.5.0：星級一列——三顆金色星星圖示（紙面墨色模式不會把文字星號轉成灰）＋條件文字；回傳下一行的 y
func _star_row(y: float, n: int, txt: String) -> float:
	var ink0 := _ink_mode
	_ink_mode = false
	for k in 3:
		_icon("star", Vector2(640 - 26 + k * 26, y + 12), 22.0, Color("#ffd166") if k < n else Color(0.55, 0.5, 0.45, 0.6))
	_ink_mode = ink0
	_text(Vector2(640, y + 28), txt, tz("S"), ACCENT, true, false, 820)
	return y + 28 + text_h(txt, tz("S"), 820) + 4

const RES_MAIN_MAX := 2
var res_more_items: Array = []
## 1.5.0 §1.5 結果頁「更多」：次要動作的清單（每顆一列，紙籤）
func _draw_res_more() -> void:
	var rowh := maxf(48.0, tz("S") * 2.0 + 8.0)
	var w := 520.0
	var P := modal_rect(w, 12.0 + h1_bottom(0.0) + GAP_L + res_more_items.size() * (rowh + GAP_S) - GAP_S + GAP_L + 44.0 + GAP_L)
	_panel(P)
	var y := _h1(Vector2(640, P.position.y + 12), L.t("res_more")) + GAP_L
	for it in res_more_items:
		var cb: Callable = it[1]
		_btn(Rect2(P.position.x + 40, y, w - 80, rowh), str(it[0]), func(): overlay = ""; cb.call())
		y += rowh + GAP_S
	_btn(Rect2(560, P.end.y - GAP_L - 44.0, 160, 44), L.t("back"), func(): overlay = "", true, true)
	screen_register("result_more", "back")

func _draw_res_facts() -> void:
	var w := 820.0
	var hh := 0.0
	for f0 in res_facts_all:
		hh += text_h("・" + str(f0), tz("S"), w - 80) + 6
	var P := modal_rect(w, 12.0 + h1_bottom(0.0) + GAP_L + hh + GAP_L + 44.0 + GAP_L)
	_panel(P)
	var y := _h1(Vector2(640, P.position.y + 12), L.t("res_facts_title")) + GAP_L
	for f1 in res_facts_all:
		_text(Vector2(P.position.x + 40, y), "・" + str(f1), tz("S"), Color.WHITE, false, false, w - 80)
		y += text_h("・" + str(f1), tz("S"), w - 80) + 6
	_btn(Rect2(560, P.end.y - GAP_L - 44.0, 160, 44), L.t("back"), func(): overlay = "", true, true)

func _draw_result_details(R: Rect2) -> void:
	var dealt: Array = report["dealt"]
	var taken: Array = report["taken"]
	var src: Array = dealt if result_metric == 0 else taken
	var rows: Array = []
	for t in report_rows(dealt, taken):
		rows.append({"label": L.t("unit_%d" % t), "b": src[0][t], "r": src[1][t], "type": t})
	_text(R.position, L.t("report_by_type"), tz("B"), Color.WHITE, false, true, 210)
	_btn(Rect2(R.position.x + 220, R.position.y - 6, 120, 38), L.t("report_dealt"), func(): result_metric = 0, true, false, TH_ACTIVE if result_metric == 0 else Color(0, 0, 0, 0))
	_btn(Rect2(R.position.x + 346, R.position.y - 6, 120, 38), L.t("report_taken"), func(): result_metric = 1, true, false, TH_ACTIVE if result_metric == 1 else Color(0, 0, 0, 0))
	var bh := minf(170.0, rows.size() * 34.0)
	Charts.diverging(self, Rect2(R.position.x + 20, R.position.y + 40, R.size.x - 40, bh), rows)
	var y := R.position.y + 50 + bh
	var ek := report_badges(ev_count)
	for tm in 2:
		var tcl := Art.team_color(tm, cbm())
		var x := R.position.x + 20
		_text(Vector2(x, y + 4), "●" if tm == 0 else "◆", tz("S"), tcl.darkened(0.6) if _ink_mode else tcl, false, true)   # 1.2.0：紙上隊色記號壓深（對比 ≥4.5）
		x += 26
		for k in ek:
			var n := int(ev_count.get("%s%d" % [k, tm], 0))
			if n == 0:
				continue
			var lab := "%s %d" % [L.t("ev_short_" + k), n]
			var bw := _width(lab, tz("S"), true) + 16
			var br := Rect2(x, y, bw, tz("S") * 1.7)
			draw_rect(br, Color(tcl, 0.22))
			draw_rect(br, Color(tcl, 0.7), false, 1.5)
			_text(br.position + Vector2(8, tz("S") * 0.3), lab, tz("S"), Color.WHITE, false, true)
			x += bw + 6
		y += tz("S") * 2.1
	_text(Vector2(640, y + 4), L.t("fingerprint", [sim.fingerprint.substr(0, 12)]), tz("C"), TXT_DIM, true, false, 760)   # V1.2.1 F5：原 45% 白只有 2:1



## 一句描述（第五輪：只講事實、和 MVP 一致，不宣稱因果——Codex 第二輪）。主角＝MVP（勝方傷害最高的那一隻）。
## V1.1 B1：藍方（玩家）輸了才有。傷害最多的敵方兵種與占比；能帶的兵裡剋它最強的那種當建議。雙人、觀戰不顯示。
