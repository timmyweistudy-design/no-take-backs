+func quick_rematch_ok() -> bool:
+	return str(Save.data.get("last_rules", {}).get("ai", "")) != ""
+
+func _quick_rematch() -> void:
+	_open_lobby("ai")
+	if not quick_rematch_ok() or _lobby_block() != "":
+		return   # 停在大廳（照舊）
+	_lobby_start()
