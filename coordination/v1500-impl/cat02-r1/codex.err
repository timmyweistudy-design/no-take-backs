+## 1.5.0 §1.1 主動作登記（R14）：這一幀的畫面類別、主動作、豁免理由
+var probe_screen := {}
+func screen_register(cls: String, main: String, skip_why := "") -> void:
+	probe_screen = {"cls": cls, "main": main, "skip": skip_why}
+## R14 計數：這一幀可點的元件（棋盤格、時間軸這類宣告 grid 的不算）
+func click_count() -> int:
+	var n := 0
+	for b in _btns:
