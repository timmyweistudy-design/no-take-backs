# ── 覆蓋層 ──
func _draw_overlay() -> void:
	if overlay != "":
		_btns.clear()   # 覆蓋層底下畫面的按鈕不能被點到（例如擺放畫面的開戰、結果頁的按鈕）
		probe_texts.clear()   # 第五輪：底下畫面的字被遮罩蓋住，版面檢查只量覆蓋層本身
		probe_btns.clear()
		probe_ctrls.clear()
		probe_reset_geom()
		if state == St.TITLE:
			_dim(0.72)   # 第七輪：標題的示範戰場不透出來
	panel_obj = OBJ_OF.get(overlay, "")   # 1.2.0 §1.2：這個疊層的面板是桌上的哪一件實物（只換外框裝飾，內容版面不動）
	match overlay:
		"trials":
			_draw_trials()
		"puzzle_hint":
			_draw_puzzle_hint()
		"puzzle_plan":
			_draw_plan_overlay()
		"profile":
			_draw_profile()
		"nemeses":
			_draw_nemeses()
		"paint":
			_draw_paint()
		"hub_play", "hub_gauntlet", "hub_challenge", "hub_collect", "playroom":
			_draw_hub(overlay)
		"first_run":
			_draw_first_run()
		"restore":
			_draw_restore()
		"clear_data":
			_draw_clear_data()
		"ghosts":
			_draw_ghosts()
		"ga_info":
			_draw_ga_info()
		"weekly":
			_draw_weekly()
		"kit_demo":
			call("_draw_kit_demo")   # 1.2.0：開發用截圖（dev_main）
		"mood_demo":
			call("_draw_mood_demo")   # 1.2.0 第 5 大類：開發用截圖（dev_main）
		"boss_note":
			if note_ret != "":   # 疊在大廳上：先畫大廳（按鈕隨後清掉，點不到），再壓暗畫便條
				overlay = note_ret
				_draw_overlay()
				overlay = "boss_note"
				_btns.clear()
				probe_texts.clear()
				probe_btns.clear()
				probe_ctrls.clear()
				probe_reset_geom()
				_dim(0.55)
			_draw_boss_note()   # 1.2.0 §12
		"res_facts":
			call("_draw_res_facts")   # 1.2.0
		"res_more":
			call("_draw_res_more")   # 1.5.0 §1.5
		"wk_ghosts":
			call("_draw_wk_ghosts")   # 1.2.0 §15.4
## 暫停（第七輪 A6）：正式對局也能停下來看；繼續時放掉選取。
func _toggle_pause() -> void:
	paused = not paused
	if not paused and play_kind == "official":
		follow_id = -1


## 進重播前存結算畫面（第七輪 A9）。
func _replay_snapshot() -> void:
	if play_kind != "official" and not replay_snap.is_empty():
		return   # Codex r2：重播完再重播，返回目的地還是最早那個結算
	replay_snap = {"sim": sim, "view": view, "report": report, "marks": battle_marks.duplicate(true), "kind": play_kind,
		"tab": result_tab, "overlay": "", "ev_count": ev_count.duplicate(), "pt_rated": pt_rated, "pt_call": pt_call_tick}

## 重播的「返回」：回到進來的地方。只還原畫面，比分、進度、成就、試玩紀錄都不寫。
func _replay_back() -> void:
	tm_ghost = null   # V1.4 #1：回到結果頁，原本時間線的淡圈不能留下
	call("_pre_drop")
	seek_target = -1   # Codex r1：算到一半返回，不能把下一場快轉到舊目標
	skip_busy = false
	paused = false
	follow_id = -1
	zoom = 1.0
	zoom_target = 1.0
	fx.clear()
	frags.clear()   # 1.2.0 §8.2
	dying.clear()
	report_log.clear()
	sfx.set_muffled(false)
	if watch_mode or replay_snap.is_empty():
		call("_go_title")
		return
	sim = replay_snap["sim"]
	view = replay_snap["view"]
	report = replay_snap["report"]
	battle_marks = replay_snap["marks"]
	play_kind = replay_snap["kind"]
	result_tab = replay_snap["tab"]
	ev_count = replay_snap["ev_count"]   # Codex r1：戰報、評分狀態也要還原，不然同一局能再評一次
	pt_rated = replay_snap["pt_rated"]
	pt_call_tick = replay_snap["pt_call"]
	overlay = replay_snap["overlay"]
	result_delay = 0.0
	state = St.RESULT
	replay_snap = {}


## 從關鍵時刻開始重播（第七輪 A7）。
func _replay_from(t: int) -> void:
	call("_replay")
	_seek_async(t)


func _follow_update(delta: float) -> void:
	if play_kind == "official":
		return
	watch_mode = true


# ── 覆盤 ──
var rv_fsel := -1   # 第六輪：自由陣型覆盤選中的那一隻（索引）

func _open_review() -> void:
	rv_orig = last_armies[0].copy()
	rv_army = last_armies[0].copy()
	rv_enemy = last_armies[1].copy()
	rv_fsel = -1
	if rv_orig.deploy == "free":
		# 編輯識別（和戰鬥編號分開，Codex 第一輪）：覆盤時每隻帶 eid，「只改一隻」依 eid 比
		for i in rv_orig.units.size():
			rv_orig.units[i]["eid"] = i
			rv_army.units[i]["eid"] = i
		# 全場：搬移時也要守敵距
		var ep: Array = []
		for u in rv_enemy.units:
			ep.append(Army.pos_of(u))
		if rv_orig.depth > rv_orig.fw / 2:
			rv_army.enemy_pos = ep
			rv_orig.enemy_pos = ep.duplicate()
	rv_sel = Vector2i(-1, -1)
	_rv_dirty()
	_rv_base_start()
	_open("review")

## 跟原本比改了幾隻（換兵種、移位、拿掉、新增都算一隻）。
static func review_changes(orig, now) -> int:
	if orig.deploy == "free":
		var ma := {}
		for u in orig.units:
			ma[int(u.get("eid", -1))] = [int(u["type"]), int(u["x"]), int(u["y"])]
		var n := 0
		var seen := {}
		for u in now.units:
			var e := int(u.get("eid", -1))
			seen[e] = true
			if not ma.has(e) or ma[e] != [int(u["type"]), int(u["x"]), int(u["y"])]:
				n += 1
