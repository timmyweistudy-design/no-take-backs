	call("_pre_drop")
	Save.retry_pending()   # 第七輪 R7：上次沒寫成功的補寫；還是失敗，標題頁會常駐提示
	sfx.set_muffled(false)
	watch_mode = false
	clutch_t = 0.0
	state = St.TITLE
	overlay = ""
	set("settings_ret", "")
	nav_stack.clear()
	if nav_hub != "":
		overlay = nav_hub   # V1.5.1：從卡片面板進去打完，回來時回到那個面板
	sim = null
	view = null
	zoom = 1.0
	_focus = int(nav_focus.get(overlay, 0)) if overlay != "" else 0   # V1.0.0（Codex v100-i3）：打完回卡片面板，焦點回原卡
	_new_demo()
	sfx.play_music("music_title")
	sfx.play_ambience("")



func _new_demo() -> void:
	var r := RandomNumberGenerator.new()
	r.seed = rng.randi()
	demo = Sim.new(AI.build(0, 100, r)["army"], AI.build(1, 100, r)["army"])
	demo.fast = true
	demo_acc = 0.0



## 第六輪（Codex 實作第 1 輪 #5）：雙人全場被封鎖到跳完手、一方沒有戰鬥兵時，照樣按「開戰」——
## 模擬在第 0 tick 就依 §3.8 判定（有戰鬥兵的一方勝、雙方都沒有＝和局），不能卡在開戰鈕永久灰掉。
func _full_blocked_ok() -> bool:
	return mode == Mode.DUEL and tp != null and tp.done() and rules != null and rules.is_free() and rules.fullfield == RuleSet.FULL_DUEL


func _ready_to_fight() -> bool:
	if mode == Mode.DUEL:
		if tp != null:
func coach_ok() -> bool:
	if play_kind != "official" or watch_mode or sim == null or sim.winner == 0 or last_armies.size() != 2:
		return false
	if bool(rush.get("on", false)) or not (mode == Mode.PUZZLE or mode == Mode.VS_AI):
		return false
	if not (get("daily_spec") as Dictionary).is_empty():
		return false   # V1.6.1 A4：每日挑戰不給教練（大家同一題、上排行榜）
	if mode == Mode.PUZZLE and bool(report.get("goal_ok", false)):
		return false
	return Coach.supported(last_armies[0], battle_rules, _coach_pz())

func _coach_open() -> void:
	var key := "%d:%s:%d:%d:%s:%d" % [mode, puzzle_id, last_armies[0].units.hash(), last_armies[1].units.hash(), battle_rules.to_code() if battle_rules != null else "", _coach_pz().hash()]
	if co_thread != null:
		if key != co_key:
			co_key = key   # 換場了：舊的答案算完不收（_v16_jobs 比對 co_thread_key），算完再重開會重算
			co_res = {}
			co_layer = 0
		overlay = "coach"
		_focus = 0
		return
	if key != co_key:
		co_key = key
		co_res = {}
		co_layer = 0
		var a0 = last_armies[0].copy()
		var a1 = last_armies[1].copy()
		var rr = battle_rules.copy() if battle_rules != null else null
		var pz := _coach_pz()
		var ctl := {"stop": false, "until": Time.get_ticks_msec() + Coach.TIME_MS, "done": 0}
		co_ctl = ctl
		if DisplayServer.get_name() == "headless" or shot_dir != "":
			co_res = Coach.search(a0, a1, rr, pz, Coach.LIMIT, ctl)
		else:
			co_thread = bg.start(func(): return Coach.search(a0, a1, rr, pz, Coach.LIMIT, ctl), ctl)
			co_thread_key = key
