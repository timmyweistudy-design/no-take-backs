index 462baf9..7329473 100644
--- a/game/scripts/ui/screens/game_result.gd
+++ b/game/scripts/ui/screens/game_result.gd
@@ -195,10 +195,7 @@ func _draw_result() -> void:
 		col = Color("#fff6e0")
 		title_sz = nxt
