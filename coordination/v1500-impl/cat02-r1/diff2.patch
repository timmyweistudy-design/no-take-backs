+	var gm: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_menus.gd")
+	ok(gm.find("screen_register(\"title\", \"plaque_battle\")") >= 0 and gm.find("[\"menu_codes\", func(): overlay = \"codes\"") < 0, "標題登記主動作；代碼不在標題系統列")
