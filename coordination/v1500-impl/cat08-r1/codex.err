   198	## 暫停時點一隻兵看狀態（第七輪 A6）。
   199	func _draw_unit_info() -> void:
   200		if not paused or follow_id < 0 or view == null:
   201			return
   202		var u = view.unit_by_id(follow_id)
   203		if u == null:
   204			return
   205		var tname := L.t("ui_none")
   206		if u.target >= 0 and u.target < view.units.size() and view.units[u.target].alive:
   207			tname = L.t("unit_%d" % view.units[u.target].type)
   208		var lines: Array = [
   209			"%s（%s）" % [L.t("unit_%d" % u.type), L.t("blue") if u.team == 0 else L.t("red")],
   210			L.t("ui_hp", [u.hp, u.max_hp]),
   211			L.t("ui_target", [tname]),
   212			L.t("ui_cd", ["%.1f" % (u.cd / 80.0)]),
   213			L.t("ui_stats", [u.dmg_dealt, u.kills]),
   214		]
   215		# 1.5.0 §13：黑底等寬資訊框 → 米紙浮籤（左緣一條隊色布條）；放在畫面右上，所選兵在右上時改放左上（不蓋住牠）
