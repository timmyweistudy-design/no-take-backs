   231	func _update_action_focus() -> void:
   232		var sum := Vector2.ZERO
   233		var n := 0
   234		for u in view.units:
   235			if u.alive and ((hurt_t.has(u.id) and time - hurt_t[u.id] < 0.8) or (atk_t.has(u.id) and time - atk_t[u.id] < 0.8)):
   236				sum += _upos(u)
   237				n += 1
   238		action_focus = sum / n if n > 0 else zoom_center
