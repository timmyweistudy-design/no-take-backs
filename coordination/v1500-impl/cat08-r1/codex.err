   212	## 戰場色調：依模式固定（使用者決定：一般晨曦、殘局黃昏、遠征月夜）。
   213	func _tone() -> Color:
   214		if state == St.TITLE:
   215			return Color(1.0, 0.72, 0.45, 0.07)
   216		if rules != null and rules.time_of != 0:
   217			return Color(0.95, 0.42, 0.3, 0.16) if rules.time_of == 1 else Color(0.12, 0.16, 0.42, 0.30)
   218		var mt := _mode_tone()
   219		if mt.a > 0.0:
   220			return mt
   221		match mode:
   222			Mode.PUZZLE:
   223				return Color(0.95, 0.42, 0.3, 0.16)    # 黃昏
   224			Mode.GAUNTLET:
   225				return Color(0.12, 0.16, 0.42, 0.30)   # 月夜
