   187	## 這隻兵附近（60px 內）有幾隻活著的兵，不算自己。
   188	func _crowd_at(u) -> int:
   189		var n := 0
   190		var p := _upos(u)
   191		for v in view.units:
   192			if v.alive and v.id != u.id and _upos(v).distance_squared_to(p) < 3600.0:
   193				n += 1
   194		return n
