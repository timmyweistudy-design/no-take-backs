  2440	# ── 1.3.0 第 12 大類：每日老闆出題（方案 §12.7）──
  2441	const OwnerDaily = preload("res://scripts/game/owner_daily.gd")
  2442	## 今天的題單（存在存檔的 od.picks；當天第一次看到才抽，之後拿到三星也不重抽）。
  2443	func od_today() -> Array:
  2444		var ids: Array = []
  2445		for p in PZ.all_puzzles():
  2446			ids.append(str(p["id"]))
  2447		var r: Array = OwnerDaily.today_picks(Save.data.get("od", {}), Daily.today(), ids, Save.data.get("puzzle_stars", {}))
  2448		Save.data["od"] = r[1]
  2449		return r[0]
  2450	
  2451	func _od_after(id: String, stars: int) -> void:
  2452		var r: Array = OwnerDaily.record(Save.data.get("od", {}), Daily.today(), od_today(), id, stars)
  2453		Save.data["od"] = r[0]
  2454		if bool(r[1]):
  2455			Save.data["od_stamps"] = int(Save.data.get("od_stamps", 0)) + 1
  2456			_toast(L.t("od_stamp_got"))
  2457			if sfx != null:
  2458				sfx.play("place_heavy", 0.8)   # 1.4.0 §10.5 紅泥小章落下「咚」
  2459			if sfx != null and sfx.has_method("play_voice"):
  2460				sfx.play_voice("happy")   # 老闆蓋印時哼一聲
  2461	
  2462	func _draw_owner_daily() -> void:
  2463		var picks := od_today()
  2464		var rec: Dictionary = OwnerDaily.sanitize(Save.data.get("od", {}))
  2465		var done: Array = rec["done"] if int(rec["day"]) == Daily.today() else []
  2466		var help := L.t("od_help")
  2467		var rowh := 52.0
  2468		var foot := L.t("od_stamps", [int(Save.data.get("od_stamps", 0))])
  2469		var bk := stamp_page(int(Save.data.get("od_stamps", 0)))
  2470		var book := L.t("od_book", [int(bk[0])])
  2471		var slot := 30.0
  2472		var P := modal_rect(720, 12.0 + h1_help_h(help, tz("S"), 640) + GAP_L + picks.size() * (rowh + GAP_S) + GAP_M + text_h(foot, tz("S"), 640) + GAP_M + text_h(book, tz("S"), 640) + GAP_S + slot + GAP_L + 44.0 + GAP_L)
  2473		_panel(P)
  2474		var y := _h1_help(Vector2(640, P.position.y + 12), L.t("od_title"), help, tz("S"), 640) + GAP_L
  2475		var stars: Dictionary = Save.data.get("puzzle_stars", {})
  2476		for id in picks:
  2477			var pz := PZ.get_puzzle(id)
  2478			var st := int(stars.get(id, 0))
  2479			var mark := L.t("od_done") if id in done else L.t("od_todo")
  2480			var label := "%s　%s　%s" % [L.field(pz, ""), "★".repeat(st) + "☆".repeat(3 - st), mark]
  2481			var pid: String = id
  2482			# 1.5.0 §13：三顆都是次鈕（原本三條亮紅主鈕太刺眼）；左邊一個木章凹槽：做過＝蓋了紅泥章、沒做＝空槽
  2483			var br := Rect2(P.position.x + 40 + 48, y, P.size.x - 80 - 48, 44)
  2484			_btn(br, label, func(): overlay = ""; _pick_puzzle(pid, false))
  2485			var sc := Vector2(P.position.x + 40 + 20, y + 22)
  2486			draw_circle(sc, 17.0, Color(PAL.TRINKET_LEATHER.darkened(0.45), 0.9), true, -1.0, true)   # 凹槽
  2487			draw_circle(sc + Vector2(0, -1), 15.0, Color(DIM_INK, 0.5), true, -1.0, true)
  2488			if id in done:
  2489				draw_circle(sc, 12.0, Color(PAL.TRINKET_RED, 0.92), true, -1.0, true)
  2490				_hand_ring(sc, 8.5, Color(1, 0.88, 0.78, 0.7), 1.5)
  2491			y += rowh + GAP_S
  2492		y += GAP_M - GAP_S
  2493		_text(Vector2(640, y), foot, tz("S"), ACCENT, true, false, 640)
  2494		y += text_h(foot, tz("S"), 640) + GAP_M
  2495		# 1.4.0 §10.5 印章冊：一頁 10 格，蓋滿翻下一頁（老闆的紅泥小章；空格是淡淡的框）
  2496		_text(Vector2(640, y), book, tz("S"), TXT_DIM, true, false, 640)
  2497		y += text_h(book, tz("S"), 640) + GAP_S
  2498		var x0 := 640.0 - (STAMP_PER_PAGE * slot + (STAMP_PER_PAGE - 1) * 8.0) / 2.0
  2499		for si in STAMP_PER_PAGE:
  2500			var sr := Rect2(x0 + si * (slot + 8.0), y, slot, slot)
  2501			if si < int(bk[1]):
  2502				draw_rect(sr.grow(-2), Color(PAL.TRINKET_RED, 0.85))
  2503				draw_rect(sr.grow(-7), Color(1, 0.9, 0.8, 0.35), false, 1.5)
  2504			else:
  2505				draw_rect(sr.grow(-2), Color(TXT_DIM, 0.35), false, 1.5)
  2506		_btn(Rect2(560, P.end.y - GAP_L - 44.0, 160, 44), L.t("back"), func(): _nav_back())
  2507	
  2508	## 印章冊：第幾頁、這頁蓋了幾格（10 的倍數＝這頁剛好蓋滿，不跳到空白新頁）
  2509	const STAMP_PER_PAGE := 10
  2510	static func stamp_page(n: int) -> Array:
  2511		if n <= 0:
  2512			return [1, 0]
  2513		return [(n - 1) / STAMP_PER_PAGE + 1, (n - 1) % STAMP_PER_PAGE + 1]
