   181	## 跳字的外框（含描邊與底襯，戰場座標）。
   182	func _text_rect(f: Dictionary, at: Vector2) -> Rect2:
   183		var sz := int(ts(int(f["size"])) * (1.0 + float(f.get("pop", 0.0)) * 1.4))   # 含合併時的彈跳放大（Codex S1 #4）
   184		var w := font_bold.get_string_size(f["s"], HORIZONTAL_ALIGNMENT_LEFT, -1, sz).x + 14.0 if font_bold != null else float(f["s"].length() * sz)
   185		var h := sz * 1.3 + 6.0
   186		return Rect2(at.x - w / 2.0, at.y - 3.0, w, h)
   187	
   188	
   189	static func _text_alpha(f: Dictionary) -> float:
   190		var k: float = f["t"] / f["dur"]
   191		return 1.0 - k * k
   192	
