   673	## 卡池唯讀摘要：「10 種・近戰 4・遠程 3・支援 2・奇襲 1」（類別跟篩選膠囊同一套）
   674	func pool_summary(mask: int) -> String:
   675		var n := [0, 0, 0, 0]
   676		var tot := 0
   677		for t in D.total():
   678			if not RuleSet.has(mask, t):
   679				continue
   680			tot += 1
   681			if t in Presets.F8.RAID:
   682				n[3] += 1
   683			elif D.is_support(t):
   684				n[2] += 1
   685			elif D.is_melee(t):
   686				n[0] += 1
   687			else:
   688				n[1] += 1
   689		var parts: Array = [L.t("lb_pool_n", [tot])]
   690		for k in 4:
   691			if n[k] > 0:
   692				parts.append("%s %d" % [L.t("lb_filter_%d" % (k + 1)), n[k]])
   693		return "・".join(parts) if (L.lang.begins_with("zh") or L.lang == "ja") else " · ".join(parts)
   694	
   695	func _filter_hit(t: int) -> bool:
   696		match lobby_filter:
   697			1:
   698				return D.is_melee(t) and not D.is_support(t) and not t in Presets.F8.RAID
   699			2:
   700				return not D.is_melee(t) and not D.is_support(t) and not t in Presets.F8.RAID
   701			3:
   702				return D.is_support(t)
   703			4:
   704				return t in Presets.F8.RAID
   705		return true
