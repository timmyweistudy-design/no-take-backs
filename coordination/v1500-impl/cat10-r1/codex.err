   167	
   168	static func f8():
   169		if _f8 == null:
   170			_f8 = load("res://scripts/core/fantasy_defs.gd")
   171		return _f8
   172	
   173	## 可以擺的兵種總數（新舊合計）。COUNT 維持 10：舊規則、舊 AI 的迴圈都靠它不變。
   174	static func total() -> int:
   175		return 20
   176	
   177	static func stat(t: int) -> Dictionary:
   178		return STATS[t] if t < COUNT else f8().STATS[t - COUNT]
   179	
   180	static func name_of(t: int) -> String:
   181		return NAMES[t] if t < COUNT else f8().NAMES[t - COUNT]
   182	
   183	## 用到新兵的場次用的數值摘要。舊場次仍是 data_digest()，一個位元組都不變。
   184	static var _digest_v8 := ""
   185	static func digest_v8() -> String:
   186		if _digest_v8 == "":
   187			var m: Dictionary = f8().get_script_constant_map()
   188			var pairs: Array = []
   189			for k in m:
   190				pairs.append([String(k), m[k]])
   191			pairs.sort_custom(func(a, b): return a[0] < b[0])
   192			var txt := data_digest()
   193			for pr in pairs:
   194				txt += "%s=%s;" % [pr[0], var_to_str(pr[1])]
   195			_digest_v8 = txt.sha256_text().substr(0, 16)
   196		return _digest_v8
   197	
   198	static func uses_new(armies: Array) -> bool:
   199		for a in armies:
   200			for u in a.units:
   201				if int(u["type"]) >= COUNT:
   202					return true
   203		return false
   204	
   205	static func version_of(armies: Array) -> String:
   206		return "1.4.1" if uses_new(armies) else RULES_VERSION   # 1.4.1：第十二輪吸塵貓改成拉向自己
   207	
   208	static func digest_of(armies: Array) -> String:
   209		return digest_v8() if uses_new(armies) else data_digest()
   210	
   211	## 結果頁、老兵筆記把生出來的兵算回母體的兵種。
   212	static func report_type(t: int) -> int:
   213		return 13 if t == 20 else (17 if t == 21 else t)
   214	
   215	static func cost(t: int) -> int:
   216		return stat(t)["cost"]
   217	
   218	static func is_melee(t: int) -> bool:
   219		return t != ARCHER and t != BOMBER and t != 17   # 17＝骷髏法師
   220	
   221	## 支援兵（第四輪）：隊上還有戰鬥兵活著時不攻擊，只做支援走位。
   222	static func is_support(t: int) -> bool:
   223		return t == MEDIC or t == DRUMMER or t == 16   # 16＝沙漏精靈
   224	
   225	## 戰鬥兵：開戰至少要有 1 隻。支援兵和奇襲兵（孢子菇、爆爆羊、寶箱怪）都不算。
   226	static func is_combat(t: int) -> bool:
   227		return not is_support(t) and t != 10 and t != 11 and t != 12
