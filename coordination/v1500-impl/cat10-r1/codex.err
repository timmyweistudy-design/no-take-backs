   117	## 把規則裡不能選的兵拿掉（解鎖進度、試玩版）；拿掉後沒有戰鬥兵就退回可選的全部。回傳被拿掉的兵種。
   118	static func clamp_pool(r, kind: String, unlocked: int, demo: bool) -> Array:
   119		var sel := selectable(kind, unlocked, demo)
   120		var removed: Array = []
   121		for tm in 2:
   122			var p := int(r.pool[tm])
   123			for t in D.total():
   124				if RSET.has(p, t) and not RSET.has(sel, t) and not t in removed:
   125					removed.append(t)
   126			p &= sel
   127			if not RSET.has_combat(p):
   128				p = sel
   129			r.pool[tm] = p
   130		return removed
