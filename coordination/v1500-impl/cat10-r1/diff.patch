+func pool_summary(mask: int) -> String:
+	var n := [0, 0, 0, 0]
+	var tot := 0
+	for t in D.total():
+		if not RuleSet.has(mask, t):
+			continue
+		tot += 1
+		if t in Presets.F8.RAID:
+			n[3] += 1
+		elif D.is_support(t):
+			n[2] += 1
+		elif D.is_melee(t):
+			n[0] += 1
+		else:
+			n[1] += 1
+	var parts: Array = [L.t("lb_pool_n", [tot])]
+	for k in 4:
+		if n[k] > 0:
+			parts.append("%s %d" % [L.t("lb_filter_%d" % (k + 1)), n[k]])
+	return "・".join(parts) if (L.lang.begins_with("zh") or L.lang == "ja") else " · ".join(parts)
