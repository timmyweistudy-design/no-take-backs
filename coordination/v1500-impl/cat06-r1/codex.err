  1322	static func backup_label(nm: String) -> String:
  1323		var b := nm.get_file().trim_suffix(".json")
  1324		var at := b.rfind("_", b.length() - 7)
  1325		if at < 9:
  1326			return b
  1327		var d := b.substr(at - 8, 8)
  1328		var t := b.substr(at + 1, 6)
  1329		if not d.is_valid_int() or not t.is_valid_int() or d.length() != 8 or t.length() != 6:
  1330			return b
  1331		return "%s/%s/%s %s:%s" % [d.substr(0, 4), d.substr(4, 2), d.substr(6, 2), t.substr(0, 2), t.substr(2, 2)]
