  1235	static func backup_list() -> Array:
  1236		var out: Array = []
  1237		var dir := DirAccess.open(backup_dir())
  1238		if dir == null:
  1239			return out
  1240		for f in dir.get_files():
  1241			if f.ends_with(".json"):
  1242				out.append(f)
  1243		out.sort()
  1244		out.reverse()
  1245		return out
