  1247	func _progress_backup() -> bool:
  1248		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(backup_dir()))
  1249		var dt := Time.get_datetime_dict_from_system()
  1250		var base := "progress_%04d%02d%02d_%02d%02d%02d" % [dt["year"], dt["month"], dt["day"], dt["hour"], dt["minute"], dt["second"]]
  1251		var name := base + ".json"
  1252		var k := 2
  1253		while FileAccess.file_exists(backup_dir() + "/" + name):
  1254			name = "%s_%02d.json" % [base, k]   # 兩位數流水號：字串排序＝時間順序（Codex v150-f3 #3）   # 同一秒連按：不蓋掉前一份（Codex v150-i2 #3）
  1255			k += 1
  1256		var f := FileAccess.open(backup_dir() + "/" + name, FileAccess.WRITE)
  1257		if f == null:
  1258			_toast(L.t("backup_fail"), true)
  1259			return false
  1260		f.store_string(JSON.stringify(Save.data))
  1261		var werr := f.get_error()
  1262		f.close()
  1263		if werr != OK:
  1264			_toast(L.t("backup_fail"), true)
  1265			return false
  1266		var lst := backup_list()
  1267		while lst.size() > 10:   # 最多留 10 份
  1268			DirAccess.remove_absolute(ProjectSettings.globalize_path(backup_dir() + "/" + str(lst.pop_back())))
  1269		_toast(L.t("backup_done", [name]))
  1270		return true
