   895	## 只在可以改已擺的兵時能用（雙人輪流落子、殘局固定兵、遠征限改都照舊擋）；不合法整筆還原並提示。
   896	func _deploy_tools_ok() -> bool:
   897		return _can_edit_existing() and not _cp_on() and mode != Mode.TUTORIAL and mode != Mode.PUZZLE and not (mode == Mode.GAUNTLET and gauntlet_stage > 1) and not (mode == Mode.VS_AI and bool(get("wv_active")))
   898	
   899	func _deploy_tool(id: String) -> bool:
   900		if id == "foe":
   901			foe_tag_open = not foe_tag_open   # 1.5.0 §1.4：按住 RT＋View＝開合敵情翻牌（不受部署工具限制）
   902			return true
   903		if not _deploy_tools_ok():
   904			return false
   905		call("_mb_release_cleanup")   # 拖曳／框選／塗兵進行中用工具：先取消那個操作（不然放開時用舊起點再位移；Codex cat11 #4）
