+## 1.5.0 §2：備份檔名 progress_20261110_120000.json → 「2026/11/10 12:00」（讀不出來就照原檔名）
+static func backup_label(nm: String) -> String:
+	var b := nm.get_file().trim_suffix(".json")
+	var at := b.rfind("_", b.length() - 7)
+	if at < 9:
+		return b
+	var d := b.substr(at - 8, 8)
+	var t := b.substr(at + 1, 6)
+	if not d.is_valid_int() or not t.is_valid_int() or d.length() != 8 or t.length() != 6:
+		return b
+	return "%s/%s/%s %s:%s" % [d.substr(0, 4), d.substr(4, 2), d.substr(6, 2), t.substr(0, 2), t.substr(2, 2)]
+
 func _draw_restore() -> void:
 	_dim(0.6)
 	# V1.5.2 L3／L7：說明從緞帶下緣＋16 起、面板高度照內容（沒有備份時不留 500px 空白）、水平置中
@@ -1331,7 +1343,7 @@ func _draw_restore() -> void:
 		_text(Vector2(640, ry), L.t("restore_none"), tz("B"), TXT_DIM, true, false, 560)
 	for i in n:
 		var nm: String = lst[i]
