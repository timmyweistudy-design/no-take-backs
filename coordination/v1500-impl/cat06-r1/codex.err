   859	## 操作說明（第五輪：從頂部移到「?」；第一次進擺放畫面自動打開）。
   860	func _draw_place_help() -> void:
   861		if not show_place_help:
   862			return
   863		var lines: Array = [L.t("place_hint_lock")]
   864		if _is_free():
   865			# 第六輪：自由排兵的手勢（雙人＝放開即落子、不能收回）
   866			lines.append(L.t("place_hint_fp_turns" if mode == Mode.DUEL and tp != null else "place_hint_fp"))
   867			lines.append(L.t("place_hint_fp_tools"))
   868		elif mode == Mode.DUEL and tp != null:
   869			lines.append(L.t("place_hint_turns"))
   870		else:
   871			lines.append(L.t("place_hint_free"))
   872		var kt: Dictionary = Save.s("keys")
   873		lines.append(L.t("place_hint_keys", [Keymap.key_name(kt, "prev"), Keymap.key_name(kt, "next"), Keymap.key_name(kt, "start"), Keymap.key_name(kt, "codex")]))
   874		if _deploy_tools_ok():
   875			if pad_mode:
   876				# 1.2.0 第 11 大類：手把按住 RT；Y＝「暫停」、LB＝「上一種」的綁定（改鍵後照實際按鍵顯示；Codex cat11 #5）
   877				var rt: String = {"ps": "R2", "nintendo": "ZR"}.get(Keymap.pad_family(Input.get_joy_name(last_joy)), "RT")
   878				lines.append(L.t("place_hint_tools_fp_pad" if _is_free() else "place_hint_tools_pad", [rt, _pk("pause"), _pk("prev")]))
   879			else:
   880				lines.append(L.t("place_hint_tools_fp") if _is_free() else L.t("place_hint_tools", [Keymap.key_name(kt, "flip")]))   # 1.2.0 §11.1
   881		if mode == Mode.VS_AI and pad_mode:
   882			var rt2: String = {"ps": "R2", "nintendo": "ZR"}.get(Keymap.pad_family(Input.get_joy_name(last_joy)), "RT")
   883			lines.append(L.t("place_hint_foe_pad", [rt2, _pk("codex")]))   # 1.5.0 §1.4
   884		var body := "\n".join(lines)
   885		var w := 520.0
   886		var h := text_h(body, tz("S"), w - 28) + 24
   887		var r := Rect2(1280 - w - 12, 96, w, h)
   888		draw_rect(r, Color(0.06, 0.07, 0.1, 0.95))
   889		draw_rect(r, ACCENT, false, 1.5)
   890		_text(r.position + Vector2(14, 12), body, tz("S"), Color.WHITE, false, false, w - 28)
   891	
