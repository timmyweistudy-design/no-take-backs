  1272	## ── V1.6.1 A12：異變練習場（自己挑異變；不記週紀錄，不算裂隙成績） ──
  1273	var rift_lab: Array = []   # 選了哪些異變（ANOMS 索引）
  1274	func rift_lab_toggle(k: int) -> void:
  1275		if k in rift_lab:
  1276			rift_lab.erase(k)
  1277			return
  1278		var tg: String = Rift.ANOMS[k][1]
  1279		rift_lab = rift_lab.filter(func(j): return Rift.ANOMS[j][1] != tg)   # 同類別換掉
  1280		rift_lab = rift_lab.filter(func(j): return not Rift.clash([j], k))   # 容易磨到時間到的組合也換掉（練習場同一套規則）
  1281		var trial: Array = rift_lab + [k]
  1282		if Rift.make_rules(trial, RS.mask(_demo()), Rift.week()).validate().is_empty():
  1283			rift_lab = trial
  1284		else:
  1285			_toast(L.t("rf_lab_bad"), true)
  1286	
  1287	func _rift_lab_start() -> void:
  1288		var wk := Rift.week()
  1289		var r = Rift.make_rules(rift_lab, RS.mask(_demo()), wk)
  1290		rules = r
  1291		set("challenge_army", Rift.enemy(r, wk))
  1292		_start_mode(Mode.VS_AI)
  1293		daily_spec = {}
  1294		rift_on = false   # 練習：不記紀錄
  1295	
  1296	func _draw_rift_lab() -> void:
  1297		var n := Rift.ANOMS.size()
  1298		var rows := ceili(n / 2.0)
  1299		# V1.6.1：異變說明在英文會換兩、三行：每列高度照兩欄裡最長的那個（文字在按鈕裡自己排，不用按鈕標籤）
  1300		var rh: Array = []
  1301		var tot := 0.0
  1302		for ri in rows:
  1303			var h := 46.0
  1304			for c in 2:
  1305				var k0: int = ri * 2 + c
  1306				if k0 < n:
  1307					h = maxf(h, text_h("✓ " + L.t(str(Rift.ANOMS[k0][0])), tz("C"), 335.0) + 14.0)
  1308			rh.append(h)
  1309			tot += h + 6.0
  1310		var P := modal_rect(820, 12.0 + h1_help_h(L.t("rf_lab_help"), tz("S"), 740) + GAP_L + tot + GAP_L + 52.0 + GAP_M + 44.0 + GAP_L)
  1311		_panel(P)
  1312		var y := _h1_help(Vector2(640, P.position.y + 12), L.t("rf_lab"), L.t("rf_lab_help"), tz("S"), 740)
  1313		for ri in rows:
  1314			for c in 2:
  1315				var k: int = ri * 2 + c
  1316				if k >= n:
  1317					continue
  1318				var kk := k
  1319				var on: bool = k in rift_lab
  1320				var br := Rect2(640 - 370 + c * 375, y, 365, float(rh[ri]))
  1321				_btn(br, "", func(): rift_lab_toggle(kk), true, k == 0, TH_ACTIVE if on else Color(0, 0, 0, 0))
  1322				_probe_btn_label = true
  1323				_probe_btn_rect = br
  1324				# 1.3.0 R11（Codex cat01 #5）：異變按鈕自己畫的標籤也是格子字——宣告按鈕面、墨跡置中
  1325				var rlab: String = ("✓ " if on else "") + L.t(str(Rift.ANOMS[k][0]))
  1326				var rsz: int = fit(rlab, tz("C"), 323.0, on)   # 左右各留 21px（Antigravity Hydrogen cat01：日文 150% 長字貼邊）
  1327				var rlines: Array = wrap_lines(rlab, rsz, 323.0, on)
  1328				var rlab2: String = balance_two_lines(rlab) if rlines.size() == 2 else "\n".join(rlines)   # 兩行時從中間斷（日文 150% 不留「可」「石」單字一行；Antigravity cat01）
