   477	## 資訊帶右邊（「?」左邊）兩顆小鈕
   478	func _tv_buttons(help: Rect2, notebook := false) -> void:
   479		var b1 := Rect2(help.position.x - 88, help.position.y, 40, 36)
   480		var b2 := Rect2(help.position.x - 44, help.position.y, 40, 36)
   481		if notebook:
   482			b1.position.x -= 44
   483			b2.position.x -= 44
   484			var b3 := Rect2(help.position.x - 44, help.position.y, 40, 36)
   485			_btn(b3, "", func(): overlay = "notebook"; _focus = 0)
   486			_icon_in(b3, "book", 20.0, Color.WHITE)
   487			if b3.has_point(mouse):
   488				_tv_tip(L.t("nb_tip"), help)
   489		_btn(b1, "", func(): tv_range = not tv_range, true, false, TH_ACTIVE if tv_range else Color(0, 0, 0, 0))
   490		_icon_in(b1, "range", 20.0, Color.WHITE)
   491		_btn(b2, "", func(): tv_mark_mode = not tv_mark_mode, true, false, TH_ACTIVE if tv_mark_mode else Color(0, 0, 0, 0))
   492		_icon_in(b2, "flag", 20.0, Color.WHITE)
   493		if b1.has_point(mouse) or b2.has_point(mouse):
   494			_tv_tip(L.t("tv_range_tip") if b1.has_point(mouse) else L.t("tv_mark_tip"), help)
