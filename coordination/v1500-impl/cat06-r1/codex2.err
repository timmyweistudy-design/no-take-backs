  1329		var v: Array = []
  1330		for k in range(1, 7):
  1331			v.append(int(m.get_string(k)))
  1332		if v[1] < 1 or v[1] > 12 or v[2] < 1 or v[2] > 31 or v[3] > 23 or v[4] > 59 or v[5] > 59:
