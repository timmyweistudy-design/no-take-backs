   175	func _seek_finish() -> void:
   176		clock_last = -1   # 1.4.0 §7.2：跳轉後棋鐘不補跳不補響
   177		if sfx != null and sfx.has_method("reseed"):
   178			sfx.reseed(sfx.seed_at(round_no, view.tick if view != null else 0))   # 1.3.0 §10：跳轉後音效變體從同一個狀態開始
   179		call_deferred("_tm_sync")
   180		var target := _seek_target_now
   181		var keep_ct := _seek_ct
   182		var had_clutch := keep_ct >= 0
   183		view = ViewBuffer.new(sim)
   184		prev_pos.clear()
   185		_gait_reset()
   186		for u in view.units:
   187			prev_pos[u.id] = Vector2(u.x, u.y)
   188		fx.clear()
   189		frags.clear()   # 1.2.0 §8.2
   190		dying.clear()
   191		graves.clear()
   192		# V1.5.1 B2：跳轉前 1～4 秒倒下的兵，陣亡小旗照時間補回（倒地 1 秒後插旗、旗子留 3 秒）
   193		for did in _seek_deaths:
   194			var age: float = float(target - int(_seek_deaths[did])) / 20.0
   195			var dv = view.unit_by_id(int(did))
   196			if dv != null and age >= 1.0 and age < 4.0:
   197				graves.append({"pos": _upos(dv), "team": dv.team, "t": age - 1.0})
   198			elif dv != null and age >= 0.0 and age < 1.0:
   199				# 不到一秒前倒下：倒地演出接著播完，跨過 1 秒照常插旗（Codex v151-i2 #1）
   200				dying.append({"pos": _upos(dv), "type": dv.type, "team": dv.team, "face": signf(dv.fx) if dv.fx != 0 else 1.0, "t": age})
   201		atk_hit.clear()
   202		atk_seq.clear()
   203		alt_hit.clear()
   204		proj_tgt.clear()   # V1.5：跳轉不能留舊的飛行目標（Antigravity v150-i1 #1）
   205		atk_t.clear()
