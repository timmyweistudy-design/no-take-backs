   234	## 點戰場上的兵：鏡頭跟著它；點空地取消。
   235	func _battle_click(p: Vector2) -> void:
   236		if not _replay_controls_active() and not (paused and state == St.BATTLE):
   237			return
   238		var world := _cam.affine_inverse() * p
   239		var best := -1
   240		var bd := 40.0 * HK   # 1.3.0：點兵半徑跟角色尺寸（Codex cat04 #2）
   241		for u in view.units:
   242			if u.alive:
   243				var d := _upos(u).distance_to(world + Vector2(0, 20 * HK))
   244				if d < bd:
   245					bd = d
   246					best = u.id
   247		follow_id = best
   248		if play_kind == "official":
   249			return   # 正式對局暫停時只看資料，不動鏡頭
   250		if best >= 0:
   251			pinch_zoom = 1.0   # 1.3.0 §2：點兵跟拍＝新的意圖，取代手動縮放
   252			dir_manual = true
   253		if best < 0:
   254			zoom_target = 1.0   # 取消跟拍：回到全景（中心由 _battle_process 拉回）
   255	
   256	## 暫停（第七輪 A6）：正式對局也能停下來看；繼續時放掉選取。
   257	func _toggle_pause() -> void:
   258		paused = not paused
   259		if not paused and play_kind == "official":
   260			follow_id = -1
   261	
   262	
   263	## 進重播前存結算畫面（第七輪 A9）。
   264	func _replay_snapshot() -> void:
   265		if play_kind != "official" and not replay_snap.is_empty():
   266			return   # Codex r2：重播完再重播，返回目的地還是最早那個結算
   267		replay_snap = {"sim": sim, "view": view, "report": report, "marks": battle_marks.duplicate(true), "kind": play_kind,
   268			"tab": result_tab, "overlay": "", "ev_count": ev_count.duplicate(), "pt_rated": pt_rated, "pt_call": pt_call_tick}
   269	
   270	## 重播的「返回」：回到進來的地方。只還原畫面，比分、進度、成就、試玩紀錄都不寫。
   271	func _replay_back() -> void:
   272		tm_ghost = null   # V1.4 #1：回到結果頁，原本時間線的淡圈不能留下
   273		call("_pre_drop")
   274		seek_target = -1   # Codex r1：算到一半返回，不能把下一場快轉到舊目標
   275		skip_busy = false
   276		paused = false
   277		follow_id = -1
   278		zoom = 1.0
   279		zoom_target = 1.0
   280		fx.clear()
   281		frags.clear()   # 1.2.0 §8.2
   282		dying.clear()
   283		report_log.clear()
   284		sfx.set_muffled(false)
   285		if watch_mode or replay_snap.is_empty():
   286			call("_go_title")
   287			return
   288		sim = replay_snap["sim"]
   289		view = replay_snap["view"]
   290		report = replay_snap["report"]
   291		battle_marks = replay_snap["marks"]
   292		play_kind = replay_snap["kind"]
   293		result_tab = replay_snap["tab"]
   294		ev_count = replay_snap["ev_count"]   # Codex r1：戰報、評分狀態也要還原，不然同一局能再評一次
   295		pt_rated = replay_snap["pt_rated"]
   296		pt_call_tick = replay_snap["pt_call"]
   297		overlay = replay_snap["overlay"]
   298		result_delay = 0.0
   299		state = St.RESULT
   300		replay_snap = {}
