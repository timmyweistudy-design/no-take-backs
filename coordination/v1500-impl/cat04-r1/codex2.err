   430	## 不能用的情況（工具不開放、不是擺陣）照原本的按鍵處理。
   431	func _pad_tool(ev: InputEventJoypadButton) -> bool:
   432		if state != St.PLACE or overlay != "" or Input.get_joy_axis(ev.device, JOY_AXIS_TRIGGER_RIGHT) < 0.5:
   433			return false
   434		var id := ""
   435		if ev.button_index == JOY_BUTTON_BACK and mode == Mode.VS_AI:
   436			pad_mode = true
   437			_enqueue("tool", "foe")   # 1.5.0 §1.4：RT＋View＝開合敵情翻牌
   438			return true
   439		match ev.button_index:
   440			JOY_BUTTON_Y:
   441				id = "align" if _is_free() else "flip"
   442			JOY_BUTTON_DPAD_RIGHT:
   443				id = "" if _is_free() else "fwd"
   444			JOY_BUTTON_DPAD_LEFT:
   445				id = "" if _is_free() else "back"
   446			JOY_BUTTON_LEFT_SHOULDER:
   447				id = "last"
   448		if id == "" or not bool(call("_deploy_tools_ok")):
   449			return false
   450		pad_mode = true
   451		_enqueue("tool", id)   # 和落子、放開、開戰同一個佇列（不然會插到前面還沒處理的拖曳之前；Codex cat11 #3）
   452		return true
