   170	func _keys_input(ev: InputEvent) -> bool:
   171		if keys_capture == "":
   172			return false
   173		var part := keys_capture.split(":")
   174		if ev is InputEventKey and ev.pressed and not ev.echo:
   175			if ev.keycode != KEY_ESCAPE and part[0] == "kb":
   176				if not Keymap.can_bind_key(ev.keycode):
   177					_toast(L.t("keys_reserved"), true)
   178					return true
   179				Save.settings["keys"] = Keymap.rebind(Keymap.ACTIONS, Save.s("keys"), part[1], ev.keycode)
   180				Save.save_settings()
   181			keys_capture = ""
   182			return true
   183		if ev is InputEventJoypadButton and ev.pressed and part[0] == "pad":
   184			if not Keymap.can_bind_pad(ev.button_index):
   185				_toast(L.t("keys_reserved"), true)
   186				return true
   187			Save.settings["pad"] = Keymap.rebind(Keymap.PAD_ACTIONS, Save.s("pad"), part[1], ev.button_index)
   188			Save.save_settings()
   189			keys_capture = ""
   190			return true
   191		return ev is InputEventKey or ev is InputEventJoypadButton
   192	
