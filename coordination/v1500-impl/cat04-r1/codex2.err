   454	## 1.2.0 §11.1 部署工具的鍵（格子 M、Shift＋←→；自由 A；兩種 L）
   455	func _place_tool_key(k: int) -> bool:
   456		match k:
   457			KEY_M:
   458				return call("_deploy_tool", "flip")
   459			KEY_A:
   460				return call("_deploy_tool", "align")
   461			KEY_L:
   462				return call("_deploy_tool", "last")
   463			KEY_RIGHT, KEY_LEFT:
   464				if Input.is_key_pressed(KEY_SHIFT):
   465					return call("_deploy_tool", "fwd" if k == KEY_RIGHT else "back")
   466		return false
