   195	func _input(ev: InputEvent) -> void:
   196		if _trans_gate(ev):
   197			if is_inside_tree():
   198				get_viewport().set_input_as_handled()
   199			return
   200		if _keys_input(ev):
   201			return
   202		if nb_edit >= 0 and _nb_edit_input(ev):
   203			return   # V1.6.1 N3：實驗簿改名時，鍵盤輸入給名稱框
   204		if ev is InputEventScreenTouch or ev is InputEventScreenDrag:
   205			fp_touch = true   # 第六輪：觸控時預覽畫在手指上方
   206			_touch_input(ev)   # V1.4 #18：長按＝右鍵、雙指縮放
   207			return
   208		if ev is InputEventMagnifyGesture and (state == St.BATTLE or state == St.RESULT):
   209			_pinch_by(ev.factor, ev.position)   # 觸控板的捏合也一樣
   210			return
   211		if ev is InputEventMouseMotion:
   212			mouse = ev.position
   213			pad_mode = false
   214			if ev.device != InputEvent.DEVICE_ID_EMULATION:
   215				fp_touch = false
   216			hover_card = _card_at(mouse)
   217			if state == St.BATTLE and overlay == "" and (ev.button_mask & MOUSE_BUTTON_MASK_MIDDLE) != 0:
   218				_enqueue("pan", ev.relative)   # 1.3.0 §2：中鍵拖曳平移
   219			_enqueue("paint", mouse)   # 一律排入，由執行端判斷有沒有在塗兵（同一幀按下再拖過也不漏格，Codex S3）
   220			_drag_scrape(ev.relative.length())
   290		if _is_free():
   291			if overlay == "":
   292				_fp_motion(p)
   293			return
   294		if state != St.PLACE or overlay != "" or not painting:
   295			return
   296		if _cur_army().team != paint_team:
   297			painting = false
   298			return
   299		var c := _cell_at(p)
   300		if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   301			_try_place(c)
