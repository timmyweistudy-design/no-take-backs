  1170	## 1.5.0 §1.4 對 AI：敵方部署區＝粉筆虛線框＋淡淡一層、地上一面紅旗印（草地照常看得到；雙人對戰照舊竹簾）。
  1171	func _chalk_zone(mr: Rect2) -> void:
  1172		draw_rect(mr, Color(0.96, 0.93, 0.84, 0.07))
  1173		var ink := Color(0.96, 0.93, 0.84, 0.62)
  1174		var r := mr.grow(-6.0)
  1175		var pts := [r.position, Vector2(r.end.x, r.position.y), r.end, Vector2(r.position.x, r.end.y), r.position]
  1176		for k in 4:
  1177			var a: Vector2 = pts[k]
  1178			var b: Vector2 = pts[k + 1]
  1179			var ln := a.distance_to(b)
  1180			var dir := (b - a) / maxf(1.0, ln)
  1181			var s := 0.0
  1182			var i := 0
  1183			while s < ln:
  1184				var e := minf(ln, s + 14.0)
  1185				var wob := Vector2(-dir.y, dir.x) * (0.8 if i % 3 == 0 else -0.5)   # 粉筆線手畫的抖
  1186				draw_line(a + dir * s + wob, a + dir * e - wob, ink, 3.0, true)
  1187				s += 22.0
  1188				i += 1
  1189	
