   285	## 塗兵（佇列命令）：按住拖過格子連續擺。
   286	func _paint_cmd(p: Vector2) -> void:
   287		call("vol_motion", p)   # 1.3.0：音量木軌拖曳中（沒在拖就什麼都不做）
   288		if drag_from.x >= 0 and p.distance_to(drag_press_p) >= 10.0:
   289			drag_moved = true   # V1.5.1：拖出去過就不算「點一下」（拖回原點也一樣，Codex v151-i3）
   290		if _is_free():
   291			if overlay == "":
   292				_fp_motion(p)
   293			return
   294		if state != St.PLACE or overlay != "" or not painting:
   295			return
   296		if _cur_army().team != paint_team:
   297			painting = false
   298			return
   299		var c := _cell_at(p)
   300		if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   301			_try_place(c)
   302	
   303	
   240			return
   241		if _fp_locked():
   242			return
   243		var src: Array = fp_redo if redo else fp_undo
   244		var a = _fp_army()
   245		# 復原紀錄依隊伍分開：暗擺換方後，另一方的紀錄不能寫進這一方（Codex 實作第 1 輪 #1）
   246		while not src.is_empty() and int(src[src.size() - 1]["team"]) != a.team:
   247			src.pop_back()
   248		if src.is_empty():
   249			return
   250		(fp_undo if redo else fp_redo).append({"team": a.team, "units": a.units.duplicate(true)})
   251		var snap: Array = src.pop_back()["units"]
   252		# 還原前重新驗證（每一隻都在這一方的部署區、間距合法）
   253		var trial = a.copy()
   254		trial.units = []
   255		for u in snap:
   256			if not trial.place_xy(int(u["type"]), int(u["x"]), int(u["y"])):
   257				trial = null
   258				break
   259		if trial == null:
   260			_toast(L.t("err_zone"), true)
   261			return
   262		a.units = snap
   263		fp_sel = []
   264	
   265	func _fp_erase_at(w: Vector2i) -> void:
   266		if _fp_duel_turns() or not _fp_can_edit():
   267			return
   268		var a = _fp_army()
   269		var i: int = a.index_near(w.x, w.y, PICK_R)
   270		if i >= 0:
   271			if not fp_erasing:
   272				_fp_push_undo()
   273			a.units.remove_at(i)
   274			fp_sel = []
   275			fp_erasing = true
   276	
   277	func _fp_delete_sel() -> void:
   278		_fp_clean_sel()
   279		if _fp_duel_turns() or not _fp_can_edit() or fp_sel.is_empty():
   280			return
   281		_fp_push_undo()
   282		var a = _fp_army()
   283		var idx := fp_sel.duplicate()
   284		idx.sort()
   285		idx.reverse()
   286		for i in idx:
   287			a.units.remove_at(i)
   288		fp_sel = []
   289	
   290	func _fp_flip_sel() -> void:
   291		_fp_clean_sel()
   292		if _fp_duel_turns() or not _fp_can_edit() or fp_sel.is_empty():
   293			return
   294		_fp_push_undo()
   295		if not _fp_army().flip_group(fp_sel):
   296			fp_undo.pop_back()
   297			_toast(L.t("err_flip"), true)
   298	
   299	# ───────── 滑鼠 ─────────
   300	## 回傳 true＝這個事件自由模式處理掉了。
   301	func _fp_mb(d: Dictionary) -> bool:
   302		if not _is_free() or overlay != "":
   303			return false
   304		var p: Vector2 = d["pos"]
   305		var w := _w_of(p)
   306		var a = _fp_army()
   307		var btn: int = d["i"]
   308		var pressed: bool = d["pressed"]
   309		_fp_clean_sel()
   310		if btn == MOUSE_BUTTON_RIGHT and pressed:
   311			if fp_stroking:
   312				_fs_cancel()   # 拖曳中按右鍵：取消整筆
   313				return true
   314			if _fp_in_field(p):
   315				fp_erasing = false
   316				_fp_erase_at(w)
   317				fp_erasing = true
   318				if _fp_duel_turns():
   319					_toast(L.t("err_notakeback"), true)
   320			return _fp_in_field(p)
   321		if btn == MOUSE_BUTTON_RIGHT and not pressed:
   322			fp_erasing = false
   323			return false
   324		if btn != MOUSE_BUTTON_LEFT:
   325			return false
   326		if pressed:
   327			if not _fp_in_field(p):
   328				return false
   329			_fp_press(p, w, Input.is_key_pressed(KEY_CTRL))
   330			return true
   331		return _fp_release(p, w)
   332	
   333	## 按下（滑鼠左鍵、手把 A 共用）：box＝強制框選（Ctrl、手把 LT）。
   334	func _fp_press(p: Vector2, w: Vector2i, box: bool) -> void:
   335		var a = _fp_army()
   336		var hit: int = a.index_near(w.x, w.y, PICK_R)
   337		if box or (fp_tool == "select" and hit < 0):
   338			fp_box = true
   339			fp_box_a = p
   340			return
   341		if hit >= 0 and not _fp_duel_turns() and _fp_can_edit():
   342			fp_drag = hit
   343			fp_drag_from = a.pos_of(a.units[hit])
   344			fp_press_p = p
   345			fp_moved = false
   346			if not hit in fp_sel:
   347				fp_sel = []
   348			return
   349		if hit >= 0:
   350			return
   351		if not call("_allowed", selected):
   352			_toast(L.t("err_type"), true)
   353			return
   354		_fs_begin(w)
   355	
   356	## 放開（滑鼠左鍵、手把 A 共用）。回傳 true＝自由模式處理掉了。
   357	func _fp_release(p: Vector2, w: Vector2i) -> bool:
   358		var a = _fp_army()
   359		if fp_box:
   360			fp_box = false
   361			var r := Rect2(fp_box_a, Vector2.ZERO).expand(p)
   362			fp_sel = []
   363			for i in a.units.size():
   364				if r.has_point(_fld_xf() * _s_of(a.pos_of(a.units[i]))):
   365					fp_sel.append(i)
   366			return true
   367		if fp_drag >= 0:
   368			var i := fp_drag
   369			fp_drag = -1
   370			if _fp_locked() or not _fp_can_edit() or _fp_duel_turns():
   371				return true   # 拖曳途中被鎖住（暗擺雙方確認）：放開不生效（Codex 實作第 2 輪 #2）
   372			var group: bool = fp_sel.size() > 1 and i in fp_sel
   373			if not _fp_in_field(p):
   374				if group:
   375					return true   # 整群拖出戰場＝取消，不刪單隻（Antigravity 實作第 1 輪 #2）
   376				_fp_push_undo()
   377				a.units.remove_at(i)
   378				fp_sel = []
   379				return true
   380			if not group and Save.s("place_mode") == "tap" and not fp_moved and p.distance_to(fp_press_p) < 10.0:
   381				# V1.5.1 C4：只點選模式點一下自己的兵＝拿掉（可以復原；Codex v151-i2 #3）
   382				_fp_push_undo()
   383				a.units.remove_at(i)
   384				fp_sel = []
   385				return true
   386			var tgt := _q(w)
   387			if group:
   388				_fp_push_undo()
   389				var mv: Vector2i = a.move_group(fp_sel, tgt.x - fp_drag_from.x, tgt.y - fp_drag_from.y)
   390				if mv.x == -99999:
   391					fp_undo.pop_back()
   392					_toast(L.t("err_group_move"), true)
   393				else:
   394					free_intro_moved = true
   395				return true
   396			if tgt != fp_drag_from:
   397				_fp_push_undo()
   398				if not a.move_xy(i, tgt.x, tgt.y):
   399					fp_undo.pop_back()
   400					_toast(L.t("err_zone"), true)
   401				else:
   402					free_intro_moved = true
   403					settle_t[a.pos_of(a.units[i])] = time   # V1.3 B3：放下沉降＋落子聲（落點已經提交，只是畫面）
   404					if sfx != null:
   405						sfx.play("place_light", 0.55)
   406			return true
   407		if fp_stroking:
   408			_fs_commit()
   409			return true
   410		return false
   411	
   412	## 拖曳中打開覆蓋層、失焦等，放開事件到不了：把所有拖曳狀態收掉（Antigravity 實作第 1 輪 #2）。
   413	func _fp_abort_drag() -> void:
   414		_fs_cancel()
   415		fp_drag = -1
   416		fp_box = false
   417		fp_erasing = false
   418		fp_pad_a = false
   419		fp_pad_x = false
   420	
   421	## 世界座標 → 畫面上的點（不加腳底偏移；手把游標當成滑鼠位置用）。
   422	func _fp_scr(w: Vector2i) -> Vector2:
   423		return ORIGIN + Vector2(w) / 1000.0 * CS
   424	
   425	func _fp_motion(p: Vector2) -> void:
   426		if not _is_free():
   427			return
   428		if fp_drag >= 0 and p.distance_to(fp_press_p) >= 10.0:
   429			fp_moved = true
   430		var w := _w_of(p)
   431		if fp_stroking:
   432			_fs_extend(w)
   433		elif fp_erasing and Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT):
   434			_fp_erase_at(w)
   435	
   436	## 鍵盤：回傳 true＝處理掉了。
   437	func _fp_key(k: int) -> bool:
   438		if not _is_free() or overlay != "":
   439			return false
   440		match k:
   441			KEY_ENTER, KEY_KP_ENTER:
   442				if fp_stroking or fp_drag >= 0 or fp_box:
   443					return true   # 拖曳中按 Enter 不做事，免得蓋掉這一筆（Codex 實作第 2 輪新問題 1）
   444				# 自由模式：在鍵盤／手把游標處放一隻（格子查找不能用，Codex 實作第 1 輪 #9）
   445				var at: Vector2i = Vector2i(fp_cur) if (pad_mode or not _fp_in_field(mouse)) else _w_of(mouse)
   446				_fs_begin(at)
   447				_fs_commit()
   448				return true
   449			KEY_ESCAPE:
   450				if fp_stroking:
   451					_fs_cancel()
   452					return true
   453				if not fp_sel.is_empty():
   454					fp_sel = []
   455					return true
   900	
   901	## V1.2：紙上墨色。灰白字→焦茶墨；亮彩字（金、綠、紅）壓暗成同色系的深色，透明度保留。
   902	static func _ink(c: Color) -> Color:
   903		var lum := c.get_luminance()
   904		if lum < 0.45:
   905			return c
   906		var a := c.a if c.a < 0.45 else maxf(c.a, 0.85)   # V1.2.1 F5：紙上墨字至少 85%；很淡的裝飾（空星）保持淡
   907		if c.s < 0.25:
   908			return Color(INK, a)
   909		return Color(c.darkened(0.74), a)
   910	
   911	func _btn(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
   912		if layout_probe and get("shot_dir") != "" and (get("shot_state") as Dictionary).has("dis"):
   913			enabled = false   # V1.2.1：版面檢查的「停用」狀態：全部按鈕畫成停用，檢查停用樣式（手把流程不受影響）
   914		var idx := _btns.size()
   915		var hit := r
   916		if btn_hit_min > r.size.y:
   917			var dh := (btn_hit_min - r.size.y) * 0.5
   918			hit = r.grow_individual(0.0, dh, 0.0, dh)
   919			if layout_probe:
   920				probe_hits.append(hit)
   921		_btns.append({"r": hit, "cb": action, "en": enabled, "snd": "k_confirm" if primary else ("k_back" if label == L.t("back") or label == L.t("menu") else "k_click"), "group": btn_group})
   922		var hover := hit.has_point(mouse) and not pad_mode
   923		var focus := pad_mode and idx == _focus
   924		var bg := TH_WOOD_L if not primary else TH_PRIMARY
   925		if tint.a > 0:
   926			bg = tint
   927		if not enabled:
   928			bg = Color(0.2, 0.17, 0.15)
   929		elif hover or focus:
   930			bg = bg.lightened(0.16)
   931			if hover:
   932				_hover_now = idx
   933		var pressed := hover and enabled and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
   934		var rd := r.grow(-minf(r.size.x, r.size.y) * 0.025) if pressed else r
   935		# V1.2 B3：按鈕下緣 3px 厚度（木牌的側面）；按下時往下沉、厚度消失
   936		var solid: bool = tint.a <= 0.0 or tint.a > 0.6
   937		if solid and r.size.y >= 20.0:
   938			# 厚度畫在按鈕框內（下緣 3px），命中框、探針與畫面一致（Codex v120-impl2）；按下時面板往下壓、厚度被蓋住
   939			_box(Rect2(rd.position, rd.size), Color(bg.darkened(0.55), 1.0), Color(0, 0, 0, 0), 7.0)
   940			rd = Rect2(rd.position + Vector2(0, 3.0 if pressed else 0.0), rd.size - Vector2(0, 3))
   941		var paper_face := btn_paper and enabled and not bool(Save.s("plain_ui"))
   942		# 1.2.0 §1.3：沒有自訂色的一般按鈕＝山毛櫸木牌（墨色字）；主要按鈕＝朱漆木牌＋左側紅蠟封；停用＝褪色木牌
   943		var cloth: bool = btn_cloth != "" and not paper_face and not bool(Save.s("plain_ui")) and _ui_tex(MAT[btn_cloth]) != null   # 1.2.0 §1.3 布標分頁
   944		# 1.2.0 第 4 大類 A10：「木色／選中」兩種標準色的按鈕也走木牌（原本是深色圓角塊，Antigravity cat03 #1）；選中＝暖一點的木牌＋朱砂框（不只靠顏色）。
   945		# 木色／選中但沒有自己標籤的按鈕（字由呼叫端另外畫白字：技能格、試煉卡、禁用卡、遠征獎勵卡）維持原本深色，避免白字落在淺木牌上（Codex cat04 #1）
   946		var sel_on: bool = tint == TH_ACTIVE
   947		var plaque: bool = not cloth and not paper_face and (tint.a <= 0.0 or ((sel_on or tint == TH_WOOD) and label != "")) and not bool(Save.s("plain_ui")) and r.size.y >= 26.0 and _ui_tex(MAT["plaque"]) != null
   948		last_btn_paper = paper_face or (plaque and not primary and enabled) or (cloth and btn_cloth == "tab_linen" and enabled)
   949		last_btn_enabled = enabled
   950		if cloth:
   951			var ct := Color.WHITE if enabled else Color(0.6, 0.6, 0.6, 0.8)
   952			if enabled and (hover or focus):
   953				ct = Color(1.12, 1.12, 1.12)
   954			_mat_box(rd, btn_cloth, ct)
   955			# 縫線：布標內緣一圈虛線（裝飾，不登記探針）
   956			var sc := Color(1, 1, 1, 0.35) if btn_cloth != "tab_linen" else Color(0.35, 0.25, 0.15, 0.4)
   957			var sr := rd.grow(-5)
   958			if layout_probe:
   959				probe_deco("stitch", sr, rd, "inside")   # 1.2.0 元件契約：縫線登記成宿主內的裝飾
   960			var dash := 6.0
   961			var xx := sr.position.x
   962			while xx < sr.end.x - dash:
   963				draw_line(Vector2(xx, sr.position.y), Vector2(xx + dash * 0.6, sr.position.y), sc, 1.0)
   964				draw_line(Vector2(xx, sr.end.y), Vector2(xx + dash * 0.6, sr.end.y), sc, 1.0)
   965				xx += dash
   966		elif plaque:
   967			var pt := Color(0.86, 0.36, 0.2) if primary else Color.WHITE
   968			if not enabled:
