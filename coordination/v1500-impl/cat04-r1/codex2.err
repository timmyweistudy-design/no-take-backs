   332	func _mb_cmd(d: Dictionary) -> void:
   333		var mb := InputEventMouseButton.new()
   334		mb.button_index = d["i"]
   335		mb.pressed = d["pressed"]
   336		mb.position = d["pos"]
   337		mouse = d["pos"]
   338		var eat_dbl := false
   339		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   340			eat_dbl = dbl_eat   # 雙擊回全景那次的放開：不論走哪條路都要清掉（Codex cat06 #4）
   341			dbl_eat = false
   342		if state == St.BATTLE and overlay == "" and mb.pressed:
   343			mag_hide = follow_id   # 1.3.0 §2：任何按下都先收起放大鏡（點到兵會在放開時重新選）
   344			hl_reel.clear()        # 精華三連播放中動了就停在這裡（交還手動）
   345			if mb.button_index == MOUSE_BUTTON_WHEEL_UP or mb.button_index == MOUSE_BUTTON_WHEEL_DOWN:
   346				cam_wheel(mb.button_index == MOUSE_BUTTON_WHEEL_UP, mouse)   # 滾輪縮放
   347				return
   348			if mb.button_index == MOUSE_BUTTON_LEFT and bool(d.get("dbl", false)) and _field_hit(mouse):
   349				cam_reset()   # 雙擊盤面回全景
   350				dbl_eat = true
   351				return
   352		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and bool(call("vol_press", mouse)):
   353			return   # 1.3.0：在音量木軌上按下＝開始拖
   354		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed and bool(call("vol_release")):
   355			_mb_release_cleanup()
   356			return   # 拖完放開：存檔，不再觸發數值鈕
   357		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   358			if _do_click(mouse) > 0:
   359				_mb_release_cleanup()
   360				return
   361		if state == St.PLACE and overlay == "" and (foe_card_r.has_point(mouse) or foe_tag_r.has_point(mouse)):
   362			if not mb.pressed:
   363				_mb_release_cleanup()
   364			return   # 1.5.0 §1.4：敵情翻牌與紙卡擋住底下的部署區（不點穿）
   365		if state == St.PLACE and overlay == "" and mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and _v16_place_click(mouse):
   366			return   # V1.6 #6：標記模式
   367		if state == St.PLACE and overlay == "" and _fp_mb(d):
   368			return   # 第六輪：自由排兵處理掉了
   369		if overlay != "" or state != St.PLACE:
   370			if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
   371				_mb_release_cleanup()
   372				if overlay == "" and state == St.BATTLE and mb.button_index == MOUSE_BUTTON_LEFT:
   373					if not eat_dbl:   # 雙擊回全景的那次放開不再選兵
   374						_battle_click(mouse)   # 重播時點兵讓鏡頭跟（第三輪 F2）
   375			return
   376		var c := _cell_at(mouse)
   377		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   378			var k := _card_at(mouse)
   379			if k >= 0 and _card_help_rect(k).has_point(mouse):
   380				return   # 放開時由「?」按鈕處理
   381			if k >= 0:
