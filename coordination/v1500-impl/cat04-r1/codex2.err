 		else:
 			lines.append(L.t("place_hint_tools_fp") if _is_free() else L.t("place_hint_tools", [Keymap.key_name(kt, "flip")]))   # 1.2.0 §11.1
+	if mode == Mode.VS_AI and pad_mode:
