## 同一欄的元件共用中線（R10）
func probe_align(id: String, rects: Array, tol := 1.0) -> void:
	if layout_probe:
		probe_aligns.append({"id": id, "rects": rects, "tol": tol})

## V1.6 #4 R5：同列卡片，cards＝[[圖示框, 標題框, 正文框], …]，同一部件的上緣要對齊
func probe_cards(id: String, cards: Array, tol := 1.0) -> void:

## V1.2：紙上墨色。灰白字→焦茶墨；亮彩字（金、綠、紅）壓暗成同色系的深色，透明度保留。
static func _ink(c: Color) -> Color:
	var lum := c.get_luminance()
	if lum < 0.45:
		return c
	var a := c.a if c.a < 0.45 else maxf(c.a, 0.85)   # V1.2.1 F5：紙上墨字至少 85%；很淡的裝飾（空星）保持淡
	if c.s < 0.25:
		return Color(INK, a)
	return Color(c.darkened(0.74), a)

func _btn(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
	if layout_probe and get("shot_dir") != "" and (get("shot_state") as Dictionary).has("dis"):
		enabled = false   # V1.2.1：版面檢查的「停用」狀態：全部按鈕畫成停用，檢查停用樣式（手把流程不受影響）
	var idx := _btns.size()
	var hit := r
	if btn_hit_min > r.size.y:
		var dh := (btn_hit_min - r.size.y) * 0.5
		hit = r.grow_individual(0.0, dh, 0.0, dh)
		if layout_probe:
			probe_hits.append(hit)
	_btns.append({"r": hit, "cb": action, "en": enabled, "snd": "k_confirm" if primary else ("k_back" if label == L.t("back") or label == L.t("menu") else "k_click"), "group": btn_group})
	var hover := hit.has_point(mouse) and not pad_mode
	var focus := pad_mode and idx == _focus
	var bg := TH_WOOD_L if not primary else TH_PRIMARY
	if tint.a > 0:
		bg = tint
	if not enabled:
		bg = Color(0.2, 0.17, 0.15)
	elif hover or focus:
		bg = bg.lightened(0.16)
		if hover:
			_hover_now = idx
	var pressed := hover and enabled and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
	var rd := r.grow(-minf(r.size.x, r.size.y) * 0.025) if pressed else r
	# V1.2 B3：按鈕下緣 3px 厚度（木牌的側面）；按下時往下沉、厚度消失
	var solid: bool = tint.a <= 0.0 or tint.a > 0.6
	if solid and r.size.y >= 20.0:
		# 厚度畫在按鈕框內（下緣 3px），命中框、探針與畫面一致（Codex v120-impl2）；按下時面板往下壓、厚度被蓋住
		_box(Rect2(rd.position, rd.size), Color(bg.darkened(0.55), 1.0), Color(0, 0, 0, 0), 7.0)
		rd = Rect2(rd.position + Vector2(0, 3.0 if pressed else 0.0), rd.size - Vector2(0, 3))
	elif focus:
		_box(rd.grow(1), Color(0, 0, 0, 0), ACCENT, 8.0, 3.0)
	if focus and enabled and bool(Save.s("focus_strong")):
		# V1.5.2：貼畫面邊的按鈕（戰場頂列）外圈往內收，整圈都看得到（不被畫面邊切掉）
		var scr := btn_ring_clip
		_box(rd.grow(5).intersection(scr), Color(0, 0, 0, 0), Color("#ffffff"), 10.0, 3.0)   # V1.5：加強焦點框（白色外圈）
		_box(rd.grow(8).intersection(scr), Color(0, 0, 0, 0), Color(INK, 0.9), 12.0, 2.0)
	if layout_probe:
		probe_btns.append(r)
		if label == "":
			probe_ctrls.append(r)   # 空白標籤的按鈕（卡片、頁籤）：裡面自己畫的字算按鈕內容
	# 1.2.0：按鈕字級看實際面高（扣下緣厚度與木牌毛邊）：放得下正文字就用正文字，不然用小一級（都在字級表內，比 1.1.0 同層大）
	var face_h: float = r.size.y - 3.0 - 6.0
	var lw := r.size.x - 2.0 * (maxf(6.0, r.size.x * 0.06) + 1.0)   # 1.4.0 R12：標籤左右各留 max(6, 6% 寬)（原本只留 5px）
	# 字級照原本的寬度選（不因為加內距而多降一級，Codex v140 cat01 #4）；內距只影響換行
	var sz := fit(label, ts(18) if r.size.y >= 40 and face_h >= ts(18) * 1.3 else ts(15), r.size.x - 10, primary)
	var lines := wrap_lines(label, sz, lw, primary)
	if lines.size() > 1 and lines.size() * sz * 1.25 > face_h:
		# 加了內距會換成放不下的兩行：退回原本的寬度（這顆按鈕要靠加寬或改短解決，R12 會擋）
		lines = wrap_lines(label, sz, r.size.x - 10, primary)
	_probe_btn_label = true   # 版面檢查：這段是按鈕自己的標籤（不用位置猜，Antigravity 實作第 2 輪抓到猜錯的情況）
func _btn_small(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
	btn_hit_min = 44.0
	_btn(r, label, action, enabled, primary, tint)
	btn_hit_min = 0.0

## 安靜的小按鈕（第七輪 N6）：點擊框維持可點的大小，平常只畫一個小記號，滑過才亮。
func _btn_quiet(r: Rect2, label: String, action: Callable) -> void:
	var idx := _btns.size()
	_btns.append({"r": r, "cb": action, "en": true, "group": btn_group})
	var hot := (r.has_point(mouse) and not pad_mode) or (pad_mode and idx == _focus)
	var sz := ts(14)
	var rad := maxf(9.0, maxf(sz * 0.62, label_ink(label, sz, true).size.y * 0.5 + 4.5))   # 1.3.0 R11：圓跟著字級長大；1.4.0 R12：墨跡上下各留 ≥4px
	var c := r.end - Vector2(rad + 3.0, rad + 3.0)
	draw_circle(c, rad, Color(ACCENT, 0.9) if hot else Color(0, 0, 0, 0.55), true, -1.0, true)
	if layout_probe:
		probe_btns.append(r)
		probe_ctrls.append(r)
	_probe_btn_label = true
	_probe_btn_rect = r
	_probe_face = Rect2(c - Vector2(rad, rad), Vector2(rad, rad) * 2.0)   # 1.3.0 R11：格子是畫出來的圓，不是 36×36 點擊區
	_probe_cell_id = "quiet%d" % idx
	_text(ink_center_p(_probe_face, label, sz, true), label, sz, Color.BLACK if hot else TXT_DIM, true, true)
	_probe_face = Rect2()
	_probe_cell_id = ""
	_probe_btn_label = false

## 用鍵盤滑鼠時不顯示手把圖示（Steam Deck 規定兩者不能同時出現）。擺放畫面已經在上方列顯示，這裡略過。
func _draw_pad_footer() -> void:
	if not pad_mode or (state == St.PLACE and overlay == ""):
		return
	var items: Array = _pad_footer_items()
	if items.is_empty():
		return
	draw_rect(Rect2(0, 770, 1280, 30), Color(0, 0, 0, 0.45))
	if layout_probe:
		probe_boxes.append({"r": Rect2(0, 770, 1280, 30), "inner": Rect2(0, 766, 1280, 34)})   # 提示列是最上層的底（不是底下兵卡的字）
	_key_hints(640, 773, items, 14)



## 滑鼠停在哪一列：輸入狀態，每幀更新一次（第七輪 H7：原本在繪圖時改狀態）。
func _settings_hover() -> void:
	if overlay != "settings":
		return
	var rows := _settings_rows()
	for i in rows.size():
		if Rect2(340, _settings_row_y(i) - 5, 560, 56).has_point(mouse):
			settings_item = rows[i][0]
	# 手把／鍵盤移焦點時，說明欄跟著焦點那一列（Antigravity v150-i1 #3）
	if pad_mode and _btns_gen == _gen and _focus >= 0 and _focus < _btns.size():
		var fy: float = _btns[_focus]["r"].position.y
		for i in rows.size():
			if absf(fy - _settings_row_y(i)) < 2.0:
				settings_item = rows[i][0]







## ── 輸入命令佇列的執行端（第三輪 A2；S8 從 ui_base 移下來：基底不再用空函式呼叫上層）──
func _process_cmds() -> int:
	var done := 0
	_update_gen()
	var q := _cmds
	_cmds = []
	for c in q:
		if c["gen"] != _gen:
			# 畫面已經換了：丟掉。但「放開滑鼠」一定要清掉拖曳／塗兵狀態（Codex S1 #2）
			if c["kind"] == "mb" and not c["data"]["pressed"]:
				_mb_release_cleanup()
			elif c["kind"] == "padbtn" and not c["data"]["pressed"]:
				_fp_abort_drag()   # 手把放開 A／X 的事件過期：同樣清掉（Codex 實作第 3 輪 #1）
			continue
		if c["kind"] == "click":
			done += _do_click(c["data"])
		draw_circle(pp, 1.5 + float(kk % 3), Color(Color("#efe4cf"), 0.7 * drop), true, -1.0, true)
	_text(c - Vector2(0, tz("T") * 0.62), txt, tz("T"), Color(col, drop), true, true)
	draw_set_transform_matrix(Transform2D.IDENTITY)
	if drop >= 1.0 and not ink_stamped:
		ink_stamped = true
		if sfx != null:
			sfx.play("place_heavy", 1.0)   # 蓋章聲

var ink_stamped := false

func _do_click(p: Vector2) -> int:
	_toast_dismiss()
	if state == St.RESULT and _ink_active():
		result_t -= INK_DUR   # 1.2.0 §9.4：點任意處跳過宣紙戰報演出
		return 1
	if _btns_gen != _gen:
		return 0
	for i in _btns.size():
		var b: Dictionary = _btns[i]
		if b["r"].has_point(p):
			if b["en"]:
				_focus = i
				if sfx != null:
					sfx.play(str(b.get("snd", "k_click")), 0.7)
				b["cb"].call()
				return 1
			return 0
	return 0


