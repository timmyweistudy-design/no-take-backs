   781	## 殘局顯示提示與三星條件；遠征顯示還能改幾隻。
   782	func _draw_info_band(R: Rect2, i: int, team: int) -> void:
   783		draw_rect(R, Color(0, 0, 0, 0.35))
   784		var y := R.position.y + (R.size.y - tz("S") * 1.1) / 2
   785		var x := 16.0
   786		var help := Rect2(R.end.x - 46, R.position.y + 2, 36, 36)
   787		_btn(help, "?", func(): show_place_help = not show_place_help)
   788		if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
   789			var pz := PZ.get_puzzle(puzzle_id)
   790			var hint: String = L.field(pz, "hint")
   791			if mode == Mode.PUZZLE:
   792				var st := "　★ " + L.t("star2_short", [pz["star2"]]) + "　★ " + L.t("star3_short", [pz["star3"]])
   793				if PZ.goal(pz) != "win":
   794					st = "　" + L.t("goal_prefix") + _goal_text(pz) + st   # 第十三輪：護送、撐住、斬首（V1.1：前面加「過關：」，和星數條件分開）
   795				if pz.has("cap"):
   796					st = "　" + L.t("cap_note", [int(pz["cap"])]) + st
   797				call("_tv_buttons", help, true)   # V1.6 #6／#12：射程、標記、實驗簿
   798				_text(Vector2(R.end.x - 192 - _width(st, tz("S"), true), y), st, tz("S"), ACCENT, false, true)
   799				_text(Vector2(x, y), hint, tz("S"), Color(1, 1, 1, 0.85), false, false, R.size.x - 252 - _width(st, tz("S"), true))
   800			else:
   801				_text(Vector2(x, y), hint, tz("S"), Color(1, 1, 1, 0.85), false, false, R.size.x - 80)
   802			_draw_place_help()
   803			return
   804		call("_tv_buttons", help, int(get("trial_id")) >= 0 and mode == Mode.VS_AI)   # V1.6 #6：射程覆蓋、標記；試煉多實驗簿
   805		if mode == Mode.GAUNTLET and gauntlet_stage > 1:
   806			var gt := L.t("gauntlet_changes", [maxi(0, gauntlet_changes - _gauntlet_diff())])
   807			_text(Vector2(R.end.x - 150 - _width(gt, tz("S")), y), gt, tz("S"), ACCENT)
   808		var name: String = L.t("unit_%d" % i)
   809		_text(Vector2(x, y - 2), name, tz("B"), ACCENT, false, true)
   810		x += _width(name, tz("B"), true) + 12
   811		if not _allowed(i) and not (rules != null):
   812			var lock: String = L.t("locked_demo") if not RS.available(i, _demo()) else L.t("locked_classic")
   813			_text(Vector2(x, y), lock, tz("S"), TXT_DIM)
   814			_draw_place_help()
   815			return
