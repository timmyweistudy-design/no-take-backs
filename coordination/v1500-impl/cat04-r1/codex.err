		var rk: float = clampf(shake * 4.0, 0.2, 1.0) * int(Save.s("rumble")) / 100.0
		Input.start_joy_vibration(last_joy, 0.3 * rk, 0.6 * rk, 0.18)
	rumble_seen = shake
	if removed_banner_t > 0.0:
		removed_banner_t -= delta
	if ach_t > 0:
		ach_t -= delta
	elif not ach_queue.is_empty():
		toast = ach_queue.pop_front()
		toast_t = 2.5
		ach_t = 2.6
	shake = maxf(0.0, shake - delta)
	if not freeze_fx:
		for f in fx:
			f["t"] += delta
			if f.has("pop"):
				f["pop"] = maxf(0.0, f["pop"] - delta)
		fx = fx.filter(func(f): return f["t"] < f["dur"])
		if _frags_on():
			frags.step(delta)
		else:
			frags.clear()   # 戰鬥中切減少特效／簡化／4 倍速：舊碎片也收掉（Codex cat09 #3）
		clutch_t = maxf(0.0, clutch_t - delta)
	for g in dying:
		var t0: float = g["t"]
		g["t"] += delta
		if t0 < 1.0 and g["t"] >= 1.0:   # 只在跨過 1 秒那一幀插旗（倒棋留 1.7 秒，Codex v130-impl1）
			graves.append({"pos": g["pos"], "team": g["team"], "t": 0.0})
	dying = dying.filter(func(g): return g["t"] < death_life(int(g["type"])))   # V1.3 A5：倒棋留 1.7 秒
	for g in graves:
		g["t"] += delta
	graves = graves.filter(func(g): return g["t"] < 3.0)
	if overlay == "codex":
static func _r14(out: Dictionary, d: Dictionary) -> void:
	var sc: Dictionary = d.get("screen", {})
	if sc.is_empty():
		return
	var cls := str(sc.get("cls", ""))
	if str(sc.get("main", "")) == "":
		_add(out, "fail", "R14", cls, "畫面登記了類別卻沒有主動作")
	if not R14_LIMITS.has(cls):
		return
	var n := int(d.get("clicks", 0))
	var lim := int(R14_LIMITS[cls])
	if n <= lim:
		return
	if str(sc.get("skip", "")) != "":
		var key := "_ex_R14:" + cls
		if not out.has(key):
			out[key] = true
			out["exempt"].append({"rule": "R14", "id": cls, "why": str(sc["skip"])})
		return
	_add(out, "fail" if cls in R14_ENFORCE else "warn", "R14", cls, "可見可點元件 %d 個，超過「%s」類上限 %d（收進「更多」或拆頁）" % [n, cls, lim])


static func _contents(texts: Array, btns: Array) -> Array:
	var cs: Array = []
	for t in texts:
		cs.append({"r": t.get("gr", t["r"]), "s": t["s"], "kind": "text"})
	for b in btns:
		cs.append({"r": b, "s": "按鈕%s" % str(b), "kind": "btn"})
	return cs


