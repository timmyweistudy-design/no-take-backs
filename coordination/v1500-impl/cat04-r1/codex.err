	if ev is InputEventJoypadButton and ev.pressed and _pad_tool(ev):
		return
	if ev is InputEventJoypadButton and _is_free() and overlay != "" and not ev.pressed and ev.button_index in [JOY_BUTTON_A, JOY_BUTTON_X]:
