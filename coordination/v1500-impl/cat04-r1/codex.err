   618	# ── 擺放 HUD ──
   619	func _draw_place_hud() -> void:
   620		# 第五輪 §4.4：頂部兩行。第一行＝模式／局數（左）、目前在做什麼＋金幣條＋人數（中）、規則徽章（右）；
   621		# 第二行＝選中兵種的資訊帶（名稱、一句定位、剋／怕頭像），完全在棋盤外，不蓋部署格。
   622		_hud_bar(Rect2(0, 0, 1280, 92))   # V1.2：頂部資訊列改深木紋（原本是平塗深底）
   623		draw_line(Vector2(0, 50), Vector2(1280, 50), Color(1, 1, 1, 0.08), 1.0)
   624		var a = _cur_army()
   625		var tcol := Art.team_color(a.team, cbm())
   626		# 左：模式與局數（1.3.0 §9.4：收在一張用黃銅圖釘釘住的牛皮紙便籤上；深色紙，字色照舊）
   627		var ml := _mode_label()
   628		if not bool(Save.s("plain_ui")):
   629			# 便籤依實際文字配寬高（Codex cat09 #4）：寬＝較寬那行＋圖釘位，高＝兩行字高；下緣不進資訊帶（y52 起，資訊帶後畫會蓋住多的）
   630			var two: bool = mode == Mode.VS_AI or mode == Mode.DUEL
   631			var nw := minf(_width(L.t("menu_duel") if mode == Mode.DUEL else ml, tz("S"), true), 380.0)
   632			if two:
   633				nw = maxf(nw, _width("%s　%s" % [L.t("round", [round_no]), L.t("score", [wins[0], wins[1]])], tz("C")))
   634			var nh := tz("S") * 1.35 + (tz("C") * 1.3 if two else 0.0) + 6.0
   635			_pin_note(Rect2(6, 3, nw + 34.0, minf(nh, 48.0)))
   636		if mode == Mode.DUEL:
   637			ml = L.t("menu_duel")   # 規則細節已經在中間大字，左上只放模式名稱（避免換行）
   638		_text(Vector2(16, 6), ml, tz("S"), TXT_DIM, false, true, 380)
   639		if mode == Mode.VS_AI or mode == Mode.DUEL:
   640			_text(Vector2(16, 6 + tz("S") * 1.35), "%s　%s" % [L.t("round", [round_no]), L.t("score", [wins[0], wins[1]])], tz("C"), TXT_DIM, false, false, 300)
   641		# 中：一句話＋金幣條
   642		var head := L.t("place_title")
   643		if mode == Mode.DUEL:
   644			if tp != null:
   645				if tp.done():
   646					head = L.t("both_done")
   647				else:
   648					var hand := "" if not tp.is_snake() else L.t("hand_of", [mini(tp.hands_max(), tp.hands_done[tp.current] + 1), tp.hands_max()])
   649					head = L.t("turn_big", [L.t("blue") if tp.current == 0 else L.t("red"), hand, tp.turn_left()])
   650			else:
   651				head = L.t("both_done") if blind_phase == 2 else L.t("blind_turn", [L.t("blue") if blind_phase == 0 else L.t("red"), L.t("red") if blind_phase == 0 else L.t("blue")])
   652				if bool(get("sealed_on")) and blind_phase < 2:
   653					head = L.t("sealed_turn", [L.t("blue") if blind_phase == 0 else L.t("red"), get("sealed")[blind_phase].size() + 1])   # V1.4 #13
   654		elif _cp_on():
   655			head = _cp_head()   # 1.2.0 §11.6
   656		elif mode == Mode.VS_AI and bool(get("wv_active")):
   657			head = L.t("wv_head", [int(get("wv_no")), int(rules.budget_of(1)) if rules != null else 0])   # Antigravity v140-i3：常駐波數
   658		elif mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
   659			var pz := PZ.get_puzzle(puzzle_id)
   660			head = L.field(pz, "")
   661		elif mode == Mode.GAUNTLET:
   662			head = "%s・%s" % [L.t("gauntlet_title", [gauntlet_stage]), L.t("ga_node_" + str(call("ga_node", gauntlet_stage)))]
   663		var hz := tcap(tz("H2"), 26)
   664		_text(Vector2(640, 2), head, hz, tcol if mode == Mode.DUEL else Color.WHITE, true, true, 520)
   665		var star := -1
   666		if mode == Mode.PUZZLE:
   667			var pzs := PZ.get_puzzle(puzzle_id)
   668			star = a.budget - int(pzs["budget"]) + int(pzs["star3"])   # 三星條件（只花 ≤N 金）換算成金幣條上的位置
   669		var gb := Rect2(440, 6 + hz * 1.35, 230, 12)
   670		Charts.gold_bar(self, gb, a.units, a.budget, star)
   733			btn_group = ""   # 第七輪 N6：點擊框不變，外觀只留一個小問號，不切到角色
   734		var start_label := L.t("start")
   735		var start_en := _ready_to_fight()
   736		if _cp_on() and not cp.done():
   737			start_label = L.t("end_hand")
   738			start_en = true
   739		if mode == Mode.DUEL and tp != null and not tp.done():
   740			start_label = L.t("end_hand")
   741			start_en = tp.can_end_turn()
   742		elif mode == Mode.DUEL and tp == null and blind_phase < 2:
   743			start_label = L.t("blind_ready", [L.t("blue") if blind_phase == 0 else L.t("red")])
   744			start_en = _cur_army().count() > 0 and (rules == null or _cur_army().has_combat())
   745		var why := _start_block_reason()
   746		if why != "":
   747			start_en = false
   748			_text(Vector2(1076, 664), why, tz("C"), Color("#ff8a8a"), true, true, 380)   # 開戰鈕灰掉時直接寫原因（Antigravity 第二輪）
   749		_btn(Rect2(884, 690, 384, 50), start_label, func(): _on_start(), start_en, true)
   750		if mode == Mode.VS_AI or (mode == Mode.GAUNTLET and gauntlet_stage == 1):
   751			_btn(Rect2(884, 746, 120, 44), L.t("formations"), func(): _open("slots"))
   752		if mode == Mode.GAUNTLET and gauntlet_stage > 1:
   753			_btn(Rect2(884, 746, 120, 44), L.t("ga_info"), func(): overlay = "ga_info")   # V1.4 收尾：本戰條件（契約、加成、宿敵／巨獸、貼紙）
   754		if mode == Mode.PUZZLE:
   755			_btn(Rect2(884, 746, 120, 44), L.t("menu_hint"), func(): call("_puzzle_hint"))
   756			if PZ.get_puzzle(puzzle_id).has("cmd"):
   757				_draw_plan_panel(Rect2(520, 692, 356, 100))
   758		if _can_edit_existing():
   759			_btn(Rect2(1012, 746, 120, 44), L.t("clear"), func(): _clear_mine())
   760		_btn(Rect2(1140, 746, 128, 44), L.t("menu"), func(): _request_leave())
   761		if removed_banner_t > 0.0:
   762			var bw := _width(removed_banner, tz("B"), true) + 40
   763			var br := Rect2(640 - bw / 2, 100, bw, tz("B") * 1.8)
   764			draw_rect(br, Color(0.45, 0.12, 0.12, 0.92))
   765			draw_rect(br, Color("#ff8a8a"), false, 2.0)
   766			_text(Vector2(640, br.position.y + tz("B") * 0.35), removed_banner, tz("B"), Color.WHITE, true, true)
   767		if foe_zone_r.size.x > 0.0 and mode == Mode.VS_AI:
   768			_draw_foe_tag(foe_zone_r)   # 1.5.0 §1.4 敵情翻牌（畫在卡列之後，展開的紙卡在最上層）
   769		foe_zone_r = Rect2()
   770		screen_register("place", "start", "自由部署「工具」抽屜展開中：貼齊、密集兩個開關暫時多出來（收合時在上限內）" if (_is_free() and fp_more) else "")   # 1.5.0 §1.1：主動作＝開戰
   771		if _cp_on():
   772			_boss_note("coop")   # 1.2.0 §12.2
   773		elif mode == Mode.DUEL and bool(get("swap_on")):
   774			_boss_note("swap")
   775		elif mode == Mode.VS_AI and not watch_mode:
   776			_boss_note("place")   # 1.2.0 §12：第一次擺陣的便條
   777	
