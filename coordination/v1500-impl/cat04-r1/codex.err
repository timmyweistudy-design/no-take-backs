   472	## 戰術預覽（優化方案 E2）：選中兵種在游標格的射程／衝鋒線／刺客路線；已擺弓手的射程；看得到敵陣時標出剋制關係。
   473	func _draw_tactical() -> void:
   474		var c := cursor if pad_mode else _cell_at(mouse)
   475		var army = _cur_army()
   476		var dir := 1.0 if army.team == 0 else -1.0
   477		if c.x >= 0 and army.in_zone(c.x, c.y):
   478			var p := ORIGIN + (Vector2(c) + Vector2(0.5, 0.5)) * CS
   479			match selected:
   480				D.ARCHER:
   481					_arc_clipped(p, 6.0 * CS, 0, TAU, Color(1, 0.9, 0.5, 0.45), 2.0)
   482				D.PIKE:
   483					_arc_clipped(p, D.STATS[D.PIKE]["reach"] / 1000.0 * CS, 0, TAU, Color(1, 0.9, 0.5, 0.5), 2.0)
   484				D.BOMBER:
   485					# 甜甜圈：外圈射程（橘白）＋內圈紅色盲區（第四輪 §4.2）
   486					_arc_clipped(p, D.STATS[D.BOMBER]["reach"] / 1000.0 * CS, 0, TAU, Color(1, 0.85, 0.7, 0.5), 2.0)
   487					# 盲區：半透明紅底＋紅斜線（Antigravity：只有細紅線會被看成增益光環）
   488					var br0 := D.BOMB_MIN / 1000.0 * CS
   489					draw_circle(p, br0, Color(1, 0.2, 0.15, 0.22), true, -1.0, true)
   490					var hn := Vector2(1, 1).normalized()
   491					var ht := Vector2(1, -1).normalized()
   492					for hk in range(-4, 5):
   493						var dd := hk * br0 / 5.0
   494						var hh := sqrt(maxf(0.0, br0 * br0 - dd * dd))
   495						var hc := p + hn * dd
   496						draw_line(hc - ht * hh, hc + ht * hh, Color(1, 0.3, 0.25, 0.5), 1.5, true)
   497					_hand_ring(p, br0, Color(1, 0.3, 0.25, 0.85), 2.5)
   498				D.MEDIC, D.DRUMMER:
   499					# 補血／戰鼓範圍：醫者草綠、鼓手暖金；圈內的友軍微亮
   500					var rad: float = (D.HEAL_RANGE if selected == D.MEDIC else D.DRUM_RANGE) / 1000.0 * CS
   501					var rc := Color(0.55, 0.95, 0.45) if selected == D.MEDIC else Color(1, 0.82, 0.35)
   502					draw_circle(p, rad, Color(rc, 0.08), true, -1.0, true)
   503					_arc_clipped(p, rad, 0, TAU, Color(rc, 0.7), 2.0)
   504					for u in army.units:
   505						var up := ORIGIN + Vector2(u["col"] + 0.5, u["row"] + 0.5) * CS
   506						if up.distance_to(p) <= rad and not D.is_support(u["type"]):
   507							draw_circle(up + Vector2(0, 14), 9.0, Color(rc, 0.45), true, -1.0, true)
   508				D.CAVALRY:
   509					var q := p + Vector2(3.0 * CS * dir, 0)
   510					_chalk_line(p, q, Color(1, 0.8, 0.3, 0.85), 3.0, 8.0)
   511					draw_circle(q, 6, Color(1, 0.8, 0.3, 0.9), true, -1.0, true)
   512					_text(q + Vector2(0, -30), L.t("ev_charge"), ts(13), Color(1, 0.85, 0.4), true, true)
   513				D.ASSASSIN:
   514					if _enemy_visible():
   515						var best := Vector2.ZERO
   516						var bd := 1e9
   517						for u in armies[1 - army.team].units:
   518							if u["type"] == D.SHIELD or u["type"] == D.CAVALRY:
   519								var ep := ORIGIN + Vector2(u["col"] + 0.5, u["row"] + 0.5) * CS
   520								if ep.distance_to(p) < bd:
   521									bd = ep.distance_to(p)
   522									best = ep
   523						if bd < 1e9:
   524							_chalk_line(p, best, Color(0.78, 0.5, 1.0, 0.85), 2.5, 7.0)
   525		# 已擺的弓手射程：只在「選著弓手、游標停在那隻弓手上、或按住 Alt／LT」時顯示，並裁在棋盤內（第三輪 U3）
   526		var show_all := selected == D.ARCHER or Input.is_key_pressed(KEY_ALT) or Input.get_joy_axis(0, JOY_AXIS_TRIGGER_LEFT) > 0.5
   527		# 第七輪 D8：不再一隻一條弧線疊在一起，只畫全軍最前緣那一條；按 Alt／LT 才看全部
   528		var want_all := Input.is_key_pressed(KEY_ALT) or Input.get_joy_axis(0, JOY_AXIS_TRIGGER_LEFT) > 0.5
   529		var front := -1
   530		for fi in army.units.size():
   531			var fu: Dictionary = army.units[fi]
   532			if fu["type"] == D.ARCHER and (front < 0 or (int(fu["col"]) - int(army.units[front]["col"])) * dir > 0):
   533				front = fi
   534		for ui in army.units.size():
   535			var u: Dictionary = army.units[ui]
   536			if ui != front and not want_all and not (c.x == u["col"] and c.y == u["row"]):
   537				continue
   538			if u["type"] == D.ARCHER and (show_all or (c.x == u["col"] and c.y == u["row"])):
   539				var ap := ORIGIN + Vector2(u["col"] + 0.5, u["row"] + 0.5) * CS
   540				var a0 := -0.6 if army.team == 0 else PI - 0.6
   541				var hov: bool = c.x == u["col"] and c.y == u["row"]
   542				_arc_clipped(ap, 6.0 * CS, a0, a0 + 1.2, Color(1, 0.9, 0.5, 0.45 if hov else 0.12), 2.0 if hov else 1.5)   # 停著的那隻亮、其他淡（Antigravity S3）
   543		if _enemy_visible():
   544			for u in armies[1 - army.team].units:
   545				var sc := AIT.counter_score(selected, u["type"])
   546				if sc == 0:
   547					continue
   548				var ep := ORIGIN + Vector2(u["col"] + 0.5, u["row"] - 0.12) * CS
   549				var bc := Color("#4ade80") if sc > 0 else Color("#f87171")
   550				if drag_new or drag_from.x >= 0:
   551					# 拖曳時敵軍腳下亮圈：被剋淡綠、天敵淡紅（第三輪 U3）
   552					var fp := ORIGIN + Vector2(u["col"] + 0.5, u["row"] + 0.82) * CS
   553					draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.5), 0, fp))
   554					draw_circle(Vector2.ZERO, 24, Color(bc, 0.28), true, -1.0, true)
   555					_hand_ring(Vector2.ZERO, 24, Color(bc, 0.7), 2.0)
   556					draw_set_transform_matrix(_cam)
   557				draw_circle(ep, 11, Color("#111827"), true, -1.0, true)
   558				_hand_ring(ep, 11, bc, 2.0)
   559				if sc > 0:
   560					draw_polyline(PackedVector2Array([ep + Vector2(-5, 0), ep + Vector2(-1, 4), ep + Vector2(6, -5)]), bc, 3.0, true)
   561				else:
   562					draw_line(ep + Vector2(-5, -5), ep + Vector2(5, 5), bc, 3.0, true)
   563					draw_line(ep + Vector2(-5, 5), ep + Vector2(5, -5), bc, 3.0, true)
   564	
   565	
   566	
   567	## 把一隻（格子或自由座標）放進 keep：自由規則照座標放；格子規則吸附到最近的格子（Antigravity 第二輪：自由陣型也能用在格子）。
   568	func _place_from(keep, u: Dictionary) -> bool:
   569		var p: Vector2i = Army.pos_of(u)
   570		if keep.deploy == "free":
   571			return keep.place_xy(int(u["type"]), Army.quant(p.x), Army.quant(p.y))
   572		return keep.place(int(u["type"]), clampi(p.x / 1000, 0, 15), clampi(p.y / 1000, 0, 8))
   573	
   574	
   575	## 載入陣型（存檔格、貼上代碼）：先解碼到暫存陣型，全軍都是這場開放的兵種才替換（Codex 實作審查 #1）。
   576	## 回傳 ""＝成功、"locked"＝含未開放兵種、其他＝格式錯誤。
   577	func _load_checked(code: String) -> String:
   578		if rules != null:
   579			# 第五輪：自訂規則下，存檔格的陣型照這局的限制重新驗證——合法的放上去、不合法的拿掉，並用橫幅列出來
   580			var raw = _decode_any(code)
   581			if raw is String:
   582				return raw
   583			var keep = armies[0].copy()
   584			keep.units = []
   585			keep.guard_combat = true   # 保留戰鬥兵需要的錢與名額（Codex 實作第 2 輪：不會載入成只剩支援兵）
   586			var gone := {}
   587			var ordered: Array = raw.units.duplicate()
   588			ordered.sort_custom(func(p, q): return (0 if not D.is_support(int(p["type"])) else 1) < (0 if not D.is_support(int(q["type"])) else 1))
   589			for u in ordered:
   590				var t := int(u["type"])
   591				if not _place_from(keep, u):
   592					gone[t] = int(gone.get(t, 0)) + 1
   593			armies[0].units = keep.units
   594			_fp_abort_drag()
   595			fp_sel = []   # 換了陣型，舊的框選索引作廢（Codex 實作第 2 輪 #8）
   596			if not gone.is_empty():
   597				var bits: Array = []
   598				for t in gone:
   599					bits.append("%s×%d" % [L.t("unit_%d" % t), gone[t]])
   600				removed_banner = L.t("removed_by_rules", ["、".join(bits)])
   601				removed_banner_t = 4.0
   602			return ""
   603		var tmp := Army.new(armies[0].team, armies[0].budget)
   604		var why := tmp.load_code(code)
   605		if why != "":
   606			return why
   607		for u in tmp.units:
   608			if not _allowed(int(u["type"])):
   609				return "locked"
   610			u.erase("st")     # V1.4 #9 #12：貼紙只在遠征裡貼，貼上陣型碼不帶進來（Codex v140-i5）
   730				_lock_icon(r.position + Vector2(r.size.x - 14, 14))
   731			btn_group = "cards"   # 1.5.0 R14：兵卡牌尺＝一個選擇器（卡上的 ? 同一組）
   732			_btn_quiet(_card_help_rect(i), "?", _open_codex.bind(i))
   733			btn_group = ""   # 第七輪 N6：點擊框不變，外觀只留一個小問號，不切到角色
   734		var start_label := L.t("start")
   735		var start_en := _ready_to_fight()
   736		if _cp_on() and not cp.done():
   737			start_label = L.t("end_hand")
