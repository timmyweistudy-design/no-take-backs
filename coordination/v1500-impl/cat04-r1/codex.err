static func _r14(out: Dictionary, d: Dictionary) -> void:
	var sc: Dictionary = d.get("screen", {})
	if sc.is_empty():
		return
	var cls := str(sc.get("cls", ""))
	if str(sc.get("main", "")) == "":
		_add(out, "fail", "R14", cls, "畫面登記了類別卻沒有主動作")
	if not R14_LIMITS.has(cls):
		return
	var n := int(d.get("clicks", 0))
	var lim := int(R14_LIMITS[cls])
	if n <= lim:
		return
	if str(sc.get("skip", "")) != "":
		var key := "_ex_R14:" + cls
		if not out.has(key):
			out[key] = true
			out["exempt"].append({"rule": "R14", "id": cls, "why": str(sc["skip"])})
		return
		return
	if hit >= 0 and not _fp_duel_turns() and _fp_can_edit():
		fp_drag = hit
		fp_drag_from = a.pos_of(a.units[hit])
		fp_press_p = p
		fp_moved = false
		if not hit in fp_sel:
			fp_sel = []
		return
	if hit >= 0:
		return
	if not call("_allowed", selected):
		_toast(L.t("err_type"), true)
		return
	_fs_begin(w)

## 放開（滑鼠左鍵、手把 A 共用）。回傳 true＝自由模式處理掉了。
func _fp_release(p: Vector2, w: Vector2i) -> bool:
	var a = _fp_army()
	if fp_box:
		fp_box = false
		var r := Rect2(fp_box_a, Vector2.ZERO).expand(p)
		fp_sel = []
		for i in a.units.size():
			if r.has_point(_fld_xf() * _s_of(a.pos_of(a.units[i]))):
				fp_sel.append(i)
		return true
	if fp_drag >= 0:
		var i := fp_drag
		fp_drag = -1
		if _fp_locked() or not _fp_can_edit() or _fp_duel_turns():
			return true   # 拖曳途中被鎖住（暗擺雙方確認）：放開不生效（Codex 實作第 2 輪 #2）
		var group: bool = fp_sel.size() > 1 and i in fp_sel
		if not _fp_in_field(p):
			if group:
				return true   # 整群拖出戰場＝取消，不刪單隻（Antigravity 實作第 1 輪 #2）
			_fp_push_undo()
			a.units.remove_at(i)
