		return
	pad_mode = true
	match k:
		KEY_UP: cursor.y = maxi(0, cursor.y - 1)
		KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
		KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
		KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
		KEY_F1:
			_open_codex(selected)
		KEY_H:
			if mode == Mode.PUZZLE:
				call("_puzzle_hint")   # 第十三輪：手把 L3
		KEY_P:
			if mode == Mode.PUZZLE and PZ.get_puzzle(puzzle_id).has("cmd"):
				overlay = "puzzle_plan"   # 第十三輪：手把 R3
		KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0:
			# 第八輪：數字鍵對應這一排的第幾張卡，不是兵種編號
			var pos := 9 if k == KEY_0 else k - KEY_1
			var cards := _card_types()
			if pos < cards.size() and _allowed(cards[pos]):
				selected = cards[pos]
		KEY_Q, KEY_E:
			var cl := _card_types()
			if not cl.is_empty():
				var at := maxi(0, cl.find(selected))
				for _i in cl.size():
					at = (at + (cl.size() - 1 if k == KEY_Q else 1)) % cl.size()
					selected = cl[at]
					if _allowed(selected):
						break
		KEY_ENTER, KEY_KP_ENTER:
			if _cur_army().index_at(cursor.x, cursor.y) == -1:
				_try_place(cursor)
		KEY_BACKSPACE, KEY_DELETE:
			_try_remove(cursor)
		KEY_SPACE, KEY_TAB:
			_on_start()
		KEY_ESCAPE:
			_request_leave()



func _throttle_when_minimized() -> void:
	var mini: bool = DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_MINIMIZED
	if mini != _was_minimized:
		_was_minimized = mini
		if mini:
			Engine.max_fps = 10
		else:
			call("_apply_display")   # V1.5：還原時回到玩家設定的幀率上限，不是無上限（Antigravity v150-i1 #4）

	toast_born = time
	if deny:
		sfx.play("ui_deny")


func _move_focus(d: int) -> void:
	pad_mode = true
	if _btns.is_empty():
		return
	_focus = posmod(_focus + d, _btns.size())


## 字太寬就往下一級縮（第五輪：只在字級表內往下走，最小到「註記」，不再縮到 9px；還是太寬就由 _text 換行）。
func fit(s: String, size: int, maxw: float, bold := false) -> int:
	var sz := size
	var levels: Array = TYPE_SCALE[_scale_key()].values()
	levels.sort()
	while _width(s, sz, bold) > maxw:
		var nxt := -1
		for v in levels:
			if v < sz:
				nxt = v
		if nxt < 0:
			break
		sz = nxt
	return sz

func _font_for(s: String, size: int, bold: bool) -> Font:
	if _hand_mode and font_title != null:
		return font_title   # 1.2.0：老闆便條、印章用手寫字（憲法 6：只放建議，不承載數值）
	if font_craft:
