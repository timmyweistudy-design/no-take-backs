   779	
   780	## 資訊帶（第五輪 §4.4）：選中／停留的兵種名稱、一句定位、剋／怕頭像（28px 以上），右邊「?」開操作說明。
   781	## 殘局顯示提示與三星條件；遠征顯示還能改幾隻。
   782	func _draw_info_band(R: Rect2, i: int, team: int) -> void:
   783		draw_rect(R, Color(0, 0, 0, 0.35))
   784		var y := R.position.y + (R.size.y - tz("S") * 1.1) / 2
   785		var x := 16.0
   786		var help := Rect2(R.end.x - 46, R.position.y + 2, 36, 36)
   787		_btn(help, "?", func(): show_place_help = not show_place_help)
   788		if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
   789			var pz := PZ.get_puzzle(puzzle_id)
   790			var hint: String = L.field(pz, "hint")
   791			if mode == Mode.PUZZLE:
   792				var st := "　★ " + L.t("star2_short", [pz["star2"]]) + "　★ " + L.t("star3_short", [pz["star3"]])
   793				if PZ.goal(pz) != "win":
   794					st = "　" + L.t("goal_prefix") + _goal_text(pz) + st   # 第十三輪：護送、撐住、斬首（V1.1：前面加「過關：」，和星數條件分開）
   795				if pz.has("cap"):
   796					st = "　" + L.t("cap_note", [int(pz["cap"])]) + st
   797				call("_tv_buttons", help, true)   # V1.6 #6／#12：射程、標記、實驗簿
   798				_text(Vector2(R.end.x - 192 - _width(st, tz("S"), true), y), st, tz("S"), ACCENT, false, true)
   799				_text(Vector2(x, y), hint, tz("S"), Color(1, 1, 1, 0.85), false, false, R.size.x - 252 - _width(st, tz("S"), true))
   800			else:
   801				_text(Vector2(x, y), hint, tz("S"), Color(1, 1, 1, 0.85), false, false, R.size.x - 80)
   802			_draw_place_help()
   803			return
   804		call("_tv_buttons", help, int(get("trial_id")) >= 0 and mode == Mode.VS_AI)   # V1.6 #6：射程覆蓋、標記；試煉多實驗簿
   805		if mode == Mode.GAUNTLET and gauntlet_stage > 1:
   205				_toast(L.t("err_zone"), true)
   206				return
   207		else:
   208			_fp_push_undo()
   209			var a = _fp_army()
   210			for it in items:
   211				a.place_xy(int(it[0]), int(it[1]), int(it[2]))
   212		for k in items.size():
   213			settle_t[Vector2i(int(items[k][1]), int(items[k][2]))] = time + k * 0.03   # V1.3 B3：一隻接一隻落下
   214		show_place_help = false
   215		_fp_sound(items.size())
   216	
   217	## 畫筆連續落子的音效：一筆只響一次＋依隻數升高音高（避免一次 10 聲破音，Antigravity 第一輪）。
   218	func _fp_sound(n: int) -> void:
   219		if sfx != null and sfx.has_method("place_of"):
   220			var pp: Array = sfx.place_of(selected)   # 1.3.0 §10：自由部署也依重量分級
   221			sfx.play_pitched(str(pp[0]), 0.6, float(pp[1]) * (1.0 + minf(0.25, n * 0.025)))
   222		elif sfx != null and sfx.has_method("play_pitched"):
   223			sfx.play_pitched("place_mid", 0.6, 1.0 + minf(0.25, n * 0.025))
   224		elif sfx != null:
   225			sfx.play("place_mid", 0.6)
   226			sfx.play_wood(selected, 0.35)   # V1.6 #14
   227	
   228	# ───────── 搬移、框選、刪除、復原 ─────────
   229	func _fp_push_undo() -> void:
   230		fp_undo.append({"team": _fp_army().team, "units": _fp_army().units.duplicate(true)})
   231		if fp_undo.size() > 40:
   232			fp_undo.pop_front()
   233		fp_redo.clear()
   234	
   235	func _fp_undo_do(redo := false) -> void:
   236		if _fp_duel_turns():
   237			_toast(L.t("err_notakeback"), true)
   238			return
   239		if _fp_locked():
   240			return
   241		var src: Array = fp_redo if redo else fp_undo
   242		var a = _fp_army()
   243		# 復原紀錄依隊伍分開：暗擺換方後，另一方的紀錄不能寫進這一方（Codex 實作第 1 輪 #1）
   244		while not src.is_empty() and int(src[src.size() - 1]["team"]) != a.team:
   245			src.pop_back()
   246		if src.is_empty():
   247			return
   248		(fp_undo if redo else fp_redo).append({"team": a.team, "units": a.units.duplicate(true)})
   249		var snap: Array = src.pop_back()["units"]
   250		# 還原前重新驗證（每一隻都在這一方的部署區、間距合法）
   251		var trial = a.copy()
   252		trial.units = []
   253		for u in snap:
   254			if not trial.place_xy(int(u["type"]), int(u["x"]), int(u["y"])):
   255				trial = null
   256				break
   257		if trial == null:
   258			_toast(L.t("err_zone"), true)
   259			return
   260		a.units = snap
   261		fp_sel = []
   262	
   263	func _fp_erase_at(w: Vector2i) -> void:
   264		if _fp_duel_turns() or not _fp_can_edit():
   265			return
   266		var a = _fp_army()
   267		var i: int = a.index_near(w.x, w.y, PICK_R)
   268		if i >= 0:
   269			if not fp_erasing:
   270				_fp_push_undo()
   271			a.units.remove_at(i)
   272			fp_sel = []
   273			fp_erasing = true
   274	
   275	func _fp_delete_sel() -> void:
   460			KEY_Z:
   461				if Input.is_key_pressed(KEY_CTRL):
   462					_fp_undo_do(false)
   463					return true
   464			KEY_Y:
   465				if Input.is_key_pressed(KEY_CTRL):
   466					_fp_undo_do(true)
   467					return true
   468		return false
   469	
   470	# ───────── 手把 ─────────
   471	func _fp_pad_process(delta: float, stick: Vector2) -> void:
   472		if not _is_free() or not pad_mode:
   473			return
   474		if stick.length() > maxf(0.05, int(Save.s("deadzone")) / 100.0):   # V1.5：死區照設定（預設 20%）
   475			# 平滑游標＋輕推時減速（微調）
   476			var sp := 5200.0 * pow(stick.length(), 2.0)
   477			fp_cur += stick.normalized() * sp * delta
   478			fp_cur.x = clampf(fp_cur.x, 200.0, fld_w - 200.0)
   479			fp_cur.y = clampf(fp_cur.y, 200.0, fld_h - 200.0)
   480			var w := Vector2i(fp_cur)
   481			if fp_stroking:
   482				_fs_extend(w)
   483			elif fp_pad_x:
   484				_fp_erase_at(w)
   485	
   486	func _fp_pad_button(b: int, pressed: bool) -> bool:
   487		if not _is_free() or overlay != "":
   488			return false
   489		var w := Vector2i(fp_cur)
   490		match b:
   491			JOY_BUTTON_A:
   492				# 手把：A 和滑鼠左鍵同一套（點兵＝搬、按住 LT＝框選、其他＝畫筆）
   493				if pressed:
   494					fp_pad_a = true
   495					_fp_press(_fp_scr(w), w, Input.get_joy_axis(0, JOY_AXIS_TRIGGER_LEFT) > 0.5)
   496				else:
   497					fp_pad_a = false
   498					_fp_release(_fp_scr(w), w)
   499				return true
   500			JOY_BUTTON_X:
   501				fp_pad_x = pressed
   502				if pressed:
   503					fp_erasing = false
   504					_fp_erase_at(w)
   505				else:
   610			fp_skip_seen = tp.skipped.size()
   611			_toast(L.t("fp_skipped", [L.t("blue") if int(sk["team"]) == 0 else L.t("red")]))
   612		var a = _fp_army()
   613		var drag_on := fp_stroking or fp_drag >= 0 or fp_box
   614		var lst: Array = []
   615		var hide_side := -1
   616		if mode == Mode.VS_AI and (rules == null or rules.fullfield != 2):
   617			hide_side = 1
   618		elif mode == Mode.DUEL and tp == null:
   619			hide_side = 1 if blind_phase == 0 else (0 if blind_phase == 1 else -1)
   620		for ar in armies:
   621			if ar.team == hide_side:
   622				continue
   623			for i in ar.units.size():
   624				if ar == a and (i == fp_drag or (fp_drag >= 0 and fp_sel.size() > 1 and fp_drag in fp_sel and i in fp_sel)):
   625					continue   # 搬移中：原位置不畫（整群一起藏，Antigravity 實作第 2 輪）
   626				var w: Vector2i = ar.pos_of(ar.units[i])
   627				lst.append([w.y, w.x, int(ar.units[i]["type"]), ar.team, ar == a and i in fp_sel])
   628		lst.sort()
   629		# 占地圈：只在拖曳或懸停時出現（Antigravity）
   630		var hover_w: Vector2i = Vector2i(fp_cur) if pad_mode else _w_of(mouse)   # 手把＝準星（Antigravity 實作第 3 輪，未經複查）
   631		if hide_side >= 0:
   632			call("_draw_hide_fog", hide_side)   # 第七輪：自由模式也要有迷霧與「敵陣開戰才看得到」，原本右半場空著像沒做完
   633		for it in lst:
   634			var w := Vector2i(it[1], it[0])
   635			if it[3] == a.team and (drag_on or Vector2(w - hover_w).length() < 1500):   # 第七輪 D8：範圍縮小減噪
   636				_fp_dashed_circle(_s_of(w) - Vector2(0, 0.32 * CS), a.spacing / 2000.0 * CS, Color(1, 1, 1, 0.35))
   637		for it in lst:
   638			var p := _s_of(Vector2i(it[1], it[0]))
			_try_place(c)
	elif mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
		if drag_new and c.x >= 0:
			_try_place(c)
		elif drag_from.x >= 0:
			if c.x < 0:
				_try_remove(drag_from)
			elif c == drag_from and Save.s("place_mode") == "tap" and not drag_moved and mouse.distance_to(drag_press_p) < 10.0:
				_try_remove(drag_from)   # V1.5.1 C4：只點選模式點一下自己的兵＝拿掉（觸控不用長按）
			elif c != drag_from:
				if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() >= gauntlet_changes:
					_toast(L.t("err_changes"), true)
				elif not _cur_army().move(drag_from.x, drag_from.y, c.x, c.y):
					_toast(L.t("err_zone"), true)
				else:
					sfx.play("place_light")
		drag_new = false
		painting = false
		drag_from = Vector2i(-1, -1)
	elif mb.button_index == MOUSE_BUTTON_RIGHT and mb.pressed and c.x >= 0:
		_try_remove(c)



## 1.2.0 第 11 大類：手把的部署工具＝按住 RT（右扳機，原本沒用到）＋Y 翻轉（自由：對齊）、＋十字 ←／→ 整軍後退／前進、＋LB 複製上一陣。
## 這裡的 Y、LB 是改鍵換算後的預設鍵（_input 先做 pad_to_default）：改了「暫停」「上一種」的綁定就跟著換，提示也照綁定顯示。
## 不能用的情況（工具不開放、不是擺陣）照原本的按鍵處理。
func _pad_tool(ev: InputEventJoypadButton) -> bool:
	if state != St.PLACE or overlay != "" or Input.get_joy_axis(ev.device, JOY_AXIS_TRIGGER_RIGHT) < 0.5:
		return false
	var id := ""
	match ev.button_index:
		JOY_BUTTON_Y:
			id = "align" if _is_free() else "flip"
		JOY_BUTTON_DPAD_RIGHT:
			id = "" if _is_free() else "fwd"
		JOY_BUTTON_DPAD_LEFT:
			id = "" if _is_free() else "back"
		JOY_BUTTON_LEFT_SHOULDER:
			id = "last"
	if id == "" or not bool(call("_deploy_tools_ok")):
		return false
	pad_mode = true
	_enqueue("tool", id)   # 和落子、放開、開戰同一個佇列（不然會插到前面還沒處理的拖曳之前；Codex cat11 #3）
	return true

## 1.2.0 §11.1 部署工具的鍵（格子 M、Shift＋←→；自由 A；兩種 L）
func _place_tool_key(k: int) -> bool:
	match k:
		KEY_M:
			return call("_deploy_tool", "flip")
		KEY_A:
			return call("_deploy_tool", "align")
		KEY_L:
			return call("_deploy_tool", "last")
		KEY_RIGHT, KEY_LEFT:
			if Input.is_key_pressed(KEY_SHIFT):
				return call("_deploy_tool", "fwd" if k == KEY_RIGHT else "back")
	return false

func _key(k: int) -> void:
	_toast_dismiss()
	if state == St.BATTLE:
		mag_hide = follow_id   # 1.3.0 §2：任何按鍵 1 幀內收起放大鏡
		hl_reel.clear()        # 精華三連：按鍵＝交還手動（Codex cat06 #6）
	if state == St.RESULT and _ink_active():
		result_t -= INK_DUR   # 1.2.0 §9.4：任何按鍵跳過宣紙戰報演出
		return
	if state == St.PLACE and overlay == "" and _v16_place_key(k):
		return
	if state == St.PLACE and overlay == "" and _place_tool_key(k):
		return
	if state == St.PLACE and _fp_key(k):
		return
	if state == St.BATTLE and overlay == "" and _cmd_key(k):
		return
	if state == St.BATTLE and overlay == "" and (k == KEY_BRACKETLEFT or k == KEY_BRACKETRIGHT) and _replay_controls_active():
		_bm_jump(-1 if k == KEY_BRACKETLEFT else 1)   # 1.2.0 §11.2 書籤
		return
	if state == St.BATTLE and overlay == "" and k == KEY_G and play_kind == "review" and tm_ghost != null:
		tm_ghost_on = not tm_ghost_on   # 1.2.0 §11.3
		return
	# 1.5.0 §1.2 大廳三步：肩鍵（Q／E）＝上一步／下一步，Y（Tab）＝打開／收起進階折頁
	if overlay == "lobby" and not bool(get("lobby_menu")):
		if (k == KEY_Q or k == KEY_E) and not bool(get("lobby_open")):
			call("_lobby_step_by", -1 if k == KEY_Q else 1)
			return
		if k == KEY_TAB:
			set("lobby_open", not bool(get("lobby_open")))
			_btns.clear()   # 開合折頁：舊按鈕立刻失效（同一幀 Y＋A 不會按到開合前的「開戰」；Codex v150 cat03 r3）
			return
	# 有按鈕焦點的畫面（標題、選單、結果、覆蓋層、戰鬥）：方向鍵移焦點、Enter 按下、Esc 返回
	if state != St.PLACE or overlay != "":
		match k:
			KEY_UP, KEY_LEFT:
				_move_focus(-1)
			KEY_DOWN, KEY_RIGHT:
				_move_focus(1)
			KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
				if _btns_gen == _gen and _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:   # 按鈕清單要是這個畫面的
					sfx.play("k_click", 0.7)
					_btns[_focus]["cb"].call()
			KEY_F1:
				if state == St.BATTLE and overlay == "" and play_kind != "official":
					call("_breport_open")   # 1.1.0 B10：手把 View／Select＝戰報面板
				elif state == St.BATTLE and overlay == "":
					set("hud_info_until", time + 2.0)   # 1.2.0 §5.6：正式對戰按 View＝叫出 AI 名稱與性格 2 秒
			KEY_PAGEUP, KEY_PAGEDOWN:
				if overlay == "codex":
					_scroll_by("left", -160.0 if k == KEY_PAGEUP else 160.0)
			KEY_P, KEY_TAB:
	var cam := fxf
	if state == St.BATTLE or state == St.RESULT:
		var off := Vector2.ZERO
		if shake > 0 and _fx_on("shake"):
			off = Vector2(sin(time * 90) * 2, cos(time * 77) * 2) * int(Save.s("shake_pct")) / 100.0   # V1.5：鏡頭震動強度
		var w := clampf((zoom - 1.0) / 0.5, 0.0, 1.0)
		var c := (ORIGIN + FIELD / 2).lerp(fxf * zoom_center, w)
		var half := Vector2(640, 388) / zoom
		var anchor := Vector2(640, 388 + BATTLE_DY)
		var lo := ORIGIN + half - Vector2(60, 100)
		var hi := ORIGIN + FIELD - half + Vector2(60, 100)
		c = Vector2(clampf(c.x, minf(lo.x, hi.x), maxf(lo.x, hi.x)), clampf(c.y, minf(lo.y, hi.y), maxf(lo.y, hi.y)))
		cam = Transform2D(0, Vector2(zoom, zoom), 0, anchor - c * zoom + off) * fxf
	if state == St.TITLE:
		# 第七輪 D4：示範戰場縮小放右邊，不被左側面板壓到
		cam = Transform2D(0, Vector2(0.72, 0.72), 0, Vector2(1270.0 - (ORIGIN.x + FIELD.x) * 0.72, 400.0 - (ORIGIN.y + FIELD.y / 2.0) * 0.72))
	draw_set_transform_matrix(cam)
	_cam = cam
	Art.base = cam
	var _t := Time.get_ticks_usec()
	_draw_field()
	perf_parts["field"] = Time.get_ticks_usec() - _t
	_t = Time.get_ticks_usec()
	if state == St.TITLE:
		_draw_units_of(demo, true)
	elif state == St.PLACE:
		if _is_free():
			_fp_draw_zones()   # 第六輪：自由排兵
			_fp_draw()
		else:
			_draw_place_units()
			_draw_tactical()
		_v16_place_draw()   # V1.6 #6
	else:
		if state == St.BATTLE and _frags_on():
			frags.draw(self)   # 1.2.0 §8.2 材料碎片在地上、單位之下
		if state == St.BATTLE:
			for f0 in fx:   # 1.5.0：地面痕跡（茶漬、焦痕）滲在木盤上＝畫在兵之下（蓋在兵上時，固定時鐘量到 Boss 戰旁邊的兵被壓暗）
				if f0["kind"] in GROUND_FX:
					_draw_fx(f0)
			_draw_contact_ao(view)   # 1.4.0 §3.2 接觸陰影
		_draw_units_of(view, false)
		if state == St.BATTLE:
			_draw_occluded_bases(view)   # 1.4.0 §3.1 被擋住的兵補虛線底座
			_draw_cues()   # 1.3.0 §7.1 技能預告（命中前）
			_v16_battle_draw()
	perf_parts["units"] = Time.get_ticks_usec() - _t
	_t = Time.get_ticks_usec()
	for f in fx:   # 先畫特效，跳字最後畫（Antigravity S2 #1：特效不能蓋住跳字）
		if not f.get("screen", false) and f["kind"] != "text" and not (state == St.BATTLE and f["kind"] in GROUND_FX):
			_draw_fx(f)
	for f in fx:
		if not f.get("screen", false) and f["kind"] == "text":
			_draw_fx(f)
	perf_parts["fx"] = Time.get_ticks_usec() - _t
	if state == St.RESULT and _ink_active():
		_draw_ink_report_field()
	draw_set_transform_matrix(Transform2D.IDENTITY)
	# V1.2 F2：畫面四周暈影（戰場與標題背景，壓在介面底下），讓視線集中在中間
	var vg := _ui_tex("res://art/ui/vignette.png")
	if vg != null and not bool(Save.s("plain_ui")):
		draw_texture_rect(vg, Rect2(0, 0, 1280, 800), false, Color(1, 1, 1, 0.5))
	_probe_ui = true
	Art.base = Transform2D.IDENTITY
	if state == St.BATTLE:
		_draw_seat()        # 1.3.0 §11 對手坐在盤外右側桌邊
