+fi
+exit $RC
diff --git a/game/tools/art_baseline.py b/game/tools/art_baseline.py
new file mode 100755
index 0000000..805ad62
--- /dev/null
+++ b/game/tools/art_baseline.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""1.5.0 §12：固定時鐘美感基線（棋子輪廓對比）。
+美感指標只在 LAYOUT_FIXED=1（固定幀時間）下比；一般版面檢查是真實時間，每次跑會浮動，不能比（1.4.0 收尾教訓）。
+用法（game/ 下）：
+  python3 tools/art_baseline.py save  <版面輸出夾> <基線檔>   # 逐畫面×組記 low_units／units
+  python3 tools/art_baseline.py check <版面輸出夾> <基線檔>   # 任一畫面×組 low_units 高於基線＝失敗（exit 1）
+  python3 tools/art_baseline.py merge <版面輸出夾> <基線檔>   # 新畫面補進基線（舊畫面不覆蓋）
+"""
+import json, os, sys, glob
+
+def read(out_dir):
+    """回傳 (有棋子的畫面×組 → [low, units], 這輪實際拍到的 畫面×組 集合)"""
+    r, seen = {}, set()
+    for f in sorted(glob.glob(os.path.join(out_dir, '*', 'layout.jsonl'))):
+        combo = os.path.basename(os.path.dirname(f))
+        for line in open(f, encoding='utf-8'):
+            x = json.loads(line)
+            key = '%s|%s' % (x['shot'], combo)
+            seen.add(key)
+            a = x.get('art') or {}
+            if int(a.get('units', 0)) <= 0:
+                continue
+            r[key] = [int(a.get('low_units', 0)), int(a['units'])]
+    return r, seen
+
+def main():
+    if len(sys.argv) != 4 or sys.argv[1] not in ('save', 'check', 'merge'):
+        print(__doc__); sys.exit(2)
+    cmd, out_dir, base = sys.argv[1:]
+    cur, seen = read(out_dir)
+    if not seen:
+        print('ART FAIL：%s 沒有任何版面輸出（空的輸出不能當通過）' % out_dir); sys.exit(1)
+    if cmd == 'save':
+        json.dump(cur, open(base, 'w', encoding='utf-8'), ensure_ascii=False, indent=0, sort_keys=True)
+        print('ART 基線寫入 %d 筆（%s）' % (len(cur), base)); return
+    old = json.load(open(base, encoding='utf-8')) if os.path.exists(base) else {}
+    if cmd == 'merge':
+        n = 0
+        for k, v in cur.items():
+            if k not in old:
+                old[k] = v; n += 1
+        json.dump(old, open(base, 'w', encoding='utf-8'), ensure_ascii=False, indent=0, sort_keys=True)
+        print('ART 基線補進 %d 筆新畫面' % n); return
+    worse, new, lo_c, lo_b = [], [], 0, 0
+    # 這輪有拍到的畫面×組，基線有棋子、這輪卻沒有美感資料＝探針消失（不能靜靜通過；Codex v150 cat01 #1）
+    lost = [k for k in sorted(old) if k in seen and k not in cur]
+    for k, v in sorted(cur.items()):
+        if k not in old:
+            new.append(k); continue
+        lo_c += v[0]; lo_b += old[k][0]
+        if v[0] > old[k][0]:
+            worse.append('%s：%d → %d（/%d）' % (k, old[k][0], v[0], v[1]))
+    print('ART 固定時鐘棋子低對比 %d（基線 %d）；比基線差 %d 筆、探針消失 %d 筆、新畫面 %d 筆（沒有基線，不算）' % (lo_c, lo_b, len(worse), len(lost), len(new)))
+    for w in worse[:40]:
+        print('  ' + w)
+    for k in lost[:20]:
+        print('  探針消失 ' + k)
+    sys.exit(1 if (worse or lost) else 0)
+
+if __name__ == '__main__':
+    main()
diff --git a/game/tools/run_chain.sh b/game/tools/run_chain.sh
new file mode 100755
index 0000000..5b95763
--- /dev/null
+++ b/game/tools/run_chain.sh
@@ -0,0 +1,83 @@
+#!/usr/bin/env bash
+# 1.5.0 §12：背景驗收鏈。整條鏈綁 run ID 與提交雜湊、跑在自己的程序群；中止時整條停（含這條鏈開的 Windows Godot），確認退出才准開新輪。
+# 用法（game/ 下）：
+#   tools/run_chain.sh <名稱> '<步驟1>' '<步驟2>' …     # 依序跑，任一步失敗就停；紀錄 ../build/tmp/chains/<名稱>/<run>/
+#   tools/run_chain.sh --stop <名稱>                     # 停掉整條鏈（Linux 程序群＋這條鏈開始之後啟動的 Windows Godot），確認退出
+#   tools/run_chain.sh --status <名稱>
+# 鎖：../build/tmp/chains/<名稱>.lock（mkdir 原子建立）；同名鏈還在跑就拒絕。
+set -u
+cd "$(dirname "$0")/.." || exit 2
+D="$(cd .. && pwd)/build/tmp/chains"
+mkdir -p "$D"
+cur() { readlink "$D/$1.current" 2>/dev/null; }
+alive() { local pg; pg=$(sed -n 's/^pgid=//p' "$1/run" 2>/dev/null); [ -n "$pg" ] && kill -0 -- "-$pg" 2>/dev/null; }
+win_godot_since() {   # 這條鏈開始之後啟動的 Windows Godot（WSL 砍不到 Windows 程序，只能從這邊找）。
+  # 查詢失敗＝回傳非零（不能當成「沒有」）：PowerShell 退出碼要是 0、而且輸出 QUERY_OK；「沒有 Godot」不是錯誤（Where-Object 過濾，不靠 -Name 找不到時的錯誤）
+  local raw rc
+  raw=$(powershell.exe -NoProfile -c "\$ErrorActionPreference='Stop'; try { \$t=[datetime]::Parse('$1', \$null, [Globalization.DateTimeStyles]::RoundtripKind); Get-Process | Where-Object { \$_.ProcessName -like 'Godot*' -and \$_.StartTime -ge \$t } | ForEach-Object { \$_.Id }; 'QUERY_OK'; exit 0 } catch { 'QUERY_FAIL'; exit 1 }" 2>/dev/null); rc=$?
+  raw=$(printf '%s' "$raw" | tr -d '\r')
+  [ $rc -eq 0 ] && printf '%s\n' "$raw" | grep -q '^QUERY_OK$' || return 1
+  printf '%s\n' "$raw" | grep -v '^QUERY_OK$' | grep -v '^$' || true
+}
+case "${1:-}" in
+--status)
+  r=$(cur "$2"); [ -n "$r" ] && cat "$r/run" || echo "CHAIN 沒有 $2"; exit 0 ;;
+--stop)
+  # 停止和啟動共用鎖：只停「目前登記的那一輪」，核對 run 身分；刪鎖只刪屬於這一輪的（不會刪到別人剛拿的新鎖；Codex v150 cat01 r3 #3）
+  r=$(cur "$2"); [ -n "$r" ] || { echo "CHAIN 沒有 $2"; exit 0; }
+  rid=$(sed -n 's/^run=//p' "$r/run")
+  for i in $(seq 1 25); do grep -q '^pgid=' "$r/run" && break; sleep 0.2; done
+  grep -q '^pgid=' "$r/run" || { echo "CHAIN $2 啟動中（還沒登記程序群），稍後再停"; exit 1; }
+  pg=$(sed -n 's/^pgid=//p' "$r/run"); st=$(sed -n 's/^started_win=//p' "$r/run")
+  kill -TERM -- "-$pg" 2>/dev/null
+  for i in $(seq 1 20); do alive "$r" || break; sleep 0.5; done
+  alive "$r" && kill -KILL -- "-$pg" 2>/dev/null
+  ids=$(win_godot_since "$st") || { echo "CHAIN $2 查不到 Windows 程序（查詢失敗），沒有確認退出"; exit 1; }
+  for id in $ids; do powershell.exe -NoProfile -c "Stop-Process -Id $id -Force" >/dev/null 2>&1; done
+  sleep 1
+  left=$(win_godot_since "$st") || { echo "CHAIN $2 查不到 Windows 程序（查詢失敗），沒有確認退出"; exit 1; }
+  if alive "$r" || [ -n "$left" ]; then echo "CHAIN $2 還沒停乾淨（Linux 程序群 $pg、Windows Godot：$left）"; exit 1; fi
+  echo "state=stopped" >> "$r/run"
+  o=$(cat "$D/$2.lock/owner" 2>/dev/null); lr=$(cat "$D/$2.lock/run" 2>/dev/null)
+  if [ "$lr" = "$rid" ]; then rm -rf "$D/$2.lock"; fi
+  echo "CHAIN $2 已停（run $rid）"; exit 0 ;;
+esac
+name="$1"; shift
+[ $# -ge 1 ] || { echo "用法：tools/run_chain.sh <名稱> '<步驟>' …"; exit 2; }
+if ! mkdir "$D/$name.lock" 2>/dev/null; then
+  # 回收舊鎖要序列化（同時只有一個程序能回收），而且沒有 owner 的鎖要放 10 秒以上才算舊（別人可能剛拿到、還沒寫 owner；Codex v150 cat01 r2 #4）
+  mkdir "$D/$name.reclaim" 2>/dev/null || { echo "CHAIN $name 有人正在回收鎖，稍後再試"; exit 1; }
+  trap 'rmdir "$D/$name.reclaim" 2>/dev/null' EXIT
+  o=$(cat "$D/$name.lock/owner" 2>/dev/null)
+  if [ -n "$o" ] && kill -0 "$o" 2>/dev/null; then echo "CHAIN $name 還在跑（擁有者 $o），先 --stop"; exit 1; fi
+  age=$(( $(date +%s) - $(stat -c %Y "$D/$name.lock" 2>/dev/null || date +%s) ))
+  if [ -z "$o" ] && [ "$age" -lt 10 ]; then echo "CHAIN $name 鎖剛被拿走（還沒登記擁有者），先不要開"; exit 1; fi
+  r=$(cur "$name")
+  if [ -n "$r" ] && alive "$r"; then echo "CHAIN $name 還在跑（$r），先 --stop"; exit 1; fi
+  rm -rf "$D/$name.lock"; mkdir "$D/$name.lock" 2>/dev/null || { echo "CHAIN $name 拿不到鎖"; exit 1; }
+  rmdir "$D/$name.reclaim" 2>/dev/null; trap - EXIT
+fi
+echo $$ > "$D/$name.lock/owner"   # 拿到鎖立刻登記擁有者
+rid="$(date +%Y%m%d-%H%M%S)-$$"
+echo "$rid" > "$D/$name.lock/run"   # 鎖屬於哪一輪（停止時核對，不刪到別人的鎖）
+R="$D/$name/$rid"; mkdir -p "$R"
+commit="$(git rev-parse --short HEAD 2>/dev/null)$(git diff --quiet 2>/dev/null || echo +dirty)"
+stw=$(powershell.exe -NoProfile -c "(Get-Date).ToString('o')" 2>/dev/null | tr -d '\r')   # 精確起點（不倒退、不截斷；Codex v150 cat01 r2 #5）
+[ -n "$stw" ] || { echo "CHAIN $name 取不到 Windows 時間"; rm -rf "$D/$name.lock"; exit 1; }
+printf 'run=%s\ncommit=%s\nstarted=%s\nstarted_win=%s\n' "$rid" "$commit" "$(date '+%F %T')" "$stw" > "$R/run"
+ln -sfn "$R" "$D/$name.current"
+setsid bash -c '
+  R="$1"; L="$2"; shift 2
+  echo "pgid=$(ps -o pgid= $$ | tr -d " ")" >> "$R/run"
+  echo $$ > "$L/owner"
+  n=0; rc=0
+  for step in "$@"; do
+    n=$((n+1)); echo "step$n=$step" >> "$R/run"
+    bash -c "$step" > "$R/step$n.log" 2>&1; rc=$?
+    echo "step${n}_rc=$rc" >> "$R/run"
+    [ $rc -ne 0 ] && break
+  done
+  [ $rc -ne 0 ] && echo "state=failed@$n" >> "$R/run" || echo "state=done" >> "$R/run"
+  [ "$(cat "$L/run" 2>/dev/null)" = "$(sed -n "s/^run=//p" "$R/run")" ] && rm -rf "$L" 2>/dev/null' _ "$R" "$D/$name.lock" "$@" &
+for i in $(seq 1 20); do grep -q '^pgid=' "$R/run" && break; sleep 0.2; done
+echo "CHAIN $name 開始（run $rid、$commit）：$R"

exec
/bin/bash -lc "nl -ba game/tools/run_chain.sh; sed -n '1120,1260p' game/scripts/ui/game_screens.gd; rg -n '_stick_repeat|_trans_gate|JOY_AXIS_RIGHT|_stick_dir|trans_stick_eat' game/scripts/ui -g '*.gd'; rg --files -g AGENTS.md /mnt/c/Users/timmy/projects 2>/dev/null" in /mnt/c/Users/timmy/projects/no-take-backs
