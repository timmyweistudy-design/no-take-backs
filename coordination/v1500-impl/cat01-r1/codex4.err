    48	  # 回收舊鎖要序列化（同時只有一個程序能回收），而且沒有 owner 的鎖要放 10 秒以上才算舊（別人可能剛拿到、還沒寫 owner；Codex v150 cat01 r2 #4）
    49	  mkdir "$D/$name.reclaim" 2>/dev/null || { echo "CHAIN $name 有人正在回收鎖，稍後再試"; exit 1; }
