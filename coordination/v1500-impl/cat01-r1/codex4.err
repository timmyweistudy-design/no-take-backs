    52	  if [ -n "$o" ] && kill -0 "$o" 2>/dev/null; then echo "CHAIN $name 還在跑（擁有者 $o），先 --stop"; exit 1; fi
    53	  age=$(( $(date +%s) - $(stat -c %Y "$D/$name.lock" 2>/dev/null || date +%s) ))
    54	  if [ -z "$o" ] && [ "$age" -lt 10 ]; then echo "CHAIN $name 鎖剛被拿走（還沒登記擁有者），先不要開"; exit 1; fi
    55	  r=$(cur "$name")
    56	  if [ -n "$r" ] && alive "$r"; then echo "CHAIN $name 還在跑（$r），先 --stop"; exit 1; fi
    57	  rm -rf "$D/$name.lock"; mkdir "$D/$name.lock" 2>/dev/null || { echo "CHAIN $name 拿不到鎖"; exit 1; }
    58	  rmdir "$D/$name.reclaim" 2>/dev/null; trap - EXIT
    59	fi
    60	echo $$ > "$D/$name.lock/owner"   # 拿到鎖立刻登記擁有者
    61	rid="$(date +%Y%m%d-%H%M%S)-$$"
    62	echo "$rid" > "$D/$name.lock/run"   # 鎖屬於哪一輪（停止時核對，不刪到別人的鎖）
    63	R="$D/$name/$rid"; mkdir -p "$R"
    64	commit="$(git rev-parse --short HEAD 2>/dev/null)$(git diff --quiet 2>/dev/null || echo +dirty)"
    65	stw=$(powershell.exe -NoProfile -c "(Get-Date).ToString('o')" 2>/dev/null | tr -d '\r')   # 精確起點（不倒退、不截斷；Codex v150 cat01 r2 #5）
    66	[ -n "$stw" ] || { echo "CHAIN $name 取不到 Windows 時間"; rm -rf "$D/$name.lock"; exit 1; }
    67	printf 'run=%s\ncommit=%s\nstarted=%s\nstarted_win=%s\n' "$rid" "$commit" "$(date '+%F %T')" "$stw" > "$R/run"
    68	ln -sfn "$R" "$D/$name.current"
    69	setsid bash -c '
    70	  R="$1"; L="$2"; shift 2
    71	  echo "pgid=$(ps -o pgid= $$ | tr -d " ")" >> "$R/run"
    72	  echo $$ > "$L/owner"
    73	  n=0; rc=0
    74	  for step in "$@"; do
    75	    n=$((n+1)); echo "step$n=$step" >> "$R/run"
    76	    bash -c "$step" > "$R/step$n.log" 2>&1; rc=$?
    77	    echo "step${n}_rc=$rc" >> "$R/run"
    78	    [ $rc -ne 0 ] && break
    79	  done
    80	  [ $rc -ne 0 ] && echo "state=failed@$n" >> "$R/run" || echo "state=done" >> "$R/run"
    81	  [ "$(cat "$L/run" 2>/dev/null)" = "$(sed -n "s/^run=//p" "$R/run")" ] && rm -rf "$L" 2>/dev/null' _ "$R" "$D/$name.lock" "$@" &
    82	for i in $(seq 1 20); do grep -q '^pgid=' "$R/run" && break; sleep 0.2; done
    83	echo "CHAIN $name 開始（run $rid、$commit）：$R"
# ── 1.4.0 第 8 大類：桌面世界與轉場（方案 §2；切片 A）──
## 每個疊層在桌上的固定位置（從哪邊滑進來）；沒列的照舊淡入。
const SLIDE_FROM := {"lobby": Vector2(-80, 0), "codex": Vector2(0, 70), "settings": Vector2(80, 0), "keys": Vector2(80, 0),
	"profile": Vector2(0, -60), "puzzles": Vector2(-70, 0), "trials": Vector2(-70, 0), "codes": Vector2(70, 0)}
const SLIDE_SEC := 0.3    # 180～300ms；和 1.3.0 器物開合同長（同時到終態，Codex cat08 #1）
var trans_eat := {}            # 跳過轉場的輸入（來源＋鍵碼＋裝置／手指）→ 各自的放開才解鎖；可能同時好幾個（Codex cat08 r2 #1、r3 #1）
var trans_stick_eat := false   # 用搖桿跳過／轉場中推著搖桿：回中之前不送方向（方案 §2.5）
var _rstick := Vector2.ZERO    # 右搖桿兩軸目前的值（轉場開始時還推著＝鎖到回中；兩軸都回中才解鎖，Codex v150 cat01 r2 #1）
var trans_rstick_eat := false  # 1.5.0：右搖桿推過轉場也鎖到回中（不然轉場一結束就直接捲圖鑑，Codex v150 cat01 #3）

## 失焦：放開事件收不到，所有輸入身分與鎖一起清
func _trans_reset_input() -> void:
	_held.clear()
	_rstick = Vector2.ZERO
	stick[JOY_AXIS_LEFT_X] = 0.0   # 失焦期間回中收不到事件：左搖桿舊值與連發狀態一起清（Codex v150 cat01 r3 #2）
	stick[JOY_AXIS_LEFT_Y] = 0.0
	set("_stick_dir", Vector2i.ZERO)
	trans_eat.clear()
	trans_stick_eat = false
	trans_rstick_eat = false

## 輸入的身分：同一顆鍵／同一個滑鼠鈕／同一根手指的按下與放開對得起來
static func trans_sig(ev: InputEvent) -> String:
	if ev is InputEventKey:
		return "k%d" % int(ev.physical_keycode if ev.physical_keycode != 0 else ev.keycode)
	if ev is InputEventMouseButton:
		return "m%d" % int(ev.button_index)
	if ev is InputEventJoypadButton:
		return "j%d:%d" % [ev.device, int(ev.button_index)]
	if ev is InputEventScreenTouch:
		return "t%d" % int(ev.index)
	return ""

## 轉場的輸入閘門（在 _input 最前面）：轉場中任何按下＝跳到終態並吃掉，連同同一個輸入的放開（含按住的連發）；
## 拖曳、滾輪、捲動、hover 在轉場中都不生效（Codex cat08 #2～#5）。回傳 true＝這個事件吃掉。
var _held := {}             # 目前按住的輸入身分（轉場開始時一併列入要吃掉的清單：開頁前按下、轉場後放開不能變成新頁上的點擊；1.5.0 輸入矩陣）
var _trans_skip_t := -1.0   # 跳過轉場的那一幀：同一幀的其他按下也吃掉（兩個輸入同時按）

func _trans_gate(ev: InputEvent) -> bool:
	if ev is InputEventJoypadMotion and (ev.axis == JOY_AXIS_RIGHT_X or ev.axis == JOY_AXIS_RIGHT_Y):
		if ev.axis == JOY_AXIS_RIGHT_X:
			_rstick.x = ev.axis_value   # 平常也記（轉場開始時要知道還推著沒）
		else:
			_rstick.y = ev.axis_value
	var sig0 := trans_sig(ev)
	if sig0 != "":
		if ev.pressed:
			_held[sig0] = true
		else:
			_held.erase(sig0)
	var active := ov_trans_k() < 1.0
	if not active and trans_eat.is_empty() and time != _trans_skip_t and not trans_rstick_eat:
		return false
	if ev is InputEventMouseMotion:
		mouse = ev.position
		return active
	if ev is InputEventJoypadMotion and (ev.axis == JOY_AXIS_RIGHT_X or ev.axis == JOY_AXIS_RIGHT_Y):
		var dzr := int(Save.s("deadzone")) / 100.0
		if (active or time == _trans_skip_t) and absf(ev.axis_value) >= dzr:   # 同一幀先按鍵跳過、再推搖桿也鎖（Codex v150 cat01 r3 #1）
			if active:
				_ov_t = time - 1.0
				_trans_skip_t = time
			trans_rstick_eat = true
		if trans_rstick_eat:
			if absf(_rstick.x) < dzr and absf(_rstick.y) < dzr:
				trans_rstick_eat = false   # 兩軸都回中才解鎖
			return true
		return active
	if ev is InputEventJoypadMotion:
		if ev.axis == JOY_AXIS_LEFT_X or ev.axis == JOY_AXIS_LEFT_Y:
			stick[ev.axis] = ev.axis_value   # 狀態照記
			if (active or time == _trans_skip_t) and absf(ev.axis_value) >= int(Save.s("deadzone")) / 100.0:
				_ov_t = time - 1.0       # 推搖桿本身也是跳過（Codex cat08 r5 #1）
				_trans_skip_t = time
				trans_stick_eat = true   # 轉場中收到有效軸輸入當下就鎖（不靠逐幀時轉場還在；同幀再按鍵跳過也鎖著，Codex cat08 r4 #1）
		return active
	var sig := trans_sig(ev)
	if sig == "":
		return active
	if ev is InputEventScreenTouch and not ev.pressed:
		touches.erase(ev.index)   # 吃掉放開也要清手指狀態（不留幽靈手指、長按計時；Codex cat08 r2 #3）
		lp_t = -1.0
	if ev.pressed:
		if active or time == _trans_skip_t:
			if active:
				_ov_t = time - 1.0
				_trans_skip_t = time
			trans_eat[sig] = true
			return true
		return trans_eat.has(sig)   # 同一顆鍵按住的連發（echo）也吃
	if trans_eat.has(sig):
		trans_eat.erase(sig)
		return true
	return active

## 疊層剛換（轉場開始）：取消進行中的長按（不從計時器繞過閘門）；開頁前就推著的搖桿鎖到回中（Codex cat08 r3 #2、#3）
func _trans_begin() -> void:
	if ov_trans_k() >= 1.0:
		return
	lp_t = -1.0
	for k in _held:
		trans_eat[k] = true   # 開頁前就按住的：放開要吃掉（不在新頁上點）
	if absf(_rstick.x) >= int(Save.s("deadzone")) / 100.0 or absf(_rstick.y) >= int(Save.s("deadzone")) / 100.0:
		trans_rstick_eat = true   # 開頁前就推著右搖桿：回中之前不捲新頁
	var dz := int(Save.s("deadzone")) / 100.0
	if absf(float(stick.get(JOY_AXIS_LEFT_X, 0.0))) >= dz or absf(float(stick.get(JOY_AXIS_LEFT_Y, 0.0))) >= dz:
		trans_stick_eat = true

## 手把拔掉：引擎不補放開事件 → 清掉那支手把的跳過身分與搖桿狀態（Codex cat08 r3 #4）
func _trans_joy_changed(device: int, connected: bool) -> void:
	if connected:
		return
	for k in trans_eat.keys():
		if String(k).begins_with("j%d:" % device):
			trans_eat.erase(k)
	for k2 in _held.keys():
		if String(k2).begins_with("j%d:" % device):
			_held.erase(k2)   # 拔掉的手把按住的鈕也清（不然下次轉場會把舊鎖復活，Codex v150 cat01 #2）
	trans_rstick_eat = false
	_rstick = Vector2.ZERO   # 舊值不留（Codex v150 cat01 r2 #2）
	stick[JOY_AXIS_LEFT_X] = 0.0
	stick[JOY_AXIS_LEFT_Y] = 0.0
	trans_stick_eat = false

## 轉場進度（0→1；沒有轉場＝1）。截圖、版面檢查、減少特效、減少動態、簡化介面都沒有轉場。
func ov_trans_k() -> float:
	if overlay == "" or not SLIDE_FROM.has(overlay) or shot_dir != "" or layout_probe or bool(Save.s("reduce_fx")) or bool(Save.s("reduce_motion")) or bool(Save.s("plain_ui")):
		return 1.0
	return clampf((time - _ov_t) / SLIDE_SEC, 0.0, 1.0)

func ov_slide_offset() -> Vector2:
	var k := ov_trans_k()
	if k >= 1.0:
		return Vector2.ZERO
	var e := 1.0 - pow(1.0 - k, 3.0)
	return SLIDE_FROM[overlay] * (1.0 - e)
