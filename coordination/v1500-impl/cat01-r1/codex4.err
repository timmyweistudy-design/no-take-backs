    34	  alive "$r" && kill -KILL -- "-$pg" 2>/dev/null
    35	  ids=$(win_godot_since "$st") || { echo "CHAIN $2 查不到 Windows 程序（查詢失敗），沒有確認退出"; exit 1; }
