    18	  raw=$(printf '%s' "$raw" | tr -d '\r')
    19	  [ $rc -eq 0 ] && printf '%s\n' "$raw" | grep -q '^QUERY_OK$' || return 1
    20	  printf '%s\n' "$raw" | grep -v '^QUERY_OK$' | grep -v '^$' || true
    21	}
    22	case "${1:-}" in
    23	--status)
    24	  r=$(cur "$2"); [ -n "$r" ] && cat "$r/run" || echo "CHAIN 沒有 $2"; exit 0 ;;
    25	--stop)
    26	  # 停止和啟動共用鎖：只停「目前登記的那一輪」，核對 run 身分；刪鎖只刪屬於這一輪的（不會刪到別人剛拿的新鎖；Codex v150 cat01 r3 #3）
    27	  r=$(cur "$2"); [ -n "$r" ] || { echo "CHAIN 沒有 $2"; exit 0; }
