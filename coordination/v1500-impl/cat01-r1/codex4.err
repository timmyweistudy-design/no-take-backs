    37	  sleep 1
    38	  left=$(win_godot_since "$st") || { echo "CHAIN $2 查不到 Windows 程序（查詢失敗），沒有確認退出"; exit 1; }
    39	  if alive "$r" || [ -n "$left" ]; then echo "CHAIN $2 還沒停乾淨（Linux 程序群 $pg、Windows Godot：$left）"; exit 1; fi
    40	  echo "state=stopped" >> "$r/run"
