@@ -60,7 +60,7 @@ bad = [k for k, v in reg.items() if not v.get('entry') or not isinstance(v.get('
 if bad:
     print('LAYOUT FAIL：清冊缺入口或狀態：%s' % bad[:10]); sys.exit(1)
