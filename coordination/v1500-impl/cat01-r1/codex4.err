+	ok(g.touches.is_empty() and g.lp_t < 0.0 and g.trans_eat.is_empty(), "觸控跳過：放開吃掉、手指狀態與長按計時清掉（Codex cat08 r2 #3）", "%s %s %s" % [str(g.touches), str(g.lp_t), str(g.trans_eat)])
 	g._ov_t = g.time
