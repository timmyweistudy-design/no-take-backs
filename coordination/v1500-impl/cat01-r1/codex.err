     1	#!/usr/bin/env bash
     2	# 1.5.0 §12：背景驗收鏈。整條鏈綁 run ID 與提交雜湊、跑在自己的程序群；中止時整條停（含 Windows Godot），確認退出才准開新輪。
     3	# 用法（game/ 下）：
     4	#   tools/run_chain.sh <名稱> '<步驟1>' '<步驟2>' …     # 依序跑，任一步失敗就停；日誌 ../build/tmp/chains/<名稱>/stepN.log
     5	#   tools/run_chain.sh --stop <名稱>                     # 停掉整條鏈
     6	#   tools/run_chain.sh --status <名稱>
     7	set -u
     8	D="../build/tmp/chains"
     9	mkdir -p "$D"
    10	if [ "${1:-}" = "--stop" ]; then
    11	  f="$D/$2.run"; [ -f "$f" ] || { echo "CHAIN 沒有 $2"; exit 0; }
    12	  pg=$(sed -n 's/^pgid=//p' "$f")
    13	  [ -n "$pg" ] && kill -TERM -- "-$pg" 2>/dev/null
    14	  powershell.exe -NoProfile -c "Get-Process Godot* -ErrorAction SilentlyContinue | Stop-Process -Force" >/dev/null 2>&1
    15	  for i in $(seq 1 20); do kill -0 -- "-$pg" 2>/dev/null || break; sleep 0.5; done
    16	  if kill -0 -- "-$pg" 2>/dev/null; then echo "CHAIN $2 還沒停乾淨"; exit 1; fi
    17	  echo "state=stopped" >> "$f"; echo "CHAIN $2 已停"; exit 0
    18	fi
    19	if [ "${1:-}" = "--status" ]; then cat "$D/$2.run" 2>/dev/null || echo "CHAIN 沒有 $2"; exit 0; fi
    20	name="$1"; shift
    21	f="$D/$name.run"
    22	if [ -f "$f" ] && ! grep -q '^state=' "$f"; then
    23	  pg=$(sed -n 's/^pgid=//p' "$f")
    24	  if [ -n "$pg" ] && kill -0 -- "-$pg" 2>/dev/null; then echo "CHAIN $name 還在跑（pgid $pg），先 --stop"; exit 1; fi
    25	fi
    26	mkdir -p "$D/$name"
    27	rid="$(date +%Y%m%d-%H%M%S)-$$"
    28	commit="$(git rev-parse --short HEAD 2>/dev/null)$(git diff --quiet 2>/dev/null || echo +dirty)"
    29	printf 'run=%s\ncommit=%s\nstarted=%s\n' "$rid" "$commit" "$(date '+%F %T')" > "$f"
    30	setsid bash -c '
    31	  f="$1"; dir="$2"; shift 2
    32	  echo "pgid=$(ps -o pgid= $$ | tr -d " ")" >> "$f"
    33	  n=0
    34	  for step in "$@"; do
    35	    n=$((n+1)); echo "step$n=$step" >> "$f"
    36	    bash -c "$step" > "$dir/step$n.log" 2>&1; rc=$?
    37	    echo "step${n}_rc=$rc" >> "$f"
    38	    [ $rc -ne 0 ] && { echo "state=failed@$n" >> "$f"; exit $rc; }
    39	  done
    40	  echo "state=done" >> "$f"' _ "$f" "$D/$name" "$@" &
    41	sleep 1
    42	echo "CHAIN $name 開始（run $rid、$commit）"
     1	#!/usr/bin/env python3
     2	"""1.5.0 §12：固定時鐘美感基線（棋子輪廓對比）。
     3	美感指標只在 LAYOUT_FIXED=1（固定幀時間）下比；一般版面檢查是真實時間，每次跑會浮動，不能比（1.4.0 收尾教訓）。
     4	用法（game/ 下）：
     5	  python3 tools/art_baseline.py save  <版面輸出夾> <基線檔>   # 逐畫面×組記 low_units／units
     6	  python3 tools/art_baseline.py check <版面輸出夾> <基線檔>   # 任一畫面×組 low_units 高於基線＝失敗（exit 1）
     7	  python3 tools/art_baseline.py merge <版面輸出夾> <基線檔>   # 新畫面補進基線（舊畫面不覆蓋）
     8	"""
     9	import json, os, sys, glob
    10	
    11	def read(out_dir):
    12	    r = {}
    13	    for f in sorted(glob.glob(os.path.join(out_dir, '*', 'layout.jsonl'))):
    14	        combo = os.path.basename(os.path.dirname(f))
    15	        for line in open(f, encoding='utf-8'):
    16	            x = json.loads(line)
    17	            a = x.get('art') or {}
    18	            if int(a.get('units', 0)) <= 0:
    19	                continue
    20	            r['%s|%s' % (x['shot'], combo)] = [int(a.get('low_units', 0)), int(a['units'])]
    21	    return r
    22	
    23	def main():
    24	    if len(sys.argv) != 4 or sys.argv[1] not in ('save', 'check', 'merge'):
    25	        print(__doc__); sys.exit(2)
    26	    cmd, out_dir, base = sys.argv[1:]
    27	    cur = read(out_dir)
    28	    if cmd == 'save':
    29	        json.dump(cur, open(base, 'w', encoding='utf-8'), ensure_ascii=False, indent=0, sort_keys=True)
    30	        print('ART 基線寫入 %d 筆（%s）' % (len(cur), base)); return
    31	    old = json.load(open(base, encoding='utf-8')) if os.path.exists(base) else {}
    32	    if cmd == 'merge':
    33	        n = 0
    34	        for k, v in cur.items():
    35	            if k not in old:
    36	                old[k] = v; n += 1
    37	        json.dump(old, open(base, 'w', encoding='utf-8'), ensure_ascii=False, indent=0, sort_keys=True)
    38	        print('ART 基線補進 %d 筆新畫面' % n); return
    39	    worse, new, lo_c, lo_b = [], [], 0, 0
    40	    for k, v in sorted(cur.items()):
    41	        if k not in old:
    42	            new.append(k); continue
    43	        lo_c += v[0]; lo_b += old[k][0]
    44	        if v[0] > old[k][0]:
    45	            worse.append('%s：%d → %d（/%d）' % (k, old[k][0], v[0], v[1]))
    46	    print('ART 固定時鐘棋子低對比 %d（基線 %d）；比基線差 %d 筆、新畫面 %d 筆（沒有基線，不算）' % (lo_c, lo_b, len(worse), len(new)))
    47	    for w in worse[:40]:
    48	        print('  ' + w)
    49	    sys.exit(1 if worse else 0)
    50	
    51	if __name__ == '__main__':
    52	    main()
