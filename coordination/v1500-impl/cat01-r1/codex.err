 			return true
 		return trans_eat.has(sig)   # 同一顆鍵按住的連發（echo）也吃
@@ -1172,6 +1187,8 @@ func _trans_begin() -> void:
 	if ov_trans_k() >= 1.0:
 		return
 	lp_t = -1.0
+	for k in _held:
+		trans_eat[k] = true   # 開頁前就按住的：放開要吃掉（不在新頁上點）
 	var dz := int(Save.s("deadzone")) / 100.0
 	if absf(float(stick.get(JOY_AXIS_LEFT_X, 0.0))) >= dz or absf(float(stick.get(JOY_AXIS_LEFT_Y, 0.0))) >= dz:
 		trans_stick_eat = true
diff --git a/game/scripts/ui/screens/game_v16.gd b/game/scripts/ui/screens/game_v16.gd
index 61a2812..c474935 100644
--- a/game/scripts/ui/screens/game_v16.gd
+++ b/game/scripts/ui/screens/game_v16.gd
@@ -78,6 +78,10 @@ static func _clip_set(txt: String) -> bool:
 func _notification(what: int) -> void:
 	if what == NOTIFICATION_WM_CLOSE_REQUEST:
 		_quit_mark()
+	if what == NOTIFICATION_APPLICATION_FOCUS_OUT or what == NOTIFICATION_WM_WINDOW_FOCUS_OUT:
+		var h = get("_held")
+		if h is Dictionary:
+			(h as Dictionary).clear()   # 1.5.0：失焦時放開事件可能收不到，按住清單清掉（不留卡住的轉場鎖）
 
 func _quit_mark() -> void:
 	Funnel.leave(screen_id())
