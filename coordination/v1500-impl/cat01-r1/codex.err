diff --git a/game/tools/art_baseline.py b/game/tools/art_baseline.py
new file mode 100755
index 0000000..a48993a
--- /dev/null
+++ b/game/tools/art_baseline.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""1.5.0 §12：固定時鐘美感基線（棋子輪廓對比）。
+美感指標只在 LAYOUT_FIXED=1（固定幀時間）下比；一般版面檢查是真實時間，每次跑會浮動，不能比（1.4.0 收尾教訓）。
+用法（game/ 下）：
+  python3 tools/art_baseline.py save  <版面輸出夾> <基線檔>   # 逐畫面×組記 low_units／units
+  python3 tools/art_baseline.py check <版面輸出夾> <基線檔>   # 任一畫面×組 low_units 高於基線＝失敗（exit 1）
+  python3 tools/art_baseline.py merge <版面輸出夾> <基線檔>   # 新畫面補進基線（舊畫面不覆蓋）
+"""
+import json, os, sys, glob
+
+def read(out_dir):
+    r = {}
+    for f in sorted(glob.glob(os.path.join(out_dir, '*', 'layout.jsonl'))):
+        combo = os.path.basename(os.path.dirname(f))
+        for line in open(f, encoding='utf-8'):
+            x = json.loads(line)
+            a = x.get('art') or {}
+            if int(a.get('units', 0)) <= 0:
+                continue
+            r['%s|%s' % (x['shot'], combo)] = [int(a.get('low_units', 0)), int(a['units'])]
+    return r
+
+def main():
+    if len(sys.argv) != 4 or sys.argv[1] not in ('save', 'check', 'merge'):
+        print(__doc__); sys.exit(2)
+    cmd, out_dir, base = sys.argv[1:]
+    cur = read(out_dir)
+    if cmd == 'save':
+        json.dump(cur, open(base, 'w', encoding='utf-8'), ensure_ascii=False, indent=0, sort_keys=True)
+        print('ART 基線寫入 %d 筆（%s）' % (len(cur), base)); return
+    old = json.load(open(base, encoding='utf-8')) if os.path.exists(base) else {}
+    if cmd == 'merge':
+        n = 0
+        for k, v in cur.items():
+            if k not in old:
+                old[k] = v; n += 1
+        json.dump(old, open(base, 'w', encoding='utf-8'), ensure_ascii=False, indent=0, sort_keys=True)
+        print('ART 基線補進 %d 筆新畫面' % n); return
+    worse, new, lo_c, lo_b = [], [], 0, 0
+    for k, v in sorted(cur.items()):
+        if k not in old:
+            new.append(k); continue
+        lo_c += v[0]; lo_b += old[k][0]
+        if v[0] > old[k][0]:
+            worse.append('%s：%d → %d（/%d）' % (k, old[k][0], v[0], v[1]))
+    print('ART 固定時鐘棋子低對比 %d（基線 %d）；比基線差 %d 筆、新畫面 %d 筆（沒有基線，不算）' % (lo_c, lo_b, len(worse), len(new)))
+    for w in worse[:40]:
+        print('  ' + w)
+    sys.exit(1 if worse else 0)
+
+if __name__ == '__main__':
+    main()
diff --git a/game/tools/run_chain.sh b/game/tools/run_chain.sh
new file mode 100755
index 0000000..0b8a8d8
--- /dev/null
+++ b/game/tools/run_chain.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+# 1.5.0 §12：背景驗收鏈。整條鏈綁 run ID 與提交雜湊、跑在自己的程序群；中止時整條停（含 Windows Godot），確認退出才准開新輪。
+# 用法（game/ 下）：
+#   tools/run_chain.sh <名稱> '<步驟1>' '<步驟2>' …     # 依序跑，任一步失敗就停；日誌 ../build/tmp/chains/<名稱>/stepN.log
+#   tools/run_chain.sh --stop <名稱>                     # 停掉整條鏈
+#   tools/run_chain.sh --status <名稱>
+set -u
+D="../build/tmp/chains"
+mkdir -p "$D"
+if [ "${1:-}" = "--stop" ]; then
+  f="$D/$2.run"; [ -f "$f" ] || { echo "CHAIN 沒有 $2"; exit 0; }
+  pg=$(sed -n 's/^pgid=//p' "$f")
+  [ -n "$pg" ] && kill -TERM -- "-$pg" 2>/dev/null
+  powershell.exe -NoProfile -c "Get-Process Godot* -ErrorAction SilentlyContinue | Stop-Process -Force" >/dev/null 2>&1
+  for i in $(seq 1 20); do kill -0 -- "-$pg" 2>/dev/null || break; sleep 0.5; done
+  if kill -0 -- "-$pg" 2>/dev/null; then echo "CHAIN $2 還沒停乾淨"; exit 1; fi
+  echo "state=stopped" >> "$f"; echo "CHAIN $2 已停"; exit 0
+fi
+if [ "${1:-}" = "--status" ]; then cat "$D/$2.run" 2>/dev/null || echo "CHAIN 沒有 $2"; exit 0; fi
+name="$1"; shift
+f="$D/$name.run"
+if [ -f "$f" ] && ! grep -q '^state=' "$f"; then
+  pg=$(sed -n 's/^pgid=//p' "$f")
+  if [ -n "$pg" ] && kill -0 -- "-$pg" 2>/dev/null; then echo "CHAIN $name 還在跑（pgid $pg），先 --stop"; exit 1; fi
+fi
+mkdir -p "$D/$name"
+rid="$(date +%Y%m%d-%H%M%S)-$$"
+commit="$(git rev-parse --short HEAD 2>/dev/null)$(git diff --quiet 2>/dev/null || echo +dirty)"
+printf 'run=%s\ncommit=%s\nstarted=%s\n' "$rid" "$commit" "$(date '+%F %T')" > "$f"
+setsid bash -c '
+  f="$1"; dir="$2"; shift 2
+  echo "pgid=$(ps -o pgid= $$ | tr -d " ")" >> "$f"
+  n=0
+  for step in "$@"; do
+    n=$((n+1)); echo "step$n=$step" >> "$f"
+    bash -c "$step" > "$dir/step$n.log" 2>&1; rc=$?
+    echo "step${n}_rc=$rc" >> "$f"
+    [ $rc -ne 0 ] && { echo "state=failed@$n" >> "$f"; exit $rc; }
+  done
+  echo "state=done" >> "$f"' _ "$f" "$D/$name" "$@" &
+sleep 1
+echo "CHAIN $name 開始（run $rid、$commit）"

