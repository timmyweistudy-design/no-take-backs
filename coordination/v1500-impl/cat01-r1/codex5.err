    10	cd "$(dirname "$0")/.." || exit 2
    11	D="$(cd .. && pwd)/build/tmp/chains"
    12	mkdir -p "$D"
    13	runinfo() { sed -n "s/^$2=//p" "$D/$1/$3/run" 2>/dev/null | head -1; }
    14	alive_pg() { [ -n "$1" ] && kill -0 -- "-$1" 2>/dev/null; }
    15	win_godot_since() {   # 這條鏈開始之後啟動的 Windows Godot（WSL 砍不到 Windows 程序，只能從這邊找）。
    16	  # 查詢失敗＝回傳非零（不能當成「沒有」）：PowerShell 退出碼要是 0、而且輸出 QUERY_OK；「沒有 Godot」不是錯誤
    17	  local raw rc
    18	  raw=$(powershell.exe -NoProfile -c "\$ErrorActionPreference='Stop'; try { \$t=[datetime]::Parse('$1', \$null, [Globalization.DateTimeStyles]::RoundtripKind); Get-Process | Where-Object { \$_.ProcessName -like 'Godot*' -and \$_.StartTime -ge \$t } | ForEach-Object { \$_.Id }; 'QUERY_OK'; exit 0 } catch { 'QUERY_FAIL'; exit 1 }" 2>/dev/null); rc=$?
    19	  raw=$(printf '%s' "$raw" | tr -d '\r')
    20	  [ $rc -eq 0 ] && printf '%s\n' "$raw" | grep -q '^QUERY_OK$' || return 1
    21	  printf '%s\n' "$raw" | grep -v '^QUERY_OK$' | grep -v '^$' || true
    22	}
    23	case "${1:-}" in
    24	--status)
    25	  rid=$(cat "$D/$2.active" 2>/dev/null); last=$(cat "$D/$2.last" 2>/dev/null)
    26	  r=${rid:-$last}; [ -n "$r" ] && cat "$D/$2/$r/run" || echo "CHAIN 沒有 $2"; exit 0 ;;
    27	--stop)
    28	  name="$2"
    29	  exec 9>"$D/$name.mutex"; flock -x 9   # 停止全程持有互斥：啟動與收尾都得等
    30	  rid=$(cat "$D/$name.active" 2>/dev/null)
    31	  [ -n "$rid" ] || { echo "CHAIN $name 沒有在跑"; exit 0; }
    32	  pg=$(runinfo "$name" pgid "$rid"); st=$(runinfo "$name" started_win "$rid")
    33	  [ -n "$pg" ] || { echo "CHAIN $name 紀錄缺程序群（$rid）"; exit 1; }
    34	  kill -TERM -- "-$pg" 2>/dev/null
    35	  for i in $(seq 1 20); do alive_pg "$pg" || break; sleep 0.5; done
    36	  alive_pg "$pg" && kill -KILL -- "-$pg" 2>/dev/null
    37	  ids=$(win_godot_since "$st") || { echo "CHAIN $name 查不到 Windows 程序（查詢失敗），沒有確認退出"; exit 1; }
    38	  for id in $ids; do powershell.exe -NoProfile -c "Stop-Process -Id $id -Force" >/dev/null 2>&1; done
    39	  sleep 1
    40	  left=$(win_godot_since "$st") || { echo "CHAIN $name 查不到 Windows 程序（查詢失敗），沒有確認退出"; exit 1; }
    41	  if alive_pg "$pg" || [ -n "$left" ]; then echo "CHAIN $name 還沒停乾淨（Linux 程序群 $pg、Windows Godot：$left）"; exit 1; fi
    42	  echo "state=stopped" >> "$D/$name/$rid/run"
    43	  echo "$rid" > "$D/$name.last"; rm -f "$D/$name.active"
    44	  echo "CHAIN $name 已停（run $rid）"; exit 0 ;;
    45	esac
    46	name="$1"; shift
    47	[ $# -ge 1 ] || { echo "用法：tools/run_chain.sh <名稱> '<步驟>' …"; exit 2; }
    48	exec 9>"$D/$name.mutex"; flock -x 9   # 啟動登記：看有沒有人在跑→開新輪→寫 active，全部在互斥裡
    49	old=$(cat "$D/$name.active" 2>/dev/null)
    50	if [ -n "$old" ]; then
    51	  opg=$(runinfo "$name" pgid "$old")
    52	  if alive_pg "$opg"; then echo "CHAIN $name 還在跑（run $old），先 --stop"; exit 1; fi
    53	  echo "$old" > "$D/$name.last"; rm -f "$D/$name.active"   # 上一輪異常結束（程序群已不在）
    54	fi
    55	rid="$(date +%Y%m%d-%H%M%S)-$$"
    56	R="$D/$name/$rid"; mkdir -p "$R"
    57	commit="$(git rev-parse --short HEAD 2>/dev/null)$(git diff --quiet 2>/dev/null || echo +dirty)"
    58	stw=$(powershell.exe -NoProfile -c "(Get-Date).ToString('o')" 2>/dev/null | tr -d '\r')   # 精確起點（不倒退、不截斷）
    59	[ -n "$stw" ] || { echo "CHAIN $name 取不到 Windows 時間"; exit 1; }
    60	printf 'run=%s\ncommit=%s\nstarted=%s\nstarted_win=%s\n' "$rid" "$commit" "$(date '+%F %T')" "$stw" > "$R/run"
    61	setsid bash -c '
    62	  R="$1"; D="$2"; name="$3"; rid="$4"; shift 4
    63	  exec 9>&-   # 不繼承啟動者的互斥
    64	  echo "pgid=$(ps -o pgid= $$ | tr -d " ")" >> "$R/run"
    65	  n=0; rc=0
    66	  for step in "$@"; do
    67	    n=$((n+1)); echo "step$n=$step" >> "$R/run"
    68	    bash -c "$step" > "$R/step$n.log" 2>&1; rc=$?
    69	    echo "step${n}_rc=$rc" >> "$R/run"
    70	    [ $rc -ne 0 ] && break
    71	  done
    72	  [ $rc -ne 0 ] && echo "state=failed@$n" >> "$R/run" || echo "state=done" >> "$R/run"
    73	  ( flock -x 8; [ "$(cat "$D/$name.active" 2>/dev/null)" = "$rid" ] && { echo "$rid" > "$D/$name.last"; rm -f "$D/$name.active"; } ) 8>"$D/$name.mutex"' _ "$R" "$D" "$name" "$rid" "$@" 9>&- &
    74	for i in $(seq 1 25); do grep -q '^pgid=' "$R/run" && break; sleep 0.2; done
    75	grep -q '^pgid=' "$R/run" || { echo "CHAIN $name 子程序沒有登記程序群"; exit 1; }
    76	echo "$rid" > "$D/$name.active"   # 子程序已登記程序群之後才算「在跑」，還在互斥裡
    77	echo "CHAIN $name 開始（run $rid、$commit）：$R"

