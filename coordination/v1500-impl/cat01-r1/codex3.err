/bin/bash -lc "bash -c 'eval \""'$(sed -n "14,19p" game/tools/run_chain.sh)"; powershell.exe() { printf "QUERY_OK'"\\n\"; return 1; }; win_godot_since test >/dev/null; printf \"query_failure_return=%s\\n\" \""'$?"'"'" in /mnt/c/Users/timmy/projects/no-take-backs
