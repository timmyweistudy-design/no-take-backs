+				var f3: Array = fx_of.call(g)
+				var rec: bool = f3[0] > f2[0] or absf(float(f3[1]) - float(f2[1])) > 0.001 or f3[2] > f2[2]
+				if not rec:
+					bad.append("%s/%s/%s 之後同一來源再操作沒有效果（卡死）" % [src, tm, cb])
+				g.free()
+	# 4 組 1.4.0 回歸（Codex cat08 抓過的）：兩輸入各跳一頁、別的鍵放開不解鎖、只推搖桿跳過、手把跳過後拔掉
