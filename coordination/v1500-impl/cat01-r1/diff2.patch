+	n += 1
+	if g2.trans_eat.size() != 2:
+		bad.append("回歸 1：兩個輸入各跳一頁沒有都記")
+	g2._input(_im_ev("key2", false))
+	n += 1
+	if g2.trans_eat.size() != 2:
+		bad.append("回歸 2：別的鍵放開解了鎖")
+	g2._input(_im_ev("mouse", false))
+	g2._input(_im_ev("key", false))
