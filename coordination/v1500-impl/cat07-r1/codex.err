diff --git a/game/tests/suites/battle_visual.gd b/game/tests/suites/battle_visual.gd
index fab5e03..fb881a3 100644
--- a/game/tests/suites/battle_visual.gd
+++ b/game/tests/suites/battle_visual.gd
@@ -1034,3 +1034,17 @@ func test_battle_v140() -> void:
 	ok(i_tag >= 0 and i_tag < bvs.find("\"kind\": \"cmdseal\""), "軍令橫幅的隊別標記標在橫幅上（不是後加的朱印；舊橫幅才清得掉）")
 	var bu: String = FileAccess.get_file_as_string("res://scripts/ui/battle/battle_units.gd")
 	ok(bu.find("inner.position.x + 18.0, inner.position.y - 9") >= 0, "地圖名刻在盤框左上角（不被戰報條切到）")
+
+func test_battle_read_v150() -> void:
+	var GS = load("res://scripts/ui/game_screens.gd")
+	ok(GS.is_num_text("12") and GS.is_num_text("-8") and GS.is_num_text("+30") and not GS.is_num_text("擊倒") and not GS.is_num_text("x2") and not GS.is_num_text(""), "純數字判斷（傷害數字不包泡泡；關鍵字照舊）")
+	var alive := [1, 2, 3, 4, 5, 6]
+	var hurt := {2: 9.8, 3: 9.9, 4: 9.95, 5: 9.0}
+	var atk := {6: 9.97}
+	var f: Array = GS.pick_focus(alive, 1, 10.0, hurt, atk)
+	ok(f.size() == 4 and f[0] == 1, "跟拍的那隻永遠是焦點，另外最多 3 隻", str(f))
+	ok(f.slice(1) == [6, 4, 3], "最近交手的先（0.5 秒內；超過的不算）", str(f))
+	ok(not 5 in f, "1 秒前被打的不是焦點")
+	ok(GS.pick_focus(alive, -1, 10.0, {}, {}).is_empty(), "沒人交手、沒跟拍：沒有焦點（不亂畫）")
+	ok(GS.pick_focus([2, 3], 9, 10.0, hurt, {}) == [3, 2], "跟拍的兵倒了：不算進去", str(GS.pick_focus([2, 3], 9, 10.0, hurt, {})))
+	ok(GS.hp_bar_alpha(1, 1, 10.0, {}) == 1.0 and GS.hp_bar_alpha(2, 1, 10.0, {2: 9.5}) == 1.0 and GS.hp_bar_alpha(3, 1, 10.0, {3: 8.0}) == 0.5, "血條：焦點不透明、其他淡一半")

