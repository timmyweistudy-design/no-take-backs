   303	func _add_fx(d: Dictionary) -> void:
   304		if bool(Save.s("reduce_fx")) and d["kind"] in ["slimehop", "pages", "bonesup", "woodwave", "axearc", "healring", "scorch", "inkring", "dust", "puff", "shard", "chips", "tell", "bones", "coins", "ripple", "note", "hex", "aim", "trip", "spore", "wool", "soulrise"]:
   305			return   # 第七輪 K3：簡化特效少掉粒子與裝飾，保留攻擊本身與嘲諷
   306		if speed >= FAST_SPEED and d["kind"] in FAST_SKIP:
   307			return   # V1.0.0 P7：高倍速只略過裝飾碎屑；預警圈（tell）、爆炸、分裂、拍地這類決定戰局的照畫
   308		var pr: int = FX_PRIO.get(d["kind"], 1)
   309		# 同一處同種特效去重（Antigravity S2 #2）：24px 內、0.15 秒內最多 2 個
   310		var dp = d.get("p", d.get("b", null))
   311		if dp != null and not d.has("src"):   # 帶攻擊者的（砍擊、箭）不去重：每一次攻擊都要有演出
   312			var same := 0
   313			for f0 in fx:
   314				if f0["kind"] == d["kind"] and f0["t"] < 0.15:
   315					var fp = f0.get("p", f0.get("b", null))
   316					if fp != null and fp.distance_to(dp) < 24.0:
   317						same += 1
   318			if same >= 2:
   319				fx_deduped += 1
   320				return
   321		var cls: String = FX_CLASS.get(d["kind"], "")
   322		if cls != "":
   323			var same_cls: Array = []
   324			for i0 in fx.size():
   325				if FX_CLASS.get(fx[i0]["kind"], "") == cls:
   326					same_cls.append(i0)
   327			if same_cls.size() >= int(FX_CLASS_CAP[cls]):
   328				fx.remove_at(same_cls[0])   # 1.4.0 §6.1：同類超額，丟最舊的那個（固定順序、可重現）；放在去重之後＝新的確定會收才淘汰（Codex cat05 #2）
   329				fx_dropped += 1
