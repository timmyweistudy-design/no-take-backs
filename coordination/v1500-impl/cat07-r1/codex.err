 				r3.position.y -= 8.0 * slam * slam
 				var dim := _clutch_dim(p3)
 				col.a *= dim
-				if not f.get("plain", false):
+				var numeric := is_num_text(str(f["s"]))
+				if not f.get("plain", false) and not numeric:
 					_bubble(r3, col.a)   # V1.2 C6：漫畫對話泡（羊皮紙色圓角＋墨線＋朝下的尖角），取代黑色膠囊
