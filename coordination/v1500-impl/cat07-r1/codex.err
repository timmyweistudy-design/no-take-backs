@@ -1483,3 +1484,67 @@ func _spring_acc(p: Vector2, type: int, team: int, face: float, scale: float, cr
 	var pts := PackedVector2Array([xf * a0, xf * mid, xf * (a0 + d)])
 	draw_polyline(pts, Color(Art.OUT, alpha), (float(sp[2]) + 2.0) * scale, false)
 	draw_polyline(pts, Color(col, alpha), float(sp[2]) * scale, false)
+
+
+## ── 1.5.0 §7 戰場辨讀：焦點兵 ──
+## 焦點＝跟拍／選中的那隻＋最近 0.5 秒內交手（被打或出手）最多 3 隻（最近的先）。純函式，測試直接呼叫。
+const FOCUS_SEC := 0.5
+const FOCUS_CAP := 3
+static func pick_focus(alive_ids: Array, follow: int, now: float, hurt: Dictionary, atk: Dictionary, cap := FOCUS_CAP) -> Array:
+	var cand: Array = []
+	for id in alive_ids:
+		if id == follow:
+			continue
+		var t := maxf(float(hurt.get(id, -99.0)), float(atk.get(id, -99.0)))
+		if now - t < FOCUS_SEC:
+			cand.append([t, id])
+	cand.sort_custom(func(a, b): return a[0] > b[0] or (a[0] == b[0] and a[1] < b[1]))   # 同一刻用 id 排，結果決定性
+	var out: Array = []
+	if follow >= 0 and follow in alive_ids:
+		out.append(follow)
+	for c in cand:
+		if out.size() >= cap + (1 if follow in out else 0):
+			break
+		out.append(c[1])
+	return out
+
+var _focus_ids: Array = []
+
+## 腳下暈光：淡淡一層象牙白暈（提亮兵四周的地面＝輪廓更清楚；不用深色，深色接觸陰影曾經讓輪廓對比變差）＋1.5px 象牙白外緣。
+## 減少特效：只留外緣。隊色、底座形狀不動。
+func _draw_focus_halo(s) -> void:
+	_focus_ids.clear()
+	if s == null or state != St.BATTLE:
+		return
+	var alive: Array = []
+	var by_id := {}
+	for u in s.units:
+		if u.alive and not u.hidden:
+			alive.append(u.id)
+			by_id[u.id] = u
+	_focus_ids = pick_focus(alive, follow_id, time, hurt_t, atk_t)
+	var plain := bool(Save.s("plain_ui")) or bool(Save.s("reduce_fx"))
+	for id in _focus_ids:
+		var u = by_id[id]
+		var p := _upos(u) + Vector2(0, 2)
+		var rr := 24.0 * HK * hk_of(u)
+		if not plain:
+			var verts := PackedVector2Array([p])
+			var cols := PackedColorArray([Color(1.0, 0.96, 0.86, 0.16)])
+			for k in ELL16.size():
+				verts.append(p + ELL16[k] * rr * 1.25)
+				cols.append(Color(1.0, 0.96, 0.86, 0.0))
+			var idx := PackedInt32Array()
+			for k in ELL16.size():
+				idx.append_array([0, 1 + k, 1 + (k + 1) % ELL16.size()])
+			RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), idx, verts, cols)
+		var ring := PackedVector2Array()
+		for k in ELL16.size() + 1:
+			ring.append(p + ELL16[k % ELL16.size()] * rr)
+		draw_polyline(ring, Color(1.0, 0.96, 0.86, 0.6), 1.5, true)
+
+## 血條透明度：焦點兵（跟拍、0.8 秒內剛被打）不透明，其他淡一半（混戰時血條不疊成一片）
+static func hp_bar_alpha(id: int, follow: int, now: float, hurt: Dictionary) -> float:
+	if id == follow or now - float(hurt.get(id, -99.0)) < 0.8:
+		return 1.0
+	return 0.5
