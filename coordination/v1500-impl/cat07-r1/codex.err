  1513	## 腳下暈光：淡淡一層象牙白暈（提亮兵四周的地面＝輪廓更清楚；不用深色，深色接觸陰影曾經讓輪廓對比變差）＋1.5px 象牙白外緣。
  1514	## 減少特效：只留外緣。隊色、底座形狀不動。
  1515	func _draw_focus_halo(s) -> void:
  1516		_focus_ids.clear()
  1517		if s == null or state != St.BATTLE:
  1518			return
  1519		var alive: Array = []
  1520		var by_id := {}
  1521		for u in s.units:
  1522			if u.alive and not u.hidden:
  1523				alive.append(u.id)
  1524				by_id[u.id] = u
  1525		_focus_ids = pick_focus(alive, follow_id, time, hurt_t, atk_t)
  1526		var plain := bool(Save.s("plain_ui")) or bool(Save.s("reduce_fx"))
  1527		for id in _focus_ids:
  1528			var u = by_id[id]
  1529			var p := _upos(u) + Vector2(0, 2)
  1530			var rr := 24.0 * HK * hk_of(u)
  1531			if not plain:
  1532				var verts := PackedVector2Array([p])
  1533				var cols := PackedColorArray([Color(1.0, 0.96, 0.86, 0.16)])
  1534				for k in ELL16.size():
  1535					verts.append(p + ELL16[k] * rr * 1.25)
  1536					cols.append(Color(1.0, 0.96, 0.86, 0.0))
  1537				var idx := PackedInt32Array()
  1538				for k in ELL16.size():
  1539					idx.append_array([0, 1 + k, 1 + (k + 1) % ELL16.size()])
  1540				RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), idx, verts, cols)
  1541			var ring := PackedVector2Array()
  1542			for k in ELL16.size() + 1:
  1543				ring.append(p + ELL16[k % ELL16.size()] * rr)
  1544			draw_polyline(ring, Color(1.0, 0.96, 0.86, 0.6), 1.5, true)
