   678	func _process_inner(delta: float) -> void:
   679		if shot_dir != "" and bool(get("shot_fixed")):
   680			delta = 1.0 / 60.0   # 1.2.0 §14.6：視覺回歸模式（--shot-fixed）用固定幀時間；一般版面檢查照真實時間（Codex cat01 #6）
   681		_touch_tick(delta)
   682		_pad_clear_tick()
   683		_stick_repeat(delta)
   684		_process_cmds()
   685		time += delta
   686		call("_gif_tick", delta)   # V1.4 #14
   687		if paused and key_t > 0.0:
   688			key_t += delta
   689		if paused and float(last_kill[1]) > 0.0:
   690			last_kill[1] = float(last_kill[1]) + delta   # 暫停時定格與歡呼波浪也凍結   # V1.3 C4：暫停時關鍵時刻的演出凍結（Codex v130-impl2）
   691		SteamApi.run_callbacks()
   692		if toast_t > 0:
   693			toast_t -= delta
   694		# V1.5：手把震動跟著鏡頭震動（強度可調、0 關掉；只在用手把時）
   695		if shake > rumble_seen + 0.05 and pad_mode and int(Save.s("rumble")) > 0:
   696			var rk: float = clampf(shake * 4.0, 0.2, 1.0) * int(Save.s("rumble")) / 100.0
   697			Input.start_joy_vibration(last_joy, 0.3 * rk, 0.6 * rk, 0.18)
   698		rumble_seen = shake
   699		if removed_banner_t > 0.0:
   700			removed_banner_t -= delta
   701		if ach_t > 0:
   702			ach_t -= delta
   703		elif not ach_queue.is_empty():
   704			toast = ach_queue.pop_front()
   705			toast_t = 2.5
   706			ach_t = 2.6
   707		shake = maxf(0.0, shake - delta)
   708		if not freeze_fx:
   709			for f in fx:
   710				f["t"] += delta
   475			gf.close()
