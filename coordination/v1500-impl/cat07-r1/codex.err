  1549			return 1.0
  1550		return 0.5
   110	## 第七輪 M3：時間軸點下去不再卡畫面，分批算。headless 測試直接走 _seek。
   111	var _seek_stop := 0
   112	var _seek_ct := -1
   113	
   114	func _seek_async(target: int) -> void:
   115		if seek_target >= 0:
   116			return
   117		if DisplayServer.get_name() == "headless" or shot_dir != "":
   118			_seek(target)
   119			return
   120		seek_target = target
   121		_seek_begin(target)
   122	
   123	## 這一幀還在算就回傳 true（戰鬥畫面這一幀不動）。
   124	func _seek_pump() -> bool:
   125		if seek_target < 0:
   126			return false
   127		if _seek_tick(10):
   128			seek_target = -1
   129			_seek_finish()
   130		return true
   131	
   132	func _seek_begin(target: int) -> void:
   133		set("dir_hot_until", -1.0)   # 1.4.0：跳轉不帶舊的推近焦點（Codex cat05 #7）
   134		cues.clear()       # 1.3.0 §7.1：跳轉清掉預告（不留舊時間線的未來事件；Codex cat06 #2）
   135		stat_prev.clear()
   136		var armies2: Array = rv_last if play_kind == "review" and not rv_last.is_empty() else last_armies
   137		sim = Sim.new(armies2[0].copy(), armies2[1].copy(), battle_rules)
   138		call("_cmd_setup", sim, play_kind)
   139		ev_count = {}
   140		set("last_blast_tick", -99)
   141		_seek_ct = -1
   142		_seek_deaths = {}
   143		battle_marks.clear()
   144		var dl: int = ViewBuffer.DELAY if (bool(sim.get("cmd_on")) and not bool(sim.get("cmd_scripted"))) else ViewBuffer.DELAY_LONG   # 和 ViewBuffer 的選法一樣
   145		_seek_stop = maxi(0, target - (view.delay if view != null else dl))
   146		_seek_target_now = target
   147	
   148	var _seek_target_now := 0
   149	var _seek_deaths := {}   # V1.5.1 B2：快轉時誰在哪個 tick 倒下（跳轉後重建陣亡小旗）
   150	
   151	## 算到時間用完或到達目標；到達回傳 true。
   152	func _seek_tick(budget_ms: int) -> bool:
   153		var t0 := Time.get_ticks_msec()
   154		while sim.tick < _seek_stop and not sim.finished:
   155			if Time.get_ticks_msec() - t0 >= budget_ms:
   156				return false
   157			sim.step()
   158			for ev in sim.events:   # 快轉時也要累計戰報次數與時間軸標記（Codex S5 #4：共用同一個收集函式）
   159				if ev.has("src"):
   160					var s = sim.unit_by_id(ev["src"])
   161					var key := "%s%d" % [ev["kind"], s.team]
   162					ev_count[key] = int(ev_count.get(key, 0)) + 1
   163					if ev["kind"] == EV.BLAST and not ev.has("dmg"):
   164						ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
   165				_collect_mark(ev, sim, sim.tick)
   166				if ev["kind"] == EV.DEATH:
   167					_seek_deaths[int(ev["id"])] = sim.tick
   168				if ev["kind"] == EV.CMD:
   169					battle_marks.append({"tick": sim.tick, "kind": "cmd", "team": int(ev["team"]), "skill": int(ev["skill"])})   # V1.5.1：快轉也收軍令標記（原本跳轉後會漏）
   170			if _seek_ct < 0 and not sim.finished and clutch_cond(sim):
   171				_seek_ct = sim.tick
   172		return true
   173	
   174	func _seek_finish() -> void:
   175		clock_last = -1   # 1.4.0 §7.2：跳轉後棋鐘不補跳不補響
   176		if sfx != null and sfx.has_method("reseed"):
   177			sfx.reseed(sfx.seed_at(round_no, view.tick if view != null else 0))   # 1.3.0 §10：跳轉後音效變體從同一個狀態開始
   178		call_deferred("_tm_sync")
   179		var target := _seek_target_now
   180		var keep_ct := _seek_ct
   181		var had_clutch := keep_ct >= 0
   182		view = ViewBuffer.new(sim)
   183		prev_pos.clear()
   184		_gait_reset()
   185		for u in view.units:
   186			prev_pos[u.id] = Vector2(u.x, u.y)
   187		fx.clear()
   188		frags.clear()   # 1.2.0 §8.2
   189		dying.clear()
   190		graves.clear()
   191		# V1.5.1 B2：跳轉前 1～4 秒倒下的兵，陣亡小旗照時間補回（倒地 1 秒後插旗、旗子留 3 秒）
   192		for did in _seek_deaths:
   193			var age: float = float(target - int(_seek_deaths[did])) / 20.0
   194			var dv = view.unit_by_id(int(did))
   195			if dv != null and age >= 1.0 and age < 4.0:
   196				graves.append({"pos": _upos(dv), "team": dv.team, "t": age - 1.0})
   197			elif dv != null and age >= 0.0 and age < 1.0:
   198				# 不到一秒前倒下：倒地演出接著播完，跨過 1 秒照常插旗（Codex v151-i2 #1）
   199				dying.append({"pos": _upos(dv), "type": dv.type, "team": dv.team, "face": signf(dv.fx) if dv.fx != 0 else 1.0, "t": age})
   200		atk_hit.clear()
   201		atk_seq.clear()
   202		alt_hit.clear()
   203		proj_tgt.clear()   # V1.5：跳轉不能留舊的飛行目標（Antigravity v150-i1 #1）
   204		atk_t.clear()
   205		hurt_t.clear()
   206		hurt_dir.clear()
   207		brace_t.clear()
   208		accum = 0.0
   209		present_debt = 0.0   # 1.2.0 §9.6：跳轉後不能帶著舊的欠時加速（Codex final-r2 #3）
   210		result_delay = 0.0
   211		clutch_t = 0.0
   212		slow_left = 0.0
   213		final_left = 0.0     # Codex v10-r1 #4：跳回前段不能留著慢動作，再播到末擊要再演
   214		final_used = false
   215		key_used = false
