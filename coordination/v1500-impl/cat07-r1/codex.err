+## 1.5.0 §7：純數字跳字（傷害、可帶正負號與 ×）——不包泡泡
+static func is_num_text(s: String) -> bool:
+	var t := s.strip_edges().trim_prefix("-").trim_prefix("+").trim_prefix("−")
+	if t == "":
+		return false
+	for ch in t:
+		if not ch in "0123456789":
+			return false
+	return true
