  1158	const TOPPLE := {D.CAVALRY: 1.5, D.SWORD: 1.5, D.SHIELD: 1.5, D.DRUMMER: 1.5, D.BERSERKER: -1.5, D.PIKE: -1.5, D.ARCHER: -1.5, D.BOMBER: -1.5, D.MEDIC: -1.5, 18: -1.5}
  1487	
  1488	
  1489	## ── 1.5.0 §7 戰場辨讀：焦點兵 ──
  1490	## 焦點＝跟拍／選中的那隻＋最近 0.5 秒內交手（被打或出手）最多 3 隻（最近的先）。純函式，測試直接呼叫。
  1491	const FOCUS_SEC := 0.5
  1492	const FOCUS_CAP := 3
  1493	static func pick_focus(alive_ids: Array, follow: int, now: float, hurt: Dictionary, atk: Dictionary, cap := FOCUS_CAP) -> Array:
  1494		var cand: Array = []
  1495		for id in alive_ids:
  1496			if id == follow:
  1497				continue
  1498			var t := maxf(float(hurt.get(id, -99.0)), float(atk.get(id, -99.0)))
  1499			if now - t < FOCUS_SEC:
  1500				cand.append([t, id])
  1501		cand.sort_custom(func(a, b): return a[0] > b[0] or (a[0] == b[0] and a[1] < b[1]))   # 同一刻用 id 排，結果決定性
  1502		var out: Array = []
  1503		if follow >= 0 and follow in alive_ids:
  1504			out.append(follow)
  1505		for c in cand:
  1506			if out.size() >= cap + (1 if follow in out else 0):
  1507				break
  1508			out.append(c[1])
  1509		return out
