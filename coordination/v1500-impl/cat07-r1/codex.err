   630	## ── V1.4 #18 觸控：點＝左鍵（引擎把觸控模擬成滑鼠）、長按 0.5 秒＝右鍵（拿掉兵）、雙指捏合＝縮放戰場 ──
   631	const LONG_PRESS := 0.5
   632	var touches := {}            # 手指編號 → 位置
   633	var lp_t := -1.0             # 長按計時（-1＝沒有在算）
   634	var lp_pos := Vector2.ZERO
   635	
   636	func _touch_input(ev: InputEvent) -> void:
   637		if ev is InputEventScreenTouch:
   638			if ev.pressed:
   639				touches[ev.index] = ev.position
   640			else:
   641				touches.erase(ev.index)
   642			lp_t = 0.0 if (ev.pressed and touches.size() == 1 and overlay == "") else -1.0   # 覆蓋層（例如軍令時間軸）不用長按，免得拖曳變右鍵
   643			lp_pos = ev.position
   644			return
   645		if ev is InputEventScreenDrag:
   646			var old: Vector2 = touches.get(ev.index, ev.position)
   647			touches[ev.index] = ev.position
   648			if lp_t >= 0.0 and ev.position.distance_to(lp_pos) > 12.0:
   649				lp_t = -1.0   # 拖動了就不是長按
   650			if touches.size() == 2 and (state == St.BATTLE or state == St.RESULT):
   651				var ks := touches.keys()
   652				var other: Vector2 = touches[ks[0] if ks[1] == ev.index else ks[1]]
   653				var d0: float = old.distance_to(other)
   654				var d1: float = ev.position.distance_to(other)
   655				if d0 > 8.0:
   656					_pinch_by(d1 / d0, (ev.position + other) / 2.0)
   657	
   658	func _pinch_by(f: float, at: Vector2) -> void:
   659		pinch_zoom = clampf(pinch_zoom * f, 1.0, 2.0)
   660		pinch_center = _fld_xf().affine_inverse() * at
   661	
   662	func _touch_tick(delta: float) -> void:
   663		if lp_t < 0.0:
   664			return
   665		lp_t += delta
   666		if lp_t >= float(Save.s("long_press")):
   667			lp_t = -1.0
   668			# 長按：取消左鍵的拖曳，改送一次右鍵（擺陣時拿掉兵；其他畫面右鍵本來就是返回／取消）
   669			drag_new = false
   670			painting = false
   671			drag_from = Vector2i(-1, -1)
   672			if _is_free():
   673				_fp_abort_drag()
   674			_enqueue("mb", {"i": MOUSE_BUTTON_RIGHT, "pressed": true, "pos": lp_pos})
   675			_enqueue("mb", {"i": MOUSE_BUTTON_RIGHT, "pressed": false, "pos": lp_pos})
   676			Input.vibrate_handheld(30)
