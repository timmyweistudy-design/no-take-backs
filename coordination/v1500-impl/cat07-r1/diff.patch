diff --git a/game/scripts/ui/battle/battle_fx.gd b/game/scripts/ui/battle/battle_fx.gd
index 4a50732..64257d5 100644
--- a/game/scripts/ui/battle/battle_fx.gd
+++ b/game/scripts/ui/battle/battle_fx.gd
@@ -890,10 +890,15 @@ func _draw_fx(f: Dictionary) -> void:
 				r3.position.y -= 8.0 * slam * slam
 				var dim := _clutch_dim(p3)
 				col.a *= dim
-				if not f.get("plain", false):
+				var numeric := is_num_text(str(f["s"]))
+				if not f.get("plain", false) and not numeric:
 					_bubble(r3, col.a)   # V1.2 C6：漫畫對話泡（羊皮紙色圓角＋墨線＋朝下的尖角），取代黑色膠囊
 				var sz := int(ts(f["size"]) * (1.0 + float(f.get("pop", 0.0)) * 1.4))
-				if f.get("plain", false):
+				if numeric and not f.get("plain", false):
+					# 1.5.0 §7 戰況字降噪：純數字不包泡泡——奶白偏原色的字＋深褐粗外框（泡泡只留給擊倒、致命等關鍵短標）
+					var fill := col.lerp(Color(1.0, 0.96, 0.88, col.a), 0.55)
+					_text(p3, f["s"], sz, fill, true, true, 0.0, Color(0.24, 0.13, 0.06, col.a))
+				elif f.get("plain", false):
 					_text(p3, f["s"], sz, col, true, true, 0.0, Color(0.05, 0.2, 0.08, col.a))   # 補血綠字加深墨綠描邊
 				else:
 					var ink0 := _ink_mode
@@ -991,3 +996,14 @@ func _draw_owner_end() -> void:
 		draw_line(Vector2(8, -6 + fi * 6), Vector2(14 if sim.winner == 1 else 17, -5 + fi * 5), Color(0.9, 0.74, 0.6), 4.5, true)   # 叩桌時握拳（指頭短）
 	draw_rect(Rect2(Vector2(0, -12), Vector2(5, 7)), Color(0.95, 0.92, 0.82))
 	draw_set_transform_matrix(Transform2D.IDENTITY)
+
+
+## 1.5.0 §7：純數字跳字（傷害、可帶正負號與 ×）——不包泡泡
+static func is_num_text(s: String) -> bool:
+	var t := s.strip_edges().trim_prefix("-").trim_prefix("+").trim_prefix("−")
+	if t == "":
+		return false
+	for ch in t:
+		if not ch in "0123456789":
+			return false
+	return true
diff --git a/game/scripts/ui/battle/battle_units.gd b/game/scripts/ui/battle/battle_units.gd
index 19df634..f08ebad 100644
--- a/game/scripts/ui/battle/battle_units.gd
+++ b/game/scripts/ui/battle/battle_units.gd
@@ -1125,8 +1125,9 @@ func _draw_units_of(s, dim: bool) -> void:
 		if (show_hb and hb != "sel" and hb != "off") or (live and u.id == follow_id and hb != "off"):
 			var w := 28.0
 			var top := p + Vector2(-w / 2, (-66 if u.type == D.CAVALRY else (-76 if u.type == F8.GOLEM or u.type == F8.SPRITE else -58)) * hk_of(u))
-			draw_rect(Rect2(top - Vector2(1, 1), Vector2(w + 2, 6)), Art.OUT)
-			draw_rect(Rect2(top, Vector2(w * u.hp / u.max_hp, 4)), Art.team_color(u.team, cbm()).lightened(0.25))
+			var ha := hp_bar_alpha(u.id, follow_id if live else -1, time, hurt_t) if live else 1.0   # 1.5.0 §7：非焦點兵血條淡一半
+			draw_rect(Rect2(top - Vector2(1, 1), Vector2(w + 2, 6)), Color(Art.OUT, Art.OUT.a * ha))
+			draw_rect(Rect2(top, Vector2(w * u.hp / u.max_hp, 4)), Color(Art.team_color(u.team, cbm()).lightened(0.25), ha))
 			if cbm():
 				# 色盲模式：血條左邊加隊伍形狀（藍＝●、紅＝◆），不只靠顏色（R8）
 				var mk := top + Vector2(-8, 2)   # 8px 標記＋黑邊（第三輪 V5）
@@ -1483,3 +1484,67 @@ func _spring_acc(p: Vector2, type: int, team: int, face: float, scale: float, cr
 	var pts := PackedVector2Array([xf * a0, xf * mid, xf * (a0 + d)])
 	draw_polyline(pts, Color(Art.OUT, alpha), (float(sp[2]) + 2.0) * scale, false)
 	draw_polyline(pts, Color(col, alpha), float(sp[2]) * scale, false)
+
+
+## ── 1.5.0 §7 戰場辨讀：焦點兵 ──
+## 焦點＝跟拍／選中的那隻＋最近 0.5 秒內交手（被打或出手）最多 3 隻（最近的先）。純函式，測試直接呼叫。
+const FOCUS_SEC := 0.5
+const FOCUS_CAP := 3
+static func pick_focus(alive_ids: Array, follow: int, now: float, hurt: Dictionary, atk: Dictionary, cap := FOCUS_CAP) -> Array:
+	var cand: Array = []
+	for id in alive_ids:
+		if id == follow:
+			continue
+		var t := maxf(float(hurt.get(id, -99.0)), float(atk.get(id, -99.0)))
+		if now - t < FOCUS_SEC:
+			cand.append([t, id])
+	cand.sort_custom(func(a, b): return a[0] > b[0] or (a[0] == b[0] and a[1] < b[1]))   # 同一刻用 id 排，結果決定性
+	var out: Array = []
+	if follow >= 0 and follow in alive_ids:
+		out.append(follow)
+	for c in cand:
+		if out.size() >= cap + (1 if follow in out else 0):
+			break
+		out.append(c[1])
+	return out
+
+var _focus_ids: Array = []
+
+## 腳下暈光：淡淡一層象牙白暈（提亮兵四周的地面＝輪廓更清楚；不用深色，深色接觸陰影曾經讓輪廓對比變差）＋1.5px 象牙白外緣。
+## 減少特效：只留外緣。隊色、底座形狀不動。
+func _draw_focus_halo(s) -> void:
+	_focus_ids.clear()
+	if s == null or state != St.BATTLE:
+		return
+	var alive: Array = []
+	var by_id := {}
+	for u in s.units:
+		if u.alive and not u.hidden:
+			alive.append(u.id)
+			by_id[u.id] = u
+	_focus_ids = pick_focus(alive, follow_id, time, hurt_t, atk_t)
+	var plain := bool(Save.s("plain_ui")) or bool(Save.s("reduce_fx"))
+	for id in _focus_ids:
+		var u = by_id[id]
+		var p := _upos(u) + Vector2(0, 2)
+		var rr := 24.0 * HK * hk_of(u)
+		if not plain:
+			var verts := PackedVector2Array([p])
+			var cols := PackedColorArray([Color(1.0, 0.96, 0.86, 0.16)])
+			for k in ELL16.size():
+				verts.append(p + ELL16[k] * rr * 1.25)
+				cols.append(Color(1.0, 0.96, 0.86, 0.0))
+			var idx := PackedInt32Array()
+			for k in ELL16.size():
+				idx.append_array([0, 1 + k, 1 + (k + 1) % ELL16.size()])
+			RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), idx, verts, cols)
+		var ring := PackedVector2Array()
+		for k in ELL16.size() + 1:
+			ring.append(p + ELL16[k % ELL16.size()] * rr)
+		draw_polyline(ring, Color(1.0, 0.96, 0.86, 0.6), 1.5, true)
+
+## 血條透明度：焦點兵（跟拍、0.8 秒內剛被打）不透明，其他淡一半（混戰時血條不疊成一片）
+static func hp_bar_alpha(id: int, follow: int, now: float, hurt: Dictionary) -> float:
+	if id == follow or now - float(hurt.get(id, -99.0)) < 0.8:
+		return 1.0
+	return 0.5
