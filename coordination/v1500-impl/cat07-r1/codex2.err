   652					draw_circle(p2, 1.4, Color(1.0, 0.55 + 0.3 * fposmod(seed, 1.0), 0.15, 0.7 * sin(ph * PI)), true, -1.0, true)
   653				_:
   654					if i % 2 == 0:
   655						var p3 := ORIGIN + Vector2(x + sin(time * 1.3 + seed) * 10.0, ph * fld_size.y)
   656						var rot := time * 2.0 + seed
   657						var d := Vector2(cos(rot), sin(rot)) * 3.0
   658						draw_line(p3 - d, p3 + d, Color(0.55, 0.62, 0.25, 0.5 * sin(ph * PI)), 2.4, true)
