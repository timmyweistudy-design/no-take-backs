  1527		var rr := 24.0 * HK * hk_of(me)
  1528		if not (bool(Save.s("plain_ui")) or bool(Save.s("reduce_fx"))):
  1529			var verts := PackedVector2Array([pm])
  1530			var cols := PackedColorArray([Color(1.0, 0.96, 0.86, 0.18)])
  1531			for k in ELL16.size():
  1532				verts.append(pm + ELL16[k] * rr * 1.3)
  1533				cols.append(Color(1.0, 0.96, 0.86, 0.0))
  1534			var idx := PackedInt32Array()
