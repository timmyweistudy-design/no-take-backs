  1344	# ── 1.4.0 第 5 大類：戰場可讀（方案 §3）──
  1345	## 接觸陰影：每隻兵腳下一圈淡淡的環境光遮蔽（底座壓暗貼地，放到桌上）。畫在單位之前；順便算好這一幀的位置給虛線底座用。
  1346	var _ao_pos: Array = []      # [[單位, 盤面位置], …]（這一幀）
  1347	var _occ_ids := {}           # 被擋住的單位 id（每 6 幀重算一次：O(n²)，切片 B 量測）
  1348	var _occ_frame := -99
  1349	var _occ_key := -1            # 上次重算時的「哪場、第幾 tick 段、幾隻活著」：換場／跳轉／有人倒下就立刻重算（Codex cat05 #6）
  1350	func _draw_contact_ao(s) -> void:
  1351		_ao_pos.clear()
  1352		if s == null or bool(Save.s("plain_ui")):
  1353			return
  1354		# 全部的橢圓組成一個三角形陣列、一次送出（逐隻 draw_colored_polygon 在 48 兵時 p95 +4%，切片 B 量測）
  1355		var verts := PackedVector2Array()
  1356		var idx := PackedInt32Array()
  1357		var n := ELL16.size()
  1358		for u in s.units:
  1359			if not u.alive or u.hidden:
  1360				continue
  1361			var p := _upos(u)
  1362			_ao_pos.append([u, p])
  1363			var c := p + Vector2(2, 3)
  1364			var base := verts.size()
  1365			verts.append(c)
  1366			for k in n:
  1367				verts.append(c + ELL16[k] * (21.0 * HK))
  1368			for k in n:
  1369				idx.append(base)
  1370				idx.append(base + 1 + k)
  1371				idx.append(base + 1 + (k + 1) % n)
  1372		if not idx.is_empty():
  1373			# 中心深、邊緣透明的柔和陰影（硬邊整圈 0.16 會把兵四周的地面壓暗，棋子輪廓對比警告從 5.9% 升到 10%；收尾量測）
  1374			# 1.5.0 §7：密集處依周圍兵數減淡（擠成一團時陰影疊加會把整團壓暗，輪廓對比變差；固定時鐘量測）
  1375			var cols := PackedColorArray()
  1376			cols.resize(verts.size())
  1377			var c_out := Color(DIM_INK, 0.0)
  1378			var r2 := (28.0 * HK) * (28.0 * HK)
  1379			for ui in _ao_pos.size():
  1380				var pu: Vector2 = _ao_pos[ui][1]
  1381				var nb := 0
  1382				for uj in _ao_pos.size():
  1383					if uj != ui and pu.distance_squared_to(_ao_pos[uj][1]) < r2:
  1384						nb += 1
  1385				var b0 := ui * (n + 1)
  1386				cols[b0] = Color(DIM_INK, 0.2 / (1.0 + 0.6 * nb))
  1387				for k in n:
  1388					cols[b0 + 1 + k] = c_out
  1389			RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), idx, verts, cols)
  1390	
  1391	## 被前面的兵擋住的：在最上層補一圈虛線底座（找得到自己的兵；48 兵都能定位）。最多 24 隻。
  1392	func _draw_occluded_bases(s) -> void:
  1393		if s == null or bool(Save.s("plain_ui")) or _ao_pos.is_empty():
  1394			return
  1395		var fr := Engine.get_frames_drawn()
  1396		var key: int = hash([s.get_instance_id(), int(s.tick) / 6, _ao_pos.size()])
  1397		if fr - _occ_frame >= 6 or fr < _occ_frame or key != _occ_key:
  1398			_occ_frame = fr
  1399			_occ_key = key
  1400			_occ_ids.clear()
  1401			var sy: Array = _ao_pos.duplicate()
  1402			sy.sort_custom(func(x, y): return (x[1] as Vector2).y < (y[1] as Vector2).y)   # 依 y 排好：只往後看 48px 內（不是 O(n²) 全掃）
  1403			for i in sy.size():
  1404				var pa: Vector2 = sy[i][1]
  1405				for j in range(i + 1, sy.size()):
  1406					var pb: Vector2 = sy[j][1]
  1407					if pb.y > pa.y + 48.0 * HK:
  1408						break
  1409					if pb.y > pa.y + 2.0 and absf(pb.x - pa.x) < 15.0 * HK:
  1410						_occ_ids[sy[i][0].id] = true
  1411						break
  1412				if _occ_ids.size() >= 24:
  1413					break
  1414		if _occ_ids.is_empty():
  1415			return
  1416		var segs := [PackedVector2Array(), PackedVector2Array()]   # 每隊一次 draw_multiline
  1417		for a in _ao_pos:
  1418			if not _occ_ids.has(a[0].id):
  1419				continue
  1420			if int(a[0].team) != 0 and a[0].id != follow_id:
  1421				continue   # 只畫玩家這邊（藍方）與正在跟拍的那隻：目的是找得到自己的兵；兩隊都畫時密集處整團被虛線蓋住（收尾量測）
  1422			var pa: Vector2 = a[1]
  1423			var tm: int = clampi(int(a[0].team), 0, 1)
  1424			for k in range(0, ELL16.size(), 2):   # 虛線＝每隔一段畫一段
  1425				segs[tm].append(pa + ELL16[k] * (17.0 * HK))
  1426				segs[tm].append(pa + ELL16[(k + 1) % ELL16.size()] * (17.0 * HK))
  1427		for tm in 2:
  1428			if not (segs[tm] as PackedVector2Array).is_empty():
  1429				# 亮隊色 2px（審查時加過 4px 深色襯底：密集混戰裡整團被虛線蓋住、棋子輪廓對比警告翻倍 → 收尾拿掉，只留提亮）
  1430				draw_multiline(segs[tm], Color(Art.team_color(tm, cbm()).lightened(0.25), 0.95), 2.0)
  1431	
  1432	## 單位橢圓（扁 0.42）16 點，接觸陰影與虛線底座共用（不每幀算 sin／cos）
  1433	static var ELL16: PackedVector2Array = _ell16()
  1434	static func _ell16() -> PackedVector2Array:
  1435		var out := PackedVector2Array()
  1436		for k in 16:
  1437			var a := k * TAU / 16.0
  1438			out.append(Vector2(cos(a), sin(a) * 0.42))
  1439		return out
  1440	
  1441	# ── 1.4.0 第 6 大類：角色動作切片 B（方案 §5.2、§5.3）──
  1442	const SQUASH := 0.07    # 前搖整體壓縮
  1443	const STRETCH := 0.05   # 出手拉長
  1444	## 即時配件（只有少數：劍士盔羽、弓箭手披風、騎兵鞍穗）：角度是展示時間、走路相位、前傾、出手進度的純函式
  1445	## （不積分、不存狀態 → 不同幀率同一時刻一樣、跳轉不用重建）；每兵種頻率與相位不同（不會整軍齊震）。
  1446	## [錨點(單位座標), 長度, 粗細, 頻率, 靜止角(弧度, 0＝往下), 顏色鍵]
  1447	const SPRING := {
  1448		0: [Vector2(-2, -45), 9.0, 2.6, 1.0, -2.3, "red"],      # 劍士：盔頂紅羽（往後上翹）
  1485		draw_polyline(pts, Color(Art.OUT, alpha), (float(sp[2]) + 2.0) * scale, false)
  1486		draw_polyline(pts, Color(col, alpha), float(sp[2]) * scale, false)
