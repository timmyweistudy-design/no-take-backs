  1034			if live and not u.hidden and hd == 0:   # 南北走的那隻不補畫（補畫只有側面，會疊出另一個輪廓；Codex cat05 #5）
  1035				xray.append([p, [u.type, u.team, face, walk, at, alpha, lean, crouch, variant], usc])
