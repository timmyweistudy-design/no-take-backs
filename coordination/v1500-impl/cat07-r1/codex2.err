   637	func _draw_ambient() -> void:
   638		if bool(Save.s("reduce_fx")) or bool(Save.s("plain_ui")):
   639			return
   640		var biome := str(MapDefs.MAPS[fld_map]["biome"]) if fld_map < MapDefs.MAPS.size() else "grass"
   641		var n := 14
   642		for i in n:
   643			var seed := float(i) * 12.9898
   644			var ph := fposmod(time * (0.05 + fposmod(seed, 0.04)) + fposmod(seed * 3.7, 1.0), 1.0)
   645			var x := fposmod(seed * 97.3 + sin(time * 0.6 + seed) * 18.0, fld_size.x)
   646			match biome:
   647				"ice":
   648					var p := ORIGIN + Vector2(x + ph * 40.0, ph * fld_size.y)
   649					draw_circle(p, 1.6 + fposmod(seed, 1.2), Color(1, 1, 1, 0.55 * sin(ph * PI)), true, -1.0, true)
   650				"lava":
