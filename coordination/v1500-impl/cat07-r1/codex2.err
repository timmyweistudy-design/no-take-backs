   140	## 模擬往前跑，直到緩衝裡有 DELAY 份還沒播的快照（或模擬結束）。回傳這次新加的快照，給前搖預告用。
   141	func pump(sim) -> Array:
   142		var added: Array = []
   143		while queue.size() < delay and not sim.finished:
   144			sim.step()
   145			var fr := capture(sim)
   146			queue.append(fr)
   147			added.append(fr)
   148		return added
   149	
   150	## 畫面前進一格；沒有可播的就回傳 false。
   151	func advance() -> bool:
   152		if queue.is_empty():
   153			return false
   154		apply(queue.pop_front())
   155		return true
