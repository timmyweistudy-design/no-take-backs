   687			# 展示快照沒有戰力函式（Codex v131-impl1）：用存活比例，而且要對方明顯比較多才算落後
   688			var cnt := [0, 0]
   689			var liv := [0, 0]
   690			for su in s.units:
   691				if su.summon:
   692					continue
   693				cnt[su.team] += 1
   694				if su.alive:
   695					liv[su.team] += 1
   696			for gt in 2:
   697				var mine := float(liv[gt]) / maxf(1.0, cnt[gt])
   698				var theirs := float(liv[1 - gt]) / maxf(1.0, cnt[1 - gt])
   699				grim[gt] = mine < 0.25 and theirs > mine * 2.0
   700		# V1.3 P0-1：這一幀的畫面位置只算一次（排序比較器原本每次比較都重算 _upos）
   701		var pc := {}
