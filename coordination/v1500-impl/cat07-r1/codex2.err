     1	extends RefCounted
     2	## 展示緩衝（第二輪方案 R5、§3）：戰鬥畫面固定比模擬晚 DELAY 個 tick。
     3	## 模擬先跑，每個 tick 存一份「畫面需要的狀態」快照＋事件；畫面依展示時鐘一格一格播。
     4	## 這樣命中事件在畫面上發生前 DELAY 個 tick 就知道了，可以先演前搖；
     5	## 血量、死亡、音效、HUD、跳字全部讀同一個延後的快照，所以一起延後，不會只有動作延後。
     6	## 純演出：模擬本身的計算、結果、指紋完全不受影響。
     7	
     8	const DELAY := 2            # 前搖長度（tick）；也是有手動軍令時的緩衝長度
     9	const DELAY_LONG := 8       # V1.5：沒有手動軍令的對局緩衝 8 tick，讓遠程「出手→飛行→命中」都在命中前演完
    10	var delay := DELAY
    11	
    12	class VUnit:
    13		var hidden := false
    14		var link := -1
    15		var windup := 0
    16		var guard := 0
    17		var summon := false
    18		var id: int
    19		var team: int
    20		var type: int
    21		var x: int
    22		var y: int
    23		var hp: int
    24		var max_hp: int
    25		var alive: bool
    26		var stealth: int
    27		var stun: int
    28		var shield := 0
    29		var haste_t := 0
    30		var fx: int
    31		var fy: int
    32		var mx: int
    33		var my: int
    34		var charge: int
    35		var target: int
    36		var breach: int            # 第四輪：被破陣剩幾 tick
    37		var aura: int              # 第四輪：在鼓手光環內
    38		var bmode: int             # 第四輪：投彈兵模式
    39		var st := 0                # V1.4 #9 貼紙
    40		var ward := false
    41		var boss := false          # V1.4 #12 巨獸與部位
    42		var arm_hp := 0
    43		var plate_hp := 0
    44		var cd := 0                # 1.3.0：暫停資料卡、放大鏡小窗要的冷卻與戰績（原本沒帶，資料卡讀 cd 會出錯；只給畫面，不進雜湊）
    45		var dmg_dealt := 0
    46		var kills := 0
    47	
    48	var units: Array = []          # 跟 sim.units 同順序
    49	var tick := 0
    50	var rally := [false, false]
    51	var frenzy := false
    52	var events: Array = []         # 這一格（畫面上剛發生）的事件
    53	var finished := false          # 畫面已經播到模擬的最後一 tick
    54	var budget := 100
    55	var budgets := [100, 100]      # 第五輪：兩邊預算（讓子時不同；舊判定時兩格都＝藍方預算）
    56	var max_ticks := 1800          # 第五輪：這一局的長度（一局時間可調）
    57	
    58	func budget_of(t: int) -> int:
    59		return int(budgets[t])
    60	var zones: Array = []
    61	var _power := [0, 0]
    62	var _alive := [0, 0]
    63	var _by_id := {}
    64	var queue: Array = []          # 還沒播的快照（模擬已經跑到、畫面還沒到）
    65	var cmd_snap: Array = []       # V1.5.1：[cmd_left, cmd_ready]（畫面這一格當下）
    66	
    67	## 把模擬當下的狀態存成一份快照。
    68	static func capture(sim) -> Dictionary:
    69		var us: Array = []
    70		var ux: Array = []
    71		for u in sim.units:
    72			ux.append([u.cd, u.dmg_dealt, u.kills])
    73			us.append([u.id, u.team, u.type, u.x, u.y, u.hp, u.max_hp, u.alive, u.stealth, u.stun, u.fx, u.fy, u.mx, u.my, u.charge, u.target, u.breach, u.aura, u.bmode, 1 if u.hidden else 0, u.link, u.windup, u.guard, u.summon, u.st, 1 if u.ward else 0, 1 if u.boss else 0, u.arm_hp, u.plate_hp, u.shield, u.haste_t])
    74		var cmd: Array = []
    75		if bool(sim.get("cmd_on")):
    76			cmd = [sim.cmd_left.duplicate(true), sim.cmd_ready.duplicate(true)]   # V1.5.1：軍令欄照畫面時間顯示（長緩衝時不提早跳）
    77		return {"cmd": cmd, "tick": sim.tick, "units": us, "ux": ux, "events": sim.events.duplicate(true), "rally": sim.rally.duplicate(),
    78			"frenzy": sim.frenzy, "finished": sim.finished, "power": [sim.power(0), sim.power(1)],
    79			"alive": [sim.alive_count(0), sim.alive_count(1)], "zones": sim.zones.duplicate()}
    80	
    81	func _init(sim = null) -> void:
    82		if sim != null:
    83			budget = sim.budget
    84			# 手動軍令要即時：維持短緩衝。V1.5.1 B1b：照紀錄施放（殘局第 12 章、軍令局重播）沒有即時輸入，用長緩衝讓遠程完整飛行
    85			delay = DELAY if (bool(sim.get("cmd_on")) and not bool(sim.get("cmd_scripted"))) else DELAY_LONG
    86			budgets = sim.budgets.duplicate()
    87			max_ticks = sim.max_ticks
    88			apply(capture(sim))
    89			events = []
    90	
    91	func apply(fr: Dictionary) -> void:
    92		cmd_snap = fr.get("cmd", [])
    93		var us: Array = fr["units"]
    94		if units.size() != us.size():
    95			units.clear()
    96			_by_id.clear()
    97			for i in us.size():
    98				var v := VUnit.new()
    99				units.append(v)
   100		for i in us.size():
   101			var a: Array = us[i]
   102			var v: VUnit = units[i]
   103			v.id = a[0]; v.team = a[1]; v.type = a[2]; v.x = a[3]; v.y = a[4]; v.hp = a[5]; v.max_hp = a[6]
   104			v.shield = a[a.size() - 2]; v.haste_t = a[a.size() - 1]
   105			v.alive = a[7]; v.stealth = a[8]; v.stun = a[9]; v.fx = a[10]; v.fy = a[11]; v.mx = a[12]; v.my = a[13]
   106			v.charge = a[14]; v.target = a[15]
   107			v.breach = a[16] if a.size() > 16 else 0
   108			v.aura = a[17] if a.size() > 17 else 0
   109			v.bmode = a[18] if a.size() > 18 else 0
   110			v.hidden = a[19] == 1 if a.size() > 19 else false
   111			v.link = a[20] if a.size() > 20 else -1
   112			v.windup = a[21] if a.size() > 21 else 0
   113			v.guard = a[22] if a.size() > 22 else 0
   114			v.summon = a[23] if a.size() > 23 else false
   115			if a.size() > 30:
   116				v.st = a[24]; v.ward = a[25] == 1; v.boss = a[26] == 1; v.arm_hp = a[27]; v.plate_hp = a[28]
   117			_by_id[v.id] = v
   118		var ux: Array = fr.get("ux", [])
   119		for i in mini(ux.size(), units.size()):
   120			var v: VUnit = units[i]
   121			v.cd = ux[i][0]; v.dmg_dealt = ux[i][1]; v.kills = ux[i][2]
   122		tick = fr["tick"]
   123		events = fr["events"]
   124		rally = fr["rally"]
   125		frenzy = fr["frenzy"]
   126		finished = fr["finished"]
   127		_power = fr["power"]
   128		_alive = fr["alive"]
   129		zones = fr.get("zones", [])
