   675	func _draw_units_of(s, dim: bool) -> void:
   676		if s == view:
   677			mag_pose = []   # 1.3.0 §2：這一幀沒畫到被選的那隻（偽裝、潛行）就不沿用上一隻的姿勢（Codex cat06 #3）
   678		var list: Array = []
