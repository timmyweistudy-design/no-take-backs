+## 1.5.0 §7：數字型跳字不包泡泡——只有數字、正負號、×、括號、百分比（含全形）；有字（衝鋒、擊倒…）的照舊泡泡。
+## 合併跳字「×3（24）」也算數字型（Codex v150 cat07 #3）。英文字母 x 不算（避免把詞當數字）。
+static func is_num_text(s: String) -> bool:
+	var has_digit := false
+	for ch in s.strip_edges():
+		if ch in "0123456789０１２３４５６７８９":
+			has_digit = true
+		elif not ch in "+＋-−－×()（）%％ 　":
+			return false
+	return has_digit
