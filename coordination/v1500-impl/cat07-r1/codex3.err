 const ALIASES := {"new": "units"}
 ## V1.1 E2：新測試只要登記在 FILES；ORDER 只保留舊執行順序，沒列到的依 FILES 順序接在後面。
 const ORDER := ["test_cat_pull", "test_modes_v9", "test_flows_v9", "test_v10_fixes", "test_v10_input", "test_v10_feel", "test_v10_demo", "test_unit_brief", "test_no_unlock", "test_cmd_sim", "test_cmd_ui", "test_star_solutions", "test_trial_rules_valid", "test_maps_v9", "test_maps_mirror_v9", "test_gait_v9", "test_gait_driver_v9", "test_army_rules", "test_turn_placement", "test_determinism_and_mirror", "test_termination", "test_traits", "test_rule_fixes", "test_suspense", "test_codes_and_snake", "test_rally", "test_nav_r1", "test_puzzle_solutions", "test_codex", "test_event_routes", "test_ui_consumers", "test_sfx_priority", "test_save_migration", "test_play_effects", "test_input_queue", "test_golden", "test_crowd_readability", "test_replay_tools", "test_counter_lib", "test_seek_clutch", "test_clutch_effects", "test_new_units", "test_roster_ui", "test_rules_v5", "test_sandbox_v5", "test_battle_code_v5", "test_rules_e2e_v5", "test_lobby_reopen_v5", "test_free_v6", "test_free_skip_v6", "test_review_free_v6", "test_to_free_keeps_units_v6", "test_free_review_fixes_v6", "test_save_v7", "test_harness_v7", "test_code_fuzz_v7", "test_keymap_v7", "test_replay_back_v7", "test_steam_v7", "test_fantasy_legacy_v8", "test_fantasy_rules_v8", "test_fantasy_regress_v8", "test_fantasy_mirror_v8", "test_fantasy_codes_v8", "test_fantasy_game_v8", "test_fantasy_codex_text_matches_stats"]
diff --git a/game/tests/suites/battle_visual.gd b/game/tests/suites/battle_visual.gd
index fab5e03..bec6c0d 100644
--- a/game/tests/suites/battle_visual.gd
+++ b/game/tests/suites/battle_visual.gd
  1490	
  1491	
  1492	## ── 1.5.0 §7 戰場辨讀：焦點兵 ──
  1493	## 焦點＝跟拍／選中的那隻＋它此刻的目標（快照裡的 target，逐 tick 決定；暫停、倒帶、跳轉、固定時鐘截圖都一樣）。
  1494	## 回傳 [焦點 id, 目標 id（沒有＝-1）]；跟拍的兵不在場上＝空。純函式，測試直接呼叫。
  1495	## （第 1 輪用「0.5 秒內交手的最多 3 隻」：動畫時鐘做基準，暫停／跳轉會變，而且看不出誰打誰——Codex、Hydrogen v150 cat07）
  1496	static func pick_focus(units: Array, follow: int) -> Array:
  1497		if follow < 0:
  1498			return []
  1499		var me = null
  1500		for u in units:
  1501			if u.id == follow and u.alive and not u.hidden:
  1502				me = u
  1503				break
  1504		if me == null:
  1505			return []
  1506		var tid := -1
  1507		var ti: int = int(me.target)
  1508		if ti >= 0 and ti < units.size():
  1509			var t = units[ti]
  1510			if t.alive and not t.hidden and t.team != me.team:
  1511				tid = t.id
  1512		return [me.id, tid]
  1513	
  1514	var _focus_ids: Array = []
  1515	
  1516	## 跟拍兵腳下：淡象牙白暈＋細白外緣；它的目標：細的朱紅外緣；兩者之間一條淡墨虛線（誰在打誰）。
  1517	## 提亮不壓暗（深色接觸陰影曾經讓輪廓對比變差）。減少特效：不畫暈。
  1518	func _draw_focus_halo(s) -> void:
  1519		_focus_ids.clear()
  1520		if s == null or state != St.BATTLE:
  1521			return
  1522		_focus_ids = pick_focus(s.units, follow_id)
  1523		if _focus_ids.is_empty():
  1524			return
  1525		var by_id := {}
  1526		for u in s.units:
  1527			by_id[u.id] = u
  1528		var me = by_id[_focus_ids[0]]
  1529		var pm := _upos(me) + Vector2(0, 2)
  1530		var rr := 24.0 * HK * hk_of(me)
  1531		if not (bool(Save.s("plain_ui")) or bool(Save.s("reduce_fx"))):
  1532			var verts := PackedVector2Array([pm])
  1533			var cols := PackedColorArray([Color(1.0, 0.96, 0.86, 0.18)])
  1534			for k in ELL16.size():
  1535				verts.append(pm + ELL16[k] * rr * 1.3)
  1536				cols.append(Color(1.0, 0.96, 0.86, 0.0))
  1537			var idx := PackedInt32Array()
  1538			for k in ELL16.size():
  1539				idx.append_array([0, 1 + k, 1 + (k + 1) % ELL16.size()])
  1540			RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), idx, verts, cols)
  1541		if int(_focus_ids[1]) >= 0:
  1542			var tg = by_id[_focus_ids[1]]
  1543			var pt := _upos(tg) + Vector2(0, 2)
  1544			var d := pt - pm
  1545			var ln := d.length()
  1546			if ln > rr * 2.2:
  1547				var dir := d / ln
  1548				var a0 := pm + dir * rr * 1.1
  1549				var a1 := pt - dir * rr * 1.1
  1550				var seg := a1 - a0
  1551				var L0 := seg.length()
  1552				var k2 := 0.0
  1553				while k2 < L0:
  1554					draw_line(a0 + dir * k2, a0 + dir * minf(L0, k2 + 10.0), Color(0.86, 0.26, 0.18, 0.7), 2.5, true)   # 朱紅虛線：草地上也看得到（淡墨在草地上消失）
  1555					k2 += 18.0
  1556	
  1557	## 頭頂記號（最上層）：跟拍兵＝金色倒三角、它的目標＝朱紅倒三角；兩隻貼在一起時也分得出誰是誰
  1558	func _draw_focus_marks(s) -> void:
  1559		if s == null or _focus_ids.is_empty():
  1560			return
  1561		var by_id := {}
  1562		for u in s.units:
  1563			by_id[u.id] = u
  1564		for k in 2:
  1565			var id := int(_focus_ids[k])
  1566			if id < 0 or not by_id.has(id):
  1567				continue
  1568			var u = by_id[id]
  1569			var col := Color(ACCENT, 1.0) if k == 0 else Color(0.86, 0.26, 0.18, 1.0)
  1570			var hy: float = (-84.0 if u.type == D.CAVALRY else -76.0) * hk_of(u)
  1571			var tp := _upos(u) + Vector2(0, hy - 4.0 * absf(sin(time * 3.0)) * (0.0 if bool(Save.s("reduce_motion")) else 1.0))
  1572			var w := 10.0 if k == 0 else 8.0
  1573			var tri := PackedVector2Array([tp + Vector2(-w, -w - 2), tp + Vector2(w, -w - 2), tp + Vector2(0, 2)])
  1574			draw_colored_polygon(tri, col)
  1575			draw_polyline(tri + PackedVector2Array([tri[0]]), Color(0.18, 0.09, 0.04, 0.95), 2.0, true)
  1576	
  1577	## 血條透明度：跟拍的兵與它的目標不透明，其他淡到 45%（逐 tick 決定，不看動畫時鐘；Hydrogen：受傷 0.8 秒內照亮會讓混戰整片都亮）
  1578	## 低血量（≤35%）是要做決定的資訊，照舊不透明。外框另外保持 ≥0.8（固定時鐘量到：外框一起淡，密集混戰的輪廓對比變差）
