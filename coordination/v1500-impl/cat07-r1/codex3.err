   251			dir_manual = true
   252		if best < 0:
   253			zoom_target = 1.0   # 取消跟拍：回到全景（中心由 _battle_process 拉回）
   254	
   255	## 暫停（第七輪 A6）：正式對局也能停下來看；繼續時放掉選取。
   256	func _toggle_pause() -> void:
   257		paused = not paused
   258		if not paused and play_kind == "official":
   259			follow_id = -1
   260	
   261	
   262	## 進重播前存結算畫面（第七輪 A9）。
   263	func _replay_snapshot() -> void:
   264		if play_kind != "official" and not replay_snap.is_empty():
   265			return   # Codex r2：重播完再重播，返回目的地還是最早那個結算
   266		replay_snap = {"sim": sim, "view": view, "report": report, "marks": battle_marks.duplicate(true), "kind": play_kind,
   267			"tab": result_tab, "overlay": "", "ev_count": ev_count.duplicate(), "pt_rated": pt_rated, "pt_call": pt_call_tick}
   268	
   269	## 重播的「返回」：回到進來的地方。只還原畫面，比分、進度、成就、試玩紀錄都不寫。
   270	func _replay_back() -> void:
   271		tm_ghost = null   # V1.4 #1：回到結果頁，原本時間線的淡圈不能留下
   272		call("_pre_drop")
   273		seek_target = -1   # Codex r1：算到一半返回，不能把下一場快轉到舊目標
   274		skip_busy = false
   275		paused = false
   276		follow_id = -1
   277		zoom = 1.0
   278		zoom_target = 1.0
   279		fx.clear()
   280		frags.clear()   # 1.2.0 §8.2
   281		dying.clear()
   282		report_log.clear()
   283		sfx.set_muffled(false)
   284		if watch_mode or replay_snap.is_empty():
   285			call("_go_title")
   286			return
   287		sim = replay_snap["sim"]
   288		view = replay_snap["view"]
   289		report = replay_snap["report"]
   290		battle_marks = replay_snap["marks"]
   291		play_kind = replay_snap["kind"]
   292		result_tab = replay_snap["tab"]
   293		ev_count = replay_snap["ev_count"]   # Codex r1：戰報、評分狀態也要還原，不然同一局能再評一次
   294		pt_rated = replay_snap["pt_rated"]
   295		pt_call_tick = replay_snap["pt_call"]
   296		overlay = replay_snap["overlay"]
   297		result_delay = 0.0
   298		state = St.RESULT
   299		replay_snap = {}
   300	
   301	
   302	## 從關鍵時刻開始重播（第七輪 A7）。
   303	func _replay_from(t: int) -> void:
   304		call("_replay")
   305		_seek_async(t)
   306	
   307	
   308	func _follow_update(delta: float) -> void:
   309		if play_kind == "official":
   310			return
   311		if follow_id < 0 or view == null or state != St.BATTLE:
   312			return
   313		var u = view.unit_by_id(follow_id)
   314		if u == null or not u.alive:
   315			follow_id = -1
   316			return
   317		zoom_target = 1.45
   318		zoom_center = zoom_center.lerp(_upos(u), minf(1.0, delta * 6.0))
   319		zoom = lerpf(zoom, zoom_target, minf(1.0, delta * 4.0))
   320	
