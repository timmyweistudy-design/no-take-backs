   323	func _copy_battle_code() -> void:
   324		var armies2: Array = rv_last if play_kind == "review" and not rv_last.is_empty() else last_armies
   325		DisplayServer.clipboard_set(BattleCode.encode(armies2[0], armies2[1], battle_rules, last_cmds))
   640	func _v16_battle_draw() -> void:
   641		if tv_ids.is_empty() or view == null:
   642			return
   643		for u in view.units:
   644			var k := tv_ids.find(u.id)
   645			if k < 0:
   646				continue
   647			var p := _upos(u)
   648			if u.alive:
   649				_tv_badge(p - Vector2(0, 1.15 * CS), k + 1)
   650				var mlv := mastery_lv(int(u.type)) if u.team == 0 else 0
   651				if mlv >= 3:
   652					_icon("star", p + Vector2(0, 6), 12.0, Color("#ffd166") if mlv >= 5 else Color("#d8dde6"))   # V1.6.1 A1：只有標記的兵在戰場上顯示熟練度（不常駐，不擋戰場）
   653	
   654	## ── #7 操作與無障礙：按住確認、文字放大鏡、軍令點選放置 ──
   655	var hold_t := 0.0
   656	var confirm_ok_r := Rect2()
   657	const HOLD_SEC := 0.6
   658	
   659	func _hold_tick(delta: float) -> void:
   660		if overlay != "confirm" or not bool(Save.s("hold_confirm")):
   661			hold_t = 0.0
   662			return
   663		var down: bool = (Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT) and confirm_ok_r.has_point(mouse)) \
   664			or (_focus == 0 and hold_keys_down(Save.s("keys"), Save.s("pad")))
   665		hold_t = hold_t + delta if down else 0.0
   666		if hold_t >= HOLD_SEC:
   667			hold_t = 0.0
   668			if pad_mode and int(Save.s("rumble")) > 0:
   669				Input.start_joy_vibration(last_joy, 0.2, 0.5 * int(Save.s("rumble")) / 100.0, 0.12)   # 確定的那一下輕震
   670			call("_confirm_go")
   671	
   672	## V1.6.1 F4：按住確認看「改鍵後」的放置／開始鍵，任何一支手把的放置鈕（原本寫死 Enter、Space、0 號手把 A）
   673	static func hold_keys_down(keys, pad) -> bool:
   674		var kt: Dictionary = keys if keys is Dictionary else {}
   675		var pt: Dictionary = pad if pad is Dictionary else {}
   676		for act in ["place", "start"]:
   677			if Input.is_key_pressed(Keymap.key_of(kt, act)):
   678				return true
   679		var pb := int(pt.get("place", JOY_BUTTON_A))
   680		for dev in Input.get_connected_joypads():
   681			if Input.is_joy_button_pressed(dev, pb):
   682				return true
   683		return false
   684	
   685	## 放大鏡：游標指到的介面字，在游標旁邊放大 1.8 倍畫一份（不改版面）
   195		var x := a.intersection(b)
   196		if not x.has_area():
   197			return 0.0
   198		return x.get_area() / maxf(1.0, minf(a.get_area(), b.get_area()))
   199	
   200	
   201	
   202	func _upos(u) -> Vector2:
   203		var cur := Vector2(u.x, u.y)
   204		var a := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
   205		var p: Vector2 = prev_pos.get(u.id, cur).lerp(cur, a)
   206		# 純畫面錯開（手感輪 2）：依編號固定偏移 ±4px，讓疊在一起的兵不會完全重合；戰鬥計算不受影響
   207		var j := Vector2(float((u.id * 37) % 9 - 4), float((u.id * 53) % 7 - 3))
   208		return ORIGIN + p * CS / 1000.0 + j
   209	
   210	
   211	
   212	## 戰場色調：依模式固定（使用者決定：一般晨曦、殘局黃昏、遠征月夜）。
   213	func _tone() -> Color:
   214		if state == St.TITLE:
   215			return Color(1.0, 0.72, 0.45, 0.07)
   216		if rules != null and rules.time_of != 0:
   217			return Color(0.95, 0.42, 0.3, 0.16) if rules.time_of == 1 else Color(0.12, 0.16, 0.42, 0.30)
   218		var mt := _mode_tone()
   219		if mt.a > 0.0:
   220			return mt
