## 1.1.0 A23：V1.6.1 之前存在舊 `ws` 鍵底下的實驗簿方案（認不出是哪一題，不顯示也不刪）：只有存檔裡真的有時才給「匯出」。
func _ws_archive_row() -> Array:
	var nb = Save.data.get("notebook", {})
	if not (nb is Dictionary and nb.has("ws") and nb["ws"] is Array and not (nb["ws"] as Array).is_empty()):
		return []
	return [["set_ws_archive", "@" + L.t("do_copy"), func(d): _ws_archive_export()]]

static func ws_archive_text(data: Dictionary) -> String:
	var nb = data.get("notebook", {})
	return JSON.stringify({"ws_archive": nb.get("ws", []) if nb is Dictionary else [], "note": "V1.6.1 以前的工坊／出題台實驗簿；原鍵與內容照存，未刪除"}, " ")

func _ws_archive_export() -> void:
	var txt := ws_archive_text(Save.data)
	mb.pressed = d["pressed"]
	mb.position = d["pos"]
	mouse = d["pos"]
	var eat_dbl := false
	if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
		eat_dbl = dbl_eat   # 雙擊回全景那次的放開：不論走哪條路都要清掉（Codex cat06 #4）
		dbl_eat = false
	if state == St.BATTLE and overlay == "" and mb.pressed:
		mag_hide = follow_id   # 1.3.0 §2：任何按下都先收起放大鏡（點到兵會在放開時重新選）
		hl_reel.clear()        # 精華三連播放中動了就停在這裡（交還手動）
		if mb.button_index == MOUSE_BUTTON_WHEEL_UP or mb.button_index == MOUSE_BUTTON_WHEEL_DOWN:
			cam_wheel(mb.button_index == MOUSE_BUTTON_WHEEL_UP, mouse)   # 滾輪縮放
			return
		if mb.button_index == MOUSE_BUTTON_LEFT and bool(d.get("dbl", false)) and _field_hit(mouse):
			cam_reset()   # 雙擊盤面回全景
			dbl_eat = true
			return
	if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and bool(call("vol_press", mouse)):
		return   # 1.3.0：在音量木軌上按下＝開始拖
	if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed and bool(call("vol_release")):
		_mb_release_cleanup()
		return   # 拖完放開：存檔，不再觸發數值鈕
	if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
		if _do_click(mouse) > 0:
			_mb_release_cleanup()
			return
	if state == St.PLACE and overlay == "" and (foe_card_r.has_point(mouse) or foe_tag_r.has_point(mouse)):
		if not mb.pressed:
			_mb_release_cleanup()
		return   # 1.5.0 §1.4：敵情翻牌與紙卡擋住底下的部署區（不點穿）
	if state == St.PLACE and overlay == "" and mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and _v16_place_click(mouse):
		if sfx != null:
			sfx.play("place_heavy", 1.0)   # 蓋章聲

var ink_stamped := false

func _do_click(p: Vector2) -> int:
	_toast_dismiss()
	if state == St.RESULT and _ink_active():
		result_t -= INK_DUR   # 1.2.0 §9.4：點任意處跳過宣紙戰報演出
		return 1
	if _btns_gen != _gen:
		return 0
	for i in _btns.size():
		var b: Dictionary = _btns[i]
		if b["r"].has_point(p):
			if b["en"]:
				_focus = i
				if sfx != null:
					sfx.play(str(b.get("snd", "k_click")), 0.7)
				b["cb"].call()
				return 1
			return 0
	return 0


