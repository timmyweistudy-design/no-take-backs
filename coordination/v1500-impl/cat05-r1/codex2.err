## 即時模式按鈕：每幀重新登記，滑鼠或焦點都能按。
## V9 P5 按鈕：圓角木牌、上緣高光、下緣陰影；按下縮一點回彈、懸停亮、焦點金框；主按鈕有流光。
## V1.2.1 F5：彩色小字對深焦茶描邊至少 4.5:1；不夠就一點點提亮（依顏色快取）。
static var _legible_cache := {}
static func _legible(c: Color) -> Color:
	var k := c.to_html()
	if _legible_cache.has(k):
		return _legible_cache[k]
	var out := c
	for i in 12:
		if _wcag(out, INK) >= 5.0:   # 目標 5:1（底色不一定是純描邊色，留餘裕）
			break
		out = out.lightened(0.08)
	_legible_cache[k] = out
	return out

## 對指定底色提亮到 5:1（黑底條上的隊色記號）。
static func _legible_on(c: Color, bg: Color) -> Color:
	var out := c
	for i in 14:
		if _wcag(out, bg) >= 5.0:
			break
		out = out.lightened(0.08)
	return out

static func _wcag(a: Color, b: Color) -> float:
	var f := func(v: float) -> float: return v / 12.92 if v <= 0.04045 else pow((v + 0.055) / 1.055, 2.4)
	var la: float = 0.2126 * f.call(a.r) + 0.7152 * f.call(a.g) + 0.0722 * f.call(a.b)
	var lb: float = 0.2126 * f.call(b.r) + 0.7152 * f.call(b.g) + 0.0722 * f.call(b.b)
	return (maxf(la, lb) + 0.05) / (minf(la, lb) + 0.05)

## V1.2：紙上墨色。灰白字→焦茶墨；亮彩字（金、綠、紅）壓暗成同色系的深色，透明度保留。
static func _ink(c: Color) -> Color:
	var lum := c.get_luminance()
	if lum < 0.45:
		return c
	var a := c.a if c.a < 0.45 else maxf(c.a, 0.85)   # V1.2.1 F5：紙上墨字至少 85%；很淡的裝飾（空星）保持淡
	if c.s < 0.25:
		return Color(INK, a)
	return Color(c.darkened(0.74), a)

func _btn(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
	if layout_probe and get("shot_dir") != "" and (get("shot_state") as Dictionary).has("dis"):
		enabled = false   # V1.2.1：版面檢查的「停用」狀態：全部按鈕畫成停用，檢查停用樣式（手把流程不受影響）
	var idx := _btns.size()
	var hit := r
	if btn_hit_min > r.size.y:
		var dh := (btn_hit_min - r.size.y) * 0.5
		hit = r.grow_individual(0.0, dh, 0.0, dh)
		if layout_probe:
			probe_hits.append(hit)
	_btns.append({"r": hit, "cb": action, "en": enabled, "snd": "k_confirm" if primary else ("k_back" if label == L.t("back") or label == L.t("menu") else "k_click"), "group": btn_group})
	var hover := hit.has_point(mouse) and not pad_mode
	var focus := pad_mode and idx == _focus
	var bg := TH_WOOD_L if not primary else TH_PRIMARY
	if tint.a > 0:
		bg = tint
	if not enabled:
		bg = Color(0.2, 0.17, 0.15)
	elif hover or focus:
		bg = bg.lightened(0.16)
	return out

## ── R14（1.5.0 §1.1 一頁一件事）：畫面登記類別與主動作；可見可點元件不超過該類上限。
## 已改造的類別（R14_ENFORCE）超標＝失敗，除非登記豁免理由；還沒改造的類別先警告。登記了類別卻沒有主動作＝失敗。
const R14_LIMITS := {"title": 9, "lobby": 9, "place": 12, "battle": 5, "replay": 8, "result": 5, "settings": 10, "codex": 12, "profile": 6, "puzzles": 10}
const R14_ENFORCE := ["title", "result", "lobby", "place", "settings"]
static func _r14(out: Dictionary, d: Dictionary) -> void:
	var sc: Dictionary = d.get("screen", {})
	if sc.is_empty():
		return
	var cls := str(sc.get("cls", ""))
	if str(sc.get("main", "")) == "":
		_add(out, "fail", "R14", cls, "畫面登記了類別卻沒有主動作")
	if not R14_LIMITS.has(cls):
		return
	var n := int(d.get("clicks", 0))
	var lim := int(R14_LIMITS[cls])
	if n <= lim:
		return
	if str(sc.get("skip", "")) != "":
		var key := "_ex_R14:" + cls
		if not out.has(key):
			out[key] = true
			out["exempt"].append({"rule": "R14", "id": cls, "why": str(sc["skip"])})
		return
	_add(out, "fail" if cls in R14_ENFORCE else "warn", "R14", cls, "可見可點元件 %d 個，超過「%s」類上限 %d（收進「更多」或拆頁）" % [n, cls, lim])


static func _contents(texts: Array, btns: Array) -> Array:
	var cs: Array = []
	for t in texts:
		cs.append({"r": t.get("gr", t["r"]), "s": t["s"], "kind": "text"})
	for b in btns:
		cs.append({"r": b, "s": "按鈕%s" % str(b), "kind": "btn"})
	return cs


