diff --git a/game/tests/suites/ui.gd b/game/tests/suites/ui.gd
index 4bf0a1f..5e9f573 100644
--- a/game/tests/suites/ui.gd
+++ b/game/tests/suites/ui.gd
@@ -2386,3 +2386,43 @@ func test_quick_rematch_v150() -> void:
 	g.free()
 	var gm: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_menus.gd")
 	ok(gm.find("if ek == \"menu_vs_ai\" and call(\"quick_rematch_ok\"):") >= 0, "最近玩的：對 AI 快速對戰走兩步開戰")
+
+
+## 1.5.0 第 3 批：大廳三步頁
+func test_lobby_steps_v150() -> void:
+	var GS = load("res://scripts/ui/game_screens.gd")
+	ok(GS.LB_STEP_ROWS.size() == 3 and "opp" in GS.LB_STEP_ROWS[0] and "map" in GS.LB_STEP_ROWS[1] and "rules" in GS.LB_STEP_ROWS[2], "三步：對手／地圖（含大小）／開戰（卡池＋規則）")
+	var seen := {}
+	for rows in GS.LB_STEP_ROWS:
+		for r0 in rows:
+			ok(not seen.has(r0), "每一列只在一步出現（%s）" % r0)
+			seen[r0] = true
+	ok(seen.size() == 5, "五列都有地方放（地圖、大小、卡池、對手、規則）")
+	var g = GS.new()
+	g.lobby_step = 0
+	ok(g._lb_show("opp") and not g._lb_show("map"), "第一步只放對手")
+	g.lobby_step = 2
+	ok(g._lb_show("rules") and g._lb_show("cards") and not g._lb_show("opp"), "第三步放卡池與規則")
+	g.btn_group = ""
+	g._btns.clear()
+	for k in 3:
+		g._btns.append({"r": Rect2(), "cb": func(): pass, "en": true, "group": "st_x"})
+	g._btns.append({"r": Rect2(), "cb": func(): pass, "en": true, "group": ""})
+	ok(g.click_count() == 2, "同一組按鈕（步進器、分頁列）算一個控制")
+	g.free()
+	var g2 = GS.new()
+	g2.overlay = "lobby"
+	g2.lobby_open = false
+	g2.lobby_menu = false
+	g2.lobby_step = 0
+	g2._key(KEY_E)
+	ok(g2.lobby_step == 1 and g2._lb_focus_main, "大廳 RB（E）＝下一步，焦點交給主鈕", "step=%d state=%d" % [g2.lobby_step, g2.state])
+	g2._key(KEY_Q)
+	ok(g2.lobby_step == 0, "大廳 LB（Q）＝上一步")
+	g2._key(KEY_TAB)
+	ok(g2.lobby_open, "大廳 Y（Tab）＝打開進階折頁")
+	g2.free()
+	var lv: String = FileAccess.get_file_as_string("res://scripts/ui/lobby_view.gd")
+	ok(lv.find("lobby_step = 2 if code != \"\" else 0") >= 0, "有上次設定時直接打開在第三步")
+	var LR = load("res://scripts/ui/layout_rules.gd")
+	ok("lobby" in LR.R14_ENFORCE, "大廳是已改造類別（R14 超標失敗）")
diff --git a/game/tools/dev_main.gd b/game/tools/dev_main.gd
index 3f880c2..ac1628a 100644
--- a/game/tools/dev_main.gd
+++ b/game/tools/dev_main.gd
@@ -1028,7 +1028,13 @@ func _shots_v4() -> void:
 	_go_title()
 	_open_lobby("ai")
 	mouse = Vector2(-100, -100)
+	lobby_step = 2   # 1.5.0 §1.2：22_lobby＝第三步「開戰」（有上次設定時打開就在這裡）
 	await _snap("22_lobby.png")
+	lobby_step = 0
+	await _snap("v150_22a_lobby_step1.png")   # 第一步：對手
+	lobby_step = 1
+	await _snap("v150_22b_lobby_step2.png")   # 第二步：地圖
+	lobby_step = 2
 	# V1.5.2 空／滿資料：「我的預設」下拉 0 筆、10 筆（上限）
 	var rp_keep = Save.data.get("rule_presets", [])
 	Save.data["rule_presets"] = []
@@ -1216,6 +1222,7 @@ func _shots_v9() -> void:
 	_lobby_pick("standard")
 	lobby_r.map_id = 1
 	lobby_r.ai_style = 1
+	lobby_step = 1   # 1.5.0：地圖在第二步
 	for k1 in 12:
 		await get_tree().process_frame
 	await _snap("57_lobby_map.png")
@@ -1766,6 +1773,29 @@ func _pad_walk() -> void:
 	await _pw_pick(0, "標題→對戰")
 	await _pw_pick(1, "對戰→對 AI 大廳")
 	await _pw_cycle("大廳")
+	# 1.5.0 §1.2 大廳三步：RB 下一步、LB 上一步、Y 進階折頁；換步後焦點在主鈕（Codex v150 cat03 #5）
+	_go_title()
+	_open_lobby("ai")   # 上面巡過每顆鈕之後畫面不在大廳了：重新打開
+	lobby_step = 0
+	lobby_open = false
+	lobby_menu = false
+	await _pw_frames(3)
+	_ov_t = time - 1.0   # 等疊層開始畫、轉場直接到終態（第一下不要被轉場吃掉）
+	for st in [1, 2]:
+		await _pw_btn(JOY_BUTTON_RIGHT_SHOULDER)
+		await _pw_frames(3)
+		_pw_check(lobby_step == st, "大廳 RB：應該到第 %d 步，現在 %d（overlay=%s menu=%s open=%s state=%d cmds=%d）" % [st + 1, lobby_step + 1, overlay, str(lobby_menu), str(lobby_open), state, _cmds.size()])
+		_pw_check(_focus >= 0 and _focus < _btns.size() and _btns[_focus]["r"].position.x >= 960.0, "大廳換步後焦點不在主鈕（第 %d 步）" % [st + 1])
+		await _pw_cycle("大廳第 %d 步" % [st + 1])
+	await _pw_btn(JOY_BUTTON_LEFT_SHOULDER)
+	await _pw_frames(3)
+	_pw_check(lobby_step == 1, "大廳 LB：應該回第 2 步")
+	await _pw_btn(JOY_BUTTON_Y)
+	await _pw_frames(3)
+	_pw_check(lobby_open, "大廳 Y：應該打開進階折頁")
+	await _pw_btn(JOY_BUTTON_Y)
+	await _pw_frames(3)
