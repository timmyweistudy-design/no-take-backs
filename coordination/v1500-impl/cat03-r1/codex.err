  1029			if int(ms["unused"]) > 0 and lobby_r.validate().is_empty():
  1030				var who := (L.t("blue") if tm == 0 else L.t("red")) + "：" if two else ""
  1031				var line := "⚠ " + who + L.t("lb_unused", [ms["units"], ms["spend"], ms["unused"]])
  1032				_text(Vector2(R.position.x, y), line, tz("S"), Color("#ffd166"), false, false, R.size.x)
  1033				y += text_h(line, tz("S"), R.size.x) + 4
  1034		var df: Array = lobby_r.diff(_lobby_std())
  1035		if not df.is_empty() and y + tz("S") * 1.4 <= R.end.y:
  1036			_text(Vector2(R.position.x, y), L.t("lb_diff_n", [df.size()]), tz("S"), TXT_DIM, false, true, R.size.x)
  1037			y += tz("S") * 1.4
  1038			var fs := tz("S")
  1039			var left := R.end.y - y - tz("S") * 0.6   # 留一點邊，最後一行不碰到下面的重置鈕
  1040			var list_h := 0.0
  1041			for d in df:
  1042				list_h += text_h("・" + _diff_text(d), fs, R.size.x - 10)
  1043			if list_h <= left:
  1044				for d in df:
