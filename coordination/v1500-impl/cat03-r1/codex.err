     1	extends "res://scripts/ui/unit_brief.gd"
     2	## 規則大廳（第五輪 §3.5、§3.6）。兩段式：
     3	##   精簡模式：預設卡片＋規則摘要＋（AI 難度／落子方式）＋開戰。新手兩秒開戰。
     4	##   自訂模式：按「自訂細項」展開分頁（軍隊、卡池、對局、AI、沙盒）＋右側說明欄（白話說明、和標準的差異、重置）。
     5	## 改的是 lobby_r；按開戰才複製一份凍結成 rules（這個系列不再變）。
     6	
     7	
     8	var lobby_kind := "ai"
     9	var lobby_r = null
    10	var lobby_open := false        # 自訂細項展開
    11	var lobby_tab := 0             # 0 軍隊 1 卡池 2 對局 3 AI 4 沙盒
    12	var lobby_item := ""           # 說明欄目前說明的項目
    13	var lobby_menu := false        # 「我的預設」下拉
    14	var lobby_pool_team := 0       # 第八輪：兩邊名單不同時正在看哪一邊
    15	var lobby_filter := 0          # V9 卡池篩選：0 全部、1 近戰、2 遠程、3 支援、4 奇襲
    16	var lobby_sb_unit := 0         # 沙盒分頁正在調的兵種
    17	
    18	const LOBBY_TABS := ["lb_tab_army", "lb_tab_deploy", "lb_tab_pool", "lb_tab_match", "lb_tab_ai", "lb_tab_lab", "lb_tab_cmd", "lb_tab_ext"]   # 1.2.0 第 11 大類：新技能（實驗）
    19	
    20	func _lobby_unlocked() -> int:
    21		return RS.mask(_demo())
    22	
    23	func _lobby_std():
    24		return Presets.make("standard", lobby_kind, _lobby_unlocked())
    25	
    26	## 打開大廳：沿用上次在這個模式用的規則（存檔裡的規則代碼）；沒有或不合法就用標準。
    27	func _open_lobby(kind: String) -> void:
    28		lobby_kind = kind
    29		var code := str(Save.data.get("last_rules", {}).get(kind, ""))
    30		var r = null
    31		if code != "":
    32			var d: Dictionary = RuleSet.from_code(code)
    33			if d["ok"]:
    34				r = d["rules"]
    35				r.preset = str(Save.data.get("last_rules", {}).get(kind + "_preset", "custom"))
    36				if r.preset == "standard":
    37					r.pool = Presets.make("standard", kind, _lobby_unlocked()).pool.duplicate()   # 舊存檔的標準可能只存到解鎖的幾種
    38				var ex = Save.data.get("last_rules", {}).get(kind + "_extra", [])
    39				if ex is Array and ex.size() >= 3:
    40					if ex.size() >= 4:
    41						r.time_of = clampi(int(ex[3]), 0, 2)
    42					r.ai_style = clampi(int(ex[0]), 0, RuleSet.AI_STYLES - 1)
    43					r.map_mode = clampi(int(ex[1]), 0, 2)
    44					r.bans = clampi(int(ex[2]), 0, 2)
    45		if r == null:
    46			r = Presets.make("standard", kind, _lobby_unlocked())
    47			# 第四輪的舊設定當作第一次打開大廳的初始值（Codex 第一輪）
    48			if str(Save.s("roster")) == "classic":
    49				r.pool = [31, 31]
    50			if kind == "duel":
    51				r.place_rule = str(Save.s("duel_rule")) if str(Save.s("duel_rule")) in RuleSet.PLACE_RULES else "snake5"
    52		lobby_r = r
    53		# 存過的規則照原樣保留（Codex 實作第 3 輪：重開雙人大廳不能把兩邊不同的卡池改成一樣）；含未解鎖兵由開戰鈕擋
    54		lobby_open = false
    55		lobby_menu = false
    56		lobby_item = ""
    57		lobby_tab = 0
    58		lobby_step = 2 if code != "" else 0   # 1.5.0：有上次設定＝直接到「確認」（遠征牌→快速對戰→開戰）
    59		_open("lobby")
    60	
    61	## 1.5.0 §1.1 兩步開戰：「最近玩的」點對 AI 快速對戰時，有上次的大廳設定就直接進擺陣、帶上次陣型
    62	## （主畫面「最近玩的」→ 擺陣「開戰」＝2 次點擊）；沒有上次設定、或上次設定現在不能開（未解鎖、試玩版）就照舊進大廳。
    63	func quick_rematch_ok() -> bool:
    64		# 上次規則要讀得回來、上次陣型要有——任一不行就照舊進大廳（不悄悄換成標準規則；Codex v150 cat02 #4）
    65		var code := str(Save.data.get("last_rules", {}).get("ai", ""))
    66		if code == "" or str(Save.data.get("last_form", "")) == "":
    67			return false
    68		return bool(RuleSet.from_code(code)["ok"])
    69	
    70	func _quick_rematch() -> void:
    71		_open_lobby("ai")
    72		if not quick_rematch_ok() or _lobby_block() != "" or lobby_r.to_code() != str(Save.data.get("last_rules", {}).get("ai", "")):
    73			return   # 停在大廳（照舊）：規則讀回來不一樣＝有東西被換掉，讓玩家看一眼
    74		_lobby_start()
    75		if state == St.PLACE and armies.size() > 0 and armies[0].units.is_empty():
    76			call("_deploy_tool", "last")   # 帶上次陣型（不合這次規則的照 _load_checked 擋、提示，留在擺陣自己調）
    77	
    78	func _lobby_clamp() -> void:
    79		Presets.clamp_pool(lobby_r, lobby_kind, _lobby_unlocked(), _demo())
    80	
    81	func _lobby_pick(id: String) -> void:
    82		if id == "fantasy" and not RuleSet.has_new(Presets.selectable(lobby_kind, _lobby_unlocked(), _demo())):
    83			_toast(L.t("lb_fantasy_locked"), true)   # 第八輪：第 14 場才有第一種奇幻軍
    84			return
    85		var keep_level: int = lobby_r.ai_level
    86		var keep_place: String = lobby_r.place_rule
    87		var keep_map: Array = [lobby_r.map_id, lobby_r.map_size, lobby_r.ai_style, lobby_r.map_mode]
    88		lobby_r = Presets.make(id, lobby_kind, Presets.selectable(lobby_kind, _lobby_unlocked(), _demo()))
    89		lobby_r.ai_level = keep_level
    90		lobby_r.ai_style = keep_map[2]
    91		if lobby_r.deploy == "free":
    92			lobby_r.map_id = keep_map[0]    # 換玩法不動已經選好的地圖
    93			lobby_r.map_mode = keep_map[3]
    94		if lobby_kind == "duel" and id != "standard" and id != "classic5":
    95			lobby_r.place_rule = keep_place
    96		_lobby_clamp()
    97		lobby_menu = false
    98	
    99	## 規則有改動就把預設名稱改成「自訂」（卡片上不再亮）。
   100	func _lobby_touch() -> void:
   101		if lobby_r.preset in Presets.IDS:
   102			var p = Presets.make(lobby_r.preset, lobby_kind, _lobby_unlocked())
   103			p.ai_level = lobby_r.ai_level
   104			p.map_id = lobby_r.map_id   # V1.6.1 B1：地圖是另外選的（不屬於玩法預設），比對前帶過去，預設名稱不會因為換地圖變「自訂」
   105			p.map_size = lobby_r.map_size
   106			p.vents = lobby_r.vents
   107			if not p.equals(lobby_r):
   108				lobby_r.preset = "custom"
   109	
   110	## 卡池裡還沒解鎖（或試玩版不能用）的兵；有的話不能開戰（Codex 實作第 1 輪：匯入的規則照原樣保留，只是不能開戰）。
   111	func _lobby_locked_units() -> Array:
   112		var sel := Presets.selectable(lobby_kind, _lobby_unlocked(), _demo())
   113		var out: Array = []
   114		for tm in 2:
   115			for t in D.total():
   116				if RuleSet.has(lobby_r.pool_of(tm), t) and not RuleSet.has(sel, t) and not t in out:
   117					out.append(t)
   118		return out
   119	
   120	func _lobby_block() -> String:
   121		var bad: Array = lobby_r.validate()
   122		if not bad.is_empty():
   123			return L.t(bad[0])
   124		if _demo() and (not call("_demo_ok", lobby_r) or lobby_r.ai_level > 1):
   125			return L.t("demo_locked")     # 第十輪 R1：貼上的規則、舊的上次設定都走這裡
   126		# 第六輪（Codex 實作第 1 輪 #4）：明牌全場只給對 AI、輪流全場只給雙人（貼上的規則代碼也要擋）
   127		if (lobby_r.fullfield == RuleSet.FULL_DUEL and lobby_kind != "duel") or (lobby_r.fullfield == RuleSet.FULL_AI and lobby_kind != "ai"):
   128			return L.t("rr_full_kind")
   129		var lk := _lobby_locked_units()
   130		if not lk.is_empty():
   131			var names: Array = []
   132			for t in lk:
   133				names.append(L.t("unit_%d" % t))
   134			return L.t("lb_has_locked", ["、".join(names)])
   135		return ""
   136	
   137	func _lobby_start() -> void:
   138		var why := _lobby_block()
   139		if why == "":
   140			Save.data["lobby_stamps"] = mini(99, int(Save.data.get("lobby_stamps", 0)) + 1)   # 1.4.0 §1.1 手帳上的印跡
   141			if sfx != null:
   142				sfx.play_pitched("place_heavy", 0.5, 0.8)   # 蓋印的悶響
   143		if why != "":
   144			_toast(why, true)
   145			return
   146		var lr: Dictionary = Save.data.get("last_rules", {})
   147		lr[lobby_kind] = lobby_r.to_code()
   148		lr[lobby_kind + "_preset"] = lobby_r.preset
   149		lr[lobby_kind + "_extra"] = [lobby_r.ai_style, lobby_r.map_mode, lobby_r.bans, lobby_r.time_of]   # 系列選項不進規則碼，另外記（Codex #8）
   150		Save.data["last_rules"] = lr
   151		Save.save_data()
   152		rules = lobby_r.copy()
   153		set("challenge_army", null)
   154		if lobby_kind == "duel" and rules.bans > 0:
   155			call("_begin_bans", rules.bans)
   156			return
   157		call("_start_mode", Mode.VS_AI if lobby_kind == "ai" else Mode.DUEL)
   158	
   159	func _lobby_copy_code() -> void:
   160		DisplayServer.clipboard_set(lobby_r.to_code())
   161		_toast(L.t("lb_code_copied"))
   162	
   163	func _lobby_paste_code(text := "") -> void:
   164		var from_clip := text == ""
   165		var d: Dictionary = RuleSet.from_code(DisplayServer.clipboard_get() if from_clip else text)
   166		if not d["ok"]:
   167			if from_clip and _ask_code(L.t("lb_paste"), _lobby_paste_code):
   168				return
   169			_toast(L.t(d["why"]) if d["why"].begins_with("rr_") else L.t("lb_code_bad"), true)
   170			return
   171		if _demo() and not call("_demo_ok", d["rules"]):
   172			_toast(L.t("bc_demo_locked"), true)
   173			return
   174		lobby_r = d["rules"]
   175		if not _lobby_locked_units().is_empty():
   176			_toast(_lobby_block(), true)   # 照原樣保留，開戰鈕會灰掉並寫原因
   177		else:
   178			_toast(L.t("lb_code_loaded"))
   179	
   180	func _lobby_save_preset() -> void:
   181		var ps: Array = Save.data.get("rule_presets", [])
   182		if ps.size() >= Save.MAX_PRESETS:
   183			_toast(L.t("lb_full", [Save.MAX_PRESETS]), true)   # V1.5：滿了不偷偷蓋掉最舊的，請玩家先刪
   184			lobby_menu = true
   185			return
   186		var used := {}
   187		for e in ps:
   188			used[str(e["name"])] = true
   189		var k := 1
   190		while used.has(L.t("lb_my_n", [k])):
   191			k += 1   # 刪過中間那格也不會撞名
   192		var nm := L.t("lb_my_n", [k])
   193		ps.append({"name": nm, "code": lobby_r.to_code()})
   194		Save.data["rule_presets"] = ps
   195		Save.save_data()
   196		_toast(L.t("lb_saved", [nm]))
   197	
   198	func _lobby_load_preset(i: int) -> void:
   199		var ps: Array = Save.data.get("rule_presets", [])
   200		if i >= ps.size():
   201			return
   202		var d: Dictionary = RuleSet.from_code(str(ps[i]["code"]))
   203		lobby_menu = false
   204		if not d["ok"]:
   205			_toast(L.t("lb_code_bad"), true)
   206			return
   207		lobby_r = d["rules"]
   208		lobby_r.preset = "custom"
   209		# 照原樣保留（Codex 實作第 2 輪）：含未解鎖的兵就由開戰鈕灰掉＋原因處理，不偷偷改規則
   210	
   211	func _lobby_delete_preset(i: int) -> void:
   212		var ps: Array = Save.data.get("rule_presets", [])
   213		if i < ps.size():
   214			ps.remove_at(i)
   215			Save.data["rule_presets"] = ps
   216			Save.save_data()
   217	
   218	# ───────── 數值調整 ─────────
   219	static func _step_in(v: int, opts: Array, d: int) -> int:
   220		var i := opts.find(v)
   430						r.place_rule = "snake5"
   431			"ai_pool_same":
   432				r.ai_pool_same = not r.ai_pool_same
   433				if not r.ai_pool_same:
   434					r.pool[1] = r.pool[0]
   435		_lobby_touch()
   436	
   437	func _lobby_toggle_unit(team: int, t: int) -> void:
   438		lobby_item = "pool"
   439		lobby_brief = t      # 觸控沒有懸停：點一下也會講這隻
   440		var sel := Presets.selectable(lobby_kind, _lobby_unlocked(), _demo())
   441		if not RuleSet.has(sel, t):
   442			_toast(L.t("lb_locked_unit"), true)
   443			return
   444		# 第八輪：一局每邊最多 10 種
   445		if not RuleSet.has(int(lobby_r.pool[team]), t) and RuleSet.pool_count(int(lobby_r.pool[team])) >= RuleSet.ROSTER_MAX:
   446			_toast(L.t("lb_roster_full"), true)
   447			return
   448		lobby_r.pool[team] = int(lobby_r.pool[team]) ^ (1 << t)
   449		if lobby_r.ai_pool_same:
   450			lobby_r.pool[1] = lobby_r.pool[0]
   451		_lobby_touch()
   452	
   453	func _lobby_sb_adj(k: int, d: int) -> void:
   454		lobby_item = "lab"
   455		var cur: Array = lobby_r.stat_pct.get(lobby_sb_unit, [100, 100, 100]).duplicate()
   456		cur[k] = clampi(int(cur[k]) + 10 * d, RuleSet.PCT_MIN, RuleSet.PCT_MAX)
   457		if cur == [100, 100, 100]:
   458			lobby_r.stat_pct.erase(lobby_sb_unit)
   459		else:
   460			lobby_r.stat_pct[lobby_sb_unit] = cur
   461		_lobby_touch()
   462	
   463	func _lobby_sb_skill(s: String) -> void:
   464		lobby_item = "lab"
   465		if s in lobby_r.skills_off:
   466			lobby_r.skills_off.erase(s)
   467		else:
   468			lobby_r.skills_off.append(s)
   469		_lobby_touch()
   470	
   471	# ───────── 文字 ─────────
   472	func _secs(ticks: int) -> int:
   473		return ticks / 20
   474	
   475	func _rounds_text(n: int) -> String:
   476		return L.t("lb_rounds_%d" % n)
   477	
   478	func _place_text(p: String) -> String:
   479		return L.t("rule_short_" + p) if p != "custom" else L.t("rule_short_custom", [lobby_r.turns])
   480	
   481	func _summary(r) -> String:
   482		var parts: Array = []
   483		if r.handicap:
   484			parts.append(L.t("lb_sum_gold_hc", [r.budget_of(0), r.budget_of(1)]))
   485		else:
   486			parts.append(L.t("lb_sum_gold", [r.budget_of(0)]))
   487		parts.append(L.t("lb_sum_cap", [r.unit_cap]))
   488		parts.append(L.t("lb_sum_secs", [_secs(r.ticks)]))
   489		parts.append(_rounds_text(r.rounds))
   490		if r.deploy == "free":
   491			parts.append(L.t("lb_sum_free") if r.fullfield == 0 else L.t("lb_sum_full"))
   492		if r.cmd_on():
   493			parts.append(L.t("lb_sum_cmd", [CmdD.count_of(int(r.cmd_mask[0]))]))
   494		return "・".join(parts)
   495	
   496	func _badge_pill(p: Vector2, b: String) -> float:
   497		var col: Color = {"cert": Color("#3fbf6a"), "fun": Color("#e8b33a"), "lab": Color("#a46be0")}[b]
   498		var icon: String = {"cert": "◎", "fun": "★", "lab": "◇"}[b]
   499		var lab: String = icon + " " + L.t("lb_badge_" + b)
   500		var fs := tz("S")
   501		var w := maxf(_width(lab, fs, true) + 20.0, _width(lab, fs, true) / 0.86 + 2.0)   # 1.4.0 R12：左右各留 max(10, 寬×6%)
   502		var r := Rect2(p, Vector2(w, maxf(fs * 1.6, label_ink(lab, fs, true).size.y + 10.0)))   # 1.4.0 R12：牌高＝墨跡＋上下各 5
   503		draw_rect(r, Color(col, 0.22))
   504		# 色盲也分得出：認證＝實線框、娛樂＝虛線框、沙盒＝雙線框
   505		match b:
   506			"cert":
   507				draw_rect(r, col, false, 2.0)
   508			"fun":
   509				var x := r.position.x
   510				while x < r.end.x:
   511					draw_line(Vector2(x, r.position.y), Vector2(minf(x + 6, r.end.x), r.position.y), col, 2.0)
   512					draw_line(Vector2(x, r.end.y), Vector2(minf(x + 6, r.end.x), r.end.y), col, 2.0)
   513					x += 10
   514				draw_line(r.position, Vector2(r.position.x, r.end.y), col, 2.0)
   515				draw_line(Vector2(r.end.x, r.position.y), r.end, col, 2.0)
   516			"lab":
   517				draw_rect(r, col, false, 1.5)
   518				draw_rect(r.grow(-4), col, false, 1.5)
   519		probe_cell_begin(r)   # 1.4.0：認證牌是格子（R11 置中、R12 內距；Codex v140 cat01 #1）
   520		_text(ink_center_p(r, lab, fs, true), lab, fs, Color.WHITE, true, true)
   521		probe_cell_end()
   522		return w
   523	
   524	# ───────── 繪製 ─────────
   525	func _draw_lobby() -> void:
   526		var P := Rect2(50, 30, 1180, 740)
   527		_panel(P)
   528		probe_skip("R4", "大廳底列：左側操作組（返回、展開、隨機／代碼）靠左，右側「開始」主按鈕靠右，刻意分兩組")
   529		var title := L.t("menu_vs_ai") if lobby_kind == "ai" else L.t("menu_duel")
   530		_h1(Vector2(640, 24), title)   # 1.2.0：H1 放大，緞帶上移 4 保持和分頁的距離（R2）   # V1.5.2 L3：緞帶跨在面板上緣（和圖鑑同款），完整下緣到預設分頁 ≥16
   531		_draw_lobby_presets(Vector2(80, 96))
   532		var cy := 96.0 + lobby_tab_h() + 12.0   # 1.4.0 R12：分頁在大字級時長高（兩行字上下要留空），內容跟著往下
   533		if lobby_open:
   534			_draw_lobby_detail(Rect2(80, cy, 1120, 684.0 - cy))
   535		else:
   536			_draw_lobby_main(Rect2(80, cy, 1120, 684.0 - cy))
   537			_ink_mode = false   # 任何路徑結束都關掉紙上墨色
   538		# 底列
   539		var by := 700.0
   540		if lobby_open or lobby_step == 0:
   541			_btn(Rect2(80, by, 150, 48), L.t("back"), func(): _nav_back())
   542		else:
   543			_btn(Rect2(80, by, 150, 48), L.t("lb_prev"), func(): lobby_step -= 1)   # 1.5.0 §1.2：上一步
   544		_btn(Rect2(244, by, 200, 48), L.t("lb_collapse") if lobby_open else L.t("lb_expand"), func(): lobby_open = not lobby_open)
   545		if lobby_open:
   546			_btn(Rect2(458, by, 150, 48), L.t("lb_copy"), _lobby_copy_code)
   547			_btn(Rect2(620, by, 150, 48), L.t("lb_paste"), _lobby_paste_code)
   548			_btn(Rect2(782, by, 150, 48), L.t("lb_save"), _lobby_save_preset)
   549		var why := _lobby_block()
   550		if not lobby_open and lobby_step < 2:
   551			_btn(Rect2(966, by, 234, 48), L.t("lb_next"), func(): lobby_step += 1, true, true)   # 1.5.0 §1.2：下一步
   552		else:
   553			btn_seal_square = true
   554			_btn(Rect2(966, by, 234, 48), L.t("lb_start"), _lobby_start, why == "", true)
   555			btn_seal_square = false
   556		screen_register("lobby", "lb_next" if (not lobby_open and lobby_step < 2) else "lb_start", "進階折頁的內部重排（卡池單側＋唯讀摘要、分頁收斂）排在後面的批次" if lobby_open else "")
   557		if not bool(Save.s("plain_ui")) and not lobby_open:
   558			# 1.4.0 §1.1：每次開戰在手帳右頁右下蓋一記方印，最多留 3 記（下次打開還在）
   559			var ns := mini(3, int(Save.data.get("lobby_stamps", 0)))
   560			for k in ns:
   561				var sc := Vector2(1150.0 - k * 34.0, 660.0 - (k % 2) * 8.0)
   562				draw_set_transform_matrix(ui_xf * Transform2D(0.08 * (k - 1), sc))
   563				draw_rect(Rect2(-13, -13, 26, 26), Color(PAL.TRINKET_RED, 0.42), false, 2.5)
   564				draw_rect(Rect2(-8, -8, 16, 16), Color(PAL.TRINKET_RED, 0.26))
   565				draw_set_transform_matrix(ui_xf)
   566		if why != "":
   567			_text(Vector2(1083, by - tz("C") * 1.5), why, tz("C"), Color("#ff8a8a"), true, true, 460)
   568		if lobby_menu:
   569			_draw_lobby_menu(Vector2(1000, 186))
   570		elif not lobby_open:
   571			_boss_note("lobby", "lobby")   # 1.2.0 §12：第一次進大廳的便條
   572	
   573	## 1.4.0 R12：預設分頁高度——字級 150% 時兩行字要上下各留 max(4, 12%)，分頁從 68 長到 78。
   574	func lobby_tab_h() -> float:
   575		if tz("B") < 22:
   576			return 68.0
   577		# 只有真的有分頁要換兩行時才長高（日文改短後全部一行，就不留空，Antigravity v140 cat01 #5）
   578		var tw_min := 154.0 - 6.0 - BM_SLOT
   579		var te := tw_min - 2.0 * (maxf(6.0, tw_min * 0.06) + 1.0)
   580		for id in Presets.IDS:
   581			if wrap_lines(L.t("lb_p_" + id), fit(L.t("lb_p_" + id), tz("B"), te, true), te, true).size() > 1:
   582				return 78.0
   583		return 68.0
   584	
   585	func _draw_lobby_presets(o: Vector2) -> void:
   586		btn_group = "lb_modes"   # 1.5.0 R14：頂緣模式紙籤＋「我的預設」＝一組分頁
   587		var w := 154.0
   588		var h := lobby_tab_h()
   589		for i in Presets.IDS.size():
   590			var id: String = Presets.IDS[i]
   591			var p = Presets.make(id, lobby_kind, _lobby_unlocked())
   592			Presets.clamp_pool(p, lobby_kind, _lobby_unlocked(), _demo())
   593			var r := Rect2(o + Vector2(i * (w + 10), 0), Vector2(w, h))
   594			var on: bool = lobby_r.preset == id
   595			# V1.5.2 L2（A 案）：選中分頁的紅書籤上緣貼分頁上緣、在右側垂下；畫在分頁底面之後、焦點框之前（不蓋手把焦點框）
   596			if on:
   597				btn_deco = _draw_bookmark
   598			btn_cloth = "tab_indigo" if on else "tab_linen"   # 1.2.0 第 4 大類：預設分頁是布標（和設定分頁同一套；選中靛藍、未選原胚布）
   599			_btn(r, "", _lobby_pick.bind(id), true, false, TH_ACTIVE if on else TH_WOOD)
   600			btn_cloth = ""
   601			var on_paper := last_btn_paper   # 原胚布：字用墨色
   602			btn_deco = Callable()
   603			if on:
   604				draw_rect(r, ACCENT, false, 3.0)
   605			# 只有選中的分頁讓出書籤槽（可用區 [6, w−BM_SLOT]）；沒選中的照整格置中（實作審查第 2 輪看圖：六格一律讓槽時
   606			# 沒書籤的分頁字明顯偏左）。要換兩行時中日文從中間斷（不留「決」「種」單字一行），從上緣 5 起排，色條在 h−9
   607			var lab := L.t("lb_p_" + id)
   608			var tw := (w - 6.0 - BM_SLOT) if on else (w - 12.0)
   609			var tx := (6.0 + tw / 2) if on else w / 2
   610			var te := tw - 2.0 * (maxf(6.0, tw * 0.06) + 1.0)   # 1.4.0 R12：分頁字左右各留 max(6, 6% 寬)
   611			var two := wrap_lines(lab, fit(lab, tz("B"), te, true), te, true).size() > 1
   612			var lsz: int = tz("B")
   613			if two:
   614				lab = balance_two_lines(lab)
   615				# 兩行時字級取字級表裡第二行字形下緣（5＋2.53×字級）還在色條上方 2px 的最大一級（Antigravity 實作第 3 輪：平衡後一行變短，fit 不會縮）
   616				lsz = tz("C")
   617				for c in [tz("B"), tz("S"), tz("C")]:
   618					if 5.0 + 2.53 * c <= h - 11.0 and 2.3 * c <= (h - 14.0) * 0.76 and _width(lab, c, true) <= te:   # 1.4.0 R12：兩行墨跡上下也要留 12%
   619						lsz = c
   620						break
   621			_ink_mode = on_paper
   622			# 1.3.0 R11：字放在「色條以上」的文字區正中（原本從上緣固定 5／8 起排，字擠在上半）；選中時扣掉書籤槽
   623			var lsz2: int = fit(lab, lsz, te, true)
   624			var lab2: String = lab if two else "\n".join(wrap_lines(lab, lsz2, te, true))
   625			var tcell := Rect2(r.position.x + tx - tw / 2, r.position.y + 3, tw, h - 9 - 2 - 3)
   626			probe_cell_begin(tcell)
   627			_text(ink_center_p(tcell, lab2, lsz2, true), lab2, lsz2, Color.WHITE, true, true)
   628			probe_cell_end()
   629			_ink_mode = false
   630			var b := Presets.badge(p, lobby_kind)
   631			var bc: Color = {"cert": Color("#3fbf6a"), "fun": Color("#e8b33a"), "lab": Color("#a46be0")}[b]
   632			_box(Rect2(r.position + Vector2(8, h - 9), Vector2(w - 16, 4)), bc, Color(0, 0, 0, 0), 2.0)
   633		if layout_probe and Presets.IDS.has(lobby_r.preset):
   634			probe_need["bookmark"] = 1   # 漏登記守衛：選了內建預設就一定要畫出紅書籤
   635		var mr := Rect2(o + Vector2(6 * (w + 10), 0), Vector2(1120 - 6 * (w + 10), h))
   636		_btn(mr, L.t("lb_mine"), func(): lobby_menu = not lobby_menu, true, false, TH_ACTIVE if lobby_r.preset == "custom" else TH_WOOD)
   637		btn_group = ""
   638	
   639	func _draw_lobby_menu(o: Vector2) -> void:
   640		var ps: Array = Save.data.get("rule_presets", [])
   641		var rows: int = clampi(ps.size(), 1, 5)
   642		var cols := 2 if ps.size() > 5 else 1
   643		o.x -= 240.0 * (cols - 1) + 30.0
   644		var r := Rect2(o, Vector2(12 + cols * 240, 12 + rows * 50))
   645		# 下拉選單蓋住的底層按鈕不能被點到（Antigravity v150-i2 #6）
   646		for bi in range(_btns.size() - 1, -1, -1):
   647			if r.intersects(_btns[bi]["r"]):
   648				_btns.remove_at(bi)
   649		draw_rect(r, PANEL)
   650		draw_rect(r, Color(1, 1, 1, 0.3), false, 1.5)
   651		if ps.is_empty():
   652			_text(r.position + Vector2(110, 18), L.t("lb_mine_empty"), tz("S"), TXT_DIM, true, false, 200)
   653			return
   654		for i in ps.size():
   655			var cp := r.position + Vector2(6 + (i / 5) * 240, 6 + (i % 5) * 50)
   656			_btn(Rect2(cp, Vector2(144, 44)), str(ps[i]["name"]), _lobby_load_preset.bind(i))
   657			_btn(Rect2(cp + Vector2(148, 0), Vector2(44, 44)), "", func(): DisplayServer.clipboard_set(str(ps[i]["code"])); _toast(L.t("lb_copied")))
   658			_icon("copy", cp + Vector2(170, 22), 18.0, Color.WHITE)
   659			_btn(Rect2(cp + Vector2(196, 0), Vector2(40, 44)), "×", _lobby_delete_preset.bind(i))
   660	
   661	func _filter_hit(t: int) -> bool:
   662		match lobby_filter:
   663			1:
   664				return D.is_melee(t) and not D.is_support(t) and not t in Presets.F8.RAID
   665			2:
   666				return not D.is_melee(t) and not D.is_support(t) and not t in Presets.F8.RAID
   667			3:
   668				return D.is_support(t)
   669			4:
   670				return t in Presets.F8.RAID
   671		return true
   672	
   673	## 部署分頁的陣型小圖：看得到間距和縱深實際長怎樣。
   674	func _draw_deploy_preview(r: Rect2) -> void:
   675		var w: float = lobby_r.field_w()
   676		var h: float = lobby_r.field_h()
   677		var k: float = minf(r.size.x / w, r.size.y / h)
   678		var q := Rect2(r.position, Vector2(w, h) * k)
   679		draw_rect(q, Color("#5f8a45"))
   680		var free_d: bool = lobby_r.deploy == "free"
   681		var dep: float = lobby_r.half_depth() if free_d else 6000.0
   682		var sp: float = lobby_r.spacing if free_d else 1000.0
   683		draw_rect(Rect2(q.position, Vector2(dep * k, q.size.y)), Color(Art.team_color(0, cbm()), 0.28))
   684		draw_rect(Rect2(q.end.x - dep * k, q.position.y, dep * k, q.size.y), Color(Art.team_color(1, cbm()), 0.28))
   685		var yy := 500.0
   686		while yy < h:
   687			var xx := 500.0
   688			while xx < dep:
   689				draw_circle(q.position + Vector2(xx, yy) * k, 2.2, Color.WHITE, true, -1.0, true)
   690				xx += sp
   691			yy += sp
   692		draw_rect(q, Color(0, 0, 0, 0.5), false, 1.5)
   693	
   694	func _deck_random() -> void:
   695		var sel: Array = RuleSet.types_of(Presets.selectable(lobby_kind, _lobby_unlocked(), _demo()))
   696		sel.shuffle()
   697		var p := 0
   698		for t in sel.slice(0, RuleSet.ROSTER_MAX):
   699			p |= 1 << int(t)
   700		if not RuleSet.has_combat(p):
   701			return
   702		lobby_r.pool[lobby_pool_team] = p
   703		if lobby_r.ai_pool_same:
   704			lobby_r.pool[1] = p
   705		_lobby_touch()
   706	
   707	func _deck_save() -> void:
   708		var decks: Array = Save.data.get("decks", [])
   709		decks.append(int(lobby_r.pool[lobby_pool_team]))
   710		while decks.size() > 3:
   711			decks.pop_front()
   712		Save.data["decks"] = decks
   713		Save.save_data()
   714		_toast(L.t("lb_deck_saved"))
   715	
   716	func _deck_load(i: int) -> void:
   717		var decks: Array = Save.data.get("decks", [])
   718		if i >= decks.size():
   719			return
   720		var sel: int = Presets.selectable(lobby_kind, _lobby_unlocked(), _demo())
   721		var p: int = int(decks[i]) & sel
   722		if p == 0 or not RuleSet.has_combat(p):
   723			_toast(L.t("lb_deck_locked"), true)
   724			return
   725		lobby_r.pool[lobby_pool_team] = p
   726		if lobby_r.ai_pool_same:
   727			lobby_r.pool[1] = p
   728		_lobby_touch()
   729	
   730	## V9 P5 單頁大廳：左邊四件事（地圖、卡牌、對手、規則），右邊即時預覽；1 秒可開打，細項收在「進階」。
   731	func _draw_lobby_main(R: Rect2) -> void:
   732		var r = lobby_r
   733		var x := R.position.x
   734		var lw := 600.0
   735		var rowh := 96.0
   736		# 1.4.0：規則摘要（最後一列）要多高先算好，上面四列平均讓出空間（84～96），規則列不撞底列（Codex v140 cat01 #5）
   737		var sm0 := _summary(r)
   738		var smz0 := fit(sm0, tz("S"), lw - 170.0)
   739		var rules_need := maxf(rowh - 8.0, 12.0 + text_h(sm0, smz0, lw - 170.0) + 4.0 + 36.0 + 8.0)
   740		rowh = clampf((R.size.y - rules_need) / 4.0, 84.0, 96.0)
   740		rowh = clampf((R.size.y - rules_need) / 4.0, 84.0, 96.0)
   741		var y := R.position.y
