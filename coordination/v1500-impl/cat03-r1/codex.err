  1003	## 警告＋差異清單大約要多高（說明欄排版用）。
  1004	func _lobby_notes_h(w: float) -> float:
  1005		var h := 0.0
  1006		for k in lobby_r.validate():
  1007			h += text_h("× " + L.t(k), tz("B"), w, true) + 4
  1008		var two: bool = lobby_r.handicap or not lobby_r.ai_pool_same
  1009		for tm in (2 if two else 1):
  1010			var ms: Dictionary = lobby_r.max_spend(tm)
  1011			if int(ms["unused"]) > 0:
  1012				h += text_h("⚠ " + L.t("lb_unused", [ms["units"], ms["spend"], ms["unused"]]), tz("S"), w) + 4
  1013		var df: Array = lobby_r.diff(_lobby_std())
  1014		if not df.is_empty():
  1015			h += tz("S") * 1.4
  1016			for d in df:
  1017				h += text_h("・" + _diff_text(d), tz("S"), w - 10)
  1018		return h
  1019	
  1020	## 驗證錯誤（紅）、花不完的錢（黃）、和標準不同的項目。
