   370	static func _r14(out: Dictionary, d: Dictionary) -> void:
   371		var sc: Dictionary = d.get("screen", {})
   372		if sc.is_empty():
   373			return
   374		var cls := str(sc.get("cls", ""))
   375		if str(sc.get("main", "")) == "":
   376			_add(out, "fail", "R14", cls, "畫面登記了類別卻沒有主動作")
   377		if not R14_LIMITS.has(cls):
   378			return
   379		var n := int(d.get("clicks", 0))
   380		var lim := int(R14_LIMITS[cls])
   381		if n <= lim:
   382			return
   383		if str(sc.get("skip", "")) != "":
   384			var key := "_ex_R14:" + cls
   385			if not out.has(key):
   386				out[key] = true
   387				out["exempt"].append({"rule": "R14", "id": cls, "why": str(sc["skip"])})
   388			return
   389		_add(out, "fail" if cls in R14_ENFORCE else "warn", "R14", cls, "可見可點元件 %d 個，超過「%s」類上限 %d（收進「更多」或拆頁）" % [n, cls, lim])
