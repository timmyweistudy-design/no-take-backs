   745			var top := y - 8.0   # 紙頁上緣和預覽木框之間留白（Antigravity impl4）
   746			var bot := R.end.y + 6.0
   747			_tex_box(Rect2(x - 16, top - 4, R.size.x + 32, bot - top + 10), "wood", Color(0.42, 0.27, 0.16))
   748			_tex_box(Rect2(x - 10, top, lw + 18, bot - top), "paper")
   749			_tex_box(Rect2(x + lw + 8, top, R.size.x - lw + 2, bot - top), "paper")
   750			for k in 6:   # 書脊：中間往兩邊漸淡的陰影
   751				var a := 0.22 - k * 0.035
   752				draw_rect(Rect2(x + lw + 7 - k * 2.0, top, 2.0, bot - top), Color(0.2, 0.12, 0.05, a))
   753				draw_rect(Rect2(x + lw + 9 + k * 2.0, top, 2.0, bot - top), Color(0.2, 0.12, 0.05, a))
   754			# 1.2.0 §1.1 A4 線裝對局譜：書脊上五針線裝（穿孔＋跨脊的靛色線），上下兩針包角
   755			var sx := x + lw + 8.0
   756			for kn in 5:
   757				var sy := top + 22.0 + kn * (bot - top - 44.0) / 4.0
   758				draw_line(Vector2(sx - 9, sy), Vector2(sx + 9, sy), Color("#2b3f5c"), 2.0, true)
   759				draw_line(Vector2(sx - 9, sy + 1.5), Vector2(sx + 9, sy + 1.5), Color(1, 1, 1, 0.12), 1.0)
   760				for hx in [-9.0, 9.0]:
   761					draw_circle(Vector2(sx + hx, sy), 2.2, Color(0.22, 0.14, 0.07, 0.75))
   762			draw_line(Vector2(sx, top + 22.0), Vector2(sx, bot - 22.0), Color("#2b3f5c", 0.55), 1.5)
   763			_ink_mode = true
   764		# V1.5.2 L6：列底色高度照內容（hh）；左欄圖示與標籤和右邊主控制項共用列中線（原本標籤靠上、控制項置中）
   765		var label := func(ic: String, s: String, yy: float, hh: float) -> void:
