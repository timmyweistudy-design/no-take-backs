  1724	## 方向鍵走到第 i 顆再按 A；同時確認焦點走得到。
  1725	func _pw_pick(i: int, what: String) -> void:
  1726		await _pw_frames(2)
  1727		_pw_check(i < _btns.size(), "%s：沒有第 %d 顆按鈕（共 %d）" % [what, i, _btns.size()])
  1728		var guard := 0
  1729		while _focus != i and guard < 60:
  1730			guard += 1
  1731			await _pw_btn(JOY_BUTTON_DPAD_DOWN)
  1732		_pw_check(_focus == i, "%s：焦點走不到第 %d 顆" % [what, i])
  1733		await _pw_btn(JOY_BUTTON_A)
  1734		await _pw_frames(3)
  1735	
  1736	## 這個畫面的每顆按鈕都走得到、都在畫面內。
  1737	func _pw_cycle(what: String) -> void:
  1738		await _pw_frames(2)
  1739		var n: int = _btns.size()
  1740		_pw_check(n > 0, "%s：沒有按鈕" % what)
  1741		for b in _btns:
  1742			_pw_check(Rect2(0, 0, 1280, 800).encloses(b["r"]), "%s：按鈕超出畫面 %s" % [what, str(b["r"])])
  1743		var seen := {}
  1744		for k in n:
  1745			seen[_focus] = true
  1746			await _pw_btn(JOY_BUTTON_DPAD_DOWN)
  1747		_pw_check(seen.size() == n, "%s：焦點只走到 %d／%d 顆" % [what, seen.size(), n])
