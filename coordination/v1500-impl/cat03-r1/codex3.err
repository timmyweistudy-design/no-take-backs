func _draw_lobby_main(R: Rect2) -> void:
	var r = lobby_r
	var x := R.position.x
	var lw := 600.0
	var rowh := 96.0
	# 1.4.0：規則摘要（最後一列）要多高先算好，上面四列平均讓出空間（84～96），規則列不撞底列（Codex v140 cat01 #5）
	var sm0 := _summary(r)
	var smz0 := fit(sm0, tz("S"), lw - 170.0)
	var rules_need := maxf(rowh - 8.0, 12.0 + text_h(sm0, smz0, lw - 170.0) + 4.0 + 36.0 + 8.0)
	rowh = clampf((R.size.y - rules_need) / 4.0, 84.0, 96.0)
	var y := R.position.y
	# V1.2 C1：左欄是一頁羊皮紙（像攤開的戰役筆記），紙上的字用墨色
	if not bool(Save.s("plain_ui")):
		# V1.2 C1：攤開的戰術筆記：木書殼＋左右兩頁羊皮紙＋中間書脊陰影（上緣和頁籤留空，Antigravity impl3）
		var top := y - 8.0   # 紙頁上緣和預覽木框之間留白（Antigravity impl4）
		var bot := R.end.y + 6.0
		_tex_box(Rect2(x - 16, top - 4, R.size.x + 32, bot - top + 10), "wood", Color(0.42, 0.27, 0.16))
		_tex_box(Rect2(x - 10, top, lw + 18, bot - top), "paper")
		_tex_box(Rect2(x + lw + 8, top, R.size.x - lw + 2, bot - top), "paper")
		for k in 6:   # 書脊：中間往兩邊漸淡的陰影
			var a := 0.22 - k * 0.035
			draw_rect(Rect2(x + lw + 7 - k * 2.0, top, 2.0, bot - top), Color(0.2, 0.12, 0.05, a))
			draw_rect(Rect2(x + lw + 9 + k * 2.0, top, 2.0, bot - top), Color(0.2, 0.12, 0.05, a))
		# 1.2.0 §1.1 A4 線裝對局譜：書脊上五針線裝（穿孔＋跨脊的靛色線），上下兩針包角
		var sx := x + lw + 8.0
		for kn in 5:
			var sy := top + 22.0 + kn * (bot - top - 44.0) / 4.0
			draw_line(Vector2(sx - 9, sy), Vector2(sx + 9, sy), Color("#2b3f5c"), 2.0, true)
			draw_line(Vector2(sx - 9, sy + 1.5), Vector2(sx + 9, sy + 1.5), Color(1, 1, 1, 0.12), 1.0)
			for hx in [-9.0, 9.0]:
				draw_circle(Vector2(sx + hx, sy), 2.2, Color(0.22, 0.14, 0.07, 0.75))
		draw_line(Vector2(sx, top + 22.0), Vector2(sx, bot - 22.0), Color("#2b3f5c", 0.55), 1.5)
		_ink_mode = true
	# V1.5.2 L6：列底色高度照內容（hh）；左欄圖示與標籤和右邊主控制項共用列中線（原本標籤靠上、控制項置中）
	var label := func(ic: String, s: String, yy: float, hh: float) -> void:
		if _ink_mode:   # 1.2.0 A10：紙頁上的列＝一條紙籤（淡墨上下細線＋左上折角），不是深色圓角框
			draw_rect(Rect2(x, yy, lw, hh), Color(0.36, 0.22, 0.1, 0.05))
			draw_line(Vector2(x + 14, yy), Vector2(x + lw, yy), Color(0.26, 0.16, 0.08, 0.35), 1.0)
			draw_line(Vector2(x, yy + hh), Vector2(x + lw, yy + hh), Color(0.26, 0.16, 0.08, 0.35), 1.0)
			draw_colored_polygon(PackedVector2Array([Vector2(x, yy), Vector2(x + 14, yy), Vector2(x, yy + 14)]), Color(0.36, 0.22, 0.1, 0.22))
		else:
			_box(Rect2(x, yy, lw, hh), Color(0, 0, 0, 0.2), Color(0, 0, 0, 0), 7.0)
		var mid := yy + minf(hh, rowh - 8.0) * 0.5
		_icon(ic, Vector2(x + 26, mid), 26.0, ACCENT)
		var lsz := fit(s, tz("B"), 112, true)
		_text(Vector2(x + 44, mid - text_h(s, lsz, 112, true) * 0.5), s, lsz, Color(1, 1, 1, 0.92), false, true, 112)
	var cx := x + 160
	var cw := lw - 170
	# 1.5.0 §1.2 三步：左頁上方一條步驟紙籤（可以直接點跳）；一次只放這一步的列
	btn_group = "lb_steps"
