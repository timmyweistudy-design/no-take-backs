var btn_group := ""
func click_count() -> int:
	var n := 0
	var seen := {}
	for b in _btns:
		if bool(b.get("grid", false)):
			continue
		var gp := str(b.get("group", ""))
		if gp != "":
			if seen.has(gp):
				continue
			seen[gp] = true
		n += 1
	return n
