var force_demo := false   # 測試用：不必匯出就能走試玩版流程
func _demo() -> bool:
		draw_rect(wr, Color(0.35, 0.22, 0.05, 0.95))
		draw_rect(wr, ACCENT, false, 2.0)
		_text(Vector2(276, wr.position.y + 12), L.t("demo_wish"), tz("S"), Color.WHITE, false, true, 480)
		var url: String = SteamApi.STORE_URL
		_btn(Rect2(780, wr.position.y + 6, 230, 40), L.t("demo_wish_btn") if url != "" else L.t("demo_wish_soon"), func(): OS.shell_open(url), url != "", true)
	var bs: Array = []
	match mode:
		Mode.VS_AI, Mode.DUEL:
			if get("trial_id") >= 0:
				var tid: int = get("trial_id")
				if w == 0 and tid + 1 < get("TRIALS").size():
					bs.append([L.t("next_puzzle"), func(): call("_start_trial", tid + 1)])
				bs.append([L.t("retry"), func(): _mark_retry(); call("_start_trial", tid); _apply_retry()])
				bs.append([L.t("trial_title"), func():
					_go_title()
					_open("trials")])
			else:
				bs.append([(L.t("sealed_again") if bool(get("sealed_on")) else L.t("new_match")) if series_over else L.t("next_round"), func(): _next_round()])
		Mode.TUTORIAL, Mode.PUZZLE:
			bs.append([L.t("retry"), func(): _mark_retry(); _start_mode(mode)])
			if ((w == 0 and mode == Mode.TUTORIAL) or bool(report.get("goal_ok", false))) and puzzle_id != "ws":
				bs.append([L.t("next_puzzle"), func(): _next_puzzle()])
	if state == St.PLACE and _fp_key(k):
		return
	if state == St.BATTLE and overlay == "" and _cmd_key(k):
		return
	if state == St.BATTLE and overlay == "" and (k == KEY_BRACKETLEFT or k == KEY_BRACKETRIGHT) and _replay_controls_active():
		_bm_jump(-1 if k == KEY_BRACKETLEFT else 1)   # 1.2.0 §11.2 書籤
		return
	if state == St.BATTLE and overlay == "" and k == KEY_G and play_kind == "review" and tm_ghost != null:
		tm_ghost_on = not tm_ghost_on   # 1.2.0 §11.3
		return
	# 1.5.0 §1.2 大廳三步：肩鍵（Q／E）＝上一步／下一步，Y（Tab）＝打開／收起進階折頁
	if overlay == "lobby" and not bool(get("lobby_menu")):
		if (k == KEY_Q or k == KEY_E) and not bool(get("lobby_open")):
			call("_lobby_step_by", -1 if k == KEY_Q else 1)
			return
		if k == KEY_TAB:
			set("lobby_open", not bool(get("lobby_open")))
			_btns.clear()   # 開合折頁：舊按鈕立刻失效（同一幀 Y＋A 不會按到開合前的「開戰」；Codex v150 cat03 r3）
			return
	# 有按鈕焦點的畫面（標題、選單、結果、覆蓋層、戰鬥）：方向鍵移焦點、Enter 按下、Esc 返回
	if state != St.PLACE or overlay != "":
		match k:
			KEY_UP, KEY_LEFT:
