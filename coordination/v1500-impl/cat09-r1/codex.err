			KEY_DOWN, KEY_RIGHT:
				_move_focus(1)
			KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
				if _btns_gen == _gen and _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:   # 按鈕清單要是這個畫面的
					sfx.play("k_click", 0.7)
					_btns[_focus]["cb"].call()
			KEY_F1:
				if state == St.BATTLE and overlay == "" and play_kind != "official":
					call("_breport_open")   # 1.1.0 B10：手把 View／Select＝戰報面板
				elif state == St.BATTLE and overlay == "":
					set("hud_info_until", time + 2.0)   # 1.2.0 §5.6：正式對戰按 View＝叫出 AI 名稱與性格 2 秒
			KEY_PAGEUP, KEY_PAGEDOWN:
				if overlay == "codex":
					_scroll_by("left", -160.0 if k == KEY_PAGEUP else 160.0)
			KEY_P, KEY_TAB:
				# 手把 Y 送的是 Tab：戰鬥中＝暫停（第七輪 A6）
				if state == St.BATTLE and overlay == "":
					_toggle_pause()
				elif k == KEY_TAB:
					_move_focus(1)
			KEY_ESCAPE:
				if overlay == "ai_busy":
					pass      # 第十輪 I4：AI 計算中不能取消
				elif overlay == "first_run":
					Save.set_setting("first_done", true)   # V1.5：跳過第一次啟動的問題
					overlay = ""
var ban_left := [0, 0]
var ban_turn := 0

## ── 主題試煉 ──
func _start_trial(i: int) -> void:
	if _demo() and not i in Presets.DEMO_TRIALS:
		_toast(L.t("demo_locked"), true)
		return
	rules = _trial_rules(i, trial_x(i))
	challenge_army = null      # 上一場挑戰碼的敵陣不能留到試煉（Codex #5）
	rng.seed = 7000 + i        # 同一關每次是同一支隊伍
	_start_mode(Mode.VS_AI)
	trial_id = i

## 試煉的規則（遊戲與工具共用）。x＝第十三輪的關卡資料（舊 10 關是空的）。
func _trial_rules(i: int, x: Dictionary):
	var t: Array = TRIALS[i]
	var r = Presets.make("standard", "ai", RS.mask(_demo()))
	r.deploy = "free"
	r.spacing = 800
	r.depth = 6000
				["pr_wager", "pr_wager_d", "dice", func(): call("_wager_new"), true],
				["pr_draft", "pr_draft_d", "cards", func(): call("_draft_new"), true],
				["pr_waves", "pr_waves_d", "swords", func(): call("_wave_start"), true],
				["pr_sealed", "pr_sealed_d", "book", func(): call("_sealed_start"), true]]
		"hub_collect":
			return [["menu_codex", "hc_codex_d", "book", func(): overlay = ""; _open_codex(0), true],
				["paint_open", "hc_paint_d", "star", func(): call("_paint_open"), true],
				["menu_profile", "hc_profile_d", "trophy", func(): overlay = ""; _open("profile"), true],
				["nem_open", "hc_nem_d", "flag", func(): overlay = "nemeses", not _demo()],
				["ed_open", "hc_ed_d", "puzzle", func(): overlay = "editor"; _focus = 0, not _demo()],   # V1.6 #16 出題台
				["tour_title", "hc_tour_d", "book", func(): overlay = "tour"; _focus = 0, true],   # V1.6.1 N2 新玩法導覽（常駐）
coordination/v1500-impl/cat09-r1/codex-prompt.md:3:重點：戰績頁籤（`pf_tab`、`pf_grp`、`pf_ach_page`）的手把焦點與狀態重設（進出戰績頁、切頁籤）、成就從焦點目標移除後手把能否到達所有可點元件；`_draw_pf_*` 版位與 `_h1` 回傳；試煉 TRIAL_PAGE 8 對其他地方（試玩版 DEMO_TRIALS、從結果返回試煉頁時落在哪一頁、PADWALK）有沒有影響；最常出戰／勝率最高排序是否決定性。附行號。最多 5 條必改、400 字內。最後一行「結論：可／有條件／不可」。
coordination/v1500-impl/cat09-r1/agy.md:1:1. **試煉（58_trials）**：每頁 8 關（2×4）只做「選關與看三星條件」一件事，留白與資訊密度適中；150% 英文與日文的標題、戰力／金幣門檻與分頁列皆無裁切或擁擠，整體好讀。
