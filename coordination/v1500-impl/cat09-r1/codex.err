func cbm() -> bool:
	return bool(Save.s("colorblind"))


func _toast(s: String, deny := false) -> void:
	toast = s
	var tm := int(Save.s("toast_mult"))
	toast_t = 2.0 * tm if tm > 0 else 600.0   # V1.5：提示停留 標準／加長／很長／手動關（點一下才收）
	toast_born = time
	if deny:
		sfx.play("ui_deny")


func _move_focus(d: int) -> void:
	pad_mode = true
	if _btns.is_empty():
		return
	_focus = posmod(_focus + d, _btns.size())


## 字太寬就往下一級縮（第五輪：只在字級表內往下走，最小到「註記」，不再縮到 9px；還是太寬就由 _text 換行）。
func fit(s: String, size: int, maxw: float, bold := false) -> int:
	var sz := size
	var levels: Array = TYPE_SCALE[_scale_key()].values()
	levels.sort()
	while _width(s, sz, bold) > maxw:
		var nxt := -1
		for v in levels:
			if v < sz:
				nxt = v
		if nxt < 0:
			break
		sz = nxt
	return sz

func _font_for(s: String, size: int, bold: bool) -> Font:
	if _hand_mode and font_title != null:
		return font_title   # 1.2.0：老闆便條、印章用手寫字（憲法 6：只放建議，不承載數值）
	if font_craft:
		# 1.2.0（Codex cat02 #3）工藝字型的分工：D／DX 展示大字＝ThenKhung（logo 氣質不變）；H1、T＝手寫楷體；H2 以下＝正文黑體
		if bold and not bool(Save.s("plain_titles")) and not _has_digit(s):
			if font_display != null and size >= tz("D"):
				return font_display
			if font_title != null and size >= tz("H1"):
				return font_title
		return font_bold if bold else font
	if bold and font_title != null and size >= tz("H2") and not bool(Save.s("plain_titles")) and not _has_digit(s):
		return font_title
	return font_bold if bold else font
	if st < 1 or st > STK.COUNT:
		return
	var c := p + Vector2(15, 5) * scale
	var a := 1.0 if on else 0.35
	draw_circle(c + Vector2(0, 1.2) * scale, 7.5 * scale, Color(0.1, 0.06, 0.03, 0.5 * a), true, -1.0, true)
	draw_circle(c, 7.0 * scale, Color(0.98, 0.94, 0.84, a), true, -1.0, true)
	draw_circle(c, 5.6 * scale, Color(Color(STK.COLORS[st]), a), true, -1.0, true)
	Icons.draw(self, STK.ICONS[st], c, 8.0 * scale, Color(1, 1, 1, a))

## 羊皮紙標題緞帶：畫面標題統一用它。回傳緞帶含尾的完整下緣（V1.5.2 L3：下方內容從「下緣＋GAP_L」起排）。
func _h1(center: Vector2, s: String, maxw := 0.0) -> float:
	var sz := tz("H1")
	var w := minf(_width(s, sz, true) + 72.0, maxw if maxw > 0.0 else 900.0)
	var r := Rect2(center.x - w / 2, center.y - 2, w, sz * 1.45)
	var notch := 14.0
	for sgn in [-1.0, 1.0]:
		var ex: float = r.position.x if sgn < 0 else r.end.x
		draw_colored_polygon(PackedVector2Array([Vector2(ex - sgn * 4, r.position.y + 6), Vector2(ex + sgn * 20, r.position.y + 6), Vector2(ex + sgn * (20 - notch), r.get_center().y + 3), Vector2(ex + sgn * 20, r.end.y + 2), Vector2(ex - sgn * 4, r.end.y + 2)]), TH_PARCH.darkened(0.28))
	_box(r, TH_PARCH, TH_PARCH.darkened(0.45), 4.0, 2.0)
	_text(center + Vector2(0, sz * 0.07), s, sz, TH_INK, true, true, maxf(w - 20.0, 100.0))
	if layout_probe:
		var host := ""
		for k in range(probe_panels.size() - 1, -1, -1):
			var pk: Rect2 = probe_panels[k]["r"]
			# 緞帶可以跨在面板上緣（圖鑑、大廳、試煉）：中心 x 在面板內、緞帶本體碰到面板就算它的宿主
			if pk.grow(2.0).has_point(center + Vector2(0, 2)) or (center.x > pk.position.x and center.x < pk.end.x and r.intersects(pk.grow(2.0))):
				host = probe_panels[k]["id"]
				break
		probe_ribbons.append({"id": "H%d" % probe_ribbons.size(), "r": Rect2(r.position.x - 20, r.position.y, r.size.x + 40, r.size.y + 2), "body": r, "cx": center.x, "bottom": r.end.y + 2.0, "host": host})
	return r.end.y + 2.0

## 標題緞帶完整下緣（不畫，給排版先算位置用）
func h1_bottom(center_y: float) -> float:
	return center_y - 2.0 + tz("H1") * 1.45 + 2.0

## V1.5.2：緞帶＋下方置中說明。回傳下一個內容的起點（說明下緣＋GAP_L；沒說明時＝緞帶下緣＋GAP_L）。
func _h1_help(center: Vector2, title: String, help: String, sz: int, maxw: float) -> float:
	var y := _h1(center, title) + GAP_L
	if help == "":
		return y
	_text(Vector2(center.x, y), help, sz, TXT_DIM, true, false, maxw)
	else:
		_box(r, Color(0, 0, 0, 0), TH_EDGE, 10.0, 3.0)
	if panel_obj != "" and not bool(Save.s("plain_ui")):
		_obj_deco(r, panel_obj)
		if layout_probe:
			probe_decos.append({"id": "obj_%s" % panel_obj, "kind": "obj", "r": obj_extent(r, panel_obj), "host_r": r, "edge": "screen"})   # 1.3.0：器物裝飾不能出畫面（Codex cat08 #3）
		obj_open_r = r
		obj_open_kind = panel_obj


func _open(name: String) -> void:
	if overlay.begins_with("hub_"):
		nav_stack.append(overlay)   # 卡片面板開著時直接開下一頁（例如結果頁「試煉」）：記得回面板
	overlay = name
	_focus = 0

## V1.5.1 返回目的地：打開下一層之前記下「從哪來」，返回鈕、Esc、手把 B 都走 _nav_back（使用者回報：返回都跳回主畫面）。
## 卡片面板（hub）畫出來時清空堆疊；開戰也清空。nav_hub＝最後經過的卡片面板，打完回標題時重新打開它。
var nav_stack: Array = []
var nav_hub := ""

var nav_focus := {}   # V1.0.0：卡片面板 → 上次點的那張卡（返回時焦點回原卡）
func _nav_push(from: String) -> void:
	nav_stack.append(from)

func _nav_back(fallback := "") -> void:
	if overlay.begins_with("hub_") or overlay == "playroom":   # V1.0.0：遊戲間也是卡片面板
		nav_hub = ""   # 關掉卡片面板：之後打完不再自動打開它
	overlay = str(nav_stack.pop_back()) if not nav_stack.is_empty() else fallback
	_focus = int(nav_focus.get(overlay, 0))   # V1.0.0（Codex v100-i1 #8）：回到卡片面板時焦點回原卡


func _fmt_num(v: float) -> String:
	return str(int(v)) if v == floorf(v) else str(v)


func _onoff(k: String) -> String:
	return L.t("on") if bool(Save.s(k)) else L.t("off")


func _cycle_setting(k: String, opts: Array) -> void:
extends "res://scripts/ui/screens/game_core.gd"
## 由 game_screens.gd 拆出（V9 P1，行為不變）

# ───────────────────────── 狀態切換 ─────────────────────────
## 第十輪 B10：玩家按離開。系列打到一半或遠征途中，先確認（自動導頁直接呼叫 _go_title，不跳確認）。
func _leave_at_risk() -> bool:
	if state == St.TITLE or watch_mode:
		return false
	if mode == Mode.GAUNTLET:
		if state == St.RESULT and sim != null:
			return sim.winner == 0 and gauntlet_stage < 7
		return gauntlet_stage > 1
	if mode == Mode.VS_AI or mode == Mode.DUEL:
		return wins[0] + wins[1] > 0 and not series_over
	return false

func _request_leave() -> void:
	if _leave_at_risk():
		overlay = "leave"
		_focus = 0
	else:
		_go_title()

func _leave_confirm() -> void:
	overlay = ""
	_go_title()

func _go_title() -> void:
	call("_rift_sync")   # 1.2.0 §11.9：回主畫面時補送當週天梯成績（沒有連線事件可接，回主畫面是固定的重試點；Codex cat10 #7）
	var rs = get("rush")
	if rs is Dictionary and bool(rs.get("on", false)):
		rs["on"] = false   # V1.6 #8：離開就結束極速賽（不記紀錄）
	set("rift_on", false)   # V1.6 #10
	set("trio_on", false)   # V1.6 #17
	set("fog_on", false)   # V1.6 #20
	set("tv_mark_mode", false)   # V1.6 #6：標記模式不能帶到別的畫面（Antigravity v160-i1 #1）
	set("tv_marks", [])
	set("ga_coop", false)   # V1.6 #21：續局時從存檔讀回
	set("challenge_army", null)   # 每日高手陣、裂隙的敵陣不能留到一般對 AI（Antigravity v160-i1 #2）
	set("wv_active", false)   # V1.4 #11：離開就結束車輪戰
	set("wv_mode", false)
	set("sealed_on", false)   # V1.4 #13
	set("sealed", [[], []])
	set("ghost_id", "")
	set("wk_active", false)
	set("wg_active", false)   # V1.4 #16：離開就取消押注，不能拿下一場來結算（Codex v140-i2）
	call("_pre_drop")
	Save.retry_pending()   # 第七輪 R7：上次沒寫成功的補寫；還是失敗，標題頁會常駐提示
	sfx.set_muffled(false)
	watch_mode = false
	clutch_t = 0.0
	state = St.TITLE
	overlay = ""
	set("settings_ret", "")
	nav_stack.clear()
	if nav_hub != "":
		overlay = nav_hub   # V1.5.1：從卡片面板進去打完，回來時回到那個面板
	sim = null
	view = null
	zoom = 1.0
	_focus = int(nav_focus.get(overlay, 0)) if overlay != "" else 0   # V1.0.0（Codex v100-i3）：打完回卡片面板，焦點回原卡
	_new_demo()
	sfx.play_music("music_title")
	sfx.play_ambience("")



func _new_demo() -> void:
	var r := RandomNumberGenerator.new()
	r.seed = rng.randi()
	demo = Sim.new(AI.build(0, 100, r)["army"], AI.build(1, 100, r)["army"])
	demo.fast = true
	demo_acc = 0.0



## 第六輪（Codex 實作第 1 輪 #5）：雙人全場被封鎖到跳完手、一方沒有戰鬥兵時，照樣按「開戰」——
## 模擬在第 0 tick 就依 §3.8 判定（有戰鬥兵的一方勝、雙方都沒有＝和局），不能卡在開戰鈕永久灰掉。
# ── 第十輪 T5：只用手把走主要流程。失敗印 PADWALK FAIL，版面檢查會擋 ──
var _pw_bad: Array = []

func _pw_check(cond: bool, what: String) -> void:
	if not cond:
		_pw_bad.append(what)

func _pw_btn(b: int) -> void:
	if ov_trans_k() < 1.0:
		_ov_t = time - 1.0   # 1.4.0 §2.2：轉場中的第一下會被吃掉（設計如此）；走訪時等轉場結束再按（等於玩家等 0.25 秒）
	_trans_reset_input()
	for pressed in [true, false]:
		var ev := InputEventJoypadButton.new()
		ev.button_index = b
		ev.pressed = pressed
		ev.device = 0
		_input(ev)
		await _pw_frames(2)

func _pw_frames(n: int) -> void:
	for i in n:
		await get_tree().process_frame

## 方向鍵走到第 i 顆再按 A；同時確認焦點走得到。
func _pw_pick(i: int, what: String) -> void:
	await _pw_frames(2)
	_pw_check(i < _btns.size(), "%s：沒有第 %d 顆按鈕（共 %d）" % [what, i, _btns.size()])
	var guard := 0
	while _focus != i and guard < 60:
		guard += 1
		await _pw_btn(JOY_BUTTON_DPAD_DOWN)
	_pw_check(_focus == i, "%s：焦點走不到第 %d 顆" % [what, i])
	await _pw_btn(JOY_BUTTON_A)
	await _pw_frames(3)

## 這個畫面的每顆按鈕都走得到、都在畫面內。
func _pw_cycle(what: String) -> void:
	await _pw_frames(2)
	var n: int = _btns.size()
	_pw_check(n > 0, "%s：沒有按鈕" % what)
	for b in _btns:
		_pw_check(Rect2(0, 0, 1280, 800).encloses(b["r"]), "%s：按鈕超出畫面 %s" % [what, str(b["r"])])
	var seen := {}
	for k in n:
		seen[_focus] = true
		await _pw_btn(JOY_BUTTON_DPAD_DOWN)
	_pw_check(seen.size() == n, "%s：焦點只走到 %d／%d 顆" % [what, seen.size(), n])

func _pad_walk() -> void:
	_pw_bad = []
	layout_probe = false
	shot_dir = ""
	rules = null
	overlay = ""
	for nk in ["lobby", "place", "result"]:   # 1.2.0：老闆便條是第一次才跳的疊層，手把流程先當看過（便條本身另有截圖與測試）
		preload("res://scripts/game/guide.gd").see(Save.data, "note_" + nk)
	_go_title()
	await _pw_frames(3)
	await _pw_cycle("標題")
	for step in [[0, "hub_play"], [1, "hub_gauntlet"], [2, "hub_challenge"], [3, "playroom"], [4, "hub_collect"], [5, "settings"]]:   # V1.5：五塊木牌（0～4）＋系統列（5 設定、6 離開；1.5.0 代碼移到收藏，下面另走）
		_go_title()
		await _pw_pick(step[0], "標題→" + str(step[1]))
		_pw_check(overlay == step[1], "標題→%s：現在是 %s" % [step[1], overlay])
		await _pw_cycle(str(step[1]))
		await _pw_btn(JOY_BUTTON_B)
		_pw_check(overlay == "", "%s：B 關不掉" % step[1])
	_go_title()
	await _pw_pick(4, "標題→收藏")
	await _pw_pick(7, "收藏→代碼")   # 1.5.0：代碼在收藏第 8 張
	_pw_check(overlay == "codes", "收藏→代碼：現在是 %s" % overlay)
	await _pw_cycle("codes")
	_go_title()
	await _pw_pick(0, "標題→對戰")
	await _pw_pick(1, "對戰→對 AI 大廳")
	await _pw_cycle("大廳")
	# 1.5.0 §1.2 大廳三步：RB 下一步、LB 上一步、Y 進階折頁；換步後焦點在主鈕（Codex v150 cat03 #5）
	_go_title()
	_open_lobby("ai")   # 上面巡過每顆鈕之後畫面不在大廳了：重新打開
	lobby_step = 0
	lobby_open = false
	lobby_menu = false
	await _pw_frames(3)
	_ov_t = time - 1.0   # 等疊層開始畫、轉場直接到終態（第一下不要被轉場吃掉）
	for st in [1, 2]:
		await _pw_btn(JOY_BUTTON_RIGHT_SHOULDER)
		await _pw_frames(3)
		_pw_check(lobby_step == st, "大廳 RB：應該到第 %d 步，現在 %d（overlay=%s menu=%s open=%s state=%d cmds=%d）" % [st + 1, lobby_step + 1, overlay, str(lobby_menu), str(lobby_open), state, _cmds.size()])
		_pw_check(_focus >= 0 and _focus < _btns.size() and _btns[_focus]["r"].position.x >= 960.0, "大廳換步後焦點不在主鈕（第 %d 步）" % [st + 1])
		await _pw_cycle("大廳第 %d 步" % [st + 1])
	await _pw_btn(JOY_BUTTON_LEFT_SHOULDER)
	await _pw_frames(3)
	_pw_check(lobby_step == 1, "大廳 LB：應該回第 2 步")
	await _pw_btn(JOY_BUTTON_Y)
	await _pw_frames(3)
	_pw_check(lobby_open, "大廳 Y：應該打開進階折頁")
	await _pw_btn(JOY_BUTTON_Y)
	await _pw_frames(3)
	_pw_check(not lobby_open, "大廳 Y：應該收起進階折頁")
	_go_title()
	overlay = "reward"
	await _pw_cycle("獎勵")
	overlay = ""
	rules = RuleSet.standard()
	rules.ai_pool_same = false
	rules.pool = [1023, ~1023 & ((1 << 20) - 1)]
	ban_left = [1, 1]
	overlay = "ban"
	await _pw_cycle("禁牌 20 張")
	overlay = ""
	rules = null
	# 試煉從頭打到結果：擺一隻、開戰、跳過、看結果、回主選單
	_go_title()
	_open("trials")
	await _pw_pick(0, "試煉第 1 關")
	_pw_check(state == St.PLACE, "試煉沒有進擺放")
	await _pw_btn(JOY_BUTTON_LEFT_SHOULDER)
	var ev := InputEventJoypadButton.new()
	ev.button_index = JOY_BUTTON_A
	ev.pressed = true
	_input(ev)
	await _pw_frames(3)
	var ev2 := InputEventJoypadButton.new()
	ev2.button_index = JOY_BUTTON_A
	ev2.pressed = false
	_input(ev2)
	await _pw_frames(3)
	if armies[0].units.is_empty():
		_pw_bad.append("手把 A 擺不下兵")
		armies[0].place_xy(0, armies[0].world_x(3000), 3000)
	await _pw_btn(JOY_BUTTON_START)
	await _pw_frames(5)
	_pw_check(state == St.BATTLE, "Start 沒有開戰，現在 %d" % state)
	await _pw_btn(JOY_BUTTON_B)   # V1.5：B 打開暫停選單（第二項＝直接看結果）
	await _pw_frames(3)
	_pw_check(overlay == "pause_menu" and paused, "B 沒有打開暫停選單，現在 %s" % overlay)
	await _pw_btn(JOY_BUTTON_DPAD_DOWN)
	await _pw_frames(2)
	await _pw_btn(JOY_BUTTON_A)
	var wait := 0
	while state != St.RESULT and wait < 900:
		wait += 1
		await get_tree().process_frame
	_pw_check(state == St.RESULT, "B 跳過後沒進結果頁")
	wait = 0
	while call("_ink_active") and wait < 300:   # 1.2.0：宣紙戰報演完（約 1 秒）才出結果面板
		wait += 1
		await get_tree().process_frame
	await _pw_cycle("結果頁")
	await _pw_btn(JOY_BUTTON_B)
	await _pw_frames(3)
	if overlay == "leave":
		await _pw_pick(1, "離開確認")
	_pw_check(state == St.TITLE, "結果頁 B 沒回標題，現在 %d" % state)
	if _pw_bad.is_empty():
		print("PADWALK OK")
	else:
		print("PADWALK FAIL ", "；".join(_pw_bad))

# ── 第十二輪：手動技能的畫面 ──
func _shots_cmd() -> void:
		Save.data["best_streak"] = maxi(int(Save.data.get("best_streak", 0)), int(Save.data["streak"]))
	else:
		Save.data["streak"] = 0

## 1.5.0 §1.6 戰績三頁籤（原本一頁塞 5 格數字＋20 格兵種＋32 個成就）：總覽／兵種／徽章櫃；每頁非按鈕格 ≤12
var pf_tab := 0
var pf_grp := 0   # 兵種頁：0 王國、1 奇幻
const CareerPF = preload("res://scripts/game/career.gd")

func _draw_profile() -> void:
	var P := Rect2(50, 24, 1180, 752)
	_panel(P)
	var hy := _h1(Vector2(640, 30), L.t("pf_title")) + GAP_L   # 1.2.0：H1 放大，緞帶上移 4（R2）；頁籤從緞帶下緣＋16 起
	var tabw := 200.0
	for i in 3:
		btn_cloth = "tab_indigo" if i == pf_tab else "tab_linen"
		btn_group = "pf_tabs"
		var ii := i
		_btn(Rect2(640 - 1.5 * tabw - 8 + i * (tabw + 8), hy, tabw, 46), L.t("pf_tab_%d" % i), func(): pf_tab = ii; pf_ach_page = 0, true, false, TH_ACTIVE if i == pf_tab else Color(0, 0, 0, 0))
		btn_group = ""
		btn_cloth = ""
	match pf_tab:
		0: _draw_pf_overview(hy + 46.0 + GAP_M)
		1: _draw_pf_units(hy + 46.0 + GAP_M)
		2: _draw_pf_badges(hy + 46.0 + GAP_M)
	_btn(Rect2(340, 722, 160, 44), L.t("back"), func(): _nav_back())
	_btn(Rect2(520, 722, 200, 44), L.t("nem_open"), func(): _nav_push("profile"); overlay = "nemeses")   # V1.4 #2 宿敵戰記
	_btn(Rect2(740, 722, 200, 44), L.t("paint_open"), func(): call("_paint_open"))   # V1.4 #15 塗裝室
	screen_register("profile", "back")

## 總覽：五格大數字（三＋二兩列，留白給木活字）
func _draw_pf_overview(y0: float) -> void:
	var st: Dictionary = Save.data.get("stats", {})
	var cs: Dictionary = Save.data.get("custom_stats", {})
	var g: int = int(st.get("games", 0)) + int(cs.get("games", 0))
	var wn: int = int(st.get("wins", 0)) + int(cs.get("wins", 0))
	var trial := 0
	for v in Save.data.get("trial_stars", {}).values():
		trial += int(v)
	var tiles := [["swords", "pf_games", str(g)], ["trophy", "pf_wins", "%d%%" % (wn * 100 / maxi(1, g))], ["repeat", "pf_streak", "%d / %d" % [int(Save.data.get("streak", 0)), int(Save.data.get("best_streak", 0))]],
		["tower", "pf_trials", "%d / %d" % [trial, TRIALS.size() * 3]], ["road", "pf_gauntlet", "%d / 7" % int(Save.data.get("gauntlet_best", 0))]]
	var tw := 330.0
	var th := 128.0
	for i in tiles.size():
		var row := 0 if i < 3 else 1
		var n := 3 if row == 0 else 2
		var col := i if row == 0 else i - 3
		var x0 := 640.0 - (n * tw + (n - 1) * 16.0) / 2.0
		var r := Rect2(x0 + col * (tw + 16), y0 + 12 + row * (th + 20), tw, th)
		_box(r, Color(0, 0, 0, 0.24), Color(0, 0, 0, 0), 9.0)
		_icon(tiles[i][0], r.position + Vector2(48, th * 0.5), 48.0, ACCENT)
		_text(r.position + Vector2(92, 26), L.t(tiles[i][1]), tz("B"), TXT_DIM, false, false, tw - 104)
		if _width(tiles[i][2], tz("H1"), true) + 10.0 <= tw - 104:
			_woodtype(r.position + Vector2(92, 26 + tz("B") * 1.6), tiles[i][2], tz("H1"), Color.WHITE, false, true)
		else:
			_text(r.position + Vector2(92, 26 + tz("B") * 1.6), tiles[i][2], tz("H1"), Color.WHITE, false, true, tw - 104)
	# 下面一列：最常出戰、勝率最高（至少 3 場）各前三名——總覽頁不只是數字，也看得出自己的習慣
	var ug: Dictionary = Save.data.get("unit_games_rec", {})
	var uw: Dictionary = Save.data.get("unit_wins_rec", {})
	var most: Array = []
	var best: Array = []
	for t in D.total():
		var gg := int(ug.get(str(t), 0))
		if gg > 0:
			most.append([gg, -t, t])
		if gg >= 3:
			best.append([int(uw.get(str(t), 0)) * 1000 / gg, -t, t])
	most.sort()
	most.reverse()
	best.sort()
	best.reverse()
	var by := y0 + 12 + 2 * (th + 20) + 8
	var bh := 706.0 - by   # 到底部按鈕上方 16
	var bw := (2 * tw + 16)
	for c in 2:
		var lst: Array = (most if c == 0 else best).slice(0, 3)
		var br := Rect2(640 - bw - 8 + c * (bw + 16), by, bw, bh)
		if c == 1:
			br.position.x = 640 + 8
		br.size.x = minf(bw, (1080.0 - 16.0) / 2.0)
		if c == 0:
			br.position.x = 640 - 8 - br.size.x
		_box(br, Color(0, 0, 0, 0.18), Color(0, 0, 0, 0), 9.0)
		_text(Vector2(br.position.x + 16, br.position.y + 10), L.t("pf_most" if c == 0 else "pf_best"), tz("B"), ACCENT, false, true, br.size.x - 32)
		if lst.is_empty():
			_text(Vector2(br.get_center().x, br.position.y + bh * 0.5), L.t("pf_none"), tz("S"), TXT_DIM, true, false, br.size.x - 32)
			continue
		for j in lst.size():
			var t2: int = lst[j][2]
			var cx := br.position.x + 16 + j * ((br.size.x - 32) / 3.0)
			var cwid := (br.size.x - 32) / 3.0
			_unit_in(Rect2(cx, br.position.y + 30, cwid, 72), t2, 0, 1.0, 0.95)
			var val := L.t("pf_games_n", [int(lst[j][0])]) if c == 0 else "%d%%" % (int(lst[j][0]) / 10)
			_text(Vector2(cx + cwid * 0.5, br.position.y + 104), L.t("unit_%d" % t2), tz("S"), Color.WHITE, true, false, cwid - 6)
			_text(Vector2(cx + cwid * 0.5, br.position.y + 104 + tz("S") * 1.35), val, tz("S"), ACCENT, true, true, cwid - 6)

## 兵種：一次 10 隻（王國／奇幻切換），每格：兵、出戰勝率、場數、熟練度
func _draw_pf_units(y0: float) -> void:
	var gw := 180.0
	for k in 2:
		btn_group = "pf_grp"
		var kk := k
		_btn(Rect2(640 - gw - 4 + k * (gw + 8), y0, gw, 42), L.t("lb_army_kingdom" if k == 0 else "lb_army_fantasy"), func(): pf_grp = kk, true, false, TH_ACTIVE if k == pf_grp else Color(0, 0, 0, 0))
		btn_group = ""
	var ug: Dictionary = Save.data.get("unit_games_rec", {})   # V1.5.1：場數、勝場同口徑（對 AI、遠征、雙人）
	var uw: Dictionary = Save.data.get("unit_wins_rec", {})
	var old_n := 0
	for v in Save.data.get("unit_games", {}).values():
		old_n += int(v)
	var rec_n := 0
	for v in ug.values():
		rec_n += int(v)
	var head := L.t("pf_units") + ("　" + L.t("pf_units_since") if old_n > rec_n else "")
	_text(Vector2(640, y0 + 52), head, tz("S"), TXT_DIM, true, false, 1000)
	var um := RS.mask(_demo())
	var cw := 200.0
	var chh := 214.0
	var ms: Dictionary = Save.data.get("mastery", {})
	for j in 10:
		var t := pf_grp * 10 + j
		if t >= D.total():
			break
		var r2 := Rect2(640 - (5 * cw + 4 * 12) / 2.0 + (j % 5) * (cw + 12), y0 + 52 + tz("S") * 1.4 + 10 + (j / 5) * (chh + 14), cw, chh)
		_box(r2, Color(0, 0, 0, 0.2), Color(0, 0, 0, 0), 8.0)
		var open: bool = RuleSet.has(um, t)
		_unit_in(Rect2(r2.position + Vector2(0, 6), Vector2(cw, 100)), t, 0, 1.0 if open else 0.3, 0.9)
		_text(Vector2(r2.get_center().x, r2.position.y + 108), L.t("unit_%d" % t), tz("C"), ACCENT, true, true, cw - 12)
		var gg := int(ug.get(str(t), 0))
		var wl := L.t("pf_none") if gg == 0 else "%d%%" % mini(100, int(uw.get(str(t), 0)) * 100 / gg)
		_text(Vector2(r2.get_center().x, r2.position.y + 108 + tz("C") * 1.4), wl, tz("B"), Color.WHITE if gg > 0 else TXT_DIM, true, gg > 0, cw - 12)
		var xp := int(ms.get(str(t), 0))
		var lv := CareerPF.level(xp)
		var nx := CareerPF.next_at(xp)
		var ml := L.t("ms_max", [lv]) if nx <= xp else L.t("ms_line", [lv, xp, nx])
		_text(Vector2(r2.get_center().x, r2.end.y - tz("S") * 1.5 - 6), ml, tz("S"), TXT_DIM, true, false, cw - 12)

## 徽章櫃：一頁 10 個（兩欄五列），條件直接寫在牌子上（不用滑過才看得到）
func _draw_pf_badges(y0: float) -> void:
	var earned: Array = Save.data.get("achievements", [])
	var ach: Dictionary = SteamApi.ACHIEVEMENTS
	var keys := ach.keys()
	var ach_pages := ceili(keys.size() / float(ACH_PAGE))
	pf_ach_page = clampi(pf_ach_page, 0, ach_pages - 1)
	var ht := L.t("pf_ach", [earned.size(), keys.size()])
	_text(Vector2(80, y0 + 6), ht, tz("B"), ACCENT, false, true, 400)
	if ach_pages > 1:
		btn_group = "pf_pager"
		_btn_small(Rect2(1004, y0, 44, 40), "◀", func(): pf_ach_page -= 1, pf_ach_page > 0)
		_btn_small(Rect2(1150, y0, 44, 40), "▶", func(): pf_ach_page += 1, pf_ach_page < ach_pages - 1)
		btn_group = ""
		_text(Vector2(1099, y0 + 6 + (tz("B") - tz("S")) * 0.5), "%d／%d" % [pf_ach_page + 1, ach_pages], tz("S"), Color.WHITE, true, false, 90)
	var cw := 548.0
	var chh := 92.0   # 條件在日文 150% 會兩行
	for i2 in range(pf_ach_page * ACH_PAGE, mini(keys.size(), pf_ach_page * ACH_PAGE + ACH_PAGE)):
		var k: String = keys[i2]
		var on: bool = k in earned
		var j2 := i2 - pf_ach_page * ACH_PAGE
		var ar := Rect2(80 + (j2 % 2) * (cw + 24), y0 + 54 + (j2 / 2) * (chh + 8), cw, chh)
		if on:
			_box(ar, Color(1.0, 0.82, 0.4, 0.14), Color(1.0, 0.82, 0.4, 0.55), 6.0, 1.0)   # V1.1 C4：已解鎖加金框
		else:
			_box(ar, Color(0, 0, 0, 0.16), Color(1, 1, 1, 0.10), 6.0, 1.0)
		draw_rect(Rect2(ar.position + Vector2(1, 4), Vector2(4, ar.size.y - 8)), SteamApi.ACH_CAT_COL.get(SteamApi.ACH_CAT.get(k, ""), Color(1, 1, 1, 0.2)))   # 1.1.0 A15：類別色條
		_icon("star" if on else "lock", Vector2(ar.position.x + 30, ar.get_center().y), 28.0, Color("#ffd166") if on else Color(1, 1, 1, 0.3))
		_text(Vector2(ar.position.x + 56, ar.position.y + 8), str(L.pick(ach[k][0], ach[k][1])), tz("B"), Color.WHITE if on else TXT_DIM, false, true, cw - 68)
		var cond := str(L.pick(ACH_DESC.get(k, ["", ""])[0], ACH_DESC.get(k, ["", ""])[1]))
		_text(Vector2(ar.position.x + 56, ar.position.y + 10 + tz("B") * 1.3), cond, tz("S"), TXT_DIM, false, false, cw - 68)

const ACH_PAGE := 10
var pf_ach_page := 0

