func _ct_reward(k: int) -> String:
	var c: Array = CONTRACTS[k]
	return L.t("ct_gold", [int(c[1])]) if int(c[1]) > 0 else L.t("ct_cap", [int(c[2])])

## 這一站可簽的 2 份契約（同一趟同一站永遠一樣）。
func _contract_offers() -> Array:
	var r := RandomNumberGenerator.new()
	r.seed = gauntlet_seed * 53 + gauntlet_stage * 389 + 11
	var ids: Array = range(CONTRACTS.size())
	var out: Array = []
	while out.size() < 2:
		var k: int = ids[r.randi() % ids.size()]
		ids.erase(k)
		out.append(k)
	out.sort()
	return out

## 簽了的契約這一戰的代價（預算、隻數），在 _gauntlet_next 之後套上。
func _apply_contract_cost() -> void:
	if gauntlet_contract < 0 or armies.is_empty():
		return
	var c: Array = CONTRACTS[gauntlet_contract]
	armies[0].budget += int(c[3])
	armies[0].unit_cap = maxi(4, armies[0].unit_cap + int(c[4]))
func test_crowded_pages_v150() -> void:
	var GS = load("res://scripts/ui/game_screens.gd")
	ok(GS.TRIAL_PAGE == 8 and ceili(GS.TRIALS.size() / float(GS.TRIAL_PAGE)) == 4, "試煉每頁 8 關、30 關分 4 頁", str(GS.TRIAL_PAGE))
	ok(GS.ACH_PAGE <= 12, "徽章櫃每頁 ≤12 個（方案 §1.6：非按鈕格 ≤12）")
	var LR = load("res://scripts/ui/layout_rules.gd")
	ok("profile" in LR.R14_ENFORCE and int(LR.R14_LIMITS["profile"]) == 6, "戰績轉成已改造類別（上限 6）")
	var gm: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_modes.gd")
	ok(gm.find("0: _draw_pf_overview()") >= 0 and gm.find("1: _draw_pf_units()") >= 0 and gm.find("2: _draw_pf_badges()") >= 0, "戰績分三頁籤：總覽／兵種／徽章櫃")
	ok(gm.find("_btns.append({\"r\": ar, \"cb\": func(): pass") < 0, "成就不再是看不見的焦點目標（條件直接寫在牌子上）")
	var g = GS.new()
	g.pf_tab = 2
	g.pf_ach_page = 3
	ok(g.pf_tab == 2, "頁籤狀態可設")
	g.free()
