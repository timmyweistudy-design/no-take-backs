    71	## 這場要用到的兵種。缺的才烘；烘的時候呼叫端先直接畫。
    72	func ensure(types: Array) -> void:
    73		if DisplayServer.get_name() == "headless" or ready_cb < 0:
    74			return
    75		for t in types:
    76			if not loc.has(t) and not t in _queue and not t in _baking:
    77				_queue.append(t)
    78		if _busy or _queue.is_empty():
    79			return
    80		_busy = true
    81		var g0 := _gen   # 世代變了（build 清空並重設狀態）就不再碰共用狀態（Codex v120-final）
    82		while not _queue.is_empty():
    83			var chunk: Array = _queue.slice(0, TYPES_PER_PAGE)
    84			_queue = _queue.slice(chunk.size())
    85			_baking = chunk
    86			await _bake_page(chunk)
    87			if g0 != _gen:
    88				return
    89			_baking = []
    90		_busy = false
    91	
    92	func _viewport(size: Vector2i, painter: Node) -> SubViewport:
    93		var vp := SubViewport.new()
    94		vp.size = size
    95		vp.transparent_bg = true
    96		vp.render_target_update_mode = SubViewport.UPDATE_ONCE
    97		vp.add_child(painter)
    98		add_child(vp)
    99		return vp
   100	
   101	func _bake_page(types: Array) -> void:
   102		var gen0 := _gen
   103		var cb := ready_cb == 1
   104		var total := types.size() * 2 * FRAMES_PER
   105		var rows := int(ceil(float(total) / COLS))
   106		var painter := _Painter.new()
   107		painter.cb = cb
   108		painter.types = types
   109		var vp := _viewport(Vector2i(COLS * CELL, rows * CELL), painter)
   110		await RenderingServer.frame_post_draw
   111		await RenderingServer.frame_post_draw
   112		var img := vp.get_texture().get_image()
   113		vp.queue_free()
   114		img = await _post(img)
   115		if (1 if cb else 0) != ready_cb or gen0 != _gen:
   116			return   # 烘的時候換了配色（或重建了）：這一批作廢
   117		# 新兵頁太多就丟最舊的（舊 10 種那兩頁不丟）
   118		if pages.size() >= MAX_PAGES:
   119			for i in pages.size():
   120				if pages[i] != null and int(pages[i]["types"][0]) >= D.COUNT:
   121					for t in pages[i]["types"]:
   122						if loc.has(t) and int(loc[t][0]) == i:
   123							loc.erase(t)
   124					pages[i] = null
   125					break
   126		var pn := pages.size()
   127		pages.append({"tex": ImageTexture.create_from_image(img), "types": types})
   128		for k in types.size():
   129			loc[types[k]] = [pn, k * 2 * FRAMES_PER]
   130	
   131	## V1.2 D1：烘好的整頁再跑一次後處理 shader（外輪廓＋頂亮底暗）。沒有 shader 檔或 plain_ui 時原樣。
   132	func _post(img: Image) -> Image:
   133		var sh_path := "res://shaders/unit_bake.gdshader"
   134		if not ResourceLoader.exists(sh_path) or bool(Save.s("plain_ui")):
   135			return img
   136		var tr := TextureRect.new()
   137		tr.texture = ImageTexture.create_from_image(img)
   138		tr.size = Vector2(img.get_width(), img.get_height())
   139		var mat := ShaderMaterial.new()
   140		mat.shader = load(sh_path)
   141		mat.set_shader_parameter("cell", float(CELL))
   142		mat.set_shader_parameter("per", float(FRAMES_PER))
   143		mat.set_shader_parameter("cols", float(COLS))
   144		tr.material = mat
   145		var vp := _viewport(Vector2i(img.get_width(), img.get_height()), tr)
   146		await RenderingServer.frame_post_draw
   147		await RenderingServer.frame_post_draw
   148		var out := vp.get_texture().get_image()
   149		vp.queue_free()
   150		return out
   151	
   152	func _bake_ring(cb: bool) -> void:
   153		var painter := _RingPainter.new()
   154		painter.cb = cb
   155		var vp := _viewport(Vector2i(4 * CELL, CELL), painter)
   156		var g0 := _gen
   157		await RenderingServer.frame_post_draw
   158		await RenderingServer.frame_post_draw
   159		if g0 == _gen:
   160			ring_tex = ImageTexture.create_from_image(vp.get_texture().get_image())
   161		vp.queue_free()
   162	
   163	## variant 1（劍士交替招式）和 2（第四輪新兵的專屬動作）都用第二組攻擊格：新兵沒有交替招式，那一組烘的是專屬動作。
   164	func frame_index(type: int, team: int, walk: float, atk: float, t: float, px: float, variant := 0) -> int:
   165		var base: int = int(loc[type][1]) + team * FRAMES_PER
   166		if atk > 0.0:
   167			return base + 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * mini(variant, 1) + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
   168		if walk <= Gait.POSE_DAZE + 1.0:
   169			return base + 2 + WALK_FRAMES + 1
   170		if walk <= Gait.POSE_DRAG + 1.0:
   171			return base + 2 + WALK_FRAMES
   172		if walk != 0.0:
   173			return base + 2 + int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES
   174		var ex := 2.0 if type == D.CAVALRY else 3.5   # Art._eyes 的眼睛中心 x
   175		var blink := fmod(t + ex * 0.13, 3.7) <= 0.12   # 與 Art._eyes 相同的眨眼節奏
   176		return base + (1 if blink else 0)
   177	
   178	func draw_ring(ci: CanvasItem, p: Vector2, team: int, type: int, scale := 1.0) -> void:
   179		var idx := team * 2 + (1 if (type == D.SHIELD or type == D.CAVALRY or type == 19) else 0)
   180		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
   181		ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2(idx * CELL, 0, CELL, CELL))
   182		ci.draw_set_transform_matrix(Art.base)
   183	
   184	func _rect(idx: int) -> Rect2:
   185		return Rect2((idx % COLS) * CELL, (idx / COLS) * CELL, CELL, CELL)
   186	
   187	## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
   188	func quant_walk(walk: float) -> float:
   189		if walk == 0.0:
   190			return 0.0
   191		if walk < -50.0:
   192			return walk
   193		return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES
   194	
   195	func quant_atk(atk: float) -> float:
   196		if atk <= 0.0:
   197			return 0.0
   198		return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES
   199	
   200	## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
   201	func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
   202			hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false, variant := 0) -> void:
   203		var idx := frame_index(type, team, walk, atk, t, p.x, variant)
   204		if atk > 0.0:
   205			walk = 0.0   # 攻擊影格烘焙時沒有走路相位：貼圖與疊加都當成沒在走（Codex 收尾輪 #4）
   206		var bob := Art.idle_bob(t, p.x) if walk == 0.0 else 0.0   # 與 Art.unit 相同：沒走路時（含攻擊）都有呼吸
   207		var xf := Art.base * Transform2D(lean * face, Vector2(scale * face / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale))
   208		ci.draw_set_transform_matrix(xf)
   209		ci.draw_texture_rect_region(pages[loc[type][0]]["tex"], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
   210		if hurt > 0.0 or mood != 0:
   211			# 攻擊影格烘焙時沒有走路相位（Codex R5 #3）
   212			var qa := quant_atk(atk)
   213			var qw := 0.0 if qa > 0.0 else quant_walk(walk)
   214			ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, face, qw, qa, t, scale, lean, crouch, type) * Gait.body_xf(type, qw))
   215			if hurt > 0.0:
   216				ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, false)
   217			if mood != 0:
   218				Art.overlay(ci, type, team, mood, alpha, t, cb)
   219		ci.draw_set_transform_matrix(Art.base)
   220	
   221	## 烘焙用的畫家：一格一格呼叫 Art.unit（face＝+1，翻面由貼圖時處理）。
   222	class _Painter extends Node2D:
   223		var cb := false
   224		var types: Array = []
   225		func _draw() -> void:
   226			var Art2 = preload("res://scripts/ui/art.gd")
   227			var D2 = preload("res://scripts/core/unit_defs.gd")
   228			var saved: Transform2D = Art2.base
   229			Art2.base = Transform2D.IDENTITY
   230			var CELL2 := 192
   231			var RS2 := 1.6
   232			var W2 := 8
   233			var per := 2 + W2 + 2 + 8 + 8
   234			var cols := 16
   235			for k in types.size():
   236				var type: int = types[k]
   237				for team in 2:
   238					for f in per:
   239						var idx: int = (k * 2 + team) * per + f
   240						var cell_o := Vector2((idx % cols) * CELL2, (idx / cols) * CELL2)
   241						var walk := 0.0
   242						var atk := 0.0
   243						var vr := 0
   244						if f >= 2 and f < 2 + W2:
   245							walk = 0.0001 + (f - 2) * TAU / W2
   246						elif f == 2 + W2:
   247							walk = -100.0   # 拖行（Gait.POSE_DRAG）
   248						elif f == 3 + W2:
   249							walk = -200.0   # 暈眩（Gait.POSE_DAZE）
   250						elif f >= 4 + W2 + 8:
   251							atk = (f - (4 + W2 + 8) + 0.5) / 8.0
   252							vr = 1 if type < D2.CLASSIC else 2   # 第四輪新兵沒有交替招式，這一組放專屬動作（variant 2）
   253						elif f >= 4 + W2:
   254							atk = (f - (4 + W2) + 0.5) / 8.0
   255						var p := cell_o + (Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160)))
   256						var ex := 2.0 if type == D2.CAVALRY else 3.5
   257						# 眨眼那一格落在眨眼區間中間；其他格取 1.0（不在眨眼區間）
   258						var tt: float = (3.7 - ex * 0.13 + 0.05) if f == 1 else 1.0
   259						# 沒走路的格子（待機、眨眼、攻擊）Art.unit 會加呼吸位移；這裡反向抵銷，貼圖時再依當下時間加
   260						var pb := p
   261						if walk == 0.0:
   262							pb.y -= sin(tt * 3.0 + p.x * 0.05) * 0.8 * RS2
   263						Art2.unit(self, pb, type, team, 1.0, walk, atk, 0.0, 1.0, tt, RS2, cb, 0, 0.0, 1.0, vr)
   264			Art2.base = saved
   265	
   266	class _RingPainter extends Node2D:
   267		var cb := false
   268		func _draw() -> void:
   269			var Art2 = preload("res://scripts/ui/art.gd")
   270			var D2 = preload("res://scripts/core/unit_defs.gd")
   271			var saved: Transform2D = Art2.base
   272			Art2.base = Transform2D.IDENTITY
   273			for team in 2:
   274				for heavy in 2:
   275					var o := Vector2((team * 2 + heavy) * 192, 0) + Vector2(96, 140)
   276					Art2.ring(self, o, team, D2.SHIELD if heavy == 1 else D2.SWORD, cb, 1.6)
   277			Art2.base = saved

