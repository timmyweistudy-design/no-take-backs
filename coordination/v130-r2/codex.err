   561				for sk0 in 3:
   562					var sa0 := time * 5.0 + sk0 * TAU / 3.0
   563					_icon("star", p + Vector2(cos(sa0) * 15.0, -60.0 + sin(sa0) * 5.0), 13.0, Color("#ffd166"))
   564			_unit(p, u.type, u.team, face, walk, at, hurt, alpha, time, UNIT_SCALE, mood, lean, crouch, variant)
   565			if live and not u.hidden:
   566				xray.append([p, [u.type, u.team, face, walk, at, alpha, lean, crouch, variant]])
   567			# 揮擊殘影（第三輪 R1、S4 依兵種分開）
   568			if live and at >= Art.ATK_WINDUP and at < Art.ATK_STRIKE + 0.12:
   569				var sk := clampf((at - Art.ATK_WINDUP) / (Art.ATK_STRIKE + 0.12 - Art.ATK_WINDUP), 0.0, 1.0)
   570				_draw_smear(p, u.type, u.team, face, sk, alpha, variant, 1.0)
   571			# 衝鋒就緒的金色拖尾（第三輪 R3）
   572			if u.type == D.CAVALRY and moving and u.charge >= D.CHARGE_NEED:
   573				var tip := p + Vector2(face * 26.0, -44.0)
   574				for k in 4:
   575					var q0 := tip - Vector2(face * k * 8.0, 0)
   576					var q1 := tip - Vector2(face * (k + 1) * 8.0, 0)
   577					draw_line(q0, q1, Color(1.0, 0.86, 0.3, (0.8 - k * 0.2) * alpha), 3.0 - k * 0.5, true)
   578		_draw_xray(xray)
   579		while prop_i < fld_props.size():
   580			MapArt.draw_prop(self, ORIGIN, fld_props[prop_i], time)
   581			prop_i += 1
   582		for pp in pot_draw:
   583			draw_circle(pp, 6.5, Art.OUT, true, -1.0, true)
   584			draw_circle(pp, 5.0, Color("#2a2533"), true, -1.0, true)
   585			draw_circle(pp + Vector2(3, -5), 2.0, Color(1, 0.8, 0.3), true, -1.0, true)
   665		var u := minf(k / 0.55, 1.0)         # 倒下的主要段落
   666		var e := 1.0 - (1.0 - u) * (1.0 - u)
   667		var al := 1.0 - maxf(0.0, (k - 0.45) / 0.3)
   668		if al <= 0.0:
   669			return
   670		var lean := 0.0
   671		var crouch := 1.0
   672		var hurt := maxf(0.0, 0.8 - k * 3.0)
   673		match t:
   674			D.CAVALRY:
   675				lean = e * 1.45          # 連人帶馬往前翻
   676			D.BERSERKER, D.PIKE:
   677				lean = -e * 1.5          # 仰天倒下
   678			D.SHIELD, D.SWORD, D.DRUMMER:
   679				lean = e * 1.2           # 往前跪倒
   680				crouch = 1.0 - e * 0.25
   681			D.ARCHER, D.BOMBER, D.MEDIC:
   682				crouch = 1.0 - e * 0.45  # 坐倒
   683				lean = -e * 0.35
   684			D.ASSASSIN:
   685				al *= 1.0 - u * 0.8      # 化煙
   686				for i in 5:
   687					var a0 := i * TAU / 5.0 + k * 2.0
   688					draw_circle(p + Vector2(cos(a0) * (6 + k * 30), -20 - k * 24 + sin(a0) * 6), 7.0 * (1.0 - k), Color(0.25, 0.2, 0.35, 0.5 * (1.0 - k)), true, -1.0, true)
   689			10:
   690				crouch = 1.0 - e * 0.7   # 孢子菇癟掉
   691			11:
   692				al *= 1.0 - u            # 羊：羊毛飛散
   693				for i in 7:
   694					var a1 := i * TAU / 7.0
   695					draw_circle(p + Vector2(cos(a1), sin(a1) * 0.6 - 0.8) * (8 + k * 46), 6.0 * (1.0 - k), Color(Art.team_color(g["team"], cbm()).lightened(0.3), 0.8 * (1.0 - k)), true, -1.0, true)
   696			12:
   697				lean = e * 0.5           # 箱子翻倒，鉚釘掉落
   698				for i in 4:
   699					draw_circle(p + Vector2((i - 1.5) * (6 + k * 14), -14 + k * k * 14), 1.8, Color(Art.GOLD, 1.0 - k), true, -1.0, true)
   700			13, 20:
   701				crouch = 1.0 - e * 0.8   # 史萊姆化開成一灘
   702				draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.4), 0, p))
   703				draw_circle(Vector2.ZERO, 8.0 + e * 16.0, Color(Art.team_color(g["team"], cbm()), 0.45 * (1.0 - k)), true, -1.0, true)
   704				draw_set_transform_matrix(_cam)
   705			14:
   706				p += Vector2(0, -e * 34.0)   # 幽靈往上消散
   707				al *= 1.0 - u * 0.7
   708			16, 17, 21, 15:
   709				crouch = 1.0 - e * 0.5   # 散開：骨頭、沙粒、布屑往外
   710				var col := Color("#ece6d6") if t != 16 and t != 15 else (Color("#ffd166") if t == 16 else Color("#e8d3a8"))
   711				for i in 6:
   712					var a2 := i * TAU / 6.0 + float(g.get("seed", 0.0))
   713					var r2 := 8.0 + e * 26.0
   714					draw_circle(p + Vector2(cos(a2) * r2, -18.0 + sin(a2) * r2 * 0.5 + k * k * 22.0), 3.0 * (1.0 - k * 0.6), Color(col, 1.0 - k), true, -1.0, true)
   715			18:
   716				lean = -e * 0.9          # 吸塵貓往後坐倒
   717			19:
   718				crouch = 1.0 - e * 0.55  # 石魔碎裂
   719				for i in 8:
   720					var a3 := i * TAU / 8.0
   721					var r3 := 10.0 + e * 34.0
   722					draw_circle(p + Vector2(cos(a3) * r3, -14.0 + sin(a3) * r3 * 0.45 + k * k * 24.0), 5.0 * (1.0 - k * 0.5), Color(Color("#8d8a80"), 1.0 - k), true, -1.0, true)
   723		_unit(p, t, g["team"], face, 0.0, 0.0, hurt, al, time, UNIT_SCALE, 1 if k < 0.4 else 0, lean, maxf(crouch, 0.15))
   724	
     1	extends RefCounted
     2	## 展示緩衝（第二輪方案 R5、§3）：戰鬥畫面固定比模擬晚 DELAY 個 tick。
     3	## 模擬先跑，每個 tick 存一份「畫面需要的狀態」快照＋事件；畫面依展示時鐘一格一格播。
     4	## 這樣命中事件在畫面上發生前 DELAY 個 tick 就知道了，可以先演前搖；
     5	## 血量、死亡、音效、HUD、跳字全部讀同一個延後的快照，所以一起延後，不會只有動作延後。
     6	## 純演出：模擬本身的計算、結果、指紋完全不受影響。
     7	
     8	const DELAY := 2
     9	
    10	class VUnit:
    11		var hidden := false
    12		var link := -1
    13		var windup := 0
    14		var guard := 0
    15		var summon := false
    16		var id: int
    17		var team: int
    18		var type: int
    19		var x: int
    20		var y: int
    21		var hp: int
    22		var max_hp: int
    23		var alive: bool
    24		var stealth: int
    25		var stun: int
    26		var shield := 0
    27		var haste_t := 0
    28		var fx: int
    29		var fy: int
    30		var mx: int
    31		var my: int
    32		var charge: int
    33		var target: int
    34		var breach: int            # 第四輪：被破陣剩幾 tick
    35		var aura: int              # 第四輪：在鼓手光環內
    36		var bmode: int             # 第四輪：投彈兵模式
    37	
    38	var units: Array = []          # 跟 sim.units 同順序
    39	var tick := 0
    40	var rally := [false, false]
    41	var frenzy := false
    42	var events: Array = []         # 這一格（畫面上剛發生）的事件
    43	var finished := false          # 畫面已經播到模擬的最後一 tick
    44	var budget := 100
    45	var budgets := [100, 100]      # 第五輪：兩邊預算（讓子時不同；舊判定時兩格都＝藍方預算）
    46	var max_ticks := 1800          # 第五輪：這一局的長度（一局時間可調）
    47	
    48	func budget_of(t: int) -> int:
    49		return int(budgets[t])
    50	var zones: Array = []
    51	var _power := [0, 0]
    52	var _alive := [0, 0]
    53	var _by_id := {}
    54	var queue: Array = []          # 還沒播的快照（模擬已經跑到、畫面還沒到）
    55	
    56	## 把模擬當下的狀態存成一份快照。
    57	static func capture(sim) -> Dictionary:
    58		var us: Array = []
    59		for u in sim.units:
    60			us.append([u.id, u.team, u.type, u.x, u.y, u.hp, u.max_hp, u.alive, u.stealth, u.stun, u.fx, u.fy, u.mx, u.my, u.charge, u.target, u.breach, u.aura, u.bmode, 1 if u.hidden else 0, u.link, u.windup, u.guard, u.summon, u.shield, u.haste_t])
    61		return {"tick": sim.tick, "units": us, "events": sim.events.duplicate(true), "rally": sim.rally.duplicate(),
    62			"frenzy": sim.frenzy, "finished": sim.finished, "power": [sim.power(0), sim.power(1)],
    63			"alive": [sim.alive_count(0), sim.alive_count(1)], "zones": sim.zones.duplicate()}
    64	
    65	func _init(sim = null) -> void:
    66		if sim != null:
    67			budget = sim.budget
    68			budgets = sim.budgets.duplicate()
    69			max_ticks = sim.max_ticks
    70			apply(capture(sim))
    71			events = []
    72	
    73	func apply(fr: Dictionary) -> void:
    74		var us: Array = fr["units"]
    75		if units.size() != us.size():
    76			units.clear()
    77			_by_id.clear()
    78			for i in us.size():
    79				var v := VUnit.new()
    80				units.append(v)
    81		for i in us.size():
    82			var a: Array = us[i]
    83			var v: VUnit = units[i]
    84			v.id = a[0]; v.team = a[1]; v.type = a[2]; v.x = a[3]; v.y = a[4]; v.hp = a[5]; v.max_hp = a[6]
    85			v.shield = a[a.size() - 2]; v.haste_t = a[a.size() - 1]
    86			v.alive = a[7]; v.stealth = a[8]; v.stun = a[9]; v.fx = a[10]; v.fy = a[11]; v.mx = a[12]; v.my = a[13]
    87			v.charge = a[14]; v.target = a[15]
    88			v.breach = a[16] if a.size() > 16 else 0
    89			v.aura = a[17] if a.size() > 17 else 0
    90			v.bmode = a[18] if a.size() > 18 else 0
    91			v.hidden = a[19] == 1 if a.size() > 19 else false
    92			v.link = a[20] if a.size() > 20 else -1
    93			v.windup = a[21] if a.size() > 21 else 0
    94			v.guard = a[22] if a.size() > 22 else 0
    95			v.summon = a[23] if a.size() > 23 else false
    96			_by_id[v.id] = v
    97		tick = fr["tick"]
    98		events = fr["events"]
    99		rally = fr["rally"]
   100		frenzy = fr["frenzy"]
   101		finished = fr["finished"]
   102		_power = fr["power"]
   103		_alive = fr["alive"]
   104		zones = fr.get("zones", [])
   105	
   106	func power(t: int) -> int:
   107		return _power[t]
   108	
   109	func alive_count(t: int) -> int:
   110		return _alive[t]
   111	
   112	func unit_by_id(id: int):
   113		return _by_id.get(id)
   114	
   115	## 模擬往前跑，直到緩衝裡有 DELAY 份還沒播的快照（或模擬結束）。回傳這次新加的快照，給前搖預告用。
   116	func pump(sim) -> Array:
   117		var added: Array = []
   118		while queue.size() < DELAY and not sim.finished:
   119			sim.step()
   120			var fr := capture(sim)
   121			queue.append(fr)
   122			added.append(fr)
   123		return added
   124	
   125	## 畫面前進一格；沒有可播的就回傳 false。
   126	func advance() -> bool:
   127		if queue.is_empty():
   128			return false
   129		apply(queue.pop_front())
   130		return true
