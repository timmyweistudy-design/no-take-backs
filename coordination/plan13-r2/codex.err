    10	## 和遊戲同一套算法。回傳 [星數, 剩餘%, 花費]。
    11	func judge(pz: Dictionary, ex: Array) -> Array:
    12		var a0: Army = P.player_army(pz)
    13		var fixed_budget: int = a0.budget - int(pz["budget"])
    14		for e in ex:
    15			a0.units.append({"type": int(e[0]), "col": int(e[1]), "row": int(e[2])})
    16		var extra: int = a0.spent() - fixed_budget
    17		var s := Sim.new(a0, P.enemy_army(pz))
    18		s.fast = true
    19		s.run_to_end()
    20		var rem: int = P.rem_pct(s.power(0), s.budget) if s.winner == 0 else 0
    21		return [P.stars(pz, s.winner == 0, rem, extra), rem, extra]
    22	
    23	func legal(pz: Dictionary, ex: Array) -> bool:
    24		var a0: Army = P.player_army(pz)
    25		for e in ex:
    26			if a0.check_place(int(e[0]), int(e[1]), int(e[2])) != "":
    27				return false
    28			a0.place(int(e[0]), int(e[1]), int(e[2]))
    29		return true
    30	
    31	## 分數：先看星數，再看離兩個條件多近。
    32	func score(pz: Dictionary, ex: Array) -> int:
    33		var j: Array = judge(pz, ex)
    34		var v: int = int(j[0]) * 100000 + int(j[1]) * 10
    35		v -= maxi(0, int(j[2]) - int(pz["star3"])) * 200
    36		return v
    37	
    38	func mutate(pz: Dictionary, ex: Array, allowed: Array, rng: RandomNumberGenerator) -> Array:
    39		var e2: Array = ex.duplicate(true)
    40		match rng.randi_range(0, 3):
    41			0:
    42				if not e2.is_empty():
    43					var i := rng.randi_range(0, e2.size() - 1)
    44					e2[i][1] = clampi(int(e2[i][1]) + rng.randi_range(-2, 2), 0, 5)
    45					e2[i][2] = clampi(int(e2[i][2]) + rng.randi_range(-2, 2), 0, 8)
    46			1:
    47				if not e2.is_empty():
    48					e2[rng.randi_range(0, e2.size() - 1)][0] = allowed[rng.randi_range(0, allowed.size() - 1)]
    49			2:
    50				if not e2.is_empty():
    51					e2.remove_at(rng.randi_range(0, e2.size() - 1))
    52			3:
    53				e2.append([allowed[rng.randi_range(0, allowed.size() - 1)], rng.randi_range(0, 5), rng.randi_range(0, 8)])
    54		return e2 if legal(pz, e2) else ex
    55	
    56	func search(pz: Dictionary, iters: int) -> Array:
    57		var allowed: Array = pz["allowed"]
    58		var best: Array = []
    59		var bs: int = LOW
    60		for sol in pz.get("solutions", []):
    61			var sc: int = score(pz, sol)
    62			if sc > bs:
    63				bs = sc
    64				best = sol
    65		var rng := RandomNumberGenerator.new()
    66		rng.seed = 4242
    67		for restart in 6:
    68			var cur: Array = best.duplicate(true) if restart < 2 else []
    69			var cs: int = score(pz, cur) if not cur.is_empty() else LOW
    70			for it in iters / 6:
    71				var c2: Array = mutate(pz, cur, allowed, rng)
    72				var s2: int = score(pz, c2) if not c2.is_empty() else LOW
    73				if s2 >= cs:
    74					cur = c2
    75					cs = s2
    76				if cs >= 300000:
    77					break
    78			if cs > bs:
    79				bs = cs
    80				best = cur
    81			if bs >= 300000:
    82				break
    83		return best
    84	
    85	func _init() -> void:
    86		var want := ""
    87		var iters := 600
    88		for x in OS.get_cmdline_user_args():
    89			if x.begins_with("--id="):
    90				want = x.substr(5)
    91			if x.begins_with("--iters="):
    92				iters = int(x.substr(8))
    93		for pz in P.puzzles() + P.new_puzzles() + P.fantasy_puzzles():
    94			if want != "" and pz["id"] != want:
    95				continue
    96			var sols: Array = []
    97			for sol in pz.get("solutions", []):
    98				sols.append(judge(pz, sol))
    99			var b: Array = search(pz, iters)
   100			var j: Array = judge(pz, b)
