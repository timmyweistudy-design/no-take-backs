   248	## 前搖結束，放招。
   249	func _v8_fire(i: int, n: int, long_stun: Dictionary, knock2: Array, raises: Array, hits: Array) -> void:
   250		var u := units[i]
   251		match u.type:
   252			F8.SPRITE:
   253				u.used = true
   254				for j in n:
   255					var o := units[j]
   256					if not o.alive or M.dist2(u.x, u.y, o.x, o.y) > F8.SPRITE_R * F8.SPRITE_R:
   257						continue
   258					if o.team == u.team:
   259						o.guard = F8.SPRITE_GUARD
   260					elif not o.hidden:
   261						long_stun[j] = true
   262				events.append({"kind": EV.TIMESTOP, "src": u.id, "tags": [EV.TIMESTOP]})
   263			F8.BONE:
   264				var c := _v8_corpse(i, n)
   265				if c != -1:
   266					raises.append([i, c])
   267			F8.GOLEM:
   268				for j in n:
   269					var e2 := units[j]
   270					if not e2.alive or e2.team == u.team or e2.hidden or M.dist2(u.x, u.y, e2.x, e2.y) > F8.GOLEM_R * F8.GOLEM_R:
   271						continue
   272					hits.append([i, j, F8.GOLEM_STOMP * atk_pct[F8.GOLEM] / 100, EV.SPLASH, [EV.SPLASH]])   # 第十二輪：拍地有傷害
   273					if e2.type != F8.GOLEM and e2.type != F8.SPORE:
   274						knock2.append([j, e2.x - u.x, e2.y - u.y])
   275				events.append({"kind": EV.STOMP, "src": u.id, "tags": [EV.STOMP]})
   276	
   277	## 這一 tick 放招的吸塵貓：每隻敵兵只被最近的那隻拉（平手鍵鏡像不變，和貓的順序無關）。孢子菇、偽裝中不拉。
   278	func _v8_vacuum(n: int, cats: Array) -> void:
   279		for c in cats:
   280			events.append({"kind": EV.VACUUM, "src": units[c].id, "tags": [EV.VACUUM]})
   281		for j in n:
   282			var e := units[j]
   283			if not e.alive or e.hidden or e.type == F8.SPORE or e.pull_t > 0:
   284				continue
   285			var best := -1
   286			var bd := 0
   287			for c in cats:
   288				var u := units[c]
   289				if u.team == e.team or not u.alive:
   290					continue
   291				var d2 := M.dist2(u.x, u.y, e.x, e.y)
   292				if d2 <= F8.CAT_R * F8.CAT_R and (best == -1 or _tie_less(d2, u, bd, units[best])):
   293					best = c
   294					bd = d2
   295			if best == -1:
   296				continue
   297			var cat := units[best]
   298			var dx: int = cat.x - e.x
   299			var dy: int = cat.y - e.y
   300			var l := M.isqrt(dx * dx + dy * dy)
   301			if l <= F8.CAT_STOP:
   302				continue      # 已經貼身：不拉、不定身，也不會被推開
   303			var amt := mini(l - F8.CAT_STOP, F8.CAT_PULL)
   304			if e.type == D.CAVALRY or e.type == F8.GOLEM:
   305				amt /= 2
   306			e.pull_t = F8.CAT_PULL_TICKS
   307			e.stun = maxi(e.stun, F8.CAT_PULL_TICKS + 1)   # 被吸的時候不能出手（放招當 tick 會先扣 1）
   308			e.pull_x = dx * amt / l / F8.CAT_PULL_TICKS
   309			e.pull_y = dy * amt / l / F8.CAT_PULL_TICKS
   310	
   311	## 爆爆羊爆炸。died＝半路被打死（小範圍、友敵都傷）。同一隻單位一 tick 最多吃 BLAST_CAP 次，敵方的羊優先、再比位置，順序鏡像不變。
   312	func _v8_voodoo(n: int, hits: Array, voodoo: Array) -> void:
   313		var capped := _v8_cap_blasts(hits)
   314		hits.clear()
   315		hits.append_array(capped)
   316		var incoming := PackedInt64Array()
   317		incoming.resize(n)
   318		for h in hits:
   319			incoming[h[1]] += h[2]
   320		for i in n:
   321			var u := units[i]
   322			if u.guard > 0:
   323				for h in hits:
   324					if h[1] == i:
   325						h[2] = h[2] / 2
   326		if skill_off.has("voodoo"):
   327			return
   328		var extra: Array = []
   329		for i in n:
   330			var u := units[i]
   331			if u.type != F8.DOLL or not u.alive or u.link < 0 or not units[u.link].alive:
   332				continue
   333			var total := 0
   334			for h in hits:
   335				if h[1] == i:
   336					var part: int = h[2] / 2
   337					h[2] -= part
   338					total += part
   339			if total > 0:
   340				extra.append([i, u.link, total, EV.VOODOO, [EV.VOODOO]])
   341		hits.append_array(extra)
   342	
   343	## 單位倒下：史萊姆分裂、石魔留碎石、羊排到下一 tick 爆。
   344	func _v8_on_death(i: int, killer: int) -> void:
   345		var u := units[i]
   346		if u.type == F8.SHEEP and not u.exploded:
   347			_pending_blast.append([i, killer])
   348		elif u.type == F8.SLIME and not skill_off.has("split"):
   349			for j in range(i + 1, units.size()):
   350				var c := units[j]
   351				if c.parent == i and c.dormant:
   352					c.dormant = false
   353					c.alive = true
   354					c.x = u.x
   355					c.y = clampi(u.y + (F8.SLIME_OFFSET if c.sub == 0 else -F8.SLIME_OFFSET), EDGE, fh - EDGE)
   356					if terrain != null and terrain.blocked(c.x, c.y, c.team):
   357						c.y = u.y     # 裂到牆裡：留在母體位置，碰撞會把它們推開
   358					c.cd = c.cd_base * 4
   359					events.append({"kind": EV.SPLIT, "src": c.id, "tgt": c.id, "tags": [EV.SPLIT]})
   360		elif u.type == F8.GOLEM and not skill_off.has("stomp"):
   361			zones.append([u.x, u.y, tick + F8.ROCK_TICKS, u.team])
   362			events.append({"kind": EV.ROCK, "src": u.id, "tgt": u.id, "tags": [EV.ROCK]})
   363	
   364	## ⑤ 之後、判定結束之前：骷髏站起來（下一 tick 才行動）、碎石區到期。
   365	func _v8_post_tick(raises: Array) -> void:
   366		raises.sort_custom(func(a, b): return _tie_less(0, units[a[0]], 0, units[b[0]]))
   367		for r in raises:
   368			var m := units[r[0]]
   369			var c := units[r[1]]
   370			if not m.alive or c.raised or c.alive:
   371				continue
   372			var k := _v8_free_kid(r[0])
   373			if k == -1:
   374				continue
   375			var s := units[k]
   376			c.raised = true
   377			s.dormant = false
   378			s.alive = true
   379			s.x = c.x
   380			s.y = c.y
