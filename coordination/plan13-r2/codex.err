   198	## 巫毒綁誰：隊伍前向半平面、同列走廊內最近；同距比 y、再比離自己底線的深度（鏡像不變）；走廊沒人就全場最近。
   199	func _v8_doll_target(i: int, sx: PackedInt64Array, sy: PackedInt64Array, st: PackedInt64Array, sv: PackedByteArray) -> int:
   200		var dir := 1 if st[i] == 0 else -1
   201		var best := -1
   202		var best_lane := false
   203		var bd := 0
   204		for j in sx.size():
   205			if sv[j] == 0 or st[j] == st[i]:
   206				continue
   207			var d2 := M.dist2(sx[i], sy[i], sx[j], sy[j])
   208			var lane: bool = (sx[j] - sx[i]) * dir >= 0 and absi(sy[j] - sy[i]) <= F8.DOLL_LANE
   209			var better := best == -1
   210			if not better and lane != best_lane:
   211				better = lane
   212			elif not better and lane == best_lane:
   213				better = _tie_less(d2, units[j], bd, units[best])
   214			if better:
   215				best = j
   216				best_lane = lane
   217				bd = d2
   218		return best
   219	
   220	## ② 之後：被吸塵貓拉的位移併進移動意圖，再統一解碰撞。
   221	func _v8_apply_pull(n: int, nx: PackedInt64Array, ny: PackedInt64Array) -> void:
   222		for i in n:
   223			var u := units[i]
   224			if u.alive and u.pull_t > 0:
   225				nx[i] += u.pull_x
   226				ny[i] += u.pull_y
   227				u.pull_t -= 1
   228			var c := units[j]
   229			if c.parent == i and c.dormant:
   230				return j
   231		return -1
   232	
   233	## 3 格內最近的我方屍體；生出來的兵、已被復活的、還沒生出來的都不算。
   234	func _v8_corpse(i: int, n: int) -> int:
   235		var u := units[i]
   236		var best := -1
   237		var bd := 0
   238		for j in n:
   239			var c := units[j]
   240			if c.alive or c.dormant or c.summon or c.raised or c.team != u.team:
   241				continue
   242			var d2 := M.dist2(u.x, u.y, c.x, c.y)
   243			if d2 <= F8.BONE_R * F8.BONE_R and (best == -1 or _tie_less(d2, c, bd, units[best])):
   244				best = j
   245				bd = d2
   246		return best
