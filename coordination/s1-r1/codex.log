   533	func _input(ev: InputEvent) -> void:
   534		if ev is InputEventMouseMotion:
   535			mouse = ev.position
   536			pad_mode = false
   537			hover_card = _card_at(mouse)
   538			if state == St.PLACE and overlay == "" and painting:
   539				if _cur_army().team != paint_team:
   540					painting = false
   541				else:
   542					var c := _cell_at(mouse)
   543					if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   544						_try_place(c)
   545			return
   546		if ev is InputEventMouseButton:
   547			_mouse_button(ev)
   548			return
   549		if ev is InputEventKey and ev.pressed:
   550			if not ev.echo or ev.keycode in [KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT]:
   551				_enqueue("key", ev.keycode)
   552			return
   553		if ev is InputEventJoypadButton and ev.pressed:
   554			pad_mode = true
   555			var map := {JOY_BUTTON_DPAD_UP: KEY_UP, JOY_BUTTON_DPAD_DOWN: KEY_DOWN, JOY_BUTTON_DPAD_LEFT: KEY_LEFT,
   556				JOY_BUTTON_DPAD_RIGHT: KEY_RIGHT, JOY_BUTTON_A: KEY_ENTER, JOY_BUTTON_B: KEY_ESCAPE, JOY_BUTTON_X: KEY_BACKSPACE,
   557				JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_Y: KEY_TAB, JOY_BUTTON_LEFT_SHOULDER: KEY_Q, JOY_BUTTON_RIGHT_SHOULDER: KEY_E,
   558				JOY_BUTTON_BACK: KEY_F1}
   559			if map.has(ev.button_index):
   560				_enqueue("key", map[ev.button_index])
   561			return
   562		if ev is InputEventJoypadMotion and absf(ev.axis_value) > 0.6 and (ev.axis == JOY_AXIS_LEFT_X or ev.axis == JOY_AXIS_LEFT_Y):
   563			pad_mode = true
   564			if ev.axis == JOY_AXIS_LEFT_X:
   565				_enqueue("key", KEY_RIGHT if ev.axis_value > 0 else KEY_LEFT)
   566			else:
   567				_enqueue("key", KEY_DOWN if ev.axis_value > 0 else KEY_UP)
   568	
   569	
   570	func _mouse_button(mb: InputEventMouseButton) -> void:
   571		mouse = mb.position
   572		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   573			_enqueue("click", mouse)
   574		if overlay != "" or state != St.PLACE:
   575			if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
   576				drag_new = false
   577				painting = false
   578				drag_from = Vector2i(-1, -1)
   579			return
   580		var c := _cell_at(mouse)
   581		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   582			var k := _card_at(mouse)
   583			if k >= 0 and _card_help_rect(k).has_point(mouse):
   584				return   # 放開時由「?」按鈕處理
   585			if k >= 0:
   586				if _allowed(k):
   587					selected = k
   588					drag_new = true
   589					sfx.play("ui_click")
   590				else:
   591					_toast(L.t("err_type"), true)
   592				return
   593			if c.x < 0:
   594				return
   595			if _can_edit_existing() and _cur_army().index_at(c.x, c.y) != -1:
   596				if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
   597					_toast(L.t("err_locked"), true)
   598					return
   599				drag_from = c
   600			else:
   601				painting = true
   602				paint_team = _cur_army().team
   603				_try_place(c)
   604		elif mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   605			if drag_new and c.x >= 0:
   606				_try_place(c)
   607			elif drag_from.x >= 0:
   608				if c.x < 0:
   609					_try_remove(drag_from)
   610				elif c != drag_from:
   611					if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() >= gauntlet_changes:
   612						_toast(L.t("err_changes"), true)
   613					elif not _cur_army().move(drag_from.x, drag_from.y, c.x, c.y):
   614						_toast(L.t("err_zone"), true)
   615					else:
   616						sfx.play("place_light")
   617			drag_new = false
   618			painting = false
   619			drag_from = Vector2i(-1, -1)
   620		elif mb.button_index == MOUSE_BUTTON_RIGHT and mb.pressed and c.x >= 0:
   621			_try_remove(c)
   622	
   623	
   624	func _key(k: int) -> void:
   625		# 有按鈕焦點的畫面（標題、選單、結果、覆蓋層、戰鬥）：方向鍵移焦點、Enter 按下、Esc 返回
   626		if state != St.PLACE or overlay != "":
   627			match k:
   628				KEY_UP, KEY_LEFT:
   629					_move_focus(-1)
   630				KEY_DOWN, KEY_RIGHT, KEY_TAB:
   631					_move_focus(1)
   632				KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
   633					if _btns_gen == _gen and _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:   # 按鈕清單要是這個畫面的
   634						sfx.play("ui_click")
   635						_btns[_focus]["cb"].call()
   636				KEY_ESCAPE:
   637					if overlay != "":
   638						overlay = ""
   639					elif state == St.BATTLE:
   640						_on_skip()
   641					elif state != St.TITLE:
   642						_go_title()
   643			return
   644		pad_mode = true
   645		match k:
   646			KEY_UP: cursor.y = maxi(0, cursor.y - 1)
   647			KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
   648			KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
   649			KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
   650			KEY_F1:
   651				_open_codex(selected)
   652			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5:
   653				var t := k - KEY_1
   654				if _allowed(t):
   655					selected = t
   656			KEY_Q, KEY_E:
   657				for i in 5:
   658					selected = (selected + (4 if k == KEY_Q else 1)) % 5
   659					if _allowed(selected):
   660						break
   661			KEY_ENTER, KEY_KP_ENTER:
   662				if _cur_army().index_at(cursor.x, cursor.y) == -1:
   663					_try_place(cursor)
   664			KEY_BACKSPACE, KEY_DELETE:
   665				_try_remove(cursor)
   666			KEY_SPACE, KEY_TAB:
   667				_on_start()
   668			KEY_ESCAPE:
   669				_go_title()
   670	
   671	
   672	# ───────────────────────── 每幀 ─────────────────────────
   673	func _process(delta: float) -> void:
   674		var _t0 := Time.get_ticks_usec()
   675		_process_inner(delta)
   676		perf_proc_us = Time.get_ticks_usec() - _t0
   677	
   678	func _process_inner(delta: float) -> void:
   679		_process_cmds()
   680		time += delta
   681		SteamApi.run_callbacks()
   682		if toast_t > 0:
   683			toast_t -= delta
   684		if ach_t > 0:
   685			ach_t -= delta
   686		elif not ach_queue.is_empty():
   687			toast = ach_queue.pop_front()
   688			toast_t = 2.5
   689			ach_t = 2.6
   690		shake = maxf(0.0, shake - delta)
   691		if not freeze_fx:
   692			for f in fx:
   693				f["t"] += delta
   694				if f.has("pop"):
   695					f["pop"] = maxf(0.0, f["pop"] - delta)
   696			fx = fx.filter(func(f): return f["t"] < f["dur"])
   697			clutch_t = maxf(0.0, clutch_t - delta)
   698		if font_bold != null:
   699			_layout_texts()
   700		for g in dying:
   701			g["t"] += delta
   702		dying = dying.filter(func(g): return g["t"] < 1.0)
   703		if overlay == "codex":
   704			_codex_tick(delta)
   705		if state == St.TITLE and demo != null and shot_dir == "":
   706			demo_acc += delta
   707			while demo_acc >= 0.05:
   708				demo_acc -= 0.05
   709				demo.step()
   710			if demo.finished:
   711				_new_demo()
   712		if state == St.BATTLE and shot_dir == "":
   713			_battle_process(delta)
   714		elif state == St.RESULT:
   715			zoom = lerpf(zoom, 1.0, delta * 4)
     1	extends "res://scripts/ui/game_screens.gd"
     2	## 主場景腳本。這一層只放宣傳工具：自動截圖、商店膠囊圖、實機影片模式。
     3	
     4	
     5	## 商店膠囊圖（N6）：用目前視窗大小構圖——先畫標題帶，再把兩軍放在標題下方對衝，中間有分界線與對射的箭。
     6	## 只有遊戲標題文字（Steam 規定）。手感輪（收尾批）調整：標題帶不壓角色、中央不留白、小尺寸放大標題與角色、兩側留邊。
     7	func _draw_capsule() -> void:
     8		var vs := get_viewport_rect().size
     9		var tile := 64.0 * vs.y / 800.0
    10		for yy in int(vs.y / tile) + 1:
    11			for xx in int(vs.x / tile) + 1:
    12				var h := absi((xx * 73856093) ^ (yy * 19349663))
    13				draw_texture_rect_region(grass, Rect2(xx * tile, yy * tile, tile, tile), Rect2((h % 8) * 32, ((h / 8) % 4) * 32, 32, 32))
    14		draw_rect(Rect2(Vector2.ZERO, vs), Color(0.06, 0.09, 0.16, 0.22))
    15		var tall := vs.y > vs.x
    16		var tiny := get_window().size.y < 300   # 畫布邏輯高度固定 800，要看實際視窗大小
    17		# 標題帶（先畫，角色畫在它下方的區域）
    18		var big := int(vs.y * (0.12 if tall else (0.30 if tiny else 0.21)))
    19		var band_h := big * 1.75
    20		var band_y := vs.y * (0.05 if tall else 0.03)
    21		draw_rect(Rect2(0, band_y, vs.x, band_h), Color(0.05, 0.06, 0.1, 0.55))
    22		# 標題：立體投影＋金邊（R6）
    23		var tw := font_bold.get_string_size(L.t("title"), HORIZONTAL_ALIGNMENT_LEFT, -1, big).x
    24		var tp := Vector2(vs.x / 2 - tw / 2, band_y + big * 0.05 + big * 0.85)
    25		for d in 4:
    26			draw_string(font_bold, tp + Vector2(1, 1) * (d + 1) * big * 0.012, L.t("title"), HORIZONTAL_ALIGNMENT_LEFT, -1, big, Color(0.35, 0.18, 0.05, 0.9))
    27		draw_string_outline(font_bold, tp, L.t("title"), HORIZONTAL_ALIGNMENT_LEFT, -1, big, int(maxf(4.0, big * 0.07)), Color("#b8860b"))
    28		draw_string(font_bold, tp, L.t("title"), HORIZONTAL_ALIGNMENT_LEFT, -1, big, Color("#ffe8a3"))
    29		_text(Vector2(vs.x / 2, band_y + big * 1.12), "No Take-Backs", int(big * (0.42 if tiny else 0.34)), Color(1, 1, 1, 0.97), true, true)
    30		# 戰場區
    31		var top := band_y + band_h + vs.y * 0.02
    32		var bottom := vs.y * 0.97
    33		var mid := vs.x / 2
    34		draw_dashed_line(Vector2(mid, top), Vector2(mid, bottom), Color(1, 1, 1, 0.45), maxf(3.0, vs.y * 0.006) * (2.5 if tiny else 1.0), vs.y * 0.02)
    35		var sc := (bottom - top) / (110.0 if tiny else 260.0)
    36		if tall:
    37			sc = minf(sc, vs.x / 380.0)   # 直式：依寬度限制大小，同排兩隻不會擠在一起
    38		var cols := 3 if tiny else (2 if tall else 3)
    39		var rows := 1 if tiny else 3
    40		var margin := maxf(20.0, vs.x * 0.05)
    41		# 每邊固定 cols×rows 的整齊陣型；弓兵固定在最靠中線的那一欄，箭從弓兵射出
    42		# 兩軍在中線交鋒的瞬間（R6）：最前排近戰撞在中線，弓兵在後排放箭，身後有速度線
    43		var layout := [D.ARCHER, D.SHIELD, D.SWORD, D.ARCHER, D.ASSASSIN, D.CAVALRY, D.ARCHER, D.SHIELD, D.SWORD]
    44		var items: Array = []
    45		var archers: Array = []
    46		for team in 2:
    47			for r in rows:
    48				for c in cols:
    49					var t: int = layout[(r * cols + c) % layout.size()]
    50					if c == 0 and not tiny:
    51						t = D.ARCHER
    52					elif c == cols - 1 and t == D.ARCHER:
    53						t = D.SWORD   # 最前排一定是近戰撞在中線
    54					var span := (mid - margin) * 0.80 - sc * 30.0
