   462	func _fx_text(p: Vector2, s: String, c: Color, dur: float, size: int, screen := false) -> void:
   463		fx.append({"kind": "text", "p": p, "s": s, "c": c, "t": 0.0, "dur": dur, "size": size, "screen": screen})
   464	
