     1	#!/usr/bin/env bash
     2	# 統一檢查入口（第三輪 T1）：本機與 CI 用同一套。任何一步失敗就 exit 1，並印出是哪一步。
     3	# 原本 CI 的問題：匯入失敗被 `|| true` 吃掉；`grep '0 失敗'` 連「10 失敗」也會通過；腳本語法錯誤會讓相依的測試靜靜略過。
     4	# 用法：GODOT=<godot 執行檔> tools/check_all.sh [輸出資料夾]
     5	set -uo pipefail
     6	cd "$(dirname "$0")/.."
     7	GODOT="${GODOT:-godot}"
     8	OUT="${1:-${TMPDIR:-/tmp}/ntb-check}"
     9	mkdir -p "$OUT"
    10	fail() { echo "CHECK FAIL：$1（記錄在 $OUT）"; exit 1; }
    11	has_err() { grep -E "SCRIPT ERROR|Parse Error|Compile Error|Failed to load script" "$1" >/dev/null; }
    12	
    13	"$GODOT" --headless --path . --import > "$OUT/import.log" 2>&1
    14	has_err "$OUT/import.log" && fail "匯入有腳本錯誤"
    15	
    16	"$GODOT" --headless --path . --script res://tools/load_all.gd > "$OUT/load.log" 2>&1 || fail "有腳本載入失敗"
    17	grep -q "^LOADALL .*失敗 0：" "$OUT/load.log" || fail "載入檢查沒有完成"
    18	
    19	"$GODOT" --headless --path . -- --boot-check > "$OUT/boot.log" 2>&1 || fail "正式入口啟動失敗"
    20	grep -q "^BOOTOK" "$OUT/boot.log" || fail "正式入口沒有跑到標題"
    21	has_err "$OUT/boot.log" && fail "正式入口啟動時有腳本錯誤"
    22	
    23	"$GODOT" --headless --path . --script res://tests/run_tests.gd > "$OUT/test.log" 2>&1 || fail "規則測試有失敗（exit 非 0）"
    24	grep -qE "^—— [1-9][0-9]* 通過 / 0 失敗" "$OUT/test.log" || fail "規則測試沒有印出完成標記"
    25	has_err "$OUT/test.log" && fail "測試過程有腳本錯誤（可能有測試被略過）"
    26	grep FINGERPRINT "$OUT/test.log" > "$OUT/fingerprint.txt"
    27	
    28	"$GODOT" --headless --path . --script res://tools/mirror_100.gd > "$OUT/mirror.log" 2>&1 || fail "鏡像檢查失敗"
    29	grep -q "^MIRROR100 100/100" "$OUT/mirror.log" || fail "鏡像沒有 100/100"
    30	
    31	GN="${GOLDEN_N:-1000}"   # Windows 上一場約 1.5 秒，CI 的 Windows 用 200 場
    32	"$GODOT" --headless --path . --script res://tools/golden.gd -- --n=$GN > "$OUT/golden.log" 2>&1 || fail "確定性金標準有分歧（看 golden.log 的第一個分歧場次與 tick）"
    33	grep -q "^GOLDEN {\"n\":$GN,\"ok\":true}" "$OUT/golden.log" || fail "金標準沒有比完 $GN 場"
    34	
    35	"$GODOT" --headless --path . --script res://tools/orbit_detect.gd > "$OUT/orbit.log" 2>&1 || fail "騎兵打轉偵測超過門檻"
    36	
    37	python3 tools/check_assets.py > "$OUT/assets.log" 2>&1 || fail "素材登記檢查失敗"
    38	
    39	echo "CHECK OK：匯入、載入、啟動、測試、鏡像、金標準、打轉、素材全過（記錄在 $OUT）"
