+## 點擊只對「這個世代畫出來的按鈕」有效（_btns_gen）。
+func _enqueue(kind: String, data) -> void:
+	_cmds.append({"kind": kind, "data": data, "gen": _gen})
+
+func _update_gen() -> void:
+	var key := "%d|%s|%d" % [state, overlay, mode]
+	if key != _gen_key:
+		_gen_key = key
+		_gen += 1
+
+func _process_cmds() -> int:
+	var done := 0
+	_update_gen()
+	var q := _cmds
+	_cmds = []
+	for c in q:
+		if c["gen"] != _gen:
+			continue   # 畫面已經換了：丟掉
+		if c["kind"] == "click":
+			if _btns_gen != _gen:
+				continue   # 這個畫面的按鈕還沒畫出來
+			var p: Vector2 = c["data"]
+			for i in _btns.size():
+				var b: Dictionary = _btns[i]
+				if b["r"].has_point(p):
+					if b["en"]:
+						_focus = i
+						if sfx != null:
+							sfx.play("ui_click")
+						b["cb"].call()
+						done += 1
+					break
+		elif c["kind"] == "key":
+			_key(int(c["data"]))
+			done += 1
+		_update_gen()
+	return done
 
