   477		for r in 9:
   478			for c in 16:
   479				var cell := Rect2(ORIGIN + Vector2(c, r) * CS, Vector2(CS, CS))
   480				if grass:
   481					var h := absi((c * 73856093) ^ (r * 19349663))
   482					draw_texture_rect_region(grass, cell, Rect2((h % 8) * 32, ((h / 8) % 4) * 32, 32, 32))
   483				else:
   484					draw_rect(cell, Color("#7cb342") if (r + c) % 2 == 0 else Color("#73a83d"))
   485				if c < 6:
   500			a["%d,%d,%d" % [u["type"], u["col"], u["row"]]] = true
   501		var d := 0
   502		for u in armies[0].units:
   503			if not a.has("%d,%d,%d" % [u["type"], u["col"], u["row"]]):
   504				d += 1
   505		return d
