   520	func _try_remove(c: Vector2i) -> void:
   521		if _locked():
   522			return
   523		if mode == Mode.DUEL and tp != null:
   524			_toast(L.t("err_notakeback"), true)
   525			return
   526		if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
   527			_toast(L.t("err_locked"), true)
   528			return
   529		if _cur_army().remove_at(c.x, c.y):
   530			sfx.play("ui_click")
