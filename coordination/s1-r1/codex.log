+## 跳字的外框（含描邊與底襯，戰場座標）。
+func _text_rect(f: Dictionary, at: Vector2) -> Rect2:
+	var sz := ts(int(f["size"]))
+	var w := font_bold.get_string_size(f["s"], HORIZONTAL_ALIGNMENT_LEFT, -1, sz).x + 14.0 if font_bold != null else float(f["s"].length() * sz)
