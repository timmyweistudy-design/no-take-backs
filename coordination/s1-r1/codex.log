+				guard += 1
+				for q: Rect2 in placed:
+					if q.intersects(r):
+						r.position.y = q.position.y - r.size.y - 2.0
+						moved = true
+			placed.append(r)
+		f["rp"] = Vector2(r.get_center().x, r.position.y + 3.0)
+		f["rr"] = r
+
