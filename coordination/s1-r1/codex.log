   401	## 最後時刻橫幅：全寬暗帶＋大字，畫在所有戰場東西上面（螢幕座標）。
   402	func _draw_clutch_banner() -> void:
   403		if clutch_t <= 0.0:
   404			return
   405		var a := clampf(clutch_t / 0.3, 0.0, 1.0) * clampf((1.6 - clutch_t) / 0.15, 0.0, 1.0)
   406		var y := 104.0
   407		for i in 6:
   408			draw_rect(Rect2(0, y + i * 6, 1280, 6), Color(0, 0, 0, 0.55 * a * (1.0 - absf(i - 2.5) / 3.5)))
   409		_text(Vector2(640, y - 2), L.t("clutch"), ts(34), Color(ACCENT, a), true, true, 900)
   410	
   411	
   412	## 慢動作暗角：螢幕四周往內的多層橢圓暗帶（金色調）。
   413	func _draw_vignette(strength: float) -> void:
   414		if strength <= 0.0:
   415			return
   416		var c := Vector2(640, 443)
   417		var rx := 640.0
   418		var ry := 357.0
   419		for ring in 6:
   420			var k0 := (0.70 + ring * 0.06) * 1.25
   421			var k1 := k0 + 0.06 * 1.25
   422			var c0 := Color(0.18, 0.11, 0.0, strength * 0.10 * ring)
   423			var c1 := Color(0.18, 0.11, 0.0, strength * 0.10 * (ring + 1))
   424			for i in 32:
   425				var a0 := i * TAU / 32.0
   426				var a1 := (i + 1) * TAU / 32.0
   427				var d0 := Vector2(cos(a0) * rx, sin(a0) * ry)
   428				var d1 := Vector2(cos(a1) * rx, sin(a1) * ry)
   429				draw_primitive(PackedVector2Array([c + d0 * k0, c + d1 * k0, c + d1 * k1, c + d0 * k1]), PackedColorArray([c0, c0, c1, c1]), PackedVector2Array())
   430	
   431	
   432	## 特效預算（第三輪 V3）：戰場特效（不含跳字）同時最多 FX_CAP 個。超過時先丟優先權低、最舊的；關鍵（2）不丟。
   433	const FX_CAP := 40
   434	const FX_PRIO := {"dust": 0, "slash": 1, "arrow": 1, "ripple": 1, "aim": 1, "hide": 1, "trip": 2, "shard": 2, "flash": 2, "vslash": 2,
   435		"taunt": 2, "bang": 2, "puff": 1, "hex": 2}
   436	var fx_dropped := 0
   437	
   438	func _add_fx(d: Dictionary) -> void:
   439		var pr: int = FX_PRIO.get(d["kind"], 1)
   440		var n := 0
   441		for f in fx:
   442			if f["kind"] != "text":
   443				n += 1
   444		if n >= FX_CAP:
   445			var victim := -1
   446			for k in fx.size():
   447				var f2: Dictionary = fx[k]
   448				if f2["kind"] == "text":
   449					continue
   450				var p2: int = FX_PRIO.get(f2["kind"], 1)
   451				if p2 < 2 and (victim < 0 or p2 < FX_PRIO.get(fx[victim]["kind"], 1) or (p2 == FX_PRIO.get(fx[victim]["kind"], 1) and f2["t"] > fx[victim]["t"])):
   452					victim = k
   453			if victim >= 0 and FX_PRIO.get(fx[victim]["kind"], 1) <= pr:
   454				fx.remove_at(victim)
   455				fx_dropped += 1
   456			elif pr < 2:
   457				fx_dropped += 1
   458				return
   459		fx.append(d)
   460	
