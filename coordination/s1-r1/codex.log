   361	## 量測（測試與手感輪用）：正常顯示的跳字兩兩最大重疊比例（交集÷較小框），以及淡出中與其他的最大重疊。
   362	func text_overlap_stats() -> Dictionary:
   363		var vis: Array = []
   364		var fading: Array = []
   365		for f in fx:
   366			if f["kind"] == "text" and not f.get("screen", false) and f.has("rr"):
   367				(vis if _text_alpha(f) >= 0.35 else fading).append(f["rr"])
   368		var worst := 0.0
   369		for a in vis.size():
   370			for b in range(a + 1, vis.size()):
   371				worst = maxf(worst, _overlap(vis[a], vis[b]))
   372		var worst_f := 0.0
   373		for fr: Rect2 in fading:
   374			for o: Rect2 in vis + fading:
   375				if o != fr:
   376					worst_f = maxf(worst_f, _overlap(fr, o))
   377		return {"visible": vis.size(), "fading": fading.size(), "max_overlap": worst, "max_overlap_fading": worst_f}
   378	
   379	static func _overlap(a: Rect2, b: Rect2) -> float:
   380		var x := a.intersection(b)
   381		if not x.has_area():
   382			return 0.0
   383		return x.get_area() / maxf(1.0, minf(a.get_area(), b.get_area()))
   384	
   385	
   386	## 最後時刻（第三輪 V2）：慢動作期間，螢幕上 y<165（橫幅下方那一帶）的戰場跳字淡到 0.2。
   387	func _clutch_dim(world_p: Vector2) -> float:
   388		if slow_left <= 0.0 and clutch_t <= 0.0:
   389			return 1.0
   390		var sp: Vector2 = _cam * world_p
   391		return 0.2 if sp.y < 165.0 else 1.0
   392	
   393	
   394	## 慢動作時離焦點遠的單位與特效降到 0.6。
   395	func _focus_dim(world_p: Vector2) -> float:
   396		if slow_left <= 0.0 or state != St.BATTLE:
   397			return 1.0
   398		return 0.6 if world_p.distance_to(zoom_center) > 260.0 else 1.0
   399	
