   508	func _try_place(c: Vector2i) -> void:
   509		var why := _check_place(selected, c)
   510		if why == "":
   511			if mode == Mode.DUEL and tp != null:
   512				tp.place(selected, c.x, c.y)
   513			else:
   514				_cur_army().place(selected, c.x, c.y)
   515			sfx.play(["place_mid", "place_heavy", "place_light", "place_heavy", "place_light"][selected])
   516		elif why != L.t("err_taken"):
   517			_toast(why, true)
   518	
