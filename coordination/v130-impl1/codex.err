   371	
   372	func _process(delta: float) -> void:
   373		_throttle_when_minimized()
   374		_rv_poll()
   375		_settings_hover()
   376		var _t0 := Time.get_ticks_usec()
   377		_process_inner(delta)
   378		perf_proc_us = Time.get_ticks_usec() - _t0
   379	
   380	
   381	func _process_inner(delta: float) -> void:
   382		_stick_repeat(delta)
   383		_process_cmds()
   384		time += delta
   385		SteamApi.run_callbacks()
   386		if toast_t > 0:
   387			toast_t -= delta
   388		if removed_banner_t > 0.0:
   389			removed_banner_t -= delta
   390		if ach_t > 0:
   391			ach_t -= delta
   392		elif not ach_queue.is_empty():
   393			toast = ach_queue.pop_front()
   394			toast_t = 2.5
   395			ach_t = 2.6
   396		shake = maxf(0.0, shake - delta)
   397		if not freeze_fx:
   398			for f in fx:
   399				f["t"] += delta
   400				if f.has("pop"):
   401					f["pop"] = maxf(0.0, f["pop"] - delta)
   402			fx = fx.filter(func(f): return f["t"] < f["dur"])
   403			clutch_t = maxf(0.0, clutch_t - delta)
   404		for g in dying:
   405			g["t"] += delta
   406			if g["t"] >= 1.0:
   407				graves.append({"pos": g["pos"], "team": g["team"], "t": 0.0})
   408		dying = dying.filter(func(g): return g["t"] < death_life(int(g["type"])))   # V1.3 A5：倒棋留 1.7 秒
   409		for g in graves:
   410			g["t"] += delta
   411		graves = graves.filter(func(g): return g["t"] < 3.0)
   412		if overlay == "codex":
   413			_codex_tick(delta)
   414		if overlay == "ai_busy":
   415			_ai_poll()
   416		if not pre_old.is_empty():
   417			_pre_reap()
   418		if state == St.TITLE and demo != null and shot_dir == "":
   419			demo_acc += delta
   420			while demo_acc >= 0.05:
   490			if not f.get("screen", false) and f["kind"] != "text":
   491				_draw_fx(f)
   492		for f in fx:
   493			if not f.get("screen", false) and f["kind"] == "text":
   494				_draw_fx(f)
   495		perf_parts["fx"] = Time.get_ticks_usec() - _t
   496		draw_set_transform_matrix(Transform2D.IDENTITY)
   497		# V1.2 F2：畫面四周暈影（戰場與標題背景，壓在介面底下），讓視線集中在中間
   498		var vg := _ui_tex("res://art/ui/vignette.png")
   499		if vg != null and not bool(Save.s("plain_ui")):
   500			draw_texture_rect(vg, Rect2(0, 0, 1280, 800), false, Color(1, 1, 1, 0.5))
   501		_probe_ui = true
   502		Art.base = Transform2D.IDENTITY
   503		if state == St.BATTLE and slow_left > 0:
   504			_draw_vignette(clampf((8.0 - slow_left) / 0.3, 0.0, 1.0))   # 多層暗角（第三輪 V2）
   505		if state == St.BATTLE and time - key_t < 0.8 and not bool(Save.s("reduce_fx")):
   506			_draw_key_moment((time - key_t) / 0.8)
   507		if state != St.RESULT:
   508			for f in fx:
   509				if f.get("screen", false):
   510					_draw_fx(f)
   511		match state:
   512			St.TITLE: _draw_title()
