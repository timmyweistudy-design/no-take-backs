   769		var k := "%s|%s|%d|%d" % [bg.to_html(), border.to_html(), int(radius), int(bw * 10)]
   770		var sb: StyleBoxFlat = _sb_cache.get(k)
   771		if sb == null:
   772			_sb_room()
   773			sb = StyleBoxFlat.new()
   774			sb.bg_color = bg
   775			sb.border_color = border
   776			sb.set_corner_radius_all(int(radius))
   777			sb.set_border_width_all(int(ceilf(bw)))
   778			sb.anti_aliasing = true
   779			_sb_cache[k] = sb
   780		return sb
