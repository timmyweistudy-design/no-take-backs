    57	## 前搖到底的後仰角（勝利姿勢用來抵銷，站直）。
    58	static func windup_lean(type: int) -> float:
    59		return float(POSE_PROFILE[type][2]) if POSE_PROFILE.has(type) else LEAN_BACK
    60	
    61	static func _pose_prof(atk: float, f: Array) -> Array:
    62		if atk < ATK_WINDUP:
    63			var e := _smooth(atk / ATK_WINDUP)
    64			return [-e, -f[2] * e, lerpf(1.0, f[0], e), lerpf(1.0, f[1], e), f[3] * e]
    65		if atk < ATK_STRIKE:
    66			var u := (atk - ATK_WINDUP) / (ATK_STRIKE - ATK_WINDUP)
    67			var e2 := 1.0 - (1.0 - u) * (1.0 - u)
    68			return [lerpf(-1.0, 1.0, e2), lerpf(-f[2], f[6], e2), lerpf(f[0], f[4], e2), lerpf(f[1], f[5], e2), lerpf(f[3], f[7], e2)]
    69		var r := (atk - ATK_STRIKE) / (1.0 - ATK_STRIKE)
    70		var e3 := _smooth(clampf((r - f[8]) / (1.0 - f[8]), 0.0, 1.0))   # 先停在命中姿勢 f[8]，再收回
    71		return [lerpf(1.0, 0.0, e3), lerpf(f[6], 0.0, e3), lerpf(f[4], 1.0, e3), lerpf(f[5], 1.0, e3), lerpf(f[7], 0.0, e3)]
    72	
    73	
    74	## 角色的局部座標轉換（以腳底為原點、face＝+1 畫）：呼吸／走路起伏、前撲、傾身、壓扁拉長、翻面。
    75	## lean＝額外傾角（騎兵衝鋒前傾）、crouch＝縱向縮放（刺客潛行蹲身）。
    76	static func unit_xf(p: Vector2, face: float, walk: float, atk: float, t: float, scale := 1.0, lean := 0.0, crouch := 1.0, gtype := 0) -> Transform2D:
    77		# 外層（位置、起伏、翻面、縮放、額外傾身／蹲身）× 內層（攻擊姿勢，face＝+1 空間）。
    78		# 精靈圖快取烘焙的是內層，貼圖時套外層，所以兩條路的順序完全一樣（Codex R5 #3）。
    79		var ps := pose(atk, gtype)
    80		var bob := idle_bob(t, p) if walk == 0.0 else -Gait.air(gtype, walk)
    81		var outer := Transform2D(lean * face, Vector2(scale * face, scale * crouch), 0.0, p + Vector2(0, bob * scale))
    82		return outer * Transform2D(ps[1], Vector2(ps[2], ps[3]), 0.0, Vector2(ps[4], 0))
    83	
    84	
    85	## 單位：p＝腳底；face＝±1；walk＝走路相位（0＝沒走）；atk＝攻擊動作進度 0～1（見上）；hurt＝受擊閃白 0～1；
    86	## alpha＝透明度（潛行）；t＝時間（待機呼吸）；scale＝縮放；mood＝表情疊加（M_*）；lean／crouch 見 unit_xf。
    87	static func unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
    88			hurt: float, alpha: float, t: float, scale := 1.0, cb := false, mood := 0, lean := 0.0, crouch := 1.0, variant := 0) -> void:
    89		var tc := team_color(team, cb)
    90		_team_now = team
    91		var w: float = pose(atk, type)[0]
    92		if atk > 0.0:
    93			walk = 0.0   # 和精靈圖一致：攻擊格沒有走路相位
    94		_xf = base * unit_xf(p, face, walk, atk, t, scale, lean, crouch, type)
    95		_b_now = Transform2D.IDENTITY
    96		if turn_c < 1.0:
    97			_xf0 = _xf
    98			_xf = _xf * Transform2D(0.0, Vector2(turn_body_w(type), 1.0), 0.0, Vector2.ZERO)
    99		ci.draw_set_transform_matrix(_xf)
   100		# 以 face＝+1 畫（水平鏡像由 transform 處理）
   101		if type == D.CAVALRY:
   102			_cavalry(ci, tc, walk, w, alpha, t, atk > 0.0)
   103		elif type >= D.COUNT:
   104			_fantasy(ci, type, tc, walk, w, alpha, t, atk > 0.0, variant)
   105		else:
   106			_infantry(ci, type, tc, walk, w, alpha, t, atk > 0.0, variant)
   107		if hurt > 0.0:
   108			# 受擊閃白：在身體位置疊一層白
   109			ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, true)
   110		if mood != 0:
   111			overlay(ci, type, team, mood, alpha, t, cb)
   112		ci.draw_set_transform_matrix(base)
   113	
   114	
   115	## 表情與狀態疊加：呼叫前畫布轉換要已經是這隻角色的局部座標（face＝+1 空間）。
   116	static func overlay(ci: CanvasItem, type: int, team: int, mood: int, a: float, t: float, cb := false) -> void:
   117		var ec := Vector2(2.0, -43.0) if type == D.CAVALRY else (Vector2(5.5, -33.5) if type == D.ASSASSIN else Vector2(3.5, -32.0))
   118		if type >= D.COUNT:
   119			if not FEATURE_EYES.has(type):
   120				return   # 寶箱怪、羊、沙漏等臉在別處，不疊通用表情
   121			ec = FEATURE_EYES[type]
   122		var eyes := [ec + Vector2(-3.0 if type != D.ASSASSIN else -2.5, 0), ec + Vector2(4.0 if type != D.ASSASSIN else 2.5, 0)]
   123		var skin := Color("#2b2140") if type == D.ASSASSIN else SKIN
   124		if mood & M_HOOD:
   125			# 帽簷壓低：一條兜帽色的帽簷蓋到眼睛上緣；每 0.4 秒整個蓋住一下（眨眼）
   126			var shut := fmod(t, 0.4) < 0.07
   127			var drop := 4.6 if shut else 2.2
   128			ci.draw_rect(Rect2(ec + Vector2(-6.5, -4.8), Vector2(13.0, drop)), Color("#33304a", a))
   129		if mood & M_HURT:
   130			for i in 2:
   131				var e: Vector2 = eyes[i]
   132				ci.draw_circle(e, 3.3, Color(skin, a), true, -1.0, true)
   133				var sx := 1.0 if i == 0 else -1.0     # 左眼 >、右眼 <
   134				var col := Color("#ffe066", a) if type == D.ASSASSIN else Color(OUT, a)
   135				ci.draw_polyline(PackedVector2Array([e + Vector2(-1.8 * sx, -2.0), e + Vector2(1.6 * sx, 0), e + Vector2(-1.8 * sx, 2.0)]), col, 1.4, true)
   136		if mood & M_SPARKLE:
   137			for e in eyes:
   138				ci.draw_circle(e, 2.9, Color(OUT, a), true, -1.0, true)
   139				_star(ci, e + Vector2(0.4, -0.6), 2.2, Color(1, 1, 1, a))
   140			# 槍尖金光（長槍放平時的槍尖位置）
   141			var tip := Vector2(-6, -30) + Vector2(cos(-0.55), sin(-0.55)) * 40.0
   142			var g := 0.6 + 0.4 * sin(t * 18.0)
   143			_star(ci, tip, 14.0 * (0.8 + 0.2 * g), Color(1, 0.86, 0.3, a * g))   # 14px 十字閃芒（第三輪 R3）
   144			_star(ci, tip, 6.0, Color("#fff8a0", a))
   145		if mood & M_BROWS:
   146			for i in 2:
   147				var e2: Vector2 = eyes[i]
   148				var inward := 1.0 if i == 0 else -1.0
   149				var bc := Color("#ffe066", a) if type == D.ASSASSIN else Color(OUT, a)
   150				ci.draw_line(e2 + Vector2(-2.2, -4.2 - inward * 0.9), e2 + Vector2(2.2, -4.2 + inward * 0.9), bc, 1.8, true)
   151				ci.draw_circle(e2 + Vector2(0.6, -0.4), 1.2, Color(1, 0.25, 0.2, a), true, -1.0, true)   # 紅眼光點（第三輪 R3）
   152		if mood & M_BRACE and type == D.PIKE:
   153			# 長槍兵拒騎：槍尖位置爆一圈銀色十字閃光（第四輪）
   154			var g2 := 0.6 + 0.4 * sin(t * 20.0)
   155			_star(ci, Vector2(7, -17) + Vector2(cos(-0.8), sin(-0.8)) * 48.0, 13.0 * g2 + 4.0, Color(0.92, 0.96, 1.0, a))
   156		if mood & M_BRACE and type == D.SHIELD:
   157			# 頂住：盾放大 1.35 倍（以盾中心縮放）
   158			var cc := Vector2(11, -24)
   159			var k := 1.25
   160			var sh := PackedVector2Array()
   161			for q in [Vector2(1, -43), Vector2(21, -41), Vector2(21, -14), Vector2(11, -2), Vector2(1, -14)]:
   162				sh.append(cc + (q - cc) * k)
   163			_poly(ci, sh, STEEL, a)
   164			var inner := PackedVector2Array()
   165			for q2 in [Vector2(7, -33), Vector2(15, -32), Vector2(15, -17), Vector2(11, -11), Vector2(7, -17)]:
   166				inner.append(cc + (q2 - cc) * k)
   167			_poly(ci, inner, team_color(team, cb), a, false)
   168	
   169	
   170	## 腳底隊伍標記：藍＝圓、紅＝菱形（色盲也分得出）；重兵（盾、騎）外框加粗。
   171	## V1.3 A3：腳底三層，由下往上：厚木座（棋子底座，留在地上）→ 接觸影子（跳起來會縮）→ 隊伍圈。
   172	## air＝離地程度 0～1（只縮影子）。
   173	static func ring(ci: CanvasItem, p: Vector2, team: int, type: int, cb := false, scale := 1.0, air := 0.0) -> void:
   174		ring_base(ci, p, scale)
   175		ring_shadow(ci, p, scale * (1.0 - air * 0.35))
   380			_hand_ring(q, r, c2, 2.5)
   381			for d in [Vector2(1, 0), Vector2(-1, 0), Vector2(0, 1), Vector2(0, -1)]:
   382				draw_line(q + d * r * 0.55, q + d * r * 1.3, c2, 2.5, true)
   383	
   384	func _draw_units_of(s, dim: bool) -> void:
   385		var list: Array = []
   386		for u in s.units:
   387			if u.alive:
   388				list.append(u)
   389		var live: bool = s == view
   390		var rfx := bool(Save.s("reduce_fx"))
   391		# V1.3 P0-1：這一幀的畫面位置只算一次（排序比較器原本每次比較都重算 _upos）
   392		var pc := {}
   393		if live:
   394			for u in list:
   395				pc[u.id] = _upos(u)
   396			list.sort_custom(func(a, b): return pc[a.id].y < pc[b.id].y)
   397		else:
   398			list.sort_custom(func(a, b): return a.y < b.y)
   399		_draw_v8_ground(s, live)
   400		# 第一層：腳底標記與影子（全部先畫，不會被別人的身體整個蓋住時也看得到外圈）
   401		var a_now := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
   402		var gm: Array = _goal_mark()
   403		if live:
   404			# V1.3 C3：戰報墨圈畫在最底層（腳底三層之下）
   405			for f in fx:
   406				if f["kind"] == "inkring":
   407					var ik: float = f["t"] / f["dur"]
   408					draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.5), 0, f["p"] + Vector2(0, 2)))   # 貼在地上（壓扁成橢圓）
   409					_hand_ring(Vector2.ZERO, (26.0 + ik * 8.0) * UNIT_SCALE, Color(0.12, 0.07, 0.04, 0.55 * (1.0 - ik)), 2.6, false, 1)
   410					draw_set_transform_matrix(_cam)
   411		for u in list:
   412			var p0: Vector2 = pc[u.id] if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
   413			var air0: float = Gait.air(u.type, _walk_of(u, a_now)) if live else 0.0
   414			_ring(p0, u.team, u.type, UNIT_SCALE, clampf(air0 * 0.05, 0.0, 1.0))   # V1.3 A3：木座和隊伍圈留在地上，只有影子跟著跳起縮
   415			if u.shield > 0:       # 第十二輪：手動技能的護盾、戰吼
   416				_hand_ring(p0 + Vector2(0, -24) * UNIT_SCALE, 28.0 * UNIT_SCALE, Color(0.55, 0.85, 1.0, 0.75), 2.5)
   417			if u.haste_t > 0:
   418				_hand_ring(p0, 19.0 * UNIT_SCALE, Color(1.0, 0.75, 0.25, 0.85), 2.5)
   419			if u.id == int(gm[0]) or (int(gm[0]) == -2 and u.team == 0 and u.type == int(gm[2]) and not u.summon):
   420				_goal_marker(p0, "protect" if int(gm[0]) == -2 else str(gm[1]))   # 第十三輪：要護送／斬首的那一隻；V1.1：不能倒的那種兵每隻都標
   421			if live and s.rally[u.team] and not s.finished:
   422				for k in 2:
   423					var ph := fmod(time * 1.6 + k * 0.5, 1.0)
   424					_hand_ring(p0, (14.0 + ph * 10.0) * UNIT_SCALE, Color(1, 0.42, 0.0, 0.55 * (1.0 - ph)), 2.0)
   425		# 陣亡痕跡：倒下處的小旗，3 秒淡出，畫在最底層（第三輪 R5）
   426		if live:
   427			for g in graves:
   428				var ga: float = 1.0 - g["t"] / 3.0
   429				var gp: Vector2 = g["pos"]
   430				draw_line(gp + Vector2(0, 2), gp + Vector2(0, -16), Color(0.35, 0.27, 0.2, 0.8 * ga), 2.0, true)
   431				draw_colored_polygon(PackedVector2Array([gp + Vector2(0, -16), gp + Vector2(10, -12), gp + Vector2(0, -8)]), Color(Art.team_color(g["team"], cbm()), 0.75 * ga))
   432				draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.4), 0, gp + Vector2(0, 2)))   # 疊在鏡頭上（Codex S4 #5）
   433				draw_circle(Vector2.ZERO, 7, Color(0, 0, 0, 0.25 * ga), true, -1.0, true)
   434				draw_set_transform_matrix(_cam)
   435		# 擁擠度：40px 內有幾隻（第三輪 V5，只在戰鬥中算）
   436		var crowd := {}
   437		if live:
   438			# V1.3 P0-1：40px 格子分桶，只比相鄰 9 格（判定與雙迴圈相同：距離平方 < 1600）
   439			var bk := {}
   440			for u in list:
   441				var q: Vector2 = pc[u.id]
   442				var key := Vector2i(floori(q.x / 40.0), floori(q.y / 40.0))
   443				if bk.has(key):
   444					bk[key].append(q)
   445				else:
   446					bk[key] = [q]
   447			for u in list:
   448				var q: Vector2 = pc[u.id]
   449				var cx := floori(q.x / 40.0)
   450				var cy := floori(q.y / 40.0)
   451				var n := -1   # 自己一定在同一格，先扣掉
   452				for dx in range(-1, 2):
   453					for dy in range(-1, 2):
   454						var cell = bk.get(Vector2i(cx + dx, cy + dy))
   455						if cell == null:
   456							continue
   457						for o in cell:
   458							if q.distance_squared_to(o) < 1600.0:
   459								n += 1
   460				crowd[u.id] = n
   461		# 第二層：身體（V9：地圖的前景物件依腳點 y 插進來，才有前後遮擋）
   462		var prop_i := 0
   463		var xray: Array = []   # V1.1 C5：[腳點, 參數]，給被下排蓋到臉的那隻補畫半透明
   464		for u in list:
   465			var p: Vector2 = pc[u.id] if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
   466			while prop_i < fld_props.size() and ORIGIN.y + float(fld_props[prop_i][0]) <= p.y:
   467				MapArt.draw_prop(self, ORIGIN, fld_props[prop_i], time)
   468				prop_i += 1
   469			var walk: float = _walk_of(u, a_now) if live else ((time * Gait.nominal_rate(u.type, float(D.stat(u.type)["speed"]), CS, UNIT_SCALE) + u.id) if (u.mx != 0 or u.my != 0) else 0.0)
   470			var moving: bool = walk > 0.0
   471			var at := 0.0
   472			var variant := 0
   473			if live and atk_hit.has(u.id):
   474				var dt0 := _disp_tick()
   475				var h := pick_hit(atk_hit[u.id], dt0, u.type)
   476				if h >= 0:
   477					at = atk_progress(dt0 - (h - ViewBuffer.DELAY), u.type)
   478					# 火罐飛行（第四輪 §4.4）：前搖期間從手上飛向目標，命中那一刻落地（模擬不受影響）
   479					if u.type == D.BOMBER and at > 0.0 and at < Art.ATK_WINDUP and bomb_tgt.get(u.id, {}).has(h):
   480						var bt = view.unit_by_id(bomb_tgt[u.id][h])
   481						if bt != null:
   482							var fk := at / Art.ATK_WINDUP
   483							var src_p: Vector2 = _upos(u) + Vector2(0, -50)
   484							var dst_p: Vector2 = _upos(bt) + Vector2(0, -10)
   485							var pp := src_p.lerp(dst_p, fk) + Vector2(0, -sin(fk * PI) * minf(70.0, src_p.distance_to(dst_p) * 0.3))
   486							pot_draw.append(pp)
   487					if u.type == D.SWORD:
   488						variant = int(atk_seq.get(u.id, {}).get(h, 0)) % 2   # 劍士橫斬與上挑逐擊交替（第三輪 R4）
   489					elif u.type >= D.CLASSIC and alt_hit.get(u.id, {}).has(h):
   490						variant = 2
   491			var hurt := 0.0
   492			if live and hurt_t.has(u.id) and _fx_on("flash"):
   493				hurt = clampf(1.0 - (time - hurt_t[u.id]) / 0.15, 0, 1)
   494			var alpha := 0.45 if u.stealth > 0 else 1.0
   495			if dim:
   496				alpha *= 0.6
   497			if live:
   498				alpha *= _focus_dim(p)
   499			var face := signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
   500			# 受擊後退 4px（第三輪 R2）：0.08 秒退、0.07 秒回，只是畫面
   501			if live and hurt_t.has(u.id):
   502				var hk: float = (time - float(hurt_t[u.id])) / 0.15
   503				if hk >= 0.0 and hk < 1.0:
   504					p.x += float(hurt_dir.get(u.id, 0.0)) * 4.0 * (sin(hk * PI) if hk < 1.0 else 0.0)
   505			if live and u.id == follow_id:
   506				_hand_ring(p + Vector2(0, 2), 22.0, Color(ACCENT, 0.9), 3.0, true)   # 跟拍中的那隻
   507			# 擠在一起時，正在出手或受擊的那隻加隊伍色光圈（第三輪 V5）
   508			if live and (at > 0.0 or hurt > 0.0) and crowd.get(u.id, 0) >= 3:
   509				_hand_ring(p + Vector2(0, -24 if u.type != D.CAVALRY else -28), 19.0, Color(Art.team_color(u.team, cbm()), 0.75 * alpha), 2.0)
   510			# 表情與兵種專屬動作（R5）
   511			var mood := 0
   512			var lean := 0.0
   513			var crouch := 1.0
   514			if hurt > 0.3 or u.stun > 0:
   515				mood |= Art.M_HURT
   516			if hurt > 0.0:
   517				crouch *= 1.0 - 0.12 * hurt                 # V1.1 A2：受擊壓扁（縱 0.88），配合後退與閃白
   518				lean -= 0.06 * hurt * float(hurt_dir.get(u.id, 0.0)) * face
   519			if live:
   520				# V1.3 A4：停步慣性。剛停下時身體往前多晃一下再回正（0.3 秒，解析式衰減，不存逐兵彈簧狀態）
   521				if moving:
   522					stop_t.erase(u.id)
   523					walking[u.id] = true
   524				elif walking.get(u.id, false):
   525					walking.erase(u.id)
   526					stop_t[u.id] = time
   527				if stop_t.has(u.id):
   528					var sk: float = (time - float(stop_t[u.id])) / 0.3
   529					if sk >= 1.0 or at > 0.0:
   530						stop_t.erase(u.id)
   531					else:
   532						lean += 0.13 * sin(sk * TAU * 0.75) * (1.0 - sk)   # 正＝往前（unit_xf 會乘朝向）
   533			if live and u.windup > 0 and at == 0.0:
   534				# V1.1 A3：大招前搖的身體預警。小石魔高舉拉長、吸塵貓吸氣鼓脹、沙漏精靈與骷髏法師浮起
   535				var wk := 1.0 - float(u.windup) / F8.WINDUP
   536				if u.type == F8.GOLEM:
