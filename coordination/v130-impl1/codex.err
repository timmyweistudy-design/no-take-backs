   368			"lava", "canyon":
   369				snd = "step_stone"
   370			"river":
   371				if absi(int(u.x) - fld_w / 2) < fld_w / 10:
   372					snd = "step_wood"
   373		sfx.play(snd, 0.16)
   374	
   375	## 小石魔、馬、羊落地揚塵。
   376	func _gait_step_fx(u, d: Array) -> void:
   377		if not gait_on.get(u.id, false):
   378			return
   379		var a: float = Gait.phase_of(u.type, d[0], CS, UNIT_SCALE, u.id)
   380		var b: float = Gait.phase_of(u.type, d[1], CS, UNIT_SCALE, u.id)
   381		if int(a / PI) != int(b / PI):
   382			fx.append({"kind": "step", "p": _upos(u), "t": 0.0, "dur": 0.35, "big": u.type == 19})
   383	
   384	## 這一幀要畫的走路相位。
   385	func _walk_of(u, a: float) -> float:
   386		var k: int = Gait.kind(u.type)
   387		if u.stun > 0 or (drag_t.get(u.id, 0.0) > 0.0):
   388			if drag_t.get(u.id, 0.0) > 0.0:
   389				return Gait.POSE_DRAG
   390			return Gait.POSE_DAZE
   391		if k == Gait.ROOT:
   392			return 0.0
   393		if gait_on.get(u.id, false):
   394			var d: Array = gait_d.get(u.id, [0.0, 0.0])
   395			return Gait.phase_of(u.type, lerpf(d[0], d[1], a), CS, UNIT_SCALE, u.id)
   396		if k == Gait.FLOAT:
   397			return 0.0001 + time * 4.0 + u.id * 0.37      # 飄浮的就算停著也在飄
   398		return 0.0
