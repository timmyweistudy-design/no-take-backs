    36	const BUS_MUSIC := "Music"
    37	const BUS_SFX := "SFX"
    38	const BUS_UI := "UI"
    39	const BUS_AMB := "Ambience"
    40	var music_old: AudioStreamPlayer   # 換曲時淡出的上一首
