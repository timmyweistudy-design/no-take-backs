   119	func _merge_text(tid: int, kind: String, label: String, dmg: int, p: Vector2, col: Color) -> void:
   120		if int(TEXT_TIER.get(kind, 1)) >= 2:
   121			text_key_in += 1
   122		var cell := Vector2i(floori(p.x / TEXT_CELL.x), floori(p.y / TEXT_CELL.y))
   123		for f in fx:
   124			if f["kind"] == "text" and not f.get("screen", false) and f.get("ek", "") == kind and f.get("cell", Vector2i(-99, -99)) == cell and f["t"] < 0.35:
   125				f["n"] += 1
   126				f["sum"] += dmg
   127				f["s"] = ("+%d" % f["sum"]) if kind == EV.HEAL else "%s ×%d（%d）" % [label, f["n"], f["sum"]]
   128				f["t"] = 0.0
   129				f["pop"] = 0.18
   130				if int(f.get("tier", 1)) >= 2:
   131					text_key_shown += 1
   132				return
   133		var tier: int = TEXT_TIER.get(kind, 1)
   134		var world := 0
   135		for f in fx:
   136			if f["kind"] == "text" and not f.get("screen", false):
   137				world += 1
   138		if world >= TEXT_CAP:
   139			# 丟最舊的一般跳字；全部都是關鍵的就照樣加（關鍵不能漏）
   140			var oldest := -1
   141			for k in fx.size():
   142				var f2: Dictionary = fx[k]
   143				if f2["kind"] == "text" and not f2.get("screen", false) and int(f2.get("tier", 1)) < 2:
   144					if oldest < 0 or f2["t"] > fx[oldest]["t"]:
   145						oldest = k
   146			if oldest >= 0:
   147				fx.remove_at(oldest)
   148				text_dropped += 1
   149			elif tier < 2:
   150				text_dropped += 1
   151				return
   152			else:
   153				# 全部都是關鍵跳字：併進最近的同種跳字（硬上限，Codex S1 #5），關鍵不漏、只是合併
   154				var near := -1
   155				for k2 in fx.size():
   156					var f3: Dictionary = fx[k2]
   157					if f3["kind"] == "text" and f3.get("ek", "") == kind and (near < 0 or f3["p"].distance_to(p) < fx[near]["p"].distance_to(p)):
   158						near = k2
   159				if near >= 0:
   160					var fn: Dictionary = fx[near]
   161					fn["n"] += 1
   162					fn["sum"] += dmg
   163					fn["s"] = "%s ×%d（%d）" % [label, fn["n"], fn["sum"]]
   164					fn["t"] = 0.0
   165					fn["pop"] = 0.18
   166					text_key_shown += 1
   167					return
   168				# 沒有同種的：取代最舊的關鍵跳字（它已經顯示過了），維持硬上限
   169				var old := -1
   170				for k4 in fx.size():
   171					var f4: Dictionary = fx[k4]
   172					if f4["kind"] == "text" and not f4.get("screen", false) and (old < 0 or f4["t"] > fx[old]["t"]):
   173						old = k4
   174				if old >= 0:
   175					fx.remove_at(old)
   176		if tier >= 2:
   177			text_key_shown += 1
   178		fx.append({"kind": "text", "p": p, "s": ("+%d" % dmg) if kind == EV.HEAL else "%s %d" % [label, dmg], "c": col, "t": 0.0, "dur": 0.85, "size": 18 if tier >= 2 else (14 if kind == EV.HEAL else 16),
   179			"tid": tid, "ek": kind, "n": 1, "sum": dmg, "screen": false, "cell": cell, "tier": tier, "pop": 0.0, "plain": kind == EV.HEAL})
