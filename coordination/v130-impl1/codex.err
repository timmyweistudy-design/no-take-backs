    45	
    46	## 沒有就建立（同名不重複建；測試可以重複呼叫）。
    47	static func _ensure_buses() -> void:
    48		for n in [BUS_MUSIC, BUS_SFX, BUS_UI, BUS_AMB]:
    49			if AudioServer.get_bus_index(n) < 0:
    50				AudioServer.add_bus()
    51				var i := AudioServer.bus_count - 1
    52				AudioServer.set_bus_name(i, n)
    53				AudioServer.set_bus_send(i, "Master")
    54	
    55	## V1.2 E：優先讀 CC0 錄音轉的 .ogg（tools/gen/import_audio.py），沒有才用程式合成的 .wav。
    56	## 同名變體（名稱__2、__3…）一起載入，播放時隨機挑、避免連續同一個。
    57	static func load_audio(n: String):
    58		for ext in ["ogg", "wav"]:
    59			var path := "res://audio/%s.%s" % [n, ext]
    60			if ResourceLoader.exists(path):
    61				return load(path)
    62		return null
    63	
    64	var variants := {}     # 名稱 → [stream...]（含本體）
    65	var _last_var := {}    # 名稱 → 上次用的變體索引
    66	
    67	func _ready() -> void:
    68		for n in FILES:
    69			var st = load_audio(n)
    70			if st:
    71				streams[n] = st
    72				var vs: Array = [st]
    73				for k in range(2, 9):
    74					var v = load_audio("%s__%d" % [n, k])
    75					if v == null:
    76						break
    77					vs.append(v)
    78				variants[n] = vs
    79		_ensure_buses()
    80		for i in 12:
    81			var p := AudioStreamPlayer.new()
    82			p.bus = BUS_SFX
    83			add_child(p)
    84			players.append(p)
    85		music = AudioStreamPlayer.new()
    86		music.bus = BUS_MUSIC
    87		add_child(music)
    88		music.finished.connect(func(): music.play())
    89		music_old = AudioStreamPlayer.new()
    90		music_old.bus = BUS_MUSIC
    91		add_child(music_old)
    92		amb = AudioStreamPlayer.new()
    93		amb.bus = BUS_AMB
    94		add_child(amb)
    95		amb.finished.connect(func(): amb.play())
    96		var lp := AudioEffectLowPassFilter.new()
    97		lp.cutoff_hz = 900.0
    98		AudioServer.add_bus_effect(0, lp)
    99		_lowpass_idx = AudioServer.get_bus_effect_count(0) - 1
   100		AudioServer.set_bus_effect_enabled(0, _lowpass_idx, false)
   195			return
   196		if _fp_duel_turns():
   197			if not tp.place_batch(items):
   198				_toast(L.t("err_zone"), true)
   199				return
   200		else:
   201			_fp_push_undo()
