     1	extends RefCounted
     2	## V1.1 D2：每日挑戰＋每週突變。純函式，不碰畫面（遊戲、測試共用）。
     3	## 不改模擬：只用現有規則參數（預算、隻數、每種上限、卡池、地圖、縱深、局長、雙方手動技能）＋AI 用固定種子組敵陣。
     4	## 日期用 UTC 日數，跨時區同一天同一題。紀錄鍵＝日數＋VER：AI 或這份產生器一改就升 VER（測試 test_daily_v11 釘住幾天的敵陣，改了會紅）。
     5	
     6	const VER := 1
     7	const MUTATORS := 8
     8	const KEEP_DAYS := 10          # 存檔只留最近幾天的最佳紀錄
     9	const CMD = preload("res://scripts/core/cmd_defs.gd")
    10	const Presets = preload("res://scripts/game/presets.gd")
    11	const MapDefs = preload("res://scripts/core/map_defs.gd")
    12	const AI = preload("res://scripts/core/ai_army.gd")
    13	
    14	static func today() -> int:
    15		return int(Time.get_unix_time_from_system()) / 86400
    16	
    17	## 這一天的題目規格。mut＝這週的突變（每 7 天換一個），map／style 每天換。
    18	static func spec(day: int) -> Dictionary:
    19		var mut := posmod(day / 7, MUTATORS)
    20		var map_id := 3 if mut == 3 else posmod(day * 5 + 1, 6)
    21		return {"day": day, "key": "%d-v%d" % [day, VER], "mut": mut, "map": map_id, "style": posmod(day * 7 + 3, 5),
    22			"level": 1, "seed": 90000 + posmod(day * 2654435761, 1000003)}
    23	
    24	static func pool_of(types: Array) -> int:
    25		var p := 0
    26		for t in types:
    27			p |= 1 << int(t)
    28		return p
    29	
    30	## 把突變套到一組（已經是自由部署、單局的）規則上。r＝RuleSet。
    31	static func apply(r, sp: Dictionary) -> void:
    32		r.map_id = int(sp["map"])
    33		r.map_size = 1
    34		r.ai_style = int(sp["style"])
    35		r.ai_level = int(sp["level"])
    36		r.ai_pool_same = false
    37		r.rounds = 1
    38		r.preset = "custom"
    39		var kingdom := (1 << 10) - 1
    40		var fantasy := ((1 << 20) - 1) & ~kingdom
    41		var pool := kingdom
    42		match int(sp["mut"]):
    43			0:   # 貼臉肉搏：近戰卡池、最深縱深、60 秒
    44				pool = pool_of([0, 1, 3, 4, 5, 7, 8, 9])
    45				r.depth = 7500
    46				r.ticks = 1200
    47			1:   # 精兵演武：只能 8 隻、每種 1 隻、高預算
    48				r.unit_cap = 8
    49				r.type_cap = 1
    50				r.budget = [140, 140]
    51			2:   # 人海戰術：40 隻、只有便宜的兵
    52				pool = pool_of([0, 1, 2, 5, 8])
    53				r.unit_cap = 40
    54			3:   # 禁魔死鬥：冰原、不開技能（map 已在 spec 固定）
    55				pass
    56			4:   # 百家爭鳴：每種 1 隻、預算 150
    57				r.type_cap = 1
    58				r.budget = [150, 150]
    59			5:   # 閃電決戰：60 秒、雙方技能全開（護盾、戰吼、隕石）
    60				r.ticks = 1200
    61				var m5 := (1 << CMD.AEGIS) | (1 << CMD.WARCRY) | (1 << CMD.METEOR)
    62				r.cmd_mask = [m5, m5]
    63			6:   # 孤軍深入：最深縱深、低預算、每種最多 2 隻
    64				r.depth = 7500
    65				r.budget = [70, 70]
    66				r.type_cap = 2
    67			7:   # 神仙打架：奇幻卡池、高預算、隻數少、技能全開
    68				pool = fantasy
    69				r.budget = [150, 150]
    70				r.unit_cap = 12
    71				var m7 := (1 << CMD.AEGIS) | (1 << CMD.HEAL) | (1 << CMD.METEOR)
    72				r.cmd_mask = [m7, m7]
    73		r.pool = [pool, pool]
    74	
    75	## 成績比較：剩餘戰力高的好，一樣就花得少的好。rec＝[剩餘%, 花費]。
    76	static func better(a: Array, b: Array) -> bool:
    77		if b.is_empty():
    78			return true
    79		return int(a[0]) > int(b[0]) or (int(a[0]) == int(b[0]) and int(a[1]) < int(b[1]))
    80	
    81	## 記一場（贏了才記）。回傳 true＝新紀錄。best＝存檔的 daily_best（會被修改、只留最近 KEEP_DAYS 天）。
    82	static func record(best: Dictionary, sp: Dictionary, rem: int, spent: int) -> bool:
    83		var k: String = sp["key"]
    84		var cur: Array = best.get(k, [])
    85		var nw := better([rem, spent], cur)
    86		if nw:
    87			best[k] = [rem, spent]
    88		var keys: Array = best.keys()
    89		keys.sort_custom(func(a, b): return int(str(a).get_slice("-", 0)) > int(str(b).get_slice("-", 0)))
    90		for i in range(KEEP_DAYS, keys.size()):
    91			best.erase(keys[i])
    92		return nw
    93	
    94	
    95	## 這一天的完整規則（自由部署、16×9、單局；再套突變）。mask＝能用的兵種（正式版全開）。
    96	static func make_rules(sp: Dictionary, mask: int):
    97		var r = Presets.make("standard", "ai", mask)
    98		r.deploy = "free"
    99		r.spacing = 800
   100		r.depth = 6000
   101		r.fullfield = 0
   102		var s: Array = MapDefs.SIZE_SUGGEST[1]
