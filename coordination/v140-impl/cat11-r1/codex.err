func _progress_and_achievements() -> void:
	var w: int = sim.winner
	# 第五輪：紀錄分欄。平衡認證的規則（或沒有規則的模式）＝標準戰績；其他自訂規則記在自訂戰績；沙盒什麼都不記。
	var kind := "duel" if mode == Mode.DUEL else "ai"
	var badge: String = Presets.badge(rules, kind) if rules != null else Presets.BADGE_CERT
	if badge == Presets.BADGE_LAB:
		_save()
		return
	var standard: bool = rules == null or Presets.is_standard_record(rules, kind)
	if free_intro:
		Save.data["free_intro_done"] = true
		free_intro = false
	Save.data["unlock_games"] = int(Save.data.get("unlock_games", 0)) + 1   # 只是累計場數（判斷新玩家用），不解鎖任何東西
	var me_won := w == 0 or (mode == Mode.DUEL and w >= 0)
	var stat_key := "stats" if standard else "custom_stats"
	var st: Dictionary = Save.data.get(stat_key, {"wins": 0, "games": 0})
	st["games"] = int(st.get("games", 0)) + 1
	if w == 0 and mode != Mode.DUEL:
		st["wins"] = int(st.get("wins", 0)) + 1
	Save.data[stat_key] = st
	_v8_achievements(w)   # 奇幻軍是娛樂變體，要放在「自訂規則提前返回」之前（Codex 第 3 輪）
	# 圖鑑老兵筆記：派這個兵種贏一場 +1（第二輪方案 R3）。第十輪 B4：自訂規則、奇幻軍也算（放在提前返回之前）
	var types := {}
	if me_won:
		for u in sim.units:
			if u.team == w:
				types[D.report_type(u.type)] = true
		CX.record_win(Save.data, types.keys())
	if not standard:
		# 自訂規則專屬成就（標準成就只看標準局）
		if me_won and mode == Mode.VS_AI and w == 0:
			if rules.budget_of(0) <= 50:
				_ach("CUSTOM_LOWGOLD")
			if rules.budget_of(0) < rules.budget_of(1):
				_ach("CUSTOM_UNDERDOG")
		if me_won and rules.unit_cap >= 36:
			_ach("CUSTOM_BIG")
		_save()
		return
	if me_won:
		_ach("FIRST_WIN")
		if sim.alive_count(w) == 1:
			_ach("LONE_HERO")
		if int(report["sus"]["max_swing_pct"]) >= 15:
			_ach("COMEBACK")
		if sim.power(w) * 100 / (sim.budget * 1000) <= 5:
			_ach("CLOSE_CALL")
		if sim.tick >= Sim.FRENZY_TICK:
			_ach("FRENZY_WIN")
		if types.size() == 5:
			_ach("ALL_TYPES")
		if int(ev_count.get("charge%d" % w, 0)) >= 5:
			_ach("CHARGE_5")
		if int(ev_count.get("backstab%d" % w, 0)) >= 3:
			_ach("BACKSTAB_3")
	if mode == Mode.VS_AI and w == 0 and difficulty == 2:
		_ach("HARD_WIN")
	if mode == Mode.DUEL and tp != null and series_over:
		_ach("NO_TAKEBACKS")
	if series_over and ((mode == Mode.DUEL and (wins == [2, 0] or wins == [0, 2])) or (mode == Mode.VS_AI and wins == [2, 0])):
		_ach("SWEEP")
	if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and puzzle_id != "ws":   # V1.1 D3：工坊殘局不存星數
		var stars := int(report.get("stars", 0))
		var ps: Dictionary = Save.data.get("puzzle_stars", {})
		if stars > int(ps.get(puzzle_id, 0)):
			ps[puzzle_id] = stars
		Save.data["puzzle_stars"] = ps
		if mode == Mode.PUZZLE and has_method("_od_after"):
			call("_od_after", puzzle_id, stars)   # 1.3.0 §12.7 每日老闆出題
		if stars >= 1 and has_method("_coach_after_clear"):
			call("_coach_after_clear", stars)   # V1.6.1 A4：自力最佳另記
		if mode == Mode.PUZZLE:
			Save.note_try("puzzle", puzzle_id, stars >= 1, armies[0].spent())   # V1.1 F2
			if stars >= 1:
				_puzzle_record(puzzle_id, armies[0].spent(), armies[0].units.size(), sim.tick)
				_best_sol_record(puzzle_id, stars)
		if mode == Mode.TUTORIAL and w == 0:
			var idx := 0
			for i in PZ.tutorials().size():
				if PZ.tutorials()[i]["id"] == puzzle_id:
					idx = i
			Save.data["tutorial"] = maxi(int(Save.data.get("tutorial", 0)), idx + 1)
			if int(Save.data["tutorial"]) >= PZ.tutorials().size():
				_ach("TUTORIAL")
		if stars == 3:
			_ach("PUZZLE_3STAR")
		var all_done := true
		for p in PZ.puzzles():
			if int(ps.get(p["id"], 0)) == 0:
				all_done = false
		if all_done:
			_ach("PUZZLE_ALL")
		var cleared := 0
		var perfect := 0
		for p2 in PZ.all_puzzles():
			cleared += 1 if int(ps.get(p2["id"], 0)) > 0 else 0
			perfect += 1 if int(ps.get(p2["id"], 0)) >= 3 else 0
		if cleared >= 100:
			_ach("PUZZLE_100")   # 第十三輪
		if perfect >= 100:
			_ach("PUZZLE_ALL3")
	if mode == Mode.GAUNTLET and play_kind == "official":
		# V1.4 #2 宿敵戰記：輸了記下打敗你的陣；打贏宿敵就是復仇
		call("_settle_contract")   # V1.4 #3：每一戰結束就結算契約
		if w == 1 and last_armies.size() == 2:   # 和局不算被打敗（Codex v140-i1）
			call("_nemesis_record", last_armies[1])
		elif w == 0 and int(get("gauntlet_nemesis")) >= 0:
			var nl: Array = Save.data.get("nemeses", [])
			var ni := int(get("gauntlet_nemesis"))
			if ni < nl.size():
				nl[ni]["revenged"] = true
				_ach("REVENGE")
				_toast(L.t("nem_revenge", [call("nemesis_title", nl[ni])]))
	if mode == Mode.GAUNTLET:
		if w == 0:
			if gauntlet_stage >= 7:
				_ach("GAUNTLET")
				Save.data["gauntlet_best"] = 7
				_gauntlet_clear()
		else:
			_gauntlet_clear()
			Save.data["gauntlet_best"] = maxi(int(Save.data.get("gauntlet_best", 0)), gauntlet_stage - 1)
	_save()

	return p >= 31 and (p & (p + 1)) == 0

## 徽章：動到沙盒＝沙盒；驗證過的組合＝平衡認證；其他＝娛樂變體。
## 對 AI：100 金、24 隻、不限單種、90 秒、前綴卡池（第四輪驗收的條件）。
## 雙人：再加上經典 5 種＋snake5（第四輪 snake5 三種 AI 強度都在 45～55%）。
static func badge(r, kind: String) -> String:
	if r.is_sandbox():
		return BADGE_LAB
	if r.cmd_on() or r.adj:
		return BADGE_FUN    # 第十二輪：手動技能沒有平衡認證；V1.6 #22 相鄰陣法也是
	var base: bool = r.budget_of(0) == 100 and r.budget_of(1) == 100 and r.unit_cap == 24 and r.type_cap == 0 and r.ticks == 1800
	# 第六輪：部署也要是驗過的——格子，或自由＋預設的間距與縱深；全場一律算娛樂變體
	base = base and deploy_certified(r)
	if kind == "ai":
		return BADGE_CERT if base and is_prefix(r.pool_of(0)) and r.pool_of(1) == r.pool_of(0) else BADGE_FUN
	return BADGE_CERT if base and r.pool_of(0) == 31 and r.pool_of(1) == 31 and r.place_rule == "snake5" and not r.carry else BADGE_FUN

static func deploy_certified(r) -> bool:
	if r.fullfield != 0 or not r.map_is_default():
		return false   # V9：地圖是娛樂變體，平衡認證只給平原中型
	return r.deploy == "grid" or (r.spacing == FREE_SPACING and r.depth == FREE_DEPTH)

## 算不算「標準紀錄」（標準戰績、標準成就；Codex 實作第 1 輪：和「平衡認證」分開判定）。
## 除了認證條件，系列也要是標準的：三戰兩勝、保留陣型、沒有讓子；對 AI 卡池兩邊相同；雙人 snake5、不累積。
static func is_standard_record(r, kind: String) -> bool:
	if badge(r, kind) != BADGE_CERT:
		return false
	if r.rounds != 3 or not r.keep_formation or r.handicap:
		return false
	if kind == "ai":
		return r.ai_pool_same
	return r.place_rule == "snake5" and not r.carry

## 部署限制是不是「標準」（前 N 種卡池、24 隻、不限單種、100 金）：對戰代碼可以用舊格式 NTB2、AI 不額外補兵。
static func deploy_standard(r) -> bool:
	return r.unit_cap == 24 and r.type_cap == 0 and r.budget_of(0) == 100 and r.budget_of(1) == 100 and is_prefix(r.pool_of(0)) and r.pool_of(1) == r.pool_of(0)

## 大廳卡池能選的兵：對 AI＝已解鎖的；雙人＝全部（試玩版＝前 7 種）。
static func selectable(kind: String, unlocked: int, demo: bool) -> int:
	var all_p: int = (RSET.prefix_pool(7) | (1 << 11)) if demo else RSET.full_pool()   # 試玩版：舊 7 種＋爆爆羊
	return (unlocked & all_p) if kind == "ai" else all_p

## 把規則裡不能選的兵拿掉（解鎖進度、試玩版）；拿掉後沒有戰鬥兵就退回可選的全部。回傳被拿掉的兵種。
static func clamp_pool(r, kind: String, unlocked: int, demo: bool) -> Array:
	var sel := selectable(kind, unlocked, demo)
	var removed: Array = []
	for tm in 2:
		var p := int(r.pool[tm])
		for t in D.total():
			if RSET.has(p, t) and not RSET.has(sel, t) and not t in removed:
				removed.append(t)
		p &= sel
		if not RSET.has_combat(p):
			p = sel
		r.pool[tm] = p
	return removed
