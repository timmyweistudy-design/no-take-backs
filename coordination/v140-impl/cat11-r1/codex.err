 const ALIASES := {"new": "units"}
 ## V1.1 E2：新測試只要登記在 FILES；ORDER 只保留舊執行順序，沒列到的依 FILES 順序接在後面。
 const ORDER := ["test_cat_pull", "test_modes_v9", "test_flows_v9", "test_v10_fixes", "test_v10_input", "test_v10_feel", "test_v10_demo", "test_unit_brief", "test_no_unlock", "test_cmd_sim", "test_cmd_ui", "test_star_solutions", "test_trial_rules_valid", "test_maps_v9", "test_maps_mirror_v9", "test_gait_v9", "test_gait_driver_v9", "test_army_rules", "test_turn_placement", "test_determinism_and_mirror", "test_termination", "test_traits", "test_rule_fixes", "test_suspense", "test_codes_and_snake", "test_rally", "test_nav_r1", "test_puzzle_solutions", "test_codex", "test_event_routes", "test_ui_consumers", "test_sfx_priority", "test_save_migration", "test_play_effects", "test_input_queue", "test_golden", "test_crowd_readability", "test_replay_tools", "test_counter_lib", "test_seek_clutch", "test_clutch_effects", "test_new_units", "test_roster_ui", "test_rules_v5", "test_sandbox_v5", "test_battle_code_v5", "test_rules_e2e_v5", "test_lobby_reopen_v5", "test_free_v6", "test_free_skip_v6", "test_review_free_v6", "test_to_free_keeps_units_v6", "test_free_review_fixes_v6", "test_save_v7", "test_harness_v7", "test_code_fuzz_v7", "test_keymap_v7", "test_replay_back_v7", "test_steam_v7", "test_fantasy_legacy_v8", "test_fantasy_rules_v8", "test_fantasy_regress_v8", "test_fantasy_mirror_v8", "test_fantasy_codes_v8", "test_fantasy_game_v8", "test_fantasy_codex_text_matches_stats"]
diff --git a/game/tests/suites/modes.gd b/game/tests/suites/modes.gd
index 7ec71a0..843c098 100644
--- a/game/tests/suites/modes.gd
+++ b/game/tests/suites/modes.gd
@@ -1599,3 +1599,43 @@ func test_wave_code_v151() -> void:
 	ok(GM.wave_decode(code + "x").is_empty() and GM.wave_decode(GM.wave_code(["NTS1.abc"])).is_empty() and GM.wave_decode(GM.wave_code([c1, c1, c1, c1])).is_empty(), "壞碼、非對戰代碼、四波都拒絕")
 	var GMenu = load("res://scripts/ui/screens/game_menus.gd")
 	ok(GMenu.code_kind(code) == "waves", "一鍵辨識認得車輪戰代碼")
+
+
+## 1.4.0 §11.1 無盡塔：每層規則合法、敵陣固定（跨機器一樣）、突變輪換、敵方預算遞增有上限、續局與最高層
+func test_tower_v140() -> void:
+	var TW = load("res://scripts/game/tower.gd")
+	var muts := {}
+	var prev_bonus := -1
+	for f in range(1, 41):
+		var sp: Dictionary = TW.spec(f)
+		muts[int(sp["mut"])] = true
+		ok(int(sp["bonus"]) >= prev_bonus and int(sp["bonus"]) <= TW.BONUS_MAX, "第 %d 層敵方加碼遞增、有上限" % f)
+		prev_bonus = int(sp["bonus"])
+		var r = TW.make_rules(sp, RS9.full_pool())
+		var bad: Array = r.validate()
+		ok(bad.is_empty(), "第 %d 層規則合法" % f, str(bad))
+		ok(int(r.budget_of(1)) == mini(RS9.BUDGET_MAX, int(r.budget_of(0)) + int(sp["bonus"])), "第 %d 層敵方預算＝我方＋加碼（夾在上限內）" % f)
+		var e = TW.enemy(sp, r)
+		ok(e.has_combat() and e.units.size() > 0, "第 %d 層敵陣有戰鬥兵" % f)
+		var e2 = TW.enemy(TW.spec(f), TW.make_rules(TW.spec(f), RS9.full_pool()))
+		ok(e.to_code() == e2.to_code(), "第 %d 層同一支敵軍（只由層數決定）" % f)
+		for u in e.units:
+			ok(RS9.has(r.pool_of(1), int(u["type"])), "第 %d 層敵兵在卡池內" % f)
+	ok(muts.size() == 8, "前 40 層 8 種突變都出現")
+	ok(TW.spec(0)["floor"] == 1 and TW.spec(-3)["floor"] == 1, "層數至少 1")
+	ok(TW.record(3, 5) == [5, true] and TW.record(7, 5) == [7, false], "最高層：刷新才更新")
+	ok(TW.next_run(4, 4, true) == 5 and TW.next_run(4, 4, false) == 0, "續局：贏了下一層、輸了清掉")
+	ok(TW.sanitize_run("x") == 0 and TW.sanitize_run(-2) == 0 and TW.sanitize_run(12.0) == 12, "續局欄位驗型")
+	var SV = load("res://scripts/game/save.gd")
+	var d := {"tower_best": "bad", "tower_run": [1]}
+	SV.sanitize_data(d)
+	ok(int(d["tower_best"]) == 0 and int(d["tower_run"]) == 0, "存檔壞資料清成 0")
+	var GM = load("res://scripts/ui/screens/game_menus.gd")
+	var found := false
+	for row in GM.CLEAR_KEYS:
+		if "tower_best" in row[1] and "tower_run" in row[1]:
+			found = true
+	ok(found, "清除戰績會清無盡塔")
+	var csv: String = FileAccess.get_file_as_string("res://data/strings.csv")
+	for k in ["tw_open", "hc_tw_d", "tw_head", "tw_next", "tw_again", "tw_floor_clear", "tw_over", "tw_resume"]:
+		ok(csv.find("\n%s," % k) >= 0, "無盡塔字串 %s" % k)
diff --git a/game/scripts/game/tower.gd b/game/scripts/game/tower.gd
new file mode 100755
index 0000000..9c52c07
--- /dev/null
+++ b/game/scripts/game/tower.gd
@@ -0,0 +1,35 @@
+extends RefCounted
+## 1.4.0 §11.1（1.3.0 延伸、stash 補完）：無盡塔——一路往上打，每層一種突變（沿用每日挑戰的 8 種）、地圖與 AI 性格輪換，
+## 敵方預算每層多一點（上限 +60）；輸一場就結束，記最高層數（本機）。每層的規則與敵陣只由層數決定（固定種子、跨機器一樣）。
+const Daily = preload("res://scripts/game/daily.gd")
+const AI = preload("res://scripts/core/ai_army.gd")
+const BONUS_STEP := 4     # 每層敵方多 4 金
+const BONUS_MAX := 60
+
+static func spec(floor_no: int) -> Dictionary:
+	var f := maxi(1, floor_no)
+	var mut := posmod(f - 1, Daily.MUTATORS)
+	return {"floor": f, "mut": mut, "map": 3 if mut == 3 else posmod(f * 5 + 2, 6), "style": posmod(f * 3 + 1, 5),
+		"level": clampi((f - 1) / 6, 0, 2), "seed": 70000 + posmod(f * 7919, 1000003), "bonus": mini(BONUS_MAX, (f - 1) * BONUS_STEP)}
+
+## 這一層的規則：每日挑戰的規則（自由部署、單局、突變）再加敵方預算。
+static func make_rules(sp: Dictionary, mask: int):
+	var r = Daily.make_rules(sp, mask)
+	var RS = load("res://scripts/core/ruleset.gd")
+	r.budget = [int(r.budget_of(0)), mini(RS.BUDGET_MAX, int(r.budget_of(1)) + int(sp["bonus"]))]   # 大地圖本來就接近上限：加碼夾在合法範圍內
+	r.handicap = int(r.budget[1]) != int(r.budget[0])   # 兩邊預算不同要開讓子，否則 budget_of 兩邊都取藍方（stash 原本漏了，測試抓到）
+	return r
+
+static func enemy(sp: Dictionary, r):
+	return Daily.enemy(sp, r)
+
+## 記最高層：過了第 f 層＝最高至少 f。回傳 [新最高, 是否刷新]。
+static func record(best: int, cleared_floor: int) -> Array:
+	return [maxi(best, cleared_floor), cleared_floor > best]
+
+## 續局：下一次要打的層（0＝沒有進行中的塔）。贏了＝下一層、輸了＝清掉；壞資料＝0。
+static func next_run(run: int, floor_no: int, won: bool) -> int:
+	return floor_no + 1 if won else 0
+
+static func sanitize_run(v) -> int:
+	return clampi(int(v), 0, 100000) if (v is int or v is float) else 0

