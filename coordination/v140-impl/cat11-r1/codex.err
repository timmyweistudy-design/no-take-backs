extends "res://scripts/ui/screens/game_core.gd"
## 由 game_screens.gd 拆出（V9 P1，行為不變）

# ───────────────────────── 狀態切換 ─────────────────────────
## 第十輪 B10：玩家按離開。系列打到一半或遠征途中，先確認（自動導頁直接呼叫 _go_title，不跳確認）。
func _leave_at_risk() -> bool:
	if state == St.TITLE or watch_mode:
		return false
	if mode == Mode.GAUNTLET:
		if state == St.RESULT and sim != null:
			return sim.winner == 0 and gauntlet_stage < 7
		return gauntlet_stage > 1
	if mode == Mode.VS_AI or mode == Mode.DUEL:
		return wins[0] + wins[1] > 0 and not series_over
	return false

func _request_leave() -> void:
	if _leave_at_risk():
		overlay = "leave"
		_focus = 0
	else:
		_go_title()

func _leave_confirm() -> void:
	overlay = ""
	_go_title()

func _go_title() -> void:
	call("_rift_sync")   # 1.2.0 §11.9：回主畫面時補送當週天梯成績（沒有連線事件可接，回主畫面是固定的重試點；Codex cat10 #7）
	var rs = get("rush")
	if rs is Dictionary and bool(rs.get("on", false)):
		rs["on"] = false   # V1.6 #8：離開就結束極速賽（不記紀錄）
	set("rift_on", false)   # V1.6 #10
	set("trio_on", false)   # V1.6 #17
	set("fog_on", false)   # V1.6 #20
	set("tv_mark_mode", false)   # V1.6 #6：標記模式不能帶到別的畫面（Antigravity v160-i1 #1）
	set("tv_marks", [])
	set("ga_coop", false)   # V1.6 #21：續局時從存檔讀回
	set("challenge_army", null)   # 每日高手陣、裂隙的敵陣不能留到一般對 AI（Antigravity v160-i1 #2）
	set("wv_active", false)   # V1.4 #11：離開就結束車輪戰
	set("wv_mode", false)
	set("sealed_on", false)   # V1.4 #13
	set("sealed", [[], []])
	set("ghost_id", "")
	set("wk_active", false)
	set("wg_active", false)   # V1.4 #16：離開就取消押注，不能拿下一場來結算（Codex v140-i2）
	call("_pre_drop")
	Save.retry_pending()   # 第七輪 R7：上次沒寫成功的補寫；還是失敗，標題頁會常駐提示
	sfx.set_muffled(false)
	watch_mode = false
	clutch_t = 0.0
	state = St.TITLE
	overlay = ""
	set("settings_ret", "")
	nav_stack.clear()
	if nav_hub != "":
		overlay = nav_hub   # V1.5.1：從卡片面板進去打完，回來時回到那個面板
	sim = null
	view = null
	zoom = 1.0
	_focus = int(nav_focus.get(overlay, 0)) if overlay != "" else 0   # V1.0.0（Codex v100-i3）：打完回卡片面板，焦點回原卡
	_new_demo()
	sfx.play_music("music_title")
	sfx.play_ambience("")



func _new_demo() -> void:
	var r := RandomNumberGenerator.new()
	r.seed = rng.randi()
	demo = Sim.new(AI.build(0, 100, r)["army"], AI.build(1, 100, r)["army"])
	demo.fast = true
	demo_acc = 0.0



## 第六輪（Codex 實作第 1 輪 #5）：雙人全場被封鎖到跳完手、一方沒有戰鬥兵時，照樣按「開戰」——
## 模擬在第 0 tick 就依 §3.8 判定（有戰鬥兵的一方勝、雙方都沒有＝和局），不能卡在開戰鈕永久灰掉。
func _full_blocked_ok() -> bool:
	return mode == Mode.DUEL and tp != null and tp.done() and rules != null and rules.is_free() and rules.fullfield == RuleSet.FULL_DUEL


func _ready_to_fight() -> bool:
	if mode == Mode.DUEL:
		if tp != null:
			return tp.done() and (rules == null or _full_blocked_ok() or (armies[0].has_combat() and armies[1].has_combat()))
		return blind_phase == 2
	if rules != null:
		return armies[0].has_combat()
	return armies[0].count() > 0



## 第五輪：開戰鈕灰掉時要直接寫的原因（空字串＝可以開戰）。
func _start_block_reason() -> String:
	if state != St.PLACE:
		return ""
	if mode == Mode.DUEL and tp != null and not tp.done():
		return ""
	var a = _cur_army()
	if a.count() == 0:
		return ""
	if rules != null and not a.has_combat() and not _full_blocked_ok():
		return L.t("err_need_combat")
	return ""



## ── 1.2.0 §11.6 合作布陣 ──
const CoopPlace = preload("res://scripts/game/coop_place.gd")
var cp_on := false
var cp = null

func _cp_on() -> bool:
	return cp_on and cp != null and mode == Mode.VS_AI

func _cp_start() -> void:
	var r = RuleSet.standard()
	var dm: int = RS.mask(_demo())
	r.pool = [int(r.pool_of(0)) & dm, int(r.pool_of(1)) & dm]   # 標準卡池再扣掉試玩版沒有的兵（Codex cat10 #5）
	rules = r
	set("challenge_army", null)
	overlay = ""
	call("_start_mode", Mode.VS_AI)
	cp_on = true
	_cp_reset()
	_toast(L.t("cp_intro"))

func _cp_reset() -> void:
	cp = CoopPlace.new(armies[0].budget, RuleSet.priciest_in(armies[0].pool))

func _cp_head() -> String:
	if cp.done():
		return L.t("cp_ready")
	return L.t("cp_turn", ["P1" if cp.player() == 0 else "P2", cp.hand / 2 + 1, cp.hands_each, cp.cap - cp.spent])

func _on_start() -> void:
	_fp_abort_drag()   # 第六輪：拖曳中按開戰／準備好，拖曳作廢（Codex 實作第 2 輪 #2）
	if _cp_on() and not cp.done():
		cp.end_hand()   # 「結束這一手」：換人；買不起就全部結束
		cp.finish_if_stuck(_cur_army().can_afford_any())
		sfx.play("turn")
		return
	if mode == Mode.DUEL and tp != null and not tp.done():
		if not tp.end_turn():
		sprites.ensure_turn_atk(placed.keys())   # 轉身出手頁只烘已經在場上的（上限 10 種，不拿整個卡池去洗）

