static func save_settings() -> bool:
	return _tracked_write(_sp(), settings)

## 未來版存檔（R5）一律不寫，回傳 true 是因為這不是「寫入失敗」，畫面已經常駐提示。
static func save_data() -> bool:
	if data_locked:
		return true
	return _tracked_write(_dp(), data)

static func has_unsaved() -> bool:
	return not pending.is_empty()

## R7：上次寫入失敗就再試一次（換畫面、回標題時呼叫）。回傳 true＝現在沒有未存內容。
static func retry_pending() -> bool:
	if pending.has(_sp()):
		save_settings()
	if pending.has(_dp()):
		save_data()
	return pending.is_empty()

static func s(key: String):
	return settings.get(key, DEFAULT_SETTINGS.get(key))

static func set_setting(key: String, v) -> void:
	settings[key] = v
	save_settings()

## V1.5：一次改很多項（預設組合、匯入設定碼）只寫一次檔。
static func set_settings(d: Dictionary) -> void:
	for k in d:
		settings[k] = d[k]
	save_settings()

## V1.5：備份檔能不能拿來還原：要是進度存檔（有版本欄），而且不是比這版新的格式。
static func restorable(d) -> bool:
	if not d is Dictionary:
		return false
	var v = d.get("schema_version", d.get("version"))
	if not (v is int or v is float) or int(v) < 1 or int(v) > SAVE_VERSION:
		return false
	# 要有進度存檔一定有的欄位（只有版本欄的 JSON 不算，Codex v150-i2 #2）
	return d.get("stats") is Dictionary and d.get("achievements") is Array


## V1.1 F2：本機遊玩紀錄（不上傳、不升存檔版本）。kind＝"puzzle"／"trial"：每打一次 +1；
## 第一次過關時記下當時的嘗試次數與花費（first＝花費、first_try＝第幾次）。之後重打不改，用來校準三星。
static func note_try(kind: String, id: String, cleared: bool, cost: int) -> void:
	var tries: Dictionary = data.get(kind + "_tries", {})
	ai_name = ""
	overlay = ""
	armies = [a0.copy(), a1.copy()]
	wins = [0, 0]
	round_no = 1
	series_over = false
	last_player_formation = []
	last_armies = [a0.copy(), a1.copy()]
	rv_last = []
	_begin_battle(a0.copy(), a1.copy(), "replay")
	watch_mode = true


# ── 覆盤 ──
var rv_fsel := -1   # 第六輪：自由陣型覆盤選中的那一隻（索引）

func _open_review() -> void:
	rv_orig = last_armies[0].copy()
	rv_army = last_armies[0].copy()
	rv_enemy = last_armies[1].copy()
	rv_fsel = -1
	if rv_orig.deploy == "free":
		# 編輯識別（和戰鬥編號分開，Codex 第一輪）：覆盤時每隻帶 eid，「只改一隻」依 eid 比
		for i in rv_orig.units.size():
			rv_orig.units[i]["eid"] = i
			rv_army.units[i]["eid"] = i
		# 全場：搬移時也要守敵距
		var ep: Array = []
		for u in rv_enemy.units:
			ep.append(Army.pos_of(u))
		if rv_orig.depth > rv_orig.fw / 2:
			rv_army.enemy_pos = ep
			rv_orig.enemy_pos = ep.duplicate()
	rv_sel = Vector2i(-1, -1)
	_rv_dirty()
	_rv_base_start()
	_open("review")

## 跟原本比改了幾隻（換兵種、移位、拿掉、新增都算一隻）。
static func review_changes(orig, now) -> int:
	if orig.deploy == "free":
		var ma := {}
		for u in orig.units:
			ma[int(u.get("eid", -1))] = [int(u["type"]), int(u["x"]), int(u["y"])]
		var n := 0
		var seen := {}
			_rv_set_result(res)

## 結束時：叫停再等（64 tick 內會停）；GIF 也叫停。
func _rv_exit() -> void:
	_rv_cancel()
	if rv_base_thread != null:
		bg.retire(rv_base_thread)
		rv_base_thread = null
	gif_ctl["stop"] = true   # 真正的等待在 bg.drain()（battle_view._exit_tree）

func _rv_play() -> void:
	rv_last = [rv_army.copy(), rv_enemy.copy()]
	_replay_snapshot()
	replay_snap["overlay"] = "review"
	replay_marks = []
	overlay = ""
	_begin_battle(rv_army.copy(), rv_enemy.copy(), "review")
	# V1.4 #1 時光機：原本那條時間線跟著同步跑，畫成淡圈；從分岔前 2 秒開始看
	_tm_new_ghost()
	if rv_div > 40:
		_seek_async(rv_div - 40)

func _draw_review() -> void:
	_boss_note("review", "review")   # 1.2.0 §12.2：這個系統第一次出現時一張便條
	# 第五輪 §4.4：左＝自己的部署區（可改）＋紅方站位（半透明參考）；右＝換兵按鈕（標價）、重算、兩條上下對齊的戰力走勢。
	_panel(Rect2(100, 40, 1080, 720))   # V1.5.2：面板上緣提到 40、底列移到 704，英文／日文 150% 走勢說明不壓到「重播」鈕
	# V1.5.2 L3：說明從緞帶下緣＋16 起；說明換行時左右兩欄一起往下（dy），不壓到「你的部署」與兵種鈕
	var hint := L.t("rv_hint_free" if rv_orig.deploy == "free" else "rv_hint")
	var hy := _h1(Vector2(640, 40), L.t("rv_title")) + GAP_L
	hint = hint + "　" + L.t("rv_note")   # 1.2.0（Codex cat02 #2）：「不一定是敗因」的限制說明放在上方說明裡，一定看得到（原本在底部，放不下就不畫）
	_text(Vector2(640, hy), hint, tz("S"), TXT_DIM, true, false, 960)
