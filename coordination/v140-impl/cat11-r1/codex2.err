func _start_mode(m: int) -> void:
	var keep_rift: bool = rift_on and m == Mode.VS_AI and rules != null and rules.to_code() == rift_code   # 裂隙「再來一局」照舊（同一組規則才算）
	var mk := "%d:%s:%d:%d" % [m, puzzle_id, int(get("trial_id")), PZ.get_puzzle("ws").hash() if puzzle_id == "ws" else 0]   # 工坊、三考都叫 ws：再比題目內容（Codex v160-i3）
	if mk != tv_mode_key:
		tv_marks = []   # 換題、換模式：舊標記不帶過去（同一題重打保留）
		co_assist = ""   # V1.6.1 A4：換題就是新的嘗試（同一題重打照舊算教練協力）
	if mk != tv_mode_key or m != Mode.PUZZLE:
		trio_job += 1   # 換題、換模式：還在算的三考結果作廢
		_trio_cancel()
	tv_mode_key = mk
	fog_on = false
	tv_mark_mode = false
	var keep_trio: bool = trio_on and m == Mode.PUZZLE and puzzle_id == "ws" and PZ.get_puzzle("ws").has("trio")   # 一陣三考「重試」照舊
	rift_on = false
	trio_on = false
	super._start_mode(m)
	rift_on = keep_rift
	trio_on = keep_trio
	_prewarm_sprites()

## 1.2.0（Antigravity cat01 #1）：圖集烘焙原本在開戰那一刻才觸發，分段後最長一幀 78 ms 會出現在戰鬥開頭。
## 改成進擺陣就依兩邊卡池（含召喚物）預烘：擺陣時玩家在思考，分段烘焙藏在這段時間裡；開戰時 _ensure_sprites 只是確認（烘過的不重烘）。
func _prewarm_sprites() -> void:
	if sprites == null or armies.size() < 2:
		return
	var want := {}
	for a in armies:
		for t in D.total():
			if int(a.pool) & (1 << t):
				want[t] = true
		for u in a.units:
			want[int(u["type"])] = true
	if mode == Mode.PUZZLE or mode == Mode.TUTORIAL:
		return "pz:" + puzzle_id
	if mode == Mode.VS_AI and int(get("trial_id")) >= 0:
		return "tr:%d" % int(get("trial_id"))
	return ""

func _mark_retry() -> void:
	retry_key = retry_key_now()
	retry_units = last_armies[0].units.duplicate(true) if not last_armies.is_empty() else []

func _apply_retry() -> void:
	var k := retry_key
	var us := retry_units
	retry_key = ""
	retry_units = []
	if k == "" or k != retry_key_now() or armies.is_empty():
		return
	var a = armies[0]
	for u in us:
		var p: Vector2i = Army.pos_of(u)
		var here := false
		for v in a.units:
			if int(v["type"]) == int(u["type"]) and Army.pos_of(v) == p:
				here = true   # 固定兵、已經在的
				break
		if not here:
			call("_place_from", a, u)



func _cur_army():
	if mode == Mode.DUEL:
		if tp != null:
			return tp.armies[tp.current]
		return armies[0] if blind_phase == 0 else armies[1]
	return armies[0]



func _enemy_visible() -> bool:
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE or mode == Mode.GAUNTLET:
		return true
	if mode == Mode.DUEL:
		return tp != null
	return false



func _ai_pool(r: RandomNumberGenerator) -> int:
	var p1: int = rules.pool_of(1) if rules != null else _pool()
	if rules != null and rules.ai_style != 0:
		p1 = AI.style_pool(p1, rules.ai_style, r)
	return p1

## 第十輪 I4：困難 AI 第二局起要模擬候選陣型，放背景算，畫面不凍住。回傳 true＝已交給背景。
func _build_ai_async() -> bool:


## 「在覆盤裡試試」：直接開覆盤，選中第一隻陣亡的同種兵（A1）。
func _open_review_on_first_loss() -> void:
	_open_review()
	var dead_type := -1
	for u in sim.units:
		if u.team == 0 and not u.alive:
			dead_type = u.type
			break
	if dead_type < 0:
		return
	for i in rv_army.units.size():
		if int(rv_army.units[i]["type"]) == dead_type:
			if rv_army.deploy == "free":
				rv_fsel = i
			else:
				rv_sel = Vector2i(int(rv_army.units[i]["col"]), int(rv_army.units[i]["row"]))
			return



## 結果頁第二層：中線對比長條（輸出／承傷切換）＋技能徽章（只列有發生的）＋指紋。
var res_facts_all: Array = []
## 1.2.0：結果頁放不下時的完整事實清單（小面板）
func _draw_res_facts() -> void:
	var w := 820.0
	var hh := 0.0
	for f0 in res_facts_all:
		hh += text_h("・" + str(f0), tz("S"), w - 80) + 6
	var P := modal_rect(w, 12.0 + h1_bottom(0.0) + GAP_L + hh + GAP_L + 44.0 + GAP_L)
		wins = [0, 0]
		round_no = 1
		series_over = false
		last_player_formation = []
		_reset_place(false)
		return
	round_no += 1
	_apply_map_mode()
	_reset_place(mode == Mode.VS_AI)
	if bool(get("sealed_on")) and mode == Mode.DUEL:
		# V1.4 #13：下一局直接用封好的陣，不再擺
		var k := clampi(round_no - 1, 0, 2)
		call("_sealed_reveal", k)
		_toast(L.t("sealed_open", [k + 1]))



func _replay() -> void:
	# 重播只看不算：比分、進度、成就、日誌都不動（第三輪 A1，原本會重複結算）
	replay_marks = _key_marks() if not report.is_empty() else []
	_replay_snapshot()
	if play_kind == "review" and rv_last.size() == 2:
		_begin_battle(rv_last[0].copy(), rv_last[1].copy(), "review")
		return
	_begin_battle(last_armies[0].copy(), last_armies[1].copy(), "replay")



func _next_puzzle() -> void:
	var list: Array = PZ.tutorials() if mode == Mode.TUTORIAL else PZ.all_puzzles()   # 第十三輪：照章節順序接下一關
	for i in list.size():
	if not _replay_controls_active() and not (paused and state == St.BATTLE):
		return
	var world := _cam.affine_inverse() * p
	var best := -1
	var bd := 40.0 * HK   # 1.3.0：點兵半徑跟角色尺寸（Codex cat04 #2）
	for u in view.units:
		if u.alive:
			var d := _upos(u).distance_to(world + Vector2(0, 20 * HK))
			if d < bd:
				bd = d
				best = u.id
	follow_id = best
	if play_kind == "official":
		return   # 正式對局暫停時只看資料，不動鏡頭
	if best >= 0:
		pinch_zoom = 1.0   # 1.3.0 §2：點兵跟拍＝新的意圖，取代手動縮放
		dir_manual = true
	if best < 0:
		zoom_target = 1.0   # 取消跟拍：回到全景（中心由 _battle_process 拉回）

## 暫停（第七輪 A6）：正式對局也能停下來看；繼續時放掉選取。
func _toggle_pause() -> void:
	paused = not paused
	if not paused and play_kind == "official":
		follow_id = -1


## 進重播前存結算畫面（第七輪 A9）。
func _replay_snapshot() -> void:
	if play_kind != "official" and not replay_snap.is_empty():
		return   # Codex r2：重播完再重播，返回目的地還是最早那個結算
	replay_snap = {"sim": sim, "view": view, "report": report, "marks": battle_marks.duplicate(true), "kind": play_kind,
		"tab": result_tab, "overlay": "", "ev_count": ev_count.duplicate(), "pt_rated": pt_rated, "pt_call": pt_call_tick}

## 重播的「返回」：回到進來的地方。只還原畫面，比分、進度、成就、試玩紀錄都不寫。
func _replay_back() -> void:
	tm_ghost = null   # V1.4 #1：回到結果頁，原本時間線的淡圈不能留下
	call("_pre_drop")
	seek_target = -1   # Codex r1：算到一半返回，不能把下一場快轉到舊目標
	skip_busy = false
	paused = false
	follow_id = -1
	zoom = 1.0
	zoom_target = 1.0
	fx.clear()
	frags.clear()   # 1.2.0 §8.2
	dying.clear()
	report_log.clear()
	sfx.set_muffled(false)
	if watch_mode or replay_snap.is_empty():
		call("_go_title")
		return
	sim = replay_snap["sim"]
	view = replay_snap["view"]
	report = replay_snap["report"]
	battle_marks = replay_snap["marks"]
	play_kind = replay_snap["kind"]
	result_tab = replay_snap["tab"]
	ev_count = replay_snap["ev_count"]   # Codex r1：戰報、評分狀態也要還原，不然同一局能再評一次
	pt_rated = replay_snap["pt_rated"]
	pt_call_tick = replay_snap["pt_call"]
	overlay = replay_snap["overlay"]
	result_delay = 0.0
	state = St.RESULT
	replay_snap = {}


## 從關鍵時刻開始重播（第七輪 A7）。
func _replay_from(t: int) -> void:
	call("_replay")
	_seek_async(t)


func _follow_update(delta: float) -> void:
	if play_kind == "official":
		return
	if follow_id < 0 or view == null or state != St.BATTLE:
		return
	var u = view.unit_by_id(follow_id)
	if u == null or not u.alive:
		follow_id = -1
		return
	zoom_target = 1.45
	zoom_center = zoom_center.lerp(_upos(u), minf(1.0, delta * 6.0))
	zoom = lerpf(zoom, zoom_target, minf(1.0, delta * 4.0))

