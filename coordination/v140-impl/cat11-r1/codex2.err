extends "res://scripts/ui/screens/game_core.gd"
## 由 game_screens.gd 拆出（V9 P1，行為不變）

# ───────────────────────── 狀態切換 ─────────────────────────
## 第十輪 B10：玩家按離開。系列打到一半或遠征途中，先確認（自動導頁直接呼叫 _go_title，不跳確認）。
func _leave_at_risk() -> bool:
	if state == St.TITLE or watch_mode:
		return false
	if mode == Mode.GAUNTLET:
		if state == St.RESULT and sim != null:
			return sim.winner == 0 and gauntlet_stage < 7
		return gauntlet_stage > 1
	if mode == Mode.VS_AI or mode == Mode.DUEL:
		return wins[0] + wins[1] > 0 and not series_over
	return false

func _request_leave() -> void:
	if _leave_at_risk():
		overlay = "leave"
		_focus = 0
	else:
		_go_title()

func _leave_confirm() -> void:
	overlay = ""
	_go_title()

func _go_title() -> void:
	call("_rift_sync")   # 1.2.0 §11.9：回主畫面時補送當週天梯成績（沒有連線事件可接，回主畫面是固定的重試點；Codex cat10 #7）
	var rs = get("rush")
	if rs is Dictionary and bool(rs.get("on", false)):
		rs["on"] = false   # V1.6 #8：離開就結束極速賽（不記紀錄）
	set("rift_on", false)   # V1.6 #10
	set("trio_on", false)   # V1.6 #17
	set("fog_on", false)   # V1.6 #20
	set("tv_mark_mode", false)   # V1.6 #6：標記模式不能帶到別的畫面（Antigravity v160-i1 #1）
	set("tv_marks", [])
	set("ga_coop", false)   # V1.6 #21：續局時從存檔讀回
	set("challenge_army", null)   # 每日高手陣、裂隙的敵陣不能留到一般對 AI（Antigravity v160-i1 #2）
	set("wv_active", false)   # V1.4 #11：離開就結束車輪戰
	set("wv_mode", false)
	set("sealed_on", false)   # V1.4 #13
	set("sealed", [[], []])
	set("ghost_id", "")
	set("wk_active", false)
	set("wg_active", false)   # V1.4 #16：離開就取消押注，不能拿下一場來結算（Codex v140-i2）
	call("_pre_drop")
	Save.retry_pending()   # 第七輪 R7：上次沒寫成功的補寫；還是失敗，標題頁會常駐提示
	sfx.set_muffled(false)
	watch_mode = false
	clutch_t = 0.0
	state = St.TITLE
	overlay = ""
	set("settings_ret", "")
	nav_stack.clear()
	if nav_hub != "":
		overlay = nav_hub   # V1.5.1：從卡片面板進去打完，回來時回到那個面板
	sim = null
	view = null
	zoom = 1.0
	_focus = int(nav_focus.get(overlay, 0)) if overlay != "" else 0   # V1.0.0（Codex v100-i3）：打完回卡片面板，焦點回原卡
	_new_demo()
	sfx.play_music("music_title")
	sfx.play_ambience("")



func _new_demo() -> void:
	var r := RandomNumberGenerator.new()
	r.seed = rng.randi()
	demo = Sim.new(AI.build(0, 100, r)["army"], AI.build(1, 100, r)["army"])
	demo.fast = true
	demo_acc = 0.0



## 第六輪（Codex 實作第 1 輪 #5）：雙人全場被封鎖到跳完手、一方沒有戰鬥兵時，照樣按「開戰」——
## 模擬在第 0 tick 就依 §3.8 判定（有戰鬥兵的一方勝、雙方都沒有＝和局），不能卡在開戰鈕永久灰掉。
func _full_blocked_ok() -> bool:
	return mode == Mode.DUEL and tp != null and tp.done() and rules != null and rules.is_free() and rules.fullfield == RuleSet.FULL_DUEL


func _ready_to_fight() -> bool:
	if mode == Mode.DUEL:
		if tp != null:
			return tp.done() and (rules == null or _full_blocked_ok() or (armies[0].has_combat() and armies[1].has_combat()))
		return blind_phase == 2
	if rules != null:
		return armies[0].has_combat()
	return armies[0].count() > 0



## 第五輪：開戰鈕灰掉時要直接寫的原因（空字串＝可以開戰）。
func _start_block_reason() -> String:
	if state != St.PLACE:
		return ""
	if mode == Mode.DUEL and tp != null and not tp.done():
		return ""
	var a = _cur_army()
	if a.count() == 0:
		return ""
	if rules != null and not a.has_combat() and not _full_blocked_ok():
		return L.t("err_need_combat")
	return ""



## ── 1.2.0 §11.6 合作布陣 ──
const CoopPlace = preload("res://scripts/game/coop_place.gd")
var cp_on := false
var cp = null

func _cp_on() -> bool:
	return cp_on and cp != null and mode == Mode.VS_AI

func _cp_start() -> void:
	var r = RuleSet.standard()
	var dm: int = RS.mask(_demo())
	r.pool = [int(r.pool_of(0)) & dm, int(r.pool_of(1)) & dm]   # 標準卡池再扣掉試玩版沒有的兵（Codex cat10 #5）
	rules = r
	set("challenge_army", null)
	overlay = ""
	call("_start_mode", Mode.VS_AI)
	cp_on = true
	_cp_reset()
	_toast(L.t("cp_intro"))

func _cp_reset() -> void:
	cp = CoopPlace.new(armies[0].budget, RuleSet.priciest_in(armies[0].pool))

func _cp_head() -> String:
	if cp.done():
		return L.t("cp_ready")
	return L.t("cp_turn", ["P1" if cp.player() == 0 else "P2", cp.hand / 2 + 1, cp.hands_each, cp.cap - cp.spent])

func _on_start() -> void:
	_fp_abort_drag()   # 第六輪：拖曳中按開戰／準備好，拖曳作廢（Codex 實作第 2 輪 #2）
	if _cp_on() and not cp.done():
		cp.end_hand()   # 「結束這一手」：換人；買不起就全部結束
		cp.finish_if_stuck(_cur_army().can_afford_any())
		sfx.play("turn")
		return
	if mode == Mode.DUEL and tp != null and not tp.done():
		if not tp.end_turn():
			_toast(L.t("err_cantskip"), true)
		else:
			sfx.play("turn")
		return
	if mode == Mode.DUEL and tp == null and blind_phase < 2:
		if _cur_army().count() == 0:
			_toast(L.t("err_empty"), true)
			return
		if rules != null and not _cur_army().has_combat():
			_toast(L.t("err_need_combat"), true)
			return
		if bool(get("sealed_on")):
			# V1.4 #13 雙封蠟戰書：每人封三個陣，封好一個就清空再擺下一個；三個都封好才換人
			var tm: int = blind_phase
			var sl: Array = get("sealed")[tm]
			sl.append(_cur_army().units.duplicate(true))
			sfx.play("turn")
			_cur_army().units = []
			if sl.size() < 3:
				_toast(L.t("sealed_done", [sl.size()]))
			sw = call("_swap_fact")   # 1.2.0 §11.5：換邊雙局照玩家總分，不照顏色勝場（Codex cat10 #1）
		_text(Vector2(640, y), L.t("series_end", [sw]), tz("B"), ACCENT, true, true, 820)
		y += tz("B") * 1.5
	if mode == Mode.GAUNTLET:
		var msg := ""
		if w == 0 and gauntlet_stage >= 7:
			msg = L.t("gauntlet_clear")
		elif w != 0:
			msg = L.t("gauntlet_over", [gauntlet_stage - 1])
		if msg != "":
			_text(Vector2(640, y), msg, tz("B"), ACCENT, true, true, 820)
			y += tz("B") * 1.5
	if bool(Save.s("playtest")) and not pt_rated:
		_text(Vector2(214, 160), L.t("pt_rate"), tz("C"), ACCENT, false, false, 200)
		for i in 5:
			_btn(Rect2(214 + i * 36, 160 + tz("C") * 1.4, 32, 32), str(i + 1), _pt_rate.bind(i + 1))
	# 試玩版結尾（第三輪 F5）
	if _demo() and series_over and play_kind == "official":
		var wr := Rect2(260, minf(y, 588), 760, 52)
		draw_rect(wr, Color(0.35, 0.22, 0.05, 0.95))
		draw_rect(wr, ACCENT, false, 2.0)
		_text(Vector2(276, wr.position.y + 12), L.t("demo_wish"), tz("S"), Color.WHITE, false, true, 480)
		var url: String = SteamApi.STORE_URL
		_btn(Rect2(780, wr.position.y + 6, 230, 40), L.t("demo_wish_btn") if url != "" else L.t("demo_wish_soon"), func(): OS.shell_open(url), url != "", true)
	var bs: Array = []
	match mode:
		Mode.VS_AI, Mode.DUEL:
			if get("trial_id") >= 0:
				var tid: int = get("trial_id")
				if w == 0 and tid + 1 < get("TRIALS").size():
					bs.append([L.t("next_puzzle"), func(): call("_start_trial", tid + 1)])
				bs.append([L.t("retry"), func(): _mark_retry(); call("_start_trial", tid); _apply_retry()])
				bs.append([L.t("trial_title"), func():
					_go_title()
					_open("trials")])
			else:
				bs.append([(L.t("sealed_again") if bool(get("sealed_on")) else L.t("new_match")) if series_over else L.t("next_round"), func(): _next_round()])
		Mode.TUTORIAL, Mode.PUZZLE:
			bs.append([L.t("retry"), func(): _mark_retry(); _start_mode(mode)])
			if ((w == 0 and mode == Mode.TUTORIAL) or bool(report.get("goal_ok", false))) and puzzle_id != "ws":
				bs.append([L.t("next_puzzle"), func(): _next_puzzle()])
			if puzzle_id == "ws" and bool(report.get("goal_ok", false)) and play_kind == "official" and not bool(get("trio_on")):
				bs.append([L.t("rl_btn"), func(): call("_open_relay")])   # V1.4 #5 接力：改兩隻敵兵傳回去
		Mode.GAUNTLET:
			if w == 0 and gauntlet_stage < 7:
				bs.append([L.t("continue"), func(): call("_gauntlet_reward")])
			else:
				bs.append([L.t("menu_gauntlet"), func(): _start_mode(Mode.GAUNTLET)])
	if bool(get("wv_mode")) and mode == Mode.VS_AI:
		# V1.4 #11 車輪戰：贏了接下一波（殘兵帶著走），輸了或打完三波就結束（結算在戰鬥結束時做一次）
		bs.clear()
		if bool(get("wv_active")) and w == 0 and int(get("wv_no")) < 3:
			bs.append([L.t("wv_next", [int(get("wv_no")) + 1]), func(): call("_wave_next")])
		else:
			bs.append([L.t("wv_again"), func(): call("_wave_start")])
			if not (get("wv_codes") as Array).is_empty():
				bs.append([L.t("wv_copy"), func(): DisplayServer.clipboard_set(call("wave_code", get("wv_codes"))); _toast(L.t("bc_copied"))])
	if bool(get("tower_on")) and mode == Mode.VS_AI:
		# 1.4.0 §11.1 無盡塔：贏了爬下一層，輸了從第 1 層重來
		var tb: Array = call("tower_button", int(get("tower_result")), int(get("tower_floor")))
		if not tb.is_empty():
			bs.clear()
			var nf: int = int(tb[1])
			bs.append([L.t(str(tb[0]), [nf]) if nf > 1 else L.t(str(tb[0])), func(): call("_tower_start", nf)])
	if watch_mode:
		bs.clear()   # 看對戰代碼：不接正式對局的「下一局」（Codex S5 #2）

	var n_main := bs.size()   # V1.5：前面這幾顆是主動作（繼續、重試、下一題），後面是次入口
	if mode == Mode.VS_AI and last_armies.size() == 2 and not watch_mode:
		if _near_miss():
			bs.insert(0, [L.t("review_near"), func(): _open_review()])   # 第十輪 F4：輸得很近，主推覆盤
			n_main += 1
		else:
			bs.append([L.t("menu_review"), func(): _open_review()])   # 覆盤（第三輪 F1）
	if bool(call("coach_ok")):
		bs.append([L.t("co_btn"), func(): call("_coach_open")])   # V1.6 #9 差一子教練
	# V1.6 #5／B25：出題碼、戰報明信片、分享格、精華時刻收進一顆「分享」（按鈕列不再擠）
	if play_kind == "official" and not watch_mode:
		bs.append([L.t("sh_btn"), func(): overlay = "share"; _focus = 0])
	if bs.size() <= 4 or not (play_kind == "official" and not watch_mode):
		bs.append([L.t("replay"), func(): _replay()])   # 按鈕太多時（試煉贏了 7 顆）重播收進「分享」面板（V1.6 #5）
	bs.append([L.t("menu"), func(): _request_leave()])
	# 按鈕寬依結果框內寬分（框 880、左右各留 16）：試煉贏了最多 6 顆，舊的固定 176 會凸出框外（使用者截圖）
	var gap := 8.0
	# V1.5：主動作比次入口寬 1.3 倍、比較高；次入口用木色、矮一點，一眼分得出先按哪顆
	var wsum := 0.0
	for i in bs.size():
		wsum += 1.3 if i < n_main else 1.0
	var unit_w: float = minf(200.0, (848.0 - (bs.size() - 1) * gap) / maxf(1.0, wsum))
	# 每顆至少放得下自己的字（日文 150% 次入口曾被切）；放不下時回到平均寬
	var ws: Array = []
	var tot := 0.0
	for i in bs.size():
		var w0: float = maxf(unit_w * (1.3 if i < n_main else 1.0), _width(str(bs[i][0]), ts(18), true) + 24.0)
		ws.append(w0)
		tot += w0
	if tot + (bs.size() - 1) * gap > 848.0:
		var avg := (848.0 - (bs.size() - 1) * gap) / maxf(1.0, bs.size())
		for i in bs.size():
			ws[i] = avg
		tot = avg * bs.size()
	var x := 640.0 - (tot + (bs.size() - 1) * gap) / 2.0
	if mode == Mode.VS_AI and not watch_mode and _near_miss():
		_text(Vector2(640, 618), L.t("review_near_d", [roundi(sim.power(1) * 100.0 / (sim.budget_of(1) * 1000))]), tz("S"), ACCENT, true, true, 820)
	for i in bs.size():
		var main := i < n_main
extends "res://scripts/ui/free_place.gd"
## 由 game_screens.gd 拆出（V9 P1，行為不變）
## 狀態機、模式、輸入、擺放、標題、選單、設定、結果、成就。

## 第七輪 S7：每次啟動一個 session、每局一個 game；彙整工具靠這兩個去重（評分和對戰是兩行，不能重複算局數）。
var pt_session := str(Time.get_unix_time_from_system()) + "-" + str(randi())
var pt_game := 0

var keys_capture := ""   # 第七輪 K1：正在改哪個按鍵（"kb:start"／"pad:place"）

# ───────────────────────── 每幀 ─────────────────────────
## 最小化時 Godot 不繪製，也就沒有垂直同步節流，主迴圈會空轉吃滿一核；降到 10 fps，模擬照常跑（用 delta 累積）。
var _was_minimized := false
## 搖桿連發（第三輪 A2）：超過 0.6 才算推、低於 0.35 才算放開（遲滯）；推下立刻一次，0.35 秒後每 0.12 秒一次。
var stick := {JOY_AXIS_LEFT_X: 0.0, JOY_AXIS_LEFT_Y: 0.0}
var _stick_dir := Vector2i.ZERO
var _stick_t := 0.0

## 結果頁的技能徽章（第四輪）：候選裡雙方合計次數最多的 6 種；不夠 6 種就用經典的預設順序補。支援兵的補血、戰鼓也在候選裡（對支援兵公平）。
const BADGE_KEYS := ["breaker", "charge", "backstab", "braced", "anticav", "counter", "pike_brace", "splash", "breach", "heal", "drum"]
const EV_DEATH := "death"


func _reset_place(keep_blue := false) -> void:
	state = St.PLACE
	if bool(get("cp_on")):
		call("_cp_reset")   # 1.2.0 §11.6：每一局重新輪手（藍軍保留時，已有的兵不算任何人這一手）
	sim = null
	view = null
	pending_cell = Vector2i(-1, -1)
	ai_prebuilt = false
	_fp_reset()
	# 第一次進擺放畫面自動打開操作說明（第五輪：說明從頂部移到「?」）
	if not bool(Save.data.get("seen_place_help", false)) and (mode == Mode.VS_AI or mode == Mode.DUEL) and shot_dir == "":
		show_place_help = true
		Save.data["seen_place_help"] = true
	fx.clear()
	frags.clear()   # 1.2.0 §8.2
	dying.clear()
	zoom = 1.0
	tp = null
	blind_phase = 0
	_focus = 0
	var keep_ok: bool = keep_blue and not armies.is_empty() and (rules == null or rules.keep_formation)
	var blue_keep = armies[0].copy() if keep_ok else null
	armies = [Army.new(0, 100), Army.new(1, 100)]
	if rules != null and (mode == Mode.VS_AI or mode == Mode.DUEL):
		armies[0].apply_rules(rules, 0)
		armies[1].apply_rules(rules, 1)
	if mode == Mode.GAUNTLET:
		armies[0].pool = _gauntlet_pool()
		armies[1].pool = _gauntlet_pool()
	match mode:
		Mode.VS_AI:
			if blue_keep != null:
				armies[0] = blue_keep
			if rules != null and rules.fullfield == 2:
				# 第六輪：對 AI 明牌全場——AI 先在自己半場擺好並公開，你在全場離敵兵 1.5 格外擺
				_build_ai()
				ai_prebuilt = true
				armies[0].enemy_pos = []
				for u in armies[1].units:
					armies[0].enemy_pos.append(armies[1].pos_of(u))
				var keep: Array = armies[0].units.duplicate(true)
				armies[0].units = []
				for u in keep:
					var pp: Vector2i = armies[0].pos_of(u)
					armies[0].place_xy(int(u["type"]), pp.x, pp.y)   # 保留的陣型和新的明牌陣衝突的就拿掉
		Mode.DUEL:
			if duel_rule != "blind":
				tp = TP.new(armies[0], armies[1], (round_no + 1) % 2, duel_rule, rules)
				if rules == null:
					tp.armies[0].pool = _pool()
					tp.armies[1].pool = _pool()
				# 1.1.0 B2：輪序紀錄碼要開局（禁牌後）的卡池與預算
				duel_start = {"pools": [tp.armies[0].pool, tp.armies[1].pool], "budgets": [tp.armies[0].budget, tp.armies[1].budget], "rules": rules.copy() if rules != null else null}
		Mode.TUTORIAL, Mode.PUZZLE:
			var pz := PZ.get_puzzle(puzzle_id)
			armies[0] = PZ.player_army(pz)
			armies[1] = PZ.enemy_army(pz)
			selected = int(pz["allowed"][0])
			if puzzle_plan_id != puzzle_id:
				puzzle_plan = PZ.default_plan(pz)   # 第十三輪：同一關重來保留上次設定的時間，換關重設
				puzzle_plan_id = puzzle_id
		Mode.GAUNTLET:
			if not gauntlet_prev.is_empty():
				armies[0].units = gauntlet_prev.duplicate(true)
			var r := RandomNumberGenerator.new()
			r.seed = gauntlet_seed + gauntlet_stage * 7919
			var node: String = call("ga_node", gauntlet_stage)
			var lvl := 2 if node == "boss" else mini(2, (gauntlet_stage - 1) / 2 + (1 if node == "elite" else 0))
			var e := AIT.build_full(1, r, lvl, gauntlet_prev, _pool())
			set("gauntlet_nemesis", call("_nemesis_for_stage"))   # V1.4 #2：菁英站可能遇到宿敵
			# V1.1 D1：菁英 +10、首領 +20；斥候劫掠／截斷補給只影響這一戰
			e.budget = 100 + 5 * (gauntlet_stage - 1) + int(get("GA_NODE_GOLD")[node]) + int(get("gauntlet_foe_gold"))
			if node == "boss" and not _demo():
				e.budget -= BossD.BUDGET_CUT   # V1.4 #12：巨獸是送的，敵方其他兵少一點錢
			e.unit_cap = maxi(4, e.unit_cap + int(get("gauntlet_foe_cap")))
			# Codex v110-impl #2：先組好的陣可能超出調低後的預算／隻數，從最後放的往回拿掉（至少留一隻戰鬥兵）
			while e.units.size() > 1 and (e.spent() > e.budget or e.units.size() > e.unit_cap):
				e.units.pop_back()
			var guard := 0
			while e.can_afford_any() and guard < 20:
				guard += 1
				var t := AIT.choose_type(e, gauntlet_prev, e.left(), r, lvl, _pool())
				if t < 0:
					break
				var c := AIT.choose_cell(e, t, gauntlet_prev, r)
				if c.x < 0 or not e.place(t, c.x, c.y):
					break
			armies[1] = e
			if node == "boss" and not _demo():
				call("add_boss", armies[1])   # V1.4 #12：遠征終點多一隻巨獸
				_toast(L.t("boss_here") + "\n" + L.t("ps_boss"))   # V1.6 #11 首領嗆聲
			if int(get("gauntlet_nemesis")) >= 0:
				armies[1] = call("_nemesis_army", int(get("gauntlet_nemesis")))
				var nt: String = call("nemesis_title", Save.data["nemeses"][int(get("gauntlet_nemesis"))])
				ai_name = nt
				_toast(L.t("nem_back", [nt, int(Save.data["nemeses"][int(get("gauntlet_nemesis"))].get("losses", 1))]) + "\n" + L.t("ps_nemesis", [nt]))   # V1.6 #11
	if not retry_key.begins_with("tr:"):
		draw_rect(Rect2(cr.position.x, cr.end.y - 3, cr.size.x, 3), Color(DIM_INK, 0.35))
		draw_rect(Rect2(640 - 9, 0, 18, 3), Color("#c9a24a"))
		# 1.4.0 §7.2：數字是木活字；最後 10 秒每換一秒數字跳一下＋輕輕一聲（減少動態不跳）
		if secs != clock_last:
			# 只有正常播放、往下走一秒才跳／響（跳轉、暫停、倒帶不算；Codex v140 cat02 #1）
			var normal: bool = clock_last >= 0 and secs == clock_last - 1 and not paused and seek_target < 0
			if normal and secs <= 10 and secs > 0 and sfx != null and not view.finished:
				sfx.play_pitched("k_click", 0.22, 1.5)
			clock_flip_t = time if normal else -10.0
			clock_last = secs
		var jmp := 0.0
		if secs <= 10 and not bool(Save.s("reduce_motion")):
			jmp = clampf(1.0 - (time - clock_flip_t) / 0.15, 0.0, 1.0)
		_woodtype(Vector2(640, 4), clock_s, ts(22), Color("#8e1b14") if view.frenzy else Color("#2a1a10"), true, true, jmp)
	else:
		_text(Vector2(640, 4), clock_s, ts(22), Color.ORANGE_RED if view.frenzy else Color.WHITE, true, true)
	# 1.2.0 §5.6 情境資訊：AI 名稱只在開場 3 秒、滑鼠指到戰力尺、手把按 View 後 2 秒顯示（Codex／Antigravity：資訊都在，次要的不常駐）
	var ai_show: bool = view.tick < 60 or Rect2(bx - 10, 32, bw + 20, 52).has_point(mouse) or time < hud_info_until or shot_dir != ""
	if mode == Mode.VS_AI and ai_name != "" and ai_show:
		var ai_lb := "AI：%s" % ai_name
		_text(Vector2(bx + bw - _width(ai_lb, tz("C")), 69.0), ai_lb, tz("C"), Color(1, 1, 1, 0.9))   # V1.2.1：大字級也在木條內
	if state == St.BATTLE and bool(Save.s("playtest")):
		if pt_call_tick < 0:
			_btn(Rect2(780, 4, 162, 36), L.t("pt_call"), func(): pt_call_tick = view.tick; _toast(L.t("pt_called", [view.tick / 20])))
	btn_ring_clip = Rect2(1, 1, 1278, 40)   # V1.5.2：頂列的加強焦點外圈不往下蓋到 y=42 的剩餘隻數
	if state == St.BATTLE:
		if play_kind != "official":
			_btn(Rect2(1010, 4, 120, 36), L.t("back"), func(): call("_replay_back"))   # 第七輪 A9：立刻回上一個畫面
		else:   # 重播／覆盤用底部的控制列，不重複放倍速鈕（Antigravity S5）
			_btn(Rect2(950, 4, 52, 36), "▶" if paused else "Ⅱ", func(): call("_toggle_pause"))   # 第七輪 A6；V1.5.2：頂列一律 y=4、高 36、右緣留 14（原本暫停鈕 y=2 和同列不齊；下緣 40 不碰 y=42 的剩餘隻數；加強焦點框在 _btn 裡夾在畫面內）
			_btn(Rect2(1010, 4, 120, 36), L.t("speed", [_fmt_num(speed)]), func(): speed = speed_step(speed, 1) if speed < float(SPEEDS[SPEEDS.size() - 1]) else float(SPEEDS[0]))   # V1.5.1：照共用表往上一格、到頂回最慢
		_btn(Rect2(1134, 4, 132, 36), L.t("skip"), func(): _on_skip())
	btn_ring_clip = Rect2(1, 1, 1278, 798)



## 開一場戰鬥（S8 從 game_screens 移下來：重播、覆盤、截圖都會用到）
func _begin_battle(a0, a1, kind := "official") -> void:
	nav_stack.clear()   # V1.5.1：開戰後，之前的返回堆疊作廢
	_pre_drop()
	play_kind = kind
	tm_ghost = null   # V1.4 #1：時光機的原本時間線只在「如果」播放時存在（_rv_play 之後會再設）
	_ensure_sprites([a0, a1])
	if kind == "official":
		last_armies = [a0.copy(), a1.copy()]
		battle_rules = rules.copy() if rules != null else _puzzle_rules()   # 第十三輪：殘局自帶規則
	sim = Sim.new(a0, a1, battle_rules)
	_cmd_setup(sim, kind)
	view = ViewBuffer.new(sim)
	atk_seq.clear()
	clutch_tick = -1
	replay_total = 0
	if kind != "official":
		# 重播／覆盤：先用確定性模擬算出整場長度，時間軸以實際秒數為滿（Antigravity S5）
		var pa0 = a0.copy()
		var pa1 = a1.copy()
		var pr = battle_rules.copy() if battle_rules != null else null
		var plog: Array = last_cmds.duplicate(true)
		replay_bm = []
		var run_pre := func() -> Array:
			var pre = Sim.new(pa0, pa1, pr)
			if pre.cmd_on:
				pre.cmd_play(plog)
			pre.fast = true
			var bm: Array = []
			while not pre.finished:
		if absf(v) > int(Save.s("deadzone")) / 100.0 + 0.25:   # V1.5.1：觸發門檻＝死區＋25%（原本 maxf(0.6, …) 讓 5～40% 的設定都被 0.6 吃掉）
			nv = 1 if v > 0 else -1
		elif absf(v) < int(Save.s("deadzone")) / 100.0:
			nv = 0
		if ax == JOY_AXIS_LEFT_X:
			d.x = nv
		else:
			d.y = nv
	if d != Vector2i.ZERO and call("ov_trans_k") < 1.0:
		set("_ov_t", float(get("time")) - 1.0)   # 1.4.0：轉場中推搖桿（和移焦同一個門檻）＝跳過
		set("trans_stick_eat", true)
	if get("trans_stick_eat") == true:
		_stick_dir = d   # 回中之前不送方向（開頁前就推著的也一樣，Codex cat08 r2 #2）
		return
	if d != _stick_dir:
		_stick_dir = d
		_stick_t = 0.35
		_stick_fire()
	elif d != Vector2i.ZERO:
		_stick_t -= delta
		if _stick_t <= 0.0:
			_stick_t += 0.12
			_stick_fire()


func _stick_fire() -> void:
	if _stick_dir.x != 0:
		_enqueue("key", KEY_RIGHT if _stick_dir.x > 0 else KEY_LEFT)
	if _stick_dir.y != 0:
		_enqueue("key", KEY_DOWN if _stick_dir.y > 0 else KEY_UP)



func _start_free_intro() -> void:
	overlay = ""
	lobby_kind = "ai"
	lobby_r = Presets.make("standard", "ai", _lobby_unlocked())
	lobby_r.rounds = 1
	lobby_r.ai_level = 0
	rules = lobby_r.copy()
	difficulty = 0
	set("challenge_army", null)
	_start_mode(Mode.VS_AI)
	free_intro = true
	free_intro_moved = false



func _draw_save_notice() -> void:
	var msg := ""
	if Save.data_locked:
		msg = L.t("save_locked")
	elif Save.data_source == "bak":
		msg = L.t("save_from_backup")
	elif Save.has_unsaved():
		msg = L.t("save_failed")
	if msg == "":
		return
	var h := text_h(msg, tz("S"), 760) + 14
	draw_rect(Rect2(490, 8, 780, h), Color(0.35, 0.12, 0.08, 0.92))
	_text(Vector2(500, 12 + tz("S")), msg, tz("S"), Color("#ffe8c8"), false, false, 760)



const HOME_CX := 255.0   # V1.5.2 L5：主畫面左欄中線（木牌 70～440 的中線）

func _draw_title() -> void:
	draw_rect(Rect2(0, 0, 1280, 800), Color(0.05, 0.06, 0.1, 0.18))
	if overlay != "":
		return
	_draw_save_notice()
