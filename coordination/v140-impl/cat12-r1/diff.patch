+func test_title_v140() -> void:
+	var GM = load("res://scripts/ui/screens/game_menus.gd")
+	ok(GM.TITLE_SHELF.size() >= 3 and GM.TITLE_SHELF.size() <= 5, "底架 3～5 隻代表木偶")
