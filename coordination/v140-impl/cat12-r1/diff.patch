+		ys[(sh[0] as Vector2).y] = true
+		ok((sh[0] as Vector2).x > 520.0 and (sh[0] as Vector2).x < 1200.0 and (sh[0] as Vector2).y >= 708.0 and (sh[0] as Vector2).y <= 752.0, "木偶腳點在木台上")
