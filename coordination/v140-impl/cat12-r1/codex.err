			_draw_frenzy_edge()
			_draw_start_cue()
			_draw_battle_report()
			_draw_unit_info()
			_draw_bmag()   # 1.3.0 §2 銅放大鏡小窗
			if pre_thread != null:
				_draw_busy(-1)
