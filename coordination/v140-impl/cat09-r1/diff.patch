 	p.stream = _pick_variant(name)
 	p.pitch_scale = pitch * (1.0 + rng.randf_range(-0.05, 0.05) if pitch != 1.0 else 1.0 + rng.randf_range(-0.1, 0.1))   # 兵種音高再加 ±5% 微擾，同音高齊發不會共鳴
