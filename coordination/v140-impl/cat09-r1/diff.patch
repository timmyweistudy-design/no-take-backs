+## 1.4.0 第 9 大類：聲音 3.0（空間化、嘟囔語）
+func test_sound_v140() -> void:
+	var SX = load("res://scripts/game/sfx.gd")
+	ok(SX.pan_bus(-0.9, false) == SX.BUS_SFX_L and SX.pan_bus(0.9, false) == SX.BUS_SFX_R, "聲像跟著出手的兵分左右")
