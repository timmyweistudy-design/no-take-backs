   150	
   151	## 算到時間用完或到達目標；到達回傳 true。
   152	func _seek_tick(budget_ms: int) -> bool:
   153		var t0 := Time.get_ticks_msec()
   154		while sim.tick < _seek_stop and not sim.finished:
   155			if Time.get_ticks_msec() - t0 >= budget_ms:
   156				return false
   157			sim.step()
   158			for ev in sim.events:   # 快轉時也要累計戰報次數與時間軸標記（Codex S5 #4：共用同一個收集函式）
   159				if ev.has("src"):
   160					var s = sim.unit_by_id(ev["src"])
   161					var key := "%s%d" % [ev["kind"], s.team]
   162					ev_count[key] = int(ev_count.get(key, 0)) + 1
   163					if ev["kind"] == EV.BLAST and not ev.has("dmg"):
   164						ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
   165				_collect_mark(ev, sim, sim.tick)
   166				if ev["kind"] == EV.DEATH:
   167					_seek_deaths[int(ev["id"])] = sim.tick
   168				if ev["kind"] == EV.CMD:
   169					battle_marks.append({"tick": sim.tick, "kind": "cmd", "team": int(ev["team"]), "skill": int(ev["skill"])})   # V1.5.1：快轉也收軍令標記（原本跳轉後會漏）
   170			if _seek_ct < 0 and not sim.finished and clutch_cond(sim):
   171				_seek_ct = sim.tick
   172		return true
   173	
   174	func _seek_finish() -> void:
   175		clock_last = -1   # 1.4.0 §7.2：跳轉後棋鐘不補跳不補響
   176		if sfx != null and sfx.has_method("reseed"):
   177			sfx.reseed(sfx.seed_at(round_no, view.tick if view != null else 0))   # 1.3.0 §10：跳轉後音效變體從同一個狀態開始
   178		call_deferred("_tm_sync")
   179		var target := _seek_target_now
   180		var keep_ct := _seek_ct
   181		var had_clutch := keep_ct >= 0
   182		view = ViewBuffer.new(sim)
   183		prev_pos.clear()
   184		_gait_reset()
   185		for u in view.units:
   186			prev_pos[u.id] = Vector2(u.x, u.y)
   187		fx.clear()
   188		frags.clear()   # 1.2.0 §8.2
   189		dying.clear()
   190		graves.clear()
   191		# V1.5.1 B2：跳轉前 1～4 秒倒下的兵，陣亡小旗照時間補回（倒地 1 秒後插旗、旗子留 3 秒）
   192		for did in _seek_deaths:
   193			var age: float = float(target - int(_seek_deaths[did])) / 20.0
   194			var dv = view.unit_by_id(int(did))
   195			if dv != null and age >= 1.0 and age < 4.0:
   196				graves.append({"pos": _upos(dv), "team": dv.team, "t": age - 1.0})
   197			elif dv != null and age >= 0.0 and age < 1.0:
   198				# 不到一秒前倒下：倒地演出接著播完，跨過 1 秒照常插旗（Codex v151-i2 #1）
   199				dying.append({"pos": _upos(dv), "type": dv.type, "team": dv.team, "face": signf(dv.fx) if dv.fx != 0 else 1.0, "t": age})
   200		atk_hit.clear()
