   123	
   124	## 聲道選擇（純函式，測試用）：先找空的；滿了就搶優先權最低（同級取最早開始）且低於新音效的。沒有可搶的回 -1。
   125	static func pick_channel(busy: Array, prios: Array, starts: Array, prio: int) -> int:
   126		for i in busy.size():
   127			if not busy[i]:
   128				return i
   129		var best := -1
   130		for i in busy.size():
   131			if prios[i] < prio and (best < 0 or prios[i] < prios[best] or (prios[i] == prios[best] and starts[i] < starts[best])):
   132				best = i
   133		return best
   134	
   135	## V1.2.1 E1：四條音量各自獨立；介面音、環境音沒給（-1）時跟音效相同（舊呼叫相容）。
   136	func set_volumes(sfx_pct: int, music_pct: int, ui_pct := -1, amb_pct := -1) -> void:
   137		sfx_vol = sfx_pct / 100.0
   138		music_vol = music_pct / 100.0
   139		ui_vol = (ui_pct if ui_pct >= 0 else sfx_pct) / 100.0
   140		amb_vol = (amb_pct if amb_pct >= 0 else sfx_pct) / 100.0
   141		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
   142		if amb != null:
   143			amb.volume_db = linear_to_db(maxf(0.0001, amb_vol * 0.22))   # V1.2.1：環境音有自己的音量
   144	
   145	## V1.3.1 P2：每種兵自己的「聲音」：同一個音效，依兵種換音高（小隻高、大隻低），出手、倒下聽得出是誰。
   146	const UNIT_PITCH := [1.0, 0.9, 1.08, 0.88, 1.12, 0.95, 1.05, 1.1, 1.0, 0.86, 1.18, 1.15, 0.92, 1.2, 1.12, 1.16, 1.22, 0.97, 1.1, 0.82, 1.25, 1.06]   # 收斂在 0.82～1.25（Antigravity v131-impl3：1.4 太尖）
   147	func play_unit(name: String, vol: float, type: int) -> void:
   148		play(name, vol, float(UNIT_PITCH[type]) if type >= 0 and type < UNIT_PITCH.size() else 1.0)
   149	
   150	func play_pitched(name: String, vol: float, pitch: float) -> void:
   151		play(name, vol, pitch)
   152	
   153	func play(name: String, vol := 1.0, pitch := 1.0) -> void:
   154		var gain := gain_for(name)
   155		if not streams.has(name) or gain <= 0.0:
   156			return
   157		if int(PRIO.get(name, 0)) >= 2 and not name.begins_with("k_"):
   158			duck(0.7)
   159		var now := Time.get_ticks_msec()
   160		var r: Array = recent.get(name, [])
   161		r = r.filter(func(t): return now - t < 80)
   162		if r.size() >= 2:
   163			return
   164		r.append(now)
   165		recent[name] = r
   166		var pr: int = PRIO.get(name, 1)
   167		if same_playing(players.map(func(q): return q.playing), _name_of, name) >= SAME_MAX:
   168			return   # V1.0.0 A2：同一個音效同時最多 SAME_MAX 路（混戰時同一種聲音疊太多會爆音）
   169		var busy: Array = []
   170		var prios: Array = []
   171		var starts: Array = []
   172		for i in players.size():
   173			busy.append(players[i].playing)
   174			prios.append(_prio_of.get(i, 0))
   175			starts.append(_started.get(i, 0))
   176		var ch := pick_channel(busy, prios, starts, pr)
   177		if ch < 0:
   178			return
   179		var p := players[ch]
   180		p.stop()
   181		p.bus = BUS_UI if is_ui(name) else pan_bus(pan_hint, mono)   # 1.4.0 §9.2：戰場音效依單位位置分左右（單聲道設定時不分）
   182		p.stream = _pick_variant(name)
   183		p.pitch_scale = pitch * (1.0 + rng.randf_range(-0.05, 0.05) if pitch != 1.0 else 1.0 + rng.randf_range(-0.1, 0.1))   # 兵種音高再加 ±5% 微擾，同音高齊發不會共鳴
   184		p.volume_db = linear_to_db(maxf(0.0001, gain * vol)) + trim_db(p.stream)   # V1.2.1 E2：個別音檔響度修正
   185		p.play()
   186		_prio_of[ch] = pr
   187		_started[ch] = now
   188		_name_of[ch] = name
   189	
   190	const SAME_MAX := 3
   191	var _name_of := {}
   192	## 純函式（測試用）：正在播這個名字的聲道數
   193	static func same_playing(playing: Array, names: Dictionary, name: String) -> int:
   194		var n := 0
   195		for i in playing.size():
   196			if playing[i] and str(names.get(i, "")) == name:
   197				n += 1
   198		return n
   199	
   200	## V1.2.1 E2：tools/gen/audio_trim.py 量出的個別音檔修正（dB），依檔名查。
   201	static var _trim := {}
   202	static func trim_db(st) -> float:
   203		if _trim.is_empty():
   204			var f := FileAccess.get_file_as_string("res://data/audio_trim.json")
   205			var j = JSON.parse_string(f) if f != "" else null
   206			_trim = j["trim"] if j is Dictionary and j.has("trim") else {"_": 0.0}
   207		if st == null or not ("resource_path" in st):
   208			return 0.0
   209		return float(_trim.get(str(st.resource_path).get_file(), 0.0))
   210	
   211	static func is_ui(name: String) -> bool:
   212		return name.begins_with("k_") or name.begins_with("ui_")
   213	
   214	## 這個音效走哪一條音量（介面音或音效）。
   215	func gain_for(name: String) -> float:
   216		return ui_vol if is_ui(name) else sfx_vol
   217	
   218	## 變體：隨機挑一個，但不和上一次相同（只有一個就用它）。
   219	func _pick_variant(name: String):
   220		var vs: Array = variants.get(name, [streams[name]])
   221		if vs.size() <= 1:
