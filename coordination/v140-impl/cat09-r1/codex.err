   200			shake = maxf(shake, 0.15)
   201	
   202	## 畫面前進一個 tick：模擬保持領先 DELAY 個 tick，畫面播最舊的那一份快照（R5 展示緩衝）。
   203	func _sim_step(with_fx: bool) -> void:
   204		_pump_view()
   205		_check_final(with_fx)
   206		for u in view.units:
   207			prev_pos[u.id] = Vector2(u.x, u.y)
   208		if not view.advance():
   209			view.finished = true
   210			return
   211		if tm_ghost != null:
   212			call("_tm_sync")
   213		_gait_tick(with_fx)
   214		_status_tags(with_fx)   # 1.3.0 §7.1 狀態竹籤
   215		_pump_view()
   216		_check_clutch(with_fx)   # 每一個畫面 tick 都判定（原本每一幀判一次，觸發的 tick 會跟幀率有關）
   217		if view.frenzy and not frenzy_seen:
   218			frenzy_seen = true
   219			if with_fx:
   220				_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
   221				sfx.play("frenzy")
   222				sfx.play_music("music_frenzy")
   223		var deaths := 0
   224		for ev in view.events:
   225			var k: String = ev["kind"]
   226			var s = view.unit_by_id(ev["src"]) if ev.has("src") else null
   227			if s != null:   # V1.4 #10：沙盤機關的事件沒有來源單位（src＝-1）
   228				var key := "%s%d" % [k, s.team]
   229				ev_count[key] = int(ev_count.get(key, 0)) + 1
   230				if k == EV.BLAST and not ev.has("dmg"):   # 第八輪：爆炸演出一筆一次；逐目標傷害不算次數（BOOM_5）
   231					ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
   232			if k == EV.DEATH:
   233				deaths += 1
   234			_collect_mark(ev, view, view.tick)
   235			_on_event(ev, with_fx)
   236		if sfx != null and "pan_hint" in sfx:
   237			sfx.pan_hint = 0.0   # 事件以外的聲音（棋鐘、結算）回到正中
   238		# 碾壓局最後一擊（優化方案 F1）：0.2 秒頓格＋微震，直接進結算
   239		if view.finished and not slow_used and deaths > 0 and with_fx:
   240			hitstop = 0.2
   241			if bool(Save.s("shake")):
   242				shake = 0.15
   243	
   244	
   245	
   246	## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
   247	func _pump_view() -> void:
   248		for fr in view.pump(sim):
   249			for e in fr["events"]:
   250				if e["kind"] == EV.CHARGE or e["kind"] == EV.BRACED:
   251					_cue_add(str(e["kind"]), int(e.get("src", -1)), int(e.get("tgt", -1)), int(fr["tick"]))   # 1.3.0 §7.1 預告
   252				if e.get("tags", []).has(EV.EXT_FIRE):
   253					continue   # 1.2.0 火矢的小火：不是射手出手，不排拉弓、飛箭（Codex cat09 #1）
   254				# 第四輪：補血、戰鼓也走出手動畫；被貼身敲人、破陣、補血、戰鼓用專屬動作（variant 2）
   255				if e["kind"] == EV.HEAL or e["kind"] == EV.DRUM or e["kind"] == EV.BONK or e.get("tags", []).has(EV.BREACH):
   549	func _on_event(ev: Dictionary, with_fx: bool) -> void:
   550		if sfx != null and "pan_hint" in sfx:
   551			var ps0 = view.unit_by_id(ev.get("src", -1)) if ev.has("src") else null
   552			sfx.pan_hint = clampf((_cam * _upos(ps0)).x / 640.0 - 1.0, -1.0, 1.0) if ps0 != null else 0.0   # 1.4.0 §9.2 聲像跟著出手的兵
   553		var k: String = ev["kind"]
   554		if ev.has("src") and ev.has("tgt"):
   555			last_hitter[int(ev["tgt"])] = int(ev["src"])   # V1.3.1：死亡事件不帶擊倒者，記住每個目標最後被誰打（Codex v131-impl3）
   556		if k == EV.CMD or k == EV.CMD_HIT:
   557			_cmd_event(ev, with_fx)
   558			return
   559		if k in ["boss_arm", "boss_plate"]:
   560			if with_fx:
   561				_fx_text(Vector2(640, 150), L.t("ev_" + k), ACCENT, 1.2, tz("H2"), true)   # V1.4 #12 巨獸部位破壞
   562				sfx.play("bell", 0.8)
   563				if _fx_on("shake"):
   564					shake = maxf(shake, 0.25)
   565			return
   566		if k in ["collapse", "fire", "push"]:
   567			# V1.4 #10 沙盤機關發動：中間一句大字＋音效（不進模擬）
   568			if with_fx:
   569				_fx_text(Vector2(640, 150), L.t("ev_" + k), Color("#ffb347") if k != "push" else Color("#f3e3c0"), 1.0, tz("H2"), true)
   570				sfx.play("bell" if k == "collapse" else ("poison" if k == "fire" else "turn"), 0.6)
   571				if k == "collapse" and _fx_on("shake"):
   572					shake = maxf(shake, 0.2)
   573			return
   574		if _on_event_v8(ev, k, with_fx):
   575			return
   576		if k == EV.DEATH:
   577			var u = view.unit_by_id(ev["id"])
   578			if with_fx:
   579				last_kill = [int(last_hitter.get(int(ev["id"]), -1)), time]   # V1.3.1 P2：最後一擊定格用（誰、什麼時候）
   580			dying.append({"pos": _upos(u), "type": u.type, "team": u.team, "face": signf(u.fx) if u.fx != 0 else 1.0, "t": 0.0})
   581			if with_fx:
   582				sfx.play_unit("death", 0.7, u.type)   # V1.3.1：倒下的聲音依兵種音高
   583				sfx.play_unit("wood_topple", 0.45, u.type)   # V1.6 #14：木座倒地彈兩下
   584				_kill_rumble()
   585				_death_extra(u)
   586				# V1.1 B2：殘局「斬首」的目標倒下：頓格＋微震＋大字（只動播放，不進模擬）
   587				if mode == Mode.PUZZLE and _goal_target_id() == int(ev["id"]):
   588					if not bool(Save.s("reduce_fx")):
   589						hitstop = maxf(hitstop, 0.3)   # 簡化特效時不頓格（Codex v110-impl2）
   590					if _fx_on("shake"):
   591						shake = maxf(shake, 0.18)
   592					_fx_text(Vector2(640, 150), L.t("ev_behead"), ACCENT, 1.2, tz("H2"), true)
   593					sfx.play("bell", 0.9)
   594			return
   595		if k == EV.HEAL and with_fx:
   596			# 補血（第四輪 §4.4）：醫者到目標一條淡綠弧線＋綠色「+N」（不加黑底）
   597			var hs0 = view.unit_by_id(ev["src"])
   598			var ht0 = view.unit_by_id(ev["tgt"])
   599			if hs0 != null and ht0 != null:
   600				_merge_text(ht0.id, EV.HEAL, "+", int(ev["amt"]), _upos(ht0) + Vector2(0, -70), Color("#7dff8a"))
   601				_add_fx({"kind": "healring", "p": _upos(ht0) + Vector2(0, 2), "t": 0.0, "dur": 0.35})   # 1.1.0 A7：被補的友軍腳下淡綠藥膏環（≤0.3 格）
   602				_add_fx({"kind": "leaves", "p": _upos(ht0) + Vector2(0, -10), "t": 0.0, "dur": 0.6})   # 1.4.0 §6.2 草葉旋升
   603				sfx.play("heal", 0.35)
   604				if _frags_on():
   605					frags.spawn(_upos(ht0), "leaf", 2, view.tick * 4096 + ht0.id, 30.0)   # 1.2.0 §8.2 薄荷葉片
   606				if (ev.get("tags", []) as Array).has(EV.RESCUE):
   607					# 1.2.0 擴充「急救契約」：救起的人頭上一句、醫者停手的那 2 秒頭上有「停手」（觀戰時看得懂為什麼醫者不動）
   608					_fx_text(_upos(ht0) + Vector2(0, -92), L.t("ev_rescue"), Color("#7dff8a"), 1.0, tz("S"))
   609					_fx_text(_upos(hs0) + Vector2(0, -84), L.t("ev_rescue_rest"), Color(1, 1, 1, 0.8), 2.0, tz("C"))
   610					sfx.play("bell", 0.4)
   611			return
   612		if k == EV.DRUM and with_fx:
   613			var dr0 = view.unit_by_id(ev["src"])
   614			if dr0 != null:
   615				_add_fx({"kind": "note", "p": _upos(dr0) + Vector2(6, -78), "t": 0.0, "dur": 0.8})
   616				_add_fx({"kind": "woodwave", "p": _upos(dr0) + Vector2(0, 2), "t": 0.0, "dur": 0.45})   # 1.1.0 A7：鼓手腳下木紋同心波（不幫友軍染色）
   617			return
   618		if k == EV.EXT_RIDE:
   619			if with_fx:
   620				var rd0 = view.unit_by_id(ev["src"])
   621				if rd0 != null:
   622					_add_fx({"kind": "puff", "p": _upos(rd0) + Vector2(0, -6), "t": 0.0, "dur": 0.4})   # 1.2.0 擴充「迴馬」：撤一格揚起的小塵
   623			return
   624		var route := event_route(ev)
   625		if not with_fx and (k == EV.BREACH or ev.get("tags", []).has(EV.BREACH)):
   626			key_used = true   # V1.3 C4：跳播／直接看結果也要記得第一次破陣已發生（Codex v130-impl2）
   627		if route == "skip" or not with_fx:
   628			return
   629		match route:
   630			"taunt":
   631				var sh = view.unit_by_id(ev["src"])
   632				var vic = view.unit_by_id(ev["tgt"])
   633				_add_fx({"kind": "taunt", "p": _upos(sh), "t": 0.0, "dur": 0.6})
   634				sfx.play("taunt", 0.5)
   635				_add_fx({"kind": "bang", "p": _upos(vic) + Vector2(20, -66), "t": 0.0, "dur": 0.7})   # 第七輪 D1：移到頭頂側上方，不擋臉
