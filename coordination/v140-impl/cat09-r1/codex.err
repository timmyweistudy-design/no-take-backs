   112	
   113	## 最後時刻：整體低通（慢動作開始時開、結束時關）。
   114	## 1.3.0 §2：最後一擊壓得更低（約 400Hz），最後時刻照舊 900Hz。
   115	func set_muffled(on: bool, hz := 900.0) -> void:
   116		if _lowpass_idx < 0:
   117			return
   118		var lp := AudioServer.get_bus_effect(0, _lowpass_idx) as AudioEffectLowPassFilter
   119		if lp != null and on and absf(lp.cutoff_hz - hz) > 1.0:
   120			lp.cutoff_hz = hz
   121		if AudioServer.is_bus_effect_enabled(0, _lowpass_idx) != on:
