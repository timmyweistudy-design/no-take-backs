   371	## 種子＝局數＋畫面 tick：開戰（tick 0）和每次跳轉完成後都從同一個狀態開始，跳回同一個 tick 聽到的變體一樣（Codex cat09 #2）。
   372	static func seed_at(round_no: int, tick: int) -> int:
   373		return 0x5EED + round_no * 7919 + tick * 31
   374	
   375	## 棋館環境三層（近：茶蓋、線香；中：算盤；遠：窗外微雨、更夫木梆）。遠層走自己的匯流排，戰況緊時低通、壓小。
   440	
   441	# ── 1.4.0 第 9 大類：聲音 3.0 程式部分（方案 §9）──
   442	## §9.2 空間化：戰場事件播放前由呼叫端設 pan_hint（−1 左～＋1 右）；用兩條帶聲像的子匯流排（不改原本的音效匯流排音量）。
   443	const BUS_SFX_L := "SfxL"
   444	const BUS_SFX_R := "SfxR"
   445	var pan_hint := 0.0
   446	var mono := false
   447	static func pan_bus(h: float, is_mono: bool) -> String:
   448		if is_mono or absf(h) < 0.25:
   449			return BUS_SFX
   450		return BUS_SFX_L if h < 0.0 else BUS_SFX_R
   451	
   452	## §9.4 嘟囔語：老闆與常客的無意義語音（happy／sad／hmm 各 3 個），字幕照常、獨立音量（voice_vol）；占位檔是程序合成。
   453	const BUS_VOICE := "Voice"
   454	var voice: AudioStreamPlayer
   455	var voice_vol := 0.7
   456	var _voice_streams := {}
   457	
   458	func _voice_setup() -> void:
   459		for pb in [[BUS_SFX_L, -0.45], [BUS_SFX_R, 0.45]]:
   460			if AudioServer.get_bus_index(pb[0]) < 0:
   461				AudioServer.add_bus()
   462				var bi := AudioServer.bus_count - 1
   463				AudioServer.set_bus_name(bi, pb[0])
   464				AudioServer.set_bus_send(bi, BUS_SFX)
   465				var pan := AudioEffectPanner.new()
   466				pan.pan = float(pb[1])
   467				AudioServer.add_bus_effect(bi, pan)
   468		if AudioServer.get_bus_index(BUS_VOICE) < 0:
   469			AudioServer.add_bus()
   470			AudioServer.set_bus_name(AudioServer.bus_count - 1, BUS_VOICE)
   471			AudioServer.set_bus_send(AudioServer.bus_count - 1, "Master")
   472		voice = AudioStreamPlayer.new()
   473		voice.bus = BUS_VOICE
   474		add_child(voice)
   475		for mood in ["happy", "sad", "hmm"]:
   476			var vs: Array = []
   477			for i in 3:
   478				var st = load_audio("voice_%s_%d" % [mood, i + 1])
   479				if st != null:
   480					vs.append(st)
   481			_voice_streams[mood] = vs
   482	
   483	func play_voice(mood: String) -> void:
   484		var vs: Array = _voice_streams.get(mood, [])
   485		if voice == null or vs.is_empty() or voice_vol <= 0.0:
   486			return
   487		voice.stop()
   488		voice.stream = vs[rng.randi_range(0, vs.size() - 1)]
   489		voice.volume_db = linear_to_db(maxf(0.0001, voice_vol))
   490		voice.play()
