## 相位（累積世界位移，1000＝1 格；cs＝每格 px）。
static func phase_of(t: int, world: float, cs: float, scale: float, id: int) -> float:
	return world * cs / 1000.0 / cycle_px(t, scale) * TAU + 0.0001 + id * 0.37

## 腳的位移：[遠腳 x, 遠腳抬起, 近腳 x, 近腳抬起]。踩地段往後等速走（抵銷身體前進），騰空段弧線往前。
static func feet(t: int, walk: float) -> Array:
	if walk <= POSE_DAZE + 1.0:
	var p1: float = s.power(1) * 100.0 / (s.budget_of(1) * 1000.0)
	return absf(p0 - p1) <= 15.0 and ((p0 <= 30.0 and p1 <= 30.0) or (s.alive_count(0) <= 3 and s.alive_count(1) <= 3))


## 畫面上現在播到第幾 tick（含小數，插值用）。
func _disp_tick() -> float:
	if view == null:
		return 0.0
	if state != St.BATTLE:
		return float(view.tick)
	return view.tick + clampf(accum / 0.05, 0.0, 8.0 if view.finished else 1.0)



