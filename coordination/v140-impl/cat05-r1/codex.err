func _draw_field() -> void:
	var free_f: bool = rules != null and rules.is_free() and (mode == Mode.VS_AI or mode == Mode.DUEL)   # 第六輪：自由排兵不畫格子
	var fbi: Dictionary = MapArt.BIOME.get(MapDefs.MAPS[fld_map]["biome"], {})
	ring_shadow = float(fbi.get("shadow", 0.0))
	# 1.2.0 §5.1：盤外是桌面（不再畫場外樹叢、岩石）
	if not bool(Save.s("plain_ui")):
		var so := Rect2(ORIGIN, fld_size).grow(18)
		for k7 in 4:   # 1.2.0 §5.1：棋盤在桌上的落影（光源左上 → 影子往右下）
			draw_rect(Rect2(so.position + Vector2(6 + k7 * 2, 8 + k7 * 2), so.size), Color(0.08, 0.05, 0.03, 0.12))
	var fr_i := clampi(int(Art.paint[5]), 0, 3)   # V1.4 #15 棋盤框
	draw_rect(Rect2(ORIGIN - Vector2(10, 10), fld_size + Vector2(20, 20)), Color(fbi.get("frame", "#5b4632") if fr_i == 0 else Art.FRAMES[fr_i]))
	if fld_map != 0:
		var mt := _map_tex()
		if mt != null:
			draw_texture_rect(mt, Rect2(ORIGIN, fld_size), false)   # 1.3.0：桌邊視角的牆格高度烘在地塊裡（map_art._relief）
		else:
			draw_rect(Rect2(ORIGIN, fld_size), Color(fbi.get("base", "#6f9a4a")))
		if (rules != null and rules.time_of != 0) or _mode_tone().a > 0.0:   # 1.3.0：地形圖也套每日／戰役的時刻（Codex cat03 #2）
			draw_rect(Rect2(ORIGIN, fld_size), _tone())
		_draw_field_frame()
		_map_prop()   # 1.3.0 §3
		return
	var f_rows: int = fld_h / 1000
	var f_cols: int = fld_w / 1000
	for r in f_rows:
		for c in f_cols:
			var cell := Rect2(ORIGIN + Vector2(c, r) * CS, Vector2(CS, CS))
			if grass:
				var h := absi((c * 73856093) ^ (r * 19349663))
				draw_texture_rect_region(grass, cell, Rect2((h % 8) * 32, ((h / 8) % 4) * 32, 32, 32))
			else:
				draw_rect(cell, Color("#7cb342") if (r + c) % 2 == 0 else Color("#73a83d"))
			if free_f:
				pass
			elif c < 6:
				draw_rect(cell, Color(Art.team_color(0, cbm()), 0.08))
			elif c >= 10:
				draw_rect(cell, Color(Art.team_color(1, cbm()), 0.06))
	draw_rect(Rect2(ORIGIN, fld_size), Color(0.06, 0.09, 0.16, 0.18))
	# 地面層次（第三輪 M2）：固定位置的明暗草塊與小花，畫在格線與單位底下
	for i in 22:
		var h := absi((i * 2654435761) ^ 0x5bd1e995) % 100000
		var pc := ORIGIN + Vector2(float(h % 1000) / 1000.0 * fld_size.x, float((h / 1000) % 100) / 100.0 * fld_size.y)
		var rr := 40.0 + float(h % 37) * 2.0
		draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1.0, 0.55), 0, pc))
		draw_circle(Vector2.ZERO, rr, Color(1, 1, 0.8, 0.045) if i % 2 == 0 else Color(0, 0.08, 0, 0.07), true, -1.0, true)
	draw_set_transform_matrix(_cam)
	var fl := [Color("#fff3b0"), Color("#ffb3c6"), Color("#cdb4ff"), Color("#ffffff")]
	# 第七輪 D2：一條踩出來的小路＋石頭群；小花少一點，免得和兵搶眼
	var path_pts := PackedVector2Array()
	for k5 in f_cols + 1:
		path_pts.append(ORIGIN + Vector2(k5 * CS, fld_size.y * 0.5 + sin(k5 * 0.7) * 34.0))
func _seek_finish() -> void:
	clock_last = -1   # 1.4.0 §7.2：跳轉後棋鐘不補跳不補響
	if sfx != null and sfx.has_method("reseed"):
		sfx.reseed(sfx.seed_at(round_no, view.tick if view != null else 0))   # 1.3.0 §10：跳轉後音效變體從同一個狀態開始
	call_deferred("_tm_sync")
	var target := _seek_target_now
	var keep_ct := _seek_ct
	var had_clutch := keep_ct >= 0
	view = ViewBuffer.new(sim)
	prev_pos.clear()
	_gait_reset()
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	fx.clear()
	frags.clear()   # 1.2.0 §8.2
	dying.clear()
	graves.clear()
	# V1.5.1 B2：跳轉前 1～4 秒倒下的兵，陣亡小旗照時間補回（倒地 1 秒後插旗、旗子留 3 秒）
	for did in _seek_deaths:
		var age: float = float(target - int(_seek_deaths[did])) / 20.0
		var dv = view.unit_by_id(int(did))
		if dv != null and age >= 1.0 and age < 4.0:
			graves.append({"pos": _upos(dv), "team": dv.team, "t": age - 1.0})
		elif dv != null and age >= 0.0 and age < 1.0:
			# 不到一秒前倒下：倒地演出接著播完，跨過 1 秒照常插旗（Codex v151-i2 #1）
			dying.append({"pos": _upos(dv), "type": dv.type, "team": dv.team, "face": signf(dv.fx) if dv.fx != 0 else 1.0, "t": age})
	atk_hit.clear()
	atk_seq.clear()
	alt_hit.clear()
	proj_tgt.clear()   # V1.5：跳轉不能留舊的飛行目標（Antigravity v150-i1 #1）
	atk_t.clear()
	hurt_t.clear()
	hurt_dir.clear()
	brace_t.clear()
	accum = 0.0
	present_debt = 0.0   # 1.2.0 §9.6：跳轉後不能帶著舊的欠時加速（Codex final-r2 #3）
	result_delay = 0.0
	clutch_t = 0.0
	slow_left = 0.0
	final_left = 0.0     # Codex v10-r1 #4：跳回前段不能留著慢動作，再播到末擊要再演
	final_used = false
	key_used = false
	key_t = -10.0
	last_kill = [-1, -10.0]
	last_hitter.clear()
	hitstop = 0.0
	# 演出狀態依目標時間重建（Codex S5 #5）：最後時刻是否已發生、是否已進狂熱、音樂
	slow_used = had_clutch
	clutch_tick = keep_ct if had_clutch else -1
	if had_clutch:
		battle_marks.append({"tick": keep_ct, "kind": "clutch", "team": -1})
	_pump_view()
	# 畫面推到剛好第 target tick（原本停在 target−DELAY）
	while view.tick < target and not view.finished:
		_sim_step(false)
	frenzy_seen = view.frenzy
	if sfx != null:
		sfx.play_music("music_frenzy" if view.frenzy else "music_battle")

## 點戰場上的兵：鏡頭跟著它；點空地取消。
func _battle_click(p: Vector2) -> void:
	if not _replay_controls_active() and not (paused and state == St.BATTLE):
		return
	var world := _cam.affine_inverse() * p
	var best := -1
	var bd := 40.0 * HK   # 1.3.0：點兵半徑跟角色尺寸（Codex cat04 #2）
	for u in view.units:
		if u.alive:
			var d := _upos(u).distance_to(world + Vector2(0, 20 * HK))
			if d < bd:
				bd = d
				best = u.id
	follow_id = best
	if play_kind == "official":
		return   # 正式對局暫停時只看資料，不動鏡頭
	if best >= 0:
		pinch_zoom = 1.0   # 1.3.0 §2：點兵跟拍＝新的意圖，取代手動縮放
		dir_manual = true
	if best < 0:
		zoom_target = 1.0   # 取消跟拍：回到全景（中心由 _battle_process 拉回）

