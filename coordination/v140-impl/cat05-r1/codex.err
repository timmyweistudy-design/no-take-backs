			var tdk := _turn_dust_k(u)
			if tdk > 0.0 and not rfx:
				# V1.3 A1a：翻面時腳下踩出一小團塵土（畫在身體下面）
				for i in 3:
					var dx := (float(i) - 1.0) * (6.0 + (1.0 - tdk) * 8.0)
					draw_circle(p + Vector2(dx, 1.0 - (1.0 - tdk) * 3.0) , (2.0 + (1.0 - tdk) * 2.5) * UNIT_SCALE, Color(0.85, 0.75, 0.55, 0.55 * tdk), true, -1.0, true)
		if u.stealth > 0:
			# 潛行：身後兩道暗紫殘影
			for g in 2:
				var gp := p + Vector2(-(8 + g * 8) * face, 0)
				draw_circle(gp + Vector2(0, -22), 11.0 - g * 2.0, Color(0.3, 0.15, 0.45, 0.22 - g * 0.08), true, -1.0, true)
				_unit(gp, u.type, u.team, face, 0.0, 0.0, 0.0, 0.14 - g * 0.06, time, UNIT_SCALE)
		if live and walk <= Gait.POSE_DAZE + 1.0:
			# 暈眩：頭上轉圈的星星
			for sk0 in 3:
				var sa0 := time * 5.0 + sk0 * TAU / 3.0
				_icon("star", p + Vector2(cos(sa0) * 15.0, -60.0 * hk_of(u) + sin(sa0) * 5.0), 13.0, Color("#ffd166"))
		# V1.3.1 P1：待機小動作。站著沒事（沒走、沒出手、沒暈、還在打）時，每隻約 30～60 秒做一次、1.2 秒，依 id 錯開
		var fid := -1
		if live and not moving and at == 0.0 and u.stun <= 0 and not s.finished and mood == 0 and not bool(Save.s("reduce_fx")):
			var per := 30.0 + float((u.id * 7919) % 30)
			var tm := fmod(time + u.id * 3.7, per)
			if tm < 1.2:
				fid = mini(3, int(tm / 1.2 * 4.0))
		var ut := _pose_t(time) if (live and walk == 0.0 and at == 0.0) else time   # 1.2.0 第 5 大類 C：待機時整隻（含呼吸起伏）走定格時間（Codex cat05 #3）
		# 1.3.0 §5.4 依移動方向選視角：走路且不出手時，往南＝3/4 正面走路格、往北＝3/4 背面走路格（沒烘好就照舊側面）
		# 1.4.0 §5.3：整體壓縮蓄力（前搖）→ 出手時拉長，再回原形；只動畫面（命中 tick 不變，at 是展示時鐘算的）
		if live and at > 0.0 and at < Art.ATK_WINDUP:
			crouch *= 1.0 - SQUASH * sin(at / Art.ATK_WINDUP * PI * 0.5)
		elif live and at >= Art.ATK_WINDUP and at < Art.ATK_STRIKE + 0.1:
			crouch *= 1.0 + STRETCH * sin(clampf((at - Art.ATK_WINDUP) / (Art.ATK_STRIKE + 0.1 - Art.ATK_WINDUP), 0.0, 1.0) * PI)
		if u.id == follow_id:
			mag_pose = [face, hurt, mood]   # 1.3.0 §2 放大鏡小窗用同一幀的表情
		var hd := heading_of(u.id, u.mx, u.my, live and walk > 0.0 and at == 0.0 and hurt <= 0.0 and not u.boss)
		var usc: float = UNIT_SCALE * (BossD.DRAW_SCALE if u.boss else 1.0) * focus_scale(u.id)
		var chip := (2 if u.hp * 4 < u.max_hp else 1) if (live and not u.hidden and not u.summon and u.max_hp > 0 and u.hp * 2 < u.max_hp) else 0   # 1.3.0 §5.2 受傷掉漆
		var drawn := false
		var cache_ok: bool = sprites != null and sprites.is_ready(cbm()) and not bool(Save.s("plain_ui"))
		if hd < 0 and cache_ok:
			drawn = sprites.draw_back_walk(self, p, u.type, u.team, face, walk, hurt, alpha, ut, usc, lean, crouch, cbm())
			if drawn and chip > 0:
				_chip_at(p, u.type, face, usc, chip, alpha)   # 背面也有掉漆（Codex cat05 #4）
		if not drawn:
			# 往南：只有圖集有走路轉身頁時才用 3/4 正面（沒有就照舊側面，不讓向量畫只橫縮；Codex cat05 #6）
			var front_ok: bool = hd > 0 and cache_ok and sprites.wt_loc.has(u.type)
			var fdraw: float = (signf(face) if face != 0.0 else 1.0) * HEAD_FRONT_C if front_ok else face
			_unit(p, u.type, u.team, fdraw, walk, at, hurt, alpha, ut, usc, mood, lean, crouch, variant, fid, chip)
		if live and not u.hidden:
			_spring_acc(p, u.type, u.team, face, usc, crouch, lean, walk, at, alpha, u.id)   # 1.4.0 §5.2 即時配件（延遲回彈）
		if live and not u.hidden and hd == 0:   # 南北走的那隻不補畫（補畫只有側面，會疊出另一個輪廓；Codex cat05 #5）
			xray.append([p, [u.type, u.team, face, walk, at, alpha, lean, crouch, variant], usc])
		# 揮擊殘影（第三輪 R1、S4 依兵種分開）
		if live and at >= Art.ATK_WINDUP and at < Art.ATK_STRIKE + 0.12:
			var sk := clampf((at - Art.ATK_WINDUP) / (Art.ATK_STRIKE + 0.12 - Art.ATK_WINDUP), 0.0, 1.0)
			_draw_smear(p, u.type, u.team, face, sk, alpha, variant, 1.0)
		# 衝鋒就緒的金色拖尾（第三輪 R3）
		if u.type == D.CAVALRY and moving and u.charge >= D.CHARGE_NEED:
			var tip := p + Vector2(face * 26.0, -44.0)
			for k in 4:
				var q0 := tip - Vector2(face * k * 8.0, 0)
				var q1 := tip - Vector2(face * (k + 1) * 8.0, 0)
				draw_line(q0, q1, Color(1.0, 0.86, 0.3, (0.8 - k * 0.2) * alpha), 3.0 - k * 0.5, true)
	_draw_xray(xray)
	while prop_i < fld_props.size():
		MapArt.draw_prop(self, ORIGIN, fld_props[prop_i], time)
		prop_i += 1
	for pp in pot_draw:
		draw_circle(pp, 6.5, Art.OUT, true, -1.0, true)
		draw_circle(pp, 5.0, Color("#2a2533"), true, -1.0, true)
		draw_circle(pp + Vector2(3, -5), 2.0, Color(1, 0.8, 0.3), true, -1.0, true)
	pot_draw.clear()
	# 施放者在飛行途中陣亡：已經離手的箭／炸彈照樣飛到（Antigravity v150-i1 #1）
	if live:
		for i in 32:
			var a0 := i * TAU / 32.0
			var a1 := (i + 1) * TAU / 32.0
			var d0 := Vector2(cos(a0) * rx, sin(a0) * ry)
			var d1 := Vector2(cos(a1) * rx, sin(a1) * ry)
			draw_primitive(PackedVector2Array([c + d0 * k0, c + d1 * k0, c + d1 * k1, c + d0 * k1]), PackedColorArray([c0, c0, c1, c1]), PackedVector2Array())



## V1.0.0 P7：4 倍速以上的降噪（Gemini v100 r5：爆爆羊爆炸、史萊姆分裂、小石魔拍地不能省）
const FAST_SPEED := 4.0
const FAST_SKIP := ["pages", "bonesup", "woodwave", "axearc", "healring", "scorch", "inkring", "dust", "puff", "chips", "bones", "coins", "ripple", "note", "hex", "trip", "soulrise"]

func _add_fx(d: Dictionary) -> void:
	if bool(Save.s("reduce_fx")) and d["kind"] in ["slimehop", "pages", "bonesup", "woodwave", "axearc", "healring", "scorch", "inkring", "dust", "puff", "shard", "chips", "tell", "bones", "coins", "ripple", "note", "hex", "aim", "trip", "spore", "wool", "soulrise"]:
		return   # 第七輪 K3：簡化特效少掉粒子與裝飾，保留攻擊本身與嘲諷
	if speed >= FAST_SPEED and d["kind"] in FAST_SKIP:
		return   # V1.0.0 P7：高倍速只略過裝飾碎屑；預警圈（tell）、爆炸、分裂、拍地這類決定戰局的照畫
	var cls: String = FX_CLASS.get(d["kind"], "")
	if cls != "":
		var same_cls: Array = []
		for i0 in fx.size():
			if FX_CLASS.get(fx[i0]["kind"], "") == cls:
				same_cls.append(i0)
		if same_cls.size() >= int(FX_CLASS_CAP[cls]):
			fx.remove_at(same_cls[0])   # 1.4.0 §6.1：同類超額，丟最舊的那個（固定順序、可重現）
			fx_dropped += 1
	var pr: int = FX_PRIO.get(d["kind"], 1)
	# 同一處同種特效去重（Antigravity S2 #2）：24px 內、0.15 秒內最多 2 個
	var dp = d.get("p", d.get("b", null))
	if dp != null and not d.has("src"):   # 帶攻擊者的（砍擊、箭）不去重：每一次攻擊都要有演出
		var same := 0
		for f0 in fx:
			if f0["kind"] == d["kind"] and f0["t"] < 0.15:
				var fp = f0.get("p", f0.get("b", null))
				if fp != null and fp.distance_to(dp) < 24.0:
					same += 1
		if same >= 2:
			fx_deduped += 1
			return
	# V1.3 C：混戰降噪（先過去重再淘汰，Codex v130-impl2）。頭頂符號（鼓舞音符、嘲諷驚嘆號）同時最多幾個，多的不畫（舊的先留著，讀得到）
	if OVERHEAD_CAP.has(d["kind"]):
		var on := 0
		var old_i := -1
		for i1 in fx.size():
			if fx[i1]["kind"] == d["kind"]:
				on += 1
				if old_i < 0 or fx[i1]["t"] > fx[old_i]["t"]:
					old_i = i1
		if on >= int(OVERHEAD_CAP[d["kind"]]) and old_i >= 0:
			fx.remove_at(old_i)   # 滿了先砍最舊的，新的事件提示才看得到（Codex v130-impl1）
			fx_dropped += 1
	var n := 0
	for f in fx:
		if f["kind"] != "text":
			n += 1
	if n >= FX_CAP:
		var victim := -1
		for k in fx.size():
			var f2: Dictionary = fx[k]
			if f2["kind"] == "text":
				continue
			var p2: int = FX_PRIO.get(f2["kind"], 1)
			if p2 < 2 and (victim < 0 or p2 < FX_PRIO.get(fx[victim]["kind"], 1) or (p2 == FX_PRIO.get(fx[victim]["kind"], 1) and f2["t"] > fx[victim]["t"])):
				victim = k
		if victim >= 0 and FX_PRIO.get(fx[victim]["kind"], 1) <= pr:
			fx.remove_at(victim)
			fx_dropped += 1
		elif pr < 2:
			fx_dropped += 1
			return
		else:
			# 全部都是關鍵特效：取代最舊的那個（硬上限，Codex S1 #5）
			var oldest := -1
			for k3 in fx.size():
				if fx[k3]["kind"] != "text" and (oldest < 0 or fx[k3]["t"] > fx[oldest]["t"]):
					oldest = k3
			fx.remove_at(oldest)
			fx_dropped += 1
	fx.append(d)



## V1.2 C6：對話泡。r＝文字外框；尖角朝下指向角色。透明度跟著字淡出。
func _bubble(r: Rect2, a: float) -> void:
	var rr := r.grow_individual(4, 1, 4, 2)

exec
/bin/bash -lc "sed -n '1,150p' game/scripts/ui/battle_view.gd; sed -n '195,240p' game/scripts/ui/battle_view.gd; sed -n '330,355p' game/scripts/ui/battle_view.gd; sed -n '550,580p' game/scripts/ui/battle_view.gd; sed -n '735,810p' game/scripts/ui/game_screens.gd; sed -n '710,880p' game/scripts/ui/battle/battle_units.gd; sed -n '1020,1110p' game/scripts/ui/battle_view.gd; rg -n 'time \\+=|reduce_motion|_pose_t|dir_hot|_occ_ids|hitstop' game/scripts/ui/game*.gd game/scripts/ui/battle/*.gd | head -100" in /mnt/c/Users/timmy/projects/no-take-backs
