## 小石魔、馬、羊落地揚塵。
func _gait_step_fx(u, d: Array) -> void:
	if not gait_on.get(u.id, false):
		return
	var a: float = Gait.phase_of(u.type, d[0], CS, UNIT_SCALE, u.id)
	var b: float = Gait.phase_of(u.type, d[1], CS, UNIT_SCALE, u.id)
	if int(a / PI) != int(b / PI):
		fx.append({"kind": "step", "p": _upos(u), "t": 0.0, "dur": 0.35, "big": u.type == 19})

## 這一幀要畫的走路相位。
func _walk_of(u, a: float) -> float:
	var k: int = Gait.kind(u.type)
	if u.stun > 0 or (drag_t.get(u.id, 0.0) > 0.0):
		if drag_t.get(u.id, 0.0) > 0.0:
			return Gait.POSE_DRAG
		return Gait.POSE_DAZE
	if k == Gait.ROOT:
		return 0.0
	if gait_on.get(u.id, false):
		var d: Array = gait_d.get(u.id, [0.0, 0.0])
		return Gait.phase_of(u.type, lerpf(d[0], d[1], a), CS, UNIT_SCALE, u.id)
	if k == Gait.FLOAT:
		return 0.0001 + time * 4.0 + u.id * 0.37      # 飄浮的就算停著也在飄
	return 0.0

func _gait_frame(delta: float) -> void:
	for id in drag_t.keys():
		drag_t[id] -= delta
		if drag_t[id] <= 0.0:
			drag_t.erase(id)
	# V1.3.1 P1：全場只剩最後一隻、而且沒在出手也沒在走時，左右張望（用轉身影格）
	var alive := [0, 0]
	for u0 in view.units:
		if u0.alive:
			alive[u0.team] += 1
	for u in view.units:
		var tgt: float = signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
		if u.mx != 0 or u.my != 0 or u.stun > 0 or atk_face.has(u.id) or drag_t.has(u.id) or not idle_since.has(u.id):   # 出手、暈眩也不算站定
			idle_since[u.id] = time
func draw_back_walk(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, hurt: float, alpha: float, t: float, scale := 1.0, lean := 0.0, crouch := 1.0, cb := false) -> bool:
	if not bw_tex.has(type) or walk <= 0.0:
		return false
	var ph := int(fposmod(walk, TAU) / TAU * WT_PH) % WT_PH
	_draw_cell(ci, bw_tex[type], team * WT_PH + ph, p, type, team, face, hurt, alpha, t, scale, lean, crouch, false, 0, cb, BW_C, 0.0001 + (ph + 0.5) * TAU / WT_PH)
	return true

## 這場要用到的兵種。缺的才烘；烘的時候呼叫端先直接畫。
func ensure(types: Array) -> void:
	if DisplayServer.get_name() == "headless" or ready_cb < 0:
		return
	for t in types:
		if not loc.has(t) and not t in _queue and not t in _baking:
			_queue.append(t)
	if _busy or _queue.is_empty():
		return
	_busy = true
	var g0 := _gen   # 世代變了（build 清空並重設狀態）就不再碰共用狀態（Codex v120-final）
	while not _queue.is_empty():
		var chunk: Array = _queue.slice(0, TYPES_PER_PAGE)
		_queue = _queue.slice(chunk.size())
		_baking = chunk
		await _bake_page(chunk)
		if g0 != _gen:
			return
		_baking = []
	_busy = false
