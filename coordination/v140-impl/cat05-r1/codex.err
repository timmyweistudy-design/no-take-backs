extends "res://scripts/ui/battle/battle_units.gd"
## 其他層在同資料夾（V9 P1 拆檔）

func _on_skip() -> void:
	if skip_busy:
		return   # 防重入
	paused = false   # Codex r1：暫停中按直接看結果，算完要能進結算
	if DisplayServer.get_name() == "headless" or shot_dir != "":
		while not view.finished:
			_sim_step(false)
		result_delay = 9.0
		return
	skip_busy = true


func _skip_step() -> void:
	var t0 := Time.get_ticks_msec()
	while not view.finished and Time.get_ticks_msec() - t0 < 10:
		_sim_step(false)
	if view.finished:
		skip_busy = false
		result_delay = 9.0


## 第十輪 I4：重播的全長在背景算，算完才開始播。
func _pre_join() -> void:
	if pre_thread != null:
		var v = pre_thread.wait_to_finish()
		pre_thread = null
		if v is Array:
			replay_total = int(v[0])
			replay_bm = v[1]

## 不要等：還在算就留給 _pre_reap 收。
func _pre_drop() -> void:
	if pre_thread != null:
		pre_old.append(pre_thread)
		pre_thread = null

func _pre_reap() -> void:
	for i in range(pre_old.size() - 1, -1, -1):
		if not pre_old[i].is_alive():
			pre_old[i].wait_to_finish()
			pre_old.remove_at(i)

func _exit_tree() -> void:
	if has_method("_rv_exit"):
		call("_rv_exit")   # 1.1.0 H1：覆盤重算、GIF 先叫停再等
	bg.drain()   # 1.1.0 N6：覆盤、GIF、教練、三考、出題碼的背景工作：全部叫停再等（各自 64 tick／每格內會停）
	_pre_join()
	_pre_drop()
	for th in pre_old:
		th.wait_to_finish()
	pre_old.clear()
	if ai_thread != null:
		ai_thread.wait_to_finish()
		ai_thread = null

func _battle_process(delta: float) -> void:
	if pre_thread != null:
		if pre_thread.is_alive():
			return
		_pre_join()
	if view != null:
		_gait_frame(delta)   # 不能放在只有部分情況才跑的地方（Codex P2 #1）
	if start_hold > 0.0:
		var ph0 := 1.0 - start_hold
		start_hold -= delta
		var ph1 := 1.0 - start_hold
		for at in [0.25, 0.55, 0.85]:   # 1.2.0 §9.1：三段落子各一聲厚重落子聲（全場只有 3 聲）
			if ph0 < at and ph1 >= at and sfx != null:
				sfx.play("place_heavy", 0.75)
		return
	if call("_seek_pump"):
		return
	if _hl_reel_tick():
		return   # 1.3.0 §2 精華三連：換段開始跳轉，這一幀不再推進（Codex cat06 #1）
	if skip_busy:
		_skip_step()
		return
	if paused:
		return
	if hitstop > 0:
		# 1.2.0 §9.6 展示時鐘：停頓期間欠下的模擬 tick（只算真的停頓的那段、照停頓當下的倍速換算）
		present_debt += minf(delta, hitstop) * speed / 0.05
		hitstop -= delta
		return
	var rate := speed
	if present_debt > 0.0 and slow_left <= 0 and final_left <= 0:
		if present_debt > 20.0:
			# 落後超過 1 秒（20 tick）：不播演出直接追上（事件照常記進戰報與書籤；最後時刻只記狀態不演）
			var nskip := int(present_debt)
			for _i in nskip:
				if view.finished:
					break
				_sim_step(false)
			present_debt = 0.0
		else:
			var extra := minf(delta * speed * 0.5 / 0.05, present_debt)   # 追回：最多 1.5 倍速
			accum += extra * 0.05
			present_debt -= extra
	if slow_left > 0:
		rate *= 0.5
		slow_left -= delta
	if final_left > 0:
		rate *= 0.25      # 第十輪 F1：最後一擊
		final_left -= delta
		_update_action_focus()
	accum += delta * rate
	while accum >= 0.05 and not view.finished:
		accum -= 0.05
		var was_slow := slow_left > 0 or final_left > 0
		_sim_step(true)
		if (slow_left > 0 or final_left > 0) and not was_slow:
			break   # 這一 tick 觸發慢動作：剩下的累積留到下一幀用慢速消耗（Codex S8 #3）
	# 播完之後展示時鐘繼續走（不再推進快照）：最後一格的位置插值與最後一擊的後搖要演完（Codex R5 #1）
	# 最後時刻只在 _sim_step 每個畫面 tick 判定（Codex S8 #1：每幀也判會讓觸發 tick 跟幀率有關）
	if slow_left > 0:
		_update_action_focus()
	# 1.3.0 §2 最後一擊的抽離感：環境低通壓到約 400Hz、畫面去飽和 25%，0.4 秒回彈（減少特效時慢動作本來就不開）
	sfx.set_muffled((slow_left > 0 or final_left > 0) and not view.finished, 400.0 if final_left > 0 else 900.0)
	desat_a = 0.25 if final_left > 0 else move_toward(desat_a, 0.0, delta * 0.25 / 0.4)
	_spot_update(delta)
	_pad_cam(delta)
	# 分軌音樂依戰況混音（第三輪 S1）
	var close := absf(view.power(0) * 100.0 / (view.budget_of(0) * 1000) - view.power(1) * 100.0 / (view.budget_of(1) * 1000)) <= 15.0
	sfx.set_layer_targets(sfx.layer_targets(close, slow_left > 0 and not view.finished))
	if sfx.has_method("set_room_tense"):
		sfx.set_room_tense(close or slow_left > 0)   # 1.3.0 §10：戰況緊時遠景低通
	# 鏡頭只有一個決策點（Codex S5 #6）：跟拍優先於最後時刻框選，兩者都沒有才回到全景
	if follow_id >= 0:
		pass   # 由 _follow_update 決定
	elif pinch_zoom > 1.01:
		zoom_target = pinch_zoom   # V1.4 #18：玩家用雙指放大，就停在那裡（1.3.0：手動優先於最後時刻框選，Codex cat06 #5）
		zoom_center = zoom_center.lerp(pinch_center, minf(1.0, delta * 6))
	elif slow_left > 0 and not view.finished and bool(Save.s("clutch_zoom")) and not bool(Save.s("reduce_motion")):   # V1.5：最後時刻自動放大可關
		_frame_alive(delta)
	elif _dir_on():
		_director_cam(delta)   # 1.3.0 §2 自動導播（重播、觀戰）
	else:
		zoom_target = 1.0
		zoom_center = zoom_center.lerp(ORIGIN + fld_size / 2, minf(1.0, delta * 3))
	zoom = lerpf(zoom, zoom_target, delta * 3)
	if view.finished:
		result_delay += delta
		if result_delay > 1.4:
			on_battle_finished.call()



	_pump_view()
	_check_final(with_fx)
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	if not view.advance():
		view.finished = true
		return
	if tm_ghost != null:
		call("_tm_sync")
	_gait_tick(with_fx)
	_status_tags(with_fx)   # 1.3.0 §7.1 狀態竹籤
	_pump_view()
	_check_clutch(with_fx)   # 每一個畫面 tick 都判定（原本每一幀判一次，觸發的 tick 會跟幀率有關）
	if view.frenzy and not frenzy_seen:
		frenzy_seen = true
		if with_fx:
			_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
			sfx.play("frenzy")
			sfx.play_music("music_frenzy")
	var deaths := 0
	for ev in view.events:
		var k: String = ev["kind"]
		var s = view.unit_by_id(ev["src"]) if ev.has("src") else null
		if s != null:   # V1.4 #10：沙盤機關的事件沒有來源單位（src＝-1）
			var key := "%s%d" % [k, s.team]
			ev_count[key] = int(ev_count.get(key, 0)) + 1
			if k == EV.BLAST and not ev.has("dmg"):   # 第八輪：爆炸演出一筆一次；逐目標傷害不算次數（BOOM_5）
				ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
		if k == EV.DEATH:
			deaths += 1
		_collect_mark(ev, view, view.tick)
		_on_event(ev, with_fx)
	# 碾壓局最後一擊（優化方案 F1）：0.2 秒頓格＋微震，直接進結算
	if view.finished and not slow_used and deaths > 0 and with_fx:
		hitstop = 0.2
		if bool(Save.s("shake")):
			shake = 0.15



## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
func _pump_view() -> void:
	for fr in view.pump(sim):
		for e in fr["events"]:
			if e["kind"] == EV.CHARGE or e["kind"] == EV.BRACED:
				_cue_add(str(e["kind"]), int(e.get("src", -1)), int(e.get("tgt", -1)), int(fr["tick"]))   # 1.3.0 §7.1 預告
			hurt_dir[t.id] = 0.0
			_add_fx({"kind": "pin", "a": sp + Vector2(0, -26), "b": tp + Vector2(0, -26), "t": 0.0, "dur": 0.3})
			_report_add(s.team, s.type, k, L.t("ev_voodoo"), Color("#ff6bb0"), s)
		EV.BLAST:
			if s.id != t.id:
				hurt_t[t.id] = time
				hurt_dir[t.id] = signf(tp.x - sp.x) if tp.x != sp.x else 0.0
			else:
				var small: bool = ev.get("small", false)
				_add_fx({"kind": "boom", "src": s.id, "p": sp + Vector2(0, -8), "t": 0.0, "dur": 0.45, "big": not small})
				_add_fx({"kind": "wool", "p": sp + Vector2(0, -18), "t": 0.0, "dur": 0.6})
				_stain(sp, (F8.DEATH_BLAST_R if small else F8.BLAST_R) * CS / 1000.0, false, view.tick * 31 + s.id)
				sfx.play("boom", 0.8)
				sfx.play("baa", 0.6)
				if _fx_on("shake"):
					shake = 0.1
				# V1.1 B2：連環爆（0.4 秒內第二顆起）短頓格，看得出是一串連鎖
				if view.tick - last_blast_tick <= 8 and _fx_on("shake"):
					hitstop = maxf(hitstop, 0.06)
				last_blast_tick = view.tick
				_report_add(s.team, s.type, k, L.t("ev_blast"), Color("#ffb347"), s)
		EV.BITE:
			atk_t[s.id] = time
			hurt_t[t.id] = time
			hurt_dir[t.id] = signf(tp.x - sp.x) if tp.x != sp.x else 0.0
			_add_fx({"kind": "chomp", "p": tp + Vector2(0, -28), "t": 0.0, "dur": 0.35})
				shake = maxf(shake, 0.25)
		return
	if k in ["collapse", "fire", "push"]:
		# V1.4 #10 沙盤機關發動：中間一句大字＋音效（不進模擬）
		if with_fx:
			_fx_text(Vector2(640, 150), L.t("ev_" + k), Color("#ffb347") if k != "push" else Color("#f3e3c0"), 1.0, tz("H2"), true)
			sfx.play("bell" if k == "collapse" else ("poison" if k == "fire" else "turn"), 0.6)
			if k == "collapse" and _fx_on("shake"):
				shake = maxf(shake, 0.2)
		return
	if _on_event_v8(ev, k, with_fx):
		return
	if k == EV.DEATH:
		var u = view.unit_by_id(ev["id"])
		if with_fx:
			last_kill = [int(last_hitter.get(int(ev["id"]), -1)), time]   # V1.3.1 P2：最後一擊定格用（誰、什麼時候）
		dying.append({"pos": _upos(u), "type": u.type, "team": u.team, "face": signf(u.fx) if u.fx != 0 else 1.0, "t": 0.0})
		if with_fx:
			sfx.play_unit("death", 0.7, u.type)   # V1.3.1：倒下的聲音依兵種音高
			sfx.play_unit("wood_topple", 0.45, u.type)   # V1.6 #14：木座倒地彈兩下
			_kill_rumble()
			_death_extra(u)
			# V1.1 B2：殘局「斬首」的目標倒下：頓格＋微震＋大字（只動播放，不進模擬）
			if mode == Mode.PUZZLE and _goal_target_id() == int(ev["id"]):
				if not bool(Save.s("reduce_fx")):
					hitstop = maxf(hitstop, 0.3)   # 簡化特效時不頓格（Codex v110-impl2）
				if _fx_on("shake"):
					shake = maxf(shake, 0.18)
				_fx_text(Vector2(640, 150), L.t("ev_behead"), ACCENT, 1.2, tz("H2"), true)
				sfx.play("bell", 0.9)
		return

func _draw_inner() -> void:
	_btns.clear()
	_probe_cell_seq = 0
	probe_texts.clear()
	probe_btns.clear()
	probe_ctrls.clear()
	probe_boxes.clear()
	probe_icons.clear()
	probe_reset_geom()
	_probe_ui = false
	_draw_desk()   # 1.2.0 §1.1 桌面世界：整個畫面是一張胡桃木桌（取代深綠底＋一圈樹）
	if (state == St.BATTLE or state == St.PLACE) and not bool(Save.s("plain_ui")):
		draw_rect(Rect2(0, 0, 1280, 800), Color(DIM_INK, 0.15))   # 1.2.0 第 6 大類 F §5.5 景深：對局時桌面退後（盤面不受影響，盤在之後畫）
	_sync_field()
	var fxf := _fld_xf()
	var cam := fxf
	if state == St.BATTLE or state == St.RESULT:
		var off := Vector2.ZERO
		if shake > 0 and _fx_on("shake"):
			off = Vector2(sin(time * 90) * 2, cos(time * 77) * 2) * int(Save.s("shake_pct")) / 100.0   # V1.5：鏡頭震動強度
		var w := clampf((zoom - 1.0) / 0.5, 0.0, 1.0)
		var c := (ORIGIN + FIELD / 2).lerp(fxf * zoom_center, w)
		var half := Vector2(640, 388) / zoom
		var anchor := Vector2(640, 388 + BATTLE_DY)
		var lo := ORIGIN + half - Vector2(60, 100)
		var hi := ORIGIN + FIELD - half + Vector2(60, 100)
		c = Vector2(clampf(c.x, minf(lo.x, hi.x), maxf(lo.x, hi.x)), clampf(c.y, minf(lo.y, hi.y), maxf(lo.y, hi.y)))
		cam = Transform2D(0, Vector2(zoom, zoom), 0, anchor - c * zoom + off) * fxf
	if state == St.TITLE:
		# 第七輪 D4：示範戰場縮小放右邊，不被左側面板壓到
		cam = Transform2D(0, Vector2(0.72, 0.72), 0, Vector2(1270.0 - (ORIGIN.x + FIELD.x) * 0.72, 400.0 - (ORIGIN.y + FIELD.y / 2.0) * 0.72))
	draw_set_transform_matrix(cam)
	_cam = cam
	Art.base = cam
	var _t := Time.get_ticks_usec()
	_draw_field()
	perf_parts["field"] = Time.get_ticks_usec() - _t
	_t = Time.get_ticks_usec()
	if state == St.TITLE:
		_draw_units_of(demo, true)
	elif state == St.PLACE:
		if _is_free():
			_fp_draw_zones()   # 第六輪：自由排兵
			_fp_draw()
		else:
			_draw_place_units()
			_draw_tactical()
		_v16_place_draw()   # V1.6 #6
	else:
		if state == St.BATTLE and _frags_on():
			frags.draw(self)   # 1.2.0 §8.2 材料碎片在地上、單位之下
		if state == St.BATTLE:
			_draw_contact_ao(view)   # 1.4.0 §3.2 接觸陰影
		_draw_units_of(view, false)
		if state == St.BATTLE:
			_draw_occluded_bases(view)   # 1.4.0 §3.1 被擋住的兵補虛線底座
			_draw_cues()   # 1.3.0 §7.1 技能預告（命中前）
			_v16_battle_draw()
	perf_parts["units"] = Time.get_ticks_usec() - _t
	_t = Time.get_ticks_usec()
	for f in fx:   # 先畫特效，跳字最後畫（Antigravity S2 #1：特效不能蓋住跳字）
		if not f.get("screen", false) and f["kind"] != "text":
			_draw_fx(f)
	for f in fx:
		if not f.get("screen", false) and f["kind"] == "text":
			_draw_fx(f)
	perf_parts["fx"] = Time.get_ticks_usec() - _t
	if state == St.RESULT and _ink_active():
		_draw_ink_report_field()
	draw_set_transform_matrix(Transform2D.IDENTITY)
	# V1.2 F2：畫面四周暈影（戰場與標題背景，壓在介面底下），讓視線集中在中間
	var vg := _ui_tex("res://art/ui/vignette.png")
	if vg != null and not bool(Save.s("plain_ui")):
		draw_texture_rect(vg, Rect2(0, 0, 1280, 800), false, Color(1, 1, 1, 0.5))
	_probe_ui = true
	var a_now := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
	var gm: Array = _goal_mark()
	if live and tm_ghost != null and play_kind == "review" and tm_ghost_on:
		# V1.4 #1 時光機：原本那條時間線的兵畫成地上的淡圈（隊伍色點＋白圈），看得出兩條時間線從哪裡分開
		for gu in tm_ghost.units:
			if not gu.alive:
				continue
			var gq: Vector2 = ORIGIN + Vector2(gu.x, gu.y) * CS / 1000.0
			# 粉筆虛線圈（米白、45%），不是 RTS 選取框（Antigravity v140-i1）
			draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.5), 0, gq))
			var rr := 15.0 * UNIT_SCALE
			for sgm in 8:
				var a0 := sgm * TAU / 8.0 + float(gu.id % 5) * 0.2
				draw_arc(Vector2.ZERO, rr, a0, a0 + TAU / 14.0, 4, Color("#e8dcc4", 0.45), 2.2, true)
			draw_set_transform_matrix(_cam)
			draw_circle(gq, 2.4, Color(Art.team_color(gu.team, cbm()), 0.5), true, -1.0, true)
	if live:
		# V1.3 C3：戰報墨圈畫在最底層（腳底三層之下）
		for f in fx:
			if f["kind"] == "inkring":
				var ik: float = f["t"] / f["dur"]
				draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.5), 0, f["p"] + Vector2(0, 2)))   # 貼在地上（壓扁成橢圓）
				_hand_ring(Vector2.ZERO, (26.0 + ik * 8.0) * UNIT_SCALE, Color(0.12, 0.07, 0.04, 0.55 * (1.0 - ik)), 2.6, false, 1)
				draw_set_transform_matrix(_cam)
	for u in list:
		var p0: Vector2 = pc[u.id] if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
		var air0: float = Gait.air(u.type, _walk_of(u, a_now)) if live else 0.0
		var ar0 := clampf(air0 * 0.05, 0.0, 1.0)
		var bsc: float = UNIT_SCALE * (BossD.DRAW_SCALE if u.boss else 1.0) * focus_scale(u.id)   # V1.4 #12 巨獸畫大；1.3.0 跟拍的那一隻畫大
		_ring(p0, u.team, u.type, bsc, ar0 if ar0 > 0.15 else 0.0)   # 小跳步不分層（效能：合成格一次貼完；1.1.0 B14 族群底座部件也烘在合成格裡）   # V1.3 A3：木座和隊伍圈留在地上，只有影子跟著跳起縮
		if u.st > 0:
			_sticker_badge(p0, u.st, UNIT_SCALE, u.ward or u.st != 3)   # V1.4 #9：護符用掉就淡掉
		if u.shield > 0:       # 第十二輪：手動技能的護盾、戰吼
			_hand_ring(p0 + Vector2(0, -24) * UNIT_SCALE, 28.0 * UNIT_SCALE, Color(0.55, 0.85, 1.0, 0.75), 2.5)
		if u.haste_t > 0:
			_hand_ring(p0, 19.0 * UNIT_SCALE, Color(1.0, 0.75, 0.25, 0.85), 2.5)
		if u.id == int(gm[0]) or (int(gm[0]) == -2 and u.team == 0 and u.type == int(gm[2]) and not u.summon):
			_goal_marker(p0, "protect" if int(gm[0]) == -2 else str(gm[1]))   # 第十三輪：要護送／斬首的那一隻；V1.1：不能倒的那種兵每隻都標
			if u.team == 0 and u.hp * 100 <= u.max_hp * 30 and not rfx:
				# V1.6.1 A2：要保住的兵殘血時框閃紅（白黑雙邊，色盲也看得出）
				var fl := 0.55 + 0.45 * sin(time * 6.0)   # 約 1 Hz 呼吸（Antigravity v161-i1：原本約 2 Hz 太累）
				_hand_ring(p0 + Vector2(0, -20) * UNIT_SCALE, 31.0 * UNIT_SCALE, Color(0, 0, 0, 0.5 * fl), 4.0)
				_hand_ring(p0 + Vector2(0, -20) * UNIT_SCALE, 30.0 * UNIT_SCALE, Color(1.0, 0.25, 0.2, fl), 2.5)
		if live and s.rally[u.team] and not s.finished:
			for k in 2:
				var ph := fmod(time * 1.6 + k * 0.5, 1.0)
				_hand_ring(p0, (14.0 + ph * 10.0) * UNIT_SCALE, Color(1, 0.42, 0.0, 0.55 * (1.0 - ph)), 2.0)
	# 陣亡痕跡：倒下處的小旗，3 秒淡出，畫在最底層（第三輪 R5）
	if live:
		for g in graves:
			var ga: float = 1.0 - g["t"] / 3.0
			var gp: Vector2 = g["pos"]
			draw_line(gp + Vector2(0, 2), gp + Vector2(0, -16), Color(0.35, 0.27, 0.2, 0.8 * ga), 2.0, true)
			draw_colored_polygon(PackedVector2Array([gp + Vector2(0, -16), gp + Vector2(10, -12), gp + Vector2(0, -8)]), Color(Art.team_color(g["team"], cbm()), 0.75 * ga))
			draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.4), 0, gp + Vector2(0, 2)))   # 疊在鏡頭上（Codex S4 #5）
			draw_circle(Vector2.ZERO, 7, Color(0, 0, 0, 0.25 * ga), true, -1.0, true)
			draw_set_transform_matrix(_cam)
	# 擁擠度：40px 內有幾隻（第三輪 V5，只在戰鬥中算）
	var crowd := {}
	if live:
		# V1.3 P0-1：40px 格子分桶，只比相鄰 9 格（判定與雙迴圈相同：距離平方 < 1600）
		var bk := {}
		for u in list:
			var q: Vector2 = pc[u.id]
			var key := Vector2i(floori(q.x / (40.0 * HK)), floori(q.y / (40.0 * HK)))
			if bk.has(key):
				bk[key].append(q)
			else:
				bk[key] = [q]
		for u in list:
			var q: Vector2 = pc[u.id]
			var cx := floori(q.x / 40.0)
			var cy := floori(q.y / 40.0)
			var n := -1   # 自己一定在同一格，先扣掉
			for dx in range(-1, 2):
				for dy in range(-1, 2):
					var cell = bk.get(Vector2i(cx + dx, cy + dy))
					if cell == null:
						continue
					for o in cell:
						if q.distance_squared_to(o) < 1600.0 * HK * HK:
							n += 1
			crowd[u.id] = n
	# 第二層：身體（V9：地圖的前景物件依腳點 y 插進來，才有前後遮擋）
	var prop_i := 0
	var xray: Array = []   # V1.1 C5：[腳點, 參數]，給被下排蓋到臉的那隻補畫半透明
	for u in list:
		var p: Vector2 = pc[u.id] if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
		while prop_i < fld_props.size() and ORIGIN.y + float(fld_props[prop_i][0]) <= p.y:
			MapArt.draw_prop(self, ORIGIN, fld_props[prop_i], time)
			prop_i += 1
		var walk: float = _walk_of(u, a_now) if live else ((time * Gait.nominal_rate(u.type, float(D.stat(u.type)["speed"]), CS, UNIT_SCALE) + u.id) if (u.mx != 0 or u.my != 0) else 0.0)
		var moving: bool = walk > 0.0
		var at := 0.0
		var variant := 0
		var hit_now := -1
		if live and atk_hit.has(u.id):
			var dt0 := _disp_tick()
			# V1.5：遠程的「出手」提早 fly 個 tick（飛行物離手），命中 tick 不變；動作照出手時間演
			var ph := proj_phase(atk_hit[u.id], dt0, u.type, view.delay, proj_tgt.get(u.id, {}))
			var hr: int = ph[0]
			var h: int = ph[1]
			var fly: int = h - hr if hr >= 0 else 0
			hit_now = h
			if h >= 0:
				at = atk_progress(dt0 - float(ph[3]), u.type, float(ph[4]))   # V1.5.1：這一發自己的動作起點與前搖
				if float(ph[2]) >= 0.0 and proj_tgt.get(u.id, {}).has(h):
					var pt = view.unit_by_id(proj_tgt[u.id][h])
					if pt != null:
						var pk: float = ph[2]
						var psg: float = signf(_upos(pt).x - _upos(u).x) if _upos(pt).x != _upos(u).x else (signf(u.fx) if u.fx != 0 else 1.0)
						proj_draw.append([u.type, u.team, _upos(u) + proj_launch(u.type, psg) * UNIT_SCALE, _upos(pt) + Vector2(0, -22 if u.type != D.BOMBER else -10), pk])
				# V1.5：舊的「前搖 2 tick 火罐飛行」拿掉：火罐前搖時在手上，出手後由上面的飛行物畫（手動軍令局沒有餘裕就直接落點爆炸）
				if u.type == D.SWORD:
					variant = int(atk_seq.get(u.id, {}).get(h, 0)) % 2   # 劍士橫斬與上挑逐擊交替（第三輪 R4）
				elif u.type >= D.CLASSIC and alt_hit.get(u.id, {}).has(h):
					variant = 2
		var hurt := 0.0
		if live and hurt_t.has(u.id) and _fx_on("flash"):
			# 1.3.0 §6 受擊後仰也走定格（_pose_t；Codex cat05 #8）；V1.5：受擊閃白強度
			hurt = clampf(1.0 - (maxf(_pose_t(time), float(hurt_t[u.id])) - hurt_t[u.id]) / 0.15, 0, 1) * int(Save.s("flash_pct")) / 100.0
		var alpha := 0.45 if u.stealth > 0 else 1.0
		if dim:
			alpha *= 0.6
		if live:
			alpha *= _focus_dim(p)
		var face := signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
		# 受擊後退 4px（第三輪 R2）：0.08 秒退、0.07 秒回，只是畫面
		if live and hurt_t.has(u.id):
			var hk: float = (time - float(hurt_t[u.id])) / 0.15
			if hk >= 0.0 and hk < 1.0:
				p.x += float(hurt_dir.get(u.id, 0.0)) * 4.0 * (sin(hk * PI) if hk < 1.0 else 0.0)
		if live and u.id == follow_id:
			_hand_ring(p + Vector2(0, 2), 22.0, Color(ACCENT, 0.9), 3.0, true)   # 跟拍中的那隻
		# 擠在一起時，正在出手或受擊的那隻加隊伍色光圈（第三輪 V5）
		if live and (at > 0.0 or hurt > 0.0) and crowd.get(u.id, 0) >= 3:
			_hand_ring(p + Vector2(0, -24 if u.type != D.CAVALRY else -28), 19.0, Color(Art.team_color(u.team, cbm()), 0.75 * alpha), 2.0)
		# 表情與兵種專屬動作（R5）
		var mood := 0
		var lean := 0.0
		var crouch := 1.0
		if hurt > 0.3 or u.stun > 0:
			mood |= Art.M_HURT
		elif grim[u.team] and at == 0.0:
			mood |= Art.M_GRIM
		if hurt > 0.0:
			crouch *= 1.0 - 0.12 * hurt                 # V1.1 A2：受擊壓扁（縱 0.88），配合後退與閃白
			lean -= 0.06 * hurt * float(hurt_dir.get(u.id, 0.0)) * face
		# 1.2.0 第 5 大類 A2：不倒翁搖（衰減擺盪）：相位用受擊後經過的時間（0.45 秒），和閃白強度無關（Codex cat05 #2）；減少動態時不搖
		if live and hurt_t.has(u.id) and not bool(Save.s("reduce_motion")):
			var hk := clampf(1.0 - (time - float(hurt_t[u.id])) / 0.45, 0.0, 1.0)
			if hk > 0.0:
				lean += _tumbler(hk) * float(hurt_dir.get(u.id, 1.0)) * face
		crouch *= _open_squash(u)
		if live:
			# V1.3 A4：停步慣性。剛停下時身體往前多晃一下再回正（0.3 秒，解析式衰減，不存逐兵彈簧狀態）
			if moving:
				stop_t.erase(u.id)
				walking[u.id] = true
			elif walking.get(u.id, false):
				walking.erase(u.id)
				stop_t[u.id] = time
			if stop_t.has(u.id):
				var sk: float = (time - float(stop_t[u.id])) / 0.3
				if sk >= 1.0 or at > 0.0:
					stop_t.erase(u.id)
				else:
					lean += 0.13 * sin(sk * TAU * 0.75) * (1.0 - sk)   # 正＝往前（unit_xf 會乘朝向）
		if live and u.windup > 0 and at == 0.0:
			# V1.1 A3：大招前搖的身體預警。小石魔高舉拉長、吸塵貓吸氣鼓脹、沙漏精靈與骷髏法師浮起
			var wk := 1.0 - float(u.windup) / F8.WINDUP
		if grp.size() > best.size():
			best = grp
	spot_n = best.size()
	if spot_n >= 2:
		var c := Vector2.ZERO
		for b in best:
			c += b
		c /= float(spot_n)
		spot_p = c if spot_a <= 0.01 else spot_p.lerp(c, minf(1.0, delta * 2.0))
		spot_a = move_toward(spot_a, 1.0, delta * 2.0)
	else:
		spot_a = move_toward(spot_a, 0.0, delta * 1.2)

func _dir_on() -> bool:
	return play_kind != "official" and not dir_manual and view != null and bool(Save.s("auto_director")) and not bool(Save.s("reduce_motion"))

func _director_cam(delta: float) -> void:
	var fc := ORIGIN + fld_size / 2
	if time < dir_hot_until and not view.finished:
		zoom_target = 1.35
		zoom_center = zoom_center.lerp(dir_hot_p, minf(1.0, delta * 3.0))
		return
	var r: Array = DirR.director_target(view.tick, view.finished, spot_p, spot_n, fc, fld_size.x)
	zoom_target = float(r[0])
	zoom_center = zoom_center.lerp(r[1], minf(1.0, delta * (4.0 if view.tick < DirR.TOUR_TICKS else 1.5)))

## 手動鏡頭：右搖桿平移（放大時）、右扳機放大、左扳機縮小。動了就交還手動。
func _pad_cam(delta: float) -> void:
	if overlay != "" or Input.get_connected_joypads().is_empty():
		return
	var dz := maxf(0.15, int(Save.s("deadzone")) / 100.0)
	var zi := Input.get_joy_axis(last_joy, JOY_AXIS_TRIGGER_RIGHT) - Input.get_joy_axis(last_joy, JOY_AXIS_TRIGGER_LEFT)
	if absf(zi) > 0.3:
		if pinch_zoom <= 1.01:
			pinch_center = zoom_center
		pinch_zoom = clampf(pinch_zoom * (1.0 + zi * delta * 1.2), 1.0, 2.0)
		_take_manual()
	var v := Vector2(Input.get_joy_axis(last_joy, JOY_AXIS_RIGHT_X), Input.get_joy_axis(last_joy, JOY_AXIS_RIGHT_Y))
	if v.length() > dz and pinch_zoom > 1.01:
		pinch_center += v * delta * 420.0 / pinch_zoom
		_take_manual()

## 滑鼠：滾輪縮放（往游標方向）、中鍵拖曳平移、雙擊回全景（game_screens 的輸入佇列呼叫）。
func cam_wheel(up: bool, at: Vector2) -> void:
	_take_manual()
	if not up and pinch_zoom <= 1.01:
		return
	call("_pinch_by", 1.12 if up else 1.0 / 1.12, at)
	_cam_apply_paused()

func cam_pan(rel: Vector2) -> void:
	if pinch_zoom <= 1.01:
		return
	_take_manual()
	pinch_center -= rel / maxf(1.0, zoom)
	_cam_apply_paused()

func cam_reset() -> void:
	_take_manual()
	pinch_zoom = 1.0
	follow_id = -1
	if paused:
		zoom = 1.0
		zoom_target = 1.0
		zoom_center = ORIGIN + fld_size / 2

## 玩家動了鏡頭：導播交還、跟拍放掉（手動優先）、精華三連停在這裡。
func _take_manual() -> void:
	dir_manual = true
	hl_reel = []
	if follow_id >= 0 and play_kind != "official":
		follow_id = -1

## 暫停時 _battle_process 不跑鏡頭：滾輪、平移直接套上（Codex cat06 #5）。
func _cam_apply_paused() -> void:
	if paused and pinch_zoom > 1.01:
		zoom = pinch_zoom
		zoom_target = pinch_zoom
		zoom_center = pinch_center
	elif paused:
		zoom = 1.0
		zoom_target = 1.0

## 聚光：熱點外圍淡淡壓暗（只壓戰場與桌面，畫在介面之前）；簡化介面、減少特效、設定關時不畫。
func _draw_spotlight() -> void:
	if spot_a <= 0.01 or view == null or not bool(Save.s("spotlight")) or bool(Save.s("plain_ui")) or bool(Save.s("reduce_fx")):
		return
	var c: Vector2 = _cam * spot_p
	var sz := Vector2(2800, 2800) * clampf(zoom, 1.0, 1.6)
	draw_texture_rect(_spot_tex(), Rect2(c - sz / 2.0, sz), false, Color(1, 1, 1, 0.34 * spot_a))   # Hydrogen cat06 #4：原本 0.2 太淡

