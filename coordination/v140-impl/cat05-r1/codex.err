 func _director_cam(delta: float) -> void:
 	var fc := ORIGIN + fld_size / 2
+	if time < dir_hot_until and not view.finished:
+		zoom_target = 1.35
+		zoom_center = zoom_center.lerp(dir_hot_p, minf(1.0, delta * 3.0))
