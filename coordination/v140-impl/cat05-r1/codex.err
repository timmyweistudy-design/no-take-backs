+# ── 1.4.0 第 5 大類：戰場可讀（方案 §3）──
+## 接觸陰影：每隻兵腳下一圈淡淡的環境光遮蔽（底座壓暗貼地，放到桌上）。畫在單位之前；順便算好這一幀的位置給虛線底座用。
+var _ao_pos: Array = []      # [[單位, 盤面位置], …]（這一幀）
+var _occ_ids := {}           # 被擋住的單位 id（每 6 幀重算一次：O(n²)，切片 B 量測）
+var _occ_frame := -99
+func _draw_contact_ao(s) -> void:
+	_ao_pos.clear()
+	if s == null or bool(Save.s("plain_ui")):
+		return
+	# 全部的橢圓組成一個三角形陣列、一次送出（逐隻 draw_colored_polygon 在 48 兵時 p95 +4%，切片 B 量測）
+	var verts := PackedVector2Array()
+	var idx := PackedInt32Array()
+	var n := ELL16.size()
+	for u in s.units:
+		if not u.alive or u.hidden:
+			continue
+		var p := _upos(u)
+		_ao_pos.append([u, p])
+		var c := p + Vector2(2, 3)
+		var base := verts.size()
+		verts.append(c)
+		for k in n:
+			verts.append(c + ELL16[k] * (21.0 * HK))
+		for k in n:
+			idx.append(base)
+			idx.append(base + 1 + k)
+			idx.append(base + 1 + (k + 1) % n)
+	if not idx.is_empty():
+		var cols := PackedColorArray()
+		cols.resize(verts.size())
+		cols.fill(Color(DIM_INK, 0.16))
+		RenderingServer.canvas_item_add_triangle_array(get_canvas_item(), idx, verts, cols)
+
+## 被前面的兵擋住的：在最上層補一圈虛線底座（找得到自己的兵；48 兵都能定位）。最多 24 隻。
+func _draw_occluded_bases(s) -> void:
+	if s == null or bool(Save.s("plain_ui")) or _ao_pos.is_empty():
+		return
+	var fr := Engine.get_frames_drawn()
+	if fr - _occ_frame >= 6 or fr < _occ_frame:
+		_occ_frame = fr
+		_occ_ids.clear()
+		var sy: Array = _ao_pos.duplicate()
+		sy.sort_custom(func(x, y): return (x[1] as Vector2).y < (y[1] as Vector2).y)   # 依 y 排好：只往後看 48px 內（不是 O(n²) 全掃）
+		for i in sy.size():
+			var pa: Vector2 = sy[i][1]
+			for j in range(i + 1, sy.size()):
+				var pb: Vector2 = sy[j][1]
+				if pb.y > pa.y + 48.0 * HK:
+					break
+				if pb.y > pa.y + 2.0 and absf(pb.x - pa.x) < 15.0 * HK:
+					_occ_ids[sy[i][0].id] = true
+					break
+			if _occ_ids.size() >= 24:
+				break
+	if _occ_ids.is_empty():
+		return
+	var segs := [PackedVector2Array(), PackedVector2Array()]   # 每隊一次 draw_multiline
+	for a in _ao_pos:
+		if not _occ_ids.has(a[0].id):
+			continue
+		var pa: Vector2 = a[1]
+		var tm: int = clampi(int(a[0].team), 0, 1)
+		for k in range(0, ELL16.size(), 2):   # 虛線＝每隔一段畫一段
+			segs[tm].append(pa + ELL16[k] * (17.0 * HK))
+			segs[tm].append(pa + ELL16[(k + 1) % ELL16.size()] * (17.0 * HK))
+	for tm in 2:
+		if not (segs[tm] as PackedVector2Array).is_empty():
+			draw_multiline(segs[tm], Color(Art.team_color(tm, cbm()), 0.9), 2.0)
+
+## 單位橢圓（扁 0.42）16 點，接觸陰影與虛線底座共用（不每幀算 sin／cos）
+static var ELL16: PackedVector2Array = _ell16()
+static func _ell16() -> PackedVector2Array:
+	var out := PackedVector2Array()
+	for k in 16:
+		var a := k * TAU / 16.0
+		out.append(Vector2(cos(a), sin(a) * 0.42))
+	return out
+
+# ── 1.4.0 第 6 大類：角色動作切片 B（方案 §5.2、§5.3）──
+const SQUASH := 0.07    # 前搖整體壓縮
+const STRETCH := 0.05   # 出手拉長
+## 即時配件（只有少數：劍士盔羽、弓箭手披風、騎兵鞍穗）：角度是展示時間、走路相位、前傾、出手進度的純函式
+## （不積分、不存狀態 → 不同幀率同一時刻一樣、跳轉不用重建）；每兵種頻率與相位不同（不會整軍齊震）。
+## [錨點(單位座標), 長度, 粗細, 頻率, 靜止角(弧度, 0＝往下), 顏色鍵]
+const SPRING := {
+	0: [Vector2(-2, -45), 9.0, 2.6, 1.0, -2.3, "red"],      # 劍士：盔頂紅羽（往後上翹）
+	2: [Vector2(-8, -27), 14.0, 5.0, 0.8, 0.35, "team"],    # 弓箭手：肩後短披風
+	3: [Vector2(-17, -29), 10.0, 2.2, 1.25, 0.15, "gold"],  # 騎兵：鞍穗
+}
+
+static func spring_angle(type: int, t: float, walk: float, lean: float, at: float, id: int) -> float:
+	if not SPRING.has(type):
+		return 0.0
+	var sp: Array = SPRING[type]
+	var f: float = sp[3]
+	var a: float = sp[4]
+	a += 0.16 * sin(t * TAU * f * 0.9 + id * 1.7)            # 待機微擺（每隻相位不同）
+	a += 0.22 * walk * sin(t * TAU * f * 2.2 + id)           # 走路晃
+	a += lean * 1.6                                          # 往前衝，配件往後拖（延遲）
+	if at > 0.0:
+		a += 0.35 * sin(clampf(at, 0.0, 1.0) * PI) * (1.0 if type != 0 else -1.0)   # 出手時甩一下再回彈
+	return a
+
+func _spring_acc(p: Vector2, type: int, team: int, face: float, scale: float, crouch: float, lean: float, walk: float, at: float, alpha: float, id: int) -> void:
+	if not SPRING.has(type) or bool(Save.s("plain_ui")) or alpha < 0.5:
+		return
+	var sp: Array = SPRING[type]
+	var ang := spring_angle(type, time if not bool(Save.s("reduce_motion")) else 0.0, walk, lean, at, id)
+	var col: Color = PAL.TRINKET_RED if sp[5] == "red" else (PAL.TRINKET_GOLD if sp[5] == "gold" else Art.team_color(team, cbm()).darkened(0.25))
+	# 單位座標 → 盤面座標自己算（翻面、縮放、前傾），不切換矩陣（合批，切片 B 量測）
+	var fx := -1.0 if face < 0.0 else 1.0
+	var xf := Transform2D(lean * fx, Vector2(scale * fx, scale * crouch), 0.0, p)
+	var a0: Vector2 = sp[0]
+	var d := Vector2(sin(ang), cos(ang)) * float(sp[1])
+	var mid := a0 + d * 0.5 + Vector2(cos(ang), -sin(ang)) * 2.0
+	var pts := PackedVector2Array([xf * a0, xf * mid, xf * (a0 + d)])
+	draw_polyline(pts, Color(Art.OUT, alpha), (float(sp[2]) + 2.0) * scale, false)
+	draw_polyline(pts, Color(col, alpha), float(sp[2]) * scale, false)
diff --git a/game/scripts/ui/battle_view.gd b/game/scripts/ui/battle_view.gd
index d264bbd..1957bee 100644
--- a/game/scripts/ui/battle_view.gd
+++ b/game/scripts/ui/battle_view.gd
@@ -469,7 +469,9 @@ func _cmd_event(ev: Dictionary, with_fx: bool) -> void:
 		return
 	sfx.play(["brace", "bugle", "raise", "stomp", "timestop"][sk], 0.9)
 	fx = fx.filter(func(f): return f.get("cmd_tm", -1) != tm)     # 一隊同時只留最新一條，不疊字
-	_fx_text(Vector2(400.0 if tm == 0 else 880.0, 128), "%s　%s" % [L.t("blue") if tm == 0 else L.t("red"), L.t("cmd_%d" % sk)], Art.team_color(tm, cbm()).lightened(0.45), 1.3, tz("H2"), true)   # V1.0.0：0.25 時紅方在動態戰場上對比偶爾 < 3
+	_fx_text(Vector2(400.0 if tm == 0 else 880.0, 128), "%s　%s" % [L.t("blue") if tm == 0 else L.t("red"), L.t("cmd_%d" % sk)], Art.team_color(tm, cbm()).lightened(0.45), 1.3, tz("B"), true)   # V1.0.0：0.25 時紅方在動態戰場上對比偶爾 < 3；1.4.0 §6.3：大字橫幅降一級，主角是桌面朱印
+	if not bool(Save.s("plain_ui")):
+		_add_fx({"kind": "cmdseal", "p": ORIGIN + fld_size * Vector2(0.25 if tm == 0 else 0.75, 0.5), "t": 0.0, "dur": 0.9, "c": Art.team_color(tm, cbm()).darkened(0.15)})
 	fx[-1]["cmd_tm"] = tm
 	if _fx_on("flash"):
 		_add_fx({"kind": "cmd_flash", "t": 0.0, "dur": 0.35, "screen": true, "c": Color("#7fd3ff") if sk == CmdD.FREEZE else (Color("#fff0b0") if sk != CmdD.METEOR else Color("#ff8a3c"))})
@@ -583,6 +585,7 @@ func _on_event(ev: Dictionary, with_fx: bool) -> void:
 		if hs0 != null and ht0 != null:
 			_merge_text(ht0.id, EV.HEAL, "+", int(ev["amt"]), _upos(ht0) + Vector2(0, -70), Color("#7dff8a"))
 			_add_fx({"kind": "healring", "p": _upos(ht0) + Vector2(0, 2), "t": 0.0, "dur": 0.35})   # 1.1.0 A7：被補的友軍腳下淡綠藥膏環（≤0.3 格）
+			_add_fx({"kind": "leaves", "p": _upos(ht0) + Vector2(0, -10), "t": 0.0, "dur": 0.6})   # 1.4.0 §6.2 草葉旋升
 			sfx.play("heal", 0.35)
 			if _frags_on():
 				frags.spawn(_upos(ht0), "leaf", 2, view.tick * 4096 + ht0.id, 30.0)   # 1.2.0 §8.2 薄荷葉片
@@ -678,6 +681,9 @@ func _on_event(ev: Dictionary, with_fx: bool) -> void:
 		EV.CHARGE:
 			label = L.t("ev_charge")
 			col = ACCENT
+			_add_fx({"kind": "windtrail", "p": sp, "dir": signf(tpos.x - sp.x) if tpos.x != sp.x else 1.0, "t": 0.0, "dur": 0.5})   # 1.4.0 §6.2 地面風痕
+			_hitstop_weight(2)   # 1.4.0 §6.5 重擊頓一下
+			_dir_hot(tpos)       # 1.4.0 §6.4 重播導播推近
 			sfx.play("charge")
 			sfx.play("bugle", 0.6)
 			if _fx_on("shake"):
@@ -1029,6 +1035,10 @@ func _dir_on() -> bool:
 
 func _director_cam(delta: float) -> void:
 	var fc := ORIGIN + fld_size / 2
+	if time < dir_hot_until and not view.finished:
+		zoom_target = 1.35
+		zoom_center = zoom_center.lerp(dir_hot_p, minf(1.0, delta * 3.0))
+		return
 	var r: Array = DirR.director_target(view.tick, view.finished, spot_p, spot_n, fc, fld_size.x)
 	zoom_target = float(r[0])
 	zoom_center = zoom_center.lerp(r[1], minf(1.0, delta * (4.0 if view.tick < DirR.TOUR_TICKS else 1.5)))
@@ -1377,3 +1387,21 @@ func _draw_intro() -> void:
 # ── 1.4.0 第 2 大類：棋鐘木活字 ──
 var clock_last := -1
 var clock_flip_t := -10.0
+
+
+# ── 1.4.0 第 7 大類：技能演出 3.0（方案 §6）──
+## 頓幀依重量：固定呈現時間（輕 0、中 30ms、重 60ms），不是幀數；只停畫面時鐘（展示時鐘補回）。減少動態、截圖不頓。
+const HITSTOP_W := [0.0, 0.03, 0.06]
+func _hitstop_weight(w: int) -> void:
+	if bool(Save.s("reduce_motion")) or shot_dir != "" or w <= 0:
+		return
+	hitstop = maxf(hitstop, HITSTOP_W[clampi(w, 0, 2)])
+
+## 招牌推近：只在重播／觀戰的自動導播（實戰、玩家操作中的觀戰都不推）；0.6 秒。
+var dir_hot_p := Vector2.ZERO
+var dir_hot_until := -1.0
+func _dir_hot(p: Vector2) -> void:
+	if not _dir_on():
+		return
+	dir_hot_p = p
+	dir_hot_until = time + 0.6
