+# ── 1.4.0 第 4 大類：謝幕（方案 §8）──
+## 系列結束（或單場的對 AI／雙人）才有三枚木印章：MVP、最大輸出、中流砥柱（承受最多傷害還站著的）。回傳 [[圖示, 標題鍵, 兵種, 數值], …]。
+func _res_seals() -> Array:
+	if sim == null or not (mode == Mode.VS_AI or mode == Mode.DUEL) or not series_over or watch_mode:
+		return []
+	var best_d = null
+	var best_t = null
+	for u in sim.units:
+		if u.team != 0 or u.summon:
+			continue
+		if best_d == null or u.dmg_dealt > best_d.dmg_dealt:
+			best_d = u
+		if u.alive and (best_t == null or u.dmg_taken > best_t.dmg_taken):
+			best_t = u
+	var out: Array = []
+	var mvp = report.get("mvp")
+	if mvp != null:
+		out.append(["trophy", "seal_mvp", int(mvp.type), int(mvp.dmg_dealt)])
+	if best_d != null:
+		out.append(["swords", "seal_dmg", int(best_d.type), int(best_d.dmg_dealt)])
+	if best_t != null and int(best_t.dmg_taken) > 0:
+		out.append(["shield", "seal_tank", int(best_t.type), int(best_t.dmg_taken)])
+	return out
+
+func _draw_res_seals(mr: Rect2, seals: Array) -> void:
