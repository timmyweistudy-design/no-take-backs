+		draw_circle(c, rr, PAL.WOOD_TYPE, true, -1.0, true)
+		draw_arc(c, rr - 3.0, 0, TAU, 32, Color(PAL.TRINKET_RED, 0.75), 2.0, true)   # 印面一圈朱砂（邊緣微滲）
+		_icon(str(seals[k][0]), c, 22.0, PAL.TRINKET_RED.darkened(0.1))
+		var sk: Array = seals[k]
+		_btns.append({"r": Rect2(c - Vector2(rr, rr), Vector2(rr, rr) * 2.0), "cb": func(): _toast(L.t(str(sk[1]), [L.t("unit_%d" % int(sk[2])), int(sk[3])])), "en": true})
