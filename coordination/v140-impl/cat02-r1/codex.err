   722		var by := g0.y + 9 * cs + 8
   723		_text(Vector2(g0.x, by), L.t("rv_budget", [rv_army.spent(), rv_army.budget, review_changes(rv_orig, rv_army)]), tz("S"), Color.WHITE, false, false, 420)
   724		var dsc := review_desc()
   725		if dsc != "":
   726			_text(Vector2(g0.x, by + tz("S") * 1.4), dsc, tz("S"), ACCENT, false, false, 420)
   727		# 右：換成哪個兵種（頭像＋價錢）／拿掉
   728		var bx := 580.0
   729		var nt: int = call("_ntypes") if has_method("_ntypes") else D.COUNT
   730		var ph := price_cell_h()   # 1.4.0 R12：價錢子格高＝墨跡＋上下內距；按鈕跟著長高、下面幾列一起往下
   731		var bh := maxf(66.0, 35.0 + ph + 5.0)
   732		var sh := bh - 66.0
