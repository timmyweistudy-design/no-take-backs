   173	func _seek_finish() -> void:
   174		if sfx != null and sfx.has_method("reseed"):
   175			sfx.reseed(sfx.seed_at(round_no, view.tick if view != null else 0))   # 1.3.0 §10：跳轉後音效變體從同一個狀態開始
   176		call_deferred("_tm_sync")
   177		var target := _seek_target_now
   178		var keep_ct := _seek_ct
   179		var had_clutch := keep_ct >= 0
   180		view = ViewBuffer.new(sim)
   181		prev_pos.clear()
   182		_gait_reset()
   183		for u in view.units:
   184			prev_pos[u.id] = Vector2(u.x, u.y)
   185		fx.clear()
   345						_toast(L.t("bc_demo_locked"), true)
   346						return
   347		if r["mismatch"]:
   348			_toast(L.t("bc_mismatch"))
   349		last_cmds = r.get("cmds", [])
   350		watch_code(r["a0"], r["a1"], r.get("rules"))
