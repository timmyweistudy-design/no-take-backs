   115					ui.draw_line(Vector2(px2, cy + 6), Vector2(px2, cy + 9), Color(1, 1, 1, 0.35), 1.5)
   116		elif values.has(me):
   117			var pm := lx + lw * (float(values[me]) - mn) / span
   118			ui.draw_line(Vector2(lx, cy), Vector2(pm, cy), accent, 4.0)
   119			ui.draw_circle(Vector2(pm, cy), 7.0, accent)
