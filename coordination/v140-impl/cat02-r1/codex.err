    25	static func hatch(ui: CanvasItem, r: Rect2, c: Color) -> void:
    26		var step := 7.0
    27		var x := r.position.x - r.size.y
    28		while x < r.end.x:
    29			var a := Vector2(maxf(x, r.position.x), r.position.y + maxf(0.0, r.position.x - x))
    30			var b := Vector2(minf(x + r.size.y, r.end.x), r.position.y + minf(r.size.y, r.end.x - x))
    31			if a.x < b.x:
    32				ui.draw_line(Vector2(a.x, r.end.y - (a.y - r.position.y)), Vector2(b.x, r.end.y - (b.y - r.position.y)), c, 1.5)
    33			x += step
