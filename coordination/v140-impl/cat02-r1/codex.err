   162	func _lobby_save_preset() -> void:
   163		var ps: Array = Save.data.get("rule_presets", [])
   164		if ps.size() >= Save.MAX_PRESETS:
   165			_toast(L.t("lb_full", [Save.MAX_PRESETS]), true)   # V1.5：滿了不偷偷蓋掉最舊的，請玩家先刪
   166			lobby_menu = true
   167			return
   168		var used := {}
   169		for e in ps:
   170			used[str(e["name"])] = true
   171		var k := 1
   172		while used.has(L.t("lb_my_n", [k])):
   173			k += 1   # 刪過中間那格也不會撞名
   174		var nm := L.t("lb_my_n", [k])
   175		ps.append({"name": nm, "code": lobby_r.to_code()})
