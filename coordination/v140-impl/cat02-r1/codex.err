    35	## 中線對比長條：rows＝[{label, b, r}]；兵種名在中間，藍往左、紅往右，數字標在條尾。
    36	static func diverging(ui, rect: Rect2, rows: Array, mid_w := 110.0) -> void:
    37		var cb: bool = ui.cbm()
    38		var maxv := 1
    39		for row in rows:
    40			maxv = maxi(maxv, maxi(int(row["b"]), int(row["r"])))
    41		var n := maxi(1, rows.size())
    42		var rh := rect.size.y / n
    43		# V1.2.1：中間兵種名欄依最長的名字算寬（英文 150% 的 Shieldbearer 原本被長條和數字蓋住）
    44		for row in rows:
    45			mid_w = maxf(mid_w, ui._width(str(row["label"]), ui.tz("S")) + (40.0 if row.has("type") else 16.0))
    46		mid_w = minf(mid_w, rect.size.x * 0.4)
    47		var half := (rect.size.x - mid_w) / 2.0
    48		var cx := rect.position.x + half
    49		var fs: int = ui.tz("S")
    50		# V1.2.1：最長的條也要在條尾外留出數字的位置（原本滿格時數字被夾進條內，和其他列不一致）
    51		var lab_w: float = ui._width(str(maxv), fs) + 8.0
    52		var bar_half := maxf(20.0, half - lab_w)
    53		for i in rows.size():
    54			var row: Dictionary = rows[i]
    55			var y := rect.position.y + i * rh
    56			var bh := minf(rh * 0.62, 22.0)
    57			var by := y + (rh - bh) / 2
    58			if row.has("type"):
    59				ui._unit_in(Rect2(cx, y, 28.0, rh), int(row["type"]), 0, 1.0, minf(0.42, rh / 80.0))   # 兵種頭像（V9）
    60			ui._text(Vector2(cx + mid_w / 2 + (12.0 if row.has("type") else 0.0), y + (rh - fs * 1.1) / 2), str(row["label"]), fs, Color.WHITE, true, false, mid_w - 6)
    61			var lb := bar_half * float(row["b"]) / maxv
    62			var lr := bar_half * float(row["r"]) / maxv
    63			ui.draw_rect(Rect2(cx - lb, by, lb, bh), team_col(0, cb))
    64			var rr := Rect2(cx + mid_w, by, lr, bh)
    65			ui.draw_rect(rr, team_col(1, cb))
    66			if cb:
    67				hatch(ui, rr, Color(0, 0, 0, 0.35))
    68			var vb := str(int(row["b"]))
    69			var vr := str(int(row["r"]))
    70			var wb: float = ui._width(vb, fs)
    71			ui._text(Vector2(cx - lb - wb - 6, y + (rh - fs * 1.1) / 2), vb, fs, MUTED)
    72			ui._text(Vector2(cx + mid_w + lr + 6, y + (rh - fs * 1.1) / 2), vr, fs, MUTED)
