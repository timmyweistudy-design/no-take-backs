   825	# ── 1.4.0 第 4 大類：謝幕（方案 §8）──
   826	## 系列結束（或單場的對 AI／雙人）才有三枚木印章：MVP、最大輸出、中流砥柱（承受最多傷害還站著的）。回傳 [[圖示, 標題鍵, 兵種, 數值], …]。
   827	func _res_seals() -> Array:
   828		if sim == null or not (mode == Mode.VS_AI or mode == Mode.DUEL) or not series_over or watch_mode:
   829			return []
   830		var best_d = null
   831		var best_t = null
   832		for u in sim.units:
   833			if u.team != 0 or u.summon:
   834				continue
   835			if best_d == null or u.dmg_dealt > best_d.dmg_dealt:
   836				best_d = u
   837			if u.alive and (best_t == null or u.dmg_taken > best_t.dmg_taken):
   838				best_t = u
   839		var out: Array = []
   840		var mvp = report.get("mvp")
   841		if mvp != null:
   842			out.append(["trophy", "seal_mvp", int(mvp.type), int(mvp.dmg_dealt)])
   843		if best_d != null:
   844			out.append(["swords", "seal_dmg", int(best_d.type), int(best_d.dmg_dealt)])
   845		if best_t != null and int(best_t.dmg_taken) > 0:
   846			out.append(["shield", "seal_tank", int(best_t.type), int(best_t.dmg_taken)])
   847		return out
