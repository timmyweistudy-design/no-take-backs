   132	func _seek_begin(target: int) -> void:
   133		cues.clear()       # 1.3.0 §7.1：跳轉清掉預告（不留舊時間線的未來事件；Codex cat06 #2）
   134		stat_prev.clear()
   135		var armies2: Array = rv_last if play_kind == "review" and not rv_last.is_empty() else last_armies
   136		sim = Sim.new(armies2[0].copy(), armies2[1].copy(), battle_rules)
   137		call("_cmd_setup", sim, play_kind)
   138		ev_count = {}
   139		set("last_blast_tick", -99)
   140		_seek_ct = -1
   141		_seek_deaths = {}
   142		battle_marks.clear()
   143		var dl: int = ViewBuffer.DELAY if (bool(sim.get("cmd_on")) and not bool(sim.get("cmd_scripted"))) else ViewBuffer.DELAY_LONG   # 和 ViewBuffer 的選法一樣
   144		_seek_stop = maxi(0, target - (view.delay if view != null else dl))
   145		_seek_target_now = target
   146	
   147	var _seek_target_now := 0
   148	var _seek_deaths := {}   # V1.5.1 B2：快轉時誰在哪個 tick 倒下（跳轉後重建陣亡小旗）
   149	
   150	## 算到時間用完或到達目標；到達回傳 true。
   151	func _seek_tick(budget_ms: int) -> bool:
   152		var t0 := Time.get_ticks_msec()
   153		while sim.tick < _seek_stop and not sim.finished:
   154			if Time.get_ticks_msec() - t0 >= budget_ms:
   155				return false
   156			sim.step()
   157			for ev in sim.events:   # 快轉時也要累計戰報次數與時間軸標記（Codex S5 #4：共用同一個收集函式）
   158				if ev.has("src"):
   159					var s = sim.unit_by_id(ev["src"])
   160					var key := "%s%d" % [ev["kind"], s.team]
   161					ev_count[key] = int(ev_count.get(key, 0)) + 1
   162					if ev["kind"] == EV.BLAST and not ev.has("dmg"):
   163						ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
   164				_collect_mark(ev, sim, sim.tick)
   165				if ev["kind"] == EV.DEATH:
   166					_seek_deaths[int(ev["id"])] = sim.tick
   167				if ev["kind"] == EV.CMD:
   168					battle_marks.append({"tick": sim.tick, "kind": "cmd", "team": int(ev["team"]), "skill": int(ev["skill"])})   # V1.5.1：快轉也收軍令標記（原本跳轉後會漏）
   169			if _seek_ct < 0 and not sim.finished and clutch_cond(sim):
   170				_seek_ct = sim.tick
   171		return true
