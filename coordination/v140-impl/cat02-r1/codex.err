   873	## 開一場戰鬥（S8 從 game_screens 移下來：重播、覆盤、截圖都會用到）
   874	func _begin_battle(a0, a1, kind := "official") -> void:
   875		nav_stack.clear()   # V1.5.1：開戰後，之前的返回堆疊作廢
   876		_pre_drop()
   877		play_kind = kind
   878		tm_ghost = null   # V1.4 #1：時光機的原本時間線只在「如果」播放時存在（_rv_play 之後會再設）
   879		_ensure_sprites([a0, a1])
   880		if kind == "official":
   881			last_armies = [a0.copy(), a1.copy()]
   882			battle_rules = rules.copy() if rules != null else _puzzle_rules()   # 第十三輪：殘局自帶規則
   883		sim = Sim.new(a0, a1, battle_rules)
   884		_cmd_setup(sim, kind)
   885		view = ViewBuffer.new(sim)
   886		atk_seq.clear()
   887		clutch_tick = -1
   888		replay_total = 0
   889		if kind != "official":
   890			# 重播／覆盤：先用確定性模擬算出整場長度，時間軸以實際秒數為滿（Antigravity S5）
   891			var pa0 = a0.copy()
   892			var pa1 = a1.copy()
   893			var pr = battle_rules.copy() if battle_rules != null else null
   894			var plog: Array = last_cmds.duplicate(true)
   895			replay_bm = []
   896			var run_pre := func() -> Array:
   897				var pre = Sim.new(pa0, pa1, pr)
   898				if pre.cmd_on:
   899					pre.cmd_play(plog)
   900				pre.fast = true
   901				var bm: Array = []
   902				while not pre.finished:
   903					pre.step()
   904					BM.collect(pre, bm)   # 1.2.0 §11.2：預跑順手收書籤（不多跑一次模擬）
   905				return [pre.tick, bm]
   906			if _async_ok():
   907				pre_thread = Thread.new()
   908				pre_thread.start(run_pre)
   909			else:
   910				var pv: Array = run_pre.call()
   911				replay_total = int(pv[0])
   912				replay_bm = pv[1]
   913		paused = false
