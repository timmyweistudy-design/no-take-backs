   774	## V1.4 #1：原本那條時間線（同一組敵陣、原本的我方陣、同樣的軍令紀錄），從頭建一份。
   775	func _tm_new_ghost() -> void:
   776		tm_ghost = Sim.new(rv_orig.copy(), rv_enemy.copy(), battle_rules)
   777		if tm_ghost.cmd_on:
   778			tm_ghost.cmd_play(last_cmds)
   779		tm_ghost.fast = true
   780	
   781	## 讓原本的時間線跟上畫面上的 tick；跳回較早的時間就重建再追（模擬是確定性的，追到同一 tick 狀態一樣）。
   782	func _tm_sync() -> void:
   783		if tm_ghost == null or view == null:
   784			return
   785		if tm_ghost.tick > view.tick:
   786			_tm_new_ghost()
   787		var guard := 0
   788		while tm_ghost.tick < view.tick and not tm_ghost.finished and guard < 20000:
   789			tm_ghost.step()
   790			guard += 1
   791	
   792	## V1.4 #1：在走勢圖上畫分岔點（墨色虛線＋小三角）。
   793	func _rv_div_mark(r: Rect2, span: int) -> void:
   794		if rv_div < 0 or span <= 0:
   795			return
   796		var x := r.position.x + r.size.x * clampf(float(rv_div) / float(span), 0.0, 1.0)
   797		_chalk_line(Vector2(x, r.position.y - 2), Vector2(x, r.end.y + 2), Color("#ffd166"), 2.6, 6.0)
   798		# 1.4.0 §8.3 批註本：分岔點在兩條墨線上各用硃筆圈一下
   799		if not bool(Save.s("plain_ui")):
   800			var chh := (r.size.y - tz("S") * 1.5 - 12.0) * 0.5
   801			for cy in [r.position.y + chh * 0.5, r.end.y - chh * 0.5]:
   802				draw_arc(Vector2(x, cy), 11.0, 0.4, TAU - 0.3, 24, Color(1, 0.9, 0.75, 0.4), 4.0, true)
   803				draw_arc(Vector2(x, cy), 11.0, 0.4, TAU - 0.3, 24, Color(PAL.TRINKET_RED, 0.9), 2.2, true)
   804		draw_colored_polygon(PackedVector2Array([Vector2(x - 5, r.position.y - 8), Vector2(x + 5, r.position.y - 8), Vector2(x, r.position.y - 1)]), ACCENT)
   805	
   806	func _rv_has_sel() -> bool:
   807		if rv_orig.deploy == "free":
   808			return rv_fsel >= 0 and rv_fsel < rv_army.units.size()
   809		return rv_sel.x >= 0
   810	
   811	## 第六輪：自由陣型的小戰場。一般＝左邊自己的部署區（可點）＋右邊紅方部署區（小、只看）；
   812	## 全場＝整個戰場一張圖，兩隊都畫。原位置留半透明殘影＋虛線，看得出搬了多遠。
   813	var _rv_map := {}   # 自己這張圖的 {o: 左上, s: 每單位幾像素}
   814	
   815	func _rv_free_board(g0: Vector2) -> void:
   800		# 色盲配色的亮橘底用深色字（對比 ≥7:1）
   801		var lc := Color.WHITE
   802		_text(Vector2(bx + 8, 42), L.t("hud_power", [roundi(p0 * 100.0 / (view.budget_of(0) * 1000))]), ts(15), lc, false, true)
   803		var rt: String = L.t("hud_power", [roundi(p1 * 100.0 / (view.budget_of(1) * 1000))])
   804		var rtw := font_bold.get_string_size(rt, HORIZONTAL_ALIGNMENT_LEFT, -1, ts(15)).x
   805		# V1.2.1 F5：深色字只在字底下真的是亮橘條時用；紅方戰力低、字底下是藍條或空槽時改白字描邊
   806		var on_orange: bool = cbm() and state == St.BATTLE and split <= bw - 8.0 - rtw - 4.0   # 結果頁有暗幕，深字不清楚
   807		var rc := Color("#141820") if on_orange else Color.WHITE
   808		_text(Vector2(bx + bw - 8 - rtw, 42), rt, ts(15), rc, false, true, 0.0, Color(1, 1, 1, 0.0) if on_orange else Color(0, 0, 0, -1))   # 深色字不加黑描邊（Antigravity S2 #1）
   809		# 第八輪：生兵戰力 0（時間到不灌水），隻數用「本隊＋召喚」講清楚
   810		var sn := [0, 0]
   811		for su in view.units:
   812			if su.alive and su.summon:
   813				sn[su.team] += 1
   814		for tm0 in 2:
   815			var cnt0: int = view.alive_count(tm0) - sn[tm0]
   816			var lb0: String = L.t("units_left", [cnt0]) if sn[tm0] == 0 else "%s＋%d" % [L.t("units_left", [cnt0]), sn[tm0]]
   817			# 左邊靠條尾對齊、右邊靠條頭對齊，留出火焰位置；不限寬（大字級「8 隻＋1」不換行）
   818			var lb_w: float = font_bold.get_string_size(lb0, HORIZONTAL_ALIGNMENT_LEFT, -1, ts(15)).x
   819			if tm0 == 0 and lb_w > bx - 22.0 - HUD_LEFT_END and sn[tm0] > 0:   # 英文大字級擠不下就只留數字，別撞到左上的比分
   820				lb0 = "%d＋%d" % [cnt0, sn[tm0]]
   821				lb_w = font_bold.get_string_size(lb0, HORIZONTAL_ALIGNMENT_LEFT, -1, ts(15)).x
   822			_text(Vector2(bx - 22 - lb_w if tm0 == 0 else bx + bw + 22, 42), lb0, ts(15), _legible(Art.team_color(tm0, cbm())))   # 1.3.0：150% 時字 ≥19 粗體不會自動提亮，這裡手動過一次（4.48 → ≥4.5）
   823		for tm in 2:
   824			if view.rally[tm] and not view.finished:
   825				var rx := bx - 70.0 if tm == 0 else bx + bw + 12.0
   826				_text(Vector2(rx, 66), L.t("rally"), ts(13), Color(1, 0.55 + 0.2 * sin(time * 8), 0.3), false, true)
   827		var secs := maxi(0, (view.max_ticks - view.tick + 19) / 20)   # 第五輪：一局時間可調（原本寫死 90 秒）
   828		var clock_s: String = L.t("secs", [secs]) + ("　" + L.t("frenzy") if view.frenzy else "")
   829		if craft_hud and state == St.BATTLE:
   830			# 1.2.0 §5.6 棋鐘：淺色木盒＋頂上黃銅按鈕，字用深墨（狂熱時深紅）。木盒是平塗＋邊線（不是九宮格：大字級時字會壓到九宮格邊）；
   831			# 結果頁有暗幕，棋鐘回到原本的白字（深字在暗幕下看不清）
   832			var cw0 := maxf(170.0, _width(clock_s, ts(22), true) + 40.0)
   833			var cr := Rect2(640 - cw0 / 2, 1, cw0, maxf(32.0, ts(22) * 1.12))   # 第 11 大類：150% 時原本 ×1.3 的盒子蓋到戰力尺中央刻度，收緊到字高
   834			draw_rect(Rect2(cr.position + Vector2(3, 3), cr.size), Color(DIM_INK, 0.5))
   835			draw_rect(cr, Color("#e9d9b8"))
   836			draw_rect(Rect2(cr.position, Vector2(cr.size.x, 3)), Color(1, 0.97, 0.88, 0.7))
   837			draw_rect(cr, Color("#5a3a22"), false, 2.0)
   838			draw_rect(cr.grow(-4), Color("#8a6a48", 0.7), false, 1.0)   # 最後一輪（Codex 看圖 #6）：鐘面內框，像有厚度的木盒
