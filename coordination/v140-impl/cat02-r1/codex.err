   858			_btns.append({"r": Rect2(c - Vector2(rr, rr), Vector2(rr, rr) * 2.0), "cb": func(): _toast(L.t(str(sk[1]), [L.t("unit_%d" % int(sk[2])), int(sk[3])])), "en": true})
