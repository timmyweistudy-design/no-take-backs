+## 印章冊：第幾頁、這頁蓋了幾格（10 的倍數＝這頁剛好蓋滿，不跳到空白新頁）
+const STAMP_PER_PAGE := 10
+static func stamp_page(n: int) -> Array:
+	if n <= 0:
+		return [1, 0]
+	return [(n - 1) / STAMP_PER_PAGE + 1, (n - 1) % STAMP_PER_PAGE + 1]
