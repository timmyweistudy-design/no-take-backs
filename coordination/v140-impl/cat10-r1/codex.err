func _process_inner(delta: float) -> void:
	if shot_dir != "" and bool(get("shot_fixed")):
		delta = 1.0 / 60.0   # 1.2.0 §14.6：視覺回歸模式（--shot-fixed）用固定幀時間；一般版面檢查照真實時間（Codex cat01 #6）
	_touch_tick(delta)
	_pad_clear_tick()
	_stick_repeat(delta)
	_process_cmds()
	time += delta
	call("_gif_tick", delta)   # V1.4 #14
	if paused and key_t > 0.0:
		key_t += delta
	if paused and float(last_kill[1]) > 0.0:
		last_kill[1] = float(last_kill[1]) + delta   # 暫停時定格與歡呼波浪也凍結   # V1.3 C4：暫停時關鍵時刻的演出凍結（Codex v130-impl2）
	SteamApi.run_callbacks()
	if toast_t > 0:
		toast_t -= delta
	# V1.5：手把震動跟著鏡頭震動（強度可調、0 關掉；只在用手把時）
	if shake > rumble_seen + 0.05 and pad_mode and int(Save.s("rumble")) > 0:
		var rk: float = clampf(shake * 4.0, 0.2, 1.0) * int(Save.s("rumble")) / 100.0
		Input.start_joy_vibration(last_joy, 0.3 * rk, 0.6 * rk, 0.18)
	rumble_seen = shake
	if removed_banner_t > 0.0:
		removed_banner_t -= delta
	if ach_t > 0:
		ach_t -= delta
	elif not ach_queue.is_empty():
		toast = ach_queue.pop_front()
		toast_t = 2.5
		ach_t = 2.6
	shake = maxf(0.0, shake - delta)
	if not freeze_fx:
		for f in fx:
			f["t"] += delta
			if f.has("pop"):
				f["pop"] = maxf(0.0, f["pop"] - delta)
		fx = fx.filter(func(f): return f["t"] < f["dur"])
		if _frags_on():
			frags.step(delta)
		else:
			frags.clear()   # 戰鬥中切減少特效／簡化／4 倍速：舊碎片也收掉（Codex cat09 #3）
		clutch_t = maxf(0.0, clutch_t - delta)
	for g in dying:
		var t0: float = g["t"]
		g["t"] += delta
		if t0 < 1.0 and g["t"] >= 1.0:   # 只在跨過 1 秒那一幀插旗（倒棋留 1.7 秒，Codex v130-impl1）
			graves.append({"pos": g["pos"], "team": g["team"], "t": 0.0})
	dying = dying.filter(func(g): return g["t"] < death_life(int(g["type"])))   # V1.3 A5：倒棋留 1.7 秒
	for g in graves:
		g["t"] += delta
	graves = graves.filter(func(g): return g["t"] < 3.0)
	if overlay == "codex":
		_codex_tick(delta)
	if overlay == "ai_busy":
		_ai_poll()
	if not pre_old.is_empty():
		_pre_reap()
	if state == St.TITLE and demo != null and shot_dir == "" and Save.s("title_bg") == "demo" and not bool(Save.s("reduce_motion")):   # V1.5：主畫面背景可改靜態
		demo_acc += delta
		while demo_acc >= 0.05:
			demo_acc -= 0.05
			demo.step()
		if demo.finished:
			_new_demo()
	if state == St.BATTLE and shot_dir == "":
		_battle_process(delta)
		_follow_update(delta)
	elif state == St.RESULT:
		zoom = lerpf(zoom, 1.0, delta * 4)
	if font_bold != null:
		_layout_texts()   # 戰鬥事件產生跳字之後才排版，新跳字第一幀就有位置（Codex S1 #3）
	queue_redraw()



# ───────────────────────── 繪圖 ─────────────────────────
func _draw() -> void:
	mag_on = bool(Save.s("magnify"))   # V1.6 #7；V1.6.1 F4：手把也能用（指焦點按鈕上的字）
	mag_hit = []
	var _t0 := Time.get_ticks_usec()
	_draw_inner()
	if i < 0 or i >= gs.size():
		return
	var r = RuleSet.standard()
	r.rounds = 1
	rules = r
	challenge_army = ghost_army(gs[i])
	overlay = ""
	set("daily_spec", {})   # Codex v140-i5：不能沿用每日挑戰的狀態
	_start_mode(Mode.VS_AI)
	set("daily_spec", {})
	challenge_army = ghost_army(gs[i])
	ghost_id = str(gs[i]["id"])
	_toast(L.t("gh_toast", [L.field(gs[i], "")]))

var wk_spec := {}   # 開題當下的題目（跨週一才打完也算開題那一週，Codex、Antigravity v140-i5）

func _weekly_start() -> void:
	var sp := weekly_spec(week_no(int(Time.get_unix_time_from_system())))
	wk_spec = sp
	var gs := ghosts()
	if gs.is_empty():
		return
	var r = RuleSet.standard()
	r.rounds = 1
	r.pool = [int(sp["pool"]), RuleSet.all_pool()]
	r.ai_pool_same = false
	r.handicap = true
	r.budget = [int(sp["budget"]), 100]
	rules = r
	challenge_army = ghost_army(gs[int(sp["ghost"])])
	overlay = ""
	set("daily_spec", {})
	_start_mode(Mode.VS_AI)
	set("daily_spec", {})
	challenge_army = ghost_army(gs[int(sp["ghost"])])
	wk_active = true
	_toast(L.t("wk_toast", [int(sp["budget"])]))

## 戰鬥結束（正式局）呼叫一次：記幽靈戰果、每週最少花費。
func _ghost_settle(w: int) -> void:
	if mode != Mode.VS_AI or play_kind != "official":
		return
	if ghost_id != "" and w == 0:
		var beat: Array = Save.data.get("ghost_beat", [])
		if not ghost_id in beat:
			beat.append(ghost_id)
