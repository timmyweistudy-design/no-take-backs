# ── 第十二輪手動技能 ──
func _cmd_setup(s, kind: String) -> void:
	if not s.cmd_on:
		return
	if kind == "official" and mode == Mode.PUZZLE:
		s.cmd_play(PZ.cmd_log(PZ.get_puzzle(puzzle_id), puzzle_plan))   # 第十三輪：時序殘局照戰前設定的時間放
	elif kind == "official":
		s.cmd_auto = [false, mode == Mode.VS_AI]
	else:
		s.cmd_play(last_cmds)

## 按第 slot 格（這一隊帶的第幾招）。成功回 true。
func _cmd_press(team: int, slot: int) -> bool:
	if sim == null or not sim.cmd_on or play_kind != "official" or sim.finished or mode == Mode.PUZZLE:
		return false
	if team == 1 and mode != Mode.DUEL:
		return false
	var list: Array = CmdD.list_of(int(sim.cmd_mask[team]))
	if slot >= list.size():
		return false
	if sim.cast(team, int(list[slot])):
		sfx.play("k_confirm", 0.8)
		return true
	sfx.play("k_error", 0.7)
	return false

	report["leads"] = leads
	# 殘局星等算在報告裡（重播也看得到），只有「寫進存檔」才受副作用矩陣管（Codex S1 #8）
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
		var pz := PZ.get_puzzle(puzzle_id)
		var extra_spent: int = armies[0].spent() - (armies[0].budget - int(pz["budget"]))
		var oc := PZ.outcome(pz, sim, extra_spent)   # 第十三輪：和工具、測試同一套判定（含護送、撐住、斬首）
		report["stars"] = int(oc["stars"])
		report["goal_ok"] = bool(oc["ok"])
		report["star_lines"] = _star_lines(bool(oc["ok"]), int(oc["rem"]), int(pz["star2"]), extra_spent, int(pz["star3"]), _goal_text(pz))



func _progress_and_achievements() -> void:
	var w: int = sim.winner
	# 第五輪：紀錄分欄。平衡認證的規則（或沒有規則的模式）＝標準戰績；其他自訂規則記在自訂戰績；沙盒什麼都不記。
	var kind := "duel" if mode == Mode.DUEL else "ai"
	var badge: String = Presets.badge(rules, kind) if rules != null else Presets.BADGE_CERT
	if badge == Presets.BADGE_LAB:
		_save()
		return
	var standard: bool = rules == null or Presets.is_standard_record(rules, kind)
	if free_intro:
		Save.data["free_intro_done"] = true
		free_intro = false
	Save.data["unlock_games"] = int(Save.data.get("unlock_games", 0)) + 1   # 只是累計場數（判斷新玩家用），不解鎖任何東西
	var me_won := w == 0 or (mode == Mode.DUEL and w >= 0)

