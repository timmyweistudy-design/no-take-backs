func _check_end() -> void:
	if v8 and not _pending_blast.is_empty() and tick < max_ticks:
		return   # 第八輪：還有羊在下一 tick 才爆，先別判勝負（Codex 第八輪 r1）
	var a0 := alive_count(0)
	var a1 := alive_count(1)
	if a0 == 0 and a1 == 0:
		_finish(-1, "同時全滅")
	elif a1 == 0:
		_finish(0, "全滅")
	elif a0 == 0:
		_finish(1, "全滅")
	elif tick >= max_ticks:
		var p0 := power(0)
		var p1 := power(1)
		if judge == 2:
			# 讓子：比「剩餘戰力占自己預算」；整數交叉相乘避免截斷（Codex 第一輪）
			var b0: int = budgets[0]
			var b1: int = budgets[1]
			var dlt: int = p0 * b1 - p1 * b0
			if 100 * absi(dlt) < 3 * 1000 * b0 * b1:
				_finish(-1, "時間到・戰力相當")
			elif dlt > 0:
				_finish(0, "時間到・剩餘戰力較高")
			else:
				_finish(1, "時間到・剩餘戰力較高")
		elif absi(p0 - p1) < budget * 30:
			_finish(-1, "時間到・戰力相當")
		elif p0 > p1:
			_finish(0, "時間到・剩餘戰力較高")
		else:
			_finish(1, "時間到・剩餘戰力較高")

func _finish(w: int, r: String) -> void:
	finished = true
	winner = w
	reason = r
	_hash.update(PackedInt64Array([tick, w]).to_byte_array())
	fingerprint = _hash.finish().hex_encode()

func unit_by_id(id: int) -> Unit:
	for u in units:
		if u.id == id:
			return u
	return null

## 懸念指標（優化方案 B2）：用每 tick 的戰力差 Δ(t) 算。只在結束後呼叫。
## lead_changes：開戰 5 秒後 Δ 跨過 ±5%（以總預算計）的次數；
## lock_ratio：勝方從這一 tick 起領先再也不低於 20% 的時間點 ÷ 全場；
## max_swing：贏家曾經落後的最大幅度（%）。
func suspense() -> Dictionary:
	var total := budget * 1000
	var lg: PackedInt64Array = power_log
	if judge == 2:
		gf.close()


var shot_only: Array = []
var shot_fixed := false   # 1.2.0：--shot-fixed＝視覺回歸模式（固定幀時間、固定亂數、橫幅拍穩定狀態）；一般版面檢查照真實時間跑（Codex cat01 #6）   # 1.2.0 §14.4：--shot-only=a.png,b.png 只存這些（流程照跑）
func _snap(name: String) -> void:
	if shot_only.is_empty():
		for a0 in OS.get_cmdline_user_args():
			if a0.begins_with("--shot-only="):
				shot_only = Array(a0.substr(12).split(",", false))
				break
		if shot_only.is_empty():
			shot_only = ["*"]
	var skip_save: bool = not ("*" in shot_only) and not (name in shot_only)   # 跳過的畫面照樣等待（不改變後面畫面的時序；Codex cat01 #6）
	if DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_MINIMIZED:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)   # 真的被縮下去就還原，否則永遠等不到繪製
	if shot_state.has("pad"):
		pad_mode = true   # V1.2.1：手把焦點狀態（焦點框畫在目前的按鈕上）
	if clutch_t > 0.0 and (clutch_t < 0.3 or clutch_t > 1.45):
		clutch_t = 0.8   # 1.2.0：「最後時刻」橫幅在淡入淡出途中（透明度 <1）做對比檢查沒有意義 → 截圖一律拍完全顯示的穩定狀態（真實時間模式也一樣）
	queue_redraw()
	await get_tree().process_frame
	await get_tree().process_frame
	await RenderingServer.frame_post_draw
	if skip_save:
		return
	var img := get_viewport().get_texture().get_image()
	var serr := img.save_png(shot_dir.path_join(name))
	if serr != OK:
		print("SHOTFAIL ", name, " ", serr)   # 1.2.0（Codex cat01 #5）：存檔失敗不能默默通過
	print("SHOT ", name)
	if layout_probe:
		_layout_report(name, img)


## 實機影片（N6 預告素材）：用 Godot 錄影模式跑（--write-movie 絕對路徑 --fixed-fps 30），全程自動。
func _run_video() -> void:
