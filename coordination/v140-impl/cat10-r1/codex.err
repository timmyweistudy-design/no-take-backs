func _tv_draw_marks_place(a) -> void:
	var have := _tv_pos_list(a)
	tv_marks = tv_marks.filter(func(m): return have.has(m))   # 被拿掉的兵自動取消標記
	for i in tv_marks.size():
		_tv_badge(_foot_of(tv_marks[i]) - Vector2(0, 1.05 * CS), i + 1)

func _begin_battle(a0, a1, kind := "official") -> void:
	super._begin_battle(a0, a1, kind)
	if kind == "official":
		Funnel.first_battle_time()   # 1.1.0 A24
	if bool(rush.get("on", false)) and kind == "official":
		call("_on_skip")   # 極速賽：不看戰鬥，直接算結果
	tv_ids = []
	if sim == null or tv_marks.is_empty():
		return
	tv_ids = tv_ids_for(a0, tv_marks)

## 標記的位置 → 模擬的兵 id。開戰時展示緩衝已經讓模擬先跑幾格（位置變了），所以照模擬的編號規則從陣型算：
## 格子＝隊伍×1000＋列×16＋欄；自由＝同隊依 (y, 自己視角 x) 排序的第 k 隻（battle_sim.gd 開頭）。
static func tv_ids_for(a0, marks: Array) -> Array:
	var out: Array = []
	var free: bool = str(a0.deploy) == "free"
	var order: Array = []
		v.charge = a[14]; v.target = a[15]
		v.breach = a[16] if a.size() > 16 else 0
		v.aura = a[17] if a.size() > 17 else 0
		v.bmode = a[18] if a.size() > 18 else 0
		v.hidden = a[19] == 1 if a.size() > 19 else false
		v.link = a[20] if a.size() > 20 else -1
		v.windup = a[21] if a.size() > 21 else 0
		v.guard = a[22] if a.size() > 22 else 0
		v.summon = a[23] if a.size() > 23 else false
		if a.size() > 30:
			v.st = a[24]; v.ward = a[25] == 1; v.boss = a[26] == 1; v.arm_hp = a[27]; v.plate_hp = a[28]
		_by_id[v.id] = v
	var ux: Array = fr.get("ux", [])
	for i in mini(ux.size(), units.size()):
		var v: VUnit = units[i]
		v.cd = ux[i][0]; v.dmg_dealt = ux[i][1]; v.kills = ux[i][2]
	tick = fr["tick"]
	events = fr["events"]
	rally = fr["rally"]
	frenzy = fr["frenzy"]
	finished = fr["finished"]
	_power = fr["power"]
	_alive = fr["alive"]
	zones = fr.get("zones", [])

func power(t: int) -> int:
	return _power[t]

func alive_count(t: int) -> int:
	return _alive[t]
