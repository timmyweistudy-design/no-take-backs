## 跳到某個 tick：同一組陣型從頭快轉（確定性模擬，結果一定一樣），畫面與音效狀態清空重建。
func _seek(target: int) -> void:
	_seek_begin(target)
	while not _seek_tick(1000000):
		pass
	_seek_finish()


## 第七輪 M3：時間軸點下去不再卡畫面，分批算。headless 測試直接走 _seek。
var _seek_stop := 0
var _seek_ct := -1

func _seek_async(target: int) -> void:
	if seek_target >= 0:
		return
	if DisplayServer.get_name() == "headless" or shot_dir != "":
		_seek(target)
		return
	seek_target = target
	_seek_begin(target)

## 這一幀還在算就回傳 true（戰鬥畫面這一幀不動）。
func _seek_pump() -> bool:
	if seek_target < 0:
		return false
	if _seek_tick(10):
		seek_target = -1
		_seek_finish()
	return true

func _seek_begin(target: int) -> void:
	set("dir_hot_until", -1.0)   # 1.4.0：跳轉不帶舊的推近焦點（Codex cat05 #7）
	cues.clear()       # 1.3.0 §7.1：跳轉清掉預告（不留舊時間線的未來事件；Codex cat06 #2）
	stat_prev.clear()
	var armies2: Array = rv_last if play_kind == "review" and not rv_last.is_empty() else last_armies
	sim = Sim.new(armies2[0].copy(), armies2[1].copy(), battle_rules)
	call("_cmd_setup", sim, play_kind)
	ev_count = {}
	set("last_blast_tick", -99)
	_seek_ct = -1
	_seek_deaths = {}
	battle_marks.clear()
	var dl: int = ViewBuffer.DELAY if (bool(sim.get("cmd_on")) and not bool(sim.get("cmd_scripted"))) else ViewBuffer.DELAY_LONG   # 和 ViewBuffer 的選法一樣
	_seek_stop = maxi(0, target - (view.delay if view != null else dl))
	_seek_target_now = target

var _seek_target_now := 0
var _seek_deaths := {}   # V1.5.1 B2：快轉時誰在哪個 tick 倒下（跳轉後重建陣亡小旗）

## 算到時間用完或到達目標；到達回傳 true。
func _seek_tick(budget_ms: int) -> bool:
	var t0 := Time.get_ticks_msec()
	while sim.tick < _seek_stop and not sim.finished:
		if Time.get_ticks_msec() - t0 >= budget_ms:
			return false
		sim.step()
		for ev in sim.events:   # 快轉時也要累計戰報次數與時間軸標記（Codex S5 #4：共用同一個收集函式）
			if ev.has("src"):
				var s = sim.unit_by_id(ev["src"])
				var key := "%s%d" % [ev["kind"], s.team]
				ev_count[key] = int(ev_count.get(key, 0)) + 1
				if ev["kind"] == EV.BLAST and not ev.has("dmg"):
					ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
			_collect_mark(ev, sim, sim.tick)
			if ev["kind"] == EV.DEATH:
				_seek_deaths[int(ev["id"])] = sim.tick
			if ev["kind"] == EV.CMD:
				battle_marks.append({"tick": sim.tick, "kind": "cmd", "team": int(ev["team"]), "skill": int(ev["skill"])})   # V1.5.1：快轉也收軍令標記（原本跳轉後會漏）
		if _seek_ct < 0 and not sim.finished and clutch_cond(sim):
			_seek_ct = sim.tick
	return true

func _seek_finish() -> void:
	clock_last = -1   # 1.4.0 §7.2：跳轉後棋鐘不補跳不補響
	if sfx != null and sfx.has_method("reseed"):
		sfx.reseed(sfx.seed_at(round_no, view.tick if view != null else 0))   # 1.3.0 §10：跳轉後音效變體從同一個狀態開始
	call_deferred("_tm_sync")
	var target := _seek_target_now
	var keep_ct := _seek_ct
	var had_clutch := keep_ct >= 0
	view = ViewBuffer.new(sim)
	prev_pos.clear()
	_gait_reset()
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	fx.clear()
	frags.clear()   # 1.2.0 §8.2
	dying.clear()
	graves.clear()
	# V1.5.1 B2：跳轉前 1～4 秒倒下的兵，陣亡小旗照時間補回（倒地 1 秒後插旗、旗子留 3 秒）
	for did in _seek_deaths:
		var age: float = float(target - int(_seek_deaths[did])) / 20.0
		var dv = view.unit_by_id(int(did))
		if dv != null and age >= 1.0 and age < 4.0:
			graves.append({"pos": _upos(dv), "team": dv.team, "t": age - 1.0})
		elif dv != null and age >= 0.0 and age < 1.0:
			# 不到一秒前倒下：倒地演出接著播完，跨過 1 秒照常插旗（Codex v151-i2 #1）
			dying.append({"pos": _upos(dv), "type": dv.type, "team": dv.team, "face": signf(dv.fx) if dv.fx != 0 else 1.0, "t": age})
	atk_hit.clear()
	atk_seq.clear()
	alt_hit.clear()
	proj_tgt.clear()   # V1.5：跳轉不能留舊的飛行目標（Antigravity v150-i1 #1）
	atk_t.clear()
	hurt_t.clear()
	hurt_dir.clear()
	brace_t.clear()
	accum = 0.0
	present_debt = 0.0   # 1.2.0 §9.6：跳轉後不能帶著舊的欠時加速（Codex final-r2 #3）
	result_delay = 0.0
	clutch_t = 0.0
	slow_left = 0.0
	final_left = 0.0     # Codex v10-r1 #4：跳回前段不能留著慢動作，再播到末擊要再演
	final_used = false
	key_used = false
	key_t = -10.0
	last_kill = [-1, -10.0]
	last_hitter.clear()
	hitstop = 0.0
	# 演出狀態依目標時間重建（Codex S5 #5）：最後時刻是否已發生、是否已進狂熱、音樂
		return   # Codex r2：重播完再重播，返回目的地還是最早那個結算
	replay_snap = {"sim": sim, "view": view, "report": report, "marks": battle_marks.duplicate(true), "kind": play_kind,
		"tab": result_tab, "overlay": "", "ev_count": ev_count.duplicate(), "pt_rated": pt_rated, "pt_call": pt_call_tick}

## 重播的「返回」：回到進來的地方。只還原畫面，比分、進度、成就、試玩紀錄都不寫。
func _replay_back() -> void:
	tm_ghost = null   # V1.4 #1：回到結果頁，原本時間線的淡圈不能留下
	call("_pre_drop")
	seek_target = -1   # Codex r1：算到一半返回，不能把下一場快轉到舊目標
	skip_busy = false
	paused = false
	follow_id = -1
	zoom = 1.0
	zoom_target = 1.0
	fx.clear()
	frags.clear()   # 1.2.0 §8.2
	dying.clear()
	report_log.clear()
	sfx.set_muffled(false)
	if watch_mode or replay_snap.is_empty():
		call("_go_title")
		return
	sim = replay_snap["sim"]
	view = replay_snap["view"]
	report = replay_snap["report"]
	battle_marks = replay_snap["marks"]
	play_kind = replay_snap["kind"]
	result_tab = replay_snap["tab"]
	ev_count = replay_snap["ev_count"]   # Codex r1：戰報、評分狀態也要還原，不然同一局能再評一次
	pt_rated = replay_snap["pt_rated"]
	pt_call_tick = replay_snap["pt_call"]
	overlay = replay_snap["overlay"]
	result_delay = 0.0
	state = St.RESULT
	replay_snap = {}


## 從關鍵時刻開始重播（第七輪 A7）。
func _replay_from(t: int) -> void:
	call("_replay")
	_seek_async(t)
	_reset_place()



func _finish_battle() -> void:
	sfx.set_muffled(false)
	_pc_capture()   # V1.4 #14：最後一格戰場畫面留給戰報卡
	fx = fx.filter(func(f): return f["kind"] != "text")   # 結果頁不留戰場跳字（Antigravity S3）
	clutch_t = 0.0   # 最後時刻橫幅不跟到結果頁（第三輪 T4 抓到）
	state = St.RESULT
	tm_ghost = null
	result_t = time
	set("ink_stamped", false)   # 1.2.0 §9.4
	if play_kind == "official" and sim != null:
		last_cmds = sim.cmd_log.duplicate(true)
	result_tab = 0
	_focus = 0
	slow_left = 0.0
	zoom_target = 1.0
	var w: int = sim.winner
	var eff: Dictionary = PLAY_EFFECTS[play_kind]
	if eff["series"]:
		if w >= 0:
			wins[w] += 1
		series_over = series_done(wins, round_no, rules)
		if bool(get("sealed_on")) and mode == Mode.DUEL and round_no >= 3:
			series_over = true   # V1.4 #13：只封了三陣，平手也不打第四局（Antigravity v140-i3）
		if series_over and bool(get("sealed_on")) and mode == Mode.DUEL and play_kind == "official":
			call("_ach", "SEALED_DONE")   # V1.5
		call("_swap_settle")   # 1.2.0 §11.5：換邊雙局照玩家記分、兩局就結束
	call("_camp_settle")   # 1.2.0 §11.7 戰役評星
	if bool(get("wv_active")) and mode == Mode.VS_AI and play_kind == "official":
		set("wv_surv", call("wave_survivors", last_armies[0], sim))   # 殘兵在結束當下就定（之後看重播不影響）
		var wc: Array = get("wv_codes")
		wc.append(BattleCode.encode(last_armies[0], last_armies[1], battle_rules, last_cmds))   # V1.5.1 D1
	_build_report()
	call("_ghost_settle", w)   # V1.4 #7
	call("_wager_settle")   # V1.4 #16：競猜結算（要在報告建好之後，不然結果行會被蓋掉，Codex v140-i2）
	if bool(get("wv_active")) and mode == Mode.VS_AI and play_kind == "official" and not (w == 0 and int(get("wv_no")) < 3):
		call("_wave_end", w == 0)   # V1.4 #11：車輪戰結束（輸了或三波打完）
	if mode == Mode.DUEL:
		sfx.play("win" if w >= 0 else "lose")
	elif mode == Mode.PUZZLE and report.has("goal_ok"):
		sfx.play("win" if bool(report["goal_ok"]) else "lose")   # 第十三輪：照過關條件（Codex v13-r1 #6）
	else:
		sfx.play("win" if w == 0 else "lose")
	sfx.play("ui_quill", 0.45)   # V1.3 B4：戰報寫上羊皮紙的筆聲（各模式都有）
	if eff["progress"] and bool(get("daily_practice")):
		call("_daily_finish", w)   # 1.1.0：每日練習只給練習結果提示，不記戰績、成就、對戰紀錄（Codex v110-i2 #3）
	elif eff["progress"]:
		_progress_and_achievements()
		if mode == Mode.VS_AI or mode == Mode.GAUNTLET or mode == Mode.DUEL:
			call("_record_match", w)
		call("_trial_finish", w)
		call("_daily_finish", w)
		Save.save_data()     # 統計是最後才記的，要再存一次（Codex #7）
	if eff["log"]:
		Save.playtest_log(_pt_entry(0))



	if fog_on and state == St.PLACE and mode == Mode.VS_AI and not ai_prebuilt:
		call("_build_ai")   # 迷霧推演的下一局：一樣先組好
		ai_prebuilt = true
	_v16_jobs(_delta)

func _open_codex(t: int) -> void:
	Funnel.mark("codex_open")
	super._open_codex(t)

func _finish_battle() -> void:
	super._finish_battle()
	if play_kind != "official" or sim == null:
		return
	if bool(rush.get("on", false)) and mode == Mode.PUZZLE:
		_rush_settle()
		return
	if trio_on and mode == Mode.PUZZLE:
		_trio_settle()
	_coop_settle()
	if mode == Mode.VS_AI and not watch_mode and not bool(get("daily_practice")):
		# V1.0.0（Codex v100-i1）：對 AI 的場數與勝場另記（stats 連教學、殘局都算，建議下一步不能用它判斷「打過 AI」）
		Save.data["ai_games"] = int(Save.data.get("ai_games", 0)) + 1
		if sim.winner == 0:
			Save.data["ai_wins"] = int(Save.data.get("ai_wins", 0)) + 1
	if mode != Mode.TUTORIAL and not watch_mode and not bool(get("daily_practice")) and not (rules != null and Presets.badge(rules, "duel" if mode == Mode.DUEL else "ai") == Presets.BADGE_LAB):
		Save.data["eff_games"] = int(Save.data.get("eff_games", 0)) + 1   # V1.6.1 N1：有效對局（1.1.0：每日練習不算）
	_rift_settle()
	_persona_result()
	if not bool(get("daily_practice")):
		_career_settle()   # 1.1.0（Codex v110-i1 #4）：每日練習不累積熟練度、戰功章
	Funnel.mark("first_battle")
	if mode != Mode.DUEL:
		var won: bool = sim.winner == 0
		Funnel.mark("first_win" if won else "first_loss")
		if mode == Mode.TUTORIAL and won:
			Funnel.mark("tutorial_done")
		if mode == Mode.PUZZLE and puzzle_id != "ws" and (won or bool(report.get("goal_ok", false))):
			Funnel.mark("puzzle_clear")   # 工坊、一陣三考不算（三考只打了第一場，Antigravity v160-i2 #4）
	if Guide.demo_end_due(Save.data, _demo(), demo_end_shown):
		demo_end_shown = true
		Funnel.mark("demo_end")
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)   # 真的被縮下去就還原，否則永遠等不到繪製
	if shot_state.has("pad"):
		pad_mode = true   # V1.2.1：手把焦點狀態（焦點框畫在目前的按鈕上）
	if clutch_t > 0.0 and (clutch_t < 0.3 or clutch_t > 1.45):
		clutch_t = 0.8   # 1.2.0：「最後時刻」橫幅在淡入淡出途中（透明度 <1）做對比檢查沒有意義 → 截圖一律拍完全顯示的穩定狀態（真實時間模式也一樣）
	queue_redraw()
	await get_tree().process_frame
	await get_tree().process_frame
	await RenderingServer.frame_post_draw
	if skip_save:
		return
	var img := get_viewport().get_texture().get_image()
	var serr := img.save_png(shot_dir.path_join(name))
	if serr != OK:
		print("SHOTFAIL ", name, " ", serr)   # 1.2.0（Codex cat01 #5）：存檔失敗不能默默通過
	print("SHOT ", name)
	if layout_probe:
		_layout_report(name, img)


## 實機影片（N6 預告素材）：用 Godot 錄影模式跑（--write-movie 絕對路徑 --fixed-fps 30），全程自動。
func _run_video() -> void:
	if "--video-offscreen" in OS.get_cmdline_user_args():   # 1.2.0：驗收錄影不開可見視窗（和截圖一樣移到畫面外、不搶焦點）
		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
		DisplayServer.window_set_position(Vector2i(-4000, -4000))
	for nk in ["lobby", "place", "result"]:   # 1.2.0：老闆便條不入鏡（影片用 shot_ 存檔，等於新玩家）
		preload("res://scripts/game/guide.gd").see(Save.data, "note_" + nk)
	await get_tree().create_timer(2.5).timeout
	difficulty = 1
	_start_mode(Mode.VS_AI)
	# 1.1.0 E6：分鏡場景（--video-scene=kingdom／fantasy），全程固定種子，同一個指令錄出同一段（trailer-30s.md）
	var scene := "kingdom"
	for a0 in OS.get_cmdline_user_args():
		if a0.begins_with("--video-scene="):
			scene = a0.substr(14)
	var plan := [[D.SHIELD, 5, 3], [D.SHIELD, 5, 5], [D.SWORD, 4, 2], [D.SWORD, 4, 6], [D.SWORD, 4, 4],
		[D.ARCHER, 1, 3], [D.ARCHER, 1, 5], [D.ARCHER, 0, 4], [D.CAVALRY, 3, 0], [D.CAVALRY, 3, 8], [D.ASSASSIN, 2, 4],
			[D.ARCHER, 1, 2], [D.ARCHER, 1, 6], [D.SWORD, 4, 3], [D.SWORD, 4, 5], [D.CAVALRY, 3, 4], [D.ASSASSIN, 2, 2], [D.SHIELD, 5, 4]]
	if scene == "fantasy":
		# 分鏡 15–18 秒：爆爆羊連環炸、史萊姆分裂、吸塵貓吸成一團
		plan = [[13, 5, 3], [13, 5, 5], [11, 5, 2], [11, 5, 6], [11, 4, 4], [18, 3, 4], [19, 2, 4], [13, 4, 2], [13, 4, 6]]
	if hp > 0.0:
		draw_arc(c, R + 4, -PI / 2, -PI / 2 + TAU * hp, 64, Art.team_color(u.team, cbm()).lightened(0.25), 5.0, true)
	for q in 4:
		var aq := -PI / 2 + q * PI / 2
		draw_line(c + Vector2(cos(aq), sin(aq)) * (R + 1.5), c + Vector2(cos(aq), sin(aq)) * (R + 6.5), PAL.TRINKET_BRASS.darkened(0.45), 1.5, true)
	var cdb := float(D.stat(u.type).get("cd", 20))
	var cdf := clampf(float(u.cd) / maxf(1.0, cdb), 0.0, 1.0)
	if cdf > 0.0:
		draw_arc(c, R - 5, -PI / 2, -PI / 2 + TAU * cdf, 48, Color(PAL.TRINKET_GOLD, 0.9), 3.0, true)

## 精華三連：一段播完（或場次結束）就跳下一段；最後一段播完照常進結果。
func _hl_seg(i: int) -> void:
	hl_i = i
	var t := int(hl_reel[i])
	hl_end = t + DirR.SEG_LEN - DirR.SEG_PRE
	call("_seek_async", maxi(0, t - DirR.SEG_PRE))

func _hl_reel_tick() -> bool:
	if hl_reel.is_empty() or view == null or seek_target >= 0 or state != St.BATTLE:
		return false
	if view.tick >= hl_end or view.finished:
		if hl_i + 1 < hl_reel.size():
			_hl_seg(hl_i + 1)
			return true
		hl_reel = []
	return false

## 放大鏡鏡片底：盤面地塊放大 1.6 倍（地圖有地塊時用 UV 圓形多邊形貼；平原用草地底色）。
func _mag_glass_bg(c: Vector2, R: float, at: Vector2) -> void:
	var mt: Texture2D = call("_map_tex") if fld_map != 0 else null
	var pts := PackedVector2Array()
	var uvs := PackedVector2Array()
	for i in 40:
		var a := i * TAU / 40.0
		var d := Vector2(cos(a), sin(a))
		pts.append(c + d * R)
		uvs.append(((at - Vector2(0, 20)) + d * R / (1.6 * zoom) - ORIGIN) / fld_size)
	if mt != null:
		draw_polygon(pts, PackedColorArray([Color.WHITE]), uvs, mt)
		return "H2"
	if px <= 48:
		return "H1"
	return "D" if px < 80 else "DX"

func _scale_key() -> int:
	var sc := int(Save.s("text_scale"))
	return 150 if sc >= 150 else (125 if sc >= 125 else 100)

func tz(role: String) -> int:
	return int(TYPE_SCALE[_scale_key()][role])

func ts(px: int) -> int:
	return tz(role_of(px))

## 封頂（第五輪）：取字級表裡 ≤ 上限的最大值，但不低於「註記」。取代 tcap(ts(x), N)，避免封出表外字級。
func tcap(sz: int, maxpx: int) -> int:
	var best := tz("C")
	for v in TYPE_SCALE[_scale_key()].values():
		if v <= mini(sz, maxpx) and v > best:
			best = v
	return best

## 這個字級在不在字級表裡（版面檢查用）。
func size_ok(sz: int) -> bool:
	return sz in TYPE_SCALE[_scale_key()].values()
