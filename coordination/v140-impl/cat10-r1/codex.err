## 行距（第五輪 §4.2，XAG 101）：多行的段落 1.5 倍；單行照舊。
static func line_h(n: int) -> float:
	return 1.5 if n > 1 else 1.3

## 一段字換行後的高度（排版用）。
func text_h(s: String, size: int, maxw := 0.0, bold := false) -> float:
	var n := wrap_lines(s, size, maxw, bold).size()
	return n * size * line_h(n)


## V1.6.1 A8：焦點框平滑移動
const FOCUS_GLIDE := 0.08
var fg_from := Rect2()
var fg_to := Rect2()
var fg_at := -9.0
func _focus_glide(rd: Rect2) -> Rect2:
	if layout_probe or not bool(get("pad_mode")) or bool(Save.s("reduce_motion")):
		fg_to = rd
		fg_at = -9.0
		return rd
	if not rd.is_equal_approx(fg_to):
		var quick := time - fg_at < 0.15   # 連續撥動：直接跳，不黏
		fg_from = rd if (quick or fg_to.size == Vector2.ZERO) else _glide_now()
		fg_to = rd
		fg_at = time
	return _glide_now()

func _pstats(a: Array) -> Dictionary:
	var b := a.duplicate()
	b.sort()
	if b.is_empty():
		return {}
	return {"p50": snappedf(b[b.size() / 2], 0.01), "p95": snappedf(b[int(b.size() * 0.95)], 0.01), "p99": snappedf(b[mini(b.size() - 1, int(b.size() * 0.99))], 0.01), "max": snappedf(b[-1], 0.01)}


## 動作／表情樣品（R5 截圖驗證用）：每個兵種一列：待機、前搖、揮擊、後搖、受擊、狂熱、專屬（衝鋒／潛行／頂住）、勝利。
var anim_gallery := false
var gallery_page := 0

func _ready() -> void:
	super._ready()
	# 宣傳／驗證模式的分派（S8：原本在 game_screens 透過基底的空函式呼叫上來）
	if capsule_path != "":
		_capture_capsule.call_deferred()
	elif shot_dir != "":
		shot_fixed = "--shot-fixed" in OS.get_cmdline_user_args()
		if shot_fixed:
			seed(20261111)   # 1.2.0 §14.6：視覺回歸模式固定全域亂數（特效、待機錯開），同一份程式重拍要一致
		_run_screenshots.call_deferred()
	elif video_mode:
		_run_video.call_deferred()
	elif perf_path != "":
		_run_perf.call_deferred()
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--mem-check="):
			_run_mem_check.call_deferred(a.substr(12))
		elif a.begins_with("--sil="):
			_run_sil.call_deferred(a.substr(6))


## V1.0.0 角色：剪影辨識表。22 種兵（含召喚物）站成兩排：上排原尺寸、下排 50%；平塗背景，tools/gen/sil_report.py 轉灰階、
## 算輪廓相似度找出最難分的兵。用法：<exe> --path game --resolution 1280x800 -- --sil=<輸出 png 絕對路徑>
var sil_mode := false
func _run_sil(out_path: String) -> void:
	Save.prefix = "shot_"
	sil_mode = true
	for i in 6:
		shake = maxf(shake, 0.15)

## 畫面前進一個 tick：模擬保持領先 DELAY 個 tick，畫面播最舊的那一份快照（R5 展示緩衝）。
func _sim_step(with_fx: bool) -> void:
	_pump_view()
	_check_final(with_fx)
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	if not view.advance():
		view.finished = true
		return
	if tm_ghost != null:
		call("_tm_sync")
	_gait_tick(with_fx)
	_status_tags(with_fx)   # 1.3.0 §7.1 狀態竹籤
	_pump_view()
	_check_clutch(with_fx)   # 每一個畫面 tick 都判定（原本每一幀判一次，觸發的 tick 會跟幀率有關）
	if view.frenzy and not frenzy_seen:
		frenzy_seen = true
		if with_fx:
			_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
			sfx.play("frenzy")
			sfx.play_music("music_frenzy")
	var deaths := 0
	for ev in view.events:
		var k: String = ev["kind"]
		var s = view.unit_by_id(ev["src"]) if ev.has("src") else null
		if s != null:   # V1.4 #10：沙盤機關的事件沒有來源單位（src＝-1）
			var key := "%s%d" % [k, s.team]
			ev_count[key] = int(ev_count.get(key, 0)) + 1
			if k == EV.BLAST and not ev.has("dmg"):   # 第八輪：爆炸演出一筆一次；逐目標傷害不算次數（BOOM_5）
				ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
		if k == EV.DEATH:
			deaths += 1
		_collect_mark(ev, view, view.tick)
		_on_event(ev, with_fx)
	if sfx != null and "pan_hint" in sfx:
		sfx.pan_hint = 0.0   # 事件以外的聲音（棋鐘、結算）回到正中
	# 碾壓局最後一擊（優化方案 F1）：0.2 秒頓格＋微震，直接進結算
	if view.finished and not slow_used and deaths > 0 and with_fx:
		hitstop = 0.2
		if bool(Save.s("shake")):
			shake = 0.15



## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
func _pump_view() -> void:
	for fr in view.pump(sim):
		for e in fr["events"]:
			if e["kind"] == EV.CHARGE or e["kind"] == EV.BRACED:
				_cue_add(str(e["kind"]), int(e.get("src", -1)), int(e.get("tgt", -1)), int(fr["tick"]))   # 1.3.0 §7.1 預告
			if e.get("tags", []).has(EV.EXT_FIRE):
				continue   # 1.2.0 火矢的小火：不是射手出手，不排拉弓、飛箭（Codex cat09 #1）
			# 第四輪：補血、戰鼓也走出手動畫；被貼身敲人、破陣、補血、戰鼓用專屬動作（variant 2）
			if e["kind"] == EV.HEAL or e["kind"] == EV.DRUM or e["kind"] == EV.BONK or e.get("tags", []).has(EV.BREACH):
				var ah: Dictionary = alt_hit.get(e["src"], {})
				ah[int(fr["tick"])] = true
				if ah.size() > 8:
					ah.erase(ah.keys().min())
				alt_hit[e["src"]] = ah
			if event_route(e) == "attack" or e["kind"] == EV.HEAL or e["kind"] == EV.DRUM:
				var hs: Array = atk_hit.get(e["src"], [])
				hs.append(int(fr["tick"]))
				var su = view.unit_by_id(e["src"]) if not view.units.is_empty() else null
				var st_ty: int = int(su.type) if su != null else -1
			for u in a.units:
				if not RS.available(int(u["type"]), true):
					_toast(L.t("bc_demo_locked"), true)
					return
	if r["mismatch"]:
		_toast(L.t("bc_mismatch"))
	last_cmds = r.get("cmds", [])
	watch_code(r["a0"], r["a1"], r.get("rules"))

## 看一場對戰代碼：當成全新的一局初始化（Codex S5 #2：原本沿用舊的陣型、比分、局數）
func watch_code(a0, a1, p_rules = null) -> void:
	replay_marks = []   # V1.5.1：看別人的代碼不能留上一局的時間軸刻度（Codex v151-i2）
	mode = Mode.VS_AI
	rules = p_rules
	battle_rules = p_rules
	ai_name = ""
	overlay = ""
	armies = [a0.copy(), a1.copy()]
	wins = [0, 0]
	round_no = 1
	series_over = false
	last_player_formation = []
	last_armies = [a0.copy(), a1.copy()]
	rv_last = []
	_begin_battle(a0.copy(), a1.copy(), "replay")
	watch_mode = true


