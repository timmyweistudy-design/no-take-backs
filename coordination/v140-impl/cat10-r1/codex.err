## 1.4.0 第 10 大類：棋館的人 2.0（謝幕反應、老闆手勢、印章冊）
func test_people_v140() -> void:
	var GS = load("res://scripts/ui/game_screens.gd")
	var A = load("res://scripts/ui/art.gd")
	ok(GS.seat_react(false, 1, 0.5, false)[0] == 0, "還在打：沒有謝幕反應")
	var win: Array = GS.seat_react(true, 1, 0.3, false)
	ok(int(win[0]) == A.M_HAPPY and float(win[1]) > 0.0 and float(win[3]) == 0.0, "對手贏：得意＋點頭、不推茶杯")
	var lose: Array = GS.seat_react(true, 0, 1.0, false)
	ok(int(lose[0]) == A.M_HURT and float(lose[3]) > 6.0, "對手輸：慌＋茶杯往前推")
	var still: Array = GS.seat_react(true, 0, 1.0, true)
	ok(int(still[0]) == A.M_HURT and float(still[1]) == 0.0 and float(still[2]) == 0.0 and float(still[3]) == 0.0, "減少動態：只換表情、不動")
	ok(GS.seat_react(true, -1, 0.5, false)[0] == A.M_GRIM, "平手：專注")
	ok(GS.seat_react(true, 1, 0.4, false) == GS.seat_react(true, 1, 0.4, false), "同一時刻同結果（純函式）")
	var g = GS.new()
	var pw: Array = g.owner_end_pose(0, 0.9)
	ok(float(pw[0]) == 1.0 and bool(pw[2]) and float(pw[1]) == 0.0, "玩家贏：老闆伸手放下紅泥小章")
	var pl: Array = g.owner_end_pose(1, 0.7)
	ok(float(pl[0]) == 1.0 and float(pl[1]) > 0.0 and not bool(pl[2]), "玩家輸：老闆叩桌")
	ok(float(g.owner_end_pose(0, 1.3)[0]) == 0.0, "結算前手收回")
	g.free()
	ok(GS.stamp_page(0) == [1, 0] and GS.stamp_page(1) == [1, 1] and GS.stamp_page(10) == [1, 10] and GS.stamp_page(11) == [2, 1], "印章冊一頁 10 格、蓋滿才翻頁")
	var csv: String = FileAccess.get_file_as_string("res://data/strings.csv")
	ok(csv.find("\nod_book,") >= 0, "印章冊頁碼有四語")
func play_pitched(name: String, vol: float, pitch: float) -> void:
	play(name, vol, pitch)

func play(name: String, vol := 1.0, pitch := 1.0) -> void:
	var gain := gain_for(name)
	if not streams.has(name) or gain <= 0.0:
		return
	if int(PRIO.get(name, 0)) >= 2 and not name.begins_with("k_"):
		duck(0.7)
	var now := Time.get_ticks_msec()
	var r: Array = recent.get(name, [])
	r = r.filter(func(t): return now - t < 80)
	if r.size() >= 2:
		return
	r.append(now)
	recent[name] = r
	var pr: int = PRIO.get(name, 1)
	if same_playing(players.map(func(q): return q.playing), _name_of, name) >= SAME_MAX:
		return   # V1.0.0 A2：同一個音效同時最多 SAME_MAX 路（混戰時同一種聲音疊太多會爆音）
	var busy: Array = []
	var prios: Array = []
	var starts: Array = []
	for i in players.size():
		busy.append(players[i].playing)
		prios.append(_prio_of.get(i, 0))
		starts.append(_started.get(i, 0))
	var ch := pick_channel(busy, prios, starts, pr)
	if ch < 0:
		return
	var p := players[ch]
	p.stop()
	p.bus = BUS_UI if is_ui(name) else pan_bus(pan_hint, mono)   # 1.4.0 §9.2：戰場音效依單位位置分左右（單聲道設定時不分）
	p.stream = _pick_variant(name)
	p.pitch_scale = pitch * (1.0 + rng.randf_range(-0.05, 0.05) if pitch != 1.0 else 1.0 + rng.randf_range(-0.1, 0.1))   # 兵種音高再加 ±5% 微擾，同音高齊發不會共鳴
	p.volume_db = linear_to_db(maxf(0.0001, gain * vol)) + trim_db(p.stream)   # V1.2.1 E2：個別音檔響度修正
	p.play()
	_prio_of[ch] = pr
	_started[ch] = now
	_name_of[ch] = name

const SAME_MAX := 3
var _name_of := {}
## 純函式（測試用）：正在播這個名字的聲道數
static func same_playing(playing: Array, names: Dictionary, name: String) -> int:
	var n := 0
	for i in playing.size():
		if playing[i] and str(names.get(i, "")) == name:
			n += 1
	return n

## V1.2.1 E2：tools/gen/audio_trim.py 量出的個別音檔修正（dB），依檔名查。
static var _trim := {}
static func trim_db(st) -> float:
	if _trim.is_empty():
		var f := FileAccess.get_file_as_string("res://data/audio_trim.json")
		var j = JSON.parse_string(f) if f != "" else null
		_trim = j["trim"] if j is Dictionary and j.has("trim") else {"_": 0.0}
	if st == null or not ("resource_path" in st):
		return 0.0
	return float(_trim.get(str(st.resource_path).get_file(), 0.0))

static func is_ui(name: String) -> bool:
	return name.begins_with("k_") or name.begins_with("ui_")

## 這個音效走哪一條音量（介面音或音效）。
func gain_for(name: String) -> float:
	return ui_vol if is_ui(name) else sfx_vol

## 變體：隨機挑一個，但不和上一次相同（只有一個就用它）。
func _pick_variant(name: String):
	var vs: Array = variants.get(name, [streams[name]])
	if vs.size() <= 1:
		return vs[0]
	var last := int(_last_var.get(name, -1))
	var k := rng.randi_range(0, vs.size() - 1) if last < 0 else rng.randi_range(0, vs.size() - 2)
	if last >= 0 and k >= last:
	else:
		voice.volume_db = linear_to_db(maxf(0.0001, voice_vol))

func play_voice(mood: String) -> void:
	var vs: Array = _voice_streams.get(mood, [])
	if voice == null or vs.is_empty() or voice_vol <= 0.0:
		return
	voice.stop()
	voice.stream = vs[rng.randi_range(0, vs.size() - 1)]
	voice.volume_db = linear_to_db(maxf(0.0001, voice_vol))
	voice.play()
