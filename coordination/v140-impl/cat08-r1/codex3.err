   455	func _key(k: int) -> void:
   456		_toast_dismiss()
   457		if state == St.BATTLE:
   458			mag_hide = follow_id   # 1.3.0 §2：任何按鍵 1 幀內收起放大鏡
   459			hl_reel.clear()        # 精華三連：按鍵＝交還手動（Codex cat06 #6）
   460		if state == St.RESULT and _ink_active():
   461			result_t -= INK_DUR   # 1.2.0 §9.4：任何按鍵跳過宣紙戰報演出
   462			return
   463		if state == St.PLACE and overlay == "" and _v16_place_key(k):
   464			return
   465		if state == St.PLACE and overlay == "" and _place_tool_key(k):
   466			return
   467		if state == St.PLACE and _fp_key(k):
   468			return
   469		if state == St.BATTLE and overlay == "" and _cmd_key(k):
   470			return
   471		if state == St.BATTLE and overlay == "" and (k == KEY_BRACKETLEFT or k == KEY_BRACKETRIGHT) and _replay_controls_active():
   472			_bm_jump(-1 if k == KEY_BRACKETLEFT else 1)   # 1.2.0 §11.2 書籤
   473			return
   474		if state == St.BATTLE and overlay == "" and k == KEY_G and play_kind == "review" and tm_ghost != null:
   475			tm_ghost_on = not tm_ghost_on   # 1.2.0 §11.3
   476			return
   477		# 有按鈕焦點的畫面（標題、選單、結果、覆蓋層、戰鬥）：方向鍵移焦點、Enter 按下、Esc 返回
   478		if state != St.PLACE or overlay != "":
   479			match k:
   480				KEY_UP, KEY_LEFT:
   481					_move_focus(-1)
   482				KEY_DOWN, KEY_RIGHT:
   483					_move_focus(1)
   484				KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
   485					if _btns_gen == _gen and _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:   # 按鈕清單要是這個畫面的
   486						sfx.play("k_click", 0.7)
   487						_btns[_focus]["cb"].call()
   488				KEY_F1:
   489					if state == St.BATTLE and overlay == "" and play_kind != "official":
   490						call("_breport_open")   # 1.1.0 B10：手把 View／Select＝戰報面板
   491					elif state == St.BATTLE and overlay == "":
   492						set("hud_info_until", time + 2.0)   # 1.2.0 §5.6：正式對戰按 View＝叫出 AI 名稱與性格 2 秒
   493				KEY_PAGEUP, KEY_PAGEDOWN:
   494					if overlay == "codex":
   495						_scroll_by("left", -160.0 if k == KEY_PAGEUP else 160.0)
   496				KEY_P, KEY_TAB:
   497					# 手把 Y 送的是 Tab：戰鬥中＝暫停（第七輪 A6）
   498					if state == St.BATTLE and overlay == "":
   499						_toggle_pause()
   500					elif k == KEY_TAB:
   501						_move_focus(1)
   502				KEY_ESCAPE:
   503					if overlay == "ai_busy":
   504						pass      # 第十輪 I4：AI 計算中不能取消
   505					elif overlay == "first_run":
   506						Save.set_setting("first_done", true)   # V1.5：跳過第一次啟動的問題
   507						overlay = ""
   508					elif overlay == "paint":
   509						call("_paint_close")   # V1.4 #15：Esc／手把 B 也要存塗裝（Codex、Antigravity v140-i4）
   510					elif overlay == "pause_menu":
   511						call("_pause_resume")
   512					elif overlay == "settings":
   513						call("_settings_close")
   514					elif overlay == "fs_confirm":
   515						call("_fs_revert")
   516					elif overlay == "confirm":
   517						overlay = str(get("confirm_ret"))
   518					elif overlay in ["keys", "restore", "clear_data"]:
   519						set("keys_capture", "")
   520						overlay = "settings"   # 設定的子頁：Esc 回設定（不是整個關掉，Antigravity v150-i2 #4）
   521					elif overlay == "codex" and bool(get("cx_zoom")) and int(get("cx_unit")) < D.total():
   522						set("cx_zoom", false)   # V1.5.1：近看模式先收合
   523					elif overlay == "breport":
   524						call("_breport_close")   # 1.1.0 B10：回到重播、焦點與暫停狀態還原
   525					elif overlay == "boss_note":
   526						call("_close_boss_note")   # 1.2.0：Esc／手把 B＝知道了（不然下一幀又跳出來，Codex cat03 #1）
   527					elif overlay == "trio_result":
   528						call("_trio_back")   # 1.1.0 H3：和結算頁返回鈕同一條路
   529					elif overlay == "leave" and state == St.BATTLE and paused:
   530						overlay = "pause_menu"   # 和「留下」一樣回暫停選單（Codex v151-i1 #3）
   531					elif overlay != "":
   532						# V1.5.1：Esc／手把 B 和返回鈕同一套目的地；沒登記來處的子頁用它返回鈕的目的地
   533						call("_nav_back", {"wager": "playroom", "draft": "playroom", "wave_codes": "codes", "ghosts": "playroom", "weekly": "playroom", "rift": "playroom", "nb_words": "notebook", "daily_past": "playroom", "wk_ghosts": "weekly"}.get(overlay, ""))
   534					elif state == St.BATTLE:
   535						if play_kind != "official":
   536							_replay_back()   # 第七輪 A9：重播時 Esc＝返回
   537						else:
   538							call("_open_pause_menu")   # V1.5：Esc 開暫停選單（原本直接看結果，移進選單第二項）
   539					elif state != St.TITLE:
   540						_request_leave()
   541			return
   542		pad_mode = true
   543		match k:
   544			KEY_UP: cursor.y = maxi(0, cursor.y - 1)
   545			KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
   546			KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
   547			KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
   548			KEY_F1:
   549				_open_codex(selected)
   550			KEY_H:
   551				if mode == Mode.PUZZLE:
   552					call("_puzzle_hint")   # 第十三輪：手把 L3
   553			KEY_P:
   554				if mode == Mode.PUZZLE and PZ.get_puzzle(puzzle_id).has("cmd"):
   555					overlay = "puzzle_plan"   # 第十三輪：手把 R3
   556			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0:
   557				# 第八輪：數字鍵對應這一排的第幾張卡，不是兵種編號
   558				var pos := 9 if k == KEY_0 else k - KEY_1
   559				var cards := _card_types()
   560				if pos < cards.size() and _allowed(cards[pos]):
   561					selected = cards[pos]
   562			KEY_Q, KEY_E:
   563				var cl := _card_types()
   564				if not cl.is_empty():
   565					var at := maxi(0, cl.find(selected))
   566					for _i in cl.size():
   567						at = (at + (cl.size() - 1 if k == KEY_Q else 1)) % cl.size()
   568						selected = cl[at]
   569						if _allowed(selected):
   570							break
   571			KEY_ENTER, KEY_KP_ENTER:
   572				if _cur_army().index_at(cursor.x, cursor.y) == -1:
   573					_try_place(cursor)
   574			KEY_BACKSPACE, KEY_DELETE:
   575				_try_remove(cursor)
   576			KEY_SPACE, KEY_TAB:
   577				_on_start()
   578			KEY_ESCAPE:
   579				_request_leave()
