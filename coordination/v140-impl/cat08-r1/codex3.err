   441	## 1.2.0 §11.1 部署工具的鍵（格子 M、Shift＋←→；自由 A；兩種 L）
   442	func _place_tool_key(k: int) -> bool:
   443		match k:
   444			KEY_M:
   445				return call("_deploy_tool", "flip")
   446			KEY_A:
   447				return call("_deploy_tool", "align")
   448			KEY_L:
   449				return call("_deploy_tool", "last")
   450			KEY_RIGHT, KEY_LEFT:
   451				if Input.is_key_pressed(KEY_SHIFT):
   452					return call("_deploy_tool", "fwd" if k == KEY_RIGHT else "back")
   453		return false
