diff --git a/game/scripts/ui/screens/game_menus.gd b/game/scripts/ui/screens/game_menus.gd
index 7650bf8..2f714d4 100644
--- a/game/scripts/ui/screens/game_menus.gd
+++ b/game/scripts/ui/screens/game_menus.gd
@@ -98,6 +98,14 @@ func _stick_repeat(delta: float) -> void:
 			d.x = nv
 		else:
 			d.y = nv
+	if d != Vector2i.ZERO and call("ov_trans_k") < 1.0:
+		set("_ov_t", float(get("time")) - 1.0)   # 1.4.0：轉場中推搖桿（和移焦同一個門檻）＝跳過
+		set("trans_stick_eat", true)
+	if get("trans_stick_eat") == true:
+		_stick_dir = d   # 回中之前不送方向（開頁前就推著的也一樣，Codex cat08 r2 #2）
+		if d == Vector2i.ZERO:
+			set("trans_stick_eat", false)
+		return
 	if d != _stick_dir:
 		_stick_dir = d
 		_stick_t = 0.35
diff --git a/game/scripts/ui/screens/game_modes.gd b/game/scripts/ui/screens/game_modes.gd
