   278	
   279	
   280	## 塗兵（佇列命令）：按住拖過格子連續擺。
   281	func _paint_cmd(p: Vector2) -> void:
   282		call("vol_motion", p)   # 1.3.0：音量木軌拖曳中（沒在拖就什麼都不做）
   283		if drag_from.x >= 0 and p.distance_to(drag_press_p) >= 10.0:
   284			drag_moved = true   # V1.5.1：拖出去過就不算「點一下」（拖回原點也一樣，Codex v151-i3）
   285		if _is_free():
   286			if overlay == "":
   287				_fp_motion(p)
   288			return
   289		if state != St.PLACE or overlay != "" or not painting:
   290			return
   291		if _cur_army().team != paint_team:
   292			painting = false
   293			return
   294		var c := _cell_at(p)
   295		if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   296			_try_place(c)
   297	
   298	
   299	
   300	var drag_press_p := Vector2.ZERO
   301	var drag_moved := false
   302	
   303	func _mb_release_cleanup() -> void:
   304		call("vol_release")   # 1.3.0：過期的放開也結束音量拖曳（並存檔）
   305		_fp_abort_drag()
   306		drag_new = false
   307		painting = false
   308		drag_from = Vector2i(-1, -1)
   309	
   310	
   311	
   312	## 滑鼠按鍵（佇列命令，第三輪 A2）：按鈕點擊、擺放、拖曳、移除。
   313	var dbl_eat := false
   314	var intro_eat := false   # 1.3.0 §13
   315	
   316	## 1.3.0 §2：雙擊回全景只認盤面範圍（按鈕列、HUD 不算）。
   317	func _field_hit(p: Vector2) -> bool:
   318		if p.y <= 96.0 or p.y >= (640.0 if _replay_controls_active() else 760.0):
   319			return false
   320		for b in _btns:
   321			if (b["r"] as Rect2).has_point(p):
   322				return false   # 按鈕上雙擊不算（Codex cat06 #4）
   323		var lo: Vector2 = _cam * ORIGIN
   324		var hi: Vector2 = _cam * (ORIGIN + fld_size)
   325		return Rect2(lo, hi - lo).has_point(p)
   326	
   327	func _mb_cmd(d: Dictionary) -> void:
   328		var mb := InputEventMouseButton.new()
   329		mb.button_index = d["i"]
   330		mb.pressed = d["pressed"]
   331		mb.position = d["pos"]
   332		mouse = d["pos"]
   333		var eat_dbl := false
   334		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   335			eat_dbl = dbl_eat   # 雙擊回全景那次的放開：不論走哪條路都要清掉（Codex cat06 #4）
   336			dbl_eat = false
   337		if state == St.BATTLE and overlay == "" and mb.pressed:
   338			mag_hide = follow_id   # 1.3.0 §2：任何按下都先收起放大鏡（點到兵會在放開時重新選）
   339			hl_reel.clear()        # 精華三連播放中動了就停在這裡（交還手動）
   340			if mb.button_index == MOUSE_BUTTON_WHEEL_UP or mb.button_index == MOUSE_BUTTON_WHEEL_DOWN:
   341				cam_wheel(mb.button_index == MOUSE_BUTTON_WHEEL_UP, mouse)   # 滾輪縮放
   342				return
   343			if mb.button_index == MOUSE_BUTTON_LEFT and bool(d.get("dbl", false)) and _field_hit(mouse):
   344				cam_reset()   # 雙擊盤面回全景
   345				dbl_eat = true
   346				return
   347		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and bool(call("vol_press", mouse)):
   348			return   # 1.3.0：在音量木軌上按下＝開始拖
   349		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed and bool(call("vol_release")):
   350			_mb_release_cleanup()
   351			return   # 拖完放開：存檔，不再觸發數值鈕
   352		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   353			if _do_click(mouse) > 0:
   354				_mb_release_cleanup()
   355				return
   356		if state == St.PLACE and overlay == "" and mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and _v16_place_click(mouse):
   357			return   # V1.6 #6：標記模式
   358		if state == St.PLACE and overlay == "" and _fp_mb(d):
   359			return   # 第六輪：自由排兵處理掉了
   360		if overlay != "" or state != St.PLACE:
   361			if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
   362				_mb_release_cleanup()
   363				if overlay == "" and state == St.BATTLE and mb.button_index == MOUSE_BUTTON_LEFT:
   364					if not eat_dbl:   # 雙擊回全景的那次放開不再選兵
   365						_battle_click(mouse)   # 重播時點兵讓鏡頭跟（第三輪 F2）
   366			return
   367		var c := _cell_at(mouse)
   368		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   369			var k := _card_at(mouse)
   370			if k >= 0 and _card_help_rect(k).has_point(mouse):
   371				return   # 放開時由「?」按鈕處理
   372			if k >= 0:
   373				if _allowed(k):
   374					selected = k
   375					drag_new = true
   376					sfx.play("k_click", 0.7)
   377				else:
   378					_toast(L.t("err_type"), true)
   379				return
   380			if c.x < 0:
   381				return
   382			if _can_edit_existing() and _cur_army().index_at(c.x, c.y) != -1:
   383				if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
   384					_toast(L.t("err_locked"), true)
   385					return
   386				if mode == Mode.VS_AI and bool(call("wave_is_locked", c)):
   387					_toast(L.t("wv_locked"), true)   # V1.4 #11：車輪戰殘兵不能搬
   388					return
   389				drag_from = c
   390				drag_moved = false
   391				drag_press_p = mouse   # V1.5.1：記下按下的位置，放開時分辨「點一下」和「拖出去又拖回來」（Codex v151-i2 #2）
   392			else:
   393				painting = Save.s("place_mode") != "tap"   # V1.5.1 C3：點選擺放不連續塗
   394				paint_team = _cur_army().team
   395				_try_place(c)
   396		elif mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   397			if drag_new and c.x >= 0:
   398				_try_place(c)
   399			elif drag_from.x >= 0:
   400				if c.x < 0:
   401					_try_remove(drag_from)
   402				elif c == drag_from and Save.s("place_mode") == "tap" and not drag_moved and mouse.distance_to(drag_press_p) < 10.0:
   403					_try_remove(drag_from)   # V1.5.1 C4：只點選模式點一下自己的兵＝拿掉（觸控不用長按）
   404				elif c != drag_from:
   405					if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() >= gauntlet_changes:
   406						_toast(L.t("err_changes"), true)
   407					elif not _cur_army().move(drag_from.x, drag_from.y, c.x, c.y):
   408						_toast(L.t("err_zone"), true)
   409					else:
   410						sfx.play("place_light")

