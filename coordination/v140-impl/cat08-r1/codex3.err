    83	
    84	func _stick_repeat(delta: float) -> void:
    85		if _is_free() and overlay == "":
    86			_fp_pad_process(delta, Vector2(stick[JOY_AXIS_LEFT_X], stick[JOY_AXIS_LEFT_Y]))   # 第六輪：平滑游標
    87			return
    88		var d := _stick_dir
    89		for ax in [JOY_AXIS_LEFT_X, JOY_AXIS_LEFT_Y]:
    90			var v: float = stick[ax]
    91			var cur: int = d.x if ax == JOY_AXIS_LEFT_X else d.y
    92			var nv := cur
    93			if absf(v) > int(Save.s("deadzone")) / 100.0 + 0.25:   # V1.5.1：觸發門檻＝死區＋25%（原本 maxf(0.6, …) 讓 5～40% 的設定都被 0.6 吃掉）
    94				nv = 1 if v > 0 else -1
    95			elif absf(v) < int(Save.s("deadzone")) / 100.0:
    96				nv = 0
    97			if ax == JOY_AXIS_LEFT_X:
    98				d.x = nv
    99			else:
   100				d.y = nv
   101		if d != Vector2i.ZERO and call("ov_trans_k") < 1.0:
   102			set("_ov_t", float(get("time")) - 1.0)   # 1.4.0：轉場中推搖桿（和移焦同一個門檻）＝跳過
   103			set("trans_stick_eat", true)
   104		if get("trans_stick_eat") == true:
   105			_stick_dir = d   # 回中之前不送方向（開頁前就推著的也一樣，Codex cat08 r2 #2）
   106			if d == Vector2i.ZERO:
   107				set("trans_stick_eat", false)
   108			return
   109		if d != _stick_dir:
   110			_stick_dir = d
   111			_stick_t = 0.35
   112			_stick_fire()
   113		elif d != Vector2i.ZERO:
   114			_stick_t -= delta
   115			if _stick_t <= 0.0:
   116				_stick_t += 0.12
   117				_stick_fire()
   118	
   119	
   120	func _stick_fire() -> void:
   121		if _stick_dir.x != 0:
   122			_enqueue("key", KEY_RIGHT if _stick_dir.x > 0 else KEY_LEFT)
   123		if _stick_dir.y != 0:
   124			_enqueue("key", KEY_DOWN if _stick_dir.y > 0 else KEY_UP)
   125	
