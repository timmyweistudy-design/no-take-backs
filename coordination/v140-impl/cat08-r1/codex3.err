   165	func _keys_input(ev: InputEvent) -> bool:
   166		if keys_capture == "":
   167			return false
   168		var part := keys_capture.split(":")
   169		if ev is InputEventKey and ev.pressed and not ev.echo:
   170			if ev.keycode != KEY_ESCAPE and part[0] == "kb":
   171				if not Keymap.can_bind_key(ev.keycode):
   172					_toast(L.t("keys_reserved"), true)
   173					return true
   174				Save.settings["keys"] = Keymap.rebind(Keymap.ACTIONS, Save.s("keys"), part[1], ev.keycode)
   175				Save.save_settings()
   176			keys_capture = ""
   177			return true
   178		if ev is InputEventJoypadButton and ev.pressed and part[0] == "pad":
   179			if not Keymap.can_bind_pad(ev.button_index):
   180				_toast(L.t("keys_reserved"), true)
   181				return true
   182			Save.settings["pad"] = Keymap.rebind(Keymap.PAD_ACTIONS, Save.s("pad"), part[1], ev.button_index)
   183			Save.save_settings()
   184			keys_capture = ""
   185			return true
   186		return ev is InputEventKey or ev is InputEventJoypadButton
