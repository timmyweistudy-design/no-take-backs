   583	func _throttle_when_minimized() -> void:
   584		var mini: bool = DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_MINIMIZED
   585		if mini != _was_minimized:
   586			_was_minimized = mini
   587			if mini:
   588				Engine.max_fps = 10
   589			else:
   590				call("_apply_display")   # V1.5：還原時回到玩家設定的幀率上限，不是無上限（Antigravity v150-i1 #4）
   591	
   592	
   593	
   594	func _process(delta: float) -> void:
   595		_throttle_when_minimized()
   596		intro_tick(delta)   # 1.3.0 §13
   597		bg.reap()   # 1.1.0 N6：收掉已叫停、已停下的背景工作
   598		_rv_poll()
   599		_settings_hover()
   600		_v16_tick(delta)   # V1.6：漏斗里程碑、背景工作
   601		var _t0 := Time.get_ticks_usec()
   602		_process_inner(delta)
   603		perf_proc_us = Time.get_ticks_usec() - _t0
   604	
   605	
   606	var rumble_seen := 0.0
   607	
   608	## ── V1.4 #18 觸控：點＝左鍵（引擎把觸控模擬成滑鼠）、長按 0.5 秒＝右鍵（拿掉兵）、雙指捏合＝縮放戰場 ──
   609	const LONG_PRESS := 0.5
   610	var touches := {}            # 手指編號 → 位置
   611	var lp_t := -1.0             # 長按計時（-1＝沒有在算）
   612	var lp_pos := Vector2.ZERO
   613	
   614	func _touch_input(ev: InputEvent) -> void:
   615		if ev is InputEventScreenTouch:
   616			if ev.pressed:
   617				touches[ev.index] = ev.position
   618			else:
   619				touches.erase(ev.index)
   620			lp_t = 0.0 if (ev.pressed and touches.size() == 1 and overlay == "") else -1.0   # 覆蓋層（例如軍令時間軸）不用長按，免得拖曳變右鍵
   621			lp_pos = ev.position
   622			return
   623		if ev is InputEventScreenDrag:
   624			var old: Vector2 = touches.get(ev.index, ev.position)
   625			touches[ev.index] = ev.position
   626			if lp_t >= 0.0 and ev.position.distance_to(lp_pos) > 12.0:
   627				lp_t = -1.0   # 拖動了就不是長按
   628			if touches.size() == 2 and (state == St.BATTLE or state == St.RESULT):
   629				var ks := touches.keys()
   630				var other: Vector2 = touches[ks[0] if ks[1] == ev.index else ks[1]]
   631				var d0: float = old.distance_to(other)
   632				var d1: float = ev.position.distance_to(other)
   633				if d0 > 8.0:
   634					_pinch_by(d1 / d0, (ev.position + other) / 2.0)
   635	
   636	func _pinch_by(f: float, at: Vector2) -> void:
   637		pinch_zoom = clampf(pinch_zoom * f, 1.0, 2.0)
   638		pinch_center = _fld_xf().affine_inverse() * at
   639	
   640	func _touch_tick(delta: float) -> void:
   641		if lp_t < 0.0:
   642			return
   643		lp_t += delta
   644		if lp_t >= float(Save.s("long_press")):
   645			lp_t = -1.0
   646			# 長按：取消左鍵的拖曳，改送一次右鍵（擺陣時拿掉兵；其他畫面右鍵本來就是返回／取消）
   647			drag_new = false
   648			painting = false
   649			drag_from = Vector2i(-1, -1)
   650			if _is_free():
   651				_fp_abort_drag()
   652			_enqueue("mb", {"i": MOUSE_BUTTON_RIGHT, "pressed": true, "pos": lp_pos})
   653			_enqueue("mb", {"i": MOUSE_BUTTON_RIGHT, "pressed": false, "pos": lp_pos})
   654			Input.vibrate_handheld(30)
   655	
   656	func _process_inner(delta: float) -> void:
   657		if shot_dir != "" and bool(get("shot_fixed")):
   658			delta = 1.0 / 60.0   # 1.2.0 §14.6：視覺回歸模式（--shot-fixed）用固定幀時間；一般版面檢查照真實時間（Codex cat01 #6）
   659		_touch_tick(delta)
   660		_pad_clear_tick()
   661		_stick_repeat(delta)
   662		_process_cmds()
   663		time += delta
   664		call("_gif_tick", delta)   # V1.4 #14
   665		if paused and key_t > 0.0:
   666			key_t += delta
   667		if paused and float(last_kill[1]) > 0.0:
   668			last_kill[1] = float(last_kill[1]) + delta   # 暫停時定格與歡呼波浪也凍結   # V1.3 C4：暫停時關鍵時刻的演出凍結（Codex v130-impl2）
   669		SteamApi.run_callbacks()
   670		if toast_t > 0:
   671			toast_t -= delta
   672		# V1.5：手把震動跟著鏡頭震動（強度可調、0 關掉；只在用手把時）
   673		if shake > rumble_seen + 0.05 and pad_mode and int(Save.s("rumble")) > 0:
   674			var rk: float = clampf(shake * 4.0, 0.2, 1.0) * int(Save.s("rumble")) / 100.0
   675			Input.start_joy_vibration(last_joy, 0.3 * rk, 0.6 * rk, 0.18)
   676		rumble_seen = shake
   677		if removed_banner_t > 0.0:
   678			removed_banner_t -= delta
   679		if ach_t > 0:
   680			ach_t -= delta
   681		elif not ach_queue.is_empty():
   682			toast = ach_queue.pop_front()
   683			toast_t = 2.5
   684			ach_t = 2.6
   685		shake = maxf(0.0, shake - delta)
   686		if not freeze_fx:
   687			for f in fx:
   688				f["t"] += delta
   689				if f.has("pop"):
   690					f["pop"] = maxf(0.0, f["pop"] - delta)
   691			fx = fx.filter(func(f): return f["t"] < f["dur"])
   692			if _frags_on():
   693				frags.step(delta)
   694			else:
   695				frags.clear()   # 戰鬥中切減少特效／簡化／4 倍速：舊碎片也收掉（Codex cat09 #3）
   696			clutch_t = maxf(0.0, clutch_t - delta)
   697		for g in dying:
   698			var t0: float = g["t"]
   699			g["t"] += delta
   700			if t0 < 1.0 and g["t"] >= 1.0:   # 只在跨過 1 秒那一幀插旗（倒棋留 1.7 秒，Codex v130-impl1）
    65		for i in Keymap.ACTIONS.size():
    66			var act: String = Keymap.ACTIONS[i][0]
    67			var y := y0 + i * 50
    68			_text(Vector2(240, y + 8), L.t("key_" + act), tz("S"), Color.WHITE, false, false, 200)
    69			var cap := keys_capture == "kb:" + act
    70			_btn(Rect2(450, y, 170, 42), "…" if cap else Keymap.key_name(kt, act), func(): keys_capture = "kb:" + act)
    71		for i2 in Keymap.PAD_ACTIONS.size():
    72			var act2: String = Keymap.PAD_ACTIONS[i2][0]
    73			var y2 := y0 + i2 * 50
    74			_text(Vector2(690, y2 + 8), L.t("key_" + act2), tz("S"), Color.WHITE, false, false, 200)
    75			var cap2 := keys_capture == "pad:" + act2
    76			_btn(Rect2(900, y2, 150, 42), "…" if cap2 else _pk(act2), func(): keys_capture = "pad:" + act2)
    77		if keys_capture != "":
    78			_text(Vector2(640, 610), L.t("keys_press"), tz("B"), ACCENT, true, true, 800)
    79		_btn(Rect2(380, 672, 240, 44), L.t("keys_reset"), func(): Save.settings["keys"] = {}; Save.settings["pad"] = {}; Save.save_settings())
    80		_btn(Rect2(660, 672, 240, 44), L.t("back"), func(): keys_capture = ""; overlay = "settings")
    81	
