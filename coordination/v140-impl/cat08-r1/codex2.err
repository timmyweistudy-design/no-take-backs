   279	## 塗兵（佇列命令）：按住拖過格子連續擺。
   280	func _paint_cmd(p: Vector2) -> void:
   281		call("vol_motion", p)   # 1.3.0：音量木軌拖曳中（沒在拖就什麼都不做）
   282		if drag_from.x >= 0 and p.distance_to(drag_press_p) >= 10.0:
   283			drag_moved = true   # V1.5.1：拖出去過就不算「點一下」（拖回原點也一樣，Codex v151-i3）
   284		if _is_free():
   285			if overlay == "":
   286				_fp_motion(p)
   287			return
   288		if state != St.PLACE or overlay != "" or not painting:
   289			return
   290		if _cur_army().team != paint_team:
   291			painting = false
   292			return
   293		var c := _cell_at(p)
   294		if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   295			_try_place(c)
   296	
   297	
   298	
   299	var drag_press_p := Vector2.ZERO
   300	var drag_moved := false
