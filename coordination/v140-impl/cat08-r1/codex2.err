   302	func _mb_release_cleanup() -> void:
   303		call("vol_release")   # 1.3.0：過期的放開也結束音量拖曳（並存檔）
   304		_fp_abort_drag()
   305		drag_new = false
   306		painting = false
   307		drag_from = Vector2i(-1, -1)
