   311	## 滑鼠按鍵（佇列命令，第三輪 A2）：按鈕點擊、擺放、拖曳、移除。
   312	var dbl_eat := false
   313	var intro_eat := false   # 1.3.0 §13
   314	
   315	## 1.3.0 §2：雙擊回全景只認盤面範圍（按鈕列、HUD 不算）。
   316	func _field_hit(p: Vector2) -> bool:
   317		if p.y <= 96.0 or p.y >= (640.0 if _replay_controls_active() else 760.0):
   318			return false
   319		for b in _btns:
   320			if (b["r"] as Rect2).has_point(p):
   321				return false   # 按鈕上雙擊不算（Codex cat06 #4）
   322		var lo: Vector2 = _cam * ORIGIN
   323		var hi: Vector2 = _cam * (ORIGIN + fld_size)
   324		return Rect2(lo, hi - lo).has_point(p)
   325	
   326	func _mb_cmd(d: Dictionary) -> void:
   327		var mb := InputEventMouseButton.new()
   328		mb.button_index = d["i"]
   329		mb.pressed = d["pressed"]
   330		mb.position = d["pos"]
   331		mouse = d["pos"]
   332		var eat_dbl := false
   333		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   334			eat_dbl = dbl_eat   # 雙擊回全景那次的放開：不論走哪條路都要清掉（Codex cat06 #4）
   335			dbl_eat = false
   336		if state == St.BATTLE and overlay == "" and mb.pressed:
   337			mag_hide = follow_id   # 1.3.0 §2：任何按下都先收起放大鏡（點到兵會在放開時重新選）
   338			hl_reel.clear()        # 精華三連播放中動了就停在這裡（交還手動）
   339			if mb.button_index == MOUSE_BUTTON_WHEEL_UP or mb.button_index == MOUSE_BUTTON_WHEEL_DOWN:
   340				cam_wheel(mb.button_index == MOUSE_BUTTON_WHEEL_UP, mouse)   # 滾輪縮放
   341				return
   342			if mb.button_index == MOUSE_BUTTON_LEFT and bool(d.get("dbl", false)) and _field_hit(mouse):
   343				cam_reset()   # 雙擊盤面回全景
   344				dbl_eat = true
   345				return
   346		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and bool(call("vol_press", mouse)):
   347			return   # 1.3.0：在音量木軌上按下＝開始拖
   348		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed and bool(call("vol_release")):
   349			_mb_release_cleanup()
   350			return   # 拖完放開：存檔，不再觸發數值鈕
   351		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   352			if _do_click(mouse) > 0:
   353				_mb_release_cleanup()
   354				return
   355		if state == St.PLACE and overlay == "" and mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and _v16_place_click(mouse):
   356			return   # V1.6 #6：標記模式
   357		if state == St.PLACE and overlay == "" and _fp_mb(d):
   358			return   # 第六輪：自由排兵處理掉了
   359		if overlay != "" or state != St.PLACE:
   360			if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
   361				_mb_release_cleanup()
   362				if overlay == "" and state == St.BATTLE and mb.button_index == MOUSE_BUTTON_LEFT:
   363					if not eat_dbl:   # 雙擊回全景的那次放開不再選兵
   364						_battle_click(mouse)   # 重播時點兵讓鏡頭跟（第三輪 F2）
   365			return
   366		var c := _cell_at(mouse)
   367		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   368			var k := _card_at(mouse)
   369			if k >= 0 and _card_help_rect(k).has_point(mouse):
   370				return   # 放開時由「?」按鈕處理
   371			if k >= 0:
   372				if _allowed(k):
   373					selected = k
   374					drag_new = true
   375					sfx.play("k_click", 0.7)
   376				else:
   377					_toast(L.t("err_type"), true)
   378				return
   379			if c.x < 0:
   380				return
   381			if _can_edit_existing() and _cur_army().index_at(c.x, c.y) != -1:
   382				if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
   383					_toast(L.t("err_locked"), true)
   384					return
   385				if mode == Mode.VS_AI and bool(call("wave_is_locked", c)):
   386					_toast(L.t("wv_locked"), true)   # V1.4 #11：車輪戰殘兵不能搬
   387					return
   388				drag_from = c
   389				drag_moved = false
   390				drag_press_p = mouse   # V1.5.1：記下按下的位置，放開時分辨「點一下」和「拖出去又拖回來」（Codex v151-i2 #2）
   391			else:
   392				painting = Save.s("place_mode") != "tap"   # V1.5.1 C3：點選擺放不連續塗
   393				paint_team = _cur_army().team
   394				_try_place(c)
   395		elif mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   396			if drag_new and c.x >= 0:
   397				_try_place(c)
   398			elif drag_from.x >= 0:
   399				if c.x < 0:
   400					_try_remove(drag_from)
   401				elif c == drag_from and Save.s("place_mode") == "tap" and not drag_moved and mouse.distance_to(drag_press_p) < 10.0:
   402					_try_remove(drag_from)   # V1.5.1 C4：只點選模式點一下自己的兵＝拿掉（觸控不用長按）
   403				elif c != drag_from:
   404					if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() >= gauntlet_changes:
   405						_toast(L.t("err_changes"), true)
   406					elif not _cur_army().move(drag_from.x, drag_from.y, c.x, c.y):
   407						_toast(L.t("err_zone"), true)
   408					else:
   409						sfx.play("place_light")
   410			drag_new = false
   411			painting = false
   412			drag_from = Vector2i(-1, -1)
   413		elif mb.button_index == MOUSE_BUTTON_RIGHT and mb.pressed and c.x >= 0:
   414			_try_remove(c)
