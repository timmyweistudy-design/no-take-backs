   418	## 1.2.0 第 11 大類：手把的部署工具＝按住 RT（右扳機，原本沒用到）＋Y 翻轉（自由：對齊）、＋十字 ←／→ 整軍後退／前進、＋LB 複製上一陣。
   419	## 這裡的 Y、LB 是改鍵換算後的預設鍵（_input 先做 pad_to_default）：改了「暫停」「上一種」的綁定就跟著換，提示也照綁定顯示。
   420	## 不能用的情況（工具不開放、不是擺陣）照原本的按鍵處理。
   421	func _pad_tool(ev: InputEventJoypadButton) -> bool:
   422		if state != St.PLACE or overlay != "" or Input.get_joy_axis(ev.device, JOY_AXIS_TRIGGER_RIGHT) < 0.5:
   423			return false
   424		var id := ""
   425		match ev.button_index:
   426			JOY_BUTTON_Y:
   427				id = "align" if _is_free() else "flip"
   428			JOY_BUTTON_DPAD_RIGHT:
   429				id = "" if _is_free() else "fwd"
   430			JOY_BUTTON_DPAD_LEFT:
   431				id = "" if _is_free() else "back"
   432			JOY_BUTTON_LEFT_SHOULDER:
   433				id = "last"
   434		if id == "" or not bool(call("_deploy_tools_ok")):
   435			return false
   436		pad_mode = true
   437		_enqueue("tool", id)   # 和落子、放開、開戰同一個佇列（不然會插到前面還沒處理的拖曳之前；Codex cat11 #3）
   438		return true
   439	
   440	## 1.2.0 §11.1 部署工具的鍵（格子 M、Shift＋←→；自由 A；兩種 L）
   441	func _place_tool_key(k: int) -> bool:
   442		match k:
   443			KEY_M:
   444				return call("_deploy_tool", "flip")
   445			KEY_A:
   446				return call("_deploy_tool", "align")
   447			KEY_L:
   448				return call("_deploy_tool", "last")
   449			KEY_RIGHT, KEY_LEFT:
   450				if Input.is_key_pressed(KEY_SHIFT):
   451					return call("_deploy_tool", "fwd" if k == KEY_RIGHT else "back")
   452		return false
   453	
   454	func _key(k: int) -> void:
   455		_toast_dismiss()
   456		if state == St.BATTLE:
   457			mag_hide = follow_id   # 1.3.0 §2：任何按鍵 1 幀內收起放大鏡
   458			hl_reel.clear()        # 精華三連：按鍵＝交還手動（Codex cat06 #6）
   459		if state == St.RESULT and _ink_active():
   460			result_t -= INK_DUR   # 1.2.0 §9.4：任何按鍵跳過宣紙戰報演出
   461			return
   462		if state == St.PLACE and overlay == "" and _v16_place_key(k):
   463			return
   464		if state == St.PLACE and overlay == "" and _place_tool_key(k):
   465			return
   466		if state == St.PLACE and _fp_key(k):
   467			return
   468		if state == St.BATTLE and overlay == "" and _cmd_key(k):
   469			return
   470		if state == St.BATTLE and overlay == "" and (k == KEY_BRACKETLEFT or k == KEY_BRACKETRIGHT) and _replay_controls_active():

