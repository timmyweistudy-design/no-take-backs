  1541					return
  1542				var col := Color("#3a2416") if kind == "ebony" else (Color("#8a8f93") if kind == "tin" else (Color("#8b4f2a") if kind == "trunk" else wood))   # 牛皮偏紅褐，和木頭分開
  1543				var lid := Rect2(r.position - Vector2(10, 10), Vector2(r.size.x + 20, h + 10))
