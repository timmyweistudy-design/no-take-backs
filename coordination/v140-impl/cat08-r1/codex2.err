  1532	func _obj_open_anim(r: Rect2, kind: String, k: float) -> void:
  1533		kind = str(OBJ_ANIM.get(kind, kind))
  1534		var e := 1.0 - (1.0 - k) * (1.0 - k) * (1.0 - k)   # ease out
