diff --git a/game/tests/suites/ui.gd b/game/tests/suites/ui.gd
index c6f66b5..ddb58f5 100644
--- a/game/tests/suites/ui.gd
+++ b/game/tests/suites/ui.gd
@@ -1857,3 +1857,77 @@ func test_vessels_curtain_v140() -> void:
 	var d := {"lobby_stamps": "x"}
 	SV.sanitize_data(d)
 	ok(d["lobby_stamps"] == 0, "手帳印跡存檔驗型")
+
+
+## 1.4.0 第 8 大類：器物從桌上的固定位置滑進來（方案 §2.2）
+func test_transition_v140() -> void:
+	var GS = load("res://scripts/ui/game_screens.gd")
+	var g = GS.new()
+	g.shot_dir = ""
+	g.layout_probe = false
+	g.overlay = "codex"
+	g.time = 10.0
+	g._ov_t = 10.0
+	var Save = load("res://scripts/game/save.gd")
+	var keep := {}
+	for k in ["reduce_fx", "reduce_motion", "plain_ui"]:
+		keep[k] = Save.s(k)
+		Save.settings[k] = false
+	ok(g.ov_trans_k() == 0.0 and g.ov_slide_offset() == GS.SLIDE_FROM["codex"], "剛打開：在桌上的起點（圖鑑從下面）")
+	g.time = 10.0 + GS.SLIDE_SEC * 0.5
+	ok(g.ov_trans_k() > 0.0 and g.ov_trans_k() < 1.0, "轉場中")
+	var press := InputEventMouseButton.new()
+	press.button_index = MOUSE_BUTTON_LEFT
+	press.pressed = true
+	ok(g._trans_gate(press) and g.ov_trans_k() == 1.0 and g.ov_slide_offset() == Vector2.ZERO, "轉場中按下＝直接到終態，這一下吃掉")
+	var mv := InputEventMouseMotion.new()
+	mv.position = Vector2(300, 300)
+	ok(not g._trans_gate(mv) and g.mouse == Vector2(300, 300), "到終態之後滑鼠移動照常")
+	var rel := InputEventMouseButton.new()
+	rel.button_index = MOUSE_BUTTON_LEFT
+	rel.pressed = false
+	ok(g._trans_gate(rel) and not g.trans_eat, "那一下的放開也吃掉（250ms 後才放開也不會點中新頁，Codex cat08 #2）")
+	ok(not g._trans_gate(rel), "之後的操作照常（不靠固定時間）")
+	g._ov_t = g.time
+	var wh := InputEventMouseButton.new()
+	wh.button_index = MOUSE_BUTTON_WHEEL_DOWN
+	wh.pressed = true
+	ok(g._trans_gate(wh), "滾輪在轉場中不捲圖鑑（跳到終態並吃掉，Codex cat08 #4）")
+	wh.pressed = false
+	g._trans_gate(wh)
+	g._ov_t = g.time
+	var mv2 := InputEventMouseMotion.new()
+	mv2.position = Vector2(500, 500)
+	ok(g._trans_gate(mv2), "轉場中的拖曳／移動不生效（音量木軌不會被拖，Codex cat08 #3）")
+	var ax := InputEventJoypadMotion.new()
+	ax.axis = JOY_AXIS_LEFT_Y
+	ax.axis_value = 1.0
+	ok(g._trans_gate(ax) and g.trans_stick_eat and g.ov_trans_k() == 1.0, "搖桿推下去＝跳過，回中之前鎖住方向（Codex cat08 #5）")
+	ax.axis_value = 0.0
+	ok(not g._trans_gate(ax), "到終態後搖桿事件照常往下傳（狀態由原本的路徑記）")
+	g.trans_stick_eat = false
+	for k2 in ["plain_ui", "reduce_fx"]:
+		g._ov_t = g.time
+		Save.settings[k2] = true
+		ok(g.ov_trans_k() == 1.0, "%s：沒有轉場" % k2)
+		Save.settings[k2] = false
+	g._ov_t = g.time
+	g.layout_probe = true
+	ok(g.ov_trans_k() == 1.0, "版面探針拍終態")
+	g.layout_probe = false
+	ok(GS.SLIDE_SEC >= 0.18 and GS.SLIDE_SEC <= 0.3, "轉場 180～300ms")
+	g._ov_t = g.time
+	Save.settings["reduce_motion"] = true
+	ok(g.ov_trans_k() == 1.0, "減少動態：沒有轉場")
+	Save.settings["reduce_motion"] = false
+	g.shot_dir = "x"
+	ok(g.ov_trans_k() == 1.0, "截圖：沒有轉場（固定畫面重拍一致）")
+	g.shot_dir = ""
+	g.overlay = "result_x"
+	ok(g.ov_trans_k() == 1.0, "沒列在表裡的疊層照舊淡入")
+	for k in keep:
+		Save.settings[k] = keep[k]
+	g.free()
+	for f in ["res://scripts/ui/lobby_view.gd", "res://scripts/ui/screens/game_modes.gd", "res://scripts/ui/ui_base.gd"]:
+		var src: String = FileAccess.get_file_as_string(f)
+		ok(src.find("draw_set_transform(Vector2.ZERO") < 0 and src.find("draw_set_transform_matrix(Transform2D.IDENTITY)") < 0, "%s 切矩陣都以 ui_xf 為底（滑動不會被蓋掉）" % f.get_file())
diff --git a/game/tools/dev_main.gd b/game/tools/dev_main.gd
index f1e2ef5..23a19d4 100644
--- a/game/tools/dev_main.gd
+++ b/game/tools/dev_main.gd
@@ -1688,6 +1688,10 @@ func _pw_check(cond: bool, what: String) -> void:
 		_pw_bad.append(what)
 
 func _pw_btn(b: int) -> void:
+	if ov_trans_k() < 1.0:
+		_ov_t = time - 1.0   # 1.4.0 §2.2：轉場中的第一下會被吃掉（設計如此）；走訪時等轉場結束再按（等於玩家等 0.25 秒）
+	trans_eat = false
+	trans_stick_eat = false
 	for pressed in [true, false]:
 		var ev := InputEventJoypadButton.new()
 		ev.button_index = b

exec
