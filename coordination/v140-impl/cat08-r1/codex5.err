  1120	
  1121	## 輸入的身分：同一顆鍵／同一個滑鼠鈕／同一根手指的按下與放開對得起來
  1122	static func trans_sig(ev: InputEvent) -> String:
  1123		if ev is InputEventKey:
  1124			return "k%d" % int(ev.physical_keycode if ev.physical_keycode != 0 else ev.keycode)
  1125		if ev is InputEventMouseButton:
  1126			return "m%d" % int(ev.button_index)
  1127		if ev is InputEventJoypadButton:
  1128			return "j%d:%d" % [ev.device, int(ev.button_index)]
  1129		if ev is InputEventScreenTouch:
  1130			return "t%d" % int(ev.index)
  1131		return ""
  1132	
  1133	## 轉場的輸入閘門（在 _input 最前面）：轉場中任何按下＝跳到終態並吃掉，連同同一個輸入的放開（含按住的連發）；
  1134	## 拖曳、滾輪、捲動、hover 在轉場中都不生效（Codex cat08 #2～#5）。回傳 true＝這個事件吃掉。
  1135	func _trans_gate(ev: InputEvent) -> bool:
  1136		var active := ov_trans_k() < 1.0
  1137		if not active and trans_eat.is_empty():
  1138			return false
  1139		if ev is InputEventMouseMotion:
  1140			mouse = ev.position
  1141			return active
  1142		if ev is InputEventJoypadMotion:
  1143			if ev.axis == JOY_AXIS_LEFT_X or ev.axis == JOY_AXIS_LEFT_Y:
  1144				stick[ev.axis] = ev.axis_value   # 狀態照記
  1145				if active and absf(ev.axis_value) >= int(Save.s("deadzone")) / 100.0:
  1146					trans_stick_eat = true   # 轉場中收到有效軸輸入當下就鎖（不靠逐幀時轉場還在；同幀再按鍵跳過也鎖著，Codex cat08 r4 #1）
  1147			return active
  1148		var sig := trans_sig(ev)
  1149		if sig == "":
  1150			return active
  1151		if ev is InputEventScreenTouch and not ev.pressed:
  1152			touches.erase(ev.index)   # 吃掉放開也要清手指狀態（不留幽靈手指、長按計時；Codex cat08 r2 #3）
  1153			lp_t = -1.0
  1154		if ev.pressed:
