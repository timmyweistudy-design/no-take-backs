    84	func _stick_repeat(delta: float) -> void:
    85		if _is_free() and overlay == "":
    86			_fp_pad_process(delta, Vector2(stick[JOY_AXIS_LEFT_X], stick[JOY_AXIS_LEFT_Y]))   # 第六輪：平滑游標
    87			return
    88		var d := _stick_dir
    89		for ax in [JOY_AXIS_LEFT_X, JOY_AXIS_LEFT_Y]:
    90			var v: float = stick[ax]
    91			var cur: int = d.x if ax == JOY_AXIS_LEFT_X else d.y
    92			var nv := cur
    93			if absf(v) > int(Save.s("deadzone")) / 100.0 + 0.25:   # V1.5.1：觸發門檻＝死區＋25%（原本 maxf(0.6, …) 讓 5～40% 的設定都被 0.6 吃掉）
    94				nv = 1 if v > 0 else -1
    95			elif absf(v) < int(Save.s("deadzone")) / 100.0:
    96				nv = 0
    97			if ax == JOY_AXIS_LEFT_X:
    98				d.x = nv
    99			else:
   100				d.y = nv
   101		if d != _stick_dir:
   102			_stick_dir = d
   103			_stick_t = 0.35
   104			_stick_fire()
   105		elif d != Vector2i.ZERO:
   106			_stick_t -= delta
   107			if _stick_t <= 0.0:
