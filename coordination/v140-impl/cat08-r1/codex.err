  1706	## 方向鍵走到第 i 顆再按 A；同時確認焦點走得到。
  1707	func _pw_pick(i: int, what: String) -> void:
  1708		await _pw_frames(2)
  1709		_pw_check(i < _btns.size(), "%s：沒有第 %d 顆按鈕（共 %d）" % [what, i, _btns.size()])
