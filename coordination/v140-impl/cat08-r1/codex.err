  1716		await _pw_frames(3)
  1717	
  1718	## 這個畫面的每顆按鈕都走得到、都在畫面內。
  1719	func _pw_cycle(what: String) -> void:
  1720		await _pw_frames(2)
  1721		var n: int = _btns.size()
  1722		_pw_check(n > 0, "%s：沒有按鈕" % what)
