   562	func _draw_lobby_presets(o: Vector2) -> void:
  1490	func _enqueue(kind: String, data) -> void:
  1491		_cmds.append({"kind": kind, "data": data, "gen": _gen})
  1492	
  1493	func _update_gen() -> void:
  1494		var key := "%d|%s|%d" % [state, overlay, mode]
  1495		if key != _gen_key:
  1496			_gen_key = key
  1497			_gen += 1
  1498	
  1499	
  1500	## 自己畫框、不走 _panel 的模態面板也要登記（R1、漏登記守衛）
  1501	func probe_panel(r: Rect2) -> void:
  1502		if layout_probe:
  1503			probe_panels.append({"id": "P%d" % probe_panels.size(), "r": r, "skip": {}})
  1504	
  1505	## 1.2.0 §1.2「一個畫面＝一個實物」：疊層 → 實物種類。只在面板外框一圈（框外 8px 到框內 10px）加裝飾、
  1506	## 面板內容區與文字底色不變（對比、版面探針不受影響）；簡化介面不畫。第 4 大類 A0。
  1507	## 1.3.0 §8 每個畫面一件器物：大廳＝對局手帳、殘局＝棋譜冊、圖鑑＝標本木箱、設定＝工匠工具箱、戰績＝獎盃架、代碼＝郵局櫃台、覆盤＝批註本（1.2.0 的經摺帖、畫筒、牛皮箱…其餘照舊）
  1508	const OBJ_OF := {"puzzles": "book", "trials": "tube", "codex": "specimen", "settings": "toolbox", "keys": "toolbox", "profile": "shelf", "nemeses": "ebony", "lobby": "notebook", "review": "annot", "owner_daily": "book",
  1509		"codes": "post", "wave_codes": "post", "songbook": "fold", "playroom": "tin", "weekly": "tin", "ghosts": "tin", "confirm": "card", "leave": "card", "pause_menu": "clock"}
  1510	var panel_obj := ""
  1775	func _panel(r: Rect2) -> void:
  1776		probe_panel(r)
  1777		_dim(0.62)
  1778		_box(Rect2(r.position + Vector2(5, 7), r.size).grow(4), Color(DIM_INK, 0.45), Color(0, 0, 0, 0), 14.0)      # 陰影（1.2.0：光源左上 → 影子往右下）
  1779		_box(r, PANEL, Color(0, 0, 0, 0), 10.0)
  1780		if not bool(Save.s("plain_ui")):
  1781			_mat_box(r.grow(-6), "walnut", Color(0.62, 0.6, 0.58))   # 1.2.0 §2：面板底是胡桃木紋（壓暗，字照樣看得清）
  1782		# V1.2 B3：深木外框＋四角銅釘（九宮格貼圖）；沒有貼圖時退回舊的細框
  1783		var fx := _ui_tex(TEX_FRAME)
  1784		if fx != null and not bool(Save.s("plain_ui")):
  1785			var sb: StyleBoxTexture = _sb_cache.get("frame")
  1786			if sb == null:
  1787				sb = StyleBoxTexture.new()
  1788				sb.texture = fx
  1789				for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
  1790					sb.set_texture_margin(side, 22.0)
  1791				sb.draw_center = false
  1792				_sb_cache["frame"] = sb
  1793			draw_style_box(sb, r.grow(8))
  1794		else:
  1795			_box(r, Color(0, 0, 0, 0), TH_EDGE, 10.0, 3.0)
  1796		if panel_obj != "" and not bool(Save.s("plain_ui")):
  1797			_obj_deco(r, panel_obj)
  1798			if layout_probe:
  1799				probe_decos.append({"id": "obj_%s" % panel_obj, "kind": "obj", "r": obj_extent(r, panel_obj), "host_r": r, "edge": "screen"})   # 1.3.0：器物裝飾不能出畫面（Codex cat08 #3）
  1800			obj_open_r = r
  1801			obj_open_kind = panel_obj
  1802	
  1803	
  1804	func _open(name: String) -> void:
  1805		if overlay.begins_with("hub_"):
  1806			nav_stack.append(overlay)   # 卡片面板開著時直接開下一頁（例如結果頁「試煉」）：記得回面板
  1807		overlay = name
  1808		_focus = 0
  1809	
  1810	## V1.5.1 返回目的地：打開下一層之前記下「從哪來」，返回鈕、Esc、手把 B 都走 _nav_back（使用者回報：返回都跳回主畫面）。
