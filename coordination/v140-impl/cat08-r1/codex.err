   662	## V1.6.1 F4：按住確認看「改鍵後」的放置／開始鍵，任何一支手把的放置鈕（原本寫死 Enter、Space、0 號手把 A）
   663	static func hold_keys_down(keys, pad) -> bool:
   664		var kt: Dictionary = keys if keys is Dictionary else {}
   665		var pt: Dictionary = pad if pad is Dictionary else {}
   666		for act in ["place", "start"]:
   667			if Input.is_key_pressed(Keymap.key_of(kt, act)):
   668				return true
   669		var pb := int(pt.get("place", JOY_BUTTON_A))
   670		for dev in Input.get_connected_joypads():
   671			if Input.is_joy_button_pressed(dev, pb):
   672				return true
   673		return false
