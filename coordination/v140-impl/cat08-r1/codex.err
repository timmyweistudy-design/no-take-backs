   243	func _draw_codex() -> void:
   244		_panel(CX_PANEL)
   245		if cx_zoom:
   246			probe_skip("R6", "圖鑑近看：中間是大圖（角色圖不經版面探針），不是空白")
   247		var u := CX.unit(cx_unit)
   248		var lang := L.lang
   249		_h1(Vector2(640, 78), L.t("codex_title"), 600)   # 1.2.0：H1 放大、再上移 4；V1.5.2 L3：緞帶上移，完整下緣到兵種分頁列 ≥16
   250		# 兵種分頁
   251		# 第四輪 §4.7：一排 10 個「頭像＋數字」頁籤；兵種全名在下面左欄的大標題
   252		# 第八輪：頁籤分兩頁（王國軍／奇幻軍），各 10 種
   253		var page_new: bool = cx_unit >= D.COUNT and cx_unit < D.total()
   254		var page_sum: bool = cx_unit >= D.total()
   255		_btn(Rect2(204, 104, 110, 38), L.t("lb_army_kingdom"), func(): _cx_pick_unit(0); cx_zoom = false, true, false, TH_ACTIVE if not page_new and not page_sum else Color(0, 0, 0, 0))
   256		_btn(Rect2(320, 104, 110, 38), L.t("lb_army_fantasy"), func(): _cx_pick_unit(D.COUNT); cx_zoom = false, true, false, TH_ACTIVE if page_new else Color(0, 0, 0, 0))
   257		var tw := (866.0 - (D.COUNT - 1) * 6.0) / D.COUNT
   258		var tab_types: Array = range(D.total(), D.total() + 2) if page_sum else range(D.COUNT if page_new else 0, (D.COUNT if page_new else 0) + D.COUNT)
   259		for t0 in tab_types.size():
   260			var t: int = tab_types[t0]
   261			var r := Rect2(204 + t0 * (tw + 6.0), 150, tw, 50)
   262			_btn(r, "", _cx_pick_unit.bind(t), true, false, TH_ACTIVE if t == cx_unit else Color(0, 0, 0, 0))
   263			if t == cx_unit:
   264				draw_rect(r.grow(1.0), ACCENT, false, 3.0)   # 第七輪 E9：選中的兵種金框
   265			_unit_in(r, t, 0, 1.0, 0.6 if t != D.CAVALRY else 0.55)   # 人物在頁籤正中間（原本腳畫到框外）
   266			# 1.4.0 §1.4：熱鍵數字改在卡片左下角的小木牌（離頭飾遠；上方沒有放書籤舌的空間，量測後改這裡），木牌是宣告的格子（R11／R12）
   267			var hk := str((t0 + 1) % 10)
   268			var hsz := tcap(tz("C"), 14)
   269			var hih := label_ink(hk, hsz, true).size.y
   270			var tgw := maxf(16.0, _width(hk, hsz, true) + 13.0)
   271			var tg := Rect2(r.position.x + 9.0, r.end.y - 9.0 - (hih + 10.0), tgw, hih + 10.0)
   272			draw_rect(Rect2(tg.position + Vector2(1, 2), tg.size), Color(DIM_INK, 0.4))
   273			draw_rect(tg, PAL.WOOD_TYPE)
   274			draw_rect(tg, PAL.WOOD_TYPE_D, false, 1.0)
   275			_probe_glyph = true
   276			probe_cell_begin(tg)
   277			_text(ink_center_p(tg, hk, hsz, true), hk, hsz, PAL.INK, true, true)
   278			probe_cell_end()
   279			_probe_glyph = false
   280		_btn(Rect2(960, 104, 110, 38), L.t("cxz_summons"), func(): _cx_pick_unit(D.COUNT * 2), true, false, TH_ACTIVE if cx_unit >= D.COUNT * 2 else Color(0, 0, 0, 0))
   281		if cx_zoom or cx_unit >= D.total():
   282			_draw_cx_zoom()
   283			_btn(Rect2(560, 676, 160, 38), L.t("back"), func(): _nav_back())
   284			return
   285		# 左欄（第三輪 U1）：可捲動區，字級＝基準×設定（150% 時正文 24px），不再縮字
   286		# 大頭照＋名字固定在上面，只有下面的屬性與文字捲動（Antigravity S3：捲動時大頭照整張消失像破圖）
   287		var items := _cx_left_items(u, lang)
   288		# 固定區的高度依名字、定位、口號實際換行後的高度決定（Antigravity S3 第 2 輪：英文 150% 口號被切）
   289		var head_min: float = float(items[0]["h"])   # V1.5：大頭照＋檢視控制鈕要整塊放得下，不然整個大頭照不畫（收尾截圖抓到）
   290		var ty := 4.0
   650				var hurt := 0.0
   651				if cx_hurt.has(u.id) and _fx_on("flash"):
   652					hurt = clampf(1.0 - (time - cx_hurt[u.id]) / 0.15, 0, 1)
   653				var face := signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
   654				_unit(p, u.type, u.team, face, (time * Gait.nominal_rate(u.type, float(D.stat(u.type)["speed"]), CS, sc) + u.id) if moving else 0.0, at, hurt, 0.45 if u.stealth > 0 else 1.0, time, sc)
   655				if u.stun > 0:
   656					_text(p + Vector2(0, -60), "◇", ts(14), Color.YELLOW, true)
   657				if u.hp < u.max_hp:
   658					var w := 24.0
   659					var top := p + Vector2(-w / 2, -52 if u.type == D.CAVALRY else -46)
   660					draw_rect(Rect2(top - Vector2(1, 1), Vector2(w + 2, 5)), Art.OUT)
   661					draw_rect(Rect2(top, Vector2(w * u.hp / u.max_hp, 3)), Art.team_color(u.team, cbm()).lightened(0.25))
   662			# 飛行物（縮到小劇場的比例：角色 0.72 倍，戰場是 UNIT_SCALE）
   663			var ps := sc / 0.92   # 戰場飛行物是照 0.92 倍角色調的固定尺寸；1.3.0 角色放大後小劇場比例不變（Codex cat04 #6）
   664			for pj in pdraw:
   665				var a0: Vector2 = pj[2] + proj_launch(int(pj[0]), float(pj[5])) * sc
   666				var b0: Vector2 = pj[3] + Vector2(0, -16.0 * ps)
   667				draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(ps, ps), 0.0, a0))
   668				_draw_projectile(int(pj[0]), int(pj[1]), Vector2.ZERO, (b0 - a0) / ps, float(pj[4]))
   669				draw_set_transform_matrix(Art.base)
   670		var drawn: Array = []
   671		for pp in cx_pops:
   672			var kk: float = pp["t"] / 1.1
   673			var q: Vector2 = _cx_map(pp["p"]) + Vector2(0, -66 - kk * 26)
   674			for dq in drawn:
   675				if dq[0] == pp["s"] and dq[1].distance_to(q) < 60.0:
   676					q.y = dq[1].y - tz("B") * 1.3   # 同一個技能字靠太近：往上疊一層，不互相蓋住
   677			if q.y < b.position.y + tz("C") * 1.5 + 6:
   678				continue   # 疊到小劇場標題列就不畫這個重複的字
   679			drawn.append([pp["s"], q])
   680			_probe_anim = true   # 小劇場的技能跳字是淡出中的特效，不算介面文字
   755	
   756	## 1.2.0 第 5 大類 B：圖鑑大圖輪流示範 5 種表情（待機 → 專注 → 生氣 → 受驚 → 得意，各 1.6 秒）；出手中固定專注；截圖固定待機。
   757	## 戰場維持原本的少數表情（小尺寸看不清）。
   758	const CX_MOODS := [0, Art.M_GRIM, Art.M_BROWS, Art.M_SURPRISE, Art.M_HAPPY]
   759	func cx_mood(atk: float) -> int:
   760		if shot_dir != "" or layout_probe or Art.back or absf(Art.turn_s) > 0.05:
   761			return 0   # 背面、轉身途中不疊表情（表情層沒有背面／轉向定位，Codex cat05 #1）
   762		if atk > 0.0:
   763			return Art.M_GRIM
   764		return int(CX_MOODS[int(time / 1.6) % CX_MOODS.size()])
   765	
   766	## V1.5.1 A6：圖鑑大圖用烘焙後處理版（外框、漬洗、乾掃和戰場一致）；簡化介面、無視窗時照舊直接畫
   767	var cx_bake = null
   768	func _cx_draw_unit(p: Vector2, face: float, atk: float, sc: float, variant: int) -> void:
   769		var mood := cx_mood(atk)
   770		if bool(Save.s("plain_ui")) or DisplayServer.get_name() == "headless":
   771			_unit(p, cx_unit, 0, face, 0.0, atk, 0.0, 1.0, time, sc, mood, 0.0, 1.0, variant)
   772			return
   773		if cx_bake == null:
   774			cx_bake = load("res://scripts/ui/codex_bake.gd").new()
   775			add_child(cx_bake)
   776		_unit_base(p, sc)
   777		cx_bake.set_params({"type": cx_unit, "face": face, "atk": atk, "hurt": 0.0, "t": time, "scale": sc, "cb": cbm(), "variant": variant,
   778			"turn_c": Art.turn_c, "turn_s": Art.turn_s, "back": Art.back, "calm": Art.calm, "look": Art.look, "mood": mood},
   779			float(Art.WASH[clampi(int(Art.paint[2]), 0, 2)]), float(Art.DRY[clampi(int(Art.paint[3]), 0, 2)]))
   780		draw_set_transform_matrix(Art.base)
   781		draw_texture(cx_bake.texture(), p - cx_bake.FEET)
