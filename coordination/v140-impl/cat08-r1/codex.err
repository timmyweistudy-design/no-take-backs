   434					var story: String = L.field(info, "story")
   435					_text(Vector2(640, cy + 4 + tz("B") * 1.5), story, tz("C"), TXT_DIM, true, false, 700)
   436					y0 = cy + 4 + tz("B") * 1.5 + text_h(story, tz("C"), 700) + GAP_M
   437					_text(Vector2(280, 690), L.t("puzzle_all_stars", [all_total, PZ.all_puzzles().size() * 3]), tz("C"), TXT_DIM, false, false, 260)
   438					if chapter_sealed(chap, stars):
   439						_wax_seal(Vector2(760, 700), 17.0)   # 1.1.0 A10：這章全部三星＝火漆印（只是裝飾，不改任何紀錄）
   440					_btn(Rect2(800, 682, 200, 36), ("✓ " if puzzle_only_open else "") + L.t("puzzle_only_open"), func(): puzzle_only_open = not puzzle_only_open)
   441					if puzzle_only_open:
   442						idx = idx.filter(func(k): return int(stars.get(list[k]["id"], 0)) < 3)
   443				var step: float = minf(82.0, (674.0 - y0) / 5.0)
   444				for k in idx.size():
   445					var i: int = idx[k]
   446					var pz: Dictionary = list[i]
   447					var r := Rect2(280 + (k % 2) * 370, y0 + (k / 2) * step, 350, step - 14)
   448					var name: String = L.field(pz, "")
   449					var st := int(stars.get(pz["id"], 0))
