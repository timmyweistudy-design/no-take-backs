   963	## ── 輸入命令佇列的執行端（第三輪 A2；S8 從 ui_base 移下來：基底不再用空函式呼叫上層）──
   964	func _process_cmds() -> int:
   965		var done := 0
   966		_update_gen()
   967		var q := _cmds
   968		_cmds = []
   969		for c in q:
   970			if c["gen"] != _gen:
   971				# 畫面已經換了：丟掉。但「放開滑鼠」一定要清掉拖曳／塗兵狀態（Codex S1 #2）
   972				if c["kind"] == "mb" and not c["data"]["pressed"]:
   973					_mb_release_cleanup()
   974				elif c["kind"] == "padbtn" and not c["data"]["pressed"]:
   975					_fp_abort_drag()   # 手把放開 A／X 的事件過期：同樣清掉（Codex 實作第 3 輪 #1）
   976				continue
   977			if c["kind"] == "click":
   978				done += _do_click(c["data"])
   979			elif c["kind"] == "mb":
   980				# 滑鼠按鍵（擺放、拖曳、移除）也走同一個佇列，和鍵盤選兵的先後順序一致（Codex S1 #2）
   981				_mb_cmd(c["data"])
   982				done += 1
   983			elif c["kind"] == "paint":
   984				_paint_cmd(c["data"])
   985			elif c["kind"] == "padbtn":
   986				if not _fp_pad_button(int(c["data"]["b"]), bool(c["data"]["pressed"])) and c["data"]["pressed"]:
   987					var mp := {JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_B: KEY_ESCAPE}
   988					if mp.has(int(c["data"]["b"])):
   989						_key(mp[int(c["data"]["b"])])
   990				done += 1
   991			elif c["kind"] == "key":
   992				_key(int(c["data"]))
   993				done += 1
   994			elif c["kind"] == "pan":
   995				cam_pan(c["data"])
   996			elif c["kind"] == "tool":
   997				if state == St.PLACE and overlay == "":
   998					call("_deploy_tool", str(c["data"]))
   999				done += 1
  1000			_update_gen()
  1001		return done
