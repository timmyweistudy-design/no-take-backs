   308	## 滑鼠按鍵（佇列命令，第三輪 A2）：按鈕點擊、擺放、拖曳、移除。
   309	var dbl_eat := false
   310	var intro_eat := false   # 1.3.0 §13
   311	
   312	## 1.3.0 §2：雙擊回全景只認盤面範圍（按鈕列、HUD 不算）。
   313	func _field_hit(p: Vector2) -> bool:
   314		if p.y <= 96.0 or p.y >= (640.0 if _replay_controls_active() else 760.0):
   315			return false
   316		for b in _btns:
   317			if (b["r"] as Rect2).has_point(p):
   318				return false   # 按鈕上雙擊不算（Codex cat06 #4）
   319		var lo: Vector2 = _cam * ORIGIN
   320		var hi: Vector2 = _cam * (ORIGIN + fld_size)
   321		return Rect2(lo, hi - lo).has_point(p)
   322	
   323	func _mb_cmd(d: Dictionary) -> void:
   324		var mb := InputEventMouseButton.new()
   325		mb.button_index = d["i"]
   326		mb.pressed = d["pressed"]
   327		mb.position = d["pos"]
   328		mouse = d["pos"]
   329		var eat_dbl := false
   330		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   331			eat_dbl = dbl_eat   # 雙擊回全景那次的放開：不論走哪條路都要清掉（Codex cat06 #4）
   332			dbl_eat = false
   333		if state == St.BATTLE and overlay == "" and mb.pressed:
   334			mag_hide = follow_id   # 1.3.0 §2：任何按下都先收起放大鏡（點到兵會在放開時重新選）
   335			hl_reel.clear()        # 精華三連播放中動了就停在這裡（交還手動）
   450	
   451	func _key(k: int) -> void:
   452		_toast_dismiss()
   453		if ov_trans_k() < 1.0 or time < _trans_hold:
   454			if ov_trans_k() < 1.0:
   455				_trans_hold = time + TRANS_HOLD   # 搖桿推著跳過：緊接著的自動連發也吃掉（不變成新頁的移動，方案 §2.5）
   456			_ov_t = time - 1.0   # 1.4.0 §2.2：轉場中按鍵＝跳到終態，這一下吃掉
   457			return
   458		if state == St.BATTLE:
   459			mag_hide = follow_id   # 1.3.0 §2：任何按鍵 1 幀內收起放大鏡
   460			hl_reel.clear()        # 精華三連：按鍵＝交還手動（Codex cat06 #6）
   461		if state == St.RESULT and _ink_active():
   462			result_t -= INK_DUR   # 1.2.0 §9.4：任何按鍵跳過宣紙戰報演出
   463			return
   464		if state == St.PLACE and overlay == "" and _v16_place_key(k):
   465			return
   466		if state == St.PLACE and overlay == "" and _place_tool_key(k):
   467			return
   468		if state == St.PLACE and _fp_key(k):
   469			return
   470		if state == St.BATTLE and overlay == "" and _cmd_key(k):
   471			return
   472		if state == St.BATTLE and overlay == "" and (k == KEY_BRACKETLEFT or k == KEY_BRACKETRIGHT) and _replay_controls_active():
   473			_bm_jump(-1 if k == KEY_BRACKETLEFT else 1)   # 1.2.0 §11.2 書籤
   474			return
   475		if state == St.BATTLE and overlay == "" and k == KEY_G and play_kind == "review" and tm_ghost != null:
   476			tm_ghost_on = not tm_ghost_on   # 1.2.0 §11.3
   477			return
   478		# 有按鈕焦點的畫面（標題、選單、結果、覆蓋層、戰鬥）：方向鍵移焦點、Enter 按下、Esc 返回
   479		if state != St.PLACE or overlay != "":
   480			match k:
   481				KEY_UP, KEY_LEFT:
   482					_move_focus(-1)
   483				KEY_DOWN, KEY_RIGHT:
   484					_move_focus(1)
   485				KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
   486					if _btns_gen == _gen and _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:   # 按鈕清單要是這個畫面的
   487						sfx.play("k_click", 0.7)
   488						_btns[_focus]["cb"].call()
   489				KEY_F1:
   490					if state == St.BATTLE and overlay == "" and play_kind != "official":
   491						call("_breport_open")   # 1.1.0 B10：手把 View／Select＝戰報面板
   492					elif state == St.BATTLE and overlay == "":
   493						set("hud_info_until", time + 2.0)   # 1.2.0 §5.6：正式對戰按 View＝叫出 AI 名稱與性格 2 秒
   494				KEY_PAGEUP, KEY_PAGEDOWN:
   495					if overlay == "codex":
   496						_scroll_by("left", -160.0 if k == KEY_PAGEUP else 160.0)
   497				KEY_P, KEY_TAB:
   498					# 手把 Y 送的是 Tab：戰鬥中＝暫停（第七輪 A6）
   499					if state == St.BATTLE and overlay == "":
   500						_toggle_pause()
   501					elif k == KEY_TAB:
   502						_move_focus(1)
   503				KEY_ESCAPE:
   504					if overlay == "ai_busy":
   505						pass      # 第十輪 I4：AI 計算中不能取消
   506					elif overlay == "first_run":
   507						Save.set_setting("first_done", true)   # V1.5：跳過第一次啟動的問題
   508						overlay = ""
   509					elif overlay == "paint":
   510						call("_paint_close")   # V1.4 #15：Esc／手把 B 也要存塗裝（Codex、Antigravity v140-i4）
   511					elif overlay == "pause_menu":
   512						call("_pause_resume")
   513					elif overlay == "settings":
   514						call("_settings_close")
   515					elif overlay == "fs_confirm":
   516						call("_fs_revert")
   517					elif overlay == "confirm":
   518						overlay = str(get("confirm_ret"))
   519					elif overlay in ["keys", "restore", "clear_data"]:
   520						set("keys_capture", "")
   521						overlay = "settings"   # 設定的子頁：Esc 回設定（不是整個關掉，Antigravity v150-i2 #4）
   522					elif overlay == "codex" and bool(get("cx_zoom")) and int(get("cx_unit")) < D.total():
   523						set("cx_zoom", false)   # V1.5.1：近看模式先收合
   524					elif overlay == "breport":
   525						call("_breport_close")   # 1.1.0 B10：回到重播、焦點與暫停狀態還原
   600		_settings_hover()
   601		_v16_tick(delta)   # V1.6：漏斗里程碑、背景工作
   602		var _t0 := Time.get_ticks_usec()
   603		_process_inner(delta)
   604		perf_proc_us = Time.get_ticks_usec() - _t0
