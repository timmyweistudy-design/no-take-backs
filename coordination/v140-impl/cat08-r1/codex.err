   276	## 塗兵（佇列命令）：按住拖過格子連續擺。
   277	func _paint_cmd(p: Vector2) -> void:
   278		call("vol_motion", p)   # 1.3.0：音量木軌拖曳中（沒在拖就什麼都不做）
   279		if drag_from.x >= 0 and p.distance_to(drag_press_p) >= 10.0:
   280			drag_moved = true   # V1.5.1：拖出去過就不算「點一下」（拖回原點也一樣，Codex v151-i3）
   281		if _is_free():
   282			if overlay == "":
   283				_fp_motion(p)
   284			return
   285		if state != St.PLACE or overlay != "" or not painting:
   286			return
   287		if _cur_army().team != paint_team:
   288			painting = false
   289			return
   290		var c := _cell_at(p)
   291		if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   292			_try_place(c)
   293	
