   877		var open_k := clampf((time - _ov_t) / 0.3, 0.0, 1.0) if ok_anim and not bool(Save.s("plain_ui")) else 1.0
   878		if obj_open_force >= 0.0:
   879			open_k = obj_open_force   # 開發截圖：固定在開到一半
   880		if open_k < 1.0 and obj_open_kind != "":
