   476					if pbest.size() == 3:
   477						note = L.t("puzzle_note_best", [int(pbest[0]), int(pz["star3"])])   # V1.4 #6：破過就顯示自己的最低花費
   478					# V1.2.1：備註放得下一行才畫（中文 150% 原本換成兩行跑出卡片）
   479					var note_y: float = r.size.y - tz("C") * 1.4 - 3.0
   480					if not tut and en and text_h(line, tz("S"), r.size.x - 72) <= tz("S") * 1.6 and _width(note, tz("C")) <= r.size.x - 132 \
   481							and note_y >= 8.0 + tz("S") * 1.25:   # 標題下面放得下才畫（英文 150% 卡片矮，不畫備註）
   482						_probe_btn_label = true
   483						_probe_btn_rect = r
   484						_text(r.position + Vector2(62, note_y), note, tz("C"), Color("#6b3a12") if last_btn_paper else Color(1, 0.9, 0.6, 0.85), false, false, r.size.x - 132)   # 1.2.0：淺色木牌／紙面上用深棕
   485						_probe_btn_label = false
