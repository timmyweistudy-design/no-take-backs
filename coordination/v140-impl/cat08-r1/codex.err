816:	Art.base = Transform2D.IDENTITY
862:		_ov_t = time
863:	var ok_anim: bool = overlay != "" and shot_dir == "" and not layout_probe and not bool(Save.s("reduce_fx"))
864:	var ok_k := clampf((time - _ov_t) / 0.18, 0.0, 1.0) if ok_anim else 1.0
868:		ui_xf = Transform2D(0.0, slide)   # 疊層裡自己切矩陣的地方都以 ui_xf 為底（不會把滑動蓋掉）
869:		Art.base = ui_xf
870:		draw_set_transform_matrix(ui_xf)
871:	_draw_overlay()
873:		ui_xf = Transform2D.IDENTITY
874:		Art.base = Transform2D.IDENTITY
875:		draw_set_transform_matrix(Transform2D.IDENTITY)
877:	var open_k := clampf((time - _ov_t) / 0.3, 0.0, 1.0) if ok_anim and not bool(Save.s("plain_ui")) else 1.0
884:	_draw_pad_footer()
