  1862	## 1.4.0 第 8 大類：器物從桌上的固定位置滑進來（方案 §2.2）
  1863	func test_transition_v140() -> void:
  1864		var GS = load("res://scripts/ui/game_screens.gd")
  1865		var g = GS.new()
  1866		g.shot_dir = ""
  1867		g.layout_probe = false
  1868		g.overlay = "codex"
  1869		g.time = 10.0
  1870		g._ov_t = 10.0
  1871		var Save = load("res://scripts/game/save.gd")
  1872		var keep := {}
  1873		for k in ["reduce_fx", "reduce_motion", "plain_ui"]:
  1874			keep[k] = Save.s(k)
  1875			Save.settings[k] = false
  1876		ok(g.ov_trans_k() == 0.0 and g.ov_slide_offset() == GS.SLIDE_FROM["codex"], "剛打開：在桌上的起點（圖鑑從下面）")
  1877		g.time = 10.0 + GS.SLIDE_SEC * 0.5
  1878		ok(g.ov_trans_k() > 0.0 and g.ov_trans_k() < 1.0, "轉場中")
  1879		g._key(KEY_DOWN)
  1880		ok(g.ov_trans_k() == 1.0 and g.ov_slide_offset() == Vector2.ZERO, "轉場中按鍵＝直接到終態，這一下被吃掉（不落到新頁）")
  1881		var ov0: String = g.overlay
  1882		g._key(KEY_ESCAPE)
  1883		ok(g.overlay == ov0, "緊接著的連發／按住也吃掉（不關掉新頁）")
  1884		g.time += GS.TRANS_HOLD + 0.01
  1885		ok(GS.SLIDE_SEC >= 0.18 and GS.SLIDE_SEC <= 0.3, "轉場 180～300ms")
  1886		g._ov_t = g.time
  1887		Save.settings["reduce_motion"] = true
  1888		ok(g.ov_trans_k() == 1.0, "減少動態：沒有轉場")
  1889		Save.settings["reduce_motion"] = false
  1890		g.shot_dir = "x"
  1891		ok(g.ov_trans_k() == 1.0, "截圖：沒有轉場（固定畫面重拍一致）")
  1892		g.shot_dir = ""
  1893		g.overlay = "result_x"
  1894		ok(g.ov_trans_k() == 1.0, "沒列在表裡的疊層照舊淡入")
  1895		for k in keep:
  1896			Save.settings[k] = keep[k]
  1897		g.free()
  1898		for f in ["res://scripts/ui/lobby_view.gd", "res://scripts/ui/screens/game_modes.gd", "res://scripts/ui/ui_base.gd"]:
  1899			var src: String = FileAccess.get_file_as_string(f)
  1900			ok(src.find("draw_set_transform(Vector2.ZERO") < 0 and src.find("draw_set_transform_matrix(Transform2D.IDENTITY)") < 0, "%s 切矩陣都以 ui_xf 為底（滑動不會被蓋掉）" % f.get_file())
