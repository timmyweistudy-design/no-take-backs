   299	func _mb_release_cleanup() -> void:
   300		call("vol_release")   # 1.3.0：過期的放開也結束音量拖曳（並存檔）
   301		_fp_abort_drag()
   302		drag_new = false
   303		painting = false
   304		drag_from = Vector2i(-1, -1)
