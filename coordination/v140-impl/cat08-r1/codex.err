  2388		draw_set_transform_matrix(Transform2D(0, Vector2(1, 0.4), 0, p + Vector2(4, 6)))
  2389		draw_circle(Vector2.ZERO, 30.0, Color(DIM_INK, 0.4 * a), true, -1.0, true)
  2390		draw_set_transform_matrix(Transform2D(0, Vector2(1, 0.4), 0, p))
  2391		draw_circle(Vector2.ZERO, 28.0, Color(PAL.TRINKET_RED.darkened(0.45), a), true, -1.0, true)
  2392		draw_circle(Vector2.ZERO, 22.0, Color(PAL.TRINKET_RED.darkened(0.25), a), true, -1.0, true)
  2393		draw_set_transform_matrix(Transform2D.IDENTITY)
  2394		var bob := 0.0 if bool(Save.s("reduce_motion")) else sin(time * 1.6) * 1.2
  2395		Art.unit(self, p + Vector2(0, -2 + bob), Persona.face(st), 1, -1.0, 0.0, 0.0, 0.0, a, time, 1.35, cbm(), mood)
  2396		# 前面一張矮茶几把腿擋住：看起來是坐在桌後的人，不是站著的兵（Hydrogen cat11 #1）
