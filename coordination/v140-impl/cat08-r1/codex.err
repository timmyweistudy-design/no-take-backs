   507	func _draw_lobby() -> void:
   508		var P := Rect2(50, 30, 1180, 740)
   509		_panel(P)
   510		probe_skip("R4", "大廳底列：左側操作組（返回、展開、隨機／代碼）靠左，右側「開始」主按鈕靠右，刻意分兩組")
   511		var title := L.t("menu_vs_ai") if lobby_kind == "ai" else L.t("menu_duel")
   512		_h1(Vector2(640, 24), title)   # 1.2.0：H1 放大，緞帶上移 4 保持和分頁的距離（R2）   # V1.5.2 L3：緞帶跨在面板上緣（和圖鑑同款），完整下緣到預設分頁 ≥16
   513		_draw_lobby_presets(Vector2(80, 96))
   514		var cy := 96.0 + lobby_tab_h() + 12.0   # 1.4.0 R12：分頁在大字級時長高（兩行字上下要留空），內容跟著往下
   515		if lobby_open:
   516			_draw_lobby_detail(Rect2(80, cy, 1120, 684.0 - cy))
   517		else:
   518			_draw_lobby_main(Rect2(80, cy, 1120, 684.0 - cy))
   519			_ink_mode = false   # 任何路徑結束都關掉紙上墨色
   520		# 底列
   521		var by := 700.0
   522		_btn(Rect2(80, by, 150, 48), L.t("back"), func(): _nav_back())
   523		_btn(Rect2(244, by, 200, 48), L.t("lb_collapse") if lobby_open else L.t("lb_expand"), func(): lobby_open = not lobby_open)
   524		if lobby_open:
   525			_btn(Rect2(458, by, 150, 48), L.t("lb_copy"), _lobby_copy_code)
   526			_btn(Rect2(620, by, 150, 48), L.t("lb_paste"), _lobby_paste_code)
   527			_btn(Rect2(782, by, 150, 48), L.t("lb_save"), _lobby_save_preset)
   528		else:
   529			_btn(Rect2(458, by, 200, 48), L.t("lb_random"), _lobby_random)
   530		var why := _lobby_block()
   531		btn_seal_square = true
   532		_btn(Rect2(966, by, 234, 48), L.t("lb_start"), _lobby_start, why == "", true)
   533		btn_seal_square = false
   534		if not bool(Save.s("plain_ui")) and not lobby_open:
   535			# 1.4.0 §1.1：每次開戰在手帳右頁右下蓋一記方印，最多留 3 記（下次打開還在）
   536			var ns := mini(3, int(Save.data.get("lobby_stamps", 0)))
   537			for k in ns:
   538				var sc := Vector2(1150.0 - k * 34.0, 660.0 - (k % 2) * 8.0)
   539				draw_set_transform_matrix(ui_xf * Transform2D(0.08 * (k - 1), sc))
   540				draw_rect(Rect2(-13, -13, 26, 26), Color(PAL.TRINKET_RED, 0.42), false, 2.5)
   541				draw_rect(Rect2(-8, -8, 16, 16), Color(PAL.TRINKET_RED, 0.26))
   542				draw_set_transform_matrix(ui_xf)
   543		if why != "":
   544			_text(Vector2(1083, by - tz("C") * 1.5), why, tz("C"), Color("#ff8a8a"), true, true, 460)
   545		if lobby_menu:
   546			_draw_lobby_menu(Vector2(1000, 186))
   547		elif not lobby_open:
   548			_boss_note("lobby", "lobby")   # 1.2.0 §12：第一次進大廳的便條
   549	
   550	## 1.4.0 R12：預設分頁高度——字級 150% 時兩行字要上下各留 max(4, 12%)，分頁從 68 長到 78。
   551	func lobby_tab_h() -> float:
   552		if tz("B") < 22:
   553			return 68.0
   554		# 只有真的有分頁要換兩行時才長高（日文改短後全部一行，就不留空，Antigravity v140 cat01 #5）
   555		var tw_min := 154.0 - 6.0 - BM_SLOT
   556		var te := tw_min - 2.0 * (maxf(6.0, tw_min * 0.06) + 1.0)
   557		for id in Presets.IDS:
   558			if wrap_lines(L.t("lb_p_" + id), fit(L.t("lb_p_" + id), tz("B"), te, true), te, true).size() > 1:
   559				return 78.0
   560		return 68.0
