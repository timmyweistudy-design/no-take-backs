   882		if ok_k < 1.0:
   883			draw_rect(Rect2(0, 0, 1280, 800), Color(0.08, 0.05, 0.03, 0.55 * (1.0 - ok_k) * (1.0 - ok_k)))
   884		_draw_pad_footer()
   885		if toast_t > 0:
   886			var a := minf(1.0, toast_t * 2)
   887			var tw := font.get_string_size(toast, HORIZONTAL_ALIGNMENT_LEFT, -1, ts(20)).x + 40
   888			var ty := 40.0 if overlay != "" else 600.0   # 覆蓋層開著時放上面；平常放在兵種提示條（y 654）上面（第四輪 Antigravity）
   889			if overlay == "" and _is_free():
   890				ty = 50.0   # 第六輪：自由擺放整個戰場都可能有兵，提示改蓋在上方的兵種說明條（Codex 實作第 3 輪 #2）
   891			draw_rect(Rect2(640 - tw / 2, ty, tw, 44), Color(0, 0, 0, (0.94 if bool(Save.s("text_plate")) else 0.72) * a))   # V1.5：高對比文字底板
   892			_text(Vector2(640, ty + 6), toast, ts(20), Color(1, 0.88, 0.5, a), true)
   893		if _focus >= _btns.size():
   894			_focus = 0
   895		_btns_gen = _gen
   896		# V9：畫面切換 0.25 秒淡入（版面檢查、簡化特效時不做）
   897		if _gen != _trans_gen:
   898			_trans_gen = _gen
   899			_trans_t = time
   900		if not layout_probe and not bool(Save.s("reduce_fx")) and time - _trans_t < 0.25:
   901			draw_rect(Rect2(0, 0, 1280, 800), Color(TH_WOOD_D, 0.9 * (1.0 - (time - _trans_t) / 0.25)))
   902		# V9：懸停音（換了一顆才響）
   903		if _hover_now != _hover_key:
   904			_hover_key = _hover_now
   905			if _hover_now >= 0 and sfx != null:
   906				sfx.play("k_hover", 0.28)
   907		_hover_now = -1
