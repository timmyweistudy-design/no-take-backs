  1005	## 點擊：只對這個畫面世代畫出來的按鈕有效。回傳執行了幾個。
  1006	## ── 1.2.0 §9.4 宣紙戰報（結果頁前 1.2 秒）──
  1007	## 盤面 0.3 秒淡成宣紙 → 陣亡點蓋 8px 朱砂小印、擊倒者到被擊倒者一道淡墨線（40%、最底層）→ 0.55 秒勝負大章蓋下 → 1.0 秒後才出結果面板。
  1008	## 點任意處／任何按鍵跳過；截圖、減少特效、重播與覆盤不播。
  1009	const INK_DUR := 1.0
  1010	func _ink_active() -> bool:
  1011		return _ink_k() < INK_DUR and (shot_dir == "" or ink_force) and not bool(Save.s("reduce_fx")) and play_kind == "official" and not bool(Save.s("plain_ui"))
  1012	
  1013	var ink_force := false   # 截圖流程專拍宣紙戰報時用
  1014	func _ink_k() -> float:
  1015		return 0.8 if ink_force else time - result_t   # 截圖專拍時停在蓋章後的瞬間（截圖等幀的實際時間不固定）
   875		var f := func(v: float) -> float: return v / 12.92 if v <= 0.04045 else pow((v + 0.055) / 1.055, 2.4)
   876		var la: float = 0.2126 * f.call(a.r) + 0.7152 * f.call(a.g) + 0.0722 * f.call(a.b)
   877		var lb: float = 0.2126 * f.call(b.r) + 0.7152 * f.call(b.g) + 0.0722 * f.call(b.b)
   878		return (maxf(la, lb) + 0.05) / (minf(la, lb) + 0.05)
   879	
   880	## V1.2：紙上墨色。灰白字→焦茶墨；亮彩字（金、綠、紅）壓暗成同色系的深色，透明度保留。
   881	static func _ink(c: Color) -> Color:
   882		var lum := c.get_luminance()
