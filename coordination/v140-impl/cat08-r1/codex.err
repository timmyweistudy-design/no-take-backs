165:func _keys_input(ev: InputEvent) -> bool:
169:	if ev is InputEventKey and ev.pressed and not ev.echo:
178:	if ev is InputEventJoypadButton and ev.pressed and part[0] == "pad":
186:	return ev is InputEventKey or ev is InputEventJoypadButton
190:func _input(ev: InputEvent) -> void:
195:	if ev is InputEventScreenTouch or ev is InputEventScreenDrag:
199:	if ev is InputEventMagnifyGesture and (state == St.BATTLE or state == St.RESULT):
202:	if ev is InputEventMouseMotion:
205:		if ev.device != InputEvent.DEVICE_ID_EMULATION:
213:	if intro_t >= 0.0 and ((ev is InputEventKey and ev.pressed) or (ev is InputEventMouseButton and ev.pressed) or (ev is InputEventJoypadButton and ev.pressed) or (ev is InputEventScreenTouch and ev.pressed)):
218:	if intro_eat and ((ev is InputEventMouseButton and not ev.pressed) or (ev is InputEventScreenTouch and not ev.pressed) or (ev is InputEventJoypadButton and not ev.pressed) or (ev is InputEventKey and not ev.pressed)):
222:	if ev is InputEventMouseButton:
229:	if state == St.BATTLE and ((ev is InputEventKey and ev.pressed) or (ev is InputEventJoypadButton and ev.pressed)):
231:	if ev is InputEventKey and ev.pressed:
237:	if ev is InputEventJoypadButton:
243:	if ev is InputEventJoypadButton:
246:			_pad_x_hold(ev.pressed)   # 1.1.0 Q1：長按拿掉鍵＝清空自己的陣
247:	if ev is InputEventJoypadButton and ev.pressed and _pad_tool(ev):
249:	if ev is InputEventJoypadButton and _is_free() and overlay != "" and not ev.pressed and ev.button_index in [JOY_BUTTON_A, JOY_BUTTON_X]:
