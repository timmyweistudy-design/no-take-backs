   265			pad_mode = true
   266			_scroll_by("left", ev.axis_value * 24.0)   # 右搖桿捲圖鑑左欄
   267			return
   268		if ev is InputEventJoypadMotion and (ev.axis == JOY_AXIS_LEFT_X or ev.axis == JOY_AXIS_LEFT_Y):
   269			# 左搖桿：只記下狀態，由 _stick_repeat 依固定節奏送方向鍵（Codex S1 #6：原本每個抖動事件都會送一次）
   270			stick[ev.axis] = ev.axis_value
   271			if absf(ev.axis_value) > 0.6:
   272				pad_mode = true
