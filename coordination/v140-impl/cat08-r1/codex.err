  2362	func seat_visible() -> bool:
  2363		if mode != Mode.VS_AI or state != St.BATTLE or view == null or bool(Save.s("plain_ui")):
  2364			return false
  2365		if str(get("ghost_id")) != "" or bool(get("wk_active")) or rift_on or watch_mode:
  2366			return false
  2367		return true
