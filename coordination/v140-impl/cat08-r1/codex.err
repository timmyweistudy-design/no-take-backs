   451					var line := "%s%d. %s" % ["✓ " if st > 0 else "", i + 1, name]   # V1.2：星數改畫圖示（不再用 ★☆ 字元，大字級不會擠出框）
   452					if pz.has("unit") and not RS.available(int(pz["unit"]), _demo()):
   453						en = false
   454						line = "%d. %s（%s）" % [i + 1, name, L.t("locked_demo")]
   455					# 第七輪：標籤靠左、讓開左邊的迷你敵陣（原本置中會被縮圖蓋住）
   456					btn_paper = st > 0   # V1.2.1 R1：已過關的卡片是紙面（未過關留木，進度一眼看得出）
   457					_btn(r, "", _pick_puzzle.bind(pz["id"], tut), en, false,
   458						Color(0.15, 0.32, 0.22) if st > 0 and plain_ui_now() else Color(0, 0, 0, 0))
   459					btn_paper = false
   460					_ink_mode = last_btn_paper
   461					_probe_dis = not last_btn_enabled
   462					_probe_btn_label = true
   463					_probe_btn_rect = r
   464					_text(r.position + Vector2(64, 8), line, tz("S"), Color.WHITE if en and last_btn_enabled else Color(1, 1, 1, 0.4), false, false, r.size.x - 72)
   465					_probe_btn_label = false
   466					if en:
   467						for ks in 3:   # 星數在右下角（和下方說明同一列，說明讓出寬度）
   468							_icon("star", Vector2(r.end.x - 55 + ks * 19, r.end.y - 24.0), 17.0, Color("#ffd166") if ks < st else Color(1, 1, 1, 0.2))   # 1.4.0 R13：離按鈕面下緣 ≥7px（量看得到的框；原本 2.8）
   469						var cde = Save.data.get("coached", {}).get(str(pz["id"]))
   470						if not tut and cde is Dictionary and (int(cde.get("lv", 0)) >= 2 or int(cde.get("ap", 0)) == 1) and int(cde.get("self", 0)) < st:   # 1.1.0：用朋友最佳解過關也算協力
   471							_icon("hint", Vector2(r.end.x - 74, r.end.y - tz("C") * 0.75), 15.0, Color("#7fd6c2"))   # V1.6.1 A4：教練協力（自力最佳比目前星數少）
   472					# 第七輪 E12：關卡鈕直接看得到預算、可用兵種、星級條件
   473					# 關卡名稱換行時（英文大字）就不再放預覽，避免互壓
