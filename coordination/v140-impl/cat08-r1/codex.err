   606	
   607	var rumble_seen := 0.0
   608	
   609	## ── V1.4 #18 觸控：點＝左鍵（引擎把觸控模擬成滑鼠）、長按 0.5 秒＝右鍵（拿掉兵）、雙指捏合＝縮放戰場 ──
   610	const LONG_PRESS := 0.5
   611	var touches := {}            # 手指編號 → 位置
   612	var lp_t := -1.0             # 長按計時（-1＝沒有在算）
   613	var lp_pos := Vector2.ZERO
   614	
   615	func _touch_input(ev: InputEvent) -> void:
   616		if ev is InputEventScreenTouch:
   617			if ev.pressed:
   618				touches[ev.index] = ev.position
   619			else:
   620				touches.erase(ev.index)
   621			lp_t = 0.0 if (ev.pressed and touches.size() == 1 and overlay == "") else -1.0   # 覆蓋層（例如軍令時間軸）不用長按，免得拖曳變右鍵
   622			lp_pos = ev.position
   623			return
   624		if ev is InputEventScreenDrag:
   625			var old: Vector2 = touches.get(ev.index, ev.position)
   626			touches[ev.index] = ev.position
   627			if lp_t >= 0.0 and ev.position.distance_to(lp_pos) > 12.0:
   628				lp_t = -1.0   # 拖動了就不是長按
   629			if touches.size() == 2 and (state == St.BATTLE or state == St.RESULT):
   630				var ks := touches.keys()
   631				var other: Vector2 = touches[ks[0] if ks[1] == ev.index else ks[1]]
   632				var d0: float = old.distance_to(other)
   633				var d1: float = ev.position.distance_to(other)
   634				if d0 > 8.0:
   635					_pinch_by(d1 / d0, (ev.position + other) / 2.0)
   636	
   637	func _pinch_by(f: float, at: Vector2) -> void:
   638		pinch_zoom = clampf(pinch_zoom * f, 1.0, 2.0)
   639		pinch_center = _fld_xf().affine_inverse() * at
   640	
   641	func _touch_tick(delta: float) -> void:
   642		if lp_t < 0.0:
   643			return
   644		lp_t += delta
   645		if lp_t >= float(Save.s("long_press")):
   646			lp_t = -1.0
   647			# 長按：取消左鍵的拖曳，改送一次右鍵（擺陣時拿掉兵；其他畫面右鍵本來就是返回／取消）
   648			drag_new = false
   649			painting = false
   650			drag_from = Vector2i(-1, -1)
   651			if _is_free():
   652				_fp_abort_drag()
   653			_enqueue("mb", {"i": MOUSE_BUTTON_RIGHT, "pressed": true, "pos": lp_pos})
   654			_enqueue("mb", {"i": MOUSE_BUTTON_RIGHT, "pressed": false, "pos": lp_pos})
   655			Input.vibrate_handheld(30)
   656	
   657	func _process_inner(delta: float) -> void:
   658		if shot_dir != "" and bool(get("shot_fixed")):
   659			delta = 1.0 / 60.0   # 1.2.0 §14.6：視覺回歸模式（--shot-fixed）用固定幀時間；一般版面檢查照真實時間（Codex cat01 #6）
   660		_touch_tick(delta)
   661		_pad_clear_tick()
   662		_stick_repeat(delta)
   663		_process_cmds()
   664		time += delta
   665		call("_gif_tick", delta)   # V1.4 #14
   666		if paused and key_t > 0.0:
   667			key_t += delta
   668		if paused and float(last_kill[1]) > 0.0:
   669			last_kill[1] = float(last_kill[1]) + delta   # 暫停時定格與歡呼波浪也凍結   # V1.3 C4：暫停時關鍵時刻的演出凍結（Codex v130-impl2）
   670		SteamApi.run_callbacks()
   671		if toast_t > 0:
   672			toast_t -= delta
   673		# V1.5：手把震動跟著鏡頭震動（強度可調、0 關掉；只在用手把時）
   674		if shake > rumble_seen + 0.05 and pad_mode and int(Save.s("rumble")) > 0:
   675			var rk: float = clampf(shake * 4.0, 0.2, 1.0) * int(Save.s("rumble")) / 100.0
   676			Input.start_joy_vibration(last_joy, 0.3 * rk, 0.6 * rk, 0.18)
   677		rumble_seen = shake
   678		if removed_banner_t > 0.0:
   679			removed_banner_t -= delta
   680		if ach_t > 0:
   681			ach_t -= delta
   682		elif not ach_queue.is_empty():
   683			toast = ach_queue.pop_front()
   684			toast_t = 2.5
   685			ach_t = 2.6
   686		shake = maxf(0.0, shake - delta)
   687		if not freeze_fx:
   688			for f in fx:
   689				f["t"] += delta
   690				if f.has("pop"):
   691					f["pop"] = maxf(0.0, f["pop"] - delta)
   692			fx = fx.filter(func(f): return f["t"] < f["dur"])
   693			if _frags_on():
   694				frags.step(delta)
   695			else:
   696				frags.clear()   # 戰鬥中切減少特效／簡化／4 倍速：舊碎片也收掉（Codex cat09 #3）
   697			clutch_t = maxf(0.0, clutch_t - delta)
   698		for g in dying:
   699			var t0: float = g["t"]
   700			g["t"] += delta
   701			if t0 < 1.0 and g["t"] >= 1.0:   # 只在跨過 1 秒那一幀插旗（倒棋留 1.7 秒，Codex v130-impl1）
   702				graves.append({"pos": g["pos"], "team": g["team"], "t": 0.0})
   703		dying = dying.filter(func(g): return g["t"] < death_life(int(g["type"])))   # V1.3 A5：倒棋留 1.7 秒
   704		for g in graves:
   705			g["t"] += delta
   706		graves = graves.filter(func(g): return g["t"] < 3.0)
   707		if overlay == "codex":
   708			_codex_tick(delta)
   709		if overlay == "ai_busy":
   710			_ai_poll()
   835				_draw_battle_hud()
   836				_draw_owner_hand()  # 1.3.0 §11 開戰前老闆替棋鐘上發條（畫在 HUD 之上，不然被木條蓋住；Codex cat11 #4）
   837				_draw_replay_controls()
   838				if sim != null and sim.cmd_on:
   839					_draw_cmd_bar()
   840				_draw_frenzy_edge()
   841				_draw_start_cue()
   842				_draw_battle_report()
   843				_draw_unit_info()
   844				_draw_bmag()   # 1.3.0 §2 銅放大鏡小窗
   845				if pre_thread != null:
   846					_draw_busy(-1)
   847				elif skip_busy:
   848					_draw_busy(roundi(view.tick * 100.0 / maxf(1.0, view.max_ticks)))
   849				elif seek_target >= 0:
   850					_draw_busy(roundi(sim.tick * 100.0 / maxf(1.0, seek_target)))
   851			St.RESULT:
   852				if not _ink_active():
   853					_draw_battle_hud()   # 宣紙戰報演出時頂部 HUD 退場（Antigravity cat03 #3）
   854				if _ink_active():
