  1724			_pw_check(Rect2(0, 0, 1280, 800).encloses(b["r"]), "%s：按鈕超出畫面 %s" % [what, str(b["r"])])
  1725		var seen := {}
  1726		for k in n:
  1727			seen[_focus] = true
  1728			await _pw_btn(JOY_BUTTON_DPAD_DOWN)
  1729		_pw_check(seen.size() == n, "%s：焦點只走到 %d／%d 顆" % [what, seen.size(), n])
