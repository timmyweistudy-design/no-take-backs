   198			return
   199		if ev is InputEventMagnifyGesture and (state == St.BATTLE or state == St.RESULT):
   200			_pinch_by(ev.factor, ev.position)   # 觸控板的捏合也一樣
   201			return
   202		if ev is InputEventMouseMotion:
   203			mouse = ev.position
   204			pad_mode = false
   205			if ev.device != InputEvent.DEVICE_ID_EMULATION:
