  2369	static func seat_mood(f_me: float, f_ai: float) -> int:
  2370		if f_ai - f_me > 0.15:
  2371			return Art.M_HAPPY
  2372		if f_me - f_ai > 0.15:
  2373			return Art.M_HURT
  2374		return Art.M_GRIM if absf(f_me - f_ai) <= 0.05 else 0
