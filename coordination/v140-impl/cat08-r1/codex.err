  2380		if a <= 0.01:
  2381			return
  2382		var st := _ai_style()
  2383		var f0: float = float(view.power(0)) / maxf(1.0, float(view.budget_of(0)) * 1000.0)   # 戰力以千分之一金計（Codex cat11 #5）
  2384		var f1: float = float(view.power(1)) / maxf(1.0, float(view.budget_of(1)) * 1000.0)
  2385		var mood := seat_mood(f0, f1)
  2386		var p := SEAT_FOOT
