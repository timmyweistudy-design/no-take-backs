   649	func _hold_tick(delta: float) -> void:
   650		if overlay != "confirm" or not bool(Save.s("hold_confirm")):
   651			hold_t = 0.0
   652			return
   653		var down: bool = (Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT) and confirm_ok_r.has_point(mouse)) \
   654			or (_focus == 0 and hold_keys_down(Save.s("keys"), Save.s("pad")))
   655		hold_t = hold_t + delta if down else 0.0
   656		if hold_t >= HOLD_SEC:
   657			hold_t = 0.0
   658			if pad_mode and int(Save.s("rumble")) > 0:
   659				Input.start_joy_vibration(last_joy, 0.2, 0.5 * int(Save.s("rumble")) / 100.0, 0.12)   # 確定的那一下輕震
   660			call("_confirm_go")
