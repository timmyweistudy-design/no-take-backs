   639	## 1.3.0 §15 第 4 項：音量木軌拖曳（走輸入佇列，和點擊同一順序；Codex cat01 #1 #2）。
   640	## 按下在軌上＝開始拖（吃掉這次按下，不觸發底下的數值鈕）；移動＝即時試聽（只改記憶體）；放開＝存檔一次、吃掉放開（不再 +5%）。
   641	## 離開設定、畫面換掉（佇列過期）都會結束並存檔。值照 VOL_STEPS（5% 一格）。
   642	func vol_press(p: Vector2) -> bool:
   643		if overlay != "settings" or pad_mode:
   644			return false
   645		for k in vol_rails:
   646			if (vol_rails[k] as Rect2).grow(4.0).has_point(p):
   647				vol_drag = k
   648				_vol_preview(p.x)
   649				return true
   650		return false
   651	
   652	func vol_motion(p: Vector2) -> void:
   653		if vol_drag != "":
   654			_vol_preview(p.x)
   655	
   656	func vol_release() -> bool:
   657		if vol_drag == "":
   658			return false
   659		var k := vol_drag
   660		vol_drag = ""
   661		Save.set_setting(k, int(Save.s(k)))   # 拖曳中只改記憶體，放開才寫檔
   662		return true
   663	
   664	func _vol_preview(x: float) -> void:
   665		if not vol_rails.has(vol_drag):
   666			return
   667		var v: int = vol_from_x(x, vol_rails[vol_drag])
   668		if v != int(Save.s(vol_drag)):
   669			Save.settings[vol_drag] = v
   670			_apply_volumes(str(VOL_PREVIEW[vol_drag]))
   671	
   672	static func vol_from_x(x: float, rail: Rect2) -> int:
   673		var f := clampf((x - rail.position.x) / maxf(1.0, rail.size.x), 0.0, 1.0)
   674		return int(roundf(f * 20.0)) * 5
