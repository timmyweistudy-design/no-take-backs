   281	
   282	## 塗兵（佇列命令）：按住拖過格子連續擺。
   283	func _paint_cmd(p: Vector2) -> void:
   284		call("vol_motion", p)   # 1.3.0：音量木軌拖曳中（沒在拖就什麼都不做）
   285		if drag_from.x >= 0 and p.distance_to(drag_press_p) >= 10.0:
   286			drag_moved = true   # V1.5.1：拖出去過就不算「點一下」（拖回原點也一樣，Codex v151-i3）
   287		if _is_free():
   288			if overlay == "":
   289				_fp_motion(p)
   290			return
   291		if state != St.PLACE or overlay != "" or not painting:
   292			return
   293		if _cur_army().team != paint_team:
   294			painting = false
   295			return
   296		var c := _cell_at(p)
   297		if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   298			_try_place(c)
   299	
   300	
   301	
   302	var drag_press_p := Vector2.ZERO
   303	var drag_moved := false
   304	
   305	func _mb_release_cleanup() -> void:
   306		call("vol_release")   # 1.3.0：過期的放開也結束音量拖曳（並存檔）
   307		_fp_abort_drag()
   308		drag_new = false
   309		painting = false
   310		drag_from = Vector2i(-1, -1)
   311	
   312	
   313	
   314	## 滑鼠按鍵（佇列命令，第三輪 A2）：按鈕點擊、擺放、拖曳、移除。
   315	var dbl_eat := false
   316	var intro_eat := false   # 1.3.0 §13
   317	
   318	## 1.3.0 §2：雙擊回全景只認盤面範圍（按鈕列、HUD 不算）。
   319	func _field_hit(p: Vector2) -> bool:
   320		if p.y <= 96.0 or p.y >= (640.0 if _replay_controls_active() else 760.0):
   321			return false
   322		for b in _btns:
   323			if (b["r"] as Rect2).has_point(p):
   324				return false   # 按鈕上雙擊不算（Codex cat06 #4）
   325		var lo: Vector2 = _cam * ORIGIN
   326		var hi: Vector2 = _cam * (ORIGIN + fld_size)
   327		return Rect2(lo, hi - lo).has_point(p)
   328	
   329	func _mb_cmd(d: Dictionary) -> void:
   330		var mb := InputEventMouseButton.new()
   331		mb.button_index = d["i"]
   332		mb.pressed = d["pressed"]
   333		mb.position = d["pos"]
   334		mouse = d["pos"]
   335		var eat_dbl := false
   336		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   337			eat_dbl = dbl_eat   # 雙擊回全景那次的放開：不論走哪條路都要清掉（Codex cat06 #4）
   338			dbl_eat = false
   339		if state == St.BATTLE and overlay == "" and mb.pressed:
   340			mag_hide = follow_id   # 1.3.0 §2：任何按下都先收起放大鏡（點到兵會在放開時重新選）
   341			hl_reel.clear()        # 精華三連播放中動了就停在這裡（交還手動）
   342			if mb.button_index == MOUSE_BUTTON_WHEEL_UP or mb.button_index == MOUSE_BUTTON_WHEEL_DOWN:
   343				cam_wheel(mb.button_index == MOUSE_BUTTON_WHEEL_UP, mouse)   # 滾輪縮放
   344				return
   345			if mb.button_index == MOUSE_BUTTON_LEFT and bool(d.get("dbl", false)) and _field_hit(mouse):
   346				cam_reset()   # 雙擊盤面回全景
   347				dbl_eat = true
   348				return
   349		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and bool(call("vol_press", mouse)):
   350			return   # 1.3.0：在音量木軌上按下＝開始拖
   351		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed and bool(call("vol_release")):
   352			_mb_release_cleanup()
   353			return   # 拖完放開：存檔，不再觸發數值鈕
   354		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   355			if _do_click(mouse) > 0:
   356				_mb_release_cleanup()
   357				return
   358		if state == St.PLACE and overlay == "" and mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and _v16_place_click(mouse):
   359			return   # V1.6 #6：標記模式
   360		if state == St.PLACE and overlay == "" and _fp_mb(d):
   361			return   # 第六輪：自由排兵處理掉了
   362		if overlay != "" or state != St.PLACE:
   363			if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
   364				_mb_release_cleanup()
   365				if overlay == "" and state == St.BATTLE and mb.button_index == MOUSE_BUTTON_LEFT:
   366					if not eat_dbl:   # 雙擊回全景的那次放開不再選兵
   367						_battle_click(mouse)   # 重播時點兵讓鏡頭跟（第三輪 F2）
   368			return
   369		var c := _cell_at(mouse)
   370		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   371			var k := _card_at(mouse)
   372			if k >= 0 and _card_help_rect(k).has_point(mouse):
   373				return   # 放開時由「?」按鈕處理
   374			if k >= 0:
   375				if _allowed(k):
   376					selected = k
   377					drag_new = true
   378					sfx.play("k_click", 0.7)
   379				else:
   380					_toast(L.t("err_type"), true)
   381				return
   382			if c.x < 0:
   383				return
   384			if _can_edit_existing() and _cur_army().index_at(c.x, c.y) != -1:
   385				if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
   386					_toast(L.t("err_locked"), true)
   387					return
   388				if mode == Mode.VS_AI and bool(call("wave_is_locked", c)):
   389					_toast(L.t("wv_locked"), true)   # V1.4 #11：車輪戰殘兵不能搬
   390					return
   600		_rv_poll()
   601		_settings_hover()
   602		_v16_tick(delta)   # V1.6：漏斗里程碑、背景工作
   603		var _t0 := Time.get_ticks_usec()
   604		_process_inner(delta)
   605		perf_proc_us = Time.get_ticks_usec() - _t0
   606	
   607	
   608	var rumble_seen := 0.0
   609	
   610	## ── V1.4 #18 觸控：點＝左鍵（引擎把觸控模擬成滑鼠）、長按 0.5 秒＝右鍵（拿掉兵）、雙指捏合＝縮放戰場 ──
   611	const LONG_PRESS := 0.5
   612	var touches := {}            # 手指編號 → 位置
   613	var lp_t := -1.0             # 長按計時（-1＝沒有在算）
   614	var lp_pos := Vector2.ZERO
   615	
   616	func _touch_input(ev: InputEvent) -> void:
   617		if ev is InputEventScreenTouch:
   618			if ev.pressed:
   619				touches[ev.index] = ev.position
   620			else:
   621				touches.erase(ev.index)
   622			lp_t = 0.0 if (ev.pressed and touches.size() == 1 and overlay == "") else -1.0   # 覆蓋層（例如軍令時間軸）不用長按，免得拖曳變右鍵
   623			lp_pos = ev.position
   624			return
   625		if ev is InputEventScreenDrag:
   626			var old: Vector2 = touches.get(ev.index, ev.position)
   627			touches[ev.index] = ev.position
   628			if lp_t >= 0.0 and ev.position.distance_to(lp_pos) > 12.0:
   629				lp_t = -1.0   # 拖動了就不是長按
   630			if touches.size() == 2 and (state == St.BATTLE or state == St.RESULT):
   631				var ks := touches.keys()
   632				var other: Vector2 = touches[ks[0] if ks[1] == ev.index else ks[1]]
   633				var d0: float = old.distance_to(other)
   634				var d1: float = ev.position.distance_to(other)
   635				if d0 > 8.0:
   636					_pinch_by(d1 / d0, (ev.position + other) / 2.0)
   637	
   638	func _pinch_by(f: float, at: Vector2) -> void:
   639		pinch_zoom = clampf(pinch_zoom * f, 1.0, 2.0)
   640		pinch_center = _fld_xf().affine_inverse() * at
   641	
   642	func _touch_tick(delta: float) -> void:
   643		if lp_t < 0.0:
   644			return
   645		lp_t += delta
   646		if lp_t >= float(Save.s("long_press")):
   647			lp_t = -1.0
   648			# 長按：取消左鍵的拖曳，改送一次右鍵（擺陣時拿掉兵；其他畫面右鍵本來就是返回／取消）
   649			drag_new = false
   650			painting = false
   651			drag_from = Vector2i(-1, -1)
   652			if _is_free():
   653				_fp_abort_drag()
   654			_enqueue("mb", {"i": MOUSE_BUTTON_RIGHT, "pressed": true, "pos": lp_pos})
   655			_enqueue("mb", {"i": MOUSE_BUTTON_RIGHT, "pressed": false, "pos": lp_pos})
   656			Input.vibrate_handheld(30)
   657	
   658	func _process_inner(delta: float) -> void:
   659		if shot_dir != "" and bool(get("shot_fixed")):
   660			delta = 1.0 / 60.0   # 1.2.0 §14.6：視覺回歸模式（--shot-fixed）用固定幀時間；一般版面檢查照真實時間（Codex cat01 #6）
   661		_touch_tick(delta)
   662		_pad_clear_tick()
   663		_stick_repeat(delta)
   664		_process_cmds()
   665		time += delta
   666		call("_gif_tick", delta)   # V1.4 #14
   667		if paused and key_t > 0.0:
   668			key_t += delta
   669		if paused and float(last_kill[1]) > 0.0:
   670			last_kill[1] = float(last_kill[1]) + delta   # 暫停時定格與歡呼波浪也凍結   # V1.3 C4：暫停時關鍵時刻的演出凍結（Codex v130-impl2）
   671		SteamApi.run_callbacks()
   672		if toast_t > 0:
   673			toast_t -= delta
   674		# V1.5：手把震動跟著鏡頭震動（強度可調、0 關掉；只在用手把時）
   675		if shake > rumble_seen + 0.05 and pad_mode and int(Save.s("rumble")) > 0:
   820			_draw_spotlight()   # 1.3.0 §2 交戰熱點聚光
   821			_draw_desat()       # 1.3.0 §2 最後一擊去飽和
   822		if state == St.BATTLE and slow_left > 0:
   823			_draw_vignette(clampf((8.0 - slow_left) / 0.3, 0.0, 1.0))   # 多層暗角（第三輪 V2）
   824		if state == St.BATTLE and time - key_t < 0.8 and not bool(Save.s("reduce_fx")):
   825			_draw_key_moment((time - key_t) / 0.8)
   826		if state != St.RESULT:
   827			for f in fx:
   828				if f.get("screen", false):
   829					_draw_fx(f)
   830		match state:
   831			St.TITLE: _draw_title()
   832			St.PLACE:
   833				_draw_place_hud()
   834				_v16_place_hud()   # V1.6
   835			St.BATTLE:
   836				_draw_battle_hud()
   837				_draw_owner_hand()  # 1.3.0 §11 開戰前老闆替棋鐘上發條（畫在 HUD 之上，不然被木條蓋住；Codex cat11 #4）
   838				_draw_replay_controls()
   839				if sim != null and sim.cmd_on:
   840					_draw_cmd_bar()
   841				_draw_frenzy_edge()
   842				_draw_start_cue()
   843				_draw_battle_report()
   844				_draw_unit_info()
   845				_draw_bmag()   # 1.3.0 §2 銅放大鏡小窗
   846				if pre_thread != null:
   847					_draw_busy(-1)
   848				elif skip_busy:
   849					_draw_busy(roundi(view.tick * 100.0 / maxf(1.0, view.max_ticks)))
   850				elif seek_target >= 0:
   851					_draw_busy(roundi(sim.tick * 100.0 / maxf(1.0, seek_target)))
   852			St.RESULT:
   853				if not _ink_active():
   854					_draw_battle_hud()   # 宣紙戰報演出時頂部 HUD 退場（Antigravity cat03 #3）
   855				if _ink_active():
   856					_draw_ink_report_screen()   # 1.2.0 §9.4 宣紙戰報：勝負章蓋下之前不出結果面板
   857				else:
   858					_draw_result()
   859		_draw_clutch_banner()
   860		# V1.2 F1：覆蓋層打開時 0.18 秒淡入（只疊一層漸淡的暗幕，不縮放：按鈕位置和滑鼠永遠一致，Codex v120-impl2）；截圖、版面檢查、簡化特效時不做
   861		if overlay != _ov_seen:
   862			_ov_seen = overlay
   863			_ov_t = time
   864			_trans_begin()
   865		var ok_anim: bool = overlay != "" and shot_dir == "" and not layout_probe and not bool(Save.s("reduce_fx"))
   866		var ok_k := clampf((time - _ov_t) / 0.18, 0.0, 1.0) if ok_anim else 1.0
   867		obj_open_kind = ""
   868		var slide := ov_slide_offset()   # 1.4.0 §2.2：器物從桌上的固定位置滑進來（大廳從左、圖鑑從下…）；只動畫面
   869		var m0 := mouse
   870		if slide != Vector2.ZERO:
   871			ui_xf = Transform2D(0.0, slide)   # 疊層裡自己切矩陣的地方都以 ui_xf 為底（不會把滑動蓋掉）
   872			Art.base = ui_xf
   873			draw_set_transform_matrix(ui_xf)
   874			mouse = Vector2(-9999, -9999)     # 滑入中不判 hover（命中框沒位移，高亮會錯位；Codex cat08 #6）
   875		_draw_overlay()
   876		var open_k := clampf((time - _ov_t) / 0.3, 0.0, 1.0) if ok_anim and not bool(Save.s("plain_ui")) and not bool(Save.s("reduce_motion")) else 1.0   # 1.4.0：減少動態＝器物也直接開好（和轉場一致，Codex cat08 r2 #4）
   877		if obj_open_force >= 0.0:
