   192	func _input(ev: InputEvent) -> void:
   193		if _trans_gate(ev):
   194			if is_inside_tree():
   195				get_viewport().set_input_as_handled()
   196			return
   197		if _keys_input(ev):
   198			return
   199		if nb_edit >= 0 and _nb_edit_input(ev):
   200			return   # V1.6.1 N3：實驗簿改名時，鍵盤輸入給名稱框
   201		if ev is InputEventScreenTouch or ev is InputEventScreenDrag:
   202			fp_touch = true   # 第六輪：觸控時預覽畫在手指上方
   203			_touch_input(ev)   # V1.4 #18：長按＝右鍵、雙指縮放
   204			return
   205		if ev is InputEventMagnifyGesture and (state == St.BATTLE or state == St.RESULT):
   206			_pinch_by(ev.factor, ev.position)   # 觸控板的捏合也一樣
   207			return
   208		if ev is InputEventMouseMotion:
   209			mouse = ev.position
   210			pad_mode = false
   211			if ev.device != InputEvent.DEVICE_ID_EMULATION:
   212				fp_touch = false
   213			hover_card = _card_at(mouse)
   214			if state == St.BATTLE and overlay == "" and (ev.button_mask & MOUSE_BUTTON_MASK_MIDDLE) != 0:
   215				_enqueue("pan", ev.relative)   # 1.3.0 §2：中鍵拖曳平移
   216			_enqueue("paint", mouse)   # 一律排入，由執行端判斷有沒有在塗兵（同一幀按下再拖過也不漏格，Codex S3）
   217			_drag_scrape(ev.relative.length())
   218			return
   219		if intro_t >= 0.0 and ((ev is InputEventKey and ev.pressed) or (ev is InputEventMouseButton and ev.pressed) or (ev is InputEventJoypadButton and ev.pressed) or (ev is InputEventScreenTouch and ev.pressed)):
   220			intro_end()   # 1.3.0 §13：任何按鍵、點擊跳過開場（這一下不再往下傳）
   221			intro_eat = true
   222			get_viewport().set_input_as_handled()
   223			return
   224		if intro_eat and ((ev is InputEventMouseButton and not ev.pressed) or (ev is InputEventScreenTouch and not ev.pressed) or (ev is InputEventJoypadButton and not ev.pressed) or (ev is InputEventKey and not ev.pressed)):
   225			intro_eat = false   # 跳過那一下的放開也吞掉（不然會點到底下的按鈕；Codex cat11 #2）
   226			get_viewport().set_input_as_handled()
   227			return
   228		if ev is InputEventMouseButton:
   229			mouse = ev.position
   230			if overlay == "codex" and ev.pressed and (ev.button_index == MOUSE_BUTTON_WHEEL_UP or ev.button_index == MOUSE_BUTTON_WHEEL_DOWN):
   231				_scroll_at(mouse, -48.0 if ev.button_index == MOUSE_BUTTON_WHEEL_UP else 48.0)   # 圖鑑捲動（第三輪 U1）
   232				return
   233			_enqueue("mb", {"i": ev.button_index, "pressed": ev.pressed, "pos": ev.position, "dbl": ev.double_click})
   234			return
   235		if state == St.BATTLE and ((ev is InputEventKey and ev.pressed) or (ev is InputEventJoypadButton and ev.pressed)):
   236			mag_hide = follow_id   # 1.3.0 §2：任何按鍵（含沒綁定的鍵、手把鍵）1 幀內收起放大鏡（只動畫面；Codex cat06 #6）
   237		if ev is InputEventKey and ev.pressed:
   238			if not ev.echo or ev.keycode in [KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT]:
   239				var dk: int = Keymap.key_to_default(Save.s("keys"), ev.keycode)
   240				if dk >= 0:
   241					_enqueue("key", dk)
   242			return
   243		if ev is InputEventJoypadButton:
   244			var db: int = Keymap.pad_to_default(Save.s("pad"), ev.button_index)
   245			if db < 0:
   246				return
   247			ev = ev.duplicate()
   248			ev.button_index = db
   249		if ev is InputEventJoypadButton:
   250			last_joy = ev.device     # 所有分流之前記（Codex v10-r1 #6）
   251			if ev.button_index == JOY_BUTTON_X:
   252				_pad_x_hold(ev.pressed)   # 1.1.0 Q1：長按拿掉鍵＝清空自己的陣
   253		if ev is InputEventJoypadButton and ev.pressed and _pad_tool(ev):
   254			return
   255		if ev is InputEventJoypadButton and _is_free() and overlay != "" and not ev.pressed and ev.button_index in [JOY_BUTTON_A, JOY_BUTTON_X]:
   256			_fp_abort_drag()   # 覆蓋層開著時放開 A／X：清掉拖曳狀態（Antigravity 實作第 1 輪 #2）
   257		if ev is InputEventJoypadButton and _is_free() and overlay == "" and ev.button_index in [JOY_BUTTON_A, JOY_BUTTON_X, JOY_BUTTON_B, JOY_BUTTON_Y, JOY_BUTTON_LEFT_STICK, JOY_BUTTON_RIGHT_STICK, JOY_BUTTON_DPAD_UP, JOY_BUTTON_DPAD_DOWN, JOY_BUTTON_DPAD_LEFT, JOY_BUTTON_DPAD_RIGHT]:
   258			pad_mode = true
   259			_enqueue("padbtn", {"b": ev.button_index, "pressed": ev.pressed})   # 第六輪：自由排兵要知道按下與放開
   260			return
   261		if ev is InputEventJoypadButton and ev.pressed:
   262			pad_mode = true
   263			var map := {JOY_BUTTON_DPAD_UP: KEY_UP, JOY_BUTTON_DPAD_DOWN: KEY_DOWN, JOY_BUTTON_DPAD_LEFT: KEY_LEFT,
   264				JOY_BUTTON_DPAD_RIGHT: KEY_RIGHT, JOY_BUTTON_A: KEY_ENTER, JOY_BUTTON_B: KEY_ESCAPE, JOY_BUTTON_X: KEY_BACKSPACE,
   265				JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_Y: KEY_TAB, JOY_BUTTON_LEFT_SHOULDER: KEY_Q, JOY_BUTTON_RIGHT_SHOULDER: KEY_E,
   266				JOY_BUTTON_BACK: KEY_F1, JOY_BUTTON_LEFT_STICK: KEY_H, JOY_BUTTON_RIGHT_STICK: KEY_P}
   267			if map.has(ev.button_index):
   268				_enqueue("key", map[ev.button_index])
   269			return
   270		if ev is InputEventJoypadMotion and ev.axis == JOY_AXIS_RIGHT_Y and overlay == "codex" and absf(ev.axis_value) > maxf(0.1, int(Save.s("deadzone")) / 100.0):   # V1.5：死區照設定
   271			pad_mode = true
   272			_scroll_by("left", ev.axis_value * 24.0)   # 右搖桿捲圖鑑左欄
   273			return
   274		if ev is InputEventJoypadMotion and (ev.axis == JOY_AXIS_LEFT_X or ev.axis == JOY_AXIS_LEFT_Y):
   275			# 左搖桿：只記下狀態，由 _stick_repeat 依固定節奏送方向鍵（Codex S1 #6：原本每個抖動事件都會送一次）
   276			stick[ev.axis] = ev.axis_value
   277			if absf(ev.axis_value) > 0.6:
   278				pad_mode = true
   279	
