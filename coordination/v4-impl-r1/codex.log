   112			for r in [4, 3, 5, 2, 6, 1, 7, 0, 8]:
   113				if b.left() < D.cost(fill):
   114					return b
   115				b.place(fill, c, r)
   116		return b
   117	
   118	## 補法 a：這套陣型裡（拿掉 X 後）金額最多的舊兵種；同額取編號小的；沒有就劍士。
   119	static func most_common_other(a: Army, x: int) -> int:
   120		var comp := F.composition(a)
   121		var best := -1
   122		for t in D.CLASSIC:
   123			if t != x and comp[t] > 0 and (best == -1 or comp[t] > comp[best]):
   124				best = t
   125		return best if best >= 0 else D.SWORD
