     1	extends SceneTree
     2	## 確定性金標準（第三輪 T2）。
     3	## 產生：godot --headless --path game --script res://tools/golden.gd -- --make
     4	##   用固定種子讓 AI 擺 1000 組陣，存成陣型代碼＋每 100 tick 的狀態雜湊＋最終指紋，寫到 tests/golden/golden.json，並記下規則版本與數值摘要。
     5	##   只有「刻意改了戰鬥規則」才重產，而且要在 commit 裡說明。
     6	## 檢查：godot --headless --path game --script res://tools/golden.gd [-- --n=1000]
     7	##   逐場重算比對，回報第一個分歧的場次與 tick；任何分歧 exit 1。規則版本或數值摘要不同也 exit 1（提示要不要重產）。
     8	const Sim = preload("res://scripts/core/battle_sim.gd")
     9	const Army = preload("res://scripts/core/army.gd")
    10	const AI = preload("res://scripts/core/ai_army.gd")
    11	const D = preload("res://scripts/core/unit_defs.gd")
    12	const F = preload("res://scripts/core/formations.gd")
    13	const PATH := "res://tests/golden/golden.json"
    14	const CHECK_EVERY := 100
    15	
    16	static func state_sig(s) -> String:
    17		var parts := PackedStringArray()
    18		parts.append(str(s.tick))
    19		for u in s.units:
    20			parts.append("%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d" % [u.id, u.x, u.y, u.hp, 1 if u.alive else 0, u.target, u.stun,
    21				u.stealth, u.charge, u.slow, u.cd, u.fx, u.fy, u.nav, 1 if u.chasing else 0, u.kills, u.dmg_dealt, u.dmg_taken,
    22				u.hcd, u.aura, u.breach, u.bmode, u.heal_done, u.follow])   # 第四輪 N0a：補擊殺與傷害統計；1.3.0：新兵種狀態   # 第四輪 N0a：補擊殺與傷害統計
    23		return ",".join(parts).sha256_text().substr(0, 16)
    24	
    25	static func run_case(c0: String, c1: String, fast: bool) -> Dictionary:
    26		var a0 := Army.new(0, 100)
    27		var a1 := Army.new(1, 100)
    28		a0.load_code(c0)
    29		a1.load_code(c1)
    30		var s = Sim.new(a0, a1)
    31		s.fast = fast
    32		var cps: Array = []
    33		while not s.finished:
    34			s.step()
    35			if s.tick % CHECK_EVERY == 0:
    36				cps.append(state_sig(s))
    37		cps.append(state_sig(s))
    38		return {"winner": s.winner, "ticks": s.tick, "cps": cps, "fp": s.fingerprint}
    39	
    40	func _init() -> void:
    41		var args := OS.get_cmdline_user_args()
    42		if "--make" in args:
    43			_make()
    44			return
    45		var n := 1000
    46		for a in args:
    47			if a.begins_with("--n="):
    48				n = int(a.substr(4))
    49		var res := check(n)
    50		print("GOLDEN %s" % JSON.stringify(res))
    51		quit(0 if res["ok"] else 1)
    52	
    53	func _make() -> void:
    54		var rng := RandomNumberGenerator.new()
    55		var cases: Array = []
    56		for i in 1000:
    57			rng.seed = 20261102 + i * 7919
    58			# 第四輪：一半用 AI 模板（含新兵模板）、一半用十種兵的隨機混編，確保至少一半場次有新兵
    59			var a0: Army = AI.build(0, 100, rng)["army"] if i % 2 == 0 else F.random_formation(0, rng, "mixed", "", D.COUNT)
    60			var a1: Army = AI.build(1, 100, rng)["army"] if i % 2 == 0 else F.random_formation(0, rng, "mixed", "", D.COUNT).mirrored()
    61			var c0 := a0.to_code()
    62			var c1 := a1.to_code()
    63			var r := run_case(c0, c1, false)
    64			cases.append({"a": c0, "b": c1, "w": r["winner"], "t": r["ticks"], "cps": r["cps"], "fp": r["fp"]})
    65		var out := {"rules": D.RULES_VERSION, "digest": D.data_digest(), "check_every": CHECK_EVERY, "cases": cases}
    66		var f := FileAccess.open(PATH, FileAccess.WRITE)
    67		f.store_string(JSON.stringify(out))
    68		f.close()
    69		print("GOLDEN 已產生 %d 場（規則 %s、摘要 %s）" % [cases.size(), D.RULES_VERSION, D.data_digest()])
    70		quit(0)
    71	
    72	## 比對前 n 場；回傳 {ok, n, first_case, first_tick, why}
    73	static func check(n: int) -> Dictionary:
    74		var g = JSON.parse_string(FileAccess.get_file_as_string(PATH))
    75		if not g is Dictionary:
    76			return {"ok": false, "why": "讀不到金標準檔"}
    77		if str(g["rules"]) != D.RULES_VERSION or str(g["digest"]) != D.data_digest():
    78			return {"ok": false, "why": "規則或數值變了（%s/%s → %s/%s）：若是刻意改規則，請重產金標準並在 commit 說明" % [g["rules"], g["digest"], D.RULES_VERSION, D.data_digest()]}
    79		var cases: Array = g["cases"]
    80		var every := int(g["check_every"])
    81		for i in mini(n, cases.size()):
    82			var c: Dictionary = cases[i]
    83			var r := run_case(c["a"], c["b"], false)
    84			var cps: Array = c["cps"]
