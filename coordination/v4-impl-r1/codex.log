   167		var fighters := [0, 0]
   168		for i in n:
   169			if units[i].alive and not D.is_support(units[i].type):
   170				fighters[units[i].team] += 1
   171	
   172		# ② 選目標＋提出移動
   173		var nx := sx.duplicate()
