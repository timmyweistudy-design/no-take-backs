    99	## 整批拿掉 X，空出的錢與格子用 fill 兵種補回：先補原本 X 的格子（前排→後排、中間→兩邊），再補其他空格；錢不夠就留著。
   100	static func refill(a: Army, x: int, fill: int) -> Army:
   101		var b := Army.new(0, 100)
   102		var holes: Array = []
   103		for u in a.units:
   104			if u["type"] == x:
   105				holes.append(Vector2i(u["col"], u["row"]))
   106			else:
   107				b.units.append(u.duplicate())
   108		holes.sort_custom(func(p, q): return p.x > q.x or (p.x == q.x and absi(p.y - 4) < absi(q.y - 4)) or (p.x == q.x and absi(p.y - 4) == absi(q.y - 4) and p.y < q.y))
   109		for h in holes:
   110			b.place(fill, h.x, h.y)
