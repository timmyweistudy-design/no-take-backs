    58	## 指定權重的陣型（第四輪 unit_eval 用）：w 長度＝D.COUNT；權重 0 的兵種不出現。
    59	static func weighted_formation(team: int, rng: RandomNumberGenerator, w: Array, style := "") -> Army:
    60		var a := Army.new(team, 100)
    61		if style == "":
    62			style = STYLES[rng.randi_range(0, STYLES.size() - 1)]
    63		var picks: Array = []
    64		var budget_left := 100
    65		var guard := 0
    66		while picks.size() < Army.MAX_UNITS and guard < 100:
    67			guard += 1
    68			var total := 0
    69			for t in w.size():
    70				if w[t] > 0 and D.cost(t) <= budget_left:
    71					total += w[t]
    72			if total == 0:
    73				break
    74			var r := rng.randi_range(1, total)
    75			for t in w.size():
    76				if w[t] > 0 and D.cost(t) <= budget_left:
    77					r -= w[t]
    78					if r <= 0:
    79						picks.append(t)
    80						budget_left -= D.cost(t)
    81						break
    82		for t in picks:
    83			place_styled(a, t, style, rng)
    84		return a
    85	
    86	static func place_styled(a: Army, t: int, style: String, rng: RandomNumberGenerator) -> void:
    87		var cols: Array
    88		var rows: Array
    89		match style:
    90			"random":
    91				for _i in 60:
    92					var c := rng.randi_range(0, 5)
    93					var r := rng.randi_range(0, 8)
    94					if a.place(t, _abs_col(a, c), r):
    95						return
    96				cols = [5, 4, 3, 2, 1, 0]
    97				rows = [4, 3, 5, 2, 6, 1, 7, 0, 8]
    98			"lane_top":
    99				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
   100				rows = [0, 1, 2, 3, 4, 5, 6, 7, 8]
   101			"lane_bottom":
   102				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
   103				rows = [8, 7, 6, 5, 4, 3, 2, 1, 0]
   104			"front":
   105				cols = [5, 4, 3, 2, 1, 0]
   106				rows = [4, 3, 5, 2, 6, 1, 7, 0, 8]
   107			"spread":
   108				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
   109				rows = [0, 8, 4, 2, 6, 1, 7, 3, 5]
   110			_:   # role / center
   111				cols = ROLE_COLS[t] + [5, 4, 3, 2, 1, 0]
   112				rows = [4, 3, 5, 2, 6, 1, 7, 0, 8] if (style == "center" or t != D.CAVALRY) else [0, 8, 1, 7, 2, 6, 3, 5, 4]
   113		for c in cols:
   114			for r in rows:
   115				if a.place(t, _abs_col(a, c), r):
   116					return
   117	
   118	## 藍方 0＝最後排、5＝最前排；紅方鏡像。
   119	static func _abs_col(a: Army, c: int) -> int:
   120		return c if a.team == 0 else Army.COLS - 1 - c
   121	
   122	## 訓練池（200）與保留池（50）：不同種子範圍，保留池不參與調參。
   123	## ntypes：池子只用編號 0～ntypes−1 的兵種（第四輪；5＝經典池，和第三輪的池子完全相同）。
   124	static func pool(team: int, count: int, seed_base: int, ntypes := D.COUNT) -> Array:
   125		var out: Array = []
   126		var rng := RandomNumberGenerator.new()
   127		var kinds := ["mixed", "mixed", "mixed", "duo", "pure"]
   128		for i in count:
   129			rng.seed = seed_base + i * 7919
   130			out.append(random_formation(team, rng, kinds[i % kinds.size()], "", ntypes))
   131		return out
   132	
   133	static func training_pool(team: int, ntypes := D.COUNT) -> Array:
   134		return pool(team, 200, 1000003, ntypes)
   135	
   136	static func holdout_pool(team: int, ntypes := D.COUNT) -> Array:
   137		return pool(team, 50, 9000011, ntypes)
   138	
   139	## 驗證池（第三輪 B1）：從來沒有用來挑參數或調關卡的 200 套，用來確認結論不是對訓練池過擬合。
   140	static func validation_pool(team: int, ntypes := D.COUNT) -> Array:
   141		return pool(team, 200, 7000001, ntypes)
   142	
   143	## 封存終驗池（第四輪 §3.4）：只在最後跑一次，不拿來調參或挑冠軍。
   144	static func sealed_pool(team: int, ntypes := D.COUNT) -> Array:
   145		return pool(team, 200, 3000029, ntypes)
   146	
   147	## 搜尋池：萬用陣搜尋演化時用的對手（跟保留池分開，避免資料洩漏）。
   148	static func search_pool(team: int, ntypes := D.COUNT) -> Array:
   149		return pool(team, 60, 5000017, ntypes)
   150	
   151	## 兵種組成向量（每種兵的金額）。
   152	static func composition(a: Army) -> Array:
   153		var v := D.zeros()
   154		for u in a.units:
   155			v[u["type"]] += D.cost(u["type"])
   156		return v

