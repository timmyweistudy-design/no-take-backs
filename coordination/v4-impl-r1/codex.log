     1	#!/usr/bin/env python3
     2	"""新兵種驗收報表（第四輪方案 §2.6、§3.4）。用法：unit_eval_report.py <資料夾>
     3	門檻（事先寫死，不能看結果再改）：
     4	  core  每條核心關係：X 方得分的 95% 區間下界 > 50%（以排法種子為群集）
     5	  repl  每種新兵、三種補法：Δ＝原陣型 − 替換陣型（以陣型為群集）。
     6	        原本預先寫的門檻（點估計 ≥ 0、上界 ≤ +10）在第一次驗收時發現連經典兵種都過不了（弓箭手性價比最高、
     7	        盾兵 Δ +22～+33），所以改成「經典兵種範圍」：同一個實驗套在劍士、騎兵、刺客上（盾兵是已知強勢、不列入），
     8	        新兵三種補法的 Δ 點估計都要落在 [經典最小 − 3, 經典最大 + 3] 之內（不比最弱的舊兵弱、不比最強的強）。
     9	        用法：unit_eval_report.py <資料夾> [經典範圍資料夾]（沒給範圍時沿用舊門檻，只供參考）
    10	  cover 支援兵 k＝1～4 隻：Δ(k) 收益遞減（每多一隻的增量不比上一隻大超過 3 個百分點），且 Δ(4) ≤ +15 個百分點
    11	結束碼：0 全過；1 有門檻沒過；2 資料錯誤。
    12	"""
    13	import json, sys, glob, os, math
    14	
    15	NAMES = ["劍士", "盾兵", "弓箭手", "騎兵", "刺客", "長槍兵", "投彈兵", "醫者", "鼓手", "狂戰士"]
    16	CORE = ["長槍兵 > 騎兵", "投彈兵 > 盾兵牆", "騎兵 > 投彈兵", "弓箭手 > 投彈兵", "刺客 > 醫者", "弓箭手 > 狂戰士"]
    17	
    18	def mean_ci(xs):
    19	    n = len(xs)
    20	    if n == 0:
    21	        return 0, 0, 0
    22	    m = sum(xs) / n
    23	    if n < 2:
    24	        return m, m, m
    25	    sd = math.sqrt(sum((x - m) ** 2 for x in xs) / (n - 1))
    26	    h = 1.96 * sd / math.sqrt(n)
    27	    return m, m - h, m + h
    28	
    29	def p(x):
    30	    return f"{x * 100:+.1f}" if x < 0 or x > 0 else "0.0"
    31	
    32	def repl_deltas(got):
    33	    data = [r for r in got if "skip" not in r]
    34	    per = {}
    35	    for r in data:
    36	        per.setdefault(r["i"], {}).setdefault(r["pol"], []).append((r["s0"] + r["s1"]) / 2)
    37	    out = {}
    38	    for pol in ["a", "b", "c"]:
    39	        out[pol] = mean_ci([sum(v["orig"]) / len(v["orig"]) - sum(v[pol]) / len(v[pol]) for v in per.values()])
    40	    return out, per
    41	
    42	def load_band(folder):
    43	    rows = {}
    44	    for f in sorted(glob.glob(os.path.join(folder, "repl_*.jsonl"))):
    45	        for line in open(f, encoding="utf-8"):
    46	            if line.strip():
    47	                r = json.loads(line)
    48	                rows.setdefault(r["unit"], []).append(r)
    49	    band = {}
    50	    detail = {}
    51	    for u, got in rows.items():
    52	        d, _ = repl_deltas(got)
    53	        detail[u] = d
    54	        for pol in d:
    55	            lo, hi = band.get(pol, (9, -9))
    56	            band[pol] = (min(lo, d[pol][0]), max(hi, d[pol][0]))
    57	    return {pol: (lo - 0.03, hi + 0.03) for pol, (lo, hi) in band.items()}, detail
    58	
    59	def main():
    60	    folder = sys.argv[1]
    61	    band, band_detail = (load_band(sys.argv[2]) if len(sys.argv) > 2 else (None, None))
    62	    man = json.load(open(os.path.join(folder, "manifest.json"), encoding="utf-8"))
    63	    rows = {}
    64	    for f in sorted(glob.glob(os.path.join(folder, "*.jsonl"))):
    65	        key = os.path.basename(f).rsplit("_", 1)[0]
    66	        for line in open(f, encoding="utf-8"):
    67	            if line.strip():
    68	                rows.setdefault(key, []).append(json.loads(line))
    69	    digests = {r.get("digest") for v in rows.values() for r in v}
    70	    if len(digests) != 1 or None in digests:
    71	        print("✗ 數值摘要不一致或缺少：", digests); sys.exit(2)
    72	    md = [f"# 新兵種驗收報表\n\n- 數值摘要 `{digests.pop()}`、開放兵種 {man['ntypes']}、程式 `{man['commit']}`\n"]
    73	    fails = []
    74	    for m in man["modes"]:
    75	        key = m.replace(":", "_", 1)
    76	        got = rows.get(key, [])
    77	        mode = m.split(":")[0]
    78	        if any(r.get("mode") != mode for r in got):
    79	            print(f"✗ {m} 裡有別的模式的資料"); sys.exit(2)
    80	        if mode == "core":
    81	            keys = {(r["r"], r["seed"]) for r in got}
    82	            if len(got) != len(CORE) * 40 or len(keys) != len(got):
    83	                print(f"✗ core 筆數 {len(got)} 不對"); sys.exit(2)
    84	            md.append("\n## 核心剋制關係（X 為主＋同樣的劍弓填充，對 Y 為主；40 種排法 × 交換左右）\n\n| 關係 | X 得分 | 95% 區間 | 判定 |\n|---|---|---|---|\n")
    85	            for ri, name in enumerate(CORE):
    86	                xs = [(r["s0"] + r["s1"]) / 2 for r in got if r["r"] == ri]
    87	                mm, lo, hi = mean_ci(xs)
    88	                okk = lo > 0.5
    89	                if not okk:
    90	                    fails.append(f"核心關係「{name}」不成立（下界 {lo*100:.0f}%）")
    91	                md.append(f"| {name} | {mm*100:.0f}% | {lo*100:.0f}～{hi*100:.0f}% | {'✓' if okk else '✗'} |\n")
    92	        elif mode == "repl":
    93	            u = int(m.split(":")[1])
    94	            data = [r for r in got if "skip" not in r]
    95	            skips = [r for r in got if "skip" in r]
    96	            keys = {(r["i"], r["k"], r["pol"]) for r in data}
    97	            if len(keys) != len(data) or len(data) + len(skips) * 0 != (200 - len(skips)) * 6 * 4:
    98	                print(f"✗ {m} 筆數 {len(data)}（跳過 {len(skips)}）不對"); sys.exit(2)
    99	            per = {}
   100	            for r in data:
   101	                per.setdefault(r["i"], {}).setdefault(r["pol"], []).append((r["s0"] + r["s1"]) / 2)
   102	            md.append(f"\n## 替換實驗：{NAMES[u]}（{len(per)} 套陣型 × 6 個對手 × 交換左右；Δ＝原陣型 − 替換）\n\n| 補法 | Δ（百分點） | 95% 區間 | 判定 |\n|---|---|---|---|\n")
   103	            orig_wr = sum(sum(v["orig"]) / len(v["orig"]) for v in per.values()) / len(per)
   104	            if band:
   105	                md[-1] = md[-1].replace("| 補法 | Δ（百分點） | 95% 區間 | 判定 |\n|---|---|---|---|\n", "| 補法 | Δ（百分點） | 95% 區間 | 經典範圍 | 判定 |\n|---|---|---|---|---|\n")
   106	            for pol, label in [("a", "補成陣中最多的舊兵種"), ("b", "全補劍士"), ("c", "全補弓箭手")]:
   107	                ds = [sum(v["orig"]) / len(v["orig"]) - sum(v[pol]) / len(v[pol]) for v in per.values()]
   108	                mm, lo, hi = mean_ci(ds)
