   230				events.append({"kind": EV.TAUNT, "src": units[t].id, "tgt": u.id, "tags": [EV.TAUNT]})
   231			if t == -1 or u.stun > 0:
   232				continue
   233			var tg := units[t]
   234			var reach := u.reach if u.bmode != 2 else D.BONK_REACH
   235			var d2 := M.dist2(u.x, u.y, tg.x, tg.y)
   236			var dest_x := tg.x
   237			var dest_y := tg.y
   238			var stop_at := reach - 50
