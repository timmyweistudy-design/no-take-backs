    82	## 含 X 的陣型：從 ntypes 範圍的混編裡產生，X 的權重至少 2；第 i 套固定種子。
    83	static func with_unit(x: int, nt: int, i: int) -> Army:
    84		var rng := RandomNumberGenerator.new()
    85		rng.seed = 424242 + x * 100003 + i * 7919
    86		for tries in 50:
    87			var w := D.zeros()
    88			for t in nt:
    89				w[t] = rng.randi_range(0, 3)
    90			w[x] = maxi(2, w[x])
    91			if D.is_support(x):
    92				# 支援兵（醫者、鼓手）不疊加、AI 一種最多帶 2 隻：只取帶 1～2 隻的陣型（第四輪驗收時修正，見報告）
    93				w[x] = 1
    94			var a := F.weighted_formation(0, rng, w)
    95			if a.count_of(x) > 0 and (not D.is_support(x) or a.count_of(x) <= 2):
    96				return a
    97		return null
