   213					new_fy[i] = sf.y
   214				continue
   215			var t := -1
   216			if u.type == D.BOMBER:
   217				# 投彈兵（第四輪 §2.2）：最近的「可見」敵人在 1.5 格內 → 這一 tick 敲人；否則只從 ≥1.5 格的敵人裡選丟彈目標
   218				var near2 := _nearest_visible_enemy_d2(i, sx, sy, st, sv)
   219				if near2 >= 0 and near2 < D.BOMB_MIN * D.BOMB_MIN:
   220					u.bmode = 2
   221					t = _choose_target(i, sx, sy, st, sk, sh, sv)
   222				elif near2 >= 0:
