   303					var dx := nx[j] - xi
   304					var dy := ny[j] - yi
   305					if dx >= MIN_SEP or dx <= -MIN_SEP or dy >= MIN_SEP or dy <= -MIN_SEP:
   306						continue
   307					var d2 := dx * dx + dy * dy
   308					if d2 >= MIN_SEP * MIN_SEP:
   309						continue
   310					var d := M.isqrt(d2)
   311					var ux := 0
   312					var uy := 0
   313					if d == 0:
   314						# 零距離：不同隊左右分開（藍往左、紅往右）；同隊上下分開
   315						if st[i] != st[j]:
   316							ux = 1000 if st[i] == 0 else -1000
   317						else:
   318							uy = 1000
   319					else:
   320						ux = dx * 1000 / d
   321						uy = dy * 1000 / d
   322					var half := (MIN_SEP - d) / 2 + 1
   323					px[i] -= ux * half / 1000
   324					py[i] -= uy * half / 1000
   325					px[j] += ux * half / 1000
   326					py[j] += uy * half / 1000
