   241				# 潛行中繞到目標背後（目的地夾在場內）
   242				dest_x = clampi(tg.x - tg.fx * D.BEHIND_DIST / 1000, EDGE, W - EDGE)
   243				dest_y = clampi(tg.y - tg.fy * D.BEHIND_DIST / 1000, EDGE, H - EDGE)
