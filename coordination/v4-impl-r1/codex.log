   977	## 懸念指標（優化方案 B2）：用每 tick 的戰力差 Δ(t) 算。只在結束後呼叫。
   978	## lead_changes：開戰 5 秒後 Δ 跨過 ±5%（以總預算計）的次數；
   979	## lock_ratio：勝方從這一 tick 起領先再也不低於 20% 的時間點 ÷ 全場；
   980	## max_swing：贏家曾經落後的最大幅度（%）。
   981	func suspense() -> Dictionary:
   982		var total := budget * 1000
   983		var thr := total * 5 / 100
   984		var lock_thr := total * 20 / 100
   985		var changes := 0
   986		var side := 0
   987		for t in range(100, power_log.size()):
   988			var d: int = power_log[t]
   989			var s := 0
   990			if d > thr:
   991				s = 1
   992			elif d < -thr:
   993				s = -1
   994			if s != 0:
   995				if side != 0 and s != side:
   996					changes += 1
   997				side = s
   998		var lock_t := power_log.size()
   999		var swing := 0
  1000		if winner >= 0:
  1001			var sign := 1 if winner == 0 else -1
  1002			lock_t = 0
  1003			for t in power_log.size():
  1004				var lead: int = power_log[t] * sign
  1005				if lead < lock_thr:
  1006					lock_t = t + 1
  1007				if -lead > swing:
  1008					swing = -lead
  1009		var ratio := lock_t * 1000 / maxi(1, power_log.size())
  1010		return {"lead_changes": changes, "lock_ratio_permille": ratio, "max_swing_pct": swing * 100 / total}

