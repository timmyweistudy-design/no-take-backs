   114	                    md.append(f"| {label} | {mm*100:+.1f} | {lo*100:+.1f}～{hi*100:+.1f} | {blo*100:+.1f}～{bhi*100:+.1f} | {'✓' if okk else '✗'} |\n")
   115	                else:
