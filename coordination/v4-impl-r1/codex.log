   102	## 陣型代碼（優化方案 E3）：NTB1.<base64url>.<校驗 4 碼>。
   103	## 位元組：[版本 1, 隻數, 每隻 (兵種<<4 | 以藍方表示的欄 0～5), 列]。欄位一律存成「自己這一側」，所以紅藍都能讀。
   104	const CODE_VERSION := 1
   105	
   106	func to_code() -> String:
   107		var b := PackedByteArray([CODE_VERSION, units.size()])
   108		for u in units:
   109			var c: int = u["col"] if team == 0 else COLS - 1 - u["col"]
   110			b.append((int(u["type"]) << 4) | c)
   111			b.append(u["row"])
   112		var body := Marshalls.raw_to_base64(b).replace("+", "-").replace("/", "_").replace("=", "")
   113		return "NTB1.%s.%s" % [body, body.sha256_text().substr(0, 4)]
   114	
   115	## 解碼並驗證；成功回傳 ""，失敗回傳原因（不改動目前陣型）。
   116	func load_code(code: String) -> String:
   117		var parts := code.strip_edges().split(".")
   118		if parts.size() != 3 or parts[0] != "NTB1":
   119			return "格式不對"
   120		if parts[1].sha256_text().substr(0, 4) != parts[2]:
   121			return "校驗碼不符"
   122		var b64 := parts[1].replace("-", "+").replace("_", "/")
   123		while b64.length() % 4 != 0:
   124			b64 += "="
   125		var b := Marshalls.base64_to_raw(b64)
   126		if b.size() < 2 or b[0] != CODE_VERSION or b.size() != 2 + b[1] * 2:
   127			return "版本或長度不對"
   128		var tmp = get_script().new(team, budget)
   129		for i in b[1]:
   130			var t: int = b[2 + i * 2] >> 4
   131			var c: int = b[2 + i * 2] & 15
   132			var r: int = b[3 + i * 2]
   133			if t >= D.COUNT or c > 5:
   134				return "內容不合法"
   135			var col: int = c if team == 0 else COLS - 1 - c
   136			if not tmp.place(t, col, r):
   137				return "超過預算、人數或格子重複"
   138		units = tmp.units
   139		return ""
