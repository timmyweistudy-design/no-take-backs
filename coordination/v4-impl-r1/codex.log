   248	## 反制庫的陣型只能用這場開放的兵種（第四輪：不會拿你還沒解鎖的兵打你）。
   249	func _types_ok(a: Army) -> bool:
   250		for u in a.units:
   251			if int(u["type"]) >= _ntypes():
   252				return false
   253		return true
