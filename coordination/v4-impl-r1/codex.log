   262	## 反制庫版本檢查（第三輪 A3）：規則版本或數值摘要對不上就不用（退回啟發式），避免用到過期的反制。
   263	static func counter_lib_entries(p) -> Array:
   264		if not p is Dictionary:
   265			return []
   266		if str(p.get("rules", "")) != D.RULES_VERSION or str(p.get("digest", "")) != D.data_digest():
   267			push_warning("counter_lib.json 的規則版本或數值摘要和遊戲不同，困難 AI 改用啟發式")
   268			return []
   269		var e = p.get("entries", [])
   270		return e if e is Array else []
