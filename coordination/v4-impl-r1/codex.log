   127	## 盾兵為主的對手池（狂戰士的混編驗收用，§2.4）：盾兵權重 4，其他經典兵種 0～2。
   128	static func shield_pool(n: int) -> Array:
   129		var out: Array = []
   130		var rng := RandomNumberGenerator.new()
   131		for i in n:
   132			rng.seed = 616161 + i * 7919
   133			var w := D.zeros()
   134			for t in D.CLASSIC:
   135				w[t] = rng.randi_range(0, 2)
   136			w[D.SHIELD] = 4
   137			out.append(F.weighted_formation(0, rng, w))
   138		return out
   139	
   140	func repl(x: int, nt: int, shard: int, shards: int, vs_shield := false) -> void:
   141		var opps := shield_pool(200) if vs_shield else F.validation_pool(0, nt)
   142		var mname := "replshield" if vs_shield else "repl"
   143		var idx := 0
   144		for i in REPL_N:
   145			idx += 1
   146			if idx % shards != shard:
   147				continue
   148			var orig := with_unit(x, nt, i)
   149			if orig == null:
   150				emit({"mode": mname, "unit": x, "i": i, "skip": "no_unit"})
   151				continue
   152			var variants := {"orig": orig, "a": refill(orig, x, most_common_other(orig, x)), "b": refill(orig, x, D.SWORD), "c": refill(orig, x, D.ARCHER)}
   153			for k in REPL_OPPS:
   154				var opp: Army = opps[(i * 7 + k * 31) % opps.size()]
   155				for pol in ["orig", "a", "b", "c"]:
   156					var sc := duel2(variants[pol], opp)
   157					emit({"mode": mname, "unit": x, "i": i, "k": k, "pol": pol, "s0": sc[0], "s1": sc[1],
   158						"left": variants[pol].left(), "n": variants[pol].count()})
   159	
   160	## 從後排（離自己底線近）、兩邊往中間拿掉戰鬥兵，直到空出 need 金；再把 k 隻支援兵照角色欄位擺上。
   161	static func with_supports(base: Army, sup: int, k: int) -> Army:
   162		var b: Army = base.copy()
   163		var need := k * D.cost(sup)
   164		var order := b.units.duplicate()
   165		order.sort_custom(func(p, q): return p["col"] < q["col"] or (p["col"] == q["col"] and absi(p["row"] - 4) > absi(q["row"] - 4)) or (p["col"] == q["col"] and absi(p["row"] - 4) == absi(q["row"] - 4) and p["row"] < q["row"]))
   166		for u in order:
   167			if b.left() >= need:
   168				break
   169			b.remove_at(u["col"], u["row"])
