   181			var u := units[i]
   182			new_target[i] = u.target
   183			new_fx[i] = u.fx
   184			new_fy[i] = u.fy
   185			new_lock[i] = -1
   186			u.mx = 0
   187			u.my = 0
   188			if not u.alive:
