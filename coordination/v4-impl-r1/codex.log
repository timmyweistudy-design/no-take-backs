   587	# ───────────────────────── 規則細節 ─────────────────────────
   588	
   589	## 選目標（企劃 §3.3）：排除潛行 → 弓手警覺 → 盾兵嘲諷（近戰）→ 兵種偏好 → 距離 → 剩血 → 列 → 深度 → 編號。
   590	## 只讀快照陣列，比較全部用整數（不配置陣列）。
   591	func _choose_target(i: int, sx: PackedInt64Array, sy: PackedInt64Array, st: PackedInt64Array,
   592			sk: PackedInt64Array, sh: PackedInt64Array, sv: PackedByteArray, min_d2 := 0) -> int:
   593		var my_team: int = st[i]
   594		var my_type: int = sk[i]
   595		var ux: int = sx[i]
   596		var uy: int = sy[i]
   597		var reach: int = units[i].reach
   598		var reach2 := reach * reach
   599		var taunt2 := D.TAUNT_RANGE * D.TAUNT_RANGE
   600		var melee := D.is_melee(my_type)
   601		var best := -1
   602		var b_rank := 99
   603		_last_rank = 99
   604		var b_d2 := 0
   605		var b_hp := 0
   606		var b_y := 0
   607		var b_dep := 0
   608		var n := sx.size()
   609		for j in n:
   610			if sv[j] == 0 or st[j] == my_team:
   611				continue
   612			var dx: int = sx[j] - ux
   613			var dy: int = sy[j] - uy
   614			var d2 := dx * dx + dy * dy
   615			if d2 < min_d2:
   616				continue   # 投彈兵丟彈：最短射程內的不選（第四輪）
   617			var et: int = sk[j]
   618			var rank := 3
   619			if my_type == D.ARCHER and et == D.ASSASSIN and d2 <= reach2:
   620				rank = 0
   621			elif melee and et == D.SHIELD and d2 <= taunt2 and units[j].breach == 0:
   622				rank = 1   # 被破陣的盾兵不嘲諷（第四輪）
   623			elif my_type == D.CAVALRY and (et == D.ARCHER or et == D.MEDIC or et == D.BOMBER):
   624				rank = 2
   625			elif my_type == D.ASSASSIN and (et == D.SHIELD or et == D.CAVALRY or et == D.MEDIC):
   626				rank = 2
   627			if best != -1:
   628				if rank > b_rank:
   629					continue
   630				if rank == b_rank:
   631					if d2 > b_d2:
   632						continue
   633					if d2 == b_d2:
   634						var hp: int = sh[j]
   635						if hp > b_hp:
   636							continue
   637						if hp == b_hp:
   638							var ey: int = sy[j]
   639							if ey > b_y:
   640								continue
   641							if ey == b_y:
   642								var dep: int = sx[j] if st[j] == 0 else W - sx[j]
   643								if dep >= b_dep:
   644									continue
   645			best = j
   646			b_rank = rank
   647			b_d2 = d2
   648			b_hp = sh[j]
   649			b_y = sy[j]
   650			b_dep = sx[j] if st[j] == 0 else W - sx[j]
   651		_last_rank = b_rank
   652		return best
   653	
   654	## ───────────────────────── 第四輪新兵種 ─────────────────────────
   655	
   656	## 平手鍵（鏡像不變、與輸入順序無關）：距離² → 列 → 離自己底線的深度 → 部署格。a 比 b 優先回傳 true。
   657	func _tie_less(d2a: int, a: Unit, d2b: int, b: Unit) -> bool:
   658		if d2a != d2b:
   659			return d2a < d2b
   660		if a.y != b.y:
   661			return a.y < b.y
   662		var da: int = a.x if a.team == 0 else W - a.x
   663		var db: int = b.x if b.team == 0 else W - b.x
   664		if da != db:
   665			return da < db
   666		return a.slot < b.slot
   667	
   668	## 最近的可見敵人距離²（沒有回傳 -1）。用 ① 快照。
   669	func _nearest_visible_enemy_d2(i: int, sx: PackedInt64Array, sy: PackedInt64Array, st: PackedInt64Array, sv: PackedByteArray) -> int:
   670		var best := -1
   671		for j in sx.size():
   672			if sv[j] == 0 or st[j] == st[i]:
   673				continue
   674			var d2 := M.dist2(sx[i], sy[i], sx[j], sy[j])
   675			if best < 0 or d2 < best:
   676				best = d2
   677		return best
   678	
   679	## 支援兵的跟隨點（第四輪 §2.3）：
   680	## 醫者先找 3 格內沒滿血、血比例最低的戰鬥兵友軍（交叉相乘比較）；沒有就（鼓手一律）用戰鬥兵友軍重心。
   681	## 只用 ① 快照的位置與血量；成員只算活著的非支援兵。
   682	func _support_point(i: int, sx: PackedInt64Array, sy: PackedInt64Array, sh: PackedInt64Array) -> Vector2i:
   683		var u := units[i]
   684		if u.type == D.MEDIC:
   685			var best := -1
   686			var bd2 := 0
   687			for j in units.size():
   688				var a := units[j]
   689				if j == i or not a.alive or a.team != u.team or D.is_support(a.type) or sh[j] >= a.max_hp:
   690					continue
   691				var d2 := M.dist2(sx[i], sy[i], sx[j], sy[j])
   692				if d2 > D.HEAL_RANGE * D.HEAL_RANGE:
   693					continue
   694				if best == -1 or _ratio_less(sh[j], a.max_hp, d2, a, sh[best], units[best].max_hp, bd2, units[best]):
   695					best = j
   696					bd2 = d2
   697			if best != -1:
   698				u.follow = best
   699				return Vector2i(sx[best], sy[best])
   700		# 重心：x 先換成「離自己底線的深度」再平均（鏡像不變），y 直接平均；都是非負整數，截斷方向一致
   701		var sd := 0
   702		var sy2 := 0
   703		var cnt := 0
   704		for j in units.size():
   705			var a := units[j]
   706			if not a.alive or a.team != u.team or D.is_support(a.type):
   707				continue
   708			sd += sx[j] if u.team == 0 else W - sx[j]
   709			sy2 += sy[j]
   710			cnt += 1
   711		if cnt == 0:
   712			return Vector2i(sx[i], sy[i])
   713		var dep := sd / cnt
   714		return Vector2i(dep if u.team == 0 else W - dep, sy2 / cnt)
   715	
   716	## 血比例比較：hp_a/max_a < hp_b/max_b（交叉相乘，不用浮點）；同比例再比平手鍵。
   717	func _ratio_less(hpa: int, ma: int, d2a: int, a: Unit, hpb: int, mb: int, d2b: int, b: Unit) -> bool:
   718		var l := hpa * mb
   719		var r := hpb * ma
   720		if l != r:
   721			return l < r
   722		return _tie_less(d2a, a, d2b, b)
   723	
   724	## 醫者補血（④）：冷卻每 tick 倒數；到 0 時選 3 格內（④ 位置）、沒滿血、不是自己的活著友軍裡血比例最低的（血量用 ① 快照）。
   725	## 沒有可補的對象就不消耗冷卻；被暈不補。所有醫者從同一份快照選，彼此不影響。
   726	func _try_heal(i: int, sh: PackedInt64Array, heals: Array) -> void:
   727		var u := units[i]
   728		if u.hcd > 0:
   729			u.hcd -= 1
   730			return
   731		if u.stun > 0:
   732			return
   733		var best := -1
   734		var bd2 := 0
   735		for j in units.size():
   736			var a := units[j]
   737			if j == i or not a.alive or a.team != u.team or sh[j] >= a.max_hp:
   738				continue
   739			var d2 := M.dist2(u.x, u.y, a.x, a.y)
   740			if d2 > D.HEAL_RANGE * D.HEAL_RANGE:
   741				continue
   742			if best == -1 or _ratio_less(sh[j], a.max_hp, d2, a, sh[best], units[best].max_hp, bd2, units[best]):
   743				best = j
   744				bd2 = d2
   745		if best == -1:
   746			return
   747		var amt := D.HEAL_AMT if not frenzy else D.HEAL_AMT / 2
   748		heals.append([i, best, amt, bd2])
   749		u.hcd = D.HEAL_CD
   750	
   751	## ⑤ 補血：傷害已經扣完；血 ≤0 的照死不補。同一隻被多個醫者選中只吃最大的一筆，記功給（量大→平手鍵）的那個醫者。
   752	## 這一 tick 死掉的醫者，已經發出的補血仍然有效（同時結算）。
   753	func _apply_heals(heals: Array) -> void:
   754		var by_t := {}
   755		for h in heals:
   756			var t: int = h[1]
   757			if not by_t.has(t):
   758				by_t[t] = h
   759				continue
   760			var cur: Array = by_t[t]
   761			if h[2] > cur[2] or (h[2] == cur[2] and _tie_less(h[3], units[h[0]], cur[3], units[cur[0]])):
   762				by_t[t] = h
   763		var ts := by_t.keys()
   764		ts.sort()
   765		for t in ts:
   766			var h: Array = by_t[t]
   767			var tg := units[t]
   768			if not tg.alive or tg.hp <= 0:
   769				continue
   770			var real := mini(int(h[2]), tg.max_hp - tg.hp)
   771			if real <= 0:
   772				continue
   773			tg.hp += real
   774			units[h[0]].heal_done += real
   775			events.append({"kind": EV.HEAL, "src": units[h[0]].id, "tgt": tg.id, "amt": real, "tags": [EV.HEAL]})
   776	
   777	## 爆炸波及：主目標 ④ 位置 0.9 格內、① 快照可見、活著的其他敵人，依平手鍵取前 SPLASH_MAX 隻。
   778	func _splash_victims(ti: int, st: PackedInt64Array, sv: PackedByteArray) -> Array:
   779		var c := units[ti]
   780		var cand: Array = []
   781		for j in units.size():
   782			if j == ti or sv[j] == 0 or st[j] != st[ti] or not units[j].alive:
   783				continue
   784			var d2 := M.dist2(c.x, c.y, units[j].x, units[j].y)
   785			if d2 <= D.SPLASH_R * D.SPLASH_R:
   786				cand.append([d2, j])
   787		cand.sort_custom(func(p, q): return _tie_less(p[0], units[p[1]], q[0], units[q[1]]))
   788		var out: Array = []
   789		for k in mini(D.SPLASH_MAX, cand.size()):
   790			out.append(cand[k][1])
   791		return out
   792	
   793	## 劍士反擊選人：打中它的刺客裡挑「最近→列小→離自己底線近」；只用鏡像不變的鍵，不用編號。
   794	func pick_counter(si: int, attackers: Array) -> int:
   795		var sw := units[si]
   796		var best := -1
   797		var bd := 0
   798		var by := 0
   799		var bdep := 0
   800		for ai in attackers:
   801			var a := units[ai]
   802			var d2 := M.dist2(sw.x, sw.y, a.x, a.y)
   803			var dep: int = a.x if a.team == 0 else W - a.x
   804			if best == -1 or d2 < bd or (d2 == bd and (a.y < by or (a.y == by and dep < bdep))):
   805				best = ai
   806				bd = d2
   807				by = a.y
   808				bdep = dep
   809		return best
   810	
   811	## 攻擊者是否在目標背後（以目標面向的內積判斷；剛好側面算正面）。
   812	func _is_behind(att: Unit, tg: Unit) -> bool:
   813		var dx := att.x - tg.x
   814		var dy := att.y - tg.y
   815		return dx * tg.fx + dy * tg.fy < 0
   816	
   817	func _same_dir(ax: int, ay: int, bx: int, by: int) -> bool:
   818		# 夾角小於約 25 度
   819		var dot := ax * bx + ay * by
   820		if dot <= 0:
   821			return false
   822		var la := ax * ax + ay * ay
   823		var lb := bx * bx + by * by
   824		return dot * dot * 100 >= la * lb * 82
   825	
   826	## 騎兵衝鋒累積（優化方案 B1）：只算「沿著這段衝鋒起始方向」的實際前進距離；
   827	## 被推開的位移不算；方向跟起始方向差太多（逐步轉彎也算）就重新開始；被擋住前進不到一半就歸零。
   828	func _update_charge(u: Unit, moved_x: int, moved_y: int) -> void:
   829		if u.mx == 0 and u.my == 0:
   830			return   # 沒有提出移動（停下攻擊或等待），在第⑤步處理
   831		var ml := M.isqrt(u.mx * u.mx + u.my * u.my)
   832		# 只算沿著自己提出方向的前進，而且最多算自己提出的距離（被往前推的部分不算）
   833		var along := mini(ml, (moved_x * u.mx + moved_y * u.my) / maxi(1, ml))
   834		if along * 2 < ml:
   835			u.charge = 0
   836			u.cdx = 0
   837			u.cdy = 0
   838			return
   839		if u.charge == 0 or not _same_dir(u.cdx, u.cdy, u.mx, u.my):
   840			u.charge = along
   841			u.cdx = u.mx
   842			u.cdy = u.my
   843		else:
   844			u.charge += along
   845	
   846	## 騎兵繞翼：目標是弓手、直線上 FLANK_DETECT 內有盾兵時，往敵兵較少的那側偏 FLANK_OFFSET 走途經點。
   847	## 騎兵追擊遲滯（第二輪方案 R1）：停著的要超出 reach 才起步；已經在追就追到 reach−CHASE_HYST 才停。
   848	static func cav_chase(chasing: bool, d2: int, reach: int) -> bool:
   849		var inner := reach - D.CHASE_HYST
   850		return d2 > reach * reach or (chasing and d2 > inner * inner)
   851	
   852	func _flank_waypoint(i: int, t: int) -> Vector2i:
   853		var u := units[i]
   854		var tg := units[t]
   855		if tg.type != D.ARCHER and tg.type != D.MEDIC and tg.type != D.BOMBER:   # 第四輪：繞翼也用在醫者、投彈兵
   856			u.wp_for = -1
   857			u.nav = 0
   858			u.wp_x = -1
   859			u.wp_y = -1
   860			return Vector2i(-1, -1)
   861		if u.wp_for == tg.id:
   862			# 同一個目標：照狀態走，不會因為離開途經點而回頭（第二輪方案 R1 根因 A）
   863			if u.nav == 1:
   864				if M.dist2(u.x, u.y, u.wp_x, u.wp_y) <= D.WP_REACHED * D.WP_REACHED:
   865					u.nav = 2
   866					return Vector2i(-1, -1)
   867				return Vector2i(u.wp_x, u.wp_y)
   868			return Vector2i(-1, -1)
   869		# 新目標：重新規劃一次
   870		u.wp_for = tg.id
   871		u.nav = 2
   872		u.wp_x = -1
   873		u.wp_y = -1
   874		var dx := tg.x - u.x
   875		var dy := tg.y - u.y
   876		var l2 := dx * dx + dy * dy
   877		if l2 == 0:
   878			return Vector2i(-1, -1)
   879		var blocked := false
   880		var above := 0
   881		var below := 0
   882		for e in units:
   883			if e.team == u.team or not e.alive:
   884				continue
   885			if e.y < u.y:
   886				above += 1
   887			elif e.y > u.y:
   888				below += 1
   889			if e.type != D.SHIELD or e.stealth > 0:
   890				continue
   891			var ex: int = e.x - u.x
   892			var ey: int = e.y - u.y
   893			var proj: int = ex * dx + ey * dy
   894			if proj <= 0 or proj >= l2:
   895				continue
   896			var cross: int = ex * dy - ey * dx
   897			if cross * cross < D.FLANK_DETECT * D.FLANK_DETECT * l2:
   898				blocked = true
   899		if not blocked:
   900			return Vector2i(-1, -1)
   901		# 上下兩個候選點都先夾在離邊界有餘裕的範圍；夾完之後如果離直線不到 FLANK_DETECT（沒有真的繞開）就不採用
   902		var lo := EDGE + D.FLANK_EDGE_MARGIN
   903		var hi := H - EDGE - D.FLANK_EDGE_MARGIN
   904		var mid_x := u.x + (tg.x - u.x) / 2   # 用差值往 0 截斷，左右鏡像才對稱
   905		var line_y := u.y + (tg.y - u.y) / 2
   906		var up_y := clampi(mini(u.y, tg.y) - D.FLANK_OFFSET, lo, hi)
   907		var dn_y := clampi(maxi(u.y, tg.y) + D.FLANK_OFFSET, lo, hi)
   908		# 用叉積算候選點到「騎兵→目標」直線的垂直距離（不是只比 y 差），近乎垂直的路線也判得對（Codex R1 審查 #2）
   909		var cu: int = (mid_x - u.x) * dy - (up_y - u.y) * dx
   910		var cd: int = (mid_x - u.x) * dy - (dn_y - u.y) * dx
   911		var need: int = D.FLANK_DETECT * D.FLANK_DETECT * l2
   912		var up_ok := up_y < line_y and cu * cu >= need
   913		var dn_ok := dn_y > line_y and cd * cd >= need
   914		var wy := -1
   915		if up_ok and (not dn_ok or above <= below):
   916			wy = up_y
   917		elif dn_ok:
   918			wy = dn_y
   919		if wy < 0:
   920			return Vector2i(-1, -1)   # 兩側都沒有空間繞：直接追
   921		u.nav = 1
   922		events.append({"kind": EV.FLANK, "src": u.id, "tgt": tg.id, "tags": [EV.FLANK]})
   923		u.wp_x = mid_x
   924		u.wp_y = wy
   925		return Vector2i(u.wp_x, u.wp_y)
   926	
   927	## 完整狀態指紋：每 tick 依 id 順序寫入固定 35 個 int64 欄位（第四輪加 7 個）。
   928	func _hash_state() -> void:
   929		var a := PackedInt64Array()
   930		a.resize(units.size() * 35 + 1)
   931		a[0] = tick
   932		var k := 1
   933		for u in units:
   934			a[k] = u.x; a[k + 1] = u.y; a[k + 2] = u.hp; a[k + 3] = u.cd; a[k + 4] = u.target
   935			a[k + 5] = u.fx; a[k + 6] = u.fy; a[k + 7] = u.face_lock; a[k + 8] = u.mx; a[k + 9] = u.my
   936			a[k + 10] = u.cdx; a[k + 11] = u.cdy; a[k + 12] = u.stealth; a[k + 13] = u.charge; a[k + 14] = u.stun
   937			a[k + 15] = u.slow; a[k + 16] = u.wp_x; a[k + 17] = u.wp_y; a[k + 18] = u.wp_for; a[k + 19] = 1 if u.alive else 0
   938			a[k + 20] = u.dmg_dealt; a[k + 21] = u.dmg_taken; a[k + 22] = u.kills; a[k + 23] = u.id; a[k + 24] = u.team; a[k + 25] = u.type
   939			a[k + 26] = u.nav; a[k + 27] = 1 if u.chasing else 0
   940			a[k + 28] = u.hcd; a[k + 29] = u.aura; a[k + 30] = u.breach; a[k + 31] = u.bmode; a[k + 32] = u.heal_done; a[k + 33] = u.follow
   941			a[k + 34] = u.drum_cover
   942			k += 35
   943		_hash.update(a.to_byte_array())
   944	
   945	func _check_end() -> void:
   946		var a0 := alive_count(0)
   947		var a1 := alive_count(1)
   948		if a0 == 0 and a1 == 0:
   949			_finish(-1, "同時全滅")
   950		elif a1 == 0:
   951			_finish(0, "全滅")
   952		elif a0 == 0:
   953			_finish(1, "全滅")
   954		elif tick >= MAX_TICKS:
   955			var p0 := power(0)
   956			var p1 := power(1)
   957			if absi(p0 - p1) < budget * 30:
   958				_finish(-1, "時間到・戰力相當")
   959			elif p0 > p1:
   960				_finish(0, "時間到・剩餘戰力較高")
   961			else:
   962				_finish(1, "時間到・剩餘戰力較高")
   963	
   964	func _finish(w: int, r: String) -> void:
   965		finished = true
   966		winner = w
   967		reason = r
   968		_hash.update(PackedInt64Array([tick, w]).to_byte_array())
   969		fingerprint = _hash.finish().hex_encode()
