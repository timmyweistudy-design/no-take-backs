   196					continue
   197				var fp := _support_point(i, sx, sy, sh)
   198				var bx := fp.x - D.SUPPORT_BACK if u.team == 0 else fp.x + D.SUPPORT_BACK
   199				var dest_sx := clampi(bx, EDGE, W - EDGE)
   200				var dest_sy := clampi(fp.y, EDGE, H - EDGE)
   201				var sdx := dest_sx - u.x
   202				var sdy := dest_sy - u.y
   203				var sl := M.isqrt(sdx * sdx + sdy * sdy)
   204				if sl > D.SUPPORT_STOP:
   205					var sstp := mini(u.speed, sl)
   206					u.mx = sdx * sstp / sl
   207					u.my = sdy * sstp / sl
   208					nx[i] = u.x + u.mx
   209					ny[i] = u.y + u.my
