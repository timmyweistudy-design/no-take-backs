   221	## 困難 AI：第 1 局沒有資訊，用會讀對方的落子 AI 自己組；之後讀你上一局的陣型，
   222	## 先查離線反制庫（組成最接近的原型），查不到就用啟發式反制。不偷看你這一局。
   223	func _hard_ai(r: RandomNumberGenerator) -> Army:
   224		var known: Array = last_player_formation if round_no > 1 else []
   225		if not known.is_empty():
   226			var lib := _counter_lib()
   227			if not lib.is_empty():
   228				var mine := D.zeros()
   229				for u in known:
   230					mine[u["type"]] += D.cost(u["type"])
   231				var best = null
   232				var bd := 1 << 30
   233				for e in lib:
   234					var d := 0
   235					var pc: Array = e["proto_comp"]
   236					for k in mine.size():
   237						d += absi((int(pc[k]) if k < pc.size() else 0) - mine[k])
   238					if d < bd:
   239						bd = d
   240						best = e
   241				if best != null and bd <= 40:
   242					var a := Army.new(1, 100)
   243					if a.load_code(best["code"]) == "" and _types_ok(a):
   244						return a
   245		return AIT.build_full(1, r, 2, known, _ntypes())
