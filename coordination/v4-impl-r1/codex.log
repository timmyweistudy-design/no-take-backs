     7	## 每一列都帶 digest、ntypes、模式與鍵，報表會核對筆數與鍵集合（第三輪學到：資料可能被改名騙過）。
     8	const Sim = preload("res://scripts/core/battle_sim.gd")
     9	const Army = preload("res://scripts/core/army.gd")
    10	const D = preload("res://scripts/core/unit_defs.gd")
    11	const F = preload("res://scripts/core/formations.gd")
    12	
    13	## 核心關係（§2.6 預先指定，不能事後改表過關）：[X, Y, 說明]
    14	const CORE := [
    15		[D.PIKE, D.CAVALRY, "長槍兵 > 騎兵"],
    16		[D.BOMBER, D.SHIELD, "投彈兵 > 盾兵牆"],
    17		[D.CAVALRY, D.BOMBER, "騎兵 > 投彈兵"],
    18		[D.ARCHER, D.BOMBER, "弓箭手 > 投彈兵"],
    19		[D.ASSASSIN, D.MEDIC, "刺客 > 醫者"],
    20		[D.ARCHER, D.BERSERKER, "弓箭手 > 狂戰士"],
    21	]
    22	const CORE_SEEDS := 40
    23	const REPL_N := 200
    24	const REPL_OPPS := 6
    25	const COVER_N := 120
    26	const COVER_OPPS := 4
    27	
    28	var args := {}
    29	
    30	func _init() -> void:
    31		for a in OS.get_cmdline_user_args():
    32			if a.begins_with("--") and "=" in a:
    33				var kv := a.substr(2).split("=", true, 1)
    34				args[kv[0]] = kv[1]
    35		var shard := int(args.get("shard", "0"))
    36		var shards := int(args.get("shards", "1"))
    37		var nt := int(args.get("ntypes", str(D.COUNT)))
    38		match args.get("mode", "core"):
    39			"core": core(shard, shards)
    40			"repl": repl(int(args.get("unit", "5")), nt, shard, shards)
    41			"replshield": repl(int(args.get("unit", "9")), nt, shard, shards, true)
    42			"cover": cover(int(args.get("unit", "7")), nt, shard, shards)
    43		quit(0)
    44	
    45	func emit(d: Dictionary) -> void:
    46		d["digest"] = D.data_digest()
    47		print("R ", JSON.stringify(d))
    48	
    49	## a 是藍方表示的陣型（team 0）、b 也是；交換左右各打一場。回傳 a 的得分列表 [第一場, 第二場]（1／0.5／0）。
    50	static func duel2(a: Army, b: Army) -> Array:
    51		var s1 = Sim.new(a.copy(), b.mirrored())
    52		s1.fast = true
    53		s1.run_to_end()
    54		var s2 = Sim.new(b.copy(), a.mirrored())
    55		s2.fast = true
    56		s2.run_to_end()
    57		return [1.0 if s1.winner == 0 else (0.5 if s1.winner < 0 else 0.0), 1.0 if s2.winner == 1 else (0.5 if s2.winner < 0 else 0.0)]
    58	
    59	func core(shard: int, shards: int) -> void:
    60		var idx := 0
    61		for ri in CORE.size():
    62			for sd in CORE_SEEDS:
    63				idx += 1
    64				if idx % shards != shard:
    65					continue
    66				var rng := RandomNumberGenerator.new()
    67				rng.seed = 90001 + ri * 1013 + sd * 7919
    68				var wx := D.zeros()
    69				wx[CORE[ri][0]] = 3
    70				wx[D.SWORD] += 1
    71				wx[D.ARCHER] += 1
    72				var wy := D.zeros()
    73				wy[CORE[ri][1]] = 3
    74				wy[D.SWORD] += 1
    75				wy[D.ARCHER] += 1
    76				var style: String = F.STYLES[sd % F.STYLES.size()]
    77				var ax := F.weighted_formation(0, rng, wx, style)
    78				var ay := F.weighted_formation(0, rng, wy, style)
    79				var sc := duel2(ax, ay)
    80				emit({"mode": "core", "r": ri, "seed": sd, "s0": sc[0], "s1": sc[1]})
