  1588	func test_roster_ui() -> void:
  1589		var RS = load("res://scripts/game/roster.gd")
  1590		var GS = load("res://scripts/ui/game_screens.gd")
  1591		var bad: Array = []
  1592		if RS.unlocked_count(0) != 5 or RS.unlocked_count(2) != 5 or RS.unlocked_count(3) != 6 or RS.unlocked_count(11) != 10 or RS.unlocked_count(99) != 10:
  1593			bad.append("解鎖場數")
  1594		if RS.unlocked_count(99, true) != 7:
  1595			bad.append("試玩版上限")
  1596		if RS.ntypes_for("duel", 0, false) != 10 or RS.ntypes_for("duel", 0, true) != 5 or RS.ntypes_for("ai", 4, false) != 6 or RS.ntypes_for("ai", 99, true) != 5:
  1597			bad.append("模式開放數")
  1598		if RS.games_to_unlock(D.MEDIC, 6) != 1 or RS.games_to_unlock(D.SWORD, 0) != 0 or RS.games_to_unlock(D.BERSERKER, 99, true) != -1:
  1599			bad.append("還要幾場")
  1600		if RS.newly_unlocked(2, 3) != [D.PIKE] or not RS.newly_unlocked(3, 4).is_empty():
  1601			bad.append("新解鎖提示")
  1602		# AI 只用開放的兵種：經典 5 種時，所有模板與落子 AI 都不會拿出新兵
  1603		var rng := RandomNumberGenerator.new()
  1604		for i in 40:
  1605			rng.seed = 900 + i
  1606			var a = AI.build(1, 100, rng, -1, 5)["army"]
  1607			var b = load("res://scripts/core/ai_turns.gd").build_full(1, rng, i % 3, [], 5)
  1608			for u in a.units + b.units:
  1609				if int(u["type"]) >= 5:
  1610					bad.append("經典模式 AI 用了兵種 %d" % u["type"])
  1611					break
  1612		ok(bad.is_empty(), "兵種開放：場數解鎖、試玩版上限、經典模式、AI 不用未開放的兵種", str(bad))
  1613		# 結果頁兵種長條：只列出場的、合計最多的 5 種
  1614		var dealt := [D.zeros(), D.zeros()]
  1615		var taken := [D.zeros(), D.zeros()]
