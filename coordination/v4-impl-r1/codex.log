   256	func _counter_lib() -> Array:
   257		if not FileAccess.file_exists("res://data/counter_lib.json"):
   258			return []
   259		return counter_lib_entries(JSON.parse_string(FileAccess.get_file_as_string("res://data/counter_lib.json")))
   260	
