func _process(delta: float) -> void:
	_throttle_when_minimized()
	_rv_poll()
	_settings_hover()
	var _t0 := Time.get_ticks_usec()
	_process_inner(delta)
	perf_proc_us = Time.get_ticks_usec() - _t0


func _process_inner(delta: float) -> void:
	_stick_repeat(delta)
	_process_cmds()
	time += delta
	if paused and key_t > 0.0:
		key_t += delta   # V1.3 C4：暫停時關鍵時刻的演出凍結（Codex v130-impl2）
	SteamApi.run_callbacks()
	if toast_t > 0:
		toast_t -= delta
	if removed_banner_t > 0.0:
		removed_banner_t -= delta
	if ach_t > 0:
		ach_t -= delta
	elif not ach_queue.is_empty():
		toast = ach_queue.pop_front()
		toast_t = 2.5
		ach_t = 2.6
	shake = maxf(0.0, shake - delta)
	if not freeze_fx:
		for f in fx:
			f["t"] += delta
			if f.has("pop"):
				f["pop"] = maxf(0.0, f["pop"] - delta)
		fx = fx.filter(func(f): return f["t"] < f["dur"])
		clutch_t = maxf(0.0, clutch_t - delta)
	for g in dying:
		var t0: float = g["t"]
		g["t"] += delta
		if t0 < 1.0 and g["t"] >= 1.0:   # 只在跨過 1 秒那一幀插旗（倒棋留 1.7 秒，Codex v130-impl1）
			graves.append({"pos": g["pos"], "team": g["team"], "t": 0.0})
	dying = dying.filter(func(g): return g["t"] < death_life(int(g["type"])))   # V1.3 A5：倒棋留 1.7 秒
	for g in graves:
		g["t"] += delta
	graves = graves.filter(func(g): return g["t"] < 3.0)
	if overlay == "codex":
		_codex_tick(delta)
	if overlay == "ai_busy":
		_ai_poll()
	if not pre_old.is_empty():
		_pre_reap()
func _seek_begin(target: int) -> void:
	var armies2: Array = rv_last if play_kind == "review" and not rv_last.is_empty() else last_armies
	sim = Sim.new(armies2[0].copy(), armies2[1].copy(), battle_rules)
	call("_cmd_setup", sim, play_kind)
	ev_count = {}
	set("last_blast_tick", -99)
	_seek_ct = -1
	battle_marks.clear()
	_seek_stop = maxi(0, target - ViewBuffer.DELAY)
	_seek_target_now = target

var _seek_target_now := 0

## 算到時間用完或到達目標；到達回傳 true。
func _seek_tick(budget_ms: int) -> bool:
	var t0 := Time.get_ticks_msec()
	while sim.tick < _seek_stop and not sim.finished:
		if Time.get_ticks_msec() - t0 >= budget_ms:
			return false
		sim.step()
		for ev in sim.events:   # 快轉時也要累計戰報次數與時間軸標記（Codex S5 #4：共用同一個收集函式）
			if ev.has("src"):
				var s = sim.unit_by_id(ev["src"])
				var key := "%s%d" % [ev["kind"], s.team]
				ev_count[key] = int(ev_count.get(key, 0)) + 1
				if ev["kind"] == EV.BLAST and not ev.has("dmg"):
					ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
			_collect_mark(ev, sim, sim.tick)
		if _seek_ct < 0 and not sim.finished and clutch_cond(sim):
			_seek_ct = sim.tick
	return true

func _seek_finish() -> void:
	var target := _seek_target_now
	var keep_ct := _seek_ct
	var had_clutch := keep_ct >= 0
	view = ViewBuffer.new(sim)
	prev_pos.clear()
	_gait_reset()
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	fx.clear()
	dying.clear()
	graves.clear()
	atk_hit.clear()
	atk_seq.clear()
	atk_t.clear()
	hurt_t.clear()
	hurt_dir.clear()
	brace_t.clear()
	accum = 0.0
	result_delay = 0.0
	clutch_t = 0.0
	slow_left = 0.0
	final_left = 0.0     # Codex v10-r1 #4：跳回前段不能留著慢動作，再播到末擊要再演
	final_used = false
	key_used = false
	key_t = -10.0
	hitstop = 0.0
	# 演出狀態依目標時間重建（Codex S5 #5）：最後時刻是否已發生、是否已進狂熱、音樂
	slow_used = had_clutch
	clutch_tick = keep_ct if had_clutch else -1
	if had_clutch:
		battle_marks.append({"tick": keep_ct, "kind": "clutch", "team": -1})
	_pump_view()
	# 畫面推到剛好第 target tick（原本停在 target−DELAY）
	while view.tick < target and not view.finished:
		_sim_step(false)
	frenzy_seen = view.frenzy
	if sfx != null:
		sfx.play_music("music_frenzy" if view.frenzy else "music_battle")

## 點戰場上的兵：鏡頭跟著它；點空地取消。
func _battle_click(p: Vector2) -> void:
				var hk: String = ["1", "2", "3"][i] if tm == 0 else ["8", "9", "0"][i]
				if pad_mode and tm == 0 and i < 2:
					hk = _pk("prev" if i == 0 else "next")
				_text(r.position + Vector2(6, 4), hk, tz("C"), TXT_DIM)
			_probe_btn_label = false
			var wait: int = int(sim.cmd_ready[tm][s]) - sim.tick
			if wait > 0 and int(sim.cmd_left[tm][s]) > 0:
				var frac: float = clampf(float(wait) / maxf(1.0, float(sim.cmd_cd)), 0.0, 1.0)
				draw_rect(Rect2(r.position, Vector2(r.size.x, r.size.y * frac)), Color(0, 0, 0, 0.5))

func _on_event(ev: Dictionary, with_fx: bool) -> void:
	var k: String = ev["kind"]
	if k == EV.CMD or k == EV.CMD_HIT:
		_cmd_event(ev, with_fx)
		return
	if _on_event_v8(ev, k, with_fx):
		return
	if k == EV.DEATH:
		var u = view.unit_by_id(ev["id"])
		if with_fx:
			last_kill = [int(ev.get("src", -1)), time]   # V1.3.1 P2：最後一擊定格用（誰、什麼時候）
		dying.append({"pos": _upos(u), "type": u.type, "team": u.team, "face": signf(u.fx) if u.fx != 0 else 1.0, "t": 0.0})
		if with_fx:
			sfx.play_unit("death", 0.7, u.type)   # V1.3.1：倒下的聲音依兵種音高
			_death_extra(u)
			# V1.1 B2：殘局「斬首」的目標倒下：頓格＋微震＋大字（只動播放，不進模擬）
			if mode == Mode.PUZZLE and _goal_target_id() == int(ev["id"]):
				if not bool(Save.s("reduce_fx")):
					hitstop = maxf(hitstop, 0.3)   # 簡化特效時不頓格（Codex v110-impl2）
				if _fx_on("shake"):
					shake = maxf(shake, 0.18)
				_fx_text(Vector2(640, 150), L.t("ev_behead"), ACCENT, 1.2, tz("H2"), true)
				sfx.play("bell", 0.9)
		return
	if k == EV.HEAL and with_fx:
		# 補血（第四輪 §4.4）：醫者到目標一條淡綠弧線＋綠色「+N」（不加黑底）
