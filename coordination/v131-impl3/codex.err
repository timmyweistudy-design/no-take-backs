extends "res://scripts/ui/battle/battle_units.gd"
## 其他層在同資料夾（V9 P1 拆檔）

func _on_skip() -> void:
	if skip_busy:
		return   # 防重入
	paused = false   # Codex r1：暫停中按直接看結果，算完要能進結算
	if DisplayServer.get_name() == "headless" or shot_dir != "":
		while not view.finished:
			_sim_step(false)
		result_delay = 9.0
		return
	skip_busy = true


func _skip_step() -> void:
	var t0 := Time.get_ticks_msec()
	while not view.finished and Time.get_ticks_msec() - t0 < 10:
		_sim_step(false)
	if view.finished:
		skip_busy = false
		result_delay = 9.0


## 第十輪 I4：重播的全長在背景算，算完才開始播。
func _pre_join() -> void:
	if pre_thread != null:
		var v = pre_thread.wait_to_finish()
		pre_thread = null
		if v != null:
			replay_total = int(v)

## 不要等：還在算就留給 _pre_reap 收。
func _pre_drop() -> void:
	if pre_thread != null:
		pre_old.append(pre_thread)
		pre_thread = null

func _pre_reap() -> void:
	for i in range(pre_old.size() - 1, -1, -1):
		if not pre_old[i].is_alive():
			pre_old[i].wait_to_finish()
			pre_old.remove_at(i)

func _exit_tree() -> void:
	_pre_join()
	_pre_drop()
	for th in pre_old:
		th.wait_to_finish()
	pre_old.clear()
	if ai_thread != null:
		ai_thread.wait_to_finish()
		ai_thread = null

func _battle_process(delta: float) -> void:
	if pre_thread != null:
		if pre_thread.is_alive():
			return
		_pre_join()
	if view != null:
		_gait_frame(delta)   # 不能放在只有部分情況才跑的地方（Codex P2 #1）
	if start_hold > 0.0:
		start_hold -= delta
		return
	if call("_seek_pump"):
		return
	if skip_busy:
		_skip_step()
		return
	if paused:
		return
	if hitstop > 0:
		hitstop -= delta
		return
	var rate := speed
	if slow_left > 0:
		rate *= 0.5
		slow_left -= delta
	if final_left > 0:
		rate *= 0.25      # 第十輪 F1：最後一擊
		final_left -= delta
		_update_action_focus()
	accum += delta * rate
	while accum >= 0.05 and not view.finished:
		accum -= 0.05
		var was_slow := slow_left > 0 or final_left > 0
		_sim_step(true)
		if (slow_left > 0 or final_left > 0) and not was_slow:
			break   # 這一 tick 觸發慢動作：剩下的累積留到下一幀用慢速消耗（Codex S8 #3）
	# 播完之後展示時鐘繼續走（不再推進快照）：最後一格的位置插值與最後一擊的後搖要演完（Codex R5 #1）
	# 最後時刻只在 _sim_step 每個畫面 tick 判定（Codex S8 #1：每幀也判會讓觸發 tick 跟幀率有關）
	if slow_left > 0:
		_update_action_focus()
	sfx.set_muffled(slow_left > 0 and not view.finished)
	# 分軌音樂依戰況混音（第三輪 S1）
	var close := absf(view.power(0) * 100.0 / (view.budget_of(0) * 1000) - view.power(1) * 100.0 / (view.budget_of(1) * 1000)) <= 15.0
	sfx.set_layer_targets(sfx.layer_targets(close, slow_left > 0 and not view.finished))
	# 鏡頭只有一個決策點（Codex S5 #6）：跟拍優先於最後時刻框選，兩者都沒有才回到全景
	if follow_id >= 0:
		pass   # 由 _follow_update 決定
	elif slow_left > 0 and not view.finished:
		_frame_alive(delta)
	else:
		zoom_target = 1.0
		zoom_center = zoom_center.lerp(ORIGIN + fld_size / 2, minf(1.0, delta * 3))
	zoom = lerpf(zoom, zoom_target, delta * 3)
	if view.finished:
		result_delay += delta
		if result_delay > 1.4:
			on_battle_finished.call()



## with_fx＝false（直接看結果、重播跳轉補播）只記狀態與標記，不放慢動作、不播音效、不出橫幅（Codex S8 #2）。
func _check_clutch(with_fx := true) -> void:
	if slow_used or view.finished:
		return
	if clutch_cond(view):
		slow_used = true
		clutch_tick = view.tick
		battle_marks.append({"tick": view.tick, "kind": "clutch", "team": -1})
		if not with_fx:
			return
		if _fx_on("slowmo"):
			slow_left = 8.0
		clutch_t = 1.6   # 最後時刻橫幅（第三輪 V2）：獨立一層畫在 _draw_clutch_banner
		sfx.play("clutch")



## 鏡頭安全框（優化方案 F2）：把所有存活單位框進畫面，四周留 15%。
func _frame_alive(delta: float) -> void:
	var lo := Vector2(1e9, 1e9)
	var hi := Vector2(-1e9, -1e9)
	for u in view.units:
		if u.alive:
			var p := _upos(u)
			lo = lo.min(p - Vector2(30, 70))
			hi = hi.max(p + Vector2(30, 20))
	var size := (hi - lo) / 0.7
	zoom_target = clampf(minf(1280.0 / maxf(1, size.x), 620.0 / maxf(1, size.y)) * 1.05, 1.08, 1.55)   # 再往勝負焦點收 5%（V2）
	zoom_center = zoom_center.lerp((lo + hi) / 2, minf(1.0, delta * 3))



## 第十輪 F1：模擬領先畫面 DELAY 個 tick，已知全滅就在倒下前放慢。和局、逾時、同歸於盡都不演。
func _check_final(with_fx: bool) -> void:
	if final_used or not with_fx or not sim.finished or sim.winner < 0 or sim.reason != "全滅":
		return
	final_used = true
	if _fx_on("slowmo"):
		final_left = 0.6
	if _fx_on("shake"):
		shake = maxf(shake, 0.15)

## 畫面前進一個 tick：模擬保持領先 DELAY 個 tick，畫面播最舊的那一份快照（R5 展示緩衝）。
func _sim_step(with_fx: bool) -> void:
	_pump_view()
	_check_final(with_fx)
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	if not view.advance():
		view.finished = true
		return
	_gait_tick(with_fx)
	_pump_view()
	_check_clutch(with_fx)   # 每一個畫面 tick 都判定（原本每一幀判一次，觸發的 tick 會跟幀率有關）
	if view.frenzy and not frenzy_seen:
		frenzy_seen = true
		if with_fx:
			_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
			sfx.play("frenzy")
			sfx.play_music("music_frenzy")
	var deaths := 0
	for ev in view.events:
		var k: String = ev["kind"]
		if ev.has("src"):
			var s = view.unit_by_id(ev["src"])
			var key := "%s%d" % [k, s.team]
			ev_count[key] = int(ev_count.get(key, 0)) + 1
			if k == EV.BLAST and not ev.has("dmg"):   # 第八輪：爆炸演出一筆一次；逐目標傷害不算次數（BOOM_5）
				ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
		if k == EV.DEATH:
			deaths += 1
		_collect_mark(ev, view, view.tick)
		_on_event(ev, with_fx)
	# 碾壓局最後一擊（優化方案 F1）：0.2 秒頓格＋微震，直接進結算
	if view.finished and not slow_used and deaths > 0 and with_fx:
		hitstop = 0.2
		if bool(Save.s("shake")):
			shake = 0.15



## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
func _pump_view() -> void:
	for fr in view.pump(sim):
		for e in fr["events"]:
			# 第四輪：補血、戰鼓也走出手動畫；被貼身敲人、破陣、補血、戰鼓用專屬動作（variant 2）
			if e["kind"] == EV.HEAL or e["kind"] == EV.DRUM or e["kind"] == EV.BONK or e.get("tags", []).has(EV.BREACH):
				var ah: Dictionary = alt_hit.get(e["src"], {})
				ah[int(fr["tick"])] = true
				if ah.size() > 8:
					ah.erase(ah.keys().min())
				alt_hit[e["src"]] = ah
	_ensure_sprites([a0, a1])
	if kind == "official":
		last_armies = [a0.copy(), a1.copy()]
		battle_rules = rules.copy() if rules != null else _puzzle_rules()   # 第十三輪：殘局自帶規則
	sim = Sim.new(a0, a1, battle_rules)
	_cmd_setup(sim, kind)
	view = ViewBuffer.new(sim)
	atk_seq.clear()
	clutch_tick = -1
	replay_total = 0
	if kind != "official":
		# 重播／覆盤：先用確定性模擬算出整場長度，時間軸以實際秒數為滿（Antigravity S5）
		var pa0 = a0.copy()
		var pa1 = a1.copy()
		var pr = battle_rules.copy() if battle_rules != null else null
		var plog: Array = last_cmds.duplicate(true)
		var run_pre := func() -> int:
			var pre = Sim.new(pa0, pa1, pr)
			if pre.cmd_on:
				pre.cmd_play(plog)
			pre.fast = true
			pre.run_to_end()
			return pre.tick
		if _async_ok():
			pre_thread = Thread.new()
			pre_thread.start(run_pre)
		else:
			replay_total = run_pre.call()
	paused = false
	follow_id = -1
	battle_marks.clear()
	report_log.clear()
	skip_busy = false
	seek_target = -1
	if kind == "official":
		replay_snap = {}
	start_hold = 0.0
	if kind == "official" and shot_dir == "" and DisplayServer.get_name() != "headless" and not bool(Save.s("reduce_fx")):
		start_hold = 1.0
		if sfx != null:
			sfx.play("bugle", 0.8)
	graves.clear()
	clutch_t = 0.0
	atk_hit.clear()
	alt_hit.clear()
	bomb_tgt.clear()
	brace_t.clear()
	state = St.BATTLE
	prev_pos.clear()
	_gait_reset()
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	_pump_view()   # 開場先預填 DELAY 個 tick
	accum = 0.0
	slow_used = false
	final_used = false
	key_used = false
	key_t = -10.0
	final_left = 0.0
	slow_left = 0.0
	hitstop = 0.0
	zoom = 1.0
	zoom_target = 1.0
	fx.clear()
	dying.clear()
	atk_t.clear()
	hurt_t.clear()
	last_blast_tick = -99
	ev_count = {}
	frenzy_seen = false
	result_delay = 0.0
	pt_call_tick = -1
	pt_rated = false
	_focus = 0
	speed = float(Save.s("speed"))
	sfx.play("start")
	sfx.play("horn", 0.55)
	sfx.play_music("music_battle")
			cnt[su.team] += 1
			if su.alive:
				liv[su.team] += 1
		for gt in 2:
			var mine := float(liv[gt]) / maxf(1.0, cnt[gt])
			var theirs := float(liv[1 - gt]) / maxf(1.0, cnt[1 - gt])
			grim[gt] = mine < 0.25 and theirs > mine * 2.0
	# V1.3 P0-1：這一幀的畫面位置只算一次（排序比較器原本每次比較都重算 _upos）
	var pc := {}
	if live:
		for u in list:
			pc[u.id] = _upos(u)
		list.sort_custom(func(a, b): return pc[a.id].y < pc[b.id].y)
	else:
		list.sort_custom(func(a, b): return a.y < b.y)
	_draw_v8_ground(s, live)
	# 第一層：腳底標記與影子（全部先畫，不會被別人的身體整個蓋住時也看得到外圈）
	var a_now := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
	var gm: Array = _goal_mark()
	if live:
		# V1.3 C3：戰報墨圈畫在最底層（腳底三層之下）
		for f in fx:
			if f["kind"] == "inkring":
				var ik: float = f["t"] / f["dur"]
				draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.5), 0, f["p"] + Vector2(0, 2)))   # 貼在地上（壓扁成橢圓）
				_hand_ring(Vector2.ZERO, (26.0 + ik * 8.0) * UNIT_SCALE, Color(0.12, 0.07, 0.04, 0.55 * (1.0 - ik)), 2.6, false, 1)
				draw_set_transform_matrix(_cam)
	for u in list:
		var p0: Vector2 = pc[u.id] if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
		var air0: float = Gait.air(u.type, _walk_of(u, a_now)) if live else 0.0
		var ar0 := clampf(air0 * 0.05, 0.0, 1.0)
		_ring(p0, u.team, u.type, UNIT_SCALE, ar0 if ar0 > 0.15 else 0.0)   # 小跳步不分層（效能：合成格一次貼完）   # V1.3 A3：木座和隊伍圈留在地上，只有影子跟著跳起縮
		if u.shield > 0:       # 第十二輪：手動技能的護盾、戰吼
			_hand_ring(p0 + Vector2(0, -24) * UNIT_SCALE, 28.0 * UNIT_SCALE, Color(0.55, 0.85, 1.0, 0.75), 2.5)
		if u.haste_t > 0:
			_hand_ring(p0, 19.0 * UNIT_SCALE, Color(1.0, 0.75, 0.25, 0.85), 2.5)
		if u.id == int(gm[0]) or (int(gm[0]) == -2 and u.team == 0 and u.type == int(gm[2]) and not u.summon):
			_goal_marker(p0, "protect" if int(gm[0]) == -2 else str(gm[1]))   # 第十三輪：要護送／斬首的那一隻；V1.1：不能倒的那種兵每隻都標
		if live and s.rally[u.team] and not s.finished:
			for k in 2:
				var ph := fmod(time * 1.6 + k * 0.5, 1.0)
				_hand_ring(p0, (14.0 + ph * 10.0) * UNIT_SCALE, Color(1, 0.42, 0.0, 0.55 * (1.0 - ph)), 2.0)
	# 陣亡痕跡：倒下處的小旗，3 秒淡出，畫在最底層（第三輪 R5）
	if live:
		for g in graves:
			var ga: float = 1.0 - g["t"] / 3.0
			var gp: Vector2 = g["pos"]
			draw_line(gp + Vector2(0, 2), gp + Vector2(0, -16), Color(0.35, 0.27, 0.2, 0.8 * ga), 2.0, true)
			draw_colored_polygon(PackedVector2Array([gp + Vector2(0, -16), gp + Vector2(10, -12), gp + Vector2(0, -8)]), Color(Art.team_color(g["team"], cbm()), 0.75 * ga))
			draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.4), 0, gp + Vector2(0, 2)))   # 疊在鏡頭上（Codex S4 #5）
			draw_circle(Vector2.ZERO, 7, Color(0, 0, 0, 0.25 * ga), true, -1.0, true)
			draw_set_transform_matrix(_cam)
	# 擁擠度：40px 內有幾隻（第三輪 V5，只在戰鬥中算）
	var crowd := {}
	if live:
		# V1.3 P0-1：40px 格子分桶，只比相鄰 9 格（判定與雙迴圈相同：距離平方 < 1600）
		var bk := {}
		for u in list:
			var q: Vector2 = pc[u.id]
			var key := Vector2i(floori(q.x / 40.0), floori(q.y / 40.0))
			if bk.has(key):
				bk[key].append(q)
			else:
				bk[key] = [q]
		for u in list:
			var q: Vector2 = pc[u.id]
			var cx := floori(q.x / 40.0)
			var cy := floori(q.y / 40.0)
			var n := -1   # 自己一定在同一格，先扣掉
			for dx in range(-1, 2):
				for dy in range(-1, 2):
					var cell = bk.get(Vector2i(cx + dx, cy + dy))
					if cell == null:
						continue
					for o in cell:
						if q.distance_squared_to(o) < 1600.0:
							n += 1
			crowd[u.id] = n
	# 第二層：身體（V9：地圖的前景物件依腳點 y 插進來，才有前後遮擋）
	var prop_i := 0
	var xray: Array = []   # V1.1 C5：[腳點, 參數]，給被下排蓋到臉的那隻補畫半透明
	for u in list:
		var p: Vector2 = pc[u.id] if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
		while prop_i < fld_props.size() and ORIGIN.y + float(fld_props[prop_i][0]) <= p.y:
			MapArt.draw_prop(self, ORIGIN, fld_props[prop_i], time)
			prop_i += 1
		var walk: float = _walk_of(u, a_now) if live else ((time * Gait.nominal_rate(u.type, float(D.stat(u.type)["speed"]), CS, UNIT_SCALE) + u.id) if (u.mx != 0 or u.my != 0) else 0.0)
		var moving: bool = walk > 0.0
		var at := 0.0
		var variant := 0
		var hit_now := -1
		if live and atk_hit.has(u.id):
			var dt0 := _disp_tick()
			var h := pick_hit(atk_hit[u.id], dt0, u.type)
			hit_now = h
			if h >= 0:
				at = atk_progress(dt0 - (h - ViewBuffer.DELAY), u.type)
				# 火罐飛行（第四輪 §4.4）：前搖期間從手上飛向目標，命中那一刻落地（模擬不受影響）
				if u.type == D.BOMBER and at > 0.0 and at < Art.ATK_WINDUP and bomb_tgt.get(u.id, {}).has(h):
					var bt = view.unit_by_id(bomb_tgt[u.id][h])
					if bt != null:
						var fk := at / Art.ATK_WINDUP
						var fsg: float = float(atk_face[u.id][1]) if atk_face.has(u.id) and int(atk_face[u.id][0]) == h else signf(u.fx) if u.fx != 0 else (signf(_upos(bt).x - _upos(u).x) if _upos(bt).x != _upos(u).x else 1.0)
						var src_p: Vector2 = _upos(u) + Vector2(fsg * 17.0, -24.0) * UNIT_SCALE   # V1.3.1：從手上的火罐位置起飛（原本是頭頂固定點）
						var dst_p: Vector2 = _upos(bt) + Vector2(0, -10)
						var pp := src_p.lerp(dst_p, fk) + Vector2(0, -sin(fk * PI) * minf(70.0, src_p.distance_to(dst_p) * 0.3))
						pot_draw.append(pp)
				if u.type == D.SWORD:
					variant = int(atk_seq.get(u.id, {}).get(h, 0)) % 2   # 劍士橫斬與上挑逐擊交替（第三輪 R4）
				elif u.type >= D.CLASSIC and alt_hit.get(u.id, {}).has(h):
					variant = 2
		var hurt := 0.0
		if live and hurt_t.has(u.id) and _fx_on("flash"):
			hurt = clampf(1.0 - (time - hurt_t[u.id]) / 0.15, 0, 1)
		var alpha := 0.45 if u.stealth > 0 else 1.0
		if dim:
			alpha *= 0.6
		if live:
			alpha *= _focus_dim(p)
		var face := signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
		# 受擊後退 4px（第三輪 R2）：0.08 秒退、0.07 秒回，只是畫面
		if live and hurt_t.has(u.id):
			var hk: float = (time - float(hurt_t[u.id])) / 0.15
			if hk >= 0.0 and hk < 1.0:
				p.x += float(hurt_dir.get(u.id, 0.0)) * 4.0 * (sin(hk * PI) if hk < 1.0 else 0.0)
		if live and u.id == follow_id:
			_hand_ring(p + Vector2(0, 2), 22.0, Color(ACCENT, 0.9), 3.0, true)   # 跟拍中的那隻
		# 擠在一起時，正在出手或受擊的那隻加隊伍色光圈（第三輪 V5）
		if live and (at > 0.0 or hurt > 0.0) and crowd.get(u.id, 0) >= 3:
			_hand_ring(p + Vector2(0, -24 if u.type != D.CAVALRY else -28), 19.0, Color(Art.team_color(u.team, cbm()), 0.75 * alpha), 2.0)
		# 表情與兵種專屬動作（R5）
		var mood := 0
		var lean := 0.0
		var crouch := 1.0
		if hurt > 0.3 or u.stun > 0:
			mood |= Art.M_HURT
		elif grim[u.team] and at == 0.0:
			mood |= Art.M_GRIM
		if hurt > 0.0:
			crouch *= 1.0 - 0.12 * hurt                 # V1.1 A2：受擊壓扁（縱 0.88），配合後退與閃白
			lean -= 0.06 * hurt * float(hurt_dir.get(u.id, 0.0)) * face
		if live:
			# V1.3 A4：停步慣性。剛停下時身體往前多晃一下再回正（0.3 秒，解析式衰減，不存逐兵彈簧狀態）
			if moving:
				stop_t.erase(u.id)
				walking[u.id] = true
			elif walking.get(u.id, false):
				walking.erase(u.id)
				stop_t[u.id] = time
			if stop_t.has(u.id):
				var sk: float = (time - float(stop_t[u.id])) / 0.3
				if sk >= 1.0 or at > 0.0:
					stop_t.erase(u.id)
				else:
					lean += 0.13 * sin(sk * TAU * 0.75) * (1.0 - sk)   # 正＝往前（unit_xf 會乘朝向）
		if live and u.windup > 0 and at == 0.0:
			# V1.1 A3：大招前搖的身體預警。小石魔高舉拉長、吸塵貓吸氣鼓脹、沙漏精靈與骷髏法師浮起
			var wk := 1.0 - float(u.windup) / F8.WINDUP
			if u.type == F8.GOLEM:
				at = Art.ATK_WINDUP * minf(1.0, wk * 1.4) * 0.999
			elif u.type == F8.CAT:
				crouch *= 1.0 + 0.14 * sin(minf(1.0, wk) * PI * 0.5)
			else:
				p.y -= 4.0 * sin(minf(1.0, wk) * PI * 0.5)
		if u.type == D.CAVALRY and moving and u.charge >= D.CHARGE_NEED:
			mood |= Art.M_SPARKLE
			lean = 0.26                      # 衝鋒蓄滿前傾 15°
			for k in 3:                      # 馬蹄噴土
				var ph := fmod(time * 4.0 + k * 0.33 + u.id * 0.1, 1.0)
				draw_circle(p + Vector2(-face * (14 + ph * 16), -2 - ph * 6), 3.2 * (1.0 - ph), Color(0.85, 0.75, 0.55, 0.7 * (1.0 - ph)), true, -1.0, true)
		if s.frenzy and at == 0.0 and not s.finished:
			mood |= Art.M_BROWS
			# 狂熱氣場（第三輪 R3）：身邊橘紅脈衝圈
			var pulse := 0.5 + 0.5 * sin(time * 7.0 + u.id)
			_hand_ring(p + Vector2(0, -22), 15.0 + pulse * 3.0, Color(1.0, 0.33, 0.2, (0.35 + 0.3 * pulse) * alpha), 2.0)
		if u.type == D.ASSASSIN and u.stealth > 0:
			mood |= Art.M_HOOD
			crouch = 0.9                     # 潛行蹲身
		if live and brace_t.has(u.id) and time - brace_t[u.id] < 0.35:
			mood |= Art.M_BRACE
		# 勝利：存活的勝方每 0.45 秒原地跳 10px、武器高舉
		var hop := 0.0
		var won: bool = live and sim != null and u.team == sim.winner and (state == St.RESULT or (state == St.BATTLE and view != null and view.finished))
		if won and u.id == int(last_kill[0]) and time - float(last_kill[1]) < 0.4 and not bool(Save.s("reduce_fx")):
			# V1.3.1 P2：最後一擊定格：擊倒最後一隻的那隻停在揮擊到底的姿勢 0.4 秒，再一起歡呼
			won = false
			at = Art.ATK_STRIKE
			lean = 0.0
		if won:
			# V1.3.1 P2：歡呼像波浪一樣從靠中線那一側傳到後排（依 x 位置錯開，不是依編號）
			var wave := absf(p.x - 640.0) / 900.0
			hop = absf(sin((time - wave) * PI / 0.45)) * 10.0
			mood |= Art.M_HAPPY   # V1.3.1：歡呼 ^ ^ 眼
			at = Art.ATK_WINDUP
			lean = Art.windup_lean(u.type)      # 抵銷前搖的後仰（V1.1：依兵種）：站直、武器高舉（和前搖分得開，Antigravity S4）
			crouch = 1.06
			_star_above(p + Vector2(0, -hop - (74 if u.type == D.CAVALRY else 66)))
			# V1.1 A7：兵種專屬的勝利小動作（簡化特效時不畫）
			match -1 if bool(Save.s("reduce_fx")) else u.type:
				D.DRUMMER:   # 鼓手：頭邊冒音符
					var nk := fmod(time * 1.6 + u.id * 0.3, 1.0)
					_icon("sound", p + Vector2(18 + nk * 8, -48 - nk * 22 - hop), 14.0, Color(1.0, 0.85, 0.4, 1.0 - nk))
				D.BERSERKER:   # 狂戰士：雙斧互敲的火花圈
					var bk := absf(sin((time + u.id * 0.05) * PI / 0.45))
					_hand_ring(p + Vector2(0, -50 - hop), 8.0 + bk * 6.0, Color(1.0, 0.55, 0.2, 0.8 * bk), 2.5)
				D.MEDIC:   # 醫者：綠色小十字往上飄
					var mk := fmod(time * 1.2 + u.id * 0.4, 1.0)
					var mc := p + Vector2(-16, -44 - mk * 24 - hop)
					draw_line(mc - Vector2(4, 0), mc + Vector2(4, 0), Color(0.5, 1.0, 0.55, 1.0 - mk), 2.5)
					draw_line(mc - Vector2(0, 4), mc + Vector2(0, 4), Color(0.5, 1.0, 0.55, 1.0 - mk), 2.5)
		p.y -= hop
		if u.hidden:
			Art.mimic_closed(self, p, u.team, face, alpha, time, cbm(), UNIT_SCALE)   # 偽裝中的寶箱怪
			continue
		if u.type == F8.GHOST:
			alpha *= 0.9
			p.y -= 3.0 + 2.5 * sin(time * 2.2 + u.id * 0.9)   # V1.1 A4：幽靈上下漂
		# 待機小動作（V9 P2）：重心換腳、偶爾縮一下身子
		if live and walk == 0.0 and at == 0.0:
			lean += sin(time * 1.1 + u.id * 1.7) * 0.018
			var idle_k := fmod(time + u.id * 1.37, 7.3)
			if idle_k < 0.3:
				crouch *= 1.0 - sin(idle_k / 0.3 * PI) * 0.05
		if live:
			face = _face_of(u)
			# V1.3.1 P0-2：出手前先轉完。前搖一開始就面向目標（不改命中時間），出手中途目標換邊也維持到收招
			if at > 0.0:
				# 鎖定的是「這一擊」：連擊換到下一擊時重新取方向（Codex v131-impl1）
				if not atk_face.has(u.id) or int(atk_face[u.id][0]) != hit_now:
					atk_face[u.id] = [hit_now, signf(u.fx) if u.fx != 0 else (1.0 if face >= 0.0 else -1.0)]
				face = float(atk_face[u.id][1])
				face_now[u.id] = face
			elif atk_face.has(u.id):
				atk_face.erase(u.id)
			var tdk := _turn_dust_k(u)
			if tdk > 0.0 and not rfx:
			if cbm():
				# 色盲模式：血條左邊加隊伍形狀（藍＝●、紅＝◆），不只靠顏色（R8）
				var mk := top + Vector2(-8, 2)   # 8px 標記＋黑邊（第三輪 V5）
				if u.team == 0:
					draw_circle(mk, 5.5, Art.OUT, true, -1.0, true)
					draw_circle(mk, 4.0, Art.team_color(0, true), true, -1.0, true)
				else:
					draw_colored_polygon(PackedVector2Array([mk + Vector2(0, -6.5), mk + Vector2(6.5, 0), mk + Vector2(0, 6.5), mk + Vector2(-6.5, 0)]), Art.OUT)
					draw_colored_polygon(PackedVector2Array([mk + Vector2(0, -4.5), mk + Vector2(4.5, 0), mk + Vector2(0, 4.5), mk + Vector2(-4.5, 0)]), Art.team_color(1, true))
	if not live:
		return
	for g in dying:
		var k: float = g["t"] / 1.0
		_draw_death(g, k)
		if k >= 1.0:
			continue   # 倒棋躺著的那段：靈魂、塵土都已經結束
		if k < 0.3:
			for i in 6:
				var ang := i * TAU / 6
				draw_circle(g["pos"] + Vector2(cos(ang), sin(ang) * 0.5) * (8 + k * 70) + Vector2(0, -16), 4 * (1 - k), Color(1, 1, 1, 0.35), true, -1.0, true)
		Art.soul(self, g["pos"] + Vector2(sin(k * 9) * 4, -24 - k * 70), 0.75 * (1.0 - k))

## V1.3 A5：倒棋的兵種與倒的方向（＋往前、−往後，弧度）。其他兵種保留專屬死法（化煙、化開、碎裂…）。
const TOPPLE := {D.CAVALRY: 1.5, D.SWORD: 1.5, D.SHIELD: 1.5, D.DRUMMER: 1.5, D.BERSERKER: -1.5, D.PIKE: -1.5, D.ARCHER: -1.5, D.BOMBER: -1.5, D.MEDIC: -1.5, 18: -1.5}
## 這一筆死亡演出要留多久（秒）：倒棋 1.7、其他 1.0。
static func death_life(t: int) -> float:
	return 1.7 if TOPPLE.has(t) else 1.0

## V9 P2：每種兵的死法。k＝0～1（1 秒）。只用轉換與粒子，不多烘影格。
func _draw_death(g: Dictionary, k: float) -> void:
	var t: int = g["type"]
	var p: Vector2 = g["pos"]
	var face: float = g["face"]
	var u := minf(k / 0.55, 1.0)         # 倒下的主要段落
	var e := 1.0 - (1.0 - u) * (1.0 - u)
	var al := 1.0 - maxf(0.0, (k - 0.45) / 0.3)
	var hurt := maxf(0.0, 0.8 - k * 3.0)
	if TOPPLE.has(t):
		# V1.3 A5 倒棋：像桌上的棋子被打倒。0.35 秒從腳點側倒到 90°（落地彈一下），躺在木座上，1.3 秒後淡出
		var ft := minf(k / 0.35, 1.0)
		var fe := ft * ft
		var bounce := 0.07 * sin(clampf((k - 0.35) / 0.18, 0.0, 1.0) * PI)
		var lal := 1.0 - clampf((k - 1.3) / 0.4, 0.0, 1.0)
		if lal <= 0.0:
			return
		if sprites != null and sprites.is_ready(cbm()):
			sprites.draw_base(self, p, UNIT_SCALE, 0.8 * lal)
		else:
			Art.ring_base(self, p, UNIT_SCALE, 0.8 * lal)
		# 往下 5px：倒下後身體貼著木座面，不是浮在上面（Antigravity v130-impl2）
		_unit(p + Vector2(0, 5.0 * fe) * UNIT_SCALE, t, g["team"], face, 0.0, 0.0, hurt, lal * (1.0 - 0.2 * ft), time, UNIT_SCALE, 1 if k < 0.4 else 0, float(TOPPLE[t]) * (fe - bounce * ft), 1.0 - 0.1 * ft)
		return
	if al <= 0.0:
		return
	var lean := 0.0
	var crouch := 1.0
	match t:
		D.ASSASSIN:
			al *= 1.0 - u * 0.8      # 化煙
			for i in 5:
				var a0 := i * TAU / 5.0 + k * 2.0
				draw_circle(p + Vector2(cos(a0) * (6 + k * 30), -20 - k * 24 + sin(a0) * 6), 7.0 * (1.0 - k), Color(0.25, 0.2, 0.35, 0.5 * (1.0 - k)), true, -1.0, true)
		10:
			crouch = 1.0 - e * 0.7   # 孢子菇癟掉
		11:
			al *= 1.0 - u            # 羊：羊毛飛散
			for i in 7:
				var a1 := i * TAU / 7.0
				draw_circle(p + Vector2(cos(a1), sin(a1) * 0.6 - 0.8) * (8 + k * 46), 6.0 * (1.0 - k), Color(Art.team_color(g["team"], cbm()).lightened(0.3), 0.8 * (1.0 - k)), true, -1.0, true)
		12:
			lean = e * 0.5           # 箱子翻倒，鉚釘掉落
			for i in 4:
				draw_circle(p + Vector2((i - 1.5) * (6 + k * 14), -14 + k * k * 14), 1.8, Color(Art.GOLD, 1.0 - k), true, -1.0, true)
		13, 20:
			crouch = 1.0 - e * 0.8   # 史萊姆化開成一灘
			draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.4), 0, p))
			draw_circle(Vector2.ZERO, 8.0 + e * 16.0, Color(Art.team_color(g["team"], cbm()), 0.45 * (1.0 - k)), true, -1.0, true)
			draw_set_transform_matrix(_cam)
		14:
			p += Vector2(0, -e * 34.0)   # 幽靈往上消散
			al *= 1.0 - u * 0.7
		16, 17, 21, 15:
			crouch = 1.0 - e * 0.5   # 散開：骨頭、沙粒、布屑往外
			var col := Color("#ece6d6") if t != 16 and t != 15 else (Color("#ffd166") if t == 16 else Color("#e8d3a8"))
			for i in 6:
				var a2 := i * TAU / 6.0 + float(g.get("seed", 0.0))
				var r2 := 8.0 + e * 26.0
				draw_circle(p + Vector2(cos(a2) * r2, -18.0 + sin(a2) * r2 * 0.5 + k * k * 22.0), 3.0 * (1.0 - k * 0.6), Color(col, 1.0 - k), true, -1.0, true)
		18:
			lean = -e * 0.9          # 吸塵貓往後坐倒
		19:
			crouch = 1.0 - e * 0.55  # 石魔碎裂
			for i in 8:
				var a3 := i * TAU / 8.0
				var r3 := 10.0 + e * 34.0
				draw_circle(p + Vector2(cos(a3) * r3, -14.0 + sin(a3) * r3 * 0.45 + k * k * 24.0), 5.0 * (1.0 - k * 0.5), Color(Color("#8d8a80"), 1.0 - k), true, -1.0, true)
	_unit(p, t, g["team"], face, 0.0, 0.0, hurt, al, time, UNIT_SCALE, 1 if k < 0.4 else 0, lean, maxf(crouch, 0.15))
	_draw_relic(t, p, face, k, g["team"])

## V1.3.1 P2：奇幻兵倒下時的「遺物」掉到地上彈一下（純畫面）：娃娃的針、骷髏的頭骨滾半圈、寶箱噴出兩枚金幣。
func _draw_relic(t: int, p: Vector2, face: float, k: float, team: int) -> void:
	if bool(Save.s("reduce_fx")) or k >= 1.0:
		return
	var a := 1.0 - maxf(0.0, (k - 0.7) / 0.3)
	var bounce := absf(sin(k * PI * 2.0)) * (1.0 - k) * 14.0
	match t:
