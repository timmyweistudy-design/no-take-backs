    93	static func atk_progress(dt: float, type: int) -> float:
    94		var tm := atk_timing(type)
    95		var tot: float = tm[0]
    96		var w: float = tm[1]
    97		var st: float = tm[2]
    98		var rc := tot - w - st
    99		if dt < 0.0 or dt >= tot:
   100			return 0.0
   101		var a: float
   102		if dt < w:
   103			a = Art.ATK_WINDUP * dt / w
   104		elif dt < w + st:
   105			a = Art.ATK_WINDUP + (Art.ATK_STRIKE - Art.ATK_WINDUP) * (dt - w) / st
   106		else:
   107			a = Art.ATK_STRIKE + (1.0 - Art.ATK_STRIKE) * (dt - w - st) / rc
   108		return maxf(a, 0.001)
