    35		# 身體（圓胖的上衣，隊伍色；狂戰士赤膊，隊伍色只留在獸皮披肩與褲頭；醫者白袍）
    36		var bw0 := 13.0 if type == D.SHIELD else 10.5   # 第七輪 C1-2：盾兵身體加寬
    37		var body := PackedVector2Array()
    38		for i in 13:
    39			var ang := PI + i * PI / 12.0
    40			body.append(Vector2(cos(ang) * bw0, -16 + sin(ang) * 9.0))
    41		if type == D.MEDIC:
    42			body.append(Vector2(13, -5)); body.append(Vector2(-13, -5))   # 第七輪 C1-8：A 字長袍
    43		else:
    44			body.append(Vector2(bw0 - 0.5, -5)); body.append(Vector2(-bw0 + 0.5, -5))
    45		_poly(ci, body, SKIN.darkened(0.06) if type == D.BERSERKER else (Color("#f4f1ea") if type == D.MEDIC else tc), a)
    46		if type == D.BERSERKER:
    47			# 第七輪 C1-10：披肩加寬＋交叉肩帶＋整條褲頭，隊伍色面積拉大
    48			_poly(ci, PackedVector2Array([Vector2(-12, -24), Vector2(-2, -27), Vector2(12, -15), Vector2(5, -8), Vector2(-3, -15), Vector2(-11, -13)]), tc, a, false)
    49			_poly(ci, PackedVector2Array([Vector2(8, -24), Vector2(11, -21), Vector2(-7, -7), Vector2(-10, -10)]), tc.darkened(0.15), a, false)
    50			_poly(ci, PackedVector2Array([Vector2(-10, -14), Vector2(10, -14), Vector2(10, -5), Vector2(-10, -5)]), tc, a, false)
    51		elif type == D.MEDIC:
    52			_poly(ci, PackedVector2Array([Vector2(-12, -11), Vector2(12, -11), Vector2(13, -5), Vector2(-13, -5)]), tc, a, false)   # 白袍下擺露出隊伍色
    53			_poly(ci, PackedVector2Array([Vector2(-10, -24), Vector2(-3, -26), Vector2(8, -22), Vector2(10, -16), Vector2(0, -19), Vector2(-11, -15)]), tc, a)   # 第七輪 C1-8：大面積隊伍色披肩
    54		ci.draw_line(Vector2(-9, -11), Vector2(9, -11), Color(OUT, 0.35 * a), 2.0, true)   # 腰帶
    55		# 頭（V1.3 A1b：轉身時頭不壓扁）
    56		var hy := -33.0
    57		_part(ci, 0.0, 0.0)
    58		_c(ci, Vector2(0, hy), 11.5, SKIN, a)
    59		# 臉（朝右）
    60		if type != D.ASSASSIN:
    61			_eyes(ci, Vector2(3.5, hy + 1), a, t, angry)
    62		# 兵種特徵
    63		match type:
    64			D.SWORD:
    65				# 頭盔＋羽飾
    66				ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.05, PI * 1.95, 18, Color(OUT, a), 6.5, true)
    67				ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.05, PI * 1.95, 18, Color(STEEL, a), 4.0, true)
    68				_poly(ci, PackedVector2Array([Vector2(-2, hy - 12), Vector2(4, hy - 21), Vector2(7, hy - 19), Vector2(3, hy - 11)]), tc.lightened(0.2), a)
    69				_part_end(ci)
    70				# 劍：斜舉的亮刃（攻擊時往前揮）
    71				# 前搖往後拉 35°、揮擊揮到 +60° 以上
    72				var ang := -1.15 + (w * 0.9 if w < 0.0 else w * 1.95) + sway   # 第十輪 F3：揮幅加大
    73				if variant == 1:
    74					# 上挑：前搖把劍壓低到身前下方，揮擊時往上撩過頭頂
    75					ang = 0.6 + (-w * 0.35 if w < 0.0 else -w * 2.6)
    76				# 第七輪 C1-1：隊伍色短領巾；劍身加寬、十字護手
    77				_poly(ci, PackedVector2Array([Vector2(-9, -24), Vector2(8, -24), Vector2(6, -20), Vector2(-3, -19), Vector2(-5, -14), Vector2(-9, -17)]), tc.lightened(0.15), a, true)
    78				_part(ci, -4.0, 1.0)   # V1.3 A1b：劍透視縮短、留在臉的前方（不橫切五官，Antigravity v130-impl1）
    79				var hand := Vector2(9, -17 + sway * 8.0)
    80				var dir := Vector2(cos(ang), sin(ang))
    81				var tip := hand + dir * 24.0
    82				var side := dir.orthogonal() * 3.6
    83				_poly(ci, PackedVector2Array([hand + side, tip + side * 0.3, tip + dir * 3.0, tip - side * 0.3, hand - side]), Color("#f4f7ff"), a)
    84				_line(ci, hand - dir.orthogonal() * 7.0, hand + dir.orthogonal() * 7.0, GOLD, 3.0, a)
    85				_c(ci, hand, 3.0, SKIN, a)
    86				_part_end(ci)
    87			D.SHIELD:
    88				# 圓頭盔＋面罩
    89				ci.draw_arc(Vector2(0, hy), 12.0, PI * 0.95, PI * 2.05, 20, Color(OUT, a), 7.0, true)
    90				ci.draw_arc(Vector2(0, hy), 12.0, PI * 0.95, PI * 2.05, 20, Color(STEEL_D, a), 4.5, true)
    91				_line(ci, Vector2(-9, hy - 3), Vector2(11, hy - 3), STEEL_D, 2.0, a)
    92				_part(ci, -3.0, 0.0)   # V1.3 A1b：大盾朝前，轉向鏡頭時不跟著變窄（Antigravity v130-impl1）
    93				# 大方盾（佔身體一半寬，正面）
    94				var push := (w * 12.0 if w > 0.0 else w * 5.0) + sway * 14.0 + 3.0   # V1.3：盾往外 3px，剪影不再是圓膠囊（Antigravity v130-impl1）   # 盾擊：揮擊時整面盾往前推（第三輪 R4）；走路時盾微晃
    95				# 第七輪 C1-2：盾放大（遮身體六成）、上寬下尖、深鐵色外框，混戰時不會融進隊伍色塊
    96				var sh := PackedVector2Array([Vector2(1 + push, -43), Vector2(21 + push, -41), Vector2(21 + push, -14), Vector2(11 + push, -2), Vector2(1 + push, -14)])
    97				_poly(ci, sh, Color("#4a5468"), a)
    98				var shi := PackedVector2Array([Vector2(4 + push, -39), Vector2(18 + push, -38), Vector2(18 + push, -15), Vector2(11 + push, -6), Vector2(4 + push, -15)])
    99				_poly(ci, shi, STEEL, a, false)
   100				_poly(ci, PackedVector2Array([Vector2(7 + push, -33), Vector2(15 + push, -32), Vector2(15 + push, -17), Vector2(11 + push, -11), Vector2(7 + push, -17)]), tc, a, false)
   101				_part_end(ci)
   102			D.ARCHER:
   103				# 綠兜帽＋羽毛
   104				ci.draw_arc(Vector2(0, hy), 12.0, PI * 0.9, PI * 2.1, 20, Color(OUT, a), 7.0, true)
   105				ci.draw_arc(Vector2(0, hy), 12.0, PI * 0.9, PI * 2.1, 20, Color(Color("#5aa364"), a), 4.5, true)
   106				_poly(ci, PackedVector2Array([Vector2(-6, hy - 10), Vector2(-14, hy - 22), Vector2(-9, hy - 10)]), tc.lightened(0.3), a)
   107				# 長弓
   108				var pull := 2.0 + 7.0 * -w if w <= 0.0 else 2.0 * (1.0 - w)   # 前搖拉弦、揮擊放箭
   109				# 第七輪 C1-3：弓放大、淺樺木色，草地上看得到
   110				var bc := Vector2(12, -22 + sway * 18.0)
   111				ci.draw_arc(bc, 18.0, -1.3, 1.3, 18, Color(OUT, a), 6.0, true)
   112				ci.draw_arc(bc, 18.0, -1.3, 1.3, 18, Color(Color("#ecd9a8"), a), 3.4, true)
   113				var top := bc + Vector2(cos(-1.3), sin(-1.3)) * 18.0
   114				var bot := bc + Vector2(cos(1.3), sin(1.3)) * 18.0
   115				var mid := Vector2(bc.x - pull, bc.y)
   116				ci.draw_line(top, mid, Color(1, 1, 1, 0.9 * a), 1.2, true)
   117				ci.draw_line(mid, bot, Color(1, 1, 1, 0.9 * a), 1.2, true)
   118				if w < 0.0:
   119					# 拉弓時看得到搭在弦上的箭（第三輪 R4）
   120					_line(ci, mid, Vector2(bc.x + 16, bc.y), WOOD, 1.6, a)
   121					_poly(ci, PackedVector2Array([Vector2(bc.x + 20, bc.y), Vector2(bc.x + 15, bc.y - 2.5), Vector2(bc.x + 15, bc.y + 2.5)]), STEEL, a, false)
   122				_c(ci, Vector2(bc.x + 12, bc.y), 3.0, SKIN, a)
   123			D.ASSASSIN:
   124				# 尖兜帽＋面罩，只露發光的眼睛
   125				# 第七輪 C1-5：不再戴紫色尖帽（蓋掉隊伍色、又高又像法師）。貼頭的深色頭巾＋隊伍色長圍巾往後飄
   126				var flow := sin(t * 5.0 + walk) * 2.0
   127				_poly(ci, PackedVector2Array([Vector2(-8, hy + 7), Vector2(-24, hy + 3 + flow), Vector2(-29, hy + 9 + flow), Vector2(-21, hy + 12 + flow * 0.5), Vector2(-7, hy + 13)]), tc, a)
   128				var hood := PackedVector2Array([Vector2(-12, hy + 5), Vector2(-13, hy - 6), Vector2(-5, hy - 13), Vector2(6, hy - 13), Vector2(12, hy - 5), Vector2(12, hy + 5)])
   129				_poly(ci, hood, Color("#33304a"), a)
   130				_poly(ci, PackedVector2Array([Vector2(-12, hy - 7), Vector2(-5, hy - 12), Vector2(6, hy - 12), Vector2(11, hy - 7), Vector2(11, hy - 4), Vector2(-12, hy - 4)]), tc, a, false)
   131				_poly(ci, PackedVector2Array([Vector2(-5, hy - 3), Vector2(11, hy - 3), Vector2(11, hy + 6), Vector2(-5, hy + 6)]), Color("#2b2140"), a, false)
   132				_poly(ci, PackedVector2Array([Vector2(-11, hy + 5), Vector2(12, hy + 5), Vector2(12, hy + 11), Vector2(-11, hy + 11)]), tc, a)
   133				_c(ci, Vector2(3.0, hy - 0.5), 1.8, Color("#ffe066"), a, false)
   134				_c(ci, Vector2(8.0, hy - 0.5), 1.8, Color("#ffe066"), a, false)
   135				if angry:
   136					ci.draw_line(Vector2(1.0, hy - 3.6), Vector2(5.0, hy - 2.4), Color("#ffe066", a), 1.3, true)
   137					ci.draw_line(Vector2(10.0, hy - 3.6), Vector2(6.0, hy - 2.4), Color("#ffe066", a), 1.3, true)
   138				# 雙短刃
   139				var sw := w * 6.0 + sway * 10.0
   140				_line(ci, Vector2(10, -18 - sw), Vector2(21, -8 + sw), Color("#f0f0ff"), 2.8, a)   # 反手短刃：刃往前下，剪影露得出刀尖
   141				# 後手的刀：揮擊時往前交叉斬（第三輪 R4）
   142				var bw := maxf(0.0, w)
   143				_line(ci, Vector2(-8 + bw * 18, -16 - bw * 6), Vector2(-15 + bw * 44, -21 + bw * 16), Color("#f0f0ff"), 2.8, a)   # 加長加粗，看得出交叉
   144				_c(ci, Vector2(10, -18 - sw), 2.8, Color("#2b2140"), a)
   145			D.PIKE:
   146				# 暖銅色扁鍋盔（寬帽簷，避開劍士的銀盔）
   147				# 第七輪 C1-6：尖角錐笠，輪廓和圓頭盔分得開
   148				_poly(ci, PackedVector2Array([Vector2(-16, hy - 5), Vector2(0, hy - 18), Vector2(16, hy - 5)]), Color("#c7834a"), a)
   149				ci.draw_line(Vector2(-8, hy - 7), Vector2(0, hy - 15), Color(1.0, 0.86, 0.55, 0.9 * a), 1.8, true)
   150				_part(ci, -9.0, 1.0)   # V1.3 A1b：長槍透視縮短、整支移到臉的前方（Antigravity v130-impl2：cos 0.3 時貫穿雙眼）
   151				# 長槍：平常斜前上方 45° 伸出頭頂；前搖收槍、揮擊放平直刺（第四輪）；專屬＝拒騎：槍幾乎直立、槍尾頓地
   152				var pang := -0.8 + (w * -0.25 if w < 0.0 else w * 0.75) + sway * 0.8
   153				var phand := Vector2(7 + (w * 6.0 if w < 0.0 else w * 9.0), -17)
   154				if variant == 2:
   155					pang = -1.2
   156					phand = Vector2(9, -14)
   157				var pdir := Vector2(cos(pang), sin(pang))
   158				var pbutt := phand - pdir * 14.0
   159				var ptip := phand + pdir * 40.0
   160				_line(ci, pbutt, ptip, WOOD, 2.4, a)
   161				_poly(ci, PackedVector2Array([ptip + pdir * 11.0, ptip + pdir.orthogonal() * 4.4, ptip - pdir.orthogonal() * 4.4]), STEEL, a)   # 第七輪 C1-6：槍尖放大
   162				var tas := ptip - pdir * 2.0
   163				_poly(ci, PackedVector2Array([tas, tas + Vector2(-4.6, 8.0), tas + Vector2(0, 6.0), tas + Vector2(3.2, 8.5)]), tc, a)   # 第七輪：槍纓改隊伍色
   164				if variant == 2:
   165					_star(ci, ptip + pdir * 6.0, 9.0, Color(0.92, 0.95, 1.0, a))   # 拒騎：槍尖銀色十字閃光
   166				_c(ci, phand, 3.0, SKIN, a)
   167				_part_end(ci)
   168			D.BOMBER:
   169				# 橘紅頭巾＋黃銅護目鏡（推在額頭上）
   170				ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.0, PI * 2.0, 18, Color(OUT, a), 6.5, true)
   171				ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.0, PI * 2.0, 18, Color("#ff7a3d", a), 4.0, true)
   172				_poly(ci, PackedVector2Array([Vector2(-11, hy - 2), Vector2(-17, hy + 4), Vector2(-12, hy + 5)]), Color("#ff7a3d"), a)
   173				_c(ci, Vector2(1.5, hy - 7.5), 3.4, Color("#d9a441"), a)
   174				_c(ci, Vector2(8.5, hy - 7.5), 3.4, Color("#d9a441"), a)
   175				ci.draw_circle(Vector2(1.5, hy - 7.5), 1.8, Color("#9fe3ff", a), true, -1.0, true)
   176				ci.draw_circle(Vector2(8.5, hy - 7.5), 1.8, Color("#9fe3ff", a), true, -1.0, true)
   177				# 肩上托一顆帶引線的黑色大圓火罐：前搖往後拉、揮擊時丟出去（手上就空了）；專屬＝被貼身：火罐收到背後、拿點火棒往前敲
   178				if variant == 2:
   179					var sa := -0.9 + maxf(0.0, w) * 1.6
   180					var sh0 := Vector2(10, -18)
   181					var sd := Vector2(cos(sa), sin(sa))
   182					_line(ci, sh0, sh0 + sd * 14.0, Color("#6b4a2b"), 2.4, a)
   183					_star(ci, sh0 + sd * 16.0, 3.6, Color(1, 0.7, 0.2, a))
   184					_c(ci, sh0, 3.0, SKIN, a)
   185				elif w <= 0.25:
   186					var bp := Vector2(17 + w * 9.0, -24 + (-w) * 4.0 + sway * 12.0)   # 第七輪 C1-7：火罐托在身前、和頭拉開（縮小後不再像髮髻）
   187					_c(ci, bp, 7.5, Color("#2a2533"), a)
   188					ci.draw_circle(bp + Vector2(-2.5, -2.5), 2.0, Color(1, 1, 1, 0.35 * a), true, -1.0, true)
   189					_line(ci, bp + Vector2(2, -7), bp + Vector2(5, -11), Color("#c9a26b"), 1.3, a)
   190					var sp := 0.6 + 0.4 * sin(t * 22.0)
   191					_star(ci, bp + Vector2(5.5, -12), 3.2 * sp + 1.0, Color(1, 0.85, 0.3, a))
   192					_c(ci, Vector2(14 + w * 6.0, -17), 3.0, SKIN, a)
   193				else:
   194					# 甩臂：火罐出手後手臂往前下甩（Antigravity P2 #6）
   195					_line(ci, Vector2(7, -20), Vector2(12 + w * 12.0, -24 + w * 14.0), SKIN, 2.6, a)
   196					_c(ci, Vector2(12 + w * 12.0, -24 + w * 14.0), 3.0, SKIN, a)
   197			D.MEDIC:
   198				# 白色高方帽＋綠十字
   199				_poly(ci, PackedVector2Array([Vector2(-9, hy - 7), Vector2(-8, hy - 24), Vector2(8, hy - 24), Vector2(9, hy - 7)]), Color("#fbfbf7"), a)
   200				ci.draw_rect(Rect2(Vector2(-1.6, hy - 21), Vector2(3.2, 10)), Color("#2fbf71", a))
   201				ci.draw_rect(Rect2(Vector2(-5, hy - 17.6), Vector2(10, 3.2)), Color("#2fbf71", a))
   202				# 頂端發綠光的長杖：補血時舉高（w 往前＝舉杖）
   203				var lift := maxf(0.0, w) * 16.0 + (-w * 4.0 if w < 0.0 else 0.0) + sway * 14.0
   204				if variant == 2:
   205					lift = 18.0   # 專屬＝施法：雙手把杖高舉過頭
   206				var sbase := Vector2(15, -4 - lift)
   207				var stop := Vector2(21, -48 - lift)   # 第七輪：杖往外斜，剪影和方帽分開
   208				_line(ci, sbase, stop, WOOD, 2.2, a)
   209				var glow := 0.65 + 0.35 * sin(t * 4.0)
   210				ci.draw_circle(stop, 7.0 + lift * 0.5, Color(0.4, 1.0, 0.55, (0.28 + lift * 0.02) * glow * a), true, -1.0, true)
   211				# 第七輪 C1-8：杖頂大十字，遠看也知道是醫者
   212				_poly(ci, PackedVector2Array([stop + Vector2(-2, -6), stop + Vector2(2, -6), stop + Vector2(2, -2), stop + Vector2(6, -2), stop + Vector2(6, 2), stop + Vector2(2, 2), stop + Vector2(2, 6), stop + Vector2(-2, 6), stop + Vector2(-2, 2), stop + Vector2(-6, 2), stop + Vector2(-6, -2), stop + Vector2(-2, -2)]), Color("#7dffa0"), a)
   213				if variant == 2:
   214					_c(ci, Vector2(9.0, -24 - lift), 2.8, SKIN, a)   # 第二隻手也扶著杖
   215				_c(ci, Vector2(17.0, -20 - lift), 3.0, SKIN, a)
   216			D.DRUMMER:
   217				# 紅白羽毛高帽（全兵種最高）
   218				var hatc := tc.darkened(0.12)   # 第七輪 C1-9：帽子用隊伍色（原本藍方戴紅帽，一眼像紅軍）
   219				_poly(ci, PackedVector2Array([Vector2(-8, hy - 8), Vector2(-7, hy - 20), Vector2(7, hy - 20), Vector2(8, hy - 8)]), hatc, a)
   220				_line(ci, Vector2(-8, hy - 10), Vector2(8, hy - 10), GOLD, 1.8, a)
   221				_poly(ci, PackedVector2Array([Vector2(-2, hy - 20), Vector2(-6 - fl, hy - 36), Vector2(1 - fl * 0.6, hy - 30), Vector2(3, hy - 20)]), Color("#ffffff"), a)
   222				_poly(ci, PackedVector2Array([Vector2(1, hy - 20), Vector2(4, hy - 33), Vector2(6, hy - 20)]), tc.lightened(0.35), a, false)
   223				# 胸前大圓鼓
   224				var dc := Vector2(9, -15)   # 第七輪 C1-9：鼓放大、往前凸
   225				_c(ci, dc, 11.5, Color("#e9d8a6"), a)
   226				ci.draw_arc(dc, 11.5, 0.0, TAU, 28, Color(tc, a), 3.2, true)
   227				_line(ci, dc + Vector2(-6, -6), dc + Vector2(6, 6), Color("#b7814e"), 1.0, a)
   228				# 鼓棒：平常輕敲、揮擊時舉高大力敲兩下
   229				var beat := absf(sin(t * 6.0 + wk * 2.0)) * 4.0
   230				var raise := maxf(0.0, -w) * 16.0 + (beat if w == 0.0 else 0.0) - maxf(0.0, w) * 4.0
   231				if variant == 2:
   232					raise = 18.0   # 專屬＝大力連敲：鼓棒舉高
   233				for k in 2:
   234					var hx := 2.0 + k * 9.0
   235					_line(ci, Vector2(hx, -20 - raise), Vector2(hx + 5, -26 - raise - k * 2), Color("#f4e3c1"), 1.8, a)
   236					_c(ci, Vector2(hx + 5, -26 - raise - k * 2), 2.0, Color("#f4e3c1"), a)
   237			D.BERSERKER:
   238				# 火紅刺蝟頭
   239				var hair := PackedVector2Array([Vector2(-12, hy - 1), Vector2(-15, hy - 10), Vector2(-9, hy - 9), Vector2(-10, hy - 19), Vector2(-3, hy - 13),
   240					Vector2(0, hy - 23), Vector2(4, hy - 13), Vector2(10, hy - 19), Vector2(9, hy - 9), Vector2(15, hy - 9), Vector2(12, hy - 1), Vector2(0, hy - 8)])
   241				_poly(ci, hair, Color("#ff5a2a"), a)
   242				# 左右手各一把闊斧：揮擊時雙斧往下劈（交叉）
   243				# 待機時雙斧垂在身體兩側往外（不擋臉）；前搖舉過頭、揮擊往前下劈
   244				var aang := -0.35 + (w * 1.3 if w < 0.0 else w * 1.4) + sway
   245				if variant == 2:
   246					aang = -1.75   # 專屬＝破陣：雙斧高舉過頭
   247				for k2 in 2:
   248					var ah := Vector2(9, -15) if k2 == 0 else Vector2(-8, -16)
   249					var aa := aang if k2 == 0 else (PI - aang if w <= 0.0 else aang - 0.4)
   250					var adir := Vector2(cos(aa), sin(aa))
   251					var atip := ah + adir * 20.0
   252					_line(ci, ah, atip, WOOD, 2.4, a)
   253					var ao := adir.orthogonal()
   254					var blade := PackedVector2Array([atip - adir * 3.0 + ao * 1.5, atip - adir * 12.0 + ao * 11.0, atip + adir * 5.0 + ao * 10.5])   # 第七輪 C1-10：斧刃放大
   255					_poly(ci, blade, STEEL, a)
   256					ci.draw_line(blade[1], blade[2], Color(1, 1, 1, a), 1.6, true)   # 亮銀刃口
   257					_c(ci, ah, 3.0, SKIN, a)
   258		if type != D.ASSASSIN and type != D.ARCHER and type != D.SWORD and type != D.PIKE and type != D.BOMBER and type != D.MEDIC and type != D.BERSERKER:
   259			_c(ci, Vector2(-9, -17 - sway * 8.0), 3.0, SKIN, a)
