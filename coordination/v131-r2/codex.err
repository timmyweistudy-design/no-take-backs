    47	static func _f_sheep(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
    48		var wk := Gait.ph(walk)
    49		var ft: Array = Gait.feet(11, walk)
    50		for lx in [-11.0, -4.0, 5.0, 12.0]:
    51			var front: bool = lx > 0.0
    52			var sw: float = (ft[0] if front else ft[2])
    53			var up: float = (ft[1] if front else ft[3])
    54			_line(ci, Vector2(lx, -10), Vector2(lx + sw, -3 - up), Color("#4a4258"), 3.0, a)
    55			_c(ci, Vector2(lx + sw, -2.5 - up), 2.4, Color("#1d1a2b"), a, false)   # 黑蹄
    56		_push_body(ci, Gait.body_xf(11, walk))
    57		# 羊毛染隊伍色（白毛會被特效洗掉）
    58		var wool := tc.lightened(0.14)
    59		var blobs := [[-11, -18, 9.5], [0, -23, 11.5], [11, -18, 9.0], [-5, -13, 8.5], [6, -13, 8.5], [-1, -30, 8.5], [-9, -26, 7.5], [8, -27, 7.5]]
    60		for b in blobs:
    61			_c(ci, Vector2(b[0], b[1]), b[2], wool, a)
    62		for b2 in blobs:
    63			ci.draw_circle(Vector2(b2[0], b2[1]), b2[2], Color(wool, a), true, -1.0, true)
    64		for h in [[-5, -28, 3.6], [6, -25, 2.8], [-9, -18, 2.4]]:
    65			ci.draw_circle(Vector2(h[0], h[1]), h[2], Color(1, 1, 1, 0.4 * a), true, -1.0, true)
    66		# 臉
    67		_c(ci, Vector2(16, -22), 8.5, Color("#3a3346"), a)
    68		_poly(ci, PackedVector2Array([Vector2(9, -27), Vector2(4, -30), Vector2(7, -24)]), Color("#3a3346"), a)   # 耳朵
    69		for ex in [13.0, 19.0]:
    70			ci.draw_circle(Vector2(ex, -23), 2.9, Color(1, 1, 1, a), true, -1.0, true)
    71			ci.draw_circle(Vector2(ex + 0.7, -23), 1.4, Color(OUT, a), true, -1.0, true)
    72		ci.draw_arc(Vector2(16, -18), 2.6, 0.3, PI - 0.3, 6, Color(1, 1, 1, 0.8 * a), 1.2, true)
    73		# 頭上的引線（招牌）：越接近爆炸火花越大
    74		_line(ci, Vector2(-1, -37), Vector2(4, -47), Color("#c9a26b"), 1.8, a)
    75		var sp := 0.7 + 0.3 * sin(t * 18.0 + wk * 3.0) + maxf(0.0, w)
    76		_star(ci, Vector2(5, -49), 5.0 * sp + 1.0, Color(1, 0.8, 0.25, a))
    77	
    78	
    79	static func _f_mimic(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
    80		# V9 P2：走路時閉蓋貼地跳（整隻離地在 Gait.air），只有箱蓋輕敲；接敵才張嘴
    81		var wk := Gait.ph(walk)
    82		_push_body(ci, Gait.body_xf(12, walk))
    83		var open := 0.45 + maxf(0.0, w) * 0.55 - minf(0.0, w) * 0.2
    84		if wk != 0.0 and w == 0.0:
    85			open = 0.04 + absf(sin(wk)) * 0.26   # 跳到最高才張嘴露一點舌（Antigravity P2 #1）
    86		var by := -3.0
    87		_poly(ci, PackedVector2Array([Vector2(-16, by), Vector2(-16, by - 15), Vector2(16, by - 15), Vector2(16, by)]), Color("#9c6b3c"), a)
    88		ci.draw_line(Vector2(-16, by - 7), Vector2(16, by - 7), Color(OUT, 0.5 * a), 1.6, true)
    89		for rv in [[-14, by - 2], [14, by - 2], [-14, by - 13], [14, by - 13]]:
    90			ci.draw_circle(Vector2(rv[0], rv[1]), 1.5, Color(GOLD, a), true, -1.0, true)   # 鉚釘
    91		# 舌頭與牙
    92		var mouth := by - 15.0
    93		_poly(ci, PackedVector2Array([Vector2(-13, mouth), Vector2(13, mouth), Vector2(13, mouth - 4 - open * 10), Vector2(-13, mouth - 4 - open * 10)]), Color("#3b0f1e"), a, false)
    94		var lick := maxf(0.0, w) * 8.0
    95		if open > 0.2:
    96			_poly(ci, PackedVector2Array([Vector2(2, mouth), Vector2(19 + lick, mouth + 2), Vector2(23 + lick, mouth - 3), Vector2(19 + lick, mouth - 7), Vector2(4, mouth - 5)]), Color("#ff6b81"), a)
    97		for k in 4:
    98			var tx := -10.0 + k * 7.0
    99			ci.draw_colored_polygon(PackedVector2Array([Vector2(tx, mouth), Vector2(tx + 5, mouth), Vector2(tx + 2.5, mouth - 5)]), Color(1, 1, 1, a))
   100		# 箱蓋（隊伍色，面積最大）
   101		var ly := mouth - 4 - open * 12
   102		_poly(ci, PackedVector2Array([Vector2(-19, ly), Vector2(-17, ly - 17), Vector2(17, ly - 19), Vector2(19, ly)]), tc, a)
   103		_line(ci, Vector2(-17, ly - 1), Vector2(17, ly - 1), GOLD, 2.0, a)
   104		_poly(ci, PackedVector2Array([Vector2(-16, by - 15), Vector2(-9, by - 15), Vector2(-9, by), Vector2(-16, by)]), tc.darkened(0.1), a, false)
   105		_poly(ci, PackedVector2Array([Vector2(9, by - 15), Vector2(16, by - 15), Vector2(16, by), Vector2(9, by)]), tc.darkened(0.1), a, false)
   106		for k2 in 2:
   107			var ex := -6.0 + k2 * 12.0
   108			ci.draw_circle(Vector2(ex, ly - 9), 3.6, Color(1, 1, 1, a), true, -1.0, true)
   109			ci.draw_circle(Vector2(ex + 1, ly - 9), 1.8, Color(OUT, a), true, -1.0, true)
   110		if angry:
   111			ci.draw_line(Vector2(-10, ly - 14), Vector2(-3, ly - 12), Color(OUT, a), 1.6, true)
   112			ci.draw_line(Vector2(10, ly - 14), Vector2(3, ly - 12), Color(OUT, a), 1.6, true)
   113	
   114	
   115	static func _f_slime(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool, k: float) -> void:
   116		# 果凍：底部微扁、頂上一小尖，走路和攻擊時壓扁彈起
   117		var wk := Gait.ph(walk)
   118		# 落地壓扁、騰空拉長（Antigravity P2 #2）：拉長時整隻離地（Gait.air）
   119		var sq := (1.14 - absf(sin(wk)) * 0.26 if wk != 0.0 else 1.0) + maxf(0.0, w) * 0.3 - minf(0.0, w) * 0.12
   120		if walk < -150.0:
   121			sq = 1.22
   122		var rx := 20.0 * k * sq
   123		var ry := 17.0 * k / sq
   124		var cy := -ry - 1.0
   125		var pts := _ell(Vector2(0, cy), rx, ry * 1.02, 0.08, PI - 0.08, 12)
   126		pts.append(Vector2(-rx * 0.9, cy - ry * 0.5))
   127		pts.append(Vector2(-rx * 0.45, cy - ry * 1.0))
   128		pts.append(Vector2(0.5 * k, cy - ry * 1.5))
   129		pts.append(Vector2(rx * 0.45, cy - ry * 1.0))
   130		pts.append(Vector2(rx * 0.9, cy - ry * 0.5))
   131		_poly(ci, pts, tc.lightened(0.05), a)
   132		ci.draw_arc(Vector2(0, cy - ry * 0.1), rx * 0.82, 0.55, PI - 0.55, 10, Color(tc.darkened(0.25), 0.55 * a), 2.6 * k, true)
   133		ci.draw_circle(Vector2(-rx * 0.45, cy - ry * 0.4), 3.8 * k, Color(1, 1, 1, 0.6 * a), true, -1.0, true)
   134		ci.draw_circle(Vector2(-rx * 0.18, cy - ry * 0.85), 1.8 * k, Color(1, 1, 1, 0.6 * a), true, -1.0, true)
   135		for b in [[0.5, 0.45, 2.2], [-0.25, 0.65, 1.6], [0.62, -0.1, 1.5]]:
   136			ci.draw_arc(Vector2(rx * b[0], cy + ry * b[1]), b[2] * k, 0, TAU, 8, Color(1, 1, 1, 0.35 * a), 1.0, true)
   137		_eyes(ci, Vector2(3.0 * k, cy + 1.0), a, t, angry)
   138	
   139	
   140	static func _f_ghost(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
   141		# 無腳飄浮：飄逸的長裙擺，隊伍色披巾在肩上；攻擊時張大嘴
   142		var body := tc.lightened(0.3)
   143		var wk := Gait.ph(walk)
   144		var lean := w * 4.0 + (4.5 if wk != 0.0 else 0.0)   # 前進要看得出來（Antigravity P2 #7）
   145		var sway := sin(t * 2.0 + wk) * 2.6
   146		_push_body(ci, Gait.body_xf(14, walk))
   147		var top := -48.0
   148		var pts := _ell(Vector2(lean, top + 15), 16.0, 15.0, PI, TAU, 14)
   149		for s in [[16.0, -24.0], [17.0, -14.0], [11.0, -5.0 + sway], [7.0, -11.0], [2.0, -3.0 - sway], [-3.0, -11.0], [-8.0, -4.0 + sway], [-13.0, -11.0], [-18.0, -7.0 - sway], [-16.0, -24.0]]:
   150			pts.append(Vector2(s[0] + lean * (0.2 + (-s[1]) * 0.02), s[1]))
   151		_poly(ci, pts, Color(body, 0.94), a)
   152		_poly(ci, PackedVector2Array([Vector2(-16 + lean, -33), Vector2(16 + lean, -33), Vector2(17 + lean * 0.7, -24), Vector2(4 + lean * 0.5, -21), Vector2(-16 + lean * 0.7, -24)]), tc, a, false)
   153		ci.draw_line(Vector2(-16 + lean, -33), Vector2(16 + lean, -33), Color(tc.darkened(0.25), a), 1.6, true)
   154		var ey := -40.0
   155		for ex in [-2.0 + lean, 7.0 + lean]:
   156			ci.draw_circle(Vector2(ex, ey), 3.3, Color(OUT, a), true, -1.0, true)
   157			ci.draw_circle(Vector2(ex + 0.9, ey - 1.0), 1.1, Color(1, 1, 1, a), true, -1.0, true)
   158			ci.draw_arc(Vector2(ex, ey), 4.8, 0.4, PI - 0.4, 6, Color(tc.darkened(0.2), 0.6 * a), 1.4, true)   # 黑眼圈
   159		if angry or w > 0.0:
   160			ci.draw_circle(Vector2(2.5 + lean, ey + 7), 3.2, Color(OUT, a), true, -1.0, true)
   161		else:
   162			ci.draw_arc(Vector2(2.5 + lean, ey + 5), 2.2, 0.3, PI - 0.3, 6, Color(OUT, a), 1.3, true)
   163		var hd := sin(wk + 0.9) * 2.0 if wk != 0.0 else 0.0   # 手延遲
   164		_c(ci, Vector2(-15 + lean + w * 5.0 - hd, -25 + hd), 3.6, body, a)
   165		_c(ci, Vector2(16 + lean + maxf(0.0, w) * 10.0 - hd, -26 - hd), 3.6, body, a)
   166	
   167	
   168	static func _f_doll(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
   169		var ft: Array = Gait.feet(15, walk)
   170		var bx: Transform2D = Gait.body_xf(15, walk)
   171		_line(ci, Vector2(-5, -11 + bx.origin.y), Vector2(-5 + ft[0], -2 - ft[1]), Color("#c9a26b"), 3.2, a)
   172		_line(ci, Vector2(5, -11 + bx.origin.y), Vector2(5 + ft[2], -2 - ft[3]), Color("#c9a26b"), 3.2, a)
   173		_push_body(ci, bx)
   174		var sway: float = Gait.swing(15, walk)
   175		# 隊伍色布身，粗縫線
   176		var body := PackedVector2Array([Vector2(-11, -8), Vector2(-13, -24), Vector2(13, -24), Vector2(11, -8)])
   177		_poly(ci, body, tc, a)
   178		for k in 3:
   179			var y := -21.0 + k * 5.0
   180			ci.draw_line(Vector2(-3, y), Vector2(3, y + 2.2), Color(OUT, 0.8 * a), 1.5, true)
   181			ci.draw_line(Vector2(3, y), Vector2(-3, y + 2.2), Color(OUT, 0.8 * a), 1.5, true)
   182		_line(ci, Vector2(-12, -21), Vector2(-17 - sway * 12.0, -15 - w * 5.0 + sway * 6.0), tc.darkened(0.15), 3.2, a)
   183		_line(ci, Vector2(12, -21), Vector2(18 + sway * 12.0, -15 + w * -5.0 + sway * 6.0), tc.darkened(0.15), 3.2, a)
   184		# 麻布頭、一邊大鈕扣、一邊 X
   185		_c(ci, Vector2(0, -35), 12.5, Color("#e8d3a8"), a)
   186		_c(ci, Vector2(6, -35), 4.6, tc.lightened(0.3), a)
   187		ci.draw_circle(Vector2(5, -36), 1.1, Color(OUT, a), true, -1.0, true)
   188		ci.draw_circle(Vector2(7.5, -34), 1.1, Color(OUT, a), true, -1.0, true)
   189		ci.draw_line(Vector2(-8, -38), Vector2(-3, -33), Color(OUT, a), 2.0, true)
   190		ci.draw_line(Vector2(-3, -38), Vector2(-8, -33), Color(OUT, a), 2.0, true)
   191		ci.draw_line(Vector2(-4, -28), Vector2(5, -28), Color(OUT, a), 1.5, true)
   192		# 頭上插一根大針（招牌）
   193		var nd := sway * 14.0
   194		_line(ci, Vector2(-3, -40), Vector2(-11 - nd, -54), STEEL, 1.8, a)
   195		_c(ci, Vector2(-12 - nd, -56), 3.4, Color("#ff4d6d"), a)
   196	
   197	
   198	static func _f_sprite(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
   199		var wk := Gait.ph(walk)
   200		_push_body(ci, Gait.body_xf(16, walk))
   201		# 飄浮的大沙漏，不畫人形（免得和鼓手、醫者撞）；弧形翅膀、沙子往下流
