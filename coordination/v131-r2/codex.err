    45	
    46	## 一步週期走多少螢幕 px，用來把位移換成相位。
    47	static func cycle_px(t: int, scale: float) -> float:
    48		return 2.0 * stride(t) * scale
    49	
    50	## 相位（累積世界位移，1000＝1 格；cs＝每格 px）。
    51	static func phase_of(t: int, world: float, cs: float, scale: float, id: int) -> float:
    52		return world * cs / 1000.0 / cycle_px(t, scale) * TAU + 0.0001 + id * 0.37
    53	
    54	## 腳的位移：[遠腳 x, 遠腳抬起, 近腳 x, 近腳抬起]。踩地段往後等速走（抵銷身體前進），騰空段弧線往前。
    55	static func feet(t: int, walk: float) -> Array:
    56		if walk <= POSE_DAZE + 1.0:
    57			return [1.0, 0.0, -1.0, 0.0]
    58		if walk <= POSE_DRAG + 1.0:
    59			return [7.0, 0.0, 10.0, 0.0]   # 腳在身前被拖著
    60		if walk == 0.0:
    61			return [0.0, 0.0, 0.0, 0.0]
    62		var a := _foot(t, walk)
    63		var b := _foot(t, walk + PI)
    64		return [a[0], a[1], b[0], b[1]]
    65	
    66	static func _foot(t: int, walk: float) -> Array:
    67		var u := fposmod(walk, TAU) / TAU
    68		var s := stride(t)
    69		var lift := float(T[t][6])
    70		if u < 0.5:
    71			return [s * 0.5 - s * (u * 2.0), 0.0]               # 踩地：+s/2 → −s/2
    72		var v := (u - 0.5) * 2.0
    73		return [-s * 0.5 + s * v, sin(v * PI) * lift]           # 騰空
