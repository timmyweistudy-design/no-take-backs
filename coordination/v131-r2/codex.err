   262	static func _cavalry(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry := false) -> void:
   263		var wk := Gait.ph(walk)
   264		var gallop := sin(wk) * 3.5 if wk != 0.0 else 0.0
   265		var pony := Color("#d9a066")
   266		# 腿（V9 P2）：前後腿成對的木馬步，腳踩地不滑
   267		var ft: Array = Gait.feet(D.CAVALRY, walk)
   268		var k_leg := 0
   269		for lx in [-11.0, -5.0, 6.0, 12.0]:
   270			var front: bool = lx > 0.0
   271			var fx: float = ft[0] if front else ft[2]
   272			var fy: float = ft[1] if front else ft[3]
   273			var lift := maxf(0.0, w) * 12.0 if front else 0.0   # 命中時馬前蹄抬起（第三輪 R4；Antigravity S4 加大）
   274			fx += 0.6 if k_leg % 2 == 0 else -0.6   # 同一對腿微微錯開（不縮步長，否則又會滑）
   275			_line(ci, Vector2(lx, -12), Vector2(lx + fx + lift * 0.6, -2 - lift - fy), Color("#9c6b3c"), 3.0, a)
   276			k_leg += 1
   277		_push_body(ci, Gait.body_xf(D.CAVALRY, walk))
   278		# 身體（圓滾滾）
   279		var body := PackedVector2Array()
   280		for i in 20:
     1	extends "res://scripts/ui/units/kingdom.gd"
     2	## 由 art.gd 拆出（V9 P1，行為不變）
     3	
     4	# ───────────────────────── 第八輪奇幻軍 ─────────────────────────
     5	## 隊伍色放上半身、面積要夠（§6）。全部 Q 版二頭身、粗黑框、白眼黑瞳。
     6	static func _fantasy(ci: CanvasItem, type: int, tc: Color, walk: float, w: float, a: float, t: float, angry := false, variant := 0) -> void:
     7		match type:
     8			10: _f_spore(ci, tc, walk, w, a, t, angry)
     9			11: _f_sheep(ci, tc, walk, w, a, t, angry)
    10			12: _f_mimic(ci, tc, walk, w, a, t, angry)
    11			13: _f_slime(ci, tc, walk, w, a, t, angry, 1.0)
    12			14: _f_ghost(ci, tc, walk, w, a, t, angry)
    13			15: _f_doll(ci, tc, walk, w, a, t, angry)
    14			16: _f_sprite(ci, tc, walk, w, a, t, angry)
    15			17: _f_bone(ci, tc, walk, w, a, t, angry, variant)
    16			18: _f_cat(ci, tc, walk, w, a, t, angry, variant)
    17			19: _f_golem(ci, tc, walk, w, a, t, angry, variant)
    18			20: _f_slime(ci, tc, walk, w, a, t, angry, 0.66)
    19			21: _f_skeleton(ci, tc, walk, w, a, t, angry)
    20	
