     4	# ───────────────────────── 第八輪奇幻軍 ─────────────────────────
     5	## 隊伍色放上半身、面積要夠（§6）。全部 Q 版二頭身、粗黑框、白眼黑瞳。
     6	static func _fantasy(ci: CanvasItem, type: int, tc: Color, walk: float, w: float, a: float, t: float, angry := false, variant := 0) -> void:
     7		match type:
     8			10: _f_spore(ci, tc, walk, w, a, t, angry)
     9			11: _f_sheep(ci, tc, walk, w, a, t, angry)
    10			12: _f_mimic(ci, tc, walk, w, a, t, angry)
    11			13: _f_slime(ci, tc, walk, w, a, t, angry, 1.0)
    12			14: _f_ghost(ci, tc, walk, w, a, t, angry)
    13			15: _f_doll(ci, tc, walk, w, a, t, angry)
    14			16: _f_sprite(ci, tc, walk, w, a, t, angry)
    15			17: _f_bone(ci, tc, walk, w, a, t, angry, variant)
    16			18: _f_cat(ci, tc, walk, w, a, t, angry, variant)
    17			19: _f_golem(ci, tc, walk, w, a, t, angry, variant)
    18			20: _f_slime(ci, tc, walk, w, a, t, angry, 0.66)
    19			21: _f_skeleton(ci, tc, walk, w, a, t, angry)
    20	
    21	
    22	static func _f_spore(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
    23		_push_body(ci, _atk_xf(Gait.body_xf(10, walk), maxf(w, 0.0), 0.3, 0.0, true))
    24		# 短胖的柄＋超大菇傘；攻擊（噴毒）時整朵壓扁再彈起，底下兩朵小芽
    25		var sq := 1.0 + maxf(0.0, w) * 0.22 - minf(0.0, w) * 0.1
    26		var low := 1.0 - maxf(0.0, w) * 0.2
    27		for s in [[-14.0, 4.0], [14.0, 3.2]]:
    28			_poly(ci, PackedVector2Array([Vector2(s[0] - 1.6, -2), Vector2(s[0] - 1.2, -6), Vector2(s[0] + 1.2, -6), Vector2(s[0] + 1.6, -2)]), Color("#f2e6cf"), a, false)
    29			ci.draw_circle(Vector2(s[0], -7), s[1], Color(OUT, a), true, -1.0, true)
    30			ci.draw_circle(Vector2(s[0], -7), s[1] - 1.4, Color(tc, a), true, -1.0, true)
    31		_poly(ci, PackedVector2Array([Vector2(-10, -3), Vector2(-8, -22 * low), Vector2(8, -22 * low), Vector2(10, -3)]), Color("#f2e6cf"), a)
    32		ci.draw_line(Vector2(-6, -8), Vector2(6, -8), Color("#d9c6a3", a), 1.4, true)
    33		_eyes(ci, Vector2(1.5, -13 * low), a, t, angry)
    34		var cy := -22.0 * low
    35		var cap := _ell(Vector2(0, cy), 22.0 * sq, 19.0 * low, PI, TAU, 16)
    36		cap.append(Vector2(15 * sq, cy + 5)); cap.append(Vector2(-15 * sq, cy + 5))
    37		_poly(ci, cap, tc, a)
    38		ci.draw_arc(Vector2(0, cy), 16.0 * sq, PI * 1.15, PI * 1.5, 8, Color(1, 1, 1, 0.4 * a), 2.6, true)
    39		for d in [[-11, -8, 3.6], [3, -14, 4.4], [13, -6, 3.0], [-3, -4, 2.6]]:
    40			_c(ci, Vector2(d[0] * sq, cy + d[1] * low), d[2], Color("#fff7e6"), a, false)
    41		if w > 0.0:
    42			for k in 5:
    43				var an := -PI + k * PI / 4.0
    44				ci.draw_circle(Vector2(cos(an) * (24 + w * 8), cy + sin(an) * (17 + w * 8)), 2.6, Color(0.7, 1.0, 0.45, 0.85 * a), true, -1.0, true)
    45	
    46	
    47	static func _f_sheep(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
    48		var wk := Gait.ph(walk)
    49		var ft: Array = Gait.feet(11, walk)
    50		for lx in [-11.0, -4.0, 5.0, 12.0]:
    51			var front: bool = lx > 0.0
    52			var sw: float = (ft[0] if front else ft[2])
    53			var up: float = (ft[1] if front else ft[3])
    54			_line(ci, Vector2(lx, -10), Vector2(lx + sw, -3 - up), Color("#4a4258"), 3.0, a)
    55			_c(ci, Vector2(lx + sw, -2.5 - up), 2.4, Color("#1d1a2b"), a, false)   # 黑蹄
    56		_push_body(ci, Gait.body_xf(11, walk))
    57		# 羊毛染隊伍色（白毛會被特效洗掉）
    58		var wool := tc.lightened(0.14)
    59		var blobs := [[-11, -18, 9.5], [0, -23, 11.5], [11, -18, 9.0], [-5, -13, 8.5], [6, -13, 8.5], [-1, -30, 8.5], [-9, -26, 7.5], [8, -27, 7.5]]
    60		for b in blobs:
    61			_c(ci, Vector2(b[0], b[1]), b[2], wool, a)
    62		for b2 in blobs:
    63			ci.draw_circle(Vector2(b2[0], b2[1]), b2[2], Color(wool, a), true, -1.0, true)
    64		for h in [[-5, -28, 3.6], [6, -25, 2.8], [-9, -18, 2.4]]:
