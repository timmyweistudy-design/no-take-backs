    22	static func _f_spore(ci: CanvasItem, tc: Color, walk: float, w: float, a: float, t: float, angry: bool) -> void:
    23		_push_body(ci, _atk_xf(Gait.body_xf(10, walk), maxf(w, 0.0), 0.3, 0.0, true))
    24		# 短胖的柄＋超大菇傘；攻擊（噴毒）時整朵壓扁再彈起，底下兩朵小芽
    25		var sq := 1.0 + maxf(0.0, w) * 0.22 - minf(0.0, w) * 0.1
    26		var low := 1.0 - maxf(0.0, w) * 0.2
    27		for s in [[-14.0, 4.0], [14.0, 3.2]]:
    28			_poly(ci, PackedVector2Array([Vector2(s[0] - 1.6, -2), Vector2(s[0] - 1.2, -6), Vector2(s[0] + 1.2, -6), Vector2(s[0] + 1.6, -2)]), Color("#f2e6cf"), a, false)
    29			ci.draw_circle(Vector2(s[0], -7), s[1], Color(OUT, a), true, -1.0, true)
    30			ci.draw_circle(Vector2(s[0], -7), s[1] - 1.4, Color(tc, a), true, -1.0, true)
    31		_poly(ci, PackedVector2Array([Vector2(-10, -3), Vector2(-8, -22 * low), Vector2(8, -22 * low), Vector2(10, -3)]), Color("#f2e6cf"), a)
    32		ci.draw_line(Vector2(-6, -8), Vector2(6, -8), Color("#d9c6a3", a), 1.4, true)
    33		_eyes(ci, Vector2(1.5, -13 * low), a, t, angry)
    34		var cy := -22.0 * low
    35		var cap := _ell(Vector2(0, cy), 22.0 * sq, 19.0 * low, PI, TAU, 16)
    36		cap.append(Vector2(15 * sq, cy + 5)); cap.append(Vector2(-15 * sq, cy + 5))
    37		_poly(ci, cap, tc, a)
    38		ci.draw_arc(Vector2(0, cy), 16.0 * sq, PI * 1.15, PI * 1.5, 8, Color(1, 1, 1, 0.4 * a), 2.6, true)
    39		for d in [[-11, -8, 3.6], [3, -14, 4.4], [13, -6, 3.0], [-3, -4, 2.6]]:
    40			_c(ci, Vector2(d[0] * sq, cy + d[1] * low), d[2], Color("#fff7e6"), a, false)
    41		if w > 0.0:
    42			for k in 5:
    43				var an := -PI + k * PI / 4.0
    44				ci.draw_circle(Vector2(cos(an) * (24 + w * 8), cy + sin(an) * (17 + w * 8)), 2.6, Color(0.7, 1.0, 0.45, 0.85 * a), true, -1.0, true)
    45	
