   179	static func event_route(ev: Dictionary) -> String:
   180		var k: String = ev.get("kind", "")
   181		if k == EV.DEATH:
   182			return "death"
   183		if k == EV.TAUNT or k == EV.REVEAL:
   184			return k if ev.has("src") and ev.has("tgt") else "skip"
   185		if ev.has("dmg") and ev.has("src") and ev.has("tgt"):
   186			return "attack"
   187		return "skip"
   188	
   189	
   190	
   191	## 第八輪的事件演出。回傳 true＝處理掉了。全部受簡化特效限制（_add_fx 會擋裝飾性的）。
   192	func _on_event_v8(ev: Dictionary, k: String, with_fx: bool) -> bool:
   193		if not k in [EV.POISON, EV.BLAST, EV.VOODOO, EV.BITE, EV.MIMIC_OPEN, EV.SPLIT, EV.CAST, EV.TIMESTOP, EV.RAISE, EV.VACUUM, EV.STOMP, EV.ROCK]:
   194			return false
   195		if not with_fx:
   196			return true
   197		var s = view.unit_by_id(ev.get("src", -1))
   198		var t = view.unit_by_id(ev.get("tgt", -1))
   199		if s == null:
   200			return true
   201		var sp := _upos(s)
   202		var tp := _upos(t) if t != null else sp
   203		match k:
   204			EV.POISON:
   205				hurt_t[t.id] = time
   206				hurt_dir[t.id] = 0.0
   207				_add_fx({"kind": "spore", "p": tp + Vector2(0, -30), "t": 0.0, "dur": 0.5})
   208				sfx.play("poison", 0.25)
   209			EV.VOODOO:
   210				hurt_t[t.id] = time
   211				hurt_dir[t.id] = 0.0
   212				_add_fx({"kind": "pin", "a": sp + Vector2(0, -26), "b": tp + Vector2(0, -26), "t": 0.0, "dur": 0.3})
   213				_report_add(s.team, s.type, k, L.t("ev_voodoo"), Color("#ff6bb0"))
   214			EV.BLAST:
   215				if s.id != t.id:
   216					hurt_t[t.id] = time
   217					hurt_dir[t.id] = signf(tp.x - sp.x) if tp.x != sp.x else 0.0
   218				else:
   219					var small: bool = ev.get("small", false)
   220					_add_fx({"kind": "boom", "src": s.id, "p": sp + Vector2(0, -8), "t": 0.0, "dur": 0.45, "big": not small})
   221					_add_fx({"kind": "wool", "p": sp + Vector2(0, -18), "t": 0.0, "dur": 0.6})
   222					sfx.play("boom", 0.8)
   223					sfx.play("baa", 0.6)
   224					if _fx_on("shake"):
   225						shake = 0.1
   226					_report_add(s.team, s.type, k, L.t("ev_blast"), Color("#ffb347"))
   227			EV.BITE:
   228				atk_t[s.id] = time
   229				hurt_t[t.id] = time
   230				hurt_dir[t.id] = signf(tp.x - sp.x) if tp.x != sp.x else 0.0
   231				_add_fx({"kind": "chomp", "p": tp + Vector2(0, -28), "t": 0.0, "dur": 0.35})
   232				sfx.play("chomp", 0.9)
   233				_report_add(s.team, s.type, k, L.t("ev_bite"), Color("#ffd166"))
   234			EV.MIMIC_OPEN:
   235				_add_fx({"kind": "puff", "p": sp + Vector2(0, -20), "t": 0.0, "dur": 0.4})
   236				sfx.play("reveal", 0.7)
   237			EV.SPLIT:
   238				_add_fx({"kind": "puff", "p": sp + Vector2(0, -12), "t": 0.0, "dur": 0.3})
   239				sfx.play("squish", 0.5)
   240				_report_add(s.team, 13, k, L.t("ev_split"), Color("#7dffa0"))
   241			EV.CAST:
   242				sfx.play("charge_up", 0.5)
   243			EV.TIMESTOP:
   244				_add_fx({"kind": "timebell", "p": sp + Vector2(0, -20), "t": 0.0, "dur": 0.8})
   245				sfx.play("bell", 1.0)
   246				sfx.play("timestop", 0.9)
   247				_report_add(s.team, s.type, k, L.t("ev_timestop"), Color("#ffe08a"))
   248			EV.RAISE:
   249				_add_fx({"kind": "soulrise", "p": sp + Vector2(0, -16), "t": 0.0, "dur": 0.6})
   250				sfx.play("raise", 0.8)
   251				_report_add(s.team, 17, k, L.t("ev_raise"), Color("#c77dff"))
   252			EV.VACUUM:
   253				_add_fx({"kind": "swirl", "p": sp + Vector2(0, -14), "t": 0.0, "dur": 0.6})
   254				sfx.play("vacuum", 0.8)
   255				_report_add(s.team, s.type, k, L.t("ev_vacuum"), Color("#9ad1ff"))
   256			EV.STOMP:
   257				_add_fx({"kind": "stompring", "p": sp, "t": 0.0, "dur": 0.45})
   258				sfx.play("stomp", 0.9)
   259				if _fx_on("shake"):
   260					shake = 0.14
   261				_report_add(s.team, s.type, k, L.t("ev_stomp"), Color("#d9c9a3"))
   262			EV.ROCK:
   263				sfx.play("shatter", 0.7)
   264		return true
   265	
   266	
   267	
   268	func _on_event(ev: Dictionary, with_fx: bool) -> void:
   269		var k: String = ev["kind"]
   270		if _on_event_v8(ev, k, with_fx):
   271			return
   272		if k == EV.DEATH:
   273			var u = view.unit_by_id(ev["id"])
   274			dying.append({"pos": _upos(u), "type": u.type, "team": u.team, "face": signf(u.fx) if u.fx != 0 else 1.0, "t": 0.0})
   275			if with_fx:
   276				sfx.play("death", 0.7)
   277			return
   278		if k == EV.HEAL and with_fx:
   279			# 補血（第四輪 §4.4）：醫者到目標一條淡綠弧線＋綠色「+N」（不加黑底）
   280			var hs0 = view.unit_by_id(ev["src"])
   281			var ht0 = view.unit_by_id(ev["tgt"])
   282			if hs0 != null and ht0 != null:
   283				_add_fx({"kind": "healarc", "a": _upos(hs0) + Vector2(0, -40), "b": _upos(ht0) + Vector2(0, -26), "t": 0.0, "dur": 0.25})
   284				_merge_text(ht0.id, EV.HEAL, "+", int(ev["amt"]), _upos(ht0) + Vector2(0, -70), Color("#7dff8a"))
   285				sfx.play("heal", 0.35)
   286			return
   287		if k == EV.DRUM and with_fx:
   288			var dr0 = view.unit_by_id(ev["src"])
   289			if dr0 != null:
   290				_add_fx({"kind": "note", "p": _upos(dr0) + Vector2(6, -78), "t": 0.0, "dur": 0.8})
