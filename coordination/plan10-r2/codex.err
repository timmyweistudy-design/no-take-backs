     1	extends Node
     2	## V9 地圖美術：每種 地圖＋大小 烘一張地面貼圖（全程式繪製，一張圖只畫一次，不佔每幀繪製）。
     3	## 地形一眼要看懂：擋路＝深色有陰影、慢＝有顆粒的粗地面、快＝亮面加箭紋。樹、岩塊是前景，和角色依 y 排序。
     4	const MD = preload("res://scripts/core/map_defs.gd")
     5	const CS := 64.0
     6	
     7	## 每種地貌的色：底、慢、快、擋、擋的高光、框。
     8	const BIOME := {
     9		"river": {"base": "#6f9a4a", "base2": "#7da655", "slow": "#7a6a44", "fast": "#a9b07a", "block": "#2f7fb5", "edge": "#7cc4e8", "frame": "#5b4632", "sound": "water"},
    10		"forest": {"base": "#4e7a3c", "base2": "#578545", "slow": "#6b5233", "fast": "#8f9a5c", "block": "#2f4d29", "edge": "#6f9a4a", "frame": "#3e2f22", "sound": "forest"},
    11		"ice": {"base": "#d8e6ef", "base2": "#e6f0f6", "slow": "#f7fbff", "fast": "#8fd0ee", "block": "#5d8fb0", "edge": "#ffffff", "frame": "#5f7485", "sound": "wind"},
    12		"lava": {"base": "#3f3640", "base2": "#4a4049", "slow": "#7e7680", "fast": "#6a5d62", "block": "#ff5f1c", "edge": "#ffd166", "frame": "#2c2428", "sound": "lava"},
    13		"canyon": {"base": "#d9b37a", "base2": "#e2bf88", "slow": "#c79a5e", "fast": "#a89a86", "block": "#6d3a26", "edge": "#c47a4e", "frame": "#6e4a2c", "sound": "wind"},
    14	}
    15	
    16	var _tex := {}       # 鍵 → Texture2D
    17	var _busy := {}
    18	
    19	static func key_of(map_id: int, size: int) -> int:
    20		return map_id * 10 + size
    21	
    22	func texture(map_id: int, size: int) -> Texture2D:
    23		var k := key_of(map_id, size)
    24		if _tex.has(k):
    25			return _tex[k]
    26		if not _busy.has(k):
    27			_busy[k] = true
    28			_bake.call_deferred(map_id, size)
    29		return null
    30	
    31	func _bake(map_id: int, size: int) -> void:
    32		var t = MD.terrain(map_id, size)
    33		if t == null:
    34			return
    35		var vp := SubViewport.new()
    36		vp.size = Vector2i(int(t.w / 1000.0 * CS), int(t.h / 1000.0 * CS))
    37		vp.render_target_update_mode = SubViewport.UPDATE_ONCE
    38		vp.disable_3d = true
    39		var p := _Painter.new()
    40		p.biome = BIOME[MD.MAPS[map_id]["biome"]]
    41		p.kind = MD.MAPS[map_id]["biome"]
    42		p.t = t
    43		vp.add_child(p)
    44		add_child(vp)
    45		await RenderingServer.frame_post_draw
    46		await RenderingServer.frame_post_draw
    47		_tex[key_of(map_id, size)] = ImageTexture.create_from_image(vp.get_texture().get_image())
    48		vp.queue_free()
    49	
    50	## 前景物件（世界 px，相對場地左上）：[y, 種類, x, 大小]，依 y 排好。
    51	static func props(map_id: int, size: int) -> Array:
    52		var t = MD.terrain(map_id, size)
    53		if t == null:
    54			return []
    55		var biome: String = MD.MAPS[map_id]["biome"]
    56		if biome == "river" or biome == "canyon":
    57			return []    # 河與崖是平的，不用前景
    58		var out: Array = []
    59		var Q := 0.5 * CS
    60		for r in t.m:
    61			for c in t.n:
    62				if t.grid[c + r * t.n] != t.BLOCK:
    63					continue
    64				var h := absi((c * 73856093) ^ (r * 19349663)) % 1000
    65				if biome == "forest" or (c + r) % 2 == 0:
    66					var x: float = (c + 0.5) * Q + (h % 9 - 4)
    67					var y: float = (r + 0.85) * Q + (h / 10 % 7 - 3)
    68					out.append([y, biome, x, 0.85 + (h % 30) / 100.0])
    69		out.sort_custom(func(a, b): return a[0] < b[0])
    70		return out
    71	
    72	## 畫一個前景物件。ci 已經是場地座標（鏡頭已套用）。
    73	static func draw_prop(ci: CanvasItem, origin: Vector2, pr: Array, time: float) -> void:
    74		var p := origin + Vector2(pr[2], pr[0])
    75		var s: float = pr[3]
    76		match pr[1]:
    77			"forest":
    78				ci.draw_circle(p + Vector2(0, 2), 13.0 * s, Color(0, 0, 0, 0.25), true, -1.0, true)
    79				ci.draw_rect(Rect2(p + Vector2(-3, -12) * s, Vector2(6, 13) * s), Color("#5a3f28"))
    80				ci.draw_circle(p + Vector2(0, -24) * s, 17.0 * s, Color("#1d3a22"), true, -1.0, true)
    81				ci.draw_circle(p + Vector2(0, -24) * s, 15.0 * s, Color("#2f6b37"), true, -1.0, true)
    82				ci.draw_circle(p + Vector2(-5, -29) * s, 8.0 * s, Color("#4c9150"), true, -1.0, true)
    83			"ice":
    84				ci.draw_circle(p + Vector2(0, 2), 11.0 * s, Color(0, 0.1, 0.3, 0.2), true, -1.0, true)
    85				ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-11, 0) * s, p + Vector2(-5, -20) * s, p + Vector2(2, -26) * s, p + Vector2(10, -12) * s, p + Vector2(11, 0) * s]), Color("#a9d8ee"))
    86				ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-5, -20) * s, p + Vector2(2, -26) * s, p + Vector2(1, -8) * s]), Color("#e8f7ff"))
    87			"lava":
    88				ci.draw_circle(p + Vector2(0, 2), 12.0 * s, Color(0, 0, 0, 0.3), true, -1.0, true)
    89				ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-12, 0) * s, p + Vector2(-7, -14) * s, p + Vector2(1, -22) * s, p + Vector2(9, -11) * s, p + Vector2(12, 0) * s]), Color("#2f282d"))
    90				var g := 0.65 + 0.35 * sin(time * 2.0 + p.x)
    91				ci.draw_line(p + Vector2(-3, -2) * s, p + Vector2(1, -14) * s, Color(1.0, 0.55, 0.15, g), 2.0, true)
    92	
    93	class _Painter extends Node2D:
    94		var biome: Dictionary
    95		var kind := ""
    96		var t
    97		func _h(c: int, r: int) -> int:
    98			return absi((c * 73856093) ^ (r * 19349663)) % 100000
    99		func _cell(c: int, r: int) -> int:
   100			if c < 0 or c >= t.n or r < 0 or r >= t.m:
   101				return -1
   102			return t.grid[c + r * t.n]
   103		func _draw() -> void:
   104			var Q := 32.0
   105			var base := Color(biome["base"])
   106			var base2 := Color(biome["base2"])
   107			draw_rect(Rect2(Vector2.ZERO, Vector2(t.n, t.m) * Q), base)
   108			# 底：大色塊，避免太平
   109			for i in 40:
   110				var h := _h(i * 7 + 3, i * 13 + 5)
   111				var p := Vector2(h % int(t.n * Q), (h / 7) % int(t.m * Q))
   112				draw_circle(p, 26.0 + h % 40, Color(base2, 0.5), true, -1.0, true)
   113			# 慢、快
   114			for r in t.m:
   115				for c in t.n:
   116					var v := _cell(c, r)
   117					var o := Vector2(c, r) * Q
   118					var h2 := _h(c, r)
   119					if v == t.SLOW:
   120						draw_rect(Rect2(o, Vector2(Q, Q)), Color(biome["slow"]))
   121						for k in 6:
   122							var d := Vector2((h2 >> k) % 30 + 1, (h2 >> (k + 3)) % 30 + 1)
   123							draw_circle(o + d, 1.6, Color(Color(biome["slow"]).darkened(0.25), 0.8), true, -1.0, true)
   124					elif v == t.FAST:
   125						draw_rect(Rect2(o, Vector2(Q, Q)), Color(biome["fast"]))
   126						if kind == "canyon":
   127							draw_rect(Rect2(o + Vector2(1, 1), Vector2(Q - 2, Q - 2)), Color(1, 1, 1, 0.08))
   128							draw_rect(Rect2(o, Vector2(Q, Q)), Color(0, 0, 0, 0.14), false, 1.5)
   129						else:
   130							draw_line(o + Vector2(4, (h2 % 20) + 4), o + Vector2(Q - 6, (h2 % 20) + 9), Color(1, 1, 1, 0.45), 1.6, true)
   131			# 慢、快的邊界柔化
   132			for r2 in t.m:
   133				for c2 in t.n:
   134					var v2 := _cell(c2, r2)
   135					if v2 == t.FREE or v2 == t.BLOCK:
   136						continue
   137					var col := Color(biome["slow"] if v2 == t.SLOW else biome["fast"])
   138					for d2 in [[1, 0], [-1, 0], [0, 1], [0, -1]]:
   139						if _cell(c2 + d2[0], r2 + d2[1]) == t.FREE:
   140							var e := (Vector2(c2, r2) + Vector2(0.5, 0.5) + Vector2(d2[0], d2[1]) * 0.5) * Q
   141							draw_circle(e, 11.0, col, true, -1.0, true)
   142			# 擋路
   143			for r3 in t.m:
   144				for c3 in t.n:
   145					if _cell(c3, r3) != t.BLOCK:
   146						continue
   147					var o3 := Vector2(c3, r3) * Q
   148					var h3 := _h(c3, r3)
   149					draw_rect(Rect2(o3, Vector2(Q, Q)), Color(biome["block"]))
   150					match kind:
   151						"river":
   152							draw_arc(o3 + Vector2(Q / 2, (h3 % 20) + 6), 9.0, 0.3, 2.6, 8, Color(1, 1, 1, 0.3), 1.6, true)
   153						"lava":
   154							draw_rect(Rect2(o3, Vector2(Q, Q)), Color(1, 0.6, 0.1, 0.25 + (h3 % 30) / 100.0))
   155							# 硬殼與裂縫：暗塊之間透出亮岩漿
   156							for kl in 2:
   157								draw_circle(o3 + Vector2((h3 >> kl) % 30, (h3 >> (kl + 2)) % 30), 7.0 + kl * 2.0, Color("#3a2320"), true, -1.0, true)
   158							draw_line(o3 + Vector2(h3 % 12, 2), o3 + Vector2(10 + h3 % 20, 30), Color("#ffe07a"), 2.2, true)
   159						"canyon":
   160							# 山崖：上面亮、岩層橫紋不對齊，不要像磚牆
   161							draw_rect(Rect2(o3, Vector2(Q, Q)), Color("#6d3a26"))
   162							draw_rect(Rect2(o3, Vector2(Q, Q * 0.42)), Color(Color(biome["edge"]), 0.9))
   163							draw_circle(o3 + Vector2(h3 % 28 + 2, 6 + h3 % 6), 4.5, Color(1, 0.9, 0.75, 0.25), true, -1.0, true)
   164							draw_line(o3 + Vector2(0, 16 + h3 % 7), o3 + Vector2(Q, 14 + (h3 >> 3) % 9), Color(0, 0, 0, 0.22), 2.0, true)
   165							draw_line(o3 + Vector2(0, 25 + h3 % 5), o3 + Vector2(Q, 26 + (h3 >> 4) % 5), Color(0, 0, 0, 0.16), 1.5, true)
   166						"ice":
   167							draw_line(o3 + Vector2(2, h3 % 28), o3 + Vector2(Q - 3, (h3 / 5) % 28), Color(1, 1, 1, 0.55), 1.6, true)
   168			# 牆邊的陰影與描邊：看得出不能走
   169			for r4 in t.m:
   170				for c4 in t.n:
   171					if _cell(c4, r4) != t.BLOCK:
   172						continue
   173					var o4 := Vector2(c4, r4) * Q
   174					if _cell(c4, r4 + 1) != t.BLOCK and r4 + 1 < t.m:
   175						draw_rect(Rect2(o4 + Vector2(0, Q), Vector2(Q, 12 if kind == "canyon" else 7)), Color(0, 0, 0, 0.32))
   176					for d4 in [[1, 0, Vector2(Q, 0), Vector2(Q, Q)], [-1, 0, Vector2.ZERO, Vector2(0, Q)], [0, -1, Vector2.ZERO, Vector2(Q, 0)], [0, 1, Vector2(0, Q), Vector2(Q, Q)]]:
   177						var nb := _cell(c4 + d4[0], r4 + d4[1])
   178						if nb != t.BLOCK and nb != -1:
   179							draw_line(o4 + d4[2], o4 + d4[3], Color(biome["edge"]), 2.5, true)
   180			# 橋：河裡的空格鋪木板
   181			if kind == "river":
   182				for r5 in t.m:
   183					for c5 in t.n:
   184						if _cell(c5, r5) != t.FREE:
   185							continue
   186						var left := false
   187						var right := false
   188						for dx in range(1, 5):
   189							left = left or _cell(c5 - dx, r5 - 0) == t.BLOCK
   190							right = right or _cell(c5 + dx, r5) == t.BLOCK
   191						var above := false
   192						for dy in range(1, 8):
   193							above = above or _cell(c5, r5 - dy) == t.BLOCK or _cell(c5, r5 + dy) == t.BLOCK
   194						if above and not left and not right:
   195							var o5 := Vector2(c5, r5) * Q
   196							draw_rect(Rect2(o5, Vector2(Q, Q)), Color("#8a6238"))
   197							for k5 in 3:
   198								draw_line(o5 + Vector2(k5 * 11.0, 0), o5 + Vector2(k5 * 11.0, Q), Color("#5b3f23"), 2.0, true)

