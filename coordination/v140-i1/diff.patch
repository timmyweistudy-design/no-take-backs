+static func nemesis_title_parts(units: Array) -> Array:
+	var cnt := {}
+	var h := 7
+	for u in units:
+		var t := int(u["type"])
+		cnt[t] = int(cnt.get(t, 0)) + 1
+		h = (h * 31 + t * 7 + int(u.get("col", 0)) * 3 + int(u.get("row", 0))) % 100003
