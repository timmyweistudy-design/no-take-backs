    39	func _finish_battle() -> void:
    40		sfx.set_muffled(false)
    41		fx = fx.filter(func(f): return f["kind"] != "text")   # 結果頁不留戰場跳字（Antigravity S3）
    42		clutch_t = 0.0   # 最後時刻橫幅不跟到結果頁（第三輪 T4 抓到）
    43		state = St.RESULT
    44		result_t = time
    45		if play_kind == "official" and sim != null:
    46			last_cmds = sim.cmd_log.duplicate(true)
    47		result_tab = 0
    48		_focus = 0
    49		slow_left = 0.0
    50		zoom_target = 1.0
    51		var w: int = sim.winner
    52		var eff: Dictionary = PLAY_EFFECTS[play_kind]
    53		if eff["series"]:
    54			if w >= 0:
    55				wins[w] += 1
    56			series_over = series_done(wins, round_no, rules)
    57		_build_report()
    58		if mode == Mode.DUEL:
    59			sfx.play("win" if w >= 0 else "lose")
    60		elif mode == Mode.PUZZLE and report.has("goal_ok"):
    61			sfx.play("win" if bool(report["goal_ok"]) else "lose")   # 第十三輪：照過關條件（Codex v13-r1 #6）
    62		else:
    63			sfx.play("win" if w == 0 else "lose")
    64		sfx.play("ui_quill", 0.45)   # V1.3 B4：戰報寫上羊皮紙的筆聲（各模式都有）
    65		if eff["progress"]:
    66			_progress_and_achievements()
    67			if mode == Mode.VS_AI or mode == Mode.GAUNTLET or mode == Mode.DUEL:
    68				call("_record_match", w)
    69			call("_trial_finish", w)
    70			call("_daily_finish", w)
    71			Save.save_data()     # 統計是最後才記的，要再存一次（Codex #7）
    72		if eff["log"]:
    73			Save.playtest_log(_pt_entry(0))
    74	
