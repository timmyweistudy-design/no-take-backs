    21		if m != Mode.VS_AI:
    22			set("challenge_army", null)
    23		if m == Mode.GAUNTLET:
    24			set("gauntlet_gold", 0)
    25			set("gauntlet_cap", 0)
    26			set("gauntlet_foe_gold", 0)
    27			set("gauntlet_foe_cap", 0)
    28			set("gauntlet_contract", -1)
