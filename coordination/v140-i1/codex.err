   366			[r.type_cap, r.budget_of(0)], [r.ticks / 20, sks], [r.budget_of(0), r.type_cap], [r.budget_of(0), r.unit_cap, sks]][mut]
   367		return L.t("daily_mut_%d_d" % mut, args)
   368	
   369	func _daily_finish(w: int) -> void:
   370		if daily_spec.is_empty() or w != 0:
   371			return
   372		var rem: int = PZ.rem_pct(sim.power(0), sim.budget_of(0))
   373		var spent: int = armies[0].spent()
   374		var best: Dictionary = Save.data.get("daily_best", {})
   375		var nw := Daily.record(best, daily_spec, rem, spent)
   376		Save.data["daily_best"] = best
