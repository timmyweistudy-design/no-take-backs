    46	func _init(p_team: int = 0, p_budget: int = 100) -> void:
    47		team = p_team
    48		budget = p_budget
    49	
    50	func spent() -> int:
    51		var s := 0
    52		for u in units:
    53			s += D.cost(u["type"])
    54		return s
    55	
    56	func left() -> int:
    57		return budget - spent()
    58	
    59	func count() -> int:
    60		return units.size()
    61	
    62	func count_of(t: int) -> int:
    63		var n := 0
    64		for u in units:
