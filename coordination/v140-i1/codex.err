   706			# 重播／覆盤：先用確定性模擬算出整場長度，時間軸以實際秒數為滿（Antigravity S5）
   707			var pa0 = a0.copy()
   708			var pa1 = a1.copy()
   709			var pr = battle_rules.copy() if battle_rules != null else null
   710			var plog: Array = last_cmds.duplicate(true)
   711			var run_pre := func() -> int:
   712				var pre = Sim.new(pa0, pa1, pr)
   713				if pre.cmd_on:
   714					pre.cmd_play(plog)
   715				pre.fast = true
   716				pre.run_to_end()
   717				return pre.tick
   718			if _async_ok():
   719				pre_thread = Thread.new()
   720				pre_thread.start(run_pre)
   721			else:
   722				replay_total = run_pre.call()
   723		paused = false
   724		follow_id = -1
   725		battle_marks.clear()
   726		report_log.clear()
   727		skip_busy = false
   728		seek_target = -1
