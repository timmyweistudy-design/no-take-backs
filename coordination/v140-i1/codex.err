   298		var x := 640.0 - (bs.size() * (bw2 + gap) - gap) / 2.0
   299		if mode == Mode.VS_AI and not watch_mode and _near_miss():
   300			_text(Vector2(640, 618), L.t("review_near_d", [roundi(sim.power(1) * 100.0 / (sim.budget_of(1) * 1000))]), tz("S"), ACCENT, true, true, 820)
   301		for i in bs.size():
   302			_btn(Rect2(x + i * (bw2 + gap), 648, bw2, 46), bs[i][0], bs[i][1], true, i == 0)
   303	
