   101	func _seek_begin(target: int) -> void:
   102		var armies2: Array = rv_last if play_kind == "review" and not rv_last.is_empty() else last_armies
   103		sim = Sim.new(armies2[0].copy(), armies2[1].copy(), battle_rules)
   104		call("_cmd_setup", sim, play_kind)
   105		ev_count = {}
   106		set("last_blast_tick", -99)
   107		_seek_ct = -1
   108		battle_marks.clear()
   109		_seek_stop = maxi(0, target - ViewBuffer.DELAY)
   110		_seek_target_now = target
   111	
   112	var _seek_target_now := 0
   113	
   114	## 算到時間用完或到達目標；到達回傳 true。
   115	func _seek_tick(budget_ms: int) -> bool:
   116		var t0 := Time.get_ticks_msec()
   117		while sim.tick < _seek_stop and not sim.finished:
   118			if Time.get_ticks_msec() - t0 >= budget_ms:
   119				return false
   120			sim.step()
   121			for ev in sim.events:   # 快轉時也要累計戰報次數與時間軸標記（Codex S5 #4：共用同一個收集函式）
   122				if ev.has("src"):
   123					var s = sim.unit_by_id(ev["src"])
   124					var key := "%s%d" % [ev["kind"], s.team]
   125					ev_count[key] = int(ev_count.get(key, 0)) + 1
   126					if ev["kind"] == EV.BLAST and not ev.has("dmg"):
   127						ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
   128				_collect_mark(ev, sim, sim.tick)
   129			if _seek_ct < 0 and not sim.finished and clutch_cond(sim):
   130				_seek_ct = sim.tick
   131		return true
   132	
   133	func _seek_finish() -> void:
   134		call_deferred("_tm_sync")
   135		var target := _seek_target_now
   136		var keep_ct := _seek_ct
   137		var had_clutch := keep_ct >= 0
   138		view = ViewBuffer.new(sim)
   139		prev_pos.clear()
   140		_gait_reset()
   141		for u in view.units:
   142			prev_pos[u.id] = Vector2(u.x, u.y)
   143		fx.clear()
   144		dying.clear()
   145		graves.clear()
   146		atk_hit.clear()
   147		atk_seq.clear()
   148		atk_t.clear()
   149		hurt_t.clear()
   150		hurt_dir.clear()
   151		brace_t.clear()
   152		accum = 0.0
   153		result_delay = 0.0
   154		clutch_t = 0.0
   155		slow_left = 0.0
   156		final_left = 0.0     # Codex v10-r1 #4：跳回前段不能留著慢動作，再播到末擊要再演
   157		final_used = false
   158		key_used = false
   159		key_t = -10.0
   160		last_kill = [-1, -10.0]
   161		last_hitter.clear()
   162		hitstop = 0.0
   163		# 演出狀態依目標時間重建（Codex S5 #5）：最後時刻是否已發生、是否已進狂熱、音樂
   164		slow_used = had_clutch
   165		clutch_tick = keep_ct if had_clutch else -1
   166		if had_clutch:
   167			battle_marks.append({"tick": keep_ct, "kind": "clutch", "team": -1})
   168		_pump_view()
   169		# 畫面推到剛好第 target tick（原本停在 target−DELAY）
   170		while view.tick < target and not view.finished:
   171			_sim_step(false)
   172		frenzy_seen = view.frenzy
   173		if sfx != null:
   174			sfx.play_music("music_frenzy" if view.frenzy else "music_battle")
