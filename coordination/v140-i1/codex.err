   691	func _begin_battle(a0, a1, kind := "official") -> void:
   692		_pre_drop()
   693		play_kind = kind
   694		tm_ghost = null   # V1.4 #1：時光機的原本時間線只在「如果」播放時存在（_rv_play 之後會再設）
   695		_ensure_sprites([a0, a1])
