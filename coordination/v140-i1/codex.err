   405	func _ach(id: String) -> void:
   699	## 戰力走勢的標記：最多 3 個，優先「勝負已定」「領先交換」「最後時刻」，再補第一個技能時刻。
   700	func _key_marks() -> Array:
   701		var out: Array = []
   702		var lock_t := int(report.get("lock_sec", 0)) * 20
   703		if lock_t > 0 and sim.winner >= 0:
   704			out.append({"t": lock_t, "label": "%s %ds" % [L.t("tl_lock"), lock_t / 20]})
   705		var leads: Array = report.get("leads", [])
   706		if not leads.is_empty():
   707			out.append({"t": int(leads[leads.size() - 1]), "label": "%s %ds" % [L.t("tl_lead"), int(leads[leads.size() - 1]) / 20]})
   708		for m in battle_marks:
   709			if out.size() >= 3:
   710				break
   711			if str(m["kind"]) == "clutch":
   712				out.append({"t": int(m["tick"]), "label": "%s %ds" % [L.t("tl_clutch"), int(m["tick"]) / 20]})
   713		for m in battle_marks:
   714			if out.size() >= 3:
   715				break
   716			if str(m["kind"]) != "clutch":
   717				out.append({"t": int(m["tick"]), "label": "%s %ds" % [L.t("tl_" + str(m["kind"])), int(m["tick"]) / 20]})
   718		out.sort_custom(func(a, b): return int(a["t"]) < int(b["t"]))
   719		return out
