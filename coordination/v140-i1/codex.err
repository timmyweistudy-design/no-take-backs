   187					bd = d
   188					best = u.id
   189		follow_id = best
   190		if play_kind == "official":
   191			return   # 正式對局暫停時只看資料，不動鏡頭
   192		if best < 0:
   193			zoom_target = 1.0   # 取消跟拍：回到全景（中心由 _battle_process 拉回）
