   357	
   358	## 突變說明：數值一律從這組規則讀（不寫死在字串裡）。
   359	func _daily_desc(sp: Dictionary, r) -> String:
   360		var mut := int(sp["mut"])
   361		var sk: Array = []
   362		for s in CmdD.list_of(int(r.cmd_mask[0])):
   363			sk.append(L.t("cmd_%d" % int(s)))
   364		var sks := L.t("list_sep").join(sk)
