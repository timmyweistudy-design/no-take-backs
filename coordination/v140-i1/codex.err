   243	## 逐版遷移（純函式，測試用）：舊進度一律保留；不認得的欄位也保留（新版遊戲寫的存檔被舊版讀到時不會被刪掉）。
   244	## 比目前新的版本：原樣回傳，不降版。
   245	static func migrate(d: Dictionary) -> Dictionary:
   246		var out := d.duplicate(true)
   247		var v := schema_of(out)
   248		if v > SAVE_VERSION:
   249			return out
   250		if v < 2:
   251			# 1 → 2：欄位名 version 改成 schema_version；加 unit_wins
   252			out.erase("version")
   253			v = 2
   254		if v < 3:
   255			# 2 → 3：解鎖改看獨立的累計場數，初值＝原本的正式場數（已解鎖的兵不會被收回）
   256			var st = out.get("stats", {})
