   202			_text(r.position + Vector2(154, 8), "%d. %s" % [i + 1, trial_name(i)], tz("B"), tcol, false, true, cw - 240)
   203			var sz := "%s %d×%d" % [L.t("map_size_%d" % int(t[1])), MapDefs.SIZES[t[1]][0], MapDefs.SIZES[t[1]][1]]
   204			var diff: String = L.t(["diff_easy", "diff_normal", "diff_hard"][int(t[3])])
