   200	static func sanitize_run(g) -> Dictionary:
   201		if not g is Dictionary:
   202			return {}
   203		var out := {}
   204		for k in ["stage", "seed", "gold", "cap", "changes", "pool"]:
   205			var v = g.get(k)
   206			if not (v is int or v is float):
   207				return {}
   208			out[k] = int(v)
   209		if out["pool"] <= 0 or out["stage"] < 2 or out["stage"] > 7 or out["gold"] < 0 or out["gold"] > 70 or out["cap"] < 0 or out["cap"] > 14:
   210			return {}
   211		var raw = g.get("prev")
   212		if not raw is Array or raw.size() > 80:
   213			return {}
   214		var prev: Array = []
   215		for u in raw:
   216			if not u is Dictionary or not u.has("type"):
   217				return {}
   218			# Codex v10-r1 #1：座標與兵種都要合法，少一項就整份不要（下一輪開場會直接讀）
   219			var free_u: bool = u.has("x") and u.has("y")
   220			var grid_u: bool = u.has("col") and u.has("row")
   221			if not (free_u or grid_u):
   222				return {}
   223			if int(u["type"]) < 0 or int(u["type"]) >= 20:
   224				return {}
   225			if free_u and (int(u["x"]) < 0 or int(u["x"]) > 18000 or int(u["y"]) < 0 or int(u["y"]) > 10000):
   226				return {}
   227			if grid_u and (int(u["col"]) < 0 or int(u["col"]) > 15 or int(u["row"]) < 0 or int(u["row"]) > 8):
   228				return {}
   229			var o := {}
   230			for k2 in u:
   231				var v2 = u[k2]
   232				if not (v2 is int or v2 is float):
   233					return {}
   234				o[str(k2)] = int(v2)
   235			prev.append(o)
   236		out["prev"] = prev
   237		# V1.1 D1：遠征路線的「下一戰敵方」事件。可有可無（舊續局沒有＝0），超出範圍歸 0
   238		for k3 in [["foe_gold", -10], ["foe_cap", -2]]:
   239			var fv = g.get(k3[0], 0)
   240			out[k3[0]] = int(fv) if (fv is int or fv is float) and int(fv) >= int(k3[1]) and int(fv) <= 0 else 0
   241		return out
