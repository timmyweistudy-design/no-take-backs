+## V1.4 #1 時光機：兩條戰力紀錄第一次不一樣的 tick（兩隊戰力交錯存放）。完全一樣回 -1。
+static func diverge_tick(a: PackedInt64Array, b: PackedInt64Array) -> int:
+	var n := mini(a.size(), b.size())
+	for i in n:
+		if a[i] != b[i]:
+			return i / 2
+	return -1 if a.size() == b.size() else n / 2
+
