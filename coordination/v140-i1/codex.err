   477	## 重算「如果」：同一個對手、改過的陣型，用確定性模擬直接跑到結束。
   478	static func review_run(a0, a1, p_rules = null, cmds: Array = []) -> Dictionary:
   479		var s = Sim.new(a0.copy(), a1.copy(), p_rules)
   480		if s.cmd_on:
   481			s.cmd_play(cmds)
   482		s.fast = true
   483		s.run_to_end()
   484		var rem := roundi(s.power(s.winner) * 100.0 / (s.budget_of(s.winner) * 1000)) if s.winner >= 0 else 0
   485		return {"winner": s.winner, "rem": rem, "log": s.power_log, "log2": s.power_log2, "b": [s.budget_of(0), s.budget_of(1)], "ticks": s.tick}
   486	
   487	## V1.4 #1 時光機：兩條戰力紀錄第一次不一樣的 tick（兩隊戰力交錯存放）。完全一樣回 -1。
   488	static func diverge_tick(a: PackedInt64Array, b: PackedInt64Array) -> int:
   489		var n := mini(a.size(), b.size())
   490		for i in n:
   491			if a[i] != b[i]:
   492				return i / 2
   493		return -1 if a.size() == b.size() else n / 2
   494	
   495	func _rv_set_result(res: Dictionary) -> void:
   496		rv_result = res
   497		rv_div = diverge_tick(rv_base.get("log2", PackedInt64Array()), res.get("log2", PackedInt64Array())) if not res.is_empty() else -1
   498	
   499	## 第七輪 M3：覆盤重算開背景執行緒（模擬是純計算），畫面不卡；算的時候按鈕不能再按（防重入）。
   500	var rv_thread: Thread = null
   501	var rv_gen := 0          # 陣型改一次加一；算完時世代不同就丟掉（Codex r1：舊陣型的結果不能配新陣型）
   502	var rv_thread_gen := 0
   503	
   504	func _rv_dirty() -> void:
   505		rv_result = {}
   506		rv_div = -1
   507		rv_gen += 1
   508	
   509	func _rv_recalc() -> void:
   510		if rv_thread != null:
   511			return
   512		if DisplayServer.get_name() == "headless" or shot_dir != "":
   513			_rv_set_result(review_run(rv_army, rv_enemy, battle_rules, last_cmds))
   514			return
   515		var a: Variant = rv_army.copy()
   516		var e: Variant = rv_enemy.copy()
   517		var r: Variant = battle_rules.copy() if battle_rules != null else null
   518		rv_thread_gen = rv_gen
   519		rv_thread = Thread.new()
   520		var lg: Array = last_cmds.duplicate(true)
   521		rv_thread.start(func(): return review_run(a, e, r, lg))
   522	
   523	func _rv_poll() -> void:
   524		if rv_thread != null and not rv_thread.is_alive():
   525			var res: Dictionary = rv_thread.wait_to_finish()
   526			rv_thread = null
   527			if rv_thread_gen == rv_gen:
   528				_rv_set_result(res)
