    31	const W := COLS * 1000
    32	const H := ROWS * 1000
    33	const EDGE := 200
    34	const QUANT := 50
    35	const E_TERRAIN := "err_terrain"
    36	var deploy := "grid"
    37	var spacing := 1000              # 己方兩隻的最小中心距離
    38	var depth := 6000                # 自己視角 x 上限（全場＝15800）
