    90		_box(r, PANEL, TH_EDGE, 10.0, 3.0)
    91		var w: int = sim.winner
    92		var title := L.t("draw")
    93		var col := Color.WHITE
    94		if w >= 0:
    95			title = L.t("win_team", [L.t("blue") if w == 0 else L.t("red")])
    96			col = Art.team_color(w, cbm())
    97		if mode == Mode.PUZZLE and report.has("goal_ok") and PZ.goal(PZ.get_puzzle(puzzle_id)) != "win":
    98			title = L.t("goal_ok") if bool(report["goal_ok"]) else L.t("goal_fail")   # 第十三輪：護送、撐住、斬首看條件
    99			col = Color("#ffd166") if bool(report["goal_ok"]) else Color(1, 1, 1, 0.8)
   100		var title_sz := tcap(tz("D"), 64)
   101		# 第十輪 V2、F2：標題離上緣遠一點；橫幅從上面落下（版面檢查、簡化特效不演）
   102		var drop := 0.0
   103		if not layout_probe and not bool(Save.s("reduce_fx")):
   104			var dk := clampf((time - result_t) / 0.25, 0.0, 1.0)
   105			drop = (1.0 - dk) * (1.0 - dk) * -60.0
   106		# V1.2 C3：勝負大字墊一條布幔絲帶（勝方隊色、兩端燕尾、金邊），不再是浮在面板上的單色字
   107		var rib_in := 0.0   # 有緞帶時，摘要第一行用緞帶內寬排版（Codex v120-final：長行跨出緞帶）
   108		if not bool(Save.s("plain_ui")):
   109			var l1 := _result_line1(540.0 - 24.0)
   110			# 緞帶最寬 540；燕尾依剩下的空間縮短，停在左右按鈕前（x 354～926）
   111			var tw: float = minf(540.0, maxf(minf(540.0, _width(title, title_sz, true)) + 120.0, _width(l1, tz("S")) + 40.0))
   112			var tail := clampf((572.0 - tw) / 2.0, 10.0, 34.0)
   113			rib_in = tw - 24.0
   114			l1 = _result_line1(rib_in)   # 高度用和正文同一個寬度決定的斷行
   115			var ry0 := 114.0 - title_sz * 0.02
   116			var ry := ry0 + drop
   117			# 布幔上下要留白（Antigravity impl1）：往下一級字級（只能用字級表裡的值）
   118			var lv: Array = TYPE_SCALE[_scale_key()].values()
   119			var nxt := title_sz
   120			for v in lv:
   121				if v < title_sz and (nxt == title_sz or v > nxt):
   122					nxt = v
   123			# 布幔包住標題＋摘要第一行，下緣金邊落在第一行和勝負敘述之間的空隙；高度用實際（fit 後）字級，和正文推進同一算法
   124			var y1 := 112.0 + nxt * 1.25 + (float(tz("C")) * 1.4 if play_kind == "review" else 0.0)
   125			var l1h := y1 - (112.0 + nxt * 1.25) + text_h(l1, fit(l1, tz("S"), rib_in), rib_in)
   275				bs.append([L.t("retry"), func(): _start_mode(mode)])
   276				if ((w == 0 and mode == Mode.TUTORIAL) or bool(report.get("goal_ok", false))) and puzzle_id != "ws":
   277					bs.append([L.t("next_puzzle"), func(): _next_puzzle()])
   278			Mode.GAUNTLET:
   279				if w == 0 and gauntlet_stage < 7:
   280					bs.append([L.t("continue"), func(): call("_gauntlet_reward")])
   281				else:
   282					bs.append([L.t("menu_gauntlet"), func(): _start_mode(Mode.GAUNTLET)])
   283		if watch_mode:
   284			bs.clear()   # 看對戰代碼：不接正式對局的「下一局」（Codex S5 #2）
   285	
   286		if mode == Mode.VS_AI and last_armies.size() == 2 and not watch_mode:
   287			if _near_miss():
   288				bs.insert(0, [L.t("review_near"), func(): _open_review()])   # 第十輪 F4：輸得很近，主推覆盤
   289			else:
   290				bs.append([L.t("menu_review"), func(): _open_review()])   # 覆盤（第三輪 F1）
   291		if _ws_ok(w):
   292			bs.append([L.t("ws_make"), func(): call("_make_workshop")])   # V1.1 D3：打贏的格子對戰可以出題
   293		bs.append([L.t("replay"), func(): _replay()])
   294		bs.append([L.t("menu"), func(): _request_leave()])
   295		# 按鈕寬依結果框內寬分（框 880、左右各留 16）：試煉贏了最多 6 顆，舊的固定 176 會凸出框外（使用者截圖）
   296		var gap := 8.0
