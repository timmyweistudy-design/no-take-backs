   306	## 第十輪 F4：輸了、對手剩不到 15% 戰力。
   307	func _near_miss() -> bool:
   308		if sim == null or sim.winner != 1 or last_armies.size() != 2:
   309			return false
   310		return sim.power(1) * 100 < sim.budget_of(1) * 1000 * 15
   311	
   312	## 結果頁的事實列：來源都是 battle_marks（模擬事件），每條都有秒數、哪一方。最多 2 條（結果頁段數上限）。
   313	func _result_facts() -> Array:
   314		var out: Array = []
   315		var pri := [EV_DEATH, "charge", "backstab", "breach", "rally_on", "braced"]
   316		for k in pri:
   317			if out.size() >= 2:
   318				break
   319			for m in battle_marks:
   320				if str(m["kind"]) == k:
   321					var side: String = L.t("blue") if int(m["team"]) == 0 else L.t("red")
   322					out.append([int(m["tick"]), L.t("fact_" + k, [int(m["tick"]) / 20, side])])
   323					break
   324		out.sort_custom(func(x, y): return x[0] < y[0])   # 依時間排
   325		var res: Array = out.map(func(x): return x[1])
   326		# V9：輸了多一條事實：對手誰打最痛、誰克制它（只講數字查得到的，不說「因為」）
   327		if mode == Mode.VS_AI and sim.winner == 1 and play_kind == "official":
   328			var dmg := {}
   329			for u in sim.units:
   330				if u.team == 1:
   331					dmg[u.type] = int(dmg.get(u.type, 0)) + u.dmg_dealt
   332			var top := -1
   333			for t in dmg:
   334				if top < 0 or int(dmg[t]) > int(dmg[top]):
   335					top = t
   336			if top >= 0 and top < D.total():
   337				var names: Array = []
   338				for x in D.total():
   339					if top in AIT.BEATS[x] and names.size() < 2:
   340						names.append(L.t("unit_%d" % x))
   341				if not names.is_empty():
   342					res.append(L.t("res_top_enemy", [L.t("unit_%d" % top), "、".join(names)]))
   343		return res
   344	
   345	
   346	## 「在覆盤裡試試」：直接開覆盤，選中第一隻陣亡的同種兵（A1）。
   347	func _open_review_on_first_loss() -> void:
   348		_open_review()
   349		var dead_type := -1
   350		for u in sim.units:
   351			if u.team == 0 and not u.alive:
   352				dead_type = u.type
   353				break
   354		if dead_type < 0:
   355			return
   400				cnt[su.team] += 1
   401				if su.alive:
   402					liv[su.team] += 1
   403			for gt in 2:
   404				var mine := float(liv[gt]) / maxf(1.0, cnt[gt])
   405				var theirs := float(liv[1 - gt]) / maxf(1.0, cnt[1 - gt])
   406				grim[gt] = mine < 0.25 and theirs > mine * 2.0
   407		# V1.3 P0-1：這一幀的畫面位置只算一次（排序比較器原本每次比較都重算 _upos）
   408		var pc := {}
   409		if live:
   410			for u in list:
   411				pc[u.id] = _upos(u)
   412			list.sort_custom(func(a, b): return pc[a.id].y < pc[b.id].y)
   413		else:
   414			list.sort_custom(func(a, b): return a.y < b.y)
   415		_draw_v8_ground(s, live)
   416		# 第一層：腳底標記與影子（全部先畫，不會被別人的身體整個蓋住時也看得到外圈）
   417		var a_now := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
