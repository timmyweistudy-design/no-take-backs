   403	## 契約達成了嗎（純函式，測試用）。army＝這一戰我方陣型；win＝我方贏；tick＝結束時間；rem＝我方剩餘戰力 %。
   404	static func contract_ok(k: int, army, win: bool, tick: int, rem: int) -> bool:
   405		if not win:
   406			return false
   407		match k:
   408			0:
   409				for u in army.units:
   410					if int(u["type"]) in RANGED:
   411						return false
   412				return true
   413			1:
   414				var kinds := {}
   415				for u in army.units:
   416					kinds[int(u["type"])] = true
   417				return kinds.size() <= 3
   418			2:
   419				return tick <= 900
   420			3:
   421				return rem >= 60
   422			_:
   423				return true   # 少帶、窮兵：簽了就是條件，贏了就達成
   424	
   425	func _ct_reward(k: int) -> String:
   426		var c: Array = CONTRACTS[k]
   427		return L.t("ct_gold", [int(c[1])]) if int(c[1]) > 0 else L.t("ct_cap", [int(c[2])])
   428	
   429	## 這一站可簽的 2 份契約（同一趟同一站永遠一樣）。
   430	func _contract_offers() -> Array:
   431		var r := RandomNumberGenerator.new()
   432		r.seed = gauntlet_seed * 53 + gauntlet_stage * 389 + 11
   433		var ids: Array = range(CONTRACTS.size())
   434		var out: Array = []
   435		while out.size() < 2:
   436			var k: int = ids[r.randi() % ids.size()]
   437			ids.erase(k)
   438			out.append(k)
   439		out.sort()
   440		return out
   441	
   442	## 簽了的契約這一戰的代價（預算、隻數），在 _gauntlet_next 之後套上。
   443	func _apply_contract_cost() -> void:
   444		if gauntlet_contract < 0 or armies.is_empty():
   445			return
   446		var c: Array = CONTRACTS[gauntlet_contract]
   447		armies[0].budget += int(c[3])
   448		armies[0].unit_cap = maxi(4, armies[0].unit_cap + int(c[4]))
   449	
   450	static func ga_node(stage: int) -> String:
   451		return GA_NODES[clampi(stage - 1, 0, GA_NODES.size() - 1)]
   452	
   453	## 這一站提供的 3 個事件（同一趟同一站永遠一樣，續局也一樣）。募兵沒有可換的就不出。
   454	func _gauntlet_offers() -> Array:
   455		var r := RandomNumberGenerator.new()
   456		r.seed = gauntlet_seed * 31 + gauntlet_stage * 977 + 5
   457		var ids: Array = [0, 1, 2, 3, 4, 5]
   458		if _recruit_pick().is_empty():
   459			ids.erase(3)
   460		var out: Array = []
   461		while out.size() < 3 and not ids.is_empty():
   462			var k: int = ids[r.randi() % ids.size()]
   463			ids.erase(k)
   464			out.append(k)
   465		out.sort()
   466		return out
   467	
   468	## 募兵：[加入的兵種, 離隊的兵種]。離隊的不能是上一戰陣型裡有的；換完還要有戰鬥兵。
   469	func _recruit_pick() -> Array:
   470		var pool: int = int(call("_gauntlet_pool"))
   471		var used := {}
   472		# Codex v110-impl #1：離隊的不能是剛打完那一戰陣型裡的兵（下一戰會沿用那個陣型）
   473		var cur: Array = last_armies[0].units if last_armies.size() >= 1 and last_armies[0] != null else gauntlet_prev
   474		for u in cur:
   475			used[int(u["type"])] = true
   476		var ins: Array = []
   477		var outs: Array = []
   478		for ty in 20:
   479			if not RuleSet.has(RS.mask(_demo()), ty):
   480				continue
   481			if RuleSet.has(pool, ty):
   482				if not used.has(ty):
   483					outs.append(ty)
   484			else:
   485				ins.append(ty)
   486		if ins.is_empty() or outs.is_empty():
   487			return []
   488		var r := RandomNumberGenerator.new()
   489		r.seed = gauntlet_seed * 17 + gauntlet_stage * 131 + 3
   490		for _i in 8:
   491			var a: int = ins[r.randi() % ins.size()]
   492			var b: int = outs[r.randi() % outs.size()]
   493			var np: int = (pool | (1 << a)) & ~(1 << b)
   494			if RuleSet.has_combat(np):
   495				return [a, b]
   496		return []
   497	
   498	func _take_reward(k: int) -> void:
   499		overlay = ""
   500		gauntlet_foe_gold = 0
   501		gauntlet_foe_cap = 0
   502		match k:
   503			0:
   504				gauntlet_gold += 10
   505			1:
   506				gauntlet_cap += 2
   507			3:
   508				var rp := _recruit_pick()
   509				if not rp.is_empty():
   510					var pool: int = int(call("_gauntlet_pool"))
   511					Save.data["gauntlet_pool"] = (pool | (1 << int(rp[0]))) & ~(1 << int(rp[1]))
   512			4:
   513				gauntlet_foe_gold = -10
   514			5:
   515				gauntlet_foe_cap = -2
   516		gauntlet_contract = ct_pick   # V1.4 #3：選完事件才生效
   517		call("_gauntlet_next")
   518		_apply_contract_cost()
   519		if k == 2:
   520			gauntlet_changes += 2
   521		call("_gauntlet_save")
   522	
   523	func _ga_event_desc(k: int) -> String:
   524		if k == 3:
   525			var rp := _recruit_pick()
   526			return L.t("rw_recruit_d", [L.t("unit_%d" % int(rp[0])), L.t("unit_%d" % int(rp[1]))]) if not rp.is_empty() else ""
   527		return L.t(GA_EVENTS[k] + "_d")
   528	
   529	func _draw_reward() -> void:
   530		draw_rect(Rect2(0, 0, 1280, 800), Color(0, 0, 0, 0.6))
   531		var P := Rect2(240, 96, 800, 624)
   532		_panel(P)
   533		_h1(Vector2(640, 108), L.t("rw_title"))
   534		_draw_route(Rect2(300, 164, 680, 56), gauntlet_stage + 1)
   535		var offers := _gauntlet_offers()
   536		for i in offers.size():
   537			var k: int = offers[i]
   538			var r := Rect2(268 + i * 252, 236, 240, 200)
   539			_btn(r, "", _take_reward.bind(k), true, false, TH_WOOD_L)
   540			_icon(GA_EVENT_ICONS[k], r.position + Vector2(120, 52), 56.0, ACCENT)
   541			_text(r.position + Vector2(120, 92), L.t(GA_EVENTS[k]), tz("B"), Color.WHITE, true, true, 220)
   542			_text(r.position + Vector2(120, 92 + tz("B") * 1.5), _ga_event_desc(k), tz("C"), TXT_DIM, true, false, 220)
   543		# V1.4 #3 戰利品契約：羊皮紙小卡，可簽一份或不簽（選完上面的事件才生效）
   544		var cy := 452.0
   545		_text(Vector2(640, cy), L.t("ct_title"), tz("B"), Color.WHITE, true, true, 740)
   546		cy += tz("B") * 1.45
   547		var cts := _contract_offers()
   548		for i in 3:
   549			var cr := Rect2(268 + i * 252, cy, 240, 84)
   550			var kk: int = cts[i] if i < cts.size() else -1
   551			var on := ct_pick == kk
   552			btn_paper = on
   553			_btn(cr, "", func(): ct_pick = kk, true, false, TH_ACTIVE if on else Color(0, 0, 0, 0))
   554			btn_paper = false
   555			var en := last_btn_enabled
   556			_probe_dis = not en
   557			_ink_mode = on and last_btn_paper
   558			var tc := (INK if on else Color.WHITE) if en else TXT_DIM
   559			if kk < 0:
   560				_text(cr.get_center() - Vector2(0, tz("S") * 0.6), L.t("ct_none"), tz("S"), tc, true, true, 220)
   561			else:
   562				# 一行：名稱（左）＋報酬（右）；一行：條件（短）
   563				_text(cr.position + Vector2(12, 10), L.t(str(CONTRACTS[kk][0])), tz("S"), tc, false, true, 110)
   564				var rw := _ct_reward(kk)
   565				_text(Vector2(cr.end.x - 12 - minf(110.0, _width(rw, tz("C"))), cr.position.y + 10 + (tz("S") - tz("C")) * 0.5), rw, tz("C"), ACCENT if not on else Color("#7a4a10"), false, true, 110)
   566				_text(cr.position + Vector2(12, 14 + tz("S") * 1.3), L.t(str(CONTRACTS[kk][0]) + "_d"), tz("C"), tc if on else (TXT_DIM if en else tc), false, false, 216)
   567			_ink_mode = false
   568			_probe_dis = false
   569		cy += 96
   570		if ct_last != "":
   571			_text(Vector2(640, cy), ct_last, tz("S"), ACCENT, true, true, 740)
   572			cy += tz("S") * 1.4
   573		_text(Vector2(640, cy), L.t("rw_now", [gauntlet_gold, gauntlet_cap]), tz("S"), TXT_DIM, true, false, 740)
   574		_text(Vector2(640, cy + tz("S") * 1.4), L.t("rw_next", [L.t("ga_node_" + ga_node(gauntlet_stage + 1))]), tz("S"), ACCENT, true, true, 740)
   575	
   576	## 遠征路線條：7 個節點，已打過的打勾、下一戰亮框；菁英、首領用不同圖示。
   577	func _draw_route(R: Rect2, next_stage: int) -> void:
   578		var n := GA_NODES.size()
     1	extends "res://scripts/ui/free_place.gd"
     2	## 由 game_screens.gd 拆出（V9 P1，行為不變）
     3	## 狀態機、模式、輸入、擺放、標題、選單、設定、結果、成就。
     4	
     5	## 第七輪 S7：每次啟動一個 session、每局一個 game；彙整工具靠這兩個去重（評分和對戰是兩行，不能重複算局數）。
     6	var pt_session := str(Time.get_unix_time_from_system()) + "-" + str(randi())
     7	var pt_game := 0
     8	
     9	var keys_capture := ""   # 第七輪 K1：正在改哪個按鍵（"kb:start"／"pad:place"）
    10	
    11	# ───────────────────────── 每幀 ─────────────────────────
    12	## 最小化時 Godot 不繪製，也就沒有垂直同步節流，主迴圈會空轉吃滿一核；降到 10 fps，模擬照常跑（用 delta 累積）。
    13	var _was_minimized := false
    14	## 搖桿連發（第三輪 A2）：超過 0.6 才算推、低於 0.35 才算放開（遲滯）；推下立刻一次，0.35 秒後每 0.12 秒一次。
    15	var stick := {JOY_AXIS_LEFT_X: 0.0, JOY_AXIS_LEFT_Y: 0.0}
    16	var _stick_dir := Vector2i.ZERO
    17	var _stick_t := 0.0
    18	
    19	## 結果頁的技能徽章（第四輪）：候選裡雙方合計次數最多的 6 種；不夠 6 種就用經典的預設順序補。支援兵的補血、戰鼓也在候選裡（對支援兵公平）。
    20	const BADGE_KEYS := ["breaker", "charge", "backstab", "braced", "anticav", "counter", "pike_brace", "splash", "breach", "heal", "drum"]
    21	const EV_DEATH := "death"
    22	
    23	
    24	func _reset_place(keep_blue := false) -> void:
    25		state = St.PLACE
    26		sim = null
    27		view = null
    28		pending_cell = Vector2i(-1, -1)
    29		ai_prebuilt = false
    30		_fp_reset()
    31		# 第一次進擺放畫面自動打開操作說明（第五輪：說明從頂部移到「?」）
    32		if not bool(Save.data.get("seen_place_help", false)) and (mode == Mode.VS_AI or mode == Mode.DUEL) and shot_dir == "":
    33			show_place_help = true
    34			Save.data["seen_place_help"] = true
    35		fx.clear()
    36		dying.clear()
    37		zoom = 1.0
    38		tp = null
    39		blind_phase = 0
    40		_focus = 0
    41		var keep_ok: bool = keep_blue and not armies.is_empty() and (rules == null or rules.keep_formation)
    42		var blue_keep = armies[0].copy() if keep_ok else null
    43		armies = [Army.new(0, 100), Army.new(1, 100)]
    44		if rules != null and (mode == Mode.VS_AI or mode == Mode.DUEL):
    45			armies[0].apply_rules(rules, 0)
    46			armies[1].apply_rules(rules, 1)
    47		if mode == Mode.GAUNTLET:
    48			armies[0].pool = _gauntlet_pool()
    49			armies[1].pool = _gauntlet_pool()
    50		match mode:
    51			Mode.VS_AI:
    52				if blue_keep != null:
    53					armies[0] = blue_keep
    54				if rules != null and rules.fullfield == 2:
    55					# 第六輪：對 AI 明牌全場——AI 先在自己半場擺好並公開，你在全場離敵兵 1.5 格外擺
    56					_build_ai()
    57					ai_prebuilt = true
    58					armies[0].enemy_pos = []
    59					for u in armies[1].units:
    60						armies[0].enemy_pos.append(armies[1].pos_of(u))
    61					var keep: Array = armies[0].units.duplicate(true)
    62					armies[0].units = []
    63					for u in keep:
    64						var pp: Vector2i = armies[0].pos_of(u)
    65						armies[0].place_xy(int(u["type"]), pp.x, pp.y)   # 保留的陣型和新的明牌陣衝突的就拿掉
    66			Mode.DUEL:
    67				if duel_rule != "blind":
    68					tp = TP.new(armies[0], armies[1], (round_no + 1) % 2, duel_rule, rules)
    69					if rules == null:
    70						tp.armies[0].pool = _pool()
    71						tp.armies[1].pool = _pool()
    72			Mode.TUTORIAL, Mode.PUZZLE:
    73				var pz := PZ.get_puzzle(puzzle_id)
    74				armies[0] = PZ.player_army(pz)
    75				armies[1] = PZ.enemy_army(pz)
    76				selected = int(pz["allowed"][0])
    77				if puzzle_plan_id != puzzle_id:
    78					puzzle_plan = PZ.default_plan(pz)   # 第十三輪：同一關重來保留上次設定的時間，換關重設
    79					puzzle_plan_id = puzzle_id
    80			Mode.GAUNTLET:
    81				if not gauntlet_prev.is_empty():
    82					armies[0].units = gauntlet_prev.duplicate(true)
    83				var r := RandomNumberGenerator.new()
    84				r.seed = gauntlet_seed + gauntlet_stage * 7919
    85				var node: String = call("ga_node", gauntlet_stage)
    86				var lvl := 2 if node == "boss" else mini(2, (gauntlet_stage - 1) / 2 + (1 if node == "elite" else 0))
    87				var e := AIT.build_full(1, r, lvl, gauntlet_prev, _pool())
    88				set("gauntlet_nemesis", call("_nemesis_for_stage"))   # V1.4 #2：菁英站可能遇到宿敵
    89				# V1.1 D1：菁英 +10、首領 +20；斥候劫掠／截斷補給只影響這一戰
    90				e.budget = 100 + 5 * (gauntlet_stage - 1) + int(get("GA_NODE_GOLD")[node]) + int(get("gauntlet_foe_gold"))
    91				e.unit_cap = maxi(4, e.unit_cap + int(get("gauntlet_foe_cap")))
    92				# Codex v110-impl #2：先組好的陣可能超出調低後的預算／隻數，從最後放的往回拿掉（至少留一隻戰鬥兵）
    93				while e.units.size() > 1 and (e.spent() > e.budget or e.units.size() > e.unit_cap):
    94					e.units.pop_back()
    95				var guard := 0
    96				while e.can_afford_any() and guard < 20:
    97					guard += 1
    98					var t := AIT.choose_type(e, gauntlet_prev, e.left(), r, lvl, _pool())
    99					if t < 0:
   100						break
   101					var c := AIT.choose_cell(e, t, gauntlet_prev, r)
   102					if c.x < 0 or not e.place(t, c.x, c.y):
   103						break
   104				armies[1] = e
   105				if int(get("gauntlet_nemesis")) >= 0:
   106					armies[1] = call("_nemesis_army", int(get("gauntlet_nemesis")))
   107					var nt: String = call("nemesis_title", Save.data["nemeses"][int(get("gauntlet_nemesis"))])
   108					ai_name = nt
   109					_toast(L.t("nem_back", [nt, int(Save.data["nemeses"][int(get("gauntlet_nemesis"))].get("losses", 1))]))
   110		sfx.play_music("music_place")
   111		sfx.play_ambience(str(MapArt.BIOME.get(MapDefs.MAPS[rules.map_id if rules != null and rules.is_free() else 0]["biome"], {}).get("sound", "")))
   112	
