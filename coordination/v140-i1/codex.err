   139	## 第十輪 I4：困難 AI 第二局起要模擬候選陣型，放背景算，畫面不凍住。回傳 true＝已交給背景。
   140	func _build_ai_async() -> bool:
   310		if not standard:
   311			# 自訂規則專屬成就（標準成就只看標準局）
   312			if me_won and mode == Mode.VS_AI and w == 0:
   313				if rules.budget_of(0) <= 50:
   314					_ach("CUSTOM_LOWGOLD")
   315				if rules.budget_of(0) < rules.budget_of(1):
   316					_ach("CUSTOM_UNDERDOG")
   317			if me_won and rules.unit_cap >= 36:
   318				_ach("CUSTOM_BIG")
   319			_save()
   320			return
   321		if me_won:
   322			_ach("FIRST_WIN")
   323			if sim.alive_count(w) == 1:
   324				_ach("LONE_HERO")
   325			if int(report["sus"]["max_swing_pct"]) >= 15:
   326				_ach("COMEBACK")
   327			if sim.power(w) * 100 / (sim.budget * 1000) <= 5:
   328				_ach("CLOSE_CALL")
   329			if sim.tick >= Sim.FRENZY_TICK:
   330				_ach("FRENZY_WIN")
   331			if types.size() == 5:
   332				_ach("ALL_TYPES")
   333			if int(ev_count.get("charge%d" % w, 0)) >= 5:
   334				_ach("CHARGE_5")
   335			if int(ev_count.get("backstab%d" % w, 0)) >= 3:
   336				_ach("BACKSTAB_3")
   337		if mode == Mode.VS_AI and w == 0 and difficulty == 2:
   338			_ach("HARD_WIN")
   339		if mode == Mode.DUEL and tp != null and series_over:
   340			_ach("NO_TAKEBACKS")
   341		if series_over and ((mode == Mode.DUEL and (wins == [2, 0] or wins == [0, 2])) or (mode == Mode.VS_AI and wins == [2, 0])):
   342			_ach("SWEEP")
   343		if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and puzzle_id != "ws":   # V1.1 D3：工坊殘局不存星數
   344			var stars := int(report.get("stars", 0))
   345			var ps: Dictionary = Save.data.get("puzzle_stars", {})
   346			if stars > int(ps.get(puzzle_id, 0)):
   347				ps[puzzle_id] = stars
   348			Save.data["puzzle_stars"] = ps
   349			if mode == Mode.PUZZLE:
   350				Save.note_try("puzzle", puzzle_id, stars >= 1, armies[0].spent())   # V1.1 F2
   351			if mode == Mode.TUTORIAL and w == 0:
   352				var idx := 0
   353				for i in PZ.tutorials().size():
   354					if PZ.tutorials()[i]["id"] == puzzle_id:
   355						idx = i
   356				Save.data["tutorial"] = maxi(int(Save.data.get("tutorial", 0)), idx + 1)
   357				if int(Save.data["tutorial"]) >= PZ.tutorials().size():
   358					_ach("TUTORIAL")
   359			if stars == 3:
   360				_ach("PUZZLE_3STAR")
   361			var all_done := true
   362			for p in PZ.puzzles():
   363				if int(ps.get(p["id"], 0)) == 0:
   364					all_done = false
   365			if all_done:
   366				_ach("PUZZLE_ALL")
   367			var cleared := 0
   368			var perfect := 0
   369			for p2 in PZ.all_puzzles():
   370				cleared += 1 if int(ps.get(p2["id"], 0)) > 0 else 0
   371				perfect += 1 if int(ps.get(p2["id"], 0)) >= 3 else 0
   372			if cleared >= 100:
   373				_ach("PUZZLE_100")   # 第十三輪
   374			if perfect >= 100:
   375				_ach("PUZZLE_ALL3")
   376		if mode == Mode.GAUNTLET and play_kind == "official":
   377			# V1.4 #2 宿敵戰記：輸了記下打敗你的陣；打贏宿敵就是復仇
   378			if w != 0 and last_armies.size() == 2:
   379				call("_nemesis_record", last_armies[1])
   380			elif w == 0 and int(get("gauntlet_nemesis")) >= 0:
   381				var nl: Array = Save.data.get("nemeses", [])
   382				var ni := int(get("gauntlet_nemesis"))
   383				if ni < nl.size():
   384					nl[ni]["revenged"] = true
   385					_toast(L.t("nem_revenge", [call("nemesis_title", nl[ni])]))
   386		if mode == Mode.GAUNTLET:
   387			if w == 0:
   388				if gauntlet_stage >= 7:
   389					_ach("GAUNTLET")
   390					Save.data["gauntlet_best"] = 7
   391					_gauntlet_clear()
   392			else:
   393				_gauntlet_clear()
   394				Save.data["gauntlet_best"] = maxi(int(Save.data.get("gauntlet_best", 0)), gauntlet_stage - 1)
   395		_save()
