    46	
    47	## ── 主題試煉 ──
    48	func _start_trial(i: int) -> void:
    49		if _demo() and not i in Presets.DEMO_TRIALS:
    50			_toast(L.t("demo_locked"), true)
    51			return
    52		rules = _trial_rules(i, trial_x(i))
    53		challenge_army = null      # 上一場挑戰碼的敵陣不能留到試煉（Codex #5）
    54		rng.seed = 7000 + i        # 同一關每次是同一支隊伍
    55		_start_mode(Mode.VS_AI)
    56		trial_id = i
    57	
    58	## 試煉的規則（遊戲與工具共用）。x＝第十三輪的關卡資料（舊 10 關是空的）。
    59	func _trial_rules(i: int, x: Dictionary):
    60		var t: Array = TRIALS[i]
    61		var r = Presets.make("standard", "ai", RS.mask(_demo()))
    62		r.deploy = "free"
    63		r.spacing = 800
    64		r.depth = 6000
    65		r.fullfield = 0
    66		r.map_id = int(t[0])
    67		r.map_size = int(t[1])
    68		var s: Array = MapDefs.SIZE_SUGGEST[r.map_size]
    69		r.budget = [int(s[0]), int(s[0])]
    70		r.unit_cap = int(s[1])
    71		r.ticks = int(s[2])
    72		r.rounds = 1
    73		r.ai_level = int(t[3])
    74		r.ai_style = int(t[2])
    75		r.ai_pool_same = false
    76		var p := 0
    77		if AI.STYLE_TYPES.has(r.ai_style):
    78			for st0 in AI.STYLE_TYPES[r.ai_style]:
    79				p |= 1 << int(st0)
    80		else:
    81			p = RuleSet.all_pool()
    82		if _demo():
    83			p &= RS.mask(true)
    84		r.pool[1] = p
    85		r.preset = "custom"
    86		if x.has("enemy"):
    87			# 第十三輪：敵方卡池＝固定敵陣實際用到的兵種（一邊最多 10 種），代碼才讀得回（Codex v13-r1 #2、v13-r2 #1）
    88			var pe := 0
    89			for u in x["enemy"]:
    90				pe |= 1 << int(u[0])
    91			r.pool[1] = pe
    92		if x.has("pool0"):
    93			var p0 := 0
    94			for t0 in x["pool0"]:
    95				p0 |= 1 << int(t0)
    96			r.pool[0] = p0 & RS.mask(_demo())
    97		if x.has("budget"):
    98			r.budget = [int(x["budget"]), int(x["budget"])]
    99		if x.has("depth"):
   100			r.depth = int(x["depth"])
   101		if x.has("type_cap"):
   102			r.type_cap = int(x["type_cap"])
   103		if x.has("cmd"):
   104			r.cmd_mask = [int(x["cmd"]), int(x["cmd"])]
   105		return r
   106	
   107	## 第十三輪：固定敵陣（世界座標）。舊 10 關回 null，照舊由 AI 用固定種子生成。
   108	func _trial_enemy():
   109		var x := trial_x(trial_id)
   110		if not x.has("enemy"):
   111			return null
   112		var e := Army.new(1, rules.budget_of(1))
   113		e.apply_rules(rules, 1)
   114		for u in x["enemy"]:
   115			e.units.append({"type": int(u[0]), "x": int(u[1]), "y": int(u[2])})
   116		return e
