   244	func _build_report() -> void:
   245		var dealt := [D.zeros(), D.zeros()]
   246		var taken := [D.zeros(), D.zeros()]
   247		var mvp = null
   248		for u in sim.units:
   249			dealt[u.team][D.report_type(u.type)] += u.dmg_dealt
   250			taken[u.team][D.report_type(u.type)] += u.dmg_taken
   251			# MVP：勝方輸出最高的兵（平手時看全場）
   252			if (sim.winner < 0 or u.team == sim.winner) and (mvp == null or u.dmg_dealt > mvp.dmg_dealt):
   253				mvp = u
   254		var sus: Dictionary = sim.suspense()
   255		report = {"dealt": dealt, "taken": taken, "mvp": mvp, "sus": sus,
   256			"lock_sec": int(sus["lock_ratio_permille"]) * sim.tick / 1000 / 20}
   257		# 時間軸的領先交換點（第三輪 U5）：戰力差換號（忽略 1% 以內的小波動），最多 4 個
   258		var leads: Array = []
   259		var last_sign := 0
   260		var eps: int = sim.budget * 1000 / 100
   261		if sim.judge == 2:
   262			eps = 10   # 讓子：用各自預算的比例（每千分之十＝1%）
   263		for t in sim.power_log.size():
   264			var d: int = sim.power_log[t] if sim.judge == 1 else sim.diff_permille(t)
   265			var sg := 0 if absi(d) <= eps else (1 if d > 0 else -1)
   266			if sg != 0 and last_sign != 0 and sg != last_sign and leads.size() < 4:
   267				leads.append(t + 1)
   268			if sg != 0:
   269				last_sign = sg
   270		report["leads"] = leads
   271		# 殘局星等算在報告裡（重播也看得到），只有「寫進存檔」才受副作用矩陣管（Codex S1 #8）
   272		if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
   273			var pz := PZ.get_puzzle(puzzle_id)
   274			var extra_spent: int = armies[0].spent() - (armies[0].budget - int(pz["budget"]))
   275			var oc := PZ.outcome(pz, sim, extra_spent)   # 第十三輪：和工具、測試同一套判定（含護送、撐住、斬首）
   370				cleared += 1 if int(ps.get(p2["id"], 0)) > 0 else 0
   371				perfect += 1 if int(ps.get(p2["id"], 0)) >= 3 else 0
   372			if cleared >= 100:
   373				_ach("PUZZLE_100")   # 第十三輪
   374			if perfect >= 100:
   375				_ach("PUZZLE_ALL3")
   376		if mode == Mode.GAUNTLET and play_kind == "official":
   377			# V1.4 #2 宿敵戰記：輸了記下打敗你的陣；打贏宿敵就是復仇
   378			if w != 0 and last_armies.size() == 2:
   379				call("_nemesis_record", last_armies[1])
   380			elif w == 0 and int(get("gauntlet_nemesis")) >= 0:
   381				var nl: Array = Save.data.get("nemeses", [])
   382				var ni := int(get("gauntlet_nemesis"))
