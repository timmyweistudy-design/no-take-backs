   138		view = ViewBuffer.new(sim)
   139		prev_pos.clear()
   140		_gait_reset()
   141		for u in view.units:
   142			prev_pos[u.id] = Vector2(u.x, u.y)
   143		fx.clear()
   144		dying.clear()
   145		graves.clear()
   146		atk_hit.clear()
   147		atk_seq.clear()
   148		atk_t.clear()
   149		hurt_t.clear()
   150		hurt_dir.clear()
   151		brace_t.clear()
   152		accum = 0.0
