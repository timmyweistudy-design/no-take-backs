   146	## 第十輪 F1：模擬領先畫面 DELAY 個 tick，已知全滅就在倒下前放慢。和局、逾時、同歸於盡都不演。
   147	func _check_final(with_fx: bool) -> void:
   148		if final_used or not with_fx or not sim.finished or sim.winner < 0 or sim.reason != "全滅":
   149			return
   150		final_used = true
   151		if _fx_on("slowmo"):
   152			final_left = 0.6
   153		if _fx_on("shake"):
   154			shake = maxf(shake, 0.15)
