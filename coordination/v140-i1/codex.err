   118	func trial_rem(i: int) -> int:
   119		var x := trial_x(i)
   120		return int(x["rem"]) if x.has("rem") else int(TRIAL_REM[int(TRIALS[i][3])])
   121	
   122	func trial_name(i: int) -> String:
   123		var x := trial_x(i)
   124		if x.has("zh"):
   125			return L.field(x, "")
   126		return L.t("map_" + str(MapDefs.MAPS[TRIALS[i][0]]["key"]))
   127	
   128	## 第十二輪：每達成一項一顆星，和殘局同一套。原本要花 ≤80% 預算還要剩「整個預算」的 50%，電腦都找不到解。
   129	const TRIAL_REM := [0, 30, 20]     # 剩餘戰力門檻（依難度，索引同 AI 等級）
   130	const TRIAL_SPEND_PCT := 80
   131	const TRIAL_SPEND_OVERRIDE := {7: 85}   # 第 8 關：80% 搜尋 13 組種子都到不了，最好是 23% 剩餘花 81%
   132	
   133	static func trial_spend_pct(id: int) -> int:
   134		var x := trial_x(id)
   135		if x.has("spend"):
   136			return int(x["spend"])
   137		return int(TRIAL_SPEND_OVERRIDE.get(id, TRIAL_SPEND_PCT))
   138	
   139	static func trial_stars(level: int, rem: int, spent: int, budget: int, spend_pct: int = TRIAL_SPEND_PCT, need_rem: int = -1) -> int:
   140		var st := 1
   141		if rem >= (int(TRIAL_REM[level]) if need_rem < 0 else need_rem):
   142			st += 1
   143		if spent * 100 <= budget * spend_pct:
   144			st += 1
   145		return st
   146	
   147	func _trial_finish(w: int) -> void:
   148		if trial_id >= 0:
   149			Save.note_try("trial", str(trial_id), w == 0, armies[0].spent())   # V1.1 F2
   150		if trial_id < 0 or w != 0:
   151			return
   152		var lvl: int = int(TRIALS[trial_id][3])
   153		var rem: int = PZ.rem_pct(sim.power(0), sim.budget_of(0))
   154		var spent: int = armies[0].spent()
   155		var pct: int = trial_spend_pct(trial_id)
   156		var st: int = trial_stars(lvl, rem, spent, armies[0].budget, pct, trial_rem(trial_id))
   157		report["trial_lines"] = call("_star_lines", true, rem, trial_rem(trial_id), spent, armies[0].budget * pct / 100)
   158		var all: Dictionary = Save.data.get("trial_stars", {})
   159		all[str(trial_id)] = maxi(int(all.get(str(trial_id), 0)), st)
   160		Save.data["trial_stars"] = all
   161		report["trial_stars"] = st
   162		var full := 0
   163		for k in TRIALS.size():
   164			full += 1 if int(all.get(str(k), 0)) >= 3 else 0
   165		if full >= TRIALS.size():
   166			call("_ach", "TRIAL_ALL3")   # 第十三輪
   167		Save.save_data()
   168	
   169	var trial_page := 0
   170	
