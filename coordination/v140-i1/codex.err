   156	## 畫面前進一個 tick：模擬保持領先 DELAY 個 tick，畫面播最舊的那一份快照（R5 展示緩衝）。
   157	func _sim_step(with_fx: bool) -> void:
   158		_pump_view()
   159		_check_final(with_fx)
   160		for u in view.units:
   161			prev_pos[u.id] = Vector2(u.x, u.y)
   162		if not view.advance():
   163			view.finished = true
   164			return
   165		if tm_ghost != null:
   166			call("_tm_sync")
   167		_gait_tick(with_fx)
   168		_pump_view()
   169		_check_clutch(with_fx)   # 每一個畫面 tick 都判定（原本每一幀判一次，觸發的 tick 會跟幀率有關）
   170		if view.frenzy and not frenzy_seen:
   171			frenzy_seen = true
   172			if with_fx:
   173				_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
   174				sfx.play("frenzy")
   175				sfx.play_music("music_frenzy")
   176		var deaths := 0
   177		for ev in view.events:
   178			var k: String = ev["kind"]
   179			if ev.has("src"):
   180				var s = view.unit_by_id(ev["src"])
   181				var key := "%s%d" % [k, s.team]
   182				ev_count[key] = int(ev_count.get(key, 0)) + 1
   183				if k == EV.BLAST and not ev.has("dmg"):   # 第八輪：爆炸演出一筆一次；逐目標傷害不算次數（BOOM_5）
   184					ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
   185			if k == EV.DEATH:
