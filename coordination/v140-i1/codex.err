    66				n += 1
    67		return n
    68	
    69	func in_zone(col: int, row: int) -> bool:
    70		if row < 0 or row >= ROWS:
    71			return false
    72		if team == 0:
    73			return col >= 0 and col < ZONE
    74		return col >= COLS - ZONE and col < COLS
    75	
    76	func index_at(col: int, row: int) -> int:
    77		for i in units.size():
    78			if units[i]["col"] == col and units[i]["row"] == row:
    79				return i
    80		return -1
    81	
    82	## 回傳空字串＝可以放；否則是不能放的原因（顯示給玩家）。
    83	func check_place(t: int, col: int, row: int) -> String:
    84		if deploy == "free":
    85			return check_place_xy(t, col * 1000 + 500, row * 1000 + 500)
    86		if not in_zone(col, row):
    87			return E_ZONE
    88		if index_at(col, row) != -1:
    89			return E_TAKEN
    90		if terrain != null and terrain.blocked(col * 1000 + 500, row * 1000 + 500, team):
    91			return E_TERRAIN   # 第十三輪：地形殘局（格子放在地圖上），牆內格子不能放
    92		return _check_common(t)
    93	
    94	## 位置以外的條件（卡池、人數、單種、錢、防卡死），格子與自由共用。
    95	func _check_common(t: int) -> String:
    96		if t < 0 or t >= D.total() or (pool >> t) & 1 == 0:
    97			return E_POOL
    98		if count() >= unit_cap:
    99			return E_CAP_PREFIX + " %d 隻" % unit_cap
   100		if type_cap > 0 and count_of(t) >= type_cap:
   101			return E_TYPE_CAP_PREFIX + " %d 隻" % type_cap
   102		var hc := D.hard_cap(t)     # 第八輪：奇幻兵一隊的硬上限
   103		if hc > 0 and count_of(t) >= hc:
   104			return E_TYPE_CAP_PREFIX + " %d 隻" % hc
   105		if D.cost(t) > left():
    65		if call("_seek_pump"):
    66			return
    67		if skip_busy:
    68			_skip_step()
    69			return
    70		if paused:
    71			return
    72		if hitstop > 0:
    73			hitstop -= delta
    74			return
    75		var rate := speed
    76		if slow_left > 0:
    77			rate *= 0.5
    78			slow_left -= delta
    79		if final_left > 0:
    80			rate *= 0.25      # 第十輪 F1：最後一擊
    81			final_left -= delta
    82			_update_action_focus()
    83		accum += delta * rate
    84		while accum >= 0.05 and not view.finished:
    85			accum -= 0.05
    86			var was_slow := slow_left > 0 or final_left > 0
    87			_sim_step(true)
    88			if (slow_left > 0 or final_left > 0) and not was_slow:
    89				break   # 這一 tick 觸發慢動作：剩下的累積留到下一幀用慢速消耗（Codex S8 #3）
