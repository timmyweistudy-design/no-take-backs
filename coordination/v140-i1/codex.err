   229	## ── 挑戰碼：把自己的陣型傳給朋友打（不需要伺服器）──
   230	func _challenge_encode() -> String:
   231		var r = rules if rules != null else RuleSet.standard()
   232		var j := JSON.stringify({"a": last_armies[0].to_code(), "r": r.to_code()})
   233		var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
   234		return "NTC1.%s.%s" % [b, b.sha256_text().substr(0, 6)]
   235	
   236	func _copy_challenge() -> void:
   237		DisplayServer.clipboard_set(_challenge_encode())
   238		_toast(L.t("ch_copied"))
   239	
   240	func _accept_challenge(c := "") -> void:
   241		var from_clip := c == ""
   242		if from_clip:
   243			c = DisplayServer.clipboard_get().strip_edges()
   244		var d := _challenge_decode(c.strip_edges())
   245		if not d["ok"]:
   246			if not (from_clip and _ask_code(L.t("ch_accept"), _accept_challenge)):
   247				_toast(L.t("ch_bad"), true)
   248			return
   249		rules = d["rules"]
   250		challenge_army = d["army"]
   251		daily_spec = {}
   252		rules.rounds = 1
   253		_start_mode(Mode.VS_AI)
   254	
   255	## 回傳 {ok, rules, army}。陣型一定要照那組規則合法。
   256	func _challenge_decode(c: String) -> Dictionary:
   257		var bad := {"ok": false}
   258		var parts := c.split(".")
   259		if c.length() > 6000 or parts.size() != 3 or parts[0] != "NTC1" or parts[1].sha256_text().substr(0, 6) != parts[2]:
   260			return bad
   261		var b64 := parts[1].replace("-", "+").replace("_", "/")
   262		while b64.length() % 4 != 0:
   263			b64 += "="
   264		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
   265		if not j is Dictionary or not j.get("a") is String or not j.get("r") is String:
   266			return bad
   267		var rd: Dictionary = RuleSet.from_code(str(j["r"]))
   268		if not rd["ok"] or rd["rules"].fullfield != RuleSet.FULL_NONE:
   269			return bad      # 全場規則是雙方互相看得到才成立，不能當挑戰碼（Codex r2 #3）
   270		var r = rd["rules"]
   271		r.ai_pool_same = false
   272		# 碼是對方當藍軍排的，到這裡他變紅軍：兩邊的預算、卡池要對調（讓子局才有差，Codex #10）
   273		var b0: int = r.budget_of(0)
   274		var b1: int = r.budget_of(1)
   275		var p0: int = r.pool_of(0)
   276		var p1: int = r.pool_of(1)
   277		r.budget = [b1, b0]
   278		r.pool = [p1, p0]
   279		r.cmd_mask = [int(r.cmd_mask[1]), int(r.cmd_mask[0])]   # 第十二輪：手動技能也要對調
   280		var a = Army.new(1, r.budget_of(1))
   281		a.apply_rules(r, 1)
   282		a.pool = RuleSet.full_pool()     # 朋友的牌不必在自己的解鎖範圍內
   283		if a.load_code(str(j["a"])) != "" or not a.has_combat():
   284			return bad
   285		if _demo() and not _demo_ok(r, a):
   286			return bad      # 第十輪 B7：試玩版不能靠挑戰碼帶進正式版內容
   287		return {"ok": true, "rules": r, "army": a}
   288	
   289	## 第十輪 R1：試玩版的範圍集中在這裡。匯入的規則與陣型都走這條。
   290	func _demo_ok(r, a = null) -> bool:
   291		var mask: int = RS.mask(true)
   292		if r != null:
   293			if not r.map_id in Presets.DEMO_MAPS:
   294				return false
   295			if r.pool_of(0) & ~mask != 0 or r.pool_of(1) & ~mask != 0:
   296				return false
   297		if a != null:
   298			for u in a.units:
   299				if not RuleSet.has(mask, int(u["type"])):
   300					return false
   301		return true
   302	
