   446	## 改了什麼（給畫面顯示）：例如「弓箭手 → 劍士（第 3 列第 5 欄）」
   447	func review_desc() -> String:
   448		if rv_orig.deploy == "free":
   449			for u in rv_orig.units:
   450				var e := int(u.get("eid", -1))
   451				var now = null
   452				for v in rv_army.units:
   453					if int(v.get("eid", -2)) == e:
   454						now = v
   455				if now == null:
   456					return L.t("rv_f_removed", [L.t("unit_%d" % int(u["type"]))])
   457				if int(now["type"]) != int(u["type"]):
   458					return L.t("rv_f_swapped", [L.t("unit_%d" % int(u["type"])), L.t("unit_%d" % int(now["type"]))])
   459				if int(now["x"]) != int(u["x"]) or int(now["y"]) != int(u["y"]):
   460					return L.t("rv_f_moved", [L.t("unit_%d" % int(u["type"])), Vector2(int(now["x"]) - int(u["x"]), int(now["y"]) - int(u["y"])).length() / 1000.0])
   461			return ""
   462		for u in rv_orig.units:
   463			var i: int = rv_army.index_at(u["col"], u["row"])
   464			if i == -1:
   465				# 被移走或拿掉
   466				for v in rv_army.units:
   467					if rv_orig.index_at(v["col"], v["row"]) == -1 and int(v["type"]) == int(u["type"]):
   468						return L.t("rv_moved", [L.t("unit_%d" % int(u["type"])), int(u["row"]) + 1, int(u["col"]) + 1, int(v["row"]) + 1, int(v["col"]) + 1])
   469				return L.t("rv_removed", [L.t("unit_%d" % int(u["type"])), int(u["row"]) + 1, int(u["col"]) + 1])
   470			if int(rv_army.units[i]["type"]) != int(u["type"]):
   471				return L.t("rv_swapped", [L.t("unit_%d" % int(u["type"])), L.t("unit_%d" % int(rv_army.units[i]["type"])), int(u["row"]) + 1, int(u["col"]) + 1])
   472		for v in rv_army.units:
   473			if rv_orig.index_at(v["col"], v["row"]) == -1:
   474				return L.t("rv_added", [L.t("unit_%d" % int(v["type"])), int(v["row"]) + 1, int(v["col"]) + 1])
   475		return ""
