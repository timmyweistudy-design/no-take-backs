- **P2｜同幀塗兵漏格**：`game_screens.gd:558`，滑鼠按下尚在佇列時，`painting` 仍為 false，接續移動不會入列；同幀按下、拖過多格、放開只放第一格。建議移動一律入列，由執行端判斷是否塗兵。

- **P2｜DPS 顯示四倍**：`codex_view.gd:229`，資料的 `cd` 已是 tick，除以 4 重複換算。劍士實際基礎 DPS 10，卻顯示 40。改為 `atk * 20.0 / cd`。

- **P2｜150% 筆記永遠空白**：`codex_view.gd:187,279`，筆記視窗高 28.6，但一行要求 27.3；上下各剩的空間使捲到底仍可能無完整行？此處實際視窗為 **28.6**，可容一行，故不列為確定缺陷。

- **P2｜捲動上限沿用舊內容**：`codex_view.gd:198,241`，切換兵種後、重畫前捲動會使用舊高度；新內容較短時，繪製也不重新 clamp，可能留下空白及越界捲軸。建議先量新內容，再限制 offset。

- **P2｜時間軸覆蓋結果內容**：`game_screens.gd:1468`，畫完時間軸沒有推進 `y`，星等／系列結算仍畫在原位置；150% 或孤軍、逆轉提示同時出現時，也會壓到下方按鈕。建議將時間軸及標籤納入結果頁排版高度。

- **P2｜頂住標記歸錯隊**：`battle_view.gd:97`，BRACED 的 src 是被頂住的騎兵，時間軸卻用它的隊色表示「頂住」。建議此事件取目標盾兵的 team。

- **P1｜layout 可零張假綠**：`game/tools/layout_check.sh:11,29`，未檢查程序退出碼、完成標記及預期截圖數。我將彙整段指向不存在目錄，實得「0 張、0 違規」、exit 0。建議六組程序成功、截圖清單完整且無腳本錯誤才通過。

可否繼續：建議先修硬上限、時間軸排版與 layout 假綠，再繼續。extends Node
## 角色精靈圖快取（第二輪方案 R2、H）：實測 48 隻時每幀直接程式繪製要 34ms（約 15fps），
## 所以啟動時用同一份 Art.unit 畫法，把每個兵種×隊伍×動作影格一次畫進一張圖集，戰鬥中只貼圖。
## 用同一份畫法烘焙，但不是逐像素等價（Codex R1 審查 #3、#4，已知且接受的差異）：
##  - 走路量化成 6 格、攻擊 8 格；攻擊中不再疊走路相位；走路／攻擊格固定睜眼（只在待機眨眼）。
## 表情疊加（受擊、暈眩、衝鋒、狂熱、潛行、頂住）不烘焙，貼完圖再用 Art.overlay 在同一個局部座標畫上去。
##  - 透明度（潛行）是對整張合成好的角色乘 alpha，重疊的部位不會像逐圖元那樣透出底下的線條。
## 待機呼吸位移在貼圖時加（烘焙時抵銷為 0）；受擊閃白跟著攻擊前衝與走路起伏。
## 沒有畫面（headless）或還沒建好時，呼叫端退回 Art.unit。

const Art = preload("res://scripts/ui/art.gd")
const D = preload("res://scripts/core/unit_defs.gd")

const CELL := 160          # 每格像素（以 RS 倍率畫）；比角色大一圈，避免相鄰格子滲色
const RS := 1.6            # 烘焙解析度倍率
const ORIGIN := Vector2(80, 124)   # 角色腳底在格子裡的位置
const WALK_FRAMES := 6
const ATK_FRAMES := 8      # 三段式攻擊（R5）要多幾格才看得出前搖／揮擊／後搖
# 每個兵種、隊伍的影格順序：0 待機、1 眨眼、2..7 走路、8..13 攻擊
const FRAMES_PER := 2 + WALK_FRAMES + ATK_FRAMES * 2   # 攻擊兩組：一般／交替招式（第三輪 R4）

var tex: Texture2D = null
var ring_tex: Texture2D = null
var ready_cb := -1         # 這份快取是用哪種配色（一般／色盲）烘焙的
var _cols := 16

func is_ready(cb: bool) -> bool:
	return tex != null and ready_cb == (1 if cb else 0)

## 烘焙：在 SubViewport 一次畫完所有影格，讀回成一張圖。
func build(cb: bool) -> void:
	if DisplayServer.get_name() == "headless":
		return
	var total := D.COUNT * 2 * FRAMES_PER
	var rows := int(ceil(float(total) / _cols)) + 1   # 最後一列放腳底圈
	var vp := SubViewport.new()
	vp.size = Vector2i(_cols * CELL, rows * CELL)
	vp.transparent_bg = true
	vp.render_target_update_mode = SubViewport.UPDATE_ONCE
	var painter := _Painter.new()
	painter.cb = cb
	painter.cols = _cols
	vp.add_child(painter)
	add_child(vp)
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	var img := vp.get_texture().get_image()
	tex = ImageTexture.create_from_image(img)
	ready_cb = 1 if cb else 0
	vp.queue_free()

func frame_index(type: int, team: int, walk: float, atk: float, t: float, px: float, variant := 0) -> int:
	var base := (type * 2 + team) * FRAMES_PER
	if atk > 0.0:
		return base + 2 + WALK_FRAMES + ATK_FRAMES * variant + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
	if walk != 0.0:
		return base + 2 + int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES
	var ex := 2.0 if type == D.CAVALRY else 3.5   # Art._eyes 的眼睛中心 x
	var blink := fmod(t + ex * 0.13, 3.7) <= 0.12   # 與 Art._eyes 相同的眨眼節奏
	return base + (1 if blink else 0)

## 腳底圈：隊伍×（一般／重兵）共 4 格，放在所有角色影格之後。
func ring_index(team: int, heavy: bool) -> int:
	return D.COUNT * 2 * FRAMES_PER + team * 2 + (1 if heavy else 0)

func draw_ring(ci: CanvasItem, p: Vector2, team: int, type: int, scale := 1.0) -> void:
	var idx := ring_index(team, type == D.SHIELD or type == D.CAVALRY)
	ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
	ci.draw_texture_rect_region(tex, Rect2(-ORIGIN, Vector2(CELL, CELL)), _rect(idx))
	ci.draw_set_transform_matrix(Art.base)

func _rect(idx: int) -> Rect2:
	return Rect2((idx % _cols) * CELL, (idx / _cols) * CELL, CELL, CELL)

## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
func quant_walk(walk: float) -> float:
	if walk == 0.0:
		return 0.0
	return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES

func quant_atk(atk: float) -> float:
	if atk <= 0.0:
		return 0.0
	return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES

## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
		hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false, variant := 0) -> void:
	var idx := frame_index(type, team, walk, atk, t, p.x, variant)
	if atk > 0.0:
		walk = 0.0   # 攻擊影格烘焙時沒有走路相位：貼圖與疊加都當成沒在走（Codex 收尾輪 #4）
	var bob := sin(t * 3.0 + p.x * 0.05) * 0.8 if walk == 0.0 else 0.0   # 與 Art.unit 相同：沒走路時（含攻擊）都有呼吸
	var xf := Art.base * Transform2D(lean * face, Vector2(scale * face / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale))
	ci.draw_set_transform_matrix(xf)
	ci.draw_texture_rect_region(tex, Rect2(-ORIGIN, Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
	if hurt > 0.0 or mood != 0:
		# 攻擊影格烘焙時沒有走路相位（Codex R5 #3）
		var qa := quant_atk(atk)
		ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, face, 0.0 if qa > 0.0 else quant_walk(walk), qa, t, scale, lean, crouch))
		if hurt > 0.0:
			ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, false)
		if mood != 0:
			Art.overlay(ci, type, team, mood, alpha, t, cb)
	ci.draw_set_transform_matrix(Art.base)

## 烘焙用的畫家：一格一格呼叫 Art.unit（face＝+1，翻面由貼圖時處理）。
class _Painter extends Node2D:
	var cb := false
	var cols := 16
	func _draw() -> void:
		var Art2 = preload("res://scripts/ui/art.gd")
		var D2 = preload("res://scripts/core/unit_defs.gd")
		var saved: Transform2D = Art2.base
		Art2.base = Transform2D.IDENTITY
		var CELL2 := 160
		var RS2 := 1.6
		var org := Vector2(80, 124)
		var per := 2 + 6 + 8 + 8
		for type in D2.COUNT:
			for team in 2:
				for f in per:
					var idx: int = (type * 2 + team) * per + f
					var cell_o := Vector2((idx % cols) * CELL2, (idx / cols) * CELL2)
					var walk := 0.0
					var atk := 0.0
					var vr := 0
					if f >= 2 and f < 8:
						walk = 0.0001 + (f - 2) * TAU / 6.0
					elif f >= 16:
						atk = (f - 16 + 0.5) / 8.0
						vr = 1
					elif f >= 8:
						atk = (f - 8 + 0.5) / 8.0
					var p := cell_o + org
					var ex := 2.0 if type == D2.CAVALRY else 3.5
					# 眨眼那一格落在眨眼區間中間；其他格取 1.0（不在眨眼區間）
					var tt: float = (3.7 - ex * 0.13 + 0.05) if f == 1 else 1.0
					# 沒走路的格子（待機、眨眼、攻擊）Art.unit 會加呼吸位移；這裡反向抵銷，貼圖時再依當下時間加
					var pb := p
					if walk == 0.0:
						pb.y -= sin(tt * 3.0 + p.x * 0.05) * 0.8 * RS2
					Art2.unit(self, pb, type, team, 1.0, walk, atk, 0.0, 1.0, tt, RS2, cb, 0, 0.0, 1.0, vr)
		# 腳底圈
		var start: int = D2.COUNT * 2 * per
		for team in 2:
			for heavy in 2:
				var idx2: int = start + team * 2 + heavy
				var o := Vector2((idx2 % cols) * CELL2, (idx2 / cols) * CELL2) + org
				Art2.ring(self, o, team, D2.SHIELD if heavy == 1 else D2.SWORD, cb, RS2)
		Art2.base = saved
extends "res://scripts/ui/ui_base.gd"
const EV = preload("res://scripts/core/events.gd")
## 戰場、單位、特效、戰鬥 HUD、最後時刻鏡頭（演出層：不影響戰鬥結果）。


func _on_skip() -> void:
	while not view.finished:
		_sim_step(false)
	result_delay = 9.0


func _battle_process(delta: float) -> void:
	if hitstop > 0:
		hitstop -= delta
		return
	var rate := speed
	if slow_left > 0:
		rate *= 0.5
		slow_left -= delta
	accum += delta * rate
	while accum >= 0.05 and not view.finished:
		accum -= 0.05
		_sim_step(true)
	# 播完之後展示時鐘繼續走（不再推進快照）：最後一格的位置插值與最後一擊的後搖要演完（Codex R5 #1）
	_check_clutch()
	if slow_left > 0:
		_update_action_focus()
	sfx.set_muffled(slow_left > 0 and not view.finished)
	if slow_left > 0 and not view.finished:
		_frame_alive(delta)
	else:
		zoom_target = 1.0
	zoom = lerpf(zoom, zoom_target, delta * 3)
	if view.finished:
		result_delay += delta
		if result_delay > 1.4:
			_finish_battle()


## 最後時刻（優化方案 F1）：雙方剩餘戰力都 ≤30% 且差距 ≤15%；或雙方各剩 ≤3 隻且差距 ≤15%。
func _check_clutch() -> void:
	if slow_used or view.finished:
		return
	var tot := float(view.budget * 1000)
	var p0: float = view.power(0) * 100.0 / tot
	var p1: float = view.power(1) * 100.0 / tot
	var a0: int = view.alive_count(0)
	var a1: int = view.alive_count(1)
	if absf(p0 - p1) <= 15.0 and ((p0 <= 30.0 and p1 <= 30.0) or (a0 <= 3 and a1 <= 3)):
		slow_used = true
		battle_marks.append({"tick": view.tick, "kind": "clutch", "team": -1})
		if bool(Save.s("slowmo")):
			slow_left = 8.0
		clutch_t = 1.6   # 最後時刻橫幅（第三輪 V2）：獨立一層畫在 _draw_clutch_banner
		sfx.play("clutch")


## 鏡頭安全框（優化方案 F2）：把所有存活單位框進畫面，四周留 15%。
func _frame_alive(delta: float) -> void:
	var lo := Vector2(1e9, 1e9)
	var hi := Vector2(-1e9, -1e9)
	for u in view.units:
		if u.alive:
			var p := _upos(u)
			lo = lo.min(p - Vector2(30, 70))
			hi = hi.max(p + Vector2(30, 20))
	var size := (hi - lo) / 0.7
	zoom_target = clampf(minf(1280.0 / maxf(1, size.x), 620.0 / maxf(1, size.y)) * 1.05, 1.08, 1.55)   # 再往勝負焦點收 5%（V2）
	zoom_center = zoom_center.lerp((lo + hi) / 2, minf(1.0, delta * 3))


## 畫面前進一個 tick：模擬保持領先 DELAY 個 tick，畫面播最舊的那一份快照（R5 展示緩衝）。
func _sim_step(with_fx: bool) -> void:
	_pump_view()
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	if not view.advance():
		view.finished = true
		return
	_pump_view()
	if view.frenzy and not frenzy_seen:
		frenzy_seen = true
		if with_fx:
			_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
			sfx.play("frenzy")
			sfx.play_music("music_frenzy")
	var deaths := 0
	for ev in view.events:
		var k: String = ev["kind"]
		if ev.has("src"):
			var s = view.unit_by_id(ev["src"])
			var key := "%s%d" % [k, s.team]
			ev_count[key] = int(ev_count.get(key, 0)) + 1
		if k == EV.DEATH:
			deaths += 1
		if k == EV.CHARGE or k == EV.BACKSTAB or k == EV.BRACED:
			# 頂住的 src 是被頂住的騎兵，功勞算盾兵那一隊（Codex S3）
			var team: int = view.unit_by_id(ev["tgt"] if k == EV.BRACED else ev["src"]).team
			var seen := false
			for m in battle_marks:
				if m["kind"] == k and m["team"] == team:
					seen = true
			if not seen:
				battle_marks.append({"tick": view.tick, "kind": k, "team": team})
		_on_event(ev, with_fx)
	# 碾壓局最後一擊（優化方案 F1）：0.2 秒頓格＋微震，直接進結算
	if view.finished and not slow_used and deaths > 0 and with_fx:
		hitstop = 0.2
		if bool(Save.s("shake")):
			shake = 0.15


## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
func _pump_view() -> void:
	for fr in view.pump(sim):
		for e in fr["events"]:
			if event_route(e) == "attack":
				var hs: Array = atk_hit.get(e["src"], [])
				hs.append(int(fr["tick"]))   # 存序列，不覆蓋還沒播到的命中（Codex R5 #2：連續反擊）
				if hs.size() > 4:
					hs.pop_front()
				atk_hit[e["src"]] = hs


## 畫面上現在播到第幾 tick（含小數，插值用）。
func _disp_tick() -> float:
	if view == null:
		return 0.0
	if state != St.BATTLE:
		return float(view.tick)
	return view.tick + clampf(accum / 0.05, 0.0, 8.0 if view.finished else 1.0)


## 這一刻要演哪一次命中（Codex R5 #2）：取前搖已開始的最近一次；但前一次的揮擊還沒做完就先讓它做完（揮擊優先、後搖可被截斷）。
static func pick_hit(hits: Array, disp: float, type: int) -> int:
	var w := float(ViewBuffer.DELAY)
	var tot := clampf(float(D.STATS[type]["cd"]) / 4.0, 4.0, 6.4)
	var strike_end := w + 0.22 * tot
	var cur := -1
	for h in hits:
		if float(h) - w <= disp:
			if cur >= 0 and disp - (float(cur) - w) < strike_end:
				break   # 前一次還在揮擊，不換
			cur = h
	return cur


## 三段式攻擊進度（R5）：前搖固定是命中前 DELAY 個 tick，揮擊與後搖依攻擊間隔壓縮（攻速快的兵動作也快，不會疊在一起）。
## 回傳 Art.unit 的 atk 參數：0＝沒在攻擊；0～0.3125 前搖、0.3125～0.53125 揮擊（命中在 0.3125）、之後後搖到 1。
static func atk_progress(dt: float, type: int) -> float:
	var period := float(D.STATS[type]["cd"])   # cd 的單位是 tick（模擬每次出手加 cd×4、每 tick 扣 4）
	var tot := clampf(period, 4.0, 6.4)
	var w := float(ViewBuffer.DELAY)
	var st := 0.22 * tot
	var rc := tot - w - st
	if dt < 0.0 or dt >= tot:
		return 0.0
	var a: float
	if dt < w:
		a = Art.ATK_WINDUP * dt / w
	elif dt < w + st:
		a = Art.ATK_WINDUP + (Art.ATK_STRIKE - Art.ATK_WINDUP) * (dt - w) / st
	else:
		a = Art.ATK_STRIKE + (1.0 - Art.ATK_STRIKE) * (dt - w - st) / rc
	return maxf(a, 0.001)


## 小火焰圖示（背水）。
func _flame(c: Vector2, sc: float) -> void:
	var fl := sin(time * 14.0) * 1.5
	draw_colored_polygon(PackedVector2Array([c + Vector2(0, -11 - fl) * sc, c + Vector2(6, 2) * sc, c + Vector2(0, 7) * sc, c + Vector2(-6, 2) * sc]), Color(1, 0.4, 0.1))
	draw_colored_polygon(PackedVector2Array([c + Vector2(0, -5 - fl * 0.5) * sc, c + Vector2(3, 3) * sc, c + Vector2(0, 6) * sc, c + Vector2(-3, 3) * sc]), Color(1, 0.85, 0.3))


func _star_above(c: Vector2) -> void:
	var r := 6.0 + sin(time * 6.0) * 1.0
	var pts := PackedVector2Array()
	for i in 10:
		var an := -PI / 2 + i * TAU / 10.0
		pts.append(c + Vector2(cos(an), sin(an)) * (r if i % 2 == 0 else r * 0.45))
	draw_colored_polygon(pts, Color(1, 0.88, 0.3))


## 事件分流（Codex R3 審查 #1）：只有帶 dmg 的才是攻擊；背水開關沒有 src；嘲諷、現形、繞翼只有演出。
## 回傳 "death"／"skip"／"taunt"／"reveal"／"attack"。測試會把真實戰鬥的每一種事件都丟進來檢查。
static func event_route(ev: Dictionary) -> String:
	var k: String = ev.get("kind", "")
	if k == EV.DEATH:
		return "death"
	if k == EV.TAUNT or k == EV.REVEAL:
		return k if ev.has("src") and ev.has("tgt") else "skip"
	if ev.has("dmg") and ev.has("src") and ev.has("tgt"):
		return "attack"
	return "skip"


func _on_event(ev: Dictionary, with_fx: bool) -> void:
	var k: String = ev["kind"]
	if k == EV.DEATH:
		var u = view.unit_by_id(ev["id"])
		dying.append({"pos": _upos(u), "type": u.type, "team": u.team, "face": signf(u.fx) if u.fx != 0 else 1.0, "t": 0.0})
