    11	func _battle_process(delta: float) -> void:
    12		if hitstop > 0:
    13			hitstop -= delta
    14			return
    15		var rate := speed
    16		if slow_left > 0:
    17			rate *= 0.5
    18			slow_left -= delta
    19		accum += delta * rate
    20		while accum >= 0.05 and not view.finished:
    21			accum -= 0.05
    22			_sim_step(true)
    23		# 播完之後展示時鐘繼續走（不再推進快照）：最後一格的位置插值與最後一擊的後搖要演完（Codex R5 #1）
    24		_check_clutch()
    25		sfx.set_muffled(slow_left > 0 and not view.finished)
    26		if slow_left > 0 and not view.finished:
    27			_frame_alive(delta)
    28		else:
    29			zoom_target = 1.0
    30		zoom = lerpf(zoom, zoom_target, delta * 3)
    31		if view.finished:
    32			result_delay += delta
    33			if result_delay > 1.4:
    34				_finish_battle()
