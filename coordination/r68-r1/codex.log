   104	## 烘焙用的畫家：一格一格呼叫 Art.unit（face＝+1，翻面由貼圖時處理）。
   105	class _Painter extends Node2D:
   106		var cb := false
   107		var cols := 16
   108		func _draw() -> void:
   109			var Art2 = preload("res://scripts/ui/art.gd")
   110			var D2 = preload("res://scripts/core/unit_defs.gd")
   111			var saved: Transform2D = Art2.base
   112			Art2.base = Transform2D.IDENTITY
   113			var CELL2 := 160
   114			var RS2 := 1.6
   115			var org := Vector2(80, 124)
   116			var per := 2 + 6 + 8
   117			for type in D2.COUNT:
   118				for team in 2:
   119					for f in per:
   120						var idx: int = (type * 2 + team) * per + f
   121						var cell_o := Vector2((idx % cols) * CELL2, (idx / cols) * CELL2)
   122						var walk := 0.0
   123						var atk := 0.0
   124						if f >= 2 and f < 8:
   125							walk = 0.0001 + (f - 2) * TAU / 6.0
   126						elif f >= 8:
   127							atk = (f - 8 + 0.5) / 8.0
   128						var p := cell_o + org
   129						var ex := 2.0 if type == D2.CAVALRY else 3.5
   130						# 眨眼那一格落在眨眼區間中間；其他格取 1.0（不在眨眼區間）
   131						var tt: float = (3.7 - ex * 0.13 + 0.05) if f == 1 else 1.0
   132						# 沒走路的格子（待機、眨眼、攻擊）Art.unit 會加呼吸位移；這裡反向抵銷，貼圖時再依當下時間加
   133						var pb := p
   134						if walk == 0.0:
   135							pb.y -= sin(tt * 3.0 + p.x * 0.05) * 0.8 * RS2
   136						Art2.unit(self, pb, type, team, 1.0, walk, atk, 0.0, 1.0, tt, RS2, cb)
   137			# 腳底圈
   138			var start: int = D2.COUNT * 2 * per
   139			for team in 2:
   140				for heavy in 2:
   141					var idx2: int = start + team * 2 + heavy
   142					var o := Vector2((idx2 % cols) * CELL2, (idx2 / cols) * CELL2) + org
   143					Art2.ring(self, o, team, D2.SHIELD if heavy == 1 else D2.SWORD, cb, RS2)
   144			Art2.base = saved
