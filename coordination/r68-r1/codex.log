   468	
   469	func _err_key(why: String) -> String:
   470		if why == "":
   471			return ""
   472		if why.begins_with("只能放"):
   473			return L.t("err_zone")
   474		if why.begins_with("這格"):
   475			return L.t("err_taken")
   476		if why.begins_with("最多"):
   477			return L.t("err_max", [Army.MAX_UNITS])
   478		if why.begins_with("錢不夠"):
   479			return L.t("err_gold")
   480		if why.begins_with("這一手"):
   481			return L.t("err_hand", [tp.hand_cap() if tp else 10])
   482		return why
