    25	func _ready() -> void:
    26		for n in FILES:
    27			var st = load("res://audio/%s.wav" % n)
    28			if st:
    29				streams[n] = st
    30		for i in 12:
    31			var p := AudioStreamPlayer.new()
    32			add_child(p)
    33			players.append(p)
    34		music = AudioStreamPlayer.new()
    35		add_child(music)
    36		music.finished.connect(func(): music.play())
    37		var lp := AudioEffectLowPassFilter.new()
    38		lp.cutoff_hz = 900.0
    39		AudioServer.add_bus_effect(0, lp)
    40		_lowpass_idx = AudioServer.get_bus_effect_count(0) - 1
    41		AudioServer.set_bus_effect_enabled(0, _lowpass_idx, false)
