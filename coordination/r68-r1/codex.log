   456	func _check_place(t: int, c: Vector2i) -> String:
   457		if _locked():
   458			return L.t("both_done")
   459		if not _allowed(t):
   460			return L.t("err_type")
   461		if mode == Mode.DUEL and tp != null:
   462			var why: String = tp.check_place(t, c.x, c.y)
   463			return _err_key(why)
   464		if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() + 1 > gauntlet_changes:
   465			return L.t("err_changes")
   466		return _err_key(_cur_army().check_place(t, c.x, c.y))
