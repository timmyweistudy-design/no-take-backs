     2	## 音效與音樂（優化方案 H）：同類音效 80ms 內最多 2 個、音高 ±10% 隨機；音樂與音效分軌。
     3	## 優先權（第二輪方案 R8）：12 個聲道滿的時候，關鍵音（技能、死亡、最後時刻）會搶走優先權最低、播最久的普通命中音，
     4	## 不會被一堆砍擊聲擠掉。最後時刻慢動作時整體加低通濾波（悶住的心跳感）。
     5	
     6	const FILES := ["arrow", "backstab", "block", "brace", "charge", "clutch", "death", "frenzy", "hit", "lose",
     7		"place_heavy", "place_light", "place_mid", "slash", "start", "turn", "ui_click", "ui_deny", "win",
     8		"shatter", "bell", "bugle", "aircut", "alert", "snap", "taunt", "reveal"]
     9	# 0 普通命中、1 防禦、2 技能／死亡、3 全場事件與介面
    10	const PRIO := {"hit": 0, "slash": 0, "arrow": 0, "block": 1, "brace": 1, "alert": 1, "taunt": 1, "reveal": 1,
    11		"shatter": 2, "bell": 2, "bugle": 2, "aircut": 2, "snap": 2, "charge": 2, "backstab": 2, "death": 2,
    12		"clutch": 3, "frenzy": 3, "start": 3, "win": 3, "lose": 3, "turn": 3, "ui_click": 3, "ui_deny": 3}
    13	var _prio_of := {}       # 聲道 → 正在播的優先權
    14	var _started := {}       # 聲道 → 開始時間
    15	var _lowpass_idx := -1
    16	var streams := {}
    17	var players: Array[AudioStreamPlayer] = []
    18	var recent := {}   # 名稱 → [時間戳...]
    19	var music: AudioStreamPlayer
    20	var music_name := ""
    21	var sfx_vol := 0.8
    22	var music_vol := 0.7
    23	var rng := RandomNumberGenerator.new()
