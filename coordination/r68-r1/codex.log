   485	## 遠征：跟上一戰的陣型比，新出現的「兵種＋格子」數（移動也算一次）。
   486	func _gauntlet_diff() -> int:
   487		if gauntlet_prev.is_empty():
   488			return 0
   489		var a := {}
   490		for u in gauntlet_prev:
   491			a["%d,%d,%d" % [u["type"], u["col"], u["row"]]] = true
   492		var d := 0
   493		for u in armies[0].units:
   494			if not a.has("%d,%d,%d" % [u["type"], u["col"], u["row"]]):
   495				d += 1
   496		return d
