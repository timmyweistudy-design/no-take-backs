   331	func _progress_and_achievements() -> void:
   332		var w: int = sim.winner
   333		var st: Dictionary = Save.data.get("stats", {"wins": 0, "games": 0})
   334		st["games"] = int(st.get("games", 0)) + 1
   335		var me_won := w == 0 or (mode == Mode.DUEL and w >= 0)
   336		if w == 0 and mode != Mode.DUEL:
   337			st["wins"] = int(st.get("wins", 0)) + 1
   338		Save.data["stats"] = st
   339		if me_won:
   340			_ach("FIRST_WIN")
   341			if sim.alive_count(w) == 1:
   342				_ach("LONE_HERO")
   343			if int(report["sus"]["max_swing_pct"]) >= 15:
   344				_ach("COMEBACK")
   345			if sim.power(w) * 100 / (sim.budget * 1000) <= 5:
   346				_ach("CLOSE_CALL")
   347			if sim.tick >= Sim.FRENZY_TICK:
   348				_ach("FRENZY_WIN")
   349			var types := {}
   350			for u in sim.units:
   351				if u.team == w:
   352					types[u.type] = true
   353			if types.size() == 5:
   354				_ach("ALL_TYPES")
   355			# 圖鑑老兵筆記：派這個兵種贏一場 +1（第二輪方案 R3）
   356			for t in CX.record_win(Save.data, types.keys()):
   357				ach_queue.append(L.t("codex_unlocked", [L.t("unit_%d" % t)]))
   358			if int(ev_count.get("charge%d" % w, 0)) >= 5:
   359				_ach("CHARGE_5")
   360			if int(ev_count.get("backstab%d" % w, 0)) >= 3:
   361				_ach("BACKSTAB_3")
   362		if mode == Mode.VS_AI and w == 0 and difficulty == 2:
   363			_ach("HARD_WIN")
   364		if mode == Mode.DUEL and tp != null and series_over:
   365			_ach("NO_TAKEBACKS")
   366		if series_over and ((mode == Mode.DUEL and (wins == [2, 0] or wins == [0, 2])) or (mode == Mode.VS_AI and wins == [2, 0])):
   367			_ach("SWEEP")
   368		if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
   369			var pz := PZ.get_puzzle(puzzle_id)
   370			var extra_spent: int = armies[0].spent() - (armies[0].budget - int(pz["budget"]))
   371			var rem: int = sim.power(0) * 100 / (sim.budget * 1000) if w == 0 else 0
   372			var stars := PZ.stars(pz, w == 0, rem, extra_spent)
   373			var ps: Dictionary = Save.data.get("puzzle_stars", {})
   374			if stars > int(ps.get(puzzle_id, 0)):
   375				ps[puzzle_id] = stars
   376			Save.data["puzzle_stars"] = ps
   377			report["stars"] = stars
   378			if mode == Mode.TUTORIAL and w == 0:
   379				var idx := 0
   380				for i in PZ.tutorials().size():
   381					if PZ.tutorials()[i]["id"] == puzzle_id:
   382						idx = i
   383				Save.data["tutorial"] = maxi(int(Save.data.get("tutorial", 0)), idx + 1)
   384				if int(Save.data["tutorial"]) >= PZ.tutorials().size():
   385					_ach("TUTORIAL")
   386			if stars == 3:
   387				_ach("PUZZLE_3STAR")
   388			var all_done := true
   389			for p in PZ.puzzles():
   390				if int(ps.get(p["id"], 0)) == 0:
   391					all_done = false
   392			if all_done:
   393				_ach("PUZZLE_ALL")
   394		if mode == Mode.GAUNTLET:
   395			if w == 0:
   396				if gauntlet_stage >= 7:
   397					_ach("GAUNTLET")
   398					Save.data["gauntlet_best"] = 7
   399			else:
   400				Save.data["gauntlet_best"] = maxi(int(Save.data.get("gauntlet_best", 0)), gauntlet_stage - 1)
   401		_save()
