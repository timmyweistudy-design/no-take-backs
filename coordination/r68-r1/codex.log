   100	## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
   101	func _pump_view() -> void:
   102		for fr in view.pump(sim):
   103			for e in fr["events"]:
   104				if event_route(e) == "attack":
   105					var hs: Array = atk_hit.get(e["src"], [])
   120	
   121	## 這一刻要演哪一次命中（Codex R5 #2）：取前搖已開始的最近一次；但前一次的揮擊還沒做完就先讓它做完（揮擊優先、後搖可被截斷）。
   122	static func pick_hit(hits: Array, disp: float, type: int) -> int:
   123		var w := float(ViewBuffer.DELAY)
   124		var tot := clampf(float(D.STATS[type]["cd"]) / 4.0, 4.0, 6.4)
   125		var strike_end := w + 0.22 * tot
   126		var cur := -1
   127		for h in hits:
   128			if float(h) - w <= disp:
   129				if cur >= 0 and disp - (float(cur) - w) < strike_end:
   130					break   # 前一次還在揮擊，不換
   131				cur = h
   132		return cur
   133	
   134	
   135	## 三段式攻擊進度（R5）：前搖固定是命中前 DELAY 個 tick，揮擊與後搖依攻擊間隔壓縮（攻速快的兵動作也快，不會疊在一起）。
   136	## 回傳 Art.unit 的 atk 參數：0＝沒在攻擊；0～0.3125 前搖、0.3125～0.53125 揮擊（命中在 0.3125）、之後後搖到 1。
   137	static func atk_progress(dt: float, type: int) -> float:
   138		var period := float(D.STATS[type]["cd"]) / 4.0
   139		var tot := clampf(period, 4.0, 6.4)
   140		var w := float(ViewBuffer.DELAY)
   141		var st := 0.22 * tot
   142		var rc := tot - w - st
   143		if dt < 0.0 or dt >= tot:
   144			return 0.0
   145		var a: float
   146		if dt < w:
   147			a = Art.ATK_WINDUP * dt / w
   148		elif dt < w + st:
   149			a = Art.ATK_WINDUP + (Art.ATK_STRIKE - Art.ATK_WINDUP) * (dt - w) / st
   150		else:
   151			a = Art.ATK_STRIKE + (1.0 - Art.ATK_STRIKE) * (dt - w - st) / rc
   152		return maxf(a, 0.001)
