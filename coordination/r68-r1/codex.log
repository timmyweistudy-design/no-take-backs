    75	## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
    76	func quant_walk(walk: float) -> float:
    77		if walk == 0.0:
    78			return 0.0
    79		return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES
    80	
    81	func quant_atk(atk: float) -> float:
    82		if atk <= 0.0:
    83			return 0.0
    84		return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES
    85	
    86	## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
    87	func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
    88			hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false) -> void:
    89		var idx := frame_index(type, team, walk, atk, t, p.x)
    90		var bob := sin(t * 3.0 + p.x * 0.05) * 0.8 if walk == 0.0 else 0.0   # 與 Art.unit 相同：沒走路時（含攻擊）都有呼吸
    91		var xf := Art.base * Transform2D(lean * face, Vector2(scale * face / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale))
    92		ci.draw_set_transform_matrix(xf)
    93		ci.draw_texture_rect_region(tex, Rect2(-ORIGIN, Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
    94		if hurt > 0.0 or mood != 0:
    95			# 攻擊影格烘焙時沒有走路相位（Codex R5 #3）
    96			var qa := quant_atk(atk)
    97			ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, face, 0.0 if qa > 0.0 else quant_walk(walk), qa, t, scale, lean, crouch))
    98			if hurt > 0.0:
    99				ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, false)
   100			if mood != 0:
   101				Art.overlay(ci, type, team, mood, alpha, t, cb)
   102		ci.draw_set_transform_matrix(Art.base)
