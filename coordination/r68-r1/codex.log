   220	## 先查離線反制庫（組成最接近的原型），查不到就用啟發式反制。不偷看你這一局。
   221	func _hard_ai(r: RandomNumberGenerator) -> Army:
   222		var known: Array = last_player_formation if round_no > 1 else []
   223		if not known.is_empty():
   224			var lib := _counter_lib()
   225			if not lib.is_empty():
   226				var mine := [0, 0, 0, 0, 0]
   227				for u in known:
   228					mine[u["type"]] += D.cost(u["type"])
   229				var best = null
   230				var bd := 1 << 30
   231				for e in lib:
   232					var d := 0
   233					for k in 5:
   234						d += absi(int(e["proto_comp"][k]) - mine[k])
   235					if d < bd:
   236						bd = d
   237						best = e
   238				if best != null and bd <= 40:
   239					var a := Army.new(1, 100)
   240					if a.load_code(best["code"]) == "":
   241						return a
   242		return AIT.build_full(1, r, 2, known)
