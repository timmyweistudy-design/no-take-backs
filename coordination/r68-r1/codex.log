    59	func set_volumes(sfx_pct: int, music_pct: int) -> void:
    60		sfx_vol = sfx_pct / 100.0
    61		music_vol = music_pct / 100.0
    62		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
    63	
    64	func play(name: String, vol := 1.0) -> void:
    65		if not streams.has(name) or sfx_vol <= 0.0:
    66			return
    67		var now := Time.get_ticks_msec()
    68		var r: Array = recent.get(name, [])
    69		r = r.filter(func(t): return now - t < 80)
    70		if r.size() >= 2:
    71			return
    72		r.append(now)
    73		recent[name] = r
    74		var pr: int = PRIO.get(name, 1)
    75		var busy: Array = []
    76		var prios: Array = []
    77		var starts: Array = []
    78		for i in players.size():
