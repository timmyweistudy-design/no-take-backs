    91	## 試玩紀錄（優化方案 F5、N3）：只在設定開啟時寫在本機 user://playtest_log.jsonl，不上傳。
    92	static func playtest_log(entry: Dictionary) -> void:
    93		if not bool(s("playtest")):
    94			return
    95		var path := "user://%splaytest_log.jsonl" % prefix
    96		var f := FileAccess.open(path, FileAccess.READ_WRITE if FileAccess.file_exists(path) else FileAccess.WRITE)
    97		if f == null:
    98			return
    99		f.seek_end()
   100		entry["time"] = Time.get_datetime_string_from_system()
   101		f.store_line(JSON.stringify(entry))
