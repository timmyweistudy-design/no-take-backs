   524	func _input(ev: InputEvent) -> void:
   525		if ev is InputEventMouseMotion:
   526			mouse = ev.position
   527			pad_mode = false
   528			hover_card = _card_at(mouse)
   529			if state == St.PLACE and overlay == "" and painting:
   530				if _cur_army().team != paint_team:
   531					painting = false
   532				else:
   533					var c := _cell_at(mouse)
   534					if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   535						_try_place(c)
   536			return
   537		if ev is InputEventMouseButton:
   538			_mouse_button(ev)
   539			return
   540		if ev is InputEventKey and ev.pressed:
   541			if not ev.echo or ev.keycode in [KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT]:
   542				_key(ev.keycode)
   543			return
   544		if ev is InputEventJoypadButton and ev.pressed:
   545			pad_mode = true
   546			var map := {JOY_BUTTON_DPAD_UP: KEY_UP, JOY_BUTTON_DPAD_DOWN: KEY_DOWN, JOY_BUTTON_DPAD_LEFT: KEY_LEFT,
   547				JOY_BUTTON_DPAD_RIGHT: KEY_RIGHT, JOY_BUTTON_A: KEY_ENTER, JOY_BUTTON_B: KEY_ESCAPE, JOY_BUTTON_X: KEY_BACKSPACE,
   548				JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_Y: KEY_TAB, JOY_BUTTON_LEFT_SHOULDER: KEY_Q, JOY_BUTTON_RIGHT_SHOULDER: KEY_E,
   549				JOY_BUTTON_BACK: KEY_F1}
   550			if map.has(ev.button_index):
   551				_key(map[ev.button_index])
   552			return
   553		if ev is InputEventJoypadMotion and absf(ev.axis_value) > 0.6 and (ev.axis == JOY_AXIS_LEFT_X or ev.axis == JOY_AXIS_LEFT_Y):
   554			pad_mode = true
   555			if ev.axis == JOY_AXIS_LEFT_X:
   556				_key(KEY_RIGHT if ev.axis_value > 0 else KEY_LEFT)
   557			else:
   558				_key(KEY_DOWN if ev.axis_value > 0 else KEY_UP)
   559	
   560	
   561	func _mouse_button(mb: InputEventMouseButton) -> void:
   562		mouse = mb.position
   563		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   564			_click_pending = mouse
   565		if overlay != "" or state != St.PLACE:
   566			if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
   567				drag_new = false
   568				painting = false
   569				drag_from = Vector2i(-1, -1)
   570			return
   571		var c := _cell_at(mouse)
   572		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   573			var k := _card_at(mouse)
   574			if k >= 0 and _card_help_rect(k).has_point(mouse):
   575				return   # 放開時由「?」按鈕處理
   576			if k >= 0:
   577				if _allowed(k):
   578					selected = k
   579					drag_new = true
   580					sfx.play("ui_click")
