    43	## 最後時刻：整體低通（慢動作開始時開、結束時關）。
    44	func set_muffled(on: bool) -> void:
    45		if _lowpass_idx >= 0 and AudioServer.is_bus_effect_enabled(0, _lowpass_idx) != on:
    46			AudioServer.set_bus_effect_enabled(0, _lowpass_idx, on)
    47	
    48	## 聲道選擇（純函式，測試用）：先找空的；滿了就搶優先權最低（同級取最早開始）且低於新音效的。沒有可搶的回 -1。
    49	static func pick_channel(busy: Array, prios: Array, starts: Array, prio: int) -> int:
    50		for i in busy.size():
    51			if not busy[i]:
    52				return i
    53		var best := -1
    54		for i in busy.size():
    55			if prios[i] < prio and (best < 0 or prios[i] < prios[best] or (prios[i] == prios[best] and starts[i] < starts[best])):
    56				best = i
    57		return best
