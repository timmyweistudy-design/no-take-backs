   135	static func _overlap(a: Rect2, b: Rect2) -> float:
   136		var x := a.intersection(b)
   137		if not x.has_area():
   138			return 0.0
   139		return x.get_area() / maxf(1.0, minf(a.get_area(), b.get_area()))
