   381	## 鍵盤：藍方 1 2 3（手把 LB、RB 送的是 Q、E），雙人紅方 8 9 0。是技能鍵就回 true。
   382	func _cmd_key(k: int) -> bool:
   383		if sim == null or not sim.cmd_on or play_kind != "official":
   384			return false
   385		var slot: int = {KEY_1: 0, KEY_2: 1, KEY_3: 2, KEY_Q: 0, KEY_E: 1}.get(k, -1)
   386		if slot >= 0:
   387			_cmd_press(0, slot)
   388			return true
   389		if mode == Mode.DUEL:
   390			var red: int = {KEY_8: 0, KEY_9: 1, KEY_0: 2}.get(k, -1)
   391			if red >= 0:
   392				_cmd_press(1, red)
   393				return true
   394		return false
