   649				col.a = 1.0 - k * k
   650				if f.get("screen", false):
   651					_text(f["p"] + Vector2(0, -k * 26), f["s"], ts(f["size"]), col, true, true)
   652				else:
   653					var p3: Vector2 = f.get("rp", f["p"] + Vector2(0, -k * 26))
   654					var r3: Rect2 = f.get("rr", Rect2(p3, Vector2.ZERO))
   655					var dim := _clutch_dim(p3)
   656					col.a *= dim
