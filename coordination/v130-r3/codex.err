   263			var k0 := (0.70 + ring * 0.06) * 1.25
   264			var k1 := k0 + 0.06 * 1.25
   265			var c0 := Color(0.20, 0.12, 0.0, strength * 0.14 * ring)
   266			var c1 := Color(0.20, 0.12, 0.0, strength * 0.14 * (ring + 1))
   267			for i in 32:
   268				var a0 := i * TAU / 32.0
   269				var a1 := (i + 1) * TAU / 32.0
   270				var d0 := Vector2(cos(a0) * rx, sin(a0) * ry)
   271				var d1 := Vector2(cos(a1) * rx, sin(a1) * ry)
   272				draw_primitive(PackedVector2Array([c + d0 * k0, c + d1 * k0, c + d1 * k1, c + d0 * k1]), PackedColorArray([c0, c0, c1, c1]), PackedVector2Array())
   273	
   274	
   275	
   276	func _add_fx(d: Dictionary) -> void:
   277		if bool(Save.s("reduce_fx")) and d["kind"] in ["dust", "puff", "shard", "chips", "tell", "bones", "coins", "ripple", "note", "hex", "aim", "trip", "spore", "wool", "soulrise"]:
   278			return   # 第七輪 K3：簡化特效少掉粒子與裝飾，保留攻擊本身與嘲諷
   279		var pr: int = FX_PRIO.get(d["kind"], 1)
   280		# 同一處同種特效去重（Antigravity S2 #2）：24px 內、0.15 秒內最多 2 個
   281		var dp = d.get("p", d.get("b", null))
   282		if dp != null and not d.has("src"):   # 帶攻擊者的（砍擊、箭）不去重：每一次攻擊都要有演出
   283			var same := 0
   284			for f0 in fx:
   285				if f0["kind"] == d["kind"] and f0["t"] < 0.15:
   286					var fp = f0.get("p", f0.get("b", null))
   287					if fp != null and fp.distance_to(dp) < 24.0:
   288						same += 1
   289			if same >= 2:
   290				fx_deduped += 1
   291				return
   292		var n := 0
   293		for f in fx:
   294			if f["kind"] != "text":
   295				n += 1
   296		if n >= FX_CAP:
   297			var victim := -1
   298			for k in fx.size():
   299				var f2: Dictionary = fx[k]
   300				if f2["kind"] == "text":
   301					continue
   302				var p2: int = FX_PRIO.get(f2["kind"], 1)
   303				if p2 < 2 and (victim < 0 or p2 < FX_PRIO.get(fx[victim]["kind"], 1) or (p2 == FX_PRIO.get(fx[victim]["kind"], 1) and f2["t"] > fx[victim]["t"])):
   304					victim = k
   305			if victim >= 0 and FX_PRIO.get(fx[victim]["kind"], 1) <= pr:
   306				fx.remove_at(victim)
   307				fx_dropped += 1
   308			elif pr < 2:
   309				fx_dropped += 1
   310				return
   311			else:
   312				# 全部都是關鍵特效：取代最舊的那個（硬上限，Codex S1 #5）
   313				var oldest := -1
   314				for k3 in fx.size():
   315					if fx[k3]["kind"] != "text" and (oldest < 0 or fx[k3]["t"] > fx[oldest]["t"]):
   316						oldest = k3
   317				fx.remove_at(oldest)
   318				fx_dropped += 1
   319		fx.append(d)
   320	
   321	
   322	
   323	## V1.2 C6：對話泡。r＝文字外框；尖角朝下指向角色。透明度跟著字淡出。
   324	func _bubble(r: Rect2, a: float) -> void:
   325		var rr := r.grow_individual(4, 1, 4, 2)
   326		var fill := Color(0.10, 0.07, 0.05, 0.82 * a)
   327		var edge := Color(0.95, 0.86, 0.66, 0.55 * a)
   328		var mid := rr.position.x + rr.size.x * 0.5
   329		var tail := PackedVector2Array([Vector2(mid - 5, rr.end.y - 1), Vector2(mid + 5, rr.end.y - 1), Vector2(mid - 1, rr.end.y + 7)])
   330		_box(rr, fill, edge, minf(10.0, rr.size.y * 0.5), 1.5)
   331		draw_colored_polygon(tail, fill)
   332		draw_polyline(PackedVector2Array([tail[0], tail[2], tail[1]]), edge, 1.5, true)
   333	
   334	func _fx_text(p: Vector2, s: String, c: Color, dur: float, size: int, screen := false) -> void:
   335		fx.append({"kind": "text", "p": p, "s": s, "c": c, "t": 0.0, "dur": dur, "size": size, "screen": screen})
   336	
   337	
   338	
   339	# V1.2 F2：亮的特效底下墊一層柔光（放射漸層貼圖，執行時生成；不用全域 Glow）
   340	const GLOW := {"boom": [Color(1.0, 0.55, 0.2), 70.0], "meteor": [Color(1.0, 0.5, 0.2), 90.0], "healarc": [Color(0.45, 1.0, 0.55), 40.0],
   341		"soulrise": [Color(0.7, 0.85, 1.0), 44.0], "timebell": [Color(1.0, 0.85, 0.4), 80.0], "sigil": [Color(1.0, 0.9, 0.55), 60.0]}
   342	var _glow_tex: GradientTexture2D = null
   343	
   344	func _draw_glow(f: Dictionary, k: float) -> void:
   345		if _glow_tex == null:
   346			var gr := Gradient.new()
   347			gr.set_color(0, Color(1, 1, 1, 1))
   348			gr.set_color(1, Color(1, 1, 1, 0))
   349			gr.add_point(0.45, Color(1, 1, 1, 0.35))
   350			_glow_tex = GradientTexture2D.new()
   351			_glow_tex.gradient = gr
   352			_glow_tex.fill = GradientTexture2D.FILL_RADIAL
   353			_glow_tex.fill_from = Vector2(0.5, 0.5)
   354			_glow_tex.fill_to = Vector2(1.0, 0.5)
   355			_glow_tex.width = 64
   356			_glow_tex.height = 64
   357		var g: Array = GLOW[f["kind"]]
   358		var gp = f.get("p", f.get("b", null))
   359		if gp == null:
   360			return
   361		var r: float = g[1] * (0.7 + 0.3 * minf(1.0, k * 3.0))
   362		draw_texture_rect(_glow_tex, Rect2(gp - Vector2(r, r * 0.8), Vector2(r * 2.0, r * 1.6)), false, Color(g[0], 0.32 * (1.0 - k)))
   363	
   364	func _draw_fx(f: Dictionary) -> void:
   365		var k: float = f["t"] / f["dur"]
   366		if GLOW.has(f["kind"]) and not bool(Save.s("plain_ui")) and not bool(Save.s("reduce_fx")):
   367			_draw_glow(f, k)
   368		match f["kind"]:
   369			"cmd_flash":
   370				draw_rect(Rect2(0, 0, 1280, 800), Color(f["c"], 0.28 * (1.0 - k)))
   371			"meteor":
   372				var mp: Vector2 = f["p"]
   373				var mr: float = f["r"]
   374				if k < 0.3:
   375					var drop := 1.0 - k / 0.3
   376					draw_circle(mp - Vector2(-120, 320) * drop, 15.0, Color("#ff8a3c"))
   377					draw_circle(mp - Vector2(-120, 320) * drop, 8.0, Color("#fff0b0"))
   378					draw_arc(mp, mr, 0, TAU, 40, Color(1, 0.5, 0.2, 0.7), 2.0, true)
   379				else:
   380					var bk := (k - 0.3) / 0.7
   381					draw_circle(mp, mr * (0.4 + bk * 0.6), Color(1, 0.5, 0.15, 0.45 * (1.0 - bk)))
   382					draw_arc(mp, mr * (0.4 + bk * 0.6), 0, TAU, 40, Color(1, 0.9, 0.6, 1.0 - bk), 4.0, true)
   383			"arrow":
   384				var a: Vector2 = f["a"]
   385				var b: Vector2 = f["b"]
   386				var h := minf(60.0, a.distance_to(b) * 0.18)
   387				var p := a.lerp(b, k) + Vector2(0, -sin(k * PI) * h)
   388				var k2 := maxf(0.0, k - 0.06)
   389				var p2 := a.lerp(b, k2) + Vector2(0, -sin(k2 * PI) * h)
   390				var dirv := (p - p2).normalized() if p != p2 else Vector2.RIGHT
   391				var tail := p - dirv * 16.0
   392				for j in 6:
   393					var kk := maxf(0.0, k - 0.03 * (j + 1))
   394					var pt := a.lerp(b, kk) + Vector2(0, -sin(kk * PI) * h)
   395					draw_circle(pt, 1.6, Color(1, 1, 1, 0.35 * (1.0 - j / 6.0)), true, -1.0, true)
   396				draw_line(tail, p, Art.OUT, 4.0, true)
   397				draw_line(tail, p, Color("#d97706"), 2.2, true)
   398				var nrm := dirv.orthogonal()
   399				draw_colored_polygon(PackedVector2Array([p + dirv * 5.0, p + nrm * 3.0, p - nrm * 3.0]), Color("#e5e7eb"))
   400				var fc: Color = f.get("tc", Color.WHITE)
   401				draw_colored_polygon(PackedVector2Array([tail, tail - dirv * 5.0 + nrm * 4.0, tail + dirv * 3.0]), fc)
   402				draw_colored_polygon(PackedVector2Array([tail, tail - dirv * 5.0 - nrm * 4.0, tail + dirv * 3.0]), fc)
   403			"slash":
   404				var c: Vector2 = f["p"] + Vector2(f["dir"] * 16, -24)
   405				var start := -1.3 if f["dir"] > 0 else PI - 1.1
   406				draw_arc(c, 16, start, start + 2.4 * k, 12, Color(1, 1, 1, 1 - k), 3.5, true)
   407			"step":
   408				var bigs: float = 1.8 if f.get("big", false) else 1.0
   409				for i in 4:
   410					var angs := i * TAU / 4 + 0.6
   411					draw_circle(f["p"] + Vector2(cos(angs) * (6 + k * 14) * bigs, sin(angs) * 3 + 1), 2.6 * bigs * (1 - k), Color(0.85, 0.75, 0.55, 0.5 * (1 - k)), true, -1.0, true)
   412			"dust":
   413				for i in 7:
   414					var ang := i * TAU / 7
   415					draw_circle(f["p"] + Vector2(cos(ang) * (10 + k * 30), sin(ang) * 6 + 2), 6 * (1 - k), Color(0.85, 0.75, 0.55, 0.6 * (1 - k)), true, -1.0, true)
   416			"flash":
   417				var c2: Color = f["c"]
   418				var p0: Vector2 = f["p"]
   419				# 雙層描邊（第三輪 V4）：深色底 4px＋亮芯
   420				for pair in [[Vector2(-14, -14), Vector2(14, 14)], [Vector2(-14, 14), Vector2(14, -14)]]:
   421					draw_line(p0 + pair[0] * (1 + k), p0 + pair[1] * (1 + k), Color(Art.OUT, 0.8 * (1 - k)), 8, true)
   422					draw_line(p0 + pair[0] * (1 + k), p0 + pair[1] * (1 + k), Color(c2, 1 - k), 4, true)
   423					draw_line(p0 + pair[0] * (1 + k), p0 + pair[1] * (1 + k), Color(1, 1, 1, 0.7 * (1 - k)), 1.5, true)
   424			"ripple":
   425				var c3: Color = f["c"]
   426				draw_arc(f["p"], 6 + k * 18, -1.2, 1.2, 12, Color(c3, 1 - k), 3, true)
   427			"bones":
   428				# V1.1 A7：骷髏散成幾根骨頭彈開、往下掉
   429				for i in 5:
   430					var an := -PI * 0.5 + (i - 2) * 0.55
   431					var v := Vector2(cos(an), sin(an)) * k * 30.0 + Vector2(0, k * k * 34.0)
   432					var c0: Vector2 = f["p"] + v
   433					var rot := k * 9.0 + i
   434					var d0 := Vector2(cos(rot), sin(rot)) * 6.0
   435					draw_line(c0 - d0, c0 + d0, Color(Art.OUT, 1.0 - k), 5.0, true)
   436					draw_line(c0 - d0, c0 + d0, Color(0.95, 0.93, 0.85, 1.0 - k), 3.0, true)
   437			"coins":
   438				# V1.1 A7：寶箱怪倒下吐出幾枚金幣
   439				for i in 6:
   440					var an2 := -PI * 0.5 + (i - 2.5) * 0.45
   441					var v2 := Vector2(cos(an2), sin(an2)) * k * 34.0 + Vector2(0, k * k * 40.0)
   442					var c1: Vector2 = f["p"] + v2
   443					draw_circle(c1, 4.5, Color(Art.OUT, 1.0 - k), true, -1.0, true)
   444					draw_circle(c1, 3.2, Color(1.0, 0.82, 0.3, 1.0 - k), true, -1.0, true)
   445			"badge":
   446				var bc: Color = f["c"]
   447				var bs := 7.0 * (1.0 + 0.4 * sin(minf(k * 2.0, 1.0) * PI))
   448				var bp: Vector2 = f["p"] - Vector2(0, k * 8.0)
   449				var dm := PackedVector2Array([bp + Vector2(0, -bs), bp + Vector2(bs * 0.8, 0), bp + Vector2(0, bs), bp + Vector2(-bs * 0.8, 0)])
   450				draw_colored_polygon(dm, Color(bc, 1.0 - k))
   451				draw_polyline(dm + PackedVector2Array([dm[0]]), Color(Art.OUT, 1.0 - k), 2.0, true)
   452			"sigil":
   453				var sc: Color = f["c"]
   454				var a0 := (1.0 - k) * (k * 6.0 if k < 0.15 else 1.0)
   455				for q in f["pts"]:
   456					draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.5), 0, q))
   457					var rr := 15.0 + k * 6.0
   458					match int(f["sk"]):
   459						0:
   460							var hx := PackedVector2Array()
   461							for j in 7:
   462								hx.append(Vector2(cos(j * TAU / 6.0), sin(j * TAU / 6.0)) * rr)
   463							draw_polyline(hx, Color(sc, 0.8 * a0), 2.5, true)
   464						1:
   465							for j in 3:
   466								var an := j * TAU / 3.0 + k * 2.0
   467								draw_arc(Vector2.ZERO, rr, an, an + 1.4, 8, Color(sc, 0.85 * a0), 3.0, true)
   468						2:
   469							draw_arc(Vector2.ZERO, rr, 0, TAU, 20, Color(sc, 0.6 * a0), 2.0, true)
   470							draw_line(Vector2(-6, 0), Vector2(6, 0), Color(sc, 0.9 * a0), 3.0, true)
   471							draw_line(Vector2(0, -6), Vector2(0, 6), Color(sc, 0.9 * a0), 3.0, true)
   472						_:
   473							for j in 6:
   474								var an2 := j * TAU / 6.0
   475								draw_line(Vector2(cos(an2), sin(an2)) * rr * 0.5, Vector2(cos(an2), sin(an2)) * rr * 1.1, Color(sc, 0.9 * a0), 2.5, true)
   476				draw_set_transform_matrix(_cam)
   477			"chips":
   478				# V1.1 A2：受擊材質碎屑（盾火花、石屑、史萊姆滴），4 顆往外彈、往下掉
   479				var cc: Color = f["c"]
   480				for i in 4:
   481					var ang := -PI * 0.5 + (i - 1.5) * 0.7 + float(int(f["p"].x) % 7) * 0.05
   482					var v := Vector2(cos(ang), sin(ang)) * k * 22.0 + Vector2(0, k * k * 18.0)
   483					var c0: Vector2 = f["p"] + v
   484					if f.get("spark", false):
   485						draw_line(c0, c0 - v.normalized() * 6.0 * (1.0 - k), Color(cc, 1.0 - k), 2.0, true)
   486					elif f.get("drop", false):
   487						draw_circle(c0, 3.2 * (1.0 - k * 0.5), Color(cc, (1.0 - k) * cc.a), true, -1.0, true)
   488					else:
   489						draw_rect(Rect2(c0 - Vector2(2.5, 2.5), Vector2(5, 5)), Color(cc, 1.0 - k))
   490			"shard":
   491				# 破盾裂片：盾面的灰藍碎片往外飛、旋轉、往下掉
   492				for i in 6:
   493					var ang := i * 1.13 + 0.4
   494					var v := Vector2(cos(ang), sin(ang) * 0.7) * k * 34
   495					var c0: Vector2 = f["p"] + v + Vector2(0, k * k * 24)
   496					var r0 := 6.0 * (1.0 - k * 0.4)
   497					var rot := k * 7.0 + i
   498					var pts := PackedVector2Array()
   499					for j in 3:
   500						pts.append(c0 + Vector2(cos(rot + j * 2.1), sin(rot + j * 2.1)) * r0)
   501					draw_colored_polygon(pts, Color(0.93, 0.97, 1.0, 1 - k))
   502					draw_polyline(pts + PackedVector2Array([pts[0]]), Color(Art.OUT, 1 - k), 2.0, true)
   503			"aim":
   504				# 警覺：金色瞄準線先拉出來，再淡掉
   505				var a2: Vector2 = f["a"]
   506				var b2: Vector2 = f["b"]
   507				var e2 := a2.lerp(b2, minf(1.0, k * 2.5))
   508				draw_dashed_line(a2, e2, Color(1, 0.84, 0.3, 0.6 * (1 - k)), 1.6, 6.0, true)
   509				draw_arc(b2, 9 - k * 3, 0, TAU, 16, Color(1, 0.84, 0.3, 1 - k), 2.0, true)
   510			"hide":
   370			return
   371		var a: float = Gait.phase_of(u.type, d[0], CS, UNIT_SCALE, u.id)
   372		var b: float = Gait.phase_of(u.type, d[1], CS, UNIT_SCALE, u.id)
   373		if int(a / PI) != int(b / PI):
   374			fx.append({"kind": "step", "p": _upos(u), "t": 0.0, "dur": 0.35, "big": u.type == 19})
   375	
   376	## 這一幀要畫的走路相位。
   377	func _walk_of(u, a: float) -> float:
   378		var k: int = Gait.kind(u.type)
   379		if u.stun > 0 or (drag_t.get(u.id, 0.0) > 0.0):
   380			if drag_t.get(u.id, 0.0) > 0.0:
   381				return Gait.POSE_DRAG
   382			return Gait.POSE_DAZE
   383		if k == Gait.ROOT:
   384			return 0.0
   385		if gait_on.get(u.id, false):
   386			var d: Array = gait_d.get(u.id, [0.0, 0.0])
   387			return Gait.phase_of(u.type, lerpf(d[0], d[1], a), CS, UNIT_SCALE, u.id)
   388		if k == Gait.FLOAT:
   389			return 0.0001 + time * 4.0 + u.id * 0.37      # 飄浮的就算停著也在飄
   390		return 0.0
   391	
   392	func _gait_frame(delta: float) -> void:
   393		for id in drag_t.keys():
   394			drag_t[id] -= delta
   395			if drag_t[id] <= 0.0:
   396				drag_t.erase(id)
   397		for u in view.units:
   398			var tgt: float = signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
   399			face_now[u.id] = move_toward(float(face_now.get(u.id, tgt)), tgt, delta * 11.0)
   400	
   401	## 轉身過場：不會縮到 0（貼圖會消失）。
   402	func _face_of(u) -> float:
   403		var f: float = face_now.get(u.id, signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0))
   404		if absf(f) < 0.18:
   405			return 0.18 if f >= 0.0 else -0.18
   406		return f
   407	
   408	## 打到不同東西聲音不同：盾與石魔是硬的、史萊姆是軟的。
   409	func _hit_material(id: int) -> void:
   410		if id < 0 or view == null:
   411			return
   412		var u = view.unit_by_id(id)
   413		if u == null:
   414			return
   415		var cp: Vector2 = _upos(u) + Vector2(0, -26)
   416		match u.type:
   417			D.SHIELD:
   418				sfx.play("hit_metal", 0.22)
   419				call("_add_fx", {"kind": "chips", "p": cp, "t": 0.0, "dur": 0.32, "c": Color("#e8f0ff"), "spark": true})   # V1.1 A2：盾面火花
   420			19, 12:
   421				sfx.play("hit_wood", 0.3)
   422				if u.type == 19:
   423					call("_add_fx", {"kind": "chips", "p": cp, "t": 0.0, "dur": 0.38, "c": Color("#a89a86")})   # 小石魔碎屑
   424			13, 20:
   425				sfx.play("hit_soft", 0.3)
   426				call("_add_fx", {"kind": "chips", "p": cp, "t": 0.0, "dur": 0.4, "c": Color(0.45, 1.0, 0.55, 0.85), "drop": true})   # 史萊姆綠滴
