     1	extends SceneTree
     2	## 第五輪 P0：效能探測。人數上限、一局時間要依這裡的數字定，不憑感覺。
     3	## 情境：標準 24＋24、大軍 32／40／48 隻、支援兵密集、困難 AI 候選模擬。
     4	## 模擬直接塞兵（繞過 MAX_UNITS），只量模擬本身；畫面 fps 另用截圖模式量。
     5	## 用法：godot --headless --path game --script res://tools/perf_probe.gd
     6	const Sim = preload("res://scripts/core/battle_sim.gd")
     7	const Army = preload("res://scripts/core/army.gd")
     8	const D = preload("res://scripts/core/unit_defs.gd")
     9	const AI = preload("res://scripts/core/ai_army.gd")
    10	const HardAI = preload("res://scripts/core/hard_ai.gd")
    11	const RSET = preload("res://scripts/core/ruleset.gd")
    12	
    13	static func fill(team: int, n: int, rng: RandomNumberGenerator, types: Array) -> Army:
    14		var a := Army.new(team, 1000)
    15		var cells: Array = []
    16		for c in Army.ZONE:
    17			for r in Army.ROWS:
    18				cells.append(Vector2i(c if team == 0 else Army.COLS - 1 - c, r))
    19		for i in range(cells.size() - 1, 0, -1):
    20			var j := rng.randi_range(0, i)
    21			var t = cells[i]; cells[i] = cells[j]; cells[j] = t
    22		for i in mini(n, cells.size()):
    23			a.units.append({"type": types[rng.randi_range(0, types.size() - 1)], "col": cells[i].x, "row": cells[i].y})
    24		return a
    25	
    26	static func bench(n: int, types: Array, reps: int, rules = null) -> Dictionary:
    27		var tot := 0
    28		var worst := 0
    29		var ticks := 0
    30		for k in reps:
    31			var rng := RandomNumberGenerator.new()
    32			rng.seed = 777 + k * 31 + n
    33			var s = Sim.new(fill(0, n, rng, types), fill(1, n, rng, types), rules)
    34			s.fast = true
    35			var t0 := Time.get_ticks_usec()
    36			s.run_to_end()
    37			var us := Time.get_ticks_usec() - t0
    38			tot += us
    39			worst = maxi(worst, us)
    40			ticks += s.tick
    41		return {"n": n, "avg_ms": tot / reps / 1000, "worst_ms": worst / 1000, "avg_ticks": ticks / reps, "us_per_tick": tot / maxi(1, ticks)}
    42	
    43	func _init() -> void:
    44		var all: Array = []
    45		for t in D.COUNT:
    46			all.append(t)
    47		var out := {}
    48		if "--fantasy" in OS.get_cmdline_user_args():
    49			# 第八輪：一局每邊最多 10 種；最壞是大量生兵與大招
    50			var fant: Array = []
    51			for t8 in range(D.COUNT, D.total()):
    52				fant.append(t8)
    53			out["fantasy_24"] = bench(24, fant, 6)
    54			out["fantasy_40"] = bench(40, fant, 6)
    55			out["fantasy_summon_40"] = bench(40, [13, 13, 17, 13, 17, D.SWORD], 6)
    56			out["fantasy_spore_40"] = bench(40, [10, 10, D.SWORD, D.ARCHER], 6)
    57			out["fantasy_cat_40"] = bench(40, [18, 18, 19, 16, D.SWORD], 6)
    58			out["old_support_40"] = bench(40, [D.SWORD, D.SHIELD, 7, 8, 7, 8], 6)
    59			print("PERF ", JSON.stringify(out))
    60			quit()
    61			return
    62		for n in [24, 32, 40, 48]:
    63			out["mixed_%d" % n] = bench(n, all, 6)
    64		out["support_40"] = bench(40, [D.SWORD, D.SHIELD, 7, 8, 7, 8], 6)   # 醫者 7、鼓手 8 密集
    65		out["archers_40"] = bench(40, [D.ARCHER, D.ARCHER, D.SHIELD], 6)
    66		# 困難 AI：候選陣型各和玩家上一局模擬一場（標準 24 隻）
    67		var rng := RandomNumberGenerator.new()
    68		rng.seed = 99
    69		var known: Array = AI.build(0, 100, rng)["army"].units
    70		var t0 := Time.get_ticks_usec()
    71		for k in 5:
    72			HardAI.build(known, [], rng)
    73		out["hard_ai_build_ms"] = (Time.get_ticks_usec() - t0) / 5 / 1000
    74		# 第五輪（Codex 實作第 1 輪）：最大規則情境——40＋40、150 秒、支援兵密集；困難 AI 在最大規則下組陣；重播跳轉到最後
    75		var big = RSET.standard()
    76		big.budget = [200, 200]
    77		big.unit_cap = 40
    78		big.ticks = 3000
    79		out["max_rules_40_150s"] = bench(40, all, 4, big)
    80		out["max_rules_support_40_150s"] = bench(40, [D.SWORD, D.SHIELD, 7, 8, 7, 8], 4, big)
    81		# 合法的最大陣（Codex 實作第 2 輪：上面兩項是繞過預算直接塞兵的壓力測試）：200 金、40 隻上限、照規則擺
    82		var legal_t := 0
    83		var legal_worst := 0
    84		for k in 4:
    85			var lr := RandomNumberGenerator.new()
    86			lr.seed = 300 + k
    87			var la = AI.build(0, 200, lr, -1, -1, big)["army"]
    88			var lb = AI.build(1, 200, lr, -1, -1, big)["army"]
    89			var ls = Sim.new(la, lb, big)
    90			ls.fast = true
    91			var t3 := Time.get_ticks_usec()
    92			ls.run_to_end()
    93			var us3 := Time.get_ticks_usec() - t3
    94			legal_t += us3
    95			legal_worst = maxi(legal_worst, us3)
    96		out["legal_max_ai_armies"] = {"avg_ms": legal_t / 4 / 1000, "worst_ms": legal_worst / 1000}
    97		# 合法的支援兵密集：10 劍士＋醫者／鼓手交替擺到買不起（200 金、40 隻）
    98		var mk := func(team: int) -> Army:
    99			var a := Army.new(team, 200)
   100			a.apply_rules(big, team)
   101			var cells: Array = []
   102			for c in Army.ZONE:
   103				for r in Army.ROWS:
   104					cells.append(Vector2i(c if team == 0 else Army.COLS - 1 - c, r))
   105			var i := 0
   106			for k in 10:
   107				a.place(D.SWORD, cells[i].x, cells[i].y)
   108				i += 1
   109			var t := 7
   110			while a.can_afford_any() and i < cells.size():
   111				a.place(t, cells[i].x, cells[i].y)
   112				t = 15 - t
   113				i += 1
   114			return a
   115		var sup0: Army = mk.call(0)
   116		var sup1: Army = mk.call(1)
   117		var ss = Sim.new(sup0, sup1, big)
   118		ss.fast = true
   119		var t4 := Time.get_ticks_usec()
   120		ss.run_to_end()
   121		out["legal_support_dense"] = {"units": sup0.count(), "ms": (Time.get_ticks_usec() - t4) / 1000, "ticks": ss.tick}
   122		var known2: Array = AI.build(0, 200, rng, -1, -1, big)["army"].units
   123		var t1 := Time.get_ticks_usec()
   124		for k in 3:
   125			HardAI.build(known2, [], rng, -1, big)
   126		out["hard_ai_build_max_rules_ms"] = (Time.get_ticks_usec() - t1) / 3 / 1000
   127		# 重播跳轉：從頭快轉到最後一 tick（畫面的 _seek 也是這樣做）
   128		rng.seed = 4242
   129		var sa := fill(0, 40, rng, [D.SWORD, D.SHIELD, 7, 8, 7, 8])
   130		var sb := fill(1, 40, rng, [D.SWORD, D.SHIELD, 7, 8, 7, 8])
   131		var t2 := Time.get_ticks_usec()
   132		var sk = Sim.new(sa, sb, big)
   133		while not sk.finished:
   134			sk.step()
   135		out["seek_to_end_max_ms"] = (Time.get_ticks_usec() - t2) / 1000
   136		print("PERF ", JSON.stringify(out))
   137		quit()

exec
/bin/bash -lc "nl -ba game/scripts/ui/battle/battle_state.gd | sed -n '20,45p;116,140p'; nl -ba game/scripts/ui/battle/battle_fx.gd | sed -n '116,206p;645,668p'; nl -ba game/scripts/ui/battle_view.gd | sed -n '380,406p;518,603p'; rg -n '9.79|p95|draw_ms|draw.*usec' game/tools/dev_main.gd coordination/v130* game/scripts/ui; nl -ba game/scripts/ui/battle/battle_units.gd | sed -n '650,675p'; rg -n '0.75|dead|death' game/scripts/ui/battle_view.gd | head -20" in /mnt/c/Users/timmy/projects/no-take-backs
 succeeded in 154ms:
    20	
    21	## 開戰號角（第七輪 A10）：正式對局開戰前留 1 秒，陣線亮一下。只是畫面緩衝，模擬還沒開始；簡化特效時略過。
    22	var start_hold := 0.0
    23	
    24	## 跳字（第三輪 V1）：
    25	## ・合併：同一種技能、同一區（48×32px）0.35 秒內合併成「背刺 ×3（120）」，數字變大彈一下
