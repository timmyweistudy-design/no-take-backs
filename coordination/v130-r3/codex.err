   123	func _text_rect(f: Dictionary, at: Vector2) -> Rect2:
   124		var sz := int(ts(int(f["size"])) * (1.0 + float(f.get("pop", 0.0)) * 1.4))   # 含合併時的彈跳放大（Codex S1 #4）
