   116	func _merge_text(tid: int, kind: String, label: String, dmg: int, p: Vector2, col: Color) -> void:
   117		if int(TEXT_TIER.get(kind, 1)) >= 2:
   118			text_key_in += 1
   119		var cell := Vector2i(floori(p.x / TEXT_CELL.x), floori(p.y / TEXT_CELL.y))
   120		for f in fx:
   121			if f["kind"] == "text" and not f.get("screen", false) and f.get("ek", "") == kind and f.get("cell", Vector2i(-99, -99)) == cell and f["t"] < 0.35:
   122				f["n"] += 1
   123				f["sum"] += dmg
   124				f["s"] = ("+%d" % f["sum"]) if kind == EV.HEAL else "%s ×%d（%d）" % [label, f["n"], f["sum"]]
   125				f["t"] = 0.0
   126				f["pop"] = 0.18
   127				if int(f.get("tier", 1)) >= 2:
   128					text_key_shown += 1
   129				return
   130		var tier: int = TEXT_TIER.get(kind, 1)
   131		var world := 0
   132		for f in fx:
   133			if f["kind"] == "text" and not f.get("screen", false):
   134				world += 1
   135		if world >= TEXT_CAP:
   136			# 丟最舊的一般跳字；全部都是關鍵的就照樣加（關鍵不能漏）
   137			var oldest := -1
   138			for k in fx.size():
   139				var f2: Dictionary = fx[k]
   140				if f2["kind"] == "text" and not f2.get("screen", false) and int(f2.get("tier", 1)) < 2:
   141					if oldest < 0 or f2["t"] > fx[oldest]["t"]:
   142						oldest = k
   143			if oldest >= 0:
   144				fx.remove_at(oldest)
   145				text_dropped += 1
   146			elif tier < 2:
   147				text_dropped += 1
   148				return
   149			else:
   150				# 全部都是關鍵跳字：併進最近的同種跳字（硬上限，Codex S1 #5），關鍵不漏、只是合併
   151				var near := -1
   152				for k2 in fx.size():
   153					var f3: Dictionary = fx[k2]
   154					if f3["kind"] == "text" and f3.get("ek", "") == kind and (near < 0 or f3["p"].distance_to(p) < fx[near]["p"].distance_to(p)):
   155						near = k2
   156				if near >= 0:
   157					var fn: Dictionary = fx[near]
   158					fn["n"] += 1
   159					fn["sum"] += dmg
   160					fn["s"] = "%s ×%d（%d）" % [label, fn["n"], fn["sum"]]
   161					fn["t"] = 0.0
   162					fn["pop"] = 0.18
   163					text_key_shown += 1
   164					return
   165				# 沒有同種的：取代最舊的關鍵跳字（它已經顯示過了），維持硬上限
   166				var old := -1
   167				for k4 in fx.size():
   168					var f4: Dictionary = fx[k4]
   169					if f4["kind"] == "text" and not f4.get("screen", false) and (old < 0 or f4["t"] > fx[old]["t"]):
   170						old = k4
   171				if old >= 0:
   172					fx.remove_at(old)
   173		if tier >= 2:
   174			text_key_shown += 1
   175		fx.append({"kind": "text", "p": p, "s": ("+%d" % dmg) if kind == EV.HEAL else "%s %d" % [label, dmg], "c": col, "t": 0.0, "dur": 0.85, "size": 18 if tier >= 2 else (14 if kind == EV.HEAL else 16),
   176			"tid": tid, "ek": kind, "n": 1, "sum": dmg, "screen": false, "cell": cell, "tier": tier, "pop": 0.0, "plain": kind == EV.HEAL})
