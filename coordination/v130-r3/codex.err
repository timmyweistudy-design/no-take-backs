   180	## 每幀排版：關鍵在前、新的在前；和已放好的（不在淡出中的）重疊就往上推。結果存在 f["rp"]。
   181	func _layout_texts() -> void:
   182		var list: Array = []
   183		for f in fx:
   184			if f["kind"] == "text" and not f.get("screen", false):
   185				list.append(f)
   186		list.sort_custom(func(a, b): return a.get("tier", 1) > b.get("tier", 1) or (a.get("tier", 1) == b.get("tier", 1) and a["t"] < b["t"]))
   187		var placed: Array = []
   188		for f in list:
   189			var k: float = f["t"] / f["dur"]
   190			var at: Vector2 = f["p"] + Vector2(0, -k * 26)
   191			var r := _text_rect(f, at)
   192			if true:   # 淡出中的也排，但排在最後（新的、關鍵的先佔位），所以不會推動正在顯示的
   193				var moved := true
   194				var guard := 0
   195				while moved and guard < 24:
   196					moved = false
   197					guard += 1
   198					for q: Rect2 in placed:
   199						if q.intersects(r):
   200							r.position.y = q.position.y - r.size.y - 2.0
   201							moved = true
   202				placed.append(r)
   203			f["rp"] = Vector2(r.get_center().x, r.position.y + 3.0)
   204			f["rr"] = r
