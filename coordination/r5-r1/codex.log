    68	## 畫面前進一個 tick：模擬保持領先 DELAY 個 tick，畫面播最舊的那一份快照（R5 展示緩衝）。
    69	func _sim_step(with_fx: bool) -> void:
    70		_pump_view()
    71		for u in view.units:
    72			prev_pos[u.id] = Vector2(u.x, u.y)
    73		if not view.advance():
    74			view.finished = true
    75			return
    76		_pump_view()
    77		if view.frenzy and not frenzy_seen:
    78			frenzy_seen = true
    79			if with_fx:
    80				_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
    81				sfx.play("frenzy")
    82				sfx.play_music("music_frenzy")
    83		var deaths := 0
    84		for ev in view.events:
    85			var k: String = ev["kind"]
    86			if ev.has("src"):
    87				var s = view.unit_by_id(ev["src"])
    88				var key := "%s%d" % [k, s.team]
    89				ev_count[key] = int(ev_count.get(key, 0)) + 1
