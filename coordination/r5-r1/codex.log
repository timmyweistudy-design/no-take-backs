   108	## 畫面上現在播到第幾 tick（含小數，插值用）。
   109	func _disp_tick() -> float:
   110		if view == null:
   111			return 0.0
   112		return view.tick + (clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 0.0)
   113	
