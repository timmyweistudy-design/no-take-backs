     1	extends "res://scripts/ui/ui_base.gd"
     2	## 戰場、單位、特效、戰鬥 HUD、最後時刻鏡頭（演出層：不影響戰鬥結果）。
     3	
     4	
     5	func _on_skip() -> void:
     6		while not view.finished:
     7			_sim_step(false)
     8		result_delay = 9.0
     9	
    10	
    11	func _battle_process(delta: float) -> void:
    12		if hitstop > 0:
    13			hitstop -= delta
    14			return
    15		var rate := speed
    16		if slow_left > 0:
    17			rate *= 0.5
    18			slow_left -= delta
    19		accum += delta * rate
    20		while accum >= 0.05 and not view.finished:
    21			accum -= 0.05
    22			_sim_step(true)
    23		if view.finished:
    24			accum = 0.0
    25		_check_clutch()
    26		if slow_left > 0 and not view.finished:
    27			_frame_alive(delta)
    28		else:
    29			zoom_target = 1.0
    30		zoom = lerpf(zoom, zoom_target, delta * 3)
    31		if view.finished:
    32			result_delay += delta
    33			if result_delay > 1.4:
    34				_finish_battle()
    35	
    36	
    37	## 最後時刻（優化方案 F1）：雙方剩餘戰力都 ≤30% 且差距 ≤15%；或雙方各剩 ≤3 隻且差距 ≤15%。
    38	func _check_clutch() -> void:
    39		if slow_used or view.finished:
    40			return
    41		var tot := float(view.budget * 1000)
    42		var p0: float = view.power(0) * 100.0 / tot
    43		var p1: float = view.power(1) * 100.0 / tot
    44		var a0: int = view.alive_count(0)
    45		var a1: int = view.alive_count(1)
    46		if absf(p0 - p1) <= 15.0 and ((p0 <= 30.0 and p1 <= 30.0) or (a0 <= 3 and a1 <= 3)):
    47			slow_used = true
    48			if bool(Save.s("slowmo")):
    49				slow_left = 8.0
    50			_fx_text(Vector2(640, 92), L.t("clutch"), ACCENT, 1.4, 34, true)
    51			sfx.play("clutch")
    52	
    53	
    54	## 鏡頭安全框（優化方案 F2）：把所有存活單位框進畫面，四周留 15%。
    55	func _frame_alive(delta: float) -> void:
    56		var lo := Vector2(1e9, 1e9)
    57		var hi := Vector2(-1e9, -1e9)
    58		for u in view.units:
    59			if u.alive:
    60				var p := _upos(u)
    61				lo = lo.min(p - Vector2(30, 70))
    62				hi = hi.max(p + Vector2(30, 20))
    63		var size := (hi - lo) / 0.7
    64		zoom_target = clampf(minf(1280.0 / maxf(1, size.x), 620.0 / maxf(1, size.y)), 1.08, 1.5)
    65		zoom_center = zoom_center.lerp((lo + hi) / 2, minf(1.0, delta * 3))
    66	
