   144	## 事件分流（Codex R3 審查 #1）：只有帶 dmg 的才是攻擊；背水開關沒有 src；嘲諷、現形、繞翼只有演出。
   145	## 回傳 "death"／"skip"／"taunt"／"reveal"／"attack"。測試會把真實戰鬥的每一種事件都丟進來檢查。
   146	static func event_route(ev: Dictionary) -> String:
   147		var k: String = ev.get("kind", "")
   148		if k == "death":
   149			return "death"
   150		if k == "taunt" or k == "reveal":
   151			return k if ev.has("src") and ev.has("tgt") else "skip"
   152		if ev.has("dmg") and ev.has("src") and ev.has("tgt"):
   153			return "attack"
   154		return "skip"
   155	
   156	
   157	func _on_event(ev: Dictionary, with_fx: bool) -> void:
   158		var k: String = ev["kind"]
   159		if k == "death":
   160			var u = view.unit_by_id(ev["id"])
   161			dying.append({"pos": _upos(u), "type": u.type, "team": u.team, "face": signf(u.fx) if u.fx != 0 else 1.0, "t": 0.0})
   162			if with_fx:
   163				sfx.play("death", 0.7)
   164			return
   165		var route := event_route(ev)
   166		if route == "skip" or not with_fx:
   167			return
   168		match route:
   169			"taunt":
   170				var sh = view.unit_by_id(ev["src"])
   171				var vic = view.unit_by_id(ev["tgt"])
   172				fx.append({"kind": "taunt", "p": _upos(sh), "t": 0.0, "dur": 0.6})
   173				fx.append({"kind": "bang", "p": _upos(vic) + Vector2(0, -64), "t": 0.0, "dur": 0.7})
   174				return
   175			"reveal":
   176				fx.append({"kind": "puff", "p": _upos(view.unit_by_id(ev["src"])) + Vector2(0, -20), "t": 0.0, "dur": 0.45})
   177				return
   178		var s = view.unit_by_id(ev["src"])
   179		var t = view.unit_by_id(ev["tgt"])
   180		var tags: Array = ev.get("tags", [])
   181		atk_t[s.id] = time
   182		hurt_t[t.id] = time
   183		var sp := _upos(s)
   184		var tpos := _upos(t)
   185		if tags.has("alert"):
   186			fx.append({"kind": "aim", "a": sp + Vector2(0, -24), "b": tpos + Vector2(0, -22), "t": 0.0, "dur": 0.32})
   187		if tags.has("hide"):
   188			fx.append({"kind": "hide", "p": tpos + Vector2(0, -24), "dir": signf(sp.x - tpos.x) if sp.x != tpos.x else 1.0, "t": 0.0, "dur": 0.4})
   189		if tags.has("trip"):
   190			fx.append({"kind": "trip", "p": tpos + Vector2(0, -4), "t": 0.0, "dur": 0.5})
   191		if s.type == D.ARCHER:
   192			fx.append({"kind": "arrow", "a": sp + Vector2(10 * signf(tpos.x - sp.x), -24), "b": tpos + Vector2(0, -22), "t": 0.0, "dur": 0.28, "tc": Art.team_color(s.team, cbm())})
   193			sfx.play("arrow", 0.35)
   194		else:
   195			fx.append({"kind": "slash", "p": sp, "dir": signf(tpos.x - sp.x) if tpos.x != sp.x else 1.0, "t": 0.0, "dur": 0.18})
   196			sfx.play("hit" if k == "hit" else "slash", 0.4)
   197		var col := Color.WHITE
   198		var label := ""
   199		match k:
   200			"charge":
   201				label = L.t("ev_charge")
   202				col = ACCENT
   203				sfx.play("charge")
   204				if bool(Save.s("shake")):
   205					shake = 0.12
   206				fx.append({"kind": "dust", "p": tpos, "t": 0.0, "dur": 0.5})
   207			"backstab":
   208				label = L.t("ev_backstab")
   209				col = Color("#c77dff")
   210				sfx.play("backstab")
   211				fx.append({"kind": "flash", "p": tpos + Vector2(0, -26), "c": Color("#c77dff"), "t": 0.0, "dur": 0.25})
   212				fx.append({"kind": "vslash", "p": tpos + Vector2(0, -26), "dir": signf(tpos.x - sp.x) if tpos.x != sp.x else 1.0, "t": 0.0, "dur": 0.3})
   213			"braced":
   214				label = L.t("ev_braced")
   215				col = Color("#9ad1ff")
   216				sfx.play("brace")
   217				brace_t[t.id] = time
   218				fx.append({"kind": "hex", "p": tpos + Vector2(10 * signf(sp.x - tpos.x), -24), "t": 0.0, "dur": 0.45})
   219			"anticav":
   220				label = L.t("ev_anticav")
   221				col = Color("#9ad1ff")
   222				sfx.play("brace", 0.6)
   223			"blocked":
   224				sfx.play("block", 0.5)
   225				fx.append({"kind": "ripple", "p": tpos + Vector2(14 * signf(sp.x - tpos.x), -26), "c": Color("#cfe3ff"), "t": 0.0, "dur": 0.3})
   226			"counter":
   227				label = L.t("ev_counter")
   228				col = Color("#80ffdb")
   229			"breaker":
   230				fx.append({"kind": "shard", "p": tpos + Vector2(12, -26), "t": 0.0, "dur": 0.5})
   231		if label != "":
   232			_merge_text(t.id, k, label, int(ev["dmg"]), tpos + Vector2(0, -78), col)
   233	
   234	
   235	## 跳字合併（優化方案 F3）：同一目標、同一種效果 0.25 秒內合併成「背刺 ×3 120」。
   236	func _merge_text(tid: int, kind: String, label: String, dmg: int, p: Vector2, col: Color) -> void:
   237		for f in fx:
   238			if f["kind"] == "text" and f.get("tid", -1) == tid and f.get("ek", "") == kind and f["t"] < 0.25:
   239				f["n"] += 1
   240				f["sum"] += dmg
   241				f["s"] = "%s ×%d（%d）" % [label, f["n"], f["sum"]]
   242				f["t"] = 0.0
   243				return
   244		# 排斥：附近已有跳字就往上疊
   245		var q := p
   246		for f in fx:
   247			if f["kind"] == "text" and not f.get("screen", false) and f["p"].distance_to(q) < 22:
   248				q.y -= 20
   249		fx.append({"kind": "text", "p": q, "s": "%s %d" % [label, dmg], "c": col, "t": 0.0, "dur": 0.85, "size": 18,
   250			"tid": tid, "ek": kind, "n": 1, "sum": dmg, "screen": false})
   251	
   252	
   253	func _fx_text(p: Vector2, s: String, c: Color, dur: float, size: int, screen := false) -> void:
   254		fx.append({"kind": "text", "p": p, "s": s, "c": c, "t": 0.0, "dur": dur, "size": size, "screen": screen})
   255	
   256	
   257	func _upos(u) -> Vector2:
   258		var cur := Vector2(u.x, u.y)
   259		var a := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
   260		var p: Vector2 = prev_pos.get(u.id, cur).lerp(cur, a)
   261		# 純畫面錯開（手感輪 2）：依編號固定偏移 ±4px，讓疊在一起的兵不會完全重合；戰鬥計算不受影響
   262		var j := Vector2(float((u.id * 37) % 9 - 4), float((u.id * 53) % 7 - 3))
   263		return ORIGIN + p * CS / 1000.0 + j
   264	
   265	
   266	func _draw_field() -> void:
   267		draw_rect(Rect2(ORIGIN - Vector2(10, 10), FIELD + Vector2(20, 20)), Color("#5b4632"))
   268		for r in 9:
   269			for c in 16:
   270				var cell := Rect2(ORIGIN + Vector2(c, r) * CS, Vector2(CS, CS))
   271				if grass:
   272					var h := absi((c * 73856093) ^ (r * 19349663))
   273					draw_texture_rect_region(grass, cell, Rect2((h % 8) * 32, ((h / 8) % 4) * 32, 32, 32))
   274				else:
   275					draw_rect(cell, Color("#7cb342") if (r + c) % 2 == 0 else Color("#73a83d"))
   276				if c < 6:
   277					draw_rect(cell, Color(Art.team_color(0, cbm()), 0.08))
   278				elif c >= 10:
   279					draw_rect(cell, Color(Art.team_color(1, cbm()), 0.06))
   280		draw_rect(Rect2(ORIGIN, FIELD), Color(0.06, 0.09, 0.16, 0.18))
   281		for i in 17:
   282			draw_line(ORIGIN + Vector2(i * CS, 0), ORIGIN + Vector2(i * CS, FIELD.y), Color(0, 0, 0, 0.07), 1)
   283		for i in 10:
   284			draw_line(ORIGIN + Vector2(0, i * CS), ORIGIN + Vector2(FIELD.x, i * CS), Color(0, 0, 0, 0.07), 1)
   285		draw_dashed_line(ORIGIN + Vector2(6 * CS, 0), ORIGIN + Vector2(6 * CS, FIELD.y), Color(Art.team_color(0, cbm()), 0.75), 3.0, 8.0)
   286		draw_dashed_line(ORIGIN + Vector2(10 * CS, 0), ORIGIN + Vector2(10 * CS, FIELD.y), Color(Art.team_color(1, cbm()), 0.75), 3.0, 8.0)
   287		if plants.size() >= 9:
   288			var deco := [[0, Vector2(52, 200)], [3, Vector2(70, 280)], [5, Vector2(30, 400)], [1, Vector2(60, 560)], [7, Vector2(90, 660)],
   289				[2, Vector2(1220, 190)], [6, Vector2(1240, 300)], [0, Vector2(1215, 470)], [4, Vector2(1245, 600)], [8, Vector2(1200, 676)]]
   290			for d in deco:
   291				var tex: Texture2D = plants[d[0]]
   292				var sz := tex.get_size() * (0.85 if d[0] <= 2 else 1.4)
   293				draw_texture_rect(tex, Rect2(d[1] - Vector2(sz.x / 2, sz.y), sz), false)
   294	
   295	
   296	func _draw_units_of(s, dim: bool) -> void:
   297		var list: Array = []
   298		for u in s.units:
   299			if u.alive:
   300				list.append(u)
   301		var live: bool = s == view
   302		if live:
   303			list.sort_custom(func(a, b): return _upos(a).y < _upos(b).y)
   304		else:
   305			list.sort_custom(func(a, b): return a.y < b.y)
   306		# 第一層：腳底標記與影子（全部先畫，不會被別人的身體整個蓋住時也看得到外圈）
   307		for u in list:
   308			var p0: Vector2 = _upos(u) if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
   309			_ring(p0, u.team, u.type, UNIT_SCALE)
   310			if live and s.rally[u.team] and not s.finished:
   311				for k in 2:
   312					var ph := fmod(time * 1.6 + k * 0.5, 1.0)
   313					draw_arc(p0, (14.0 + ph * 10.0) * UNIT_SCALE, 0, TAU, 20, Color(1, 0.42, 0.0, 0.55 * (1.0 - ph)), 2.0, true)
   314		# 第二層：身體
   315		for u in list:
   316			var p: Vector2 = _upos(u) if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
   317			var moving: bool = u.mx != 0 or u.my != 0
   318			var at := 0.0
   319			if live and atk_hit.has(u.id):
   320				at = atk_progress(_disp_tick() - (atk_hit[u.id] - ViewBuffer.DELAY), u.type)
   321			var hurt := 0.0
   322			if live and hurt_t.has(u.id) and bool(Save.s("flash")):
   323				hurt = clampf(1.0 - (time - hurt_t[u.id]) / 0.15, 0, 1)
   324			var alpha := 0.45 if u.stealth > 0 else 1.0
   325			if dim:
   326				alpha *= 0.6
   327			var face := signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
   328			# 表情與兵種專屬動作（R5）
   329			var mood := 0
   330			var lean := 0.0
   331			var crouch := 1.0
   332			if hurt > 0.3 or u.stun > 0:
   333				mood |= Art.M_HURT
   334			if u.type == D.CAVALRY and moving and u.charge >= D.CHARGE_NEED:
   335				mood |= Art.M_SPARKLE
   336				lean = 0.26                      # 衝鋒蓄滿前傾 15°
   337				for k in 3:                      # 馬蹄噴土
   338					var ph := fmod(time * 4.0 + k * 0.33 + u.id * 0.1, 1.0)
   339					draw_circle(p + Vector2(-face * (14 + ph * 16), -2 - ph * 6), 3.2 * (1.0 - ph), Color(0.85, 0.75, 0.55, 0.7 * (1.0 - ph)), true, -1.0, true)
   340			if s.frenzy and at == 0.0 and not s.finished:
   341				mood |= Art.M_BROWS
   342			if u.type == D.ASSASSIN and u.stealth > 0:
   343				mood |= Art.M_HOOD
   344				crouch = 0.9                     # 潛行蹲身
   345			if live and brace_t.has(u.id) and time - brace_t[u.id] < 0.35:
   346				mood |= Art.M_BRACE
   347			# 勝利：存活的勝方每 0.45 秒原地跳 10px、武器高舉
   348			var hop := 0.0
   349			if state == St.RESULT and live and sim != null and u.team == sim.winner:
   350				hop = absf(sin((time + u.id * 0.05) * PI / 0.45)) * 10.0
   351				at = Art.ATK_WINDUP
   352				_star_above(p + Vector2(0, -hop - (74 if u.type == D.CAVALRY else 66)))
   353			p.y -= hop
   354			var run := 1.6 if u.type == D.CAVALRY else (1.4 if u.type == D.ASSASSIN else 1.0)   # 快的兵跑步節奏也快
   355			if u.stealth > 0:
   356				# 潛行：身後兩道暗紫殘影
   357				for g in 2:
   358					var gp := p + Vector2(-(8 + g * 8) * face, 0)
   359					draw_circle(gp + Vector2(0, -22), 11.0 - g * 2.0, Color(0.3, 0.15, 0.45, 0.22 - g * 0.08), true, -1.0, true)
   360					_unit(gp, u.type, u.team, face, 0.0, 0.0, 0.0, 0.14 - g * 0.06, time, UNIT_SCALE)
   361			_unit(p, u.type, u.team, face, (time * 10.0 * run + u.id) if moving else 0.0, at, hurt, alpha, time, UNIT_SCALE, mood, lean, crouch)
   362		if dim:
   363			return
   364		# 第三層：小旗、血條、狀態（永遠畫在最上面）
   365		for u in list:
   366			var p: Vector2 = _upos(u) if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
   367			Art.flag(self, p + Vector2(-12, -50 if u.type != D.CAVALRY else -58), u.team, cbm())
   368			if u.stun > 0:
   369				# 暈眩：三顆金色菱形繞著頭轉
   370				var hc := p + Vector2(0, -70 if u.type == D.CAVALRY else -62)
   371				for j in 3:
   372					var an := time * 5.0 + j * TAU / 3.0
   373					var dc := hc + Vector2(cos(an) * 13, sin(an) * 4)
   374					var sz := 4.0 + sin(an) * 1.0
   375					draw_colored_polygon(PackedVector2Array([dc + Vector2(0, -sz), dc + Vector2(sz * 0.7, 0), dc + Vector2(0, sz), dc + Vector2(-sz * 0.7, 0)]), Color(1, 0.85, 0.25))
   376			if live and s.rally[u.team]:
   377				draw_arc(p + Vector2(0, -24), 22.0, 0, TAU, 20, Color(1, 0.45, 0.2, 0.35 + 0.15 * sin(time * 8)), 2.5, true)
   378			if s.frenzy:
   379				draw_circle(p + Vector2(8, -58 - sin(time * 12 + u.id) * 2), 3.0, Color(1, 0.5, 0.1, 0.9), true, -1.0, true)
   380			if u.hp < u.max_hp:
   381				var w := 28.0
   382				var top := p + Vector2(-w / 2, -66 if u.type == D.CAVALRY else -58)
   383				draw_rect(Rect2(top - Vector2(1, 1), Vector2(w + 2, 6)), Art.OUT)
   384				draw_rect(Rect2(top, Vector2(w * u.hp / u.max_hp, 4)), Art.team_color(u.team, cbm()).lightened(0.25))
   385		if not live:
   386			return
   387		for g in dying:
   388			var k: float = g["t"] / 1.0
   389			if k < 0.3:
   390				_unit(g["pos"], g["type"], g["team"], g["face"], 0.0, 0.0, 0.8, 1.0 - k / 0.3, time)
   391				for i in 6:
   392					var ang := i * TAU / 6
   393					draw_circle(g["pos"] + Vector2(cos(ang), sin(ang) * 0.5) * (8 + k * 70) + Vector2(0, -16), 4 * (1 - k), Color(1, 1, 1, 0.35), true, -1.0, true)
   394			Art.soul(self, g["pos"] + Vector2(sin(k * 9) * 4, -24 - k * 70), 0.75 * (1.0 - k))
   395	
   396	
   397	func _draw_fx(f: Dictionary) -> void:
   398		var k: float = f["t"] / f["dur"]
   399		match f["kind"]:
   400			"arrow":
   401				var a: Vector2 = f["a"]
   402				var b: Vector2 = f["b"]
   403				var h := minf(60.0, a.distance_to(b) * 0.18)
   404				var p := a.lerp(b, k) + Vector2(0, -sin(k * PI) * h)
   405				var k2 := maxf(0.0, k - 0.06)
   406				var p2 := a.lerp(b, k2) + Vector2(0, -sin(k2 * PI) * h)
   407				var dirv := (p - p2).normalized() if p != p2 else Vector2.RIGHT
   408				var tail := p - dirv * 16.0
   409				for j in 6:
   410					var kk := maxf(0.0, k - 0.03 * (j + 1))
   411					var pt := a.lerp(b, kk) + Vector2(0, -sin(kk * PI) * h)
   412					draw_circle(pt, 1.6, Color(1, 1, 1, 0.35 * (1.0 - j / 6.0)), true, -1.0, true)
   413				draw_line(tail, p, Art.OUT, 4.0, true)
   414				draw_line(tail, p, Color("#d97706"), 2.2, true)
   415				var nrm := dirv.orthogonal()
   416				draw_colored_polygon(PackedVector2Array([p + dirv * 5.0, p + nrm * 3.0, p - nrm * 3.0]), Color("#e5e7eb"))
   417				var fc: Color = f.get("tc", Color.WHITE)
   418				draw_colored_polygon(PackedVector2Array([tail, tail - dirv * 5.0 + nrm * 4.0, tail + dirv * 3.0]), fc)
   419				draw_colored_polygon(PackedVector2Array([tail, tail - dirv * 5.0 - nrm * 4.0, tail + dirv * 3.0]), fc)
   420			"slash":
   421				var c: Vector2 = f["p"] + Vector2(f["dir"] * 16, -24)
   422				var start := -1.3 if f["dir"] > 0 else PI - 1.1
   423				draw_arc(c, 16, start, start + 2.4 * k, 12, Color(1, 1, 1, 1 - k), 3.5, true)
   424			"dust":
   425				for i in 7:
   426					var ang := i * TAU / 7
   427					draw_circle(f["p"] + Vector2(cos(ang) * (10 + k * 30), sin(ang) * 6 + 2), 6 * (1 - k), Color(0.85, 0.75, 0.55, 0.6 * (1 - k)), true, -1.0, true)
   428			"flash":
   429				var c2: Color = f["c"]
   430				var p0: Vector2 = f["p"]
   431				draw_line(p0 + Vector2(-14, -14) * (1 + k), p0 + Vector2(14, 14) * (1 + k), Color(c2, 1 - k), 4, true)
   432				draw_line(p0 + Vector2(-14, 14) * (1 + k), p0 + Vector2(14, -14) * (1 + k), Color(c2, 1 - k), 4, true)
   433			"ripple":
   434				var c3: Color = f["c"]
   435				draw_arc(f["p"], 6 + k * 18, -1.2, 1.2, 12, Color(c3, 1 - k), 3, true)
   436			"shard":
   437				# 破盾裂片：盾面的灰藍碎片往外飛、旋轉、往下掉
   438				for i in 6:
   439					var ang := i * 1.13 + 0.4
   440					var v := Vector2(cos(ang), sin(ang) * 0.7) * k * 34
   441					var c0: Vector2 = f["p"] + v + Vector2(0, k * k * 24)
   442					var r0 := 6.0 * (1.0 - k * 0.4)
   443					var rot := k * 7.0 + i
   444					var pts := PackedVector2Array()
   445					for j in 3:
   446						pts.append(c0 + Vector2(cos(rot + j * 2.1), sin(rot + j * 2.1)) * r0)
   447					draw_colored_polygon(pts, Color(0.93, 0.97, 1.0, 1 - k))
   448					draw_polyline(pts + PackedVector2Array([pts[0]]), Color(0.2, 0.25, 0.35, 1 - k), 1.2, true)
   449			"aim":
   450				# 警覺：金色瞄準線先拉出來，再淡掉
   451				var a2: Vector2 = f["a"]
   452				var b2: Vector2 = f["b"]
   453				var e2 := a2.lerp(b2, minf(1.0, k * 2.5))
   454				draw_dashed_line(a2, e2, Color(1, 0.84, 0.3, 0.6 * (1 - k)), 1.6, 6.0, true)
   455				draw_arc(b2, 9 - k * 3, 0, TAU, 16, Color(1, 0.84, 0.3, 1 - k), 2.0, true)
   456			"hide":
   457				# 皮甲：琥珀色弧光擋在中箭的那一側
   458				var d3: float = f["dir"]
   459				var c4: Vector2 = f["p"]
   460				var st := -1.1 if d3 > 0 else PI - 1.1
   461				draw_arc(c4, 15 + k * 6, st, st + 2.2, 14, Color(1, 0.66, 0.2, 0.95 * (1 - k)), 4.0 - k * 2, true)
   462			"trip":
   463				# 絆馬：一條白繩在腳邊繃斷，兩段往外彈
   464				var c5: Vector2 = f["p"]
   465				var gap := 2.0 + k * 14.0
   466				var drop := k * k * 8.0
   467				draw_line(c5 + Vector2(-24, 0), c5 + Vector2(-gap, drop), Art.OUT, 4.6, true)
   468				draw_line(c5 + Vector2(gap, drop), c5 + Vector2(24, 0), Art.OUT, 4.6, true)
   469				draw_line(c5 + Vector2(-24, 0), c5 + Vector2(-gap, drop), Color(1, 1, 1, 1 - k), 3.0, true)
   470				draw_line(c5 + Vector2(gap, drop), c5 + Vector2(24, 0), Color(1, 1, 1, 1 - k), 3.0, true)
   471				if k < 0.25:
   472					draw_circle(c5, 5.0 * (1.0 - k * 4.0), Color(1, 1, 1, 0.9), true, -1.0, true)   # 繃斷的閃白
   473			"vslash":
   474				# 背刺：一道粗的紫色斬痕
   475				var c6: Vector2 = f["p"]
   476				var dd: float = f["dir"]
   477				var a0 := Vector2(-18 * dd, -16)
   478				var a1 := Vector2(18 * dd, 16)
   479				var e3 := a0.lerp(a1, minf(1.0, k * 3.0))
   480				draw_line(c6 + a0, c6 + e3, Color(0.78, 0.49, 1.0, 1 - k), 6.0 * (1 - k * 0.6), true)
   481				draw_line(c6 + a0, c6 + e3, Color(1, 1, 1, 0.8 * (1 - k)), 1.6, true)
   482			"taunt":
   483				# 嘲諷：盾兵身邊擴散的橘色圈
   484				for j in 2:
   485					var kj := clampf(k * 1.4 - j * 0.3, 0.0, 1.0)
   486					draw_arc(f["p"], 10 + kj * 22, 0, TAU, 28, Color(1, 0.55, 0.15, 0.6 * (1 - kj)), 2.5, true)
   487			"bang":
   488				# 嘲諷：被吸過去的敵人頭上冒「!」
   489				var y4 := -sin(minf(1.0, k * 3.0) * PI * 0.5) * 8.0
   490				_text(f["p"] + Vector2(0, y4 - 10), "!", ts(22), Color(1, 0.6, 0.2, 1.0 - k * k), true, true)
   491			"hex":
   492				# 頂住：藍色六角波紋
   493				for j in 2:
   494					var kh := clampf(k * 1.3 - j * 0.25, 0.0, 1.0)
   495					var rr := 10.0 + kh * 22.0
   496					var hp := PackedVector2Array()
   497					for q in 7:
   498						var an := q * TAU / 6.0 + PI / 6.0
   499						hp.append(f["p"] + Vector2(cos(an), sin(an)) * rr)
