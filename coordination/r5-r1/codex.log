    98				ci.draw_polyline(PackedVector2Array([e + Vector2(-1.8 * sx, -2.0), e + Vector2(1.6 * sx, 0), e + Vector2(-1.8 * sx, 2.0)]), col, 1.4, true)
    99		if mood & M_SPARKLE:
   100			for e in eyes:
   101				ci.draw_circle(e, 2.9, Color(OUT, a), true, -1.0, true)
   102				_star(ci, e + Vector2(0.4, -0.6), 2.2, Color(1, 1, 1, a))
   103			# 槍尖金光（長槍放平時的槍尖位置）
   104			var tip := Vector2(-6, -30) + Vector2(cos(-0.55), sin(-0.55)) * 40.0
   105			var g := 0.6 + 0.4 * sin(t * 18.0)
   106			_star(ci, tip, 4.5 + g * 1.5, Color(1, 0.86, 0.3, a * g))
   107		if mood & M_BROWS:
   108			for i in 2:
   109				var e2: Vector2 = eyes[i]
   110				var inward := 1.0 if i == 0 else -1.0
   111				var bc := Color("#ffe066", a) if type == D.ASSASSIN else Color(OUT, a)
   112				ci.draw_line(e2 + Vector2(-2.2, -4.2 - inward * 0.9), e2 + Vector2(2.2, -4.2 + inward * 0.9), bc, 1.5, true)
   113		if mood & M_BRACE and type == D.SHIELD:
   114			# 頂住：盾放大 1.35 倍（以盾中心縮放）
   115			var cc := Vector2(12, -24)
   116			var k := 1.35
   117			var sh := PackedVector2Array()
   118			for q in [Vector2(5, -40), Vector2(19, -38), Vector2(19, -12), Vector2(12, -4), Vector2(5, -12)]:
   119				sh.append(cc + (q - cc) * k)
   120			_poly(ci, sh, STEEL, a)
   121			var inner := PackedVector2Array()
   122			for q2 in [Vector2(9, -33), Vector2(15, -32), Vector2(15, -16), Vector2(12, -12), Vector2(9, -16)]:
   123				inner.append(cc + (q2 - cc) * k)
   124			_poly(ci, inner, team_color(team, cb), a, false)
   125	
   126	static func _star(ci: CanvasItem, c: Vector2, r: float, col: Color) -> void:
   127		ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0, -r), c + Vector2(r * 0.28, -r * 0.28), c + Vector2(r, 0), c + Vector2(r * 0.28, r * 0.28),
   128			c + Vector2(0, r), c + Vector2(-r * 0.28, r * 0.28), c + Vector2(-r, 0), c + Vector2(-r * 0.28, -r * 0.28)]), col)
   129	
   130	static func _c(ci: CanvasItem, c: Vector2, r: float, col: Color, a: float, outline := true) -> void:
   131		if outline:
   132			ci.draw_circle(c, r + 1.6, Color(OUT, a), true, -1.0, true)
   133		ci.draw_circle(c, r, Color(col, col.a * a), true, -1.0, true)
   134	
   135	static func _poly(ci: CanvasItem, pts: PackedVector2Array, col: Color, a: float, outline := true) -> void:
extends SceneTree
## headless 測試：godot --headless --path game --script res://tests/run_tests.gd
## 印出每項 PASS/FAIL，最後一行是總結；有失敗就 exit 1。另外印出「指紋」給跨平台比對。

const D = preload("res://scripts/core/unit_defs.gd")
const Army = preload("res://scripts/core/army.gd")
const Sim = preload("res://scripts/core/battle_sim.gd")
const AI = preload("res://scripts/core/ai_army.gd")
const TP = preload("res://scripts/core/turn_placement.gd")
const MC = preload("res://scripts/core/mirror_check.gd")
const PZ = preload("res://scripts/game/puzzles.gd")
const CX = preload("res://scripts/game/codex.gd")
const BV = preload("res://scripts/ui/battle_view.gd")
const F = preload("res://scripts/core/formations.gd")
const Art = preload("res://scripts/ui/art.gd")

var passed := 0
var failed := 0

func ok(cond: bool, name: String, extra := "") -> void:
	if cond:
		passed += 1
		print("PASS ", name)
	else:
		failed += 1
		print("FAIL ", name, "  ", extra)

func _init() -> void:
	var t0 := Time.get_ticks_msec()
	test_army_rules()
	test_turn_placement()
	test_determinism_and_mirror()
	test_termination()
	test_traits()
	test_rule_fixes()
	test_suspense()
	test_codes_and_snake()
	test_rally()
	test_nav_r1()
	test_puzzle_solutions()
	test_codex()
	test_event_routes()
	test_ui_consumers()
	print("—— %d 通過 / %d 失敗（%d ms）" % [passed, failed, Time.get_ticks_msec() - t0])
	quit(1 if failed > 0 or passed == 0 else 0)

func army_from(team: int, spec: Array):
	var a = Army.new(team, 100)
	for s in spec:
		var col: int = s[1] if team == 0 else Army.COLS - 1 - s[1]
		a.units.append({"type": s[0], "col": col, "row": s[2]})
	return a

func test_army_rules() -> void:
	var a = Army.new(0, 100)
	ok(a.check_place(D.SWORD, 6, 0) != "", "部署區外不能放")
	ok(a.place(D.SWORD, 0, 0), "部署區內可以放")
	ok(not a.place(D.SHIELD, 0, 0), "同一格不能放兩隻")
	var b = Army.new(1, 100)
	ok(b.check_place(D.SWORD, 5, 0) != "" and b.check_place(D.SWORD, 10, 0) == "", "紅方部署區是 10～15 欄")
	a.clear()
	var n := 0
	for r in 9:
		for c in 6:
			if a.place(D.ARCHER, c, r):
				n += 1
	ok(n == 24 and a.spent() == 24 * D.cost(D.ARCHER), "最便宜的兵擺滿也只能放 24 隻（人數上限）", "n=%d" % n)
	a.clear()
	for i in 14:
		a.place(D.CAVALRY, i % 6, i / 6)
coordination/r5-r1/codex.prompt.md:1:# 程式輪 R5（Codex 唯讀，第 1 輪）
coordination/r5-r1/codex.prompt.md:9:- 測試新增 test_ui_consumers：用 game_screens.gd.new()＋假音效替身，把 6 場真實戰鬥逐 tick 交給 _sim_step（含 _on_event），檢查不報錯、每個攻擊 tick 都有 fx、緩衝排空；命中前一格已在前搖；圖鑑 _codex_tick 每段都跳字。已證明拔掉演出或跳字會紅。

codex
找到 4 項需修正；以下為唯讀靜態審查，未重跑測試。

1. **P2：末幀插值未播完，結算時跳位。**  
   `game/scripts/ui/battle_view.gd:23` 在 `view.finished` 後每幀清零 `accum`；但 `:259` 用它插值 `prev_pos→cur`，因此存活者停在倒數第二格位置，進 RESULT 才跳到最終位置。`:112` 的攻擊時鐘也凍住，最後一擊會卡姿勢。建議讓末格插值與攻擊後搖繼續完成，再停止展示時鐘。

2. **P2：未來反擊會覆蓋尚未展示的命中。**  
   `game/scripts/ui/battle_view.gd:105` 每次預填直接覆寫 `atk_hit[src]`。劍士反擊不受自身冷卻限制，多名刺客錯開命中可讓它連續 tick 反擊；例如展示到命中 H 時，H+2 已覆蓋紀錄，`:320` 算出的是下一次前搖起點，H 的揮擊就消失。`:119` 的最短 4 tick 也無法容納這種密集事件。建議保存每隻單位的命中時間序列，明訂重疊時的揮擊優先與後搖截斷規則。現行普通攻擊即使狂熱＋背水仍至少約 10 tick，短間隔主要來自反擊。

3. **P2：overlay 沒有完全沿用貼圖的實際變換。**  
   `game/scripts/ui/sprite_cache.gd:95` 攻擊時仍傳入 `quant_walk(walk)`，但攻擊貼圖在 `:124` 烘焙時 `walk=0`；移動中前搖／受擊時，眼睛與閃白會額外上下偏移。另外 `:91` 是對已烘焙姿勢外加 lean／crouch，overlay 卻重新呼叫 `unit_xf`，兩者的位移與縮放順序不同。建議記錄各影格烘焙用的局部矩陣，overlay 使用「貼圖外層矩陣 × 烘焙矩陣」；攻擊影格的走路相位固定為零。

4. **P2：測試仍可能假綠，未涵蓋上述播放問題。**  
   `game/tests/run_tests.gd:555` 只驗證有攻擊的 tick 中 `fx` 非空；同 tick 其他攻擊、嘲諷或狂熱文字都能掩蓋漏播。`:545` 直接呼叫 `_sim_step`，也沒有經過 `_battle_process`、末格插值及 RESULT 切換。建議逐事件核對來源／目標對應演出，加入連續反擊、末格仍移動的案例，並檢查最後位置與姿勢確實完成。

緩衝快照有複製事件與狀態；一般 advance 的位置插值連續，重播會重建緩衝，跳過及截圖會排到最後，影片沿用正常播放。未見畫面回寫模擬或破壞確定性的路徑。

可否繼續：建議先修正以上四項，再進下一輪。
