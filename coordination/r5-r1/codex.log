   115	## 三段式攻擊進度（R5）：前搖固定是命中前 DELAY 個 tick，揮擊與後搖依攻擊間隔壓縮（攻速快的兵動作也快，不會疊在一起）。
   116	## 回傳 Art.unit 的 atk 參數：0＝沒在攻擊；0～0.3125 前搖、0.3125～0.53125 揮擊（命中在 0.3125）、之後後搖到 1。
   117	static func atk_progress(dt: float, type: int) -> float:
   118		var period := float(D.STATS[type]["cd"]) / 4.0
   119		var tot := clampf(period, 4.0, 6.4)
   120		var w := float(ViewBuffer.DELAY)
   121		var st := 0.22 * tot
   122		var rc := tot - w - st
   123		if dt < 0.0 or dt >= tot:
   124			return 0.0
   125		var a: float
   126		if dt < w:
   127			a = Art.ATK_WINDUP * dt / w
   128		elif dt < w + st:
   129			a = Art.ATK_WINDUP + (Art.ATK_STRIKE - Art.ATK_WINDUP) * (dt - w) / st
   130		else:
   131			a = Art.ATK_STRIKE + (1.0 - Art.ATK_STRIKE) * (dt - w - st) / rc
   132		return maxf(a, 0.001)
   133	
