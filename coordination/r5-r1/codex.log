 succeeded in 328ms:
		if u.alive and u.team == team:
			p += u.cost * u.hp * 1000 / u.max_hp
	return p

func run_to_end() -> void:
	while not finished:
		step()

# ───────────────────────── 一個 tick ─────────────────────────
func step() -> void:
	if finished:
		return
	tick += 1
	frenzy = tick >= FRENZY_TICK
	events = []
	var n := units.size()

	# ① 快照（之後的選目標、碰撞都只讀這些陣列）
	var sx := PackedInt64Array()
	var sy := PackedInt64Array()
	var st := PackedInt64Array()     # 隊伍
	var sk := PackedInt64Array()     # 兵種
	var sh := PackedInt64Array()     # 血
	var sv := PackedByteArray()      # 可被選為目標（活著且沒潛行）
	sx.resize(n); sy.resize(n); st.resize(n); sk.resize(n); sh.resize(n); sv.resize(n)
	for i in n:
		var u := units[i]
		sx[i] = u.x
		sy[i] = u.y
		st[i] = u.team
		sk[i] = u.type
		sh[i] = u.hp
		sv[i] = 1 if (u.alive and u.stealth == 0) else 0

	# ② 選目標＋提出移動
	var nx := sx.duplicate()
	var ny := sy.duplicate()
	var new_target := PackedInt64Array()
	var new_fx := PackedInt64Array()
	var new_fy := PackedInt64Array()
	var new_lock := PackedInt64Array()
	new_target.resize(n); new_fx.resize(n); new_fy.resize(n); new_lock.resize(n)
	for i in n:
		var u := units[i]
		new_target[i] = u.target
		new_fx[i] = u.fx
	var stun_set := {}
	var slow_set := {}
	var reveal := {}
	var knock: Array = []
	var attacked := PackedByteArray()
	attacked.resize(n)
	var sword_hit_by := {}   # 劍士索引 → 這一 tick 打中它的刺客索引們
	var dec := D.FRENZY_CD_RATE if frenzy else 4
	# 背水（追趕機制，預設關閉）：用這一 tick 開始時的戰力判斷，兩隊同時算
	var rally_bonus := [0, 0]
	rally = [false, false]
	if D.RALLY_RATIO_PCT > 0:
		var pw := [power(0), power(1)]
		for tm in 2:
			if pw[tm] * 100 < pw[1 - tm] * D.RALLY_RATIO_PCT:
				rally_bonus[tm] = D.RALLY_CD_BONUS
				rally[tm] = true
	for tm in 2:
		if rally[tm] != _was_rally[tm]:
			events.append({"kind": "rally_on" if rally[tm] else "rally_off", "team": tm, "tags": ["rally"]})
			_was_rally[tm] = rally[tm]
	for i in n:
		var u := units[i]
		if not u.alive:
			continue
		if u.cd > 0:
			u.cd = maxi(0, u.cd - dec - rally_bonus[u.team])
		if u.stun > 0 or u.target == -1 or u.cd > 0:
			continue
		var tg := units[u.target]
		if M.dist2(u.x, u.y, tg.x, tg.y) > u.reach * u.reach:
			continue
		if u.type == D.ASSASSIN and u.stealth > 0 and not _is_behind(u, tg):
			continue
		var dmg := u.atk
		var kind := "hit"
		var tags: Array = []
		if u.type == D.SHIELD and tg.type == D.CAVALRY:
			dmg = dmg * D.ANTICAV_NUM / D.ANTICAV_DEN
			kind = "anticav"
			tags.append("anticav")
		if u.type == D.SWORD:
			if tg.type == D.SHIELD:
				dmg = dmg * D.BREAKER_NUM / D.BREAKER_DEN
				kind = "breaker"
				tags.append("breaker")
		elif u.type == D.ARCHER:
			kind = "arrow"
			tags.append("arrow")
			if tg.type == D.ASSASSIN:
				dmg = dmg * D.ALERT_NUM / D.ALERT_DEN
				tags.append("alert")
			if tg.type == D.SHIELD and not _is_behind(u, tg):
				dmg = dmg * D.BLOCK_NUM / D.BLOCK_DEN
				kind = "blocked"
				tags.append("blocked")
			elif tg.type == D.CAVALRY:
				dmg = dmg * D.HIDE_ARROW_NUM / D.HIDE_ARROW_DEN
				tags.append("hide")
		elif u.type == D.CAVALRY:
			if u.charge >= D.CHARGE_NEED:
				if tg.type == D.SHIELD and not _is_behind(u, tg):
					stun_set[i] = true
					kind = "braced"
					tags.append("braced")
				else:
					dmg = dmg * D.CHARGE_NUM / D.CHARGE_DEN
					kind = "charge"
					tags.append("charge")
					knock.append([u.target, tg.x - u.x, tg.y - u.y])
		elif u.type == D.ASSASSIN:
			if _is_behind(u, tg):
				dmg = dmg * D.BACKSTAB_NUM / D.BACKSTAB_DEN
				kind = "backstab"
				tags.append("backstab")
			if tg.type == D.CAVALRY:
				slow_set[u.target] = true
				tags.append("trip")
			reveal[i] = true
			if tg.type == D.SWORD:
				if not sword_hit_by.has(u.target):
					sword_hit_by[u.target] = []
				sword_hit_by[u.target].append(i)
		if tags.is_empty():
			tags.append("hit")
		hits.append([i, u.target, dmg, kind, tags])
		attacked[i] = 1
		u.cd += u.cd_base * 4
		if u.type == D.CAVALRY:
			u.charge = 0   # 任何一擊之後都要重新直行才能再衝
	# 劍士反擊（優化方案 B1）：這一 tick 打中它的刺客裡，挑「最近→列小→離自己底線近」的那一隻，每 tick 最多一次
	var swords := sword_hit_by.keys()
	swords.sort()
	for si in swords:
		var sw := units[si]
		hits.append([si, pick_counter(si, sword_hit_by[si]), sw.atk * D.COUNTER_PCT / 100, "counter", ["counter"]])

	# ⑤ 同時結算
	var dmg_in := PackedInt64Array()
	dmg_in.resize(n)
	var last_hit := PackedInt64Array()
	last_hit.resize(n)
	last_hit.fill(-1)
	var per_pair := {}   # (目標, 攻擊者) → 這一 tick 的傷害
	for h in hits:
		dmg_in[h[1]] += h[2]
		units[h[0]].dmg_dealt += h[2]
		units[h[1]].dmg_taken += h[2]
		var key: int = h[1] * 4096 + h[0]
		per_pair[key] = int(per_pair.get(key, 0)) + h[2]
		events.append({"src": units[h[0]].id, "tgt": units[h[1]].id, "dmg": h[2], "kind": h[3], "tags": h[4]})
	# 擊殺歸屬：傷害最高者；同傷害比列小、再比離自己底線近（只用鏡像不變的鍵）
	var best_d := PackedInt64Array()
	best_d.resize(n)
	for key in per_pair:
		var tgt: int = key / 4096
		var src: int = key % 4096
		var d: int = per_pair[key]
		var cur: int = last_hit[tgt]
		var better := cur == -1 or d > best_d[tgt]
		if not better and d == best_d[tgt]:
			var a := units[src]
			var b := units[cur]
			var da: int = a.x if a.team == 0 else W - a.x
			var db: int = b.x if b.team == 0 else W - b.x
			better = a.y < b.y or (a.y == b.y and da < db)
		if better:
			last_hit[tgt] = src
			best_d[tgt] = d
	# 狂熱耗損：第 1200+100k tick（k＝0～5）扣 (k+1)×STEP% 滿血（至少 1）
	if tick >= FRENZY_TICK and (tick - FRENZY_TICK) % 100 == 0 and (tick - FRENZY_TICK) / 100 <= 5:
	if not FileAccess.file_exists("res://data/counter_lib.json"):
		return []
	var p = JSON.parse_string(FileAccess.get_file_as_string("res://data/counter_lib.json"))
	return p if typeof(p) == TYPE_ARRAY else []


func _begin_battle(a0, a1) -> void:
	last_armies = [a0.copy(), a1.copy()]
	sim = Sim.new(a0, a1)
	view = ViewBuffer.new(sim)
	atk_hit.clear()
	brace_t.clear()
	state = St.BATTLE
	prev_pos.clear()
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	_pump_view()   # 開場先預填 DELAY 個 tick
	accum = 0.0
	slow_used = false
	slow_left = 0.0
	hitstop = 0.0
	zoom = 1.0
	zoom_target = 1.0
	fx.clear()
	dying.clear()
	atk_t.clear()
	hurt_t.clear()
	ev_count = {}
	frenzy_seen = false
	result_delay = 0.0
	pt_call_tick = -1
	pt_rated = false
	_focus = 0
	speed = float(Save.s("speed"))
	sfx.play("start")
	sfx.play_music("music_battle")


func _finish_battle() -> void:
	state = St.RESULT
	_focus = 0
	slow_left = 0.0
	zoom_target = 1.0
	var w: int = sim.winner
	if w >= 0:
		wins[w] += 1
	series_over = wins[0] >= 2 or wins[1] >= 2 or round_no >= 5
	_build_report()
	if mode == Mode.DUEL:
		sfx.play("win" if w >= 0 else "lose")
	else:
		sfx.play("win" if w == 0 else "lose")
	_progress_and_achievements()
	Save.playtest_log(_pt_entry(0))


func _pt_entry(rating: int) -> Dictionary:
	return {"event": "rating" if rating > 0 else "battle", "mode": _mode_label(), "round": round_no, "winner": sim.winner,
		"ticks": sim.tick, "reason": sim.reason, "blue": last_armies[0].to_code(), "red": last_armies[1].to_code(),
		"power": [sim.power(0), sim.power(1)], "suspense": report.get("sus", {}), "call_tick": pt_call_tick,
		"rating": rating, "rules": D.RULES_VERSION, "digest": D.data_digest()}
		KEY_SPACE, KEY_TAB:
			_on_start()
		KEY_ESCAPE:
			_go_title()


# ───────────────────────── 每幀 ─────────────────────────
func _process(delta: float) -> void:
	var _t0 := Time.get_ticks_usec()
	_process_inner(delta)
	perf_proc_us = Time.get_ticks_usec() - _t0

func _process_inner(delta: float) -> void:
	time += delta
	SteamApi.run_callbacks()
	if toast_t > 0:
		toast_t -= delta
	if ach_t > 0:
		ach_t -= delta
	elif not ach_queue.is_empty():
		toast = ach_queue.pop_front()
		toast_t = 2.5
		ach_t = 2.6
	shake = maxf(0.0, shake - delta)
	if not freeze_fx:
		for f in fx:
			f["t"] += delta
		fx = fx.filter(func(f): return f["t"] < f["dur"])
	for g in dying:
		g["t"] += delta
	dying = dying.filter(func(g): return g["t"] < 1.0)
	if overlay == "codex":
		_codex_tick(delta)
	if state == St.TITLE and demo != null and shot_dir == "":
		demo_acc += delta
		while demo_acc >= 0.05:
			demo_acc -= 0.05
			demo.step()
		if demo.finished:
			_new_demo()
	if state == St.BATTLE and shot_dir == "":
		_battle_process(delta)
	elif state == St.RESULT:
		zoom = lerpf(zoom, 1.0, delta * 4)
	queue_redraw()


# ───────────────────────── 繪圖 ─────────────────────────
func _draw() -> void:
	var _t0 := Time.get_ticks_usec()
	_draw_inner()
	perf_draw_us = Time.get_ticks_usec() - _t0

func _draw_inner() -> void:
	_btns.clear()
	if capsule_path != "":
		_draw_capsule()
		return
	draw_rect(Rect2(0, 0, 1280, 800), Color("#1b2a1f"))
	var cam := Transform2D.IDENTITY
	if state == St.BATTLE or state == St.RESULT:
		var off := Vector2.ZERO
		if shake > 0 and bool(Save.s("shake")):
			off = Vector2(sin(time * 90) * 2, cos(time * 77) * 2)
		var w := clampf((zoom - 1.0) / 0.5, 0.0, 1.0)
		var c := (ORIGIN + FIELD / 2).lerp(zoom_center, w)
		var half := Vector2(640, 388) / zoom
		var lo := ORIGIN + half - Vector2(60, 100)
		var hi := ORIGIN + FIELD - half + Vector2(60, 100)
		wins = [0, 0]
		round_no = 1
		series_over = false
		last_player_formation = []
		_reset_place(false)
		return
	round_no += 1
	_reset_place(mode == Mode.VS_AI)


func _replay() -> void:
	var w: int = sim.winner
	if w >= 0:
		wins[w] -= 1
	series_over = false
	_begin_battle(last_armies[0].copy(), last_armies[1].copy())


func _next_puzzle() -> void:
	var list: Array = PZ.tutorials() if mode == Mode.TUTORIAL else PZ.puzzles()
	for i in list.size():
		if list[i]["id"] == puzzle_id and i + 1 < list.size():
			puzzle_id = list[i + 1]["id"]
			_start_mode(mode)
			return
	if mode == Mode.TUTORIAL and not PZ.puzzles().is_empty():
		puzzle_id = PZ.puzzles()[0]["id"]
		_start_mode(Mode.PUZZLE)
		return
	_go_title()


func _gauntlet_next() -> void:
	gauntlet_prev = last_armies[0].units.duplicate(true)
	gauntlet_stage += 1
	gauntlet_changes = 3
	get_viewport().get_texture().get_image().save_png(shot_dir.path_join(name))
	print("SHOT ", name)


## 實機影片（N6 預告素材）：用 Godot 錄影模式跑（--write-movie 絕對路徑 --fixed-fps 30），全程自動。
func _run_video() -> void:
	await get_tree().create_timer(2.5).timeout
	difficulty = 1
	_start_mode(Mode.VS_AI)
	var plan := [[D.SHIELD, 5, 3], [D.SHIELD, 5, 5], [D.SWORD, 4, 2], [D.SWORD, 4, 6], [D.SWORD, 4, 4],
		[D.ARCHER, 1, 3], [D.ARCHER, 1, 5], [D.ARCHER, 0, 4], [D.CAVALRY, 3, 0], [D.CAVALRY, 3, 8], [D.ASSASSIN, 2, 4],
			[D.ARCHER, 1, 2], [D.ARCHER, 1, 6], [D.SWORD, 4, 3], [D.SWORD, 4, 5], [D.CAVALRY, 3, 4], [D.ASSASSIN, 2, 2], [D.SHIELD, 5, 4]]
	for s2 in plan:
		selected = s2[0]
		mouse = ORIGIN + Vector2(s2[1] + 0.5, s2[2] + 0.5) * CS
		await get_tree().create_timer(0.35).timeout
		_try_place(Vector2i(s2[1], s2[2]))
	await get_tree().create_timer(1.0).timeout
	var red_pick = null
	for k in 120:
		var r := RandomNumberGenerator.new()
		r.seed = 777 + k
		var cand = AI.build(1, 100, r)["army"]
		if _would_clutch(armies[0], cand):
			red_pick = cand
			break
	last_player_formation = armies[0].units.duplicate(true)
	ai_name = L.t("diff_normal")
	_begin_battle(armies[0].copy(), (red_pick if red_pick != null else AI.build(1, 100, rng)["army"]).copy())
	while state != St.RESULT:
		await get_tree().process_frame
	await get_tree().create_timer(4.0).timeout
	get_tree().quit()


func _would_clutch(a0, a1) -> bool:
	var t = Sim.new(a0.copy(), a1.copy())
	t.fast = true
	var tot := float(t.budget * 1000)
	while not t.finished:
		t.step()
		var p0: float = t.power(0) * 100.0 / tot
		var p1: float = t.power(1) * 100.0 / tot
		if absf(p0 - p1) <= 15.0 and ((p0 <= 30.0 and p1 <= 30.0) or (t.alive_count(0) <= 3 and t.alive_count(1) <= 3)) and not t.finished:
			return true
	return false


