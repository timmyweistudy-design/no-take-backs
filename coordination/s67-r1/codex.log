   127		return [1.0, 1.0 if close else 0.35, 1.0]
   128	
   129	func set_layer_targets(g: Array) -> void:
   130		layer_gain = g
   131	
   132	func _process(delta: float) -> void:
   133		if music_name != "layers" or layers.is_empty():
   134			return
   135		for i in layers.size():
   136			layer_cur[i] = move_toward(layer_cur[i], layer_gain[i], delta * 1.5)
   137			layers[i].volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * layer_cur[i]))
   138	
   139	func play_music(name: String) -> void:
