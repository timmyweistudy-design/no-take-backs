   148		var st = load("res://audio/%s.wav" % name)
   149		if st == null:
   150			music.stop()
   151			return
   152		music.stream = st
   153		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
   154		music.play()
