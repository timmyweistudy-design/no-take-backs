   108				if st is AudioStreamWAV:
   109					st.loop_mode = AudioStreamWAV.LOOP_FORWARD
   110					st.loop_begin = 0
   111					st.loop_end = st.data.size() / 2
   112				p.stream = st
   113				layers.append(p)
   114		layer_cur = layer_gain.duplicate()
