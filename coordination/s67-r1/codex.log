   168	# ── 覆盤 ──
   169	func _open_review() -> void:
   170		rv_orig = last_armies[0].copy()
   171		rv_army = last_armies[0].copy()
   172		rv_enemy = last_armies[1].copy()
   173		rv_sel = Vector2i(-1, -1)
   174		rv_result = {}
   175		rv_base = review_run(rv_orig, rv_enemy)
   176		_open("review")
   177	
   178	## 跟原本比改了幾隻（換兵種、移位、拿掉、新增都算一隻）。
   179	static func review_changes(orig, now) -> int:
   180		var a := {}
   181		var b := {}
   182		for u in orig.units:
   183			a["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   184		for u in now.units:
   185			b["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   186		var gone := 0
   187		var added := 0
   188		for k in a:
   189			if not b.has(k) or b[k] != a[k]:
   190				gone += 1
   191		for k in b:
   192			if not a.has(k) or a[k] != b[k]:
   193				added += 1
   194		return maxi(gone, added)
   195	
   196	func _rv_try(edit: Callable) -> void:
   197		var before = rv_army.copy()
   198		edit.call()
   199		if review_changes(rv_orig, rv_army) > 1:
   200			rv_army = before
   201			_toast(L.t("rv_one"), true)
   202			return
   203		rv_result = {}
