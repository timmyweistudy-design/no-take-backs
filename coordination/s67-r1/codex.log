diff --git a/game/tools/balance_report.py b/game/tools/balance_report.py
index f99177b..ccfe23b 100644
--- a/game/tools/balance_report.py
+++ b/game/tools/balance_report.py
@@ -30,6 +30,20 @@ def load(folder):
 def pct(a, b):
     return 0 if b == 0 else round(100 * a / b)
 
+def wilson(k, n, z=1.96):
+    """比例的 95% 信賴區間（Wilson），回傳 (低%, 高%)。第三輪 B1：每個勝率都附區間。"""
+    if n == 0:
+        return (0, 0)
+    p = k / n
+    d = 1 + z * z / n
+    c = p + z * z / (2 * n)
+    h = z * ((p * (1 - p) / n + z * z / (4 * n * n)) ** 0.5)
+    return (round(100 * (c - h) / d), round(100 * (c + h) / d))
+
+def ci(k, n):
+    lo, hi = wilson(k, n)
+    return f"{pct(k, n)}%（95% 區間 {lo}～{hi}%）"
+
 def main():
     folder = sys.argv[1]
