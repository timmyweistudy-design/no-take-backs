+# ── 分軌戰鬥音樂（第三輪 S1）：低音、鼓、旋律三軌同時播、各自調音量 ──
+const LAYERS := ["music_battle_bass", "music_battle_drums", "music_battle_mel"]
+var layers: Array[AudioStreamPlayer] = []
