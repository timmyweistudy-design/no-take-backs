    85	func league(shard: int, shards: int, val := false) -> void:
    86		var pool := F.validation_pool(0) if val else F.training_pool(0)
    87		for i in pool.size():
    88			if i % shards != shard:
    89				continue
    90			for k in 12:
    91				var j := (i * 37 + k * 53 + 1) % pool.size()
    92				if j == i:
    93					j = (j + 1) % pool.size()
    94				# 交換左右各打一次：i 當藍方、i 當紅方（結果都以 i 的角度記錄）
    95				for side in 2:
    96					var r := fight(pool[i], pool[j]) if side == 0 else fight(pool[j], pool[i])
    97					if side == 1:
    98						r["res"] = -r["res"]
    99					r["mode"] = "valleague" if val else "league"; r["a"] = i; r["b"] = j; r["k"] = k; r["side"] = side; r["comp"] = F.composition(pool[i])
   100					emit(r)
