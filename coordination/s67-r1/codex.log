   106		var rng := RandomNumberGenerator.new()
   107		for g in games:
   108			if g % shards != shard:
   109				continue
   110			# 成對：同一個種子打兩場，只交換先手（隔離先後手效果）
   111			rng.seed = 424242 + (g / 2) * 104729
   112			var first := g % 2
   113			var tp := TP.new(Army.new(0, 100), Army.new(1, 100), first, rule)
   114			var guard := 0
   115			while not tp.done() and guard < 100:
   116				guard += 1
   117				AIT.play_turn(tp, rng, level)
   118			var s := Sim.new(tp.armies[0], tp.armies[1])
   119			s.fast = true
   120			s.run_to_end()
   121			var first_won := 0
   122			if s.winner == first:
   123				first_won = 1
   124			elif s.winner == 1 - first:
   125				first_won = -1
   126			emit({"mode": "turns", "rule": rule, "game": g, "first": first, "first_won": first_won,
