+
+func play_layers() -> void:
+	music.stop()
+	music_name = "layers"
+	if layers.is_empty():
+		for n in LAYERS:
+			var p := AudioStreamPlayer.new()
+			add_child(p)
+			var st = load("res://audio/%s.wav" % n)
+			if st is AudioStreamWAV:
+				st.loop_mode = AudioStreamWAV.LOOP_FORWARD
+				st.loop_begin = 0
