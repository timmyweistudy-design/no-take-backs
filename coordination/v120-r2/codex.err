     1	#!/usr/bin/env bash
     2	# 版面檢查（第三輪 T4）：用 Windows 版 Godot 跑截圖模式，兩種語言 × 三種字級，彙整 layout.jsonl。
     3	# 用法：tools/layout_check.sh <Godot 執行檔> <輸出資料夾（WSL 路徑）>
     4	set -uo pipefail
     5	cd "$(dirname "$0")/.."
     6	EXE="$1"; OUT="$2"
     7	# 第七輪 I5：只准清自己產生的輸出夾（有記號檔），或空資料夾；其他一律拒絕，不再無條件 rm -rf
     8	MARK=".ntb-layout-output"
     9	if [ -d "$OUT" ] && [ -n "$(ls -A "$OUT" 2>/dev/null)" ]; then
    10	  if [ ! -f "$OUT/$MARK" ]; then
    11	    echo "LAYOUT FAIL：$OUT 已有內容但不是版面檢查的輸出夾，不會刪除。請換一個新資料夾。"; exit 2
    12	  fi
    13	  rm -rf "$OUT"
    14	fi
    15	mkdir -p "$OUT"; : > "$OUT/$MARK"
    16	# Windows／WSL／Linux 都能跑：有 wslpath 才轉路徑
    17	winpath() { if command -v wslpath >/dev/null 2>&1 && [[ "$EXE" == *.exe ]]; then wslpath -w "$1"; else printf '%s' "$1"; fi; }
    18	# WSL 的 timeout 只殺得到包裝程序，Windows 上的視窗會留著繼續跑：逾時要連它一起關（只關這次輸出夾的）
    19	kill_win() { if [[ "$EXE" == *.exe ]]; then powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name like 'Godot%'\" | Where-Object { \$_.CommandLine -like '*--shot=$(winpath "$1")*' } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force }" >/dev/null 2>&1; fi; }
    20	# 第九輪 P0：LAYOUT_QUICK=1 只跑中文 100%＋英文 150%（最容易出事的兩組）；里程碑跑 6 組
    21	COMBOS="zh_TW:100 zh_TW:125 zh_TW:150 en:100 en:125 en:150"
    22	[ "${LAYOUT_QUICK:-0}" = "1" ] && COMBOS="zh_TW:100 en:150"
    23	for combo in $COMBOS; do
    24	  lang="${combo%%:*}"; sc="${combo##*:}"
    25	  {
    26	    d="$OUT/${lang}_${sc}"; mkdir -p "$d"
    27	    timeout 600 "$EXE" --path "$(winpath .)" --resolution 1280x800 -- --shot="$(winpath "$d")" --shot-lang=$lang --shot-text=$sc --layout-check > "$d/run.log" 2>&1 \
    28	      || { echo "LAYOUT FAIL：$lang $sc% 截圖程式 exit 非 0"; kill_win "$d"; exit 1; }
    29	    grep -E "SCRIPT ERROR|Parse Error" "$d/run.log" >/dev/null && { echo "LAYOUT FAIL：$lang $sc% 有腳本錯誤"; exit 1; }
    30	    grep -q "PADWALK OK" "$d/run.log" || { echo "LAYOUT FAIL：$lang $sc% 手把流程：$(grep PADWALK "$d/run.log" | cut -c1-400)"; exit 1; }
    31	  }
    32	done
    33	EXPECT=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | wc -l)
    34	NAMES=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | sed 's/_snap("//; s/")//' | sort | tr '\n' ',')
    35	python3 - "$OUT" "$EXPECT" "$NAMES" <<'PY'
    36	import json,sys,glob,os
    37	out=sys.argv[1]; expect=int(sys.argv[2]); names=set(x for x in sys.argv[3].split(',') if x); total=0; rows=[]
    38	for f in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    39	    for line in open(f,encoding='utf-8'):
    40	        d=json.loads(line); total+=len(d['violations']); rows.append(d)
    41	warns=sum(len(d.get('warnings',[])) for d in rows)
    42	# 第五輪：每組都要剛好是 dev_main.gd 列出的那些畫面（不能用重複畫面湊張數）
    43	for f2 in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    44	    got=[json.loads(l)['shot'] for l in open(f2,encoding='utf-8')]
    45	    if sorted(got)!=sorted(names) or len(set(got))!=len(got):
    46	        print('LAYOUT FAIL：%s 的畫面集合不對（少了 %s、多了 %s）' % (f2, sorted(names-set(got)), sorted(set(got)-names))); sys.exit(1)
    47	by={}
    48	for d in rows: by.setdefault((d['lang'],d['scale']),[]).append(d['median_size'])
    49	print('LAYOUT 截圖 %d 張、違規 %d' % (len(rows), total))
    50	for d in rows:
    51	    for v in d['violations']: print('  %s %s %d%%：%s' % (d['shot'], d['lang'], d['scale'], v))
    52	for lang in ['zh_TW','en']:
    53	    if (lang,100) in by and (lang,150) in by:
    54	        a=sorted(by[(lang,100)]); b=sorted(by[(lang,150)])
    55	        print('  %s 中位字級 100%%=%s 150%%=%s' % (lang, a[len(a)//2], b[len(b)//2]))
    56	runs=glob.glob(os.path.join(out,'*','layout.jsonl'))
    57	want=len(runs) if os.environ.get('LAYOUT_QUICK')=='1' else 6
    58	if len(runs)!=want or len(rows)!=want*expect:
    59	    print('LAYOUT FAIL：應有 6 組 × %d 張，實得 %d 組、%d 張（截圖沒跑完也算失敗）' % (expect, len(runs), len(rows))); sys.exit(1)
    60	sys.exit(1 if total else 0)
    61	PY
109:func _layout_report(name: String) -> void:
