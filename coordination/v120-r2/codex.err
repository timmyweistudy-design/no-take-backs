     1	#!/usr/bin/env python3
     2	"""字型子集化（優化方案 I）：只留遊戲用得到的字，Noto Sans TC 從 5.7 MB 縮到幾百 KB。
     3	改了任何中文文案（strings.csv、puzzles.json、credits.txt、程式裡的字）都要重跑。
     4	用法：python3 tools/gen/build_font.py <Noto 原檔資料夾>
     5	"""
     6	import sys, os, glob, re
     7	from fontTools import subset
     8	
     9	src = sys.argv[1]
    10	root = os.path.join(os.path.dirname(__file__), "..", "..")
    11	chars = set()
    12	for pat in ["data/*.csv", "data/*.json", "data/*.txt", "scripts/**/*.gd"]:
    13	    for f in glob.glob(os.path.join(root, pat), recursive=True):
    14	        txt = open(f, encoding="utf-8").read()
    15	        # V9：程式碼只算字串常值，註解的字不必進字型
    16	        chars.update("".join(re.findall(r'"(?:[^"\\\n]|\\.)*"', txt)) if f.endswith(".gd") else txt)
    17	chars.update(chr(c) for c in range(0x20, 0x7F))
    18	chars.update("★☆✓✗✦●◆■□｜・…×％（）：，。！？「」、")
    19	text = "".join(sorted(c for c in chars if c.isprintable()))
    20	os.makedirs(os.path.join(root, "fonts"), exist_ok=True)
    21	for w in ["Regular", "Bold"]:
    22	    out = os.path.join(root, "fonts", f"NotoSansTC-{w}-sub.otf")
    23	    opts = subset.Options()
    24	    opts.layout_features = ["*"]
    25	    opts.name_IDs = ["*"]
    26	    sub = subset.Subsetter(opts)
    27	    font = subset.load_font(os.path.join(src, f"NotoSansTC-{w}.otf"), opts)
    28	    sub.populate(text=text)
    29	    sub.subset(font)
    30	    subset.save_font(font, out, opts)
    31	    print(w, len(text), "字", os.path.getsize(out) // 1024, "KB")
    32	
    33	# 第五輪：標題字 UoqMunThenKhung（SIL OFL 1.1，取自 timmy-project）。只用在 ≥22px 的粗體標題；
    34	# 同一份字集子集化，原字型沒有的字由思源黑體 Bold 補（ui_base 設定 fallbacks），並印出缺字數。
    35	from fontTools.ttLib import TTFont
    36	tk_src = os.path.join(src, "ThenKhung-Regular.ttf")
    37	if os.path.exists(tk_src):
    38	    out = os.path.join(root, "fonts", "ThenKhung-sub.ttf")
    39	    opts = subset.Options()
    40	    opts.layout_features = ["*"]
    41	    opts.name_IDs = ["*"]
    42	    sub = subset.Subsetter(opts)
    43	    font = subset.load_font(tk_src, opts)
    44	    cmap = font.getBestCmap()
    45	    missing = [c for c in text if ord(c) not in cmap and not c.isspace()]
    46	    sub.populate(text=text)
    47	    sub.subset(font)
    48	    subset.save_font(font, out, opts)
    49	    got = TTFont(out).getBestCmap()
    50	    lost = [c for c in text if ord(c) in cmap and ord(c) not in got]
    51	    if lost:
    52	        sys.exit("標題字子集漏字：" + "".join(lost[:40]))
    53	    open(os.path.join(root, "fonts", "ThenKhung-missing.txt"), "w", encoding="utf-8").write("".join(missing))
    54	    print("ThenKhung", len(text) - len(missing), "字（原字型沒有 %d 字，由思源黑體補）" % len(missing), os.path.getsize(out) // 1024, "KB")
    55	else:
    56	    print("（沒有 ThenKhung-Regular.ttf，略過標題字）")
