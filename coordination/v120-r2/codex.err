   124	func _wrap(s: String, size: int, width: float) -> String:
   125		var out: PackedStringArray = []
   126		for para in s.split("\n"):
   127			var line := ""
   128			var tokens: Array = []
   129			var word := ""
   130			for ch in para:
   131				if ch == " ":
   132					tokens.append(word + " ")
   133					word = ""
   134				elif ch.unicode_at(0) > 0x2E80:
   135					if word != "":
   136						tokens.append(word)
   137						word = ""
   138					tokens.append(ch)
   139				else:
   140					word += ch
   141			if word != "":
   142				tokens.append(word)
   143			for tk in tokens:
   144				if line != "" and font.get_string_size(line + tk, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x > width:
   145					out.append(line.strip_edges(false, true))
   146					line = tk.strip_edges(true, false) if tk == " " else tk
   147				else:
   148					line += tk
   149			out.append(line)
   150		return "\n".join(out)
