    24	
    25	# ── 三段式攻擊（第二輪方案 R5）──
    26	# atk（0～1）＝一次攻擊動作的進度：0～ATK_WINDUP 前搖、ATK_WINDUP～ATK_STRIKE 揮擊（命中就在 ATK_WINDUP 那一刻）、之後後搖。
    27	const ATK_WINDUP := 0.3125
    28	const ATK_STRIKE := 0.53125
    29	const LEAN_BACK := 0.2618     # 前搖身體後傾 15°（第三輪 R1，原 12°）
    30	const LEAN_FWD := 0.3840      # 揮擊前撲 22°（第三輪 R1，原 18°）
    31	
    32	# 臉部疊加（表情）：同一份畫法同時給直接繪製與精靈圖快取用，兩條路看起來一樣
    33	const M_HURT := 1             # 受擊／暈眩：>< 眼
    34	const M_SPARKLE := 2          # 騎兵衝鋒蓄滿：亮晶晶眼＋槍尖金光
    35	const M_BROWS := 4            # 狂熱：眉毛內傾
    36	const M_HOOD := 8             # 刺客潛行：帽簷壓低、黃眼每 0.4 秒眨一次
    37	const M_BRACE := 16           # 盾兵頂住：盾放大 1.35 倍
    38	
    39	# 第八輪：通用表情疊加用的眼睛位置（其他新兵的臉不適合疊）
    40	const FEATURE_EYES := {10: Vector2(1.5, -13), 13: Vector2(3, -17), 18: Vector2(3, -33), 19: Vector2(1, -31), 20: Vector2(2, -11)}
    41	
    42	
    43	static func team_color(team: int, cb := false) -> Color:
    44		return TEAM[1 if cb else 0][team]
    45	
    46	
    47	static func _smooth(u: float) -> float:
    48		return u * u * (3.0 - 2.0 * u)
    49	
    50	
    51	static func _star(ci: CanvasItem, c: Vector2, r: float, col: Color) -> void:
    52		ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0, -r), c + Vector2(r * 0.28, -r * 0.28), c + Vector2(r, 0), c + Vector2(r * 0.28, r * 0.28),
    53			c + Vector2(0, r), c + Vector2(-r * 0.28, r * 0.28), c + Vector2(-r, 0), c + Vector2(-r * 0.28, -r * 0.28)]), col)
    54	
    55	
    56	static func _c(ci: CanvasItem, c: Vector2, r: float, col: Color, a: float, outline := true) -> void:
    57		if outline:
    58			ci.draw_circle(c, r + 1.6, Color(OUT, a), true, -1.0, true)
    59		ci.draw_circle(c, r, Color(col, col.a * a), true, -1.0, true)
    60	
    61	
    62	static func _poly(ci: CanvasItem, pts: PackedVector2Array, col: Color, a: float, outline := true) -> void:
    63		if outline:
    64			var closed := pts.duplicate()
    65			closed.append(pts[0])
    66			ci.draw_polyline(closed, Color(OUT, a), 3.2, true)
    67		ci.draw_colored_polygon(pts, Color(col, col.a * a))
    68	
    69	
    70	static func _line(ci: CanvasItem, a: Vector2, b: Vector2, col: Color, w: float, al: float) -> void:
    71		ci.draw_line(a, b, Color(OUT, al), w + 3.0, true)
    72		ci.draw_line(a, b, Color(col, col.a * al), w, true)
    73	
    74	
    75	static func _eyes(ci: CanvasItem, c: Vector2, a: float, t: float, angry := false) -> void:
    76		var blink := 1.0 if fmod(t + c.x * 0.13, 3.7) > 0.12 else 0.15
    77		for dx in [-3.0, 4.0]:
    78			var e := c + Vector2(dx, 0)
    79			ci.draw_circle(e, 2.6, Color(OUT, a), true, -1.0, true)
    80			if blink > 0.5:
    81				ci.draw_circle(e + Vector2(0.7, -0.8), 0.9, Color(1, 1, 1, a), true, -1.0, true)
    82			else:
    83				ci.draw_rect(Rect2(e - Vector2(2.6, 0.6), Vector2(5.2, 1.2)), Color(SKIN, a))
    84		ci.draw_circle(c + Vector2(-6.5, 4.0), 2.4, Color(BLUSH, BLUSH.a * a), true, -1.0, true)
    85		ci.draw_circle(c + Vector2(7.5, 4.0), 2.4, Color(BLUSH, BLUSH.a * a), true, -1.0, true)
    86		if angry:
    87			# 攻擊：眉毛內傾＋嘴巴張開
    88			ci.draw_line(c + Vector2(-5.2, -4.4), c + Vector2(-1.0, -3.2), Color(OUT, a), 1.5, true)
    89			ci.draw_line(c + Vector2(6.2, -4.4), c + Vector2(2.0, -3.2), Color(OUT, a), 1.5, true)
    90			ci.draw_circle(c + Vector2(0.5, 4.6), 1.7, Color(OUT, a), true, -1.0, true)
    91			ci.draw_circle(c + Vector2(0.5, 5.2), 0.9, Color("#e05a6a", a), true, -1.0, true)
    92		else:
    93			ci.draw_arc(c + Vector2(0.5, 4.2), 1.8, 0.2, PI - 0.2, 6, Color(OUT, a), 1.2, true)
    94	
    95	
    96	static func _ell(c: Vector2, rx: float, ry: float, a0 := 0.0, a1 := TAU, n := 20) -> PackedVector2Array:
    97		var pts := PackedVector2Array()
    98		for i in n:
    99			var ang := a0 + (a1 - a0) * i / float(n - (0 if is_equal_approx(a1 - a0, TAU) else 1))
   100			pts.append(c + Vector2(cos(ang) * rx, sin(ang) * ry))
   101		return pts
   102	
   103	## 上半身：腳畫完後呼叫，之後畫的東西跟著起伏與傾身。
   104	## 第十輪 F3：攻擊時整隻壓扁、前衝。腳底為原點，所以不會和腿分離。up＝彈起（往上拉長）。
   105	static func _atk_xf(b: Transform2D, w: float, sq: float, lunge := 0.0, up := false) -> Transform2D:
   106		if w == 0.0:
   107			return b
   108		var sx := 1.0
   109		var sy := 1.0
   110		var dx := 0.0
   111		if w < 0.0:
   112			sx = 1.0 - w * sq
   113			sy = 1.0 + w * sq
   114			dx = w * lunge * 0.3
   115		elif up:
   116			sx = 1.0 - w * sq * 0.4
   117			sy = 1.0 + w * sq * 0.6
   118		else:
   119			sx = 1.0 + w * sq * 0.6
   120			sy = 1.0 - w * sq * 0.3
   121			dx = w * lunge
   122		return Transform2D(0.0, Vector2(sx, sy), 0.0, Vector2(dx, 0.0)) * b
   123	
   124	static func _push_body(ci: CanvasItem, b: Transform2D) -> void:
   125		ci.draw_set_transform_matrix(_xf * b)
