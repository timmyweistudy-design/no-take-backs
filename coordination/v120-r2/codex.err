     1	extends Node2D
     2	## 《落子無悔》UI 基底：共用常數、狀態、按鈕、文字、焦點、提示（第二輪方案 R2 從 main.gd 拆出）。
     3	## 繼承鏈：ui_base → battle_view（戰場與演出）→ game_screens（狀態機與各畫面）→ main（宣傳工具：截圖、膠囊、影片）。
     4	## 戰鬥結果完全由 scripts/core/battle_sim.gd 決定；這裡只負責演出（插值、特效、慢動作、鏡頭、聲音），不影響勝負。
     5	## UI 是自繪的「即時模式按鈕」，同時支援滑鼠、鍵盤、手把（焦點導航）。
     6	
     7	const D = preload("res://scripts/core/unit_defs.gd")
     8	const Army = preload("res://scripts/core/army.gd")
     9	const Sim = preload("res://scripts/core/battle_sim.gd")
    10	const AI = preload("res://scripts/core/ai_army.gd")
    11	const AIT = preload("res://scripts/core/ai_turns.gd")
    12	const TP = preload("res://scripts/core/turn_placement.gd")
    13	const Art = preload("res://scripts/ui/art.gd")
    14	const L = preload("res://scripts/game/strings.gd")
    15	const Save = preload("res://scripts/game/save.gd")
    16	const SteamApi = preload("res://scripts/game/steam.gd")
    17	const PZ = preload("res://scripts/game/puzzles.gd")
    18	const SfxScript = preload("res://scripts/game/sfx.gd")
    19	const SpriteCache = preload("res://scripts/ui/sprite_cache.gd")
    20	const ViewBuffer = preload("res://scripts/ui/view_buffer.gd")
    21	const RS = preload("res://scripts/game/roster.gd")
    22	const Keymap = preload("res://scripts/game/keymap.gd")
    23	const HardAI = preload("res://scripts/core/hard_ai.gd")
    24	const RuleSet = preload("res://scripts/core/ruleset.gd")
    25	const Presets = preload("res://scripts/game/presets.gd")
    26	const CmdD = preload("res://scripts/core/cmd_defs.gd")
    27	const Charts = preload("res://scripts/ui/charts.gd")
    28	
    29	enum St { TITLE, PLACE, BATTLE, RESULT }
    30	enum Mode { VS_AI, DUEL, TUTORIAL, PUZZLE, GAUNTLET }
    31	
    32	const ORIGIN := Vector2(128, 100)
    33	const BATTLE_DY := 36.0   # 第十輪 B9：戰鬥鏡頭下移，貼上緣的兵頭不被頂列蓋住（只改畫面）
    34	var force_demo := false   # 測試用：不必匯出就能走試玩版流程
    35	func _demo() -> bool:
    36		return force_demo or OS.has_feature("demo")
    37	var force_async := false  # 測試用：headless 也走背景計算
    38	var last_joy := 0         # 最後操作的手把（提示要依它顯示）
    39	func _async_ok() -> bool:
    40		return force_async or (DisplayServer.get_name() != "headless" and shot_dir == "")
    41	func _pk(action: String) -> String:
    42		return load("res://scripts/game/keymap.gd").pad_glyph(Save.s("pad"), action, Input.get_joy_name(last_joy))
    43	## 第十輪 I3：手把沒辦法貼上時開 Steam 鍵盤；沒有 Steam 就提示。有接手回傳 true。
    44	func _ask_code(prompt: String, on_text: Callable) -> bool:
    45		if not pad_mode:
    46			return false
    47		var cb := func(submitted: bool, text: String, _app: int) -> void:
    48			if submitted:
    49				on_text.call(text)
    50		if not SteamApi.text_input(prompt, 8000, cb):
    51			_toast(L.t("bc_pad_hint"), true)
    52		return true
    53	const CS := 64.0
    54	const FIELD := Vector2(16 * 64, 9 * 64)
    55	const MapArt = preload("res://scripts/ui/map_art.gd")
    56	const MapDefs = preload("res://scripts/core/map_defs.gd")
    57	# V9：這一場的場地（世界 px）。標準大小時 fld_size＝FIELD、_fld_xf＝單位矩陣，舊畫面完全不變
    58	var fld_size := FIELD
    59	var fld_w := 16000
    60	var fld_h := 9000
    61	var fld_map := 0
    62	var fld_sz := 1
    63	var fld_props: Array = []
    64	var map_art = null
    65	
    66	## 第十三輪：殘局自帶的規則（地形、撐住秒數、技能）；不是殘局或不用規則回 null。
    67	func _puzzle_rules():
    68		if (mode == Mode.PUZZLE or mode == Mode.TUTORIAL) and puzzle_id != "":
    69			return PZ.rules_of(PZ.get_puzzle(puzzle_id))
    70		return null
    71	
    72	## 場地用哪一組規則畫：自由部署的大廳規則，或格子放在地圖上的殘局。
    73	func _field_rules():
    74		if rules != null and rules.is_free():
    75			return rules
    76		var pr = _puzzle_rules()
    77		if pr != null and pr.map_id != 0:
    78			return pr
    79		return null
    80	
    81	## 這關要護送／斬首的單位：[模擬 id, "protect"／"kill"]，沒有回 [-1, ""]。
    82	func _goal_mark() -> Array:
    83		if mode != Mode.PUZZLE or puzzle_id == "":
    84			return [-1, ""]
    85		var pz := PZ.get_puzzle(puzzle_id)
    86		var g := PZ.goal(pz)
    87		if g == "flawless":
    88			return [-2, "flawless", int(pz["goal_type"])]   # V1.1：-2＝標整個兵種（我方每一隻）
    89		if g != "protect" and g != "kill":
    90			return [-1, ""]
    91		var c: Array = pz["goal_unit"]
    92		var team := 0 if g == "protect" else 1
    93		return [team * 1000 + int(c[1]) * 16 + int(c[0]), g]
    94	
    95	## 依這一場的規則同步場地。每幀畫面開頭呼叫。
    96	func _sync_field() -> void:
    97		var r = _field_rules()
    98		var m: int = r.map_id if r != null else 0
    99		var z: int = r.map_size if r != null else MapDefs.STD_SIZE
   100		if m == fld_map and z == fld_sz:
   101			return
   102		fld_map = m
   103		fld_sz = z
   104		fld_w = MapDefs.width(z)
   105		fld_h = MapDefs.height(z)
   106		fld_size = Vector2(fld_w / 1000.0 * CS, fld_h / 1000.0 * CS)
   107		fld_props = MapArt.props(m, z)
   108		_map_tex()   # 一換圖就先烘，開場那幾格才看得到地形
   109	
   110	## 把場地放進固定的戰場框：等比容納，置中留邊。
   111	func _fld_xf() -> Transform2D:
   112		if fld_sz == MapDefs.STD_SIZE:
   113			return Transform2D.IDENTITY
   114		var k: float = minf(FIELD.x / fld_size.x, FIELD.y / fld_size.y)
   115		return Transform2D(0.0, Vector2(k, k), 0.0, ORIGIN + (FIELD - fld_size * k) / 2.0 - ORIGIN * k)
   116	
   117	func _map_tex() -> Texture2D:
   118		if map_art == null:
   119			map_art = MapArt.new()
   120			add_child.call_deferred(map_art)
   121			return null
   122		if fld_map == 0:
   123			return null
   124		if not map_art.is_inside_tree():
   125			return null
   126		return map_art.texture(fld_map, fld_sz)
