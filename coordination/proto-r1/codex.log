   102	# ───────────────────────── 狀態切換 ─────────────────────────
   103	func _reset_place(keep_blue := false) -> void:
   104		state = St.PLACE
   105		sim = null
   106		fx.clear()
   107		dying.clear()
   108		zoom = 1.0
   109		if not keep_blue or armies.is_empty():
   110			armies = [Army.new(0, 100), Army.new(1, 100)]
   111		else:
   112			armies[1] = Army.new(1, 100)
   113		tp = null
   114		if mode == Mode.TURNS:
   115			armies = [Army.new(0, 100), Army.new(1, 100)]
   116			tp = TP.new(armies[0], armies[1], (round_no + 1) % 2)
   117		_refresh_buttons()
   118	
   119	func _refresh_buttons() -> void:
   120		var place := state == St.PLACE
   121		buttons["start"].visible = place
   122		buttons["clear"].visible = place and mode == Mode.VS_AI
   123		buttons["mode"].visible = place
   124		buttons["mode"].text = "模式：對 AI（點這裡換成兩人輪流落子）" if mode == Mode.VS_AI else "模式：兩人輪流落子（點這裡換成對 AI）"
   125		buttons["speed"].visible = state == St.BATTLE
   126		buttons["skip"].visible = state == St.BATTLE
   127		buttons["again"].visible = state == St.RESULT
   128		buttons["replay"].visible = state == St.RESULT
   129		if place and mode == Mode.TURNS:
   130			buttons["start"].text = "開戰！" if tp.done() else "結束這一手"
   131			buttons["start"].disabled = not (tp.done() or tp.can_end_turn())
   132		elif place:
   133			buttons["start"].text = "開戰！"
   134			buttons["start"].disabled = armies[0].count() == 0
