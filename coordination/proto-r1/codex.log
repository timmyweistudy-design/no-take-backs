    63	func _ready() -> void:
    64		var sf := SystemFont.new()
    65		sf.font_names = PackedStringArray(["Microsoft JhengHei UI", "Microsoft JhengHei", "Noto Sans CJK TC", "Noto Sans TC", "Noto Sans CJK SC", "sans-serif"])
    66		font = sf
    67		var theme := Theme.new()
