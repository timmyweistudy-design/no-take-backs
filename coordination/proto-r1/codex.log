    77		_btn(root, "start", "開戰！", Rect2(884, 690, 236, 50), _on_start)
    78		_btn(root, "clear", "清空", Rect2(1128, 690, 140, 50), _on_clear)
    79		_btn(root, "mode", "", Rect2(884, 746, 384, 44), _on_mode)
    80		_btn(root, "speed", "速度 1×", Rect2(884, 700, 180, 50), _on_speed)
    81		_btn(root, "skip", "直接看結果", Rect2(1076, 700, 192, 50), _on_skip)
    82		_btn(root, "again", "再來一局", Rect2(470, 520, 160, 50), _on_again)
    83		_btn(root, "replay", "重播", Rect2(650, 520, 160, 50), _on_replay)
    84		for a in OS.get_cmdline_user_args():
    85			if a.begins_with("--shot="):
    86				shot_dir = a.substr(7)
    87		rng.seed = Time.get_ticks_usec() if shot_dir == "" else 12345
    88		_reset_place()
    89		if shot_dir != "":
    90			_run_screenshots.call_deferred()
