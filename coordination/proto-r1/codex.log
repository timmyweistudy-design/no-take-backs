    16	]
    17	
    18	# reach＝攻擊距離（中心到中心）
    19	const STATS := [
    20		{"cost": 4, "hp": 100, "atk": 12, "cd": 20, "reach": 700, "speed": 60},   # 劍士
    21		{"cost": 5, "hp": 180, "atk": 6, "cd": 24, "reach": 700, "speed": 45},    # 盾兵
    22		{"cost": 4, "hp": 60, "atk": 10, "cd": 28, "reach": 6000, "speed": 50},   # 弓箭手
    23		{"cost": 7, "hp": 140, "atk": 14, "cd": 22, "reach": 750, "speed": 120},  # 騎兵
    24		{"cost": 6, "hp": 70, "atk": 20, "cd": 16, "reach": 700, "speed": 90},    # 刺客
    25	]
    26	
    27	const STEALTH_TICKS := 60      # 刺客開場潛行
    28	const CHARGE_NEED := 3000      # 騎兵直行 3 格才算衝鋒
    29	const STUN_TICKS := 20
    30	const SLOW_TICKS := 20
