   136	func _on_start() -> void:
   137		if mode == Mode.TURNS and not tp.done():
   138			if not tp.end_turn():
   139				_toast("買得起就不能跳過，至少擺 1 隻")
   140			_refresh_buttons()
   141			return
   142		if armies[0].count() == 0:
   143			_toast("先擺兵！")
   144			return
   145		if mode == Mode.VS_AI:
   146			var r = AI.build(1, 100, rng)
   147			armies[1] = r["army"]
   148			ai_name = r["name"]
   149		_begin_battle(armies[0].copy(), armies[1].copy())
   150	
   151	func _begin_battle(a0, a1) -> void:
   152		last_armies = [a0.copy(), a1.copy()]
   153		sim = Sim.new(a0, a1)
   154		state = St.BATTLE
   155		prev_pos.clear()
   156		for u in sim.units:
   157			prev_pos[u.id] = Vector2(u.x, u.y)
   158		accum = 0.0
   159		slow_used = false
   160		slow_left = 0.0
   161		zoom = 1.0
   162		fx.clear()
   163		dying.clear()
   164		atk_t.clear()
   165		result_delay = 0.0
   166		speed = 1.0
   167		buttons["speed"].text = "速度 1×"
   168		_refresh_buttons()
   169	
   170	func _on_clear() -> void:
   171		armies[0].clear()
   172		_refresh_buttons()
   173	
   174	func _on_mode() -> void:
   175		mode = Mode.TURNS if mode == Mode.VS_AI else Mode.VS_AI
   176		wins = [0, 0]
   177		round_no = 1
   178		_reset_place()
   179	
   180	func _on_speed() -> void:
   181		speed = 2.0 if speed == 1.0 else (4.0 if speed == 2.0 else 1.0)
   182		buttons["speed"].text = "速度 %d×" % int(speed)
   183	
   184	func _on_skip() -> void:
   185		while not sim.finished:
   186			_sim_step(false)
   187		result_delay = 0.0
   188	
   189	func _on_again() -> void:
   190		round_no += 1
   191		_reset_place(true)
   192	
   193	func _on_replay() -> void:
   194		var w: int = sim.winner
   195		if w >= 0:
   196			wins[w] -= 1   # 重播不重複計分
   197		_begin_battle(last_armies[0].copy(), last_armies[1].copy())
   198	
   199	func _toast(s: String) -> void:
   200		toast = s
   201		toast_t = 2.0
   202	
   203	# ───────────────────────── 輸入 ─────────────────────────
   204	func _cell_at(p: Vector2) -> Vector2i:
   205		var q := (p - ORIGIN) / CS
   206		if q.x < 0 or q.y < 0 or q.x >= 16 or q.y >= 9:
   207			return Vector2i(-1, -1)
   208		return Vector2i(int(q.x), int(q.y))
   209	
   210	func _card_at(p: Vector2) -> int:
   211		for i in D.COUNT:
   212			if Rect2(128 + i * (CARD_W + 8), CARD_Y, CARD_W, CARD_H).has_point(p):
   213				return i
   214		return -1
   215	
   216	func _cur_army():
   217		return tp.armies[tp.current] if mode == Mode.TURNS else armies[0]
   218	
   219	func _try_place(c: Vector2i) -> void:
   220		var why: String
   221		if mode == Mode.TURNS:
   222			why = tp.check_place(selected, c.x, c.y)
   223			if why == "":
   224				tp.place(selected, c.x, c.y)
   225		else:
   226			why = armies[0].check_place(selected, c.x, c.y)
   227			if why == "":
   228				armies[0].place(selected, c.x, c.y)
   229		if why != "" and why != "這格已經有兵":
   230			_toast(why)
   231		_refresh_buttons()
   232	
   233	func _unhandled_input(ev: InputEvent) -> void:
   234		if ev is InputEventMouseMotion:
   235			mouse = ev.position
   236			hover_card = _card_at(mouse)
   237			if state == St.PLACE and painting:
   238				var c := _cell_at(mouse)
   239				if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   240					_try_place(c)
   241		if state != St.PLACE or not (ev is InputEventMouseButton):
   242			return
   243		var mb := ev as InputEventMouseButton
   244		mouse = mb.position
   245		var c := _cell_at(mouse)
   246		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   247			var k := _card_at(mouse)
   248			if k >= 0:
   249				selected = k
   250				drag_new = true
   251				return
   252			if c.x < 0:
   253				return
   254			if mode == Mode.VS_AI and armies[0].index_at(c.x, c.y) != -1:
   255				drag_from = c
   256			else:
   257				painting = true
   258				_try_place(c)
   259		elif mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   260			if drag_new and c.x >= 0:
   261				_try_place(c)
   262			elif drag_from.x >= 0:
   263				if c.x < 0:
   264					armies[0].remove_at(drag_from.x, drag_from.y)
   265				elif c != drag_from and not armies[0].move(drag_from.x, drag_from.y, c.x, c.y):
   266					_toast("不能移到那裡")
   267			drag_new = false
   268			painting = false
   269			drag_from = Vector2i(-1, -1)
   270			_refresh_buttons()
   271		elif mb.button_index == MOUSE_BUTTON_RIGHT and mb.pressed and c.x >= 0:
   272			if mode == Mode.VS_AI:
   273				armies[0].remove_at(c.x, c.y)
   274			else:
   275				_toast("落子無悔：擺下的兵不能收回")
   276			_refresh_buttons()
   277	
   278	# ───────────────────────── 每幀 ─────────────────────────
   279	func _process(delta: float) -> void:
   280		time += delta
   281		if toast_t > 0:
   282			toast_t -= delta
   283		shake = maxf(0.0, shake - delta)
   284		for f in fx:
   285			f["t"] += delta
   286		fx = fx.filter(func(f): return f["t"] < f["dur"])
   287		for g in dying:
   288			g["t"] += delta
   289		dying = dying.filter(func(g): return g["t"] < 1.4)
   290		if state == St.BATTLE and shot_dir == "":
   291			_battle_process(delta)
   292		queue_redraw()
   293	
   294	func _battle_process(delta: float) -> void:
   295		var rate := speed
   296		if slow_left > 0:
   297			rate *= 0.5
   298			slow_left -= delta
   299		accum += delta * rate
   300		while accum >= 0.05 and not sim.finished:
   301			accum -= 0.05
   302			_sim_step(true)
   303		# 最後時刻：任一方剩 ≤3 隻 → 慢動作、鏡頭拉近（每局一次，最多多花 4 秒）
   304		var a0: int = sim.alive_count(0)
   305		var a1: int = sim.alive_count(1)
   306		if not slow_used and not sim.finished and (a0 <= 3 or a1 <= 3):
   307			slow_used = true
   308			slow_left = 8.0
   309			_fx_text(ORIGIN + FIELD / 2 - Vector2(0, 200), "最後時刻！", Color.GOLD, 1.6, 40)
   310		var target_zoom := 1.0
   311		if slow_left > 0 and not sim.finished:
   312			target_zoom = 1.3
   313			zoom_center = zoom_center.lerp(_alive_centroid(), delta * 3)
   314		zoom = lerpf(zoom, target_zoom, delta * 3)
   315		if sim.finished:
   316			result_delay += delta
   317			if result_delay > 1.2:
   318				_finish_battle()
   319	
   320	func _sim_step(with_fx: bool) -> void:
   321		for u in sim.units:
   322			prev_pos[u.id] = Vector2(u.x, u.y)
   323		var was_frenzy: bool = sim.frenzy
   324		sim.step()
   325		if sim.frenzy and not was_frenzy and with_fx:
   326			_fx_text(ORIGIN + Vector2(FIELD.x / 2, 60), "狂熱！攻速提升、全場耗損", Color.ORANGE_RED, 2.0, 30)
   327		for ev in sim.events:
   328			_on_event(ev, with_fx)
   329	
   330	func _on_event(ev: Dictionary, with_fx: bool) -> void:
   331		var k: String = ev["kind"]
   332		if k == "death":
   333			var u = sim.unit_by_id(ev["id"])
   334			dying.append({"pos": _upos(u), "type": u.type, "team": u.team, "face": signf(u.fx), "t": 0.0})
   335			return
   336		if k == "attrition" or not with_fx:
   337			return
   338		var s = sim.unit_by_id(ev["src"])
   339		var t = sim.unit_by_id(ev["tgt"])
   340		atk_t[s.id] = time
   341		var sp := _upos(s)
   342		var tpos := _upos(t)
   343		if k == "arrow" or k == "blocked":
   344			fx.append({"kind": "arrow", "a": sp + Vector2(0, -26), "b": tpos + Vector2(0, -22), "t": 0.0, "dur": 0.25})
   345		else:
   346			fx.append({"kind": "slash", "p": sp, "dir": signf(tpos.x - sp.x), "t": 0.0, "dur": 0.18, "team": s.team})
   347		var col := Color.WHITE
   348		var label := ""
   349		match k:
   350			"charge":
   351				label = "衝鋒！"
   352				col = Color.GOLD
   353				shake = 0.12
   354			"backstab":
   355				label = "背刺！"
   356				col = Color("#c77dff")
   357			"braced":
   358				label = "頂住！"
   359				col = Color("#9ad1ff")
   360			"breaker":
   361				label = "破盾"
   362				col = Color("#ffd166")
   363			"blocked":
   364				label = "擋"
   365				col = Color("#aaaaaa")
   366			"counter":
   367				label = "反擊"
   368				col = Color("#80ffdb")
   369		# 一般攻擊只有刀光，不跳數字（48 隻同時打會洗版）；特殊效果才跳字
   370		if label != "" and label != "破盾":
   371			_fx_text(tpos + Vector2(0, -52), "%s %d" % [label, ev["dmg"]], col, 0.8, 18)
   372	
   373	func _fx_text(p: Vector2, s: String, c: Color, dur: float, size: int) -> void:
   374		fx.append({"kind": "text", "p": p, "s": s, "c": c, "t": 0.0, "dur": dur, "size": size})
   375	
   376	func _finish_battle() -> void:
   377		state = St.RESULT
   378		if sim.winner >= 0:
   379			wins[sim.winner] += 1
   380		slow_left = 0
   381		_refresh_buttons()
   382	
   383	func _alive_centroid() -> Vector2:
   384		var s := Vector2.ZERO
   385		var n := 0
   386		for u in sim.units:
   387			if u.alive:
   388				s += _upos(u)
   389				n += 1
   390		return s / n if n > 0 else ORIGIN + FIELD / 2
   391	
   392	func _upos(u) -> Vector2:
   393		var cur := Vector2(u.x, u.y)
   394		var a := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
   395		var p: Vector2 = prev_pos.get(u.id, cur).lerp(cur, a)
   396		return ORIGIN + p * CS / 1000.0
   397	
   398	# ───────────────────────── 繪圖 ─────────────────────────
   399	func _draw() -> void:
   400		var cam := Transform2D.IDENTITY
   401		if state != St.PLACE:
   402			var off := Vector2.ZERO
   403			if shake > 0:
   404				off = Vector2(sin(time * 90) * 2, cos(time * 77) * 2)
   405			var c := zoom_center.lerp(ORIGIN + FIELD / 2, clampf((1.3 - zoom) / 0.3, 0, 1))
   406			# 鏡頭不能拉出戰場外
   407			var half := Vector2(640, 390) / zoom
   408			var lo := ORIGIN + half - Vector2(16, 16)
   409			var hi := ORIGIN + FIELD - half + Vector2(16, 16)
   410			c = Vector2(clampf(c.x, minf(lo.x, hi.x), maxf(lo.x, hi.x)), clampf(c.y, minf(lo.y, hi.y), maxf(lo.y, hi.y)))
   411			cam = Transform2D(0, Vector2(zoom, zoom), 0, Vector2(640, 390) - c * zoom + off)
   412		draw_set_transform_matrix(cam)
   413		_draw_field()
   414		if state == St.PLACE:
   415			_draw_place_units()
   416		else:
   417			_draw_battle_units()
   418		for f in fx:
   419			_draw_fx(f)
   420		draw_set_transform_matrix(Transform2D.IDENTITY)
   421		_draw_hud()
   422	
   423	func _draw_field() -> void:
   424		draw_rect(Rect2(ORIGIN - Vector2(8, 8), FIELD + Vector2(16, 16)), Color("#3b2f24"))
   425		for r in 9:
   426			for c in 16:
   427				var base := Color("#7cb342") if (r + c) % 2 == 0 else Color("#73a83d")
   428				if c < 6:
   429					base = base.lerp(TEAM_COL[0], 0.10)
   430				elif c >= 10:
   431					base = base.lerp(TEAM_COL[1], 0.10)
   432				else:
   433					base = base.lightened(0.08)
   434				draw_rect(Rect2(ORIGIN + Vector2(c, r) * CS, Vector2(CS, CS)), base)
   435		draw_line(ORIGIN + Vector2(6 * CS, 0), ORIGIN + Vector2(6 * CS, FIELD.y), Color(1, 1, 1, 0.35), 2)
   436		draw_line(ORIGIN + Vector2(10 * CS, 0), ORIGIN + Vector2(10 * CS, FIELD.y), Color(1, 1, 1, 0.35), 2)
   437		if state == St.PLACE and mode == Mode.VS_AI:
   438			# AI 的陣型開戰前看不到
   439			draw_rect(Rect2(ORIGIN + Vector2(10 * CS, 0), Vector2(6 * CS, FIELD.y)), Color(0.1, 0.05, 0.05, 0.45))
   440			_text(ORIGIN + Vector2(13 * CS, FIELD.y / 2), "AI 的陣型\n開戰後揭曉", 22, Color(1, 1, 1, 0.8), true)
   441	
   442	func _draw_place_units() -> void:
   443		var list: Array = []
   444		for a in armies:
   445			for u in a.units:
   446				if drag_from.x >= 0 and a.team == 0 and u["col"] == drag_from.x and u["row"] == drag_from.y:
   447					continue
   448				list.append([u["row"], u["col"], u["type"], a.team])
   449		list.sort()
   450		for it in list:
   451			var p := ORIGIN + Vector2(it[1] + 0.5, it[0] + 0.8) * CS
   452			_ring(p, it[3])
   453			_stick(p, it[2], it[3], 1.0 if it[3] == 0 else -1.0, time * 2 + it[1], 0.0, 1.0)
   454		# 拖曳預覽
   455		var c := _cell_at(mouse)
   456		var dragging_type := -1
   457		if drag_new:
   458			dragging_type = selected
   459		elif drag_from.x >= 0:
   460			dragging_type = armies[0].units[armies[0].index_at(drag_from.x, drag_from.y)]["type"]
   461		if dragging_type >= 0:
   462			_stick(mouse + Vector2(0, 20), dragging_type, _cur_army().team, 1.0, 0.0, 0.0, 0.7)
   463		if c.x >= 0:
   464			var okp: bool = _cur_army().check_place(selected, c.x, c.y) == ""
   465			draw_rect(Rect2(ORIGIN + Vector2(c) * CS, Vector2(CS, CS)), Color(1, 1, 1, 0.25) if okp else Color(1, 0.2, 0.2, 0.25))
   466	
   467	func _draw_battle_units() -> void:
   468		var list: Array = []
   469		for u in sim.units:
   470			if u.alive:
   471				list.append([_upos(u).y, u])
   472		list.sort_custom(func(a, b): return a[0] < b[0])
   473		for it in list:
   474			var u = it[1]
   475			var p := _upos(u)
   476			var moving: bool = prev_pos.get(u.id, Vector2(u.x, u.y)).distance_to(Vector2(u.x, u.y)) > 1
   477			var at := 0.0
   478			if atk_t.has(u.id):
   479				at = clampf((time - atk_t[u.id]) / 0.25, 0, 1)
   480				if at >= 1:
   481					at = 0
   482			var alpha := 0.35 if u.stealth > 0 else 1.0
   483			_ring(p, u.team)
   484			var face := signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
   485			_stick(p, u.type, u.team, face, (time * 10.0 + u.id) if moving else 0.0, at, alpha)
   486			if u.stun > 0:
   487				_text(p + Vector2(0, -58), "✦", 16, Color.YELLOW, true)
   488			if sim.frenzy:
   489				draw_circle(p + Vector2(0, -50 - sin(time * 12 + u.id) * 2), 3, Color(1, 0.5, 0.1, 0.9))
   490			if u.hp < u.max_hp:
   491				var w := 28.0
   492				var top := p + Vector2(-w / 2, -48)
   493				draw_rect(Rect2(top - Vector2(1, 1), Vector2(w + 2, 6)), OUTLINE)
   494				draw_rect(Rect2(top, Vector2(w * u.hp / u.max_hp, 4)), TEAM_COL[u.team].lightened(0.2))
   495		for g in dying:
   496			var k: float = g["t"] / 1.4
   497			if k < 0.3:
   498				_stick(g["pos"], g["type"], g["team"], g["face"], 0, 0, 1.0 - k / 0.3)
   499				for i in 5:
   500					var a := i * TAU / 5
   501					draw_circle(g["pos"] + Vector2(cos(a), sin(a) * 0.5) * (8 + k * 60) + Vector2(0, -14), 5 * (1 - k), Color(1, 1, 1, 0.6))
   502			var gp: Vector2 = g["pos"] + Vector2(sin(k * 9) * 4, -20 - k * 60)
   503			var ga := 0.7 * (1.0 - k)
   504			draw_circle(gp, 7, Color(0.85, 0.95, 1, ga))
   505			draw_circle(gp + Vector2(-2.5, -1), 1.2, Color(0.1, 0.1, 0.2, ga))
   506			draw_circle(gp + Vector2(2.5, -1), 1.2, Color(0.1, 0.1, 0.2, ga))
   507	
   508	func _ring(p: Vector2, team: int) -> void:
   509		var pts := PackedVector2Array()
   510		if team == 0:
   511			for i in 17:
   512				var a := i * TAU / 16
   513				pts.append(p + Vector2(cos(a) * 14, sin(a) * 7))
   514		else:
   515			pts = PackedVector2Array([p + Vector2(-15, 0), p + Vector2(0, -8), p + Vector2(15, 0), p + Vector2(0, 8), p + Vector2(-15, 0)])
   516		draw_polyline(pts, OUTLINE, 4)
   517		draw_polyline(pts, TEAM_COL[team], 2)
   518	
   519	func _ln(a: Vector2, b: Vector2, c: Color, w := 2.5) -> void:
   520		draw_line(a, b, Color(OUTLINE, c.a), w + 2.5, true)
   521		draw_line(a, b, c, w, true)
   522	
   523	## 火柴人。p＝腳底；face＝±1；walk＝走路相位；atk＝攻擊動畫進度（0＝沒在攻擊）。
   524	func _stick(p: Vector2, type: int, team: int, face: float, walk: float, atk: float, alpha: float) -> void:
   525		var col: Color = TEAM_COL[team]
   526		col.a = alpha
   527		var skin := Color(1, 0.93, 0.85, alpha)
   528		var dark := Color(0.2, 0.2, 0.25, alpha)
   529		var swing := sin(walk) * 5.0 if walk != 0.0 else 0.0
   530		var lunge := sin(atk * PI) * 4.0 * face
   531		var o := p + Vector2(lunge, 0)
   532		if type == D.CAVALRY:
   533			# 馬
   534			var hb := o + Vector2(0, -16)
   535			_ln(hb + Vector2(-12, 0), hb + Vector2(12, 0), dark, 6)
   536			for lx in [-9, -4, 5, 10]:
   537				_ln(hb + Vector2(lx, 2), o + Vector2(lx + swing * (1 if lx < 0 else -1) * 0.6, 0), dark, 2)
   538			_ln(hb + Vector2(12 * face, -1), hb + Vector2(17 * face, -10), dark, 3)
   539			draw_circle(hb + Vector2(19 * face, -11), 3.5, dark)
   540			_ln(hb + Vector2(-12 * face, -1), hb + Vector2(-17 * face, 4), dark, 2)
   541			# 騎士
   542			var hip := o + Vector2(0, -21)
   543			var neck := hip + Vector2(0, -12)
   544			_ln(hip, neck, col)
   545			_ln(hip, hip + Vector2(5 * face, 5), col)
   546			draw_circle(neck + Vector2(0, -6), 6, OUTLINE)
   547			draw_circle(neck + Vector2(0, -6), 5, skin)
   548			_ln(neck + Vector2(0, -12), neck + Vector2(0, -10), col, 4)
   549			var hand := neck + Vector2(6 * face, 4)
   550			_ln(neck + Vector2(0, 2), hand, col)
   551			var tip := hand + Vector2((22 + atk * 8) * face, -4 + atk * 4)
   552			_ln(hand - Vector2(6 * face, -1), tip, Color(0.75, 0.6, 0.4, alpha), 2)
   553			return
   554		var hip := o + Vector2(0, -14)
   555		var neck := o + Vector2(0, -28)
   556		var head := o + Vector2(0, -35)
   557		_ln(hip, o + Vector2(-5 + swing, 0), col)
   558		_ln(hip, o + Vector2(5 - swing, 0), col)
   559		_ln(hip, neck, col)
   560		draw_circle(head, 7.5, Color(OUTLINE, alpha))
   561		draw_circle(head, 6.2, skin)
   562		draw_circle(head + Vector2(2.5 * face, -0.5), 1.1, Color(0, 0, 0, alpha))
   563		var sh := neck + Vector2(0, 3)
   564		var back_hand := sh + Vector2(-6 * face, 9 - swing)
   565		_ln(sh, back_hand, col)
   566		match type:
   567			D.SWORD:
   568				var hand := sh + Vector2(8 * face, 6)
   569				_ln(sh, hand, col)
   570				var ang := lerpf(-1.9, 0.4, atk) if atk > 0 else -1.1
   571				var dir := Vector2(cos(ang) * face, sin(ang))
   572				_ln(hand, hand + dir * 18, Color(0.9, 0.92, 1, alpha), 2.5)
   573				_ln(hand - dir * 2 + dir.orthogonal() * 3, hand - dir * 2 - dir.orthogonal() * 3, Color(0.6, 0.45, 0.2, alpha), 2)
   574				# 頭盔
   575				draw_arc(head + Vector2(0, -1), 7.5, PI, TAU, 10, Color(0.65, 0.68, 0.75, alpha), 3)
   576			D.SHIELD:
   577				var hand := sh + Vector2(7 * face, 6)
   578				_ln(sh, hand, col)
   579				var r := Rect2(hand + Vector2(-3 + 3 * face, -12), Vector2(7, 22))
   580				r.position.x = hand.x + (2 if face > 0 else -9) + atk * 3 * face
   581				draw_rect(r.grow(1.5), Color(OUTLINE, alpha))
   582				draw_rect(r, Color(0.62, 0.66, 0.74, alpha))
   583				draw_line(r.get_center() + Vector2(0, -8), r.get_center() + Vector2(0, 8), col, 2)
   584				draw_arc(head + Vector2(0, -1), 7.5, PI, TAU, 10, Color(0.55, 0.58, 0.65, alpha), 4)
   585				_ln(head + Vector2(-5, 1), head + Vector2(5, 1), Color(0.55, 0.58, 0.65, alpha), 1.5)
   586			D.ARCHER:
   587				var hand := sh + Vector2(10 * face, 1)
   588				_ln(sh, hand, col)
   589				draw_arc(hand, 11, -1.2 if face > 0 else PI - 1.2, 1.2 if face > 0 else PI + 1.2, 12, Color(0.65, 0.45, 0.25, alpha), 2.5)
   590				var pull := 6.0 * (1.0 - atk) if atk > 0 else 2.0
   591				var top := hand + Vector2(cos(-1.2) * 11 * face, sin(-1.2) * 11)
   592				var bot := hand + Vector2(cos(1.2) * 11 * face, sin(1.2) * 11)
   593				var mid := hand - Vector2(pull * face, 0)
   594				draw_line(top, mid, Color(1, 1, 1, alpha * 0.8), 1)
   595				draw_line(mid, bot, Color(1, 1, 1, alpha * 0.8), 1)
   596				# 帽子
   597				draw_colored_polygon(PackedVector2Array([head + Vector2(-8, -3), head + Vector2(8, -3), head + Vector2(-2 * face, -14)]), Color(0.3, 0.55, 0.3, alpha))
   598			D.ASSASSIN:
   599				var hand := sh + Vector2(8 * face, 4 - atk * 4)
   600				_ln(sh, hand, col)
   601				_ln(hand, hand + Vector2(9 * face, -3 + atk * 6), Color(0.85, 0.85, 0.95, alpha), 2)
   602				# 兜帽
   603				draw_colored_polygon(PackedVector2Array([head + Vector2(-8.5, 3), head + Vector2(-7, -6), head + Vector2(-5 * face, -12), head + Vector2(7, -6), head + Vector2(8.5, 3), head + Vector2(5 * face, 0)]), Color(0.38, 0.15, 0.5, alpha))
   604				draw_circle(head + Vector2(3 * face, 0), 1.3, Color(1, 0.9, 0.2, alpha))
   605	
   606	func _draw_fx(f: Dictionary) -> void:
   607		var k: float = f["t"] / f["dur"]
   608		match f["kind"]:
   609			"arrow":
   610				var a: Vector2 = f["a"]
   611				var b: Vector2 = f["b"]
   612				var p := a.lerp(b, k) + Vector2(0, -sin(k * PI) * 30)
   613				var p2 := a.lerp(b, maxf(0, k - 0.12)) + Vector2(0, -sin(maxf(0, k - 0.12) * PI) * 30)
   614				draw_line(p2, p, Color(0.95, 0.9, 0.7), 2)
   615			"slash":
   616				var c: Vector2 = f["p"] + Vector2(f["dir"] * 14, -22)
   617				var start := -1.2 if f["dir"] > 0 else PI - 1.2
   618				draw_arc(c, 14, start, start + 2.4 * k, 10, Color(1, 1, 1, 1 - k), 3)
   619			"text":
   620				var p: Vector2 = f["p"] + Vector2(0, -k * 24)
   621				var c: Color = f["c"]
   622				c.a = 1.0 - k * k
   623				_text(p, f["s"], f["size"], c, true)
   624	
   625	func _text(p: Vector2, s: String, size: int, c: Color, center := false) -> void:
   626		var lines := s.split("\n")
   627		for i in lines.size():
   628			var w := font.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x if center else 0.0
   629			var q := p + Vector2(-w / 2, i * size * 1.25 + size * 0.35)
   630			draw_string_outline(font, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, 4, Color(0, 0, 0, c.a * 0.8))
   631			draw_string(font, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, c)
   632	
   633	func _draw_hud() -> void:
   634		draw_rect(Rect2(0, 0, 1280, 84), Color(0.08, 0.09, 0.12, 0.92))
   635		_text(Vector2(20, 20), "落子無悔", 28, Color("#ffe8a3"))
   636		_text(Vector2(20, 54), "No Take-Backs・火柴人原型", 14, Color(1, 1, 1, 0.6))
   637		_text(Vector2(1260 - 180, 22), "第 %d 局" % round_no, 18, Color.WHITE)
   638		_text(Vector2(1260 - 180, 50), "藍 %d : %d 紅" % [wins[0], wins[1]], 18, Color.WHITE)
   639		if state == St.PLACE:
   640			_draw_place_hud()
   641		else:
   642			_draw_battle_hud()
   643		if toast_t > 0:
   644			_text(Vector2(640, 640), toast, 22, Color(1, 0.85, 0.4, minf(1, toast_t * 2)), true)
   645	
   646	func _draw_place_hud() -> void:
   647		var a = _cur_army()
   648		var tcol: Color = TEAM_COL[a.team]
   649		var head := "擺放你的軍隊" if mode == Mode.VS_AI else "%s 落子中　這一手還能花 %d 金" % [TEAM_NAME[tp.current], tp.turn_left()]
   650		if mode == Mode.TURNS and tp.done():
   651			head = "雙方都擺完了，按「開戰！」"
   652		_text(Vector2(640, 18), head, 22, tcol if mode == Mode.TURNS else Color.WHITE, true)
   653		# 預算條
   654		var bx := 400.0
   655		var bw := 480.0
   656		draw_rect(Rect2(bx, 48, bw, 16), Color(0.2, 0.2, 0.25))
   657		draw_rect(Rect2(bx, 48, bw * a.spent() / a.budget, 16), tcol)
   658		_text(Vector2(640, 46), "%s　已用 %d / %d 金　%d / %d 隻" % [TEAM_NAME[a.team], a.spent(), a.budget, a.count(), Army.MAX_UNITS], 14, Color.WHITE, true)
   659		var info := "%s：%s" % [D.NAMES[selected], D.BLURB[selected]]
   660		if mode == Mode.VS_AI:
   661			info += "　｜　按住拖過格子可連續擺・拖動可移位・右鍵移除"
   662		else:
   663			var o = tp.armies[1 - tp.current]
   664			info += "　｜　擺下不能收回　｜　%s 已用 %d 金・%d 隻" % [TEAM_NAME[o.team], o.spent(), o.count()]
   665		_text(Vector2(640, 70), info, 13, Color(1, 1, 1, 0.75), true)
   666		# 兵種卡
   667		for i in D.COUNT:
