     8	const TEMPLATES := [
     9		{"name": "均衡軍", "w": [3, 2, 3, 1, 1]},
    10		{"name": "鐵壁弓陣", "w": [1, 4, 5, 0, 0]},
    11		{"name": "鐵騎突擊", "w": [2, 1, 0, 5, 0]},
    12		{"name": "暗影刺殺", "w": [3, 0, 2, 0, 4]},
    13		{"name": "劍海", "w": [5, 2, 2, 0, 0]},
    14		{"name": "騎射混編", "w": [0, 2, 3, 3, 0]},
    15	]
    16	
    17	# 每種兵偏好的欄（以藍方 0～5 表示，0＝最後排、5＝最前排；紅方自動鏡像）
    18	const PREF_COLS := [
    19		[5, 4, 3],          # 劍士：前排
    20		[5, 4],             # 盾兵：最前排
    21		[0, 1, 2],          # 弓箭手：後排
    22		[3, 2, 4],          # 騎兵：中排兩翼
    23		[2, 3, 1],          # 刺客：中後排
    24	]
    25	const ROW_CENTER := [4, 3, 5, 2, 6, 1, 7, 0, 8]
    26	const ROW_EDGE := [0, 8, 1, 7, 2, 6, 3, 5, 4]
    27	
    28	static func build(team: int, budget: int, rng: RandomNumberGenerator, template := -1):
    29		var a = Army.new(team, budget)
    30		var ti := template if template >= 0 else rng.randi_range(0, TEMPLATES.size() - 1)
    31		var w: Array = TEMPLATES[ti]["w"]
    32		var picks: Array = []
    33		var guard := 0
    34		while a.left() >= D.cheapest() and picks.size() < Army.MAX_UNITS and guard < 200:
    35			guard += 1
    36			var total := 0
    37			for t in D.COUNT:
    38				if D.cost(t) <= a.left() - _cost_sum(picks) and w[t] > 0:
    39					total += w[t]
    40			if total == 0:
    41				break
    42			var r := rng.randi_range(1, total)
    43			for t in D.COUNT:
    44				if D.cost(t) <= a.left() - _cost_sum(picks) and w[t] > 0:
    45					r -= w[t]
    46					if r <= 0:
    47						picks.append(t)
    48						break
    49			if _cost_sum(picks) > a.left():
    50				picks.pop_back()
    51				break
    52		# 先放盾兵、劍士，再放其他（讓前排先佔中間）
    53		picks.sort_custom(func(p, q): return [1, 0, 3, 4, 2].find(p) < [1, 0, 3, 4, 2].find(q))
    54		for t in picks:
    55			_place_pref(a, t)
    56		return {"army": a, "name": TEMPLATES[ti]["name"]}
    57	
    58	static func _cost_sum(picks: Array) -> int:
    59		var s := 0
    60		for t in picks:
    61			s += D.cost(t)
    62		return s
    63	
    64	static func _place_pref(a, t: int) -> void:
    65		var rows: Array = ROW_EDGE if t == D.CAVALRY else ROW_CENTER
    66		var cols: Array = PREF_COLS[t] + [5, 4, 3, 2, 1, 0]
    67		for c in cols:
    68			var col: int = c if a.team == 0 else Army.COLS - 1 - c
    69			for r in rows:
    70				if a.place(t, col, r):
    71					return
