   213					px[i] -= ux * half / 1000
   214					py[i] -= uy * half / 1000
   215					px[j] += ux * half / 1000
   216					py[j] += uy * half / 1000
   217			for i in n:
   218				nx[i] = clampi(nx[i] + px[i], EDGE, W - EDGE)
   219				ny[i] = clampi(ny[i] + py[i], EDGE, H - EDGE)
   220	
   221		# 套用移動、目標、面向
   222		for i in n:
   223			var u: Unit = units[i]
   224			if not u.alive:
   225				continue
   226			var moved_x: int = nx[i] - u.x
   227			var moved_y: int = ny[i] - u.y
   228			if u.type == D.CAVALRY:
   229				var ml := M.isqrt(moved_x * moved_x + moved_y * moved_y)
   230				if ml > 0:
   231					if _same_dir(u.lmx, u.lmy, moved_x, moved_y):
   232						u.charge += ml
   233					else:
   234						u.charge = ml
   235					u.lmx = moved_x
   236					u.lmy = moved_y
   237			u.x = nx[i]
   238			u.y = ny[i]
   239			u.target = new_target[i]
   240			u.fx = new_fx[i]
   241			u.fy = new_fy[i]
   242	
   243		# ④ 產生攻擊（讀這一 tick 已確定的位置與面向）
   244		var hits: Array = []   # [來源, 目標, 傷害, 種類]
   245		var stun_set := {}
   246		var slow_set := {}
   247		var reveal := {}
   248		var knock: Array = []
   249		var countered := {}
   250		var dec := 5 if frenzy else 4
   251		for i in n:
   252			var u: Unit = units[i]
   253			if not u.alive:
   254				continue
   255			if u.cd > 0:
   256				u.cd = maxi(0, u.cd - dec)
   257			if u.stun > 0 or u.target == -1 or u.cd > 0:
   258				continue
   259			var tg: Unit = units[u.target]
   260			var reach: int = D.STATS[u.type]["reach"]
   261			if M.dist2(u.x, u.y, tg.x, tg.y) > reach * reach:
   262				continue
   263			if u.type == D.ASSASSIN and u.stealth > 0 and not _is_behind(u, tg):
   264				continue
   265			var dmg: int = D.STATS[u.type]["atk"]
   266			var kind := "hit"
   267			if u.type == D.SWORD:
   268				if tg.type == D.SHIELD:
   269					dmg = dmg * 3 / 2
   270					kind = "breaker"
   271			elif u.type == D.ARCHER:
   272				kind = "arrow"
   273				if tg.type == D.SHIELD and not _is_behind(u, tg):
   274					dmg = dmg / 4
   275					kind = "blocked"
   276			elif u.type == D.CAVALRY:
   277				if u.charge >= D.CHARGE_NEED:
   278					if tg.type == D.SHIELD and not _is_behind(u, tg):
   279						stun_set[i] = true
   280						kind = "braced"
   281					else:
   282						dmg = dmg * 5 / 2
   283						kind = "charge"
   284						knock.append([u.target, tg.x - u.x, tg.y - u.y])
   285					u.charge = 0
   286			elif u.type == D.ASSASSIN:
   287				if _is_behind(u, tg):
   288					dmg *= 2
   289					kind = "backstab"
   290				if tg.type == D.CAVALRY:
   291					slow_set[u.target] = true
   292				reveal[i] = true
   293			hits.append([i, u.target, dmg, kind])
   294			u.cd += D.STATS[u.type]["cd"] * 4
   295			# 劍士反擊：被刺客打到立刻回砍，每 tick 最多一次，反擊不會再觸發反擊
   296			if u.type == D.ASSASSIN and tg.type == D.SWORD and not countered.has(u.target):
   297				countered[u.target] = true
   298				hits.append([u.target, i, D.STATS[D.SWORD]["atk"], "counter"])
   299	
   300		# ⑤ 同時結算
   301		var dmg_in := PackedInt64Array()
   302		dmg_in.resize(n)
   303		var last_hit := PackedInt64Array()
   304		last_hit.resize(n)
   305		last_hit.fill(-1)
   306		for h in hits:
   307			dmg_in[h[1]] += h[2]
   308			units[h[0]].dmg_dealt += h[2]
   309			if last_hit[h[1]] == -1:
   310				last_hit[h[1]] = h[0]
   311			events.append({"src": units[h[0]].id, "tgt": units[h[1]].id, "dmg": h[2], "kind": h[3]})
   312		# 狂熱耗損：第 1200+100k tick 扣 (k+1)×2% 滿血（至少 1）
   313		if tick >= FRENZY_TICK and (tick - FRENZY_TICK) % 100 == 0:
   314			var k := (tick - FRENZY_TICK) / 100
   315			for i in n:
   316				if units[i].alive:
   317					dmg_in[i] += maxi(1, units[i].max_hp * (k + 1) * 2 / 100)
   318			events.append({"kind": "attrition", "k": k})
   319		for kb in knock:
   320			var v := M.unit1000(kb[1], kb[2])
   321			var t: Unit = units[kb[0]]
   322			t.x = clampi(t.x + v.x * D.KNOCKBACK / 1000, EDGE, W - EDGE)
   323			t.y = clampi(t.y + v.y * D.KNOCKBACK / 1000, EDGE, H - EDGE)
   324		for i in n:
   325			var u: Unit = units[i]
   326			if not u.alive:
   327				continue
   328			u.hp -= dmg_in[i]
   329			if u.stun > 0:
   330				u.stun -= 1
   331			if u.slow > 0:
   332				u.slow -= 1
   333			if u.stealth > 0:
   334				u.stealth -= 1
   335			if reveal.has(i):
   336				u.stealth = 0
   337			if stun_set.has(i):
   338				u.stun = D.STUN_TICKS
   339				u.charge = 0
   340			if slow_set.has(i):
   341				u.slow = D.SLOW_TICKS
   342		for i in n:
   343			var u: Unit = units[i]
   344			if u.alive and u.hp <= 0:
   345				u.alive = false
   346				u.hp = 0
   347				if last_hit[i] != -1:
   348					units[last_hit[i]].kills += 1
   349				events.append({"kind": "death", "id": u.id})
   350	
   351		_update_fingerprint()
   352		_check_end()
   353	
   354	# ───────────────────────── 規則細節 ─────────────────────────
   355	
   356	## 選目標（企劃 §3.3）：排除潛行 → 弓手警覺 → 盾兵嘲諷（近戰）→ 兵種偏好 → 距離 → 剩血 → 編號。
   357	func _choose_target(i: int) -> int:
   358		var u: Unit = units[i]
   359		var reach: int = D.STATS[u.type]["reach"]
   360		var best := -1
   361		var bk := [99, 0, 0, 0]
   362		for j in units.size():
   363			var e: Unit = units[j]
   364			if e.team == u.team or not e.alive or e.stealth > 0:
   365				continue
   366			var d2 := M.dist2(u.x, u.y, e.x, e.y)
   367			var rank := 3
   368			if u.type == D.ARCHER and e.type == D.ASSASSIN and d2 <= reach * reach:
   369				rank = 0
   370			elif D.is_melee(u.type) and e.type == D.SHIELD and d2 <= D.TAUNT_RANGE * D.TAUNT_RANGE:
   371				rank = 1
   372			elif u.type == D.CAVALRY and e.type == D.ARCHER:
   373				rank = 2
   374			elif u.type == D.ASSASSIN and (e.type == D.SHIELD or e.type == D.CAVALRY):
   375				rank = 2
   376			var key := [rank, d2, e.hp, e.id]
   377			if best == -1 or _key_less(key, bk):
   378				best = j
   379				bk = key
   380		return best
   381	
   382	func _key_less(a: Array, b: Array) -> bool:
   383		for k in a.size():
   384			if a[k] != b[k]:
   385				return a[k] < b[k]
   386		return false
   387	
   388	## 攻擊者是否在目標背後（以目標面向的內積判斷；剛好側面算正面）。
   389	func _is_behind(att: Unit, tg: Unit) -> bool:
   390		var dx := att.x - tg.x
   391		var dy := att.y - tg.y
   392		return dx * tg.fx + dy * tg.fy < 0
   393	
   394	func _same_dir(ax: int, ay: int, bx: int, by: int) -> bool:
   395		# 夾角小於約 25 度
   396		var dot := ax * bx + ay * by
   397		if dot <= 0:
   398			return false
   399		var la := ax * ax + ay * ay
   400		var lb := bx * bx + by * by
   401		return dot * dot * 100 >= la * lb * 82
   402	
   403	## 騎兵繞翼：目標是弓手、直線上 1.5 格內有盾兵時，往敵兵較少的那側偏 2 格走途經點。
   404	func _flank_waypoint(i: int, t: int) -> Vector2i:
   405		var u: Unit = units[i]
   406		var tg: Unit = units[t]
   407		if tg.type != D.ARCHER:
   408			u.wp_for = -1
   409			return Vector2i(-1, -1)
   410		if u.wp_for == tg.id:
   411			if M.dist2(u.x, u.y, u.wp_x, u.wp_y) > 400 * 400:
   412				return Vector2i(u.wp_x, u.wp_y)
   413			return Vector2i(-1, -1)   # 已經到過途經點，直衝
   414		var dx := tg.x - u.x
   415		var dy := tg.y - u.y
   416		var l2 := dx * dx + dy * dy
   417		if l2 == 0:
   418			return Vector2i(-1, -1)
   419		var blocked := false
   420		var above := 0
   421		var below := 0
   422		for e in units:
   423			if e.team == u.team or not e.alive:
   424				continue
   425			if e.y < u.y:
   426				above += 1
   427			elif e.y > u.y:
   428				below += 1
   429			if e.type != D.SHIELD or e.stealth > 0:
   430				continue
   431			var ex: int = e.x - u.x
   432			var ey: int = e.y - u.y
   433			var proj: int = ex * dx + ey * dy
   434			if proj <= 0 or proj >= l2:
   435				continue
   436			var cross: int = ex * dy - ey * dx
   437			if cross * cross < 1500 * 1500 * l2:
   438				blocked = true
   439		if not blocked:
   440			return Vector2i(-1, -1)
   441		var wy: int
   442		if above <= below:
   443			wy = mini(u.y, tg.y) - 2 * CELL
   444		else:
   445			wy = maxi(u.y, tg.y) + 2 * CELL
   446		u.wp_for = tg.id
   447		u.wp_x = (u.x + tg.x) / 2
   448		u.wp_y = clampi(wy, EDGE, H - EDGE)
   449		return Vector2i(u.wp_x, u.wp_y)
   450	
   451	func _update_fingerprint() -> void:
   452		var h := fingerprint
   453		for u in units:
   454			var v: int = u.x * 7 + u.y * 13 + u.hp * 17 + u.fx * 3 + u.fy * 5 + u.target * 11 + u.cd + u.stealth + u.charge + (1 if u.alive else 0)
   455			h = posmod(h * 1000003 + v, HASH_MOD)
   456		fingerprint = h
   457	
   458	func _check_end() -> void:
   459		var a0 := alive_count(0)
   460		var a1 := alive_count(1)
   461		if a0 == 0 and a1 == 0:
   462			_finish(-1, "同時全滅")
   463		elif a1 == 0:
   464			_finish(0, "全滅")
   465		elif a0 == 0:
   466			_finish(1, "全滅")
   467		elif tick >= MAX_TICKS:
   468			var p0 := power(0)
   469			var p1 := power(1)
   470			if absi(p0 - p1) < budget * 30:
   471				_finish(-1, "時間到・戰力相當")
   472			elif p0 > p1:
   473				_finish(0, "時間到・剩餘戰力較高")
   474			else:
   475				_finish(1, "時間到・剩餘戰力較高")
   476	
   477	func _finish(w: int, r: String) -> void:
   478		finished = true
   479		winner = w
   480		reason = r
   481	
   482	func unit_by_id(id: int) -> Unit:
   483		for u in units:
   484			if u.id == id:
   485				return u
   486		return null
game/scripts/core/imath.gd
     1	extends RefCounted
     2	## 確定性整數數學。GDScript 的 int/int 是「往 0 截斷」，左右鏡像時結果對稱，所以全部沿用。
     3	
     4	## 整數平方根（無條件捨去）。先用浮點估計，再用整數修正到精確值，所以跨平台結果一定一樣。
     5	static func isqrt(n: int) -> int:
     6		if n <= 0:
     7			return 0
     8		var x := int(sqrt(float(n)))
     9		while x * x > n:
    10			x -= 1
    11		while (x + 1) * (x + 1) <= n:
    12			x += 1
    13		return x
    14	
    15	static func dist2(ax: int, ay: int, bx: int, by: int) -> int:
    16		var dx := bx - ax
    17		var dy := by - ay
    18		return dx * dx + dy * dy
    19	
    20	## 把 (dx,dy) 縮放成長度約 1000 的整數向量；零向量回傳 (0,0)。
    21	static func unit1000(dx: int, dy: int) -> Vector2i:
    22		var l := isqrt(dx * dx + dy * dy)
    23		if l == 0:
    24			return Vector2i.ZERO
    25		return Vector2i(dx * 1000 / l, dy * 1000 / l)
game/scripts/core/turn_placement.gd
     1	extends RefCounted
     2	## 輪流落子（企劃 §4.1）：公開輪流擺；每一手花 1～10 金、至少 1 隻；擺下不能移動或收回；
     3	## 買得起就不能跳過；買不起或滿 24 隻就自動停手；雙方都停手就開打。
     4	
     5	const D = preload("res://scripts/core/unit_defs.gd")
     6	
     7	const TURN_CAP := 10
     8	
     9	var armies: Array            # [藍, 紅]
    10	var current := 0
    11	var spent_this_turn := 0
    12	var placed_this_turn := 0
    13	var stopped := [false, false]
    14	
    15	func _init(a0, a1, first := 0) -> void:
    16		armies = [a0, a1]
    17		current = first
    18		_skip_if_stuck()
    19	
    20	func done() -> bool:
    21		return stopped[0] and stopped[1]
    22	
    23	func turn_left() -> int:
    24		return mini(TURN_CAP - spent_this_turn, armies[current].left())
    25	
    26	func check_place(t: int, col: int, row: int) -> String:
    27		if done():
    28			return "擺放已結束"
    29		if D.cost(t) > TURN_CAP - spent_this_turn:
    30			return "這一手最多花 %d 金" % TURN_CAP
    31		return armies[current].check_place(t, col, row)
    32	
    33	func place(t: int, col: int, row: int) -> bool:
    34		if check_place(t, col, row) != "":
    35			return false
    36		armies[current].place(t, col, row)
    37		spent_this_turn += D.cost(t)
    38		placed_this_turn += 1
    39		if turn_left() < D.cheapest() or not armies[current].can_afford_any():
    40			end_turn()
    41		return true
    42	
    43	func can_end_turn() -> bool:
    44		return placed_this_turn > 0
    45	
    46	## 結束這一手。還沒擺任何兵、又買得起時不能結束（買得起就不能跳過）。
    47	func end_turn() -> bool:
    48		if placed_this_turn == 0 and armies[current].can_afford_any():
    49			return false
    50		if not armies[current].can_afford_any():
    51			stopped[current] = true
    52		spent_this_turn = 0
    53		placed_this_turn = 0
    54		current = 1 - current
    55		_skip_if_stuck()
    56		return true
    57	
    58	func _skip_if_stuck() -> void:
    59		for _i in 2:
    60			if not armies[current].can_afford_any():
    61				stopped[current] = true
    62			if stopped[current] and not done():
    63				current = 1 - current
