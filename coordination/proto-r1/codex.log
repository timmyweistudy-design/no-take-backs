    83	func test_determinism_and_mirror() -> void:
    84		var rng := RandomNumberGenerator.new()
    85		var mirror_ok := 0
    86		var mirror_total := 0
    87		var det_ok := true
    88		var prints: Array = []
    89		var ms: Array = []
    90		for seed in 20:
    91			rng.seed = seed * 7919 + 1
    92			var a0 = AI.build(0, 100, rng)["army"]
    93			var a1 = AI.build(1, 100, rng)["army"]
    94			var t := Time.get_ticks_usec()
    95			var s1 = Sim.new(a0, a1)
    96			s1.run_to_end()
    97			ms.append((Time.get_ticks_usec() - t) / 1000)
    98			var s2 = Sim.new(a0.copy(), a1.copy())
    99			s2.run_to_end()
   100			if s1.fingerprint != s2.fingerprint or s1.winner != s2.winner:
   101				det_ok = false
   102			prints.append(s1.fingerprint)
   103			# 左右交換：a1 鏡像成藍方、a0 鏡像成紅方 → 勝方應該對調
   104			var s3 = Sim.new(a1.mirrored(), a0.mirrored())
   105			s3.run_to_end()
   106			mirror_total += 1
   107			var expect: int = s1.winner if s1.winner == -1 else 1 - s1.winner
   108			if s3.winner == expect and s3.tick == s1.tick:
   109				mirror_ok += 1
   110			else:
   111				print("  鏡像不一致 seed=%d 原本 %d@%d 鏡像 %d@%d" % [seed, s1.winner, s1.tick, s3.winner, s3.tick])
   112		ok(det_ok, "同一場跑兩次指紋相同（20 場）")
   113		ok(mirror_ok == mirror_total, "左右交換後勝方對調、tick 相同（%d/%d）" % [mirror_ok, mirror_total])
   114		ms.sort()
   115		print("  每場耗時 ms：中位數 %d、最大 %d（48 隻上限、headless debug）" % [ms[ms.size() / 2], ms[-1]])
   116		var h := 0
   117		for p in prints:
   118			h = posmod(h * 1000003 + p, Sim.HASH_MOD)
   119		print("FINGERPRINT ", h)
