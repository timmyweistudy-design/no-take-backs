   290	var _btns: Array = []
   291	var _focus := 0
   292	var _cmds: Array = []        # 輸入命令佇列（A2）
   293	var _gen := 0                # 畫面世代
   294	var _gen_key := ""
   295	var _btns_gen := -1          # _btns 是哪個世代畫出來的
   296	
   297	var capsule_path := ""
   298	var perf_draw_us := 0     # 這一幀 _draw 花的時間（效能量測用）
   299	var perf_proc_us := 0     # 這一幀 _process 花的時間
   300	var perf_path := ""
   301	var perf_parts := {}      # 繪圖各部分耗時（微秒）
   302	var sprites = null        # 角色精靈圖快取（沒有畫面時是 null，退回直接繪製）
   303	var video_mode := false
   304	var grass: Texture2D
   305	var plants: Array = []
