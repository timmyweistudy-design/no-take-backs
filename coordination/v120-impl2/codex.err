     1	shader_type canvas_item;
     2	// V1.2 D1：角色圖集烘焙後處理（只在烘焙時跑一次，每幀貼圖成本不變）。
     3	// ① 外輪廓：沿 alpha 往外擴 radius 像素，用隊伍墨色（藍方冷深褐、紅方暖深焦茶）；部件自己的描邊變成較細的內線。
     4	// ② 頂亮底暗：依格子內高度，上半疊暖光、下半疊冷影（左右翻面不穿幫，不做左右光）。
     5	uniform vec4 ink0 : source_color = vec4(0.114, 0.102, 0.149, 1.0);
     6	uniform vec4 ink1 : source_color = vec4(0.157, 0.086, 0.071, 1.0);
     7	uniform float cell = 192.0;
     8	uniform float per = 28.0;
     9	uniform float cols = 16.0;
    10	uniform float radius = 3.0;
    11	uniform float hi_amt = 0.09;
    12	uniform float sh_amt = 0.20;
    13	
    14	void fragment() {
    15		vec2 px = UV / TEXTURE_PIXEL_SIZE;
    16		vec4 c = texture(TEXTURE, UV);
    17		float cidx = floor(px.y / cell) * cols + floor(px.x / cell);
    18		float team = mod(floor(cidx / per), 2.0);
    19		vec4 ink = team < 0.5 ? ink0 : ink1;
    20		float a = 0.0;
    21		for (int r = 1; r <= 2; r++) {
    22			float rr = radius * float(r) / 2.0;
    23			for (int i = 0; i < 16; i++) {
    24				float ang = 6.2831853 * (float(i) + 0.5 * float(r)) / 16.0;
    25				a = max(a, texture(TEXTURE, UV + vec2(cos(ang), sin(ang)) * rr * TEXTURE_PIXEL_SIZE).a);
    26			}
    27		}
    28		vec3 col = c.rgb;
    29		float ly = mod(px.y, cell) / cell;
    30		float hi = clamp((0.50 - ly) / 0.28, 0.0, 1.0) * hi_amt;
    31		float sh = clamp((ly - 0.62) / 0.20, 0.0, 1.0) * sh_amt;
    32		col = mix(col, vec3(1.0, 0.953, 0.839), hi);
    33		col = mix(col, col * vec3(0.48, 0.42, 0.58), sh);
    34		float oa = a * ink.a;
    35		float outa = c.a + oa * (1.0 - c.a);
    36		vec3 rgb = outa > 0.0 ? (col * c.a + ink.rgb * oa * (1.0 - c.a)) / outa : vec3(0.0);
    37		COLOR = vec4(rgb, outa);
    38	}
