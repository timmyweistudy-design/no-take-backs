   673	## V1.2 C2：8 格刻印能力條（取代細長滑桿）：凹槽底＋一格一格填色，最後一格依比例部分填。
   674	func _seg_bar(r: Rect2, frac: float, col: Color, segs := 8) -> void:
   675		var gap := 2.0
   676		var sw := (r.size.x - gap * (segs - 1)) / segs
   677		var filled := clampf(frac, 0.0, 1.0) * segs
   678		for i in segs:
   679			var sr := Rect2(r.position.x + i * (sw + gap), r.position.y, sw, r.size.y)
   680			draw_rect(sr, Color(0.06, 0.04, 0.03, 0.75))
   681			draw_rect(Rect2(sr.position, Vector2(sw, 1.0)), Color(0, 0, 0, 0.5))
   682			var f := clampf(filled - i, 0.0, 1.0)
   683			if f > 0.0:
   684				var fr := Rect2(sr.position + Vector2(1, 1), Vector2((sw - 2.0) * f, sr.size.y - 2.0))
   685				draw_rect(fr, col)
   686				draw_rect(Rect2(fr.position, Vector2(fr.size.x, maxf(1.0, fr.size.y * 0.35))), Color(1, 1, 1, 0.28))
