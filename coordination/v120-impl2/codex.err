   307	
   308	func _load_font(path: String) -> Font:
   309		if ResourceLoader.exists(path):
   310			var f = load(path)
   311			if f:
   312				return f
   313		var sf := SystemFont.new()
   314		sf.font_names = PackedStringArray(["Microsoft JhengHei UI", "Noto Sans CJK TC", "sans-serif"])
   315		return sf
   316	
   317	
   318	## V1.2 A1：英數字型疊在中文字型上（中文缺字落到後備）。沒有英數字型檔時直接用中文字型。
   319	func _latin_over(path: String, cjk: Font) -> Font:
   320		if ResourceLoader.exists(path):
   321			var lf = load(path)
   322			if lf is FontFile:
   323				var f2: FontFile = lf.duplicate()
   324				f2.fallbacks = [cjk]
   325				return f2
   326		return _tnum(cjk)
   327	
   328	## 第五輪：數字用等寬（tnum），金幣、秒數、百分比跳動時不會左右晃。
   329	func _tnum(f: Font) -> Font:
   330		var fv := FontVariation.new()
   331		fv.base_font = f
   332		fv.opentype_features = {TextServerManager.get_primary_interface().name_to_tag("tnum"): 1}
   333		return fv
   334	
   335	## 第五輪：載入三種字型角色。標題字缺的字由介面字型 Bold 補。
   336	## V1.2 A1：介面字＝「NTB Latin（Fredoka，英數、數字等寬）為主字型＋NTB Rounded（源泉圓體 TW）為後備」：
   337	## 主字型只有拉丁字，中文自動落到後備，所以同一行裡英數用 Fredoka、中文用源泉圓體，不用拆段。
   338	func _load_fonts() -> void:
   339		var reg := _load_font("res://fonts/NTBRounded-R-sub.otf")
   340		var bold := _load_font("res://fonts/NTBRounded-B-sub.otf")
   341		font = _latin_over("res://fonts/NTBLatin-M-sub.ttf", reg)
   342		font_bold = _latin_over("res://fonts/NTBLatin-B-sub.ttf", bold)
   343		if ResourceLoader.exists("res://fonts/ThenKhung-sub.ttf"):
   344			var tk = load("res://fonts/ThenKhung-sub.ttf")
   345			if tk is FontFile:
   346				tk.fallbacks = [bold]
   347				font_title = tk
   348	
   349	
   350	func _apply_fullscreen() -> void:
   351		if shot_dir != "":
   352			return
   353		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN if Save.s("fullscreen") else DisplayServer.WINDOW_MODE_WINDOWED)
   354	
   355	
   356	## 舊介面寫的字級數字（11～84）吸附到字級表：11～14→註記、15→次要、16～18→內文、19～24→區塊標題、25～48→畫面標題、49 以上→展示。
   357	## 這樣全遊戲不會再出現表外字級，也不會小於 14（第五輪 §4.2）。新程式請直接用 tz("B") 這類語意名稱。
   358	static func role_of(px: int) -> String:
   359		if px <= 14:
   360			return "C"
   361		if px == 15:
   362			return "S"
   363		if px <= 18:
   364			return "B"
   365		if px <= 24:
   366			return "H2"
   367		if px <= 48:
   368			return "H1"
   369		return "D" if px < 80 else "DX"
   370	
   371	func _scale_key() -> int:
   372		var sc := int(Save.s("text_scale"))
   373		return 150 if sc >= 150 else (125 if sc >= 125 else 100)
   374	
   375	func tz(role: String) -> int:
   376		return int(TYPE_SCALE[_scale_key()][role])
   377	
   378	func ts(px: int) -> int:
   379		return tz(role_of(px))
   380	
   381	## 封頂（第五輪）：取字級表裡 ≤ 上限的最大值，但不低於「註記」。取代 tcap(ts(x), N)，避免封出表外字級。
   382	func tcap(sz: int, maxpx: int) -> int:
   383		var best := tz("C")
   384		for v in TYPE_SCALE[_scale_key()].values():
   385			if v <= mini(sz, maxpx) and v > best:
   386				best = v
   387		return best
   388	
   389	## 這個字級在不在字級表裡（版面檢查用）。
   390	func size_ok(sz: int) -> bool:
   391		return sz in TYPE_SCALE[_scale_key()].values()
   392	
   393	
   394	## 第五輪：解鎖用的累計場數（設定「全部解鎖」時視為全開；試玩版上限由 roster 管）。
   395	
   396	
   397	func cbm() -> bool:
   398		return bool(Save.s("colorblind"))
   399	
   400	
   401	func _toast(s: String, deny := false) -> void:
   402		toast = s
   403		toast_t = 2.0
   404		if deny:
   405			sfx.play("ui_deny")
   406	
   407	
   408	func _move_focus(d: int) -> void:
   409		pad_mode = true
   410		if _btns.is_empty():
   411			return
   412		_focus = posmod(_focus + d, _btns.size())
   413	
   414	
   415	## 字太寬就往下一級縮（第五輪：只在字級表內往下走，最小到「註記」，不再縮到 9px；還是太寬就由 _text 換行）。
   416	func fit(s: String, size: int, maxw: float, bold := false) -> int:
   417		var sz := size
   418		var levels: Array = TYPE_SCALE[_scale_key()].values()
   419		levels.sort()
   420		while _width(s, sz, bold) > maxw:
   421			var nxt := -1
   422			for v in levels:
   423				if v < sz:
   424					nxt = v
   425			if nxt < 0:
   426				break
   427			sz = nxt
   428		return sz
   429	
   430	func _font_for(s: String, size: int, bold: bool) -> Font:
   431		if bold and font_title != null and size >= tz("H2") and not bool(Save.s("plain_titles")) and not _has_digit(s):
   432			return font_title
   433		return font_bold if bold else font
   434	
   435	static func _has_digit(s: String) -> bool:
   436		for i in s.length():
   437			var c := s.unicode_at(i)
   438			if (c >= 48 and c <= 57) or (c >= 0xFF10 and c <= 0xFF19):
   439				return true
   440		return false
   441	
   442	func _width(s: String, size: int, bold := false) -> float:
   443		var w := 0.0
   444		for ln in s.split("\n"):
   445			w = maxf(w, _font_for(ln, size, bold).get_string_size(ln, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x)
   446		return w
   447	
   448	## 換行（第五輪）：中日韓逐字斷、英文逐詞斷；保留原本的 \n。回傳行陣列。
   449	func wrap_lines(s: String, size: int, maxw: float, bold := false) -> PackedStringArray:
   450		var out := PackedStringArray()
   451		for para in s.split("\n"):
   452			if maxw <= 0.0 or _width(para, size, bold) <= maxw:
   453				out.append(para)
   454				continue
   455			var cur := ""
   456			var i := 0
   457			while i < para.length():
   458				var tok := para[i]
   459				if tok.unicode_at(0) < 0x2E80 and tok != " ":
   460					# 拉丁字：整個詞一起
   461					var j := i + 1
   462					while j < para.length() and para[j].unicode_at(0) < 0x2E80 and para[j] != " ":
   463						j += 1
   464					tok = para.substr(i, j - i)
   465					i = j
   466				else:
   467					i += 1
   468				if cur != "" and _width(cur + tok, size, bold) > maxw:
   469					# 避頭點（第六輪截圖）：句號、逗號、右括號不放行首——把上一行最後一個字一起帶到下一行（不掛出框外）
   470					if tok.length() == 1 and "。，、）」』！？；：%".contains(tok) and cur.length() > 1 and cur.unicode_at(cur.length() - 1) >= 0x2E80:
   471						out.append(cur.substr(0, cur.length() - 1).strip_edges(false, true))
   472						cur = cur.substr(cur.length() - 1) + tok
   473					else:
   474						out.append(cur.strip_edges(false, true))
   475						cur = tok.strip_edges(true, false) if tok == " " else tok
   476				else:
   477					cur += tok
   478			if cur != "":
   479				out.append(cur)
   480		return out
   481	
   482	## 行距（第五輪 §4.2，XAG 101）：多行的段落 1.5 倍；單行照舊。
   483	static func line_h(n: int) -> float:
   484		return 1.5 if n > 1 else 1.3
   485	
   486	## 一段字換行後的高度（排版用）。
   487	func text_h(s: String, size: int, maxw := 0.0, bold := false) -> float:
   488		var n := wrap_lines(s, size, maxw, bold).size()
   489		return n * size * line_h(n)
   490	
   491	
   492	func _text(p: Vector2, s: String, size: int, c: Color, center := false, bold := false, maxw := 0.0, outline := Color(0, 0, 0, -1)) -> void:
   493		if maxw > 0.0:
   494			size = fit(s, size, maxw, bold)
   495		var lines := wrap_lines(s, size, maxw, bold) if maxw > 0.0 else s.split("\n")
   496		for i in lines.size():
   497			var fnt := _font_for(lines[i], size, bold)
   498			var w := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x if center else 0.0
   499			var q := p + Vector2(-w / 2, i * size * line_h(lines.size()) + size * 0.85)
   500			var oc := Color(INK, c.a * 0.85) if outline.a < 0.0 else outline
   501			var ow := text_outline_w(size)
   502			var sh := text_shadow_dy(size)
   503			# 版面探針（第五輪補洞）：介面層與戰場層都量、低透明度（>0.05）也量；戰場字標 field
   504			# V1.2 A3：外框算進描邊外擴（左右上各半個描邊、下方再加陰影位移），換字與換框才不會靜靜爆框
   505			if layout_probe and c.a > 0.05 and lines[i].strip_edges() != "":
   506				var ww := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
   507				var ex := ow * 0.5 if oc.a > 0.0 else 0.0
   508				# 直向：原本的框（1.1 倍字高）已經留了上下各約 0.05 字高的空，描邊與陰影只算超出的部分
   509				var ey := maxf(0.0, ex - size * 0.05)
   510				var eb := maxf(0.0, ey + (sh if oc.a > 0.0 else 0.0) - size * 0.05)
   511				probe_texts.append({"r": Rect2(q.x - ex, q.y - size * 0.85 - ey, ww + ex * 2.0, size * 1.1 + ey + eb), "size": size, "s": lines[i], "field": not _probe_ui, "a": c.a, "btn": _probe_btn_label, "own": _probe_btn_rect})
   512			if outline.a < 0.0 and c.get_luminance() < 0.4:
   513				# V1.2（Antigravity impl1）：深色字印在淺色紙或布條上：不描深邊（會糊成一團），改 1px 淺色浮雕
   514				draw_string(fnt, q + Vector2(0, 1), lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, Color(1.0, 0.96, 0.86, 0.45 * c.a))
   515				oc = Color(0, 0, 0, 0)
   516			if oc.a > 0.0:
   517				# V1.2 A3：先畫柔和的下方陰影，再畫深焦茶描邊（取代純黑），最後正文
   518				draw_string_outline(fnt, q + Vector2(0, sh), lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, ow, Color(INK_SHADOW, oc.a * 0.55))
   519				draw_string_outline(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, ow, oc)
   520			draw_string(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, c)
   521	
   522	
   523	## V1.2 A3：描邊依字級減薄（小字描太粗會糊）、陰影位移依字級（純函式，測試與探針共用）。
   524	static func text_outline_w(size: int) -> int:
   525		return 3 if size <= 16 else (4 if size <= 22 else 5)
   526	
   527	static func text_shadow_dy(size: int) -> float:
   528		return maxf(1.0, roundf(size / 12.0))
   529	
   530	
   531	## 即時模式按鈕：每幀重新登記，滑鼠或焦點都能按。
   532	## V9 P5 按鈕：圓角木牌、上緣高光、下緣陰影；按下縮一點回彈、懸停亮、焦點金框；主按鈕有流光。
   533	func _btn(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
   534		var idx := _btns.size()
   535		_btns.append({"r": r, "cb": action, "en": enabled, "snd": "k_confirm" if primary else ("k_back" if label == L.t("back") or label == L.t("menu") else "k_click")})
   536		var hover := r.has_point(mouse) and not pad_mode
   537		var focus := pad_mode and idx == _focus
   538		var bg := TH_WOOD_L if not primary else TH_PRIMARY
   539		if tint.a > 0:
   540			bg = tint
   541		if not enabled:
   542			bg = Color(0.2, 0.17, 0.15)
   543		elif hover or focus:
   544			bg = bg.lightened(0.16)
   545			if hover:
   546				_hover_now = idx
   547		var pressed := hover and enabled and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
   548		var rd := r.grow(-minf(r.size.x, r.size.y) * 0.025) if pressed else r
   549		# V1.2 B3：按鈕下緣 3px 厚度（木牌的側面）；按下時往下沉、厚度消失
   550		var solid: bool = tint.a <= 0.0 or tint.a > 0.6
   551		if solid and not pressed and r.size.y >= 20.0:
   552			_box(Rect2(rd.position + Vector2(0, 3), rd.size), Color(bg.darkened(0.55), 1.0), Color(0, 0, 0, 0), 7.0)
   553		elif pressed:
   554			rd.position.y += 2.0
   555		if (hover or focus) and enabled and not pressed and shot_dir == "" and not layout_probe:
   556			rd.position.y -= 1.0   # V1.2 F1：懸停／焦點時微微抬起
   557		_box(rd, bg, TH_EDGE.darkened(0.25) if solid else Color(0, 0, 0, 0), 7.0, 1.5)
   558		if tint.a <= 0.0 or tint.a > 0.6:
   559			draw_line(rd.position + Vector2(6, 1.5), rd.position + Vector2(rd.size.x - 6, 1.5), Color(1, 1, 1, 0.16), 1.5)
   560			draw_line(rd.position + Vector2(6, rd.size.y - 1.5), rd.end - Vector2(6, 1.5), Color(0, 0, 0, 0.3), 2.0)
   561		if primary and enabled:
   562			_btn_shine(rd)
   563		if focus:
   564			_box(rd.grow(1), Color(0, 0, 0, 0), ACCENT, 8.0, 3.0)
   565		if layout_probe:
   566			probe_btns.append(r)
   567			if label == "":
   568				probe_ctrls.append(r)   # 空白標籤的按鈕（卡片、頁籤）：裡面自己畫的字算按鈕內容
   569		var sz := fit(label, ts(18) if r.size.y >= 40 else ts(15), r.size.x - 10, primary)
   570		var lines := wrap_lines(label, sz, r.size.x - 10, primary)
   571		var h := lines.size() * sz * line_h(lines.size())
   572		_probe_btn_label = true   # 版面檢查：這段是按鈕自己的標籤（不用位置猜，Antigravity 實作第 2 輪抓到猜錯的情況）
   573		_probe_btn_rect = r
   574		_text(r.get_center() - Vector2(0, h / 2 - sz * 0.03), "\n".join(lines), sz, Color.WHITE if enabled else Color(1, 1, 1, 0.4), true, primary)
   575		_probe_btn_label = false
   576	
   577	## 主按鈕的流光（可關）。
   578	func _btn_shine(r: Rect2) -> void:
   579		if bool(Save.s("reduce_fx")):
   580			return
   581		var k := fposmod(time * 0.45, 1.0)
   582		if k > 0.5:
   583			return
   584		var x: float = r.position.x + (r.size.x + 60.0) * (k * 2.0) - 30.0
   585		# V1.2：斜的、窄的、淡的流光（直的半透明帶在截圖裡像破圖）
   586		var sk := r.size.y * 0.5
   587		var pts := PackedVector2Array([Vector2(x, r.end.y - 3), Vector2(x + 14, r.end.y - 3), Vector2(x + 14 + sk, r.position.y + 3), Vector2(x + sk, r.position.y + 3)])
   588		var clip := PackedVector2Array()
   589		for pp in pts:
   590			clip.append(Vector2(clampf(pp.x, r.position.x + 3, r.end.x - 3), pp.y))
   591		if clip[1].x > clip[0].x or clip[2].x > clip[3].x:
   592			draw_colored_polygon(clip, Color(1, 1, 1, 0.09))
   593	
   594	## V1.2 B3：材質貼圖（tools/gen/gen_ui_tex.py 生成）。木紋是灰階，用原本的底色染，配色不變、多了木紋與上亮下暗的斜角。
   595	const TEX_WOOD := "res://art/ui/wood.png"
   596	const TEX_FRAME := "res://art/ui/frame.png"
   597	const TEX_GROOVE := "res://art/ui/groove.png"
   598	const TEX_PAPER := "res://art/ui/paper.png"
   599	var _tex_cache := {}
   600	
   601	func _ui_tex(path: String) -> Texture2D:
   602		if not _tex_cache.has(path):
   603			_tex_cache[path] = load(path) if ResourceLoader.exists(path) else null
   604		return _tex_cache[path]
   605	
   606	## V1.2：頂部資訊列：深木紋＋下緣一條亮線與落影（沒有貼圖時照舊平塗）。
   607	func _hud_bar(r: Rect2) -> void:
   608		if bool(Save.s("plain_ui")) or not _tex_box(r.grow_individual(8, 8, 8, 0), "wood", Color(0.3, 0.21, 0.15, 0.97)):
   609			draw_rect(r, UI_BG)
   610			return
   611		draw_rect(Rect2(r.position.x, r.end.y - 2, r.size.x, 2), Color(0.55, 0.42, 0.28, 0.9))
   612		draw_rect(Rect2(r.position.x, r.end.y, r.size.x, 4), Color(0, 0, 0, 0.25))
   613	
   614	## V1.2：木製框（九宮格、四角銅釘、中間透明），面板、戰場、大廳沙盤預覽共用。grow＝往外擴多少。
   615	func _wood_frame(r: Rect2, grow := 8.0, key := "frame") -> void:
   616		var fx := _ui_tex(TEX_FRAME)
   617		if fx == null or bool(Save.s("plain_ui")):
   618			return
   619		var sb: StyleBoxTexture = _sb_cache.get(key)
   620		if sb == null:
   621			sb = StyleBoxTexture.new()
   622			sb.texture = fx
   623			for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
   624				sb.set_texture_margin(side, 22.0)
   625			sb.draw_center = false
   626			_sb_cache[key] = sb
   627		draw_style_box(sb, r.grow(grow))
   628	
   629	## 材質方塊：kind＝wood（染色）／groove（染色）／paper（原色）。沒有貼圖時退回平塗。
   630	func _tex_box(r: Rect2, kind: String, tint := Color.WHITE) -> bool:
   631		var path: String = {"wood": TEX_WOOD, "groove": TEX_GROOVE, "paper": TEX_PAPER}[kind]
   632		var tx := _ui_tex(path)
   633		if tx == null:
   634			return false
   635		var k := "t|%s|%s" % [kind, tint.to_html()]
   636		var sb: StyleBoxTexture = _sb_cache.get(k)
   637		if sb == null:
   638			sb = StyleBoxTexture.new()
   639			sb.texture = tx
   640			var m := 10.0 if kind != "paper" else 14.0
   641			sb.texture_margin_left = m
   642			sb.texture_margin_right = m
   643			sb.texture_margin_top = m
   644			sb.texture_margin_bottom = m
   645			# 羊皮紙整張拉伸（紋理不能無縫平鋪，平鋪會出現直條接縫）；木紋、凹槽平鋪保持紋理比例
   646			var mode := StyleBoxTexture.AXIS_STRETCH_MODE_STRETCH if kind == "paper" else StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
   647			sb.axis_stretch_horizontal = mode
   648			sb.axis_stretch_vertical = mode
   649			sb.modulate_color = tint
   650			_sb_cache[k] = sb
   651		draw_style_box(sb, r)
   652		return true
   653	
   654	## 圓角方塊（StyleBox 快取，不每幀配新物件）。
   655	## V1.2 B3：夠大、夠不透明的實心方塊改用木紋材質（用 bg 染色），外框線另外畫在上面；小東西與半透明的陰影維持平塗。
   656	func _box(r: Rect2, bg: Color, border := Color(0, 0, 0, 0), radius := 6.0, bw := 0.0) -> void:
   657		if bg.a >= 0.6 and minf(r.size.x, r.size.y) >= 20.0 and not bool(Save.s("plain_ui")) and _tex_box(r, "wood", Color(bg.r * 1.28, bg.g * 1.28, bg.b * 1.28, bg.a)):
   658			if bw > 0.0 and border.a > 0.0:
   659				_box(r, Color(0, 0, 0, 0), border, radius, bw)
   660			return
   661		var k := "%s|%s|%d|%d" % [bg.to_html(), border.to_html(), int(radius), int(bw * 10)]
   662		var sb: StyleBoxFlat = _sb_cache.get(k)
   663		if sb == null:
   664			sb = StyleBoxFlat.new()
   665			sb.bg_color = bg
   666			sb.border_color = border
   667			sb.set_corner_radius_all(int(radius))
   668			sb.set_border_width_all(int(ceilf(bw)))
   669			sb.anti_aliasing = true
   670			_sb_cache[k] = sb
   671		draw_style_box(sb, r)
