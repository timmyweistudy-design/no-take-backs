    96		painter.cb = cb
    97		painter.types = types
    98		var vp := _viewport(Vector2i(COLS * CELL, rows * CELL), painter)
    99		await RenderingServer.frame_post_draw
   100		await RenderingServer.frame_post_draw
   101		var img := vp.get_texture().get_image()
   102		vp.queue_free()
   103		img = await _post(img)
   104		if (1 if cb else 0) != ready_cb:
