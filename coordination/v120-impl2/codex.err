   106		# 新兵頁太多就丟最舊的（舊 10 種那兩頁不丟）
   107		if pages.size() >= MAX_PAGES:
   108			for i in pages.size():
   109				if pages[i] != null and int(pages[i]["types"][0]) >= D.COUNT:
   110					for t in pages[i]["types"]:
   111						if loc.has(t) and int(loc[t][0]) == i:
   112							loc.erase(t)
   113					pages[i] = null
   114					break
   115		var pn := pages.size()
   116		pages.append({"tex": ImageTexture.create_from_image(img), "types": types})
   117		for k in types.size():
   118			loc[types[k]] = [pn, k * 2 * FRAMES_PER]
   119	
   120	## V1.2 D1：烘好的整頁再跑一次後處理 shader（外輪廓＋頂亮底暗）。沒有 shader 檔或 plain_ui 時原樣。
   121	func _post(img: Image) -> Image:
   122		var sh_path := "res://shaders/unit_bake.gdshader"
   123		if not ResourceLoader.exists(sh_path) or bool(Save.s("plain_ui")):
   124			return img
   125		var tr := TextureRect.new()
   126		tr.texture = ImageTexture.create_from_image(img)
   127		tr.size = Vector2(img.get_width(), img.get_height())
   128		var mat := ShaderMaterial.new()
   129		mat.shader = load(sh_path)
   130		mat.set_shader_parameter("cell", float(CELL))
   131		mat.set_shader_parameter("per", float(FRAMES_PER))
   132		mat.set_shader_parameter("cols", float(COLS))
   133		tr.material = mat
   134		var vp := _viewport(Vector2i(img.get_width(), img.get_height()), tr)
   135		await RenderingServer.frame_post_draw
   136		await RenderingServer.frame_post_draw
   137		var out := vp.get_texture().get_image()
   138		vp.queue_free()
   139		return out
   140	
   141	func _bake_ring(cb: bool) -> void:
   142		var painter := _RingPainter.new()
   143		painter.cb = cb
   144		var vp := _viewport(Vector2i(4 * CELL, CELL), painter)
   145		await RenderingServer.frame_post_draw
   146		await RenderingServer.frame_post_draw
   147		ring_tex = ImageTexture.create_from_image(vp.get_texture().get_image())
   148		vp.queue_free()
   149	
   150	## variant 1（劍士交替招式）和 2（第四輪新兵的專屬動作）都用第二組攻擊格：新兵沒有交替招式，那一組烘的是專屬動作。
   151	func frame_index(type: int, team: int, walk: float, atk: float, t: float, px: float, variant := 0) -> int:
   152		var base: int = int(loc[type][1]) + team * FRAMES_PER
   153		if atk > 0.0:
   154			return base + 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * mini(variant, 1) + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
   155		if walk <= Gait.POSE_DAZE + 1.0:
   156			return base + 2 + WALK_FRAMES + 1
   157		if walk <= Gait.POSE_DRAG + 1.0:
   158			return base + 2 + WALK_FRAMES
   159		if walk != 0.0:
   160			return base + 2 + int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES
   161		var ex := 2.0 if type == D.CAVALRY else 3.5   # Art._eyes 的眼睛中心 x
   162		var blink := fmod(t + ex * 0.13, 3.7) <= 0.12   # 與 Art._eyes 相同的眨眼節奏
   163		return base + (1 if blink else 0)
   164	
   165	func draw_ring(ci: CanvasItem, p: Vector2, team: int, type: int, scale := 1.0) -> void:
   166		var idx := team * 2 + (1 if (type == D.SHIELD or type == D.CAVALRY or type == 19) else 0)
   167		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
   168		ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2(idx * CELL, 0, CELL, CELL))
   169		ci.draw_set_transform_matrix(Art.base)
   170	
   171	func _rect(idx: int) -> Rect2:
   172		return Rect2((idx % COLS) * CELL, (idx / COLS) * CELL, CELL, CELL)
   173	
   174	## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
   175	func quant_walk(walk: float) -> float:
   176		if walk == 0.0:
   177			return 0.0
   178		if walk < -50.0:
   179			return walk
   180		return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES
   181	
   182	func quant_atk(atk: float) -> float:
   183		if atk <= 0.0:
   184			return 0.0
   185		return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES
   186	
   187	## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
   188	func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
   189			hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false, variant := 0) -> void:
   190		var idx := frame_index(type, team, walk, atk, t, p.x, variant)
   191		if atk > 0.0:
   192			walk = 0.0   # 攻擊影格烘焙時沒有走路相位：貼圖與疊加都當成沒在走（Codex 收尾輪 #4）
   193		var bob := Art.idle_bob(t, p.x) if walk == 0.0 else 0.0   # 與 Art.unit 相同：沒走路時（含攻擊）都有呼吸
   194		var xf := Art.base * Transform2D(lean * face, Vector2(scale * face / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale))
   195		ci.draw_set_transform_matrix(xf)
   196		ci.draw_texture_rect_region(pages[loc[type][0]]["tex"], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
   197		if hurt > 0.0 or mood != 0:
   198			# 攻擊影格烘焙時沒有走路相位（Codex R5 #3）
   199			var qa := quant_atk(atk)
   200			var qw := 0.0 if qa > 0.0 else quant_walk(walk)
   201			ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, face, qw, qa, t, scale, lean, crouch, type) * Gait.body_xf(type, qw))
   202			if hurt > 0.0:
   203				ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, false)
   204			if mood != 0:
   205				Art.overlay(ci, type, team, mood, alpha, t, cb)
   206		ci.draw_set_transform_matrix(Art.base)
   207	
   208	## 烘焙用的畫家：一格一格呼叫 Art.unit（face＝+1，翻面由貼圖時處理）。
   209	class _Painter extends Node2D:
   210		var cb := false
   211		var types: Array = []
   212		func _draw() -> void:
   213			var Art2 = preload("res://scripts/ui/art.gd")
   214			var D2 = preload("res://scripts/core/unit_defs.gd")
   215			var saved: Transform2D = Art2.base
   216			Art2.base = Transform2D.IDENTITY
   217			var CELL2 := 192
   218			var RS2 := 1.6
   219			var W2 := 8
   220			var per := 2 + W2 + 2 + 8 + 8
   221			var cols := 16
   222			for k in types.size():
   223				var type: int = types[k]
   224				for team in 2:
   225					for f in per:
   226						var idx: int = (k * 2 + team) * per + f
   227						var cell_o := Vector2((idx % cols) * CELL2, (idx / cols) * CELL2)
   228						var walk := 0.0
   229						var atk := 0.0
   230						var vr := 0
   231						if f >= 2 and f < 2 + W2:
   232							walk = 0.0001 + (f - 2) * TAU / W2
   233						elif f == 2 + W2:
   234							walk = -100.0   # 拖行（Gait.POSE_DRAG）
   235						elif f == 3 + W2:
   236							walk = -200.0   # 暈眩（Gait.POSE_DAZE）
   237						elif f >= 4 + W2 + 8:
   238							atk = (f - (4 + W2 + 8) + 0.5) / 8.0
   239							vr = 1 if type < D2.CLASSIC else 2   # 第四輪新兵沒有交替招式，這一組放專屬動作（variant 2）
   240						elif f >= 4 + W2:
   241							atk = (f - (4 + W2) + 0.5) / 8.0
   242						var p := cell_o + (Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160)))
   243						var ex := 2.0 if type == D2.CAVALRY else 3.5
   244						# 眨眼那一格落在眨眼區間中間；其他格取 1.0（不在眨眼區間）
   245						var tt: float = (3.7 - ex * 0.13 + 0.05) if f == 1 else 1.0
   246						# 沒走路的格子（待機、眨眼、攻擊）Art.unit 會加呼吸位移；這裡反向抵銷，貼圖時再依當下時間加
   247						var pb := p
   248						if walk == 0.0:
   249							pb.y -= sin(tt * 3.0 + p.x * 0.05) * 0.8 * RS2
   250						Art2.unit(self, pb, type, team, 1.0, walk, atk, 0.0, 1.0, tt, RS2, cb, 0, 0.0, 1.0, vr)
   251			Art2.base = saved
   252	
   253	class _RingPainter extends Node2D:
   254		var cb := false
   255		func _draw() -> void:
   256			var Art2 = preload("res://scripts/ui/art.gd")
   257			var D2 = preload("res://scripts/core/unit_defs.gd")
   258			var saved: Transform2D = Art2.base
   259			Art2.base = Transform2D.IDENTITY
   260			for team in 2:
   261				for heavy in 2:
   262					var o := Vector2((team * 2 + heavy) * 192, 0) + Vector2(96, 140)
   263					Art2.ring(self, o, team, D2.SHIELD if heavy == 1 else D2.SWORD, cb, 1.6)
   264			Art2.base = saved
     1	extends Node
     2	## 音效與音樂（優化方案 H）：同類音效 80ms 內最多 2 個、音高 ±10% 隨機；音樂與音效分軌。
     3	## 優先權（第二輪方案 R8）：12 個聲道滿的時候，關鍵音（技能、死亡、最後時刻）會搶走優先權最低、播最久的普通命中音，
     4	## 不會被一堆砍擊聲擠掉。最後時刻慢動作時整體加低通濾波（悶住的心跳感）。
     5	
     6	const FILES := ["arrow", "backstab", "block", "brace", "charge", "clutch", "death", "frenzy", "hit", "lose",
     7		"place_heavy", "place_light", "place_mid", "slash", "start", "turn", "ui_click", "ui_deny", "win",
     8		"shatter", "bell", "bugle", "aircut", "alert", "snap", "taunt", "reveal", "boom", "heal",
     9		"poison", "baa", "chomp", "squish", "charge_up", "timestop", "raise", "vacuum", "stomp",
    10		"k_hover", "k_click", "k_back", "k_confirm", "k_tab", "k_toggle", "k_error", "k_open", "k_close", "k_unlock", "k_star", "k_place",
    11		"step_grass", "step_snow", "step_wood", "step_stone", "step_heavy", "hit_metal", "hit_wood", "hit_soft", "horn"]
    12	# 0 普通命中、1 防禦、2 技能／死亡、3 全場事件與介面
    13	const PRIO := {"hit": 0, "slash": 0, "arrow": 0, "block": 1, "brace": 1, "alert": 1, "taunt": 1, "reveal": 1,
    14		"shatter": 2, "bell": 2, "bugle": 2, "aircut": 2, "snap": 2, "charge": 2, "backstab": 2, "death": 2,
    15		"step_grass": 0, "step_snow": 0, "step_wood": 0, "step_stone": 0, "step_heavy": 1, "hit_metal": 0, "hit_wood": 0, "hit_soft": 0, "horn": 3,
    16		"k_hover": 3, "k_click": 3, "k_back": 3, "k_confirm": 3, "k_tab": 3, "k_toggle": 3, "k_error": 3, "k_open": 3, "k_close": 3, "k_unlock": 3, "k_star": 3, "k_place": 3,
    17		"poison": 0, "squish": 1, "charge_up": 1, "baa": 1, "chomp": 2, "timestop": 2, "raise": 2, "vacuum": 2, "stomp": 2, "clutch": 3, "frenzy": 3, "start": 3, "win": 3, "lose": 3, "turn": 3, "ui_click": 3, "ui_deny": 3}
    18	var _prio_of := {}       # 聲道 → 正在播的優先權
    19	var _started := {}       # 聲道 → 開始時間
    20	var _lowpass_idx := -1
    21	var streams := {}
    22	var players: Array[AudioStreamPlayer] = []
    23	var recent := {}   # 名稱 → [時間戳...]
    24	var music: AudioStreamPlayer
    25	var music_name := ""
    26	var amb: AudioStreamPlayer       # V9：地圖環境音
    27	var amb_name := ""
    28	var duck_t := 0.0                # V9：大招、號角時暫時壓低音樂
    29	var sfx_vol := 0.8
    30	var music_vol := 0.7
    31	var rng := RandomNumberGenerator.new()
    32	
    33	## V1.2 E：優先讀 CC0 錄音轉的 .ogg（tools/gen/import_audio.py），沒有才用程式合成的 .wav。
    34	## 同名變體（名稱__2、__3…）一起載入，播放時隨機挑、避免連續同一個。
    35	static func load_audio(n: String):
    36		for ext in ["ogg", "wav"]:
    37			var path := "res://audio/%s.%s" % [n, ext]
    38			if ResourceLoader.exists(path):
    39				return load(path)
    40		return null
    41	
    42	var variants := {}     # 名稱 → [stream...]（含本體）
    43	var _last_var := {}    # 名稱 → 上次用的變體索引
    44	
    45	func _ready() -> void:
    46		for n in FILES:
    47			var st = load_audio(n)
    48			if st:
    49				streams[n] = st
    50				var vs: Array = [st]
    51				for k in range(2, 9):
    52					var v = load_audio("%s__%d" % [n, k])
    53					if v == null:
    54						break
    55					vs.append(v)
    56				variants[n] = vs
    57		for i in 12:
    58			var p := AudioStreamPlayer.new()
    59			add_child(p)
    60			players.append(p)
    61		music = AudioStreamPlayer.new()
    62		add_child(music)
    63		music.finished.connect(func(): music.play())
    64		amb = AudioStreamPlayer.new()
    65		add_child(amb)
    66		amb.finished.connect(func(): amb.play())
    67		var lp := AudioEffectLowPassFilter.new()
    68		lp.cutoff_hz = 900.0
    69		AudioServer.add_bus_effect(0, lp)
    70		_lowpass_idx = AudioServer.get_bus_effect_count(0) - 1
    71		AudioServer.set_bus_effect_enabled(0, _lowpass_idx, false)
    72	
    73	## 最後時刻：整體低通（慢動作開始時開、結束時關）。
    74	func set_muffled(on: bool) -> void:
    75		if _lowpass_idx >= 0 and AudioServer.is_bus_effect_enabled(0, _lowpass_idx) != on:
    76			AudioServer.set_bus_effect_enabled(0, _lowpass_idx, on)
    77	
    78	## 聲道選擇（純函式，測試用）：先找空的；滿了就搶優先權最低（同級取最早開始）且低於新音效的。沒有可搶的回 -1。
    79	static func pick_channel(busy: Array, prios: Array, starts: Array, prio: int) -> int:
    80		for i in busy.size():
    81			if not busy[i]:
    82				return i
    83		var best := -1
    84		for i in busy.size():
    85			if prios[i] < prio and (best < 0 or prios[i] < prios[best] or (prios[i] == prios[best] and starts[i] < starts[best])):
    86				best = i
    87		return best
    88	
    89	func set_volumes(sfx_pct: int, music_pct: int) -> void:
    90		sfx_vol = sfx_pct / 100.0
    91		music_vol = music_pct / 100.0
    92		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
    93		if amb != null:
    94			amb.volume_db = linear_to_db(maxf(0.0001, sfx_vol * 0.22))   # 第十輪 B6：環境音跟音效音量
    95	
    96	func play(name: String, vol := 1.0) -> void:
    97		if not streams.has(name) or sfx_vol <= 0.0:
    98			return
    99		if int(PRIO.get(name, 0)) >= 2 and not name.begins_with("k_"):
   100			duck(0.7)
   101		var now := Time.get_ticks_msec()
   102		var r: Array = recent.get(name, [])
   103		r = r.filter(func(t): return now - t < 80)
   104		if r.size() >= 2:
   105			return
   106		r.append(now)
   107		recent[name] = r
   108		var pr: int = PRIO.get(name, 1)
   109		var busy: Array = []
   110		var prios: Array = []
   111		var starts: Array = []
   112		for i in players.size():
   113			busy.append(players[i].playing)
   114			prios.append(_prio_of.get(i, 0))
   115			starts.append(_started.get(i, 0))
   116		var ch := pick_channel(busy, prios, starts, pr)
   117		if ch < 0:
   118			return
   119		var p := players[ch]
   120		p.stop()
   121		p.stream = _pick_variant(name)
   122		p.pitch_scale = 1.0 + rng.randf_range(-0.1, 0.1)
   123		p.volume_db = linear_to_db(maxf(0.0001, sfx_vol * vol))
   124		p.play()
   125		_prio_of[ch] = pr
   126		_started[ch] = now
   127	
   128	## 變體：隨機挑一個，但不和上一次相同（只有一個就用它）。
   129	func _pick_variant(name: String):
   130		var vs: Array = variants.get(name, [streams[name]])
   131		if vs.size() <= 1:
   132			return vs[0]
   133		var k := rng.randi_range(0, vs.size() - 2)
   134		if k >= int(_last_var.get(name, -1)):
   135			k += 1
   136		_last_var[name] = k
   137		return vs[k]
   138	
   139	# ── 分軌戰鬥音樂（第三輪 S1）：低音、鼓、旋律三軌同時播、各自調音量 ──
   140	const LAYERS := ["music_battle_bass", "music_battle_drums", "music_battle_mel"]
   141	var layers: Array[AudioStreamPlayer] = []
   142	var layer_gain := [1.0, 0.35, 1.0]     # 目標
   143	var layer_cur := [1.0, 0.35, 1.0]      # 目前（平滑）
   144	
   145	func play_layers() -> void:
   146		music.stop()
   147		music_name = "layers"
   148		if layers.is_empty():
   149			for n in LAYERS:
   150				var p := AudioStreamPlayer.new()
   151				add_child(p)
   152				# 循環在匯入設定裡開（edit/loop_mode=2 整段循環）；檔案匯入時會壓縮，不能用位元組數自己算樣本數（Codex S7 #1）
   153				p.stream = load("res://audio/%s.wav" % n)
   154				layers.append(p)
   155		layer_cur = layer_gain.duplicate()
   156		for i in layers.size():
   157			layers[i].volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * layer_cur[i] * (0.45 if duck_t > 0.0 else 1.0)))
   158			layers[i].play(0.0)
   159	
   160	func stop_layers() -> void:
   161		for p in layers:
   162			p.stop()
   163	
   164	## 戰況 → 三軌目標音量：差距小（≤15%）鼓聲進來；最後時刻只留低音（心跳另外播）。
   165	static func layer_targets(close: bool, clutch: bool) -> Array:
   166		if clutch:
   167			return [1.0, 0.0, 0.0]
   168		return [1.0, 1.0 if close else 0.35, 1.0]
   169	
   170	func set_layer_targets(g: Array) -> void:
   171		layer_gain = g
   172		# 單軌：差距小時全音量、拉開時略小聲、最後時刻壓低（心跳另外播）
   173		single_gain = 0.55 if float(g[2]) <= 0.0 else (1.0 if float(g[1]) >= 1.0 else 0.8)
   174	
   175	var single_gain := 1.0
   176	var single_cur := 1.0
   177	
   178	func _process(delta: float) -> void:
   179		if duck_t > 0.0:
   180			duck_t -= delta
   181		# V1.2：單軌戰鬥曲用「緊張程度」調音量（分軌時的鼓聲進出改成整首大小聲），並套用大招壓低
   182		single_cur = move_toward(single_cur, single_gain, delta * 1.5)
   183		if music.playing:
   184			music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * single_cur * (0.45 if duck_t > 0.0 else 1.0)))
   185		if music_name != "layers" or layers.is_empty():
   186			return
   187		for i in layers.size():
   188			layer_cur[i] = move_toward(layer_cur[i], layer_gain[i], delta * 1.5)
   189			layers[i].volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * layer_cur[i] * (0.45 if duck_t > 0.0 else 1.0)))   # V1.2：分軌也要被大招壓低（原本漏乘）
   190	
   191	## V9：地圖環境音；空字串＝停。
   192	func play_ambience(name: String) -> void:
   193		if name == amb_name:
   194			return
   195		amb_name = name
   196		if name == "":
   197			amb.stop()
   198			return
   199		var st = load("res://audio/amb_%s.wav" % name)
   200		if st == null:
   201			amb.stop()
   202			return
   203		amb.stream = st
   204		amb.volume_db = linear_to_db(maxf(0.0001, sfx_vol * 0.22))
   205		amb.play()
   206	
   207	func duck(sec: float) -> void:
   208		duck_t = maxf(duck_t, sec)
   209	
   210	func play_music(name: String) -> void:
   211		# V1.2 E：有錄音的戰鬥曲（music_battle.ogg）就單軌播；沒有才用舊的合成三軌
   212		var real_battle := ResourceLoader.exists("res://audio/music_battle.ogg")
   213		if name == "music_battle" and not real_battle:
   214			if music_name != "layers":
   215				play_layers()
   216			return
   217		var src := name
   218		var pitch := 1.0
   219		if name == "music_frenzy" and real_battle:
   220			src = "music_battle"     # 狂熱：同一首加快一點，不換成合成音
   221			pitch = 1.08
   222		if name == music_name:
   223			return
   224		stop_layers()
   225		music_name = name
   226		var st = load_audio(src)
   227		if st == null:
   228			music.stop()
   229			return
   230		if "loop" in st:
   231			st.loop = true       # Ogg 的循環在這裡開（匯入預設不循環）
   232		music.stream = st
   233		music.pitch_scale = pitch
   234		single_gain = 1.0
   235		single_cur = 1.0
   236		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
   237		music.play()

