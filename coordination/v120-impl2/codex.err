   779	## 畫一隻角色：精靈圖快取好了就貼圖（快很多），否則直接用 Art 畫。畫面相同。
   780	func _unit(p: Vector2, type: int, team: int, face: float, walk: float, atk: float, hurt: float, alpha: float, t: float, scale := 1.0,
   781			mood := 0, lean := 0.0, crouch := 1.0, variant := 0) -> void:
   782		if scale > 1.4 and alpha > 0.5 and not bool(Save.s("plain_ui")):
   783			# V1.2 D2：大圖（圖鑑、MVP）站在木製圓底座上，像桌上的棋偶公仔
   784			var bw := 30.0 * scale
   785			var bh := 9.0 * scale
   786			draw_set_transform(p + Vector2(0, 2 * scale), 0.0, Vector2(1, bh / bw))
   787			draw_circle(Vector2(0, 3 * scale * bw / bh), bw * 1.04, Color(0, 0, 0, 0.3), true, -1.0, true)
   788			draw_circle(Vector2.ZERO, bw, Color("#5a3b22"), true, -1.0, true)
   789			draw_circle(Vector2(0, -2.2 * scale * bw / bh), bw * 0.96, Color("#8a5f37"), true, -1.0, true)
   790			draw_arc(Vector2(0, -2.2 * scale * bw / bh), bw * 0.96, PI * 1.1, PI * 1.9, 24, Color(1, 0.9, 0.7, 0.35), 2.0, true)
   791			draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
   792		if scale <= 1.4 and sprites != null and sprites.is_ready(cbm()) and sprites.has_type(type):   # V1.2：大圖（圖鑑、MVP）直接向量畫，放大圖集會糊
   793			sprites.draw_unit(self, p, type, team, face, walk, atk, hurt, alpha, t, scale, mood, lean, crouch, cbm(), variant)
   794		else:
   795			Art.unit(self, p, type, team, face, walk, atk, hurt, alpha, t, scale, cbm(), mood, lean, crouch, variant)
