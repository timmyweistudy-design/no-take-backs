    64	## 這場要用到的兵種。缺的才烘；烘的時候呼叫端先直接畫。
    65	func ensure(types: Array) -> void:
    66		if DisplayServer.get_name() == "headless" or ready_cb < 0:
    67			return
    68		for t in types:
    69			if not loc.has(t) and not t in _queue and not t in _baking:
    70				_queue.append(t)
    71		if _busy or _queue.is_empty():
    72			return
    73		_busy = true
    74		while not _queue.is_empty():
    75			var chunk: Array = _queue.slice(0, TYPES_PER_PAGE)
    76			_queue = _queue.slice(chunk.size())
    77			_baking = chunk
    78			await _bake_page(chunk)
    79			_baking = []
    80		_busy = false
