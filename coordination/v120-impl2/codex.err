    49	## 全部清掉，烘舊 10 種和腳底圈。
    50	func build(cb: bool) -> void:
    51		if DisplayServer.get_name() == "headless":
    52			return
    53		pages.clear()
    54		loc.clear()
    55		_queue.clear()
