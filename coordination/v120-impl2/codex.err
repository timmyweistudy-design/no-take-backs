    49	
    50	def trim(x, sr, thr=0.01):
    51	    a = np.abs(x if x.ndim == 1 else x.max(axis=1))
    52	    idx = np.nonzero(a > thr)[0]
    53	    if idx.size == 0:
    54	        return x
    55	    s = max(0, idx[0] - int(sr * 0.003))
    56	    e = min(len(x), idx[-1] + int(sr * 0.03))
    57	    return x[s:e]
    58	
    59	
    60	def finish(x, sr, peak):
    61	    m = np.max(np.abs(x))
    62	    if m > 0:
    63	        x = x * (peak / m)
    64	    n = min(len(x), int(sr * 0.015))
    65	    if n > 0:
    66	        fade = np.linspace(1.0, 0.0, n)
    67	        x[-n:] = (x[-n:].T * fade).T
    68	    return x
    69	
    70	
    71	def write(name, data, sr):
    72	    p = os.path.join(OUT, name + ".ogg")
    73	    sf.write(p, data, sr, format="OGG", subtype="VORBIS")
    74	    return os.path.getsize(p)
    75	
    76	
    77	def main():
    78	    total = 0
    79	    only_music = "--music" in sys.argv
    80	    for name, srcs in ({} if only_music else SFX).items():
    81	        for k, rel in enumerate(srcs):
    82	            x, sr = sf.read(os.path.join(SRC, rel), always_2d=False, dtype="float32")
    83	            if x.ndim == 2:
    84	                x = x.mean(axis=1)
    85	            x = finish(trim(x, sr), sr, 0.8)
    86	            total += write(name if k == 0 else f"{name}__{k + 1}", x, sr)
    87	        print("音效", name, len(srcs), "個變體")
    88	    for name, rel in MUSIC:
    89	        x, sr = sf.read(os.path.join(SRC, rel), always_2d=True, dtype="float32")
    90	        x = x * (0.85 / max(1e-6, np.max(np.abs(x))))
    91	        p = os.path.join(OUT, name + ".ogg")
    92	        # 一次寫整首會讓 libsndfile 的 Vorbis 編碼崩潰（大檔），分塊寫
    93	        with sf.SoundFile(p, "w", samplerate=sr, channels=x.shape[1], format="OGG", subtype="VORBIS") as f:
    94	            for i in range(0, len(x), 32768):
    95	                f.write(np.ascontiguousarray(x[i:i + 32768]))
    96	        total += os.path.getsize(p)
    97	        print("音樂", name, round(len(x) / sr, 1), "秒", os.path.getsize(p) // 1024, "KB")
    98	    print("合計", total // 1024, "KB")
    99	
   100	
   101	if __name__ == "__main__":
   102	    sys.exit(main())

