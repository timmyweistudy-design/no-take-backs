   276	var _probe_ui := false        # 只量介面層（不量戰場上的跳字）
   277	var probe_texts: Array = []
   278	var probe_btns: Array = []      # 第五輪：這一幀畫出來的按鈕外框（點擊框大小檢查）
   279	var probe_ctrls: Array = []
   280	var _probe_btn_label := false
   281	var _probe_btn_rect := Rect2()     # 第五輪：其他控制項（兵卡）的外框；裡面的字不算段數     # 截圖用：特效停在當下的時刻不往前跑
   282	var pt_call_tick := -1
   283	var pt_rated := false
   284	
   285	# 標題背景的展示戰
   286	var demo = null
   287	var demo_acc := 0.0
   288	
