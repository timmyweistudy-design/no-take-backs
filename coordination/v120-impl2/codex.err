    41	const FEATURE_EYES := {10: Vector2(1.5, -13), 13: Vector2(3, -17), 18: Vector2(3, -33), 19: Vector2(1, -31), 20: Vector2(2, -11)}
    42	
    43	
    44	static func team_color(team: int, cb := false) -> Color:
    45		return TEAM[1 if cb else 0][team]
    46	
    47	
    48	static func _smooth(u: float) -> float:
    49		return u * u * (3.0 - 2.0 * u)
    50	
    51	
    52	static func _star(ci: CanvasItem, c: Vector2, r: float, col: Color) -> void:
    53		ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0, -r), c + Vector2(r * 0.28, -r * 0.28), c + Vector2(r, 0), c + Vector2(r * 0.28, r * 0.28),
    54			c + Vector2(0, r), c + Vector2(-r * 0.28, r * 0.28), c + Vector2(-r, 0), c + Vector2(-r * 0.28, -r * 0.28)]), col)
    55	
    56	
    57	static func _c(ci: CanvasItem, c: Vector2, r: float, col: Color, a: float, outline := true) -> void:
    58		if outline:
    59			ci.draw_circle(c, r + INNER_W, Color(OUT, a), true, -1.0, true)
    60		ci.draw_circle(c, r, Color(col, col.a * a), true, -1.0, true)
    61	
    62	
    63	static func _poly(ci: CanvasItem, pts: PackedVector2Array, col: Color, a: float, outline := true) -> void:
    64		if outline:
    65			var closed := pts.duplicate()
    66			closed.append(pts[0])
    67			ci.draw_polyline(closed, Color(OUT, a), INNER_W * 2.0, true)
    68		ci.draw_colored_polygon(pts, Color(col, col.a * a))
    69	
    70	
    71	static func _line(ci: CanvasItem, a: Vector2, b: Vector2, col: Color, w: float, al: float) -> void:
    72		ci.draw_line(a, b, Color(OUT, al), w + INNER_W * 1.9, true)
    73		ci.draw_line(a, b, Color(col, col.a * al), w, true)
    74	
    75	
    76	static func _eyes(ci: CanvasItem, c: Vector2, a: float, t: float, angry := false) -> void:
    77		var blink := 1.0 if fmod(t + c.x * 0.13, 3.7) > 0.12 else 0.15
    78		for dx in [-3.0, 4.0]:
    79			var e := c + Vector2(dx, 0)
    80			ci.draw_circle(e, 2.6, Color(OUT, a), true, -1.0, true)
    81			if blink > 0.5:
    82				ci.draw_circle(e + Vector2(0.7, -0.8), 0.9, Color(1, 1, 1, a), true, -1.0, true)
    83			else:
    84				ci.draw_rect(Rect2(e - Vector2(2.6, 0.6), Vector2(5.2, 1.2)), Color(SKIN, a))
    85		ci.draw_circle(c + Vector2(-6.5, 4.0), 2.4, Color(BLUSH, BLUSH.a * a), true, -1.0, true)
    86		ci.draw_circle(c + Vector2(7.5, 4.0), 2.4, Color(BLUSH, BLUSH.a * a), true, -1.0, true)
    87		if angry:
    88			# 攻擊：眉毛內傾＋嘴巴張開
    89			ci.draw_line(c + Vector2(-5.2, -4.4), c + Vector2(-1.0, -3.2), Color(OUT, a), 1.5, true)
    90			ci.draw_line(c + Vector2(6.2, -4.4), c + Vector2(2.0, -3.2), Color(OUT, a), 1.5, true)
    91			ci.draw_circle(c + Vector2(0.5, 4.6), 1.7, Color(OUT, a), true, -1.0, true)
    92			ci.draw_circle(c + Vector2(0.5, 5.2), 0.9, Color("#e05a6a", a), true, -1.0, true)
    93		else:
    94			ci.draw_arc(c + Vector2(0.5, 4.2), 1.8, 0.2, PI - 0.2, 6, Color(OUT, a), 1.2, true)
