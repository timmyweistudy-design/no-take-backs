+	if col.a > 0.3 and s >= 14.0 and not bool(Save.s("plain_ui")):
+		var off := maxf(1.0, s * 0.07)
+		Icons.draw(self, name, c + Vector2(off, off), s, Color(INK, col.a * 0.75))
 	Icons.draw(self, name, c, s, col)
 
