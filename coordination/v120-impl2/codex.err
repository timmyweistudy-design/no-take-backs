 const D = preload("res://scripts/core/unit_defs.gd")
 const Gait = preload("res://scripts/ui/units/gait.gd")
+const Save = preload("res://scripts/game/save.gd")
 
 const CELL := 192          # 每格像素（以 RS 倍率畫）；比角色大一圈，避免相鄰格子滲色
 const RS := 1.6            # 烘焙解析度倍率
