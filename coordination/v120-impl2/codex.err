    24	const TEAM := [[Color("#45acff"), Color("#d93a44")], [Color("#2f80ff"), Color("#ffb000")]]   # 第七輪：紅壓暗，灰階下敵我也分得開（小樣通過條件 ②）
    25	
    26	# ── 三段式攻擊（第二輪方案 R5）──
    27	# atk（0～1）＝一次攻擊動作的進度：0～ATK_WINDUP 前搖、ATK_WINDUP～ATK_STRIKE 揮擊（命中就在 ATK_WINDUP 那一刻）、之後後搖。
    28	const ATK_WINDUP := 0.3125
    29	const ATK_STRIKE := 0.53125
    30	const LEAN_BACK := 0.2618     # 前搖身體後傾 15°（第三輪 R1，原 12°）
    31	const LEAN_FWD := 0.3840      # 揮擊前撲 22°（第三輪 R1，原 18°）
    32	
    33	# 臉部疊加（表情）：同一份畫法同時給直接繪製與精靈圖快取用，兩條路看起來一樣
    34	const M_HURT := 1             # 受擊／暈眩：>< 眼
    35	const M_SPARKLE := 2          # 騎兵衝鋒蓄滿：亮晶晶眼＋槍尖金光
    36	const M_BROWS := 4            # 狂熱：眉毛內傾
    37	const M_HOOD := 8             # 刺客潛行：帽簷壓低、黃眼每 0.4 秒眨一次
    38	const M_BRACE := 16           # 盾兵頂住：盾放大 1.35 倍
    39	
