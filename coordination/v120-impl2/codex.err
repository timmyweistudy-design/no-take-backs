+## V1.2 A1：英數字型疊在中文字型上（中文缺字落到後備）。沒有英數字型檔時直接用中文字型。
+func _latin_over(path: String, cjk: Font) -> Font:
+	if ResourceLoader.exists(path):
+		var lf = load(path)
+		if lf is FontFile:
+			var f2: FontFile = lf.duplicate()
+			f2.fallbacks = [cjk]
+			return f2
+	return _tnum(cjk)
+
