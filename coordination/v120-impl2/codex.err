   116	## 戰力走勢：log2＝每 tick [藍戰力, 紅戰力] 交錯；b0／b1＝兩邊預算。
   117	## 值＝藍比例 ÷（藍比例＋紅比例），以 50% 為界上藍下紅；雙方都 0 時沿用上一點；最後一段做平滑（第五輪 §4.3）。
   118	## marks＝[{t, label}] 最多畫 3 個，標籤不重疊。回傳每個取樣點的 y（測試用）。
   119	static func momentum(ui, rect: Rect2, log2: PackedInt64Array, b0: int, b1: int, marks: Array, total_ticks := 0) -> Array:
   120		var cb: bool = ui.cbm()
   121		var n := log2.size() / 2
   122		var mid := rect.position.y + rect.size.y / 2
   123		# V1.2 C3：羊皮紙底＋墨水中線（原本是半透明黑底、白線，像看盤軟體）
   124		var paper: bool = ui.has_method("_tex_box") and not bool(ui.Save.s("plain_ui")) and ui._tex_box(rect.grow_individual(6, 6, 6, 2), "paper")
   125		if not paper:
   126			ui.draw_rect(rect, Color(0, 0, 0, 0.25))
   127		ui.draw_line(Vector2(rect.position.x, mid), Vector2(rect.end.x, mid), Color(0.14, 0.08, 0.04, 0.55) if paper else Color(1, 1, 1, 0.35), 1.0)
   128		var wash := 0.62 if paper else 0.85
   129		if n <= 1:
   130			return []
   131		var span := maxi(n, total_ticks)
   132		var cols := int(minf(rect.size.x, 240.0))
   133		var ys: Array = []
   134		var last := 0.5
   135		for k in cols + 1:
   136			var t := mini(n - 1, int(float(k) / cols * (span - 1)))
   137			if float(k) / cols * (span - 1) > n - 1:
   138				break
   139			var p0 := float(log2[2 * t]) / maxf(1.0, b0)
   140			var p1 := float(log2[2 * t + 1]) / maxf(1.0, b1)
   141			var v := last
   142			if p0 + p1 > 0.0:
   143				v = p0 / (p0 + p1)
   144				# 雙方都快打光時分母很小，曲線會劇烈跳：剩不到 6% 時向上一點靠攏
   145				if p0 + p1 < 60.0:
   146					v = lerpf(last, v, 0.35)
   147			last = v
   148			ys.append(v)
   149		var dx := rect.size.x / cols
   150		for k in ys.size():
   151			var x := rect.position.x + k * dx
   152			var y: float = rect.end.y - rect.size.y * ys[k]
   153			if y < mid:
   154				ui.draw_rect(Rect2(x, y, dx + 0.5, mid - y), team_col(0, cb) * Color(1, 1, 1, wash))
   155			else:
   156				var rr := Rect2(x, mid, dx + 0.5, y - mid)
   157				ui.draw_rect(rr, team_col(1, cb) * Color(1, 1, 1, wash))
   158		if paper:
   159			# 墨線描出戰力曲線（像手繪在紙上）
   160			var ink := PackedVector2Array()
   161			for k2 in ys.size():
   162				ink.append(Vector2(rect.position.x + k2 * dx, rect.end.y - rect.size.y * ys[k2]))
   163			if ink.size() >= 2:
   164				ui.draw_polyline(ink, Color(0.14, 0.08, 0.04, 0.85), 1.6, true)
   165		if cb:
