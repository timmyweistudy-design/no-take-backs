diff --git a/tools/gen/gen_ui_tex.py b/tools/gen/gen_ui_tex.py
new file mode 100644
index 0000000..baf8195
--- /dev/null
+++ b/tools/gen/gen_ui_tex.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""V1.2 B3：介面材質貼圖（程式生成、本作原創、零授權成本）。只用 Pillow。
+輸出（九宮格用，都是灰階或中性色，遊戲裡用 modulate 染成原本的底色，配色不變）：
+  wood.png    木紋方塊：圓角 8、上緣亮斜角、下緣暗斜角、細木紋（灰階 → 用底色染）
+  paper.png   羊皮紙：纖維、斑點、邊緣微焦（本身就是紙色，不再染）
+  groove.png  凹槽：內陰影（灰階 → 用底色染）
+  frame.png   面板外框：深木框＋四角銅釘（直接用，不染）
+  vignette.png 暈影：中心透明、四周暗（戰場與標題用）
+用法：python3 tools/gen/gen_ui_tex.py <輸出資料夾>（預設 game/art/ui）
+"""
+import math
+import os
+import random
+import sys
+
+from PIL import Image, ImageChops, ImageDraw, ImageFilter
+
+OUT = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(__file__), "..", "..", "game", "art", "ui")
+os.makedirs(OUT, exist_ok=True)
+R = random.Random(20261107)
+
+
+def noise(w, h, scale_x, scale_y, sigma=64):
+    """拉長的雜訊：先生成小張雜訊再放大（木紋＝橫向拉長）。"""
+    n = Image.effect_noise((max(1, w // scale_x), max(1, h // scale_y)), sigma)
+    return n.resize((w, h), Image.BICUBIC)
+
+
+def rounded_mask(w, h, rad):
+    m = Image.new("L", (w, h), 0)
+    ImageDraw.Draw(m).rounded_rectangle((0, 0, w - 1, h - 1), rad, fill=255)
+    return m
+
+
+def bevel(w, h, rad, top=46, bottom=56):
+    """上亮下暗的斜角：用逐列漸層（128＝不變），圓角由遮罩處理，四角不會缺。"""
+    b = Image.new("L", (w, h), 128)
+    px = b.load()
+    for y in range(h):
+        if y < 3:
+            v = 128 + int(top * (1 - y / 3))
+        elif y >= h - 4:
+            v = 128 - int(bottom * ((y - (h - 4)) / 3))
+        else:
+            v = 128 + int(10 * (0.5 - y / h))   # 上半略亮、下半略暗的柔和明暗
+        for x in range(w):
+            px[x, y] = v
+    return b
+
+def apply_shift(base, shift):
+    """base（L）加上 shift（128＝0）。"""
+    return ImageChops.add(ImageChops.subtract(base, Image.new("L", base.size, 128)), shift, 1.0, -128).point(lambda v: max(0, min(255, v)))
+
+
+def wood(w=64, h=64, rad=8):
+    g = noise(w, h, 32, 2, 40).filter(ImageFilter.GaussianBlur(1.0))
+    g = g.point(lambda v: int(200 + (v - 128) * 0.12))   # 紋理更淡、更長（Antigravity impl1：太密像拉絲金屬）          # 很淡的木紋：底色 ~200
+    # 幾條較深的木紋線
+    d = ImageDraw.Draw(g)
+    for k in range(3):
+        y = R.randint(6, h - 6)
+        amp = R.uniform(0.5, 2.0)
+        pts = [(x, y + amp * math.sin(x / R.uniform(6, 12) + k)) for x in range(0, w, 2)]
+        d.line(pts, fill=184, width=1)
+    g = g.filter(ImageFilter.GaussianBlur(0.4))
+    g = ImageChops.add(g, bevel(w, h, rad), 1.0, -128)
+    img = Image.merge("LA", (g, rounded_mask(w, h, rad)))
+    return img.convert("RGBA")
+
+
+def groove(w=48, h=48, rad=6):
+    g = Image.new("L", (w, h), 200)
+    sh = Image.new("L", (w, h), 0)
+    d = ImageDraw.Draw(sh)
+    for i in range(6):
+        d.rounded_rectangle((i, i, w - 1 - i, h - 1 - i), max(1, rad - i), outline=int(70 - i * 11))
+    sh = sh.filter(ImageFilter.GaussianBlur(1.2))
+    g = ImageChops.subtract(g, sh)
+    g = ImageChops.add(g, noise(w, h, 2, 2, 20).point(lambda v: int((v - 128) * 0.15 + 128)), 1.0, -128)
+    img = Image.merge("LA", (g, rounded_mask(w, h, rad)))
+    return img.convert("RGBA")
+
+
+def paper(w=128, h=128, rad=6):
+    base = Image.new("RGB", (w, h), (236, 218, 182))
+    fib = noise(w, h, 8, 3, 60).filter(ImageFilter.GaussianBlur(0.8)).point(lambda v: int((v - 128) * 0.12 + 128))
+    blot = noise(w, h, 24, 24, 80).filter(ImageFilter.GaussianBlur(4)).point(lambda v: int((v - 128) * 0.25 + 128))
+    tone = ImageChops.add(fib, blot, 1.0, -128)
+    r, g, b = base.split()
+    r = ImageChops.add(r, tone, 1.0, -128)
+    g = ImageChops.add(g, tone, 1.0, -128)
+    b = ImageChops.add(b, tone, 1.0, -132)
+    img = Image.merge("RGB", (r, g, b))
+    # 邊緣微焦
+    edge = Image.new("L", (w, h), 0)
+    d = ImageDraw.Draw(edge)
+    for i in range(10):
+        d.rounded_rectangle((i, i, w - 1 - i, h - 1 - i), rad, outline=int(90 * (1 - i / 10)))
+    edge = edge.filter(ImageFilter.GaussianBlur(2))
+    burn = Image.new("RGB", (w, h), (120, 80, 40))
+    img = Image.composite(burn, img, edge.point(lambda v: int(v * 0.55)))
+    out = img.convert("RGBA")
+    out.putalpha(rounded_mask(w, h, rad))
+    return out
+
+
+def frame(w=96, h=96, border=14, rad=12):
+    """面板外框：深木框（內部透明），四角銅釘。"""
+    wd = wood(w, h, rad)
+    col = Image.new("RGBA", (w, h), (92, 64, 42, 255))
+    img = ImageChops.multiply(col, wd)
+    img.putalpha(rounded_mask(w, h, rad))
+    hole = Image.new("L", (w, h), 255)
+    ImageDraw.Draw(hole).rounded_rectangle((border, border, w - 1 - border, h - 1 - border), 6, fill=0)
+    a = ImageChops.multiply(img.getchannel("A"), hole)
+    img.putalpha(a)
+    d = ImageDraw.Draw(img)
+    # 內緣暗線（框和內容之間的陰影）
+    d.rounded_rectangle((border - 1, border - 1, w - border, h - border), 7, outline=(26, 16, 10, 200), width=2)
+    for cx, cy in [(border // 2 + 1, border // 2 + 1), (w - border // 2 - 2, border // 2 + 1), (border // 2 + 1, h - border // 2 - 2), (w - border // 2 - 2, h - border // 2 - 2)]:
+        d.ellipse((cx - 4, cy - 4, cx + 4, cy + 4), fill=(141, 98, 52, 255), outline=(40, 24, 12, 255))
+        d.ellipse((cx - 2, cy - 2, cx, cy), fill=(239, 214, 160, 255))
+    return img
+
+
+def vignette(w=256, h=160):
+    m = Image.new("L", (w, h), 0)
+    px = m.load()
+    for y in range(h):
+        for x in range(w):
+            dx = (x - w / 2) / (w / 2)
+            dy = (y - h / 2) / (h / 2)
+            dd = math.sqrt(dx * dx * 0.9 + dy * dy * 1.1)
+            px[x, y] = int(max(0.0, min(1.0, (dd - 0.6) / 0.6)) ** 1.6 * 150)
+    img = Image.new("RGBA", (w, h), (20, 11, 6, 0))
+    img.putalpha(m.filter(ImageFilter.GaussianBlur(3)))
+    return img
+
+
+def cursor(s=32):
+    """游標：斜放的小劍（劍尖在左上 (2,2)），深焦茶描邊、鋼刃、木柄、金護手。"""
+    img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
+    d = ImageDraw.Draw(img)
+    ink = (36, 21, 11, 255)
+    blade = [(2, 2), (6, 3), (19, 16), (16, 19), (3, 6)]
+    d.polygon(blade, fill=(214, 222, 235, 255), outline=ink)
+    d.line([(4, 4), (17, 17)], fill=(250, 252, 255, 255), width=1)
+    d.line([(14, 22), (22, 14)], fill=ink, width=5)
+    d.line([(14, 22), (22, 14)], fill=(232, 178, 74, 255), width=3)
+    d.line([(19, 19), (27, 27)], fill=ink, width=6)
+    d.line([(19, 19), (27, 27)], fill=(150, 96, 52, 255), width=4)
+    d.ellipse((25, 25, 30, 30), fill=(232, 178, 74, 255), outline=ink)
+    return img
+
+
+for name, im in [("cursor", cursor()), ("wood", wood()), ("groove", groove()), ("paper", paper()), ("frame", frame()), ("vignette", vignette())]:
+    p = os.path.join(OUT, name + ".png")
+    im.save(p)
+    print(name, im.size, os.path.getsize(p), "B")
diff --git a/tools/gen/import_audio.py b/tools/gen/import_audio.py
new file mode 100644
index 0000000..f6054a5
--- /dev/null
+++ b/tools/gen/import_audio.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""V1.2 E：把 CC0 錄音素材轉成遊戲用的 Ogg Vorbis（取代程式合成的音樂與部分音效）。
+來源都在 OpenGameArt、逐頁確認是 CC0（原始頁面存在 build/dl/oga/<頁面>/page.html），授權登記在 THIRD_PARTY_LICENSES.md。
+處理：轉單聲道（音效）／保留立體聲（音樂）、去頭尾靜音、峰值正規化、尾端 15ms 淡出；同名多個變體存成 名稱、名稱__2、名稱__3…
+（sfx.gd 會隨機挑變體、避免連續抽到同一個）。
+用法（需要 soundfile、numpy；用專案的 venv）：build/venv-audio/bin/python tools/gen/import_audio.py
+"""
+import os
+import sys
+
+import numpy as np
+import soundfile as sf
+
+ROOT = os.path.join(os.path.dirname(__file__), "..", "..")
+SRC = os.path.join(ROOT, "build", "dl", "oga")
+OUT = os.path.join(ROOT, "game", "audio")
+
+SW = "20-sword-sound-effects-attacks-and-clashes/x"
+MW = "100-cc0-metal-and-wood-sfx/x"
+RPG = "50-rpg-sound-effects/x/OGG"
+
+# 遊戲裡的音效名稱 → 來源檔（多個＝變體）
+SFX = {
+    "slash": [f"{SW}/sword - StarNinjas/sword.{i}.ogg" for i in (1, 2, 3, 4, 5)],
+    "block": [f"{SW}/sword_clash.{i}.ogg" for i in (1, 2, 3, 4)],
+    "hit": [f"{RPG}/chop.ogg", f"{RPG}/knifeSlice.ogg", f"{RPG}/knifeSlice2.ogg"],
+    "hit_metal": [f"{MW}/metal_hit_0{i}.ogg" for i in (1, 2, 3, 4)],
+    "hit_wood": [f"{MW}/wood_hit_0{i}.ogg" for i in (1, 2, 3, 4)],
+    "place_light": [f"{RPG}/bookPlace{i}.ogg" for i in (1, 2, 3)],
+    "place_mid": [f"{MW}/wood_hit_0{i}.ogg" for i in (1, 3)],
+    "place_heavy": [f"{RPG}/dropLeather.ogg", f"{MW}/wood_close_01.ogg"],
+    "k_tab": [f"{RPG}/bookFlip{i}.ogg" for i in (1, 2, 3)],
+    "k_open": [f"{RPG}/bookOpen.ogg"],
+    "k_close": [f"{RPG}/bookClose.ogg"],
+    "k_place": [f"{RPG}/bookPlace{i}.ogg" for i in (2, 3)],
+    "k_star": [f"{RPG}/handleCoins.ogg", f"{RPG}/handleCoins2.ogg"],
+    "k_unlock": [f"{RPG}/metalLatch.ogg"],
+    "step_grass": [f"{RPG}/footstep0{i}.ogg" for i in (0, 1, 2, 3)],
+    "step_stone": [f"{RPG}/footstep0{i}.ogg" for i in (4, 5, 6)],
+    "step_wood": [f"{RPG}/footstep0{i}.ogg" for i in (7, 8, 9)],
+}
+# 音樂：（名稱, 來源, 長度上限秒）
+MUSIC = [
+    ("music_title", "medieval-the-bards-tale/Loop_The_Bards_Tale.wav"),
+    ("music_place", "medieval-the-old-tower-inn/Loop_The_Old_Tower_Inn.wav"),
+    ("music_battle", "medieval-minstrel-dance/Loop_Minstrel_Dance_0.wav"),
+]
+
+
+def trim(x, sr, thr=0.01):
+    a = np.abs(x if x.ndim == 1 else x.max(axis=1))
+    idx = np.nonzero(a > thr)[0]
+    if idx.size == 0:
+        return x
+    s = max(0, idx[0] - int(sr * 0.003))
+    e = min(len(x), idx[-1] + int(sr * 0.03))
+    return x[s:e]
+
+
+def finish(x, sr, peak):
+    m = np.max(np.abs(x))
+    if m > 0:
+        x = x * (peak / m)
+    n = min(len(x), int(sr * 0.015))
+    if n > 0:
+        fade = np.linspace(1.0, 0.0, n)
+        x[-n:] = (x[-n:].T * fade).T
+    return x
+
+
+def write(name, data, sr):
+    p = os.path.join(OUT, name + ".ogg")
+    sf.write(p, data, sr, format="OGG", subtype="VORBIS")
+    return os.path.getsize(p)
+
+
+def main():
+    total = 0
+    only_music = "--music" in sys.argv
+    for name, srcs in ({} if only_music else SFX).items():
+        for k, rel in enumerate(srcs):
+            x, sr = sf.read(os.path.join(SRC, rel), always_2d=False, dtype="float32")
+            if x.ndim == 2:
+                x = x.mean(axis=1)
+            x = finish(trim(x, sr), sr, 0.8)
+            total += write(name if k == 0 else f"{name}__{k + 1}", x, sr)
+        print("音效", name, len(srcs), "個變體")
+    for name, rel in MUSIC:
+        x, sr = sf.read(os.path.join(SRC, rel), always_2d=True, dtype="float32")
+        x = x * (0.85 / max(1e-6, np.max(np.abs(x))))
+        p = os.path.join(OUT, name + ".ogg")
+        # 一次寫整首會讓 libsndfile 的 Vorbis 編碼崩潰（大檔），分塊寫
+        with sf.SoundFile(p, "w", samplerate=sr, channels=x.shape[1], format="OGG", subtype="VORBIS") as f:
+            for i in range(0, len(x), 32768):
+                f.write(np.ascontiguousarray(x[i:i + 32768]))
+        total += os.path.getsize(p)
+        print("音樂", name, round(len(x) / sr, 1), "秒", os.path.getsize(p) // 1024, "KB")
+    print("合計", total // 1024, "KB")
+
+
+if __name__ == "__main__":
+    sys.exit(main())
