## 戰鬥核心（純邏輯、全整數、確定性）。企劃 §2.3、§2.4、§3.3；優化方案 B1、L1。
## 每 tick 固定五步：①讀快照 ②選目標＋提出移動 ③統一解碰撞 ④產生攻擊 ⑤同時結算。
## 任何一步都只讀「這一步開始前」的狀態，所以不會因為誰先算就佔便宜。
## 禁止新增浮點運算（imath.isqrt 內的浮點估計之後一定用整數修正）。
## 指紋＝每 tick 完整狀態（固定欄位、int64 小端序）串接後的 SHA-256。

const D = preload("res://scripts/core/unit_defs.gd")
const M = preload("res://scripts/core/imath.gd")

const TPS := 20
const MAX_TICKS := D.MATCH_TICKS
const FRENZY_TICK := D.FRENZY_TICK
const CELL := 1000
const COLS := 16
const ROWS := 9
const W := COLS * CELL
const H := ROWS * CELL
const MIN_SEP := D.MIN_SEP
const EDGE := 200

class Unit:
	var id: int
	var team: int
	var type: int
	var x: int
	var y: int
	var hp: int
	var max_hp: int
	var cost: int
	var reach: int
	var speed: int
	var atk: int
	var cd_base: int
	var cd := 0                # 子刻度（×4）；平常每 tick 扣 4，狂熱扣 FRENZY_CD_RATE
	var target := -1           # 目標的索引
	var fx := 0                # 面向（長度約 1000）
	var fy := 0
	var face_lock := -1        # 面向鎖定中的目標索引（交戰中只在換目標時重算面向）
	var mx := 0                # 這一 tick 提出的移動
	var my := 0
	var cdx := 0               # 騎兵這段衝鋒的起始方向
	var cdy := 0
	var stealth := 0
	var charge := 0
	var stun := 0
	var slow := 0
	var wp_x := -1             # 騎兵繞翼途經點
	var wp_y := -1
	var wp_for := -1
	var alive := true
	var dmg_dealt := 0
	var dmg_taken := 0
	var kills := 0

var units: Array[Unit] = []    # 依 id 排序
var tick := 0
var budget := 100
var finished := false
var winner := -2               # -2 進行中；-1 平手；0／1 勝方
var reason := ""
var fingerprint := ""          # 結束時的 SHA-256（十六進位）
var events: Array = []         # 這一 tick 的事件（給畫面演出用，不影響計算）
var frenzy := false
var rally := [false, false]    # 這一 tick 哪一隊在「背水」（畫面提示用；計算用的是第④步當下的值）
var power_log: PackedInt64Array = PackedInt64Array()   # 每 tick 的（藍戰力−紅戰力），懸念指標用
var _hash := HashingContext.new()
var fast := false              # 平衡工具用：不算每 tick 指紋（結果完全一樣，只是沒有指紋）

func _init(army0, army1) -> void:
	budget = army0.budget
	_hash.start(HashingContext.HASH_SHA256)
	var raw: Array = []
	for a in [army0, army1]:
		for u in a.units:
			raw.append([a.team * 1000 + u["row"] * COLS + u["col"], a.team, u])
	raw.sort_custom(func(p, q): return p[0] < q[0])
	for r in raw:
		var u = r[2]
		var s: Dictionary = D.STATS[u["type"]]
		var n := Unit.new()
		n.id = r[0]
		n.team = r[1]
		n.type = u["type"]
		n.x = u["col"] * CELL + CELL / 2
		n.y = u["row"] * CELL + CELL / 2
		n.hp = s["hp"]
		n.max_hp = s["hp"]
		n.cost = s["cost"]
		n.reach = s["reach"]
		n.speed = s["speed"]
		n.atk = s["atk"]
		n.cd_base = s["cd"]
		n.fx = 1000 if n.team == 0 else -1000
		if n.type == D.ASSASSIN:
			n.stealth = D.STEALTH_TICKS
		units.append(n)
	var hdr := PackedInt64Array([D.RULES_VERSION_INT, budget, units.size()])
	_hash.update(hdr.to_byte_array())
	_hash.update(D.data_digest().to_utf8_buffer())
extends RefCounted
## ════════════════════════════════════════════════════════════════════
##  《落子無悔》兵種數值表 —— 要調平衡只改這個檔案
## ════════════════════════════════════════════════════════════════════
## 單位換算（全部整數，才能保證兩台電腦算出一樣的結果）：
##   距離：1000 ＝ 1 格        例：reach 700 ＝ 0.7 格
##   時間：1 tick ＝ 1/20 秒   例：cd 20 ＝ 1 秒攻擊一次
##   速度：千分之一格／tick     例：speed 60 ＝ 每秒 1.2 格（60×20÷1000）
##   倍率：寫成「分子／分母」   例：NUM 5、DEN 2 ＝ ×2.5
## 改完跑：cd game && godot --headless --path . --script res://tools/balance.gd

enum { SWORD, SHIELD, ARCHER, CAVALRY, ASSASSIN }

## 規則版本：改了戰鬥規則（不是只改數值）就要升版；重播與陣型代碼會帶這個版本。
const RULES_VERSION := "1.1.0"
const RULES_VERSION_INT := 10100

const COUNT := 5
const NAMES := ["劍士", "盾兵", "弓箭手", "騎兵", "刺客"]
const BLURB := [
	"破盾、被刺客打會反擊",
	"正面擋箭、頂住衝鋒、拒馬（打騎兵×2）、嘲諷近戰",
	"遠程拋射、優先射現形刺客（傷害×1.5）",
	"直衝 3 格後重擊、皮甲（箭傷減半）、繞過盾兵找弓手",
	"開場潛行、背刺×2、絆馬",
]

# ─── 基本數值 ───
#   cost  ＝ 價錢（金）
#   hp    ＝ 血量
#   atk   ＝ 每次攻擊傷害
#   cd    ＝ 攻擊間隔（tick；20＝1 秒）
#   reach ＝ 攻擊距離（中心到中心；1000＝1 格）
#   speed ＝ 移動速度（千分之一格／tick；50＝每秒 1 格）
const STATS := [
	{"cost": 5, "hp": 250, "atk": 10, "cd": 20, "reach": 700, "speed": 60},   # 劍士
	{"cost": 5, "hp": 450, "atk": 6, "cd": 24, "reach": 700, "speed": 45},    # 盾兵
	{"cost": 4, "hp": 150, "atk": 12, "cd": 24, "reach": 6000, "speed": 50},  # 弓箭手
	{"cost": 7, "hp": 350, "atk": 14, "cd": 22, "reach": 750, "speed": 120},  # 騎兵
	{"cost": 6, "hp": 175, "atk": 20, "cd": 16, "reach": 700, "speed": 90},   # 刺客
]

# ─── 劍士 ───
const BREAKER_NUM := 3          # 破盾：打盾兵的傷害 ×3/2
const BREAKER_DEN := 2
const COUNTER_PCT := 100        # 反擊：被刺客打到立刻回砍，傷害＝劍士攻擊的 100%

# ─── 盾兵 ───
const BLOCK_NUM := 1            # 舉盾：正面被弓箭射中，傷害 ×1/4
const BLOCK_DEN := 4
const STUN_TICKS := 20          # 頂住：正面被衝鋒的騎兵暈 20 tick（1 秒）
const TAUNT_RANGE := 2000       # 嘲諷：2 格內的近戰敵人優先打盾兵
const ANTICAV_NUM := 2          # 拒馬：盾兵打騎兵 ×2/1
const ANTICAV_DEN := 1

# ─── 弓箭手 ───
const ALERT_NUM := 3            # 警覺：射刺客 ×3/2
const ALERT_DEN := 2

# ─── 騎兵 ───
const CHARGE_NEED := 3000       # 衝鋒：連續直行 3 格後的第一擊
const CHARGE_NUM := 5           # 衝鋒傷害 ×5/2
const CHARGE_DEN := 2
const KNOCKBACK := 500          # 衝鋒擊退 0.5 格
const FLANK_DETECT := 1500      # 繞翼：衝向弓手的直線 1.5 格內有盾兵就繞
const FLANK_OFFSET := 2000      # 繞翼往上／下偏 2 格
const HIDE_ARROW_NUM := 1       # 皮甲：騎兵被弓箭射中 ×1/2
const HIDE_ARROW_DEN := 2

# ─── 刺客 ───
const STEALTH_TICKS := 40       # 潛行：開場 40 tick（2 秒）不能被指定、不碰撞
const BEHIND_DIST := 600        # 潛行時繞到目標背後 0.6 格的位置
const BACKSTAB_NUM := 2         # 背刺：從背後攻擊 ×2（無視舉盾）
const BACKSTAB_DEN := 1
const SLOW_TICKS := 20          # 絆馬：打到騎兵讓它減速 20 tick
const SLOW_NUM := 1             # 減速後速度 ×1/2
const SLOW_DEN := 2

# ─── 全場規則 ───
const MATCH_TICKS := 1800       # 一局最長 90 秒
const FRENZY_TICK := 1200       # 60 秒起狂熱
const FRENZY_CD_RATE := 5       # 狂熱時冷卻每 tick 扣 5（平常 4）＝攻速 ×5/4
const ATTRITION_STEP_PCT := 2   # 狂熱耗損：第 k 次（k＝0～5，每 5 秒一次）扣 (k+1)×2% 滿血
const MIN_SEP := 450            # 兵與兵最小間距 0.45 格
const RALLY_RATIO_PCT := 60     # 背水（追趕機制）：自己的剩餘戰力 < 對方的這個百分比時觸發；0＝關閉。11/01 實驗 5 組後採用 60%／+2
const RALLY_CD_BONUS := 2       # 背水時冷卻每 tick 多扣幾：平常 4→6（攻速約 ×1.5）、狂熱 5→7（約 ×1.4）；實際間隔取整到 tick

static var _digest := ""

## 數值摘要：本檔所有常數的 SHA-256 前 16 碼。遊戲、AI、平衡工具、重播都記錄它，證明跑的是同一份數值。
static func data_digest() -> String:
	if _digest == "":
		var m: Dictionary = load("res://scripts/core/unit_defs.gd").get_script_constant_map()
		# 常數名稱是 StringName，直接排序是比記憶體位址、不是字母順序 → 先轉成 String 再排
		var pairs: Array = []
		for k in m:
			pairs.append([String(k), m[k]])
		pairs.sort_custom(func(a, b): return a[0] < b[0])
		var txt := ""
		for pr in pairs:
			txt += "%s=%s;" % [pr[0], var_to_str(pr[1])]
		_digest = txt.sha256_text().substr(0, 16)
	return _digest

static func cost(t: int) -> int:
	return STATS[t]["cost"]

static func is_melee(t: int) -> bool:
	return t != ARCHER

static func cheapest() -> int:
	var c := 999
	for s in STATS:
		c = mini(c, s["cost"])
	return c

