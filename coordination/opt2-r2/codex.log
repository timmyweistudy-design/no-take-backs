var report := {}
var pt_call_tick := -1
var pt_rated := false

# 標題背景的展示戰
var demo = null
var demo_acc := 0.0

# 即時模式按鈕
var _btns: Array = []
var _focus := 0
var _click_pending := Vector2(-1, -1)

var capsule_path := ""
var video_mode := false
var grass: Texture2D
var plants: Array = []

func _ready() -> void:
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--shot=") or a.begins_with("--steam-test="):
			Save.prefix = "shot_"   # 不讀、不寫玩家真正的存檔
	Save.load_all()
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--steam-test="):
			var aid := int(a.substr(13))
			SteamApi.init(aid, false)
			var res: Dictionary = SteamApi.self_test(aid)
			print("STEAMTEST ", JSON.stringify(res))
			get_tree().quit(0 if res["ok"] else 1)
			return
	L.lang = Save.s("lang")
	duel_rule = Save.s("duel_rule")
	speed = float(Save.s("speed"))
	var _ua := OS.get_cmdline_user_args()
	var _special := "--video" in _ua
	for x in _ua:
		if x.begins_with("--capsule="):
			_special = true
	if Save.prefix == "" and not _special:   # 截圖／影片／膠囊模式完全不碰 Steam
		SteamApi.init()
	font = _load_font("res://fonts/NotoSansTC-Regular-sub.otf")
	font_bold = _load_font("res://fonts/NotoSansTC-Bold-sub.otf")
	sfx = SfxScript.new()
	add_child(sfx)
	sfx.set_volumes(int(Save.s("sfx")), int(Save.s("music")))
	grass = load("res://art/cainos/TX_Tileset_Grass.png")
	for i in 9:
		var tex = load("res://art/cainos/plant_%02d.png" % i)
		if tex:
			plants.append(tex)
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--shot="):
			shot_dir = a.substr(7)
		elif a.begins_with("--capsule="):
			capsule_path = a.substr(10)
		elif a == "--video":
			video_mode = true
	if capsule_path != "":
		get_window().content_scale_aspect = Window.CONTENT_SCALE_ASPECT_EXPAND
		_capture_capsule.call_deferred()
		return
	_apply_fullscreen()
	rng.seed = Time.get_ticks_usec() if (shot_dir == "" and not video_mode) else 12345
	if video_mode:
		Save.prefix = "shot_"
		Save.load_all()
	_go_title()
	if shot_dir != "":
		_run_screenshots.call_deferred()
	elif video_mode:
		_run_video.call_deferred()

func _load_font(path: String) -> Font:
	if ResourceLoader.exists(path):
		var f = load(path)
		if f:
			return f
	var sf := SystemFont.new()
	sf.font_names = PackedStringArray(["Microsoft JhengHei UI", "Noto Sans CJK TC", "sans-serif"])
	return sf

func _apply_fullscreen() -> void:
	if shot_dir != "":
		return
	DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN if Save.s("fullscreen") else DisplayServer.WINDOW_MODE_WINDOWED)

func ts(px: int) -> int:
	return int(px * int(Save.s("text_scale")) / 100)

func cbm() -> bool:
	return bool(Save.s("colorblind"))

# ───────────────────────── 狀態切換 ─────────────────────────
func _go_title() -> void:
	state = St.TITLE
	overlay = ""
	sim = null
	zoom = 1.0
	_focus = 0
	_new_demo()
	sfx.play_music("music_title")

func _new_demo() -> void:
	var r := RandomNumberGenerator.new()
	r.seed = rng.randi()
	demo = Sim.new(AI.build(0, 100, r)["army"], AI.build(1, 100, r)["army"])
	demo.fast = true
	demo_acc = 0.0

func _start_mode(m: int) -> void:
	mode = m
	wins = [0, 0]
	round_no = 1
	series_over = false
	last_player_formation = []
	overlay = ""
	if m == Mode.GAUNTLET:
		gauntlet_stage = 1
		gauntlet_prev = []
		gauntlet_changes = 99
		gauntlet_seed = rng.randi()
	_reset_place()

func _reset_place(keep_blue := false) -> void:
	state = St.PLACE
	sim = null
	fx.clear()
	dying.clear()
	zoom = 1.0
	tp = null
	blind_phase = 0
	_focus = 0
	var blue_keep = armies[0].copy() if keep_blue and not armies.is_empty() else null
	armies = [Army.new(0, 100), Army.new(1, 100)]
	match mode:
		Mode.VS_AI:
			if blue_keep != null:
				armies[0] = blue_keep
		Mode.DUEL:
extends RefCounted
## 程式繪製的 Q 版角色與戰場（優化方案 G：美術先用程式能做到的先做）。
## 全部是向量圖形＋抗鋸齒，沒有外部角色素材。辨識靠三層視覺錨點：腳底隊伍標記、上半身／武器剪影、動態特效。

const D = preload("res://scripts/core/unit_defs.gd")

const OUT := Color("#1d1a2b")
const SKIN := Color("#ffe1c4")
const BLUSH := Color(1.0, 0.55, 0.6, 0.55)
const STEEL := Color("#c9d3e3")
const STEEL_D := Color("#8c97ab")
const WOOD := Color("#b7814e")
const GOLD := Color("#ffd166")

# 隊伍色（一般／色盲高對比）
## 呼叫端目前的畫布轉換（鏡頭）。角色繪製要「疊加」在它上面，不能覆蓋掉（手感輪 2 抓到的錯位 bug）。
static var base := Transform2D.IDENTITY

const TEAM := [[Color("#3fa7ff"), Color("#ff5a5a")], [Color("#2f80ff"), Color("#ffb000")]]

static func team_color(team: int, cb := false) -> Color:
	return TEAM[1 if cb else 0][team]

## 單位：p＝腳底；face＝±1；walk＝走路相位（0＝沒走）；atk＝攻擊動畫 0～1；hurt＝受擊閃白 0～1；
## alpha＝透明度（潛行）；t＝時間（待機呼吸）；scale＝縮放。
static func unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
		hurt: float, alpha: float, t: float, scale := 1.0, cb := false) -> void:
	var tc := team_color(team, cb)
	var bob := sin(t * 3.0 + p.x * 0.05) * 0.8 if walk == 0.0 else absf(sin(walk)) * -2.5
	var lunge := sin(atk * PI) * 5.0 * face
	var o := p + Vector2(lunge, bob) * scale
	ci.draw_set_transform_matrix(base * Transform2D(0.0, Vector2(scale * face, scale), 0.0, o))
	# 以 face＝+1 畫（水平鏡像由 transform 處理）
	if type == D.CAVALRY:
		_cavalry(ci, tc, walk, atk, alpha, t)
	else:
		_infantry(ci, type, tc, walk, atk, alpha, t)
	if hurt > 0.0:
		# 受擊閃白：在身體位置疊一層白
		ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, true)
	ci.draw_set_transform_matrix(base)

static func _c(ci: CanvasItem, c: Vector2, r: float, col: Color, a: float, outline := true) -> void:
	if outline:
		ci.draw_circle(c, r + 1.6, Color(OUT, a), true, -1.0, true)
	ci.draw_circle(c, r, Color(col, col.a * a), true, -1.0, true)

static func _poly(ci: CanvasItem, pts: PackedVector2Array, col: Color, a: float, outline := true) -> void:
	if outline:
		var closed := pts.duplicate()
		closed.append(pts[0])
		ci.draw_polyline(closed, Color(OUT, a), 3.2, true)
	ci.draw_colored_polygon(pts, Color(col, col.a * a))

static func _line(ci: CanvasItem, a: Vector2, b: Vector2, col: Color, w: float, al: float) -> void:
	ci.draw_line(a, b, Color(OUT, al), w + 3.0, true)
	ci.draw_line(a, b, Color(col, col.a * al), w, true)

static func _infantry(ci: CanvasItem, type: int, tc: Color, walk: float, atk: float, a: float, t: float) -> void:
	var leg := sin(walk) * 3.0 if walk != 0.0 else 0.0
	# 腿
	_c(ci, Vector2(-4 + leg, -3), 3.6, Color("#4a3b5c"), a)
	_c(ci, Vector2(4 - leg, -3), 3.6, Color("#4a3b5c"), a)
	# 背後的東西（箭筒）
	if type == D.ARCHER:
		_poly(ci, PackedVector2Array([Vector2(-11, -28), Vector2(-6, -30), Vector2(-3, -12), Vector2(-8, -11)]), WOOD, a)
		_line(ci, Vector2(-9, -30), Vector2(-11, -35), Color.WHITE, 1.5, a)
	# 身體（圓胖的上衣，隊伍色）
	var body := PackedVector2Array()
	for i in 13:
		var ang := PI + i * PI / 12.0
		body.append(Vector2(cos(ang) * 10.5, -16 + sin(ang) * 9.0))
	body.append(Vector2(10, -5)); body.append(Vector2(-10, -5))
	_poly(ci, body, tc, a)
	ci.draw_line(Vector2(-9, -11), Vector2(9, -11), Color(OUT, 0.35 * a), 2.0, true)   # 腰帶
	# 頭
	var hy := -33.0
	_c(ci, Vector2(0, hy), 11.5, SKIN, a)
	# 臉（朝右）
	if type != D.ASSASSIN:
		_eyes(ci, Vector2(3.5, hy + 1), a, t)
	# 兵種特徵
	match type:
		D.SWORD:
			# 頭盔＋羽飾
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.05, PI * 1.95, 18, Color(OUT, a), 6.5, true)
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.05, PI * 1.95, 18, Color(STEEL, a), 4.0, true)
			_poly(ci, PackedVector2Array([Vector2(-2, hy - 12), Vector2(4, hy - 21), Vector2(7, hy - 19), Vector2(3, hy - 11)]), tc.lightened(0.2), a)
			# 劍：斜舉的亮刃（攻擊時往前揮）
			var ang := lerpf(-2.2, 0.35, atk) if atk > 0.0 else -1.15
extends SceneTree
