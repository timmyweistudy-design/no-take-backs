   284	func _upos(u) -> Vector2:
   285		var cur := Vector2(u.x, u.y)
   286		var a := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
   287		var p: Vector2 = prev_pos.get(u.id, cur).lerp(cur, a)
   288		# 純畫面錯開（手感輪 2）：依編號固定偏移 ±4px，讓疊在一起的兵不會完全重合；戰鬥計算不受影響
   289		var j := Vector2(float((u.id * 37) % 9 - 4), float((u.id * 53) % 7 - 3))
   290		return ORIGIN + p * CS / 1000.0 + j
