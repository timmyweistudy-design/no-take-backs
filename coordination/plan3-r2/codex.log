   663	# ───────────────────────── 每幀 ─────────────────────────
   664	func _process(delta: float) -> void:
   665		var _t0 := Time.get_ticks_usec()
   666		_process_inner(delta)
   667		perf_proc_us = Time.get_ticks_usec() - _t0
   668	
   669	func _process_inner(delta: float) -> void:
   670		time += delta
   671		SteamApi.run_callbacks()
   672		if toast_t > 0:
   673			toast_t -= delta
   674		if ach_t > 0:
   675			ach_t -= delta
   676		elif not ach_queue.is_empty():
   677			toast = ach_queue.pop_front()
   678			toast_t = 2.5
   679			ach_t = 2.6
   680		shake = maxf(0.0, shake - delta)
   681		if not freeze_fx:
   682			for f in fx:
   683				f["t"] += delta
   684			fx = fx.filter(func(f): return f["t"] < f["dur"])
   685		for g in dying:
   686			g["t"] += delta
   687		dying = dying.filter(func(g): return g["t"] < 1.0)
   688		if overlay == "codex":
   689			_codex_tick(delta)
   690		if state == St.TITLE and demo != null and shot_dir == "":
   691			demo_acc += delta
   692			while demo_acc >= 0.05:
   693				demo_acc -= 0.05
   694				demo.step()
   695			if demo.finished:
   696				_new_demo()
   697		if state == St.BATTLE and shot_dir == "":
   698			_battle_process(delta)
   699		elif state == St.RESULT:
   700			zoom = lerpf(zoom, 1.0, delta * 4)
   701		queue_redraw()
   702	
   703	
   704	# ───────────────────────── 繪圖 ─────────────────────────
   705	func _draw() -> void:
   706		var _t0 := Time.get_ticks_usec()
   707		_draw_inner()
   708		perf_draw_us = Time.get_ticks_usec() - _t0
   709	
   710	func _draw_inner() -> void:
   711		_btns.clear()
   712		if capsule_path != "":
   713			_draw_capsule()
   714			return
   715		draw_rect(Rect2(0, 0, 1280, 800), Color("#1b2a1f"))
   716		var cam := Transform2D.IDENTITY
   717		if state == St.BATTLE or state == St.RESULT:
   718			var off := Vector2.ZERO
   719			if shake > 0 and bool(Save.s("shake")):
   720				off = Vector2(sin(time * 90) * 2, cos(time * 77) * 2)
