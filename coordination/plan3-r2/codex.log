   112	## 畫面上現在播到第幾 tick（含小數，插值用）。
   113	func _disp_tick() -> float:
   114		if view == null:
   115			return 0.0
   116		if state != St.BATTLE:
   117			return float(view.tick)
   118		return view.tick + clampf(accum / 0.05, 0.0, 8.0 if view.finished else 1.0)
