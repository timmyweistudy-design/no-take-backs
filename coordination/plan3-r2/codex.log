   321			dealt[u.team][u.type] += u.dmg_dealt
   322			taken[u.team][u.type] += u.dmg_taken
   323			# MVP：勝方輸出最高的兵（平手時看全場）
   324			if (sim.winner < 0 or u.team == sim.winner) and (mvp == null or u.dmg_dealt > mvp.dmg_dealt):
   325				mvp = u
