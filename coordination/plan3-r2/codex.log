   615	func _key(k: int) -> void:
   616		# 有按鈕焦點的畫面（標題、選單、結果、覆蓋層、戰鬥）：方向鍵移焦點、Enter 按下、Esc 返回
   617		if state != St.PLACE or overlay != "":
   618			match k:
   619				KEY_UP, KEY_LEFT:
   620					_move_focus(-1)
   621				KEY_DOWN, KEY_RIGHT, KEY_TAB:
   622					_move_focus(1)
   623				KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
   624					if _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:
   625						sfx.play("ui_click")
   626						_btns[_focus]["cb"].call()
   627				KEY_ESCAPE:
   628					if overlay != "":
   629						overlay = ""
   630					elif state == St.BATTLE:
   631						_on_skip()
   632					elif state != St.TITLE:
   633						_go_title()
   634			return
   635		pad_mode = true
   636		match k:
   637			KEY_UP: cursor.y = maxi(0, cursor.y - 1)
   638			KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
   639			KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
   640			KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
   641			KEY_F1:
   642				_open_codex(selected)
   643			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5:
   644				var t := k - KEY_1
   645				if _allowed(t):
   646					selected = t
   647			KEY_Q, KEY_E:
   648				for i in 5:
   649					selected = (selected + (4 if k == KEY_Q else 1)) % 5
   650					if _allowed(selected):
   651						break
   652			KEY_ENTER, KEY_KP_ENTER:
   653				if _cur_army().index_at(cursor.x, cursor.y) == -1:
   654					_try_place(cursor)
   655			KEY_BACKSPACE, KEY_DELETE:
   656				_try_remove(cursor)
   657			KEY_SPACE, KEY_TAB:
   658				_on_start()
   659			KEY_ESCAPE:
   660				_go_title()
