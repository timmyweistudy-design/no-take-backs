   328	func _tone() -> Color:
   329		if state == St.TITLE:
   330			return Color(1.0, 0.72, 0.45, 0.07)
   331		match mode:
   332			Mode.PUZZLE:
   333				return Color(0.95, 0.42, 0.3, 0.16)    # 黃昏
   334			Mode.GAUNTLET:
