   100	## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
   101	func _pump_view() -> void:
   102		for fr in view.pump(sim):
   103			for e in fr["events"]:
   104				if event_route(e) == "attack":
   105					var hs: Array = atk_hit.get(e["src"], [])
   106					hs.append(int(fr["tick"]))   # 存序列，不覆蓋還沒播到的命中（Codex R5 #2：連續反擊）
   107					if hs.size() > 4:
   108						hs.pop_front()
   109					atk_hit[e["src"]] = hs
