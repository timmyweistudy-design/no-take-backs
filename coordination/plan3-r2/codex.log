   116	## 剩餘戰力＝Σ⌊兵價×剩血×1000÷滿血⌋（企劃 §2.4）。
   117	func power(team: int) -> int:
   118		var p := 0
   119		for u in units:
   120			if u.alive and u.team == team:
   121				p += u.cost * u.hp * 1000 / u.max_hp
   122		return p
