   262	## 跳字合併（優化方案 F3）：同一目標、同一種效果 0.25 秒內合併成「背刺 ×3 120」。
   263	func _merge_text(tid: int, kind: String, label: String, dmg: int, p: Vector2, col: Color) -> void:
   264		for f in fx:
   265			if f["kind"] == "text" and f.get("tid", -1) == tid and f.get("ek", "") == kind and f["t"] < 0.25:
   266				f["n"] += 1
   267				f["sum"] += dmg
   268				f["s"] = "%s ×%d（%d）" % [label, f["n"], f["sum"]]
   269				f["t"] = 0.0
   270				return
   271		# 排斥：附近已有跳字就往上疊
   272		var q := p
   273		for f in fx:
   274			if f["kind"] == "text" and not f.get("screen", false) and f["p"].distance_to(q) < 22:
   275				q.y -= 20
   276		fx.append({"kind": "text", "p": q, "s": "%s %d" % [label, dmg], "c": col, "t": 0.0, "dur": 0.85, "size": 18,
   277			"tid": tid, "ek": kind, "n": 1, "sum": dmg, "screen": false})
