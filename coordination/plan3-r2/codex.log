   164	## 事件分流（Codex R3 審查 #1）：只有帶 dmg 的才是攻擊；背水開關沒有 src；嘲諷、現形、繞翼只有演出。
   165	## 回傳 "death"／"skip"／"taunt"／"reveal"／"attack"。測試會把真實戰鬥的每一種事件都丟進來檢查。
   166	static func event_route(ev: Dictionary) -> String:
   167		var k: String = ev.get("kind", "")
   168		if k == "death":
   169			return "death"
   170		if k == "taunt" or k == "reveal":
   171			return k if ev.has("src") and ev.has("tgt") else "skip"
   172		if ev.has("dmg") and ev.has("src") and ev.has("tgt"):
   173			return "attack"
   174		return "skip"
