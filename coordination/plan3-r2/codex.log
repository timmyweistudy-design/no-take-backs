    54	## 鏡頭安全框（優化方案 F2）：把所有存活單位框進畫面，四周留 15%。
    55	func _frame_alive(delta: float) -> void:
    56		var lo := Vector2(1e9, 1e9)
    57		var hi := Vector2(-1e9, -1e9)
    58		for u in view.units:
    59			if u.alive:
    60				var p := _upos(u)
    61				lo = lo.min(p - Vector2(30, 70))
    62				hi = hi.max(p + Vector2(30, 20))
    63		var size := (hi - lo) / 0.7
    64		zoom_target = clampf(minf(1280.0 / maxf(1, size.x), 620.0 / maxf(1, size.y)), 1.08, 1.5)
    65		zoom_center = zoom_center.lerp((lo + hi) / 2, minf(1.0, delta * 3))
