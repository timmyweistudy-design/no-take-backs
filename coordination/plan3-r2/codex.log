   177	func _on_event(ev: Dictionary, with_fx: bool) -> void:
   178		var k: String = ev["kind"]
   179		if k == "death":
   180			var u = view.unit_by_id(ev["id"])
   181			dying.append({"pos": _upos(u), "type": u.type, "team": u.team, "face": signf(u.fx) if u.fx != 0 else 1.0, "t": 0.0})
   182			if with_fx:
   183				sfx.play("death", 0.7)
   184			return
   185		var route := event_route(ev)
   186		if route == "skip" or not with_fx:
   187			return
   188		match route:
   189			"taunt":
   190				var sh = view.unit_by_id(ev["src"])
   191				var vic = view.unit_by_id(ev["tgt"])
   192				fx.append({"kind": "taunt", "p": _upos(sh), "t": 0.0, "dur": 0.6})
   193				sfx.play("taunt", 0.5)
   194				fx.append({"kind": "bang", "p": _upos(vic) + Vector2(0, -64), "t": 0.0, "dur": 0.7})
   195				return
   196			"reveal":
   197				fx.append({"kind": "puff", "p": _upos(view.unit_by_id(ev["src"])) + Vector2(0, -20), "t": 0.0, "dur": 0.45})
   198				sfx.play("reveal", 0.6)
   199				return
   200		var s = view.unit_by_id(ev["src"])
   201		var t = view.unit_by_id(ev["tgt"])
   202		var tags: Array = ev.get("tags", [])
   203		atk_t[s.id] = time
   204		hurt_t[t.id] = time
   205		var sp := _upos(s)
   206		var tpos := _upos(t)
   207		if tags.has("alert"):
   208			sfx.play("alert", 0.5)
   209			fx.append({"kind": "aim", "a": sp + Vector2(0, -24), "b": tpos + Vector2(0, -22), "t": 0.0, "dur": 0.32})
   210		if tags.has("hide"):
   211			fx.append({"kind": "hide", "p": tpos + Vector2(0, -24), "dir": signf(sp.x - tpos.x) if sp.x != tpos.x else 1.0, "t": 0.0, "dur": 0.4})
   212		if tags.has("trip"):
   213			sfx.play("snap", 0.7)
   214			fx.append({"kind": "trip", "p": tpos + Vector2(0, -4), "t": 0.0, "dur": 0.5})
   215		if s.type == D.ARCHER:
   216			fx.append({"src": s.id, "kind": "arrow", "a": sp + Vector2(10 * signf(tpos.x - sp.x), -24), "b": tpos + Vector2(0, -22), "t": 0.0, "dur": 0.28, "tc": Art.team_color(s.team, cbm())})
   217			sfx.play("arrow", 0.35)
   218		else:
   219			fx.append({"src": s.id, "kind": "slash", "p": sp, "dir": signf(tpos.x - sp.x) if tpos.x != sp.x else 1.0, "t": 0.0, "dur": 0.18})
   220			sfx.play("hit" if k == "hit" else "slash", 0.4)
   221		var col := Color.WHITE
   222		var label := ""
   223		match k:
   224			"charge":
   225				label = L.t("ev_charge")
   226				col = ACCENT
   227				sfx.play("charge")
   228				sfx.play("bugle", 0.6)
   229				if bool(Save.s("shake")):
   230					shake = 0.12
   231				fx.append({"kind": "dust", "p": tpos, "t": 0.0, "dur": 0.5})
   232			"backstab":
   233				label = L.t("ev_backstab")
   234				col = Color("#c77dff")
   235				sfx.play("backstab")
   236				sfx.play("aircut", 0.7)
   237				fx.append({"kind": "flash", "p": tpos + Vector2(0, -26), "c": Color("#c77dff"), "t": 0.0, "dur": 0.25})
   238				fx.append({"kind": "vslash", "p": tpos + Vector2(0, -26), "dir": signf(tpos.x - sp.x) if tpos.x != sp.x else 1.0, "t": 0.0, "dur": 0.3})
   239			"braced":
   240				label = L.t("ev_braced")
   241				col = Color("#9ad1ff")
   242				sfx.play("bell", 0.8)
   243				brace_t[t.id] = time
   244				fx.append({"kind": "hex", "p": tpos + Vector2(10 * signf(sp.x - tpos.x), -24), "t": 0.0, "dur": 0.45})
   245			"anticav":
