    37	## 最後時刻（優化方案 F1）：雙方剩餘戰力都 ≤30% 且差距 ≤15%；或雙方各剩 ≤3 隻且差距 ≤15%。
    38	func _check_clutch() -> void:
    39		if slow_used or view.finished:
    40			return
    41		var tot := float(view.budget * 1000)
    42		var p0: float = view.power(0) * 100.0 / tot
    43		var p1: float = view.power(1) * 100.0 / tot
    44		var a0: int = view.alive_count(0)
    45		var a1: int = view.alive_count(1)
    46		if absf(p0 - p1) <= 15.0 and ((p0 <= 30.0 and p1 <= 30.0) or (a0 <= 3 and a1 <= 3)):
    47			slow_used = true
    48			if bool(Save.s("slowmo")):
    49				slow_left = 8.0
    50			_fx_text(Vector2(640, 92), L.t("clutch"), ACCENT, 1.4, 34, true)
    51			sfx.play("clutch")
