   107	## 依寬度換行：中文一字一字量，英文以空白為界。
   108	func _wrap(s: String, size: int, width: float) -> String:
   109		var out: PackedStringArray = []
   110		for para in s.split("\n"):
   111			var line := ""
   112			var tokens: Array = []
   113			var word := ""
   114			for ch in para:
   115				if ch == " ":
   116					tokens.append(word + " ")
   117					word = ""
   118				elif ch.unicode_at(0) > 0x2E80:
   119					if word != "":
   120						tokens.append(word)
   121						word = ""
   122					tokens.append(ch)
   123				else:
   124					word += ch
   125			if word != "":
   126				tokens.append(word)
   127			for tk in tokens:
   128				if line != "" and font.get_string_size(line + tk, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x > width:
   129					out.append(line.strip_edges(false, true))
   130					line = tk.strip_edges(true, false) if tk == " " else tk
   131				else:
   132					line += tk
   133			out.append(line)
   134		return "\n".join(out)
