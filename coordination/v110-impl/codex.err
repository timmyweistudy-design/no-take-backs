-	if w >= 0 and not goal_mode:   # 第十三輪：護送、撐住、斬首不寫一般勝負敘述（Codex v13-r1 #6）
+	var loss := _loss_line(w, goal_mode)
+	if loss != "":
+		# V1.1 B1：輸的時候這一行改講「主要傷害來源＋可以試的兵」，不另外加高版面
+		hw = 540.0 if y < 210 else 820.0
