+			var cc: Color = f["c"]
+			for i in 4:
+				var ang := -PI * 0.5 + (i - 1.5) * 0.7 + float(int(f["p"].x) % 7) * 0.05
+				var v := Vector2(cos(ang), sin(ang)) * k * 22.0 + Vector2(0, k * k * 18.0)
+				var c0: Vector2 = f["p"] + v
