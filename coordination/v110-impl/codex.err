+		print("FAIL 測試函式沒登記在 FILES：", ", ".join(unreg))
+		print("—— 0 通過 / 1 失敗")
+		quit(1)
+		return
 	var names: Array = ALL_TESTS
 	for a in OS.get_cmdline_user_args():
 		if a.begins_with("--only="):
