+		var rp := _recruit_pick()
+		return L.t("rw_recruit_d", [L.t("unit_%d" % int(rp[0])), L.t("unit_%d" % int(rp[1]))]) if not rp.is_empty() else ""
+	return L.t(GA_EVENTS[k] + "_d")
+
