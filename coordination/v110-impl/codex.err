-	_text(Vector2(x, y), blurb, tz("S"), Color.WHITE, false, false, w)
-	y += blurb_h
-	if show_mu:
-		_brief_mu(Vector2(x, y), w, t)
-		y += mu_h
-	if show_bar:
-		_brief_bars(Rect2(x, y, w, bar_h), t)
-
