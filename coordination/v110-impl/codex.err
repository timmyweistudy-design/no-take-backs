   682		if kind == "official" and shot_dir == "" and DisplayServer.get_name() != "headless" and not bool(Save.s("reduce_fx")):
   683			start_hold = 1.0
   684			if sfx != null:
   685				sfx.play("bugle", 0.8)
   686		graves.clear()
   687		clutch_t = 0.0
