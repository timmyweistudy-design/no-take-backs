+def suite_map() -> dict:
+    """run_tests.gd 的 FILES（JSON 相容）＋別名 new＝units。"""
+    src = (GAME / "tests/run_tests.gd").read_text(encoding="utf-8")
+    m = re.search(r"^const FILES := (\{.*\})$", src, re.M)
+    files = json.loads(m.group(1)) if m else {}
+    if "units" in files:
+        files["new"] = files["units"]
+    return files
+
+
