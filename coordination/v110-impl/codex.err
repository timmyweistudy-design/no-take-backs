+		draw_colored_polygon(sh, Color(0.05, 0.08, 0.15, ring_shadow))
 	if sprites != null and sprites.is_ready(cbm()):
 		sprites.draw_ring(self, p, team, type, scale)
 	else:
@@ -667,7 +675,11 @@ func _rebuild_sprites() -> void:
