    26	def deps(entry: str, seen=None) -> set:
    27	    seen = set() if seen is None else seen
    28	    if entry in seen or not (GAME / entry).is_file():
    29	        return seen
    30	    seen.add(entry)
    31	    if entry.endswith(".gd"):
    32	        for m in PRE.findall((GAME / entry).read_text(encoding="utf-8", errors="ignore")):
    33	            deps(m, seen)
    34	    return seen
    35	
    36	
    37	def key_of(ver: str, entries: list, extra_dirs: list) -> str:
    38	    files = set()
    39	    for e in entries:
    40	        deps(e, files)
    41	    for d in extra_dirs:
    42	        p = GAME / d
    43	        if p.is_dir():
    44	            files |= {str(x.relative_to(GAME)).replace("\\", "/") for x in p.rglob("*") if x.is_file() and x.suffix != ".import"}
    45	        elif p.is_file():
    46	            files.add(d)
    47	    h = hashlib.sha256(ver.encode())
    48	    for f in sorted(files):
    49	        h.update(f.encode())
    50	        h.update(sha(GAME / f).encode())
