-	var cy: float = r.position.y + h / 2
-	draw_circle(Vector2(r.position.x + pw / 2 + 2, cy), minf(40.0, h / 2 - 4), Color(1, 1, 1, 0.07))
-	_unit_in(Rect2(r.position.x + 2, cy - 50, pw, 100), t, 0, 0.45 if locked else 1.0, 0.95)
-	var y := r.position.y + 6
