   151		# 演出狀態依目標時間重建（Codex S5 #5）：最後時刻是否已發生、是否已進狂熱、音樂
   152		slow_used = had_clutch
   153		clutch_tick = keep_ct if had_clutch else -1
   154		if had_clutch:
   155			battle_marks.append({"tick": keep_ct, "kind": "clutch", "team": -1})
   155	
   156	## 畫面前進一個 tick：模擬保持領先 DELAY 個 tick，畫面播最舊的那一份快照（R5 展示緩衝）。
   157	func _sim_step(with_fx: bool) -> void:
   158		_pump_view()
   159		_check_final(with_fx)
   160		for u in view.units:
   161			prev_pos[u.id] = Vector2(u.x, u.y)
   162		if not view.advance():
   163			view.finished = true
   164			return
   165		_gait_tick(with_fx)
   166		_pump_view()
   167		_check_clutch(with_fx)   # 每一個畫面 tick 都判定（原本每一幀判一次，觸發的 tick 會跟幀率有關）
   168		if view.frenzy and not frenzy_seen:
   169			frenzy_seen = true
   170			if with_fx:
   171				_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
   172				sfx.play("frenzy")
   173				sfx.play_music("music_frenzy")
   174		var deaths := 0
   175		for ev in view.events:
   176			var k: String = ev["kind"]
   177			if ev.has("src"):
   178				var s = view.unit_by_id(ev["src"])
   179				var key := "%s%d" % [k, s.team]
   180				ev_count[key] = int(ev_count.get(key, 0)) + 1
   181				if k == EV.BLAST and not ev.has("dmg"):   # 第八輪：爆炸演出一筆一次；逐目標傷害不算次數（BOOM_5）
   182					ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
   183			if k == EV.DEATH:
   184				deaths += 1
   185			_collect_mark(ev, view, view.tick)
   186			_on_event(ev, with_fx)
   187		# 碾壓局最後一擊（優化方案 F1）：0.2 秒頓格＋微震，直接進結算
   188		if view.finished and not slow_used and deaths > 0 and with_fx:
   189			hitstop = 0.2
   190			if bool(Save.s("shake")):
   191				shake = 0.15
   192	
   193	
   240	var last_blast_t := -9.0   # V1.1 B2：連環爆偵測
   241	
   242	## 第八輪的事件演出。回傳 true＝處理掉了。全部受簡化特效限制（_add_fx 會擋裝飾性的）。
   243	func _on_event_v8(ev: Dictionary, k: String, with_fx: bool) -> bool:
   244		if not k in [EV.POISON, EV.BLAST, EV.VOODOO, EV.BITE, EV.MIMIC_OPEN, EV.SPLIT, EV.CAST, EV.TIMESTOP, EV.RAISE, EV.VACUUM, EV.STOMP, EV.ROCK]:
   245			return false
   246		if not with_fx:
   247			return true
   248		var s = view.unit_by_id(ev.get("src", -1))
   249		var t = view.unit_by_id(ev.get("tgt", -1))
   250		if s == null:
   251			return true
   252		var sp := _upos(s)
   253		var tp := _upos(t) if t != null else sp
   254		match k:
   255			EV.POISON:
   256				hurt_t[t.id] = time
   257				hurt_dir[t.id] = 0.0
   258				_add_fx({"kind": "spore", "p": tp + Vector2(0, -30), "t": 0.0, "dur": 0.5})
   259				sfx.play("poison", 0.25)
   260			EV.VOODOO:
   261				hurt_t[t.id] = time
   262				hurt_dir[t.id] = 0.0
   263				_add_fx({"kind": "pin", "a": sp + Vector2(0, -26), "b": tp + Vector2(0, -26), "t": 0.0, "dur": 0.3})
   264				_report_add(s.team, s.type, k, L.t("ev_voodoo"), Color("#ff6bb0"))
   265			EV.BLAST:
   266				if s.id != t.id:
   267					hurt_t[t.id] = time
   268					hurt_dir[t.id] = signf(tp.x - sp.x) if tp.x != sp.x else 0.0
   269				else:
   270					var small: bool = ev.get("small", false)
   271					_add_fx({"kind": "boom", "src": s.id, "p": sp + Vector2(0, -8), "t": 0.0, "dur": 0.45, "big": not small})
   272					_add_fx({"kind": "wool", "p": sp + Vector2(0, -18), "t": 0.0, "dur": 0.6})
   273					sfx.play("boom", 0.8)
   274					sfx.play("baa", 0.6)
   275					if _fx_on("shake"):
   276						shake = 0.1
   277					# V1.1 B2：連環爆（0.4 秒內第二顆起）短頓格，看得出是一串連鎖
   278					if time - last_blast_t < 0.4 and _fx_on("shake"):
   279						hitstop = maxf(hitstop, 0.06)
   280					last_blast_t = time
   281					_report_add(s.team, s.type, k, L.t("ev_blast"), Color("#ffb347"))
   282			EV.BITE:
   283				atk_t[s.id] = time
   284				hurt_t[t.id] = time
   285				hurt_dir[t.id] = signf(tp.x - sp.x) if tp.x != sp.x else 0.0
   670				pre_thread.start(run_pre)
   671			else:
   672				replay_total = run_pre.call()
   673		paused = false
   674		follow_id = -1
   675		battle_marks.clear()
   676		report_log.clear()
   677		skip_busy = false
   678		seek_target = -1
