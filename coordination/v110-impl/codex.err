   352	func _recruit_pick() -> Array:
   353		var pool: int = int(call("_gauntlet_pool"))
   354		var used := {}
   355		for u in gauntlet_prev:
   356			used[int(u["type"])] = true
   357		var ins: Array = []
   358		var outs: Array = []
   359		for ty in 20:
   360			if not RuleSet.has(RS.mask(_demo()), ty):
   361				continue
   362			if RuleSet.has(pool, ty):
   363				if not used.has(ty):
   364					outs.append(ty)
   365			else:
   366				ins.append(ty)
   367		if ins.is_empty() or outs.is_empty():
   368			return []
   369		var r := RandomNumberGenerator.new()
   370		r.seed = gauntlet_seed * 17 + gauntlet_stage * 131 + 3
   371		for _i in 8:
   372			var a: int = ins[r.randi() % ins.size()]
   373			var b: int = outs[r.randi() % outs.size()]
   374			var np: int = (pool | (1 << a)) & ~(1 << b)
   375			if RuleSet.has_combat(np):
   376				return [a, b]
   377		return []
