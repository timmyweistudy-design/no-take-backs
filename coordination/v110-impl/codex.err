## 自由擺放（對 AI 模式）：知道對方「上一局」的陣型（困難才用），一次擺滿。
## pool：卡池遮罩（-1＝全部）；rules：第五輪 Ruleset（預算、人數、單種上限）。
static func build_full(team: int, rng: RandomNumberGenerator, level: int, known_enemy: Array, pool := -1, rules = null) -> Army:
	var a := Army.new(team, 100)
	if rules != null:
		a.apply_rules(rules, team)
	if pool >= 0:
		a.pool = pool
	if rules != null and rules.is_free():
		a.deploy = "grid"
		a.depth = 6000
		a.enemy_pos = []
		var g := fill_army(a, rng, level, _grid_known(known_enemy))
		return load("res://scripts/core/ai_army.gd").free_from_grid(g, rules)
	return fill_army(a, rng, level, known_enemy)

## 困難 AI 讀上一局（自由座標）時，換成最近的格子給格子邏輯用。
static func _grid_known(known: Array) -> Array:
	var out: Array = []
	for u in known:
		if u.has("col"):
			out.append(u)
		else:
			out.append({"type": u["type"], "col": clampi(int(u["x"]) / 1000, 0, 15), "row": clampi(int(u["y"]) / 1000, 0, 8)})
	return out

## 把一支軍隊擺到買不起為止（第五輪：不再寫死 100 金、40 次）。
static func fill_army(a: Army, rng: RandomNumberGenerator, level: int, known_enemy: Array) -> Army:
	var guard := 0
	var limit: int = (a.budget / 4 + 10) if a.guard_combat else 40   # 標準路徑維持 40 次（亂數呼叫次數不變）
	while a.can_afford_any() and guard < limit:
		guard += 1
		var t := choose_type(a, known_enemy if level == 2 else [], a.left(), rng, level)
		if t == -1:
			break
		var c := choose_cell(a, t, known_enemy if level >= 1 else [], rng)
		if c.x < 0:
			break
		a.place(t, c.x, c.y)
	return a
extends RefCounted
## 一方的陣型：預算、人數上限、部署區、格子佔用。純資料，不碰畫面。

## 擺放錯誤碼（第七輪 H6）：畫面靠這些常數判斷，不再比對中文字串。查過：這些字串沒有進任何代碼或存檔。
const E_ZONE := "只能放在自己的部署區"
const E_TAKEN := "這格已經有兵"
const E_POOL := "這種兵不在這局的卡池裡"
const E_GOLD := "錢不夠"
const E_RESERVE := "要留錢和名額給至少 1 隻戰鬥兵"
const E_NEAR := "離其他兵太近"
const E_NEAR_ENEMY := "離敵兵太近"
const E_CAP_PREFIX := "最多"
const E_TYPE_CAP_PREFIX := "這種兵最多"
const D = preload("res://scripts/core/unit_defs.gd")

const COLS := 16
const ROWS := 9
const ZONE := 6          # 每邊部署區 6 欄
const MAX_UNITS := 24

var team: int
var budget: int
var units: Array = []    # 每筆 {"type", "col", "row"}
# 第五輪：自訂規則的部署限制（預設值＝1.3.0 行為）
var pool := (1 << D.COUNT) - 1   # 可用兵種遮罩
var unit_cap := MAX_UNITS
var type_cap := 0                # 單種上限，0＝不限
var guard_combat := false        # 防卡死：還沒擺戰鬥兵時，不准擺到買不起戰鬥兵（只有玩家擺放與 AI 用，載入舊代碼不開）
# 第六輪：自由排兵（docs/2026-11-03-free-placement-plan-v6.md §3）
# 自由部署的 units 每筆是 {"type", "x", "y"}（世界座標、量化到 50）；格子部署照舊 {"type", "col", "row"}。
const W := COLS * 1000
const H := ROWS * 1000
const EDGE := 200
const QUANT := 50
const E_TERRAIN := "err_terrain"
var deploy := "grid"
var spacing := 1000              # 己方兩隻的最小中心距離
var depth := 6000                # 自己視角 x 上限（全場＝15800）
var enemy_pos: Array = []        # 全場時：敵兵的世界座標（Vector2i），離它們至少 ENEMY_GAP
var enemy_gap := 1500
# V9 地圖：場地大小與地形（標準＝16×9、沒有地形）
var fw := W
var fh := H
var terrain = null

func _init(p_team: int = 0, p_budget: int = 100) -> void:
	team = p_team
	budget = p_budget

func spent() -> int:
	var s := 0
	for u in units:
		s += D.cost(u["type"])
	return s

func left() -> int:
	return budget - spent()

func count() -> int:
	return units.size()

func count_of(t: int) -> int:
	var n := 0
	for u in units:
		if u["type"] == t:
			n += 1
	return n

func in_zone(col: int, row: int) -> bool:
	if row < 0 or row >= ROWS:
		return false
	if team == 0:
		return col >= 0 and col < ZONE
	return col >= COLS - ZONE and col < COLS

func index_at(col: int, row: int) -> int:
	for i in units.size():
		if units[i]["col"] == col and units[i]["row"] == row:
			return i
	return -1

## 回傳空字串＝可以放；否則是不能放的原因（顯示給玩家）。
func check_place(t: int, col: int, row: int) -> String:
	if deploy == "free":
		return check_place_xy(t, col * 1000 + 500, row * 1000 + 500)
	if not in_zone(col, row):
		return E_ZONE
	if index_at(col, row) != -1:
		return E_TAKEN
	if terrain != null and terrain.blocked(col * 1000 + 500, row * 1000 + 500, team):
		return E_TERRAIN   # 第十三輪：地形殘局（格子放在地圖上），牆內格子不能放
	return _check_common(t)

## 位置以外的條件（卡池、人數、單種、錢、防卡死），格子與自由共用。
func _check_common(t: int) -> String:
	if t < 0 or t >= D.total() or (pool >> t) & 1 == 0:
		return E_POOL
	if count() >= unit_cap:
		return E_CAP_PREFIX + " %d 隻" % unit_cap
	if type_cap > 0 and count_of(t) >= type_cap:
		return E_TYPE_CAP_PREFIX + " %d 隻" % type_cap
	var hc := D.hard_cap(t)     # 第八輪：奇幻兵一隊的硬上限
	if hc > 0 and count_of(t) >= hc:
		return E_TYPE_CAP_PREFIX + " %d 隻" % hc
	if D.cost(t) > left():
