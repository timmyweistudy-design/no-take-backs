   624			KEY_UP: cursor.y = maxi(0, cursor.y - 1)
   625			KEY_DOWN: cursor.y = mini(8, cursor.y + 1)
   626			KEY_LEFT: cursor.x = maxi(0, cursor.x - 1)
   627			KEY_RIGHT: cursor.x = mini(15, cursor.x + 1)
   628			KEY_F1:
   629				_open_codex(selected)
   630			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5:
   631				var t := k - KEY_1
   632				if _allowed(t):
   633					selected = t
   634			KEY_Q, KEY_E:
   635				for i in 5:
   636					selected = (selected + (4 if k == KEY_Q else 1)) % 5
   637					if _allowed(selected):
