   650	# ───────────────────────── 每幀 ─────────────────────────
   651	func _process(delta: float) -> void:
   652		var _t0 := Time.get_ticks_usec()
   653		_process_inner(delta)
   654		perf_proc_us = Time.get_ticks_usec() - _t0
   655	
   656	func _process_inner(delta: float) -> void:
   657		time += delta
   658		SteamApi.run_callbacks()
   659		if toast_t > 0:
   660			toast_t -= delta
   661		if ach_t > 0:
   662			ach_t -= delta
   663		elif not ach_queue.is_empty():
   664			toast = ach_queue.pop_front()
   665			toast_t = 2.5
   666			ach_t = 2.6
   667		shake = maxf(0.0, shake - delta)
   668		if not freeze_fx:
   669			for f in fx:
   670				f["t"] += delta
   671			fx = fx.filter(func(f): return f["t"] < f["dur"])
   672		for g in dying:
   673			g["t"] += delta
   674		dying = dying.filter(func(g): return g["t"] < 1.0)
   675		if overlay == "codex":
   676			_codex_tick(delta)
   677		if state == St.TITLE and demo != null and shot_dir == "":
   678			demo_acc += delta
   679			while demo_acc >= 0.05:
   680				demo_acc -= 0.05
   681				demo.step()
   682			if demo.finished:
   683				_new_demo()
   684		if state == St.BATTLE and shot_dir == "":
   685			_battle_process(delta)
   686		elif state == St.RESULT:
   687			zoom = lerpf(zoom, 1.0, delta * 4)
   688		queue_redraw()
