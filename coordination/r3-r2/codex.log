   639			KEY_ENTER, KEY_KP_ENTER:
   640				if _cur_army().index_at(cursor.x, cursor.y) == -1:
   641					_try_place(cursor)
   642			KEY_BACKSPACE, KEY_DELETE:
   643				_try_remove(cursor)
