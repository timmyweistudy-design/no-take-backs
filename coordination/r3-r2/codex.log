   608				KEY_DOWN, KEY_RIGHT, KEY_TAB:
   609					_move_focus(1)
   610				KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
   611					if _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:
