   320	func _draw_fx(f: Dictionary) -> void:
   321		var k: float = f["t"] / f["dur"]
   322		match f["kind"]:
   323			"arrow":
   324				var a: Vector2 = f["a"]
   325				var b: Vector2 = f["b"]
   326				var h := minf(60.0, a.distance_to(b) * 0.18)
   327				var p := a.lerp(b, k) + Vector2(0, -sin(k * PI) * h)
   328				var k2 := maxf(0.0, k - 0.06)
   329				var p2 := a.lerp(b, k2) + Vector2(0, -sin(k2 * PI) * h)
   330				var dirv := (p - p2).normalized() if p != p2 else Vector2.RIGHT
   331				var tail := p - dirv * 16.0
   332				for j in 6:
   333					var kk := maxf(0.0, k - 0.03 * (j + 1))
   334					var pt := a.lerp(b, kk) + Vector2(0, -sin(kk * PI) * h)
   335					draw_circle(pt, 1.6, Color(1, 1, 1, 0.35 * (1.0 - j / 6.0)), true, -1.0, true)
   336				draw_line(tail, p, Art.OUT, 4.0, true)
   337				draw_line(tail, p, Color("#d97706"), 2.2, true)
   338				var nrm := dirv.orthogonal()
   339				draw_colored_polygon(PackedVector2Array([p + dirv * 5.0, p + nrm * 3.0, p - nrm * 3.0]), Color("#e5e7eb"))
   340				var fc: Color = f.get("tc", Color.WHITE)
   341				draw_colored_polygon(PackedVector2Array([tail, tail - dirv * 5.0 + nrm * 4.0, tail + dirv * 3.0]), fc)
   342				draw_colored_polygon(PackedVector2Array([tail, tail - dirv * 5.0 - nrm * 4.0, tail + dirv * 3.0]), fc)
   343			"slash":
   344				var c: Vector2 = f["p"] + Vector2(f["dir"] * 16, -24)
   345				var start := -1.3 if f["dir"] > 0 else PI - 1.1
   346				draw_arc(c, 16, start, start + 2.4 * k, 12, Color(1, 1, 1, 1 - k), 3.5, true)
   347			"dust":
   348				for i in 7:
   349					var ang := i * TAU / 7
   350					draw_circle(f["p"] + Vector2(cos(ang) * (10 + k * 30), sin(ang) * 6 + 2), 6 * (1 - k), Color(0.85, 0.75, 0.55, 0.6 * (1 - k)), true, -1.0, true)
   351			"flash":
   352				var c2: Color = f["c"]
   353				var p0: Vector2 = f["p"]
   354				draw_line(p0 + Vector2(-14, -14) * (1 + k), p0 + Vector2(14, 14) * (1 + k), Color(c2, 1 - k), 4, true)
   355				draw_line(p0 + Vector2(-14, 14) * (1 + k), p0 + Vector2(14, -14) * (1 + k), Color(c2, 1 - k), 4, true)
   356			"ripple":
   357				var c3: Color = f["c"]
   358				draw_arc(f["p"], 6 + k * 18, -1.2, 1.2, 12, Color(c3, 1 - k), 3, true)
   359			"shard":
   360				# 破盾裂片：盾面的灰藍碎片往外飛、旋轉、往下掉
   361				for i in 6:
   362					var ang := i * 1.13 + 0.4
   363					var v := Vector2(cos(ang), sin(ang) * 0.7) * k * 34
   364					var c0: Vector2 = f["p"] + v + Vector2(0, k * k * 24)
   365					var r0 := 6.0 * (1.0 - k * 0.4)
   366					var rot := k * 7.0 + i
   367					var pts := PackedVector2Array()
   368					for j in 3:
   369						pts.append(c0 + Vector2(cos(rot + j * 2.1), sin(rot + j * 2.1)) * r0)
   370					draw_colored_polygon(pts, Color(0.78, 0.84, 0.95, 1 - k))
   371					draw_polyline(pts + PackedVector2Array([pts[0]]), Color(0.2, 0.25, 0.35, 1 - k), 1.2, true)
   372			"aim":
   373				# 警覺：金色瞄準線先拉出來，再淡掉
   374				var a2: Vector2 = f["a"]
   375				var b2: Vector2 = f["b"]
   376				var e2 := a2.lerp(b2, minf(1.0, k * 2.5))
   377				draw_dashed_line(a2, e2, Color(1, 0.84, 0.3, 0.9 * (1 - k)), 2.0, 6.0, true)
   378				draw_arc(b2, 9 - k * 3, 0, TAU, 16, Color(1, 0.84, 0.3, 1 - k), 2.0, true)
   379			"hide":
   380				# 皮甲：琥珀色弧光擋在中箭的那一側
   381				var d3: float = f["dir"]
   382				var c4: Vector2 = f["p"]
   383				var st := -1.1 if d3 > 0 else PI - 1.1
   384				draw_arc(c4, 15 + k * 6, st, st + 2.2, 14, Color(1, 0.66, 0.2, 0.95 * (1 - k)), 4.0 - k * 2, true)
   385			"trip":
   386				# 絆馬：一條白繩在腳邊繃斷，兩段往外彈
   387				var c5: Vector2 = f["p"]
   388				var gap := 2.0 + k * 14.0
   389				var drop := k * k * 8.0
   390				draw_line(c5 + Vector2(-20, 0), c5 + Vector2(-gap, drop), Color(1, 1, 1, 1 - k), 2.2, true)
   391				draw_line(c5 + Vector2(gap, drop), c5 + Vector2(20, 0), Color(1, 1, 1, 1 - k), 2.2, true)
   392			"vslash":
   393				# 背刺：一道粗的紫色斬痕
   394				var c6: Vector2 = f["p"]
   395				var dd: float = f["dir"]
   396				var a0 := Vector2(-18 * dd, -16)
   397				var a1 := Vector2(18 * dd, 16)
   398				var e3 := a0.lerp(a1, minf(1.0, k * 3.0))
   399				draw_line(c6 + a0, c6 + e3, Color(0.78, 0.49, 1.0, 1 - k), 6.0 * (1 - k * 0.6), true)
   400				draw_line(c6 + a0, c6 + e3, Color(1, 1, 1, 0.8 * (1 - k)), 1.6, true)
   401			"taunt":
   402				# 嘲諷：盾兵身邊擴散的橘色圈
   403				for j in 2:
   404					var kj := clampf(k * 1.4 - j * 0.3, 0.0, 1.0)
   405					draw_arc(f["p"], 12 + kj * 30, 0, TAU, 28, Color(1, 0.55, 0.15, 0.85 * (1 - kj)), 3.0, true)
   406			"bang":
   407				# 嘲諷：被吸過去的敵人頭上冒「!」
   408				var y4 := -sin(minf(1.0, k * 3.0) * PI * 0.5) * 8.0
   409				_text(f["p"] + Vector2(0, y4 - 10), "!", ts(22), Color(1, 0.6, 0.2, 1.0 - k * k), true, true)
   410			"puff":
   411				# 現形：一團暗紫色煙散開
   412				for i in 7:
   413					var ang2 := i * TAU / 7 + 0.3
   414					draw_circle(f["p"] + Vector2(cos(ang2), sin(ang2) * 0.7) * (6 + k * 22), 7 * (1 - k), Color(0.35, 0.2, 0.5, 0.7 * (1 - k)), true, -1.0, true)
   415			"text":
   416				var p3: Vector2 = f["p"] + Vector2(0, -k * 26)
   417				var col: Color = f["c"]
   418				col.a = 1.0 - k * k
   419				_text(p3, f["s"], ts(f["size"]), col, true, true)
   420	
