    22		_text(Vector2(vs.x / 2, band_y + big * 0.05), L.t("title"), big, Color("#ffe8a3"), true, true)
    23		_text(Vector2(vs.x / 2, band_y + big * 1.12), "No Take-Backs", int(big * (0.42 if tiny else 0.34)), Color(1, 1, 1, 0.97), true, true)
    24		# 戰場區
    25		var top := band_y + band_h + vs.y * 0.02
    26		var bottom := vs.y * 0.97
    27		var mid := vs.x / 2
    28		draw_dashed_line(Vector2(mid, top), Vector2(mid, bottom), Color(1, 1, 1, 0.45), maxf(3.0, vs.y * 0.006) * (2.5 if tiny else 1.0), vs.y * 0.02)
    29		var sc := (bottom - top) / (110.0 if tiny else 260.0)
    30		if tall:
    31			sc = minf(sc, vs.x / 380.0)   # 直式：依寬度限制大小，同排兩隻不會擠在一起
    32		var cols := 3 if tiny else (2 if tall else 3)
    33		var rows := 1 if tiny else 3
    34		var margin := maxf(20.0, vs.x * 0.05)
    35		# 每邊固定 cols×rows 的整齊陣型；弓兵固定在最靠中線的那一欄，箭從弓兵射出
    36		var layout := [D.SHIELD, D.SWORD, D.ARCHER, D.CAVALRY, D.ASSASSIN, D.ARCHER, D.SWORD, D.SHIELD, D.ARCHER]
    37		var items: Array = []
    38		var archers: Array = []
    39		for team in 2:
    40			for r in rows:
    41				for c in cols:
    42					var t: int = layout[(r * cols + c) % layout.size()]
    43					if c == cols - 1:
    44						t = D.ARCHER if r != 1 or tiny else D.CAVALRY
    45					var span := (mid - margin) * 0.62
    46					var x := margin + sc * 24.0 + c * span / maxf(1, cols - 1)
    47					if team == 1:
    48						x = vs.x - x
    49					var y := bottom - sc * 6.0 if tiny else top + sc * 62.0 + r * (bottom - top - sc * 72.0) / maxf(1, rows - 1)
    50					items.append([y, x, t, team])
    51					if t == D.ARCHER and c == cols - 1 and not tall:   # 只有最靠中線的弓兵放箭；直式太窄就不畫箭
    52						archers.append(Vector2(x, y))
    53		items.sort()
    54		for it in items:
    55			Art.ring(self, Vector2(it[1], it[0]), it[3], it[2], false, sc)
    56		for it in items:
    57			var face := 1.0 if it[3] == 0 else -1.0
    58			Art.unit(self, Vector2(it[1], it[0]), it[2], it[3], face, 2.0 + it[1] * 0.01, 0.45 if it[2] == D.SWORD else 0.0, 0.0, 1.0, 1.3, sc)
    59		# 箭：從每個弓兵的弓往中線飛
    60		for ap: Vector2 in archers:
    61			var dir := 1.0 if ap.x < mid else -1.0
    62			var start := ap + Vector2(dir * sc * 28.0, -sc * 22.0)
    63			var p := Vector2(mid - dir * sc * 18.0, start.y - sc * 8.0)
    64			var tail := p - (p - start).normalized() * sc * 26.0
    65			draw_line(start, tail, Color(1, 1, 1, 0.28), sc * 1.5, true)
    66			draw_line(tail, p, Art.OUT, sc * 3.5, true)
    67			draw_line(tail, p, Color("#d97706"), sc * 2.0, true)
    68			var dv := (p - tail).normalized()
    69			var nv := dv.orthogonal()
    70			draw_colored_polygon(PackedVector2Array([p + dv * sc * 6.0, p + nv * sc * 3.0, p - nv * sc * 3.0]), Color("#e5e7eb"))
    71			var tc := Art.team_color(0 if dir > 0 else 1, false)
    72			draw_colored_polygon(PackedVector2Array([tail, tail - dv * sc * 6.0 + nv * sc * 4.0, tail + dv * sc * 3.0]), tc)
    73			draw_colored_polygon(PackedVector2Array([tail, tail - dv * sc * 6.0 - nv * sc * 4.0, tail + dv * sc * 3.0]), tc)
