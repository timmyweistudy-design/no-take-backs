    28	func run(pz: Dictionary, extra: Array) -> Sim:
    29		var a0: Army = P.player_army(pz)
    30		for e in extra:
    31			a0.units.append({"type": e[0], "col": e[1], "row": e[2]})
    32		var s := Sim.new(a0, P.enemy_army(pz))
    33		s.fast = true
    34		s.run_to_end()
    35		return s
