    12		var kinds := {"A": 0, "B": 0, "C": 0, "N": 0, "T": 0}
    13		var edge := 0
    14		var samples: Array = []
    15		for i in 120:
    16			var s := Sim.new(pool[i].copy(), pool[(i * 37 + 11) % pool.size()].mirrored())
    17			s.fast = true
    18			var hist := {}
    19			var flagged := {}
    20			var thist := {}
    21			var has_cav := false
    22			while not s.finished:
    23				s.step()
    24				for u in s.units:
    25					if u.type != D.CAVALRY or not u.alive:
    26						continue
    27					has_cav = true
    28					var h: Array = hist.get(u.id, [])
    29					h.append(Vector2(u.x, u.y))
    30					var th: Array = thist.get(u.id, [])
    31					th.append(u.target)
    32					if th.size() > 40:
    33						th.pop_front()
    34					thist[u.id] = th
    35					if h.size() > 40:
    36						h.pop_front()
    37					hist[u.id] = h
    38					if h.size() == 40 and not flagged.has(u.id):
    39						var path := 0.0
    40						for k in range(1, 40):
    41							path += h[k].distance_to(h[k - 1])
    42						if path > 3000 and h[39].distance_to(h[0]) < 800:
    43							flagged[u.id] = true
    44							found += 1
