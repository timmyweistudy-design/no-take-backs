   125	# ───────────────────────── 一個 tick ─────────────────────────
   126	func step() -> void:
   127		if finished:
   128			return
   129		tick += 1
   130		frenzy = tick >= FRENZY_TICK
   131		events = []
   132		var n := units.size()
   133	
   134		# ① 快照（之後的選目標、碰撞都只讀這些陣列）
   135		var sx := PackedInt64Array()
   136		var sy := PackedInt64Array()
   137		var st := PackedInt64Array()     # 隊伍
   138		var sk := PackedInt64Array()     # 兵種
   139		var sh := PackedInt64Array()     # 血
   140		var sv := PackedByteArray()      # 可被選為目標（活著且沒潛行）
   141		sx.resize(n); sy.resize(n); st.resize(n); sk.resize(n); sh.resize(n); sv.resize(n)
   142		for i in n:
   143			var u := units[i]
   144			sx[i] = u.x
   145			sy[i] = u.y
   146			st[i] = u.team
   147			sk[i] = u.type
   148			sh[i] = u.hp
   149			sv[i] = 1 if (u.alive and u.stealth == 0) else 0
   150	
   151		# ② 選目標＋提出移動
   152		var nx := sx.duplicate()
   153		var ny := sy.duplicate()
   154		var new_target := PackedInt64Array()
   155		var new_fx := PackedInt64Array()
   156		var new_fy := PackedInt64Array()
   157		var new_lock := PackedInt64Array()
   158		new_target.resize(n); new_fx.resize(n); new_fy.resize(n); new_lock.resize(n)
   159		for i in n:
   160			var u := units[i]
   161			new_target[i] = u.target
   162			new_fx[i] = u.fx
   163			new_fy[i] = u.fy
   164			new_lock[i] = -1
   165			u.mx = 0
   166			u.my = 0
   167			if not u.alive:
   168				continue
   169			var t := _choose_target(i, sx, sy, st, sk, sh, sv)
   170			new_target[i] = t
   171			if t == -1 or u.stun > 0:
   172				continue
   173			var tg := units[t]
   174			var reach := u.reach
   175			var d2 := M.dist2(u.x, u.y, tg.x, tg.y)
   176			var dest_x := tg.x
   177			var dest_y := tg.y
   178			var stop_at := reach - 50
   179			var flanking := false
   180			if u.type == D.ASSASSIN and u.stealth > 0:
   181				# 潛行中繞到目標背後（目的地夾在場內）
