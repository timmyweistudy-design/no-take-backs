    52								k2 = "T"   # 視窗內換過目標（集火目標死亡後轉向），不是導航問題
    53							if k2 == "C" and u.target >= 0:
    54								var tg = s.units[u.target]
    55								var near: bool = Vector2(u.x, u.y).distance_to(Vector2(tg.x, tg.y)) <= u.reach + 600
    56								k2 = "C" if not near else "N"
    57							kinds[k2] = kinds.get(k2, 0) + 1
    58							if k2 == "C" and samples.size() < 5:
    59								var tg2 = s.units[u.target] if u.target >= 0 else null
    60								samples.append([i, s.tick, u.x, u.y, tg2.type if tg2 else -1, tg2.x if tg2 else 0, tg2.y if tg2 else 0, u.nav, u.stun, u.slow, u.chasing])
    61							if u.y <= 1000 or u.y >= Sim.H - 1000:
    62								edge += 1
    63			if has_cav:
    64				cav_battles += 1
    65		print("ORBIT cav_battles=%d total=%d A=%d B=%d C(遠離目標)=%d N(正常纏鬥)=%d T(換目標)=%d edge=%d" % [cav_battles, found, kinds["A"], kinds["B"], kinds["C"], kinds["N"], kinds["T"], edge])
    66		for x in samples:
    67			print("  C 例：場%d tick%d 騎兵(%d,%d) 目標兵種%d(%d,%d) nav=%d stun=%d slow=%d chasing=%s" % x)
    68		quit(0 if kinds["A"] == 0 and kinds["B"] <= 8 and kinds["C"] <= 2 else 1)

