   183				dest_y = clampi(tg.y - tg.fy * D.BEHIND_DIST / 1000, EDGE, H - EDGE)
   184				stop_at = 0
   185			elif u.type == D.CAVALRY:
   186				var wp := _flank_waypoint(i, t)
   187				if wp.x >= 0:
   188					if d2 <= reach * reach:
   189						u.nav = 2            # 敵人已在射程內：結束繞翼直接開打，不卡在未完成狀態
   190					else:
   191						dest_x = wp.x
   192						dest_y = wp.y
   193						stop_at = 0
   194						flanking = true
   195			var need_move := d2 > reach * reach or (u.type == D.ASSASSIN and u.stealth > 0) or flanking
   196			if u.type == D.CAVALRY and not flanking:
   197				# 追擊遲滯：已經在追就追到 reach−CHASE_HYST 才停；停著的要超出 reach 才起步
   198				var inner := reach - D.CHASE_HYST
