   215	## 繪圖效能量測（第二輪方案 R2、H）：48 隻（24 對 24）跑約 6 秒，記錄每一幀的 _draw、_process 與 GPU 時間。
   216	## 輸出 JSON：p50／p95／最大值（毫秒）。用法：<exe> --path game --resolution 1280x800 -- --perf=<輸出 json 絕對路徑>
   217	func _run_perf() -> void:
   218		await get_tree().process_frame
   219		var vp := get_viewport().get_viewport_rid()
   220		RenderingServer.viewport_set_measure_render_time(vp, true)
   221		var a0 := Army.new(0, 100)
   222		var a1 := Army.new(1, 100)
   223		var spec := [D.SHIELD, D.SWORD, D.ARCHER, D.ARCHER, D.SWORD, D.ARCHER]
   224		for r in 9:
   225			for c in 6:
   226				if a0.count() < 24:
   227					var t: int = spec[(r + c) % spec.size()]
   228					if D.cost(t) <= a0.left():
   229						a0.place(t, 5 - c, r)
   230					elif a0.left() >= 4:
   231						a0.place(D.ARCHER, 5 - c, r)
   232		a1 = a0.mirrored()
   233		mode = Mode.VS_AI
   234		_begin_battle(a0, a1)
   235		var draw: Array = []
   236		var proc: Array = []
   237		var gpu: Array = []
   238		var frame: Array = []
   239		var units: Array = []
   240		var parts := {"field": [], "units": [], "fx": []}
   241		var last := Time.get_ticks_usec()
   242		for i in 360:
   243			await RenderingServer.frame_post_draw
   244			var now := Time.get_ticks_usec()
   245			frame.append((now - last) / 1000.0)
   246			last = now
   247			draw.append(perf_draw_us / 1000.0)
   248			proc.append(perf_proc_us / 1000.0)
   249			gpu.append(RenderingServer.viewport_get_measured_render_time_gpu(vp))
   250			for k in parts:
   251				parts[k].append(perf_parts.get(k, 0) / 1000.0)
   252			units.append(sim.alive_count(0) + sim.alive_count(1) if sim != null else 0)
   253			if state != St.BATTLE:
   254				break
   255		var out := {"frames": draw.size(), "units_start": units[0] if units.size() > 0 else 0, "units_end": units[-1] if units.size() > 0 else 0,
   256			"draw_ms": _pstats(draw), "process_ms": _pstats(proc), "gpu_ms": _pstats(gpu), "frame_ms": _pstats(frame),
   257			"field_ms": _pstats(parts["field"]), "units_ms": _pstats(parts["units"]), "fx_ms": _pstats(parts["fx"]),
   258			"note": "frame_ms 受垂直同步限制（約 16.7）；看 draw＋process＋gpu 才是實際成本"}
   259		var f := FileAccess.open(perf_path, FileAccess.WRITE)
   260		f.store_string(JSON.stringify(out, "  "))
   261		f.close()
   262		print("PERF ", JSON.stringify(out))
   263		get_tree().quit()
   264	
   265	func _pstats(a: Array) -> Dictionary:
   266		var b := a.duplicate()
   267		b.sort()
   268		if b.is_empty():
   269			return {}
   270		return {"p50": snappedf(b[b.size() / 2], 0.01), "p95": snappedf(b[int(b.size() * 0.95)], 0.01), "max": snappedf(b[-1], 0.01)}

