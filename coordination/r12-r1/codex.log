    37	func validate(pz: Dictionary, samples: int) -> Dictionary:
    38		var base := run(pz, [])
    39		var rng := RandomNumberGenerator.new()
    40		rng.seed = hash(pz["id"])
    41		var wins := 0
    42		var classes := {}
    43		var best_rem := 0
    44		var min_spend := 999
    45		var three_star := false
    46		var examples := {}
    47		var allowed: Array = pz["allowed"]
    48		var fixed_cells := {}
    49		for f in pz["fixed"]:
    50			fixed_cells[Vector2i(f[1], f[2])] = true
    51		for i in samples:
    52			var left: int = pz["budget"]
    53			var extra: Array = []
    54			var used := {}
    55			var n := rng.randi_range(1, 6)
    56			for k in n:
    57				var t: int = allowed[rng.randi_range(0, allowed.size() - 1)]
    58				if D.cost(t) > left:
    59					continue
    60				for tries in 20:
    61					var c := Vector2i(rng.randi_range(0, 5), rng.randi_range(0, 8))
    62					if not fixed_cells.has(c) and not used.has(c):
    63						used[c] = true
    64						extra.append([t, c.x, c.y])
    65						left -= D.cost(t)
    66						break
    67			if extra.is_empty():
    68				continue
    69			var s := run(pz, extra)
    70			if s.winner == 0:
    71				wins += 1
    72				var types := {}
    73				var spend := 0
    74				for e in extra:
    75					types[e[0]] = true
    76					spend += D.cost(e[0])
    77				var key := types.keys()
    78				key.sort()
    79				classes[str(key)] = classes.get(str(key), 0) + 1
    80				var rem: int = s.power(0) * 100 / (s.budget * 1000)
    81				best_rem = maxi(best_rem, rem)
    82				min_spend = mini(min_spend, spend)
    83				if rem >= int(pz["star2"]) and spend <= int(pz["star3"]):
    84					three_star = true
    85				if not examples.has(str(key)) and examples.size() < 2:
    86					examples[str(key)] = extra
    87		var rate := wins * 100 / maxi(1, samples)
    88		var max_rate := 95 if pz.get("tutorial", false) else 70
    89		var need_classes := 1 if pz.get("tutorial", false) else 2
    90		var ok: bool = base.winner != 0 and classes.size() >= need_classes and rate >= 2 and rate <= max_rate \
    91			and three_star
    92		return {"id": pz["id"], "ok": ok, "base_winner": base.winner, "win_rate": rate, "classes": classes.size(),
    93			"class_list": classes, "best_rem": best_rem, "min_spend": min_spend, "three_star": three_star, "star2": pz["star2"], "star3": pz["star3"], "solutions": examples.values()}
