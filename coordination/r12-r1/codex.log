   130	func _would_clutch(a0, a1) -> bool:
   131		var t = Sim.new(a0.copy(), a1.copy())
   132		t.fast = true
   133		var tot := float(t.budget * 1000)
   134		while not t.finished:
   135			t.step()
   136			var p0: float = t.power(0) * 100.0 / tot
   137			var p1: float = t.power(1) * 100.0 / tot
   138			if absf(p0 - p1) <= 15.0 and ((p0 <= 30.0 and p1 <= 30.0) or (t.alive_count(0) <= 3 and t.alive_count(1) <= 3)) and not t.finished:
   139				return true
   140		return false
