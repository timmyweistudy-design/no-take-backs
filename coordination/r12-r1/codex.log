   113	## 剩餘戰力＝Σ⌊兵價×剩血×1000÷滿血⌋（企劃 §2.4）。
   114	func power(team: int) -> int:
   115		var p := 0
   116		for u in units:
   117			if u.alive and u.team == team:
   118				p += u.cost * u.hp * 1000 / u.max_hp
   119		return p
