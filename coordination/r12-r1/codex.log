    11	func _battle_process(delta: float) -> void:
    12		if hitstop > 0:
    13			hitstop -= delta
    14			return
    15		var rate := speed
    16		if slow_left > 0:
    17			rate *= 0.5
    18			slow_left -= delta
    19		accum += delta * rate
    20		while accum >= 0.05 and not sim.finished:
    21			accum -= 0.05
    22			_sim_step(true)
    23		_check_clutch()
    24		if slow_left > 0 and not sim.finished:
    25			_frame_alive(delta)
    26		else:
    27			zoom_target = 1.0
    28		zoom = lerpf(zoom, zoom_target, delta * 3)
    29		if sim.finished:
    30			result_delay += delta
    31			if result_delay > 1.4:
    32				_finish_battle()
    33	
    34	
    35	## 最後時刻（優化方案 F1）：雙方剩餘戰力都 ≤30% 且差距 ≤15%；或雙方各剩 ≤3 隻且差距 ≤15%。
    36	func _check_clutch() -> void:
    37		if slow_used or sim.finished:
    38			return
    39		var tot := float(sim.budget * 1000)
    40		var p0: float = sim.power(0) * 100.0 / tot
    41		var p1: float = sim.power(1) * 100.0 / tot
    42		var a0: int = sim.alive_count(0)
    43		var a1: int = sim.alive_count(1)
    44		if absf(p0 - p1) <= 15.0 and ((p0 <= 30.0 and p1 <= 30.0) or (a0 <= 3 and a1 <= 3)):
    45			slow_used = true
    46			if bool(Save.s("slowmo")):
    47				slow_left = 8.0
    48			_fx_text(Vector2(640, 92), L.t("clutch"), ACCENT, 1.4, 34, true)
    49			sfx.play("clutch")
    50	
    51	
    52	## 鏡頭安全框（優化方案 F2）：把所有存活單位框進畫面，四周留 15%。
    53	func _frame_alive(delta: float) -> void:
    54		var lo := Vector2(1e9, 1e9)
    55		var hi := Vector2(-1e9, -1e9)
    56		for u in sim.units:
    57			if u.alive:
    58				var p := _upos(u)
    59				lo = lo.min(p - Vector2(30, 70))
    60				hi = hi.max(p + Vector2(30, 20))
    61		var size := (hi - lo) / 0.7
    62		zoom_target = clampf(minf(1280.0 / maxf(1, size.x), 620.0 / maxf(1, size.y)), 1.08, 1.5)
    63		zoom_center = zoom_center.lerp((lo + hi) / 2, minf(1.0, delta * 3))
    64	
