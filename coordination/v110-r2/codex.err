   217	## 回傳 {ok, rules, army}。陣型一定要照那組規則合法。
   218	func _challenge_decode(c: String) -> Dictionary:
   219		var bad := {"ok": false}
   220		var parts := c.split(".")
   221		if c.length() > 6000 or parts.size() != 3 or parts[0] != "NTC1" or parts[1].sha256_text().substr(0, 6) != parts[2]:
   222			return bad
   223		var b64 := parts[1].replace("-", "+").replace("_", "/")
   224		while b64.length() % 4 != 0:
   225			b64 += "="
   226		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
   227		if not j is Dictionary or not j.get("a") is String or not j.get("r") is String:
   228			return bad
   229		var rd: Dictionary = RuleSet.from_code(str(j["r"]))
   230		if not rd["ok"] or rd["rules"].fullfield != RuleSet.FULL_NONE:
   231			return bad      # 全場規則是雙方互相看得到才成立，不能當挑戰碼（Codex r2 #3）
   232		var r = rd["rules"]
   233		r.ai_pool_same = false
   234		# 碼是對方當藍軍排的，到這裡他變紅軍：兩邊的預算、卡池要對調（讓子局才有差，Codex #10）
   235		var b0: int = r.budget_of(0)
   236		var b1: int = r.budget_of(1)
   237		var p0: int = r.pool_of(0)
   238		var p1: int = r.pool_of(1)
   239		r.budget = [b1, b0]
   240		r.pool = [p1, p0]
   241		r.cmd_mask = [int(r.cmd_mask[1]), int(r.cmd_mask[0])]   # 第十二輪：手動技能也要對調
   242		var a = Army.new(1, r.budget_of(1))
   243		a.apply_rules(r, 1)
   244		a.pool = RuleSet.full_pool()     # 朋友的牌不必在自己的解鎖範圍內
   245		if a.load_code(str(j["a"])) != "" or not a.has_combat():
   246			return bad
   247		if _demo() and not _demo_ok(r, a):
   248			return bad      # 第十輪 B7：試玩版不能靠挑戰碼帶進正式版內容
   249		return {"ok": true, "rules": r, "army": a}
