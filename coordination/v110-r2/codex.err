   203	func _accept_challenge(c := "") -> void:
   204		var from_clip := c == ""
   205		if from_clip:
   206			c = DisplayServer.clipboard_get().strip_edges()
   207		var d := _challenge_decode(c.strip_edges())
   208		if not d["ok"]:
   209			if not (from_clip and _ask_code(L.t("ch_accept"), _accept_challenge)):
   210				_toast(L.t("ch_bad"), true)
   211			return
   212		rules = d["rules"]
   213		challenge_army = d["army"]
   214		rules.rounds = 1
   215		_start_mode(Mode.VS_AI)
