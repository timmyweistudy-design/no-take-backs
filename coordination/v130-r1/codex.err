    85	## 前景物件（世界 px，相對場地左上）：[y, 種類, x, 大小]，依 y 排好。
    86	static func props(map_id: int, size: int) -> Array:
    87		var t = MD.terrain(map_id, size)
    88		if t == null:
    89			return []
    90		var biome: String = MD.MAPS[map_id]["biome"]
    91		if biome == "river" or biome == "canyon":
    92			return []    # 河與崖是平的，不用前景
    93		var out: Array = []
    94		var Q := 0.5 * CS
    95		for r in t.m:
    96			for c in t.n:
    97				if t.grid[c + r * t.n] != t.BLOCK:
    98					continue
    99				var h := absi((c * 73856093) ^ (r * 19349663)) % 1000
   100				if biome == "forest" or (c + r) % 2 == 0:
   101					var x: float = (c + 0.5) * Q + (h % 9 - 4)
   102					var y: float = (r + 0.85) * Q + (h / 10 % 7 - 3)
   103					out.append([y, biome, x, 0.85 + (h % 30) / 100.0])
   104		out.sort_custom(func(a, b): return a[0] < b[0])
   105		return out
   106	
   107	## 第十輪 V4：場外裝飾，只放左右兩條空白；不碰場地，不會被誤認成障礙。
   108	static func draw_outfield(ci: CanvasItem, field: Rect2, biome: String) -> void:
   109		var bi: Dictionary = BIOME.get(biome, {})
   110		ci.draw_rect(Rect2(-300, -300, 1900, 1400), Color(bi.get("outer", "#1b2a1f")))
   111		var kinds: Array = {"river": ["bush", "bush", "rock"], "forest": ["forest", "forest", "bush"], "ice": ["pine", "pine", "ice"], "lava": ["lava", "lava", "rock"], "canyon": ["deadtree", "rock", "rock"]}.get(biome, [])
   112		if kinds.is_empty():
   113			return
   114		for i in 18:
   115			var h := absi((i * 73856093) ^ ((i + 11) * 19349663)) % 100000
   116			var left := i % 2 == 0
   117			var span := field.position.x - 40.0
   118			var x: float = 16.0 + h % int(span) if left else field.end.x + 24.0 + h % int(span)
   119			var y: float = field.position.y + 10.0 + i * (field.size.y + 60.0) / 18.0 + h % 16
   120			draw_prop(ci, Vector2.ZERO, [y, kinds[h % 3], x, 1.0 + (h % 50) / 100.0], 0.0)
   121	
   122	## 畫一個前景物件。ci 已經是場地座標（鏡頭已套用）。
   123	static func draw_prop(ci: CanvasItem, origin: Vector2, pr: Array, time: float) -> void:
   124		var p := origin + Vector2(pr[2], pr[0])
   125		var s: float = pr[3]
   126		match pr[1]:
   127			"forest":
   128				ci.draw_circle(p + Vector2(0, 2), 13.0 * s, Color(0, 0, 0, 0.25), true, -1.0, true)
   129				ci.draw_rect(Rect2(p + Vector2(-3, -12) * s, Vector2(6, 13) * s), Color("#5a3f28"))
   130				ci.draw_circle(p + Vector2(0, -24) * s, 17.0 * s, Color("#1d3a22"), true, -1.0, true)
   131				ci.draw_circle(p + Vector2(0, -24) * s, 15.0 * s, Color("#2f6b37"), true, -1.0, true)
   132				ci.draw_circle(p + Vector2(-5, -29) * s, 8.0 * s, Color("#4c9150"), true, -1.0, true)
   133			"bush":
   134				ci.draw_circle(p + Vector2(0, -6) * s, 13.0 * s, Color("#1f3a1c"), true, -1.0, true)
   135				ci.draw_circle(p + Vector2(-5, -9) * s, 9.0 * s, Color("#3f6f33"), true, -1.0, true)
   136				ci.draw_circle(p + Vector2(6, -7) * s, 7.0 * s, Color("#4f8240"), true, -1.0, true)
   137			"rock":
   138				ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-13, 0) * s, p + Vector2(-8, -11) * s, p + Vector2(4, -15) * s, p + Vector2(13, -5) * s, p + Vector2(12, 0) * s]), Color(0.28, 0.26, 0.28))
   139				ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-8, -11) * s, p + Vector2(4, -15) * s, p + Vector2(1, -6) * s]), Color(0.42, 0.4, 0.42))
   140			"pine":
   141				ci.draw_rect(Rect2(p + Vector2(-3, -8) * s, Vector2(6, 9) * s), Color("#4a3a2c"))
   142				for k in 3:
   143					var ky: float = -8.0 - k * 11.0
   144					var kw: float = 16.0 - k * 4.0
   145					ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-kw, ky) * s, p + Vector2(0, ky - 17.0) * s, p + Vector2(kw, ky) * s]), Color("#2f5a55"))
   146					ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-kw * 0.45, ky - 9.0) * s, p + Vector2(0, ky - 17.0) * s, p + Vector2(kw * 0.45, ky - 9.0) * s]), Color("#e4f0f7"))
   147			"deadtree":
   148				ci.draw_line(p, p + Vector2(1, -28) * s, Color("#3a2a1c"), 5.0 * s, true)
   149				ci.draw_line(p + Vector2(1, -16) * s, p + Vector2(-11, -28) * s, Color("#3a2a1c"), 3.0 * s, true)
   150				ci.draw_line(p + Vector2(1, -22) * s, p + Vector2(11, -36) * s, Color("#3a2a1c"), 3.0 * s, true)
   151			"ice":
   152				ci.draw_circle(p + Vector2(0, 2), 11.0 * s, Color(0, 0.1, 0.3, 0.2), true, -1.0, true)
   153				ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-11, 0) * s, p + Vector2(-5, -20) * s, p + Vector2(2, -26) * s, p + Vector2(10, -12) * s, p + Vector2(11, 0) * s]), Color("#a9d8ee"))
   154				ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-5, -20) * s, p + Vector2(2, -26) * s, p + Vector2(1, -8) * s]), Color("#e8f7ff"))
   155			"lava":
   156				ci.draw_circle(p + Vector2(0, 2), 12.0 * s, Color(0, 0, 0, 0.3), true, -1.0, true)
   157				ci.draw_colored_polygon(PackedVector2Array([p + Vector2(-12, 0) * s, p + Vector2(-7, -14) * s, p + Vector2(1, -22) * s, p + Vector2(9, -11) * s, p + Vector2(12, 0) * s]), Color("#2f282d"))
   158				var g := 0.65 + 0.35 * sin(time * 2.0 + p.x)
   159				ci.draw_line(p + Vector2(-3, -2) * s, p + Vector2(1, -14) * s, Color(1.0, 0.55, 0.15, g), 2.0, true)
