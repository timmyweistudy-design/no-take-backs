   172		## 沿一格的邊往外畫一條鋸齒帶；m＝邊的中點。
   173		func _jag(m: Vector2, out_dir: Vector2, col: Color, h: int, depth: float) -> void:
   174			var side := Vector2(out_dir.y, out_dir.x)
   175			var half := 16.5
   176			var pts := PackedVector2Array([m - side * half, m + side * half])
   177			for k in 5:
   178				var f: float = 1.0 - k * 0.5
   179				var bump: float = depth * (0.45 + float((h >> (k * 2)) % 4) * 0.2)
   180				pts.append(m + side * (f * half) + out_dir * bump)
   181			draw_colored_polygon(pts, col)
