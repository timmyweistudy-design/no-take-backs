    29		17: [BIPED, 11.0, 1.4, 0.05, 0.10, 0.0, 2.5],  # 骷髏法師：拖步
    30		18: [BIPED, 14.0, 3.0, 0.06, 0.14, 0.0, 5.0],  # 吸塵貓
    31		19: [STOMP, 18.0, 2.2, 0.09, 0.10, 0.0, 6.0],  # 小石魔：左右重踏
    32		20: [HOP, 11.0, 0.0, 0.0, 0.0, 2.5, 0.0],      # 小史萊姆
    33		21: [BIPED, 13.0, 2.5, 0.10, 0.30, 0.0, 4.0],  # 骷髏：喀喀搖擺
    34	}
    35	
    36	static func kind(t: int) -> int:
    37		return int(T[t][0])
    38	
    39	static func stride(t: int) -> float:
    40		return float(T[t][1])
    41	
    42	## 真的走路相位；待機與專屬姿勢回 0。
    43	static func ph(walk: float) -> float:
    44		return walk if walk > -50.0 else 0.0
    45	
    46	## 一步週期走多少螢幕 px，用來把位移換成相位。
    47	static func cycle_px(t: int, scale: float) -> float:
    48		return 2.0 * stride(t) * scale
    49	
    50	## 相位（累積世界位移，1000＝1 格；cs＝每格 px）。
    51	static func phase_of(t: int, world: float, cs: float, scale: float, id: int) -> float:
    52		return world * cs / 1000.0 / cycle_px(t, scale) * TAU + 0.0001 + id * 0.37
    53	
    54	## 腳的位移：[遠腳 x, 遠腳抬起, 近腳 x, 近腳抬起]。踩地段往後等速走（抵銷身體前進），騰空段弧線往前。
    55	static func feet(t: int, walk: float) -> Array:
    56		if walk <= POSE_DAZE + 1.0:
    57			return [1.0, 0.0, -1.0, 0.0]
    58		if walk <= POSE_DRAG + 1.0:
    59			return [7.0, 0.0, 10.0, 0.0]   # 腳在身前被拖著
    60		if walk == 0.0:
    61			return [0.0, 0.0, 0.0, 0.0]
    62		var a := _foot(t, walk)
    63		var b := _foot(t, walk + PI)
    64		return [a[0], a[1], b[0], b[1]]
    65	
    66	static func _foot(t: int, walk: float) -> Array:
    67		var u := fposmod(walk, TAU) / TAU
    68		var s := stride(t)
    69		var lift := float(T[t][6])
    70		if u < 0.5:
    71			return [s * 0.5 - s * (u * 2.0), 0.0]               # 踩地：+s/2 → −s/2
    72		var v := (u - 0.5) * 2.0
    73		return [-s * 0.5 + s * v, sin(v * PI) * lift]           # 騰空
    74	
    75	static func planted(t: int, walk: float) -> bool:
    76		return fposmod(walk, TAU) / TAU < 0.5
    77	
    78	## 上半身相對腳的轉換：起伏與傾身（腳不跟著動）。
    79	static func body_xf(t: int, walk: float) -> Transform2D:
    80		if walk <= POSE_DAZE + 1.0:
    81			return Transform2D(0.10, Vector2(0, 1.5))
    82		if walk <= POSE_DRAG + 1.0:
    83			return Transform2D(-0.30, Vector2(2.0, 1.0))
    84		if walk == 0.0:
    85			return Transform2D.IDENTITY
    86		var r: Array = T[t]
    87		var k: int = r[0]
    88		if k == HOP or k == FLOAT or k == ROOT:
    89			return Transform2D(float(r[3]) * sin(walk), Vector2.ZERO)
    90		var dy := -absf(sin(walk)) * float(r[2]) * 1.3
    91		var tilt := float(r[3]) * sin(walk)
    92		if k != STOMP:
    93			tilt += float(r[3]) * 0.5     # 走路時微微前傾
    94		return Transform2D(tilt, Vector2(0, dy))
    95	
    96	## 整隻離地（跳步、飄浮）。
    97	static func air(t: int, walk: float) -> float:
    98		if walk == 0.0 or walk < -50.0:
    99			return 0.0
   100		var r: Array = T[t]
   101		if r[0] == FLOAT:
   102			return float(r[5]) * (0.5 + 0.5 * sin(walk))
   103		return absf(sin(walk)) * float(r[5])
   104	
   105	## 手與武器的擺動（弧度感的比例，−1～1 × 擺幅）。
   106	static func swing(t: int, walk: float) -> float:
   107		if walk == 0.0 or walk < -50.0:
   108			return 0.0
   109		return cos(walk) * float(T[t][4])
   110	
   111	## 沒有實際位移資料時（圖鑑小劇場）的相位速度。speed＝每 tick 世界單位。
   112	static func nominal_rate(t: int, speed: float, cs: float, scale: float) -> float:
   113		var s := speed * 20.0 * cs / 1000.0
   114		return s / cycle_px(t, scale) * TAU
   390		if live:
   391			list.sort_custom(func(a, b): return _upos(a).y < _upos(b).y)
   392		else:
   393			list.sort_custom(func(a, b): return a.y < b.y)
   394		_draw_v8_ground(s, live)
   395		# 第一層：腳底標記與影子（全部先畫，不會被別人的身體整個蓋住時也看得到外圈）
   396		var a_now := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
   397		var gm: Array = _goal_mark()
   398		for u in list:
   399			var p0: Vector2 = _upos(u) if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
   400			var air0: float = Gait.air(u.type, _walk_of(u, a_now)) if live else 0.0
   401			_ring(p0, u.team, u.type, UNIT_SCALE * (1.0 - air0 * 0.018))   # 跳起來影子縮一點
   402			if u.shield > 0:       # 第十二輪：手動技能的護盾、戰吼
   403				draw_arc(p0 + Vector2(0, -24) * UNIT_SCALE, 28.0 * UNIT_SCALE, 0, TAU, 24, Color(0.55, 0.85, 1.0, 0.75), 2.5, true)
   404			if u.haste_t > 0:
   405				draw_arc(p0, 19.0 * UNIT_SCALE, 0, TAU, 20, Color(1.0, 0.75, 0.25, 0.85), 2.5, true)
   406			if u.id == int(gm[0]) or (int(gm[0]) == -2 and u.team == 0 and u.type == int(gm[2]) and not u.summon):
   407				_goal_marker(p0, "protect" if int(gm[0]) == -2 else str(gm[1]))   # 第十三輪：要護送／斬首的那一隻；V1.1：不能倒的那種兵每隻都標
   408			if live and s.rally[u.team] and not s.finished:
   409				for k in 2:
   410					var ph := fmod(time * 1.6 + k * 0.5, 1.0)
   411					draw_arc(p0, (14.0 + ph * 10.0) * UNIT_SCALE, 0, TAU, 20, Color(1, 0.42, 0.0, 0.55 * (1.0 - ph)), 2.0, true)
   412		# 陣亡痕跡：倒下處的小旗，3 秒淡出，畫在最底層（第三輪 R5）
   413		if live:
   414			for g in graves:
   415				var ga: float = 1.0 - g["t"] / 3.0
   416				var gp: Vector2 = g["pos"]
   417				draw_line(gp + Vector2(0, 2), gp + Vector2(0, -16), Color(0.35, 0.27, 0.2, 0.8 * ga), 2.0, true)
   418				draw_colored_polygon(PackedVector2Array([gp + Vector2(0, -16), gp + Vector2(10, -12), gp + Vector2(0, -8)]), Color(Art.team_color(g["team"], cbm()), 0.75 * ga))
   419				draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.4), 0, gp + Vector2(0, 2)))   # 疊在鏡頭上（Codex S4 #5）
   420				draw_circle(Vector2.ZERO, 7, Color(0, 0, 0, 0.25 * ga), true, -1.0, true)
   421				draw_set_transform_matrix(_cam)
   422		# 擁擠度：40px 內有幾隻（第三輪 V5，只在戰鬥中算）
   423		var crowd := {}
   424		if live:
   425			var pos: Array = []
   426			for u in list:
   427				pos.append(_upos(u))
   428			for a in list.size():
   429				var n := 0
   430				for b in list.size():
   431					if a != b and pos[a].distance_squared_to(pos[b]) < 1600.0:
   432						n += 1
   433				crowd[list[a].id] = n
   434		# 第二層：身體（V9：地圖的前景物件依腳點 y 插進來，才有前後遮擋）
   435		var prop_i := 0
   436		var xray: Array = []   # V1.1 C5：[腳點, 參數]，給被下排蓋到臉的那隻補畫半透明
   437		for u in list:
   438			var p: Vector2 = _upos(u) if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
   439			while prop_i < fld_props.size() and ORIGIN.y + float(fld_props[prop_i][0]) <= p.y:
   440				MapArt.draw_prop(self, ORIGIN, fld_props[prop_i], time)
   441				prop_i += 1
   442			var walk: float = _walk_of(u, a_now) if live else ((time * Gait.nominal_rate(u.type, float(D.stat(u.type)["speed"]), CS, UNIT_SCALE) + u.id) if (u.mx != 0 or u.my != 0) else 0.0)
   443			var moving: bool = walk > 0.0
   444			var at := 0.0
   445			var variant := 0
   446			if live and atk_hit.has(u.id):
   447				var dt0 := _disp_tick()
   448				var h := pick_hit(atk_hit[u.id], dt0, u.type)
   449				if h >= 0:
   450					at = atk_progress(dt0 - (h - ViewBuffer.DELAY), u.type)
   451					# 火罐飛行（第四輪 §4.4）：前搖期間從手上飛向目標，命中那一刻落地（模擬不受影響）
   452					if u.type == D.BOMBER and at > 0.0 and at < Art.ATK_WINDUP and bomb_tgt.get(u.id, {}).has(h):
   453						var bt = view.unit_by_id(bomb_tgt[u.id][h])
   454						if bt != null:
   455							var fk := at / Art.ATK_WINDUP
   456							var src_p: Vector2 = _upos(u) + Vector2(0, -50)
   457							var dst_p: Vector2 = _upos(bt) + Vector2(0, -10)
   458							var pp := src_p.lerp(dst_p, fk) + Vector2(0, -sin(fk * PI) * minf(70.0, src_p.distance_to(dst_p) * 0.3))
   459							pot_draw.append(pp)
   460					if u.type == D.SWORD:
   461						variant = int(atk_seq.get(u.id, {}).get(h, 0)) % 2   # 劍士橫斬與上挑逐擊交替（第三輪 R4）
   462					elif u.type >= D.CLASSIC and alt_hit.get(u.id, {}).has(h):
   463						variant = 2
   464			var hurt := 0.0
   465			if live and hurt_t.has(u.id) and _fx_on("flash"):
   466				hurt = clampf(1.0 - (time - hurt_t[u.id]) / 0.15, 0, 1)
   467			var alpha := 0.45 if u.stealth > 0 else 1.0
   468			if dim:
   469				alpha *= 0.6
   470			if live:
   471				alpha *= _focus_dim(p)
   472			var face := signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
   473			# 受擊後退 4px（第三輪 R2）：0.08 秒退、0.07 秒回，只是畫面
   474			if live and hurt_t.has(u.id):
   475				var hk: float = (time - float(hurt_t[u.id])) / 0.15
   476				if hk >= 0.0 and hk < 1.0:
   477					p.x += float(hurt_dir.get(u.id, 0.0)) * 4.0 * (sin(hk * PI) if hk < 1.0 else 0.0)
   478			if live and u.id == follow_id:
   479				draw_arc(p + Vector2(0, 2), 22.0, 0, TAU, 28, Color(ACCENT, 0.9), 3.0, true)   # 跟拍中的那隻
   480			# 擠在一起時，正在出手或受擊的那隻加隊伍色光圈（第三輪 V5）
   481			if live and (at > 0.0 or hurt > 0.0) and crowd.get(u.id, 0) >= 3:
   482				draw_arc(p + Vector2(0, -24 if u.type != D.CAVALRY else -28), 19.0, 0, TAU, 24, Color(Art.team_color(u.team, cbm()), 0.75 * alpha), 2.0, true)
   483			# 表情與兵種專屬動作（R5）
   484			var mood := 0
   485			var lean := 0.0
   486			var crouch := 1.0
   487			if hurt > 0.3 or u.stun > 0:
   488				mood |= Art.M_HURT
   489			if hurt > 0.0:
   490				crouch *= 1.0 - 0.12 * hurt                 # V1.1 A2：受擊壓扁（縱 0.88），配合後退與閃白
   491				lean -= 0.06 * hurt * float(hurt_dir.get(u.id, 0.0)) * face
   492			if live and u.windup > 0 and at == 0.0:
   493				# V1.1 A3：大招前搖的身體預警。小石魔高舉拉長、吸塵貓吸氣鼓脹、沙漏精靈與骷髏法師浮起
   494				var wk := 1.0 - float(u.windup) / F8.WINDUP
   495				if u.type == F8.GOLEM:
   496					at = Art.ATK_WINDUP * minf(1.0, wk * 1.4) * 0.999
   497				elif u.type == F8.CAT:
   498					crouch *= 1.0 + 0.14 * sin(minf(1.0, wk) * PI * 0.5)
   499				else:
   500					p.y -= 4.0 * sin(minf(1.0, wk) * PI * 0.5)
   501			if u.type == D.CAVALRY and moving and u.charge >= D.CHARGE_NEED:
   502				mood |= Art.M_SPARKLE
   503				lean = 0.26                      # 衝鋒蓄滿前傾 15°
   504				for k in 3:                      # 馬蹄噴土
   505					var ph := fmod(time * 4.0 + k * 0.33 + u.id * 0.1, 1.0)
   506					draw_circle(p + Vector2(-face * (14 + ph * 16), -2 - ph * 6), 3.2 * (1.0 - ph), Color(0.85, 0.75, 0.55, 0.7 * (1.0 - ph)), true, -1.0, true)
   507			if s.frenzy and at == 0.0 and not s.finished:
   508				mood |= Art.M_BROWS
   509				# 狂熱氣場（第三輪 R3）：身邊橘紅脈衝圈
   510				var pulse := 0.5 + 0.5 * sin(time * 7.0 + u.id)
   511				draw_arc(p + Vector2(0, -22), 15.0 + pulse * 3.0, 0, TAU, 20, Color(1.0, 0.33, 0.2, (0.35 + 0.3 * pulse) * alpha), 2.0, true)
   512			if u.type == D.ASSASSIN and u.stealth > 0:
   513				mood |= Art.M_HOOD
   514				crouch = 0.9                     # 潛行蹲身
   515			if live and brace_t.has(u.id) and time - brace_t[u.id] < 0.35:
   516				mood |= Art.M_BRACE
   517			# 勝利：存活的勝方每 0.45 秒原地跳 10px、武器高舉
   518			var hop := 0.0
   519			if live and sim != null and u.team == sim.winner and (state == St.RESULT or (state == St.BATTLE and view != null and view.finished)):
   520				hop = absf(sin((time + u.id * 0.05) * PI / 0.45)) * 10.0
   521				at = Art.ATK_WINDUP
   522				lean = Art.windup_lean(u.type)      # 抵銷前搖的後仰（V1.1：依兵種）：站直、武器高舉（和前搖分得開，Antigravity S4）
   523				crouch = 1.06
   524				_star_above(p + Vector2(0, -hop - (74 if u.type == D.CAVALRY else 66)))
   525				# V1.1 A7：兵種專屬的勝利小動作（簡化特效時不畫）
   526				match -1 if bool(Save.s("reduce_fx")) else u.type:
   527					D.DRUMMER:   # 鼓手：頭邊冒音符
