   529						_icon("sound", p + Vector2(18 + nk * 8, -48 - nk * 22 - hop), 14.0, Color(1.0, 0.85, 0.4, 1.0 - nk))
   530					D.BERSERKER:   # 狂戰士：雙斧互敲的火花圈
   531						var bk := absf(sin((time + u.id * 0.05) * PI / 0.45))
   532						draw_arc(p + Vector2(0, -50 - hop), 8.0 + bk * 6.0, 0, TAU, 16, Color(1.0, 0.55, 0.2, 0.8 * bk), 2.5, true)
   533					D.MEDIC:   # 醫者：綠色小十字往上飄
   534						var mk := fmod(time * 1.2 + u.id * 0.4, 1.0)
   535						var mc := p + Vector2(-16, -44 - mk * 24 - hop)
   536						draw_line(mc - Vector2(4, 0), mc + Vector2(4, 0), Color(0.5, 1.0, 0.55, 1.0 - mk), 2.5)
   537						draw_line(mc - Vector2(0, 4), mc + Vector2(0, 4), Color(0.5, 1.0, 0.55, 1.0 - mk), 2.5)
   538			p.y -= hop
   539			if u.hidden:
   540				Art.mimic_closed(self, p, u.team, face, alpha, time, cbm(), UNIT_SCALE)   # 偽裝中的寶箱怪
   541				continue
   542			if u.type == F8.GHOST:
   543				alpha *= 0.9
   544				p.y -= 3.0 + 2.5 * sin(time * 2.2 + u.id * 0.9)   # V1.1 A4：幽靈上下漂
   545			# 待機小動作（V9 P2）：重心換腳、偶爾縮一下身子
   546			if live and walk == 0.0 and at == 0.0:
   547				lean += sin(time * 1.1 + u.id * 1.7) * 0.018
   548				var idle_k := fmod(time + u.id * 1.37, 7.3)
   549				if idle_k < 0.3:
   550					crouch *= 1.0 - sin(idle_k / 0.3 * PI) * 0.05
   551			if live:
   552				face = _face_of(u)
   553			if u.stealth > 0:
   554				# 潛行：身後兩道暗紫殘影
   555				for g in 2:
   556					var gp := p + Vector2(-(8 + g * 8) * face, 0)
   557					draw_circle(gp + Vector2(0, -22), 11.0 - g * 2.0, Color(0.3, 0.15, 0.45, 0.22 - g * 0.08), true, -1.0, true)
   558					_unit(gp, u.type, u.team, face, 0.0, 0.0, 0.0, 0.14 - g * 0.06, time, UNIT_SCALE)
   559			if live and walk <= Gait.POSE_DAZE + 1.0:
   560				# 暈眩：頭上轉圈的星星
   561				for sk0 in 3:
   562					var sa0 := time * 5.0 + sk0 * TAU / 3.0
   563					_icon("star", p + Vector2(cos(sa0) * 15.0, -60.0 + sin(sa0) * 5.0), 13.0, Color("#ffd166"))
   564			_unit(p, u.type, u.team, face, walk, at, hurt, alpha, time, UNIT_SCALE, mood, lean, crouch, variant)
   565			if live and not u.hidden:
   640				if cbm():
   641					# 色盲模式：血條左邊加隊伍形狀（藍＝●、紅＝◆），不只靠顏色（R8）
   642					var mk := top + Vector2(-8, 2)   # 8px 標記＋黑邊（第三輪 V5）
   643					if u.team == 0:
   644						draw_circle(mk, 5.5, Art.OUT, true, -1.0, true)
   645						draw_circle(mk, 4.0, Art.team_color(0, true), true, -1.0, true)
   646					else:
   647						draw_colored_polygon(PackedVector2Array([mk + Vector2(0, -6.5), mk + Vector2(6.5, 0), mk + Vector2(0, 6.5), mk + Vector2(-6.5, 0)]), Art.OUT)
   648						draw_colored_polygon(PackedVector2Array([mk + Vector2(0, -4.5), mk + Vector2(4.5, 0), mk + Vector2(0, 4.5), mk + Vector2(-4.5, 0)]), Art.team_color(1, true))
   649		if not live:
   650			return
   651		for g in dying:
   652			var k: float = g["t"] / 1.0
   653			_draw_death(g, k)
   654			if k < 0.3:
   655				for i in 6:
   656					var ang := i * TAU / 6
   657					draw_circle(g["pos"] + Vector2(cos(ang), sin(ang) * 0.5) * (8 + k * 70) + Vector2(0, -16), 4 * (1 - k), Color(1, 1, 1, 0.35), true, -1.0, true)
   658			Art.soul(self, g["pos"] + Vector2(sin(k * 9) * 4, -24 - k * 70), 0.75 * (1.0 - k))
   659	
   660	## V9 P2：每種兵的死法。k＝0～1（1 秒）。只用轉換與粒子，不多烘影格。
   661	func _draw_death(g: Dictionary, k: float) -> void:
   662		var t: int = g["type"]
   663		var p: Vector2 = g["pos"]
   664		var face: float = g["face"]
   665		var u := minf(k / 0.55, 1.0)         # 倒下的主要段落
   666		var e := 1.0 - (1.0 - u) * (1.0 - u)
   667		var al := 1.0 - maxf(0.0, (k - 0.45) / 0.3)
   668		if al <= 0.0:
   669			return
   670		var lean := 0.0
   671		var crouch := 1.0
   672		var hurt := maxf(0.0, 0.8 - k * 3.0)
   673		match t:
   674			D.CAVALRY:
   675				lean = e * 1.45          # 連人帶馬往前翻
   676			D.BERSERKER, D.PIKE:
   677				lean = -e * 1.5          # 仰天倒下
   678			D.SHIELD, D.SWORD, D.DRUMMER:
   679				lean = e * 1.2           # 往前跪倒
   680				crouch = 1.0 - e * 0.25
   681			D.ARCHER, D.BOMBER, D.MEDIC:
   682				crouch = 1.0 - e * 0.45  # 坐倒
   683				lean = -e * 0.35
   684			D.ASSASSIN:
   685				al *= 1.0 - u * 0.8      # 化煙
   686				for i in 5:
   687					var a0 := i * TAU / 5.0 + k * 2.0
   688					draw_circle(p + Vector2(cos(a0) * (6 + k * 30), -20 - k * 24 + sin(a0) * 6), 7.0 * (1.0 - k), Color(0.25, 0.2, 0.35, 0.5 * (1.0 - k)), true, -1.0, true)
   689			10:
   690				crouch = 1.0 - e * 0.7   # 孢子菇癟掉
   691			11:
   692				al *= 1.0 - u            # 羊：羊毛飛散
   693				for i in 7:
   694					var a1 := i * TAU / 7.0
   695					draw_circle(p + Vector2(cos(a1), sin(a1) * 0.6 - 0.8) * (8 + k * 46), 6.0 * (1.0 - k), Color(Art.team_color(g["team"], cbm()).lightened(0.3), 0.8 * (1.0 - k)), true, -1.0, true)
   696			12:
   697				lean = e * 0.5           # 箱子翻倒，鉚釘掉落
   698				for i in 4:
   699					draw_circle(p + Vector2((i - 1.5) * (6 + k * 14), -14 + k * k * 14), 1.8, Color(Art.GOLD, 1.0 - k), true, -1.0, true)
   700			13, 20:
   701				crouch = 1.0 - e * 0.8   # 史萊姆化開成一灘
   702				draw_set_transform_matrix(_cam * Transform2D(0, Vector2(1, 0.4), 0, p))
   703				draw_circle(Vector2.ZERO, 8.0 + e * 16.0, Color(Art.team_color(g["team"], cbm()), 0.45 * (1.0 - k)), true, -1.0, true)
   704				draw_set_transform_matrix(_cam)
   705			14:
   706				p += Vector2(0, -e * 34.0)   # 幽靈往上消散
   707				al *= 1.0 - u * 0.7
   708			16, 17, 21, 15:
   709				crouch = 1.0 - e * 0.5   # 散開：骨頭、沙粒、布屑往外
   710				var col := Color("#ece6d6") if t != 16 and t != 15 else (Color("#ffd166") if t == 16 else Color("#e8d3a8"))
   711				for i in 6:
   712					var a2 := i * TAU / 6.0 + float(g.get("seed", 0.0))
   713					var r2 := 8.0 + e * 26.0
   714					draw_circle(p + Vector2(cos(a2) * r2, -18.0 + sin(a2) * r2 * 0.5 + k * k * 22.0), 3.0 * (1.0 - k * 0.6), Color(col, 1.0 - k), true, -1.0, true)
   715			18:
   716				lean = -e * 0.9          # 吸塵貓往後坐倒
   717			19:
