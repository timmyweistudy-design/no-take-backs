    56	static func _pose_prof(atk: float, f: Array) -> Array:
    57		if atk < ATK_WINDUP:
    58			var e := _smooth(atk / ATK_WINDUP)
    59			return [-e, -f[2] * e, lerpf(1.0, f[0], e), lerpf(1.0, f[1], e), f[3] * e]
    60		if atk < ATK_STRIKE:
    61			var u := (atk - ATK_WINDUP) / (ATK_STRIKE - ATK_WINDUP)
    62			var e2 := 1.0 - (1.0 - u) * (1.0 - u)
    63			return [lerpf(-1.0, 1.0, e2), lerpf(-f[2], f[6], e2), lerpf(f[0], f[4], e2), lerpf(f[1], f[5], e2), lerpf(f[3], f[7], e2)]
    64		var r := (atk - ATK_STRIKE) / (1.0 - ATK_STRIKE)
    65		var e3 := _smooth(clampf((r - f[8]) / (1.0 - f[8]), 0.0, 1.0))   # 先停在命中姿勢 f[8]，再收回
    66		return [lerpf(1.0, 0.0, e3), lerpf(f[6], 0.0, e3), lerpf(f[4], 1.0, e3), lerpf(f[5], 1.0, e3), lerpf(f[7], 0.0, e3)]
    67	
    68	
    69	## 角色的局部座標轉換（以腳底為原點、face＝+1 畫）：呼吸／走路起伏、前撲、傾身、壓扁拉長、翻面。
    70	## lean＝額外傾角（騎兵衝鋒前傾）、crouch＝縱向縮放（刺客潛行蹲身）。
    71	static func unit_xf(p: Vector2, face: float, walk: float, atk: float, t: float, scale := 1.0, lean := 0.0, crouch := 1.0, gtype := 0) -> Transform2D:
    72		# 外層（位置、起伏、翻面、縮放、額外傾身／蹲身）× 內層（攻擊姿勢，face＝+1 空間）。
    73		# 精靈圖快取烘焙的是內層，貼圖時套外層，所以兩條路的順序完全一樣（Codex R5 #3）。
    74		var ps := pose(atk, gtype)
    75		var bob := idle_bob(t, p.x) if walk == 0.0 else -Gait.air(gtype, walk)
    76		var outer := Transform2D(lean * face, Vector2(scale * face, scale * crouch), 0.0, p + Vector2(0, bob * scale))
    77		return outer * Transform2D(ps[1], Vector2(ps[2], ps[3]), 0.0, Vector2(ps[4], 0))
    78	
    79	
    80	## 單位：p＝腳底；face＝±1；walk＝走路相位（0＝沒走）；atk＝攻擊動作進度 0～1（見上）；hurt＝受擊閃白 0～1；
    81	## alpha＝透明度（潛行）；t＝時間（待機呼吸）；scale＝縮放；mood＝表情疊加（M_*）；lean／crouch 見 unit_xf。
    82	static func unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
    83			hurt: float, alpha: float, t: float, scale := 1.0, cb := false, mood := 0, lean := 0.0, crouch := 1.0, variant := 0) -> void:
    84		var tc := team_color(team, cb)
    85		_team_now = team
    86		var w: float = pose(atk, type)[0]
    87		if atk > 0.0:
    88			walk = 0.0   # 和精靈圖一致：攻擊格沒有走路相位
    89		_xf = base * unit_xf(p, face, walk, atk, t, scale, lean, crouch, type)
    90		ci.draw_set_transform_matrix(_xf)
    91		# 以 face＝+1 畫（水平鏡像由 transform 處理）
    92		if type == D.CAVALRY:
    93			_cavalry(ci, tc, walk, w, alpha, t, atk > 0.0)
    94		elif type >= D.COUNT:
    95			_fantasy(ci, type, tc, walk, w, alpha, t, atk > 0.0, variant)
    96		else:
    97			_infantry(ci, type, tc, walk, w, alpha, t, atk > 0.0, variant)
    98		if hurt > 0.0:
    99			# 受擊閃白：在身體位置疊一層白
   100			ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, true)
   680	var _tex_cache := {}
   681	
   682	func _ui_tex(path: String) -> Texture2D:
   683		if not _tex_cache.has(path):
   684			_tex_cache[path] = load(path) if ResourceLoader.exists(path) else null
   685		if _tex_cache[path] == null and layout_probe and not path in probe_missing:
   686			probe_missing.append(path)
   687		return _tex_cache[path]
   688	
   689	## V1.2：頂部資訊列：深木紋＋下緣一條亮線與落影（沒有貼圖時照舊平塗）。
   690	func _hud_bar(r: Rect2) -> void:
   691		if bool(Save.s("plain_ui")) or not _tex_box(r.grow_individual(8, 8, 8, 0), "wood", Color(0.3, 0.21, 0.15, 0.97)):
   692			draw_rect(r, UI_BG)
   693			return
   694		draw_rect(Rect2(r.position.x, r.end.y - 2, r.size.x, 2), Color(0.55, 0.42, 0.28, 0.9))
   695		draw_rect(Rect2(r.position.x, r.end.y, r.size.x, 4), Color(0, 0, 0, 0.25))
   696	
   697	## V1.2：木製框（九宮格、四角銅釘、中間透明），面板、戰場、大廳沙盤預覽共用。grow＝往外擴多少。
   698	func _wood_frame(r: Rect2, grow := 8.0, key := "frame") -> void:
   699		var fx := _ui_tex(TEX_FRAME)
   700		if fx == null or bool(Save.s("plain_ui")):
   701			return
   702		var sb: StyleBoxTexture = _sb_cache.get(key)
   703		if sb == null:
   704			sb = StyleBoxTexture.new()
   705			sb.texture = fx
- 三星搜尋只證明「拿得到」，不代表難度合理；舊 25 關與試煉前 10 關解法在 `tests/golden/star_solutions.json`，新關的三星解存在關卡資料的 `best`。
- 新 75 殘局、20 試煉的難度只有求解器指標（隨機擺法過關率、容錯、兵種數），沒有真人校準；章內依隨機過關率排序。時序章有幾關三星解在開場就放，時機不算關鍵。有些關不帶主角也能過（只記錄 `hero_free_ok`，不擋）。
- 新成就 3 個（PUZZLE_100、PUZZLE_ALL3、TRIAL_ALL3，共 24 個）要在 Steamworks 後台建立才會解鎖。
- 拿掉循序解鎖後，新手第一場就面對 10 種兵（選奇幻是另外 10 種）：靠教學、預設、簡介卡引導，有沒有資訊過量要看真人試玩。

## 驗證入口
- `GODOT=<4.6.2> tools/check_all.sh`：統一檢查，CI 也用。
- `tools/layout_check.sh <win exe> <新資料夾>`：版面（會被擋的項目見腳本）；另外要人工看英文 150%。
- `GODOT=<win exe> tools/export_check.sh <空資料夾>`：匯出成品自我檢查。
- `SHARDS=14 tools/balance/fantasy_eval.sh <army|cheese|core|repl> <輸出檔>`：奇幻兵平衡；替換實驗至少用 `--bases=24 --opp=14`（112 場會把雜訊看成超標）。
- 統一檢查在 Windows 版要 40～50 分鐘，外層 timeout 至少開 90 分鐘。

## 最後一次驗收（2026-11-07，V1.2.1 收尾）
- 統一檢查 CHECK OK（48 步全部重跑）：測試 3993 項全過，811 秒；FINGERPRINT b8fe741bcbfcf800、數值摘要 288176c5c9af5a79 不變。
- 版面 14 組 1400 張 0 違規（兩語 × 三字級＋簡化、色盲、手把、停用各兩語 150%），含文字對比、九宮格內距、缺圖、手把流程；截圖人工看過。
- 匯出 EXPORT OK；標題顯示 v1.2.1。
- 效能（同機、效能模式）：繪圖 p95 9.61 ms（V1.1 8.90，+8%）；開機 3.4 秒（這台機器 2.6～3.4 秒雙峰）。`docs/perf/v121-draw.json`。
- 三方：方案三輪；實作 Codex、Antigravity 各審兩輪，必修都修完或已裁決（`coordination/v121-*`）。沒有真人玩過 V1.2.1。
# 模組索引（自動產生，勿手改：`python3 tools/gen/module_index.py`）

找程式先看這裡，再用 grep 加行號範圍讀；大檔不要整檔讀。

