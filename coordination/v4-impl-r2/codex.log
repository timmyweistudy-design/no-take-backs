   222	            md.append(f"\n收益遞減：{'✓' if dim else '✗'}；Δ(4) ≤ +15：{'✓' if dk[4] <= 0.15 else '✗'}\n")
   223	    if band_detail:
   224	        md.append("\n## 經典兵種範圍（同一個替換實驗，經典池）\n\n| 兵種 | 補法 a | 補法 b | 補法 c |\n|---|---|---|---|\n")
   225	        for u, d in sorted(band_detail.items()):
   226	            md.append(f"| {NAMES[u]} | {d['a'][0]*100:+.1f} | {d['b'][0]*100:+.1f} | {d['c'][0]*100:+.1f} |\n")
   227	        md.append("範圍＝最小−3～最大+3：" + "、".join(f"{k} {v[0]*100:+.1f}～{v[1]*100:+.1f}" for k, v in sorted(band.items())) + "\n")
   228	    md.append("\n## 結論\n\n" + ("全部門檻通過 ✓\n" if not fails else "".join(f"- ✗ {f}\n" for f in fails)))
   229	    open(os.path.join(folder, "report.md"), "w", encoding="utf-8").write("".join(md))
   230	    print("".join(md))
   231	    sys.exit(1 if fails else 0)
