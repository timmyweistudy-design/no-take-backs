   104	def load_band(folder):
   105	    # 經典範圍資料要完整：開放數 5、恰好劍士／騎兵／刺客三種、每種 200×6×4 列（Codex 實作審查 #8）
   106	    bman = json.load(open(os.path.join(folder, "manifest.json"), encoding="utf-8"))
   107	    if bman.get("ntypes") != 5 or sorted(bman.get("modes", [])) != ["repl:0", "repl:3", "repl:4"]:
   108	        print("✗ 經典範圍資料的設定不對：", bman); sys.exit(2)
   109	    rows = {}
   110	    for f in sorted(glob.glob(os.path.join(folder, "repl_*.jsonl"))):
   111	        for line in open(f, encoding="utf-8"):
   112	            if line.strip():
   113	                r = json.loads(line)
   114	                rows.setdefault(r["unit"], []).append(r)
   115	    if sorted(rows) != [0, 3, 4] or any(len([r for r in v if "skip" not in r]) != 200 * 6 * 4 for v in rows.values()):
   116	        print("✗ 經典範圍資料不完整：", {u: len(v) for u, v in rows.items()}); sys.exit(2)
   117	    band = {}
   118	    detail = {}
   119	    for u, got in rows.items():
   120	        d, _ = repl_deltas(got)
   121	        detail[u] = d
   122	        for pol in d:
   123	            lo, hi = band.get(pol, (9, -9))
   124	            band[pol] = (min(lo, d[pol][0]), max(hi, d[pol][0]))
   125	    return {pol: (lo - 0.03, hi + 0.03) for pol, (lo, hi) in band.items()}, detail
   126	
   127	def main():
   128	    folder = sys.argv[1]
   129	    band, band_detail = (load_band(sys.argv[2]) if len(sys.argv) > 2 else (None, None))
   130	    man = json.load(open(os.path.join(folder, "manifest.json"), encoding="utf-8"))
   131	    rows = {}
   132	    for f in sorted(glob.glob(os.path.join(folder, "*.jsonl"))):
   133	        key = os.path.basename(f).rsplit("_", 1)[0]
   134	        for line in open(f, encoding="utf-8"):
   135	            if line.strip():
   136	                rows.setdefault(key, []).append(json.loads(line))
   137	    digests = {r.get("digest") for v in rows.values() for r in v}
   138	    if len(digests) != 1 or None in digests:
   139	        print("✗ 數值摘要不一致或缺少：", digests); sys.exit(2)
   140	    md = [f"# 新兵種驗收報表\n\n- 數值摘要 `{digests.pop()}`、開放兵種 {man['ntypes']}、程式 `{man['commit']}`\n"]
   141	    fails = []
   142	    for m in man["modes"]:
   143	        key = m.replace(":", "_", 1)
   144	        got = rows.get(key, [])
   145	        mode = m.split(":")[0]
   146	        if any(r.get("mode") != mode for r in got):
   147	            print(f"✗ {m} 裡有別的模式的資料"); sys.exit(2)
   148	        if not got:
   149	            print(f"✗ {m} 沒有資料"); sys.exit(2)
   150	        check_rows(m, mode, got, man)
   151	        if mode == "core":
   152	            keys = {(r["r"], r["seed"]) for r in got}
   153	            if len(got) != len(CORE) * 40 or len(keys) != len(got):
   154	                print(f"✗ core 筆數 {len(got)} 不對"); sys.exit(2)
   155	            md.append("\n## 核心剋制關係（X 為主＋同樣的劍弓填充，對 Y 為主；40 種排法 × 交換左右）\n\n| 關係 | X 得分 | 95% 區間 | 判定 |\n|---|---|---|---|\n")
   156	            for ri, name in enumerate(CORE):
   157	                xs = [(r["s0"] + r["s1"]) / 2 for r in got if r["r"] == ri]
   158	                mm, lo, hi = mean_ci(xs)
   159	                okk = lo > 0.5
   160	                if not okk:
   161	                    fails.append(f"核心關係「{name}」不成立（下界 {lo*100:.0f}%）")
   162	                md.append(f"| {name} | {mm*100:.0f}% | {lo*100:.0f}～{hi*100:.0f}% | {'✓' if okk else '✗'} |\n")
   163	        elif mode == "repl":
   164	            u = int(m.split(":")[1])
   165	            data = [r for r in got if "skip" not in r]
   166	            skips = [r for r in got if "skip" in r]
   167	            keys = {(r["i"], r["k"], r["pol"]) for r in data}
   168	            if len(keys) != len(data) or len(data) + len(skips) * 0 != (200 - len(skips)) * 6 * 4:
   169	                print(f"✗ {m} 筆數 {len(data)}（跳過 {len(skips)}）不對"); sys.exit(2)
   170	            per = {}
   171	            for r in data:
   172	                per.setdefault(r["i"], {}).setdefault(r["pol"], []).append((r["s0"] + r["s1"]) / 2)
   173	            md.append(f"\n## 替換實驗：{NAMES[u]}（{len(per)} 套陣型 × 6 個對手 × 交換左右；Δ＝原陣型 − 替換）\n\n| 補法 | Δ（百分點） | 95% 區間 | 判定 |\n|---|---|---|---|\n")
   174	            orig_wr = sum(sum(v["orig"]) / len(v["orig"]) for v in per.values()) / len(per)
   175	            if band:
   176	                md[-1] = md[-1].replace("| 補法 | Δ（百分點） | 95% 區間 | 判定 |\n|---|---|---|---|\n", "| 補法 | Δ（百分點） | 95% 區間 | 經典範圍 | 判定 |\n|---|---|---|---|---|\n")
   177	            dd, _ = repl_deltas(got)
   178	            for pol, label in [("a", "補成陣中最多的舊兵種"), ("b", "全補劍士"), ("c", "全補弓箭手")]:
   179	                mm, lo, hi = dd[pol]   # 雙向群集（陣型 × 對手）區間
   180	                if band:
   181	                    blo, bhi = band[pol]
   182	                    okk = blo <= mm <= bhi
   183	                    if not okk:
   184	                        fails.append(f"{NAMES[u]} 替換實驗（{label}）Δ {mm*100:+.1f} 不在經典範圍 {blo*100:+.1f}～{bhi*100:+.1f}")
   185	                    md.append(f"| {label} | {mm*100:+.1f} | {lo*100:+.1f}～{hi*100:+.1f} | {blo*100:+.1f}～{bhi*100:+.1f} | {'✓' if okk else '✗'} |\n")
   186	                else:
