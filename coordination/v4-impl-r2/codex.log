func core(shard: int, shards: int) -> void:
	var idx := 0
	for ri in CORE.size():
		for sd in CORE_SEEDS:
			idx += 1
			if idx % shards != shard:
				continue
			var rng := RandomNumberGenerator.new()
			rng.seed = 90001 + ri * 1013 + sd * 7919
			var wx := D.zeros()
			wx[CORE[ri][0]] = 3
			wx[D.SWORD] += 1
			wx[D.ARCHER] += 1
			var wy := D.zeros()
			wy[CORE[ri][1]] = 3
			wy[D.SWORD] += 1
			wy[D.ARCHER] += 1
			var style: String = F.STYLES[sd % F.STYLES.size()]
			var ax := F.weighted_formation(0, rng, wx, style)
			var ay := F.weighted_formation(0, rng, wy, style)
			var sc := duel2(ax, ay)
			emit({"mode": "core", "r": ri, "seed": sd, "s0": sc[0], "s1": sc[1]})

## 含 X 的陣型：從 ntypes 範圍的混編裡產生，X 的權重至少 2；第 i 套固定種子。
static func with_unit(x: int, nt: int, i: int) -> Army:
	var rng := RandomNumberGenerator.new()
	rng.seed = 424242 + x * 100003 + i * 7919
	for tries in 50:
		var w := D.zeros()
		for t in nt:
			w[t] = rng.randi_range(0, 3)
		w[x] = maxi(2, w[x])
		if D.is_support(x):
			# 支援兵（醫者、鼓手）不疊加、AI 一種最多帶 2 隻：只取帶 1～2 隻的陣型（第四輪驗收時修正，見報告）
			w[x] = 1
		var a := F.weighted_formation(0, rng, w)
		if a.count_of(x) > 0 and (not D.is_support(x) or a.count_of(x) <= 2):
			return a
	return null

## 整批拿掉 X，空出的錢與格子用 fill 兵種補回：先補原本 X 的格子（前排→後排、中間→兩邊），再補其他空格；錢不夠就留著。
static func refill(a: Army, x: int, fill: int) -> Army:
	var b := Army.new(0, 100)
	var holes: Array = []
	for u in a.units:
		if u["type"] == x:
			holes.append(Vector2i(u["col"], u["row"]))
		else:
			b.units.append(u.duplicate())
	holes.sort_custom(func(p, q): return p.x > q.x or (p.x == q.x and absi(p.y - 4) < absi(q.y - 4)) or (p.x == q.x and absi(p.y - 4) == absi(q.y - 4) and p.y < q.y))
	for h in holes:
		b.place(fill, h.x, h.y)
	for c in [5, 4, 3, 2, 1, 0]:
		for r in [4, 3, 5, 2, 6, 1, 7, 0, 8]:
			if b.left() < D.cost(fill):
				return b
			b.place(fill, c, r)
	return b

## 補法 a：這套陣型裡（拿掉 X 後）金額最多的舊兵種；同額取編號小的；沒有就劍士。
static func most_common_other(a: Army, x: int) -> int:
	var comp := F.composition(a)
	var best := -1
	for t in D.CLASSIC:
		if t != x and comp[t] > 0 and (best == -1 or comp[t] > comp[best]):
			best = t
	return best if best >= 0 else D.SWORD

## 盾兵為主的對手池（狂戰士的混編驗收用，§2.4）：盾兵權重 4，其他經典兵種 0～2。
static func shield_pool(n: int) -> Array:
	var out: Array = []
	var rng := RandomNumberGenerator.new()
	for i in n:
		rng.seed = 616161 + i * 7919
		var w := D.zeros()
		for t in D.CLASSIC:
			w[t] = rng.randi_range(0, 2)
		w[D.SHIELD] = 4
		out.append(F.weighted_formation(0, rng, w))
	return out

func repl(x: int, nt: int, shard: int, shards: int, vs_shield := false) -> void:
	var opps := shield_pool(200) if vs_shield else F.validation_pool(0, nt)
	pool_id = pool_hash(opps)
	var mname := "replshield" if vs_shield else "repl"
extends SceneTree
## 舊兵種相容檢查（第四輪方案 §3.1～3.2）。
## 目的：加新兵種之後，「只用舊 5 種兵」的對戰行為必須一模一樣。
## 最終指紋包含規則版本和數值摘要，加兵後一定會變，所以這裡不比指紋，改比：
##   ・逐 tick 累積摘要：每 tick 把每隻兵的「舊欄位」（第三輪就有的 28 個狀態）寫進同一個 SHA-256
##   ・勝方、結束 tick、每隻兵的擊殺數、造成／承受傷害
## 基準檔 tests/golden/compat_v1.2.json 是在 N0a（規則 1.2.0、還沒加兵）時用同一套程式產生的，
## 之後不重產；陣型代碼存在檔案裡，不重新呼叫 AI 造陣（AI 之後會改）。
## 用法：godot --headless --path game --script res://tools/compat.gd -- [--make] [--n=1000]
const Sim = preload("res://scripts/core/battle_sim.gd")
const Army = preload("res://scripts/core/army.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const PATH := "res://tests/golden/compat_v1.2.json"
const GOLDEN := "res://tests/golden/golden.json"

## 舊欄位（第三輪 _hash_state 的 28 個欄位）。新兵種加的狀態不放這裡，另外檢查它們在舊場次一直是初值。
static func old_fields(u) -> PackedInt64Array:
	return PackedInt64Array([u.x, u.y, u.hp, u.cd, u.target, u.fx, u.fy, u.face_lock, u.mx, u.my, u.cdx, u.cdy, u.stealth, u.charge, u.stun,
		u.slow, u.wp_x, u.wp_y, u.wp_for, 1 if u.alive else 0, u.dmg_dealt, u.dmg_taken, u.kills, u.id, u.team, u.type, u.nav, 1 if u.chasing else 0])

## 新狀態在舊場次必須一直是初值（加了新欄位就在這裡登記初值）。回傳空字串＝正常。
static func new_fields_untouched(s) -> String:
	for u in s.units:
		for k in NEW_FIELDS:
			if k in u and u.get(k) != NEW_FIELDS[k]:
				return "id %d 的 %s=%s（應為 %s）" % [u.id, k, u.get(k), NEW_FIELDS[k]]
	return ""

## 第四輪新增的單位狀態與它們的初值（舊 5 種兵永遠不會用到）
const NEW_FIELDS := {"hcd": 0, "aura": 0, "breach": 0, "bmode": 0, "heal_done": 0, "follow": -1, "drum_cover": 0}

static func run_case(c0: String, c1: String) -> Dictionary:
	var a0 := Army.new(0, 100)
	var a1 := Army.new(1, 100)
	a0.load_code(c0)
	a1.load_code(c1)
	var s = Sim.new(a0, a1)
	s.fast = true
	var h := HashingContext.new()
	h.start(HashingContext.HASH_SHA256)
	var untouched := ""
	while not s.finished:
		s.step()
		var buf := PackedInt64Array([s.tick])
		for u in s.units:
			buf.append_array(old_fields(u))
		h.update(buf.to_byte_array())
		if untouched == "":
			untouched = new_fields_untouched(s)
	var per := PackedStringArray()
	for u in s.units:
		per.append("%d:%d:%d:%d" % [u.id, u.kills, u.dmg_dealt, u.dmg_taken])
	return {"w": s.winner, "t": s.tick, "roll": h.finish().hex_encode().substr(0, 24), "per": ";".join(per), "untouched": untouched}

func _init() -> void:
	var args := OS.get_cmdline_user_args()
	var n := 1000
	for a in args:
		if a.begins_with("--n="):
			n = int(a.substr(4))
	if "--make" in args:
		_make()
		return
	var res := check(n)
	print("COMPAT %s" % JSON.stringify(res))
	quit(0 if res["ok"] else 1)

func _make() -> void:
	if D.RULES_VERSION != "1.2.0":
		push_error("相容基準只能在規則 1.2.0（還沒加新兵）時產生")
		quit(1)
		return
	var g = JSON.parse_string(FileAccess.get_file_as_string(GOLDEN))
	var cases: Array = []
	for c in g["cases"]:
		var r := run_case(c["a"], c["b"])
		cases.append({"a": c["a"], "b": c["b"], "w": r["w"], "t": r["t"], "roll": r["roll"], "per": r["per"]})
	var f := FileAccess.open(PATH, FileAccess.WRITE)
	f.store_string(JSON.stringify({"from_rules": D.RULES_VERSION, "from_digest": D.data_digest(), "cases": cases}))
	f.close()
	print("COMPAT 已產生 %d 場基準（規則 %s）" % [cases.size(), D.RULES_VERSION])
	quit(0)

## 比對前 n 場；回傳 {ok, n, first_case, why}
static func check(n: int) -> Dictionary:
	var g = JSON.parse_string(FileAccess.get_file_as_string(PATH))
	if not g is Dictionary:
		return {"ok": false, "why": "讀不到相容基準檔"}
	var cases: Array = g["cases"]
	# 基準必須是完整的 1000 場、而且至少要比 1 場（Codex 實作審查 #10：空的或縮水的基準不能回報成功）
	if cases.size() != 1000 or str(g.get("from_rules", "")) != "1.2.0":
		return {"ok": false, "why": "相容基準不完整或來源規則不是 1.2.0（%d 場）" % cases.size()}
	if n < 1 or n > cases.size():
		return {"ok": false, "why": "要比的場數 %d 不合法" % n}
	for i in n:
		var c: Dictionary = cases[i]
		var r := run_case(c["a"], c["b"])
		if r["untouched"] != "":
			return {"ok": false, "n": i + 1, "first_case": i, "why": "新狀態在舊場次被動到：" + r["untouched"]}
		if int(r["w"]) != int(c["w"]) or int(r["t"]) != int(c["t"]):
			return {"ok": false, "n": i + 1, "first_case": i, "why": "勝負或結束 tick 不同"}
		if r["per"] != str(c["per"]):
			return {"ok": false, "n": i + 1, "first_case": i, "why": "擊殺或傷害統計不同"}
		if r["roll"] != c["roll"]:
			return {"ok": false, "n": i + 1, "first_case": i, "why": "逐 tick 狀態分歧"}
	return {"ok": true, "n": n}
#!/usr/bin/env bash
# 新兵種驗收（第四輪 §3.4）。用法：NTYPES=7 SHARDS=12 tools/unit_eval.sh <輸出資料夾> core repl:5 repl:6 cover:7 ...
# 每個模式開 SHARDS 個 headless 行程；最後 unit_eval_report.py 核對筆數與鍵、算群集區間、判定門檻。
set -uo pipefail
cd "$(dirname "$0")/.."
OUT="${1:?輸出資料夾}"; shift
SHARDS="${SHARDS:-12}"; GODOT="${GODOT:-godot}"; NT="${NTYPES:-10}"
mkdir -p "$OUT"; rm -f "$OUT"/*.jsonl
t0=$(date +%s); fail=0
for m in "$@"; do
  mode="${m%%:*}"; unit=""; [[ "$m" == *:* ]] && unit="--unit=${m#*:}"
  pids=()
  for ((s=0; s<SHARDS; s++)); do
    "$GODOT" --headless --path . --script res://tools/unit_eval.gd -- "--mode=$mode" $unit "--ntypes=$NT" "--shard=$s" "--shards=$SHARDS" > "$OUT/${m/:/_}_$s.raw" 2>&1 &
    pids+=($!)
  done
  for p in "${pids[@]}"; do wait "$p" || fail=1; done
  for ((s=0; s<SHARDS; s++)); do
    grep '^R ' "$OUT/${m/:/_}_$s.raw" | sed 's/^R //' > "$OUT/${m/:/_}_$s.jsonl"
    if grep -q 'SCRIPT ERROR\|Parse Error' "$OUT/${m/:/_}_$s.raw"; then echo "✗ $m 第 $s 片有腳本錯誤" >&2; grep -m3 'SCRIPT ERROR' "$OUT/${m/:/_}_$s.raw" >&2; fail=1; fi
    rm -f "$OUT/${m/:/_}_$s.raw"
  done
  echo "· $m 完成（累計 $(( $(date +%s) - t0 )) 秒）"
done
printf '{"modes": [%s], "shards": %d, "ntypes": %d, "commit": "%s"}\n' "$(printf '"%s",' "$@" | sed 's/,$//')" "$SHARDS" "$NT" "$(git rev-parse --short HEAD)$(git diff --quiet || echo '+dirty')" > "$OUT/manifest.json"
[ $fail -ne 0 ] && { echo "✗ 有分片失敗" >&2; exit 2; }
python3 tools/unit_eval_report.py "$OUT" ${BAND:+"$BAND"}
