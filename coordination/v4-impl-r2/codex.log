   200	            md.append(f"\n## 混編驗收：{NAMES[u]} 對盾兵為主的對手（{len(per)} 套）\n\n換成等價劍士 Δ {mm*100:+.1f}（95% 區間 {lo*100:+.1f}～{hi*100:+.1f}）{'✓' if okk else '✗'}；"
   201	                      f"換成陣中最多的舊兵 Δ {d['a'][0]*100:+.1f}、換成弓箭手 Δ {d['c'][0]*100:+.1f}\n")
   202	        elif mode == "cover":
   203	            u = int(m.split(":")[1])
   204	            keys = {(r["i"], r["kk"], r["k"]) for r in got}
   205	            if len(keys) != len(got) or len(got) != 120 * 5 * 4:
   206	                print(f"✗ {m} 筆數 {len(got)} 不對"); sys.exit(2)
   207	            per = {}
   208	            for r in got:
   209	                per.setdefault(r["i"], {}).setdefault(r["kk"], []).append((r["s0"] + r["s1"]) / 2)
   210	            md.append(f"\n## 支援兵覆蓋曲線：{NAMES[u]}（120 套沒有支援兵的陣型，從後排換成 k 隻）\n\n| k | Δ（百分點） | 95% 區間 |\n|---|---|---|\n")
   211	            dk = [0.0]
   212	            for kk in range(1, 5):
   213	                ds = [sum(v[kk]) / len(v[kk]) - sum(v[0]) / len(v[0]) for v in per.values()]
   214	                mm, lo, hi = mean_ci(ds)
   215	                dk.append(mm)
   216	                md.append(f"| {kk} | {mm*100:+.1f} | {lo*100:+.1f}～{hi*100:+.1f} |\n")
   217	            dim = all((dk[k + 1] - dk[k]) <= (dk[k] - dk[k - 1]) + 0.03 for k in range(1, 4))
   218	            if not dim:
   219	                fails.append(f"{NAMES[u]} 收益沒有遞減：{[round(x*100,1) for x in dk]}")
   220	            if dk[4] > 0.15:
