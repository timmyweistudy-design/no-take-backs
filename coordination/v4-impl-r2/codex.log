    18	def mean_ci(xs):
    19	    n = len(xs)
    20	    if n == 0:
    21	        return 0, 0, 0
    22	    m = sum(xs) / n
    23	    if n < 2:
    24	        return m, m, m
    25	    sd = math.sqrt(sum((x - m) ** 2 for x in xs) / (n - 1))
    26	    h = 1.96 * sd / math.sqrt(n)
    27	    return m, m - h, m + h
    28	
    29	def p(x):
    30	    return f"{x * 100:+.1f}" if x < 0 or x > 0 else "0.0"
    31	
    32	def twoway_ci(cells):
    33	    """雙向群集（陣型 × 對手）的平均與 95% 區間（Cameron–Gelbach–Miller）：cells＝[(陣型, 對手, 值)]。Codex 實作審查 #9。"""
    34	    n = len(cells)
    35	    if n == 0:
    36	        return 0, 0, 0
    37	    m = sum(c[2] for c in cells) / n
    38	    def v_by(key):
    39	        g = {}
    40	        for c in cells:
    41	            g[key(c)] = g.get(key(c), 0.0) + (c[2] - m)
    42	        return sum(x * x for x in g.values()) / (n * n)
    43	    var = v_by(lambda c: c[0]) + v_by(lambda c: c[1]) - v_by(lambda c: (c[0], c[1]))
    44	    h = 1.96 * math.sqrt(max(var, 0.0))
    45	    return m, m - h, m + h
    46	
    47	def repl_deltas(got):
    48	    data = [r for r in got if "skip" not in r]
    49	    per = {}
    50	    cell = {}
    51	    for r in data:
    52	        sc = (r["s0"] + r["s1"]) / 2
    53	        per.setdefault(r["i"], {}).setdefault(r["pol"], []).append(sc)
    54	        cell.setdefault((r["i"], r.get("opp", r["k"]), r["k"]), {})[r["pol"]] = sc
    55	    out = {}
    56	    for pol in ["a", "b", "c"]:
    57	        out[pol] = twoway_ci([(k[0], k[1], v["orig"] - v[pol]) for k, v in cell.items() if "orig" in v and pol in v])
    58	    return out, per
    59	
    60	LEGAL = (0.0, 0.5, 1.0)
    61	
    62	def check_rows(m, mode, got, man):
    63	    """逐模式驗完整鍵集合、兵種、分數、開放數、池身分（Codex 實作審查 #6、#7）。有問題直接 exit 2。"""
    64	    unit = int(m.split(":")[1]) if ":" in m else None
    65	    bad = []
    66	    for r in got:
    67	        if "skip" in r:
    68	            continue
    69	        if r.get("s0") not in LEGAL or r.get("s1") not in LEGAL:
    70	            bad.append(f"分數不合法 {r}")
    71	        if unit is not None and r.get("unit") != unit:
    72	            bad.append(f"兵種不符 {r.get('unit')}")
    73	        if mode != "core" and r.get("nt") != man["ntypes"]:
    74	            bad.append(f"開放數 {r.get('nt')} ≠ {man['ntypes']}")
    75	    pools = {r.get("pool") for r in got if "skip" not in r}
    76	    if mode != "core" and (len(pools) != 1 or None in pools):
    77	        bad.append(f"對手池不只一個或缺少：{pools}")
    78	    keys = [tuple(r.get(k) for k in ("i", "k", "pol", "kk", "r", "seed")) for r in got]
    79	    if len(set(keys)) != len(keys):
    80	        bad.append("有重複的列")
    81	    if mode in ("repl", "replshield"):
    82	        skips = {r["i"] for r in got if "skip" in r}
    83	        if len(skips) > 10:
    84	            bad.append(f"跳過的陣型太多（{len(skips)}）")
    85	        want = {(i, k, pol) for i in range(200) if i not in skips for k in range(6) for pol in ("orig", "a", "b", "c")}
    86	        have = {(r["i"], r["k"], r["pol"]) for r in got if "skip" not in r}
    87	        if have != want:
    88	            bad.append(f"鍵集合不對（少 {len(want - have)}、多 {len(have - want)}）")
    89	    elif mode == "cover":
    90	        want = {(i, kk, k) for i in range(120) for kk in range(5) for k in range(4)}
    91	        have = {(r["i"], r["kk"], r["k"]) for r in got}
    92	        if have != want:
    93	            bad.append(f"鍵集合不對（少 {len(want - have)}、多 {len(have - want)}）")
    94	        wrong = [r for r in got if r.get("have") != r.get("kk")]
    95	        if wrong:
    96	            bad.append(f"有 {len(wrong)} 列實際支援兵數 ≠ 要求（例：i={wrong[0]['i']} kk={wrong[0]['kk']} have={wrong[0]['have']}）")
    97	    elif mode == "core":
    98	        want = {(ri, sd) for ri in range(len(CORE)) for sd in range(40)}
    99	        if {(r["r"], r["seed"]) for r in got} != want:
   100	            bad.append("core 鍵集合不對")
   101	    if bad:
   102	        print(f"✗ {m} 資料錯誤：" + "；".join(bad[:5])); sys.exit(2)
