   189	                        fails.append(f"{NAMES[u]} 替換實驗（{label}）Δ {mm*100:+.1f}（上界 {hi*100:+.1f}）")
   190	                    md.append(f"| {label} | {mm*100:+.1f} | {lo*100:+.1f}～{hi*100:+.1f} | {'✓' if okk else '✗'} |\n")
   191	            md.append(f"\n原陣型平均得分 {orig_wr*100:.0f}%\n")
   192	        elif mode == "replshield":
