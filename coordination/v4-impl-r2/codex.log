    45	var pool_id := ""
    46	
    47	## 對手池的身分：池內全部陣型代碼的 SHA-256 前 12 碼（每列都帶，報表核對同一模式只有一個池；Codex 實作審查 #7）
    48	static func pool_hash(opps: Array) -> String:
    49		var parts := PackedStringArray()
    50		for a in opps:
    51			parts.append(a.to_code())
    52		return ",".join(parts).sha256_text().substr(0, 12)
    53	
    54	func emit(d: Dictionary) -> void:
    55		d["digest"] = D.data_digest()
    56		d["rules"] = D.RULES_VERSION
    57		if pool_id != "":
    58			d["pool"] = pool_id
    59		print("R ", JSON.stringify(d))
    60	
    61	## a 是藍方表示的陣型（team 0）、b 也是；交換左右各打一場。回傳 a 的得分列表 [第一場, 第二場]（1／0.5／0）。
    62	static func duel2(a: Army, b: Army) -> Array:
    63		var s1 = Sim.new(a.copy(), b.mirrored())
    64		s1.fast = true
    65		s1.run_to_end()
    66		var s2 = Sim.new(b.copy(), a.mirrored())
    67		s2.fast = true
    68		s2.run_to_end()
    69		return [1.0 if s1.winner == 0 else (0.5 if s1.winner < 0 else 0.0), 1.0 if s2.winner == 1 else (0.5 if s2.winner < 0 else 0.0)]
    70	
    71	func core(shard: int, shards: int) -> void:
    72		var idx := 0
    73		for ri in CORE.size():
    74			for sd in CORE_SEEDS:
    75				idx += 1
    76				if idx % shards != shard:
    77					continue
    78				var rng := RandomNumberGenerator.new()
    79				rng.seed = 90001 + ri * 1013 + sd * 7919
    80				var wx := D.zeros()
    81				wx[CORE[ri][0]] = 3
    82				wx[D.SWORD] += 1
    83				wx[D.ARCHER] += 1
    84				var wy := D.zeros()
    85				wy[CORE[ri][1]] = 3
    86				wy[D.SWORD] += 1
    87				wy[D.ARCHER] += 1
    88				var style: String = F.STYLES[sd % F.STYLES.size()]
    89				var ax := F.weighted_formation(0, rng, wx, style)
    90				var ay := F.weighted_formation(0, rng, wy, style)
    91				var sc := duel2(ax, ay)
    92				emit({"mode": "core", "r": ri, "seed": sd, "s0": sc[0], "s1": sc[1]})
    93	
    94	## 含 X 的陣型：從 ntypes 範圍的混編裡產生，X 的權重至少 2；第 i 套固定種子。
    95	static func with_unit(x: int, nt: int, i: int) -> Army:
    96		var rng := RandomNumberGenerator.new()
    97		rng.seed = 424242 + x * 100003 + i * 7919
    98		for tries in 50:
    99			var w := D.zeros()
   100			for t in nt:
   101				w[t] = rng.randi_range(0, 3)
   102			w[x] = maxi(2, w[x])
   103			if D.is_support(x):
   104				# 支援兵（醫者、鼓手）不疊加、AI 一種最多帶 2 隻：只取帶 1～2 隻的陣型（第四輪驗收時修正，見報告）
   105				w[x] = 1
   106			var a := F.weighted_formation(0, rng, w)
   107			if a.count_of(x) > 0 and (not D.is_support(x) or a.count_of(x) <= 2):
   108				return a
   109		return null
   110	
   111	## 整批拿掉 X，空出的錢與格子用 fill 兵種補回：先補原本 X 的格子（前排→後排、中間→兩邊），再補其他空格；錢不夠就留著。
   112	static func refill(a: Army, x: int, fill: int) -> Army:
   113		var b := Army.new(0, 100)
   114		var holes: Array = []
   115		for u in a.units:
   116			if u["type"] == x:
   117				holes.append(Vector2i(u["col"], u["row"]))
   118			else:
   119				b.units.append(u.duplicate())
   120		holes.sort_custom(func(p, q): return p.x > q.x or (p.x == q.x and absi(p.y - 4) < absi(q.y - 4)) or (p.x == q.x and absi(p.y - 4) == absi(q.y - 4) and p.y < q.y))
   121		for h in holes:
   122			b.place(fill, h.x, h.y)
   123		for c in [5, 4, 3, 2, 1, 0]:
   124			for r in [4, 3, 5, 2, 6, 1, 7, 0, 8]:
   125				if b.left() < D.cost(fill):
   126					return b
   127				b.place(fill, c, r)
   128		return b
   129	
   130	## 補法 a：這套陣型裡（拿掉 X 後）金額最多的舊兵種；同額取編號小的；沒有就劍士。
   131	static func most_common_other(a: Army, x: int) -> int:
   132		var comp := F.composition(a)
   133		var best := -1
   134		for t in D.CLASSIC:
   135			if t != x and comp[t] > 0 and (best == -1 or comp[t] > comp[best]):
   136				best = t
   137		return best if best >= 0 else D.SWORD
   138	
   139	## 盾兵為主的對手池（狂戰士的混編驗收用，§2.4）：盾兵權重 4，其他經典兵種 0～2。
   140	static func shield_pool(n: int) -> Array:
   141		var out: Array = []
   142		var rng := RandomNumberGenerator.new()
   143		for i in n:
   144			rng.seed = 616161 + i * 7919
   145			var w := D.zeros()
   146			for t in D.CLASSIC:
   147				w[t] = rng.randi_range(0, 2)
   148			w[D.SHIELD] = 4
   149			out.append(F.weighted_formation(0, rng, w))
   150		return out
   151	
   152	func repl(x: int, nt: int, shard: int, shards: int, vs_shield := false) -> void:
   153		var opps := shield_pool(200) if vs_shield else F.validation_pool(0, nt)
   154		pool_id = pool_hash(opps)
   155		var mname := "replshield" if vs_shield else "repl"
   156		var idx := 0
   157		for i in REPL_N:
   158			idx += 1
   159			if idx % shards != shard:
   160				continue
   161			var orig := with_unit(x, nt, i)
   162			if orig == null:
   163				emit({"mode": mname, "unit": x, "i": i, "skip": "no_unit", "nt": nt})
   164				continue
   165			var variants := {"orig": orig, "a": refill(orig, x, most_common_other(orig, x)), "b": refill(orig, x, D.SWORD), "c": refill(orig, x, D.ARCHER)}
   166			for k in REPL_OPPS:
   167				var opp: Army = opps[(i * 7 + k * 31) % opps.size()]
   168				for pol in ["orig", "a", "b", "c"]:
   169					var sc := duel2(variants[pol], opp)
   170					emit({"mode": mname, "unit": x, "i": i, "k": k, "opp": (i * 7 + k * 31) % opps.size(), "pol": pol, "s0": sc[0], "s1": sc[1],
   171						"left": variants[pol].left(), "n": variants[pol].count(), "nt": nt, "code": variants[pol].to_code() if k == 0 else ""})
   172	
   173	## 從後排（離自己底線近）、兩邊往中間拿掉戰鬥兵，直到空出 need 金；再把 k 隻支援兵照角色欄位擺上。
   174	static func with_supports(base: Army, sup: int, k: int) -> Army:
   175		var b: Army = base.copy()
   176		var need := k * D.cost(sup)
   177		var order := b.units.duplicate()
   178		order.sort_custom(func(p, q): return p["col"] < q["col"] or (p["col"] == q["col"] and absi(p["row"] - 4) > absi(q["row"] - 4)) or (p["col"] == q["col"] and absi(p["row"] - 4) == absi(q["row"] - 4) and p["row"] < q["row"]))
   179		for u in order:
   180			if b.left() >= need:
   181				break
   182			b.remove_at(u["col"], u["row"])
   183		var rng := RandomNumberGenerator.new()
   184		rng.seed = 1
   185		for j in k:
   186			F.place_styled(b, sup, "role", rng)
   187		return b
   188	
   189	func cover(sup: int, nt: int, shard: int, shards: int) -> void:
   190		var opps := F.validation_pool(0, nt)
   191		pool_id = pool_hash(opps)
   192		var idx := 0
   193		for i in COVER_N:
   194			idx += 1
   195			if idx % shards != shard:
   196				continue
   197			var rng := RandomNumberGenerator.new()
   198			rng.seed = 515151 + sup * 100003 + i * 7919
   199			var w := D.zeros()
   200			for t in nt:
   201				if not D.is_support(t):
   202					w[t] = rng.randi_range(0, 3)
   203			if w.max() == 0:
   204				w[D.SWORD] = 1
   205			var base := F.weighted_formation(0, rng, w)
   206			for kk in 5:
   207				var v := with_supports(base, sup, kk)
   208				for k in COVER_OPPS:
   209					var opp: Army = opps[(i * 11 + k * 37) % opps.size()]
   210					var sc := duel2(v, opp)
   211					emit({"mode": "cover", "unit": sup, "i": i, "kk": kk, "k": k, "opp": (i * 11 + k * 37) % opps.size(), "s0": sc[0], "s1": sc[1], "have": v.count_of(sup), "nt": nt})
     1	extends SceneTree
     2	## 舊兵種相容檢查（第四輪方案 §3.1～3.2）。
     3	## 目的：加新兵種之後，「只用舊 5 種兵」的對戰行為必須一模一樣。
     4	## 最終指紋包含規則版本和數值摘要，加兵後一定會變，所以這裡不比指紋，改比：
     5	##   ・逐 tick 累積摘要：每 tick 把每隻兵的「舊欄位」（第三輪就有的 28 個狀態）寫進同一個 SHA-256
     6	##   ・勝方、結束 tick、每隻兵的擊殺數、造成／承受傷害
     7	## 基準檔 tests/golden/compat_v1.2.json 是在 N0a（規則 1.2.0、還沒加兵）時用同一套程式產生的，
     8	## 之後不重產；陣型代碼存在檔案裡，不重新呼叫 AI 造陣（AI 之後會改）。
     9	## 用法：godot --headless --path game --script res://tools/compat.gd -- [--make] [--n=1000]
    10	const Sim = preload("res://scripts/core/battle_sim.gd")
    11	const Army = preload("res://scripts/core/army.gd")
    12	const D = preload("res://scripts/core/unit_defs.gd")
    13	const PATH := "res://tests/golden/compat_v1.2.json"
    14	const GOLDEN := "res://tests/golden/golden.json"
    15	
    16	## 舊欄位（第三輪 _hash_state 的 28 個欄位）。新兵種加的狀態不放這裡，另外檢查它們在舊場次一直是初值。
    17	static func old_fields(u) -> PackedInt64Array:
    18		return PackedInt64Array([u.x, u.y, u.hp, u.cd, u.target, u.fx, u.fy, u.face_lock, u.mx, u.my, u.cdx, u.cdy, u.stealth, u.charge, u.stun,
    19			u.slow, u.wp_x, u.wp_y, u.wp_for, 1 if u.alive else 0, u.dmg_dealt, u.dmg_taken, u.kills, u.id, u.team, u.type, u.nav, 1 if u.chasing else 0])
    20	
    21	## 新狀態在舊場次必須一直是初值（加了新欄位就在這裡登記初值）。回傳空字串＝正常。
    22	static func new_fields_untouched(s) -> String:
    23		for u in s.units:
    24			for k in NEW_FIELDS:
    25				if k in u and u.get(k) != NEW_FIELDS[k]:
    26					return "id %d 的 %s=%s（應為 %s）" % [u.id, k, u.get(k), NEW_FIELDS[k]]
    27		return ""
    28	
    29	## 第四輪新增的單位狀態與它們的初值（舊 5 種兵永遠不會用到）
    30	const NEW_FIELDS := {"hcd": 0, "aura": 0, "breach": 0, "bmode": 0, "heal_done": 0, "follow": -1, "drum_cover": 0}
    31	
    32	static func run_case(c0: String, c1: String) -> Dictionary:
    33		var a0 := Army.new(0, 100)
    34		var a1 := Army.new(1, 100)
    35		a0.load_code(c0)
    36		a1.load_code(c1)
    37		var s = Sim.new(a0, a1)
    38		s.fast = true
    39		var h := HashingContext.new()
    40		h.start(HashingContext.HASH_SHA256)
    41		var untouched := ""
    42		while not s.finished:
    43			s.step()
    44			var buf := PackedInt64Array([s.tick])
    45			for u in s.units:
    46				buf.append_array(old_fields(u))
    47			h.update(buf.to_byte_array())
    48			if untouched == "":
    49				untouched = new_fields_untouched(s)
    50		var per := PackedStringArray()
    51		for u in s.units:
    52			per.append("%d:%d:%d:%d" % [u.id, u.kills, u.dmg_dealt, u.dmg_taken])
    53		return {"w": s.winner, "t": s.tick, "roll": h.finish().hex_encode().substr(0, 24), "per": ";".join(per), "untouched": untouched}
    54	
    55	func _init() -> void:
    56		var args := OS.get_cmdline_user_args()
    57		var n := 1000
    58		for a in args:
    59			if a.begins_with("--n="):
    60				n = int(a.substr(4))
    61		if "--make" in args:
    62			_make()
    63			return
    64		var res := check(n)
    65		print("COMPAT %s" % JSON.stringify(res))
    66		quit(0 if res["ok"] else 1)
    67	
    68	func _make() -> void:
    69		if D.RULES_VERSION != "1.2.0":
    70			push_error("相容基準只能在規則 1.2.0（還沒加新兵）時產生")
    71			quit(1)
    72			return
    73		var g = JSON.parse_string(FileAccess.get_file_as_string(GOLDEN))
    74		var cases: Array = []
    75		for c in g["cases"]:
    76			var r := run_case(c["a"], c["b"])
    77			cases.append({"a": c["a"], "b": c["b"], "w": r["w"], "t": r["t"], "roll": r["roll"], "per": r["per"]})
    78		var f := FileAccess.open(PATH, FileAccess.WRITE)
    79		f.store_string(JSON.stringify({"from_rules": D.RULES_VERSION, "from_digest": D.data_digest(), "cases": cases}))
    80		f.close()
    81		print("COMPAT 已產生 %d 場基準（規則 %s）" % [cases.size(), D.RULES_VERSION])
    82		quit(0)
    83	
    84	## 比對前 n 場；回傳 {ok, n, first_case, why}
    85	static func check(n: int) -> Dictionary:
    86		var g = JSON.parse_string(FileAccess.get_file_as_string(PATH))
    87		if not g is Dictionary:
    88			return {"ok": false, "why": "讀不到相容基準檔"}
    89		var cases: Array = g["cases"]
    90		# 基準必須是完整的 1000 場、而且至少要比 1 場（Codex 實作審查 #10：空的或縮水的基準不能回報成功）
    91		if cases.size() != 1000 or str(g.get("from_rules", "")) != "1.2.0":
    92			return {"ok": false, "why": "相容基準不完整或來源規則不是 1.2.0（%d 場）" % cases.size()}
    93		if n < 1 or n > cases.size():
    94			return {"ok": false, "why": "要比的場數 %d 不合法" % n}
    95		for i in n:
    96			var c: Dictionary = cases[i]
    97			var r := run_case(c["a"], c["b"])
    98			if r["untouched"] != "":
    99				return {"ok": false, "n": i + 1, "first_case": i, "why": "新狀態在舊場次被動到：" + r["untouched"]}
   100			if int(r["w"]) != int(c["w"]) or int(r["t"]) != int(c["t"]):
   101				return {"ok": false, "n": i + 1, "first_case": i, "why": "勝負或結束 tick 不同"}
   102			if r["per"] != str(c["per"]):
   103				return {"ok": false, "n": i + 1, "first_case": i, "why": "擊殺或傷害統計不同"}
   104			if r["roll"] != c["roll"]:
   105				return {"ok": false, "n": i + 1, "first_case": i, "why": "逐 tick 狀態分歧"}
   106		return {"ok": true, "n": n}

