@@ -444,6 +453,66 @@ func _board_ring(inner: Rect2) -> bool:
 
 const MAT_OAK := "res://art/mat/tile_oak.png"
 
+## ── 1.3.0 §1 桌邊視角（路線 B：2D 假立體；路線 A 切片的結論見 coordination/v130-impl/cat02-plan.md）──
+## 鏡頭是正交、偏離俯視 20°：地面座標和 1.2.0 完全一樣（點格、版面、截圖座標都不變），只多出朝南的立面、厚度與燈影。
+## 設定「戰場視角」：桌邊（預設）／正上方（＝1.2.0 畫法）；簡化介面一律正上方。
+const BOARD_EDGE_H := 10.0   # 棋盤南側端面露出的高度（板厚 × sin20°）
+const RELIEF_H := 12.0       # 凸起牆格的頂面上移量（牆高 × sin20°；不超過半格 16px，北側格的腳點不會被蓋到）
+const RELIEF := {"ice": 1, "canyon": 1, "forest": 1, "river": -1, "lava": -1}   # 1＝凸起積木、-1＝凹槽（水、岩漿）
+
+func tilt_on() -> bool:
+	return bool(Save.s("table_view")) and not bool(Save.s("plain_ui"))
+
+## 牆格高度（只改畫面；牆格判讀色不變）：凸起＝右側落影（燈在左上）→ 頂面整格上移 RELIEF_H（從地塊貼圖取同一塊）→ 南側立面（較暗、上緣亮線）；
+## 凹槽＝北緣與西緣內陰影、南緣一道亮邊（水面低於地面）。由北往南畫，相鄰牆格接得起來。
+func _draw_relief(mt: Texture2D) -> void:
+	if not tilt_on() or fld_map == 0 or MapDefs.MAPS.size() <= fld_map:
+		return
+	var t = MapDefs.terrain(fld_map, fld_sz)
+	if t == null or not t.has_block:
+		return
+	var biome := str(MapDefs.MAPS[fld_map]["biome"])
+	var kind := int(RELIEF.get(biome, 0))
+	if kind == 0:
+		return
+	var cw: float = fld_size.x / float(t.n)
+	var ch: float = fld_size.y / float(t.m)
+	var blk := Color(MapArt.BIOME[biome]["block"])
+	var isb := func(c: int, r: int) -> bool: return c >= 0 and r >= 0 and c < t.n and r < t.m and t.grid[c + r * t.n] == t.BLOCK
+	if kind < 0:
+		for r in t.m:
+			for c in t.n:
+				if not isb.call(c, r):
+					continue
+				var R := Rect2(ORIGIN + Vector2(c * cw, r * ch), Vector2(cw, ch))
+				if not isb.call(c, r - 1):
+					for k in 3:
+						draw_rect(Rect2(R.position + Vector2(0, k * 2.0), Vector2(cw, 2.0)), Color(0.04, 0.03, 0.02, 0.26 - k * 0.08))
+				if not isb.call(c - 1, r):
+					draw_rect(Rect2(R.position, Vector2(3.0, ch)), Color(0.04, 0.03, 0.02, 0.16))
+				if not isb.call(c, r + 1):
+					draw_line(Vector2(R.position.x, R.end.y - 0.5), Vector2(R.end.x, R.end.y - 0.5), Color(1, 0.95, 0.85, 0.28), 1.0)
+		return
+	for r in t.m:
+		for c in t.n:
+			if isb.call(c, r) and not isb.call(c + 1, r):
+				var R2 := Rect2(ORIGIN + Vector2(c * cw, r * ch), Vector2(cw, ch))
+				draw_rect(Rect2(Vector2(R2.end.x, R2.position.y - RELIEF_H + 5.0), Vector2(6.0, ch)), Color(0.06, 0.04, 0.02, 0.24))   # 右側落影
+	for r in t.m:
+		for c in t.n:
+			if not isb.call(c, r):
+				continue
+			var R := Rect2(ORIGIN + Vector2(c * cw, r * ch), Vector2(cw, ch))
+			var top := Rect2(R.position - Vector2(0, RELIEF_H), R.size)
+			draw_texture_rect_region(mt, top, Rect2(R.position - ORIGIN, R.size))
+			if not isb.call(c, r - 1):
+				draw_line(top.position, Vector2(top.end.x, top.position.y), Color(1, 0.95, 0.85, 0.35), 1.0)   # 頂面北緣受光
+			if not isb.call(c, r + 1):
+				var fr := Rect2(Vector2(R.position.x, R.end.y - RELIEF_H), Vector2(cw, RELIEF_H))
+				draw_rect(fr, blk.darkened(0.45))
+				draw_line(fr.position, Vector2(fr.end.x, fr.position.y), Color(0, 0, 0, 0.35), 1.0)
+				draw_line(Vector2(fr.position.x, fr.end.y - 0.5), Vector2(fr.end.x, fr.end.y - 0.5), Color(0.05, 0.03, 0.02, 0.5), 1.0)
+
