+## 1.3.0 第 5 大類：依移動方向選視角（往南＝3/4 正面、往北＝3/4 背面、東西＝側面；不走路一律側面；跳轉清掉）
+func test_heading_view_v130() -> void:
+	var g = load("res://scripts/ui/game_screens.gd").new()
+	var p := Vector2(100, 100)
+	var hs := 0
+	for i in 20:
+		p += Vector2(0.2, 2.0)
+		hs = g.heading_of(1, p, true)
+	ok(hs == 1, "往南走＝3/4 正面")
+	var pn := Vector2(300, 300)
+	var hn := 0
+	for i in 20:
+		pn += Vector2(-0.3, -2.0)
+		hn = g.heading_of(2, pn, true)
+	ok(hn == -1, "往北走＝3/4 背面")
+	var pe := Vector2(0, 0)
+	var he := 9
+	for i in 20:
+		pe += Vector2(2.0, 0.8)
+		he = g.heading_of(3, pe, true)
+	ok(he == 0, "斜向但東西為主＝側面")
+	ok(g.heading_of(1, p + Vector2(0, 2), false) == 0, "不走路（出手、待機）一律側面")
+	g._gait_reset()
+	ok(g.hd_prev.is_empty() and g.hd_v.is_empty(), "跳轉／新的一場清掉走向記錄")
+	var SC = load("res://scripts/ui/sprite_cache.gd")
+	ok(SC.BW_C == 0.55 and g.HEAD_FRONT_C == 0.55, "南北都用 3/4 角度（和既有走路轉身頁同角度）")
+	g.free()
