+var hd_prev := {}
+var hd_v := {}
+func heading_of(id: int, p: Vector2, walking: bool) -> int:
+	var v: Vector2 = hd_v.get(id, Vector2.ZERO)
+	if hd_prev.has(id):
+		v = v * 0.8 + (p - (hd_prev[id] as Vector2)) * 0.2
+	hd_prev[id] = p
+	hd_v[id] = v
+	if not walking:
+		return 0
+	if absf(v.y) > absf(v.x) * 1.3 and absf(v.y) > 0.25:
+		return 1 if v.y > 0.0 else -1
+	return 0
+
