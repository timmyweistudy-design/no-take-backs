+## 1.3.0 §2：最後一擊壓得更低（約 400Hz），最後時刻照舊 900Hz。
+func set_muffled(on: bool, hz := 900.0) -> void:
+	if _lowpass_idx < 0:
+		return
+	var lp := AudioServer.get_bus_effect(0, _lowpass_idx) as AudioEffectLowPassFilter
