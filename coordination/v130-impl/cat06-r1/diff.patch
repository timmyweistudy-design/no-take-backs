+# ── 1.3.0 第 6 大類：戰場導演與觀戰（方案 §2）──
+const DirR = preload("res://scripts/game/director_rules.gd")
+var dir_manual := false     # 玩家動過鏡頭（滾輪、拖曳、雙擊、點兵、右搖桿、扳機）＝這一場交還手動
