     1	extends RefCounted
     2	## 對戰代碼（第三輪 F3）：把雙方陣型、規則版本、數值摘要編成一串，貼給朋友就能看同一場。
     3	## 格式：NTB2.<base64url(JSON)>.<校驗 6 碼>。JSON：{a/b: 雙方陣型代碼, ba/bb: 雙方預算, r: 規則版本, d: 數值摘要}
     4	## 規則或數值不同時仍可以播，但結果可能不同，所以解碼會回報 mismatch 讓畫面提示。
     5	
     6	const Army = preload("res://scripts/core/army.gd")
     7	const D = preload("res://scripts/core/unit_defs.gd")
     8	const RSET = preload("res://scripts/core/ruleset.gd")
     9	## 第五輪：自訂規則的對戰代碼用 NTB3（多一欄 rules＝規則代碼）。標準規則仍輸出 NTB2，位元組和 1.3.0 相同。
    10	
    11	## 這組規則能不能用舊格式 NTB2 重播（模擬走舊路徑、陣型在舊的人數上限內）。
    12	static func needs_v3(rules) -> bool:
    13		# Codex 實作第 1 輪：卡池、人數、單種上限有任何不標準就用 NTB3，分享後規則不會遺失
    14		return rules != null and (not rules.sim_is_legacy() or not load("res://scripts/game/presets.gd").deploy_standard(rules))
    15	
    16	static func encode(a0, a1, rules = null, cmds: Array = []) -> String:
    17		if rules != null and rules.cmd_on():
    18			# 第十二輪 NTB7：手動技能要連施放紀錄一起存，才播得出同一場
    19			var j7 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.version_of([a0, a1]), "d": D.digest_of([a0, a1]), "rules": rules.to_code(), "c": cmds})
    20			var body7 := Marshalls.utf8_to_base64(j7).replace("+", "-").replace("/", "_").replace("=", "")
    21			return "NTB7.%s.%s" % [body7, body7.sha256_text().substr(0, 6)]
    22		if D.uses_new([a0, a1]):
    23			# 第八輪：用到新兵走 NTB4（新版 NTB2／3／4 都讀；舊版讀到會回報格式不對）
    24			var j4 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.version_of([a0, a1]), "d": D.digest_of([a0, a1]), "rules": rules.to_code() if rules != null else ""})
    25			var body4 := Marshalls.utf8_to_base64(j4).replace("+", "-").replace("/", "_").replace("=", "")
    26			return "NTB4.%s.%s" % [body4, body4.sha256_text().substr(0, 6)]
    27		if needs_v3(rules):
    28			var j3 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest(), "rules": rules.to_code()})
    29			var body3 := Marshalls.utf8_to_base64(j3).replace("+", "-").replace("/", "_").replace("=", "")
    30			return "NTB3.%s.%s" % [body3, body3.sha256_text().substr(0, 6)]
    31		var j := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest()})
    32		var body := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
    33		return "NTB2.%s.%s" % [body, body.sha256_text().substr(0, 6)]
    34	
    35	## 回傳 {ok, why, a0, a1, mismatch, rules}（NTB2 的 rules＝null＝用 1.3.0 舊判定重播）
    36	static func decode(code: String) -> Dictionary:
    37		var c := code.strip_edges()
    38		if c.length() > 8000:
    39			return {"ok": false, "why": "format"}
    40		var parts := c.split(".")
    41		if parts.size() != 3 or (parts[0] != "NTB2" and parts[0] != "NTB3" and parts[0] != "NTB4" and parts[0] != "NTB7"):
    42			return {"ok": false, "why": "format"}
    43		if parts[1].sha256_text().substr(0, 6) != parts[2]:
    44			return {"ok": false, "why": "checksum"}
    45		var b64 := parts[1].replace("-", "+").replace("_", "/")
    46		while b64.length() % 4 != 0:
    47			b64 += "="
    48		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
    49		if not j is Dictionary or not j.has("a") or not j.has("b"):
    50			return {"ok": false, "why": "body"}
    51		# 預算也編進去（Codex S5 #1：遠征敵軍超過 100 金、殘局低預算時，原本會被當成 100）
    52		# 第七輪 N2：外部資料先驗型，int([]) 會讓整個解碼中斷，不會回報「代碼錯誤」
    53		for bk in ["ba", "bb"]:
    54			var bv = j.get(bk, 100)
    55			if not (bv is int or bv is float) or float(bv) != floorf(float(bv)) or absf(float(bv)) > 1000:
    56				return {"ok": false, "why": "budget"}
    57		if not j["a"] is String or not j["b"] is String or not j.get("rules", "") is String:
    58			return {"ok": false, "why": "body"}
    59		var ba := int(j.get("ba", 100))
    60		var bb := int(j.get("bb", 100))
    61		if ba < 1 or ba > 400 or bb < 1 or bb > 400:
    62			return {"ok": false, "why": "budget"}
    63		var a0 := Army.new(0, ba)
    64		var a1 := Army.new(1, bb)
    65		var rules = null
    66		var cmds: Array = []
    67		if parts[0] == "NTB7":
    68			var raw_c = j.get("c", [])
    69			if not raw_c is Array or raw_c.size() > 200 or str(j.get("rules", "")) == "":
    70				return {"ok": false, "why": "body"}
    71			for e in raw_c:
    72				if not e is Array or e.size() != 3:
    73					return {"ok": false, "why": "body"}
    74				for v0 in e:
    75					if not (v0 is int or v0 is float) or float(v0) != floorf(float(v0)) or float(v0) < 0 or float(v0) > 100000:
    76						return {"ok": false, "why": "body"}
    77				if int(e[1]) > 1 or int(e[2]) >= 5:
    78					return {"ok": false, "why": "body"}
    79				cmds.append([int(e[0]), int(e[1]), int(e[2])])
    80		if parts[0] == "NTB4" or parts[0] == "NTB7":
    81			a0.pool = RSET.full_pool()
    82			a1.pool = RSET.full_pool()
    83		if parts[0] == "NTB3" or parts[0] == "NTB7" or (parts[0] == "NTB4" and str(j.get("rules", "")) != ""):
    84			var rd: Dictionary = RSET.from_code(str(j.get("rules", "")))
    85			if not rd["ok"]:
    86				return {"ok": false, "why": "rules"}
    87			rules = rd["rules"]
    88			if rules.budget_of(0) != ba or rules.budget_of(1) != bb:
    89				return {"ok": false, "why": "budget"}
    90			for pair in [[a0, 0], [a1, 1]]:
    91				pair[0].apply_rules(rules, pair[1])
    92		if a0.load_code(str(j["a"])) != "" or a1.load_code(str(j["b"])) != "":
    93			return {"ok": false, "why": "army"}
    94		var full_duel: bool = rules != null and rules.is_free() and rules.fullfield == RSET.FULL_DUEL
    95		if rules != null and not full_duel and (not a0.has_combat() or not a1.has_combat()):
    96			return {"ok": false, "why": "army"}   # NTB3（第五輪新格式）：雙方各至少 1 隻戰鬥兵；舊 NTB2 不加這條（相容）
    97		if rules != null and rules.is_free() and rules.fullfield != RSET.FULL_NONE:
    98			# 第六輪（Codex 實作第 1 輪 #3）：全場的跨隊條件——兩軍任兩隻至少隔 ENEMY_GAP；明牌全場的 AI（紅）只在自己半場
    99			var g2: int = RSET.ENEMY_GAP * RSET.ENEMY_GAP
   100			for u in a0.units:
   101				var p := Army.pos_of(u)
   102				for v in a1.units:
   103					var q := Army.pos_of(v)
   104					if (p.x - q.x) * (p.x - q.x) + (p.y - q.y) * (p.y - q.y) < g2:
   105						return {"ok": false, "why": "army"}
   106			if rules.fullfield == RSET.FULL_AI:
   107				for v in a1.units:
   108					if a1.own_x(Army.pos_of(v).x) > rules.half_depth():
   109						return {"ok": false, "why": "army"}
   110		# 輪流落子的指令紀錄（cmds）目前不支援：代碼只證明「最後陣型合法」，不證明輪序（Codex 實作第 1 輪 #10，見方案 §11 已知限制）
   111		if j.has("cmds"):
   112			return {"ok": false, "why": "body"}
   113		var mismatch: bool = str(j.get("r", "")) != D.version_of([a0, a1]) or str(j.get("d", "")) != D.digest_of([a0, a1])
   114		return {"ok": true, "why": "", "a0": a0, "a1": a1, "mismatch": mismatch, "rules": rules, "cmds": cmds}

