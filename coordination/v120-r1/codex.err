    62	func _draw_battle_report() -> void:
    63		if report_log.is_empty():
    64			return
    65		var ctl: bool = play_kind != "official"
    66		var rows := 1 if ctl else 2     # 重播時底部有控制列，只剩一排
    67		var rh: float = tz("S") * 1.32
    68		var y0: float = 800.0 - rows * rh - 4.0 if ctl else minf(720.0, 766.0 - rows * rh)
    69		var cw := 412.0
    70		if not ctl:
    71			draw_rect(Rect2(0, y0 - 3, 1280, mini(ceili(report_log.size() / 3.0), rows) * rh + 6), Color(0, 0, 0, 0.5))   # 第十輪 V10：底條
    72		for i in mini(report_log.size(), rows * 3):
    73			var e: Dictionary = report_log[i]
    74			var age: float = time - float(e["t"])
    75			var a := clampf(1.6 - age * 0.4, 0.35, 1.0)
    76			var p := Vector2(14.0 + (i % 3) * cw, y0 + (i / 3) * rh)
    77			var mark := "●" if e["team"] == 0 else "◆"
    78			var line := "%s %s" % [L.t("unit_%d" % int(e["type"])), e["label"]]
    79			if int(e["n"]) > 1:
    80				line += " ×%d" % int(e["n"])
    81			_text(p, mark, tz("S"), Color(Art.team_color(int(e["team"]), cbm()), a), false, true)
    82			_text(p + Vector2(tz("S") + 6.0, 0), line, tz("S"), Color(e["col"], a), false, true, cw - tz("S") - 14.0)
    83	
