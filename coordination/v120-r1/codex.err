    47	## 狂熱暖色暈影（第七輪 D5）：受簡化特效控制。
    48	func _draw_frenzy_edge() -> void:
    49		if view == null or not view.frenzy or view.finished or bool(Save.s("reduce_fx")):
    50			return
    51		var a := 0.16 + 0.05 * sin(time * 5.0)
    52		for k in 4:
    53			var w := 22.0 - k * 5.0
    54			var col := Color(1.0, 0.42, 0.1, a * (0.35 + k * 0.2))
    55			draw_rect(Rect2(0, 86, 1280, w), col)
    56			draw_rect(Rect2(0, 800 - w, 1280, w), col)
    57			draw_rect(Rect2(0, 86, w, 714), col)
    58			draw_rect(Rect2(1280 - w, 86, w, 714), col)
