    59	## 聲道選擇（純函式，測試用）：先找空的；滿了就搶優先權最低（同級取最早開始）且低於新音效的。沒有可搶的回 -1。
    60	static func pick_channel(busy: Array, prios: Array, starts: Array, prio: int) -> int:
    61		for i in busy.size():
    62			if not busy[i]:
    63				return i
    64		var best := -1
    65		for i in busy.size():
    66			if prios[i] < prio and (best < 0 or prios[i] < prios[best] or (prios[i] == prios[best] and starts[i] < starts[best])):
    67				best = i
    68		return best
    69	
    70	func set_volumes(sfx_pct: int, music_pct: int) -> void:
    71		sfx_vol = sfx_pct / 100.0
    72		music_vol = music_pct / 100.0
    73		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
    74		if amb != null:
    75			amb.volume_db = linear_to_db(maxf(0.0001, sfx_vol * 0.22))   # 第十輪 B6：環境音跟音效音量
    76	
    77	func play(name: String, vol := 1.0) -> void:
    78		if not streams.has(name) or sfx_vol <= 0.0:
    79			return
    80		if int(PRIO.get(name, 0)) >= 2 and not name.begins_with("k_"):
    81			duck(0.7)
    82		var now := Time.get_ticks_msec()
    83		var r: Array = recent.get(name, [])
    84		r = r.filter(func(t): return now - t < 80)
    85		if r.size() >= 2:
    86			return
    87		r.append(now)
    88		recent[name] = r
    89		var pr: int = PRIO.get(name, 1)
    90		var busy: Array = []
    91		var prios: Array = []
    92		var starts: Array = []
    93		for i in players.size():
    94			busy.append(players[i].playing)
    95			prios.append(_prio_of.get(i, 0))
    96			starts.append(_started.get(i, 0))
    97		var ch := pick_channel(busy, prios, starts, pr)
    98		if ch < 0:
    99			return
   100		var p := players[ch]
   101		p.stop()
   102		p.stream = streams[name]
   103		p.pitch_scale = 1.0 + rng.randf_range(-0.1, 0.1)
   104		p.volume_db = linear_to_db(maxf(0.0001, sfx_vol * vol))
   105		p.play()
   106		_prio_of[ch] = pr
   107		_started[ch] = now
   108	
   109	# ── 分軌戰鬥音樂（第三輪 S1）：低音、鼓、旋律三軌同時播、各自調音量 ──
   110	const LAYERS := ["music_battle_bass", "music_battle_drums", "music_battle_mel"]
   111	var layers: Array[AudioStreamPlayer] = []
   112	var layer_gain := [1.0, 0.35, 1.0]     # 目標
   113	var layer_cur := [1.0, 0.35, 1.0]      # 目前（平滑）
   114	
   115	func play_layers() -> void:
   116		music.stop()
   117		music_name = "layers"
   118		if layers.is_empty():
   119			for n in LAYERS:
   120				var p := AudioStreamPlayer.new()
   121				add_child(p)
   122				# 循環在匯入設定裡開（edit/loop_mode=2 整段循環）；檔案匯入時會壓縮，不能用位元組數自己算樣本數（Codex S7 #1）
   123				p.stream = load("res://audio/%s.wav" % n)
   124				layers.append(p)
   125		layer_cur = layer_gain.duplicate()
   126		for i in layers.size():
   127			layers[i].volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * layer_cur[i] * (0.45 if duck_t > 0.0 else 1.0)))
   128			layers[i].play(0.0)
   129	
   130	func stop_layers() -> void:
   131		for p in layers:
   132			p.stop()
   133	
   134	## 戰況 → 三軌目標音量：差距小（≤15%）鼓聲進來；最後時刻只留低音（心跳另外播）。
   135	static func layer_targets(close: bool, clutch: bool) -> Array:
   136		if clutch:
   137			return [1.0, 0.0, 0.0]
   138		return [1.0, 1.0 if close else 0.35, 1.0]
   139	
   140	func set_layer_targets(g: Array) -> void:
   141		layer_gain = g
   142	
   143	func _process(delta: float) -> void:
   144		if duck_t > 0.0:
   145			duck_t -= delta
   146			music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * (0.45 if duck_t > 0.0 else 1.0)))
   147		if music_name != "layers" or layers.is_empty():
   148			return
   149		for i in layers.size():
   150			layer_cur[i] = move_toward(layer_cur[i], layer_gain[i], delta * 1.5)
   151			layers[i].volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * layer_cur[i]))
   152	
   153	## V9：地圖環境音；空字串＝停。
   154	func play_ambience(name: String) -> void:
   155		if name == amb_name:
   156			return
   157		amb_name = name
   158		if name == "":
   159			amb.stop()
   160			return
   161		var st = load("res://audio/amb_%s.wav" % name)
   162		if st == null:
   163			amb.stop()
   164			return
   165		amb.stream = st
   166		amb.volume_db = linear_to_db(maxf(0.0001, sfx_vol * 0.22))
   167		amb.play()
   168	
   169	func duck(sec: float) -> void:
   170		duck_t = maxf(duck_t, sec)
   171	
   172	func play_music(name: String) -> void:
   173		if name == "music_battle":
   174			if music_name != "layers":
   175				play_layers()
   176			return
   177		if name == music_name:
   178			return
   179		stop_layers()
   180		music_name = name
   181		var st = load("res://audio/%s.wav" % name)
   182		if st == null:
   183			music.stop()
   184			return
   185		music.stream = st
   186		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
   187		music.play()

