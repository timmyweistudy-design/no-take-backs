     4	func _draw_busy(pct: int) -> void:
     5		var msg: String = L.t("busy_wait") if pct < 0 else L.t("busy_calc", [pct])
     6		var w := _width(msg, tz("B"), true) + 40
     7		draw_rect(Rect2(640 - w / 2, 360, w, tz("B") * 1.8), Color(TH_WOOD_D, 0.94))
