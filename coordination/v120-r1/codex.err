   489			var oc := Color(0, 0, 0, c.a * 0.75) if outline.a < 0.0 else outline
   490			if oc.a > 0.0:
   491				draw_string_outline(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, 5, oc)
