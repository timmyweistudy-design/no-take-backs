    75	static func _eyes(ci: CanvasItem, c: Vector2, a: float, t: float, angry := false) -> void:
    76		var blink := 1.0 if fmod(t + c.x * 0.13, 3.7) > 0.12 else 0.15
    77		for dx in [-3.0, 4.0]:
