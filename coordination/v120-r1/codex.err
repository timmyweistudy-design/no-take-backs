   533	## 主按鈕的流光（可關）。
   534	func _btn_shine(r: Rect2) -> void:
   535		if bool(Save.s("reduce_fx")):
   536			return
   537		var k := fposmod(time * 0.45, 1.0)
   538		if k > 0.5:
   539			return
   540		var x: float = r.position.x + (r.size.x + 40.0) * (k * 2.0) - 40.0
   541		var x0 := maxf(x, r.position.x + 3)
   542		var x1 := minf(x + 26.0, r.end.x - 3)
   543		if x1 > x0:
   544			draw_rect(Rect2(x0, r.position.y + 3, x1 - x0, r.size.y - 6), Color(1, 1, 1, 0.13))
   545	
   546	## 圓角方塊（StyleBox 快取，不每幀配新物件）。
   547	func _box(r: Rect2, bg: Color, border := Color(0, 0, 0, 0), radius := 6.0, bw := 0.0) -> void:
   548		var k := "%s|%s|%d|%d" % [bg.to_html(), border.to_html(), int(radius), int(bw * 10)]
   549		var sb: StyleBoxFlat = _sb_cache.get(k)
   550		if sb == null:
   551			sb = StyleBoxFlat.new()
   552			sb.bg_color = bg
   553			sb.border_color = border
   554			sb.set_corner_radius_all(int(radius))
   555			sb.set_border_width_all(int(ceilf(bw)))
   556			sb.anti_aliasing = true
   557			_sb_cache[k] = sb
   558		draw_style_box(sb, r)
   559	
   560	func _icon(name: String, c: Vector2, s: float, col := Color.WHITE) -> void:
   561		Icons.draw(self, name, c, s, col)
   562	
   563	## 羊皮紙標題緞帶：畫面標題統一用它。
   564	func _h1(center: Vector2, s: String, maxw := 0.0) -> void:
   565		var sz := tz("H1")
   566		var w := minf(_width(s, sz, true) + 72.0, maxw if maxw > 0.0 else 900.0)
   567		var r := Rect2(center.x - w / 2, center.y - 2, w, sz * 1.45)
   568		var notch := 14.0
   569		for sgn in [-1.0, 1.0]:
   570			var ex: float = r.position.x if sgn < 0 else r.end.x
   571			draw_colored_polygon(PackedVector2Array([Vector2(ex - sgn * 4, r.position.y + 6), Vector2(ex + sgn * 20, r.position.y + 6), Vector2(ex + sgn * (20 - notch), r.get_center().y + 3), Vector2(ex + sgn * 20, r.end.y + 2), Vector2(ex - sgn * 4, r.end.y + 2)]), TH_PARCH.darkened(0.28))
   572		_box(r, TH_PARCH, TH_PARCH.darkened(0.45), 4.0, 2.0)
   573		_text(center + Vector2(0, sz * 0.07), s, sz, TH_INK, true, true, maxf(w - 20.0, 100.0))
   574	
   575	## 安靜的小按鈕（第七輪 N6）：點擊框維持可點的大小，平常只畫一個小記號，滑過才亮。
   576	func _btn_quiet(r: Rect2, label: String, action: Callable) -> void:
   577		var idx := _btns.size()
   578		_btns.append({"r": r, "cb": action, "en": true})
   579		var hot := (r.has_point(mouse) and not pad_mode) or (pad_mode and idx == _focus)
   580		var c := r.end - Vector2(12, 12)
   581		draw_circle(c, 9.0, Color(ACCENT, 0.9) if hot else Color(0, 0, 0, 0.55), true, -1.0, true)
   582		if layout_probe:
   583			probe_btns.append(r)
   584			probe_ctrls.append(r)
   585		var sz := ts(14)
   586		_probe_btn_label = true
   587		_probe_btn_rect = r
   588		_text(c - Vector2(0, sz * 0.62), label, sz, Color.BLACK if hot else Color(1, 1, 1, 0.8), true, true)
   589		_probe_btn_label = false
   590	
   591	
   592	## ── 輸入命令佇列（第三輪 A2）──
   593	## 輸入事件不再直接執行，也不在 _draw 裡派發：先排進佇列，在 _process 開頭依序處理。
   594	## 每個命令記下排入時的「畫面世代」；畫面（狀態、覆蓋層、模式）一換，舊命令就丟掉，避免點到下一個畫面的按鈕。
   595	## 點擊只對「這個世代畫出來的按鈕」有效（_btns_gen）。
   596	func _enqueue(kind: String, data) -> void:
   597		_cmds.append({"kind": kind, "data": data, "gen": _gen})
   598	
   599	func _update_gen() -> void:
   600		var key := "%d|%s|%d" % [state, overlay, mode]
   601		if key != _gen_key:
   602			_gen_key = key
   603			_gen += 1
   604	
   605	
   606	func _panel(r: Rect2) -> void:
   607		draw_rect(Rect2(0, 0, 1280, 800), Color(0, 0, 0, 0.62))
   608		_box(r.grow(6), Color(0, 0, 0, 0.35), Color(0, 0, 0, 0), 14.0)      # 陰影
   609		_box(r, PANEL, TH_EDGE, 10.0, 3.0)
   610		_box(r.grow(-5), Color(0, 0, 0, 0), Color(0, 0, 0, 0.35), 7.0, 1.0)
   611		# 木紋：固定幾條淡線
   612		var n := int(r.size.y / 46.0)
   613		for k in n:
   614			var y := r.position.y + 24.0 + k * 46.0 + float((k * 37) % 13)
   615			draw_line(Vector2(r.position.x + 12, y), Vector2(r.end.x - 12, y + float((k * 13) % 5) - 2.0), Color(1, 0.85, 0.6, 0.022), 2.0)
   616		for c in [r.position + Vector2(11, 11), Vector2(r.end.x - 11, r.position.y + 11), Vector2(r.position.x + 11, r.end.y - 11), r.end - Vector2(11, 11)]:
   617			draw_circle(c, 3.2, TH_EDGE, true, -1.0, true)
   618			draw_circle(c - Vector2(0.8, 0.8), 1.3, TH_PARCH, true, -1.0, true)
   619	
   620	
   621	func _open(name: String) -> void:
   622		overlay = name
   623		_focus = 0
   624	
   625	
     1	extends Node
     2	## 角色精靈圖快取（第二輪方案 R2、H；第八輪改分頁）：實測 48 隻時每幀直接程式繪製要 34ms（約 15fps），
     3	## 所以用同一份 Art.unit 畫法，把兵種×隊伍×動作影格畫進圖集，戰鬥中只貼圖。
     4	## 第八輪：一張大圖放 22 種會到 3072×11712，Compatibility 渲染器超過 4096 有風險。改成每頁 ≤4096（7 種兵），
     5	## 開場只烘舊 10 種，新兵上場才烘；還沒烘好時呼叫端直接畫，不會缺圖。頁數有上限，超過丟最舊的新兵頁。
     6	## 用同一份畫法烘焙，但不是逐像素等價（Codex R1 審查 #3、#4，已知且接受的差異）：
     7	##  - 走路量化成 6 格、攻擊 8 格；攻擊中不再疊走路相位；走路／攻擊格固定睜眼（只在待機眨眼）。
     8	## 表情疊加（受擊、暈眩、衝鋒、狂熱、潛行、頂住）不烘焙，貼完圖再用 Art.overlay 在同一個局部座標畫上去。
     9	##  - 透明度（潛行）是對整張合成好的角色乘 alpha，重疊的部位不會像逐圖元那樣透出底下的線條。
    10	## 待機呼吸位移在貼圖時加（烘焙時抵銷為 0）；受擊閃白跟著攻擊前衝與走路起伏。
    11	## 沒有畫面（headless）或還沒建好時，呼叫端退回 Art.unit。
    12	
    13	const Art = preload("res://scripts/ui/art.gd")
    14	const D = preload("res://scripts/core/unit_defs.gd")
    15	const Gait = preload("res://scripts/ui/units/gait.gd")
    16	
    17	const CELL := 192          # 每格像素（以 RS 倍率畫）；比角色大一圈，避免相鄰格子滲色
    18	const RS := 1.6            # 烘焙解析度倍率
    19	const ORIGIN := Vector2(78, 160)   # 角色腳底在格子裡的位置（第七輪 C0：原本會超框被切掉）
    20	const RING_ORIGIN := Vector2(96, 140)   # 腳底圈格子的中心（有影子，要留下方空間）
    21	const WALK_FRAMES := 8     # V9 P2：6→8，另加拖行、暈眩
    22	const POSE_FRAMES := 2
    23	const ATK_FRAMES := 8      # 三段式攻擊（R5）要多幾格才看得出前搖／揮擊／後搖
    24	# 每個兵種、隊伍的影格順序：0 待機、1 眨眼、2..7 走路、8..23 攻擊兩組（一般／交替或專屬）
    25	const FRAMES_PER := 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * 2
    26	const COLS := 16
    27	const TYPES_PER_PAGE := 6  # 6×2×28＝336 格＝21 列×192＝4032px，不超過 4096
    28	const MAX_PAGES := 5
    29	
    30	var pages: Array = []      # 每頁 {tex, types}
    31	var loc := {}              # 兵種 → [頁, 這一種在頁裡的起始格]
    32	var ring_tex: Texture2D = null
    33	var ready_cb := -1         # 這份快取是用哪種配色（一般／色盲）烘焙的
    34	var _busy := false
    35	var _queue: Array = []
    36	var _baking: Array = []
    37	
    38	func is_ready(cb: bool) -> bool:
    39		return ring_tex != null and ready_cb == (1 if cb else 0)
    40	
    41	func has_type(t: int) -> bool:
    42		return loc.has(t)
    43	
    44	## 腳底在格子裡的位置：往前伸得很長的長槍兵靠左、很寬的小石魔靠右，其他都一樣。
    45	static func origin_of(type: int) -> Vector2:
    46		return Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160))
    47	
    48	## 全部清掉，烘舊 10 種和腳底圈。
    49	func build(cb: bool) -> void:
    50		if DisplayServer.get_name() == "headless":
    51			return
    52		pages.clear()
    53		loc.clear()
    54		_queue.clear()
    55		ring_tex = null
    56		ready_cb = 1 if cb else 0
    57		var base: Array = []
    58		for t in D.COUNT:
    59			base.append(t)
    60		await _bake_ring(cb)
    61		await ensure(base)
    62	
    63	## 這場要用到的兵種。缺的才烘；烘的時候呼叫端先直接畫。
    64	func ensure(types: Array) -> void:
    65		if DisplayServer.get_name() == "headless" or ready_cb < 0:
    66			return
    67		for t in types:
    68			if not loc.has(t) and not t in _queue and not t in _baking:
    69				_queue.append(t)
    70		if _busy or _queue.is_empty():
    71			return
    72		_busy = true
    73		while not _queue.is_empty():
    74			var chunk: Array = _queue.slice(0, TYPES_PER_PAGE)
    75			_queue = _queue.slice(chunk.size())
    76			_baking = chunk
    77			await _bake_page(chunk)
    78			_baking = []
    79		_busy = false
    80	
    81	func _viewport(size: Vector2i, painter: Node) -> SubViewport:
    82		var vp := SubViewport.new()
    83		vp.size = size
    84		vp.transparent_bg = true
    85		vp.render_target_update_mode = SubViewport.UPDATE_ONCE
    86		vp.add_child(painter)
    87		add_child(vp)
    88		return vp
    89	
    90	func _bake_page(types: Array) -> void:
    91		var cb := ready_cb == 1
    92		var total := types.size() * 2 * FRAMES_PER
    93		var rows := int(ceil(float(total) / COLS))
    94		var painter := _Painter.new()
    95		painter.cb = cb
    96		painter.types = types
    97		var vp := _viewport(Vector2i(COLS * CELL, rows * CELL), painter)
    98		await RenderingServer.frame_post_draw
    99		await RenderingServer.frame_post_draw
   100		var img := vp.get_texture().get_image()
   101		vp.queue_free()
   102		if (1 if cb else 0) != ready_cb:
   103			return   # 烘的時候換了配色：這一批作廢
   104		# 新兵頁太多就丟最舊的（舊 10 種那兩頁不丟）
   105		if pages.size() >= MAX_PAGES:
   106			for i in pages.size():
   107				if pages[i] != null and int(pages[i]["types"][0]) >= D.COUNT:
   108					for t in pages[i]["types"]:
   109						if loc.has(t) and int(loc[t][0]) == i:
   110							loc.erase(t)
   111					pages[i] = null
   112					break
   113		var pn := pages.size()
   114		pages.append({"tex": ImageTexture.create_from_image(img), "types": types})
   115		for k in types.size():
   116			loc[types[k]] = [pn, k * 2 * FRAMES_PER]
   117	
   118	func _bake_ring(cb: bool) -> void:
   119		var painter := _RingPainter.new()
   120		painter.cb = cb
   121		var vp := _viewport(Vector2i(4 * CELL, CELL), painter)
   122		await RenderingServer.frame_post_draw
   123		await RenderingServer.frame_post_draw
   124		ring_tex = ImageTexture.create_from_image(vp.get_texture().get_image())
   125		vp.queue_free()
   126	
   127	## variant 1（劍士交替招式）和 2（第四輪新兵的專屬動作）都用第二組攻擊格：新兵沒有交替招式，那一組烘的是專屬動作。
   128	func frame_index(type: int, team: int, walk: float, atk: float, t: float, px: float, variant := 0) -> int:
   129		var base: int = int(loc[type][1]) + team * FRAMES_PER
   130		if atk > 0.0:
   131			return base + 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * mini(variant, 1) + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
   132		if walk <= Gait.POSE_DAZE + 1.0:
   133			return base + 2 + WALK_FRAMES + 1
   134		if walk <= Gait.POSE_DRAG + 1.0:
   135			return base + 2 + WALK_FRAMES
   136		if walk != 0.0:
   137			return base + 2 + int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES
   138		var ex := 2.0 if type == D.CAVALRY else 3.5   # Art._eyes 的眼睛中心 x
   139		var blink := fmod(t + ex * 0.13, 3.7) <= 0.12   # 與 Art._eyes 相同的眨眼節奏
   140		return base + (1 if blink else 0)
   141	
   142	func draw_ring(ci: CanvasItem, p: Vector2, team: int, type: int, scale := 1.0) -> void:
   143		var idx := team * 2 + (1 if (type == D.SHIELD or type == D.CAVALRY or type == 19) else 0)
   144		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
   145		ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2(idx * CELL, 0, CELL, CELL))
   146		ci.draw_set_transform_matrix(Art.base)
   147	
   148	func _rect(idx: int) -> Rect2:
   149		return Rect2((idx % COLS) * CELL, (idx / COLS) * CELL, CELL, CELL)
   150	
   151	## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
   152	func quant_walk(walk: float) -> float:
   153		if walk == 0.0:
   154			return 0.0
   155		if walk < -50.0:
   156			return walk
   157		return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES
   158	
   159	func quant_atk(atk: float) -> float:
   160		if atk <= 0.0:
   161			return 0.0
   162		return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES
   163	
   164	## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
   165	func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
   166			hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false, variant := 0) -> void:
   167		var idx := frame_index(type, team, walk, atk, t, p.x, variant)
   168		if atk > 0.0:
   169			walk = 0.0   # 攻擊影格烘焙時沒有走路相位：貼圖與疊加都當成沒在走（Codex 收尾輪 #4）
   170		var bob := Art.idle_bob(t, p.x) if walk == 0.0 else 0.0   # 與 Art.unit 相同：沒走路時（含攻擊）都有呼吸
   171		var xf := Art.base * Transform2D(lean * face, Vector2(scale * face / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale))
   172		ci.draw_set_transform_matrix(xf)
   173		ci.draw_texture_rect_region(pages[loc[type][0]]["tex"], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
   174		if hurt > 0.0 or mood != 0:
   175			# 攻擊影格烘焙時沒有走路相位（Codex R5 #3）
   176			var qa := quant_atk(atk)
   177			var qw := 0.0 if qa > 0.0 else quant_walk(walk)
   178			ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, face, qw, qa, t, scale, lean, crouch, type) * Gait.body_xf(type, qw))
   179			if hurt > 0.0:
   180				ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, false)
   181			if mood != 0:
   182				Art.overlay(ci, type, team, mood, alpha, t, cb)
   183		ci.draw_set_transform_matrix(Art.base)
   184	
   185	## 烘焙用的畫家：一格一格呼叫 Art.unit（face＝+1，翻面由貼圖時處理）。
   186	class _Painter extends Node2D:
   187		var cb := false
   188		var types: Array = []
   189		func _draw() -> void:
   190			var Art2 = preload("res://scripts/ui/art.gd")
   191			var D2 = preload("res://scripts/core/unit_defs.gd")
   192			var saved: Transform2D = Art2.base
   193			Art2.base = Transform2D.IDENTITY
   194			var CELL2 := 192
   195			var RS2 := 1.6
   196			var W2 := 8
   197			var per := 2 + W2 + 2 + 8 + 8
   198			var cols := 16
   199			for k in types.size():
   200				var type: int = types[k]
   201				for team in 2:
   202					for f in per:
   203						var idx: int = (k * 2 + team) * per + f
   204						var cell_o := Vector2((idx % cols) * CELL2, (idx / cols) * CELL2)
   205						var walk := 0.0
   206						var atk := 0.0
   207						var vr := 0
   208						if f >= 2 and f < 2 + W2:
   209							walk = 0.0001 + (f - 2) * TAU / W2
   210						elif f == 2 + W2:
   211							walk = -100.0   # 拖行（Gait.POSE_DRAG）
   212						elif f == 3 + W2:
   213							walk = -200.0   # 暈眩（Gait.POSE_DAZE）
   214						elif f >= 4 + W2 + 8:
   215							atk = (f - (4 + W2 + 8) + 0.5) / 8.0
   216							vr = 1 if type < D2.CLASSIC else 2   # 第四輪新兵沒有交替招式，這一組放專屬動作（variant 2）
   217						elif f >= 4 + W2:
   218							atk = (f - (4 + W2) + 0.5) / 8.0
   219						var p := cell_o + (Vector2(70, 160) if type == 5 else (Vector2(90, 160) if type == 19 else Vector2(78, 160)))
   220						var ex := 2.0 if type == D2.CAVALRY else 3.5
   221						# 眨眼那一格落在眨眼區間中間；其他格取 1.0（不在眨眼區間）
   222						var tt: float = (3.7 - ex * 0.13 + 0.05) if f == 1 else 1.0
   223						# 沒走路的格子（待機、眨眼、攻擊）Art.unit 會加呼吸位移；這裡反向抵銷，貼圖時再依當下時間加
   224						var pb := p
   225						if walk == 0.0:
   226							pb.y -= sin(tt * 3.0 + p.x * 0.05) * 0.8 * RS2
   227						Art2.unit(self, pb, type, team, 1.0, walk, atk, 0.0, 1.0, tt, RS2, cb, 0, 0.0, 1.0, vr)
   228			Art2.base = saved
   229	
   230	class _RingPainter extends Node2D:
     1	extends RefCounted
     2	## 由 art.gd 拆出（V9 P1，行為不變）
     3	## 程式繪製的 Q 版角色與戰場（優化方案 G：美術先用程式能做到的先做）。
     4	## 全部是向量圖形＋抗鋸齒，沒有外部角色素材。辨識靠三層視覺錨點：腳底隊伍標記、上半身／武器剪影、動態特效。
     5	
     6	const D = preload("res://scripts/core/unit_defs.gd")
     7	const Gait = preload("res://scripts/ui/units/gait.gd")
     8	
     9	const OUT := Color("#1d1a2b")
