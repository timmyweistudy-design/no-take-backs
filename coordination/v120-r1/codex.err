   151	## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
   152	func quant_walk(walk: float) -> float:
   153		if walk == 0.0:
   154			return 0.0
   155		if walk < -50.0:
   156			return walk
   157		return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES
   158	
   159	func quant_atk(atk: float) -> float:
   160		if atk <= 0.0:
   161			return 0.0
   162		return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES
   163	
   164	## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
   165	func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
   166			hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false, variant := 0) -> void:
   167		var idx := frame_index(type, team, walk, atk, t, p.x, variant)
   168		if atk > 0.0:
   169			walk = 0.0   # 攻擊影格烘焙時沒有走路相位：貼圖與疊加都當成沒在走（Codex 收尾輪 #4）
   170		var bob := Art.idle_bob(t, p.x) if walk == 0.0 else 0.0   # 與 Art.unit 相同：沒走路時（含攻擊）都有呼吸
   171		var xf := Art.base * Transform2D(lean * face, Vector2(scale * face / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale))
   172		ci.draw_set_transform_matrix(xf)
   173		ci.draw_texture_rect_region(pages[loc[type][0]]["tex"], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
   174		if hurt > 0.0 or mood != 0:
   175			# 攻擊影格烘焙時沒有走路相位（Codex R5 #3）
   176			var qa := quant_atk(atk)
   177			var qw := 0.0 if qa > 0.0 else quant_walk(walk)
   178			ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, face, qw, qa, t, scale, lean, crouch, type) * Gait.body_xf(type, qw))
   179			if hurt > 0.0:
   180				ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, false)
   181			if mood != 0:
   182				Art.overlay(ci, type, team, mood, alpha, t, cb)
     1	#!/usr/bin/env python3
     2	"""字型涵蓋檢查（第五輪 §5.3）：遊戲會顯示的字（strings.csv、puzzles.json、codex.json、credits.txt、程式裡的字）
     3	都要在思源黑體子集裡；不然那幾個字會靜靜 fallback 成系統字型（循徑拾光踩過的坑）。缺字 exit 1。
     4	標題字 ThenKhung 原字型本來就沒有的字由思源黑體 Bold 補，不算缺字。"""
     5	import os, glob, re, sys
     6	from fontTools.ttLib import TTFont
     7	root = os.path.join(os.path.dirname(__file__), "..")
     8	chars = set()
     9	for pat in ["data/*.csv", "data/*.json", "data/*.txt", "scripts/**/*.gd"]:
    10	    for f in glob.glob(os.path.join(root, pat), recursive=True):
    11	        txt = open(f, encoding="utf-8").read()
    12	        # V9：程式碼只算字串常值，註解的字不必進字型
    13	        chars.update("".join(re.findall(r'"(?:[^"\\\n]|\\.)*"', txt)) if f.endswith(".gd") else txt)
    14	need = sorted(c for c in chars if c.isprintable() and not c.isspace() and ord(c) >= 0x20)
    15	bad = []
    16	for w in ["Regular", "Bold"]:
    17	    cmap = TTFont(os.path.join(root, "fonts", f"NotoSansTC-{w}-sub.otf")).getBestCmap()
    18	    miss = [c for c in need if ord(c) not in cmap]
    19	    if miss:
    20	        bad.append(f"{w} 缺 {len(miss)} 字：{''.join(miss[:40])}")
    21	# 標題字：子集裡沒有的字，必須是原字型本來就沒有的（build_font.py 寫在 ThenKhung-missing.txt），否則就是漏子集化
    22	tk = os.path.join(root, "fonts", "ThenKhung-sub.ttf")
    23	if os.path.exists(tk):
    24	    tcm = TTFont(tk).getBestCmap()
    25	    allowed = set(open(os.path.join(root, "fonts", "ThenKhung-missing.txt"), encoding="utf-8").read()) if os.path.exists(os.path.join(root, "fonts", "ThenKhung-missing.txt")) else set()
    26	    miss = [c for c in need if ord(c) not in tcm and c not in allowed]
    27	    if miss:
    28	        bad.append(f"標題字缺 {len(miss)} 字（不是原字型沒有的）：{''.join(miss[:40])}")
    29	print("FONTCOVER", "OK" if not bad else "；".join(bad), f"（{len(need)} 字）")
    30	sys.exit(1 if bad else 0)
