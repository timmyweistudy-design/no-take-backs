    96	static func _ell(c: Vector2, rx: float, ry: float, a0 := 0.0, a1 := TAU, n := 20) -> PackedVector2Array:
    97		var pts := PackedVector2Array()
    98		for i in n:
    99			var ang := a0 + (a1 - a0) * i / float(n - (0 if is_equal_approx(a1 - a0, TAU) else 1))
   100			pts.append(c + Vector2(cos(ang) * rx, sin(ang) * ry))
   101		return pts
