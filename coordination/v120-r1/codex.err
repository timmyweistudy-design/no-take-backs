    85	
    86	func _merge_text(tid: int, kind: String, label: String, dmg: int, p: Vector2, col: Color) -> void:
    87		if int(TEXT_TIER.get(kind, 1)) >= 2:
    88			text_key_in += 1
    89		var cell := Vector2i(floori(p.x / TEXT_CELL.x), floori(p.y / TEXT_CELL.y))
    90		for f in fx:
    91			if f["kind"] == "text" and not f.get("screen", false) and f.get("ek", "") == kind and f.get("cell", Vector2i(-99, -99)) == cell and f["t"] < 0.35:
    92				f["n"] += 1
    93				f["sum"] += dmg
    94				f["s"] = ("+%d" % f["sum"]) if kind == EV.HEAL else "%s ×%d（%d）" % [label, f["n"], f["sum"]]
    95				f["t"] = 0.0
    96				f["pop"] = 0.18
    97				if int(f.get("tier", 1)) >= 2:
    98					text_key_shown += 1
    99				return
   100		var tier: int = TEXT_TIER.get(kind, 1)
   101		var world := 0
   102		for f in fx:
   103			if f["kind"] == "text" and not f.get("screen", false):
   104				world += 1
   105		if world >= TEXT_CAP:
   106			# 丟最舊的一般跳字；全部都是關鍵的就照樣加（關鍵不能漏）
   107			var oldest := -1
   108			for k in fx.size():
   109				var f2: Dictionary = fx[k]
   110				if f2["kind"] == "text" and not f2.get("screen", false) and int(f2.get("tier", 1)) < 2:
   111					if oldest < 0 or f2["t"] > fx[oldest]["t"]:
   112						oldest = k
   113			if oldest >= 0:
   114				fx.remove_at(oldest)
   115				text_dropped += 1
   116			elif tier < 2:
   117				text_dropped += 1
   118				return
   119			else:
   120				# 全部都是關鍵跳字：併進最近的同種跳字（硬上限，Codex S1 #5），關鍵不漏、只是合併
   121				var near := -1
   122				for k2 in fx.size():
   123					var f3: Dictionary = fx[k2]
   124					if f3["kind"] == "text" and f3.get("ek", "") == kind and (near < 0 or f3["p"].distance_to(p) < fx[near]["p"].distance_to(p)):
   125						near = k2
   126				if near >= 0:
   127					var fn: Dictionary = fx[near]
   128					fn["n"] += 1
   129					fn["sum"] += dmg
   130					fn["s"] = "%s ×%d（%d）" % [label, fn["n"], fn["sum"]]
   131					fn["t"] = 0.0
   132					fn["pop"] = 0.18
   133					text_key_shown += 1
   134					return
   135				# 沒有同種的：取代最舊的關鍵跳字（它已經顯示過了），維持硬上限
   136				var old := -1
   137				for k4 in fx.size():
   138					var f4: Dictionary = fx[k4]
   139					if f4["kind"] == "text" and not f4.get("screen", false) and (old < 0 or f4["t"] > fx[old]["t"]):
   140						old = k4
   141				if old >= 0:
   142					fx.remove_at(old)
   143		if tier >= 2:
   144			text_key_shown += 1
   145		fx.append({"kind": "text", "p": p, "s": ("+%d" % dmg) if kind == EV.HEAL else "%s %d" % [label, dmg], "c": col, "t": 0.0, "dur": 0.85, "size": 18 if tier >= 2 else (14 if kind == EV.HEAL else 16),
   146			"tid": tid, "ek": kind, "n": 1, "sum": dmg, "screen": false, "cell": cell, "tier": tier, "pop": 0.0, "plain": kind == EV.HEAL})
   147	
   148	
   149	
   150	## 每幀排版：關鍵在前、新的在前；和已放好的（不在淡出中的）重疊就往上推。結果存在 f["rp"]。
   151	func _layout_texts() -> void:
   152		var list: Array = []
   153		for f in fx:
   154			if f["kind"] == "text" and not f.get("screen", false):
   155				list.append(f)
   156		list.sort_custom(func(a, b): return a.get("tier", 1) > b.get("tier", 1) or (a.get("tier", 1) == b.get("tier", 1) and a["t"] < b["t"]))
   157		var placed: Array = []
   158		for f in list:
   159			var k: float = f["t"] / f["dur"]
   160			var at: Vector2 = f["p"] + Vector2(0, -k * 26)
   161			var r := _text_rect(f, at)
   162			if true:   # 淡出中的也排，但排在最後（新的、關鍵的先佔位），所以不會推動正在顯示的
   163				var moved := true
   164				var guard := 0
   165				while moved and guard < 24:
   166					moved = false
   167					guard += 1
   168					for q: Rect2 in placed:
   169						if q.intersects(r):
   170							r.position.y = q.position.y - r.size.y - 2.0
   171							moved = true
   172				placed.append(r)
   173			f["rp"] = Vector2(r.get_center().x, r.position.y + 3.0)
   174			f["rr"] = r
   175	
   176	
   177	
   178	## 量測（測試與手感輪用）：正常顯示的跳字兩兩最大重疊比例（交集÷較小框），以及淡出中與其他的最大重疊。
   179	func text_overlap_stats() -> Dictionary:
   180		var vis: Array = []
   181		var fading: Array = []
   182		for f in fx:
   183			if f["kind"] == "text" and not f.get("screen", false) and f.has("rr"):
   184				(vis if _text_alpha(f) >= 0.35 else fading).append(f["rr"])
   185		var worst := 0.0
   186		for a in vis.size():
   187			for b in range(a + 1, vis.size()):
   188				worst = maxf(worst, _overlap(vis[a], vis[b]))
   189		var worst_f := 0.0
   190		for fr: Rect2 in fading:
   191			for o: Rect2 in vis + fading:
   192				if o != fr:
   193					worst_f = maxf(worst_f, _overlap(fr, o))
   194		return {"visible": vis.size(), "fading": fading.size(), "max_overlap": worst, "max_overlap_fading": worst_f}
   195	
   196	
   197	## 最後時刻（第三輪 V2）：慢動作期間，螢幕上 y<165（橫幅下方那一帶）的戰場跳字淡到 0.2。
   198	func _clutch_dim(world_p: Vector2) -> float:
   199		if slow_left <= 0.0 and clutch_t <= 0.0:
   200			return 1.0
   201		var sp: Vector2 = _cam * world_p
   202		return 0.2 if sp.y < 165.0 else 1.0
   203	
   204	
   205	
   206	## 慢動作時離焦點遠的單位與特效降到 0.6。
   207	func _focus_dim(world_p: Vector2) -> float:
   208		if slow_left <= 0.0 or state != St.BATTLE:
   209			return 1.0
   210		return 0.6 if world_p.distance_to(action_focus) > 200.0 else 1.0
