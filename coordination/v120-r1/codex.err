   104	## 第十輪 F3：攻擊時整隻壓扁、前衝。腳底為原點，所以不會和腿分離。up＝彈起（往上拉長）。
   105	static func _atk_xf(b: Transform2D, w: float, sq: float, lunge := 0.0, up := false) -> Transform2D:
   106		if w == 0.0:
   107			return b
   108		var sx := 1.0
   109		var sy := 1.0
   110		var dx := 0.0
   111		if w < 0.0:
   112			sx = 1.0 - w * sq
   113			sy = 1.0 + w * sq
   114			dx = w * lunge * 0.3
   115		elif up:
   116			sx = 1.0 - w * sq * 0.4
   117			sy = 1.0 + w * sq * 0.6
   118		else:
   119			sx = 1.0 + w * sq * 0.6
   120			sy = 1.0 - w * sq * 0.3
   121			dx = w * lunge
   122		return Transform2D(0.0, Vector2(sx, sy), 0.0, Vector2(dx, 0.0)) * b
   123	
   124	static func _push_body(ci: CanvasItem, b: Transform2D) -> void:
   125		ci.draw_set_transform_matrix(_xf * b)

