    20	func _report_add(team: int, type: int, kind: String, label: String, col: Color) -> void:
    21		for i in report_log.size():
    22			var e: Dictionary = report_log[i]
    23			if e["team"] == team and e["type"] == type and e["kind"] == kind and time - float(e["t"]) < 2.0:
    24				e["n"] += 1
    25				e["t"] = time
    26				report_log.remove_at(i)
    27				report_log.push_front(e)
    28				return
    29		report_log.push_front({"team": team, "type": type, "kind": kind, "label": label, "col": col, "n": 1, "t": time})
    30		if report_log.size() > REPORT_CAP:
    31			report_log.resize(REPORT_CAP)
    32	
    33	
    34	func _draw_start_cue() -> void:
    35		if start_hold <= 0.0:
    36			return
    37		var k := clampf(start_hold, 0.0, 1.0)
    38		var msg: String = L.t("start")
    39		var sz := tcap(tz("D"), 64)
    40		_text(Vector2(640, 340), msg, sz, Color(1, 0.85, 0.4, k), true, true)
    41		for tm in 2:
    42			var x: float = ORIGIN.x + (float(view.max_x(tm)) / 1000.0 if view.has_method("max_x") else (6.0 if tm == 0 else 10.0) * 1.0) * CS
    43			draw_line(Vector2(x, ORIGIN.y), Vector2(x, ORIGIN.y + fld_size.y), Color(Art.team_color(tm, cbm()), 0.9 * k), 5.0)
    44	
