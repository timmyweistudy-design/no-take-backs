     1	extends Node
     2	## 音效與音樂（優化方案 H）：同類音效 80ms 內最多 2 個、音高 ±10% 隨機；音樂與音效分軌。
     3	## 優先權（第二輪方案 R8）：12 個聲道滿的時候，關鍵音（技能、死亡、最後時刻）會搶走優先權最低、播最久的普通命中音，
     4	## 不會被一堆砍擊聲擠掉。最後時刻慢動作時整體加低通濾波（悶住的心跳感）。
     5	
     6	const FILES := ["arrow", "backstab", "block", "brace", "charge", "clutch", "death", "frenzy", "hit", "lose",
     7		"place_heavy", "place_light", "place_mid", "slash", "start", "turn", "ui_click", "ui_deny", "win",
     8		"shatter", "bell", "bugle", "aircut", "alert", "snap", "taunt", "reveal", "boom", "heal",
     9		"poison", "baa", "chomp", "squish", "charge_up", "timestop", "raise", "vacuum", "stomp",
    10		"k_hover", "k_click", "k_back", "k_confirm", "k_tab", "k_toggle", "k_error", "k_open", "k_close", "k_unlock", "k_star", "k_place",
    11		"step_grass", "step_snow", "step_wood", "step_stone", "step_heavy", "hit_metal", "hit_wood", "hit_soft", "horn"]
    12	# 0 普通命中、1 防禦、2 技能／死亡、3 全場事件與介面
    13	const PRIO := {"hit": 0, "slash": 0, "arrow": 0, "block": 1, "brace": 1, "alert": 1, "taunt": 1, "reveal": 1,
    14		"shatter": 2, "bell": 2, "bugle": 2, "aircut": 2, "snap": 2, "charge": 2, "backstab": 2, "death": 2,
    15		"step_grass": 0, "step_snow": 0, "step_wood": 0, "step_stone": 0, "step_heavy": 1, "hit_metal": 0, "hit_wood": 0, "hit_soft": 0, "horn": 3,
    16		"k_hover": 3, "k_click": 3, "k_back": 3, "k_confirm": 3, "k_tab": 3, "k_toggle": 3, "k_error": 3, "k_open": 3, "k_close": 3, "k_unlock": 3, "k_star": 3, "k_place": 3,
    17		"poison": 0, "squish": 1, "charge_up": 1, "baa": 1, "chomp": 2, "timestop": 2, "raise": 2, "vacuum": 2, "stomp": 2, "clutch": 3, "frenzy": 3, "start": 3, "win": 3, "lose": 3, "turn": 3, "ui_click": 3, "ui_deny": 3}
    18	var _prio_of := {}       # 聲道 → 正在播的優先權
    19	var _started := {}       # 聲道 → 開始時間
    20	var _lowpass_idx := -1
    21	var streams := {}
    22	var players: Array[AudioStreamPlayer] = []
    23	var recent := {}   # 名稱 → [時間戳...]
    24	var music: AudioStreamPlayer
    25	var music_name := ""
    26	var amb: AudioStreamPlayer       # V9：地圖環境音
    27	var amb_name := ""
    28	var duck_t := 0.0                # V9：大招、號角時暫時壓低音樂
    29	var sfx_vol := 0.8
    30	var music_vol := 0.7
    31	var rng := RandomNumberGenerator.new()
    32	
    33	func _ready() -> void:
    34		for n in FILES:
    35			var st = load("res://audio/%s.wav" % n)
    36			if st:
    37				streams[n] = st
    38		for i in 12:
    39			var p := AudioStreamPlayer.new()
    40			add_child(p)
    41			players.append(p)
    42		music = AudioStreamPlayer.new()
    43		add_child(music)
    44		music.finished.connect(func(): music.play())
    45		amb = AudioStreamPlayer.new()
    46		add_child(amb)
    47		amb.finished.connect(func(): amb.play())
    48		var lp := AudioEffectLowPassFilter.new()
    49		lp.cutoff_hz = 900.0
    50		AudioServer.add_bus_effect(0, lp)
    51		_lowpass_idx = AudioServer.get_bus_effect_count(0) - 1
    52		AudioServer.set_bus_effect_enabled(0, _lowpass_idx, false)
    53	
    54	## 最後時刻：整體低通（慢動作開始時開、結束時關）。
    55	func set_muffled(on: bool) -> void:
    56		if _lowpass_idx >= 0 and AudioServer.is_bus_effect_enabled(0, _lowpass_idx) != on:
    57			AudioServer.set_bus_effect_enabled(0, _lowpass_idx, on)
    58	
    59	## 聲道選擇（純函式，測試用）：先找空的；滿了就搶優先權最低（同級取最早開始）且低於新音效的。沒有可搶的回 -1。
    60	static func pick_channel(busy: Array, prios: Array, starts: Array, prio: int) -> int:
    61		for i in busy.size():
    62			if not busy[i]:
    63				return i
    64		var best := -1
    65		for i in busy.size():
    66			if prios[i] < prio and (best < 0 or prios[i] < prios[best] or (prios[i] == prios[best] and starts[i] < starts[best])):
    67				best = i
    68		return best
    69	
    70	func set_volumes(sfx_pct: int, music_pct: int) -> void:
    71		sfx_vol = sfx_pct / 100.0
    72		music_vol = music_pct / 100.0
    73		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
    74		if amb != null:
    75			amb.volume_db = linear_to_db(maxf(0.0001, sfx_vol * 0.22))   # 第十輪 B6：環境音跟音效音量
    76	
    77	func play(name: String, vol := 1.0) -> void:
    78		if not streams.has(name) or sfx_vol <= 0.0:
    79			return
    80		if int(PRIO.get(name, 0)) >= 2 and not name.begins_with("k_"):
    81			duck(0.7)
    82		var now := Time.get_ticks_msec()
    83		var r: Array = recent.get(name, [])
    84		r = r.filter(func(t): return now - t < 80)
    85		if r.size() >= 2:
    86			return
    87		r.append(now)
    88		recent[name] = r
    89		var pr: int = PRIO.get(name, 1)
    90		var busy: Array = []
    91		var prios: Array = []
    92		var starts: Array = []
    93		for i in players.size():
    94			busy.append(players[i].playing)
    95			prios.append(_prio_of.get(i, 0))
    96			starts.append(_started.get(i, 0))
    97		var ch := pick_channel(busy, prios, starts, pr)
    98		if ch < 0:
    99			return
   100		var p := players[ch]
   101		p.stop()
   102		p.stream = streams[name]
   103		p.pitch_scale = 1.0 + rng.randf_range(-0.1, 0.1)
   104		p.volume_db = linear_to_db(maxf(0.0001, sfx_vol * vol))
   105		p.play()
   106		_prio_of[ch] = pr
   107		_started[ch] = now
   108	
   109	# ── 分軌戰鬥音樂（第三輪 S1）：低音、鼓、旋律三軌同時播、各自調音量 ──
   110	const LAYERS := ["music_battle_bass", "music_battle_drums", "music_battle_mel"]
   111	var layers: Array[AudioStreamPlayer] = []
   112	var layer_gain := [1.0, 0.35, 1.0]     # 目標
   113	var layer_cur := [1.0, 0.35, 1.0]      # 目前（平滑）
   114	
   115	func play_layers() -> void:
   116		music.stop()
   117		music_name = "layers"
   118		if layers.is_empty():
   119			for n in LAYERS:
   120				var p := AudioStreamPlayer.new()
   121				add_child(p)
   122				# 循環在匯入設定裡開（edit/loop_mode=2 整段循環）；檔案匯入時會壓縮，不能用位元組數自己算樣本數（Codex S7 #1）
   123				p.stream = load("res://audio/%s.wav" % n)
   124				layers.append(p)
   125		layer_cur = layer_gain.duplicate()
   126		for i in layers.size():
   127			layers[i].volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * layer_cur[i] * (0.45 if duck_t > 0.0 else 1.0)))
   128			layers[i].play(0.0)
   129	
   130	func stop_layers() -> void:
   131		for p in layers:
   132			p.stop()
   133	
   134	## 戰況 → 三軌目標音量：差距小（≤15%）鼓聲進來；最後時刻只留低音（心跳另外播）。
   135	static func layer_targets(close: bool, clutch: bool) -> Array:
   136		if clutch:
   137			return [1.0, 0.0, 0.0]
   138		return [1.0, 1.0 if close else 0.35, 1.0]
   139	
   140	func set_layer_targets(g: Array) -> void:
   141		layer_gain = g
   142	
   143	func _process(delta: float) -> void:
   144		if duck_t > 0.0:
   145			duck_t -= delta
   146			music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * (0.45 if duck_t > 0.0 else 1.0)))
   147		if music_name != "layers" or layers.is_empty():
   148			return
   149		for i in layers.size():
   150			layer_cur[i] = move_toward(layer_cur[i], layer_gain[i], delta * 1.5)
   151			layers[i].volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6 * layer_cur[i]))
   152	
   153	## V9：地圖環境音；空字串＝停。
   154	func play_ambience(name: String) -> void:
   155		if name == amb_name:
   156			return
   157		amb_name = name
   158		if name == "":
   159			amb.stop()
   160			return
   161		var st = load("res://audio/amb_%s.wav" % name)
   162		if st == null:
   163			amb.stop()
   164			return
   165		amb.stream = st
   166		amb.volume_db = linear_to_db(maxf(0.0001, sfx_vol * 0.22))
   167		amb.play()
   168	
   169	func duck(sec: float) -> void:
   170		duck_t = maxf(duck_t, sec)
   171	
   172	func play_music(name: String) -> void:
   173		if name == "music_battle":
   174			if music_name != "layers":
   175				play_layers()
   176			return
   177		if name == music_name:
   178			return
   179		stop_layers()
   180		music_name = name
   181		var st = load("res://audio/%s.wav" % name)
   182		if st == null:
   183			music.stop()
   184			return
   185		music.stream = st
   186		music.volume_db = linear_to_db(maxf(0.0001, music_vol * 0.6))
   187		music.play()
     1	#!/usr/bin/env bash
     2	# 版面檢查（第三輪 T4）：用 Windows 版 Godot 跑截圖模式，兩種語言 × 三種字級，彙整 layout.jsonl。
     3	# 用法：tools/layout_check.sh <Godot 執行檔> <輸出資料夾（WSL 路徑）>
     4	set -uo pipefail
     5	cd "$(dirname "$0")/.."
     6	EXE="$1"; OUT="$2"
     7	# 第七輪 I5：只准清自己產生的輸出夾（有記號檔），或空資料夾；其他一律拒絕，不再無條件 rm -rf
     8	MARK=".ntb-layout-output"
     9	if [ -d "$OUT" ] && [ -n "$(ls -A "$OUT" 2>/dev/null)" ]; then
    10	  if [ ! -f "$OUT/$MARK" ]; then
    11	    echo "LAYOUT FAIL：$OUT 已有內容但不是版面檢查的輸出夾，不會刪除。請換一個新資料夾。"; exit 2
    12	  fi
    13	  rm -rf "$OUT"
    14	fi
    15	mkdir -p "$OUT"; : > "$OUT/$MARK"
    16	# Windows／WSL／Linux 都能跑：有 wslpath 才轉路徑
    17	winpath() { if command -v wslpath >/dev/null 2>&1 && [[ "$EXE" == *.exe ]]; then wslpath -w "$1"; else printf '%s' "$1"; fi; }
    18	# WSL 的 timeout 只殺得到包裝程序，Windows 上的視窗會留著繼續跑：逾時要連它一起關（只關這次輸出夾的）
    19	kill_win() { if [[ "$EXE" == *.exe ]]; then powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name like 'Godot%'\" | Where-Object { \$_.CommandLine -like '*--shot=$(winpath "$1")*' } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force }" >/dev/null 2>&1; fi; }
    20	# 第九輪 P0：LAYOUT_QUICK=1 只跑中文 100%＋英文 150%（最容易出事的兩組）；里程碑跑 6 組
    21	COMBOS="zh_TW:100 zh_TW:125 zh_TW:150 en:100 en:125 en:150"
    22	[ "${LAYOUT_QUICK:-0}" = "1" ] && COMBOS="zh_TW:100 en:150"
    23	for combo in $COMBOS; do
    24	  lang="${combo%%:*}"; sc="${combo##*:}"
    25	  {
    26	    d="$OUT/${lang}_${sc}"; mkdir -p "$d"
    27	    timeout 600 "$EXE" --path "$(winpath .)" --resolution 1280x800 -- --shot="$(winpath "$d")" --shot-lang=$lang --shot-text=$sc --layout-check > "$d/run.log" 2>&1 \
    28	      || { echo "LAYOUT FAIL：$lang $sc% 截圖程式 exit 非 0"; kill_win "$d"; exit 1; }
    29	    grep -E "SCRIPT ERROR|Parse Error" "$d/run.log" >/dev/null && { echo "LAYOUT FAIL：$lang $sc% 有腳本錯誤"; exit 1; }
    30	    grep -q "PADWALK OK" "$d/run.log" || { echo "LAYOUT FAIL：$lang $sc% 手把流程：$(grep PADWALK "$d/run.log" | cut -c1-400)"; exit 1; }
    31	  }
    32	done
    33	EXPECT=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | wc -l)
    34	NAMES=$(grep -o '_snap("[^"]*")' tools/dev_main.gd | sed 's/_snap("//; s/")//' | sort | tr '\n' ',')
    35	python3 - "$OUT" "$EXPECT" "$NAMES" <<'PY'
    36	import json,sys,glob,os
    37	out=sys.argv[1]; expect=int(sys.argv[2]); names=set(x for x in sys.argv[3].split(',') if x); total=0; rows=[]
    38	for f in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    39	    for line in open(f,encoding='utf-8'):
    40	        d=json.loads(line); total+=len(d['violations']); rows.append(d)
    41	warns=sum(len(d.get('warnings',[])) for d in rows)
    42	# 第五輪：每組都要剛好是 dev_main.gd 列出的那些畫面（不能用重複畫面湊張數）
    43	for f2 in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    44	    got=[json.loads(l)['shot'] for l in open(f2,encoding='utf-8')]
    45	    if sorted(got)!=sorted(names) or len(set(got))!=len(got):
    46	        print('LAYOUT FAIL：%s 的畫面集合不對（少了 %s、多了 %s）' % (f2, sorted(names-set(got)), sorted(set(got)-names))); sys.exit(1)
    47	by={}
    48	for d in rows: by.setdefault((d['lang'],d['scale']),[]).append(d['median_size'])
    49	print('LAYOUT 截圖 %d 張、違規 %d' % (len(rows), total))
    50	for d in rows:
    51	    for v in d['violations']: print('  %s %s %d%%：%s' % (d['shot'], d['lang'], d['scale'], v))
