#!/usr/bin/env bash
# 統一檢查入口（第三輪 T1）：本機與 CI 用同一套。任何一步失敗就 exit 1，並印出是哪一步。
# 原本 CI 的問題：匯入失敗被 `|| true` 吃掉；`grep '0 失敗'` 連「10 失敗」也會通過；腳本語法錯誤會讓相依的測試靜靜略過。
# 用法：GODOT=<godot 執行檔> tools/check_all.sh [輸出資料夾]
set -uo pipefail
cd "$(dirname "$0")/.."
GODOT="${GODOT:-godot}"
OUT="${1:-${TMPDIR:-/tmp}/ntb-check}"
mkdir -p "$OUT"
fail() { echo "CHECK FAIL：$1（記錄在 $OUT）"; exit 1; }
has_err() { grep -E "SCRIPT ERROR|Parse Error|Compile Error|Failed to load script" "$1" >/dev/null; }

"$GODOT" --headless --path . --import > "$OUT/import.log" 2>&1 || fail "匯入失敗（exit 非 0）"
has_err "$OUT/import.log" && fail "匯入有腳本錯誤"
grep -E "^ERROR: .*(import|Import|Failed loading resource)" "$OUT/import.log" >/dev/null && fail "有素材匯入失敗"

"$GODOT" --headless --path . --script res://tools/load_all.gd > "$OUT/load.log" 2>&1 || fail "有腳本載入失敗"
grep -q "^LOADALL .*失敗 0：" "$OUT/load.log" || fail "載入檢查沒有完成"

"$GODOT" --headless --path . -- --boot-check > "$OUT/boot.log" 2>&1 || fail "正式入口啟動失敗"
grep -q "^BOOTOK" "$OUT/boot.log" || fail "正式入口沒有跑到標題"
has_err "$OUT/boot.log" && fail "正式入口啟動時有腳本錯誤"

"$GODOT" --headless --path . --script res://tests/run_tests.gd > "$OUT/test.log" 2>&1 || fail "規則測試有失敗（exit 非 0）"
grep -qE "^—— [1-9][0-9]* 通過 / 0 失敗" "$OUT/test.log" || fail "規則測試沒有印出完成標記"
has_err "$OUT/test.log" && fail "測試過程有腳本錯誤（可能有測試被略過）"
grep FINGERPRINT "$OUT/test.log" > "$OUT/fingerprint.txt"

"$GODOT" --headless --path . --script res://tools/mirror_100.gd > "$OUT/mirror.log" 2>&1 || fail "鏡像檢查失敗"
grep -q "^MIRROR100 100/100" "$OUT/mirror.log" || fail "鏡像沒有 100/100"

GN="${GOLDEN_N:-1000}"   # Windows 上一場約 1.5 秒，CI 的 Windows 用 200 場
"$GODOT" --headless --path . --script res://tools/golden.gd -- --n=$GN > "$OUT/golden.log" 2>&1 || fail "確定性金標準有分歧（看 golden.log 的第一個分歧場次與 tick）"
grep -q "^GOLDEN {\"n\":$GN,\"ok\":true}" "$OUT/golden.log" || fail "金標準沒有比完 $GN 場"

CN="${COMPAT_N:-1000}"   # 第四輪：舊 5 種兵逐 tick 相容（加新兵後舊兵行為不能變）；里程碑時用 COMPAT_N=1000 跑完整
"$GODOT" --headless --path . --script res://tools/compat.gd -- --n=$CN > "$OUT/compat.log" 2>&1 || fail "舊兵種相容檢查有分歧（看 compat.log）"
grep -q "^COMPAT {\"n\":$CN,\"ok\":true}" "$OUT/compat.log" || fail "相容檢查沒有比完 $CN 場"

"$GODOT" --headless --path . --script res://tools/seal_codes.gd > "$OUT/sealcodes.log" 2>&1 || fail "封存的舊對戰代碼（NTB2）播出不同結果（看 sealcodes.log）"
grep -q '^SEALCODES {"n":40,"ok":true}' "$OUT/sealcodes.log" || fail "舊對戰代碼檢查沒有完成"

"$GODOT" --headless --path . --script res://tools/orbit_detect.gd > "$OUT/orbit.log" 2>&1 || fail "騎兵打轉偵測超過門檻"
grep -q "^ORBIT cav_battles=" "$OUT/orbit.log" || fail "打轉偵測沒有完成"
for lg in mirror golden compat sealcodes orbit; do has_err "$OUT/$lg.log" && fail "$lg 過程有腳本錯誤"; done

python3 tools/check_assets.py > "$OUT/assets.log" 2>&1 || fail "素材登記檢查失敗"
python3 tools/check_font_coverage.py > "$OUT/font.log" 2>&1 || fail "字型子集缺字（改了中文要重跑 tools/build_font.py）"

echo "CHECK OK：匯入、載入、啟動、測試、鏡像、金標準、打轉、素材、舊兵相容、舊對戰代碼、字型涵蓋全過（記錄在 $OUT）"

exec
/bin/bash -lc "sed -n '396,455p' docs/2026-11-03-custom-rules-and-ui-plan-v5.md; git diff 1d8d731..bb1edf2 -- docs/2026-11-03-custom-rules-and-ui-plan-v5.md; nl -ba game/scripts/ui/ui_base.gd | sed -n '335,400p'; nl -ba game/scripts/core/army.gd | sed -n '135,205p'; nl -ba game/scripts/core/ruleset.gd | sed -n '300,365p'" in /mnt/c/Users/timmy/projects/no-take-backs
 succeeded in 867ms:
| # | 決定 |
|---|---|
| 1 沙盒 | 做了（R3），閘門通過：100%＋全開＝標準規則（指紋相同）、12 個技能開關各自生效、兩場不同規則交錯跑不互相污染 |
| 2 人數上限 | 4～40（效能探測：40＋40 每 tick 約 1.3 ms；支援兵密集 2.6 ms） |
| 3 自訂局算不算解鎖 | 算（存檔 v3 新增「解鎖累計場數」，從舊的正式場數遷移）；標準戰績、標準成就只算「標準紀錄」的局 |
| 4 未解鎖的兵進自訂卡池 | 不行；設定加「全部解鎖」。匯入含未解鎖兵的規則照原樣保留，但開戰鈕灰掉並寫原因 |
| 5 標題字 | 採用 UoqMunThenKhung（設定可換回一般字型） |
| 6 讓子判定 | 比「剩餘戰力占自己預算」（judge 2，整數交叉相乘） |
| 7 200% 字級 | 延後；這一輪做好 100／125／150% |
| 8 短局狂熱 | 依比例：起點 T×2÷3、間隔 T÷18（60 秒局 40 秒開始） |

### 11.2 和定稿不同的地方
| 項目 | 定稿 | 實作 | 原因 |
|---|---|---|---|
| 文字段數上限 | 擺放 ≤30、結果 ≤20、圖鑑 ≤25 | 擺放 ≤30、結果 ≤20、**圖鑑 ≤30**；只算「控制項外的文字」，按鈕標籤、兵卡上的小字不算 | 剋／怕的名字與擺放建議是 Antigravity 要求留在第一層的，圖鑑實測 29 段；兵卡上的快捷鍵、價錢是重複的控制項，不是要讀的說明 |
| 點擊框 | ≥36px | ≥36px（第一版用 32，Codex 實作第 1 輪抓到後改回） | — |
| 重擺本手 | 不做 | 不做；雙人改「點兩下才落子」（設定可關） | 落子無悔 |
| 預設卡片 | 7 張 | 6 張官方預設＋「我的預設 ▼」下拉 | Antigravity 第二輪 |
| 標準紀錄 | 平衡認證就算標準 | 另外判定「標準紀錄」：認證＋三戰兩勝＋保留陣型＋沒讓子＋AI 卡池相同（雙人：snake5、不累積） | Codex 實作第 1 輪：只改局數也會被當成標準戰績 |
| 缺字符號 | — | ⚖ ⚙ ▸ ◂ ▾ ✕ ✗ ✦ ✛ 思源黑體沒有，換成 ◎ › ‹ ▼ × ◇ ＋ | Steam Deck／Linux 沒有系統字型可以補 |

### 11.3 做了什麼
**R 線**
- `scripts/core/ruleset.gd`：三層規則、驗證、規則代碼 `NTBR1`（逐欄驗型）、差異、狂熱時間表、每手上限、系列局數、最大花費（有界背包）。
- 模擬器：可選規則；標準規則雜湊位元組不變；讓子 judge 2；兩方戰力記錄；沙盒（倍率套到波及、敲人、補血；12 個技能開關）。
- Army：卡池、人數、單種上限、防卡死；輪流落子：Thue‑Morse 輪序推廣到任意手數、每手上限、累積、最後一手必須擺戰鬥兵。
- AI：卡池遮罩；後備組陣；困難 AI 吃規則（反制庫只在標準規則用、大軍或長局少一個候選、讓子用比例評分）；標準部署不額外補兵（亂數流程不變）。
- 規則大廳 `lobby_view.gd`：兩段式、6 個預設＋我的預設、三種徽章（色盲靠框線區分）、說明欄、差異清單、花不完的錢、規則代碼。
- 對戰代碼：標準規則 NTB2（位元組不變）；其他 NTB3（帶規則、雙方要有戰鬥兵）；重播、覆盤、跳轉用同一份規則。
- 存檔 v3；紀錄分欄；3 個自訂成就。

**U 線**
- 字級表（100／125／150% 整數值）、`ts()` 吸附、`tcap()`、`fit()` 下限 14、換行、多行行距 1.5。
- 三種字型角色：標題字 UoqMunThenKhung（子集 707 KB）、內文思源黑體、數字 tnum。
- `charts.gd`：中線對比長條、排名條、戰力走勢、金幣條（4 色系、三星刻度）、色盲斜線紋。
- 畫面：標題、擺放、雙人、殘局、結果（兩層）、覆盤、圖鑑、設定（四分頁）、戰鬥 HUD。

### 11.4 驗證
- 統一檢查 `GOLDEN_N=1000 COMPAT_N=1000`：測試 188 項、金標準 1000（加鎖檔）、舊兵相容 1000、40 筆封存 NTB2（逐 tick 指紋）、鏡像 100、打轉、素材、字型涵蓋（含標題字）全過。
- 第五輪新測試：規則代碼來回與壞資料、讓子判定（公式邊界＋實跑到時間到 12 場）、狂熱時間表、系列結束（遊戲實際用的函式）、1024 卡池窮舉（AI 組陣）、1023 卡池 × 落子方式 × 手數 × 預算 × 人數 × 單種上限 × 累積的輪流落子終止、雙方不同卡池配對、防卡死、沙盒 12 技能開關與不污染、NTB3 保真、自訂／沙盒紀錄副作用、存檔 v3 遷移。
- 版面檢查：中英 × 100／125／150%，180 張 0 違規。規則：重疊、越界、表外字級、小於 14、戰場字越界、相同字串重疊、點擊框 <36、文字壓到按鈕（按鈕標籤在繪製時標記）、文字段數上限、畫面集合。
