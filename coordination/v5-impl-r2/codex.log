   105	## 值＝藍比例 ÷（藍比例＋紅比例），以 50% 為界上藍下紅；雙方都 0 時沿用上一點；最後一段做平滑（第五輪 §4.3）。
   106	## marks＝[{t, label}] 最多畫 3 個，標籤不重疊。回傳每個取樣點的 y（測試用）。
   107	static func momentum(ui, rect: Rect2, log2: PackedInt64Array, b0: int, b1: int, marks: Array, total_ticks := 0) -> Array:
   108		var cb: bool = ui.cbm()
   109		var n := log2.size() / 2
   110		var mid := rect.position.y + rect.size.y / 2
   111		ui.draw_rect(rect, Color(0, 0, 0, 0.25))
   112		ui.draw_line(Vector2(rect.position.x, mid), Vector2(rect.end.x, mid), Color(1, 1, 1, 0.35), 1.0)
   113		if n <= 1:
   114			return []
   115		var span := maxi(n, total_ticks)
   116		var cols := int(minf(rect.size.x, 240.0))
   117		var ys: Array = []
   118		var last := 0.5
   119		for k in cols + 1:
   120			var t := mini(n - 1, int(float(k) / cols * (span - 1)))
   121			if float(k) / cols * (span - 1) > n - 1:
   122				break
   123			var p0 := float(log2[2 * t]) / maxf(1.0, b0)
   124			var p1 := float(log2[2 * t + 1]) / maxf(1.0, b1)
   125			var v := last
   126			if p0 + p1 > 0.0:
   127				v = p0 / (p0 + p1)
   128				# 雙方都快打光時分母很小，曲線會劇烈跳：剩不到 6% 時向上一點靠攏
   129				if p0 + p1 < 60.0:
   130					v = lerpf(last, v, 0.35)
   131			last = v
   132			ys.append(v)
   133		var dx := rect.size.x / cols
   134		for k in ys.size():
   135			var x := rect.position.x + k * dx
   136			var y: float = rect.end.y - rect.size.y * ys[k]
   137			if y < mid:
   138				ui.draw_rect(Rect2(x, y, dx + 0.5, mid - y), team_col(0, cb) * Color(1, 1, 1, 0.85))
   139			else:
