    44		return p >= 31 and (p & (p + 1)) == 0
    45	
    46	## 徽章：動到沙盒＝沙盒；驗證過的組合＝平衡認證；其他＝娛樂變體。
    47	## 對 AI：100 金、24 隻、不限單種、90 秒、前綴卡池（第四輪驗收的條件）。
    48	## 雙人：再加上經典 5 種＋snake5（第四輪 snake5 三種 AI 強度都在 45～55%）。
    49	static func badge(r, kind: String) -> String:
    50		if r.is_sandbox():
    51			return BADGE_LAB
    52		var base: bool = r.budget_of(0) == 100 and r.budget_of(1) == 100 and r.unit_cap == 24 and r.type_cap == 0 and r.ticks == 1800
    53		if kind == "ai":
    54			return BADGE_CERT if base and is_prefix(r.pool_of(0)) and r.pool_of(1) == r.pool_of(0) else BADGE_FUN
    55		return BADGE_CERT if base and r.pool_of(0) == 31 and r.pool_of(1) == 31 and r.place_rule == "snake5" and not r.carry else BADGE_FUN
    56	
    57	## 算不算「標準紀錄」（標準戰績、標準成就；Codex 實作第 1 輪：和「平衡認證」分開判定）。
    58	## 除了認證條件，系列也要是標準的：三戰兩勝、保留陣型、沒有讓子；對 AI 卡池兩邊相同；雙人 snake5、不累積。
    59	static func is_standard_record(r, kind: String) -> bool:
    60		if badge(r, kind) != BADGE_CERT:
    61			return false
    62		if r.rounds != 3 or not r.keep_formation or r.handicap:
    63			return false
    64		if kind == "ai":
    65			return r.ai_pool_same
    66		return r.place_rule == "snake5" and not r.carry
    67	
    68	## 部署限制是不是「標準」（前 N 種卡池、24 隻、不限單種、100 金）：對戰代碼可以用舊格式 NTB2、AI 不額外補兵。
    69	static func deploy_standard(r) -> bool:
    70		return r.unit_cap == 24 and r.type_cap == 0 and r.budget_of(0) == 100 and r.budget_of(1) == 100 and is_prefix(r.pool_of(0)) and is_prefix(r.pool_of(1))
    71	
    72	## 大廳卡池能選的兵：對 AI＝已解鎖的；雙人＝全部（試玩版＝前 7 種）。
    73	static func selectable(kind: String, unlocked: int, demo: bool) -> int:
    74		var all_p: int = RSET.prefix_pool(7) if demo else RSET.all_pool()
    75		return (unlocked & all_p) if kind == "ai" else all_p
    76	
    77	## 把規則裡不能選的兵拿掉（解鎖進度、試玩版）；拿掉後沒有戰鬥兵就退回可選的全部。回傳被拿掉的兵種。
    78	static func clamp_pool(r, kind: String, unlocked: int, demo: bool) -> Array:
    79		var sel := selectable(kind, unlocked, demo)
    80		var removed: Array = []
    81		for tm in 2:
    82			var p := int(r.pool[tm])
    83			for t in D.COUNT:
    84				if RSET.has(p, t) and not RSET.has(sel, t) and not t in removed:
    85					removed.append(t)
    86			p &= sel
    87			if not RSET.has_combat(p):
    88				p = sel
    89			r.pool[tm] = p
    90		return removed
     1	extends RefCounted
     2	## 困難 AI（第四輪）：真的「讀你上一局」。
     3	## 第 1 局沒有資訊 → 用原型模板組（和普通 AI 同一套，不會比普通弱）。
     4	## 第 2 局起 → 準備幾個候選陣型（反制庫裡最接近的那筆、兩套模板陣、會讀對方的落子 AI 陣），
     5	## 各拿去和你上一局的陣型模擬一場，挑打得最好的。只看你「上一局」公開過的陣型，不偷看這一局。
     6	## 遊戲（game_screens._hard_ai）和反制庫驗證（tools/make_counter_lib.gd）共用這一個函式。
     7	## 第三輪的做法（查不到反制就退回落子 AI）在第四輪新模板加入後，對驗證池反而比普通 AI 弱（73.0% vs 74.0%），所以改成這樣。
     8	
     9	const D = preload("res://scripts/core/unit_defs.gd")
    10	const Army = preload("res://scripts/core/army.gd")
    11	const Sim = preload("res://scripts/core/battle_sim.gd")
    12	const AI = preload("res://scripts/core/ai_army.gd")
    13	const AIT = preload("res://scripts/core/ai_turns.gd")
    14	const F = preload("res://scripts/core/formations.gd")
    15	const RS = preload("res://scripts/core/ruleset.gd")
    16	
    17	## known：玩家上一局的兵（藍方座標）；entries：反制庫；回傳紅方陣型。
    18	## pool：紅方卡池遮罩（-1＝全部）；rules：第五輪 Ruleset（null＝標準）。
    19	## 反制庫只在「規則和標準一樣」時用（第五輪 §3.2）；大軍或長局時少一個候選（效能探測：40＋40、150 秒一場可達數秒）。
    20	static func build(known: Array, entries: Array, rng: RandomNumberGenerator, pool := -1, rules = null) -> Army:
    21		if pool < 0:
    22			pool = RS.all_pool()
    23		var bud: int = 100 if rules == null else rules.budget_of(1)
    24		var cands: Array = []
    25		cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
    26		if known.is_empty():
    27			return cands[0]
    28		var heavy: bool = rules != null and (rules.unit_cap > 24 or rules.ticks > 1800)
    29		if not heavy:
    30			cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
    31		var full := AIT.build_full(1, rng, 2, known, pool, rules)
    32		cands.append(full)
    33		if rules == null or _standard_like(rules):
    34			var lib := pick_counter(entries, known, pool)
    35			if lib != null:
    36				cands.append(lib)
    37		var me := Army.new(0, 100 if rules == null else rules.budget_of(0))
    38		for u in known:
    39			me.units.append({"type": int(u["type"]), "col": int(u["col"]), "row": int(u["row"])})
    40		var best: Army = cands[0]
    41		var bs := -(1 << 40)
    42		for c in cands:
    43			var s = Sim.new(me.copy(), c.copy(), rules)
    44			s.fast = true
    45			s.run_to_end()
    46			# 讓子局用各自預算的比例評分（Codex 實作第 1 輪）；標準局算式不變
    47			var sc: int = (1000000 + s.power(1)) if s.winner == 1 else (s.power(1) - s.power(0))
    48			if s.judge == 2:
    49				sc = (1000000 + s.power_permille(1)) if s.winner == 1 else (s.power_permille(1) - s.power_permille(0))
    50			if sc > bs:
    51				bs = sc
    52				best = c
    53		return best
    54	
    55	## 反制庫：組成最接近玩家陣型的原型的反制（距離 ≤40）；用到未開放兵種的不算。
    56	static func _standard_like(r) -> bool:
    57		return r.budget_of(0) == 100 and r.budget_of(1) == 100 and r.unit_cap == 24 and r.type_cap == 0 and r.sim_is_legacy()
    58	
    59	static func pick_counter(entries: Array, known: Array, pool: int) -> Army:
    60		if entries.is_empty():
    61			return null
    62		var mine := D.zeros()
    63		for u in known:
    64			mine[int(u["type"])] += D.cost(int(u["type"]))
    65		var best = null
    66		var bd := 1 << 30
    67		for e in entries:
    68			var pc: Array = e["proto_comp"]
    69			var d := 0
    70			for k in mine.size():
    71				d += absi((int(pc[k]) if k < pc.size() else 0) - int(mine[k]))
    72			if d < bd:
    73				bd = d
    74				best = e
    75		if best == null or bd > 40:
    76			return null
    77		var a := Army.new(1, 100)
    78		if a.load_code(str(best["code"])) != "":
    79			return null
    80		for u in a.units:
    81			if not RS.has(pool, int(u["type"])):
    82				return null
    83		return a
     1	extends RefCounted
     2	## 自訂規則（第五輪 §3）。純資料，不碰畫面。三層：
     3	##   模擬規則：兩邊預算、一局 tick 數、判定版本、（沙盒）數值倍率與技能開關 → 進模擬雜湊與對戰代碼
     4	##   部署規則：人數上限、單種上限、雙方卡池 → 進對戰代碼（重播要驗陣型合法）
     5	##   系列規則：局數、落子方式、手數、累積、保留陣型、AI 難度 → 只在大廳與系列流程用
     6	## 標準規則下模擬器走原本的路徑（雜湊表頭位元組不變），所以這個檔案**不能**把常數放進 unit_defs.gd（會改數值摘要）。
     7	## 開戰時用 copy() 凍結一份，之後大廳再怎麼改都不影響這一局。
     8	
     9	const D = preload("res://scripts/core/unit_defs.gd")
    10	
    11	const CODE_PREFIX := "NTBR1"
    12	const STD_BUDGET := 100
    13	const STD_TICKS := 1800
    14	const STD_UNIT_CAP := 24
    15	const TICK_CHOICES := [1200, 1800, 2400, 3000]     # 60／90／120／150 秒
    16	const BUDGET_MIN := 30
    17	const BUDGET_MAX := 200
    18	const UNIT_CAP_MIN := 4
    19	const UNIT_CAP_MAX := 40       # 效能探測（docs/perf/v5-probe.json）：40＋40 每 tick 約 1.3 ms，支援兵密集 2.6 ms
    20	const TYPE_CAP_MAX := 10
    21	const ROUND_CHOICES := [1, 3, 5, 7]
    22	const PLACE_RULES := ["snake5", "cap10", "blind", "custom"]
    23	const TURNS_MIN := 1
    24	const TURNS_MAX := 10
    25	const PCT_MIN := 50            # 沙盒倍率
    26	const PCT_MAX := 200
    27	const SKILLS := ["charge", "taunt", "backstab", "counter", "stealth", "brace", "splash", "heal", "drum", "breach", "frenzy", "rally"]
    28	
    29	# ── 模擬 ──
    30	var budget := [STD_BUDGET, STD_BUDGET]   # 讓子關閉時兩邊相同
    31	var handicap := false
    32	var ticks := STD_TICKS
    33	# ── 部署 ──
    34	var unit_cap := STD_UNIT_CAP
    35	var type_cap := 0              # 0＝不限
    36	var pool := [0, 0]             # 玩家（藍）／對手（紅）卡池遮罩；0 會被 validate 擋
    37	var ai_pool_same := true       # 對手卡池跟藍方一樣
    38	# ── 系列 ──
    39	var rounds := 3
    40	var place_rule := "snake5"
    41	var turns := 5                 # place_rule＝custom 時每人幾手
    42	var carry := false             # 沒花完的錢累積到下一手
    43	var keep_formation := true
    44	var ai_level := 1
    45	# ── 沙盒（R3）──
    46	var stat_pct := {}             # type → [hp%, atk%, speed%]；空＝全部 100%
    47	var skills_off: Array = []     # SKILLS 裡關掉的
    48	# 只是顯示用，不參與相等判定
    49	var preset := "standard"
    50	
    51	# ───────── 卡池工具（static，給 AI／Army 用） ─────────
    52	static func all_pool() -> int:
    53		return (1 << D.COUNT) - 1
    54	
    55	static func prefix_pool(n: int) -> int:
    56		return (1 << clampi(n, 0, D.COUNT)) - 1
    57	
    58	static func has(p: int, t: int) -> bool:
    59		return (p >> t) & 1 == 1
    60	
    61	static func types_of(p: int) -> Array:
    62		var out: Array = []
    63		for t in D.COUNT:
    64			if has(p, t):
    65				out.append(t)
    66		return out
    67	
    68	static func pool_count(p: int) -> int:
    69		return types_of(p).size()
    70	
    71	static func cheapest_in(p: int) -> int:
    72		var c := 1 << 30
    73		for t in types_of(p):
    74			c = mini(c, D.cost(t))
    75		return c
    76	
    77	static func cheapest_combat_in(p: int) -> int:
    78		var c := 1 << 30
    79		for t in types_of(p):
    80			if not D.is_support(t):
    81				c = mini(c, D.cost(t))
    82		return c
    83	
    84	static func priciest_in(p: int) -> int:
    85		var c := 0
    86		for t in types_of(p):
    87			c = maxi(c, D.cost(t))
    88		return c
    89	
    90	static func has_combat(p: int) -> bool:
    91		return cheapest_combat_in(p) < (1 << 30)
    92	
    93	# ───────── 建立 ─────────
    94	static func standard(p: int = -1):
    95		var r = load("res://scripts/core/ruleset.gd").new()
    96		var pp: int = all_pool() if p < 0 else p
    97		r.pool = [pp, pp]
    98		return r
    99	
   100	func copy():
   101		var r = load("res://scripts/core/ruleset.gd").new()
   102		r.budget = budget.duplicate()
   103		r.handicap = handicap
   104		r.ticks = ticks
   105		r.unit_cap = unit_cap
   106		r.type_cap = type_cap
   107		r.pool = pool.duplicate()
   108		r.ai_pool_same = ai_pool_same
   109		r.rounds = rounds
   110		r.place_rule = place_rule
   111		r.turns = turns
   112		r.carry = carry
   113		r.keep_formation = keep_formation
   114		r.ai_level = ai_level
   115		r.stat_pct = stat_pct.duplicate(true)
   116		r.skills_off = skills_off.duplicate()
   117		r.preset = preset
   118		return r
   119	
   120	func budget_of(team: int) -> int:
   121		return int(budget[team]) if handicap else int(budget[0])
   122	
   123	func pool_of(team: int) -> int:
   124		return int(pool[0]) if (team == 1 and ai_pool_same) else int(pool[team])
   125	
   126	func is_sandbox() -> bool:
   127		if not skills_off.is_empty():
   128			return true
   129		for t in stat_pct:
   130			for v in stat_pct[t]:
   131				if int(v) != 100:
   132					return true
   133		return false
   134	
   135	## 判定版本：兩邊預算不同（讓子）才用比例判定 2；其他都是舊判定 1（和 1.3.0 完全相同）。
   136	func judge() -> int:
   137		return 2 if budget_of(0) != budget_of(1) else 1
   138	
   139	## 模擬是否走舊路徑（雜湊位元組和 1.3.0 相同）。
   140	func sim_is_legacy() -> bool:
   141		return ticks == STD_TICKS and judge() == 1 and not is_sandbox()
   142	
   143	## 狂熱時間表（第五輪 §3.1，Codex 第二輪 ③）：起點 F＝T×2÷3、間隔 S＝T÷18，耗損在 F＋k×S（k＝0～5）。
   144	## T＝1800 時精確是 1200、100（1.3.0 的值）。
   145	func frenzy_tick() -> int:
   146		return ticks * 2 / 3
   147	
   148	func attrition_step() -> int:
   149		return maxi(1, ticks / 18)
   150	
   151	## 雙人每手上限（輪流落子）：max(預算÷手數（進位）, 卡池最貴兵價)。標準 snake5（100 金、5 手）＝20。
   152	func turn_cap(team: int) -> int:
   153		var n := 5 if place_rule == "snake5" else (10 if place_rule == "cap10" else turns)
   154		var b := budget_of(team)
   155		return maxi((b + n - 1) / n, priciest_in(pool_of(team)))
   156	
   157	func turns_per_player() -> int:
   158		return 5 if place_rule == "snake5" else (turns if place_rule == "custom" else 0)
   159	
   160	func wins_needed() -> int:
   161		return (rounds + 1) / 2
   162	
   163	## 最多打幾局：N＝1 只打 1 局；N≥3 最多 N＋2 局（平手不算勝場）。三戰兩勝最多 5 局＝1.3.0 現制。
   164	func max_rounds() -> int:
   165		return 1 if rounds <= 1 else rounds + 2
   166	
   167	# ───────── 驗證 ─────────
   168	## 回傳不合法原因的字串鍵（空陣列＝合法）。給大廳顯示、代碼匯入、開戰前檢查共用。
   169	func validate() -> Array:
   170		var bad: Array = []
   171		for tm in 2:
   172			var b := budget_of(tm)
   173			if b < BUDGET_MIN or b > BUDGET_MAX:
   174				bad.append("rr_bad_budget")
   175			var p := pool_of(tm)
   176			if p <= 0 or p > all_pool():
   177				bad.append("rr_bad_pool")
   178			elif not has_combat(p):
   179				bad.append("rr_no_combat")
   180			elif cheapest_combat_in(p) > b:
   181				bad.append("rr_cant_afford")
   182			elif place_rule != "blind" and turns_per_player() > 0 and cheapest_combat_in(p) > turn_cap(tm):
   183				bad.append("rr_turn_too_small")
   184		if not ticks in TICK_CHOICES:
   185			bad.append("rr_bad_ticks")
   186		if unit_cap < UNIT_CAP_MIN or unit_cap > UNIT_CAP_MAX:
   187			bad.append("rr_bad_cap")
   188		if type_cap < 0 or type_cap > TYPE_CAP_MAX:
   189			bad.append("rr_bad_type_cap")
   190		if not rounds in ROUND_CHOICES:
   191			bad.append("rr_bad_rounds")
   192		if not place_rule in PLACE_RULES:
   193			bad.append("rr_bad_place")
   194		if turns < TURNS_MIN or turns > TURNS_MAX:
   195			bad.append("rr_bad_turns")
   196		if ai_level < 0 or ai_level > 2:
   197			bad.append("rr_bad_ai")
   198		for t in stat_pct:
   199			if int(t) < 0 or int(t) >= D.COUNT or not stat_pct[t] is Array or stat_pct[t].size() != 3:
   200				bad.append("rr_bad_sandbox")
   201				break
   202			for v in stat_pct[t]:
   203				if int(v) < PCT_MIN or int(v) > PCT_MAX:
   204					bad.append("rr_bad_sandbox")
   205					break
   206		for s in skills_off:
   207			if not s in SKILLS:
   208				bad.append("rr_bad_sandbox")
   209				break
   210		var uniq: Array = []
   211		for b in bad:
   212			if not b in uniq:
   213				uniq.append(b)
   214		return uniq
   215	
   216	## 最多能花多少錢（大廳「花不完的錢」提示用）：有界背包，在人數上限、單種上限內求最大花費；units＝達到這個花費最少要幾隻。
   217	func max_spend(team: int) -> Dictionary:
   218		var b := budget_of(team)
   219		var inf := 1 << 20
   220		var dp: Array = []
   221		dp.resize(b + 1)
   222		dp.fill(inf)
   223		dp[0] = 0
   224		for t in types_of(pool_of(team)):
   225			var c := D.cost(t)
   226			var lim: int = b / c if type_cap == 0 else mini(type_cap, b / c)
   227			for _k in lim:
   228				for s in range(b, c - 1, -1):
   229					if dp[s - c] + 1 < dp[s]:
   230						dp[s] = dp[s - c] + 1
   231		var best := 0
   232		for s in range(b, -1, -1):
   233			if dp[s] <= unit_cap:
   234				best = s
   235				break
   236		return {"spend": best, "units": dp[best], "unused": b - best}
   237	
   238	# ───────── 相等與差異 ─────────
   239	## 和規則相等判定有關的欄位（預設名稱、AI 難度這類顯示用的不算）。固定順序。
   240	func key_fields() -> Array:
   100	
   101	# ───────────────────────── 截圖（驗證用） ─────────────────────────
   102	## 版面檢查（第三輪 T4）：這張截圖的介面文字有沒有越界、小於 9px（Steam Deck 下限）、彼此重疊超過 15%。
   103	## 第五輪 U4：新規則全部算違規——表外字級、小於字級表下限、戰場字小於 14、相同字串在不同位置重疊、點擊框小於 32px、
   104	## 「要讀的文字」段數超過上限（控制項＝按鈕、兵卡裡的字不算）。
   105	const TEXT_BUDGET := {"02_place.png": 30, "17_place_new.png": 30, "05_result.png": 20, "10_codex.png": 30, "19_codex_new.png": 30,
   106		"22_lobby.png": 25, "25_lobby_duel.png": 25, "08_settings.png": 25, "01_title.png": 12}
   107	
   108	func _layout_report(name: String) -> void:
   109		var bad: Array = []
   110		var sizes: Array = []
   111		var ui_n := 0
   112		var free_n := 0
   113		var ctrls: Array = probe_btns + probe_ctrls
   114		for t in probe_texts:
   115			var r: Rect2 = t["r"]
   116			var sz := int(t["size"])
   117			if t.get("field", false):
   118				if sz < 14:
   119					bad.append({"type": "戰場字太小", "s": t["s"], "size": sz})
   120				if r.position.x < -2 or r.end.x > 1282 or r.position.y < -2 or r.end.y > 802:
   121					bad.append({"type": "戰場字越界", "s": t["s"], "r": str(r)})
   122				continue
   123			ui_n += 1
   124			sizes.append(sz)
   125			var in_ctrl: bool = t.get("btn", false)
   126			for c in probe_ctrls:
   127				if c.grow(1.0).encloses(r):
   128					in_ctrl = true   # 整段字都在卡片／空白標籤按鈕裡＝控制項內容
   129					break
   130			if not in_ctrl:
   131				free_n += 1
   132			if r.position.x < -2 or r.end.x > 1282 or r.position.y < -2 or r.end.y > 802:
   133				bad.append({"type": "越界", "s": t["s"], "r": str(r)})
   134			if sz < tz("C"):
   135				bad.append({"type": "小於字級表下限", "s": t["s"], "size": sz})
   136			if not size_ok(sz):
   137				bad.append({"type": "表外字級", "s": t["s"], "size": sz})
   138		for a in probe_texts.size():
   139			if probe_texts[a].get("field", false):
   140				continue
   141			for b in range(a + 1, probe_texts.size()):
   142				if probe_texts[b].get("field", false):
   143					continue
   144				var ra: Rect2 = probe_texts[a]["r"]
   145				var rb: Rect2 = probe_texts[b]["r"]
   146				var x := ra.intersection(rb)
   147				if not x.has_area():
   148					continue
   149				var ratio := x.get_area() / maxf(1.0, minf(ra.get_area(), rb.get_area()))
   150				if ratio <= 0.15:
   151					continue
   152				if probe_texts[a]["s"] != probe_texts[b]["s"]:
   153					bad.append({"type": "重疊", "a": probe_texts[a]["s"], "b": probe_texts[b]["s"], "ratio": snappedf(ratio, 0.01)})
   154				elif ra.position.distance_to(rb.position) > 2.0:
   155					bad.append({"type": "相同字串重疊", "s": probe_texts[a]["s"], "ratio": snappedf(ratio, 0.01)})
   156		for r in probe_btns:
   157			if r.size.x < 36.0 or r.size.y < 36.0:   # 方案 §5.3：點擊框 ≥36px
   158				bad.append({"type": "點擊框太小", "r": str(r)})
   159		# 第五輪（Antigravity 實作第 1 輪抓到自動檢查漏的）：按鈕外的文字壓到按鈕上
   160		for t in probe_texts:
   161			if t.get("field", false):
   162				continue
   163			var tr: Rect2 = t["r"]
   164			if t.get("btn", false):
   165				continue   # 按鈕自己的標籤
   166			var inside := false
   167			for c in probe_ctrls:
   168				if c.grow(1.0).encloses(tr):
   169					inside = true
   170					break
   171			if inside:
   172				continue
   173			for br in probe_btns:
   174				var x2 := tr.intersection(br)
   175				if x2.has_area() and x2.get_area() > tr.get_area() * 0.10:
   176					bad.append({"type": "文字壓到按鈕", "s": t["s"], "btn": str(br)})
   177					break
   178		if TEXT_BUDGET.has(name) and int(Save.s("text_scale")) == 100 and free_n > int(TEXT_BUDGET[name]):
   179			bad.append({"type": "文字段數超過上限", "n": free_n, "max": TEXT_BUDGET[name]})
   180		sizes.sort()
   181		var line := JSON.stringify({"shot": name, "lang": L.lang, "scale": int(Save.s("text_scale")), "texts": ui_n, "free_texts": free_n,
   182			"median_size": sizes[sizes.size() / 2] if not sizes.is_empty() else 0, "min_size": sizes[0] if not sizes.is_empty() else 0,
   183			"violations": bad, "warnings": []})
   184		var f := FileAccess.open(shot_dir.path_join("layout.jsonl"), FileAccess.READ_WRITE if FileAccess.file_exists(shot_dir.path_join("layout.jsonl")) else FileAccess.WRITE)
   185		f.seek_end()
   186		f.store_line(line)
   187		f.close()
   188	
   189	
   190	func _snap(name: String) -> void:
   191		queue_redraw()
   192		await get_tree().process_frame
   193		await get_tree().process_frame
   194		await RenderingServer.frame_post_draw
   195		get_viewport().get_texture().get_image().save_png(shot_dir.path_join(name))
   196		print("SHOT ", name)
   197		if layout_probe:
   198			_layout_report(name)
   199	
   200	
   201	## 實機影片（N6 預告素材）：用 Godot 錄影模式跑（--write-movie 絕對路徑 --fixed-fps 30），全程自動。
   202	func _run_video() -> void:
   203		await get_tree().create_timer(2.5).timeout
   204		difficulty = 1
   205		_start_mode(Mode.VS_AI)

