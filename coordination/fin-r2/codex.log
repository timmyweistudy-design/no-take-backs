   730	# ───────────────────────── 每幀 ─────────────────────────
   731	func _process(delta: float) -> void:
   732		time += delta
   733		SteamApi.run_callbacks()
   734		if toast_t > 0:
   735			toast_t -= delta
   736		if ach_t > 0:
   737			ach_t -= delta
   738		elif not ach_queue.is_empty():
   739			toast = ach_queue.pop_front()
   740			toast_t = 2.5
   741			ach_t = 2.6
   742		shake = maxf(0.0, shake - delta)
   743		for f in fx:
   744			f["t"] += delta
   745		fx = fx.filter(func(f): return f["t"] < f["dur"])
   746		for g in dying:
   747			g["t"] += delta
   748		dying = dying.filter(func(g): return g["t"] < 1.0)
   749		if state == St.TITLE and demo != null and shot_dir == "":
   750			demo_acc += delta
   751			while demo_acc >= 0.05:
   752				demo_acc -= 0.05
   753				demo.step()
   754			if demo.finished:
   755				_new_demo()
   756		if state == St.BATTLE and shot_dir == "":
   757			_battle_process(delta)
   758		elif state == St.RESULT:
   759			zoom = lerpf(zoom, 1.0, delta * 4)
   760		queue_redraw()
