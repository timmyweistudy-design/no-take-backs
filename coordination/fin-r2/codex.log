     1	#!/usr/bin/env python3
     2	"""平衡工具 2.0 報表：合併 balance.sh 各分片的 JSONL，檢查紅線，寫 report.md 與 summary.json。
     3	用法：balance_report.py <資料夾> [總秒數]
     4	結束碼：0＝紅線全過；1＝有紅線失敗；2＝資料錯誤（零筆、數值摘要不一致）。
     5	紅線（優化方案 M）：
     6	  - 剋制五角形 10/10（matrix：剋的一方左右各打一次都要贏）
     7	  - 碾壓局（勝方剩 >50%）< 20%
     8	  - 戰鬥秒數中位數 35～75
     9	  - 勝方剩餘戰力中位數 ≤ 30%
    10	警示（列入調查，不算失敗）：
    11	  - 先手或後手勝率 > 55%
    12	  - 搜尋到保留池勝率 > 65% 的陣型
    13	  - 鎖定時間比中位數 < 0.4（垃圾時間太長）
    14	"""
    15	import json, sys, glob, os, statistics as st
    16	
    17	NAMES = ["劍士", "盾兵", "弓箭手", "騎兵", "刺客"]
    18	BEATS = {0: [4, 1], 1: [3, 2], 2: [0, 4], 3: [2, 0], 4: [1, 3]}
    19	
    20	def load(folder):
    21	    rows = {}
    22	    for f in sorted(glob.glob(os.path.join(folder, "*.jsonl"))):
    23	        key = os.path.basename(f).rsplit("_", 1)[0]
    24	        for line in open(f, encoding="utf-8"):
    25	            line = line.strip()
    26	            if line:
    27	                rows.setdefault(key, []).append(json.loads(line))
    28	    return rows
    29	
    30	def pct(a, b):
    31	    return 0 if b == 0 else round(100 * a / b)
    32	
    33	def main():
    34	    folder = sys.argv[1]
    35	    secs = sys.argv[2] if len(sys.argv) > 2 else "?"
    36	    rows = load(folder)
    37	    total = sum(len(v) for v in rows.values())
    38	    if total == 0:
    39	        print("✗ 零筆結果"); sys.exit(2)
    40	    # 完整性（Codex N1-r1 #6）：每個模式的筆數要對、不能有重複鍵；依鍵排序
    41	    man_path = os.path.join(folder, "manifest.json")
    42	    if not os.path.exists(man_path):
    43	        print("✗ 沒有 manifest.json，無法確認資料完整"); sys.exit(2)
    44	    man = json.load(open(man_path))
    45	    if not isinstance(man.get("modes"), list) or not man["modes"] or not isinstance(man.get("shards"), int) or man["shards"] <= 0:
    46	        print("✗ manifest.json 不合法"); sys.exit(2)
    47	    shards = man["shards"]
    48	    allowed = {"matrix", "league", "turns:cap10", "turns:snake5", "turns:snake5c", "search", "counter", "countersearch"}
    49	    bad_modes = [m for m in man["modes"] if m not in allowed]
    50	    if bad_modes:
    51	        print(f"✗ manifest 有不合法的模式：{bad_modes}"); sys.exit(2)
    52	    # 分片檔完整性（Codex N1-r3 #6）：每個模式 0～shards-1 片都要在，也不能有 manifest 以外的檔案
    53	    have = {os.path.basename(f) for f in glob.glob(os.path.join(folder, "*.jsonl"))}
    54	    want_files = {f"{m.replace(':', '_')}_{i}.jsonl" for m in man["modes"] for i in range(man["shards"])}
    55	    if have != want_files:
    56	        print(f"✗ 分片檔不完整：缺 {sorted(want_files - have)[:5]}、多 {sorted(have - want_files)[:5]}"); sys.exit(2)
    57	    errs = [r for v in rows.values() for r in v if "error" in r]
    58	    if errs:
    59	        print(f"✗ 有 {len(errs)} 筆執行錯誤（例：{errs[0]}）"); sys.exit(2)
    60	    expect = {"matrix": 20, "league": 200 * 12 * 2, "search": shards, "counter": 6, "countersearch": shards}
    61	    keyset = {
    62	        "matrix": {(a, b) for a in range(5) for b in range(5) if a != b},
    63	        "league": {(a, k, s) for a in range(200) for k in range(12) for s in range(2)},
    64	        "search": {(s,) for s in range(shards)},
    65	        "counter": {(t,) for t in range(6)},
    66	        "countersearch": {(s,) for s in range(shards)},
    67	    }
    68	    keyf = {"matrix": ("a", "b"), "league": ("a", "k", "side"), "search": ("shard",), "counter": ("template",),
    69	            "countersearch": ("shard",)}
    70	    for m in man["modes"]:
    71	        key = m.replace(":", "_")
    72	        got = rows.get(key, [])
    73	        base = m.split(":")[0]
    74	        exp = 400 if base == "turns" else expect.get(base)
    75	        want = {(g,) for g in range(400)} if base == "turns" else keyset.get(base)
    76	        kf = ("game",) if base == "turns" else keyf.get(base, ())
    77	        keys = [tuple(r.get(k) for k in kf) for r in got]
    78	        if exp is not None and len(got) != exp:
    79	            print(f"✗ {m} 筆數 {len(got)}，預期 {exp}"); sys.exit(2)
    80	        if len(set(keys)) != len(keys):
    81	            print(f"✗ {m} 有重複的場次"); sys.exit(2)
    82	        if want is not None and set(keys) != want:
    83	            print(f"✗ {m} 場次鍵集合不對（少 {len(want - set(keys))}、多 {len(set(keys) - want)}）"); sys.exit(2)
    84	        rows[key] = [r for _, r in sorted(zip(keys, got), key=lambda kv: kv[0])]
    85	    digests = {r.get("digest") for v in rows.values() for r in v}
    86	    if None in digests or "" in digests:
    87	        print("✗ 有資料缺少數值摘要"); sys.exit(2)
    88	    if len(digests) != 1:
    89	        print("✗ 數值摘要不一致：", digests); sys.exit(2)
    90	    md = [f"# 平衡報表 2.0\n", f"- 數值摘要 `{digests.pop()}`、共 {total} 筆、耗時 {secs} 秒\n"]
    91	    fails, warns, summary = [], [], {}
    92	
    93	    if "matrix" in rows:
    94	        m = {}
    95	        for r in rows["matrix"]:
    96	            m[(r["a"], r["b"])] = r
    97	        ok = 0
    98	        md.append("\n## ① 剋制矩陣（各 60 金；列兵種對行兵種：勝/平/負，括號＝勝方剩餘%）\n\n| | " + " | ".join(NAMES) + " |\n|" + "---|" * 6 + "\n")
    99	        for a in range(5):
   100	            cells = []
   101	            for b in range(5):
   102	                if a == b:
   103	                    cells.append("—"); continue
   104	                r1, r2 = m.get((a, b)), m.get((b, a))
   105	                wins = (r1["res"] == 1) + (r2["res"] == -1)
   106	                loss = (r1["res"] == -1) + (r2["res"] == 1)
   107	                cells.append(f"{wins}/{2-wins-loss}/{loss} ({r1['rem']})")
   108	            md.append(f"| {NAMES[a]} | " + " | ".join(cells) + " |\n")
   109	        for a, bs in BEATS.items():
   110	            for b in bs:
   111	                r1, r2 = m[(a, b)], m[(b, a)]
   112	                if r1["res"] == 1 and r2["res"] == -1:
   113	                    ok += 1
   114	        md.append(f"\n剋制成立 **{ok}/10**\n")
   115	        summary["pentagon"] = ok
   116	        if ok < 10:
   117	            fails.append(f"剋制只成立 {ok}/10")
   118	
   119	    if "league" in rows:
   120	        L = rows["league"]
   121	        dec = [r for r in L if r["res"] != 0]
   122	        rem = [r["rem"] for r in dec]
   123	        sec = [r["ticks"] / 20 for r in L]
   124	        lock = [r["lock"] / 1000 for r in dec]
   125	        lc = [r["lc"] for r in L]
   126	        swing = [r["swing"] for r in dec]
   127	        blow = pct(sum(1 for x in rem if x > 50), len(rem))
   128	        close = pct(sum(1 for x in rem if x <= 30), len(rem))
   129	        med_rem = st.median(rem) if rem else 0
   130	        med_sec = st.median(sec)
   131	        med_lock = st.median(lock) if lock else 0
   132	        summary.update(league_games=len(L), median_rem=med_rem, blowout_pct=blow, close_pct=close, median_secs=med_sec,
   133	                       median_lock=med_lock, lead_change_pct=pct(sum(1 for x in lc if x >= 1), len(lc)),
   134	                       comeback_pct=pct(sum(1 for x in swing if x >= 15), len(swing)),
   135	                       draw_pct=pct(len(L) - len(dec), len(L)), timeout_pct=pct(sum(1 for r in L if r["timeout"]), len(L)))
   136	        md.append(f"\n## ② 陣型聯賽（訓練池 200 套 × 12 對手 × 交換左右 = {len(L)} 場）\n\n")
   137	        md.append(f"| 指標 | 數值 | 目標 |\n|---|---|---|\n")
   138	        md.append(f"| 勝方剩餘戰力中位數 | {med_rem}% | ≤30% |\n| 接近局（勝方剩 ≤30%） | {close}% | — |\n| 碾壓局（勝方剩 >50%） | {blow}% | <20% |\n")
   139	        md.append(f"| 戰鬥秒數中位數 | {med_sec:.1f} | 35～75 |\n| 鎖定時間比中位數 | {med_lock:.2f} | ≥0.65 理想、<0.4 警示 |\n")
   140	        md.append(f"| 有領先交換的場次 | {summary['lead_change_pct']}% | — |\n| 翻盤局（贏家曾落後 ≥15%） | {summary['comeback_pct']}% | — |\n")
   141	        md.append(f"| 平手 | {summary['draw_pct']}% | — |\n| 時間到 | {summary['timeout_pct']}% | — |\n")
   142	        if blow >= 20: warns.append(f"全池碾壓局 {blow}%（全池含亂擺陣型，只當參考）")
   143	        if not (35 <= med_sec <= 75): fails.append(f"秒數中位數 {med_sec:.1f}")
   144	        if med_rem > 30: warns.append(f"全池勝方剩餘中位數 {med_rem}%（只當參考）")
   145	        if med_lock < 0.4: warns.append(f"鎖定時間比中位數 {med_lock:.2f} < 0.4")
