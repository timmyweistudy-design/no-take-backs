## app_id：0＝由 Steam 啟動時決定（正式上架）；開發測試可給 480（Valve 公開測試 App「Spacewar」）。
## sync_local：初始化後把本機成就補送到 Steam。自我檢查一定傳 false（不寫入任何東西）。
## GodotSteam 4.23.2 的簽章是 steamInitEx(app_id: int = 0, embed_callbacks: bool = false)（用 ClassDB 查過）。
static func init(app_id := 0, sync_local := true) -> void:
	if Engine.has_singleton("Steam"):
		_steam = Engine.get_singleton("Steam")
		var r = _steam.steamInitEx(app_id) if app_id > 0 else _steam.steamInitEx()
		init_result = r
		if typeof(r) == TYPE_DICTIONARY and int(r.get("status", 1)) != 0:
			_steam = null
	if _steam != null and sync_local:
		# 離線時解鎖、只記在本機的成就，這裡補送到 Steam（沒有就不呼叫 storeStats）
		var got: Array = Save.data.get("achievements", [])
		if not got.is_empty():
			for id in got:
				_steam.setAchievement(id)
			_steam.storeStats()

static func available() -> bool:
	return _steam != null

static func name_of(id: String, lang: String) -> String:
	var n: Array = ACHIEVEMENTS.get(id, [id, id])
	return n[0] if lang == "zh_TW" else n[1]

## 解鎖成就；回傳 true 表示這次是新解鎖（畫面要跳提示）。
static func unlock(id: String) -> bool:
	var got: Array = Save.data.get("achievements", [])
	if id in got:
		return false
	got.append(id)
	Save.data["achievements"] = got
	Save.save_data()
	if _steam != null:
		_steam.setAchievement(id)
		store_ok = bool(_steam.storeStats())   # 第七輪 R7：送不出去就記著，run_callbacks 定期重試
	return true

## 唯讀自我檢查（N8）：init 時不補送、只用讀取函式；不解鎖、不寫統計、不初始化輸入。
## 回傳每一項結果與總判定 ok（任何一項不符就是 false，呼叫端用它決定結束碼）。
static func self_test(expect_app_id: int) -> Dictionary:
	var out := {"has_singleton": Engine.has_singleton("Steam"), "init": str(init_result), "available": available(), "ok": false}
	if _steam == null:
		out["why"] = "沒有 GodotSteam 或初始化失敗"
		return out
	out["logged_on"] = _steam.loggedOn()
	out["app_id"] = _steam.getAppID()
	out["running"] = _steam.isSteamRunning()
	# 第七輪 S4：Spacewar 和正式 App 分開驗
	if expect_app_id == 480:
		var known = _steam.getAchievement("ACH_WIN_ONE_GAME")    # Spacewar 真的有的成就：讀取應該成功
		var ours = _steam.getAchievement("FIRST_WIN")            # 我們的 ID 在 480 不存在：讀取應該失敗
		out["known_read_ok"] = typeof(known) == TYPE_DICTIONARY and bool(known.get("ret", false))
		out["our_id_missing"] = typeof(ours) == TYPE_DICTIONARY and not bool(ours.get("ret", true))
		out["ok"] = out["logged_on"] and int(out["app_id"]) == expect_app_id and out["known_read_ok"] and out["our_id_missing"]
	else:
		# 正式 App：後台的成就清單要和程式一字不差
		var missing: Array = []
		for id in ACHIEVEMENTS:
			var r = _steam.getAchievement(id)
			if typeof(r) != TYPE_DICTIONARY or not bool(r.get("ret", false)):
				missing.append(id)
		out["missing_achievements"] = missing
		out["ok"] = out["logged_on"] and int(out["app_id"]) == expect_app_id and missing.is_empty()
	if not out["ok"]:
		out["why"] = "有檢查項不符"
	return out

## 手把貼不了剪貼簿（第七輪 N4）：Steam 的大字幕鍵盤。回傳 false＝沒有 Steam 或不支援，呼叫端要自己提示。
## 這段只有接上 Steam 才跑得到，還沒實機驗（ClassDB 查過簽章：input_mode、line_input_mode、description、max_text、preset_text）。
static func text_input(description: String, max_len: int, done: Callable) -> bool:
	if _steam == null or not _steam.has_method("showGamepadTextInput"):
		return false
	if not _steam.is_connected("gamepad_text_input_dismissed", done):
		_steam.connect("gamepad_text_input_dismissed", done, CONNECT_ONE_SHOT)
	var ok := bool(_steam.showGamepadTextInput(0, 0, description, max_len, ""))
	if not ok and _steam.is_connected("gamepad_text_input_dismissed", done):
		_steam.disconnect("gamepad_text_input_dismissed", done)   # V1.2.1 F3：鍵盤沒開成要解除，不然下次關閉會觸發舊動作
	return ok

static func run_callbacks() -> void:
	if _steam != null:
		_steam.run_callbacks()
		if not store_ok:
			_retry_tick += 1
			if _retry_tick >= 600:
				_retry_tick = 0
				store_ok = bool(_steam.storeStats())
extends RefCounted
## 對戰代碼（第三輪 F3）：把雙方陣型、規則版本、數值摘要編成一串，貼給朋友就能看同一場。
## 格式：NTB2.<base64url(JSON)>.<校驗 6 碼>。JSON：{a/b: 雙方陣型代碼, ba/bb: 雙方預算, r: 規則版本, d: 數值摘要}
## 規則或數值不同時仍可以播，但結果可能不同，所以解碼會回報 mismatch 讓畫面提示。

const Army = preload("res://scripts/core/army.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const RSET = preload("res://scripts/core/ruleset.gd")
## 第五輪：自訂規則的對戰代碼用 NTB3（多一欄 rules＝規則代碼）。標準規則仍輸出 NTB2，位元組和 1.3.0 相同。

## 這組規則能不能用舊格式 NTB2 重播（模擬走舊路徑、陣型在舊的人數上限內）。
static func needs_v3(rules) -> bool:
	# Codex 實作第 1 輪：卡池、人數、單種上限有任何不標準就用 NTB3，分享後規則不會遺失
	return rules != null and (not rules.sim_is_legacy() or not load("res://scripts/game/presets.gd").deploy_standard(rules))

static func encode(a0, a1, rules = null, cmds: Array = []) -> String:
	if rules != null and rules.cmd_on():
		# 第十二輪 NTB7：手動技能要連施放紀錄一起存，才播得出同一場
		var j7 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.version_of([a0, a1]), "d": D.digest_of([a0, a1]), "rules": rules.to_code(), "c": cmds})
		var body7 := Marshalls.utf8_to_base64(j7).replace("+", "-").replace("/", "_").replace("=", "")
		return "NTB7.%s.%s" % [body7, body7.sha256_text().substr(0, 6)]
	if D.uses_new([a0, a1]):
		# 第八輪：用到新兵走 NTB4（新版 NTB2／3／4 都讀；舊版讀到會回報格式不對）
		var j4 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.version_of([a0, a1]), "d": D.digest_of([a0, a1]), "rules": rules.to_code() if rules != null else ""})
		var body4 := Marshalls.utf8_to_base64(j4).replace("+", "-").replace("/", "_").replace("=", "")
		return "NTB4.%s.%s" % [body4, body4.sha256_text().substr(0, 6)]
	if needs_v3(rules):
		var j3 := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest(), "rules": rules.to_code()})
		var body3 := Marshalls.utf8_to_base64(j3).replace("+", "-").replace("/", "_").replace("=", "")
		return "NTB3.%s.%s" % [body3, body3.sha256_text().substr(0, 6)]
	var j := JSON.stringify({"a": a0.to_code(), "b": a1.to_code(), "ba": a0.budget, "bb": a1.budget, "r": D.RULES_VERSION, "d": D.data_digest()})
	var body := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
	return "NTB2.%s.%s" % [body, body.sha256_text().substr(0, 6)]

## 回傳 {ok, why, a0, a1, mismatch, rules}（NTB2 的 rules＝null＝用 1.3.0 舊判定重播）
static func decode(code: String) -> Dictionary:
	var c := code.strip_edges()
	if c.length() > 8000:
		return {"ok": false, "why": "format"}
	var parts := c.split(".")
	if parts.size() != 3 or (parts[0] != "NTB2" and parts[0] != "NTB3" and parts[0] != "NTB4" and parts[0] != "NTB7"):
		return {"ok": false, "why": "format"}
	if parts[1].sha256_text().substr(0, 6) != parts[2]:
		return {"ok": false, "why": "checksum"}
	var b64 := parts[1].replace("-", "+").replace("_", "/")
	while b64.length() % 4 != 0:
		b64 += "="
	var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
	if not j is Dictionary or not j.has("a") or not j.has("b"):
		return {"ok": false, "why": "body"}
extends RefCounted
## 困難 AI（第四輪）：真的「讀你上一局」。
## 第 1 局沒有資訊 → 用原型模板組（和普通 AI 同一套，不會比普通弱）。
## 第 2 局起 → 準備幾個候選陣型（反制庫裡最接近的那筆、兩套模板陣、會讀對方的落子 AI 陣），
## 各拿去和你上一局的陣型模擬一場，挑打得最好的。只看你「上一局」公開過的陣型，不偷看這一局。
## 遊戲（game_screens._hard_ai）和反制庫驗證（tools/balance/make_counter_lib.gd）共用這一個函式。
## 第三輪的做法（查不到反制就退回落子 AI）在第四輪新模板加入後，對驗證池反而比普通 AI 弱（73.0% vs 74.0%），所以改成這樣。

const D = preload("res://scripts/core/unit_defs.gd")
const Army = preload("res://scripts/core/army.gd")
const Sim = preload("res://scripts/core/battle_sim.gd")
const AI = preload("res://scripts/core/ai_army.gd")
const AIT = preload("res://scripts/core/ai_turns.gd")
const F = preload("res://scripts/core/formations.gd")
const RS = preload("res://scripts/core/ruleset.gd")

## known：玩家上一局的兵（藍方座標）；entries：反制庫；回傳紅方陣型。
## pool：紅方卡池遮罩（-1＝全部）；rules：第五輪 Ruleset（null＝標準）。
## 反制庫只在「規則和標準一樣」時用（第五輪 §3.2）；大軍或長局時少一個候選（效能探測：40＋40、150 秒一場可達數秒）。
static func build(known: Array, entries: Array, rng: RandomNumberGenerator, pool := -1, rules = null) -> Army:
	if pool < 0:
		pool = RS.all_pool()
	var bud: int = 100 if rules == null else rules.budget_of(1)
	var cands: Array = []
	cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
	if known.is_empty():
		return cands[0]
	var heavy: bool = rules != null and (rules.unit_cap > 24 or rules.ticks > 1800)
	if not heavy:
		cands.append(AI.build(1, bud, rng, -1, pool, rules)["army"])
	var full := AIT.build_full(1, rng, 2, known, pool, rules)
	cands.append(full)
	if rules == null or _standard_like(rules):
		var lib := pick_counter(entries, known, pool)
		if lib != null:
			cands.append(lib)
	var me := Army.new(0, 100 if rules == null else rules.budget_of(0))
	if rules != null and rules.is_free():
		me.deploy = "free"   # 第六輪：上一局是自由陣型，照原座標模擬
	for u in known:
		if u.has("x"):
			me.units.append({"type": int(u["type"]), "x": int(u["x"]), "y": int(u["y"])})
		elif me.deploy == "free":
			me.units.append({"type": int(u["type"]), "x": int(u["col"]) * 1000 + 500, "y": int(u["row"]) * 1000 + 500})
		else:
