# 平衡調整方案（2026-11-01；**F1 已於同日套用**，報表與實驗完全一致，Windows／Linux 指紋 612786773464）

使用者要求：劍士削弱、弓箭手加強、血量全部加倍、盡量拉長一局；先不要實作，列出完整方案。
做法：在暫存複本裡改數值，跑 10 組平衡報表（`docs/balance-runs/`），正式遊戲數值沒動。

## 結果總表
「剋制」＝五角形 10 組剋制關係成立幾組。「秒數」＝AI 陣型聯賽 552 場的戰鬥秒數中位數。

| 方案 | 內容 | 剋制 | 秒數 | 勝方剩餘中位 | 碾壓局 | 陣型勝率範圍 |
|---|---|---|---|---|---|---|
| 現行 | 原型數值 | 6/10 | 23.1 | 27% | 12% | 17%～78% |
| V0 | 只有血量 ×2 | 6/10 | 38.5 | 30% | 15% | 13%～81% |
| V1 | 血量×2＋劍士削弱＋弓箭手加強（使用者原話） | 8/10 | 32.6 | 34% | 24% | 11%～**91%** |
| V2 | V1＋盾兵拒馬＋潛行 2 秒 | 9/10 | 32.9 | 34% | 25% | 11%～91% |
| V3 | V2＋騎兵、刺客微調 | 9/10 | 32.8 | 33% | 23% | 15%～91% |
| V4 | V2＋騎兵皮甲＋弓手攻擊回調 12 | 9/10 | 40.9 | 24% | 8% | 29%～64% |
| **V5** | V4，血量改 ×2.5 | 9/10 | **50.6** | 25% | **5%** | 29%～59% |
| V6 | V4，弓手攻擊 14＋漲價 5 金 | 9/10 | 37.5 | 27% | 10% | 31%～60% |
| V7 | V4＋衝鋒只要 2 格 | 9/10 | 40.9 | 25% | 8% | 29%～65% |
| **F1** | **V5＋弓手射刺客 ×1.5** | **10/10** | **50.4** | 26% | 9% | 23%～64% |
| F2 | V5＋潛行縮到 1.5 秒 | 9/10 | 48.9 | 25% | 5% | 32%～58% |

## 推薦：F1
目標：剋制 10/10、秒數 35～75、勝方剩餘 ≤30%、碾壓 <20% —— **四項全達標**。

| | 價錢 | 血量 | 攻擊 | 間隔 | 距離 | 速度 | 特性變動 |
|---|---|---|---|---|---|---|---|
| 劍士 | 4→**5** | 100→**250** | 12→**10** | 1.0 秒 | 0.7 | 1.2 | — |
| 盾兵 | 5 | 180→**450** | 6 | 1.2 秒 | 0.7 | 0.9 | **新「拒馬」：打騎兵 ×2** |
| 弓箭手 | 4 | 60→**150** | 10→**12** | 1.4→**1.2 秒** | 6 | 1.0 | **警覺加碼：射刺客 ×1.5** |
| 騎兵 | 7 | 140→**350** | 14 | 1.1 秒 | 0.75 | 2.4 | **新「皮甲」：被箭射 ×1/2** |
| 刺客 | 6 | 70→**175** | 20 | 0.8 秒 | 0.7 | 1.8 | 潛行 3→**2 秒** |

每 1 金換算（調整後）：
| | 每秒傷害／金 | 血量／金 |
|---|---|---|
| 劍士 | 3.0→2.0 | 25→50 |
| 盾兵 | 1.0 | 36→90 |
| 弓箭手 | 1.8→2.5 | 15→37.5 |
| 騎兵 | 1.8 | 20→50 |
| 刺客 | 4.2 | 11.7→29 |

## 從 10 組實驗學到的
1. **只加血量能拉長一局，但修不好剋制**：V0 從 23 秒拉到 38.5 秒，劍士照樣全勝。
2. **單純加強弓箭手會補過頭**：V1～V3 的「盾兵＋弓箭手」陣勝率 91%。因為血量加倍後，騎兵衝進弓箭陣前就被射死。
3. **要讓剋制成立，靠的是「對某兵種的專屬倍率」，不是整體數值**：
   - 盾兵拒馬 → 盾兵剋騎兵成立。
   - 騎兵皮甲 → 騎兵剋弓箭手成立，弓箭陣不再稱霸。
   - 弓手射刺客加碼 → 弓手剋刺客成立。
4. **一局長度主要由血量倍率決定**：×2 約 41 秒，×2.5 約 50 秒。

## 還沒解決、要知道的
- **刺客陣型偏弱**：F1 的「暗影刺殺」陣勝率 23%。原因是弓箭手剋刺客變強了。下一輪可以試刺客 6→5 金。F2 的陣型勝率比較平均，但剋制只有 9/10。
- **這份報表的覆蓋範圍有限**：
  - 兵種矩陣只測「60 金純兵種、固定方陣」。
  - 聯賽只有 6 套 AI 陣型 × 4 種子。
  - 企劃 M2 要求的「200 套陣型＋50 套驗證陣＋主動搜尋萬用陣」還沒做，所以**還不能說沒有萬用陣**。
- 狂熱、耗損沒有調；一局拉長後，更多局會進入 60 秒狂熱。目前時間到只有 2 場，還正常。
- 還沒有真人玩過新數值。

## 要實作時的改動清單
- `unit_defs.gd`：五個兵的數值。
- `unit_defs.gd`：新增常數 `ANTICAV_NUM/DEN`（拒馬 2/1）、`HIDE_ARROW_NUM/DEN`（皮甲 1/2）、`ALERT_NUM/DEN`（射刺客 3/2），`STEALTH_TICKS` 改 40。
- `battle_sim.gd`：在攻擊結算加三條倍率規則。
- 測試：補三項（拒馬、皮甲、射刺客加碼），並做「改壞會紅」驗證。
- 兵種卡說明文字跟著改。
extends SceneTree
## headless 測試：godot --headless --path game --script res://tests/run_tests.gd
## 印出每項 PASS/FAIL，最後一行是總結；有失敗就 exit 1。另外印出「指紋」給跨平台比對。

const D = preload("res://scripts/core/unit_defs.gd")
const Army = preload("res://scripts/core/army.gd")
const Sim = preload("res://scripts/core/battle_sim.gd")
const AI = preload("res://scripts/core/ai_army.gd")
const TP = preload("res://scripts/core/turn_placement.gd")

var passed := 0
var failed := 0

func ok(cond: bool, name: String, extra := "") -> void:
	if cond:
		passed += 1
		print("PASS ", name)
	else:
		failed += 1
		print("FAIL ", name, "  ", extra)

func _init() -> void:
	var t0 := Time.get_ticks_msec()
	test_army_rules()
	test_turn_placement()
	test_determinism_and_mirror()
	test_termination()
	test_traits()
	print("—— %d 通過 / %d 失敗（%d ms）" % [passed, failed, Time.get_ticks_msec() - t0])
	quit(1 if failed > 0 or passed == 0 else 0)

func army_from(team: int, spec: Array):
	var a = Army.new(team, 100)
	for s in spec:
		var col: int = s[1] if team == 0 else Army.COLS - 1 - s[1]
		a.units.append({"type": s[0], "col": col, "row": s[2]})
	return a

func test_army_rules() -> void:
	var a = Army.new(0, 100)
	ok(a.check_place(D.SWORD, 6, 0) != "", "部署區外不能放")
	ok(a.place(D.SWORD, 0, 0), "部署區內可以放")
	ok(not a.place(D.SHIELD, 0, 0), "同一格不能放兩隻")
	var b = Army.new(1, 100)
	ok(b.check_place(D.SWORD, 5, 0) != "" and b.check_place(D.SWORD, 10, 0) == "", "紅方部署區是 10～15 欄")
	a.clear()
	var n := 0
	for r in 9:
		for c in 6:
			if a.place(D.ARCHER, c, r):
				n += 1
	ok(n == 24 and a.spent() == 24 * D.cost(D.ARCHER), "最便宜的兵擺滿也只能放 24 隻（人數上限）", "n=%d" % n)
	a.clear()
	for i in 14:
		a.place(D.CAVALRY, i % 6, i / 6)
	ok(a.count() == 14 and a.left() == 2 and not a.can_afford_any(), "錢不夠就放不下", "count=%d left=%d" % [a.count(), a.left()])
	var m = army_from(0, [[D.SWORD, 0, 0], [D.ARCHER, 5, 8]]).mirrored()
	ok(m.team == 1 and m.units[0]["col"] == 15 and m.units[1]["col"] == 10, "鏡像換隊、欄位翻轉")

func test_turn_placement() -> void:
	var tp = TP.new(Army.new(0, 100), Army.new(1, 100), 0)
	ok(not tp.end_turn(), "沒擺兵又買得起不能結束這一手")
	ok(tp.place(D.SWORD, 0, 0), "第一手擺劍士")
	ok(tp.check_place(D.CAVALRY, 1, 0) != "", "一手最多 10 金（4＋7 超過）")
	ok(tp.current == 0 and tp.end_turn() and tp.current == 1, "結束後換紅方")
	ok(tp.place(D.CAVALRY, 15, 0) and tp.current == 0, "這一手剩 3 金買不起任何兵 → 自動換手")
	ok(tp.armies[0].count() == 1, "擺下的兵不會被收回")
	# 跑完整場：雙方輪流用最便宜的兵擺到停手
	var guard := 0
	while not tp.done() and guard < 500:
		guard += 1
		var a = tp.armies[tp.current]
		var placed := false
		for r in 9:
			for c in 16:
				if not placed and tp.place(D.SWORD, c, r):
					placed = true
		if not placed:
			tp.end_turn()
	ok(tp.done() and guard < 500, "輪流落子一定會結束", "guard=%d" % guard)
	ok(tp.armies[0].left() < D.cheapest() or tp.armies[0].count() == 24, "停手時藍方真的買不起或滿了")

func test_determinism_and_mirror() -> void:
	var rng := RandomNumberGenerator.new()
	var mirror_ok := 0
	var mirror_total := 0
	var det_ok := true
	var prints: Array = []
	var ms: Array = []
	for seed in 20:
		rng.seed = seed * 7919 + 1
		var a0 = AI.build(0, 100, rng)["army"]
		var a1 = AI.build(1, 100, rng)["army"]
		var t := Time.get_ticks_usec()
		var s1 = Sim.new(a0, a1)
		s1.run_to_end()
		ms.append((Time.get_ticks_usec() - t) / 1000)
		var s2 = Sim.new(a0.copy(), a1.copy())
		s2.run_to_end()
		if s1.fingerprint != s2.fingerprint or s1.winner != s2.winner:
			det_ok = false
		prints.append(s1.fingerprint)
		# 左右交換：a1 鏡像成藍方、a0 鏡像成紅方 → 勝方應該對調
		var s3 = Sim.new(a1.mirrored(), a0.mirrored())
		s3.run_to_end()
		mirror_total += 1
		var expect: int = s1.winner if s1.winner == -1 else 1 - s1.winner
		if s3.winner == expect and s3.tick == s1.tick:
			mirror_ok += 1
		else:
			print("  鏡像不一致 seed=%d 原本 %d@%d 鏡像 %d@%d" % [seed, s1.winner, s1.tick, s3.winner, s3.tick])
	ok(det_ok, "同一場跑兩次指紋相同（20 場）")
	ok(mirror_ok == mirror_total, "左右交換後勝方對調、tick 相同（%d/%d）" % [mirror_ok, mirror_total])
	ms.sort()
	print("  每場耗時 ms：中位數 %d、最大 %d（48 隻上限、headless debug）" % [ms[ms.size() / 2], ms[-1]])
	var h := 0
	for p in prints:
		h = posmod(h * 1000003 + p, Sim.HASH_MOD)
	print("FINGERPRINT ", h)

func test_termination() -> void:
	var a0 := []
	var a1 := []
	for r in 9:
		for c in 2:
			a0.append([D.SHIELD, 5 - c, r])
			a1.append([D.SHIELD, 5 - c, r])
	var s = Sim.new(army_from(0, a0), army_from(1, a1))
	s.run_to_end()
	ok(s.finished and s.tick <= Sim.MAX_TICKS, "全盾對全盾 90 秒內結束", "tick=%d" % s.tick)
	ok(s.winner == -1, "一模一樣的軍隊是平手", "winner=%d %s" % [s.winner, s.reason])
	# 全盾局會在耗損下同歸於盡（上面判平手）；這裡另外驗狂熱與耗損的時間點
	var f = Sim.new(army_from(0, a0), army_from(1, a1))
	var frenzy_at := -1
	while not f.finished and f.tick < Sim.FRENZY_TICK + 5:
extends RefCounted
## 戰鬥核心（純邏輯、全整數、確定性）。企劃 §2.3、§2.4、§3.3。
## 每 tick 固定五步：①讀快照 ②選目標＋提出移動 ③統一解碰撞 ④產生攻擊 ⑤同時結算。
## 任何一步都只讀「這一步開始前」的狀態，所以不會因為誰先算就佔便宜。

const D = preload("res://scripts/core/unit_defs.gd")
const M = preload("res://scripts/core/imath.gd")

const TPS := 20
const MAX_TICKS := D.MATCH_TICKS
const FRENZY_TICK := D.FRENZY_TICK
const CELL := 1000
const COLS := 16
const ROWS := 9
const W := COLS * CELL
const H := ROWS * CELL
const MIN_SEP := D.MIN_SEP
const EDGE := 200
const HASH_MOD := 1099511627689  # < 2^40，乘上 1000003 不會溢位

class Unit:
	var id: int
	var team: int
	var type: int
	var x: int
	var y: int
	var hp: int
	var max_hp: int
	var cost: int
	var cd := 0                # 子刻度（×4）；平常每 tick 扣 4，狂熱扣 5
	var target := -1           # 目標的索引
	var fx := 0                # 面向（長度約 1000）
	var fy := 0
	var mx := 0                # 這一 tick 提出的移動
	var my := 0
	var lmx := 0               # 上一次實際移動（判斷騎兵是否直行）
	var lmy := 0
	var stealth := 0
	var charge := 0
	var stun := 0
	var slow := 0
	var wp_x := -1             # 騎兵繞翼途經點
	var wp_y := -1
	var wp_for := -1
	var alive := true
	var dmg_dealt := 0
	var kills := 0

var units: Array = []          # 依 id 排序
var tick := 0
var budget := 100
var finished := false
var winner := -2               # -2 進行中；-1 平手；0／1 勝方
var reason := ""
var fingerprint := 0
var events: Array = []         # 這一 tick 的事件（給畫面演出用，不影響計算）
var frenzy := false

func _init(army0, army1) -> void:
	budget = army0.budget
	var raw: Array = []
	for a in [army0, army1]:
		for u in a.units:
			raw.append([a.team * 1000 + u["row"] * COLS + u["col"], a.team, u])
	raw.sort_custom(func(p, q): return p[0] < q[0])
	for r in raw:
		var u = r[2]
		var s = D.STATS[u["type"]]
		var n := Unit.new()
		n.id = r[0]
		n.team = r[1]
		n.type = u["type"]
		n.x = u["col"] * CELL + CELL / 2
		n.y = u["row"] * CELL + CELL / 2
		n.hp = s["hp"]
		n.max_hp = s["hp"]
		n.cost = s["cost"]
		n.fx = 1000 if n.team == 0 else -1000
		if n.type == D.ASSASSIN:
			n.stealth = D.STEALTH_TICKS
		units.append(n)
	if alive_count(0) == 0 or alive_count(1) == 0:
		finished = true
		winner = -1
		reason = "有一方沒有兵"

