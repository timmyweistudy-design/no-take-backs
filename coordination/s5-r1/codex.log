diff --git a/game/scripts/ui/ui_base.gd b/game/scripts/ui/ui_base.gd
index b9f9b83..da97875 100644
--- a/game/scripts/ui/ui_base.gd
+++ b/game/scripts/ui/ui_base.gd
@@ -80,10 +80,13 @@ const PLAY_EFFECTS := {
 }
 var play_kind := "official"   # 這一場是哪種播放
 var view = null           # 展示緩衝（R5）：戰鬥畫面播的是比模擬晚 2 tick 的快照
