   224	## 困難 AI：第 1 局沒有資訊，用會讀對方的落子 AI 自己組；之後讀你上一局的陣型，
   225	## 先查離線反制庫（組成最接近的原型），查不到就用啟發式反制。不偷看你這一局。
   226	func _hard_ai(r: RandomNumberGenerator) -> Army:
   227		var known: Array = last_player_formation if round_no > 1 else []
   228		if not known.is_empty():
   229			var lib := _counter_lib()
   230			if not lib.is_empty():
   231				var mine := [0, 0, 0, 0, 0]
   232				for u in known:
   233					mine[u["type"]] += D.cost(u["type"])
   234				var best = null
   235				var bd := 1 << 30
   236				for e in lib:
   237					var d := 0
   238					for k in 5:
   239						d += absi(int(e["proto_comp"][k]) - mine[k])
   240					if d < bd:
   241						bd = d
   242						best = e
   243				if best != null and bd <= 40:
   244					var a := Army.new(1, 100)
   245					if a.load_code(best["code"]) == "":
   246						return a
   247		return AIT.build_full(1, r, 2, known)
