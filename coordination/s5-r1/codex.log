   142				if not gauntlet_prev.is_empty():
   143					armies[0].units = gauntlet_prev.duplicate(true)
   144				var r := RandomNumberGenerator.new()
   145				r.seed = gauntlet_seed + gauntlet_stage * 7919
   146				var lvl := mini(2, (gauntlet_stage - 1) / 2)
   147				var e := AIT.build_full(1, r, lvl, gauntlet_prev)
   148				e.budget = 100 + 5 * (gauntlet_stage - 1)
   149				var guard := 0
   150				while e.can_afford_any() and guard < 20:
   151					guard += 1
   152					var t := AIT.choose_type(e, gauntlet_prev, e.left(), r, lvl)
   153					if t < 0:
   154						break
   155					var c := AIT.choose_cell(e, t, gauntlet_prev, r)
   156					if c.x < 0 or not e.place(t, c.x, c.y):
   157						break
