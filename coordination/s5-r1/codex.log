  1600	## 動態判詞：用輸出最高的兵種、結束方式、懸念類型組一句話。
  1601	func _verdict(w: int) -> String:
  1602		var dealt: Array = report["dealt"][w]
  1603		var top := 0
  1604		for t in 5:
  1605			if dealt[t] > dealt[top]:
  1606				top = t
  1607		var sus: Dictionary = report["sus"]
  1608		var side := L.t("blue") if w == 0 else L.t("red")
  1609		var unit := L.t("unit_%d" % top)
  1610		var secs := int(sim.tick / 20)
  1611		if int(sus.get("max_swing_pct", 0)) >= 15:
  1612			return L.t("verdict_comeback", [side, unit, sus["max_swing_pct"]])
  1613		if sim.power(w) * 100 / (sim.budget * 1000) <= 10:
  1614			return L.t("verdict_close", [side, unit, secs])
  1615		if int(sus.get("lock_ratio_permille", 0)) <= 200:
  1616			return L.t("verdict_rout", [side, unit, secs])
  1617		return L.t("verdict_normal", [side, unit, secs])
