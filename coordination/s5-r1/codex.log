     1	extends "res://scripts/ui/ui_base.gd"
     2	const EV = preload("res://scripts/core/events.gd")
     3	## 戰場、單位、特效、戰鬥 HUD、最後時刻鏡頭（演出層：不影響戰鬥結果）。
     4	
     5	
     6	func _on_skip() -> void:
     7		while not view.finished:
     8			_sim_step(false)
     9		result_delay = 9.0
    10	
    11	
    12	func _battle_process(delta: float) -> void:
    13		if paused:
    14			return
    15		if hitstop > 0:
    16			hitstop -= delta
    17			return
    18		var rate := speed
    19		if slow_left > 0:
    20			rate *= 0.5
    21			slow_left -= delta
    22		accum += delta * rate
    23		while accum >= 0.05 and not view.finished:
    24			accum -= 0.05
    25			_sim_step(true)
    26		# 播完之後展示時鐘繼續走（不再推進快照）：最後一格的位置插值與最後一擊的後搖要演完（Codex R5 #1）
    27		_check_clutch()
    28		if slow_left > 0:
    29			_update_action_focus()
    30		sfx.set_muffled(slow_left > 0 and not view.finished)
    31		if slow_left > 0 and not view.finished:
    32			_frame_alive(delta)
    33		else:
    34			zoom_target = 1.0
    35		zoom = lerpf(zoom, zoom_target, delta * 3)
    36		if view.finished:
    37			result_delay += delta
    38			if result_delay > 1.4:
    39				_finish_battle()
    40	
    41	
    42	## 最後時刻（優化方案 F1）：雙方剩餘戰力都 ≤30% 且差距 ≤15%；或雙方各剩 ≤3 隻且差距 ≤15%。
    43	func _check_clutch() -> void:
    44		if slow_used or view.finished:
    45			return
    46		var tot := float(view.budget * 1000)
    47		var p0: float = view.power(0) * 100.0 / tot
    48		var p1: float = view.power(1) * 100.0 / tot
    49		var a0: int = view.alive_count(0)
    50		var a1: int = view.alive_count(1)
    51		if absf(p0 - p1) <= 15.0 and ((p0 <= 30.0 and p1 <= 30.0) or (a0 <= 3 and a1 <= 3)):
    52			slow_used = true
    53			battle_marks.append({"tick": view.tick, "kind": "clutch", "team": -1})
    54			if bool(Save.s("slowmo")):
    55				slow_left = 8.0
    56			clutch_t = 1.6   # 最後時刻橫幅（第三輪 V2）：獨立一層畫在 _draw_clutch_banner
    57			sfx.play("clutch")
    58	
    59	
    60	## 鏡頭安全框（優化方案 F2）：把所有存活單位框進畫面，四周留 15%。
    61	func _frame_alive(delta: float) -> void:
    62		var lo := Vector2(1e9, 1e9)
    63		var hi := Vector2(-1e9, -1e9)
    64		for u in view.units:
    65			if u.alive:
    66				var p := _upos(u)
    67				lo = lo.min(p - Vector2(30, 70))
    68				hi = hi.max(p + Vector2(30, 20))
    69		var size := (hi - lo) / 0.7
    70		zoom_target = clampf(minf(1280.0 / maxf(1, size.x), 620.0 / maxf(1, size.y)) * 1.05, 1.08, 1.55)   # 再往勝負焦點收 5%（V2）
    71		zoom_center = zoom_center.lerp((lo + hi) / 2, minf(1.0, delta * 3))
    72	
    73	
    74	## 畫面前進一個 tick：模擬保持領先 DELAY 個 tick，畫面播最舊的那一份快照（R5 展示緩衝）。
    75	func _sim_step(with_fx: bool) -> void:
    76		_pump_view()
    77		for u in view.units:
    78			prev_pos[u.id] = Vector2(u.x, u.y)
    79		if not view.advance():
    80			view.finished = true
    81			return
    82		_pump_view()
    83		if view.frenzy and not frenzy_seen:
    84			frenzy_seen = true
    85			if with_fx:
    86				_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
    87				sfx.play("frenzy")
    88				sfx.play_music("music_frenzy")
    89		var deaths := 0
    90		for ev in view.events:
    91			var k: String = ev["kind"]
    92			if ev.has("src"):
    93				var s = view.unit_by_id(ev["src"])
    94				var key := "%s%d" % [k, s.team]
    95				ev_count[key] = int(ev_count.get(key, 0)) + 1
    96			if k == EV.DEATH:
    97				deaths += 1
    98			if k == EV.CHARGE or k == EV.BACKSTAB or k == EV.BRACED:
    99				# 頂住的 src 是被頂住的騎兵，功勞算盾兵那一隊（Codex S3）
   100				var team: int = view.unit_by_id(ev["tgt"] if k == EV.BRACED else ev["src"]).team
   101				var seen := false
   102				for m in battle_marks:
   103					if m["kind"] == k and m["team"] == team:
   104						seen = true
   105				if not seen:
   106					battle_marks.append({"tick": view.tick, "kind": k, "team": team})
   107			_on_event(ev, with_fx)
   108		# 碾壓局最後一擊（優化方案 F1）：0.2 秒頓格＋微震，直接進結算
   109		if view.finished and not slow_used and deaths > 0 and with_fx:
   110			hitstop = 0.2
   111			if bool(Save.s("shake")):
   112				shake = 0.15
   113	
   114	
   115	## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
   116	func _pump_view() -> void:
   117		for fr in view.pump(sim):
   118			for e in fr["events"]:
   119				if event_route(e) == "attack":
   120					var hs: Array = atk_hit.get(e["src"], [])
   121					hs.append(int(fr["tick"]))
   122					# 每隻單位的第幾次出手（交替招式用，Codex S4 #2：原本用 tick 奇偶，連續反擊會同招）
   123					var sq: Dictionary = atk_seq.get(e["src"], {})
   124					sq[int(fr["tick"])] = sq.size()
   125					atk_seq[e["src"]] = sq   # 存序列，不覆蓋還沒播到的命中（Codex R5 #2：連續反擊）
   126					if hs.size() > 4:
   127						hs.pop_front()
   128					atk_hit[e["src"]] = hs
   129	
   130	
   131	## 畫面上現在播到第幾 tick（含小數，插值用）。
   132	func _disp_tick() -> float:
   133		if view == null:
   134			return 0.0
   135		if state != St.BATTLE:
   136			return float(view.tick)
   137		return view.tick + clampf(accum / 0.05, 0.0, 8.0 if view.finished else 1.0)
   138	
   139	
   140	## 這一刻要演哪一次命中（Codex R5 #2）：取前搖已開始的最近一次；但前一次的揮擊還沒做完就先讓它做完（揮擊優先、後搖可被截斷）。
   141	static func pick_hit(hits: Array, disp: float, type: int) -> int:
   142		var tm := atk_timing(type)
   143		var w: float = tm[1]
   144		var strike_end: float = w + tm[2]
   145		var cur := -1
   146		for h in hits:
   147			if float(h) - w <= disp:
   148				if cur >= 0 and disp - (float(cur) - w) < strike_end:
   149					break   # 前一次還在揮擊，不換
   150				cur = h
   151		return cur
   152	
   153	
   154	## 三段式攻擊進度（R5）：前搖固定是命中前 DELAY 個 tick，揮擊與後搖依攻擊間隔壓縮（攻速快的兵動作也快，不會疊在一起）。
   155	## 回傳 Art.unit 的 atk 參數：0＝沒在攻擊；0～0.3125 前搖、0.3125～0.53125 揮擊（命中在 0.3125）、之後後搖到 1。
   156	## 一次攻擊動作的時長（tick）：前搖固定 DELAY，揮擊 0.22×總長；atk_progress 與 pick_hit 共用（Codex S4 #1）。
   157	static func atk_timing(type: int) -> Array:
   158		var period := float(D.STATS[type]["cd"])   # cd 的單位是 tick（模擬每次出手加 cd×4、每 tick 扣 4）
   159		var tot := clampf(period, 4.0, 6.4)
   160		return [tot, float(ViewBuffer.DELAY), 0.22 * tot]
   161	
   162	static func atk_progress(dt: float, type: int) -> float:
   163		var tm := atk_timing(type)
   164		var tot: float = tm[0]
   165		var w: float = tm[1]
   166		var st: float = tm[2]
   167		var rc := tot - w - st
   168		if dt < 0.0 or dt >= tot:
   169			return 0.0
   170		var a: float
   171		if dt < w:
   172			a = Art.ATK_WINDUP * dt / w
   173		elif dt < w + st:
   174			a = Art.ATK_WINDUP + (Art.ATK_STRIKE - Art.ATK_WINDUP) * (dt - w) / st
   175		else:
   176			a = Art.ATK_STRIKE + (1.0 - Art.ATK_STRIKE) * (dt - w - st) / rc
   177		return maxf(a, 0.001)
   178	
   179	
   180	## 揮擊殘影（Antigravity S4：五兵種不能共用同一個圓弧）：
