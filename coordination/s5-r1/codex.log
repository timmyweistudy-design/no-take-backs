     2	## 狀態機、模式、輸入、擺放、標題、選單、設定、結果、成就。
     3	
     4	func _ready() -> void:
     5		for a in OS.get_cmdline_user_args():
     6			if a.begins_with("--shot=") or a.begins_with("--steam-test=") or a.begins_with("--perf=") or a == "--boot-check":
     7				Save.prefix = "shot_"   # 不讀、不寫玩家真正的存檔
     8		Save.load_all()
     9		for a in OS.get_cmdline_user_args():
    10			if a.begins_with("--steam-test="):
    11				var aid := int(a.substr(13))
    12				SteamApi.init(aid, false)
    13				var res: Dictionary = SteamApi.self_test(aid)
    14				print("STEAMTEST ", JSON.stringify(res))
    15				get_tree().quit(0 if res["ok"] else 1)
    16				return
    17		for a2 in OS.get_cmdline_user_args():   # 截圖驗證用：--shot-lang=en、--shot-text=150（只改這次記憶體中的設定）
    18			if a2.begins_with("--shot-lang="):
    19				Save.settings["lang"] = a2.substr(12)
    20			elif a2.begins_with("--shot-text="):
    21				Save.settings["text_scale"] = int(a2.substr(12))
    22			elif a2 == "--layout-check":
    23				layout_probe = true
