   147	## 跟原本比改了幾隻（換兵種、移位、拿掉、新增都算一隻）。
   148	static func review_changes(orig, now) -> int:
   149		var a := {}
   150		var b := {}
   151		for u in orig.units:
   152			a["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   153		for u in now.units:
   154			b["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   155		var gone := 0
   156		var added := 0
   157		for k in a:
   158			if not b.has(k) or b[k] != a[k]:
   159				gone += 1
   160		for k in b:
   161			if not a.has(k) or a[k] != b[k]:
   162				added += 1
   163		return maxi(gone, added)
