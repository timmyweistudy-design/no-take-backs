   939	func _rv_band(r: Rect2, log: PackedInt64Array) -> void:
   940		draw_rect(r, Color(0, 0, 0, 0.4))
   941		var n := log.size()
   942		if n == 0:
   943			return
   944		var tot := 100000.0
   945		var cols := int(r.size.x / 2.0)
   946		# 原本與如果用同一個時間尺度：兩場裡比較長的那一場為滿（Antigravity S5）
   947		var span := float(maxi(n, maxi(int(rv_base.get("ticks", 0)), int(rv_result.get("ticks", 0)))))
   948		for i in cols:
   949			var t := int(i * 2.0 / r.size.x * span)
   950			if t >= n:
   951				break
   952			var d: float = clampf(float(log[t]) / tot * 2.0, -1.0, 1.0)
   953			var h := absf(d) * r.size.y / 2.0
   954			draw_rect(Rect2(r.position.x + i * 2.0, r.get_center().y - (h if d > 0 else 0.0), 2.0, h), Color(Art.team_color(0 if d > 0 else 1, cbm()), 0.85))
   955		draw_line(Vector2(r.position.x, r.get_center().y), Vector2(r.end.x, r.get_center().y), Color(1, 1, 1, 0.3), 1.0)
   956	
