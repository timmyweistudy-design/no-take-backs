   919	func _dash(a: Vector2, b: Vector2, c: Color, w: float) -> void:
   920		var n: int = maxi(1, int(a.distance_to(b) / 8.0))
   921		for k in n:
   922			if k % 2 == 0:
   923				draw_line(a.lerp(b, float(k) / n), a.lerp(b, float(k + 1) / n), c, w)
