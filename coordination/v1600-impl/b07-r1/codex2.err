   928		if _rv_map.is_empty():
   929			return
   930		var m := get_local_mouse_position()
   931		var w: Vector2 = (m - (_rv_map["o"] as Vector2)) / float(_rv_map["s"])
   932		_rv_free_click(Vector2i(int(w.x), int(w.y)))
