   181	func _entry_action(key: String) -> Callable:
   182		for kind in HUBS:
   183			for it in hub_items(kind):
   184				if str(it[0]) == key:
   185					var cb: Callable = it[3]
   186					return func(): Guide.see(Save.data, key); cb.call()
   187		return func(): pass
