   591		var lg: Array = last_cmds.duplicate(true)
   592		var ctl: Dictionary = BgPool.make_ctl(RV_LIMIT_MS)
   593		rv_base_thread = bg.start(func(): return review_run(a, e, r, lg, ctl), ctl)
   594		if rv_base_thread == null:
   595			rv_base_err = "fail"   # 開不了執行緒：不退回主執行緒無期限重算（Codex cat01 #1），顯示失敗、可以再按
   596	
   597	func _rv_base_poll() -> void:
   598		if rv_base_thread == null:
   599			return
   600		if overlay != "review":
   601			bg.retire(rv_base_thread)
   602			rv_base_thread = null
   603			return
   604		if not rv_base_thread.is_alive():
   605			var res: Dictionary = bg.take(rv_base_thread)
   606			rv_base_thread = null
   607			if bool(res.get("cancel", false)):
   608				rv_base_err = "slow"   # 逾時：顯示「算太久」＋重算鈕（不是永遠停在計算中）
   609				return
   610			rv_base = res
   611			if not rv_result.is_empty():
   612				_rv_set_result(rv_result)   # 先算好的「如果」要重新和基準比分岔點
   613	
   614	func _rv_set_result(res: Dictionary) -> void:
   615		if rv_result.is_empty() and not res.is_empty():
   616			rv_tab = 1   # 1.6.0 B07：重算好了＝自動翻到「讀結果」
   617		rv_result = res
   618		rv_div = diverge_tick(rv_base.get("log2", PackedInt64Array()), res.get("log2", PackedInt64Array())) if not res.is_empty() else -1
   619	
   620	## 第七輪 M3：覆盤重算開背景執行緒（模擬是純計算），畫面不卡；算的時候按鈕不能再按（防重入）。
   621	var rv_thread: Thread = null
   622	var rv_gen := 0          # 陣型改一次加一；算完時世代不同就丟掉（Codex r1：舊陣型的結果不能配新陣型）
   623	var rv_thread_gen := 0
   624	
   625	func _rv_dirty() -> void:
   626		rv_result = {}
   627		rv_div = -1
   628		rv_gen += 1
   629	
   630	## 1.1.0 H1：可取消、有期限（RV_LIMIT_MS）；改了陣型或離開覆盤就叫停，停了的交給 bg（BgPool）背景回收（不在主執行緒等）。
   631	## 開不了執行緒就提示、可以再按。
   632	const RV_LIMIT_MS := 20000
   633	var rv_ctl := {}
   634	func _rv_recalc() -> void:
   635		if rv_thread != null:
   636			return
   637		if DisplayServer.get_name() == "headless" or shot_dir != "":
   638			_rv_set_result(review_run(rv_army, rv_enemy, battle_rules, last_cmds))
   639			return
   640		var a: Variant = rv_army.copy()
   641		var e: Variant = rv_enemy.copy()
   642		var r: Variant = battle_rules.copy() if battle_rules != null else null
   643		var lg: Array = last_cmds.duplicate(true)
   644		var ctl: Dictionary = BgPool.make_ctl(RV_LIMIT_MS)
   645		var t: Thread = bg.start(func(): return review_run(a, e, r, lg, ctl), ctl)
   646		if t == null:
   647			_toast(L.t("rv_fail"), true)
   648			return
   649		rv_ctl = ctl
   650		rv_thread_gen = rv_gen
   651		rv_thread = t
   652	
   653	func _rv_cancel() -> void:
   654		if rv_thread != null:
   655			bg.retire(rv_thread)   # 叫停、交給共用回收（N6）
   656			rv_thread = null
   657	
   658	func _rv_poll() -> void:
   659		_rv_base_poll()
   660		if rv_thread != null and (overlay != "review" or rv_thread_gen != rv_gen):
   661			_rv_cancel()   # 離開覆盤或改了陣型：舊的不用算完
   662			return
   663		if rv_thread != null and not rv_thread.is_alive():
   664			var res: Dictionary = bg.take(rv_thread)
   665			rv_thread = null
   666			if bool(res.get("cancel", false)):
   667				_toast(L.t("rv_slow"), true)   # 只有逾時會走到這（離開、改陣型在上面就收掉了）
   668				return
   669			if rv_thread_gen == rv_gen:
   670				_rv_set_result(res)
   671	
   672	## 結束時：叫停再等（64 tick 內會停）；GIF 也叫停。
   673	func _rv_exit() -> void:
   674		_rv_cancel()
   675		if rv_base_thread != null:
   676			bg.retire(rv_base_thread)
   677			rv_base_thread = null
   678		gif_ctl["stop"] = true   # 真正的等待在 bg.drain()（battle_view._exit_tree）
   679	
