   191	func _tour_row_h(it: Array) -> float:
   192		return maxf(56.0, maxf(text_h(L.t(str(it[1])), tz("C"), 900.0 - 80.0 - 300.0), text_h(L.t(str(it[0])), tz("S"), 220.0, true)) + 18.0)
   193	
   194	func _draw_tour() -> void:
   195		var rows := TOUR.size()
   196		var hsum := 0.0
   197		for it0 in TOUR:
   198			hsum += _tour_row_h(it0) + 8.0
   199		var P := modal_rect(900, 12.0 + h1_help_h(L.t("tour_help"), tz("S"), 740) + GAP_L + hsum + GAP_L + 44.0 + GAP_L)
   200		_panel(P)
   201		var y := _h1_help(Vector2(640, P.position.y + 12), L.t("tour_title"), L.t("tour_help"), tz("S"), 740)
   202		for i in rows:
   203			var it: Array = TOUR[i]
   204			var rh := _tour_row_h(it)
   205			var r := Rect2(P.position.x + 40, y, P.size.x - 80, rh)   # V1.6.1：列高照說明行數（英文長說明會換行）
   206			y += rh + 8.0
   207			var en: bool = not _demo() or str(it[0]) == "fog_open"
   208			_btn(r, "", _entry_action(str(it[0])), en, false)   # 不用主按鈕的橘底：說明字在橘底上對比不夠（接觸表看到）
   209			_ink_mode = last_btn_paper   # 1.6.0 B02（P2.2）：紙面鈕上用墨字
   210			_icon(str(it[2]), r.position + Vector2(30, rh / 2.0), 26.0, ACCENT if en else TXT_DIM)
   211			_text(r.position + Vector2(60, 6), L.t(str(it[0])), tz("S"), Color.WHITE if en else TXT_DIM, false, true, 220)
   212			_text(r.position + Vector2(290, 8), L.t(str(it[1])), tz("C"), TXT_DIM, false, false, r.size.x - 300)
   213			_ink_mode = false
   214		_btn(Rect2(560, P.end.y - GAP_L - 44.0, 160, 44), L.t("back"), func(): _nav_back())   # V1.0.0（Codex v100-i1 #8）：和 Esc 同一條返回路徑
