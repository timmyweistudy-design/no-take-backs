   456	## 第六輪：自由陣型覆盤——點小戰場：點到兵就選它；選了之後點空地就搬過去。
   457	func _rv_free_click(w: Vector2i) -> void:
   458		var hit: int = rv_army.index_near(w.x, w.y, 450)
   459		if hit >= 0:
   460			rv_fsel = hit
   461			return
   462		if rv_fsel < 0:
   463			return
   464		var trial = rv_army.copy()
   465		if not trial.move_xy(rv_fsel, trial.world_x(Army.quant(trial.own_x(w.x))), Army.quant(w.y)):
   466			_toast(L.t("err_zone"), true)
   467			return
   468		if review_changes(rv_orig, trial) > 1:
   488			_toast(L.t("rv_one"), true)
   489			return
   490		rv_army = trial
   491		if t < 0:
   492			rv_fsel = -1
   493		_rv_dirty()
   494	
   495	func _rv_set_type(t: int) -> void:
   496		if rv_orig.deploy == "free":
   497			_rv_free_set_type(t)
   498			return
   499		if rv_sel.x < 0:
   500			return
   501		# 在副本上換，買不起或不合法就保留原兵並提示（Codex S5 #3：原本會變成直接刪兵）
   502		var c := rv_sel
   503		var trial = rv_army.copy()
   504		trial.remove_at(c.x, c.y)
   505		if t >= 0:
   506			var why: String = trial.check_place(t, c.x, c.y)
   507			if why != "":
   508				_toast(L.t("rv_cant", [L.t("unit_%d" % t)]), true)
   509				return
   510			trial.place(t, c.x, c.y)
   511		if review_changes(rv_orig, trial) > 1:
   512			_toast(L.t("rv_one"), true)
   513			return
   514		rv_army = trial
   515		_rv_dirty()
