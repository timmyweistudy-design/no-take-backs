   448	func _rv_cell(c: Vector2i) -> void:
   449		if rv_sel.x >= 0 and rv_army.index_at(rv_sel.x, rv_sel.y) != -1 and rv_army.index_at(c.x, c.y) == -1:
   450			var from := rv_sel
