+	var g = d.get("goal", 0)
+	var m = d.get("map", 0)
+	return (g is int or g is float) and int(g) >= 0 and int(g) < WS3.ED_GOALS.size() and (m is int or m is float) and int(m) >= 0 and int(m) < 64
+
+func _ed_load_draft() -> void:
+	var d = Save.data.get("ed_draft")
