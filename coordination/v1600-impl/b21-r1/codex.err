+	var cl: Array = []
+	for k in ed_cells:
+		cl.append([int(ed_cells[k]), k.x, k.y])
+	cl.sort()
+	Save.data["ed_draft"] = {"v": 1, "cells": cl, "goal": ed_goal, "map": ed_map, "t": [ed_target.x, ed_target.y]}
+
+static func ed_draft_ok(d) -> bool:
+	if not d is Dictionary or not d.get("cells") is Array or (d["cells"] as Array).size() > 160:
+		return false
+	for e in d["cells"]:
+		if not e is Array or e.size() != 3:
+			return false
+		for x in e:
+			if not (x is int or (x is float and float(x) == floorf(float(x)))) or float(x) < 0.0 or float(x) > 63.0:
+				return false
+		if int(e[1]) > 15 or int(e[2]) > 8 or (int(e[1]) > 5 and int(e[1]) < 10):
