   256		if j["a"].is_empty() or j["a"].size() > D.total():
   257			return bad
   258		for t in j["a"]:
   259			if not _is_int(t, 0, D.total() - 1) or int(t) in allowed:
   260				return bad
   261			allowed.append(int(t))
   262		var spent := 0
   263		for u in s:
   264			if not int(u[0]) in allowed:
   265				return bad
   266			spent += D.cost(int(u[0]))
   267		if spent > 200:
   268			return bad
   269		var pz := {"id": ID, "ch": 0, "relay": relay,
   270			"enemy": e, "fixed": [], "budget": spent, "allowed": allowed, "star2": 0, "star3": spent}
   271		if relay == 0:
   272			L.fill(pz, "", "ws_pz_name")
   273		else:
   274			L.fill(pz, "", "rl_title", [relay])
   275		L.fill(pz, "hint", "ws_pz_hint")   # V1.6.1 F6：四種語言都從字串表來
   276		var map_id := 0
   277		if vv == 5:
   278			if not _is_int(j.get("m"), 1, MapDefs.MAPS.size() - 1) or j.get("g") == "trio":
   279				return bad
   280			map_id = int(j["m"])
   281			for u in e:
   282				if blocked_cell(map_id, int(u[1]), int(u[2]), 1):
   283					return bad
   284			for u in s:
   285				if blocked_cell(map_id, int(u[1]), int(u[2]), 0):
   286					return bad
   287			pz["map"] = map_id
   288		if vv == 4 and j.get("g") == "trio":
   289			var ts := trio_set_of(j, s, allowed)
   290			if ts.is_empty():
   291				return bad
   292			var tr := Trio.results(ts, s, 0, ctl if not ctl.is_empty() else {"stop": false, "until": Time.get_ticks_msec() + SOLVE_MS * 3})
   293			if tr.is_empty():
   294				return {"ok": false, "why": "ws_slow"}
   295			if Trio.stars(ts, tr) < 1:
   296				return {"ok": false, "why": "ws_unsolved"}
   297			return {"ok": true, "pz": Trio.make_pz(ts, 0), "sol": s, "trio": ts, "why": ""}
   298		if vv >= 3:
   299			var g = j.get("g")
   300			var picked: bool = vv == 4 or (vv == 5 and j.has("t"))
   301			if not g is String or not g in GOALS3 or (picked and not g in PICK_GOALS):
   302				return bad
   303			var gf := pick_fields(g, e, s, j.get("t")) if picked else goal_fields(g, e, s)
   304			if picked and gf.is_empty():
   305				return bad   # 指定的目標不存在（「打贏」的 NTP3 本來就沒有目標欄位）
   306			pz.merge(gf, true)
   307			if gf.has("fixed"):
   308				# 護送：被護送的兵是固定兵，解題的人擺其他的；作者解扣掉它、預算也扣掉它的錢
   309				var fx: Array = gf["fixed"][0]
   310				s = s.filter(func(u): return not (int(u[1]) == int(fx[1]) and int(u[2]) == int(fx[2])))
   311				pz["budget"] = int(pz["budget"]) - D.cost(int(fx[0]))
   312				pz["star3"] = int(pz["budget"])
   313			L.fill(pz, "", "wb_pz_name")
   314			L.fill(pz, "hint", "wb_pz_hint")
   315		var r: Dictionary = PZ.play(pz, s, [], true, ctl if not ctl.is_empty() else {"stop": false, "until": Time.get_ticks_msec() + SOLVE_MS})
   316		if bool(r.get("cancel", false)):
   317			return {"ok": false, "why": "ws_slow"}   # V1.0.0 M15：作者解跑太久（壞碼或刻意卡住）就不收
   318		if not bool(r.get("ok", false)):
   319			return {"ok": false, "why": "ws_unsolved"}
   320		pz["star2"] = int(r["rem"])
   321		pz["best"] = {"u": s, "p": []}
   322		return {"ok": true, "pz": pz, "sol": s, "why": ""}

