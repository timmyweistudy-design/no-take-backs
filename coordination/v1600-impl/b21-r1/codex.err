     1	extends RefCounted
     2	## V1.1 D3：殘局工坊碼 NTP1。打贏一場格子對戰 → 把敵陣＋自己的解做成殘局碼傳給朋友解。
     3	## 作者的解就是「可解」的證明：匯入時先驗格式與合法性，再用殘局同一套判定（PZ.play）重跑作者解，要過關才收。
     4	## 星數門檻＝作者的成績：剩餘戰力 ≥ 作者（2 星）、花費 ≤ 作者（3 星）。不寫進存檔、不算殘局進度。
     5	## 格式：NTP1.<base64url(JSON {"v":1,"e":敵陣,"s":作者解,"a":可用兵種})>.<sha256 前 6 碼>；敵陣欄 10～15、解欄 0～5、列 0～8。
     6	
     7	const PZ = preload("res://scripts/game/puzzles.gd")
     8	const MapDefs = preload("res://scripts/core/map_defs.gd")
     9	const L = preload("res://scripts/game/strings.gd")
    10	const D = preload("res://scripts/core/unit_defs.gd")
    11	const PREFIX := "NTP1"
    12	const PREFIX2 := "NTP2"   # V1.4 #5 接力殘局：多一欄「第幾棒」n（1～99）；NTP1 照舊能用（n＝0）
    13	const PREFIX3 := "NTP3"   # V1.6 #16 出題台：多一欄目標 g（win／kill／survive／draw／margin）與參數；NTP1、NTP2 照舊
    14	const GOALS3 := ["win", "kill", "survive", "draw", "margin", "protect", "flawless"]
    15	const PREFIX5 := "NTP5"   # 1.2.0 §11.10 出題台地形：NTP3／NTP4 的欄位＋m＝地形圖（1～8，殘局中尺寸）；兩軍都不能壓在牆上
    16	const PREFIX4 := "NTP4"   # V1.6.1 A2：出題台作者自己指定目標（多一欄 t＝[欄, 列]：斬首＝敵兵、護送＝己兵、完美＝那隻兵的兵種）；NTP1～3 照舊
    17	const PICK_GOALS := ["kill", "protect", "flawless"]
    18	const ED_GOALS := ["win", "kill", "survive", "draw", "margin", "protect", "flawless", "trio"]   # 出題台的目標（V1.6.1 D2 多一種：一陣三考）
    19	const Trio = preload("res://scripts/game/trio.gd")
    20	const MAX_UNITS := 40
    21	const MAX_LEN := 6000
    22	const ID := "ws"
    23	
    24	## 是整數（JSON 讀回是浮點）而且在 [lo, hi] 內。
    25	static func _is_int(v, lo: int, hi: int) -> bool:
    26		if not (v is int or v is float):
    27			return false
    28		var f := float(v)
    29		return f == floorf(f) and f >= lo and f <= hi
    30	
    31	static func _clean(list, c0: int, c1: int) -> Array:
    32		if not list is Array or list.is_empty() or list.size() > MAX_UNITS:
    33			return []
    34		var out: Array = []
    35		var seen := {}
    36		for e in list:
    37			if not e is Array or e.size() != 3:
    38				return []
    39			for v in e:
    40				if not (v is int or v is float) or float(v) != floorf(float(v)):
    41					return []
    42			var t := int(e[0])
    43			var c := int(e[1])
    44			var r := int(e[2])
    45			if t < 0 or t >= D.total() or c < c0 or c > c1 or r < 0 or r >= 9:
    46				return []
    47			var key := c * 16 + r
    48			if seen.has(key):
    49				return []
    50			seen[key] = true
    51			out.append([t, c, r])
    52		return out
    53	
    54	## 把一場打贏的格子對戰做成殘局碼。enemy／sol＝[[兵種, 欄, 列], ...]（敵陣用絕對欄 10～15）。
    55	## 先用殘局規則重跑一次，作者解在殘局規則下也要贏才給碼（對戰可能用了不同局長等規則）。不合格回 ""。
    56	static func encode(enemy: Array, sol: Array, n := 0) -> String:
    57		var e := _clean(enemy, 10, 15)
    58		var s := _clean(sol, 0, 5)
    59		if e.is_empty() or s.is_empty():
    60			return ""
    61		var allowed: Array = []
    62		for u in s:
    63			if not int(u[0]) in allowed:
    64				allowed.append(int(u[0]))
    65		allowed.sort()
    66		var body := {"v": 1, "e": e, "s": s, "a": allowed}
    67		if n > 0:
    68			body = {"v": 2, "e": e, "s": s, "a": allowed, "n": clampi(n, 1, 99)}
    69		var j := JSON.stringify(body)
    70		var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
    71		var code := "%s.%s.%s" % [PREFIX2 if n > 0 else PREFIX, b, b.sha256_text().substr(0, 6)]
    72		return code if bool(decode(code)["ok"]) else ""
    73	
    74	## V1.6 #16：出題台的碼。goal＝GOALS3 之一；kill 的目標＝最貴的敵兵（同價取欄、列最小），survive 30 秒、draw 60 秒、margin 剩 50%。
    75	static func encode3(enemy: Array, sol: Array, goal: String) -> String:
    76		var e := _clean(enemy, 10, 15)
    77		var s := _clean(sol, 0, 5)
    78		if e.is_empty() or s.is_empty() or not goal in GOALS3:
    79			return ""
    80		var allowed: Array = []
    81		for u in s:
    82			if not int(u[0]) in allowed:
    83				allowed.append(int(u[0]))
    84		allowed.sort()
    85		var j := JSON.stringify({"v": 3, "e": e, "s": s, "a": allowed, "g": goal})
    86		var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
    87		var code := "%s.%s.%s" % [PREFIX3, b, b.sha256_text().substr(0, 6)]
    88		return code if bool(decode(code)["ok"]) else ""
    89	
    90	## V1.6.1 A2：作者點了目標（t＝[欄, 列]）就出 NTP4；沒點照舊出 NTP3（自動選）。
    91	static func encode4(enemy: Array, sol: Array, goal: String, t: Vector2i) -> String:
    92		if not goal in PICK_GOALS or t.x < 0:
    93			return encode3(enemy, sol, goal)
    94		var e := _clean(enemy, 10, 15)
    95		var s := _clean(sol, 0, 5)
    96		if e.is_empty() or s.is_empty() or pick_fields(goal, e, s, [t.x, t.y]).is_empty():
    97			return ""
    98		var allowed: Array = []
    99		for u in s:
   100			if not int(u[0]) in allowed:
   101				allowed.append(int(u[0]))
   102		allowed.sort()
   103		var j := JSON.stringify({"v": 4, "e": e, "s": s, "a": allowed, "g": goal, "t": [t.x, t.y]})
   104		var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
   105		var code := "%s.%s.%s" % [PREFIX4, b, b.sha256_text().substr(0, 6)]
   106		return code if bool(decode(code)["ok"]) else ""
   107	
   108	## 1.2.0 §11.10：有地形就出 NTP5（目標指定或自動都可以）；沒地形照舊走 encode4。
   109	static func encode5(enemy: Array, sol: Array, goal: String, t: Vector2i, map_id: int) -> String:
   110		if map_id <= 0:
   111			return encode4(enemy, sol, goal, t)
   112		var e := _clean(enemy, 10, 15)
   113		var s := _clean(sol, 0, 5)
   114		if e.is_empty() or s.is_empty() or not goal in GOALS3 or goal == "trio":
   115			return ""
   116		var allowed: Array = []
   117		for u in s:
   118			if not int(u[0]) in allowed:
   119				allowed.append(int(u[0]))
   120		allowed.sort()
   121		var body := {"v": 5, "e": e, "s": s, "a": allowed, "g": goal, "m": map_id}
   122		if goal in PICK_GOALS and t.x >= 0:
   123			body["t"] = [t.x, t.y]
   124		var b := Marshalls.utf8_to_base64(JSON.stringify(body)).replace("+", "-").replace("/", "_").replace("=", "")
   125		var code := "%s.%s.%s" % [PREFIX5, b, b.sha256_text().substr(0, 6)]
   126		return code if bool(decode(code)["ok"]) else ""
   127	
   128	## 1.2.0 §11.10：這張地形圖（殘局中尺寸）上，格子 (c, r) 對 team 是不是牆
   129	static func blocked_cell(map_id: int, c: int, r: int, team: int) -> bool:
   130		if map_id <= 0:
   131			return false
   132		var rr = PZ.rules_of({"map": map_id, "enemy": [], "goal": "win"})
   133		if rr == null:
   134			return false
   135		var tr = rr.terrain()
   136		return tr != null and tr.blocked(c * 1000 + 500, r * 1000 + 500, team)
   137	
   138	## V1.6.1 D2：出題台出「一陣三考」題：三支敵陣＋作者解（要三場都贏才給碼）。NTP4，g＝"trio"、e3＝三支敵陣。
   139	static func encode_trio(foes: Array, sol: Array) -> String:
   140		if foes.size() != 3:
   141			return ""
   142		var e3: Array = []
   143		for f in foes:
   144			var e := _clean(f, 10, 15)
   145			if e.is_empty():
   146				return ""
   147			e3.append(e)
   148		var s := _clean(sol, 0, 5)
   149		if s.is_empty():
   150			return ""
   151		var allowed: Array = []
   152		for u in s:
   153			if not int(u[0]) in allowed:
   154				allowed.append(int(u[0]))
   155		allowed.sort()
   156		var j := JSON.stringify({"v": 4, "e": e3[0], "e3": e3, "s": s, "a": allowed, "g": "trio"})
   157		var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
   158		var code := "%s.%s.%s" % [PREFIX4, b, b.sha256_text().substr(0, 6)]
   159		return code if bool(decode(code)["ok"]) else ""
   160	
   161	## 三考碼解出來的題組（和 data/trio.json 同格式；id＝碼的雜湊）
   162	static func trio_set_of(j: Dictionary, s: Array, allowed: Array) -> Dictionary:
   163		var e3 = j.get("e3")
   164		if not e3 is Array or e3.size() != 3:
   165			return {}
   166		var foes: Array = []
   167		for f in e3:
   168			var e := _clean(f, 10, 15)
   169			if e.is_empty():
   170				return {}
   171			foes.append(e)
   172		var spent := 0
   173		for u in s:
   174			spent += D.cost(int(u[0]))
   175		var al2: Array = allowed.duplicate()
   176		al2.sort()
   177		return {"id": "c" + JSON.stringify([foes, spent, al2]).md5_text().substr(0, 12), "budget": spent, "allowed": allowed, "foes": foes, "sol": s}   # 身分含預算與可用兵種（Codex v161-i1 #7）
   178	
   179	## 指定的目標要真的有那隻兵（斬首在敵陣、護送與完美在作者解）；不對回 {}。
   180	static func pick_fields(goal: String, e: Array, s: Array, t) -> Dictionary:
   181		if not t is Array or t.size() != 2 or not _is_int(t[0], 0, 15) or not _is_int(t[1], 0, 8):
   182			return {}
   183		var lst: Array = e if goal == "kill" else s
   184		for u in lst:
   185			if int(u[1]) == int(t[0]) and int(u[2]) == int(t[1]):
   186				match goal:
   187					"kill":
   188						return {"goal": "kill", "goal_unit": [int(u[1]), int(u[2])]}
   189					"protect":
   190						return {"goal": "protect", "goal_unit": [int(u[1]), int(u[2])], "fixed": [[int(u[0]), int(u[1]), int(u[2])]]}
   191					"flawless":
   192						return {"goal": "flawless", "goal_type": int(u[0]), "need_type": true}
   193		return {}
   194	
   195	## 目標的細節（解碼時從敵陣、作者解算，不吃碼裡的數字：少一個能被竄改的欄位）
   196	## protect：作者解裡最貴的兵（同價取欄、列最小）變成固定兵，要活到最後；flawless：作者解裡最多的兵種一隻都不能倒
   197	static func goal_fields(goal: String, e: Array, s: Array = []) -> Dictionary:
   198		match goal:
   199			"protect":
   200				var pb: Array = s[0]
   201				for u in s:
   202					if D.cost(int(u[0])) > D.cost(int(pb[0])) or (D.cost(int(u[0])) == D.cost(int(pb[0])) and (int(u[1]) * 16 + int(u[2])) < (int(pb[1]) * 16 + int(pb[2]))):
   203						pb = u
   204				return {"goal": "protect", "goal_unit": [int(pb[1]), int(pb[2])], "fixed": [[int(pb[0]), int(pb[1]), int(pb[2])]]}
   205			"flawless":
   206				var cnt := {}
   207				for u in s:
   208					cnt[int(u[0])] = int(cnt.get(int(u[0]), 0)) + 1
   209				var bt := int(s[0][0])
   210				for t in cnt:
   211					if int(cnt[t]) > int(cnt[bt]) or (int(cnt[t]) == int(cnt[bt]) and int(t) < bt):
   212						bt = int(t)
   213				return {"goal": "flawless", "goal_type": bt, "need_type": true}
   214			"kill":
   215				var best: Array = e[0]
   216				for u in e:
   217					if D.cost(int(u[0])) > D.cost(int(best[0])) or (D.cost(int(u[0])) == D.cost(int(best[0])) and (int(u[1]) * 16 + int(u[2])) < (int(best[1]) * 16 + int(best[2]))):
   218						best = u
   219				return {"goal": "kill", "goal_unit": [int(best[1]), int(best[2])]}
   220			"survive":
   221				return {"goal": "survive", "goal_ticks": 600}
   222			"draw":
   223				return {"goal": "draw", "goal_ticks": 1200}
   224			"margin":
   225				return {"goal": "margin", "goal_rem": 50}
   226		return {}
   227	
   228	## 解碼＋驗證＋重跑作者解。回傳 {ok, pz, sol, why}。
   229	## V1.0.0 M15：重跑作者解有期限（SOLVE_MS，三考三場合計 3 倍），超過回 ws_slow。
   230	const SOLVE_MS := 8000
   231	## ctl：背景驗證用（{"stop", "until"}，見 PZ.play）；沒給就用 SOLVE_MS 自己的期限。
   232	static func decode(code: String, ctl := {}) -> Dictionary:
   233		var bad := {"ok": false, "why": "ws_bad"}
   234		code = code.strip_edges()
   235		var parts := code.split(".")
   236		if code.length() > MAX_LEN or parts.size() != 3 or not (parts[0] in [PREFIX, PREFIX2, PREFIX3, PREFIX4, PREFIX5]) or parts[1].sha256_text().substr(0, 6) != parts[2]:
   237			return bad
   238		var b64 := parts[1].replace("-", "+").replace("_", "/")
   239		while b64.length() % 4 != 0:
   240			b64 += "="
   241		var j = JSON.parse_string(Marshalls.base64_to_utf8(b64))
   242		var v2 := parts[0] == PREFIX2
   243		var vv := 5 if parts[0] == PREFIX5 else (4 if parts[0] == PREFIX4 else (3 if parts[0] == PREFIX3 else (2 if v2 else 1)))
   244		if not j is Dictionary or not _is_int(j.get("v"), vv, vv):   # Codex v110-impl2：先驗型別再轉，不能讓 {}、1.9 混進來
   245			return bad
   246		var relay := 0
   247		if v2:
   248			if not _is_int(j.get("n"), 1, 99):
   249				return bad
   250			relay = int(j["n"])
   251		var e := _clean(j.get("e"), 10, 15)
   252		var s := _clean(j.get("s"), 0, 5)
   253		if e.is_empty() or s.is_empty() or not j.get("a") is Array:
   254			return bad
