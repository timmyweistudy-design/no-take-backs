## 三考題：右半邊的格子存回目前這一支敵陣
func _ed_sync_foe() -> void:
	var f := {}
	for k in ed_cells:
		if k.x >= 10:
			f[k] = ed_cells[k]
	ed_foes[ed_foe_i] = f

func _ed_switch_foe(i: int) -> void:
	_ed_sync_foe()
	for k in ed_cells.keys():
		if k.x >= 10:
			ed_cells.erase(k)
	ed_foe_i = i
	for k in ed_foes[i]:
		ed_cells[k] = ed_foes[i][k]
	ed_msg = ""

