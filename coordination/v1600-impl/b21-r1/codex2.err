+func _gh_title_size(name: String) -> int:
+	var levels: Array = TYPE_SCALE[_scale_key()].values()
+	levels.sort()
+	levels.reverse()
+	for v in levels:
+		if int(v) <= tz("B") and text_h(name, int(v), 200, true) <= text_h("A\nA", int(v), 200, true) + 0.5:   # 兩行高照實量（Codex B21 r1）
+			return int(v)
+	return int(levels[-1])
