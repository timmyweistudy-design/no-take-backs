  2235		if trio_st == 3 and not custom:
  2236			call("_ach", "TRIO_STAR3")   # V1.6.1 D7
  2237		if trio_st >= 1 and not custom:   # 朋友出的三考題不存紀錄
  2238			var cl: Dictionary = Save.data.get("trio_clear", {})
  2239			var id := str(s["id"])
  2240			var sp: int = int(trio_snap.get("spent", last_armies[0].spent()))
  2241			if not cl.has(id) or sp < int(cl[id]):
  2242				cl[id] = sp
  2243				Save.data["trio_clear"] = cl
  2244			var ts: Dictionary = Save.data.get("trio_stars", {})
  2245			if trio_st > int(ts.get(id, 0)):
  2246				ts[id] = trio_st
  2247				Save.data["trio_stars"] = ts
  2248			Save.save_data()
