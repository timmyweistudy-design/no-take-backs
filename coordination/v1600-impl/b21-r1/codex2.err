func _toast(s: String, deny := false) -> void:
	toast = s
	var tm := int(Save.s("toast_mult"))
	toast_t = 2.0 * tm if tm > 0 else 600.0   # V1.5：提示停留 標準／加長／很長／手動關（點一下才收）
	toast_born = time
	if deny:
		sfx.play("ui_deny")


func _move_focus(d: int) -> void:
	pad_mode = true
	if _btns.is_empty():
		return
	_focus = posmod(_focus + d, _btns.size())


## 字太寬就往下一級縮（第五輪：只在字級表內往下走，最小到「註記」，不再縮到 9px；還是太寬就由 _text 換行）。
func fit(s: String, size: int, maxw: float, bold := false) -> int:
	var sz := size
	var levels: Array = TYPE_SCALE[_scale_key()].values()
	levels.sort()
	while _width(s, sz, bold) > maxw:
		var nxt := -1
		for v in levels:
			if v < sz:
				nxt = v
		if nxt < 0:
			break
		sz = nxt
	if layout_probe and sz < size:
		# 1.6.0 B07（P2.3）：版面檢查記下「字被擠到縮級」——英文 150% 重災頁的量測（縮到最小級還放不下＝over）
		probe_shrink.append([s.substr(0, 60), size, sz, _width(s, sz, bold) > maxw])
	return sz

func _font_for(s: String, size: int, bold: bool) -> Font:
	if _hand_mode and font_title != null:
		return font_title   # 1.2.0：老闆便條、印章用手寫字（憲法 6：只放建議，不承載數值）
	if font_craft:
		# 1.2.0（Codex cat02 #3）工藝字型的分工：D／DX 展示大字＝ThenKhung（logo 氣質不變）；H1、T＝手寫楷體；H2 以下＝正文黑體
		if bold and not bool(Save.s("plain_titles")) and not _has_digit(s):
			if font_display != null and size >= tz("D"):
				return font_display
			if font_title != null and size >= tz("H1"):
				return font_title
		return font_bold if bold else font
	if bold and font_title != null and size >= tz("H2") and not bool(Save.s("plain_titles")) and not _has_digit(s):
		return font_title
	return font_bold if bold else font

static func _has_digit(s: String) -> bool:
	for i in s.length():
		var c := s.unicode_at(i)
		if (c >= 48 and c <= 57) or (c >= 0xFF10 and c <= 0xFF19):
			return true
	return false

func _width(s: String, size: int, bold := false) -> float:
	var w := 0.0
	for ln in s.split("\n"):
		w = maxf(w, _font_for(ln, size, bold).get_string_size(ln, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x)
	return w

## 換行（第五輪）：中日韓逐字斷、英文逐詞斷；保留原本的 \n。回傳行陣列。
const NO_LINE_HEAD := "。，、）」』！？；：%”’ぁぃぅぇぉっゃゅょゎァィゥェォッャュョヮヵヶーゝゞヽヾ・"

func wrap_lines(s: String, size: int, maxw: float, bold := false) -> PackedStringArray:
	var out := PackedStringArray()
	for para in s.split("\n"):
		if maxw <= 0.0 or _width(para, size, bold) <= maxw:
			out.append(para)
			continue
		var cur := ""
		var i := 0
		while i < para.length():
			var tok := para[i]
			if tok.unicode_at(0) < 0x2E80 and tok != " ":
				# 拉丁字：整個詞一起
				var j := i + 1
				while j < para.length() and para[j].unicode_at(0) < 0x2E80 and para[j] != " ":
					j += 1
				tok = para.substr(i, j - i)
				i = j
			else:
				i += 1
			if cur != "" and _width(cur + tok, size, bold) > maxw:
				# 避頭點（第六輪截圖）：句號、逗號、右括號不放行首——把上一行最後一個字一起帶到下一行（不掛出框外）
				# V1.4 #17：日文另加小假名、長音、中黑點不放行首；簡中的右引號也算
				if tok.length() == 1 and NO_LINE_HEAD.contains(tok) and cur.length() > 1 and cur.unicode_at(cur.length() - 1) >= 0x2E80:
					# 往回多帶幾個字，直到新的一行開頭不是禁則字（「ュー」這種連續的也處理，Codex v140-i4）；最多帶 4 個
					var n := 1
					while n < 4 and n < cur.length() - 1 and NO_LINE_HEAD.contains(cur[cur.length() - n]) and cur.unicode_at(cur.length() - n - 1) >= 0x2E80:
						n += 1
					out.append(cur.substr(0, cur.length() - n).strip_edges(false, true))
					cur = cur.substr(cur.length() - n) + tok
				else:
					out.append(cur.strip_edges(false, true))
					cur = tok.strip_edges(true, false) if tok == " " else tok
			else:
				cur += tok
		if cur != "":
			out.append(cur)
	return out

## 行距（第五輪 §4.2，XAG 101）：多行的段落 1.5 倍；單行照舊。
static func line_h(n: int) -> float:
	return 1.5 if n > 1 else 1.3

## 一段字換行後的高度（排版用）。
func text_h(s: String, size: int, maxw := 0.0, bold := false) -> float:
	var n := wrap_lines(s, size, maxw, bold).size()
	return n * size * line_h(n)


## V1.6.1 A8：焦點框平滑移動
const FOCUS_GLIDE := 0.08
var fg_from := Rect2()
var fg_to := Rect2()
var fg_at := -9.0
func _focus_glide(rd: Rect2) -> Rect2:
	if layout_probe or not bool(get("pad_mode")) or bool(Save.s("reduce_motion")):
		fg_to = rd
		fg_at = -9.0
		return rd
	if not rd.is_equal_approx(fg_to):
		var quick := time - fg_at < 0.15   # 連續撥動：直接跳，不黏
		fg_from = rd if (quick or fg_to.size == Vector2.ZERO) else _glide_now()
		fg_to = rd
		fg_at = time
	return _glide_now()

func _glide_now() -> Rect2:
	var k := clampf((time - fg_at) / FOCUS_GLIDE, 0.0, 1.0)
	k = 1.0 - (1.0 - k) * (1.0 - k)
	return Rect2(fg_from.position.lerp(fg_to.position, k), fg_from.size.lerp(fg_to.size, k))

var mag_focus := Vector2(-1, -1)   # V1.6.1 F4：手把模式時放大鏡跟著焦點按鈕（不用另外的鍵，不和 L3 提示衝突）
## 宣告「接下來畫的字在這個格子裡」（R11）：非按鈕的格子（價錢小方塊、徽章、分頁字）用。
func probe_cell_begin(face: Rect2) -> void:
	_probe_face = face
	_probe_cell_seq += 1
	_probe_cell_id = "cell%d" % _probe_cell_seq

func probe_cell_end() -> void:
	_probe_face = Rect2()
	_probe_cell_id = ""

func _text(p: Vector2, s: String, size: int, c: Color, center := false, bold := false, maxw := 0.0, outline := Color(0, 0, 0, -1)) -> void:
	if _ink_mode:
		c = Color(_ink(c), c.a) if _ink_keep_a else _ink(c)
	elif outline.a < 0.0 and not (size >= 24 or (bold and size >= 19)) and c.s >= 0.25 and not (c.get_luminance() < 0.35 and c.s < 0.8):   # 深色低彩度的浮雕字不動
		c = Color(_legible(Color(c, 1.0)), c.a)   # V1.2.1 F5：深描邊上的彩色小字自動提亮到 4.5:1
	if maxw > 0.0:
		size = fit(s, size, maxw, bold)
	var lines := wrap_lines(s, size, maxw, bold) if maxw > 0.0 else s.split("\n")
	for i in lines.size():
		var fnt := _font_for(lines[i], size, bold)
		var w := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x if center else 0.0
		var q := p + Vector2(-w / 2, i * size * line_h(lines.size()) + size * 0.85)
		if mag_on and _probe_ui and size < 26 and c.a > 0.3:
			var mw := w if center else fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
			if Rect2(q.x, q.y - size * 0.95, mw, size * 1.2).grow(4.0 if bool(get("pad_mode")) else 0.0).has_point(mag_point()):
				mag_hit = [lines[i], size, bold]
		var oc := Color(INK, c.a * 0.85) if outline.a < 0.0 else outline
		# V1.2：深色、低彩度的「墨色字」（印在紙或布條上）不描深邊，改淺色浮雕；先決定樣式再登記探針（Codex v120-impl2）
		var emboss := outline.a < 0.0 and (_ink_mode or (c.get_luminance() < 0.35 and c.s < 0.8))
		if emboss:
			oc = Color(0, 0, 0, 0)
		var ow := text_outline_w(size)
		var sh := text_shadow_dy(size)
		# 版面探針（第五輪補洞）：介面層與戰場層都量、低透明度（>0.05）也量；戰場字標 field
		# V1.2 A3：外框算進描邊外擴（左右上各半個描邊、下方再加陰影位移），換字與換框才不會靜靜爆框
		if layout_probe and c.a > 0.05 and lines[i].strip_edges() != "":
			var ww := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
			var ex := ow * 0.5 if oc.a > 0.0 else 0.0
			# 直向：原本的框（1.1 倍字高）已經留了上下各約 0.05 字高的空，描邊與陰影只算超出的部分
			var ey := maxf(0.0, ex - size * 0.05)
			var eb := maxf(0.0, ey + (sh if oc.a > 0.0 else 0.0) - size * 0.05)
			probe_texts.append({"r": Rect2(q.x - ex, q.y - size * 0.85 - ey, ww + ex * 2.0, size * 1.1 + ey + eb), "size": size, "s": lines[i], "field": not _probe_ui, "a": c.a, "btn": _probe_btn_label, "own": _probe_btn_rect,
				"c": c, "oc": oc, "ow": ow if oc.a > 0.0 else 0.0, "bold": bold, "glyph": _probe_glyph, "anim": _probe_anim, "dis": _probe_dis, "fz": probe_faces.size(),
				"gr": Rect2(q.x, q.y - size * 0.80, ww, size * 0.98),
				"face": _probe_face if _probe_face.size.x > 0.0 else null, "cell": _probe_cell_id, "ink": Rect2(q + ink_line(fnt, lines[i], size).position, ink_line(fnt, lines[i], size).size)})   # V1.2.1：字形框（不含描邊外擴、陰影與行距），九宮格內距用   # V1.2.1 F5：對比檢查要實際字色與描邊
		if emboss:
extends RefCounted
## V1.1 D3：殘局工坊碼 NTP1。打贏一場格子對戰 → 把敵陣＋自己的解做成殘局碼傳給朋友解。
## 作者的解就是「可解」的證明：匯入時先驗格式與合法性，再用殘局同一套判定（PZ.play）重跑作者解，要過關才收。
## 星數門檻＝作者的成績：剩餘戰力 ≥ 作者（2 星）、花費 ≤ 作者（3 星）。不寫進存檔、不算殘局進度。
## 格式：NTP1.<base64url(JSON {"v":1,"e":敵陣,"s":作者解,"a":可用兵種})>.<sha256 前 6 碼>；敵陣欄 10～15、解欄 0～5、列 0～8。

const PZ = preload("res://scripts/game/puzzles.gd")
const MapDefs = preload("res://scripts/core/map_defs.gd")
const L = preload("res://scripts/game/strings.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const PREFIX := "NTP1"
const PREFIX2 := "NTP2"   # V1.4 #5 接力殘局：多一欄「第幾棒」n（1～99）；NTP1 照舊能用（n＝0）
const PREFIX3 := "NTP3"   # V1.6 #16 出題台：多一欄目標 g（win／kill／survive／draw／margin）與參數；NTP1、NTP2 照舊
const GOALS3 := ["win", "kill", "survive", "draw", "margin", "protect", "flawless"]
const PREFIX5 := "NTP5"   # 1.2.0 §11.10 出題台地形：NTP3／NTP4 的欄位＋m＝地形圖（1～8，殘局中尺寸）；兩軍都不能壓在牆上
const PREFIX4 := "NTP4"   # V1.6.1 A2：出題台作者自己指定目標（多一欄 t＝[欄, 列]：斬首＝敵兵、護送＝己兵、完美＝那隻兵的兵種）；NTP1～3 照舊
const PICK_GOALS := ["kill", "protect", "flawless"]
const ED_GOALS := ["win", "kill", "survive", "draw", "margin", "protect", "flawless", "trio"]   # 出題台的目標（V1.6.1 D2 多一種：一陣三考）
const Trio = preload("res://scripts/game/trio.gd")
const MAX_UNITS := 40
const MAX_LEN := 6000
const ID := "ws"

## 是整數（JSON 讀回是浮點）而且在 [lo, hi] 內。
static func _is_int(v, lo: int, hi: int) -> bool:
	if not (v is int or v is float):
		return false
	var f := float(v)
	return f == floorf(f) and f >= lo and f <= hi

static func _clean(list, c0: int, c1: int) -> Array:
	if not list is Array or list.is_empty() or list.size() > MAX_UNITS:
		return []
	var out: Array = []
	var seen := {}
	for e in list:
		if not e is Array or e.size() != 3:
			return []
		for v in e:
			if not (v is int or v is float) or float(v) != floorf(float(v)):
				return []
		var t := int(e[0])
		var c := int(e[1])
		var r := int(e[2])
		if t < 0 or t >= D.total() or c < c0 or c > c1 or r < 0 or r >= 9:
			return []
		var key := c * 16 + r
		if seen.has(key):
			return []
		seen[key] = true
		out.append([t, c, r])
	return out

## 把一場打贏的格子對戰做成殘局碼。enemy／sol＝[[兵種, 欄, 列], ...]（敵陣用絕對欄 10～15）。
## 先用殘局規則重跑一次，作者解在殘局規則下也要贏才給碼（對戰可能用了不同局長等規則）。不合格回 ""。
static func encode(enemy: Array, sol: Array, n := 0) -> String:
	var e := _clean(enemy, 10, 15)
	var s := _clean(sol, 0, 5)
	if e.is_empty() or s.is_empty():
		return ""
	var allowed: Array = []
	for u in s:
		if not int(u[0]) in allowed:
			allowed.append(int(u[0]))
	allowed.sort()
	var body := {"v": 1, "e": e, "s": s, "a": allowed}
	if n > 0:
		body = {"v": 2, "e": e, "s": s, "a": allowed, "n": clampi(n, 1, 99)}
	var j := JSON.stringify(body)
	var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
	var code := "%s.%s.%s" % [PREFIX2 if n > 0 else PREFIX, b, b.sha256_text().substr(0, 6)]
	return code if bool(decode(code)["ok"]) else ""

## V1.6 #16：出題台的碼。goal＝GOALS3 之一；kill 的目標＝最貴的敵兵（同價取欄、列最小），survive 30 秒、draw 60 秒、margin 剩 50%。
static func encode3(enemy: Array, sol: Array, goal: String) -> String:
	var e := _clean(enemy, 10, 15)
	var s := _clean(sol, 0, 5)
	if e.is_empty() or s.is_empty() or not goal in GOALS3:
		return ""
	var allowed: Array = []
	for u in s:
		if not int(u[0]) in allowed:
			allowed.append(int(u[0]))
	allowed.sort()
	var j := JSON.stringify({"v": 3, "e": e, "s": s, "a": allowed, "g": goal})
	var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
	var code := "%s.%s.%s" % [PREFIX3, b, b.sha256_text().substr(0, 6)]
	return code if bool(decode(code)["ok"]) else ""

## V1.6.1 A2：作者點了目標（t＝[欄, 列]）就出 NTP4；沒點照舊出 NTP3（自動選）。
static func encode4(enemy: Array, sol: Array, goal: String, t: Vector2i) -> String:
	if not goal in PICK_GOALS or t.x < 0:
		return encode3(enemy, sol, goal)
	var e := _clean(enemy, 10, 15)
	var s := _clean(sol, 0, 5)
	if e.is_empty() or s.is_empty() or pick_fields(goal, e, s, [t.x, t.y]).is_empty():
		return ""
	var allowed: Array = []
	for u in s:
		if not int(u[0]) in allowed:
			allowed.append(int(u[0]))
	allowed.sort()
	var j := JSON.stringify({"v": 4, "e": e, "s": s, "a": allowed, "g": goal, "t": [t.x, t.y]})
	var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
	var code := "%s.%s.%s" % [PREFIX4, b, b.sha256_text().substr(0, 6)]
	return code if bool(decode(code)["ok"]) else ""

## 1.2.0 §11.10：有地形就出 NTP5（目標指定或自動都可以）；沒地形照舊走 encode4。
static func encode5(enemy: Array, sol: Array, goal: String, t: Vector2i, map_id: int) -> String:
	if map_id <= 0:
		return encode4(enemy, sol, goal, t)
	var e := _clean(enemy, 10, 15)
	var s := _clean(sol, 0, 5)
	if e.is_empty() or s.is_empty() or not goal in GOALS3 or goal == "trio":
		return ""
	var allowed: Array = []
	for u in s:
		if not int(u[0]) in allowed:
			allowed.append(int(u[0]))
	allowed.sort()
	var body := {"v": 5, "e": e, "s": s, "a": allowed, "g": goal, "m": map_id}
	if goal in PICK_GOALS and t.x >= 0:
		body["t"] = [t.x, t.y]
	var b := Marshalls.utf8_to_base64(JSON.stringify(body)).replace("+", "-").replace("/", "_").replace("=", "")
	var code := "%s.%s.%s" % [PREFIX5, b, b.sha256_text().substr(0, 6)]
	return code if bool(decode(code)["ok"]) else ""

## 1.2.0 §11.10：這張地形圖（殘局中尺寸）上，格子 (c, r) 對 team 是不是牆
static func blocked_cell(map_id: int, c: int, r: int, team: int) -> bool:
	if map_id <= 0:
		return false
	var rr = PZ.rules_of({"map": map_id, "enemy": [], "goal": "win"})
	if rr == null:
		return false
	var tr = rr.terrain()
	return tr != null and tr.blocked(c * 1000 + 500, r * 1000 + 500, team)

## V1.6.1 D2：出題台出「一陣三考」題：三支敵陣＋作者解（要三場都贏才給碼）。NTP4，g＝"trio"、e3＝三支敵陣。
static func encode_trio(foes: Array, sol: Array) -> String:
	if foes.size() != 3:
		return ""
	var e3: Array = []
	for f in foes:
		var e := _clean(f, 10, 15)
		if e.is_empty():
			return ""
		e3.append(e)
	var s := _clean(sol, 0, 5)
	if s.is_empty():
		return ""
	var allowed: Array = []
	for u in s:
		if not int(u[0]) in allowed:
			allowed.append(int(u[0]))
	allowed.sort()
	var j := JSON.stringify({"v": 4, "e": e3[0], "e3": e3, "s": s, "a": allowed, "g": "trio"})
	var b := Marshalls.utf8_to_base64(j).replace("+", "-").replace("/", "_").replace("=", "")
	var code := "%s.%s.%s" % [PREFIX4, b, b.sha256_text().substr(0, 6)]
	return code if bool(decode(code)["ok"]) else ""

## 三考碼解出來的題組（和 data/trio.json 同格式；id＝碼的雜湊）
static func trio_set_of(j: Dictionary, s: Array, allowed: Array) -> Dictionary:
	var e3 = j.get("e3")
	if not e3 is Array or e3.size() != 3:
		return {}
	var foes: Array = []
	for f in e3:
		var e := _clean(f, 10, 15)
		if e.is_empty():
			return {}
		foes.append(e)
	var spent := 0
	for u in s:
		spent += D.cost(int(u[0]))
	var al2: Array = allowed.duplicate()
	al2.sort()
	return {"id": "c" + JSON.stringify([foes, spent, al2]).md5_text().substr(0, 12), "budget": spent, "allowed": allowed, "foes": foes, "sol": s}   # 身分含預算與可用兵種（Codex v161-i1 #7）

## 指定的目標要真的有那隻兵（斬首在敵陣、護送與完美在作者解）；不對回 {}。
static func pick_fields(goal: String, e: Array, s: Array, t) -> Dictionary:
	if not t is Array or t.size() != 2 or not _is_int(t[0], 0, 15) or not _is_int(t[1], 0, 8):
		return {}
	var lst: Array = e if goal == "kill" else s
	for u in lst:
		if int(u[1]) == int(t[0]) and int(u[2]) == int(t[1]):
			match goal:
				"kill":
					return {"goal": "kill", "goal_unit": [int(u[1]), int(u[2])]}
				"protect":
					return {"goal": "protect", "goal_unit": [int(u[1]), int(u[2])], "fixed": [[int(u[0]), int(u[1]), int(u[2])]]}
				"flawless":
					return {"goal": "flawless", "goal_type": int(u[0]), "need_type": true}
	return {}

## 目標的細節（解碼時從敵陣、作者解算，不吃碼裡的數字：少一個能被竄改的欄位）
## protect：作者解裡最貴的兵（同價取欄、列最小）變成固定兵，要活到最後；flawless：作者解裡最多的兵種一隻都不能倒
static func goal_fields(goal: String, e: Array, s: Array = []) -> Dictionary:
	match goal:
		"protect":
			var pb: Array = s[0]
