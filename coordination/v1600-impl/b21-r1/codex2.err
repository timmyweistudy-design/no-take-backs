  2209	## V1.0.0 M13：三考背景運算可取消、有期限（TRIO_LIMIT_MS），被取消的交給 bg（BgPool）回收，不阻塞畫面。
  2210	const TRIO_LIMIT_MS := 20000
  2211	var trio_ctl := {}
  2212	var trio_err := false   # 逾時：不寫星數，結算頁顯示「算太久」
  2213	func _trio_cancel() -> void:
  2214		if trio_thread != null:
  2215			bg.retire(trio_thread)
  2216			trio_thread = null
  2217			trio_busy = false
  2218	
  2219	func _trio_jobs() -> void:
  2220		if trio_thread != null and not trio_thread.is_alive():
  2221			var got: Array = bg.take(trio_thread)
  2222			trio_thread = null
  2223			trio_busy = false
  2224			if int(got[0]) == trio_job and trio_res.size() == 1:
  2225				if (got[1] as Array).is_empty():
  2226					trio_err = true   # 逾時被停：不寫紀錄
  2227					return
  2228				trio_res += got[1]
  2229				_trio_done()
  2230	
  2231	func _trio_done() -> void:
  2232		var s: Dictionary = trio_snap.get("set", _trio_set())
  2233		trio_st = Trio.stars(s, trio_res)
