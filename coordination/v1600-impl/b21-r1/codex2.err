 func _nav_back(fallback := "") -> void:
+	if str(get("overlay")) == "editor" and Save.data.has("ed_draft"):
+		Save.save_data()   # 1.6.0 B21（P13.2）：離開出題台＝草稿寫進存檔（重開遊戲也在）
 	if overlay.begins_with("hub_") or overlay == "playroom":   # V1.0.0：遊戲間也是卡片面板
 		nav_hub = ""   # 關掉卡片面板：之後打完不再自動打開它
 	overlay = str(nav_stack.pop_back()) if not nav_stack.is_empty() else fallback
--- a/game/scripts/game/save.gd
+++ b/game/scripts/game/save.gd
@@ -387,6 +387,9 @@
 	return _is_num(x) and float(x) == floorf(float(x))   # 整數（JSON 讀進來是 float，小數不收；Codex v110-i2 #8）
 
 static func sanitize_extras(out: Dictionary) -> void:
+	# 1.6.0 B21（P13.2）出題台草稿：不是字典＝丟掉（內容在打開出題台時逐格驗）
+	if out.has("ed_draft") and not out["ed_draft"] is Dictionary:
+		out.erase("ed_draft")
 	# 1.6.0 B18（§3.1）對 AI 換邊雙局的會話：壞了＝沒有進行中的一組
 	if out.has("swap_ai_run"):
 		var swr = preload("res://scripts/game/swap_duel.gd").sanitize_run(out["swap_ai_run"])
--- a/game/tests/suites/coach_lab.gd
+++ b/game/tests/suites/coach_lab.gd
@@ -830,3 +830,41 @@
 	g.sb_tab = 1
 	ok(g.famous_games().size() == fl.size(), "名局只讀一次（快取）")
 	g.free()
+
+## 1.6.0 B21（P13.2）出題錯誤落點與保留草稿：擋住出題的原因＋格子；草稿存檔、重開帶回、壞草稿不帶。
+func test_editor_draft_v1600() -> void:
+	var GS = load("res://scripts/ui/game_screens.gd")
+	var SVx = load("res://scripts/game/save.gd")
+	var LSd = load("res://scripts/game/strings.gd")
+	ok(GS.ed_problems({}, {}).size() == 2 and GS.ed_problems({}, {})[0][0] == "ed_err_no_own", "空盤：先說沒有你的兵、再說沒有敵兵")
+	var c := {Vector2i(1, 1): 0, Vector2i(12, 4): 0}
+	ok(GS.ed_problems(c, {}).is_empty(), "兩邊都有兵：可以出")
+	var pw: Array = GS.ed_problems(c, {Vector2i(12, 4): true})
+	ok(pw.size() == 1 and pw[0][0] == "ed_err_wall" and pw[0][1] == [Vector2i(12, 4)], "壓在牆上：圈出那一格")
+	var big := {Vector2i(12, 4): 0}
+	for r in 9:
+		for col in 6:
+			big[Vector2i(col, r)] = 3
+	var pb: Array = GS.ed_problems(big, {})
+	ok(pb.size() >= 1 and pb[0][0] == "ed_err_budget" and (pb[0][1] as Array).size() == 54, "超過 200 金：圈出你的兵")
+	var keep: Dictionary = SVx.data.duplicate(true)
+	var g = GS.new()
+	g.sfx = FakeSfx.new()
+	g.ed_cells = {}
+	g._ed_make()
+	ok(g.ed_err_side == 0 and g.ed_msg == LSd.t("ed_err_no_own"), "按出題時擋下、整個左半邊圈紅", str([g.ed_err_side, g.ed_msg]))
+	g.ed_type = 0
+	g.ed_toggle(Vector2i(2, 3))
+	ok(g.ed_err_side == -1 and SVx.data.get("ed_draft", {}).get("cells", []) == [[0, 2, 3]], "改了就收紅框、草稿跟著改")
+	var d: Dictionary = JSON.parse_string(JSON.stringify(SVx.data))
+	SVx.sanitize_data(d)
+	var g2 = GS.new()
+	g2.sfx = FakeSfx.new()
+	SVx.data["ed_draft"] = d["ed_draft"]
+	g2._ed_load_draft()
+	ok(g2.ed_cells == {Vector2i(2, 3): 0} and g2.ed_msg == LSd.t("ed_draft_back"), "重開（存檔來回）帶回草稿")
+	for bad in ["x", {"cells": [[0, 7, 3]]}, {"cells": [[0, 2, 30]], "goal": 0, "map": 0}, {"cells": [[1.0e30, 2, 3]], "goal": 0, "map": 0}, {"cells": [], "goal": 99, "map": 0}]:
+		ok(not GS.ed_draft_ok(bad), "壞草稿不帶回：%s" % str(bad))
+	g.free()
+	g2.free()
+	SVx.data = keep
