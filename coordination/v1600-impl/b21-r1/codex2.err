   318		if not bool(r.get("ok", false)):
   319			return {"ok": false, "why": "ws_unsolved"}
   320		pz["star2"] = int(r["rem"])
   321		pz["best"] = {"u": s, "p": []}
   322		return {"ok": true, "pz": pz, "sol": s, "why": ""}
extends RefCounted
## V9 地圖資料（純資料＋整數）：左半邊的矩形清單，右半邊自動鏡像，所以公平性由建構保證。
## 座標用千分比（x：0＝左邊界、1000＝中線；y：0＝上、1000＝下），依大小換算到 0.5 格的格點。
const Terrain = preload("res://scripts/core/terrain.gd")

const FREE := 0
const BLOCK := 1
const SLOW := 2
const FAST := 3

const SIZES := [[12, 7], [16, 9], [18, 10]]   # 格數：小、中（標準）、大
const STD_SIZE := 1
const SIZE_SUGGEST := [[60, 16, 1200], [100, 24, 1800], [130, 30, 2400]]   # 建議 金、人數、tick

const PLAIN := 0
const RIVER := 1
const FOREST := 2
const ICE := 3
const LAVA := 4
const CANYON := 5
const QUARRY := 6     # V1.4 #10 沙盤機關：崩塌礦坑
const BEACON := 7     # 烽火關
const PLATES := 8     # 推進板

## V1.4 #10 定時機關：{"t": 第幾 tick, "k": 種類, "r": 左半千分比矩形 [x0, y0, x1, y1]（右半鏡像）, "d": 持續 tick}
## collapse＝崩成擋路（之後一直在）；fire＝火牆燒 d tick（每 FIRE_EVERY tick 扣 FIRE_DMG）；push＝推進板把上面的兵往前推 PUSH 距離。
const FIRE_EVERY := 10
const FIRE_DMG := 6
const PUSH := 1000

## 後面的矩形蓋掉前面。名稱鍵在 strings.csv：map_<key>。biome 給畫面用。
const MAPS := [
	{"key": "plain", "biome": "grass", "rects": []},
