  1827		h += text_h(L.t("fr_later"), tz("C"), cw) + GAP_M + 48.0 + 18.0
  1828		return Rect2(FR_NOTE_X, maxf(24.0, 400.0 - h * 0.5), FR_NOTE_W, h)
