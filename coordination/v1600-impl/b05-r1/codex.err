   311	func _pick_puzzle(id: String, tut: bool) -> void:
   312		puzzle_id = id
   313		_start_mode(Mode.TUTORIAL if tut else Mode.PUZZLE)
   314		if tut and id == "t1":
   315			_toast(tut_remove_text())   # V1.0.0 N6：教學第一關就講「擺錯可以拿掉重擺」
   316		elif tut and id == "t2":
   317			_toast(L.t("tut_counter"))   # V1.0.0 M1：剋制記號 ▲▼ 的互動說明（選一隻兵看敵兵頭上）
   318	
   319	## 照現在的輸入方式講怎麼拿掉兵；並說清楚只有雙人輪流落子才不能收回（遊戲名叫落子無悔）。
   320	func tut_remove_text() -> String:
   321		var how := L.t("tut_rm_mouse")
   322		if pad_mode:
   323			how = L.t("tut_rm_pad", [_pk("remove")])
   324		elif Save.s("place_mode") == "tap":
   325			how = L.t("tut_rm_tap")
   326		return L.t("tut_remove", [how])
