   330	# ── 覆蓋層 ──
   331	func _draw_overlay() -> void:
   332		if overlay != "":
   333			_btns.clear()   # 覆蓋層底下畫面的按鈕不能被點到（例如擺放畫面的開戰、結果頁的按鈕）
   334			probe_screen = {}   # 1.5.0 R14：底下畫面的登記也清掉，由疊層自己登記（Codex v150 cat02 #2）
   335			probe_texts.clear()   # 第五輪：底下畫面的字被遮罩蓋住，版面檢查只量覆蓋層本身
   336			probe_icons.clear()   # 1.5.0：底下畫面的圖示也一樣（結果頁星級改成圖示後，教練疊層下面的星星被量到）
   337			probe_btns.clear()
   338			probe_ctrls.clear()
   339			probe_reset_geom()
   340			if state == St.TITLE:
  1640				return L.t("home_st_daily") if Save.data.get("daily_best", {}).get(sp["key"], []).is_empty() else ""
  1641		return ""
  1642	
  1643	## 第二層卡片：[名稱, 說明, 圖示, 動作, 能不能用]
  1644	func hub_items(kind: String) -> Array:
  1645		match kind:
  1646			"hub_play":
  1647				return [["menu_tutorial", "hc_tutorial_d", "book", func(): overlay = ""; _open("tutorial"), true],
  1648					["menu_vs_ai", "hc_vs_ai_d", "robot", func(): overlay = ""; _open_lobby("ai"), true],
  1649					["menu_duel", "hc_duel_d", "people", func(): overlay = ""; _open_lobby("duel"), true],
  1650					["fog_open", "hc_fog_d", "map", func(): overlay = ""; call("_fog_start"), true],   # V1.6 #20
  1651					["sw_open", "hc_sw_d", "swap", func(): overlay = ""; call("_swap_start"), true],   # 1.2.0 §11.5 換邊雙局
  1652					["cp_open", "hc_cp_d", "people", func(): overlay = ""; call("_cp_start"), true]]   # 1.2.0 §11.6 合作布陣
  1653			"hub_gauntlet":   # V1.0.0 H1／M5：遠征牌＝單人遠征＋雙人接力遠征
  1654				return [["menu_gauntlet", "hc_gauntlet_d", "flag", func(): overlay = ""; _enter_gauntlet(), not _demo()],
  1655					["cmp_title", "hc_cmp_d", "book", func(): call("_camp_open"), not _demo()],   # 1.2.0 §11.7 戰役
  1656					["coop_open", "hc_coop_d", "people", func(): overlay = ""; call("_coop_start"), not _demo()],   # V1.6 #21
  1657					["tw_open", "hc_tw_d", "tower", func(): overlay = ""; call("_tower_open"), not _demo()]]   # 1.4.0 §11.1 無盡塔
  1658			"hub_challenge":   # V1.0.0 H1：「挑戰」拆掉，這張牌改成「殘局」：單人求解類
  1659				return [["menu_puzzle", "hc_puzzle_d", "puzzle", func(): overlay = ""; _open("puzzles"), true],
  1660					["menu_trials", "hc_trials_d", "trophy", func(): overlay = ""; _open("trials"), true],
  1661					["rush_open", "hc_rush_d", "clock", func(): overlay = ""; call("_rush_start"), not _demo()],   # V1.6 #8（題庫是全部殘局：試玩版不開，Codex v160-i1 #7）
  1662					["trio_open", "hc_trio_d", "people", func(): overlay = "trio"; _focus = 0, not _demo()],   # V1.6 #17
  1663					["od_open", "hc_od_d", "star", func(): overlay = "owner_daily"; _focus = 0, not _demo()]]   # 1.3.0 §12.7 每日老闆出題
  1664			"playroom":   # V1.0.0 H1：遊戲間＝定期回來的（每日、每週、幽靈、裂隙）＋派對玩法（競猜、輪抽、車輪、雙封蠟）
  1665				return [["menu_daily", "hc_daily_d", "dice", func(): overlay = ""; call("_daily_entry"), not _demo()],   # 1.1.0 N4：今天打過了就開最近 7 天
  1666					["wk_open", "hc_weekly_d", "cards", func(): overlay = "weekly", not _demo()],
  1667					["gh_open", "hc_ghosts_d", "skull", func(): overlay = "ghosts", not _demo()],
  1668					["rift_open", "hc_rift_d", "swap", func(): overlay = "rift"; _focus = 0, not _demo()],   # V1.6 #10
  1669					["pr_wager", "pr_wager_d", "dice", func(): call("_wager_new"), true],
  1670					["pr_draft", "pr_draft_d", "cards", func(): call("_draft_new"), true],
  1671					["pr_waves", "pr_waves_d", "swords", func(): call("_wave_start"), true],
  1672					["pr_sealed", "pr_sealed_d", "book", func(): call("_sealed_start"), true]]
  1673			"hub_collect":
  1674				return [["menu_codex", "hc_codex_d", "book", func(): overlay = ""; _open_codex(0), true],
  1675					["paint_open", "hc_paint_d", "star", func(): call("_paint_open"), true],
  1676					["menu_profile", "hc_profile_d", "trophy", func(): overlay = ""; _open("profile"), true],
  1677					["nem_open", "hc_nem_d", "flag", func(): overlay = "nemeses", not _demo()],
  1678					["ed_open", "hc_ed_d", "puzzle", func(): overlay = "editor"; _focus = 0, not _demo()],   # V1.6 #16 出題台
  1679					["tour_title", "hc_tour_d", "book", func(): overlay = "tour"; _focus = 0, true],   # V1.6.1 N2 新玩法導覽（常駐）
  1680					["sb_title", "hc_sb_d", "book", func(): overlay = "songbook"; _focus = 0, true],   # 1.2.0 §11.8 棋譜本
  1681					["menu_codes", "hc_codes_d", "copy", func(): overlay = "codes"; _focus = 0, true]]   # 1.5.0 §1.1：代碼從標題系統鈕移到收藏（標題只留設定、離開）
  1682		return []
  1683	
  1684	func _draw_hub(kind: String) -> void:
  1685		_dim(0.55)
  1686		nav_stack.clear()   # 回到卡片面板＝堆疊重來
  1687		var items := hub_items(kind)
  1688		var cols := 4 if items.size() > 6 or items.size() == 4 else 3   # V1.6：7 張以上兩列四欄（三列在 150% 放不下）；V1.0.0：剛好 4 張排一列
  1689		var rows := ceili(items.size() / float(cols))
  1690		# V1.5.2 L1：模態面板水平置中；卡片群在面板內置中；卡片從緞帶完整下緣＋GAP_L 起排
  1691		var head := ceilf(h1_bottom(12.0) + GAP_L)
  1692		var rec := hub_note(kind)   # V1.0.0：遊戲間底下的紀錄（眼力分、車輪戰最佳）
  1693		var rec_h := (text_h(rec, tz("S"), 960.0) + GAP_M) if rec != "" else 0.0
  1694		var cw := 236.0
  1695		var pw := 800.0 if cols == 3 else 1040.0
  1696		var ch := 160.0
  1697		var ph := 0.0
  1698		# 卡片高度照最長的說明算；1.2.0 字級表放大後兩列在 150% 會超出畫面 → 先試加寬卡片（說明換行變少）再算高度
  1699		for cw_try in [236.0, 278.0]:
  1700			cw = cw_try
  1701			ch = 160.0
  1702			for it0 in items:
  1703				ch = maxf(ch, 82.0 + tz("B") * 1.6 + text_h(L.t(str(it0[1])), tz("C"), cw - 32) + 14.0)
  1704			ph = head + rows * (ch + 14.0) - 14.0 + GAP_L + rec_h + 44.0 + GAP_L
  1705			pw = (800.0 if cols == 3 else 1040.0) + (cw - 236.0) * cols
  1706			if ph <= 768.0:
  1707				break
  1708		var P := Rect2((1280.0 - pw) * 0.5, clampf((800.0 - ph) * 0.5, 16.0, 120.0), pw, maxf(ph, 300.0))
  1709		_panel(P)
  1710		_h1(Vector2(P.get_center().x, P.position.y + 12), L.t({"hub_play": "home_play", "hub_gauntlet": "menu_gauntlet", "hub_challenge": "home_challenge", "hub_collect": "home_collect", "playroom": "menu_playroom"}.get(kind, "home_play")))
  1711		var ncol := mini(cols, items.size())
  1712		var gx := P.position.x + (P.size.x - (ncol * cw + (ncol - 1) * 14.0)) * 0.5
  1713		var r5: Array = [[], []]   # V1.6 #4：R5 每一列卡片的圖示、標題、說明起點
  1714		for i in items.size():
  1715			var it: Array = items[i]
  1716			var r := Rect2(gx + (i % cols) * (cw + 14), P.position.y + head + (i / cols) * (ch + 14), cw, ch)
  1717			r5[mini(i / cols, 1)].append([Rect2(r.position + Vector2(cw / 2 - 20, 24), Vector2(40, 40)), Rect2(r.position + Vector2(10, 78), Vector2(cw - 20, tz("B"))), Rect2(r.position + Vector2(16, 82 + tz("B") * 1.6), Vector2(cw - 32, tz("C")))])
  1718			btn_paper = true
  1719			var cb: Callable = it[3]
  1720			var ek := str(it[0])
  1721			var ci := i
  1722			_btn(r, "", func(): _nav_push(kind); nav_focus[kind] = ci; nav_hub = kind; Guide.see(Save.data, ek); Save.data["recent"] = Recent.push(Save.data.get("recent", []), kind, ek); cb.call(), bool(it[4]), i == 0)
  1723			btn_paper = false
  1724			var on_paper: bool = bool(_btns[_btns.size() - 1]["en"]) and not bool(Save.s("plain_ui"))
