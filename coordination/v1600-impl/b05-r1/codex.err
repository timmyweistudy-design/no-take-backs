   313		var today: int = Daily.today()
   314		var best: Dictionary = Save.data.get("daily_best", {})
   315		for i in DAILY_PAST:
   316			var day := today - i
   317			var sp: Dictionary = Daily.spec(day)
   318			var b: Array = best.get(sp["key"], [])
   319			var date := Time.get_date_string_from_unix_time(day * 86400)
   320			var line := "%s　%s" % [date, L.t("daily_mut_%d" % int(sp["mut"]))] + (("　・%d%%" % int(b[0])) if not b.is_empty() else "")
   321			_text(Vector2(P.position.x + 40, y + 12), line, tz("S"), Color.WHITE if i == 0 else TXT_DIM, false, false, 460)
