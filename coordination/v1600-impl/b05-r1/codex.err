   244	func _ns_text(k: String) -> String:
   245		if k.begins_with("v16:"):
   246			return L.t("ns_new", [L.t(k.substr(4))])
   247		if k == "gauntlet_cont":
   248			return L.t("ns_gauntlet_cont", [int(Save.data.get("gauntlet_run", {}).get("stage", 1))])
   249		if k == "puzzle_more":
   250			var pid := Guide.next_puzzle_id(Save.data, PZ.all_puzzles())
   251			var all := PZ.all_puzzles()
   252			for i in all.size():
   253				if str(all[i]["id"]) == pid:
   254					return L.t("ns_puzzle_more", [_pz_label(i)])
   255			return L.t("ns_puzzle")
   256		return L.t("ns_" + k)
   257	
   258	## 殘局在全部清單的第 i 個 → 「章-關」
   259	func _pz_label(i: int) -> String:
   260		var n := 0
   261		for ch in range(1, PZ.CHAPTERS + 1):
   262			var c := PZ.chapter(ch).size()
   263			if i < n + c:
   264				return "%d-%d" % [ch, i - n + 1]
   265			n += c
   266		return str(i + 1)
