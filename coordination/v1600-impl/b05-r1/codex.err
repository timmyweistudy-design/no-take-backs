  1024	func _process_cmds() -> int:
  1025		var done := 0
  1026		_update_gen()
  1027		var q := _cmds
  1028		_cmds = []
  1029		for c in q:
  1030			if c["gen"] != _gen:
  1031				# 畫面已經換了：丟掉。但「放開滑鼠」一定要清掉拖曳／塗兵狀態（Codex S1 #2）
  1032				if c["kind"] == "mb" and not c["data"]["pressed"]:
  1033					_mb_release_cleanup()
  1034				elif c["kind"] == "padbtn" and not c["data"]["pressed"]:
  1035					_fp_abort_drag()   # 手把放開 A／X 的事件過期：同樣清掉（Codex 實作第 3 輪 #1）
  1036				continue
  1037			if c["kind"] == "click":
  1038				done += _do_click(c["data"])
  1039			elif c["kind"] == "mb":
  1040				# 滑鼠按鍵（擺放、拖曳、移除）也走同一個佇列，和鍵盤選兵的先後順序一致（Codex S1 #2）
  1041				_mb_cmd(c["data"])
  1042				done += 1
  1043			elif c["kind"] == "paint":
  1044				_paint_cmd(c["data"])
  1045			elif c["kind"] == "padbtn":
  1046				if not _fp_pad_button(int(c["data"]["b"]), bool(c["data"]["pressed"])) and c["data"]["pressed"]:
  1047					var mp := {JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_B: KEY_ESCAPE}
  1048					if mp.has(int(c["data"]["b"])):
  1049						_key(mp[int(c["data"]["b"])])
  1050				done += 1
  1051			elif c["kind"] == "key":
  1052				_key(int(c["data"]))
  1053				done += 1
  1054			elif c["kind"] == "pan":
  1055				cam_pan(c["data"])
  1056			elif c["kind"] == "tool":
  1057				if state == St.PLACE and overlay == "":
  1058					call("_deploy_tool", str(c["data"]))
  1059				done += 1
  1060			_update_gen()
  1061		return done
