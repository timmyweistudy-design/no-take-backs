   321	## 1.3.0 §2：雙擊回全景只認盤面範圍（按鈕列、HUD 不算）。
   322	func _field_hit(p: Vector2) -> bool:
   323		if p.y <= 96.0 or p.y >= (640.0 if _replay_controls_active() else 760.0):
   324			return false
   325		for b in _btns:
   326			if (b["r"] as Rect2).has_point(p):
   327				return false   # 按鈕上雙擊不算（Codex cat06 #4）
   328		var lo: Vector2 = _cam * ORIGIN
   329		var hi: Vector2 = _cam * (ORIGIN + fld_size)
   330		return Rect2(lo, hi - lo).has_point(p)
