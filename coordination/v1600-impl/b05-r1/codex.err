   307	func _draw_daily_past() -> void:
   308		var rowh := 52.0
   309		var help := L.t("dp_help")
   310		var P := modal_rect(760, 12.0 + h1_help_h(help, tz("S"), 680) + GAP_L + DAILY_PAST * (rowh + GAP_S) + GAP_L + 44.0 + GAP_L)
   311		_panel(P)
