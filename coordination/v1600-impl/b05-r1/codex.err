   788		_draw_desk()   # 1.2.0 §1.1 桌面世界：整個畫面是一張胡桃木桌（取代深綠底＋一圈樹）
   789		if (state == St.BATTLE or state == St.PLACE) and not bool(Save.s("plain_ui")):
   790			draw_rect(Rect2(0, 0, 1280, 800), Color(DIM_INK, 0.15))   # 1.2.0 第 6 大類 F §5.5 景深：對局時桌面退後（盤面不受影響，盤在之後畫）
   791		_sync_field()
   792		var fxf := _fld_xf()
   793		var cam := fxf
   794		if state == St.BATTLE or state == St.RESULT:
   795			var off := Vector2.ZERO
   796			if shake > 0 and _fx_on("shake"):
   797				off = Vector2(sin(time * 90) * 2, cos(time * 77) * 2) * int(Save.s("shake_pct")) / 100.0   # V1.5：鏡頭震動強度
   798			var w := clampf((zoom - 1.0) / 0.5, 0.0, 1.0)
   799			var c := (ORIGIN + FIELD / 2).lerp(fxf * zoom_center, w)
   800			var half := Vector2(640, 388) / zoom
   801			var anchor := Vector2(640, 388 + BATTLE_DY)
   802			var lo := ORIGIN + half - Vector2(60, 100)
   803			var hi := ORIGIN + FIELD - half + Vector2(60, 100)
   804			c = Vector2(clampf(c.x, minf(lo.x, hi.x), maxf(lo.x, hi.x)), clampf(c.y, minf(lo.y, hi.y), maxf(lo.y, hi.y)))
   805			cam = Transform2D(0, Vector2(zoom, zoom), 0, anchor - c * zoom + off) * fxf
   806		if state == St.TITLE:
   807			# 第七輪 D4：示範戰場縮小放右邊，不被左側面板壓到
   808			cam = Transform2D(0, Vector2(0.72, 0.72), 0, Vector2(1270.0 - (ORIGIN.x + FIELD.x) * 0.72, 400.0 - (ORIGIN.y + FIELD.y / 2.0) * 0.72))
   809		draw_set_transform_matrix(cam)
