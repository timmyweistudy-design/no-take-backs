--- (新增測試，附在 game/tests/suites/ui.gd 末尾) ---
## 1.6.0 B05（S9；P8.1、P8.2）第一幕：首開入館便條 ≤35% 屏、不壓示範戰場；「開第一局」直達大廳確認步（冷啟到開戰 2 下，
## 真畫面點擊是截圖流程的 FIRSTRUN）；桌上三主牌＋「更多」抽屜（IN-160-02：停用、返回、手把）。
func test_first_act_v1600() -> void:
	var GS = load("res://scripts/ui/game_screens.gd")
	var g = GS.new()
	g.sfx = FakeSfx.new()
	g._load_fonts()
	var LS = load("res://scripts/game/strings.gd")
	var Sv = load("res://scripts/game/save.gd")
	var keep_lang = LS.lang
	var keep_ts = Sv.settings.get("text_scale", 100)
	var keep_fd = Sv.settings.get("first_done", false)
	var fz := 0.72
	var off := Vector2(1270.0 - (g.ORIGIN.x + g.FIELD.x) * fz, 400.0 - (g.ORIGIN.y + g.FIELD.y / 2.0) * fz)
	var field := Rect2(g.ORIGIN * fz + off, g.FIELD * fz)
	var worst := 0.0
	var hit := false
	for lg in ["zh_TW", "en", "zh_CN", "ja"]:
		LS.lang = lg
		for sc in [100, 125, 150]:
			Sv.settings["text_scale"] = sc
			var R: Rect2 = g.first_run_rect()
			worst = maxf(worst, R.get_area() / (1280.0 * 800.0))
			hit = hit or R.intersects(field) or R.end.y > 800.0 or R.position.y < 0.0
	LS.lang = keep_lang
	Sv.settings["text_scale"] = keep_ts
	ok(worst <= 0.35 and not hit, "首開便條四語三字級最大 %.1f%% 屏（≤35%%）、不壓示範戰場、不出畫面" % (worst * 100.0))
	g._first_battle()
	ok(g.overlay == "lobby" and g.lobby_step == 2 and bool(Sv.settings.get("first_done", false)), "開第一局：直接進對 AI 大廳的確認步（再按開戰＝冷啟 2 下）")
	Sv.settings["first_done"] = keep_fd
	g.overlay = ""
	g.home_more = false
	ok(g.home_plaques().size() == 4, "桌上三主牌＋更多（抽屜關著 4 塊）")
	(g.home_plaques()[3][3] as Callable).call()
	ok(g.home_more and g.home_plaques().size() == 6, "按更多＝抽屜打開，多出遊戲間、收藏")
	(g.home_plaques()[5][3] as Callable).call()
	ok(g.overlay == "hub_collect" and not g.home_more, "抽屜裡選收藏＝打開收藏、抽屜收起")
	g.overlay = ""
	g.state = g.St.TITLE
	g.home_more = true
	g._key(KEY_ESCAPE)
	ok(not g.home_more and g.overlay == "", "返回（Esc／B）先收起抽屜")
	var pq: Array = g.home_plaques()
	ok(not bool(pq[1][4]) and bool(pq[0][4]) and bool(pq[3][4]), "試玩版：遠征停用；對戰、更多照開（抽屜裡遊戲間停用照舊）")
	g.home_more = true
	ok(not bool(g.home_plaques()[4][4]), "試玩版：抽屜裡的遊戲間停用")
	g.home_more = false
	var src: String = FileAccess.get_file_as_string("res://tools/dev_main.gd")
	ok(src.find("print(\"FIRSTRUN \"") >= 0 and src.find("[4, \"playroom\", true], [5, \"hub_collect\", true]") >= 0, "截圖流程：冷啟點擊走查（FIRSTRUN）、手把走查涵蓋抽屜（PADWALK）")
	g.free()

exec
/bin/bash -lc "rg --files -g AGENTS.md; nl -ba build/cg/b05/game/tools/dev_main.gd | sed -n '2590,2675p'; rg -n 'plain_ui|_ink_mode|home_plaques|home_more|home_next|recent|建議|最近|func _go_title|func _open_lobby|func _btn|R14' build/cg/b05/game/scripts/ui/{game_screens.gd,screens/game_menus.gd,*.gd}" in /mnt/c/Users/timmy/projects/no-take-backs
 succeeded in 837ms:
  2590	
  2591	
  2592	## 1.6.0 B06（Codex B06 r1 #4）：便條釘位的真實繪製＋手把——真的畫出來（按鈕由繪製登記）、十字鍵從結果頁按鈕走到「打開看」、A 打開、B 關掉。
  2593	## 結果印在 run.log：NOTEPIN OK／FAIL（驗收鏈數 24 組都要 OK）。存檔已是截圖前綴，B 關掉記住的「看過」不碰正式存檔。
  2594	## 1.6.0 B04（S1）：大廳手把 ≤3 步開戰——真的畫面、真的手把 A（走 _input），從打開大廳（第一步）按到進入擺陣，
  2595	## 印 LOBBYPAD OK／FAIL；走完回到大廳第三步、還原手把模式（之後的截圖照舊）。
  2596	## 1.6.0 B05（S9）：冷啟到開戰的點擊數——真畫面、真的滑鼠點擊（走 _input）：首開便條按「開第一局」→ 大廳確認步按「開戰」→ 擺陣。
  2597	## 印 FIRSTRUN OK／FAIL（點擊數、便條面積比、和示範戰場框相交否）；走完回到標題。
  2598	func _first_run_walk() -> void:
  2599		var pad0: bool = pad_mode
  2600		var had_dis: bool = shot_state.has("dis")
  2601		shot_state.erase("dis")
  2602		var fd0 = Save.s("first_done")
  2603		var frame := func() -> void:
  2604			queue_redraw()
  2605			await get_tree().process_frame
  2606			await RenderingServer.frame_post_draw
  2607		var click := func(p: Vector2) -> void:
  2608			for dn in [true, false]:
  2609				var e := InputEventMouseButton.new()
  2610				e.button_index = MOUSE_BUTTON_LEFT
  2611				e.position = p
  2612				e.pressed = dn
  2613				_input(e)
  2614				await get_tree().process_frame
  2615		_go_title()
  2616		overlay = "first_run"
  2617		await frame.call()
  2618		var R: Rect2 = first_run_rect()
  2619		var area: float = R.get_area() / (1280.0 * 800.0)
  2620		# 標題示範戰場在畫面上的框（game_screens 標題的鏡頭：縮 0.72、靠右；和 _draw 同一組數字）
  2621		var fz := 0.72
  2622		var off := Vector2(1270.0 - (ORIGIN.x + FIELD.x) * fz, 400.0 - (ORIGIN.y + FIELD.y / 2.0) * fz)
  2623		var field := Rect2(ORIGIN * fz + off, FIELD * fz)
  2624		var hits_field: bool = R.intersects(field)
  2625		var clicks := 0
  2626		var cw: float = R.size.x - 40.0
  2627		var hw: float = (cw - 8.0) / 2.0
  2628		await click.call(Rect2(R.position.x + 20.0 + hw + 8.0, R.end.y - 18.0 - 48.0, hw, 48.0).get_center())   # 開第一局
  2629		clicks += 1
  2630		await frame.call()
  2631		var in_lobby: bool = overlay == "lobby" and lobby_step == 2
  2632		await click.call(Rect2(966, 700, 234, 48).get_center())   # 大廳確認步「開戰」
  2633		clicks += 1
  2634		for i in 3:
  2635			await get_tree().process_frame
  2636		var ok: bool = in_lobby and state == St.PLACE and clicks <= 3 and area <= 0.35 and not hits_field
  2637		print("FIRSTRUN ", "OK" if ok else "FAIL", " ", JSON.stringify({"clicks": clicks, "lobby_confirm": in_lobby, "place": state == St.PLACE, "note_area": snappedf(area, 0.001), "hits_field": hits_field}))
  2638		Save.set_setting("first_done", fd0)
  2639		_go_title()
  2640		overlay = ""
  2641		pad_mode = pad0
  2642		if had_dis:
  2643			shot_state["dis"] = true
  2644	
  2645	func _lobby_pad_walk() -> void:
  2646		var pad0: bool = pad_mode
  2647		var had_dis: bool = shot_state.has("dis")   # 停用組合：全部按鈕畫成停用，A 按不下去；走的時候拿掉（同 _note_pin_walk）
  2648		shot_state.erase("dis")
  2649		var frame := func() -> void:
  2650			queue_redraw()
  2651			await get_tree().process_frame
  2652			await RenderingServer.frame_post_draw
  2653		var press := func(b: int, same_frame := false) -> void:
  2654			for dn in [true, false]:
  2655				var e := InputEventJoypadButton.new()
  2656				e.device = 0
  2657				e.button_index = b
  2658				e.pressed = dn
  2659				_input(e)
  2660				if not same_frame:
  2661					await get_tree().process_frame
  2662		var rep := {}
  2663		# ①對 AI、②雙人：從打開大廳（第一步）連按 A，幾下進到擺陣（S1 ≤3）
  2664		for kind in ["ai", "duel"]:
  2665			_go_title()
  2666			_open_lobby(kind)
  2667			lobby_step = 0
  2668			var steps := 0
  2669			for i in 5:
  2670				await frame.call()
  2671				if state != St.TITLE or overlay != "lobby":
  2672					break
  2673				await press.call(JOY_BUTTON_A)
  2674				steps += 1
  2675			for i in 3:
