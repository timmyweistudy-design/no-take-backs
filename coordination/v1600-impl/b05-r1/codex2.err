func _btn(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
	if layout_probe and get("shot_dir") != "" and (get("shot_state") as Dictionary).has("dis"):
		enabled = false   # V1.2.1：版面檢查的「停用」狀態：全部按鈕畫成停用，檢查停用樣式（手把流程不受影響）
	var idx := _btns.size()
	var hit := r
	if btn_hit_min > r.size.y:
		var dh := (btn_hit_min - r.size.y) * 0.5
		hit = r.grow_individual(0.0, dh, 0.0, dh)
		if layout_probe:
			probe_hits.append(hit)
	_btns.append({"r": hit, "cb": action, "en": enabled, "snd": "k_confirm" if primary else ("k_back" if label == L.t("back") or label == L.t("menu") else "k_click"), "group": btn_group})
	var hover := hit.has_point(mouse) and not pad_mode
	var focus := pad_mode and idx == _focus
	var bg := TH_WOOD_L if not primary else TH_PRIMARY
	if tint.a > 0:
		bg = tint
	if not enabled:
		bg = Color(0.2, 0.17, 0.15)
	elif hover or focus:
		bg = bg.lightened(0.16)
		if hover:
			_hover_now = idx
	var pressed := hover and enabled and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
	var rd := r.grow(-minf(r.size.x, r.size.y) * 0.025) if pressed else r
	# V1.2 B3：按鈕下緣 3px 厚度（木牌的側面）；按下時往下沉、厚度消失
	var solid: bool = tint.a <= 0.0 or tint.a > 0.6
	if solid and r.size.y >= 20.0:
		# 厚度畫在按鈕框內（下緣 3px），命中框、探針與畫面一致（Codex v120-impl2）；按下時面板往下壓、厚度被蓋住
		_box(Rect2(rd.position, rd.size), Color(bg.darkened(0.55), 1.0), Color(0, 0, 0, 0), 7.0)
		rd = Rect2(rd.position + Vector2(0, 3.0 if pressed else 0.0), rd.size - Vector2(0, 3))
	var paper_face := btn_paper and enabled and not bool(Save.s("plain_ui"))
	# 1.2.0 §1.3：沒有自訂色的一般按鈕＝山毛櫸木牌（墨色字）；主要按鈕＝朱漆木牌＋左側紅蠟封；停用＝褪色木牌
	var cloth: bool = btn_cloth != "" and not paper_face and not bool(Save.s("plain_ui")) and _ui_tex(MAT[btn_cloth]) != null   # 1.2.0 §1.3 布標分頁
	# 1.2.0 第 4 大類 A10：「木色／選中」兩種標準色的按鈕也走木牌（原本是深色圓角塊，Antigravity cat03 #1）；選中＝暖一點的木牌＋朱砂框（不只靠顏色）。
	# 木色／選中但沒有自己標籤的按鈕（字由呼叫端另外畫白字：技能格、試煉卡、禁用卡、遠征獎勵卡）維持原本深色，避免白字落在淺木牌上（Codex cat04 #1）
	var sel_on: bool = tint == TH_ACTIVE
	dying = dying.filter(func(g): return g["t"] < death_life(int(g["type"])))   # V1.3 A5：倒棋留 1.7 秒
	for g in graves:
		g["t"] += delta
	graves = graves.filter(func(g): return g["t"] < 3.0)
	if overlay == "codex":
		_codex_tick(delta)
	if overlay == "ai_busy":
		_ai_poll()
	if not pre_old.is_empty():
		_pre_reap()
	if state == St.TITLE and demo != null and shot_dir == "" and Save.s("title_bg") == "demo" and not bool(Save.s("reduce_motion")):   # V1.5：主畫面背景可改靜態
		demo_acc += delta
		while demo_acc >= 0.05:
			demo_acc -= 0.05
			demo.step()
		if demo.finished:
			_new_demo()
	if state == St.BATTLE and shot_dir == "":
		_battle_process(delta)
		_follow_update(delta)
	elif state == St.RESULT:
		zoom = lerpf(zoom, 1.0, delta * 4)
	if font_bold != null:
		_layout_texts()   # 戰鬥事件產生跳字之後才排版，新跳字第一幀就有位置（Codex S1 #3）
	queue_redraw()



# ───────────────────────── 繪圖 ─────────────────────────
## 量測對照用（`--no-desk-paper`／LAYOUT_NO_DESK_PAPER=1）：關掉桌燈紙，比「紙面暗斑」名單哪些是 B06 造成的
var no_desk_paper := "--no-desk-paper" in OS.get_cmdline_user_args()
func _draw() -> void:
	mag_on = bool(Save.s("magnify"))   # V1.6 #7；V1.6.1 F4：手把也能用（指焦點按鈕上的字）
	mag_hit = []
	var _t0 := Time.get_ticks_usec()
	# 1.6.0 B06（方案 P1.3 主材質全站）：桌燈下的紙——全站紙面（羊皮紙、卡紙）乘桌燈色調、紙上彩色字用深墨（B03 結果紙同一套）。
	# 標題頁本身（沒有疊層）是首開與主牌的版面，屬 B05；大廳＝挑戰簿（B04：簿紙再暗一階，貼圖上蓋平塗層讓斑紋減半，暗斑不 <4.5:1）；
	# 簡化介面照舊平塗亮紙（雙階色塊規格）。
	var desk_paper: bool = not bool(Save.s("plain_ui")) and not (state == St.TITLE and overlay == "") and overlay != "first_run" and not no_desk_paper   # 1.6.0 B05：首開便條是一張新紙（亮紙、墨字；Hydrogen B05 r1 #1）
	paper_tone = PAL.PAPER_DESK_TONE if desk_paper else Color.WHITE
	paper_book = desk_paper and (overlay == "lobby" or note_ret == "lobby")   # 1.6.0 B04：大廳＝挑戰簿（B06 留給本批）
	ink_deep = desk_paper
	_draw_inner()
	ink_deep = false
	paper_tone = Color.WHITE
	paper_book = false
	_draw_magnifier()   # V1.6 #7：最上層
	perf_draw_us = Time.get_ticks_usec() - _t0


func _draw_inner() -> void:
	_btns.clear()
	probe_screen = {}
	_probe_cell_seq = 0
	probe_texts.clear()
	probe_btns.clear()
	probe_faces.clear()
	probe_ctrls.clear()
	probe_boxes.clear()
	probe_icons.clear()
	probe_reset_geom()

