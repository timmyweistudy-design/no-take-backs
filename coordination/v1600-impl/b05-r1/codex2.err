  1028	func _process_cmds() -> int:
  1029		var done := 0
  1030		_update_gen()
  1031		var q := _cmds
  1032		_cmds = []
  1033		for c in q:
  1034			if c["gen"] != _gen:
  1035				# 畫面已經換了：丟掉。但「放開滑鼠」一定要清掉拖曳／塗兵狀態（Codex S1 #2）
