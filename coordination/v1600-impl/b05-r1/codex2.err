  1037					_mb_release_cleanup()
  1038				elif c["kind"] == "padbtn" and not c["data"]["pressed"]:
  1039					_fp_abort_drag()   # 手把放開 A／X 的事件過期：同樣清掉（Codex 實作第 3 輪 #1）
  1040				continue
  1041			if c["kind"] == "click":
  1042				done += _do_click(c["data"])
  1043			elif c["kind"] == "mb":
  1044				# 滑鼠按鍵（擺放、拖曳、移除）也走同一個佇列，和鍵盤選兵的先後順序一致（Codex S1 #2）
  1045				_mb_cmd(c["data"])
  1046				done += 1
  1047			elif c["kind"] == "paint":
  1048				_paint_cmd(c["data"])
  1049			elif c["kind"] == "padbtn":
  1050				if not _fp_pad_button(int(c["data"]["b"]), bool(c["data"]["pressed"])) and c["data"]["pressed"]:
  1051					var mp := {JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_B: KEY_ESCAPE}
  1052					if mp.has(int(c["data"]["b"])):
  1053						_key(mp[int(c["data"]["b"])])
  1054				done += 1
  1055			elif c["kind"] == "key":
  1056				_key(int(c["data"]))
  1057				done += 1
  1058			elif c["kind"] == "pan":
  1059				cam_pan(c["data"])
  1060			elif c["kind"] == "tool":
  1061				if state == St.PLACE and overlay == "":
  1062					call("_deploy_tool", str(c["data"]))
  1063				done += 1
  1064			_update_gen()
  1065		return done
