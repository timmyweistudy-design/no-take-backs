  1886		btn_group = ""
  1887		y += bh + GAP_M
  1888		_text(Vector2(R.get_center().x, y), L.t("fr_later"), tz("C"), TXT_DIM, true, false, cw)
  1889		_ink_mode = false
  1890		var by := R.end.y - 18.0 - 48.0
