+## 找一個不疊別的跳字、不蓋頭胸、在盤內的位置。回傳 [Rect2, 找到乾淨位置?]；找不到時回傳蓋得最少的候選。
+## 順序：原位往上推 → 左右各一、兩個字寬再往上推 → 往下（腳下）推；一般跳字最遠 TEXT_MAX_MOVE，關鍵（far）最遠 TEXT_MAX_MOVE_KEY。
+const TEXT_MAX_MOVE_KEY := 160.0   # 2.5 格：關鍵字不能丟，擠成一團時寧可遠一點（仍在交戰區附近）
+func _text_slot(r: Rect2, placed: Array, faces: Array, board: Rect2, far := false) -> Array:
+	var lim := TEXT_MAX_MOVE_KEY if far else TEXT_MAX_MOVE
+	var near: Array = []
+	var zone := r.grow(lim + r.size.x * 2.0)
+	for q: Rect2 in faces:
+		if zone.intersects(q):
+			near.append(q)
+	var best := r
+	var best_cost := INF
+	var side := r.size.x * 0.5 + 10.0
+	for dir in [-1.0, 1.0]:
+		for dx in [0.0, -side, side, -side * 2.0, side * 2.0]:
+			var dy := 0.0 if dir < 0.0 else 4.0
+			while dy <= lim:
+				var c := Rect2(r.position + Vector2(dx, dir * dy), r.size)
+				c.position.x = clampf(c.position.x, board.position.x, maxf(board.position.x, board.end.x - c.size.x))
+				c.position.y = clampf(c.position.y, board.position.y, maxf(board.position.y, board.end.y - c.size.y))
+				var cost := 0.0
+				var jump := 0.0
+				for q: Rect2 in placed:
+					if q.intersects(c):
+						cost += c.intersection(q).get_area() + 1.0
+						jump = maxf(jump, (c.end.y - q.position.y) if dir < 0.0 else (q.end.y - c.position.y))
+				for q: Rect2 in near:
