diff --git a/game/scripts/ui/battle/battle_units.gd b/game/scripts/ui/battle/battle_units.gd
index 05428d3..63624cd 100644
--- a/game/scripts/ui/battle/battle_units.gd
+++ b/game/scripts/ui/battle/battle_units.gd
@@ -510,6 +510,53 @@ const FOCUS_SCALE := 1.4 / 1.25
 func focus_scale(id: int) -> float:
 	return FOCUS_SCALE if follow_id >= 0 and id == follow_id else 1.0
 
+## 1.6.0 B08（P3.3、S4）：兵偶頭胸框（戰場座標）——跳字不蓋。腳底點往上 FACE_BOT～FACE_TOP（×HK×巨獸／跟拍縮放），半寬 FACE_HW。
+## 數字對截圖量過（--face-debug 把框畫出來）。
+const FACE_TOP := 54.0
+const FACE_BOT := 14.0
+const FACE_HW := 17.0
+func face_rects() -> Array:
+	var out: Array = []
+	if view == null:
+		return out
+	for u in view.units:
+		if not u.alive or u.hidden:
+			continue
+		var sc: float = (BossD.DRAW_SCALE if u.boss else 1.0) * focus_scale(u.id) * HK
+		var p: Vector2 = _upos(u) + _open_drop(u)
+		out.append(Rect2(p + Vector2(-FACE_HW, -FACE_TOP) * sc, Vector2(FACE_HW * 2.0, FACE_TOP - FACE_BOT) * sc))
+	return out
+
+## 交戰區：和敵兵相距 ≤1.5 格的兵的外接框，往外一格、夾在盤內；沒有交戰＝整個盤。
+func engage_rect() -> Rect2:
+	var board := Rect2(ORIGIN, fld_size)
+	if view == null:
+		return board
+	var ps: Array = [[], []]
+	for u in view.units:
+		if u.alive and not u.hidden:
+			ps[u.team].append(_upos(u))
+	var r := Rect2()
+	var any := false
+	var lim := (CS * 1.5) * (CS * 1.5)
+	for a: Vector2 in ps[0]:
+		for b: Vector2 in ps[1]:
+			if a.distance_squared_to(b) <= lim:
+				var pair := Rect2(a, Vector2.ZERO).expand(b)
+				r = pair if not any else r.merge(pair)
+				any = true
+	if not any:
+		return board
+	return r.grow(CS).intersection(board)
+
+func _draw_face_debug() -> void:
+	for q: Rect2 in face_rects():
+		draw_rect(q, Color(1, 0, 1, 0.9), false, 1.5)
+	draw_rect(engage_rect(), Color(0, 1, 1, 0.9), false, 2.0)
+	for f in fx:
+		if f["kind"] == "text" and f.has("rr"):
+			draw_rect(f["rr"], Color(1, 1, 0, 0.9), false, 1.0)
+
 ## 1.3.0 §3 平原棉布拼貼（64px＝一格）：斜紋（每 6px 一道亮／暗細紋）；grid＝true 時上緣、左緣是壓縫棉線（亮線＋下方暗影、每 4px 一針），左上角一個小線結。
 static var _cotton := {}
 static func _cotton_tex(grid: bool) -> Texture2D:
diff --git a/game/scripts/ui/game_screens.gd b/game/scripts/ui/game_screens.gd
index 96789a6..730003a 100644
--- a/game/scripts/ui/game_screens.gd
+++ b/game/scripts/ui/game_screens.gd
@@ -843,6 +843,8 @@ func _draw_inner() -> void:
 	for f in fx:
 		if not f.get("screen", false) and f["kind"] == "text":
 			_draw_fx(f)
+	if state == St.BATTLE and "--face-debug" in OS.get_cmdline_user_args():
+		_draw_face_debug()   # 1.6.0 B08：開發用，頭胸框／交戰區／跳字框
 	if state == St.BATTLE:
 		_draw_focus_marks(view)   # 1.5.0 §7：跟拍兵／目標的頭頂記號畫在跳字泡泡之上（不被蓋住；Hydrogen v150 cat07 r3）
 	perf_parts["fx"] = Time.get_ticks_usec() - _t
