 				var pa := i * TAU / 4.0 + 0.6
 				var pp := bp + Vector2(cos(pa) * (8.0 + k * 30.0), sin(pa) * (6.0 + k * 20.0) - k * 10.0)
@@ -874,13 +999,14 @@ func _draw_fx(f: Dictionary) -> void:
