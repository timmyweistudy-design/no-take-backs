    89			var a := clampf(1.6 - age * 0.4, 0.9, 1.0)   # V1.2.1 F5：舊條目最淡到 90%（35% 讀不到）
    90			var p := Vector2(14.0 + (i % 3) * cw, y0 + (i / 3) * rh)
    91			var mark := "●" if e["team"] == 0 else "◆"
    92			var line := "%s %s" % [L.t("unit_%d" % int(e["type"])), e["label"]]
    93			if int(e["n"]) > 1:
    94				line += " ×%d" % int(e["n"])
    95			if plain:
    96				_text(p, mark, tz("S"), Color(_legible_on(Art.team_color(int(e["team"]), cbm()), Color(0.14, 0.16, 0.1)), 1.0), false, true)   # V1.2.1：深色隊色記號在黑底條上提亮
    97			else:
    98				# V1.2 C6：隊色小章（藍圓、紅菱形，色盲也分得出）；頭像太小會糊（Antigravity impl4），不放
    99				var sz := float(tz("S"))
   100				var c := p + Vector2(sz * 0.5, sz * 0.62)
   101				var tc := Art.team_color(int(e["team"]), cbm())
   102				var rr := sz * 0.42
   103				if int(e["team"]) == 0:
   104					draw_circle(c, rr + 2.0, Color(INK, a), true, -1.0, true)
   105					draw_circle(c, rr, Color(tc, a), true, -1.0, true)
   106					draw_circle(c + Vector2(-rr * 0.35, -rr * 0.35), rr * 0.28, Color(1, 1, 1, 0.45 * a), true, -1.0, true)
   107				else:
   108					var dm := PackedVector2Array([c + Vector2(0, -rr - 3), c + Vector2(rr + 3, 0), c + Vector2(0, rr + 3), c + Vector2(-rr - 3, 0)])
   109					draw_colored_polygon(dm, Color(INK, a))
   110					var di := PackedVector2Array([c + Vector2(0, -rr), c + Vector2(rr, 0), c + Vector2(0, rr), c + Vector2(-rr, 0)])
   111					draw_colored_polygon(di, Color(tc, a))
   112					draw_circle(c + Vector2(-rr * 0.25, -rr * 0.3), rr * 0.22, Color(1, 1, 1, 0.45 * a), true, -1.0, true)
   113			var lc: Color = e["col"]
   114			lc = _legible_on(lc, Color(0.3, 0.22, 0.15) if not plain else Color(0.24, 0.26, 0.16))   # 對木槽（或黑底條）提亮到 5:1（刺客紫原本太暗）
   115			_text(p + Vector2(tz("S") + 6.0, 0), line, tz("S"), Color(lc, a), false, true, cw - tz("S") - 14.0)
   116	
   117	
   118	
   119	func _merge_text(tid: int, kind: String, label: String, dmg: int, p: Vector2, col: Color) -> void:
   120		var dn: String = str(Save.s("dmg_nums"))
   121		if (dn == "off" or speed >= FAST_SPEED) and int(TEXT_TIER.get(kind, 1)) < 2:
   122			return   # V1.5：傷害與治療數字關掉（關鍵事件的字照樣出）；V1.0.0 P7：4 倍速以上一般跳字也不出
   123		if int(TEXT_TIER.get(kind, 1)) >= 2:
   124			text_key_in += 1
   125		var cell := Vector2i(floori(p.x / TEXT_CELL.x), floori(p.y / TEXT_CELL.y))
   126		for f in ([] if dn == "each" else fx):   # V1.5：「逐次」不合併
   127			if f["kind"] == "text" and not f.get("screen", false) and f.get("ek", "") == kind and f.get("cell", Vector2i(-99, -99)) == cell and f["t"] < 0.35:
   128				f["n"] += 1
   129				f["sum"] += dmg
   130				f["s"] = ("+%d" % f["sum"]) if kind == EV.HEAL else "%s ×%d（%d）" % [label, f["n"], f["sum"]]
   131				f["t"] = 0.0
   132				f["pop"] = 0.18
   133				if int(f.get("tier", 1)) >= 2:
   134					text_key_shown += 1
   135				return
   136		var tier: int = TEXT_TIER.get(kind, 1)
   137		var world := 0
   138		for f in fx:
   139			if f["kind"] == "text" and not f.get("screen", false):
   140				world += 1
   141		if world >= TEXT_CAP:
   142			# 丟最舊的一般跳字；全部都是關鍵的就照樣加（關鍵不能漏）
   143			var oldest := -1
   144			for k in fx.size():
   145				var f2: Dictionary = fx[k]
   146				if f2["kind"] == "text" and not f2.get("screen", false) and int(f2.get("tier", 1)) < 2:
   147					if oldest < 0 or f2["t"] > fx[oldest]["t"]:
   148						oldest = k
   149			if oldest >= 0:
   150				fx.remove_at(oldest)
   151				text_dropped += 1
   152			elif tier < 2:
   153				text_dropped += 1
   154				return
   155			else:
   156				# 全部都是關鍵跳字：併進最近的同種跳字（硬上限，Codex S1 #5），關鍵不漏、只是合併
   157				var near := -1
   158				for k2 in fx.size():
   159					var f3: Dictionary = fx[k2]
   160					if f3["kind"] == "text" and f3.get("ek", "") == kind and (near < 0 or f3["p"].distance_to(p) < fx[near]["p"].distance_to(p)):
   161						near = k2
   162				if near >= 0:
   163					var fn: Dictionary = fx[near]
   164					fn["n"] += 1
   165					fn["sum"] += dmg
   166					fn["s"] = "%s ×%d（%d）" % [label, fn["n"], fn["sum"]]
   167					fn["t"] = 0.0
   168					fn["pop"] = 0.18
   169					text_key_shown += 1
   170					return
   171				# 沒有同種的：取代最舊的關鍵跳字（它已經顯示過了），維持硬上限
   172				var old := -1
   173				for k4 in fx.size():
   174					var f4: Dictionary = fx[k4]
   175					if f4["kind"] == "text" and not f4.get("screen", false) and (old < 0 or f4["t"] > fx[old]["t"]):
   176						old = k4
   177				if old >= 0:
   178					fx.remove_at(old)
   179		if tier >= 2:
   180			text_key_shown += 1
   181		fx.append({"kind": "text", "p": p, "s": ("+%d" % dmg) if kind == EV.HEAL else "%s %d" % [label, dmg], "c": col, "t": 0.0, "dur": 0.85, "size": 18 if tier >= 2 else (14 if kind == EV.HEAL else 16),
   182			"tid": tid, "ek": kind, "n": 1, "sum": dmg, "screen": false, "cell": cell, "tier": tier, "pop": 0.0, "plain": kind == EV.HEAL})
   183	
   184	
   185	
   186	## 每幀排版：關鍵在前、新的在前；和已放好的（不在淡出中的）重疊就往上推。結果存在 f["rp"]。
   187	## 1.6.0 B08（P3.3、S4）：再避開兵偶頭胸框（face_rects）、夾在盤內 ≥TEXT_BOARD_PAD；找位置的順序＝原位往上推 → 左右換邊再往上推，
   188	## 最遠 TEXT_MAX_MOVE。找不到：一般跳字丟掉（計 text_dropped），關鍵跳字放在蓋最少的位置（關鍵不能漏）。
   189	## 面積：顯示中（不透明度 ≥0.35）的跳字總面積 ≤ 交戰區 × TEXT_AREA_MAX，超過就丟一般跳字（新的、關鍵的先佔）。
   190	const TEXT_BOARD_PAD := 12.0
   191	const TEXT_MAX_MOVE := 96.0   # 1.5 格：再遠就看不出是誰的字
   192	const TEXT_AREA_MAX := 0.15
   193	const TEXT_LEAD_MIN := 18.0   # 推離原位超過這麼遠就畫引線
   194	## 1.6.0 B08（P3.4）：裝飾特效上限——單一特效面積 ≤ 交戰區 × FX_AREA_MAX（超過就等比縮）、最亮色相對亮度 ≤ FX_LUM_MAX（保持色相壓暗）；
   195	## 畫在兵偶頭胸上的小特效（音符、閃光叉、治療十字）壓到 FX_FACE_ALPHA。表示範圍的（隕石落點圈、範圍預告）不縮——語意（P3.5）。
   196	const FX_AREA_MAX := 0.04
   197	const FX_LUM_MAX := 0.8
   198	const FX_FACE_ALPHA := 0.5
   199	var _fx_faces: Dictionary = {}
   200	var _fx_eng_area := 0.0
   201	var fx_stats := {"max_area": 0.0, "max_lum": 0.0}   # 量測：這一幀畫出的裝飾特效裡最大面積比、最亮相對亮度
   202	
   203	static func fx_lum_cap(c: Color) -> Color:
   204		var l := 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b
   205		if l <= FX_LUM_MAX:
   206			return c
   207		var k := FX_LUM_MAX / maxf(l, 1e-4)
   208		return Color(c.r * k, c.g * k, c.b * k, c.a)
   209	
   210	## 面積 area 的裝飾特效要縮多少（≤1）；同時記量測
   211	func fx_area_scale(area: float) -> float:
   212		var eng := _fx_eng_area if _fx_eng_area > 0.0 else Rect2(ORIGIN, fld_size).get_area()
   213		var sc := minf(1.0, sqrt(eng * FX_AREA_MAX / maxf(1.0, area)))
   214		fx_stats["max_area"] = maxf(fx_stats["max_area"], area * sc * sc / eng)
   215		return sc
   216	
   217	## 畫和量用同一支（測試不能在 _draw 外畫圖）
   218	func glow_radius(f: Dictionary, k: float) -> float:
   219		var r: float = GLOW[f["kind"]][1] * (0.7 + 0.3 * minf(1.0, k * 3.0))
   220		return r * fx_area_scale(PI * r * r * 0.8)
   221	
   222	func boom_radius(k: float) -> float:
   223		var br := 14.0 + _smoothstep01(k) * 26.0
   224		return br * fx_area_scale(PI * br * br * 0.8 * 0.75)   # 鋸齒星芒約 0.75 個橢圓
   225	
   226	func fx_on_face(p: Vector2, rad: float) -> bool:
   227		var r := Rect2(p - Vector2(rad, rad), Vector2(rad, rad) * 2.0)
   228		for id in _fx_faces:
   229			if (_fx_faces[id] as Rect2).intersects(r):
   230				return true
   231		return false
   232	
   233	func fx_col(c: Color) -> Color:   # 壓亮度並記量測（灰階＝畫面值的加權和）
   234		var cc := fx_lum_cap(c)
   235		fx_stats["max_lum"] = maxf(fx_stats["max_lum"], 0.2126 * cc.r + 0.7152 * cc.g + 0.0722 * cc.b)
   236		return cc
   237	
   238	func face_rects() -> Dictionary:
   239		return {}   # battle_units 覆寫：{兵 id: 頭胸框}（要用到兵的畫面位置與縮放）
   240	
   241	func engage_rect() -> Rect2:
   242		return Rect2(ORIGIN, fld_size)   # battle_units 覆寫
   243	
   244	func _layout_texts() -> void:
   245		var t_us := Time.get_ticks_usec()
   246		_fx_faces = face_rects()   # 特效上限（P3.4）同一幀共用；{兵 id: 頭胸框}
   247		_fx_eng_area = engage_rect().get_area()
   248		fx_stats = {"max_area": 0.0, "max_lum": 0.0}
   249		var list: Array = []
   250		for f in fx:
   251			if f["kind"] == "text" and not f.get("screen", false):
   252				list.append(f)
   253		if list.is_empty():
   254			layout_us = Time.get_ticks_usec() - t_us
   255			return
   256		list.sort_custom(func(a, b): return a.get("tier", 1) > b.get("tier", 1) or (a.get("tier", 1) == b.get("tier", 1) and a["t"] < b["t"]))
   257		var board := Rect2(ORIGIN, fld_size).grow(-TEXT_BOARD_PAD)
   258		var budget := _fx_eng_area * TEXT_AREA_MAX
   259		var used := 0.0
   260		var placed: Array = []      # 已放好的完整畫出範圍（含紙條、出場壓下）
   261		var placed_key: Array = []  # 已放好的關鍵跳字（擠不下的關鍵字併進最近的一個）
   262		var drop: Array = []
   263		for f in list:
   264			var k: float = f["t"] / f["dur"]
   265			var slam := 1.0 - minf(float(f["t"]) / 0.1, 1.0)
   266			var at: Vector2 = f["p"] + Vector2(0, -k * 26 - 8.0 * slam * slam)   # 出場壓下的 8px 也算進排版（Codex B08 r1 #1）
   267			var r := _text_rect(f, at)
   268			var pad := _text_pad(f)
   269			var dr := r.grow_individual(pad[0], pad[1], pad[2], pad[3])
   270			var key := int(f.get("tier", 1)) >= 2
   271			var vis := _text_alpha(f) >= 0.35
   272			var own := int(f.get("tid", -1))
   273			var res: Array = [dr, true]
   274			if vis and used + dr.get_area() > budget:
   275				res = [dr, false]   # 超過面積：一般丟、關鍵併
   276			else:
   277				res = _text_slot(dr, placed, _fx_faces, board, key, own, f.get("off", Vector2.INF), f["p"] + Vector2(0, 10))
   278			if not res[1] and vis:
   279				if key:
   280					# 擠不下的關鍵字：併進最近的關鍵字；附近沒有就只留在底部戰報列（_report_add 已記；和第七輪 D1「混戰時關鍵技能進戰報列」同一條）
   281					if not _merge_into(f, placed_key):
   282						text_key_to_report += 1
   283					drop.append([f, false])
   284					continue
   285				drop.append([f, true])
   286				continue
   287			f["off"] = (res[0] as Rect2).position - dr.position   # 下一幀先試同樣的位移
   288			f["stuck"] = not res[1]
   289			dr = res[0]
   290			r.position = dr.position + Vector2(pad[0], pad[1])
   291			placed.append(dr)
   292			if key:
   293				placed_key.append(f)
   294			if vis:
   295				used += dr.get_area()
   296			f["rp"] = Vector2(r.get_center().x, r.position.y + 3.0)
   297			f["rr"] = r
   298			f["dr"] = dr
   299			var fr: Rect2 = own_face(_fx_faces, own, f["p"] + Vector2(0, 10))
   300			f["lead"] = Vector2(fr.get_center().x, fr.position.y - 2.0) if fr.size.x > 0.0 else f["p"] + Vector2(0, 10)
   301			f["seg"] = lead_seg(dr, f["lead"], _fx_faces, fr) if r.get_center().distance_to(f["p"] + Vector2(0, -k * 26.0)) > TEXT_LEAD_MIN else []
   302		for d in drop:
   303			fx.erase(d[0])
   304			if d[1]:
   305				text_dropped += 1
   306		layout_us = Time.get_ticks_usec() - t_us
   307	
   308	var layout_us := 0   # 量測：上一次排版耗時（µs）
   309	var text_key_to_report := 0   # 量測：擠不下、附近也沒有可併的關鍵字，只留在戰報列的次數
   310	
   311	## 紙條、出場、描邊實際畫出去的範圍（相對字框 _text_rect 的左、上、右、下外擴）：紙條 _bubble 外擴 4／1／4／2、
   312	## 下緣細引線 9.5＋點、陰影往左上 1／2；純數字與補血字只有描邊。
   313	func _text_pad(f: Dictionary) -> Array:
   314		if f.get("plain", false) or is_num_text(str(f["s"])):
   315			return [3.0, 3.0, 3.0, 3.0]
   316		return [5.0, 3.0, 4.0, 12.0]
   317	
   318	## 擠不下的關鍵跳字：併進 2.5 格內最近的、已放好的關鍵跳字（「衝鋒！×2（70）」）。關鍵不漏、也不蓋臉。
   319	func _merge_into(f: Dictionary, keys: Array) -> bool:
   320		var near = null
   321		for g in keys:
   322			var d: float = (g["p"] as Vector2).distance_to(f["p"])
   323			if d <= TEXT_MAX_MOVE_KEY and (near == null or d < (near["p"] as Vector2).distance_to(f["p"])):
   324				near = g
   325		if near == null:
   326			return false
   327		near["n"] = int(near["n"]) + int(f.get("n", 1))
   328		near["sum"] = int(near["sum"]) + int(f.get("sum", 0))
   329		var lab := str(f["s"]).split(" ")[0]
   330		near["s"] = "%s ×%d（%d）" % [lab, near["n"], near["sum"]] if near.get("ek", "") == f.get("ek", "") else str(near["s"])
   331		return true
   332	
   333	## 找一個不疊別的跳字、不蓋別隻兵的頭胸、在盤內的位置（r＝完整畫出範圍）。回傳 [Rect2, 找到乾淨位置?]。
   334	## 候選：原位、左右各一／兩個字寬，各自往上推、往下（腳下）推；最終位移 ≤ 上限（一般 1.5 格、關鍵 2.5 格）；
   335	## 推離原位要畫引線時，引線也不准穿過別隻的頭胸。取各方向第一個乾淨位置中離原位最近的；都不行回傳蓋得最少的。
   336	const TEXT_MAX_MOVE_KEY := 160.0   # 2.5 格
   337	func _text_slot(r: Rect2, placed: Array, faces: Dictionary, board: Rect2, far := false, own := -1, pref := Vector2.INF, anchor := Vector2.INF) -> Array:
   338		if anchor == Vector2.INF:
   339			anchor = Vector2(r.get_center().x, r.end.y + 10.0)
   340		var lim := TEXT_MAX_MOVE_KEY if far else TEXT_MAX_MOVE
   341		var near: Array = []
   342		var zone := r.grow_individual(r.size.x + 20.0, lim, r.size.x + 20.0, lim)
   343		for id in faces:
   344			var q: Rect2 = faces[id]
   345			if zone.intersects(q):
   346				near.append(q)
   347		var own_r: Rect2 = own_face(faces, own, anchor)
   348		var lead_to := Vector2(own_r.get_center().x, own_r.position.y - 2.0) if own_r.size.x > 0.0 else anchor
   349		# 黏著：上一幀的位移還乾淨就沿用（不每幀重找；跳字也不會左右跳）
   350		if pref != Vector2.INF:
   351			var pc := Rect2(r.position + pref, r.size)
   352			if board.encloses(pc) and pc.position.distance_to(r.position) <= lim and _cand_cost(pc, r, placed, near, own_r, lead_to)[0] == 0.0:
   353				return [pc, true]
   354		var best := r
   355		var best_cost := INF
   356		var clean := r
   357		var clean_d := INF
   358		var side := r.size.x * 0.5 + 10.0
   359		var dxs: Array = [0.0]
   360		if own_r.size.x > 0.0:
   361			dxs.append(own_r.end.x + 4.0 - r.position.x)    # 緊貼自己那隻的右側（引線最短、一看就知道是誰的）
   362			dxs.append(own_r.position.x - 4.0 - r.end.x)    # 緊貼左側
   363		dxs.append_array([-side, side, -side * 2.0, side * 2.0])
   364		for dir in [-1.0, 1.0]:
   365			for dx in dxs:
   366				var dy := 0.0 if dir < 0.0 else 4.0
   367				var last_y := INF
   368				while dy <= lim:
   369					var c := Rect2(r.position + Vector2(dx, dir * dy), r.size)
   370					c.position.x = clampf(c.position.x, board.position.x, maxf(board.position.x, board.end.x - c.size.x))
   371					c.position.y = clampf(c.position.y, board.position.y, maxf(board.position.y, board.end.y - c.size.y))
   372					if c.position.y == last_y:
   373						break   # 被盤邊夾住：再推也是同一個位置
   374					last_y = c.position.y
   375					var dist := c.position.distance_to(r.position)
   376					if dist > lim or dist >= clean_d:
   377						break   # 最終位移超過上限（Codex B08 r1 #4），或已經比找到的乾淨位置遠：這個方向不用再推
   378					var cj: Array = _cand_cost(c, r, placed, near, own_r, lead_to)
   379					if cj[0] == 0.0:
   380						clean_d = dist
   381						clean = c
   382						break   # 這個方向第一個乾淨的位置就是它最近的
   383					if cj[0] < best_cost:
   384						best_cost = cj[0]
   385						best = c
   386					dy += maxf(4.0, float(cj[1]) + 2.0)   # 直接跳過擋路那個框
   387		if clean_d < INF:
   388			return [clean, true]   # Hydrogen B08 r1：推太遠會被看成別隻的字 → 取最近
   389		return [best, false]
   390	
   391	## 這個跳字「自己那隻」的頭胸框：兵還在錨點附近（≤1.2 格）才算；兵已經走遠（或對不上），引線改指錨點、也不豁免任何框
   392	func own_face(faces: Dictionary, own: int, anchor: Vector2) -> Rect2:
   393		var q: Rect2 = faces.get(own, Rect2())
   394		if q.size.x <= 0.0 or anchor == Vector2.INF:
   395			return q
   396		return q if Vector2(q.get_center().x, q.position.y).distance_to(anchor) <= CS * 1.2 else Rect2()
   397	
   398	## 候選位置的代價：疊到已放的跳字、蓋到頭胸（×4）。回傳 [代價, 往前跳多少]。（引線不算：引線在碰到頭胸框前就停，見 lead_seg）
   399	func _cand_cost(c: Rect2, r: Rect2, placed: Array, near: Array, own_r: Rect2, lead_to: Vector2) -> Array:
   400		var cost := 0.0
   401		var jump := 0.0
   402		var up := c.position.y <= r.position.y
   403		for q: Rect2 in placed:
   404			if q.intersects(c):
   405				cost += c.intersection(q).get_area() + 1.0
   406				jump = maxf(jump, (c.end.y - q.position.y) if up else (q.end.y - c.position.y))
   407		for q: Rect2 in near:
   408			if q.intersects(c):
   409				cost += c.intersection(q).get_area() * 4.0 + 1.0
   410				jump = maxf(jump, (c.end.y - q.position.y) if up else (q.end.y - c.position.y))
   411		return [cost, jump]
   412	
   413	## 引線：從字框邊往「自己那隻的頭頂」（兵走遠了就往錨點）畫，碰到任何別隻的頭胸框之前就停（引線本身不蓋臉）。
   414	## 回傳 [起點, 終點]；太短（<6px）回傳空陣列＝不畫。
   415	func lead_seg(dr: Rect2, lead_to: Vector2, faces: Dictionary, own_r: Rect2) -> Array:
   416		var from := Vector2(clampf(lead_to.x, dr.position.x + 6.0, dr.end.x - 6.0), dr.end.y if lead_to.y > dr.get_center().y else dr.position.y)
   417		var t_end := 1.0
   418		for id in faces:
   419			var q: Rect2 = faces[id]
   420			if q == own_r:
   421				continue
   422			var te := seg_entry(from, lead_to, q)
   423			if te < t_end:
   424				t_end = te
   425		var to := from.lerp(lead_to, maxf(0.0, t_end - 4.0 / maxf(1.0, from.distance_to(lead_to))))
   426		if from.distance_to(to) < 6.0:
   427			return []
   428		return [from, to]
   429	
   430	## 線段 a–b 進入矩形 q 的參數 t（0～1）；不相交回傳 2.0；起點就在裡面回傳 0
   431	static func seg_entry(a: Vector2, b: Vector2, q: Rect2) -> float:
   432		var t0 := 0.0
   433		var t1 := 1.0
   434		var d := b - a
   435		for e in [[-d.x, a.x - q.position.x], [d.x, q.end.x - a.x], [-d.y, a.y - q.position.y], [d.y, q.end.y - a.y]]:
   436			var pp: float = e[0]
   437			var qq: float = e[1]
   438			if absf(pp) < 1e-9:
   439				if qq < 0.0:
   440					return 2.0
   441			else:
   442				var t := qq / pp
   443				if pp < 0.0:
   444					t0 = maxf(t0, t)
   445				else:
   446					t1 = minf(t1, t)
   447				if t0 > t1:
   448					return 2.0
   449		return t0
   450	
   451	## 線段 a–b 是否穿過矩形 q（Liang–Barsky 裁切）
   452	static func seg_hits_rect(a: Vector2, b: Vector2, q: Rect2) -> bool:
   453		var t0 := 0.0
   454		var t1 := 1.0
   455		var d := b - a
   456		for e in [[-d.x, a.x - q.position.x], [d.x, q.end.x - a.x], [-d.y, a.y - q.position.y], [d.y, q.end.y - a.y]]:
   457			var pp: float = e[0]
   458			var qq: float = e[1]
   459			if absf(pp) < 1e-9:
   460				if qq < 0.0:
   461					return false
   462			else:
   463				var t := qq / pp
   464				if pp < 0.0:
   465					t0 = maxf(t0, t)
   466				else:
   467					t1 = minf(t1, t)
   468				if t0 > t1:
   469					return false
   470		return true
   471	
   472	
