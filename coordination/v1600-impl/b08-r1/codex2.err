  1262	## 1.4.0 §10.1 老闆依勝負的手勢（對 AI、播完到結算前）：玩家贏＝伸手在棋鐘旁放一枚紅泥小章；玩家輸＝在桌緣叩兩下。
  1263	## 純畫面；簡化介面、減少特效、截圖不畫（和開場上發條同一條規則）。
  1264	func owner_end_pose(winner: int, t: float) -> Array:
  1265		# → [伸出程度 0～1, 叩桌位移 px, 章放下了沒]
  1266		var k := clampf(t / 1.3, 0.0, 1.0)
  1267		var reach := 0.0
  1268		if k < 0.35:
  1269			reach = 1.0 - pow(1.0 - k / 0.35, 3.0)
  1270		elif k < 0.8:
  1271			reach = 1.0
  1272		elif k < 1.0:
  1273			reach = 1.0 - (k - 0.8) / 0.2
  1274		var knock := 0.0
  1275		if winner == 1 and k >= 0.35 and k < 0.8:
  1276			knock = absf(sin((k - 0.35) / 0.45 * PI * 2.0)) * 6.0
  1277		return [reach, knock, winner == 0 and k >= 0.5]
