   481	## 1.3.0 §5.4 走向：用模擬這一 tick「提出的移動」（mx、my，整數；擊退、推擠不算——Codex cat05 #1 #2）判斷，
   482	## 和幀率、倍速、暫停、鏡頭無關（同一場重播選到同一個方向）。遲滯：南北分量 > 東西 ×1.3 才轉成南／北，
   483	## < 東西 ×1.0 才回側面（不在臨界抖動）。不走路、出手、受擊一律側面（狀態保留，下次走路從側面重新判斷）。跳轉、新的一場清掉。
   484	const HEAD_FRONT_C := 0.55   # 往南走用的轉身角度（既有走路轉身頁 WT_C 0.55，22 種都有）
   485	var hd_state := {}
   486	var mag_pose: Array = []    # 1.3.0 §2：被選那隻這一幀的 [面向, 受擊, 表情]（單位迴圈寫入、放大鏡小窗讀）
   487	func heading_of(id: int, mx: int, my: int, walking: bool) -> int:
   488		if not walking or (mx == 0 and my == 0):
   489			hd_state.erase(id)
   490			return 0
   491		var cur: int = int(hd_state.get(id, 0))
   492		var ay := absi(my)
   493		var ax := absi(mx)
   494		var nxt := cur
   495		if cur == 0 and ay * 10 > ax * 13:
   496			nxt = 1 if my > 0 else -1
   497		elif cur != 0 and ay <= ax:
   498			nxt = 0
   499		elif cur != 0 and signi(my) != cur and ay * 10 > ax * 13:
   500			nxt = 1 if my > 0 else -1
   501		hd_state[id] = nxt
   502		return nxt
