   474	## 量測（測試與手感輪用）：正常顯示的跳字兩兩最大重疊比例（交集÷較小框），以及淡出中與其他的最大重疊。
   475	func text_overlap_stats() -> Dictionary:
   476		var vis: Array = []
   477		var fading: Array = []
   478		for f in fx:
   479			if f["kind"] == "text" and not f.get("screen", false) and f.has("rr"):
   480				(vis if _text_alpha(f) >= 0.35 else fading).append(f["rr"])
   481		var worst := 0.0
   482		for a in vis.size():
   483			for b in range(a + 1, vis.size()):
   484				worst = maxf(worst, _overlap(vis[a], vis[b]))
   485		var worst_f := 0.0
   486		for fr: Rect2 in fading:
   487			for o: Rect2 in vis + fading:
   488				if o != fr:
   489					worst_f = maxf(worst_f, _overlap(fr, o))
   490		# 1.6.0 B08（S4）：顯示中跳字（完整畫出範圍：紙條、出場、引線）蓋到別隻兵頭胸框的面積、出盤內 12px 的個數、總面積÷交戰區
   491		var face_px := 0.0
   492		var clipped := 0
   493		var area := 0.0
   494		var board := Rect2(ORIGIN, fld_size).grow(-TEXT_BOARD_PAD + 0.5)
   495		var faces: Dictionary = face_rects()
   496		for f in fx:
   497			if f["kind"] != "text" or f.get("screen", false) or not f.has("dr") or _text_alpha(f) < 0.35:
   498				continue
   499			var dr: Rect2 = f["dr"]
   500			area += dr.get_area()
   501			if not board.encloses(dr):
   502				clipped += 1
   503			var own_r: Rect2 = own_face(faces, int(f.get("tid", -1)), f["p"] + Vector2(0, 10))
   504			var sg: Array = f.get("seg", [])
   505			for id in faces:
   506				var q: Rect2 = faces[id]
   507				if q.intersects(dr):
   508					face_px += dr.intersection(q).get_area()
   509				if sg.size() == 2 and q != own_r and seg_hits_rect(sg[0], sg[1], q.grow(-0.5)):
   510					face_px += 1.0   # 引線（實際畫的那段）穿過別隻的頭胸
   511		return {"visible": vis.size(), "fading": fading.size(), "max_overlap": worst, "max_overlap_fading": worst_f,
   512			"face_px": int(face_px), "clipped": clipped, "area_ratio": area / maxf(1.0, engage_rect().get_area())}
