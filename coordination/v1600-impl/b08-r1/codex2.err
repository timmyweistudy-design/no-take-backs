   699	func _fx_text(p: Vector2, s: String, c: Color, dur: float, size: int, screen := false) -> void:
   700		# V1.3（Codex 第 3 輪）：跳字原本直接加、不受上限管。戰場上的跳字最多 TEXT_CAP 個，滿了丟最舊的那個
   701		if not screen:
   702			var n := 0
   703			var oldest := -1
   704			for i in fx.size():
   705				if fx[i]["kind"] == "text" and not fx[i].get("screen", false):
   706					n += 1
   707					var ti: int = fx[i].get("tier", 1)
   708					if oldest < 0 or ti < int(fx[oldest].get("tier", 1)) or (ti == int(fx[oldest].get("tier", 1)) and fx[i]["t"] > fx[oldest]["t"]):
   709						oldest = i   # 先丟不重要的（tier 低），同級丟最舊的
   710			if n >= FX_TEXT_CAP and oldest >= 0:
   711				fx.remove_at(oldest)
   712				fx_dropped += 1
   713		fx.append({"kind": "text", "p": p, "s": s, "c": c, "t": 0.0, "dur": dur, "size": size, "screen": screen})
   714	
   715	
   716	
   717	# V1.2 F2：亮的特效底下墊一層柔光（放射漸層貼圖，執行時生成；不用全域 Glow）
   718	const GLOW := {"boom": [Color(1.0, 0.55, 0.2), 70.0], "meteor": [Color(1.0, 0.5, 0.2), 90.0], "healarc": [Color(0.45, 1.0, 0.55), 40.0],
   719		"soulrise": [Color(0.7, 0.85, 1.0), 44.0], "timebell": [Color(1.0, 0.85, 0.4), 80.0], "sigil": [Color(1.0, 0.9, 0.55), 60.0]}
   720	var _glow_tex: GradientTexture2D = null
   740				label = L.t("ev_pike_brace")
   741				col = Color("#ffd166")
   742				sfx.play("bell", 0.8)
   743				brace_t[t.id] = time   # 長槍兵頓槍（M_BRACE 疊加：槍尖銀光）
   744				_add_fx({"kind": "hex", "p": tpos + Vector2(10 * signf(sp.x - tpos.x), -24), "t": 0.0, "dur": 0.45})
   745			EV.BREACH:
   746				label = L.t("ev_breach")
   747				if not key_used:
   748					# V1.3 C4：每場第一次破陣是「關鍵時刻」：四周壓暗、向心墨圈，不動時間（預設開，簡化特效關）。
   749					# 跳播（with_fx＝false）時也記下「用過了」，跳過去之後的第二次破陣不會再演（Codex v130-impl1）
   750					key_used = true
   751					if with_fx:
   752						key_t = time
   753						key_p = tpos
   754				col = Color("#ff7a3d")
   755				if with_fx and s != null and s.type == D.BERSERKER:
   756					_add_fx({"kind": "axearc", "p": sp + Vector2(12 * signf(tpos.x - sp.x), -30), "dir": signf(tpos.x - sp.x), "t": 0.0, "dur": 0.25})   # 1.1.0 A7：狂戰士破陣赭橙短弧
   757				sfx.play("shatter", 0.6)
   758				_add_fx({"kind": "shard", "p": tpos + Vector2(12, -26), "t": 0.0, "dur": 0.5})
   759			EV.BREAKER:
   760				sfx.play("shatter", 0.45)
   761				_add_fx({"kind": "shard", "p": tpos + Vector2(12, -26), "t": 0.0, "dur": 0.5})
   762		if label != "":
   763			_report_add(s.team, s.type, k, label, col, s)
   764			# 第七輪 D1：混戰（附近 3 隻以上）不再往上疊跳字，技能都進底部戰報列；稀疏時才跳字
   765			if int(TEXT_TIER.get(k, 1)) < 2:
   766				# V1.1 A5：一般狀態（反騎、反擊、破陣）不出字，只在頭頂閃一個小菱形，字留在底部戰報列
   767				_add_fx({"kind": "badge", "p": tpos + Vector2(0, -64 * HK), "c": col, "t": 0.0, "dur": 0.4})
   768			elif _crowd_at(t) < 3:
   769				_merge_text(t.id, k, label, int(ev["dmg"]), tpos + Vector2(0, -78 * HK), col)
   770			elif int(TEXT_TIER.get(k, 1)) >= 2:
   771				text_key_in += 1
   772				text_key_shown += 1   # 關鍵技能仍然有顯示，只是在戰報列（測試對帳用）
   773	
