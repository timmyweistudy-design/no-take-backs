   776	# ── 戰鬥 HUD ──
   777	func _draw_battle_hud() -> void:
   778		_hud_bar(Rect2(0, 0, 1280, 96))   # V1.2：頂部資訊列改深木紋（原本是平塗深底）；V1.2.1 加高，大字級的下排小字（AI 名）也在木條內
   705			toast_t = 2.5
   706			ach_t = 2.6
   707		shake = maxf(0.0, shake - delta)
   708		if not freeze_fx:
   709			for f in fx:
   710				f["t"] += delta
   711				if f.has("pop"):
   712					f["pop"] = maxf(0.0, f["pop"] - delta)
   713			fx = fx.filter(func(f): return f["t"] < f["dur"])
   714			if _frags_on():
   715				frags.step(delta)
   716			else:
   717				frags.clear()   # 戰鬥中切減少特效／簡化／4 倍速：舊碎片也收掉（Codex cat09 #3）
   718			clutch_t = maxf(0.0, clutch_t - delta)
   719		for g in dying:
   720			var t0: float = g["t"]
   721			g["t"] += delta
   722			if t0 < 1.0 and g["t"] >= 1.0:   # 只在跨過 1 秒那一幀插旗（倒棋留 1.7 秒，Codex v130-impl1）
   723				graves.append({"pos": g["pos"], "team": g["team"], "t": 0.0})
   724		dying = dying.filter(func(g): return g["t"] < death_life(int(g["type"])))   # V1.3 A5：倒棋留 1.7 秒
   725		for g in graves:
   726			g["t"] += delta
   727		graves = graves.filter(func(g): return g["t"] < 3.0)
   728		if overlay == "codex":
   729			_codex_tick(delta)
   730		if overlay == "ai_busy":
   731			_ai_poll()
   732		if not pre_old.is_empty():
   733			_pre_reap()
   734		if state == St.TITLE and demo != null and shot_dir == "" and Save.s("title_bg") == "demo" and not bool(Save.s("reduce_motion")):   # V1.5：主畫面背景可改靜態
   735			demo_acc += delta
   736			while demo_acc >= 0.05:
   737				demo_acc -= 0.05
   738				demo.step()
   739			if demo.finished:
   740				_new_demo()
   741		if state == St.BATTLE and shot_dir == "":
   742			_battle_process(delta)
   743			_follow_update(delta)
   744		elif state == St.RESULT:
   745			zoom = lerpf(zoom, 1.0, delta * 4)
   746		if font_bold != null:
   747			_layout_texts()   # 戰鬥事件產生跳字之後才排版，新跳字第一幀就有位置（Codex S1 #3）
   748		queue_redraw()
   749	
