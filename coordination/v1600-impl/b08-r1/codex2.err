   513	## 1.6.0 B08（P3.3、S4）：兵偶頭胸框（戰場座標）——跳字不蓋。腳底點往上 FACE_BOT～FACE_TOP（×HK×巨獸／跟拍縮放），半寬 FACE_HW。
   514	## 站姿的頭胸對截圖量過（14～54、半寬 17，--face-debug 畫得出來）；再包住姿勢起伏（Codex B08 r1 #2）：跳步 ≤10px、走路起伏 4、
   515	## 幽靈上下漂 ≤5.5、衝鋒前傾 ≤15°（頭頂橫移約 ±17px）→ 上緣多 12、左右各多 6（HK 單位）。
   516	const FACE_TOP := 66.0
   517	const FACE_BOT := 14.0
   518	const FACE_HW := 23.0
   519	func face_rects() -> Dictionary:
   520		var out := {}
   521		if view == null:
   522			return out
   523		for u in view.units:
   524			if not u.alive or u.hidden:
   525				continue
   526			var sc: float = (BossD.DRAW_SCALE if u.boss else 1.0) * focus_scale(u.id) * HK
   527			var p: Vector2 = _upos(u) + _open_drop(u)
   528			out[u.id] = Rect2(p + Vector2(-FACE_HW, -FACE_TOP) * sc, Vector2(FACE_HW * 2.0, FACE_TOP - FACE_BOT) * sc)
   529		return out
   530	
   531	## 交戰區：和敵兵相距 ≤1.5 格的兵的外接框，往外一格、夾在盤內；沒有交戰＝整個盤。
   532	func engage_rect() -> Rect2:
   533		var board := Rect2(ORIGIN, fld_size)
   534		if view == null:
   535			return board
   536		var ps: Array = [[], []]
   537		for u in view.units:
   538			if u.alive and not u.hidden:
   539				ps[u.team].append(_upos(u))
   540		var r := Rect2()
   541		var any := false
   542		var lim := (CS * 1.5) * (CS * 1.5)
   543		for a: Vector2 in ps[0]:
   544			for b: Vector2 in ps[1]:
   545				if a.distance_squared_to(b) <= lim:
   546					var pair := Rect2(a, Vector2.ZERO).expand(b)
   547					r = pair if not any else r.merge(pair)
   548					any = true
   549		if not any:
   550			return board
   551		return r.grow(CS).intersection(board)
   552	
   553	func _draw_face_debug() -> void:
   554		var fr: Dictionary = face_rects()
   555		for id in fr:
   556			draw_rect(fr[id], Color(1, 0, 1, 0.9), false, 1.5)
   557		draw_rect(engage_rect(), Color(0, 1, 1, 0.9), false, 2.0)
   558		for f in fx:
   559			if f["kind"] == "text" and f.has("dr"):
   560				draw_rect(f["dr"], Color(1, 1, 0, 0.9), false, 1.0)
   561				draw_circle(f["p"], 4.0, Color(0, 1, 1, 0.9))   # 原位錨點
