   145					# 1.2.0 第 5 大類（Antigravity cat05 #1）：受驚＝眼白放大＋針尖小瞳孔（和待機的大黑瞳分得開）
   675	func _bubble(r: Rect2, a: float) -> void:
   676		var rr := r.grow_individual(4, 1, 4, 2)
   677		# 1.2.0 第 4 大類 A11：跳字泡改成小紙條（米白紙底＋墨邊），字用墨色（保留色相）；簡化介面維持深色泡
   678		var paper := not bool(Save.s("plain_ui"))
   679		var mid := rr.position.x + rr.size.x * 0.5
   680		if paper:
   681			# 1.4.0 §3.1：牛皮紙短標籤（方角、底緣深一階）＋細短引線指向觸發點（取代白底圓角泡＋三角尾）
   682			# 1.5.0 §4：手裁吊牌——左邊兩角斜切、右緣細鋸齒（穿線孔試過：貼在第一個字前面像標點，拿掉）（原本直角素色框像介面；Hydrogen v150 cat07）。外框範圍不變（字的幾何不動）
   683			var kraft := Color(PAL.KRAFT, 0.95 * a)
   684			var tag := tag_poly(rr)
   685			draw_colored_polygon(tag * Transform2D(0.0, Vector2(-1, -2)), Color(DIM_INK, 0.35 * a))
   686			draw_colored_polygon(tag, kraft)
   687			draw_rect(Rect2(rr.position.x + 5.0, rr.end.y - 2.0, rr.size.x - 7.0, 2.0), Color(PAL.KRAFT_D, 0.8 * a))
   688			draw_polyline(tag + PackedVector2Array([tag[0]]), Color(PAL.KRAFT_D, 0.9 * a), 1.0, true)
   689			draw_line(Vector2(mid, rr.end.y), Vector2(mid, rr.end.y + 9.0), Color(PAL.KRAFT_D, 0.95 * a), 2.0, true)   # 引線加粗（Antigravity cat05 #3）
   690			draw_circle(Vector2(mid, rr.end.y + 9.5), 1.6, Color(PAL.KRAFT_D, 0.85 * a), true, -1.0, true)
   691			return
   692		var fill := Color(0.10, 0.07, 0.05, 0.82 * a)
   693		var edge := Color(0.95, 0.86, 0.66, 0.55 * a)
   694		var tail := PackedVector2Array([Vector2(mid - 5, rr.end.y - 1), Vector2(mid + 5, rr.end.y - 1), Vector2(mid - 1, rr.end.y + 7)])
   695		_box(rr, fill, edge, minf(10.0, rr.size.y * 0.5), 1.5)
   696		draw_colored_polygon(tail, fill)
   697		draw_polyline(PackedVector2Array([tail[0], tail[2], tail[1]]), edge, 1.5, true)
