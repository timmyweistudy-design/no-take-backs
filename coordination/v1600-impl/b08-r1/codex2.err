   563	## 1.3.0 §3 平原棉布拼貼（64px＝一格）：斜紋（每 6px 一道亮／暗細紋）；grid＝true 時上緣、左緣是壓縫棉線（亮線＋下方暗影、每 4px 一針），左上角一個小線結。
   564	static var _cotton := {}
   565	static func _cotton_tex(grid: bool) -> Texture2D:
   566		if _cotton.has(grid):
   567			return _cotton[grid]
   568		var img := Image.create(64, 64, false, Image.FORMAT_RGBA8)
   569		img.fill(Color(0, 0, 0, 0))
   570		for y in 64:
   571			for x in 64:
   572				var d := (x + y) % 6
   573				if d == 0:
   574					img.set_pixel(x, y, Color(1, 1, 0.9, 0.06))
   575				elif d == 3:
   576					img.set_pixel(x, y, Color(0.05, 0.08, 0.02, 0.05))
   577		if grid:
   578			for i in 64:
   579				var on := (i % 4) != 3   # 一針一針（每 4px 留 1px 縫）
   580				if on:
   581					img.set_pixel(i, 0, Color(1, 0.97, 0.86, 0.38))
   582					img.set_pixel(0, i, Color(1, 0.97, 0.86, 0.38))
   583				img.set_pixel(i, 1, Color(0.08, 0.05, 0.02, 0.14))
   584				img.set_pixel(1, i, Color(0.08, 0.05, 0.02, 0.14))
   585			for k in [[0, 0], [1, 0], [0, 1], [1, 1], [63, 0], [0, 63]]:
   586				img.set_pixel(k[0], k[1], Color(0.96, 0.9, 0.76, 0.75))   # 交叉點的線結
   587		var tex := ImageTexture.create_from_image(img)
   588		_cotton[grid] = tex
   589		return tex
