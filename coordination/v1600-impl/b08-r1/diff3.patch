+					g.boom_radius(fk)
+					g.fx_col(Color(1.0, 0.86, 0.35))
+			fx_a = maxf(fx_a, float(g.fx_stats["max_area"]))
+			fx_l = maxf(fx_l, float(g.fx_stats["max_lum"]))
