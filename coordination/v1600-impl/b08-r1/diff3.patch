+static func seg_entry(a: Vector2, b: Vector2, q: Rect2) -> float:
+	var t0 := 0.0
+	var t1 := 1.0
+	var d := b - a
+	for e in [[-d.x, a.x - q.position.x], [d.x, q.end.x - a.x], [-d.y, a.y - q.position.y], [d.y, q.end.y - a.y]]:
