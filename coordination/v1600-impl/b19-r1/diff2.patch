+	var hw := fld_size.x / (2.0 * STORE_ZOOM)
+	var hh := fld_size.y / (2.0 * STORE_ZOOM)
+	return Vector2(clampf(c.x, ORIGIN.x + hw, ORIGIN.x + fld_size.x - hw), clampf(c.y, ORIGIN.y + hh, ORIGIN.y + fld_size.y - hh))
