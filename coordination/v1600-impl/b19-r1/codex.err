     1	extends RefCounted
     2	## 1.4.0 §11.1（1.3.0 延伸、stash 補完）：無盡塔——一路往上打，每層一種突變（沿用每日挑戰的 8 種）、地圖與 AI 性格輪換，
     3	## 敵方預算每層多一點（上限 +60）；輸一場就結束，記最高層數（本機）。每層的規則與敵陣只由層數決定（固定種子、跨機器一樣）。
     4	const Daily = preload("res://scripts/game/daily.gd")
     5	const AI = preload("res://scripts/core/ai_army.gd")
     6	const BONUS_STEP := 4     # 每層敵方多 4 金
     7	const BONUS_MAX := 60
     8	
     9	static func spec(floor_no: int) -> Dictionary:
    10		var f := maxi(1, floor_no)
    11		var mut := posmod(f - 1, Daily.MUTATORS)
    12		return {"floor": f, "mut": mut, "map": 3 if mut == 3 else posmod(f * 5 + 2, 6), "style": posmod(f * 3 + 1, 5),
    13			"level": clampi((f - 1) / 6, 0, 2), "seed": 70000 + posmod(f * 7919, 1000003), "bonus": mini(BONUS_MAX, (f - 1) * BONUS_STEP)}
    14	
    15	## 這一層的規則：每日挑戰的規則（自由部署、單局、突變）再加敵方預算。
    16	static func make_rules(sp: Dictionary, mask: int):
    17		var r = Daily.make_rules(sp, mask)
    18		var RS = load("res://scripts/core/ruleset.gd")
    19		r.budget = [int(r.budget_of(0)), mini(RS.BUDGET_MAX, int(r.budget_of(1)) + int(sp["bonus"]))]   # 大地圖本來就接近上限：加碼夾在合法範圍內
    20		if int(sp.get("route", 0)) != 0:
    21			# 1.6.0 B17：路線加減在封頂之後算（休整一定有效；契約到上限就沒有加碼，卡片照實寫；Codex B17 r1）
    22			r.budget[1] = clampi(int(r.budget[1]) + int(sp["route"]), RS.BUDGET_MIN, RS.BUDGET_MAX)
    23		r.handicap = int(r.budget[1]) != int(r.budget[0])   # 兩邊預算不同要開讓子，否則 budget_of 兩邊都取藍方（stash 原本漏了，測試抓到）
    24		return r
    25	
    26	static func enemy(sp: Dictionary, r):
    27		return Daily.enemy(sp, r)
    28	
    29	## 記最高層：過了第 f 層＝最高至少 f。回傳 [新最高, 是否刷新]。
    30	static func record(best: int, cleared_floor: int) -> Array:
    31		return [maxi(best, cleared_floor), cleared_floor > best]
    32	
    33	## 續局：下一次要打的層（0＝沒有進行中的塔）。贏了＝下一層、輸了＝清掉；壞資料＝0。
    34	static func next_run(run: int, floor_no: int, won: bool) -> int:
    35		return floor_no + 1 if won else 0
    36	
    37	static func sanitize_run(v) -> int:
    38		return clampi(int(v), 0, 100000) if (v is int or v is float) else 0
    39	
    40	## ── 1.6.0 B17（P7.1、P7.2；S6）塔分岔＋完整續塔 ──
    41	## 每過三層（打完第 3、6、9…層）要選一次路：契約（接下來三層敵方 +CONTRACT_BONUS 金，每過一層記一枚契約章）／休整（下一層敵方 −REST_CUT 金）。
    42	## 路線狀態（存檔 tower_route）＝{v, floor（下一次要打的層，0＝沒有進行中）, path（每個岔口的選擇：c＝契約、r＝休整、-＝舊存檔沒有紀錄）, seals（契約章）, done（已結算到第幾層）}。
    43	## 一切只由 path 與層數決定（沒有亂數）：兩台機器同一條路線雜湊一樣、重啟不重抽；結算記 done，同一層不重領。
    44	## 舊存檔只有 tower_run（層數）：遷移成同一層、過去的岔口記 "-"（不猜當時選了什麼，也不補問）。
    45	const FORK_EVERY := 3
    46	const CONTRACT_BONUS := 8
    47	const CONTRACT_SPAN := 3
    48	const REST_CUT := 8
    49	const ROUTE_V := 1
    50	const FLOOR_MAX := 100000
    51	
    52	static func new_route() -> Dictionary:
    53		return {"v": ROUTE_V, "floor": 1, "path": "", "seals": 0, "done": 0}
    54	
    55	## 這一層開打前要先選路嗎（第 4、7、10…層開打前；這個岔口還沒選）
    56	static func fork_due(st: Dictionary) -> bool:
    57		var f := int(st.get("floor", 0))
    58		return f > 1 and (f - 1) % FORK_EVERY == 0 and str(st.get("path", "")).length() < (f - 1) / FORK_EVERY
    59	
    60	## 選路：只在該選的時候生效（重複點、晚到的點擊＝原樣回傳）
    61	static func choose(st: Dictionary, c: String) -> Dictionary:
    62		if not fork_due(st) or not c in ["c", "r"]:
    63			return st
    64		var out := st.duplicate(true)
    65		out["path"] = str(st["path"]) + c
    66		return out
    67	
    68	## 第 k 個岔口（0 起）之後的第一層＝k*3+4
    69	static func _fork_floor(k: int) -> int:
    70		return (k + 1) * FORK_EVERY + 1
    71	
    72	## 這一層吃到的路線加減：[敵方加減金, 是不是契約層]
    73	static func route_adj(path: String, floor_no: int) -> Array:
    74		var adj := 0
    75		var contract := false
    76		for k in path.length():
    77			var f0 := _fork_floor(k)
    78			if path[k] == "c" and floor_no >= f0 and floor_no < f0 + CONTRACT_SPAN:
    79				adj += CONTRACT_BONUS
    80				contract = true
    81			elif path[k] == "r" and floor_no == f0:
    82				adj -= REST_CUT
    83		return [adj, contract]
    84	
    85	## 帶路線的這一層：spec 的敵方加碼再加減（夾在 0 以上），附 contract
    86	static func spec_route(st: Dictionary, floor_no: int) -> Dictionary:
    87		var sp := spec(floor_no)
    88		var ra := route_adj(str(st.get("path", "")), floor_no)
    89		sp["route"] = int(ra[0])   # make_rules 在封頂之後加減
    90		sp["contract"] = bool(ra[1])
    91		return sp
    92	
    93	## 某一層實際的敵方預算加減（封頂後）：給岔路卡片照實寫（到上限＝0）
    94	static func route_effect(floor_no: int, adj: int, mask: int) -> int:
    95		var sp := spec(floor_no)
    96		var base = make_rules(sp, mask)
    97		sp["route"] = adj
    98		return int(make_rules(sp, mask).budget_of(1)) - int(base.budget_of(1))
    99	
   100	## 結算一層（只一次）：回 [新狀態, 有沒有變]。贏＝下一層、契約層加一枚章；輸＝路線結束（floor 0，章數照留在這次結果裡）。
   101	static func settle(st: Dictionary, floor_no: int, won: bool) -> Array:
   102		if floor_no <= int(st.get("done", 0)) or floor_no != int(st.get("floor", 0)):
   103			return [st, false]
   104		var out := st.duplicate(true)
   105		out["done"] = floor_no
   106		if won:
   107			out["floor"] = floor_no + 1
   108			if bool(route_adj(str(st.get("path", "")), floor_no)[1]):
   109				out["seals"] = int(st.get("seals", 0)) + 1
   110		else:
   111			out["floor"] = 0
   112		return [out, true]
   113	
   114	## 路線雜湊（S6：兩台機器同一條路線一樣）
   115	static func route_hash(st: Dictionary) -> String:
   116		return ("%d|%s|%d" % [int(st.get("v", ROUTE_V)), str(st.get("path", "")), int(st.get("floor", 0))]).sha256_text().substr(0, 12)
   117	
   118	## 舊存檔：只有 tower_run（下一次要打的層）。過去的岔口記 "-"（不猜歷史），done＝前一層（不能重領）。
   119	static func migrate_old(run: int) -> Dictionary:
   120		if run <= 0:
   121			return {"v": ROUTE_V, "floor": 0, "path": "", "seals": 0, "done": 0}
   122		return {"v": ROUTE_V, "floor": run, "path": "-".repeat((run - 1) / FORK_EVERY), "seals": 0, "done": run - 1}
   123	
   124	## 存檔的路線版本比遊戲新（§3.1：唯讀、不覆寫）
   125	static func route_is_future(v) -> bool:
   126		return v is Dictionary and (v.get("v") is int or v.get("v") is float) and float(v["v"]) > ROUTE_V and float(v["v"]) < 1.0e6
   127	
   128	static func _int_in(v, lo: float, hi: float) -> bool:
   129		return (v is int or (v is float and float(v) == floorf(float(v)))) and float(v) >= lo and float(v) <= hi
   130	
   131	## 存檔讀回：逐欄驗型；壞了回 null（呼叫端用 tower_run 遷移）。路線長度不能超過層數允許的岔口數。
   132	static func sanitize_route(v):
   133		if not v is Dictionary:
   134			return null
   135		if not _int_in(v.get("v"), 1, ROUTE_V) or not _int_in(v.get("floor"), 0, FLOOR_MAX) or not _int_in(v.get("seals"), 0, FLOOR_MAX) or not _int_in(v.get("done"), 0, FLOOR_MAX):
   136			return null
   137		var p = v.get("path")
   138		if not p is String or p.length() > FLOOR_MAX / FORK_EVERY:
   139			return null
   140		for ch in p:
   141			if not ch in ["c", "r", "-"]:
   142				return null
   143		var f := int(v["floor"])
   144		var dn := int(v["done"])
   145		if f > 0:
   146			# 狀態一致（Codex B17 r1）：下一次要打的層＝已結算的下一層；路線長度＝這一層之前該有的岔口數（岔口還沒選時少一個）
   147			if dn != f - 1:
   148				return null
   149			var need := (f - 1) / FORK_EVERY
   150			var pending := 1 if (f > 1 and (f - 1) % FORK_EVERY == 0) else 0
   151			if p.length() > need or p.length() < need - pending:
   152				return null
   153		elif p.length() > maxi(0, dn / FORK_EVERY):
   154			return null
   155		return {"v": int(v["v"]), "floor": f, "path": p, "seals": int(v["seals"]), "done": int(v["done"])}
