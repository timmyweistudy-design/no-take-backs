var shot_only: Array = []
var shot_fixed := false   # 1.2.0：--shot-fixed＝視覺回歸模式（固定幀時間、固定亂數、橫幅拍穩定狀態）；一般版面檢查照真實時間跑（Codex cat01 #6）   # 1.2.0 §14.4：--shot-only=a.png,b.png 只存這些（流程照跑）
## 1.6.0 R0：這張截圖的拍攝參數（畫面狀態、地圖、模擬 tick、動畫時間、鏡頭、跟拍、場上數量）
func _cap_info() -> Dictionary:
	var alive := 0
	if view != null:
		for u in view.units:
			if u.alive and not u.hidden:
				alive += 1
	var texts := 0
	for f0 in fx:
		if f0["kind"] == "text":
			texts += 1
	return {"state": int(state), "overlay": overlay, "map": fld_map, "sim_tick": sim.tick if sim != null else -1,
		"view_tick": view.tick if view != null else -1, "anim_time": snappedf(time, 0.01), "zoom": snappedf(zoom, 0.001),
		"cam": [snappedf(zoom_center.x, 0.1), snappedf(zoom_center.y, 0.1)], "follow": follow_id, "alive": alive,
		"fx": fx.size(), "fx_text": texts, "paused": paused, "fixed_clock": bool(shot_fixed), "size": [1280, 800]}

func _snap(name: String) -> void:
	if shot_only.is_empty():
		for a0 in OS.get_cmdline_user_args():
			if a0.begins_with("--shot-only="):
				shot_only = Array(a0.substr(12).split(",", false))
				break
		if shot_only.is_empty():
			shot_only = ["*"]
	var skip_save: bool = not ("*" in shot_only) and not (name in shot_only)   # 跳過的畫面照樣等待（不改變後面畫面的時序；Codex cat01 #6）
	if DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_MINIMIZED:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)   # 真的被縮下去就還原，否則永遠等不到繪製
	if shot_state.has("pad"):
		pad_mode = true   # V1.2.1：手把焦點狀態（焦點框畫在目前的按鈕上）
	if clutch_t > 0.0 and (clutch_t < 0.3 or clutch_t > 1.45):
		clutch_t = 0.8   # 1.2.0：「最後時刻」橫幅在淡入淡出途中（透明度 <1）做對比檢查沒有意義 → 截圖一律拍完全顯示的穩定狀態（真實時間模式也一樣）
	if shot_fixed and state == St.BATTLE:
		time = 600.0 + float(name.hash() & 1023) * 0.01   # 1.5.0 §12：固定模式下戰鬥截圖的動畫時間只由畫面名決定（不受前面拍了幾張影響；美感基線才比得了）
	queue_redraw()
	await get_tree().process_frame
	await get_tree().process_frame
	await RenderingServer.frame_post_draw
	if skip_save:
		return
	var img := get_viewport().get_texture().get_image()
	var serr := img.save_png(shot_dir.path_join(name))
	if serr != OK:
		print("SHOTFAIL ", name, " ", serr)   # 1.2.0（Codex cat01 #5）：存檔失敗不能默默通過
	print("SHOT ", name)
	if layout_probe:
		_layout_report(name, img)

	var atlas := await _perf_atlas_sweep()
	var commit := ""
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--perf-commit="):
			commit = a.substr(14)
	var out := {
		"hardware": {"cpu": OS.get_processor_name(), "cores": OS.get_processor_count(), "gpu": RenderingServer.get_video_adapter_name(),
			"os": OS.get_name(), "engine": Engine.get_version_info()["string"], "resolution": str(get_viewport().get_visible_rect().size)},
		"mem_static_mib": snappedf(Performance.get_monitor(Performance.MEMORY_STATIC) / 1048576.0, 0.1), "mem_static_max_mib": snappedf(Performance.get_monitor(Performance.MEMORY_STATIC_MAX) / 1048576.0, 0.1),
		"tex_mem_mib": tex_battle,   # V1.3.1：資源驗收（方案 §0）；1.1.0：取對戰時的值，圖集掃描的峰值另記在 atlas_sweep
		"commit": commit, "boot_ms": ready_ms, "boot_to_measure_ms": boot_ms, "colorblind_rebuild_ms": cb_ms,
		"units_start": units_start, "display_speed": 4.0, "battle_ticks": sim.tick, "reached_frenzy": sim.tick >= Sim.FRENZY_TICK,
		"all": sect.call(0), "normal": sect.call(1), "frenzy": sect.call(2), "atlas_sweep": atlas,
		"note": "frame_ms 受垂直同步限制（約 16.7）；實際成本看 draw＋process＋gpu。展示速度 4 倍時每幀處理的模擬 tick 比正常多，屬於偏嚴的量法"}
	var f := FileAccess.open(perf_path, FileAccess.WRITE)
	f.store_string(JSON.stringify(out, "  "))
	f.close()
	print("PERF ", JSON.stringify(out))
	get_tree().quit()

func _pstats(a: Array) -> Dictionary:
	var b := a.duplicate()
	b.sort()
	if b.is_empty():
		return {}
	return {"p50": snappedf(b[b.size() / 2], 0.01), "p95": snappedf(b[int(b.size() * 0.95)], 0.01), "p99": snappedf(b[mini(b.size() - 1, int(b.size() * 0.99))], 0.01), "max": snappedf(b[-1], 0.01)}


## 動作／表情樣品（R5 截圖驗證用）：每個兵種一列：待機、前搖、揮擊、後搖、受擊、狂熱、專屬（衝鋒／潛行／頂住）、勝利。
var anim_gallery := false
var gallery_page := 0

func _ready() -> void:
	super._ready()
	# 宣傳／驗證模式的分派（S8：原本在 game_screens 透過基底的空函式呼叫上來）
	if capsule_path != "":
		_capture_capsule.call_deferred()
	elif shot_dir != "":
		shot_fixed = "--shot-fixed" in OS.get_cmdline_user_args()
		if shot_fixed:
			seed(20261111)   # 1.2.0 §14.6：視覺回歸模式固定全域亂數（特效、待機錯開），同一份程式重拍要一致
		_run_screenshots.call_deferred()
	elif video_mode:
		_run_video.call_deferred()
	elif perf_path != "":
		_run_perf.call_deferred()
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--mem-check="):
			_run_mem_check.call_deferred(a.substr(12))
		elif a.begins_with("--sil="):
			_run_sil.call_deferred(a.substr(6))
		elif a.begins_with("--turn-strip="):
			_run_turn_strip.call_deferred(a.substr(13))
		elif a.begins_with("--bake-pack="):
			_run_bake_pack.call_deferred(a.substr(12))
		elif a.begins_with("--pack-bench="):
			_run_pack_bench.call_deferred(a.substr(13))
		elif a.begins_with("--pack-selftest="):
			_run_pack_selftest.call_deferred(a.substr(16))


## 1.6.0 B09（Codex r2 #3）實跑：①重建中途換色盲（競態）：最後是新配色、包讀到的頁＝包裡兵種條拼的頁、沒有誤停用；
## ②壞包：把一條換成別種（同尺寸）→ 驗檔擋下、整包停用、退回即時烘，而且即時烘的頁＝原包拼的頁（包和即時烘逐像素一樣）。
## 用法：<exe> --path game --resolution 1280x800 -- --pack-selftest=<json 絕對路徑>
func _run_pack_selftest(out_path: String) -> void:
	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
	overlay = ""
	pad_mode = pad0
	if had_dis:
		shot_state["dis"] = true

## 1.6.0 B14（P5.3）疲累：另開一場會打很久的（訓練陣 2 對 9，約 51 秒），推到 32 秒（tick 640）拍——殘血的兵往前垂。
## 用完把戰鬥狀態交回下一段截圖自己設定（後面的截圖都會重新開場）。
func _shot_fatigue() -> void:
	var FF = preload("res://scripts/core/formations.gd")
	var pool: Array = FF.training_pool(0)
	_begin_battle(pool[2].copy(), pool[9].mirrored(), "replay")
	start_hold = 0.0
	while not view.finished and view.tick < 640:
		_sim_step(false)
	for k in 30:
		_frame_alive(0.1)   # 讓受擊閃白、表情退掉（同 04_clutch 的做法）
	slow_left = 0.0
	clutch_t = 0.0
	zoom = 1.0
	# 拉近到血最少的疲累兵（亂戰裡看得到姿勢與汗滴；Hydrogen B14 r1）
	var tgt = null
	for u in view.units:
		if u.alive and fatigued(u) and (tgt == null or u.hp < tgt.hp):
			tgt = u
	if tgt != null:
		zoom = 2.0
		zoom_target = 2.0
		zoom_center = _upos(tgt) + Vector2(0, -30)
	await _snap("v160_14a_fatigue.png")
	zoom = 1.0
	zoom_target = 1.0

func _lobby_pad_walk() -> void:
	var pad0: bool = pad_mode
	# 走查真的開戰：會寫 last_rules、蓋章數、消耗亂數——全部存起來、走完還原（不然之後截圖的 AI 陣容、規則都變了；b04c 抓到 74_cmd_cast 0→423）
	var data0: Dictionary = Save.data.duplicate(true)
	var rng0: int = rng.state
	var had_dis: bool = shot_state.has("dis")   # 停用組合：全部按鈕畫成停用，A 按不下去；走的時候拿掉（同 _note_pin_walk）
extends "res://scripts/ui/battle/battle_units.gd"
## 其他層在同資料夾（V9 P1 拆檔）

func _on_skip() -> void:
	if skip_busy:
		return   # 防重入
	paused = false   # Codex r1：暫停中按直接看結果，算完要能進結算
	if DisplayServer.get_name() == "headless" or shot_dir != "":
		while not view.finished:
			_sim_step(false)
		result_delay = 9.0
		return
	skip_busy = true


func _skip_step() -> void:
	var t0 := Time.get_ticks_msec()
	while not view.finished and Time.get_ticks_msec() - t0 < 10:
		_sim_step(false)
	if view.finished:
		skip_busy = false
		result_delay = 9.0


## 第十輪 I4：重播的全長在背景算，算完才開始播。
func _pre_join() -> void:
	if pre_thread != null:
		var v = pre_thread.wait_to_finish()
		pre_thread = null
		if v is Array:
			replay_total = int(v[0])
			replay_bm = v[1]

## 不要等：還在算就留給 _pre_reap 收。
func _pre_drop() -> void:
	if pre_thread != null:
		pre_old.append(pre_thread)
		pre_thread = null

func _pre_reap() -> void:
	for i in range(pre_old.size() - 1, -1, -1):
		if not pre_old[i].is_alive():
			pre_old[i].wait_to_finish()
			pre_old.remove_at(i)

func _exit_tree() -> void:
	if has_method("_rv_exit"):
		call("_rv_exit")   # 1.1.0 H1：覆盤重算、GIF 先叫停再等
	bg.drain()   # 1.1.0 N6：覆盤、GIF、教練、三考、出題碼的背景工作：全部叫停再等（各自 64 tick／每格內會停）
	_pre_join()
	_pre_drop()
	for th in pre_old:
		th.wait_to_finish()
	pre_old.clear()
	if ai_thread != null:
		ai_thread.wait_to_finish()
		ai_thread = null

func _battle_process(delta: float) -> void:
	if pre_thread != null:
		if pre_thread.is_alive():
			return
		_pre_join()
	if view != null:
		_gait_frame(delta)   # 不能放在只有部分情況才跑的地方（Codex P2 #1）
	if start_hold > 0.0:
		var ph0 := 1.0 - start_hold
		start_hold -= delta
		var ph1 := 1.0 - start_hold
		for at in [0.25, 0.55, 0.85]:   # 1.2.0 §9.1：三段落子各一聲厚重落子聲（全場只有 3 聲）
			if ph0 < at and ph1 >= at and sfx != null:
				sfx.play("place_heavy", 0.75)
		if start_hold <= 0.0:
			_ceremony_knock()   # 1.6.0 B14（P5.4）落桌完＝開戰敲桌
		return
	if call("_seek_pump"):
		return
	if _hl_reel_tick():
		return   # 1.3.0 §2 精華三連：換段開始跳轉，這一幀不再推進（Codex cat06 #1）
	if skip_busy:
		_skip_step()
		return
	if paused:
		return
	if hitstop > 0:
		# 1.2.0 §9.6 展示時鐘：停頓期間欠下的模擬 tick（只算真的停頓的那段、照停頓當下的倍速換算）
		var used := minf(delta, hitstop)
		present_debt += used * speed / 0.05
		freeze_t += used   # 1.4.0：配件等只看展示時間的動畫也一起停（Codex cat05 #8）
		hitstop -= delta
func _frame_alive(delta: float) -> void:
	var lo := Vector2(1e9, 1e9)
	var hi := Vector2(-1e9, -1e9)
	for u in view.units:
		if u.alive:
			var p := _upos(u)
			lo = lo.min(p - Vector2(30, 70))
			hi = hi.max(p + Vector2(30, 20))
	var size := (hi - lo) / 0.7
	zoom_target = clampf(minf(1280.0 / maxf(1, size.x), 620.0 / maxf(1, size.y)) * 1.05, 1.08, 1.55)   # 再往勝負焦點收 5%（V2）
	zoom_center = zoom_center.lerp((lo + hi) / 2, minf(1.0, delta * 3))



## 第十輪 F1：模擬領先畫面 DELAY 個 tick，已知全滅就在倒下前放慢。和局、逾時、同歸於盡都不演。
func _check_final(with_fx: bool) -> void:
	if final_used or not with_fx or not sim.finished or sim.winner < 0 or sim.reason != "全滅":
		return
	final_used = true
	if _fx_on("slowmo"):
		final_left = 0.6
	if _fx_on("shake"):
		shake = maxf(shake, 0.15)

## 畫面前進一個 tick：模擬保持領先 DELAY 個 tick，畫面播最舊的那一份快照（R5 展示緩衝）。
func _sim_step(with_fx: bool) -> void:
	_pump_view()
	_check_final(with_fx)
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	if not view.advance():
		view.finished = true
		return
	if tm_ghost != null:
		call("_tm_sync")
	_gait_tick(with_fx)
	_status_tags(with_fx)   # 1.3.0 §7.1 狀態竹籤
	_pump_view()
	_check_clutch(with_fx)   # 每一個畫面 tick 都判定（原本每一幀判一次，觸發的 tick 會跟幀率有關）
	if view.frenzy and not frenzy_seen:
		frenzy_seen = true
		if with_fx:
			_fx_text(Vector2(640, 140), L.t("frenzy_banner"), Color.ORANGE_RED, 2.0, 30, true)
			sfx.play("frenzy")
			sfx.play_music("music_frenzy")
	var deaths := 0
	for ev in view.events:
		var k: String = ev["kind"]
		var s = view.unit_by_id(ev["src"]) if ev.has("src") else null
		if s != null:   # V1.4 #10：沙盤機關的事件沒有來源單位（src＝-1）
			var key := "%s%d" % [k, s.team]
			ev_count[key] = int(ev_count.get(key, 0)) + 1
			if k == EV.BLAST and not ev.has("dmg"):   # 第八輪：爆炸演出一筆一次；逐目標傷害不算次數（BOOM_5）
				ev_count["blast_fx%d" % s.team] = int(ev_count.get("blast_fx%d" % s.team, 0)) + 1
		if k == EV.DEATH:
			deaths += 1
			if int(first_fall[0]) < 0:
				var du = view.unit_by_id(int(ev.get("id", -1)))
				if du != null and du.team == 0:
					first_fall = [view.tick, int(ev["id"])]   # 1.5.0 §11：藍方第一隻倒下（逐 tick 事件，順播與跳轉一致）
		_collect_mark(ev, view, view.tick)
		_on_event(ev, with_fx)
	if sfx != null and "pan_hint" in sfx:
		sfx.pan_hint = 0.0   # 事件以外的聲音（棋鐘、結算）回到正中
	# 碾壓局最後一擊（優化方案 F1）：0.2 秒頓格＋微震，直接進結算
	if view.finished and not slow_used and deaths > 0 and with_fx:
		hitstop = 0.2
		if bool(Save.s("shake")):
			shake = 0.15



## 模擬往前補到領先 DELAY 個 tick；新進緩衝的攻擊事件先記下命中 tick，畫面就能在命中前開始演前搖。
func _pump_view() -> void:
	for fr in view.pump(sim):
		for e in fr["events"]:
			if e["kind"] == EV.CHARGE or e["kind"] == EV.BRACED:
				_cue_add(str(e["kind"]), int(e.get("src", -1)), int(e.get("tgt", -1)), int(fr["tick"]))   # 1.3.0 §7.1 預告
			if e.get("tags", []).has(EV.EXT_FIRE):
				continue   # 1.2.0 火矢的小火：不是射手出手，不排拉弓、飛箭（Codex cat09 #1）
			# 第四輪：補血、戰鼓也走出手動畫；被貼身敲人、破陣、補血、戰鼓用專屬動作（variant 2）
			if e["kind"] == EV.HEAL or e["kind"] == EV.DRUM or e["kind"] == EV.BONK or e.get("tags", []).has(EV.BREACH):
				var ah: Dictionary = alt_hit.get(e["src"], {})
func _begin_battle(a0, a1, kind := "official") -> void:
	nav_stack.clear()   # V1.5.1：開戰後，之前的返回堆疊作廢
	_pre_drop()
	play_kind = kind
	tm_ghost = null   # V1.4 #1：時光機的原本時間線只在「如果」播放時存在（_rv_play 之後會再設）
	_ensure_sprites([a0, a1])
	if kind == "official":
		last_armies = [a0.copy(), a1.copy()]
		battle_rules = rules.copy() if rules != null else _puzzle_rules()   # 第十三輪：殘局自帶規則
	sim = Sim.new(a0, a1, battle_rules)
	_cmd_setup(sim, kind)
	view = ViewBuffer.new(sim)
	atk_seq.clear()
	clutch_tick = -1
	replay_total = 0
	if kind != "official":
		# 重播／覆盤：先用確定性模擬算出整場長度，時間軸以實際秒數為滿（Antigravity S5）
		var pa0 = a0.copy()
		var pa1 = a1.copy()
		var pr = battle_rules.copy() if battle_rules != null else null
		var plog: Array = last_cmds.duplicate(true)
		replay_bm = []
		var run_pre := func() -> Array:
			var pre = Sim.new(pa0, pa1, pr)
			if pre.cmd_on:
				pre.cmd_play(plog)
			pre.fast = true
			var bm: Array = []
			while not pre.finished:
				pre.step()
				BM.collect(pre, bm)   # 1.2.0 §11.2：預跑順手收書籤（不多跑一次模擬）
			return [pre.tick, bm]
		if _async_ok():
			pre_thread = Thread.new()
			pre_thread.start(run_pre)
		else:
			var pv: Array = run_pre.call()
			replay_total = int(pv[0])
			replay_bm = pv[1]
	paused = false
	follow_id = -1
	battle_marks.clear()
	first_fall = [-1, -1]
	report_log.clear()
	skip_busy = false
	seek_target = -1
	if kind == "official":
		replay_snap = {}
	start_hold = 0.0
	if kind == "official" and shot_dir == "" and DisplayServer.get_name() != "headless" and not bool(Save.s("reduce_fx")):
		start_hold = 1.0
		if sfx != null:
			sfx.play("bugle", 0.8)
	graves.clear()
	clutch_t = 0.0
	atk_hit.clear()
	alt_hit.clear()
	proj_tgt.clear()
	brace_t.clear()
	state = St.BATTLE
	prev_pos.clear()
	_gait_reset()
	for u in view.units:
		prev_pos[u.id] = Vector2(u.x, u.y)
	_pump_view()   # 開場先預填 DELAY 個 tick
	accum = 0.0
	present_debt = 0.0   # 1.2.0 §9.6
	slow_used = false
	final_used = false
	cues.clear()        # 1.3.0 §7.1
	stat_prev.clear()
	key_used = false
	key_t = -10.0
	last_kill = [-1, -10.0]
	last_hitter.clear()
	final_left = 0.0
	slow_left = 0.0
	hitstop = 0.0
	dir_hot_until = -1.0   # 1.4.0：推近不帶到下一場／下一段（Codex cat05 #7）
	zoom = 1.0
	zoom_target = 1.0
	pinch_zoom = 1.0   # V1.4 #18：新的一場不沿用上一場的縮放
	dir_manual = false   # 1.3.0 §2：每一場（含重播、精華段）導播重新接手
	clock_last = -1      # 1.4.0 §7.2：棋鐘跳字重新算
	if sfx != null and sfx.has_method("reseed"):
		sfx.reseed(sfx.seed_at(round_no, 0))   # 1.3.0 §10：音效變體用固定種子
	spot_a = 0.0
	spot_n = 0
	desat_a = 0.0
	mag_hide = -1
	mag_corner_i = -1
	if kind == "official":
		hl_reel = []
	fx.clear()
	frags.clear()   # 1.2.0 §8.2
	dying.clear()
	atk_t.clear()
	hurt_t.clear()
extends "res://scripts/ui/free_place.gd"
## 由 game_screens.gd 拆出（V9 P1，行為不變）
## 狀態機、模式、輸入、擺放、標題、選單、設定、結果、成就。

## 第七輪 S7：每次啟動一個 session、每局一個 game；彙整工具靠這兩個去重（評分和對戰是兩行，不能重複算局數）。
var pt_session := str(Time.get_unix_time_from_system()) + "-" + str(randi())
var pt_game := 0

var keys_capture := ""   # 第七輪 K1：正在改哪個按鍵（"kb:start"／"pad:place"）

# ───────────────────────── 每幀 ─────────────────────────
## 最小化時 Godot 不繪製，也就沒有垂直同步節流，主迴圈會空轉吃滿一核；降到 10 fps，模擬照常跑（用 delta 累積）。
var _was_minimized := false
## 搖桿連發（第三輪 A2）：超過 0.6 才算推、低於 0.35 才算放開（遲滯）；推下立刻一次，0.35 秒後每 0.12 秒一次。
var stick := {JOY_AXIS_LEFT_X: 0.0, JOY_AXIS_LEFT_Y: 0.0}
var _stick_dir := Vector2i.ZERO
var _stick_t := 0.0

## 結果頁的技能徽章（第四輪）：候選裡雙方合計次數最多的 6 種；不夠 6 種就用經典的預設順序補。支援兵的補血、戰鼓也在候選裡（對支援兵公平）。
const BADGE_KEYS := ["breaker", "charge", "backstab", "braced", "anticav", "counter", "pike_brace", "splash", "breach", "heal", "drum"]
const EV_DEATH := "death"


func _reset_place(keep_blue := false) -> void:
	state = St.PLACE
	if bool(get("cp_on")):
		call("_cp_reset")   # 1.2.0 §11.6：每一局重新輪手（藍軍保留時，已有的兵不算任何人這一手）
	sim = null
	view = null
	pending_cell = Vector2i(-1, -1)
	ai_prebuilt = false
	_fp_reset()
	# 第一次進擺放畫面自動打開操作說明（第五輪：說明從頂部移到「?」）
	if not bool(Save.data.get("seen_place_help", false)) and (mode == Mode.VS_AI or mode == Mode.DUEL) and shot_dir == "":
		show_place_help = true
		Save.data["seen_place_help"] = true
	fx.clear()
	frags.clear()   # 1.2.0 §8.2
	dying.clear()
	zoom = 1.0
	tp = null
	blind_phase = 0
	foe_tag_open = false   # 1.5.0 §1.4
	_focus = 0
	var keep_ok: bool = keep_blue and not armies.is_empty() and (rules == null or rules.keep_formation)
	var blue_keep = armies[0].copy() if keep_ok else null
	armies = [Army.new(0, 100), Army.new(1, 100)]
	if rules != null and (mode == Mode.VS_AI or mode == Mode.DUEL):
		armies[0].apply_rules(rules, 0)
		armies[1].apply_rules(rules, 1)
	if mode == Mode.GAUNTLET:
		armies[0].pool = _gauntlet_pool()
		armies[1].pool = _gauntlet_pool()
	match mode:
		Mode.VS_AI:
			if blue_keep != null:
				armies[0] = blue_keep
			if rules != null and rules.fullfield == 2:
				# 第六輪：對 AI 明牌全場——AI 先在自己半場擺好並公開，你在全場離敵兵 1.5 格外擺
				_build_ai()
				ai_prebuilt = true
				armies[0].enemy_pos = []
				for u in armies[1].units:
					armies[0].enemy_pos.append(armies[1].pos_of(u))
				var keep: Array = armies[0].units.duplicate(true)
				armies[0].units = []
				for u in keep:
					var pp: Vector2i = armies[0].pos_of(u)
					armies[0].place_xy(int(u["type"]), pp.x, pp.y)   # 保留的陣型和新的明牌陣衝突的就拿掉
		Mode.DUEL:
			if bool(get("swap_ai")):
				call("_swap_ai_prep")   # 1.6.0 B18（P7.3）對 AI 換邊雙局：AI 那一色自動擺好、玩家照暗擺流程擺自己那一色
			elif duel_rule != "blind":
				tp = TP.new(armies[0], armies[1], (round_no + 1) % 2, duel_rule, rules)
				if rules == null:
					tp.armies[0].pool = _pool()
					tp.armies[1].pool = _pool()
				# 1.1.0 B2：輪序紀錄碼要開局（禁牌後）的卡池與預算
				duel_start = {"pools": [tp.armies[0].pool, tp.armies[1].pool], "budgets": [tp.armies[0].budget, tp.armies[1].budget], "rules": rules.copy() if rules != null else null}
		Mode.TUTORIAL, Mode.PUZZLE:
			var pz := PZ.get_puzzle(puzzle_id)
			armies[0] = PZ.player_army(pz)
			armies[1] = PZ.enemy_army(pz)
			selected = int(pz["allowed"][0])
			if puzzle_plan_id != puzzle_id:
	return p1

## 第十輪 I4：困難 AI 第二局起要模擬候選陣型，放背景算，畫面不凍住。回傳 true＝已交給背景。
func _build_ai_async() -> bool:
	if not _async_ok() or difficulty != 2 or round_no <= 1 or get("challenge_army") != null:
		return false
	var r := RandomNumberGenerator.new()
	r.seed = rng.randi()
	var p1: int = _ai_pool(r)
	var known: Array = last_player_formation.duplicate(true)
	var lib: Array = _counter_lib()
	var rr = rules.copy() if rules != null else null
	ai_thread = Thread.new()
	ai_thread.start(func(): return HardAI.build(known, lib, r, p1, rr))
	overlay = "ai_busy"
	return true

func _ai_poll() -> void:
	if ai_thread == null or ai_thread.is_alive():
		return
	armies[1] = ai_thread.wait_to_finish()
	ai_thread = null
	ai_name = L.t("diff_hard")
	overlay = ""
	call("_on_start_go")

## 組 AI 的陣型（第六輪：明牌全場時在擺放開始就組好）。
func _build_ai() -> void:
	if get("challenge_army") != null:
		armies[1] = get("challenge_army").copy()     # 挑戰碼：對手就是朋友排好的陣
		var dsp = get("daily_spec")
		ai_name = L.t("menu_daily") if dsp is Dictionary and not dsp.is_empty() else L.t("ch_name")
		return
	var tid = get("trial_id")
	if tid != null and int(tid) >= 0:
		var te = call("_trial_enemy")   # 第十三輪：新試煉是固定敵陣
		if te != null:
			armies[1] = te
			ai_name = call("trial_name", int(tid))
			return
	if true:
		var r := RandomNumberGenerator.new()
		r.seed = rng.randi()
		var p1: int = _ai_pool(r)
		match difficulty:
			0:
				armies[1] = AIT.build_full(1, r, 0, [], p1, rules)
				ai_name = L.t("diff_easy")
			1:
				var tpl := -1
				if has_method("_signature_tpl"):
					tpl = int(call("_signature_tpl", r.seed, p1))   # V1.6.1 A11：AI 人設招牌陣（一般對 AI 才有）
				var res = AI.build(1, rules.budget_of(1) if rules != null else 100, r, tpl, p1, rules)
				armies[1] = res["army"]
				if rules != null and rules.is_free() and armies[1].terrain != null and (get("daily_spec") as Dictionary).is_empty() and int(get("trial_id")) < 0:   # 試煉第 1～10 關的敵陣也是即時組的：照舊（三星解釘住，t_star 抓到）
					armies[1] = load("res://scripts/core/formations.gd").terrain_smart(armies[1])   # V1.6 #15 地形 AI（每日挑戰、試煉的敵陣照舊，不升 Daily.VER）
				ai_name = L.t("name_sep_fmt", [L.t("diff_normal"), ai_tpl_name(str(res["name"]))])
			_:
				armies[1] = _hard_ai(r, p1)
				ai_name = L.t("diff_hard")



## 困難 AI：第 1 局沒有資訊，用會讀對方的落子 AI 自己組；之後讀你上一局的陣型，
## 先查離線反制庫（組成最接近的原型），查不到就用啟發式反制。不偷看你這一局。
func _hard_ai(r: RandomNumberGenerator, pool: int) -> Army:
	# 第四輪：候選陣型各和你上一局的陣型模擬一場，挑最好的（scripts/core/hard_ai.gd）
	var known: Array = last_player_formation if round_no > 1 else []
