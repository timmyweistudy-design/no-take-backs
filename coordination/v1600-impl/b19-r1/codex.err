  1972	const STORE_ZOOM := 1.25
  1973	const STORE_TICKS := [150, 520]
  1974	func store_armies() -> Array:
  1975		var FF = preload("res://scripts/core/formations.gd")
  1976		var pool: Array = FF.training_pool(0)
  1977		var b = pool[2].copy()
  1978		var r = pool[9].mirrored()
  1979		b.shift_all(-1)   # 前排往後一欄（出界那一步整筆還原＝擺不下就照原位）
  1980		r.shift_all(-1)
  1981		return [b, r]
  1982	
  1983	func _store_center() -> Vector2:
  1984		var sum := Vector2.ZERO
  1985		var n := 0
  1986		for u in view.units:
  1987			if u.alive and not u.hidden:
  1988				sum += _upos(u)
  1989				n += 1
  1990		return (sum / n) if n > 0 else ORIGIN + fld_size / 2
  1991	
  1992	## 接在正式截圖流程最後（--shot=<夾> --store；--shot-only=store_ 開頭的四張就只存這四張）。開一場新的戰鬥，不影響前面的截圖。
  1993	## 換畫面的木色轉場遮罩：換畫面後第一次重畫才開始計時，固定時鐘下時間不走 → 先畫幾幀再把計時清掉
  1994	func _store_settle() -> void:
  1995		for k in 3:
  1996			queue_redraw()
  1997			await get_tree().process_frame
  1998			set("_trans_t", -100.0)
  1999	
