     4	const DEV := "res://tools/dev_main.gd"
     5	const DEV_FLAGS := ["--shot=", "--capsule=", "--video", "--perf=", "--mem-check=", "--sil=", "--bake-pack=", "--pack-bench=", "--pack-selftest=", "--turn-strip=", "--store"]
     6	
     7	func _ready() -> void:
     8		for a in OS.get_cmdline_user_args():
     9			for f in DEV_FLAGS:
    10				if a.begins_with(f) and ResourceLoader.exists(DEV):
    11					set_process(false)
    12					visible = false
    13					_swap_to_dev.call_deferred()
    14					return
    15		super()
    16	
    17	func _swap_to_dev() -> void:
    18		var p := get_parent()
    19		var d: Node = load(DEV).new()
    20		d.name = name
    21		p.remove_child(self)
    22		p.add_child(d)
    23		queue_free()

