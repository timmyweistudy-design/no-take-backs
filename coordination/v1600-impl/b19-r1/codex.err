  2009		await _store_settle()
  2010		await _snap("store_01_place.png")
  2011		_begin_battle(ar[0].copy(), ar[1].copy(), "official")   # 正式對局的畫面（沒有重播控制列）；截圖模式不結算
  2012		start_hold = 0.0
  2013		var n := 1
  2014		for t in STORE_TICKS:
  2015			while not view.finished and view.tick < int(t):
  2016				_sim_step(false)
  2017			for k in 20:
  2018				_frame_alive(0.05)
  2019			slow_left = 0.0
  2020			clutch_t = 0.0
