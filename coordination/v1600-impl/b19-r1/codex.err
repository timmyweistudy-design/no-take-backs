    64	func quick_rematch_ok() -> bool:
    65		# 上次規則要讀得回來、上次陣型要有——任一不行就照舊進大廳（不悄悄換成標準規則；Codex v150 cat02 #4）
    66		var code := str(Save.data.get("last_rules", {}).get("ai", ""))
    67		if code == "" or str(Save.data.get("last_form", "")) == "":
    68			return false
    69		return bool(RuleSet.from_code(code)["ok"])
    70	
    71	func _quick_rematch() -> void:
    72		_open_lobby("ai")
    73		if not quick_rematch_ok() or _lobby_block() != "" or lobby_r.to_code() != str(Save.data.get("last_rules", {}).get("ai", "")):
    74			return   # 停在大廳（照舊）：規則讀回來不一樣＝有東西被換掉，讓玩家看一眼
    75		_lobby_start()
    76		if state == St.PLACE and armies.size() > 0 and armies[0].units.is_empty():
    77			call("_deploy_tool", "last")   # 帶上次陣型（不合這次規則的照 _load_checked 擋、提示，留在擺陣自己調）
    78	
    79	func _lobby_clamp() -> void:
    80		Presets.clamp_pool(lobby_r, lobby_kind, _lobby_unlocked(), _demo())
    81	
    82	func _lobby_pick(id: String) -> void:
    83		if id == "fantasy" and not RuleSet.has_new(Presets.selectable(lobby_kind, _lobby_unlocked(), _demo())):
    84			_toast(L.t("lb_fantasy_locked"), true)   # 第八輪：第 14 場才有第一種奇幻軍
    85			return

