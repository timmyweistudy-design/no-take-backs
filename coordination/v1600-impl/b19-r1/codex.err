  1654	func hub_items(kind: String) -> Array:
  1655		match kind:
  1656			"hub_play":
  1657				return [["menu_tutorial", "hc_tutorial_d", "book", func(): overlay = ""; _open("tutorial"), true],
  1658					["menu_vs_ai", "hc_vs_ai_d", "robot", func(): overlay = ""; _open_lobby("ai"), true],
  1659					["menu_duel", "hc_duel_d", "people", func(): overlay = ""; _open_lobby("duel"), true],
  1660					["fog_open", "hc_fog_d", "map", func(): overlay = ""; call("_fog_start"), true],   # V1.6 #20
  1661					["sw_open", "hc_sw_d", "swap", func(): overlay = ""; call("_swap_start"), true],   # 1.2.0 §11.5 換邊雙局
  1662					["sw_ai_open", "hc_sw_ai_d", "swap", func(): overlay = ""; call("_swap_ai_start"), true],   # 1.6.0 B18（P7.3）對 AI 換邊雙局
  1663					["cp_open", "hc_cp_d", "people", func(): overlay = ""; call("_cp_start"), true]]   # 1.2.0 §11.6 合作布陣
  1664			"hub_gauntlet":   # V1.0.0 H1／M5：遠征牌＝單人遠征＋雙人接力遠征
  1665				return [["menu_gauntlet", "hc_gauntlet_d", "flag", func(): overlay = ""; _enter_gauntlet(), not _demo()],
  1666					["cmp_title", "hc_cmp_d", "book", func(): call("_camp_open"), not _demo()],   # 1.2.0 §11.7 戰役
  1667					["coop_open", "hc_coop_d", "people", func(): overlay = ""; call("_coop_start"), not _demo()],   # V1.6 #21
  1668					["tw_open", "hc_tw_d", "tower", func(): overlay = ""; call("_tower_open"), not _demo()]]   # 1.4.0 §11.1 無盡塔
  1669			"hub_challenge":   # V1.0.0 H1：「挑戰」拆掉，這張牌改成「殘局」：單人求解類
  1670				return [["menu_puzzle", "hc_puzzle_d", "puzzle", func(): overlay = ""; _open("puzzles"), true],
  1671					["menu_trials", "hc_trials_d", "trophy", func(): overlay = ""; _open("trials"), true],
    30		var r = null
    31		if code != "":
