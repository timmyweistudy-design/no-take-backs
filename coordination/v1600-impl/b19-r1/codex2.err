--- a/game/tools/store_thumb.py
+++ b/game/tools/store_thumb.py
@@ -0,0 +1,36 @@
+#!/usr/bin/env python3
+"""1.6.0 B19（P8.3；K2 自動部分）商店圖縮圖辨識：把商店截圖縮到 Steam 小圖寬（462px）後量
+① 藍、紅兩隊隊色像素各占多少（都要 ≥0.4%＝縮小後還看得到兩邊的兵）；② 兩隊平均色的 ΔE（CIE76，≥40＝顏色分得開）；
+③ 畫面平均亮度（≥55＝沒被遮罩壓暗）。真人「縮圖辨識」（K2 人工）另外做，這裡只是自動門檻。
+用法：PYTHONPATH=build/pylibnp python3 game/tools/store_thumb.py <資料夾>；印 STORETHUMB OK／FAIL。"""
+import sys, os, glob
+import numpy as np
+from PIL import Image
+
+def lab(rgb):
+    c = rgb / 255.0
+    c = np.where(c > 0.04045, ((c + 0.055) / 1.055) ** 2.4, c / 12.92)
+    m = np.array([[0.4124, 0.3576, 0.1805], [0.2126, 0.7152, 0.0722], [0.0193, 0.1192, 0.9505]])
+    xyz = c @ m.T / np.array([0.9505, 1.0, 1.089])
+    f = np.where(xyz > 0.008856, np.cbrt(xyz), 7.787 * xyz + 16 / 116)
+    return np.stack([116 * f[..., 1] - 16, 500 * (f[..., 0] - f[..., 1]), 200 * (f[..., 1] - f[..., 2])], -1)
+
+bad = 0
+files = sorted(glob.glob(os.path.join(sys.argv[1], "store_*.png")))
+for p in files:
+    im = Image.open(p).convert("RGB")
+    im = im.crop((40, 50, 1240, 690))   # 只看戰場區：上面的戰力條、下面的兵種盤／開戰鈕／時間軸都是介面色，不算兵（Codex B19 r1）
+    im = im.resize((462, int(im.height * 462 / im.width)), Image.LANCZOS)
+    a = np.asarray(im).astype(float)
+    r, g, b = a[..., 0], a[..., 1], a[..., 2]
+    blue = (b > r + 40) & (b > g + 10) & (b > 120)
+    red = (r > g + 60) & (r > b + 40) & (r > 140)
+    pb, pr = blue.mean() * 100, red.mean() * 100
+    de = float(np.linalg.norm(lab(a[blue].mean(0)) - lab(a[red].mean(0)))) if blue.any() and red.any() else 0.0
+    lum = a.mean()
+    place = "place" in os.path.basename(p)   # 擺陣畫面看不到紅軍（對方地盤遮著）：只要求藍軍看得到；量到的紅多半是藍兵身上的紅配件
+    ok = pb >= 0.4 and (place or (pr >= 0.4 and de >= 40)) and lum >= 55
+    bad += 0 if ok else 1
+    print("%-24s 藍 %.2f%%  紅 %.2f%%  ΔE %.0f  亮度 %.0f  %s" % (os.path.basename(p), pb, pr, de, lum, "OK" if ok else "FAIL"))
+print("STORETHUMB %s（%d 張、不合格 %d）" % ("OK" if files and bad == 0 else "FAIL", len(files), bad))
+sys.exit(0 if files and bad == 0 else 1)
     1	# 實機錄影清單（1.6.0 B19；P8.4）
     2	
     3	給實機（Windows 桌機或 Steam Deck）錄商店影片、預告片素材用。**錄影要人在機器前操作，Claude 不錄**（長時間可見視窗與帳號狀態的動作由你來）。
     4	
     5	## 共通設定
     6	- 解析度 1920×1080（Deck 1280×800 照原生），全螢幕，60 fps，音效 100、音樂 60。
     7	- 設定：字級 100%、簡化介面關、減少動態關、減少特效關、跳字「合併」。
     8	- 每段錄 8～15 秒，前後各多留 1 秒（剪輯用）；滑鼠游標錄進去（擺陣要看得到手）。
     9	- 截圖模式的商店預設（`--shot=<夾> --shot-fixed --store`，見 `tools/dev_main.gd` `_shot_store`）是靜態圖；錄影用同一組陣型對照：藍＝訓練陣第 3 個、紅＝訓練陣第 10 個（鏡像），前排各往後一欄。
    10	
    11	## 清單
    12	| # | 段落 | 怎麼進 | 要錄到的東西 | 長度 |
    13	|---|---|---|---|---|
    14	| 1 | 擺陣落子 | 對戰 → 對 AI 快速對戰 → 大廳（選好規則按主鈕）→ 擺陣 | 從空棋盤連放 6～8 隻（盾在前、弓在後），聽得到落子聲；最後按「開戰」 | 12 秒 |
    15	| 2 | 開戰 | 接 1 | 開場落桌三聲 → 敲桌（木聲＋輕震）→ 兩軍前進 | 8 秒 |
    16	| 3 | 跟拍 | 戰鬥中點一隻騎兵 | 鏡頭跟著那一隻衝進側翼；點空白處取消 | 10 秒 |
    17	| 4 | 交鋒 | 接 2，不點 | 前排接觸、跳字避讓、受擊閃白；不要剛好卡在暫停 | 8 秒 |
    18	| 5 | 最後時刻 | 打到「最後時刻」橫幅 | 慢動作＋放大，到勝負落定 | 10 秒 |
    19	| 6 | 收盤 | 接 5 | 結束後倖存的兵點頭 → 結果頁宣紙戰報蓋章 | 8 秒 |
    20	| 7 | 敗因 | 故意輸一場（全放弓兵） | 結果頁「觀察：多半傷害來自…」→ 更多 → 覆盤 → 換一隻 → 重算 → 讀結果（此條件下已驗證） | 15 秒 |
    21	| 8 | 棋課本 | 接 7 | 記進棋課 → 棋課本頁 → 重算核對一致 | 10 秒 |
    22	| 9 | 無盡塔岔路 | 連勝遠征 → 無盡塔，打過第 3 層 | 岔路兩張卡、選契約、第 4 層開場提示（契約層） | 10 秒 |
    23	| 10 | 手把 | 接手把重做 1～2 | 十字鍵選兵、A 落子、RT 開戰（Deck 上錄） | 12 秒 |
    24	
    25	## 交付
    26	- 原始檔放 `docs/release/recordings/`（不進 git，太大）；檔名用表格的編號，例如 `03_follow.mp4`。
    27	- 錄完回報哪幾段有怪（穿模、跳格、聲音不同步），會照 K3（命中音畫差 ≤50ms）逐段對。

