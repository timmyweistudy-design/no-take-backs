		Input.start_joy_vibration(last_joy, 0.3 * rk, 0.6 * rk, 0.18)
	rumble_seen = shake
	if removed_banner_t > 0.0:
		removed_banner_t -= delta
	if ach_t > 0:
	for tm0 in 2:
		var cnt0: int = view.alive_count(tm0) - sn[tm0]
		var lb0: String = L.t("units_left", [cnt0]) if sn[tm0] == 0 else "%s＋%d" % [L.t("units_left", [cnt0]), sn[tm0]]
