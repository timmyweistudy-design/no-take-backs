+func _run_turn_strip(out_dir: String) -> void:
+	Save.prefix = "shot_"
+	var res := {"combos": 0, "missing": 0, "missing_list": [], "slide": [], "pages": 0}
+	print("TS start")
+	for cbv in [false, true]:
+		Save.set_setting("colorblind", cbv)
+		_rebuild_sprites()
+		print("TS rebuild cb=", cbv)
