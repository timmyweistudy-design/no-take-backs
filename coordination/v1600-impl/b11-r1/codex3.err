  2031				ts_routes.append(_ts_draw_one(o + Vector2(39, 78), e[0], e[1], st))
  2032			draw_set_transform_matrix(Transform2D.IDENTITY)
  2033			return
  2034		if not sil_mode:
  2035			super._draw()
  2036			return
  2037		draw_rect(Rect2(0, 0, 1280, 800), Color(0.5, 0.5, 0.5))
