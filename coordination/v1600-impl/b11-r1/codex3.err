  1920	func _run_turn_strip(out_dir: String) -> void:
  1921		Save.prefix = "shot_"
  1922		var res := {"combos": 0, "missing": 0, "missing_list": [], "slide": [], "pages": 0}
  1923		print("TS start")
  1924		for cbv in [false, true]:
  1925			Save.set_setting("colorblind", cbv)
  1926			_rebuild_sprites()
  1927			print("TS rebuild cb=", cbv)
  1928			var guard := 0
  1929			while not (sprites.is_ready(cbv) and sprites.build_done) and guard < 1200:
  1930				guard += 1
  1931				await get_tree().process_frame
  1932			sprites.ensure_turn_atk([D.SWORD, D.CAVALRY])   # 和開戰時同一支：出場兵種補烘轉身出手格＋背面走路頁
  1933			while not (sprites.bw_tex.has(D.SWORD) and sprites.bw_tex.has(D.CAVALRY)) and guard < 2400:
  1934				guard += 1
  1935				await get_tree().process_frame
  1936			print("TS ready cb=", cbv, " guard=", guard, " ready=", sprites.is_ready(cbv), " done=", sprites.build_done)
  1937			var jobs: Array = []
  1938			for type in [D.SWORD, D.CAVALRY]:
  1939				for team in 2:
  1940					for a in TS_DIRS:
  1941						for b in TS_DIRS:
  1942							if a != b:
  1943								jobs.append([type, team, a, b])
  1944			var per_page := 8   # 每頁 2 欄 × 4 列、列距 196（騎兵的槍伸很高，列距 98 會伸進上一列的腳底量測區）
  1945			for pg in range(0, jobs.size(), per_page):
  1946				ts_page = []
  1947				for ji in range(pg, mini(pg + per_page, jobs.size())):
  1948					var j: Array = jobs[ji]
  1949					var row := ji - pg
  1950					for f in 8:
  1951						ts_page.append([j[0], j[1], j[2], j[3], f / 7.0, Vector2(6 + f * 78 + (640 if row >= 4 else 0), 100 + (row % 4) * 196)])
  1952				ts_mode = true
  1953				queue_redraw()
  1954				await get_tree().process_frame
  1955				await RenderingServer.frame_post_draw
  1956				var img := get_viewport().get_texture().get_image()
  1957				img.save_png(out_dir.path_join("turn_strip_cb%d_%02d.png" % [int(cbv), pg / per_page]))
  1958				res["pages"] += 1
  1959				for ji in range(pg, mini(pg + per_page, jobs.size())):
  1960					var j: Array = jobs[ji]
  1961					res["combos"] += 1
  1962					var miss := 0
  1963					var xs: Array = []
  1964					for f in 8:
  1965						var idx := (ji - pg) * 8 + f
  1966						if ts_routes[idx] != "atlas":
  1967							miss += 1
  1968						if j[2] in ["E", "W"] and j[3] in ["E", "W"]:
  1969							xs.append(_ts_foot_x(img, ts_page[idx][5]))
  1970					if miss > 0:
  1971						res["missing"] += miss
  1972						res["missing_list"].append([j[0], j[1], int(cbv), j[2], j[3], miss])
  1973					if not xs.is_empty():
  1974						var lo := 1e9
  1975						var hi := -1e9
  1976						var bad := 0
  1977						for x in xs:
  1978							if x > -900.0:
  1979								lo = minf(lo, x)
  1980								hi = maxf(hi, x)
  1981							else:
  1982								bad += 1
  1983						# 八格都要量得到腳（Codex B11 r1 #5：量不到不能當沒滑）；量不到＝ 9.9（必失敗）
  1984						res["slide"].append([j[0], j[1], int(cbv), j[2], j[3], snappedf((hi - lo) / (36.0 * UNIT_SCALE / 0.92), 0.001) if bad == 0 and hi >= lo else 9.9])
  1985		ts_mode = false
  1986		Save.set_setting("colorblind", false)
  1987		var worst := 0.0
  1988		for sl in res["slide"]:
  1989			worst = maxf(worst, float(sl[5]))
  1990		res["slide_max"] = worst
  1991		var f := FileAccess.open(out_dir.path_join("turn_strip.json"), FileAccess.WRITE)
  1992		f.store_string(JSON.stringify(res))
  1993		f.close()
  1994		var ok: bool = res["combos"] == 160 and res["missing"] == 0 and worst <= 0.1
  1995		print("TURNSTRIP ", "OK" if ok else "FAIL", " combos=", res["combos"], " missing=", res["missing"], " slide_max=", worst)
  1996		get_tree().quit(0 if ok else 1)
