   478	
   479	## 這一幀要畫的走路相位。
   480	func _walk_of(u, a: float) -> float:
   481		var k: int = Gait.kind(u.type)
   482		if u.stun > 0 or (drag_t.get(u.id, 0.0) > 0.0):
   483			if drag_t.get(u.id, 0.0) > 0.0:
   484				return Gait.POSE_DRAG
   485			return Gait.POSE_DAZE
   486		if k == Gait.ROOT:
   487			return 0.0
   488		if gait_on.get(u.id, false):
   489			var d: Array = gait_d.get(u.id, [0.0, 0.0])
   490			return Gait.phase_of(u.type, lerpf(d[0], d[1], a), CS, UNIT_SCALE, u.id)
   491		if k == Gait.FLOAT:
   492			return 0.0001 + time * 4.0 + u.id * 0.37      # 飄浮的就算停著也在飄
   493		return 0.0
   494	
   495	func _gait_frame(delta: float) -> void:
   496		for id in drag_t.keys():
   497			drag_t[id] -= delta
   498			if drag_t[id] <= 0.0:
   499				drag_t.erase(id)
   500		# V1.3.1 P1：全場只剩最後一隻、而且沒在出手也沒在走時，左右張望（用轉身影格）
   501		var alive := [0, 0]
   502		for u0 in view.units:
   503			if u0.alive:
   504				alive[u0.team] += 1
   505		for u in view.units:
   506			var tgt: float = signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
   507			if u.mx != 0 or u.my != 0 or u.stun > 0 or atk_face.has(u.id) or drag_t.has(u.id) or not idle_since.has(u.id):   # 出手、暈眩也不算站定
   508				idle_since[u.id] = time
   509			if u.alive and alive[u.team] == 1 and not view.finished and time - float(idle_since[u.id]) > 1.5 and not atk_face.has(u.id):
   510				tgt = 1.0 if sin(time * PI / 1.1 + u.id) >= 0.0 else -1.0   # 站定 1.5 秒後才開始張望
   511			var f0: float = float(face_now.get(u.id, tgt))
   512			var f1: float = move_toward(f0, tgt, delta * 11.0)
   513			face_now[u.id] = f1
   514			if absf(f0) >= 0.999 and f1 != f0:
   515				turn_start_t[u.id] = anim_clock()   # 1.6.0 B11：轉身開始那一刻（預備壓縮從這裡算；展示時鐘）
   516			if f0 != 0.0 and signf(f1) != signf(f0):
   517				turn_t[u.id] = time   # V1.3 A1a：翻面那一刻（腳下揚塵、展開回彈從這裡算）
   518				turn_flip_t[u.id] = anim_clock()   # 1.6.0 B11：同一刻的展示時鐘（落定微彈用）
   519	
   520	## 轉身過場（V1.3 A1a）：像厚木牌俐落翻面，不是紙片等比夾扁。
   521	## 寬度不低於 TURN_MIN_W（窄位直接跳過去），展開段 X 微回彈 1.04；不做 Y 下壓（混戰時會像受擊）。
   522	const TURN_MIN_W := 0.45
   523	var turn_start_t := {}   # 1.6.0 B11：{兵 id: 轉身開始的展示時鐘}
   524	var turn_flip_t := {}    # 1.6.0 B11：{兵 id: 翻面那一刻的展示時鐘}
   525	const TURN_BOUNCE := 0.04
   526	func _face_of(u) -> float:
   527		var f: float = face_now.get(u.id, signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0))
   528		var a := absf(f)
   529		if a < 0.9 and sprites != null and sprites.has_turn(u.type):
   530			# 有轉身影格的兵：傳原本的朝向，貼圖端選中間姿勢（不能是 0，退回直接繪製時才不會消失）
   531			return maxf(a, 0.18) * (1.0 if f >= 0.0 else -1.0)
   532		var w := TURN_MIN_W + (1.0 - TURN_MIN_W) * a
   533		if a < 1.0 and turn_t.has(u.id) and time - float(turn_t[u.id]) < 0.25:
   534			w *= 1.0 + TURN_BOUNCE * sin(clampf((a - 0.55) / 0.45, 0.0, 1.0) * PI)
   535		return w if f >= 0.0 else -w
   536	
   537	## 剛翻面的兵腳下的小揚塵：0～1（1＝剛翻），超過 0.25 秒＝0。
   538	func _turn_dust_k(u) -> float:
   539		if not turn_t.has(u.id):
   540			return 0.0
   541		var k: float = (time - float(turn_t[u.id])) / 0.25
   542		return 1.0 - k if k >= 0.0 and k < 1.0 else 0.0
   543	
   544	## 打到不同東西聲音不同：盾與石魔是硬的、史萊姆是軟的。
   545	func _hit_material(id: int) -> void:
   546		if id < 0 or view == null:
   547			return
   548		var u = view.unit_by_id(id)
   549		if u == null:
   550			return
   551		var cp: Vector2 = _upos(u) + Vector2(0, -26)
