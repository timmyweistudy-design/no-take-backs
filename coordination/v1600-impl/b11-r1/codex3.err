   498	## 兩個方向之間過渡用的轉身格寬度（cos）：側↔正面 0.8、側↔背面 0.55、正面↔背面 0.3
   499	## 側↔背面不插（1.0＝不插）：轉身格是朝鏡頭烘的，插在轉向背面的中間會先露臉再突然背過去（Hydrogen B11 r2）；
   500	## 要有「轉向背面」的過渡得另烘背面轉身頁（圖集容量另算），留給原畫或 B13b。
   501	static func hd_blend_c(a: int, b: int) -> float:
   502		if a == b:
   503			return 1.0
   504		if a == 0 or b == 0:
   505			return 0.8 if (a + b) > 0 else 1.0
   506		return 0.3
   507	
   508	func heading_of(id: int, mx: int, my: int, walking: bool) -> int:
   509		if not walking or (mx == 0 and my == 0):
   510			if int(hd_state.get(id, 0)) != 0:
   511				hd_t[id] = [anim_clock(), int(hd_state[id]), 0]
   512			hd_state.erase(id)
   513			return 0
   514		var cur: int = int(hd_state.get(id, 0))
   515		var ay := absi(my)
   516		var ax := absi(mx)
   517		var nxt := cur
   518		if cur == 0 and ay * 10 > ax * 13:
   519			nxt = 1 if my > 0 else -1
   520		elif cur != 0 and ay <= ax:
   521			nxt = 0
   522		elif cur != 0 and signi(my) != cur and ay * 10 > ax * 13:
   523			nxt = 1 if my > 0 else -1
   524		if nxt != cur:
   525			hd_t[id] = [anim_clock(), cur, nxt]
   526		hd_state[id] = nxt
   527		return nxt
   528	
   529	## 1.3.0：這一隻的頭頂資訊倍率（照 0.92 倍調的偏移 × 角色放大 × 跟拍放大）
   530	func hk_of(u) -> float:
   531		return HK * focus_scale(u.id)
   532	
   533	## 1.3.0 §5.1：跟拍（點兵讓鏡頭跟）的那一隻畫成 1.4 倍（基準 1.25 倍的 1.12 倍）；只改畫面。
   534	## 1.6.0 B11（P5.1）程式轉身退路的縱向節奏（橫向靠轉身格）：轉身剛開始 TURN_ANT 秒內壓 3%（比受擊小得多，
   535	## 1.3 起「轉身不往下壓、會像受擊」的顧慮——量級壓到受擊的三分之一以下）；翻面後 0.25 秒內往上拉 3%（微彈）。
   536	const TURN_ANT := 0.06
   537	const TURN_SQ := 0.03
   538	func turn_crouch(id: int) -> float:
   539		var c := 1.0
   540		var now := anim_clock()   # 展示時鐘：暫停、頓幀凍結（Codex B11 r2 #1）
   541		if turn_start_t.has(id):
   542			var k0: float = (now - float(turn_start_t[id])) / TURN_ANT
   543			if k0 >= 0.0 and k0 < 1.0:
   544				c *= 1.0 - TURN_SQ * sin(k0 * PI)
   545		if turn_flip_t.has(id):
   546			var k1: float = (now - float(turn_flip_t[id])) / 0.25
   547			if k1 >= 0.0 and k1 < 1.0:
   548				c *= 1.0 + TURN_SQ * sin(k1 * PI)
   549		return c
   550	
   551	const FOCUS_SCALE := 1.4 / 1.25
   552	const BOSS_SIL_PX := 3.0   # 1.6.0 B10（P4.4）：巨獸外框多加的畫面像素
   553	func focus_scale(id: int) -> float:
   554		return FOCUS_SCALE if follow_id >= 0 and id == follow_id else 1.0
   555	
