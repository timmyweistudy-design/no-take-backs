  1872	## 1.6.0 B11（P5.5、S3）轉身連拍：劍士、騎兵 × 兩隊 × 色盲開關 × 五方向（東、西＝側面；東南、西南＝往南走的 3/4 正面；北＝背面）
  1873	## 兩兩轉換 20 種＝160 組合，每組 8 格。每格記走哪條畫法（圖集／向量＝缺格）；原地轉身（東↔西）另量腳底接地點左右漂移（腳滑比）。
  1874	## 用法：<exe> --path game --resolution 1280x800 -- --turn-strip=<輸出資料夾（Windows 路徑）>   每頁存 PNG、最後存 turn_strip.json，印 TURNSTRIP
  1875	var ts_mode := false
  1876	var ts_page: Array = []   # 這一頁要畫的 [type, team, from, to, k, 格子左上]
  1877	var ts_routes: Array = []   # 這一頁每格實際走的畫法
  1878	const TS_DIRS := ["E", "W", "SE", "SW", "N"]
  1879	const TS_CELL := Vector2(78, 96)
  1880	func _ts_state(a: String, b: String, k: float) -> Dictionary:
  1881		# 照戰鬥的實際行為模擬（Hydrogen B11 r2）：朝向 face 在 8 格之間連續變（face_now 的轉身插值），走路時 |face|<0.9 由
  1882		# draw_unit 自動走 3/4 正面頁（正中過渡）；南北頁照 heading 前後半；方向切換中間插同一支 hd_blend_c 的轉身格（側↔背不插，見 hd_blend_c）
  1883		var fa := 1.0 if a in ["E", "SE"] else (-1.0 if a in ["W", "SW"] else (1.0 if b in ["E", "SE"] else -1.0))
  1884		var fb := 1.0 if b in ["E", "SE"] else (-1.0 if b in ["W", "SW"] else fa)
  1885		var face := lerpf(fa, fb, k)
  1886		if absf(face) < 0.18:
  1887			face = 0.18 * (signf(fb) if k >= 0.5 else signf(fa))
  1888		var walking := a in ["SE", "SW", "N"] or b in ["SE", "SW", "N"]
  1889		var ha := 1 if a in ["SE", "SW"] else (-1 if a == "N" else 0)
  1890		var hb := 1 if b in ["SE", "SW"] else (-1 if b == "N" else 0)
  1891		var hd := ha if k < 0.5 else hb
  1892		var c := hd_blend_c(ha, hb)
  1893		if ha != hb and c < 1.0 and k > 0.36 and k < 0.64:
  1894			return {"face": signf(face) * c, "hd": 0, "walk": 0.0}
  1895		return {"face": face, "hd": hd, "walk": (0.3 + k * 4.0) if walking else 0.0}
  1896	
  1897	func _ts_draw_one(p: Vector2, type: int, team: int, st: Dictionary) -> String:
  1898		var face: float = st["face"]
  1899		var walk: float = st["walk"]
  1900		var hd: int = st["hd"]
  1901		var dm := dir_draw_mode(type, hd, true)   # 和戰鬥同一支選畫法（Codex B11 r1 #4）
  1902		if hd != 0 and dm == 0:
  1903			Art.unit(self, p, type, team, face, walk, 0.0, 0.0, 1.0, 0.0, UNIT_SCALE, cbm())
  1904			return "vector"   # 要南北頁卻沒有＝缺格
  1905		if dm < 0:
  1906			sprites.draw_back_walk(self, p, type, team, face, walk, 0.0, 1.0, 0.0, UNIT_SCALE, 0.0, 1.0, cbm())
  1907			return "atlas"
  1908		if dm > 0:
  1909			sprites.draw_unit(self, p, type, team, signf(face) * HEAD_FRONT_C, walk, 0.0, 0.0, 1.0, 0.0, UNIT_SCALE, 0, 0.0, 1.0, cbm())
  1910			return "atlas"
  1911		if absf(face) < 0.9 and not sprites.has_turn(type):
  1912			Art.unit(self, p, type, team, face, walk, 0.0, 0.0, 1.0, 0.0, UNIT_SCALE, cbm())
  1913			return "vector"
  1914		if not sprites.has_type(type):
  1915			Art.unit(self, p, type, team, face, walk, 0.0, 0.0, 1.0, 0.0, UNIT_SCALE, cbm())
  1916			return "vector"
  1917		sprites.draw_unit(self, p, type, team, face, walk, 0.0, 0.0, 1.0, 0.0, UNIT_SCALE, 0, 0.0, 1.0, cbm())
  1918		return "atlas"
