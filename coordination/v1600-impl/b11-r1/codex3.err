   468		sfx.play(snd, 0.16)
   469	
   470	## 小石魔、馬、羊落地揚塵。
   471	func _gait_step_fx(u, d: Array) -> void:
   472		if not gait_on.get(u.id, false):
   473			return
   474		var a: float = Gait.phase_of(u.type, d[0], CS, UNIT_SCALE, u.id)
   475		var b: float = Gait.phase_of(u.type, d[1], CS, UNIT_SCALE, u.id)
   476		if int(a / PI) != int(b / PI):
