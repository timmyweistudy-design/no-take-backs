   443	## 腳步聲：全場一起走會變噪音，所以限量（約每 0.11 秒最多一聲）、音量很小；小石魔例外。
   444	var _step_cool := 0
   445	func _gait_step_snd(u, d: Array) -> void:
   446		var k: int = Gait.kind(u.type)
   447		if k == Gait.FLOAT or k == Gait.ROOT or k == Gait.HOP:
   448			return
   449		var a: float = Gait.phase_of(u.type, d[0], CS, UNIT_SCALE, u.id)
   450		var b: float = Gait.phase_of(u.type, d[1], CS, UNIT_SCALE, u.id)
   451		if int(a / PI) == int(b / PI):
   452			return
   453		if u.type == 19:
   454			sfx.play("step_heavy", 0.55)
