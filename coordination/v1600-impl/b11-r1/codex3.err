   490	## 這一格畫哪一種（戰鬥與連拍工具共用；Codex B11 r1 #4）：-1＝背面走路頁、1＝3/4 正面走路頁、0＝側面（含轉身格）
   491	func dir_draw_mode(type: int, hd: int, cache_ok: bool) -> int:
   492		if hd < 0 and cache_ok and sprites.bw_tex.has(type):
   493			return -1
   494		if hd > 0 and cache_ok and sprites.wt_loc.has(type):
   495			return 1
   496		return 0
