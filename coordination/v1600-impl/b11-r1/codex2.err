  1992	## 1.3.0 §5.2 掉漆貼花：血 <50% 身側剝一塊漆露出淡黃原木胎；<25% 再加一塊＋邊角崩口。
  1993	## 預烘成 32×32 小圖（兩格：一塊／兩塊），每隻受傷的兵只多 1 次貼圖（1.1.0 教訓：每幀逐隻向量畫 p95 多 20%）。召喚物不掉漆。
  1994	static var _chip_tex: Texture2D = null
  1995	static func chip_tex() -> Texture2D:
  1996		if _chip_tex != null:
  1997			return _chip_tex
  1998		var img := Image.create(64, 32, false, Image.FORMAT_RGBA8)
  1999		img.fill(Color(0, 0, 0, 0))
  2000		var wood := Color(0.93, 0.82, 0.6, 0.95)
  2001		var edge := Color(0.32, 0.2, 0.1, 0.8)
  2002		for cell in 2:
  2003			var spots: Array = [[Vector2(12, 14), 5.0]] if cell == 0 else [[Vector2(12, 12), 5.0], [Vector2(20, 21), 4.0]]
  2004			for sp in spots:
  2005				var c: Vector2 = sp[0] + Vector2(cell * 32, 0)
  2006				var r: float = sp[1]
  2007				for y in range(int(c.y - r - 1), int(c.y + r + 2)):
  2008					for x in range(int(c.x - r - 1), int(c.x + r + 2)):
  2009						var d := Vector2(x, y).distance_to(c) + (0.8 if (x + y) % 3 == 0 else 0.0)   # 不規則的剝落邊
  2010						if d <= r - 1.0:
  2011							img.set_pixel(x, y, wood)
  2012						elif d <= r:
  2013							img.set_pixel(x, y, edge)
  2014		_chip_tex = ImageTexture.create_from_image(img)
  2015		return _chip_tex
