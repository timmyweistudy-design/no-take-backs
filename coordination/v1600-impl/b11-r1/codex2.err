  1676	static func pick_focus(units: Array, follow: int) -> Array:
  1677		if follow < 0:
  1678			return []
  1679		var me = null
  1680		for u in units:
  1681			if u.id == follow and u.alive and not u.hidden:
  1682				me = u
  1683				break
  1684		if me == null:
  1685			return []
  1686		var tid := -1
  1687		var ti: int = int(me.target)
  1688		if ti >= 0 and ti < units.size():
  1689			var t = units[ti]
  1690			if t.alive and not t.hidden and t.team != me.team:
  1691				tid = t.id
  1692		return [me.id, tid]
