  2000	## 一格的腳底接地點：找到最低的前景列，取「最低 6 列」裡所有前景像素的平均 x（相對格子中心）——兩隻腳都算進去
  2001	## （只取最低一列會只抓到靠前那隻腳，轉身時換腳就像在滑；B11 第一版的量法錯誤）
  2002	func _ts_foot_x(img: Image, o: Vector2) -> float:
  2003		var x0 := int(o.x)
  2004		var y0 := int(o.y)
  2005		var low := -1
  2006		for yy in range(y0 + 95, y0 + 20, -1):
  2007			for xx in range(x0 + 4, mini(x0 + 74, img.get_width())):   # 畫面外 get_pixel 會給黑色（被當成腳）
  2008				var c := img.get_pixel(xx, yy)
  2009				if absf(c.r - 0.5) + absf(c.g - 0.5) + absf(c.b - 0.5) > 0.12:
  2010					low = yy
  2011					break
  2012			if low >= 0:
  2013				break
  2014		if low < 0:
  2015			return -999.0
  2016		var sx := 0.0
  2017		var n := 0
  2018		for yy in range(low - 5, low + 1):
  2019			for xx in range(x0 + 4, mini(x0 + 74, img.get_width())):
  2020				var c := img.get_pixel(xx, yy)
  2021				if absf(c.r - 0.5) + absf(c.g - 0.5) + absf(c.b - 0.5) > 0.12:
  2022					sx += xx
  2023					n += 1
  2024		return sx / maxi(1, n) - (x0 + 39)
