   772	func _goal_marker(p: Vector2, kind: String) -> void:
   773		var pulse := 0.5 + 0.5 * sin(time * 4.0)
   774		if kind == "protect":
   775			var c := Color(1.0, 0.82, 0.3, 0.75 + 0.25 * pulse)
   776			_hand_ring(p, 22.0 * UNIT_SCALE, c, 3.0)
   777			_hand_ring(p, 27.0 * UNIT_SCALE, Color(c, 0.45), 2.0)
   778		else:
   779			var c2 := Color(1.0, 0.3, 0.25, 0.8 + 0.2 * pulse)
   780			var r := 24.0 * UNIT_SCALE
   781			var q := p + Vector2(0, -22) * UNIT_SCALE
   782			_hand_ring(q, r, c2, 2.5)
   783			for d in [Vector2(1, 0), Vector2(-1, 0), Vector2(0, 1), Vector2(0, -1)]:
   784				draw_line(q + d * r * 0.55, q + d * r * 1.3, c2, 2.5, true)
