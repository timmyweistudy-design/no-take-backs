   684	func _process_inner(delta: float) -> void:
   685		if shot_dir != "" and bool(get("shot_fixed")):
   686			delta = 1.0 / 60.0   # 1.2.0 §14.6：視覺回歸模式（--shot-fixed）用固定幀時間；一般版面檢查照真實時間（Codex cat01 #6）
   687		_touch_tick(delta)
   688		_pad_clear_tick()
   689		_stick_repeat(delta)
   690		_process_cmds()
   691		time += delta
   692		call("_gif_tick", delta)   # V1.4 #14
   693		if paused and key_t > 0.0:
   694			key_t += delta
   695		if paused and float(last_kill[1]) > 0.0:
   696			last_kill[1] = float(last_kill[1]) + delta   # 暫停時定格與歡呼波浪也凍結   # V1.3 C4：暫停時關鍵時刻的演出凍結（Codex v130-impl2）
   697		SteamApi.run_callbacks()
   698		if toast_t > 0:
   699			toast_t -= delta
   700		# V1.5：手把震動跟著鏡頭震動（強度可調、0 關掉；只在用手把時）
   701		if shake > rumble_seen + 0.05 and pad_mode and int(Save.s("rumble")) > 0:
   702			var rk: float = clampf(shake * 4.0, 0.2, 1.0) * int(Save.s("rumble")) / 100.0
   703			Input.start_joy_vibration(last_joy, 0.3 * rk, 0.6 * rk, 0.18)
   704		rumble_seen = shake
   705		if removed_banner_t > 0.0:
   706			removed_banner_t -= delta
