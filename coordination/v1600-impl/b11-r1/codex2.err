   730	## 機關還沒發動：虛線框＋「第 N 秒」小牌（戰鬥中改成倒數）。
   731	func _ev_warn(R: Rect2, t0: int, tk: float, col: Color, outline := true) -> void:
   732		if outline:
   733			var pts := [R.position, Vector2(R.end.x, R.position.y), R.end, Vector2(R.position.x, R.end.y), R.position]
   734			for k in 4:
   735				var a: Vector2 = pts[k]
   736				var b: Vector2 = pts[k + 1]
   737				var segs := int(a.distance_to(b) / 10.0)
   738				for s2 in segs:
   739					if s2 % 2 == 0:
   740						draw_line(a.lerp(b, float(s2) / segs), a.lerp(b, float(s2 + 1) / segs), Color(col, 0.85), 2.0, true)
   741		var left := (t0 - tk) / 20.0
   742		var lab := ("%ds" % int(ceil(left))) if tk > 0.0 else ("%ds" % (t0 / 20))
   743		var c := R.get_center()
   744		draw_circle(c, 15.0, Color(0.98, 0.94, 0.84, 0.92), true, -1.0, true)
   745		draw_arc(c, 15.0, 0, TAU, 24, col, 2.0, true)
   746		_text(c - Vector2(0, tz("C") * 0.68), lab, tz("C"), Color(0.25, 0.15, 0.08), true, true, 40)
   747	## V1.2 F3：環境動態（確定性：只看時間與編號，不進模擬）。草地／林間落葉、冰原落雪、熔岩火星；簡化特效時不畫。
   748	func _draw_ambient() -> void:
   749		if bool(Save.s("reduce_fx")) or bool(Save.s("plain_ui")):
   750			return
   751		var biome := str(MapDefs.MAPS[fld_map]["biome"]) if fld_map < MapDefs.MAPS.size() else "grass"
   752		var n := 14
   753		for i in n:
   754			var seed := float(i) * 12.9898
   755			var ph := fposmod(time * (0.05 + fposmod(seed, 0.04)) + fposmod(seed * 3.7, 1.0), 1.0)
   756			var x := fposmod(seed * 97.3 + sin(time * 0.6 + seed) * 18.0, fld_size.x)
   757			match biome:
   758				"ice":
   759					var p := ORIGIN + Vector2(x + ph * 40.0, ph * fld_size.y)
   760					draw_circle(p, 1.6 + fposmod(seed, 1.2), Color(1, 1, 1, 0.55 * sin(ph * PI)), true, -1.0, true)
   761				"lava":
   762					var p2 := ORIGIN + Vector2(x, fld_size.y * (1.0 - ph))
   763					draw_circle(p2, 1.4, Color(1.0, 0.55 + 0.3 * fposmod(seed, 1.0), 0.15, 0.7 * sin(ph * PI)), true, -1.0, true)
   764				_:
   765					if i % 2 == 0:
   766						var p3 := ORIGIN + Vector2(x + sin(time * 1.3 + seed) * 10.0, ph * fld_size.y)
   767						var rot := time * 2.0 + seed
   768						var d := Vector2(cos(rot), sin(rot)) * 3.0
   769						draw_line(p3 - d, p3 + d, Color(0.55, 0.62, 0.25, 0.5 * sin(ph * PI)), 2.4, true)
