  1971							xs.append(_ts_foot_x(img, ts_page[idx][5]))
  1972					if miss > 0:
  1973						res["missing"] += miss
  1974						res["missing_list"].append([j[0], j[1], int(cbv), j[2], j[3], miss])
  1975					if not xs.is_empty():
  1976						var lo := 1e9
