+	_poly(ci, PackedVector2Array([gp + dir * 3.0 + o * 4.5, gp + dir * 9.0, gp + dir * 3.0 - o * 4.5]), STEEL, a)
+	_fist(ci, gp, dir, a)
+	_part_end(ci)
