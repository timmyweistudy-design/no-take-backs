   486		if k == Gait.FLOAT:
   487			return 0.0001 + time * 4.0 + u.id * 0.37      # 飄浮的就算停著也在飄
   488		return 0.0
   489	
   490	func _gait_frame(delta: float) -> void:
   491		for id in drag_t.keys():
   492			drag_t[id] -= delta
   493			if drag_t[id] <= 0.0:
   494				drag_t.erase(id)
   495		# V1.3.1 P1：全場只剩最後一隻、而且沒在出手也沒在走時，左右張望（用轉身影格）
   496		var alive := [0, 0]
   497		for u0 in view.units:
   498			if u0.alive:
   499				alive[u0.team] += 1
   500		for u in view.units:
   501			var tgt: float = signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
   502			if u.mx != 0 or u.my != 0 or u.stun > 0 or atk_face.has(u.id) or drag_t.has(u.id) or not idle_since.has(u.id):   # 出手、暈眩也不算站定
   503				idle_since[u.id] = time
   504			if u.alive and alive[u.team] == 1 and not view.finished and time - float(idle_since[u.id]) > 1.5 and not atk_face.has(u.id):
   505				tgt = 1.0 if sin(time * PI / 1.1 + u.id) >= 0.0 else -1.0   # 站定 1.5 秒後才開始張望
   506			var f0: float = float(face_now.get(u.id, tgt))
   507			var f1: float = move_toward(f0, tgt, delta * 11.0)
   508			face_now[u.id] = f1
   509			if absf(f0) >= 0.999 and f1 != f0:
   510				turn_start_t[u.id] = time   # 1.6.0 B11：轉身開始那一刻（預備壓縮從這裡算）
   511			if f0 != 0.0 and signf(f1) != signf(f0):
   512				turn_t[u.id] = time   # V1.3 A1a：翻面那一刻（腳下揚塵、展開回彈從這裡算）
   513	
   514	## 轉身過場（V1.3 A1a）：像厚木牌俐落翻面，不是紙片等比夾扁。
   515	## 寬度不低於 TURN_MIN_W（窄位直接跳過去），展開段 X 微回彈 1.04；不做 Y 下壓（混戰時會像受擊）。
   516	const TURN_MIN_W := 0.45
   517	var turn_start_t := {}   # 1.6.0 B11：{兵 id: 轉身開始時間}
   518	const TURN_BOUNCE := 0.04
   519	func _face_of(u) -> float:
   520		var f: float = face_now.get(u.id, signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0))
   521		var a := absf(f)
   522		if a < 0.9 and sprites != null and sprites.has_turn(u.type):
   523			# 有轉身影格的兵：傳原本的朝向，貼圖端選中間姿勢（不能是 0，退回直接繪製時才不會消失）
   524			return maxf(a, 0.18) * (1.0 if f >= 0.0 else -1.0)
   525		var w := TURN_MIN_W + (1.0 - TURN_MIN_W) * a
   526		if a < 1.0 and turn_t.has(u.id) and time - float(turn_t[u.id]) < 0.25:
   527			w *= 1.0 + TURN_BOUNCE * sin(clampf((a - 0.55) / 0.45, 0.0, 1.0) * PI)
   528		return w if f >= 0.0 else -w
   529	
   530	## 剛翻面的兵腳下的小揚塵：0～1（1＝剛翻），超過 0.25 秒＝0。
   531	func _turn_dust_k(u) -> float:
   532		if not turn_t.has(u.id):
   533			return 0.0
   534		var k: float = (time - float(turn_t[u.id])) / 0.25
   535		return 1.0 - k if k >= 0.0 and k < 1.0 else 0.0
   536	
   537	## 打到不同東西聲音不同：盾與石魔是硬的、史萊姆是軟的。
   538	func _hit_material(id: int) -> void:
   539		if id < 0 or view == null:
   540			return
   541		var u = view.unit_by_id(id)
   542		if u == null:
