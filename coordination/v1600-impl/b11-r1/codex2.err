   786	func _draw_units_of(s, dim: bool) -> void:
   787		if s == view:
   788			mag_pose = []   # 1.3.0 §2：這一幀沒畫到被選的那隻（偽裝、潛行）就不沿用上一隻的姿勢（Codex cat06 #3）
   789		var list: Array = []
   790		for u in s.units:
   791			if u.alive:
   792				list.append(u)
   793		var live: bool = s == view
   794		var rfx := bool(Save.s("reduce_fx"))
   795		# V1.3.1 P2：大落後（戰力 <25%）的那一方，沒事做的兵表情沉下來（每幀每隊只算一次）
   796		var grim := [false, false]
   797		if live and not s.finished:
   798			# 展示快照沒有戰力函式（Codex v131-impl1）：用存活比例，而且要對方明顯比較多才算落後
   799			var cnt := [0, 0]
   800			var liv := [0, 0]
   801			for su in s.units:
   802				if su.summon:
   803					continue
   804				cnt[su.team] += 1
   805				if su.alive:
   806					liv[su.team] += 1
   807			for gt in 2:
   808				var mine := float(liv[gt]) / maxf(1.0, cnt[gt])
   809				var theirs := float(liv[1 - gt]) / maxf(1.0, cnt[1 - gt])
   810				grim[gt] = mine < 0.25 and theirs > mine * 2.0
   811		# V1.3 P0-1：這一幀的畫面位置只算一次（排序比較器原本每次比較都重算 _upos）
   812		var pc := {}
   813		if live:
   814			for u in list:
   815				pc[u.id] = _upos(u) + _open_drop(u)
   816			list.sort_custom(func(a, b): return pc[a.id].y < pc[b.id].y)
   817		else:
   818			list.sort_custom(func(a, b): return a.y < b.y)
   819		_draw_v8_ground(s, live)
   820		# 第一層：腳底標記與影子（全部先畫，不會被別人的身體整個蓋住時也看得到外圈）
   821		var a_now := clampf(accum / 0.05, 0.0, 1.0) if state == St.BATTLE else 1.0
   822		var gm: Array = _goal_mark()
   823		if live and tm_ghost != null and play_kind == "review" and tm_ghost_on:
   824			# V1.4 #1 時光機：原本那條時間線的兵畫成地上的淡圈（隊伍色點＋白圈），看得出兩條時間線從哪裡分開
   825			for gu in tm_ghost.units:
   682			Input.vibrate_handheld(30)
