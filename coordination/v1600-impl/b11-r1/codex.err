  1906				return "atlas"
  1907			Art.unit(self, p, type, team, face, walk, 0.0, 0.0, 1.0, 0.0, UNIT_SCALE, cbm())
  1908			return "vector"
  1909		if absf(face) < 0.9 and not sprites.has_turn(type):
