  1880	func _ts_state(a: String, b: String, k: float) -> Dictionary:
  1881		# 轉換過程：先在原方向、中間過渡、最後在新方向。側面互轉＝原地轉身（face 經過轉身格）；有南／北＝邊走邊轉
  1882		var dir := a if k < 0.5 else b
  1883		var face := 1.0 if dir in ["E", "SE"] else -1.0
  1884		if a in ["E", "W"] and b in ["E", "W"] and a != b:
  1885			var f0 := 1.0 if a == "E" else -1.0
  1886			face = lerpf(f0, -f0, k)
  1887			if absf(face) < 0.18:
  1888				face = 0.18 * (1.0 if k < 0.5 else -1.0) * signf(f0)
  1889			return {"face": face, "hd": 0, "walk": 0.0}
  1890		var walking := a in ["SE", "SW", "N"] or b in ["SE", "SW", "N"]
  1891		var hd := 1 if dir in ["SE", "SW"] else (-1 if dir == "N" else 0)
  1892		return {"face": face, "hd": hd, "walk": (0.3 + k * 4.0) if walking else 0.0}
