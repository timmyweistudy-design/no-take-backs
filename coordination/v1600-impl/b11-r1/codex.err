   464	## 小石魔、馬、羊落地揚塵。
   465	func _gait_step_fx(u, d: Array) -> void:
   466		if not gait_on.get(u.id, false):
   467			return
   468		var a: float = Gait.phase_of(u.type, d[0], CS, UNIT_SCALE, u.id)
   469		var b: float = Gait.phase_of(u.type, d[1], CS, UNIT_SCALE, u.id)
   470		if int(a / PI) != int(b / PI):
   471			fx.append({"kind": "step", "p": _upos(u), "t": 0.0, "dur": 0.35, "big": u.type == 19})
   472	
   473	## 這一幀要畫的走路相位。
   474	func _walk_of(u, a: float) -> float:
   475		var k: int = Gait.kind(u.type)
   476		if u.stun > 0 or (drag_t.get(u.id, 0.0) > 0.0):
   477			if drag_t.get(u.id, 0.0) > 0.0:
   478				return Gait.POSE_DRAG
   479			return Gait.POSE_DAZE
   480		if k == Gait.ROOT:
   481			return 0.0
   482		if gait_on.get(u.id, false):
   483			var d: Array = gait_d.get(u.id, [0.0, 0.0])
   484			return Gait.phase_of(u.type, lerpf(d[0], d[1], a), CS, UNIT_SCALE, u.id)
   485		if k == Gait.FLOAT:
   486			return 0.0001 + time * 4.0 + u.id * 0.37      # 飄浮的就算停著也在飄
   487		return 0.0
