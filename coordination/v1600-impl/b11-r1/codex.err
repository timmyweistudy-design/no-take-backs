+## 1.6.0 B11（P5.2）命中頓幀：出手動作在命中點（ATK_STRIKE）停 HIT_HOLD，之後的收招等比補回（總長不變、不跳格；只改畫面，不碰模擬）
+const HIT_HOLD := 0.04
+static func hit_hold(a: float) -> float:
+	var s0 := Art.ATK_STRIKE
+	if a <= s0:
+		return a
+	if a <= s0 + HIT_HOLD:
+		return s0
+	return s0 + (a - s0 - HIT_HOLD) * (1.0 - s0) / (1.0 - s0 - HIT_HOLD)
+
+## 1.6.0 B11（P5.1）程式轉身退路的縱向節奏（橫向靠轉身格）：轉身剛開始 TURN_ANT 秒內壓 3%（比受擊小得多，
+## 1.3 起「轉身不往下壓、會像受擊」的顧慮——量級壓到受擊的三分之一以下）；翻面後 0.25 秒內往上拉 3%（微彈）。
+const TURN_ANT := 0.06
+const TURN_SQ := 0.03
+func turn_crouch(id: int) -> float:
+	var c := 1.0
+	if turn_start_t.has(id):
+		var k0: float = (time - float(turn_start_t[id])) / TURN_ANT
+		if k0 >= 0.0 and k0 < 1.0:
+			c *= 1.0 - TURN_SQ * sin(k0 * PI)
+	if turn_t.has(id):
+		var k1: float = (time - float(turn_t[id])) / 0.25
+		if k1 >= 0.0 and k1 < 1.0:
+			c *= 1.0 + TURN_SQ * sin(k1 * PI)
+	return c
+
