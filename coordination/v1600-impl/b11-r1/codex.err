   489	func _gait_frame(delta: float) -> void:
   490		for id in drag_t.keys():
   491			drag_t[id] -= delta
   492			if drag_t[id] <= 0.0:
   493				drag_t.erase(id)
   494		# V1.3.1 P1：全場只剩最後一隻、而且沒在出手也沒在走時，左右張望（用轉身影格）
   495		var alive := [0, 0]
   496		for u0 in view.units:
   497			if u0.alive:
   498				alive[u0.team] += 1
   499		for u in view.units:
   500			var tgt: float = signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0)
   501			if u.mx != 0 or u.my != 0 or u.stun > 0 or atk_face.has(u.id) or drag_t.has(u.id) or not idle_since.has(u.id):   # 出手、暈眩也不算站定
   502				idle_since[u.id] = time
   503			if u.alive and alive[u.team] == 1 and not view.finished and time - float(idle_since[u.id]) > 1.5 and not atk_face.has(u.id):
   504				tgt = 1.0 if sin(time * PI / 1.1 + u.id) >= 0.0 else -1.0   # 站定 1.5 秒後才開始張望
   505			var f0: float = float(face_now.get(u.id, tgt))
   506			var f1: float = move_toward(f0, tgt, delta * 11.0)
   507			face_now[u.id] = f1
   508			if absf(f0) >= 0.999 and f1 != f0:
   509				turn_start_t[u.id] = time   # 1.6.0 B11：轉身開始那一刻（預備壓縮從這裡算）
   510			if f0 != 0.0 and signf(f1) != signf(f0):
   511				turn_t[u.id] = time   # V1.3 A1a：翻面那一刻（腳下揚塵、展開回彈從這裡算）
   512	
   513	## 轉身過場（V1.3 A1a）：像厚木牌俐落翻面，不是紙片等比夾扁。
   514	## 寬度不低於 TURN_MIN_W（窄位直接跳過去），展開段 X 微回彈 1.04；不做 Y 下壓（混戰時會像受擊）。
   515	const TURN_MIN_W := 0.45
   516	var turn_start_t := {}   # 1.6.0 B11：{兵 id: 轉身開始時間}
   517	const TURN_BOUNCE := 0.04
   518	func _face_of(u) -> float:
   519		var f: float = face_now.get(u.id, signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0))
   520		var a := absf(f)
   521		if a < 0.9 and sprites != null and sprites.has_turn(u.type):
   522			# 有轉身影格的兵：傳原本的朝向，貼圖端選中間姿勢（不能是 0，退回直接繪製時才不會消失）
   523			return maxf(a, 0.18) * (1.0 if f >= 0.0 else -1.0)
   524		var w := TURN_MIN_W + (1.0 - TURN_MIN_W) * a
   525		if a < 1.0 and turn_t.has(u.id) and time - float(turn_t[u.id]) < 0.25:
   526			w *= 1.0 + TURN_BOUNCE * sin(clampf((a - 0.55) / 0.45, 0.0, 1.0) * PI)
   527		return w if f >= 0.0 else -w
   528	
   529	## 剛翻面的兵腳下的小揚塵：0～1（1＝剛翻），超過 0.25 秒＝0。
   530	func _turn_dust_k(u) -> float:
   531		if not turn_t.has(u.id):
   532			return 0.0
   533		var k: float = (time - float(turn_t[u.id])) / 0.25
   534		return 1.0 - k if k >= 0.0 and k < 1.0 else 0.0
