   437	## 腳步聲：全場一起走會變噪音，所以限量（約每 0.11 秒最多一聲）、音量很小；小石魔例外。
   438	var _step_cool := 0
   439	func _gait_step_snd(u, d: Array) -> void:
   440		var k: int = Gait.kind(u.type)
   441		if k == Gait.FLOAT or k == Gait.ROOT or k == Gait.HOP:
   442			return
   443		var a: float = Gait.phase_of(u.type, d[0], CS, UNIT_SCALE, u.id)
   444		var b: float = Gait.phase_of(u.type, d[1], CS, UNIT_SCALE, u.id)
   445		if int(a / PI) == int(b / PI):
   446			return
   447		if u.type == 19:
   448			sfx.play("step_heavy", 0.55)
   449			return
   450		if view.tick <= _step_cool:
   451			return
   452		_step_cool = view.tick + 2
   453		var snd := "step_grass"
   454		match MapDefs.MAPS[fld_map]["biome"]:
   455			"ice":
   456				snd = "step_snow"
   457			"lava", "canyon":
   458				snd = "step_stone"
   459			"river":
   460				if absi(int(u.x) - fld_w / 2) < fld_w / 10:
   461					snd = "step_wood"
   462		sfx.play(snd, 0.16)
