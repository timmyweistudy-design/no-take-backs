  1992	## 一格的腳底接地點：找到最低的前景列，取「最低 6 列」裡所有前景像素的平均 x（相對格子中心）——兩隻腳都算進去
  1993	## （只取最低一列會只抓到靠前那隻腳，轉身時換腳就像在滑；B11 第一版的量法錯誤）
  1994	func _ts_foot_x(img: Image, o: Vector2) -> float:
  1995		var x0 := int(o.x)
  1996		var y0 := int(o.y)
  1997		var low := -1
  1998		for yy in range(y0 + 95, y0 + 20, -1):
  1999			for xx in range(x0 + 4, mini(x0 + 74, img.get_width())):   # 畫面外 get_pixel 會給黑色（被當成腳）
  2000				var c := img.get_pixel(xx, yy)
  2001				if absf(c.r - 0.5) + absf(c.g - 0.5) + absf(c.b - 0.5) > 0.12:
  2002					low = yy
  2003					break
  2004			if low >= 0:
  2005				break
  2006		if low < 0:
  2007			return -999.0
  2008		var sx := 0.0
  2009		var n := 0
  2010		for yy in range(low - 5, low + 1):
  2011			for xx in range(x0 + 4, mini(x0 + 74, img.get_width())):
  2012				var c := img.get_pixel(xx, yy)
  2013				if absf(c.r - 0.5) + absf(c.g - 0.5) + absf(c.b - 0.5) > 0.12:
  2014					sx += xx
  2015					n += 1
  2016		return sx / maxi(1, n) - (x0 + 39)
  2017	
  2018	func _draw() -> void:
  2019		if ts_mode:
  2020			draw_rect(Rect2(0, 0, 1280, 800), Color(0.5, 0.5, 0.5))
  2021			ts_routes = []
  2022			for e in ts_page:
  2023				var o: Vector2 = e[5]
  2024				var st := _ts_state(e[2], e[3], e[4])
  2025				ts_routes.append(_ts_draw_one(o + Vector2(39, 78), e[0], e[1], st))

