    79	
    80	## 這一刻要演哪一次命中（Codex R5 #2）：取前搖已開始的最近一次；但前一次的揮擊還沒做完就先讓它做完（揮擊優先、後搖可被截斷）。
    81	static func pick_hit(hits: Array, disp: float, type: int, wind := -1.0) -> int:
    82		var tm := atk_timing(type, wind)
    83		var w: float = tm[1]
    84		var strike_end: float = w + tm[2]
    85		var cur := -1
    86		for h in hits:
    87			if float(h) - w <= disp:
    88				if cur >= 0 and disp - (float(cur) - w) < strike_end:
    89					break   # 前一次還在揮擊，不換
    90				cur = h
    91		return cur
    92	
