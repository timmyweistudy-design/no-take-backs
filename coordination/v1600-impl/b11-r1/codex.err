    95	## 三段式攻擊進度（R5）：前搖固定是命中前 DELAY 個 tick，揮擊與後搖依攻擊間隔壓縮（攻速快的兵動作也快，不會疊在一起）。
    96	## 回傳 Art.unit 的 atk 參數：0＝沒在攻擊；0～0.3125 前搖、0.3125～0.53125 揮擊（命中在 0.3125）、之後後搖到 1。
    97	## 一次攻擊動作的時長（tick）：前搖固定 DELAY，揮擊 0.22×總長；atk_progress 與 pick_hit 共用（Codex S4 #1）。
    98	## V1.5：遠程的飛行時間（tick）。0＝近戰或不畫飛行物（孢子菇是毒圈、巫毒是連線，各自另外演）。
    99	## 實際飛行還會被緩衝長度限制：飛行＋前搖不能超過展示緩衝（手動軍令局緩衝只有 2，就幾乎直接命中）。
   100	const PROJ_FLY := {2: 5, 6: 6, 17: 5, 7: 3}   # 弓箭手、投彈兵、骷髏法師、醫者（補血）
   101	
   102	static func proj_fly(type: int) -> int:
   103		return int(PROJ_FLY.get(type, 0))
   104	
   105	## V1.5：這一刻該演哪一次攻擊。回傳 [出手 tick, 命中 tick, 飛行進度 -1／0～1]；沒有就 [-1, -1, -1]。
   106	## 遠程的出手比命中早 fly 個 tick（fly＝飛行時間，受緩衝長度限制）；飛行進度在出手～命中之間由 0 走到 1。
   107	## only：哪些命中 tick 是飛行物（null＝全部）。投彈兵貼身敲人這種近身命中不提早出手、不畫炸彈（Codex v150-i1 #3）。
   108	static func proj_phase(hits: Array, disp: float, type: int, delay: int, only = null) -> Array:
   109		# 回傳 [出手 tick, 命中 tick, 飛行進度, 動作起點 tick, 前搖長度]
   110		# V1.5.1：每一發各自決定前搖——有飛行物的那發用局內前搖（手動軍令局 1 tick），近身的（投彈兵敲擊）照舊 2 tick（Codex v151-i1 #7）
   111		var wd := proj_wind(type, delay)
   112		var fly: int = maxi(0, mini(proj_fly(type), delay - wd))
   113		var tm := atk_timing(type)
   114		var st: float = tm[2]
   115		var es: Array = []   # [動作起點, 出手, 命中, 前搖]
   116		for x in hits:
   117			var shift: bool = fly > 0 and (only == null or (only as Dictionary).has(int(x)))
   118			if shift:
   119				es.append([int(x) - fly - wd, int(x) - fly, int(x), wd])
   120			else:
   121				es.append([int(x) - ViewBuffer.DELAY, int(x), int(x), ViewBuffer.DELAY])
   122		es.sort_custom(func(a, b): return a[0] < b[0])
   123		var cur: Array = []
   124		for e in es:
   125			if float(e[0]) <= disp:
   126				if not cur.is_empty() and disp - float(cur[0]) < float(cur[3]) + st:
   127					break   # 前一次還在揮擊，不換
   128				cur = e
   129		if cur.is_empty():
   130			return [-1, -1, -1.0, -1, ViewBuffer.DELAY]
   131		var hr: int = cur[1]
   132		var h: int = cur[2]
   133		var k := -1.0
   134		if h > hr and disp >= float(hr) and disp <= float(h):
   135			k = clampf((disp - float(hr)) / float(h - hr), 0.0, 1.0)
   136		return [hr, h, k, cur[0], cur[3]]
   137	
   138	static func atk_timing(type: int, wind := -1.0) -> Array:
   139		var period := float(D.stat(type)["cd"])   # cd 的單位是 tick（模擬每次出手加 cd×4、每 tick 扣 4）
   140		var tot := clampf(period, 4.0, 6.4)
   141		return [tot, float(ViewBuffer.DELAY) if wind < 0.0 else wind, 0.22 * tot]
   142	
   143	## V1.5.1 B1：這一局遠程的前搖 tick。手動軍令局緩衝只有 2 tick：有飛行物的遠程前搖縮成 1 tick、讓出 1 tick 給飛行（命中 tick 不變）。
   144	static func proj_wind(type: int, delay: int) -> int:
   145		if proj_fly(type) > 0 and delay <= ViewBuffer.DELAY:
   146			return 1
   147		return ViewBuffer.DELAY
   148	
   149	
   150	static func atk_progress(dt: float, type: int, wind := -1.0) -> float:
   151		var tm := atk_timing(type, wind)
   152		var tot: float = tm[0]
   153		var w: float = tm[1]
   154		var st: float = tm[2]
   155		var rc := tot - w - st
   156		if dt < 0.0 or dt >= tot:
   157			return 0.0
   158		var a: float
   159		if dt < w:
   160			a = Art.ATK_WINDUP * dt / w
   161		elif dt < w + st:
   162			a = Art.ATK_WINDUP + (Art.ATK_STRIKE - Art.ATK_WINDUP) * (dt - w) / st
   163		else:
   164			a = Art.ATK_STRIKE + (1.0 - Art.ATK_STRIKE) * (dt - w - st) / rc
   165		return maxf(a, 0.001)
   166	
   167	
   168	
   169	static func _smoothstep01(x: float) -> float:
   170		return x * x * (3.0 - 2.0 * x)
