    70	## 畫面上現在播到第幾 tick（含小數，插值用）。
    71	func _disp_tick() -> float:
    72		if view == null:
    73			return 0.0
    74		if state != St.BATTLE:
    75			return float(view.tick)
    76		return view.tick + clampf(accum / 0.05, 0.0, 8.0 if view.finished else 1.0)
    77	
