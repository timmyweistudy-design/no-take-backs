  1965							miss += 1
  1966						if j[2] in ["E", "W"] and j[3] in ["E", "W"]:
  1967							xs.append(_ts_foot_x(img, ts_page[idx][5]))
  1968					if miss > 0:
  1969						res["missing"] += miss
  1970						res["missing_list"].append([j[0], j[1], int(cbv), j[2], j[3], miss])
  1971					if not xs.is_empty():
  1972						var lo := 1e9
  1973						var hi := -1e9
  1974						for x in xs:
  1975							if x > -900.0:
  1976								lo = minf(lo, x)
  1977								hi = maxf(hi, x)
  1978						res["slide"].append([j[0], j[1], int(cbv), j[2], j[3], snappedf((hi - lo) / (36.0 * UNIT_SCALE / 0.92), 0.001) if hi >= lo else -1.0])
  1979		ts_mode = false
  1980		Save.set_setting("colorblind", false)
  1981		var worst := 0.0
