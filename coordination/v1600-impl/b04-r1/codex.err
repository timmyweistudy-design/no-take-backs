		if ev.button_index == JOY_BUTTON_X:
			_pad_x_hold(ev.pressed)   # 1.1.0 Q1：長按拿掉鍵＝清空自己的陣
	if ev is InputEventJoypadButton and ev.pressed and _pad_tool(ev):
