## 憲法 3（禁純黑）：選單打開時的暗幕用暖暗墨色，不用 #000。
const DIM_INK := PAL.DIM_INK
func _dim(a: float) -> void:
	draw_rect(Rect2(0, 0, 1280, 800), Color(DIM_INK, a))
const TEX_FRAME := "res://art/ui/frame.png"
const TEX_GROOVE := "res://art/ui/groove.png"
const TEX_PAPER := "res://art/ui/paper.png"
const TEX_VIGNETTE := "res://art/ui/vignette.png"
var _tex_cache := {}

func _ui_tex(path: String) -> Texture2D:
	if not _tex_cache.has(path):
		_tex_cache[path] = load(path) if ResourceLoader.exists(path) else null
	if _tex_cache[path] == null and layout_probe and not path in probe_missing:
		probe_missing.append(path)
	return _tex_cache[path]

## V1.2：頂部資訊列：深木紋＋下緣一條亮線與落影（沒有貼圖時照舊平塗）。
func _hud_bar(r: Rect2) -> void:
	if bool(Save.s("plain_ui")) or not _tex_box(r.grow_individual(8, 8, 8, 0), "wood", Color(0.3, 0.21, 0.15, 0.97)):
		draw_rect(r, UI_BG)
		return
	draw_rect(Rect2(r.position.x, r.end.y - 2, r.size.x, 2), Color(0.55, 0.42, 0.28, 0.9))
	draw_rect(Rect2(r.position.x, r.end.y, r.size.x, 4), Color(0, 0, 0, 0.25))

## V1.2：木製框（九宮格、四角銅釘、中間透明），面板、戰場、大廳沙盤預覽共用。grow＝往外擴多少。
func _wood_frame(r: Rect2, grow := 8.0, key := "frame") -> void:
	var fx := _ui_tex(TEX_FRAME)
	if fx == null or bool(Save.s("plain_ui")):
		for d in df:
			h += text_h("・" + _diff_text(d), tz("S"), w - 10)
	return h

## 驗證錯誤（紅）、花不完的錢（黃）、和標準不同的項目。
func _draw_lobby_notes(R: Rect2) -> void:
	var y := R.position.y
	for k in lobby_r.validate():
		_text(Vector2(R.position.x, y), "× " + L.t(k), tz("B"), Color("#ff7b7b"), false, true, R.size.x)
		y += tz("B") * 1.5
	var two: bool = lobby_r.handicap or not lobby_r.ai_pool_same
	for tm in (2 if two else 1):
		var ms: Dictionary = lobby_r.max_spend(tm)
		if int(ms["unused"]) > 0 and lobby_r.validate().is_empty():
			var who := (L.t("blue") if tm == 0 else L.t("red")) + "：" if two else ""
			var line := "⚠ " + who + L.t("lb_unused", [ms["units"], ms["spend"], ms["unused"]])
			_text(Vector2(R.position.x, y), line, tz("S"), Color("#ffd166"), false, false, R.size.x)
			y += text_h(line, tz("S"), R.size.x) + 4
	var df: Array = lobby_r.diff(_lobby_std())
	if not df.is_empty() and y + tz("S") * 1.4 <= R.end.y:
		_text(Vector2(R.position.x, y), L.t("lb_diff_n", [df.size()]), tz("S"), TXT_DIM, false, true, R.size.x)
		y += tz("S") * 1.4
		var fs := tz("S")
		var left := R.end.y - y - tz("S") * 0.6   # 留一點邊，最後一行不碰到下面的重置鈕
		var list_h := 0.0
		for d in df:
			list_h += text_h("・" + _diff_text(d), fs, R.size.x - 10)
		if list_h <= left:
			for d in df:
				var ln := "・" + _diff_text(d)
				_text(Vector2(R.position.x + 10, y), ln, fs, TXT_DIM, false, false, R.size.x - 10)
				y += text_h(ln, fs, R.size.x - 10)
		else:
			# 放不下（大字）：改成一段連續文字、用註記字級；還是放不下就截到放得下的項目數＋「…」（Antigravity 實作第 1 輪）
			fs = tz("C")
			var bits: Array = []
			for d in df:
				bits.append(_diff_text(d))
			var para := "・".join(bits)
			while bits.size() > 1 and text_h(para, fs, R.size.x) > left:
				bits.pop_back()
				para = "・".join(bits) + "…"
			if text_h(para, fs, R.size.x) <= left:
				_text(Vector2(R.position.x, y), para, fs, TXT_DIM, false, false, R.size.x)

func _diff_text(d: Array) -> String:
func _draw_lobby_detail(R: Rect2) -> void:
	var tabs: Array = LOBBY_TABS.duplicate()
	if lobby_kind == "duel":
		tabs.erase("lb_tab_ai")
	# V1.6.1 A10：常用（前面）與進階（實驗、軍令）中間隔一段、標「進階」
	var adv_gap := tz("C") * 1.6 + 8.0
	var adv_at: int = tabs.find("lb_tab_lab")
	for i in tabs.size():
		var idx: int = LOBBY_TABS.find(tabs[i])
		var gy := adv_gap if adv_at >= 0 and i >= adv_at else 0.0
		if i == adv_at:
			draw_line(R.position + Vector2(8, i * 58 + 2), R.position + Vector2(142, i * 58 + 2), Color(1, 1, 1, 0.25), 1.0)
			_text(R.position + Vector2(75, i * 58 + 4), L.t("lb_adv"), tz("C"), TXT_DIM, true, false, 140)
		btn_group = "lb_subtabs"   # 1.5.0 R14：折頁子分頁＝一個選擇器
		_btn(Rect2(R.position + Vector2(0, i * 58 + gy), Vector2(150, 50)), L.t(tabs[i]), func(): lobby_tab = idx; lobby_rpage = 0, true, false,
			TH_ACTIVE if idx == lobby_tab else Color(0, 0, 0, 0))
		btn_group = ""
	var L0 := Rect2(R.position + Vector2(170, 0), Vector2(600, R.size.y))
	var D0 := Rect2(Vector2(L0.end.x + 20, R.position.y), Vector2(R.end.x - L0.end.x - 20, R.size.y))
	draw_rect(D0, Color(0, 0, 0, 0.25))
	match lobby_tab:
		0:
			var rows: Array = [["budget", L.t("lb_gold_blue") if lobby_r.handicap else L.t("lb_gold"), L.t("lb_n_gold", [lobby_r.budget_of(0)])],
				["handicap", L.t("lb_handicap"), L.t("on") if lobby_r.handicap else L.t("off")]]
			if lobby_r.handicap:
				rows.append(["budget_red", L.t("lb_gold_red"), L.t("lb_n_gold", [lobby_r.budget_of(1)])])
			rows.append(["unit_cap", L.t("lb_cap"), L.t("lb_n_units", [lobby_r.unit_cap])])
			rows.append(["type_cap", L.t("lb_type_cap"), L.t("lb_nolimit") if lobby_r.type_cap == 0 else L.t("lb_n_units", [lobby_r.type_cap])])
			_rows_paged(L0, rows)
		1:
			var fr: bool = lobby_r.deploy == "free"
			var rowsd: Array = [["deploy", L.t("lb_deploy"), L.t("lb_deploy_free") if fr else L.t("lb_deploy_grid")]]
			if fr:
				rowsd.append(["spacing", L.t("lb_spacing"), L.t("lb_cells", [lobby_r.spacing / 1000.0])])
				# 全場：雙人沒有縱深（整個戰場）；對 AI 的縱深只管 AI 自己擺多深（Antigravity 實作第 1 輪 #7）
				if lobby_r.fullfield == RuleSet.FULL_NONE:
					rowsd.append(["depth", L.t("lb_depth"), L.t("lb_cells", [lobby_r.depth / 1000.0])])
				elif lobby_kind == "ai":
					rowsd.append(["depth", L.t("lb_depth_ai"), L.t("lb_cells", [lobby_r.depth / 1000.0])])
				rowsd.append(["fullfield", L.t("lb_full_ai") if lobby_kind == "ai" else L.t("lb_full_duel"), L.t("on") if lobby_r.fullfield != 0 else L.t("off")])
			_rows_paged(L0, rowsd)
			var pv_y: float = L0.position.y + rowsd.size() * 66 + 8
			if L0.end.y - pv_y >= 110.0:
				_draw_deploy_preview(Rect2(L0.position.x + 230, pv_y, 360, L0.end.y - pv_y - 8))
				_text(Vector2(L0.position.x, pv_y + 4), L.t("lb_deploy_preview"), tz("S"), TXT_DIM, false, false, 220)
		2:
			_draw_pool_tab(L0)
		3:
			var rows2: Array = [["ticks", L.t("lb_time"), L.t("lb_n_secs", [_secs(lobby_r.ticks)])], ["rounds", L.t("lb_rounds"), _rounds_text(lobby_r.rounds)]]
			if lobby_kind == "duel":
				rows2.append(["place_rule", L.t("lb_place_rule"), _place_text(lobby_r.place_rule)])
				if lobby_r.place_rule == "custom":
					rows2.append(["turns", L.t("lb_turns"), L.t("lb_n_turns", [lobby_r.turns])])
				if lobby_r.place_rule != "blind":
					rows2.append(["carry", L.t("lb_carry"), L.t("on") if lobby_r.carry else L.t("off")])
				rows2.append(["bans", L.t("lb_bans"), L.t("lb_bans_n", [lobby_r.bans])])
			rows2.append(["keep", L.t("lb_keep"), L.t("on") if lobby_r.keep_formation else L.t("off")])
			if lobby_r.deploy == "free":
				rows2.append(["map_mode", L.t("lb_map_mode"), L.t("map_mode_%d" % lobby_r.map_mode)])
			rows2.append(["time_of", L.t("lb_time_of"), L.t("time_of_%d" % lobby_r.time_of)])
			rows2.append(["adj", L.t("lb_adj"), L.t("on") if lobby_r.adj else L.t("off")])   # V1.6 #22（娛樂）；V1.6.1 A7：一律列出，放不下就分頁
			_rows_paged(L0, rows2)
		4:
			_rows(L0, [["ai_level", L.t("lb_ai_level"), L.t(["diff_easy", "diff_normal", "diff_hard"][lobby_r.ai_level])],
				["ai_pool_same", L.t("lb_ai_pool_same"), L.t("on") if lobby_r.ai_pool_same else L.t("off")]])
		5:
			_draw_lab_tab(L0)
		6:
			_draw_cmd_tab(L0)
		7:
			var xr := _ext_rows()
			_rows_paged(L0, xr)
			# 最後一輪（Codex 看圖 #3）：說明放在左欄列表下方的紙片上（右欄在大字級＋差異清單長時會省略說明）
			var xid: String = lobby_item if lobby_item.begins_with("xs_") else "ext"
			var xt := _ext_desc(xid)
			var xy: float = L0.position.y + xr.size() * 66 + 8
			var xh := text_h(xt, tz("S"), L0.size.x - 48) + 24
			if xy + xh <= L0.end.y:
				var xrect := Rect2(L0.position.x, xy, L0.size.x - 10, xh)
				var paper := not bool(Save.s("plain_ui")) and _mat_box(xrect, "card2")
				if not paper:
					draw_rect(xrect, Color(0, 0, 0, 0.3))
				_ink_mode = paper
				_text(xrect.position + Vector2(16, 12), xt, tz("S"), Color.WHITE, false, false, L0.size.x - 48)
				_ink_mode = false
	_draw_lobby_desc(D0)

## V1.6.1 A7：列數超過這一欄放得下的就分頁（底下一列「◀ 1／2 ▶」），每個開關都找得到。
var lobby_rpage := 0
const FOLD_ROWS := 3   # 1.5.0 §1.2：折頁一頁最多 3 列規則（R14 大廳上限 9：頂緣 2＋子分頁 1＋收起／開戰 2＋規則 3＋翻頁 1）
func _rows_paged(R: Rect2, rows: Array) -> void:
	var cap := mini(int(R.size.y / 66.0), FOLD_ROWS + 1)
	if rows.size() <= cap:
		lobby_rpage = 0
		_rows(R, rows)
		return
			if t in types:
				out.append(s)
				break
	return out

func _draw_lobby_desc(R: Rect2) -> void:
	var x := R.position.x + 16
	var w := R.size.x - 32
	var y := R.position.y + 14
	var id: String = lobby_item if lobby_item != "" else ["budget", "deploy", "pool", "ticks", "ai_level", "lab", "cmd_on", "ext"][lobby_tab]
	_text(Vector2(x, y), L.t("lbd_t_" + id), tz("H2"), ACCENT, false, true, w)
	y += tz("H2") * 1.6
	var body := "" if id == "ext" or id.begins_with("xs_") else _ext_desc(id)   # 新技能的說明畫在左欄紙片上
	var bfs := tz("S") if _scale_key() == 100 else tz("C")   # 大字時說明改用註記字級，讓下面的差異清單放得下
	# 先估警告＋差異清單要多高；說明＋清單放不下時省略說明，只留警告與差異（Antigravity 實作第 2 輪）
	var need_h := tz("S") * 2.4 + _lobby_notes_h(w)
	var avail := R.end.y - 60 - y
	if text_h(body, bfs, w) + 12 + need_h <= avail:
		_text(Vector2(x, y), body, bfs, Color(1, 1, 1, 0.88), false, false, w)
		y += text_h(body, bfs, w) + 12
	_badge_pill(Vector2(x, y), Presets.badge(lobby_r, lobby_kind))
	y += tz("S") * 2.4
	_draw_lobby_notes(Rect2(x, y, w, R.end.y - y - 8))   # 1.5.0 §1.2：「重置回標準」拿掉——和頂緣「標準」紙籤是同一件事（R14 折頁每格 ≤9）


## V1.2 C1：選中的預設像夾在筆記本上的書籤，從分頁底下垂進紙頁（紙頁畫完才畫，才不會被蓋住）。
## V1.5.2 L2（A 案）：選中分頁的紅書籤。宿主＝分頁面框 r：本體左 x＝右緣−34、寬 20、上緣貼分頁上緣、
## 下尖端在上緣＋30、中央凹口在上緣＋23。未選分頁不畫（舊的褐色小耳拿掉）。
const BM_SLOT := 42.0   # 分頁文字右側讓給書籤的寬度（書籤 34＋間隔 8；粗體描邊外擴後仍留 6px）

func _draw_bookmark(r: Rect2) -> void:
extends RefCounted
## 字串表（優化方案 I）：data/strings.csv，欄位 key,zh_TW,en。所有畫面文字都從這裡來，不寫死在程式裡。

static var _table := {}
static var lang := "zh_TW"
const LANGS := ["zh_TW", "en", "zh_CN", "ja"]   # V1.4 #17：簡中、日文（AI 翻譯，未經母語校對）
## V1.2.1 G3：資料檔（殘局、章節、試煉、圖鑑）的語言欄位後綴。之後加簡中、日文：這裡加 "zh_CN": "sc"、"ja": "ja"，
## strings.csv 加一欄、資料檔加 *_sc／*_ja 欄位、字型子集加字，程式不用再到處改。
const SUFFIX := {"zh_TW": "zh", "en": "en", "zh_CN": "sc", "ja": "ja"}
static var _extra := {}   # data/l10n_extra.csv：程式裡的二元陣列（成就名、條件、AI 陣型名）其他語言的譯文，以中文原文為鍵

## 中文系（漢字、不用空白分詞、用全形標點）：版面、引號、斷行用。
static func cjk(l := "") -> bool:
	return (lang if l == "" else l) != "en"

## 依目前語言取資料欄位：field(pz, "") → pz["zh"]／pz["en"]；field(pz, "hint") → pz["hint_zh"]／pz["hint_en"]。缺的退回英文、再退回中文。
static func field(d: Dictionary, base: String) -> String:
	var pre := base + "_" if base != "" else ""
	for suf in [SUFFIX.get(lang, "en"), "en", "zh"]:
		if d.has(pre + suf):
			return str(d[pre + suf])
	return ""

## V1.6.1 F6：程式組出來的題目（工坊、出題台、一陣三考）把字串表的四種語言寫進資料欄位，簡中、日文不再退回英文。
static func fill(d: Dictionary, base: String, key: String, args: Array = []) -> void:
	load_table()
	var row: Dictionary = _table.get(key, {})
	var pre := base + "_" if base != "" else ""
	for l in LANGS:
		var s: String = str(row.get(l, ""))
		if s == "":
			s = str(row.get("en", key))
		d[pre + str(SUFFIX[l])] = s % args if not args.is_empty() else s

## 二選一的舊資料（[中文, 英文]）：之後加語言時改成字典。
static func pick(zh, en):
	return pick_for(zh, en, lang)

static func pick_for(zh, en, l: String):
	if l == "zh_TW":
		return zh
	if l == "en":
		return en
	_load_extra()
	var s: String = str(_extra.get(str(zh), {}).get(l, ""))
	return s if s != "" else en

static func _load_extra() -> void:
	if not _extra.is_empty():
		return
	_extra["_"] = {}
	var f := FileAccess.open("res://data/l10n_extra.csv", FileAccess.READ)
	if f == null:
		return
	var header := f.get_csv_line()
	while not f.eof_reached():
		var row := f.get_csv_line()
		if row.size() < header.size() or row[0] == "":
			continue
		var d := {}
		for i in range(1, header.size()):
			d[header[i]] = row[i]
		_extra[row[0]] = d

static func load_table() -> void:
	if not _table.is_empty():
		return
	var f := FileAccess.open("res://data/strings.csv", FileAccess.READ)
	if f == null:
		push_error("strings.csv 讀不到")
		return
	var header := f.get_csv_line()
	while not f.eof_reached():
		var row := f.get_csv_line()
		if row.size() < 3 or row[0] == "":
			continue
		var d := {}
		for i in range(1, mini(header.size(), row.size())):   # 少了後面的語言欄（剛加、還沒跑翻譯）：那幾種語言退回英文
			d[header[i]] = row[i].replace("\\n", "\n")
		_table[row[0]] = d

static func t(key: String, args: Array = []) -> String:
	load_table()
	var d: Dictionary = _table.get(key, {})
	var s: String = d.get(lang, "")
	if s == "":
		s = d.get("en", d.get("zh_TW", key))   # 沒翻到的退回英文
	if s == "":
		s = key
	if args.is_empty():
		return s
	return s % args

## V1.5：某個語言自己的名稱（第一次啟動的語言按鈕要用該語言寫，例如「日本語」）。
static func lang_name_of(l: String) -> String:
	load_table()
	var d: Dictionary = _table.get("lang_name", {})
	var s: String = str(d.get(l, ""))
	return s if s != "" else l

static func has(key: String) -> bool:
	load_table()
	return _table.has(key)

static func keys() -> Array:
	load_table()
	return _table.keys()

## 給字型子集化用：所有語言的所有字。
static func all_text() -> String:
	load_table()
	var s := ""
	for k in _table:
		for l in LANGS:
			s += _table[k].get(l, "")
	return s
