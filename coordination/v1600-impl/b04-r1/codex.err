+	ok(3 - g.lobby_step <= 3, "從打開到開戰最多 3 下 A（第 %d 步起）" % g.lobby_step)
+	# IN-160-01：返回後重開，焦點照樣回到主鈕（不留在舊索引）
+	g._focus = 5
+	g._key(KEY_ESCAPE)
+	ok(g.overlay != "lobby", "大廳 B／Esc 返回")
+	g._open_lobby("ai")
+	ok(g._lb_focus_main, "重開大廳焦點恢復到主鈕")
+	g.free()
