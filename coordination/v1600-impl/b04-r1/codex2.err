   502	
   503	func _badge_pill(p: Vector2, b: String) -> float:
   504		var col: Color = {"cert": Color("#3fbf6a"), "fun": Color("#e8b33a"), "lab": Color("#a46be0")}[b]
   505		var icon: String = {"cert": "◎", "fun": "★", "lab": "◇"}[b]
   506		var lab: String = icon + " " + L.t("lb_badge_" + b)
   507		var fs := tz("S")
   508		var w := maxf(_width(lab, fs, true) + 20.0, _width(lab, fs, true) / 0.86 + 2.0)   # 1.4.0 R12：左右各留 max(10, 寬×6%)
   509		var r := Rect2(p, Vector2(w, maxf(fs * 1.6, label_ink(lab, fs, true).size.y + 10.0)))   # 1.4.0 R12：牌高＝墨跡＋上下各 5
   510		if paper_book:
   511			draw_rect(r, Color(0.93, 0.89, 0.8, 0.6))   # 1.6.0 B04（Hydrogen r1 #1）：簿紙暗一階，認證牌墊一層淺紙底（綠框、字才不發悶）
   512		draw_rect(r, Color(col, 0.22))
   513		# 色盲也分得出：認證＝實線框、娛樂＝虛線框、沙盒＝雙線框
   514		match b:
   515			"cert":
   516				draw_rect(r, col, false, 2.0)
   517			"fun":
   518				var x := r.position.x
   519				while x < r.end.x:
   520					draw_line(Vector2(x, r.position.y), Vector2(minf(x + 6, r.end.x), r.position.y), col, 2.0)
   521					draw_line(Vector2(x, r.end.y), Vector2(minf(x + 6, r.end.x), r.end.y), col, 2.0)
   522					x += 10
   523				draw_line(r.position, Vector2(r.position.x, r.end.y), col, 2.0)
   524				draw_line(Vector2(r.end.x, r.position.y), r.end, col, 2.0)
   525			"lab":
   526				draw_rect(r, col, false, 1.5)
   527				draw_rect(r.grow(-4), col, false, 1.5)
   528		probe_cell_begin(r)   # 1.4.0：認證牌是格子（R11 置中、R12 內距；Codex v140 cat01 #1）
   529		_text(ink_center_p(r, lab, fs, true), lab, fs, Color.WHITE, true, true)
   530		probe_cell_end()
   531		return w
