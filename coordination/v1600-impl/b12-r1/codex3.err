+				pts.append(float(xx))
+	if pts.is_empty():
+		return -999.0
+	return pts.reduce(func(acc, v): return acc + v, 0.0) / pts.size() - (x0 + cx)
+
+## 左右腳分開追蹤（Codex B12 r1 #4：只看雙腳重心，對稱往內滑看不出來）：最低帶的前景像素以重心分左右兩群，各取平均 x
+func _ts_feet_lr(img: Image, o: Vector2, big := false) -> Vector2:
+	var x0 := int(o.x)
+	var y0 := int(o.y)
+	var cw := 154 if big else 74
+	var cx := 79 if big else 39
+	var c0: float = _ts_foot_x(img, o, big)
+	if c0 < -900.0:
+		return Vector2(-999.0, -999.0)
+	var low := -1
+	for yy in range((y0 + (190 if big else 95)), y0 + 20, -1):
+		for xx in range(x0 + 4, mini(x0 + cw, img.get_width())):
+			var c := img.get_pixel(xx, yy)
+			if absf(c.r - 0.5) + absf(c.g - 0.5) + absf(c.b - 0.5) > 0.12:
+				low = yy
+				break
+		if low >= 0:
+			break
+	var ls := 0.0
+	var ln := 0
+	var rs := 0.0
+	var rn := 0
+	for yy in range(low - (9 if big else 5), low + 1):
+		for xx in range(x0 + 4, mini(x0 + cw, img.get_width())):
+			var c := img.get_pixel(xx, yy)
+			if absf(c.r - 0.5) + absf(c.g - 0.5) + absf(c.b - 0.5) > 0.12:
+				if float(xx) - (x0 + cx) < c0:
+					ls += xx
+					ln += 1
+				else:
+					rs += xx
+					rn += 1
+	return Vector2(ls / maxi(1, ln) - (x0 + cx) if ln > 0 else c0, rs / maxi(1, rn) - (x0 + cx) if rn > 0 else c0)
 
 func _draw() -> void:
 	if ts_mode:
@@ -2028,7 +2090,18 @@
 		for e in ts_page:
 			var o: Vector2 = e[5]
 			var st := _ts_state(e[2], e[3], e[4])
-			ts_routes.append(_ts_draw_one(o + Vector2(39, 78), e[0], e[1], st))
+			if bool(e[6]):
+				# 巨獸：和戰鬥同一條路（放大 1.75 倍走向量畫，Art.unit）；不吃南北方向、不插方向過渡（Codex B12 r1 #3）；
+				# 朝向照 _face_of（Codex B12 r1 #1：工具要和戰鬥同一條）
+				var fa0 := 1.0 if e[2] in ["E", "SE"] else (-1.0 if e[2] in ["W", "SW"] else (1.0 if e[3] in ["E", "SE"] else -1.0))
+				var fb0 := 1.0 if e[3] in ["E", "SE"] else (-1.0 if e[3] in ["W", "SW"] else fa0)
+				var fl := lerpf(fa0, fb0, e[4])
+				var fw := 1.0 if fl >= 0.0 else -1.0   # 和戰鬥 _face_of 同一條：巨獸直接換邊（B12）
+				var wk: float = (0.3 + float(e[4]) * 4.0) if (e[2] in ["SE", "SW", "N"] or e[3] in ["SE", "SW", "N"]) else 0.0
+				Art.unit(self, o + Vector2(79, 168), e[0], e[1], fw, wk, 0.0, 0.0, 1.0, 0.0, UNIT_SCALE * BossD.DRAW_SCALE, cbm())
+				ts_routes.append("vector")
+			else:
+				ts_routes.append(_ts_draw_one(o + Vector2(39, 78), e[0], e[1], st))
 		draw_set_transform_matrix(Transform2D.IDENTITY)
 		return
 	if not sil_mode:
--- a/game/tests/suites/battle_visual.gd
+++ b/game/tests/suites/battle_visual.gd
@@ -1439,3 +1439,20 @@
 	var dm: String = FileAccess.get_file_as_string("res://tools/dev_main.gd")
 	var mg: String = FileAccess.get_file_as_string("res://scripts/ui/main.gd")
 	ok(dm.find("func _run_turn_strip(") >= 0 and dm.find("print(\"TURNSTRIP \"") >= 0 and mg.find("\"--turn-strip=\"") >= 0, "連拍工具：--turn-strip（160 組合、缺格、腳滑比）")
+
+## 1.6.0 B12（S3 大型／非人形驗證）：巨獸（石魔底、放大 1.75 倍走向量畫）與召喚物骷髏的剪影＋轉身。
+## 剪影與轉身要真的繪圖：dev_main --sil（sil_report）與 --turn-strip --turn-strip-types=19b,21，數字記 ledger。這裡驗畫法與工具接線。
+func test_large_verify_v1600() -> void:
+	var fs: String = FileAccess.get_file_as_string("res://scripts/ui/units/fantasy.gd")
+	ok(fs.find("var up := 30.0 if (w == 0.0 and walk == 0.0) else 0.0") >= 0, "石魔：純待機時近側拳頭舉過肩（出手、走路一律放下）")
+	ok(fs.find("if back:\n\t\t_skel_bone(ci, w, walk, bone, a)") >= 0, "骷髏：背面時骨棒在身體之前畫（被擋住）")
+	var GS = load("res://scripts/ui/game_screens.gd")
+	var g = GS.new()
+	var bs: String = FileAccess.get_file_as_string("res://scripts/ui/battle/battle_state.gd")
+	ok(bs.find("if u.boss:\n\t\t# 1.6.0 B12：巨獸放大走向量畫") >= 0, "巨獸直接換邊（不壓扁轉身，腳不往中間滑）")
+	ok(FileAccess.get_file_as_string("res://scripts/ui/battle/battle_units.gd").find("if (signf(f0) == tgt_f and absf(f0) >= 0.9) or u.boss:") >= 0, "巨獸出手轉向也直接換邊")
+	g.free()
+	ok(fs.find("rock.lightened(0.28)") >= 0, "石魔：受光的岩頂")
+	ok(fs.find("var ang: float = -0.15 + (w * 0.9 if w < 0.0 else w * 1.0)") >= 0 and fs.find("hand + bdir * 22.0") >= 0, "骷髏：骨棒待機往前平舉、加長")
+	var dm: String = FileAccess.get_file_as_string("res://tools/dev_main.gd")
+	ok(dm.find("--turn-strip-types=") >= 0 and dm.find("不算缺格") >= 0, "連拍工具可指定兵種與巨獸尺寸（巨獸向量畫不算缺格）")
