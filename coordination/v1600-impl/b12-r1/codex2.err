  2052	## 左右腳分開追蹤（Codex B12 r1 #4：只看雙腳重心，對稱往內滑看不出來）：最低帶的前景像素以重心分左右兩群，各取平均 x
  2053	func _ts_feet_lr(img: Image, o: Vector2, big := false) -> Vector2:
  2054		var x0 := int(o.x)
  2055		var y0 := int(o.y)
  2056		var cw := 154 if big else 74
  2057		var cx := 79 if big else 39
  2058		var c0: float = _ts_foot_x(img, o, big)
  2059		if c0 < -900.0:
  2060			return Vector2(-999.0, -999.0)
  2061		var low := -1
  2062		for yy in range((y0 + (190 if big else 95)), y0 + 20, -1):
  2063			for xx in range(x0 + 4, mini(x0 + cw, img.get_width())):
  2064				var c := img.get_pixel(xx, yy)
  2065				if absf(c.r - 0.5) + absf(c.g - 0.5) + absf(c.b - 0.5) > 0.12:
  2066					low = yy
  2067					break
  2068			if low >= 0:
  2069				break
  2070		var ls := 0.0
  2071		var ln := 0
  2072		var rs := 0.0
  2073		var rn := 0
  2074		for yy in range(low - (9 if big else 5), low + 1):
  2075			for xx in range(x0 + 4, mini(x0 + cw, img.get_width())):
  2076				var c := img.get_pixel(xx, yy)
  2077				if absf(c.r - 0.5) + absf(c.g - 0.5) + absf(c.b - 0.5) > 0.12:
  2078					if float(xx) - (x0 + cx) < c0:
  2079						ls += xx
  2080						ln += 1
  2081					else:
  2082						rs += xx
  2083						rn += 1
  2084		return Vector2(ls / maxi(1, ln) - (x0 + cx) if ln > 0 else c0, rs / maxi(1, rn) - (x0 + cx) if rn > 0 else c0)
