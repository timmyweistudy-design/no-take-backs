   517				turn_start_t[u.id] = anim_clock()   # 1.6.0 B11：轉身開始那一刻（預備壓縮從這裡算；展示時鐘）
   518			if f0 != 0.0 and signf(f1) != signf(f0):
   519				turn_t[u.id] = time   # V1.3 A1a：翻面那一刻（腳下揚塵、展開回彈從這裡算）
   520				turn_flip_t[u.id] = anim_clock()   # 1.6.0 B11：同一刻的展示時鐘（落定微彈用）
   521	
   522	## 轉身過場（V1.3 A1a）：像厚木牌俐落翻面，不是紙片等比夾扁。
