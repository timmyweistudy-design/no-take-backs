   527	const TURN_BOUNCE := 0.04
   528	func _face_of(u) -> float:
   529		var f: float = face_now.get(u.id, signf(u.fx) if u.fx != 0 else (1.0 if u.team == 0 else -1.0))
   530		var a := absf(f)
   531		if u.boss:
   532			# 1.6.0 B12：巨獸放大走向量畫，壓扁轉身會把整隻（連腳）夾成一條線、腳往中間滑（連拍量到 0.197）→ 直接換邊（翻面揚塵照舊）
   533			return 1.0 if f >= 0.0 else -1.0
