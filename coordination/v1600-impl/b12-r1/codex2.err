    66		var p1: float = s.power(1) * 100.0 / (s.budget_of(1) * 1000.0)
    67		return absf(p0 - p1) <= 15.0 and ((p0 <= 30.0 and p1 <= 30.0) or (s.alive_count(0) <= 3 and s.alive_count(1) <= 3))
