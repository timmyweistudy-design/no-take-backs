		return _legible_cache[k]
	var out := c
	for i in 12:
		if _wcag(out, INK) >= 5.0:   # 目標 5:1（底色不一定是純描邊色，留餘裕）
			break
		out = out.lightened(0.08)
	_legible_cache[k] = out
	return out

## 對指定底色提亮到 5:1（黑底條上的隊色記號）。
static func _legible_on(c: Color, bg: Color) -> Color:
	var out := c
	for i in 14:
		if _wcag(out, bg) >= 5.0:
			break
		out = out.lightened(0.08)
	return out

static func _wcag(a: Color, b: Color) -> float:
	var f := func(v: float) -> float: return v / 12.92 if v <= 0.04045 else pow((v + 0.055) / 1.055, 2.4)
	var la: float = 0.2126 * f.call(a.r) + 0.7152 * f.call(a.g) + 0.0722 * f.call(a.b)
	var lb: float = 0.2126 * f.call(b.r) + 0.7152 * f.call(b.g) + 0.0722 * f.call(b.b)
	return (maxf(la, lb) + 0.05) / (minf(la, lb) + 0.05)

## V1.2：紙上墨色。灰白字→焦茶墨；亮彩字（金、綠、紅）壓暗成同色系的深色，透明度保留。
## 1.6.0 B03：ink_deep＝桌燈下的暗紙（結果紙 L*≈64）：彩色字再壓深、中間調的彩色（隊色小圖示）也壓，對紙 ≥4.5:1
static var ink_deep := false
static var paper_tone := Color.WHITE   # 1.6.0 B06：全站紙面乘這個色（桌燈下的紙＝PAL.PAPER_DESK_TONE；game_screens._draw 每幀設定）
static func _ink(c: Color) -> Color:
	var lum := c.get_luminance()
	if ink_deep and c.s >= 0.25:
		var a0 := c.a if c.a < 0.45 else maxf(c.a, 0.85)
		if lum >= 0.45:
			return Color(c.darkened(0.82), a0)
		if lum > 0.12:
			return Color(c.darkened(0.5), a0)
	if lum < 0.45:
		return c
	var a := c.a if c.a < 0.45 else maxf(c.a, 0.85)   # V1.2.1 F5：紙上墨字至少 85%；很淡的裝飾（空星）保持淡
	if c.s < 0.25:
		return Color(INK, a)
	return Color(c.darkened(0.74), a)

func _btn(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
	if layout_probe and get("shot_dir") != "" and (get("shot_state") as Dictionary).has("dis"):
		enabled = false   # V1.2.1：版面檢查的「停用」狀態：全部按鈕畫成停用，檢查停用樣式（手把流程不受影響）
	var idx := _btns.size()
	var hit := r
	if btn_hit_min > r.size.y:
		var dh := (btn_hit_min - r.size.y) * 0.5
		hit = r.grow_individual(0.0, dh, 0.0, dh)
		if layout_probe:
			probe_hits.append(hit)
	_btns.append({"r": hit, "cb": action, "en": enabled, "snd": "k_confirm" if primary else ("k_back" if label == L.t("back") or label == L.t("menu") else "k_click"), "group": btn_group})
	var hover := hit.has_point(mouse) and not pad_mode
	var focus := pad_mode and idx == _focus
	var bg := TH_WOOD_L if not primary else TH_PRIMARY
	if tint.a > 0:
		bg = tint
	if not enabled:
		bg = Color(0.2, 0.17, 0.15)
	elif hover or focus:
		bg = bg.lightened(0.16)
		if hover:
			_hover_now = idx
	var pressed := hover and enabled and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
	var rd := r.grow(-minf(r.size.x, r.size.y) * 0.025) if pressed else r
	# V1.2 B3：按鈕下緣 3px 厚度（木牌的側面）；按下時往下沉、厚度消失
	var solid: bool = tint.a <= 0.0 or tint.a > 0.6
	if solid and r.size.y >= 20.0:
		# 厚度畫在按鈕框內（下緣 3px），命中框、探針與畫面一致（Codex v120-impl2）；按下時面板往下壓、厚度被蓋住
		_box(Rect2(rd.position, rd.size), Color(bg.darkened(0.55), 1.0), Color(0, 0, 0, 0), 7.0)
		rd = Rect2(rd.position + Vector2(0, 3.0 if pressed else 0.0), rd.size - Vector2(0, 3))
	var paper_face := btn_paper and enabled and not bool(Save.s("plain_ui"))
	# 1.2.0 §1.3：沒有自訂色的一般按鈕＝山毛櫸木牌（墨色字）；主要按鈕＝朱漆木牌＋左側紅蠟封；停用＝褪色木牌
	var cloth: bool = btn_cloth != "" and not paper_face and not bool(Save.s("plain_ui")) and _ui_tex(MAT[btn_cloth]) != null   # 1.2.0 §1.3 布標分頁
	# 1.2.0 第 4 大類 A10：「木色／選中」兩種標準色的按鈕也走木牌（原本是深色圓角塊，Antigravity cat03 #1）；選中＝暖一點的木牌＋朱砂框（不只靠顏色）。
	# 木色／選中但沒有自己標籤的按鈕（字由呼叫端另外畫白字：技能格、試煉卡、禁用卡、遠征獎勵卡）維持原本深色，避免白字落在淺木牌上（Codex cat04 #1）
	var sel_on: bool = tint == TH_ACTIVE
	var plaque: bool = not cloth and not paper_face and (tint.a <= 0.0 or ((sel_on or tint == TH_WOOD) and label != "")) and not bool(Save.s("plain_ui")) and r.size.y >= 26.0 and _ui_tex(MAT["plaque"]) != null
	last_btn_paper = paper_face or (plaque and not primary and enabled) or (cloth and btn_cloth == "tab_linen" and enabled)
	if layout_probe:
		probe_faces.append([rd, last_btn_paper])   # 實際畫出來的面（不含擴大的點擊區；Codex v1600 B02 #2）；深色鈕也登記（紙上的深色鈕裡白字是對的）
	last_btn_enabled = enabled
	if cloth:
		var ct := Color.WHITE if enabled else Color(0.6, 0.6, 0.6, 0.8)
	for w in 3:
		var pts := PackedVector2Array()
		for k in 9:
			var yy := -k * 7.0
			pts.append(cup + Vector2(-8 + w * 8 + sin(st_t * 1.3 + k * 0.7 + w * 2.1) * (2.0 + k * 0.6), -20 + yy))
		draw_polyline(pts, Color(1, 1, 1, 0.10 + 0.04 * w), 2.0, true)
	# 沙漏（右緣下槽）
	var hg: Vector2 = (slots["clock"] as Rect2).get_center() + Vector2(0, 8)
	_contact_shadow(Rect2(hg + Vector2(-16, 27), Vector2(32, 5)), 2.0)
	draw_rect(Rect2(hg - Vector2(16, 32), Vector2(32, 5)), Color("#7a5434"))
	draw_rect(Rect2(hg + Vector2(-16, 27), Vector2(32, 5)), Color("#7a5434"))
	draw_colored_polygon(PackedVector2Array([hg + Vector2(-12, -27), hg + Vector2(12, -27), hg, hg + Vector2(12, 27), hg + Vector2(-12, 27), hg]), Color(0.85, 0.9, 0.95, 0.22))
	draw_colored_polygon(PackedVector2Array([hg + Vector2(-8, 27), hg + Vector2(8, 27), hg + Vector2(0, 12)]), Color("#d9b874"))

## 1.2.0 §12 老闆的便條：第一次進大廳、擺陣、結果時，跳一張紙卡（手寫字，只放建議、不放數值）；按「知道了」就不再出現。
## 是一個小的模態疊層（overlay＝boss_note），不蓋在按鈕上；截圖、版面檢查平常不跳（乾淨存檔每張都會跳），另拍一張專拍。
var note_key := ""
var note_ret := ""   # 便條疊在哪個疊層上（大廳本身是疊層 "lobby"）；關掉時還原（Codex cat03 #2）
func _boss_note(key: String, host := "") -> void:
	if overlay != host or shot_dir != "" or layout_probe:
		return
	if not preload("res://scripts/game/guide.gd").is_new(Save.data, "note_" + key):
		return
	note_key = key
	note_ret = host
	overlay = "boss_note"
	_focus = 0

## 1.6.0 B06（方案 P1.5、§1 桌位表）：結果頁的老闆便條不再蓋在結果紙上——釘在紙外左下桌緣（`Seats.result_note_rect`），
## 點「打開看」才展開全文（同一個便條疊層，知道了＝記住、之後不再釘）。字放不下時往上撐高（不縮字；英文 150%）。
var note_pin_force := false   # 截圖專拍（平常截圖流程不釘便條）
func _note_pin_shown(key: String) -> bool:
	if overlay != "":
		return false
	return note_pin_force or (shot_dir == "" and not layout_probe and preload("res://scripts/game/guide.gd").is_new(Save.data, "note_" + key))

## 便條的框（紙外左下桌緣，下緣對齊結果紙下緣；字多時往上撐）與字行
func _note_pin_layout() -> Dictionary:
	var R0 := Seats.result_note_rect()
	var pad := 12.0
	var sz := tz("B")
	_hand_mode = true
	var lines := wrap_lines(L.t("bn_pin"), sz, R0.size.x - pad * 2.0)
	_hand_mode = false
	var lh := sz * line_h(lines.size())
	var bh := maxf(40.0, tz("S") * 1.9)
	var h := maxf(R0.size.y, 14.0 + lines.size() * lh + 8.0 + bh + pad)
	var R := Rect2(R0.position.x, R0.end.y - h, R0.size.x, h)
	return {"r": R, "pad": pad, "sz": sz, "lines": lines, "lh": lh, "btn": Rect2(R.position.x + pad, R.end.y - pad - bh, R.size.x - pad * 2.0, bh)}

func _note_pin_open(key: String) -> void:
	note_key = key
	note_ret = ""
	overlay = "boss_note"
	_focus = 0

func _note_pin(key: String) -> void:
	if not _note_pin_shown(key):
		return
	var lay := _note_pin_layout()
	var R: Rect2 = lay["r"]
	probe_panel(R)
	probe_skip("R1", "桌位表固定位置：結果紙外左下桌緣（方案 §1、P1.5），刻意不置中")
	_contact_shadow(R)
	if bool(Save.s("plain_ui")) or not _mat_box(R, "card1"):
		draw_rect(R, PAL.MAT_PAPER[0])
	probe_faces.append([R, true])
	var cx := R.get_center().x
	draw_colored_polygon(PackedVector2Array([Vector2(cx - 30, R.position.y - 7), Vector2(cx + 26, R.position.y - 10),
		Vector2(cx + 28, R.position.y + 7), Vector2(cx - 28, R.position.y + 10)]), Color(0.93, 0.88, 0.7, 0.82))   # 一段紙膠帶
	_ink_mode = true
	_hand_mode = true
	var y := R.position.y + 14.0
	for ln in lay["lines"]:
		_text(Vector2(R.position.x + float(lay["pad"]), y), ln, int(lay["sz"]), INK)
		y += float(lay["lh"])
	_hand_mode = false
	_ink_mode = false
	_btn(lay["btn"], L.t("bn_pin_open"), _note_pin_open.bind(key))

func _close_boss_note() -> void:
	preload("res://scripts/game/guide.gd").see(Save.data, "note_" + note_key)
	Save.save_data()
	overlay = note_ret
	note_ret = ""

func _draw_boss_note() -> void:
	var w := 600.0
	var txt := L.t("bn_" + note_key)
	var sign := "—— " + L.t("ps_name_0")
	var sz := tz("H2")   # 手寫字在小字級會糊成黑體的樣子（Antigravity cat03 #4）→ 用 H2，自己斷行（不走 fit 縮字）
	_hand_mode = true
	var lines := wrap_lines(txt, sz, w - 72)
	_hand_mode = false
	var lh := sz * line_h(lines.size())
	var bh := maxf(44.0, tz("B") * 1.9)
	var P := modal_rect(w, 32.0 + lines.size() * lh + 8.0 + tz("B") * 1.4 + GAP_L + bh + 24.0)
	probe_panel(P)
	draw_rect(Rect2(P.position + Vector2(6, 9), P.size), Color(DIM_INK, 0.45))   # 落影（光源左上）
	if bool(Save.s("plain_ui")) or not _mat_box(P, "card1"):
		draw_rect(P, Color("#f5efe6"))
#!/usr/bin/env python3
"""1.6.0 B03（S2）三代表頁的灰階三階＋盤內不變量測。
用法：PYTHONPATH=../build/pylibnp python3 tools/tone_check.py <新版面輸出夾> [舊版對照夾] [--strip 輸出.png]
  兩個資料夾底下都是 <組合>/<畫面>.png（layout_check 的輸出結構）。
量什麼（L*，CIE 1976，0～100；區域照 scripts/ui/table_seats.gd 的桌位表）：
  桌：右緣桌面（上槽與中槽之間的空桌） ≤25
  紙：結果紙中段、擺陣盤面中段（「中階紙與盤」） 35～65
  主層：主鈕（開戰、下一局）只列數值（主層看「亮或高對比實心」，紅漆鈕靠對比不靠亮度）
  盤內不變：同固定時鐘的舊截圖，盤面內逐像素比（擺陣頁遮掉 1.5.0 吊在盤上的敵情翻牌）；差異像素 0＝ΔE 0
--strip：左舊｜中新｜右新灰階的三頁流程條（並列審片用）。
最後一行：TONE OK／TONE FAIL <理由>。"""
import os, sys
import numpy as np
from PIL import Image

PAGES = {
    "01_title.png": {"desk": (20, 640, 40, 100), "paper": (560, 350, 160, 100)},        # 標題：左下桌角；中階＝示範棋盤（標題的木牌是主層鈕）
    "02_place.png": {"desk": (1186, 232, 88, 120), "paper": (300, 300, 300, 200), "main": (960, 700, 280, 28), "board": True},
    "05_result.png": {"desk": (1186, 232, 88, 120), "paper": (240, 300, 260, 60), "main": (330, 660, 200, 22)},
}
BOARD = (150, 120, 980, 530)   # 盤面內側（戰鬥是桌邊視角，盤緣幾列會露出桌面，取內側）
OLD_TAG = (760, 90, 400, 110)   # 1.5.0 吊在盤右上的翻牌（含吊繩；英文 150% 兩行更寬更高）

def lstar(a):
    a = a.astype(float) / 255.0
    lin = np.where(a <= 0.04045, a / 12.92, ((a + 0.055) / 1.055) ** 2.4)
    y = lin @ np.array([0.2126, 0.7152, 0.0722])
    return np.where(y > 0.008856, 116 * np.cbrt(y) - 16, 903.3 * y)

NOISE = 3   # 容許 ≤3/255：同一份程式固定時鐘重拍兩次逐像素完全一致（差 0）；1.5→1.6 盤內有 236 點差 2/255（ΔE<1、看不出，來源未查明，B03 ledger）

def contrast(c1, c2):
    def rl(c):
        c = np.asarray(c, float) / 255.0
        lin = np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)
        return float(lin @ np.array([0.2126, 0.7152, 0.0722]))
    a, b = rl(c1), rl(c2)
    return (max(a, b) + 0.05) / (min(a, b) + 0.05)

def crop(a, r):
    x, y, w, h = r
    return a[y:y + h, x:x + w]

def main():
    args = [x for i, x in enumerate(sys.argv[1:], 1) if not x.startswith("--") and sys.argv[i - 1] not in ("--expect",)]
    strip = sys.argv[sys.argv.index("--strip") + 1] if "--strip" in sys.argv else ""
    if strip in args:
        args.remove(strip)
    new = args[0]
    old = args[1] if len(args) > 1 else ""
    fails = []
    rows = []
    combos = sorted(c for c in os.listdir(new) if os.path.isdir(os.path.join(new, c)))
    if not combos:
        fails.append("沒有任何組合（輸出夾是空的）")
    # 組合要齊：--expect N＝至少 N 組（全量驗收給 24）；對照夾有的組合新版一定要有（Codex B03 r2 #1）
    if "--expect" in sys.argv:
        n_exp = int(sys.argv[sys.argv.index("--expect") + 1])
        if len(combos) < n_exp:
            fails.append("組合只有 %d 組（要 %d）" % (len(combos), n_exp))
    if old:
        olds = sorted(c for c in os.listdir(old) if os.path.isdir(os.path.join(old, c)))
        if not olds:
            fails.append("對照夾是空的")
        for c in olds:
            if c not in combos:
                fails.append("對照有 %s、新版沒有" % c)
    for combo in combos:
        for page, zones in PAGES.items():
            p = os.path.join(new, combo, page)
            if not os.path.isfile(p):
                fails.append("%s 缺 %s" % (combo, page))   # 缺頁＝失敗（Codex B03 r1 #4）
                continue
            a = np.asarray(Image.open(p).convert("RGB"))
            L = lstar(a)
            d = float(np.median(crop(L, zones["desk"])))
            pp = float(np.median(crop(L, zones["paper"])))
            line = "%s %s 桌 %.1f 紙 %.1f" % (combo, page, d, pp)
            if "main" in zones:
                # 主層：紅漆主鈕靠對比不靠亮度——主鈕中位色對旁邊桌面的對比 ≥3:1（Codex B03 r1 #5）
                mc = np.median(crop(a, zones["main"]).reshape(-1, 3), axis=0)
                dc = np.median(crop(a, zones["desk"]).reshape(-1, 3), axis=0)
                cr = contrast(mc, dc)
                line += " 主鈕 L*%.1f 對桌 %.1f:1" % (float(np.median(crop(L, zones["main"]))), cr)
                if cr < 3.0:
                    fails.append("%s/%s 主鈕對桌 %.1f<3" % (combo, page, cr))
            if d > 25.0:
                fails.append("%s/%s 桌 %.1f>25" % (combo, page, d))
            if not (35.0 <= pp <= 65.0) and "plain" not in combo:
                fails.append("%s/%s 紙 %.1f 不在 35～65" % (combo, page, pp))
            if old and zones.get("board"):
                for name in (page, "03_battle.png"):
                    bp, np_ = os.path.join(old, combo, name), os.path.join(new, combo, name)
                    if not os.path.isfile(bp):
                        if os.path.isdir(os.path.join(old, combo)):
                            line += " ｜對照缺 %s（不比）" % name   # 對照本身沒有這張：照實列出，不算過也不算錯
                        continue
                    if not os.path.isfile(np_):
                        fails.append("%s 新版缺 %s（對照有）" % (combo, name))   # 有對照就一定要比到
                        continue
                    b0 = np.asarray(Image.open(bp).convert("RGB")).astype(int)
                    b1 = np.asarray(Image.open(np_).convert("RGB")).astype(int)
                    sd = b1 - b0
                    keep = np.ones(sd.shape[:2], bool)
                    if name == "02_place.png":
                        x, y, w, h = OLD_TAG
                        keep[y:y + h, x:x + w] = False
                    full = (np.abs(sd).max(axis=2) > NOISE) & keep
                    n = int(crop(full, BOARD).sum())
                    # 整盤偏色：每點都 ≤NOISE 但整片往同一方向偏（例如半透明壓暗蓋到盤上），平均有號差 ≥0.5 就算（Codex B03 r1 #5）
                    shift = float(np.abs(crop(sd, BOARD)[crop(keep, BOARD)].mean(axis=0)).max())
                    line += " ｜盤內差 %s %d px、平均偏 %.2f" % (name, n, shift)
                    if n or shift >= 0.5:
                        fails.append("%s/%s 盤內差 %d px、平均偏 %.2f" % (combo, name, n, shift))
            rows.append(line)
    for r in rows:
        print(r)
    if strip and old:
        tiles = []
        for page in PAGES:
            q, n2 = os.path.join(old, "zh_TW_100", page), os.path.join(new, "zh_TW_100", page)
            if os.path.isfile(q) and os.path.isfile(n2):
                a0 = Image.open(q).convert("RGB").resize((640, 400))
                a1 = Image.open(n2).convert("RGB").resize((640, 400))
                tiles.append([a0, a1, a1.convert("L").convert("RGB")])
        if tiles:
            W = Image.new("RGB", (1920, 400 * len(tiles)))
            for i, t in enumerate(tiles):
                for j, im in enumerate(t):
                    W.paste(im, (640 * j, 400 * i))
            W.save(strip)
            print("流程條", strip)
    print("TONE OK" if not fails else "TONE FAIL " + "；".join(fails[:8]) + ("…共 %d 筆" % len(fails) if len(fails) > 8 else ""))
    sys.exit(1 if fails else 0)

if __name__ == "__main__":
    main()

