   376		## 河裡的空格且上下有河、左右沒有＝橋（和鋪木板的條件同一份）
   377		func _bridge(c: int, r: int) -> bool:
   378			if _cell(c, r) != t.FREE:
   379				return false
   380			var left := false
   381			var right := false
   382			for dx in range(1, 5):
   383				left = left or _cell(c - dx, r) == t.BLOCK
   384				right = right or _cell(c + dx, r) == t.BLOCK
   385			var above := false
