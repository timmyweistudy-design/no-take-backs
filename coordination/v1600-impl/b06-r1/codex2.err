    16	def lstar(a):
    17	    a = a.astype(float) / 255.0
    18	    lin = np.where(a <= 0.04045, a / 12.92, ((a + 0.055) / 1.055) ** 2.4)
    19	    y = lin @ np.array([0.2126, 0.7152, 0.0722])
    20	    return np.where(y > 0.008856, 116 * np.cbrt(y) - 16, 903.3 * y)
    21	
    22	def owners():
    23	    here = os.path.dirname(os.path.abspath(__file__))
    24	    out = os.path.join(here, "..", "..", "build", "tmp", "screen_owner.md")
    25	    subprocess.run([sys.executable, os.path.join(here, "screen_owner.py"), out], check=True, stdout=subprocess.DEVNULL)
    26	    own = {}
    27	    for ln in open(out, encoding="utf-8"):
    28	        m = re.match(r"\| `([^`]+)` \| [^|]* \| (\S+) \|", ln)
    29	        if m:
    30	            own[m.group(1)] = m.group(2)
    31	    return own
    32	
    33	def main():
    34	    old, new = sys.argv[1], sys.argv[2]
    35	    own = owners()
    36	    fails, rows = [], []
    37	    for f in sorted(os.listdir(new)):
    38	        if not f.endswith(".png") or not os.path.exists(os.path.join(old, f)):
    39	            continue
    40	        a = np.asarray(Image.open(os.path.join(old, f)).convert("RGB"))[::2, ::2]
    41	        b = np.asarray(Image.open(os.path.join(new, f)).convert("RGB"))[::2, ::2]
    42	        if a.shape != b.shape:
    43	            continue
    44	        La = lstar(a)
    45	        ch = a.max(axis=2).astype(int) - a.min(axis=2).astype(int)
    46	        m = (La > 72) & (ch < 60)
    47	        frac = m.mean()
    48	        if frac < 0.03:
    49	            continue
    50	        med = float(np.median(lstar(b)[m]))
    51	        n = f[:-4]
    52	        o = own.get(n, "?")
    53	        if TERRAIN.match(n):
    54	            continue   # 地形頁：亮的是雪地盤面
    55	        bad = o == "B06" and not (35.0 <= med <= HI)
    56	        rows.append((o, n, frac, float(np.median(La[m])), med, bad))
    57	        if bad:
    58	            fails.append(f"{n} 紙 L* {med:.1f}")
    59	    for o, n, fr, ma, mb, bad in rows:
    60	        print(f"{'✗' if bad else ' '} {o:4s} {n:34s} 紙 {fr*100:4.1f}%  L* {ma:5.1f} → {mb:5.1f}")
    61	    b06 = [r for r in rows if r[0] == "B06"]
    62	    print(("PAPER OK" if not fails else "PAPER FAIL " + "、".join(fails)) + f"（B06 紙頁 {len(b06)} 頁，中位數 {np.median([r[4] for r in b06]) if b06 else 0:.1f}；量了 {len(rows)} 頁）")
    63	    sys.exit(1 if fails else 0)
    64	
    65	if __name__ == "__main__":
    66	    main()
