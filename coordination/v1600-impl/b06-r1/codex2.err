						draw_line(fr.position, Vector2(fr.end.x, fr.position.y), Color(0, 0, 0, 0.45), 1.5)          # 頂面轉立面的暗線
						draw_line(Vector2(fr.position.x, fr.end.y - 0.5), Vector2(fr.end.x, fr.end.y - 0.5), Color(0.04, 0.03, 0.02, 0.6), 1.0)   # 貼地暗線
						if e_free:
