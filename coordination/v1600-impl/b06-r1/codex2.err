#!/usr/bin/env python3
"""1.6.0 B06（方案 P1.3；Codex B06 r1 #5）：全站紙頁的實圖灰階量測。
舊版截圖裡的「亮紙」像素（L*>72、低彩度）＝紙面遮罩；量新版同位置的 L* 中位數。
B06 負責的頁（tools/screen_owner.py 歸屬）紙面佔畫面 ≥3% 的，中位數要在 35～72；其他批次的頁只列出。地形頁（雪地盤面不是紙）不算。
門檻 72 而不是方案的 65（偏差，B06 ledger）：貼圖紙有明暗起伏（約 ±7），墨字要 4.5:1 紙最暗處得 ≥L*53，中位數壓到 65 暗斑上的字就不夠；
方案的 35～65 仍由 tone_check 在三代表頁的紙面中段量。
文字對比不在這裡量：版面檢查逐頁逐組在真實截圖取樣（24 組 0 違規＝紙上字全部 ≥4.5:1）。
用法：PYTHONPATH=../build/pylibnp python3 tools/paper_tone.py <舊組合夾> <新組合夾>   最後一行 PAPER OK／PAPER FAIL"""
import os, sys, re, subprocess
import numpy as np
from PIL import Image

HI = 72.0
TERRAIN = re.compile(r"^(5[0-6]_map_|82_place_terrain|87_battle_terrain|87b_quarry|87c_quarry|87d_boss|v120_07_editor_map)")

def lstar(a):
    a = a.astype(float) / 255.0
    lin = np.where(a <= 0.04045, a / 12.92, ((a + 0.055) / 1.055) ** 2.4)
    y = lin @ np.array([0.2126, 0.7152, 0.0722])
    return np.where(y > 0.008856, 116 * np.cbrt(y) - 16, 903.3 * y)

def owners():
    here = os.path.dirname(os.path.abspath(__file__))
    out = os.path.join(here, "..", "..", "build", "tmp", "screen_owner.md")
    subprocess.run([sys.executable, os.path.join(here, "screen_owner.py"), out], check=True, stdout=subprocess.DEVNULL)
    own = {}
    for ln in open(out, encoding="utf-8"):
        m = re.match(r"\| `([^`]+)` \| [^|]* \| (\S+) \|", ln)
        if m:
            own[m.group(1)] = m.group(2)
    return own

def main():
    old, new = sys.argv[1], sys.argv[2]
    own = owners()
    fails, rows = [], []
    for f in sorted(os.listdir(new)):
        if not f.endswith(".png") or not os.path.exists(os.path.join(old, f)):
            continue
        a = np.asarray(Image.open(os.path.join(old, f)).convert("RGB"))[::2, ::2]
        b = np.asarray(Image.open(os.path.join(new, f)).convert("RGB"))[::2, ::2]
        if a.shape != b.shape:
            continue
        La = lstar(a)
        ch = a.max(axis=2).astype(int) - a.min(axis=2).astype(int)
        m = (La > 72) & (ch < 60)
        frac = m.mean()
        if frac < 0.03:
            continue
        med = float(np.median(lstar(b)[m]))
        n = f[:-4]
        o = own.get(n, "?")
        if TERRAIN.match(n):
            continue   # 地形頁：亮的是雪地盤面
        bad = o == "B06" and not (35.0 <= med <= HI)
        rows.append((o, n, frac, float(np.median(La[m])), med, bad))
        if bad:
            fails.append(f"{n} 紙 L* {med:.1f}")
    for o, n, fr, ma, mb, bad in rows:
        print(f"{'✗' if bad else ' '} {o:4s} {n:34s} 紙 {fr*100:4.1f}%  L* {ma:5.1f} → {mb:5.1f}")
    b06 = [r for r in rows if r[0] == "B06"]
    print(("PAPER OK" if not fails else "PAPER FAIL " + "、".join(fails)) + f"（B06 紙頁 {len(b06)} 頁，中位數 {np.median([r[4] for r in b06]) if b06 else 0:.1f}；量了 {len(rows)} 頁）")
    sys.exit(1 if fails else 0)

if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""1.6.0 B06：200 畫面批次歸屬表（方案 §5「六把尺全站覆蓋」）。
依 tools/screens.json 的 entry（入口）與檔名逐頁歸屬；每頁一定要有主批次，沒有＝非零結束（新畫面登記時要補規則）。
用法：python3 tools/screen_owner.py [輸出.md]"""
import json, os, re, sys

HERE = os.path.dirname(os.path.abspath(__file__))
B03_DONE = {"01_title", "02_place", "05_result"}   # S2 三代表頁
B07_EN = {"08f_settings_controls", "23_lobby_pool", "58_trials", "89_trials_p2", "10_codex", "60_reward", "01_title"}   # 方案 P2.3 英文 150% 重災頁
# (樣式, 主批次, 說明)；依序比對 entry，再比檔名；第一個中的算
RULES = [
    (r"開發用", "—", "開發用展示頁（不上架；只要 24 組 0 違規）"),
    (r"^標題→卡片面板|第一次開遊戲|^標題$|試玩版結束|主畫面", "B05", "第一幕：首開便條、卡片面板主牌"),
    (r"放大鏡", "B08", "放大鏡進槽、戰鬥 HUD"),
    (r"大廳|^雙人(→禁牌)?$", "B04", "大廳挑戰簿、木撥片"),
    (r"宣紙戰報|棋譜本", "B16", "宣紙戰報＋棋譜本"),
    (r"覆盤|時光機", "B15", "覆盤帳本"),
    (r"出題台|競猜", "B21", "舊器物精修"),
    (r"^戰鬥|^對戰|重播|手動技能|謝幕|^奇幻", "B08", "混戰可讀、戰鬥 HUD（桌面與盤外已在 B03／B06）"),
    # B06 明確清單（Codex B06 r1 #3：不用萬用規則——新入口沒列在任何一條＝失敗，登記時要決定歸屬）
    (r"^(結果|設定|圖鑑|戰績|宿敵|殘局|主題試煉|試煉第|遠征|遊戲間|擺陣|自由排兵|自由部署|軍令時間軸|雙人盲擺|確認窗|離開確認|代碼|回報分類|"
     r"塗裝室|實驗簿|接力殘局|合作接力|教練|新玩法導覽|極速賽|一陣三考|裂隙|每日挑戰)", "B06", "全站同一張桌：紙面灰階、接觸影、盤外桌面"),
]
TERRAIN = re.compile(r"^(5[0-6]_map_|82_place_terrain|87_battle_terrain|87b_quarry|87c_quarry|87d_boss|v120_07_editor_map)")

def owner(name: str, entry: str):
    if name in B03_DONE:
        return "B03", "代表頁（S2 已做）"
    if TERRAIN.match(name):
        return "B06", "地形微縮（P1.4）" + ("；戰鬥 HUD 屬 B08" if "battle" in name else "")
    for pat, b, why in RULES:
        if re.search(pat, entry):
            return b, why
    return None, ""

def main():
    d = json.load(open(os.path.join(HERE, "screens.json"), encoding="utf-8"))
    rows, miss, cnt = [], [], {}
    for fn, v in d.items():
        name = fn[:-4]
        b, why = owner(name, v.get("entry", ""))
        if b is None:
            miss.append(name)
            continue
        extra = "；英文 150% 改寫屬 B07" if name in B07_EN else ""
        cnt[b] = cnt.get(b, 0) + 1
        rows.append(f"| `{name}` | {v.get('entry','')} | {b} | {why}{extra} |")
    out = ["# 1.6.0 畫面批次歸屬表（`tools/screen_owner.py` 產生，勿手改）", "",
           "方案 §5：200 畫面逐頁歸屬。主批次＝這一頁的桌面、材質、版面由哪一批負責；B06 以外的頁在 B06 只保證不退步（24 組 0、固定時鐘容差內）。", "",
           "合計：" + "、".join(f"{k} {cnt[k]}" for k in sorted(cnt)) + f"（共 {sum(cnt.values())}）", "",
           "| 畫面 | 入口 | 主批次 | 說明 |", "|---|---|---|---|"] + rows
    if len(sys.argv) > 1:
        open(sys.argv[1], "w", encoding="utf-8").write("\n".join(out) + "\n")
    if miss:
        print("SCREEN_OWNER FAIL 沒有歸屬：" + "、".join(miss))
        sys.exit(1)
    print(f"SCREEN_OWNER OK {sum(cnt.values())} 頁：" + "、".join(f"{k} {cnt[k]}" for k in sorted(cnt)))

if __name__ == "__main__":
    main()
coordination/v1600-impl/b06-r1/codex-prompt2.md:2:B06。第 1 輪意見 coordination/v1600-impl/b06-r1/codex.md（有條件，5 條）；新的完整差異 coordination/v1600-impl/b06-r1/diff2.patch。
coordination/v1600-impl/b06-r1/codex-prompt2.md:3:改了：①`map_art` 落影抽成 `shadow_south`／`shadow_east`（東南格是牆就裁掉右偏的 3px）；測試拿全部真實地圖×三種大小×兩種視角驗「影子不碰任何牆格」，另加人造地形驗裁切（拿掉裁切會紅，已實測）。南影深 7／12 是 1.2.0 起的既有值，只改了方向；新加的影 ≤4px。②凹槽（河、岩漿）北緣內影正上方視角也畫（自己格內、較淡）。③歸屬表拿掉萬用規則，B06 改明確入口清單；未知入口＝失敗（已實測）。④便條：單元測試加手把 A 路徑；另在截圖流程裡真畫（`dev_main._note_pin_walk`）：按鈕由繪製登記、十字鍵從結果頁走到「打開看」、A 開、B 關，印 NOTEPIN，驗收鏈要 24 組都 OK。⑤`tools/paper_tone.py`：用舊截圖的亮紙遮罩量新版同位置 L*，B06 紙頁中位數 35～72（偏差：貼圖紙起伏約 ±7，墨字 4.5:1 要最暗處 ≥L*53；三代表頁仍 tone_check 35～65）；繁中 100% 26 頁中位數 68.0。文字對比由版面檢查在 24 組真實截圖逐字取樣。單組全量時抓到 4 筆對比不足（擺陣敵情紙卡、輪抽「你的／電腦的」），改走深墨後 0。
coordination/v1600-impl/b06-r1/codex.md:7:5. [ui.gd:2819](/mnt/c/Users/timmy/projects/no-take-backs/game/tests/suites/ui.gd:2819)：對比只驗假定純色；tone_check 僅三頁，不能證明全站紋理暗處合格。須補 B06 紙頁實圖量測。
