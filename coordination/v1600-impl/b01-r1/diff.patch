+func test_session_contract_tower_v1600() -> void:
+	var T = load("res://scripts/game/tower.gd")
+	var settled := {"done": false}
+	session_contract("無盡塔", {
+		"start": func(): return {"run": 3, "spec": T.spec(3)},
