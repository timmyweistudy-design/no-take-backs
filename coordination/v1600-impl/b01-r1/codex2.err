static var pending := {}
## 只給測試用：接下來幾次寫入要假裝失敗（"tmp"＝寫暫存失敗；"rotate"＝輪替備份失敗）。
static var fail_inject := {}

static func load_all() -> void:
	pending = {}
	settings = sanitize_settings(_read(_sp(), {}).get("value", {}))
	var r := _read(_dp(), {})
	data_source = r["source"]
	var raw: Dictionary = r["value"]
	data_locked = schema_of(raw) > SAVE_VERSION
	# 未來版存檔：記憶體用全新進度，檔案完全不碰（Codex plan7 R5）
	data = migrate({}) if data_locked else migrate(raw)   # 先讀原始內容再遷移（遷移裡才補預設值），不然舊檔會被當成新版（Codex 收尾輪 #1）

## 檔名前綴：測試／截圖的 prefix 在前；試玩版另外一份，進度不帶進正式版（N1、§18-4）。
static func file_prefix(demo := OS.has_feature("demo")) -> String:
	return prefix + ("demo_" if demo else "")

static func _sp() -> String:
	return "user://%ssettings.json" % file_prefix()

static func _dp() -> String:
	return "user://%ssave.json" % file_prefix()

## 讀一個 JSON 檔；內容不是物件就回傳 null。
static func _parse(path: String):
	var j := JSON.new()   # 不用 JSON.parse_string：壞檔是預期情況，不該在日誌印 ERROR
	if j.parse(FileAccess.get_file_as_string(path)) != OK:
		return null
	return j.data if typeof(j.data) == TYPE_DICTIONARY else null

extends RefCounted

## 測試共用（第七輪 I1）：斷言、常數、輔助函式。各主題的測試在 tests/suites/。



var runner = null   # run_tests.gd（框架測試要用）

const D = preload("res://scripts/core/unit_defs.gd")

const Army = preload("res://scripts/core/army.gd")

const Sim = preload("res://scripts/core/battle_sim.gd")

const AI = preload("res://scripts/core/ai_army.gd")

const TP = preload("res://scripts/core/turn_placement.gd")

const MC = preload("res://scripts/core/mirror_check.gd")

const PZ = preload("res://scripts/game/puzzles.gd")

const CX = preload("res://scripts/game/codex.gd")

const BV = preload("res://scripts/ui/battle_view.gd")

const F = preload("res://scripts/core/formations.gd")

const EVS = preload("res://scripts/core/events.gd")

const Art = preload("res://scripts/ui/art.gd")

var passed := 0

var failed := 0

func ok(cond: bool, name: String, extra := "") -> void:
	if cond:
		passed += 1
		print("PASS ", name)
	else:
		failed += 1
		print("FAIL ", name, "  ", extra)

func army_from(team: int, spec: Array):
    33	    "scripts/ui/battle/battle_units.gd": ["戰鬥", "重播", "擺陣"],
    34	    "scripts/ui/battle/battle_fx.gd": ["戰鬥", "重播"],
    35	    "scripts/ui/battle/battle_state.gd": ["戰鬥", "重播"],
    36	}
    37	QUIET = ("tests/", "../docs/", "docs/", "../coordination/", "coordination/", "tools/affected_shots.py")
    38	
    39	def changed(rng):
    40	    out = subprocess.run(["git", "diff", "--name-only", rng], cwd=ROOT, capture_output=True, text=True).stdout.split()
    41	    out += subprocess.run(["git", "ls-files", "--others", "--exclude-standard", "--full-name"], cwd=ROOT, capture_output=True, text=True).stdout.split()
    42	    return sorted(set(f[len("game/"):] if f.startswith("game/") else "../" + f for f in out))
    43	
    44	def decide(files, screens):
    45	    shots = set()
    46	    for f in files:
    47	        if f.startswith(QUIET) or f.endswith((".md", ".txt")) and not f.startswith("data/"):
    48	            continue
    49	        for pre, why in FULL:
    50	            if f.startswith(pre):
    51	                return "FULL", "%s（%s）" % (why, f)
    52	        if f in ENTRY:
    53	            keys = ENTRY[f]
    54	            for n, v in screens.items():
    55	                e = v.get("entry", "")
    56	                if any(e.startswith(k) for k in keys):
    57	                    shots.add(n)
    58	            # 沒被任何對照表認領的畫面（入口名不在表裡）也一起拍——依賴不明就擴大（Codex v1600 B01 #2）
    59	            allk = [k for ks in ENTRY.values() for k in ks]
    60	            for n, v in screens.items():
    61	                if not any(v.get("entry", "").startswith(k) for k in allk):
    62	                    shots.add(n)
    63	            continue
    64	        if f.startswith(("scripts/", "tools/", "../tools/")) and f.endswith((".gd", ".py", ".sh")):
    65	            if f.startswith("tools/") and not f.endswith(".gd"):
    66	                continue   # 其他工具腳本不影響畫面
    67	            return "FULL", "依賴不明（%s）" % f
    68	    return "LIST", sorted(shots)
    69	
    70	if __name__ == "__main__":
    71	    rng = sys.argv[1] if len(sys.argv) > 1 else "HEAD"
    72	    screens = json.load(open(os.path.join(ROOT, "tools/screens.json"), encoding="utf-8"))
    73	    kind, v = decide(changed(rng), screens)
    74	    if kind == "FULL":
    75	        print("AFFECTED FULL", v)
    76	    else:
    77	        print("AFFECTED %d %s" % (len(v), ",".join(v)))
