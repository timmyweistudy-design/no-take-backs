   310	## 1.6.0 B01（方案 §3.1）：會話邊界測試範本。新玩法（塔分岔、茶局、情報、棋課）都用它。
   311	## 一個會話＝開局 → 承諾（寫進存檔）→ 戰鬥 → 結算（只一次）→ 續玩 → 回退。範本檢查：
   312	##   ① 承諾後「重啟」（存檔來回序列化＋sanitize）狀態不變、不重抽；② 結算兩次＝第二次不改任何東西；
   313	##   ③ 壞資料（亂型別、缺欄、負數、超大）讀回＝安全預設，不當掉；④ 舊版樣本原樣讀回。
   314	## s 是字典：start() -> 狀態、commit(狀態) -> 存檔字典、restart(存檔字典) -> 狀態、settle(狀態) -> [新狀態, 是否有變]、
   315	## same(a, b) -> bool、bad_inputs: Array、sanitize(v) -> 狀態、old_samples: Array of [存檔字典, 期望狀態]
   316	func session_contract(name: String, s: Dictionary) -> void:
   317		var st0 = s["start"].call()
   318		var saved: Dictionary = s["commit"].call(st0)
   319		var round_trip = JSON.parse_string(JSON.stringify(saved))   # 模擬寫檔再讀回（整數會變浮點，sanitize 要處理）
   320		var st1 = s["restart"].call(round_trip)
   321		ok(bool(s["same"].call(st0, st1)), name + "：承諾後重啟，狀態不變（不重抽）")
   322		var r1: Array = s["settle"].call(st1)
   323		var r2: Array = s["settle"].call(r1[0])
   324		ok(bool(r1[1]) and not bool(r2[1]) and bool(s["same"].call(r1[0], r2[0])), name + "：結算只生效一次（第二次不改狀態快照）")
   325		for b in s.get("bad_inputs", []):
   326			var v = s["sanitize"].call(b)
   327			ok(v != null, name + "：壞資料讀回不當掉（%s）" % str(b))
   328		for pair in s.get("old_samples", []):
   329			ok(bool(s["same"].call(s["restart"].call(pair[0]), pair[1])), name + "：舊版樣本原樣讀回")
