var tower_on := false
var tower_floor := 1
var tower_result := -1   # 這一層的正式結算（-1＝還沒、0＝過、1＝沒過）；結果頁的按鈕只看它（覆盤改陣贏了不能跳層，Codex cat11 #2）

## 結果頁的無盡塔按鈕：照正式結算，不照畫面上這一場（覆盤、重播）→ [文字鍵, 下一次的層]
static func tower_button(result: int, floor_no: int) -> Array:
	if result == 0:
		return ["tw_next", floor_no + 1]
	if result == 1:
		return ["tw_again", 1]
	return []

## 遠征牌上的入口：有進行中的塔就從那一層繼續（回標題也保留，方案 §11.11）
func _tower_open() -> void:
	var run := int(Save.data.get("tower_run", 0))
	if run > 1:
		_toast(L.t("tw_resume", [run]))
	_tower_start(maxi(1, run))

func _tower_start(floor_no: int) -> void:
	if _demo():
		_toast(L.t("demo_locked"), true)
		return
	var sp: Dictionary = Tower.spec(floor_no)
	var r = Tower.make_rules(sp, RS.mask(false))
	if not r.validate().is_empty():
		_toast(L.t("ch_bad"), true)   # 規則不合法＝提示並回第 1 層（方案 §11.11）
		if floor_no > 1:
			Save.data["tower_run"] = 0
			_tower_start(1)
		return
	set("daily_spec", {})        # 從每日挑戰／每日練習直接進塔：不帶每日狀態（不記每日紀錄、不跳過塔結算，Codex cat11 #1）
	set("daily_practice", false)
	rules = r
	challenge_army = Tower.enemy(sp, r)   # 這一層固定的敵陣（走挑戰碼那條路）
	overlay = ""
	_start_mode(Mode.VS_AI)
	tower_on = true
	tower_floor = int(sp["floor"])
	tower_result = -1
	Save.data["tower_run"] = tower_floor
	Save.save_data()   # 續局寫進存檔（中途關遊戲也從這一層繼續，Codex cat11 #3）
	_toast(L.t("tw_head", [tower_floor, L.t("daily_mut_%d" % int(sp["mut"]))]))

func _tower_finish(w: int) -> void:
	if not tower_on or mode != Mode.VS_AI or play_kind != "official":
		return
	var best := int(Save.data.get("tower_best", 0))
	Save.data["tower_run"] = Tower.next_run(int(Save.data.get("tower_run", 0)), tower_floor, w == 0)
	tower_result = 0 if w == 0 else 1
	if w == 0:
		var r: Array = Tower.record(best, tower_floor)
		Save.data["tower_best"] = r[0]
		_toast(L.t("tw_floor_clear", [tower_floor]))
	else:
		_toast(L.t("tw_over", [tower_floor, best]))
extends RefCounted
## 1.4.0 §11.1（1.3.0 延伸、stash 補完）：無盡塔——一路往上打，每層一種突變（沿用每日挑戰的 8 種）、地圖與 AI 性格輪換，
## 敵方預算每層多一點（上限 +60）；輸一場就結束，記最高層數（本機）。每層的規則與敵陣只由層數決定（固定種子、跨機器一樣）。
const Daily = preload("res://scripts/game/daily.gd")
const AI = preload("res://scripts/core/ai_army.gd")
const BONUS_STEP := 4     # 每層敵方多 4 金
const BONUS_MAX := 60

static func spec(floor_no: int) -> Dictionary:
	var f := maxi(1, floor_no)
	var mut := posmod(f - 1, Daily.MUTATORS)
	return {"floor": f, "mut": mut, "map": 3 if mut == 3 else posmod(f * 5 + 2, 6), "style": posmod(f * 3 + 1, 5),
		"level": clampi((f - 1) / 6, 0, 2), "seed": 70000 + posmod(f * 7919, 1000003), "bonus": mini(BONUS_MAX, (f - 1) * BONUS_STEP)}

## 這一層的規則：每日挑戰的規則（自由部署、單局、突變）再加敵方預算。
static func make_rules(sp: Dictionary, mask: int):
	var r = Daily.make_rules(sp, mask)
	var RS = load("res://scripts/core/ruleset.gd")
	r.budget = [int(r.budget_of(0)), mini(RS.BUDGET_MAX, int(r.budget_of(1)) + int(sp["bonus"]))]   # 大地圖本來就接近上限：加碼夾在合法範圍內
	r.handicap = int(r.budget[1]) != int(r.budget[0])   # 兩邊預算不同要開讓子，否則 budget_of 兩邊都取藍方（stash 原本漏了，測試抓到）
	return r

static func enemy(sp: Dictionary, r):
	return Daily.enemy(sp, r)

## 記最高層：過了第 f 層＝最高至少 f。回傳 [新最高, 是否刷新]。
static func record(best: int, cleared_floor: int) -> Array:
	return [maxi(best, cleared_floor), cleared_floor > best]

## 續局：下一次要打的層（0＝沒有進行中的塔）。贏了＝下一層、輸了＝清掉；壞資料＝0。
static func next_run(run: int, floor_no: int, won: bool) -> int:
	return floor_no + 1 if won else 0

static func sanitize_run(v) -> int:
	return clampi(int(v), 0, 100000) if (v is int or v is float) else 0
## 回傳 {value, source}。主檔壞 → 隔離 → 讀備份。
static func _read(path: String, defaults: Dictionary) -> Dictionary:
	if FileAccess.file_exists(path):
		var m = _parse(path)
		if m != null:
			return {"value": m, "source": "main"}
		_quarantine(path)
	var bak := path + ".bak"
	if FileAccess.file_exists(bak):
		var b = _parse(bak)
		if b != null:
			return {"value": b, "source": "bak"}
	return {"value": defaults.duplicate(true), "source": "none"}

static func _num(v, fallback := 0.0) -> float:
	return float(v) if (v is int or v is float) else float(fallback)

static func _count(v, hi := 1000000000) -> int:
	return clampi(int(_num(v)), 0, hi)

static func schema_of(d: Dictionary) -> int:
	return int(_num(d.get("schema_version", d.get("version", 1)), 1))

## 設定逐欄驗型（R4）：型別不對用預設，數值夾在合法範圍；不認得的欄位保留。
static func sanitize_settings(d: Dictionary) -> Dictionary:
	var out := d.duplicate(true)
	# V1.2.1 F4：介面音、環境音是新欄位；舊檔沒有（或型別錯）時承接舊的音效值，舊靜音也保持靜音
	var old_sfx = out.get("sfx", DEFAULT_SETTINGS["sfx"])
	if not (old_sfx is int or old_sfx is float):
		old_sfx = DEFAULT_SETTINGS["sfx"]
	for nk in ["ui_vol", "amb_vol"]:
		if not (out.get(nk) is int or out.get(nk) is float):
			out[nk] = int(old_sfx)
	for k in DEFAULT_SETTINGS:
		var dv = DEFAULT_SETTINGS[k]
		var v = out.get(k, dv)
		if dv is bool:
			out[k] = v if v is bool else dv
		elif dv is String:
			out[k] = v if v is String else dv
		elif dv is int:
			out[k] = int(v) if (v is int or v is float) else dv
		elif dv is float:
			out[k] = float(v) if (v is int or v is float) else dv
	if not str(out["lang"]) in preload("res://scripts/game/strings.gd").LANGS:   # V1.2.1 G3：語言清單單一來源
		out["lang"] = DEFAULT_SETTINGS["lang"]
	if not int(out["text_scale"]) in [100, 125, 150]:
		out["text_scale"] = DEFAULT_SETTINGS["text_scale"]
	out["music"] = clampi(int(out["music"]), 0, 100)
	out["sfx"] = clampi(int(out["sfx"]), 0, 100)
	out["ui_vol"] = clampi(int(out["ui_vol"]), 0, 100)
	out["amb_vol"] = clampi(int(out["amb_vol"]), 0, 100)
	out["voice_vol"] = clampi(int(out.get("voice_vol", 70)), 0, 100)   # 1.4.0（Codex cat09 #3）
	out["speed"] = clampf(float(out["speed"]), 0.25, 8.0)
	if not str(out["duel_rule"]) in ["snake5", "snake5c", "cap10", "blind", "custom"]:
		out["duel_rule"] = DEFAULT_SETTINGS["duel_rule"]
	var KM = load("res://scripts/game/keymap.gd")
	out["keys"] = KM.sanitize(KM.ACTIONS, out.get("keys"))
	out["pad"] = KM.sanitize(KM.PAD_ACTIONS, out.get("pad"))
	if not str(out["roster"]) in ["all", "classic"]:
		out["roster"] = DEFAULT_SETTINGS["roster"]
	# V1.5：已經有設定檔的老玩家不問第一次啟動的三個問題
	if not d.has("first_done") and d.size() > 0:
		out["first_done"] = true
	# V1.5：列舉值不在清單裡就回預設；舊存檔的震動、閃白開關轉成強度（關＝0）
	# 新安裝（沒有設定檔）照方案：震動 25%、閃白柔和（50%）；老玩家照原本開關（開＝100）不改手感
	if not d.has("shake_pct"):
		out["shake_pct"] = (100 if bool(out["shake"]) else 0) if d.size() > 0 else 25
	if not d.has("flash_pct"):
		out["flash_pct"] = (100 if bool(out["flash"]) else 0) if d.size() > 0 else 50
	for ek in ENUMS:
		if not out[ek] in ENUMS[ek]:
			out[ek] = DEFAULT_SETTINGS[ek]
	out["master"] = clampi(int(out["master"]), 0, 100)
	out["long_press"] = clampf(float(out["long_press"]), 0.3, 1.0)
	out["shake"] = int(out["shake_pct"]) > 0
	out["flash"] = int(out["flash_pct"]) > 0
	return out

## 進度逐欄驗型（R4）：語法對但型別錯的欄位不能讓遊戲當掉；壞欄位改預設，其他進度保留。
static func sanitize_data(out: Dictionary) -> void:
	var sl: Array = ["", "", "", "", ""]
	var raw_sl = out.get("slots", [])
	if raw_sl is Array:
		for i in mini(raw_sl.size(), sl.size()):
			if raw_sl[i] is String and str(raw_sl[i]).length() <= 8000:
				sl[i] = raw_sl[i]
	out["slots"] = sl
	var lf = out.get("last_form", "")
	out["last_form"] = lf if lf is String and str(lf).length() <= 8000 else ""   # 1.2.0 §11.1：上一陣（陣型碼）
	out["songbook"] = load("res://scripts/game/songbook.gd").sanitize(out.get("songbook", []))   # 1.2.0 §11.8 棋譜本
	out["intro_seen"] = out.get("intro_seen", false) is bool and bool(out.get("intro_seen", false))   # 1.3.0 §13 掌燈開門只播第一次
	out["od"] = load("res://scripts/game/owner_daily.gd").sanitize(out.get("od", {}))   # 1.3.0 §12.7 每日老闆出題（新鍵逐欄驗型；舊存檔沒有＝空）
	var lst = out.get("lobby_stamps", 0)
	out["lobby_stamps"] = clampi(int(lst), 0, 99) if (lst is int or lst is float) else 0   # 1.4.0 §1.1 手帳印跡
	var twb = out.get("tower_best", 0)
	out["tower_best"] = clampi(int(twb), 0, 100000) if (twb is int or twb is float) else 0   # 1.4.0 §11.1 無盡塔最高層
	out["tower_run"] = load("res://scripts/game/tower.gd").sanitize_run(out.get("tower_run", 0))   # 進行中的層（回標題保留、下次繼續）
	var ods = out.get("od_stamps", 0)
	out["od_stamps"] = clampi(int(ods), 0, 100000) if (ods is int or ods is float) else 0
	out["campaign"] = load("res://scripts/game/campaign.gd").sanitize(out.get("campaign", {}))   # 1.2.0 §11.7（新鍵逐欄驗型；舊存檔沒有＝空，不需要遷移）
	out["recent"] = load("res://scripts/game/recent.gd").valid(out.get("recent", []), ["hub_play", "hub_gauntlet", "hub_challenge", "playroom", "hub_collect"])   # 1.2.0 §11.11
	for k in ["tutorial", "gauntlet_best", "unlock_games"]:
		out[k] = _count(out.get(k, 0))
	for k in ["stats", "custom_stats"]:
		var st = out.get(k, {})
