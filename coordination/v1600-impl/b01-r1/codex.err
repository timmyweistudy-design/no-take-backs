   342	## V1.2 D1：烘好的整頁再跑一次後處理 shader（外輪廓＋頂亮底暗）。
   343	func _post_tex(tex: Texture2D, size: Vector2i, per: int) -> Image:
   344		var tr := TextureRect.new()
   345		tr.texture = tex
   346		tr.size = Vector2(size)
   347		var mat := ShaderMaterial.new()
   348		mat.shader = load("res://shaders/unit_bake.gdshader")
   349		mat.set_shader_parameter("cell", float(CELL))
   350		mat.set_shader_parameter("per", float(per))
   351		mat.set_shader_parameter("cols", float(COLS))
   352		mat.set_shader_parameter("sh_amt", float(Art.WASH[clampi(int(Art.paint[2]), 0, 2)]))   # V1.4 #15 漬洗
   353		mat.set_shader_parameter("hi_amt", float(Art.DRY[clampi(int(Art.paint[3]), 0, 2)]))    # 乾掃
   354		tr.material = mat
   355		var vp := _viewport(size, tr)
   356		await RenderingServer.frame_post_draw
   357		await RenderingServer.frame_post_draw
   358		var t_rb := Time.get_ticks_usec()
   359		var out := vp.get_texture().get_image()
   360		_stat("readback", Time.get_ticks_usec() - t_rb)
   361		vp.queue_free()
   362		return out
