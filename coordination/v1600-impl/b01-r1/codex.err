    57	        elif p.is_file():
    58	            files.add(d)
    59	    h = hashlib.sha256(ver.encode())
    60	    for f in sorted(files):
    61	        h.update(f.encode())
    62	        h.update(sha(GAME / f).encode())
    63	    return h.hexdigest()[:20]
