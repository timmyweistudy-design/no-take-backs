   322	## 1.6.0 B01：會話邊界範本套在現有無盡塔（之後 B17 塔分岔改用同一份範本擴充）
   323	func test_session_contract_tower_v1600() -> void:
   324		var T = load("res://scripts/game/tower.gd")
   325		var settled := {"done": false}
   326		session_contract("無盡塔", {
   327			"start": func(): return {"run": 3, "spec": T.spec(3)},
   328			"commit": func(st): return {"tower_run": st["run"]},
   329			"restart": func(sv): return {"run": T.sanitize_run(sv.get("tower_run", 0)), "spec": T.spec(T.sanitize_run(sv.get("tower_run", 0)))},
   330			"settle": func(st):
   331				if settled["done"]:
   332					return [st, false]
   333				settled["done"] = true
   334				return [{"run": T.next_run(st["run"], st["run"], true), "spec": T.spec(st["run"] + 1)}, true],
   335			"same": func(a, b): return int(a["run"]) == int(b["run"]) and JSON.stringify(a["spec"]) == JSON.stringify(b["spec"]),
   336			"bad_inputs": ["x", -5, 1e12, null, [], {}],
   337			"sanitize": func(v): return T.sanitize_run(v),
   338			"old_samples": [[{"tower_run": 3}, {"run": 3, "spec": T.spec(3)}], [{}, {"run": 0, "spec": T.spec(0)}]],
   339		})
   340		ok(T.sanitize_run(-5) == 0 and T.sanitize_run(1e12) == 100000, "塔 run 範圍夾在 0～100000")

