     1	#!/usr/bin/env python3
     2	"""1.6.0 B01（P11.4）差分擴驗：從改動的檔案推出開發時要重拍哪些畫面。
     3	用法：python3 tools/affected_shots.py [git 範圍，預設 HEAD]   （在 game/ 下；看工作目錄＋暫存區對該範圍的差異）
     4	輸出：最後一行 `AFFECTED FULL <理由>` 或 `AFFECTED <n> <逗號分隔的截圖名>`；後者可直接給 LAYOUT_SHOTS。
     5	規則（寧可多拍）：
     6	- 共用的東西（字型、字串、色票、介面底層、整個畫面腳本的入口、模擬、截圖腳本、版面檢查）→ FULL（24 組全量）。
     7	- 已知只影響某類畫面的檔案 → 依 screens.json 的 entry 關鍵字挑。
     8	- 不認得的 scripts/ui 檔 → FULL（依賴不明就擴大）。
     9	- 只改 tests/、docs/、coordination/ → 不用重拍（輸出 0 張）。
    10	發版一律全量；這只是開發回饋。"""
    11	import json, os, subprocess, sys
    12	
    13	ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))   # game/
    14	FULL = [
    15	    ("data/strings.csv", "字串"), ("fonts/", "字型"), ("scripts/ui/palette.gd", "色票"), ("scripts/ui/ui_base.gd", "介面底層"),
    16	    ("scripts/ui/game_screens.gd", "畫面入口"), ("scripts/ui/layout_rules.gd", "版面規則"), ("scripts/ui/art.gd", "角色繪製"),
    17	    ("scripts/ui/sprite_cache.gd", "圖集"), ("scripts/core/", "模擬"), ("scripts/game/save.gd", "存檔"), ("tools/dev_main.gd", "截圖腳本"),
    18	    ("tools/layout_check.sh", "版面檢查"), ("art/", "素材"), ("shaders/", "shader"), ("project.godot", "專案設定"), ("scripts/ui/table_seats.gd", "桌位表"),
    19	]
    20	# 檔案 → screens.json entry 開頭關鍵字（任一命中就拍）
    21	ENTRY = {
    22	    "scripts/ui/screens/game_place.gd": ["擺陣", "自由排兵", "殘局", "主題試煉"],
    23	    "scripts/ui/free_place.gd": ["擺陣", "自由排兵"],
    24	    "scripts/ui/lobby_view.gd": ["對 AI 大廳", "雙人", "標題"],
    25	    "scripts/ui/screens/game_result.gd": ["結果", "結果頁", "遠征總結"],
    26	    "scripts/ui/screens/game_menus.gd": ["標題", "設定", "收藏", "殘局列表", "確認窗", "第一次開遊戲", "代碼", "離開確認"],
    27	    "scripts/ui/screens/game_modes.gd": ["主題試煉", "戰績", "遠征", "宿敵", "極速賽", "一陣三考"],
    28	    "scripts/ui/screens/game_playroom.gd": ["遊戲間", "塗裝室", "合作接力", "裂隙"],
    29	    "scripts/ui/screens/game_v16.gd": ["標題", "遊戲間", "出題台", "實驗簿", "每日挑戰", "裂隙", "戰鬥"],
    30	    "scripts/ui/codex_view.gd": ["圖鑑"],
    31	    "scripts/ui/replay_view.gd": ["重播", "覆盤", "結果"],
    32	    "scripts/ui/battle_view.gd": ["戰鬥", "重播"],
    33	    "scripts/ui/battle/battle_units.gd": ["戰鬥", "重播", "擺陣"],
    34	    "scripts/ui/battle/battle_fx.gd": ["戰鬥", "重播"],
    35	    "scripts/ui/battle/battle_state.gd": ["戰鬥", "重播"],
    36	}
    37	QUIET = ("tests/", "../docs/", "docs/", "../coordination/", "coordination/", "tools/affected_shots.py")
    38	
    39	def changed(rng):
    40	    out = subprocess.run(["git", "diff", "--name-only", rng], cwd=ROOT, capture_output=True, text=True).stdout.split()
    41	    out += subprocess.run(["git", "ls-files", "--others", "--exclude-standard", "--full-name"], cwd=ROOT, capture_output=True, text=True).stdout.split()
    42	    return sorted(set(f[len("game/"):] if f.startswith("game/") else "../" + f for f in out))
    43	
    44	def decide(files, screens):
    45	    shots = set()
    46	    for f in files:
    47	        if f.startswith(QUIET) or f.endswith((".md", ".txt")) and not f.startswith("data/"):
    48	            continue
    49	        for pre, why in FULL:
    50	            if f.startswith(pre):
    51	                return "FULL", "%s（%s）" % (why, f)
    52	        if f in ENTRY:
    53	            keys = ENTRY[f]
    54	            for n, v in screens.items():
    55	                e = v.get("entry", "")
    56	                if any(e.startswith(k) for k in keys):
    57	                    shots.add(n)
    58	            continue
    59	        if f.startswith(("scripts/", "tools/", "../tools/")) and f.endswith((".gd", ".py", ".sh")):
    60	            if f.startswith("tools/") and not f.endswith(".gd"):
    61	                continue   # 其他工具腳本不影響畫面
    62	            return "FULL", "依賴不明（%s）" % f
    63	    return "LIST", sorted(shots)
    64	
    65	if __name__ == "__main__":
    66	    rng = sys.argv[1] if len(sys.argv) > 1 else "HEAD"
    67	    screens = json.load(open(os.path.join(ROOT, "tools/screens.json"), encoding="utf-8"))
    68	    kind, v = decide(changed(rng), screens)
    69	    if kind == "FULL":
    70	        print("AFFECTED FULL", v)
    71	    else:
    72	        print("AFFECTED %d %s" % (len(v), ",".join(v)))
   300		f.store_string(txt)
   301		f.close()
   302	
   303	class FakePlat:
   304		func isCloudEnabledForAccount(): return true
   305		func isCloudEnabledForApp(): return true
   306		func getFileCount(): return 3
   307		func getFileNameAndSize(i): return {"name": ["save.json", "save.json.bak", "settings.json"][i], "size": 10}
   308		func getCurrentBetaName(): return {"ret": true, "name": "beta"}
   309	
   310	## 1.6.0 B01（方案 §3.1）：會話邊界測試範本。新玩法（塔分岔、茶局、情報、棋課）都用它。
   311	## 一個會話＝開局 → 承諾（寫進存檔）→ 戰鬥 → 結算（只一次）→ 續玩 → 回退。範本檢查：
   312	##   ① 承諾後「重啟」（存檔來回序列化＋sanitize）狀態不變、不重抽；② 結算兩次＝第二次不改任何東西；
   313	##   ③ 壞資料（亂型別、缺欄、負數、超大）讀回＝安全預設，不當掉；④ 舊版樣本原樣讀回。
   314	## s 是字典：start() -> 狀態、commit(狀態) -> 存檔字典、restart(存檔字典) -> 狀態、settle(狀態) -> [新狀態, 是否有變]、
   315	## same(a, b) -> bool、bad_inputs: Array、sanitize(v) -> 狀態、old_samples: Array of [存檔字典, 期望狀態]
   316	func session_contract(name: String, s: Dictionary) -> void:
   317		var st0 = s["start"].call()
   318		var saved: Dictionary = s["commit"].call(st0)
   319		var round_trip = JSON.parse_string(JSON.stringify(saved))   # 模擬寫檔再讀回（整數會變浮點，sanitize 要處理）
   320		var st1 = s["restart"].call(round_trip)
   321		ok(bool(s["same"].call(st0, st1)), name + "：承諾後重啟，狀態不變（不重抽）")
   322		var r1: Array = s["settle"].call(st1)
   323		var r2: Array = s["settle"].call(r1[0])
   324		ok(bool(r1[1]) and not bool(r2[1]), name + "：結算只生效一次（第二次不改任何東西）")
   325		for b in s.get("bad_inputs", []):
   326			var v = s["sanitize"].call(b)
   327			ok(v != null, name + "：壞資料讀回不當掉（%s）" % str(b))
   328		for pair in s.get("old_samples", []):
   329			ok(bool(s["same"].call(s["restart"].call(pair[0]), pair[1])), name + "：舊版樣本原樣讀回")
   313	
   314	## 1.2.0：存檔格式 3 → 4 補上戰役、棋譜本、最近玩的、上一陣；舊進度不動（Codex cat10 #4）
   315	func test_save_v4_migration_v120() -> void:
   316		var SVx = load("res://scripts/game/save.gd")
   317		var m: Dictionary = SVx.migrate({"schema_version": 3, "stats": {"games": 5, "wins": 2}, "tutorial": 2, "puzzle_stars": {"p1": 3}})
   318		ok(int(m["schema_version"]) == 4 and m["campaign"] is Dictionary and m["songbook"] is Array and m["recent"] is Array and m["last_form"] == "" and int(m["puzzle_stars"]["p1"]) == 3 and int(m["tutorial"]) == 2, "3→4 補新欄位、舊進度保留", str(m))
   319		var keep: Dictionary = SVx.migrate({"schema_version": 3, "campaign": {"c1_1": 2}})
   320		ok(int(keep["campaign"]["c1_1"]) == 2, "已有的戰役進度不覆蓋")
