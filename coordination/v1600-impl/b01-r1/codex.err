   388	    sys.exit(main())
    10	var ALL_TESTS: Array = []
    11	var _objs := {}
    12	
    13	func has_test(fn: String) -> bool:
    14		for g in FILES:
    15			if fn in FILES[g]:
    16				return load("res://tests/suites/%s.gd" % g).new().has_method(fn)
    17		return false
    18	
    19	## V1.1 E2：suites 裡有 test_ 開頭的函式卻沒登記 → 擋下（以前會靜靜不跑）。
    20	func unregistered() -> Array:
    21		var out := []
    22		var reg := {}
    23		for g in FILES:
    24			for fn in FILES[g]:
    25				reg[fn] = true
    26		var d := DirAccess.open("res://tests/suites")
    27		if d == null:
    28			return out
    29		for f in d.get_files():
    30			if not f.ends_with(".gd"):
    31				continue
    32			var src := FileAccess.get_file_as_string("res://tests/suites/" + f)
    33			for line in src.split("\n"):
    34				if line.begins_with("func test_"):
    35					var fn := line.substr(5).get_slice("(", 0).strip_edges()
    36					if not reg.has(fn):
    37						out.append(f.get_basename() + "." + fn)
    38		return out
    39	
    40	## 純函式（測試用）：至少 1 項通過且 0 失敗才算成功。
    41	static func exit_code(p: int, f: int) -> int:
    42		return 0 if p > 0 and f == 0 else 1
    43	
    44	func _obj(g: String):
    45		if not _objs.has(g):
    46			_objs[g] = load("res://tests/suites/%s.gd" % g).new()
    47			_objs[g].runner = self
    48		return _objs[g]
    49	
    50	func _init() -> void:
    51		var t0 := Time.get_ticks_msec()
    52		for g in FILES:
    53			SUITES[g] = FILES[g]
    54		for al in ALIASES:
    55			SUITES[al] = FILES[ALIASES[al]]
    56		ALL_TESTS = ORDER.duplicate()
    57		for g in FILES:
    58			for fn in FILES[g]:
    59				if not fn in ALL_TESTS:
    60					ALL_TESTS.append(fn)
    61		var unreg := unregistered()
    62		if not unreg.is_empty():
    63			print("FAIL 測試函式沒登記在 FILES：", ", ".join(unreg))
    64			print("—— 0 通過 / 1 失敗")
    65			quit(1)
    66			return
    67		var names: Array = ALL_TESTS
    68		for a in OS.get_cmdline_user_args():
    69			if a.begins_with("--prefix="):
    70				# V1.6 #4：會碰存檔的測試組分兩個行程平行跑，各用自己的存檔前綴
    71				load("res://scripts/game/save.gd").prefix = a.substr(9)
    72			if a.begins_with("--only="):
    73				# 第九輪 P0：可以逗號列多個，每項是測試組或單一 test_ 函式名
    74				names = []
    75				for k in a.substr(7).split(","):
    76					if k.begins_with("-"):
    77						names.erase(k.substr(1))   # 例：--only=core,-test_golden
    78					elif SUITES.has(k):
    79						names.append_array(SUITES[k])
    80					elif k in ALL_TESTS:
    81						names.append(k)
    82					else:
    83						print("FAIL 未知的測試組：", k, "（可用：", ", ".join(SUITES.keys()), "）")
    84						print("—— 0 通過 / 1 失敗")
    85						quit(1)
    86						return
    87		for fn in names:
    88			for g in FILES:
    89				if fn in FILES[g]:
    90					var t1 := Time.get_ticks_msec()
    91					_obj(g).call(fn)
    92					print("TIME %s %d" % [fn, Time.get_ticks_msec() - t1])
    93		var p := 0
    94		var f := 0
    95		for g2 in _objs:
    96			p += _objs[g2].passed
    97			f += _objs[g2].failed
    98		print("—— %d 通過 / %d 失敗（%d ms）" % [p, f, Time.get_ticks_msec() - t0])
    99		quit(exit_code(p, f))
