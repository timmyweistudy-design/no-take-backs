   162	              f"Where-Object {{ $_.CommandLine -like '*{marker}*' }} | ForEach-Object {{ Stop-Process -Id $_.ProcessId -Force }}")
   163	        subprocess.run(["powershell.exe", "-NoProfile", "-Command", ps], capture_output=True, timeout=60)
