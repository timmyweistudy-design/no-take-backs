   326	def _run_steps(ex, todo, godot, out, a, marker, res, cache):
   327	    if True:   # 保留原縮排
   328	        futs = {ex.submit(run_step, s, godot, out, a.timeout, marker): s for s in todo}
   329	        for fu in cf.as_completed(futs):
   330	            r = fu.result()
   331	            res.append(r)
   332	            if r["ok"]:
   333	                s = futs[fu]
   334	                for old in cache.glob(f"{s['name']}-*.log"):
   335	                    old.unlink()
   336	                shutil.copy(out / f"{s['name']}.log", cache / f"{s['name']}-{s['key']}.log")
   337	    return res
