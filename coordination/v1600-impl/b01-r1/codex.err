   274	func stage_report() -> Dictionary:
   275		var out := {}
   276		for k in stage_stats:
   277			var e: Array = stage_stats[k]
   278			out[k] = {"n": e[0], "total_ms": snappedf(int(e[1]) / 1000.0, 0.1), "max_ms": snappedf(int(e[2]) / 1000.0, 0.1)}
   279		return out
   280	
   281	func _paint_steps(size: Vector2i, painter: Node, total: int) -> SubViewport:
   282		painter.cell_from = 0
   283		painter.cell_to = PAINT_CHUNK
   284		var vp := _viewport(size, painter)
   285		vp.render_target_clear_mode = SubViewport.CLEAR_MODE_ONCE
   286		await RenderingServer.frame_post_draw
   287		var c0 := PAINT_CHUNK
   288		while c0 < total:
   289			var t_pf := Time.get_ticks_usec()
   290			painter.cell_from = c0
   291			painter.cell_to = c0 + PAINT_CHUNK
   292			painter.queue_redraw()
   293			vp.render_target_update_mode = SubViewport.UPDATE_ONCE
   294			await RenderingServer.frame_post_draw
   295			_stat("paint_frame", Time.get_ticks_usec() - t_pf)   # 一段畫格＋等到畫完（含當幀其他工作）
   296			c0 += PAINT_CHUNK
   297		await RenderingServer.frame_post_draw
   298		return vp
