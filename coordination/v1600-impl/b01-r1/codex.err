   339	
   340	def _finish(a, godot, out, steps, res, t0, fail, f_load, f_boot, gate):
   341	    if not f_load.result():
   342	        return fail("有腳本載入失敗")
   343	    if not f_boot.result():
   344	        return fail("正式入口啟動失敗")
   345	    gate.shutdown()
   346	    tests, times = 0, []
   347	    fp = ""
   348	    for s in steps:
   349	        lg = out / f"{s['name']}.log"
   350	        if lg.is_file() and s["name"].startswith("t_"):
   351	            txt = lg.read_text(encoding="utf-8", errors="ignore")
   352	            m = TEST_DONE.search(txt)
   353	            tests += int(m.group(1)) if m else 0
   354	            times += [(n, int(ms)) for n, ms in re.findall(r"^TIME (\S+) (\d+)", txt, re.M)]
   355	            m2 = re.search(r"^FINGERPRINT .*$", txt, re.M)
   356	            fp = m2.group(0).strip() if m2 else fp
   357	    # 1.2.0 §14.2：完整模式核對測試 ID：所有 t_ 步驟跑過的測試（TIME 行）聯集＝FILES 全集，而且每個測試只在一個步驟出現
   358	    if not a.quick and not a.only:
   359	        seen = {}
   360	        for s in steps:
   361	            lg = out / f"{s['name']}.log"
   362	            if lg.is_file() and s["name"].startswith("t_"):
   363	                for n in re.findall(r"^TIME (\S+) \d+", lg.read_text(encoding="utf-8", errors="ignore"), re.M):
   364	                    seen.setdefault(n, []).append(s["name"])
   365	        want = {fn for fns in suite_map().values() for fn in fns}
   366	        if not want:
   367	            return fail("讀不到 run_tests.gd 的 FILES（測試 ID 核對不能跳過）")
   368	        missing = sorted(want - set(seen))
   369	        extra = sorted(set(seen) - want)
   370	        dup = sorted(n for n, v in seen.items() if len(v) > 1)
   371	        if missing or dup or extra:
   372	            return fail("測試 ID 聯集不對：漏跑 %s；重複 %s；多出 %s" % (missing[:10], [(n, seen[n]) for n in dup[:10]], extra[:10]))
   373	    if fp:
   374	        (out / "fingerprint.txt").write_text(fp + "\n", encoding="utf-8", newline="\n")   # Windows 預設 CRLF，跨平台比對會假失敗
   375	    wall = time.time() - t0
   376	    bad = [r for r in res if not r["ok"]]
   377	    times.sort(key=lambda x: -x[1])
   378	    (out / "summary.json").write_text(json.dumps({"wall_sec": round(wall), "tests": tests, "fingerprint": fp, "jobs": a.jobs,
   379	        "steps": sorted(res, key=lambda r: -r["sec"]), "slow_tests": times[:25]}, ensure_ascii=False, indent=1), encoding="utf-8")
   380	    if bad:
   381	        return fail("、".join(f"{r['name']}（{r['why']}）" for r in bad))
   382	    cached = sum(1 for r in res if r.get("cached"))
   383	    print(f"CHECK OK：{len(res)} 步（快取 {cached}）、測試 {tests} 項、{round(wall)} 秒｜{fp}")
   384	    return 0
