+## 1.6.0 B01：會話邊界範本套在現有無盡塔（之後 B17 塔分岔改用同一份範本擴充）
+func test_session_contract_tower_v1600() -> void:
+	var T = load("res://scripts/game/tower.gd")
+	var settled := {"done": false}
+	session_contract("無盡塔", {
+		"start": func(): return {"run": 3, "spec": T.spec(3)},
+		"commit": func(st): return {"tower_run": st["run"]},
+		"restart": func(sv): return {"run": T.sanitize_run(sv.get("tower_run", 0)), "spec": T.spec(T.sanitize_run(sv.get("tower_run", 0)))},
+		"settle": func(st):
+			if settled["done"]:
+				return [st, false]
+			settled["done"] = true
+			return [{"run": T.next_run(st["run"], st["run"], true), "spec": T.spec(st["run"] + 1)}, true],
+		"same": func(a, b): return int(a["run"]) == int(b["run"]) and JSON.stringify(a["spec"]) == JSON.stringify(b["spec"]),
+		"bad_inputs": ["x", -5, 1e12, null, [], {}],
+		"sanitize": func(v): return T.sanitize_run(v),
+		"old_samples": [[{"tower_run": 3}, {"run": 3, "spec": T.spec(3)}], [{}, {"run": 0, "spec": T.spec(0)}]],
+	})
+	ok(T.sanitize_run(-5) == 0 and T.sanitize_run(1e12) == 100000, "塔 run 範圍夾在 0～100000")
diff --git a/game/tests/test_base.gd b/game/tests/test_base.gd
index ff1e4d2..e6017fb 100644
--- a/game/tests/test_base.gd
+++ b/game/tests/test_base.gd
@@ -306,3 +306,24 @@ class FakePlat:
 	func getFileCount(): return 3
 	func getFileNameAndSize(i): return {"name": ["save.json", "save.json.bak", "settings.json"][i], "size": 10}
 	func getCurrentBetaName(): return {"ret": true, "name": "beta"}
+
+## 1.6.0 B01（方案 §3.1）：會話邊界測試範本。新玩法（塔分岔、茶局、情報、棋課）都用它。
+## 一個會話＝開局 → 承諾（寫進存檔）→ 戰鬥 → 結算（只一次）→ 續玩 → 回退。範本檢查：
+##   ① 承諾後「重啟」（存檔來回序列化＋sanitize）狀態不變、不重抽；② 結算兩次＝第二次不改任何東西；
+##   ③ 壞資料（亂型別、缺欄、負數、超大）讀回＝安全預設，不當掉；④ 舊版樣本原樣讀回。
+## s 是字典：start() -> 狀態、commit(狀態) -> 存檔字典、restart(存檔字典) -> 狀態、settle(狀態) -> [新狀態, 是否有變]、
+## same(a, b) -> bool、bad_inputs: Array、sanitize(v) -> 狀態、old_samples: Array of [存檔字典, 期望狀態]
+func session_contract(name: String, s: Dictionary) -> void:
+	var st0 = s["start"].call()
+	var saved: Dictionary = s["commit"].call(st0)
+	var round_trip = JSON.parse_string(JSON.stringify(saved))   # 模擬寫檔再讀回（整數會變浮點，sanitize 要處理）
+	var st1 = s["restart"].call(round_trip)
+	ok(bool(s["same"].call(st0, st1)), name + "：承諾後重啟，狀態不變（不重抽）")
+	var r1: Array = s["settle"].call(st1)
+	var r2: Array = s["settle"].call(r1[0])
+	ok(bool(r1[1]) and not bool(r2[1]), name + "：結算只生效一次（第二次不改任何東西）")
+	for b in s.get("bad_inputs", []):
+		var v = s["sanitize"].call(b)
+		ok(v != null, name + "：壞資料讀回不當掉（%s）" % str(b))
+	for pair in s.get("old_samples", []):
+		ok(bool(s["same"].call(s["restart"].call(pair[0]), pair[1])), name + "：舊版樣本原樣讀回")
