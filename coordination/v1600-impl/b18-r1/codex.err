## 一句描述（第五輪：只講事實、和 MVP 一致，不宣稱因果——Codex 第二輪）。主角＝MVP（勝方傷害最高的那一隻）。
## V1.1 B1：藍方（玩家）輸了才有。傷害最多的敵方兵種與占比；能帶的兵裡剋它最強的那種當建議。雙人、觀戰不顯示。
func _loss_line(w: int, goal_mode: bool) -> String:
	if mode == Mode.DUEL or watch_mode or play_kind == "review":
		return ""
	var lost: bool = (bool(report.get("goal_ok", true)) == false) if goal_mode else (w == 1)
	if not lost:
		return ""
	var line := loss_summary(ev_count, _loss_pool())
	var st: Dictionary = Save.data.get("stats", {})
	if line != "" and int(st.get("wins", 0)) == 0 and int(st.get("games", 0)) <= 2 and (mode == Mode.VS_AI or mode == Mode.TUTORIAL):
		line = L.t("loss_first", [line])   # V1.0.0 N6：前兩場還沒贏過：先講「輸很正常」再給建議
	if line != "":
		line = L.t("ev_observed", [line])   # 1.6.0 B15（P6.1）證據分層：敗因卡是「觀察」，覆盤重算過才是「此條件下已驗證」
	return line

func _loss_pool() -> Array:
	if mode == Mode.PUZZLE or mode == Mode.TUTORIAL:
		return PZ.get_puzzle(puzzle_id).get("allowed", [])
	var out: Array = []
	var pool: int = int(armies[0].pool) if not armies.is_empty() else 0
	for ty in 20:
		if RuleSet.has(pool, ty):
			out.append(ty)
	return out

## 1.5.0：敗因卡用的兩個兵種 [主要傷害來源, 建議改帶]（-1＝沒有）；和 loss_summary 同一套判斷
static func loss_pair(counts: Dictionary, pool: Array) -> Array:
	var total := 0
	var top := -1
	var top_v := 0
	for k in counts:
		if str(k).begins_with("dmgby0_"):
			var v := int(counts[k])
			total += v
			if v > top_v:
				top_v = v
				top = int(str(k).substr(7))
	if top < 0 or total <= 0:
		return [-1, -1]
	var best := -1
	var best_sc := 0
	for ty in pool:
		var sc: int = AIT.counter_score(int(ty), top)
		if sc > best_sc:

## ── 戰績 ──
func _record_match(w: int) -> void:
	if armies.is_empty() or armies[0] == null:
		return
	var ug: Dictionary = Save.data.get("unit_games", {})
	var seen := {}
	for u in armies[0].units:
		seen[str(int(u["type"]))] = true
	if mode == Mode.DUEL and armies.size() > 1 and armies[1] != null:   # 第十輪 B4：雙人兩邊贏了都算勝場，場數也要兩邊算
		for u2 in armies[1].units:
			seen[str(int(u2["type"]))] = true
	for k in seen:
		ug[k] = int(ug.get(k, 0)) + 1
	Save.data["unit_games"] = ug
	# V1.5.1：戰績頁的兵種勝率用同一組模式記場數與勝場（原本勝場在殘局、教學、試煉也加，勝率偏高；使用者回報）
	# 實驗室徽章（沙盒調數值）不記（Codex／Antigravity v151-i1）
	if rules != null and Presets.badge(rules, "duel" if mode == Mode.DUEL else "ai") == Presets.BADGE_LAB:
		return
	var gr: Dictionary = Save.data.get("unit_games_rec", {})
	var wr: Dictionary = Save.data.get("unit_wins_rec", {})
	for k in seen:
		gr[k] = int(gr.get(k, 0)) + 1
	if w >= 0 and (w == 0 or mode == Mode.DUEL):
		var won := {}
		var wa = armies[w] if w < armies.size() and armies[w] != null else armies[0]
		for u in wa.units:
			won[str(int(u["type"]))] = true
		for k in won:
			wr[k] = int(wr.get(k, 0)) + 1
	Save.data["unit_games_rec"] = gr
	Save.data["unit_wins_rec"] = wr
	if mode == Mode.DUEL:
		return    # 連勝只算單人
	if w == 0:
		Save.data["streak"] = int(Save.data.get("streak", 0)) + 1
		Save.data["best_streak"] = maxi(int(Save.data.get("best_streak", 0)), int(Save.data["streak"]))
	else:
		Save.data["streak"] = 0

