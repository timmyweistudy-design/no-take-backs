func shift_all(d: int) -> bool:
	if deploy == "free" or units.is_empty():
		return false
	var keep := units.duplicate(true)
	var dc := d if team == 0 else -d
	for u in units:
		u["col"] = int(u["col"]) + dc
	return _grid_keep_or_undo(keep)

