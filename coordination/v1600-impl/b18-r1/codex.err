## 開一場戰鬥（S8 從 game_screens 移下來：重播、覆盤、截圖都會用到）
func _begin_battle(a0, a1, kind := "official") -> void:
	nav_stack.clear()   # V1.5.1：開戰後，之前的返回堆疊作廢
	_pre_drop()
	play_kind = kind
	tm_ghost = null   # V1.4 #1：時光機的原本時間線只在「如果」播放時存在（_rv_play 之後會再設）
	_ensure_sprites([a0, a1])
	if kind == "official":
		last_armies = [a0.copy(), a1.copy()]
		battle_rules = rules.copy() if rules != null else _puzzle_rules()   # 第十三輪：殘局自帶規則
	sim = Sim.new(a0, a1, battle_rules)
	_cmd_setup(sim, kind)
	view = ViewBuffer.new(sim)
	atk_seq.clear()
	clutch_tick = -1
	replay_total = 0
	else:
		draw_rect(mr, Color(0.11, 0.09, 0.24, 0.80))
	var fp := mr.position + Vector2(mr.size.x / 2 - 8, mr.size.y / 2 - 120)
	var glow := 0.5 + 0.5 * sin(time * 2.4)
	draw_circle(fp + Vector2(22, 18), 34 + glow * 6, Color(1, 0.25, 0.25, 0.10 + glow * 0.06), true, -1.0, true)
	draw_line(fp, fp + Vector2(0, 74), Color(0.85, 0.78, 0.7), 3.0, true)
	draw_colored_polygon(PackedVector2Array([fp, fp + Vector2(48, 16), fp + Vector2(0, 36)]), Color(0.9, 0.2, 0.22))
	_text(fp + Vector2(15, 2), "?", ts(22), Color.WHITE, true, true)
	# V1.2.1 R5：旗竿底座的小木牌，只寫公開資訊（敵方預算、兵數上限），不洩漏陣型
	if not bool(Save.s("plain_ui")):
		var eb: int = rules.budget_of(hide_side) if rules != null else 100
		var ec: int = rules.unit_cap if rules != null else 24
		var sg := L.t("fog_sign", [eb, ec])
		if mode == Mode.GAUNTLET and int(get("gauntlet_nemesis")) >= 0:
			sg = L.t("nem_sign", [ai_name])   # V1.4 #2：宿敵攔路時木牌寫它的名號
		var sfs: int = tz("C")
		var sw := _width(sg, sfs, true) + 24.0
		var sr := Rect2(fp.x - sw / 2.0, fp.y + 74, sw, sfs * 1.5)
		_tex_box(sr, "wood", Color(0.62, 0.44, 0.3))
		draw_rect(Rect2(sr.position.x + 3, sr.end.y - 2, sr.size.x - 6, 2), Color(0, 0, 0, 0.3))
		_text(Vector2(fp.x, sr.position.y + sfs * 0.2), sg, sfs, Color.WHITE, true, true, sw)
	# 第七輪 A1：同一系列第 2 局起，留上一局敵陣殘影當參考（對手這局可能換陣）
	return L.t("res_normal", [side, unit, dmg, lock_s])



## V9：系列每局換地圖。換圖後舊陣型不一定放得下，所以不保留陣型。
func _apply_map_mode() -> void:
	if rules == null or rules.map_mode == 0 or not rules.is_free():
		return
	var n: int = MapDefs.MAPS.size()
	rules.map_id = wrapi(rules.map_id + 1, 0, n) if rules.map_mode == 1 else rng.randi_range(0, n - 1)
	rules.keep_formation = false
	rules.vents = false

func _next_round() -> void:
	if series_over and bool(get("sealed_on")) and mode == Mode.DUEL:
		call("_sealed_start")   # V1.4 #13：三戰打完再來＝重新封三陣（不是重打同一組，Antigravity v140-i3）
		return
	if series_over and bool(get("swap_on")) and mode == Mode.DUEL:
		call("_swap_ai_start" if bool(get("swap_ai")) else "_swap_start")   # 1.2.0 §11.5：再來一組換邊雙局（分數歸零）；1.6.0 B18 對 AI 版照原樣再來
		return
	if series_over:
		wins = [0, 0]
		round_no = 1
		series_over = false
		last_player_formation = []
		_reset_place(false)
		return
	round_no += 1
	_apply_map_mode()
	_reset_place(mode == Mode.VS_AI)
	if bool(get("sealed_on")) and mode == Mode.DUEL:
		# V1.4 #13：下一局直接用封好的陣，不再擺
		var k := clampi(round_no - 1, 0, 2)
		call("_sealed_reveal", k)
		_toast(L.t("sealed_open", [k + 1]))

