func apply_rules(r, p_team: int) -> void:
	budget = r.budget_of(p_team)
	pool = r.pool_of(p_team)
	unit_cap = r.unit_cap
	type_cap = r.type_cap
	guard_combat = true
	deploy = r.deploy
	spacing = r.spacing
	depth = r.depth_of()
	enemy_gap = r.ENEMY_GAP
	fw = r.field_w()
	fh = r.field_h()
	terrain = r.terrain()

func _copy_limits(a) -> void:
	a.pool = pool
	a.unit_cap = unit_cap
	a.type_cap = type_cap
	a.guard_combat = guard_combat
	a.deploy = deploy
	a.spacing = spacing
	a.depth = depth
	a.enemy_gap = enemy_gap
	a.enemy_pos = enemy_pos.duplicate()
	a.fw = fw
	a.fh = fh
	a.terrain = terrain

func place(t: int, col: int, row: int) -> bool:
	if deploy == "free":
