 	# 1.6.0 B16（P13.1）：隔離區（讀不出來的紀錄原文還在）＋滿六筆時的替換確認
 	Save.data["songbook_bad"] = ["{\"c\":\"NTB2.broken\",\"n\":\"2026-11-01\"}"]
 	await _snap("v160_16d_songbook_bad.png")
--- a/game/tools/gen_famous.gd
+++ b/game/tools/gen_famous.gd
@@ -0,0 +1,28 @@
+extends SceneTree
+## 1.6.0 B18（P7.4）名局：固定種子掃 AI 對 AI 一般組陣，挑「險勝」（勝方剩 ≤15%、打超過 40 秒）的前 6 場，寫 data/famous_games.json。
+## 只寫量得到的事實（勝方、剩餘戰力、秒數），不編故事。
+func _init():
+	var AI = load("res://scripts/core/ai_army.gd")
+	var BC = load("res://scripts/game/battle_code.gd")
+	var Sim = load("res://scripts/core/battle_sim.gd")
+	var out: Array = []
+	var seed := 160400
+	while out.size() < 6 and seed < 161400:
+		seed += 1
+		var r := RandomNumberGenerator.new()
+		r.seed = seed
+		var a0 = AI.build(0, 100, r)["army"]
+		var a1 = AI.build(1, 100, r)["army"]
+		var s = Sim.new(a0.copy(), a1.copy())
+		s.fast = true
+		s.run_to_end()
+		if s.winner < 0:
+			continue
+		var rem := roundi(s.power(s.winner) * 100.0 / (s.budget_of(s.winner) * 1000))
+		if rem <= 15 and rem >= 1 and s.tick >= 800:
+			out.append({"c": BC.encode(a0, a1), "w": s.winner, "rem": rem, "sec": s.tick / 20, "seed": seed})
+	var f := FileAccess.open("res://data/famous_games.json", FileAccess.WRITE)
+	f.store_string(JSON.stringify(out, "\t"))
+	f.close()
+	print("FAMOUS ", out.size())
+	quit()
--- a/game/tests/suites/modes_live.gd
+++ b/game/tests/suites/modes_live.gd
@@ -413,3 +413,28 @@
 
 func ok_quiet(_c: bool) -> void:
 	pass
+
+## 1.6.0 B18（P7.3）對 AI 換邊雙局：第 1 局你擺藍、AI 擺紅；第 2 局 AI 先擺藍、你擺紅；分數跟著人走（SwapDuel 原規則）。
+func test_swap_ai_v1600() -> void:
+	var GS = load("res://scripts/ui/game_screens.gd")
+	var SD = load("res://scripts/game/swap_duel.gd")
+	var LSx = load("res://scripts/game/strings.gd")
+	var g = GS.new()
+	g.sfx = FakeSfx.new()
+	g._swap_ai_start()
+	ok(g.swap_on and g.swap_ai and g.mode == g.Mode.DUEL and g.tp == null and g.blind_phase == 0 and g.armies[1].count() == 0, "第 1 局：輪到你擺藍方，紅方還空著", str([g.blind_phase, g.tp]))
+	var pool := F.training_pool(0)
+	for u in pool[2].units:
+		g.armies[0].place(int(u["type"]), int(u["col"]), int(u["row"]))
+	g._on_start()
+	ok(g.blind_phase == 2 and g.armies[1].count() > 0 and g._ready_to_fight(), "你擺好藍方＝AI 擺紅方，可以開戰（紅 %d 隻）" % g.armies[1].count())
+	ok(g._swap_who().find(LSx.t("blue")) >= 0, "第 1 局標示你是藍方")
+	g.round_no = 2
+	g._reset_place()
+	ok(g.blind_phase == 1 and g.armies[0].count() > 0 and g.armies[1].count() == 0 and g._cur_army() == g.armies[1], "第 2 局：AI 先擺好藍方，輪到你擺紅方")
+	ok(g._swap_who().find(LSx.t("red")) >= 0 and SD.owner(2, 1) == 0, "第 2 局標示你是紅方；紅方分數算給你")
+	ok(g._swap_fact().find("AI") >= 0, "結果頁寫你和 AI（不是玩家 A／B）")
+	g.free()
+	var gm: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_menus.gd")
+	var gr: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_result.gd")
+	ok(gm.find("[\"sw_ai_open\", \"hc_sw_ai_d\"") >= 0 and gr.find("call(\"_swap_ai_start\" if bool(get(\"swap_ai\")) else \"_swap_start\")") >= 0 and gr.find("set(\"swap_ai\", false)") >= 0, "入口、再來一組、換模式清旗標")
--- a/game/tests/suites/coach_lab.gd
+++ b/game/tests/suites/coach_lab.gd
@@ -810,3 +810,23 @@
 	ok(spn[1].size() == 1 and str(spn[1][0]).length() <= SBx.BAD_TEXT, "巢狀／超長：只留截過的原文")
 	var gr: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_result.gd")
 	ok(gr.find("res_more_items.append([L.t(\"sb_add\"), func(): call(\"_sb_add_current\")])") >= 0, "結果頁「更多」直接收進棋譜本")
+
+## 1.6.0 B18（P7.4）棋館名局：每一場都解得開、重算的勝方／剩餘／秒數和資料一樣（確定性），文字只寫這三個事實。
+func test_famous_v1600() -> void:
+	var GS = load("res://scripts/ui/game_screens.gd")
+	var BCx = load("res://scripts/game/battle_code.gd")
+	var g = GS.new()
+	var fl: Array = g.famous_games()
+	var same := 0
+	for e in fl:
+		var d: Dictionary = BCx.decode(str(e["c"]))
+		var s = Sim.new(d["a0"], d["a1"], d.get("rules"))
+		s.fast = true
+		s.run_to_end()
+		var rem := roundi(s.power(s.winner) * 100.0 / (s.budget_of(s.winner) * 1000)) if s.winner >= 0 else -1
+		if s.winner == int(e["w"]) and rem == int(e["rem"]) and s.tick / 20 == int(e["sec"]) and rem < 20:
+			same += 1
+	ok(fl.size() == 6 and same == 6, "名局 6 場重算都和資料一樣、都是剩不到兩成的險勝（%d／%d）" % [same, fl.size()])
+	g.sb_tab = 1
+	ok(g.famous_games().size() == fl.size(), "名局只讀一次（快取）")
+	g.free()
