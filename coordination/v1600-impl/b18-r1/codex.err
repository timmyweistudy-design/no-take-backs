extends "res://scripts/ui/free_place.gd"
## 由 game_screens.gd 拆出（V9 P1，行為不變）
## 狀態機、模式、輸入、擺放、標題、選單、設定、結果、成就。

## 第七輪 S7：每次啟動一個 session、每局一個 game；彙整工具靠這兩個去重（評分和對戰是兩行，不能重複算局數）。
var pt_session := str(Time.get_unix_time_from_system()) + "-" + str(randi())
var pt_game := 0

var keys_capture := ""   # 第七輪 K1：正在改哪個按鍵（"kb:start"／"pad:place"）

# ───────────────────────── 每幀 ─────────────────────────
## 最小化時 Godot 不繪製，也就沒有垂直同步節流，主迴圈會空轉吃滿一核；降到 10 fps，模擬照常跑（用 delta 累積）。
var _was_minimized := false
## 搖桿連發（第三輪 A2）：超過 0.6 才算推、低於 0.35 才算放開（遲滯）；推下立刻一次，0.35 秒後每 0.12 秒一次。
var stick := {JOY_AXIS_LEFT_X: 0.0, JOY_AXIS_LEFT_Y: 0.0}
var _stick_dir := Vector2i.ZERO
var _stick_t := 0.0

## 結果頁的技能徽章（第四輪）：候選裡雙方合計次數最多的 6 種；不夠 6 種就用經典的預設順序補。支援兵的補血、戰鼓也在候選裡（對支援兵公平）。
const BADGE_KEYS := ["breaker", "charge", "backstab", "braced", "anticav", "counter", "pike_brace", "splash", "breach", "heal", "drum"]
const EV_DEATH := "death"


func _reset_place(keep_blue := false) -> void:
	state = St.PLACE
	if bool(get("cp_on")):
		call("_cp_reset")   # 1.2.0 §11.6：每一局重新輪手（藍軍保留時，已有的兵不算任何人這一手）
	sim = null
	view = null
	pending_cell = Vector2i(-1, -1)
	ai_prebuilt = false
	_fp_reset()
	# 第一次進擺放畫面自動打開操作說明（第五輪：說明從頂部移到「?」）
	if not bool(Save.data.get("seen_place_help", false)) and (mode == Mode.VS_AI or mode == Mode.DUEL) and shot_dir == "":
		show_place_help = true
		Save.data["seen_place_help"] = true
	fx.clear()
	frags.clear()   # 1.2.0 §8.2
	dying.clear()
	zoom = 1.0
	tp = null
	blind_phase = 0
	foe_tag_open = false   # 1.5.0 §1.4
	_focus = 0
	var keep_ok: bool = keep_blue and not armies.is_empty() and (rules == null or rules.keep_formation)
	var blue_keep = armies[0].copy() if keep_ok else null
	armies = [Army.new(0, 100), Army.new(1, 100)]
	if rules != null and (mode == Mode.VS_AI or mode == Mode.DUEL):
		armies[0].apply_rules(rules, 0)
		armies[1].apply_rules(rules, 1)
	if mode == Mode.GAUNTLET:
		armies[0].pool = _gauntlet_pool()
		armies[1].pool = _gauntlet_pool()
	match mode:
		Mode.VS_AI:
			if blue_keep != null:
				armies[0] = blue_keep
			if rules != null and rules.fullfield == 2:
				# 第六輪：對 AI 明牌全場——AI 先在自己半場擺好並公開，你在全場離敵兵 1.5 格外擺
				_build_ai()
				ai_prebuilt = true
				armies[0].enemy_pos = []
				for u in armies[1].units:
					armies[0].enemy_pos.append(armies[1].pos_of(u))
				var keep: Array = armies[0].units.duplicate(true)
				armies[0].units = []
				for u in keep:
					var pp: Vector2i = armies[0].pos_of(u)
					armies[0].place_xy(int(u["type"]), pp.x, pp.y)   # 保留的陣型和新的明牌陣衝突的就拿掉
		Mode.DUEL:
			if bool(get("swap_ai")):
				call("_swap_ai_prep")   # 1.6.0 B18（P7.3）對 AI 換邊雙局：AI 那一色自動擺好、玩家照暗擺流程擺自己那一色
			elif duel_rule != "blind":
				tp = TP.new(armies[0], armies[1], (round_no + 1) % 2, duel_rule, rules)
				if rules == null:
					tp.armies[0].pool = _pool()
					tp.armies[1].pool = _pool()
				# 1.1.0 B2：輪序紀錄碼要開局（禁牌後）的卡池與預算
				duel_start = {"pools": [tp.armies[0].pool, tp.armies[1].pool], "budgets": [tp.armies[0].budget, tp.armies[1].budget], "rules": rules.copy() if rules != null else null}
		Mode.TUTORIAL, Mode.PUZZLE:
			var pz := PZ.get_puzzle(puzzle_id)
			armies[0] = PZ.player_army(pz)
			armies[1] = PZ.enemy_army(pz)
			selected = int(pz["allowed"][0])
			if puzzle_plan_id != puzzle_id:
				puzzle_plan = PZ.default_plan(pz)   # 第十三輪：同一關重來保留上次設定的時間，換關重設
				puzzle_plan_id = puzzle_id
		Mode.GAUNTLET:
			if not gauntlet_prev.is_empty():
				armies[0].units = gauntlet_prev.duplicate(true)
			var r := RandomNumberGenerator.new()
			r.seed = gauntlet_seed + gauntlet_stage * 7919
			var node: String = call("ga_node", gauntlet_stage)
			var lvl := 2 if node == "boss" else mini(2, (gauntlet_stage - 1) / 2 + (1 if node == "elite" else 0))
			var e := AIT.build_full(1, r, lvl, gauntlet_prev, _pool())
			set("gauntlet_nemesis", call("_nemesis_for_stage"))   # V1.4 #2：菁英站可能遇到宿敵
			# V1.1 D1：菁英 +10、首領 +20；斥候劫掠／截斷補給只影響這一戰
			e.budget = 100 + 5 * (gauntlet_stage - 1) + int(get("GA_NODE_GOLD")[node]) + int(get("gauntlet_foe_gold"))
			if node == "boss" and not _demo():
				e.budget -= BossD.BUDGET_CUT   # V1.4 #12：巨獸是送的，敵方其他兵少一點錢
			e.unit_cap = maxi(4, e.unit_cap + int(get("gauntlet_foe_cap")))
			# Codex v110-impl #2：先組好的陣可能超出調低後的預算／隻數，從最後放的往回拿掉（至少留一隻戰鬥兵）
			while e.units.size() > 1 and (e.spent() > e.budget or e.units.size() > e.unit_cap):
				e.units.pop_back()
			var guard := 0
			while e.can_afford_any() and guard < 20:
				guard += 1
				var t := AIT.choose_type(e, gauntlet_prev, e.left(), r, lvl, _pool())
				if t < 0:
					break
				var c := AIT.choose_cell(e, t, gauntlet_prev, r)
				if c.x < 0 or not e.place(t, c.x, c.y):
					break
			armies[1] = e
			if node == "boss" and not _demo():
				call("add_boss", armies[1])   # V1.4 #12：遠征終點多一隻巨獸
				_toast(L.t("boss_here") + "\n" + L.t("ps_boss"))   # V1.6 #11 首領嗆聲
			if int(get("gauntlet_nemesis")) >= 0:
				armies[1] = call("_nemesis_army", int(get("gauntlet_nemesis")))
				var nt: String = call("nemesis_title", Save.data["nemeses"][int(get("gauntlet_nemesis"))])
				ai_name = nt
				_toast(L.t("nem_back", [nt, int(Save.data["nemeses"][int(get("gauntlet_nemesis"))].get("losses", 1))]) + "\n" + L.t("ps_nemesis", [nt]))   # V1.6 #11
	if not retry_key.begins_with("tr:"):
		_apply_retry()   # 試煉的 trial_id 在 _start_mode 之後才設：由「重打」自己在 _start_trial 後套用
	sfx.play_music("music_puzzle" if mode == Mode.PUZZLE or mode == Mode.TUTORIAL else "music_place")   # V1.0.0 A1：殘局、教學用比較靜的思考曲
	sfx.play_ambience(str(MapArt.BIOME.get(MapDefs.MAPS[rules.map_id if rules != null and rules.is_free() else 0]["biome"], {}).get("sound", "")))

## V1.0.0 R1：殘局、試煉按「重打」保留上次的擺法（現在會重設成關卡初始）；擺不回去的（規則變了）就略過。
## 結果頁的「重打」設 retry_key／retry_units；換關、換模式就不帶。擺陣畫面原本的「清空」照舊可以清掉。
var retry_key := ""
var retry_units: Array = []
func retry_key_now() -> String:
	if mode == Mode.PUZZLE or mode == Mode.TUTORIAL:
		return "pz:" + puzzle_id
	if mode == Mode.VS_AI and int(get("trial_id")) >= 0:
		return "tr:%d" % int(get("trial_id"))
	return ""

func _mark_retry() -> void:
	retry_key = retry_key_now()
	retry_units = last_armies[0].units.duplicate(true) if not last_armies.is_empty() else []

func _apply_retry() -> void:
	var k := retry_key
	var us := retry_units
	retry_key = ""
	retry_units = []
	if k == "" or k != retry_key_now() or armies.is_empty():
		return
	var a = armies[0]
	for u in us:
		var p: Vector2i = Army.pos_of(u)
		var here := false
		for v in a.units:
			if int(v["type"]) == int(u["type"]) and Army.pos_of(v) == p:
				here = true   # 固定兵、已經在的
				break
		if not here:
			call("_place_from", a, u)



func _cur_army():
	if mode == Mode.DUEL:
		if tp != null:
			return tp.armies[tp.current]
		return armies[0] if blind_phase == 0 else armies[1]
	return armies[0]



func _enemy_visible() -> bool:
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE or mode == Mode.GAUNTLET:
		return true
	if mode == Mode.DUEL:
		return tp != null
	return false



func _ai_pool(r: RandomNumberGenerator) -> int:
	var p1: int = rules.pool_of(1) if rules != null else _pool()
	if rules != null and rules.ai_style != 0:
		p1 = AI.style_pool(p1, rules.ai_style, r)
	return p1
			leads.append(t + 1)
		if sg != 0:
			last_sign = sg
	report["leads"] = leads
	# 殘局星等算在報告裡（重播也看得到），只有「寫進存檔」才受副作用矩陣管（Codex S1 #8）
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
		var pz := PZ.get_puzzle(puzzle_id)
		var extra_spent: int = armies[0].spent() - (armies[0].budget - int(pz["budget"]))
		var oc := PZ.outcome(pz, sim, extra_spent)   # 第十三輪：和工具、測試同一套判定（含護送、撐住、斬首）
		report["stars"] = int(oc["stars"])
		report["goal_ok"] = bool(oc["ok"])
		report["star_lines"] = _star_lines(bool(oc["ok"]), int(oc["rem"]), int(pz["star2"]), extra_spent, int(pz["star3"]), _goal_text(pz))



func _progress_and_achievements() -> void:
	var w: int = sim.winner
	# 第五輪：紀錄分欄。平衡認證的規則（或沒有規則的模式）＝標準戰績；其他自訂規則記在自訂戰績；沙盒什麼都不記。
	var kind := "duel" if mode == Mode.DUEL else "ai"
	var badge: String = Presets.badge(rules, kind) if rules != null else Presets.BADGE_CERT
	if badge == Presets.BADGE_LAB:
		_save()
		return
	var standard: bool = rules == null or Presets.is_standard_record(rules, kind)
	if free_intro:
		Save.data["free_intro_done"] = true
		free_intro = false
	Save.data["unlock_games"] = int(Save.data.get("unlock_games", 0)) + 1   # 只是累計場數（判斷新玩家用），不解鎖任何東西
	var me_won := w == 0 or (mode == Mode.DUEL and w >= 0)
	var stat_key := "stats" if standard else "custom_stats"
	var st: Dictionary = Save.data.get(stat_key, {"wins": 0, "games": 0})
	st["games"] = int(st.get("games", 0)) + 1
	if w == 0 and mode != Mode.DUEL:
		st["wins"] = int(st.get("wins", 0)) + 1
	Save.data[stat_key] = st
	_v8_achievements(w)   # 奇幻軍是娛樂變體，要放在「自訂規則提前返回」之前（Codex 第 3 輪）
	# 圖鑑老兵筆記：派這個兵種贏一場 +1（第二輪方案 R3）。第十輪 B4：自訂規則、奇幻軍也算（放在提前返回之前）
	var types := {}
	if me_won:
		for u in sim.units:
			if u.team == w:
				types[D.report_type(u.type)] = true
		CX.record_win(Save.data, types.keys())
	if not standard:
		# 自訂規則專屬成就（標準成就只看標準局）
		if me_won and mode == Mode.VS_AI and w == 0:
			if rules.budget_of(0) <= 50:
				_ach("CUSTOM_LOWGOLD")
			if rules.budget_of(0) < rules.budget_of(1):
				_ach("CUSTOM_UNDERDOG")
		if me_won and rules.unit_cap >= 36:
			_ach("CUSTOM_BIG")
		_save()
		return
	if me_won:
		_ach("FIRST_WIN")
		if sim.alive_count(w) == 1:
			_ach("LONE_HERO")
		if int(report["sus"]["max_swing_pct"]) >= 15:
			_ach("COMEBACK")
		if sim.power(w) * 100 / (sim.budget * 1000) <= 5:
			_ach("CLOSE_CALL")
		if sim.tick >= Sim.FRENZY_TICK:
			_ach("FRENZY_WIN")
		if types.size() == 5:
			_ach("ALL_TYPES")
		if int(ev_count.get("charge%d" % w, 0)) >= 5:
			_ach("CHARGE_5")
		if int(ev_count.get("backstab%d" % w, 0)) >= 3:
			_ach("BACKSTAB_3")
	if mode == Mode.VS_AI and w == 0 and difficulty == 2:
		_ach("HARD_WIN")
	if mode == Mode.DUEL and tp != null and series_over:
		_ach("NO_TAKEBACKS")
	if series_over and ((mode == Mode.DUEL and (wins == [2, 0] or wins == [0, 2])) or (mode == Mode.VS_AI and wins == [2, 0])):
		_ach("SWEEP")
	if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and puzzle_id != "ws":   # V1.1 D3：工坊殘局不存星數
		var stars := int(report.get("stars", 0))
		var ps: Dictionary = Save.data.get("puzzle_stars", {})
		if stars > int(ps.get(puzzle_id, 0)):
			ps[puzzle_id] = stars
		Save.data["puzzle_stars"] = ps
		if mode == Mode.PUZZLE and has_method("_od_after"):
			call("_od_after", puzzle_id, stars)   # 1.3.0 §12.7 每日老闆出題
		if stars >= 1 and has_method("_coach_after_clear"):
			call("_coach_after_clear", stars)   # V1.6.1 A4：自力最佳另記
	_begin_battle(armies[0].copy(), armies[1].copy())



func _can_edit_existing() -> bool:
	return not (mode == Mode.DUEL and (tp != null or blind_phase == 2)) and not _cp_on()   # 1.2.0 §11.6：合作布陣不能清空／整軍工具（只能撤自己這一手）



func _locked() -> bool:
	return mode == Mode.DUEL and tp == null and blind_phase == 2



func _check_place(t: int, c: Vector2i) -> String:
	if _locked():
		return L.t("both_done")
	if not _allowed(t):
		return L.t("err_type")
	if mode == Mode.DUEL and tp != null:
		var why: String = tp.check_place(t, c.x, c.y)
		return _err_key(why)
	if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() + 1 > gauntlet_changes:
		return L.t("err_changes")
	if _cp_on():
		var cw: String = cp.check(D.cost(t))   # 1.2.0 §11.6 合作布陣：這一手的上限、手數
		if cw == "done":
			return L.t("cp_done")
		if cw == "cap":
			return L.t("err_hand", [cp.cap])
	return _err_key(_cur_army().check_place(t, c.x, c.y))



func _err_key(why: String) -> String:
	if why == "":
		return ""
	if why == Army.E_ZONE:
		return L.t("err_zone")
	if why == Army.E_TERRAIN:
		return L.t("err_terrain")
	if why == Army.E_TAKEN:
		return L.t("err_taken")
	if why.begins_with(Army.E_CAP_PREFIX):
		return L.t("err_max", [_cur_army().unit_cap])
	if why.begins_with("這種兵最多"):
		return L.t("err_type_cap", [_cur_army().type_cap])
	if why.begins_with("這種兵不在"):
		return L.t("err_type")
	if why.begins_with("要留錢"):
		return L.t("err_reserve")
	if why.begins_with("最後一手"):
		return L.t("err_last_hand")
	if why == Army.E_GOLD:
		return L.t("err_gold")
	if why.begins_with("這一手"):
		return L.t("err_hand", [tp.hand_cap() if tp else 10])
	return why



func _try_place(c: Vector2i) -> void:
	var why := _check_place(selected, c)
	if why == "":
		if mode == Mode.DUEL and tp != null:
			# 第五輪防手滑（Antigravity 第二輪）：輪流落子時先點一下出現預覽，再點同一格才落子；設定可關。擺下仍不能收回。
			if bool(Save.s("confirm_place")) and pending_cell != c:
				pending_cell = c
				sfx.play("k_click", 0.7)
				return
			pending_cell = Vector2i(-1, -1)
			tp.place(selected, c.x, c.y)
		else:
			_cur_army().place(selected, c.x, c.y)
			if _cp_on():
				cp.placed(c, D.cost(selected))
		show_place_help = false
		settle_t[Vector2i(c.x, c.y)] = time   # V1.3.1 P2：格子模式也有放下沉降
		sfx.play_place(selected)   # 1.3.0 §10：落子音按重量分級（22 種都有，原本只有前 10 種）
		sfx.play_wood(selected, 0.4)   # V1.6 #14：每種兵的木雕材質
	elif why != L.t("err_taken"):
		_toast(why, true)



func _try_remove(c: Vector2i) -> void:
	if _locked():
		return
	if mode == Mode.DUEL and tp != null:
		_toast(L.t("err_notakeback"), true)
		return
	if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
		_toast(L.t("err_locked"), true)
		return
	if _cp_on() and not cp.can_remove(c):
		_toast(L.t("cp_noundo"), true)   # 1.2.0 §11.6：只能撤自己這一手擺的
		return
	if mode == Mode.VS_AI and bool(call("wave_is_locked", c)):
		_toast(L.t("wv_locked"), true)   # V1.4 #11：殘兵不能撤（Antigravity v140-i3）
		return
	var rt := -1
	var ri: int = _cur_army().index_at(c.x, c.y)
	if ri >= 0:
		rt = int(_cur_army().units[ri]["type"])
	if _cur_army().remove_at(c.x, c.y):
		if _cp_on() and rt >= 0:
			cp.removed(c, D.cost(rt))
		sfx.play("k_click", 0.7)



	_fp_push_undo()
	a.units = after

func _clear_mine() -> void:
	var a = _cur_army()
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
		var pz := PZ.get_puzzle(puzzle_id)
		a.units = a.units.filter(func(u): return PZ.is_fixed(pz, u["col"], u["row"]))
	elif mode == Mode.GAUNTLET and gauntlet_stage > 1:
		a.units = gauntlet_prev.duplicate(true)
	elif mode == Mode.VS_AI and bool(get("wv_active")):
		a.units = get("wv_lock").duplicate(true)   # 車輪戰：清空只清新補的兵
	else:
		if _is_free():
			_fp_push_undo()   # 自由模式：清空可以 Ctrl＋Z 復原
		a.clear()
	fp_sel = []
	_fp_abort_drag()

## 第十三輪：時序殘局的施放時間（戰鬥中不能按，照這裡設定的秒數放）。每格 0.5 秒。
func _draw_plan_panel(R: Rect2) -> void:
	# V1.4 #4：擺陣畫面只放精簡摘要＋「排軍令」按鈕；完整的木刻度尺在 overlay（_draw_plan_overlay）
	var pz := PZ.get_puzzle(puzzle_id)
	_tex_box(R, "paper")
	_ink_mode = true
	var parts: Array = []
	for e in puzzle_plan:
		parts.append(L.t("plan_item", [L.t("cmd_%d" % PZ.plan_skill(pz, int(e))), _fmt_num(PZ.plan_tick(pz, int(e)) / 20.0)]))
	_text(R.position + Vector2(12, 8), L.t("plan_title"), tz("C"), INK, false, true, R.size.x - 24)
	_text(R.position + Vector2(12, 8 + tz("C") * 1.35), "・".join(parts), tz("C"), INK, false, false, R.size.x - 24)
	_ink_mode = false
	_btn(Rect2(R.end.x - 132, R.end.y - 46, 124, 40), L.t("plan_open"), func(): overlay = "puzzle_plan")
	if pad_mode:
		_text(Vector2(R.position.x + 10, R.position.y - tz("C") * 1.4), L.t("plan_pad"), tz("C"), TXT_DIM, false, false, R.size.x)

## V1.4 #4 軍令連鎖：連鎖的組合（先放 a、3 秒內放 b）。只是提示，模擬照原本規則算。
		armies[team].apply_rules(rules, team)
		armies[team].units = res["army"].units.duplicate(true)
	blind_phase = 1 if team == 0 else 2

func _swap_start() -> void:
	var r = RuleSet.standard()
	var dm: int = RS.mask(_demo())
	r.pool = [int(r.pool_of(0)) & dm, int(r.pool_of(1)) & dm]   # 標準卡池再扣掉試玩版沒有的兵（Codex cat10 #5）
	r.rounds = 3   # 用三戰兩勝的局數上限，實際由換邊雙局在第 2 局結束
	rules = r
	challenge_army = null
	overlay = ""
	_start_mode(Mode.DUEL)
	swap_on = true
	sw_pts = [0, 0]
	sw_dead = [0, 0]
	_toast(L.t("sw_intro"))

## 每局正式打完（_finish_battle）：記分；第 2 局後系列結束
func _swap_settle() -> void:
	if not swap_on or mode != Mode.DUEL or play_kind != "official" or sim == null:
		return
	var r: Array = SwapDuel.settle(sw_pts, sw_dead, round_no, sim)
	sw_pts = r[0]
	sw_dead = r[1]
	series_over = round_no >= SwapDuel.ROUNDS

## 擺陣頂部：誰是哪一色（第 2 局換過來）
func _swap_who() -> String:
	if swap_ai:
		return L.t("sw_ai_who", [L.t("blue") if SwapDuel.owner(round_no, 0) == 0 else L.t("red")])   # 1.6.0 B18：你＝哪一色（AI 拿另一色）
	return L.t("sw_who", [L.t("blue") if SwapDuel.owner(round_no, 0) == 0 else L.t("red"), L.t("red") if SwapDuel.owner(round_no, 0) == 0 else L.t("blue")])

## 結果頁第一條事實
func _swap_fact() -> String:
	if swap_ai:
		if not series_over:
			return L.t("sw_ai_round", [int(sw_pts[0]), int(sw_pts[1])])
		var va := SwapDuel.verdict(sw_pts, sw_dead)
		return L.t("sw_ai_final", [int(sw_pts[0]), int(sw_pts[1]), L.t("sw_ai_you") if va == 0 else (L.t("sw_ai_them") if va == 1 else L.t("sw_tie"))])
	if not series_over:
		return L.t("sw_round", [int(sw_pts[0]), int(sw_pts[1])])
	var v := SwapDuel.verdict(sw_pts, sw_dead)
	return L.t("sw_final", [int(sw_pts[0]), int(sw_pts[1]), L.t("sw_a") if v == 0 else (L.t("sw_b") if v == 1 else L.t("sw_tie"))])

## 揭封：第 k 封放回兩邊（鎖定，不能改），之後照一般「開戰」。
func _sealed_reveal(k: int) -> void:
	armies[0].units = sealed[0][k].duplicate(true)
	armies[1].units = sealed[1][k].duplicate(true)
	blind_phase = 2


