    59	## 讀一個 JSON 檔；內容不是物件就回傳 null。
    60	static func _parse(path: String):
    61		var j := JSON.new()   # 不用 JSON.parse_string：壞檔是預期情況，不該在日誌印 ERROR
    62		if j.parse(FileAccess.get_file_as_string(path)) != OK:
