   143		deploy = r.deploy
   144		spacing = r.spacing
   145		depth = r.depth_of()
   146		enemy_gap = r.ENEMY_GAP
   147		fw = r.field_w()
   148		fh = r.field_h()
   149		terrain = r.terrain()
