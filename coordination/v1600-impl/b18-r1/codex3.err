    71	func in_zone(col: int, row: int) -> bool:
    72		if row < 0 or row >= ROWS:
    73			return false
    74		if team == 0:
    75			return col >= 0 and col < ZONE
    76		return col >= COLS - ZONE and col < COLS
    77	
    78	func index_at(col: int, row: int) -> int:
    79		for i in units.size():
    80			if units[i]["col"] == col and units[i]["row"] == row:
    81				return i
    82		return -1
    83	
    84	## 回傳空字串＝可以放；否則是不能放的原因（顯示給玩家）。
    85	func check_place(t: int, col: int, row: int) -> String:
    86		if deploy == "free":
    87			return check_place_xy(t, col * 1000 + 500, row * 1000 + 500)
    88		if not in_zone(col, row):
    89			return E_ZONE
    90		if index_at(col, row) != -1:
    91			return E_TAKEN
    92		if terrain != null and terrain.blocked(col * 1000 + 500, row * 1000 + 500, team):
    93			return E_TERRAIN   # 第十三輪：地形殘局（格子放在地圖上），牆內格子不能放
    94		return _check_common(t)
    95	
    96	## 位置以外的條件（卡池、人數、單種、錢、防卡死），格子與自由共用。
    97	func _check_common(t: int) -> String:
    98		if t < 0 or t >= D.total() or (pool >> t) & 1 == 0:
    99			return E_POOL
   100		if count() >= unit_cap:
   101			return E_CAP_PREFIX + " %d 隻" % unit_cap
   102		if type_cap > 0 and count_of(t) >= type_cap:
   103			return E_TYPE_CAP_PREFIX + " %d 隻" % type_cap
   104		var hc := D.hard_cap(t)     # 第八輪：奇幻兵一隊的硬上限
   105		if hc > 0 and count_of(t) >= hc:
   106			return E_TYPE_CAP_PREFIX + " %d 隻" % hc
   107		if D.cost(t) > left():
   108			return E_GOLD
   109		if guard_combat and not D.is_combat(t) and not has_combat():
   110			var cc := cheapest_combat()
   111			if count() + 1 >= unit_cap or left() - D.cost(t) < cc:
   112				return E_RESERVE
   113		return ""
   114	
   115	## 第五輪：有沒有擺戰鬥兵（開戰條件：雙方各至少 1 隻）。
   116	func has_combat() -> bool:
   117		for u in units:
   118			if D.is_combat(int(u["type"])):
   119				return true
   120		return false
   121	
   122	func cheapest_combat() -> int:
   123		var c := 1 << 30
   124		for t in D.total():
   125			if (pool >> t) & 1 == 1 and D.is_combat(t):
   126				c = mini(c, D.cost(t))
   127		return c
   128	
   129	func cheapest_in_pool() -> int:
   130		var c := 1 << 30
   131		for t in D.total():
   132			if (pool >> t) & 1 == 1 and (type_cap == 0 or count_of(t) < type_cap):
   133				c = mini(c, D.cost(t))
   134		return c
