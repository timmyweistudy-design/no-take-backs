    35	## ── 1.6.0 B18（P7.3；§3.1）對 AI 換邊雙局的會話：存檔 swap_ai_run ──
    36	## {v, round（現在這一局 1／2）, pts, dead, settled（已記分到第幾局）, ai（這一局 AI 那一色的陣：[[兵種, 欄, 列]...]；還沒擺＝[]）}
    37	## 承諾＝AI 擺好就寫檔（重啟不重抽）；結算＝記分、settled 前進（同一局不重記）；整組結束＝刪掉。
    38	const RUN_V := 1
    39	
    40	static func _iv(x, lo: float, hi: float) -> bool:
    41		return (x is int or (x is float and float(x) == floorf(float(x)))) and float(x) >= lo and float(x) <= hi
    42	
    43	## 讀回驗型；壞了回 null（＝沒有進行中的一組）
    44	static func sanitize_run(v):
    45		if not v is Dictionary or not _iv(v.get("v"), 1, RUN_V) or not _iv(v.get("round"), 1, ROUNDS) or not _iv(v.get("settled"), 0, ROUNDS):
    46			return null
    47		var out := {"v": RUN_V, "round": int(v["round"]), "settled": int(v["settled"]), "pts": [], "dead": [], "ai": []}
    48		for k in ["pts", "dead"]:
    49			var a = v.get(k)
    50			if not a is Array or a.size() != 2 or not _iv(a[0], 0, 100000) or not _iv(a[1], 0, 100000):
    51				return null
    52			out[k] = [int(a[0]), int(a[1])]
    53		var ai = v.get("ai")
    54		if not ai is Array or ai.size() > 64:
    55			return null
    56		for u in ai:
    57			if not u is Array or u.size() != 3 or not _iv(u[0], 0, 63) or not _iv(u[1], 0, 63) or not _iv(u[2], 0, 63):
    58				return null
    59			out["ai"].append([int(u[0]), int(u[1]), int(u[2])])
    60		if out["settled"] > out["round"] or out["settled"] < out["round"] - 1:
    61			return null   # 狀態一致：這一局要嘛還沒記分（settled＝round−1）、要嘛剛記完（settled＝round）
    62		return out
