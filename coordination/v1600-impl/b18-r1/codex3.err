    44		_focus = 0
    45		var keep_ok: bool = keep_blue and not armies.is_empty() and (rules == null or rules.keep_formation)
    46		var blue_keep = armies[0].copy() if keep_ok else null
    47		armies = [Army.new(0, 100), Army.new(1, 100)]
    48		if rules != null and (mode == Mode.VS_AI or mode == Mode.DUEL):
    49			armies[0].apply_rules(rules, 0)
    50			armies[1].apply_rules(rules, 1)
    51		if mode == Mode.GAUNTLET:
    52			armies[0].pool = _gauntlet_pool()
    53			armies[1].pool = _gauntlet_pool()
    54		match mode:
    55			Mode.VS_AI:
    56				if blue_keep != null:
    57					armies[0] = blue_keep
    58				if rules != null and rules.fullfield == 2:
    59					# 第六輪：對 AI 明牌全場——AI 先在自己半場擺好並公開，你在全場離敵兵 1.5 格外擺
    60					_build_ai()
    61					ai_prebuilt = true
    62					armies[0].enemy_pos = []
    63					for u in armies[1].units:
    64						armies[0].enemy_pos.append(armies[1].pos_of(u))
    65					var keep: Array = armies[0].units.duplicate(true)
    66					armies[0].units = []
    67					for u in keep:
    68						var pp: Vector2i = armies[0].pos_of(u)
    69						armies[0].place_xy(int(u["type"]), pp.x, pp.y)   # 保留的陣型和新的明牌陣衝突的就拿掉
    70			Mode.DUEL:
    71				if duel_rule != "blind":
    72					tp = TP.new(armies[0], armies[1], (round_no + 1) % 2, duel_rule, rules)
    73					if rules == null:
    74						tp.armies[0].pool = _pool()
    75						tp.armies[1].pool = _pool()
    76					# 1.1.0 B2：輪序紀錄碼要開局（禁牌後）的卡池與預算
    77					duel_start = {"pools": [tp.armies[0].pool, tp.armies[1].pool], "budgets": [tp.armies[0].budget, tp.armies[1].budget], "rules": rules.copy() if rules != null else null}
    78			Mode.TUTORIAL, Mode.PUZZLE:
    79				var pz := PZ.get_puzzle(puzzle_id)
    80				armies[0] = PZ.player_army(pz)
    81				armies[1] = PZ.enemy_army(pz)
