   508	## 每局正式打完（_finish_battle）：記分；第 2 局後系列結束
   509	func _swap_settle() -> void:
   510		if not swap_on or mode != Mode.DUEL or play_kind != "official" or sim == null:
   511			return
   512		if sw_settled == round_no:
   513			return
