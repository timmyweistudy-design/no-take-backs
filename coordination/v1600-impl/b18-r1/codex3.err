  2673	## 印章冊：第幾頁、這頁蓋了幾格（10 的倍數＝這頁剛好蓋滿，不跳到空白新頁）
  2674	const STAMP_PER_PAGE := 10
  2675	static func stamp_page(n: int) -> Array:
