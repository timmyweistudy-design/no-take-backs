     1	extends RefCounted
     2	## 一方的陣型：預算、人數上限、部署區、格子佔用。純資料，不碰畫面。
     3	
     4	## 擺放錯誤碼（第七輪 H6）：畫面靠這些常數判斷，不再比對中文字串。查過：這些字串沒有進任何代碼或存檔。
     5	const E_ZONE := "只能放在自己的部署區"
     6	const E_TAKEN := "這格已經有兵"
     7	const E_POOL := "這種兵不在這局的卡池裡"
     8	const E_GOLD := "錢不夠"
     9	const E_RESERVE := "要留錢和名額給至少 1 隻戰鬥兵"
    10	const E_NEAR := "離其他兵太近"
    11	const E_NEAR_ENEMY := "離敵兵太近"
    12	const E_CAP_PREFIX := "最多"
    13	const E_TYPE_CAP_PREFIX := "這種兵最多"
    14	const D = preload("res://scripts/core/unit_defs.gd")
    15	const STK = preload("res://scripts/core/sticker_defs.gd")
    16	
    17	const COLS := 16
    18	const ROWS := 9
    19	const ZONE := 6          # 每邊部署區 6 欄
    20	const MAX_UNITS := 24
    21	
    22	var team: int
    23	var budget: int
    24	var units: Array = []    # 每筆 {"type", "col", "row"}
    25	# 第五輪：自訂規則的部署限制（預設值＝1.3.0 行為）
    26	var pool := (1 << D.COUNT) - 1   # 可用兵種遮罩
    27	var unit_cap := MAX_UNITS
    28	var type_cap := 0                # 單種上限，0＝不限
    29	var allow_boss := false          # V1.4 #12：只有看重播的對戰碼（紅方）可以帶巨獸；一般陣型碼、挑戰碼不行（Codex、Antigravity v140-i5）
    30	var guard_combat := false        # 防卡死：還沒擺戰鬥兵時，不准擺到買不起戰鬥兵（只有玩家擺放與 AI 用，載入舊代碼不開）
    31	# 第六輪：自由排兵（docs/history/2026-11-03-free-placement-plan-v6.md §3）
    32	# 自由部署的 units 每筆是 {"type", "x", "y"}（世界座標、量化到 50）；格子部署照舊 {"type", "col", "row"}。
    33	const W := COLS * 1000
    34	const H := ROWS * 1000
    35	const EDGE := 200
    36	const QUANT := 50
    37	const E_TERRAIN := "err_terrain"
    38	var deploy := "grid"
    39	var spacing := 1000              # 己方兩隻的最小中心距離
    40	var depth := 6000                # 自己視角 x 上限（全場＝15800）
    41	var enemy_pos: Array = []        # 全場時：敵兵的世界座標（Vector2i），離它們至少 ENEMY_GAP
    42	var enemy_gap := 1500
    43	# V9 地圖：場地大小與地形（標準＝16×9、沒有地形）
    44	var fw := W
    45	var fh := H
    46	var terrain = null
    47	
    48	func _init(p_team: int = 0, p_budget: int = 100) -> void:
    49		team = p_team
    50		budget = p_budget
    51	
    52	func spent() -> int:
    53		var s := 0
    54		for u in units:
    55			s += D.cost(u["type"])
    56		return s
    57	
    58	func left() -> int:
