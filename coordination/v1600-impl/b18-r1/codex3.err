   539	func _paint_swatch(row: int, k: int, r: Rect2, lock: bool, on: bool) -> void:
   540		var c := r.get_center()
   541		if lock:
   542			_icon("lock", c, 18.0, Color(1, 1, 1, 0.5))
   543			return
   544		match row:
   545			0, 1:
   546				_paint_well(c, 15.0, Art.PAINTS[row][k])   # 1.5.0 §13：水彩凹槽（原本是平塗圓點）
   547			2, 3:
   548				for i in 3:
   549					var a := 0.25 + 0.5 * float(i <= k)
   550					var col := Color(0.12, 0.08, 0.05, a) if row == 2 else Color(1.0, 0.95, 0.8, a)
   551					_paint_well(c + Vector2(-19 + i * 19, 0), 8.5, col)
   552			4:
   553				var wd: Array = Art.WOODS[k]
   554				draw_colored_polygon(_ellipse_pts(c + Vector2(0, 3), 26.0, 9.0), wd[0])
   555				draw_colored_polygon(_ellipse_pts(c, 26.0, 9.0), wd[1])
   556			5:
   557				draw_rect(Rect2(c - Vector2(30, 10), Vector2(60, 20)), Color("#5b4632") if k == 0 else Color(Art.FRAMES[k]))
   558				draw_rect(Rect2(c - Vector2(22, 5), Vector2(44, 10)), Color("#6f9a4a"))
   559		if on:
   560			_hand_ring(c + Vector2(35, -10), 5.0, Color("#e8c46a"), 2.0)
   561	
   562	## 調色盤上的一個瓷凹槽：白瓷緣＋上緣內陰影＋積在槽裡的顏料（下半較濃）＋一點濕亮
   563	func _paint_well(c: Vector2, r: float, col: Color) -> void:
