   531				_btn(r, "", func(): _paint_pick(rr, kk), not lock, on)
   532				_paint_swatch(row, k, r, lock, on)
   533			y += rh
   534		if ach_n < int(PAINT_UNLOCK[3]):
   535			_text(Vector2(x0, y + 4), L.t("paint_unlock", [ach_n]), tz("C"), TXT_DIM, false, false, 570)
   536		_btn(Rect2(560, 672, 160, 44), L.t("paint_done"), func(): _paint_close(), true, true)
