你是《落子無悔》(Godot 4.6.2) 1.6.0 實作的程式審查（B18 第 3 輪＝最後一輪）。只讀。專案根目錄＝目前資料夾。
第 2 輪 coordination/v1600-impl/b18-r1/codex2.md（不可 3 條）；新差異 diff3.patch（同資料夾，基準＝B17 快照）。
處理：①勝場（stats.wins）與兵種勝場都改依 `swap_ai_my_color`；②會話照 §3.1 寫檔：`swap_ai_run`｛v, round, pts, dead, settled, ai｝——AI 擺好＝承諾寫檔（重啟照存的陣擺回、不重抽）、記分＝settled 前進（同一局不重記，重啟後也是）、整組結束刪掉、寫檔失敗照實說；讀回 `sanitize_run` 驗型與一致性；每局的統計照一般對局記（不是「放棄＝不記」，第 2 輪那句裁決撤回）；③順帶（§3.1 塔路線「讀到較新版本＝唯讀」）：新版存的 tower_route 原樣保留、不遷移不覆寫，塔入口提示需要新版。
只看修正是否正確、有沒有新問題。附行號。最多 3 條、200 字內。最後一行「結論：可／有條件／不可」。
# B18 換邊雙局（對 AI）＋棋譜集（P7.3、P7.4）計畫

方案 §4 B18：§3.1 會話邊界；鏡像場分數。前置 B17。在 B17 快照之上做（`build/cg/b18`），B17、B18 一起搬回。回退：退一般對 AI。
- P7.3 對 AI 換邊雙局：沿用 1.2.0 `SwapDuel`（分數＝剩餘戰力百分比、跟著人走；平手比倒下數）與暗擺流程（`blind_phase`）。新旗標 `swap_ai`：第 1 局你擺藍→按「準備好」AI 立刻擺紅（`_swap_ai_fill(1)`）→可開戰；第 2 局開局 AI 先擺藍（`_swap_ai_prep`）→輪到你擺紅。AI 用一般難度組陣，種子取自本局亂數（重播、代碼照常）。對 AI 版關掉封蠟戰書、不走輪流落子（tp）。文字改成「你／AI」。入口在「對戰」牌（新）；結果頁「再來一組」照原樣（對 AI 版再開對 AI 版）；換模式清旗標。
  - 鏡像場分數：SwapDuel 原規則（同一組規則兩局、各當一次藍紅），本批不改計分。
- P7.4 棋譜集（名局收冊）：棋譜本加頁籤「我收的／棋館名局」。名局＝`tools/gen_famous.gd` 從固定種子掃 AI 對 AI，挑勝方剩不到兩成（≤15%）、打超過 40 秒的前 6 場，存 `data/famous_games.json`（代碼＋勝方＋剩餘＋秒數）。文字只寫這三個事實；看＝走看對戰代碼的路。
- 測試 `test_swap_ai_v1600`（modes_live）、`test_famous_v1600`（coach_lab：6 場重算都和資料一樣）。截圖 `v160_18a_famous`；`01b_hub_play` 多一張牌。
--- a/game/scripts/ui/screens/game_core.gd
+++ b/game/scripts/ui/screens/game_core.gd
@@ -68,7 +68,9 @@
 					var pp: Vector2i = armies[0].pos_of(u)
 					armies[0].place_xy(int(u["type"]), pp.x, pp.y)   # 保留的陣型和新的明牌陣衝突的就拿掉
 		Mode.DUEL:
-			if duel_rule != "blind":
+			if bool(get("swap_ai")):
+				call("_swap_ai_prep")   # 1.6.0 B18（P7.3）對 AI 換邊雙局：AI 那一色自動擺好、玩家照暗擺流程擺自己那一色
+			elif duel_rule != "blind":
 				tp = TP.new(armies[0], armies[1], (round_no + 1) % 2, duel_rule, rules)
 				if rules == null:
 					tp.armies[0].pool = _pool()
@@ -344,6 +346,8 @@
 		free_intro = false
 	Save.data["unlock_games"] = int(Save.data.get("unlock_games", 0)) + 1   # 只是累計場數（判斷新玩家用），不解鎖任何東西
 	var me_won := w == 0 or (mode == Mode.DUEL and w >= 0)
+	if bool(get("swap_ai")) and mode == Mode.DUEL:
+		me_won = w >= 0 and w == int(call("swap_ai_my_color"))   # 1.6.0 B18：對 AI 換邊雙局只有你那一色贏才算你贏（Codex B18 r1）
 	var stat_key := "stats" if standard else "custom_stats"
 	var st: Dictionary = Save.data.get(stat_key, {"wins": 0, "games": 0})
 	st["games"] = int(st.get("games", 0)) + 1
--- a/game/scripts/ui/screens/game_place.gd
+++ b/game/scripts/ui/screens/game_place.gd
@@ -172,6 +172,8 @@
 				_toast(L.t("sealed_swap"))   # Antigravity v140-i3：第三封封完要說換人
 			return
 		blind_phase += 1
+		if blind_phase == 1 and bool(get("swap_ai")):
+			call("_swap_ai_fill", 1)   # 1.6.0 B18：玩家擺好藍方＝AI 擺紅方，直接可以開戰
 		sfx.play("turn")
 		return
 	if armies[0].count() == 0 and not _full_blocked_ok():
@@ -197,8 +199,10 @@
 	_on_start_go()
 
 func _on_start_go() -> void:
-	last_player_formation = armies[0].units.duplicate(true)
-	if mode == Mode.VS_AI or mode == Mode.DUEL or mode == Mode.GAUNTLET:
+	var ai_blue: bool = bool(get("swap_ai")) and int(call("swap_ai_my_color")) == 1   # 1.6.0 B18：你擺紅的那一局，藍方是 AI 的陣（不記成你的上一陣；Codex B18 r1）
+	if not ai_blue:
+		last_player_formation = armies[0].units.duplicate(true)
+	if (mode == Mode.VS_AI or mode == Mode.DUEL or mode == Mode.GAUNTLET) and not ai_blue:
 		Save.data["last_form"] = armies[0].to_code()   # 1.2.0 §11.1「複製上一陣」（下次擺陣按 L）
 	_begin_battle(armies[0].copy(), armies[1].copy())
 
--- a/game/scripts/ui/screens/game_playroom.gd
+++ b/game/scripts/ui/screens/game_playroom.gd
@@ -409,6 +409,38 @@
 var sw_pts := [0, 0]    # 玩家 A、B 的分數（剩餘戰力百分比合計）
 var sw_dead := [0, 0]   # 玩家 A、B 兩局合計倒下數
 
+var swap_ai := false   # 1.6.0 B18（P7.3）：對 AI 換邊雙局（第 1 局你藍、第 2 局你紅；AI 擺另一色）
+
+func _swap_ai_start() -> void:
+	_swap_start()
+	swap_ai = true
+	sealed_off_for_swap()
+	_reset_place()   # 用對 AI 的擺法重開這一局（_start_mode 時還沒設 swap_ai）
+	_toast(L.t("sw_ai_intro"))
