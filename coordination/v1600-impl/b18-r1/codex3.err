  2739	## 契約卡的說明：三層逐層算封頂後實際加多少（全滿＝原句、全封頂＝已到上限、部分＝逐層列出；Codex B17 r2）
  2740	static func fork_contract_text(f: int, mask: int) -> String:
  2741		var eff: Array = []
  2742		for k in Tower.CONTRACT_SPAN:
  2743			eff.append(Tower.route_effect(f + k, Tower.CONTRACT_BONUS, mask))
  2744		if eff.all(func(x): return int(x) == Tower.CONTRACT_BONUS):
  2745			return L.t("tw_fork_c_d", [Tower.CONTRACT_SPAN, Tower.CONTRACT_BONUS])
  2746		if eff.all(func(x): return int(x) == 0):
  2747			return L.t("tw_fork_c_cap", [Tower.CONTRACT_SPAN])
  2748		var parts: PackedStringArray = []
  2749		for x in eff:
  2750			parts.append("+%d" % int(x))
  2751		return L.t("tw_fork_c_part", ["／".join(parts)])
