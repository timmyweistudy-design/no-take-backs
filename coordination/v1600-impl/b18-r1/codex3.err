    69	static var quarantine_failed := false
    70	static func _quarantine(path: String) -> bool:
    71		if int(fail_inject.get("quarantine", 0)) > 0:
    72			fail_inject["quarantine"] -= 1   # 測試用：模擬隔離失敗
    73			quarantine_failed = true
    74			return false
    75		var dst := ""
    76		for n in range(1, 21):
    77			if not FileAccess.file_exists("%s.corrupt%d" % [path, n]):
    78				dst = "%s.corrupt%d" % [path, n]
    79				break
    80		if dst == "":
    81			dst = "%s.corrupt_%d_%d" % [path, int(Time.get_unix_time_from_system()), Time.get_ticks_msec()]
    82		if DirAccess.rename_absolute(path, dst) == OK:
    83			return true
    84		if DirAccess.copy_absolute(path, dst) == OK and DirAccess.remove_absolute(path) == OK:
    85			return true

