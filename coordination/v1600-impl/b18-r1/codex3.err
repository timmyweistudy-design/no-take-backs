    21	const EV_DEATH := "death"
    22	
    23	
    24	func _reset_place(keep_blue := false) -> void:
    25		state = St.PLACE
    26		if bool(get("cp_on")):
    27			call("_cp_reset")   # 1.2.0 §11.6：每一局重新輪手（藍軍保留時，已有的兵不算任何人這一手）
    28		sim = null
    29		view = null
    30		pending_cell = Vector2i(-1, -1)
    31		ai_prebuilt = false
    32		_fp_reset()
    33		# 第一次進擺放畫面自動打開操作說明（第五輪：說明從頂部移到「?」）
    34		if not bool(Save.data.get("seen_place_help", false)) and (mode == Mode.VS_AI or mode == Mode.DUEL) and shot_dir == "":
    35			show_place_help = true
    36			Save.data["seen_place_help"] = true
    37		fx.clear()
    38		frags.clear()   # 1.2.0 §8.2
    39		dying.clear()
    40		zoom = 1.0
    41		tp = null
    42		blind_phase = 0
