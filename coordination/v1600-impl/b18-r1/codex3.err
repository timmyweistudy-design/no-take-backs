   461	func _paint_apply() -> void:
   462		var p = Save.data.get("paint", [0, 0, 1, 1, 0, 0])
   463		var ach_n: int = Save.data.get("achievements", []).size() + Campaign.cleared(Save.data)   # 1.2.0 §11.7：每通一章戰役＋1
   464		if p is Array and p.size() == 6:
   465			for i in 6:
   466				var v := clampi(int(p[i]), 0, int(PAINT_HI[i]))
   467				if paint_locked(bool(PAINT_ROWS[i][2]), v, ach_n):
   468					v = 0   # 存檔被改過、或成就被重置：鎖住的選項退回原色（Antigravity v140-i4）
   469				Art.paint[i] = v
   470	
   471	static func paint_locked(row_locks: bool, k: int, ach_n: int) -> bool:
   472		return row_locks and ach_n < int(PAINT_UNLOCK[clampi(k, 0, 3)])
