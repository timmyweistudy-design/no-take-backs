   463	## AI 擺 team 這一色（一般難度的組陣；種子取自本局亂數，重播、代碼照常）
   464	func _swap_ai_fill(team: int) -> void:
   465		if not sw_resume_ai.is_empty():
   466			# 續局：這一局 AI 的陣早就承諾過了，照存的擺回去
   467			var a = Army.new(team, armies[team].budget)
   468			if rules != null:
   469				a.apply_rules(rules, team)
   470			for u in sw_resume_ai:
   471				a.place(int(u[0]), int(u[1]), int(u[2]))
   472			armies[team] = a
   473			sw_resume_ai = []
   474		else:
   475			var r := RandomNumberGenerator.new()
   476			r.seed = rng.randi()
   477			var p: int = int(armies[team].pool)
   478			var res = AI.build(team, armies[team].budget, r, -1, p, rules)
   479			var units: Array = res["army"].units.duplicate(true)
   480			armies[team] = res["army"]
   481			if rules != null:
   482				armies[team].apply_rules(rules, team)
   483				armies[team].units = units
   484		blind_phase = 1 if team == 0 else 2
   485		_swap_ai_commit(SwapDuel.units_of(armies[team]))   # 承諾：AI 的陣寫檔（重啟不重抽）
