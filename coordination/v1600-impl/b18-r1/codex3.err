   426	## 每局正式打完（_finish_battle）：記分；第 2 局後系列結束
   427	func _swap_settle() -> void:
   428		if not swap_on or mode != Mode.DUEL or play_kind != "official" or sim == null:
   429			return
   430		var r: Array = SwapDuel.settle(sw_pts, sw_dead, round_no, sim)
   431		sw_pts = r[0]
   432		sw_dead = r[1]
   433		series_over = round_no >= SwapDuel.ROUNDS
   434	
   435	## 擺陣頂部：誰是哪一色（第 2 局換過來）
   436	func _swap_who() -> String:
   437		return L.t("sw_who", [L.t("blue") if SwapDuel.owner(round_no, 0) == 0 else L.t("red"), L.t("red") if SwapDuel.owner(round_no, 0) == 0 else L.t("blue")])
   438	
   439	## 結果頁第一條事實
   440	func _swap_fact() -> String:
   441		if not series_over:
   442			return L.t("sw_round", [int(sw_pts[0]), int(sw_pts[1])])
   443		var v := SwapDuel.verdict(sw_pts, sw_dead)
   444		return L.t("sw_final", [int(sw_pts[0]), int(sw_pts[1]), L.t("sw_a") if v == 0 else (L.t("sw_b") if v == 1 else L.t("sw_tie"))])
