   775	## V9：系列每局換地圖。換圖後舊陣型不一定放得下，所以不保留陣型。
   776	func _apply_map_mode() -> void:
   777		if rules == null or rules.map_mode == 0 or not rules.is_free():
   778			return
   779		var n: int = MapDefs.MAPS.size()
   780		rules.map_id = wrapi(rules.map_id + 1, 0, n) if rules.map_mode == 1 else rng.randi_range(0, n - 1)
   781		rules.keep_formation = false
   782		rules.vents = false
   783	
   784	func _next_round() -> void:
   785		if series_over and bool(get("sealed_on")) and mode == Mode.DUEL:
   786			call("_sealed_start")   # V1.4 #13：三戰打完再來＝重新封三陣（不是重打同一組，Antigravity v140-i3）
   787			return
   788		if series_over and bool(get("swap_on")) and mode == Mode.DUEL:
   789			call("_swap_start")   # 1.2.0 §11.5：再來一組換邊雙局（分數歸零）
   790			return
   791		if series_over:
   792			wins = [0, 0]
   793			round_no = 1
   794			series_over = false
   795			last_player_formation = []
   796			_reset_place(false)
   797			return
   798		round_no += 1
   799		_apply_map_mode()
   800		_reset_place(mode == Mode.VS_AI)
   801		if bool(get("sealed_on")) and mode == Mode.DUEL:
   802			# V1.4 #13：下一局直接用封好的陣，不再擺
   803			var k := clampi(round_no - 1, 0, 2)
   804			call("_sealed_reveal", k)
   805			_toast(L.t("sealed_open", [k + 1]))
