   840	func _result_line1(maxw := 0.0) -> String:
   841		var reason_key := {"全滅": "reason_wipe", "同時全滅": "reason_bothwipe", "時間到・戰力相當": "reason_time_even",
   842			"時間到・剩餘戰力較高": "reason_time_power", "有一方沒有兵": "reason_empty"}
   843		var p0 := roundi(sim.power(0) * 100.0 / (sim.budget_of(0) * 1000))
   844		var p1 := roundi(sim.power(1) * 100.0 / (sim.budget_of(1) * 1000))
   845		var a := "%s・%.1fs" % [L.t(reason_key.get(sim.reason, "draw")), sim.tick / 20.0]
   846		var b := L.t("power_left", [p0, p1])
   847		var one := "%s　｜　%s" % [a, b]
   848		# V1.2.1 B1：放不下就在「｜」那裡分兩行（原因／戰力），不讓百分比孤零零掉到下一行
   849		if maxw > 0.0 and _width(one, tz("S")) > maxw:
   850			return a + "\n" + b
