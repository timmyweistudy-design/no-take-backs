   407	## 跟原本比改了幾隻（換兵種、移位、拿掉、新增都算一隻）。
   408	static func review_changes(orig, now) -> int:
   409		if orig.deploy == "free":
   410			var ma := {}
   411			for u in orig.units:
   412				ma[int(u.get("eid", -1))] = [int(u["type"]), int(u["x"]), int(u["y"])]
   413			var n := 0
   414			var seen := {}
   415			for u in now.units:
   416				var e := int(u.get("eid", -1))
   417				seen[e] = true
   418				if not ma.has(e) or ma[e] != [int(u["type"]), int(u["x"]), int(u["y"])]:
   419					n += 1
   420			for e in ma:
   421				if not seen.has(e):
   422					n += 1
   423			return n
   424		var a := {}
   425		var b := {}
   426		for u in orig.units:
   427			a["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   428		for u in now.units:
   429			b["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   430		var gone := 0
   431		var added := 0
   432		for k in a:
   433			if not b.has(k) or b[k] != a[k]:
   434				gone += 1
   435		for k in b:
   436			if not a.has(k) or a[k] != b[k]:
   437				added += 1
   438		return maxi(gone, added)
   439	
   440	func _rv_try(edit: Callable) -> void:
   441		var before = rv_army.copy()
   442		edit.call()
   443		if review_changes(rv_orig, rv_army) > 1:
   444			rv_army = before
   445			_toast(L.t("rv_one"), true)
   446			return
   447		_rv_dirty()
   448	
   449	func _rv_cell(c: Vector2i) -> void:
   450		if rv_tab != 0:
   451			return   # 1.6.0 B07（Codex r1 #1）：讀結果頁只看，不能改陣
   452		if rv_sel.x >= 0 and rv_army.index_at(rv_sel.x, rv_sel.y) != -1 and rv_army.index_at(c.x, c.y) == -1:
   453			var from := rv_sel
   454			_rv_try(func(): rv_army.move(from.x, from.y, c.x, c.y))
   455			rv_sel = c
   456			return
   457		rv_sel = c
