   826					break   # 試玩版沒有下一關的兵
   827				if _demo() and mode == Mode.PUZZLE and i + 1 >= Presets.DEMO_PUZZLES:
   828					break   # 試玩版只有第一章前幾關
   829				puzzle_id = nx["id"]
   830				_start_mode(mode)
   831				return
   832		if mode == Mode.TUTORIAL and not PZ.puzzles().is_empty():
   833			puzzle_id = PZ.puzzles()[0]["id"]
   834			_start_mode(Mode.PUZZLE)
   835			return
