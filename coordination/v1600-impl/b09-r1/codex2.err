    41			_files(s, files)
    42		var ctx := HashingContext.new()
    43		ctx.start(HashingContext.HASH_SHA256)
    44		var n := 0
    45		for f in files:
    46			var txt := FileAccess.get_file_as_string(f) if FileAccess.file_exists(f) else "<缺檔>"
    47			ctx.update(("%s\n" % f).to_utf8_buffer())
    48			ctx.update(txt.to_utf8_buffer())
    49			n += 1
    50		if n == 0:
    51			return ""
    52		return ctx.finish().hex_encode().substr(0, 16)
