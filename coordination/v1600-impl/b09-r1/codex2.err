  1632	## 加 --no-pack＝即時烘焙對照。用法：<exe> --path game --resolution 1280x800 -- --pack-bench=<json 絕對路徑> [--no-pack] [--bench-blank]
  1633	func _bench_wait(cb: bool) -> Dictionary:
  1634		var t0 := Time.get_ticks_msec()
  1635		var last := Time.get_ticks_usec()
  1636		var frames: Array = []
  1637		var m0 := Performance.get_monitor(Performance.MEMORY_STATIC)
  1638		var mpk := m0
  1639		var g := 0
  1640		while sprites != null and not (sprites.build_done and sprites.is_ready(cb) and not sprites._busy and not sprites._ta_busy) and g < 3000:
  1641			g += 1
  1642			await RenderingServer.frame_post_draw
  1643			var now := Time.get_ticks_usec()
  1644			frames.append(snappedf((now - last) / 1000.0, 0.1))
  1645			last = now
  1646			mpk = maxf(mpk, Performance.get_monitor(Performance.MEMORY_STATIC))
  1647		return {"ms": Time.get_ticks_msec() - t0, "longest_frame_ms": frames.max() if not frames.is_empty() else 0.0, "first2": frames.slice(0, 2),
  1648			"after2_max": frames.slice(2).max() if frames.size() > 2 else 0.0, "frames": frames.size(), "temp_peak_mib": snappedf((mpk - m0) / 1048576.0, 0.1)}
  1649	
  1650	func _run_pack_bench(out_path: String) -> void:
  1651		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
  1652		DisplayServer.window_set_position(Vector2i(-4000, -4000))
  1653		var blank := "--bench-blank" in OS.get_cmdline_user_args()
  1654		if blank:
  1655			visible = false   # 只量烘焙本身：畫面不畫
  1656		var cold: Dictionary = await _bench_wait(false)
  1657		var warm: Array = []
  1658		for i in 20:
  1659			var cb := i % 2 == 0
  1660			sprites.build(cb)
  1661			var w: Dictionary = await _bench_wait(cb)
  1662			w["cb"] = cb
  1663			warm.append(w)
  1664		var AP = preload("res://scripts/ui/atlas_pack.gd")
  1665		var rep := {"blank": blank, "pack": AP.usable(), "why": AP.why, "misses": AP.misses, "cold": cold, "warm": warm, "stats": sprites.pack_stats.duplicate(), "stages": sprites.stage_report(),
  1666			"tex_mib": snappedf(Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED) / 1048576.0, 0.1), "static_mib": snappedf(Performance.get_monitor(Performance.MEMORY_STATIC) / 1048576.0, 0.1)}
  1667		var f := FileAccess.open(out_path, FileAccess.WRITE)
  1668		f.store_string(JSON.stringify(rep, "  "))
  1669		f.close()
  1670		get_tree().quit()
