   172				return await _post_vp(vpw, per_w), wsz)   # 第 11 大類：直接拿視窗貼圖跑後處理，省一次讀回＋上傳
   173			if g0 != _gen or (1 if cb else 0) != ready_cb:
   174				return
   175			wt_pages.append(_mk_tex(imw))
   176			for k in chunk.size():
   177				wt_loc[chunk[k]] = [pg, k * 2 * per_w]
   178			pg += 1
   179	
   180	## V1.5.1：這場出場的兵種補烘轉身出手格（背景烘；還沒好之前照舊轉正出手）。
   181	func ensure_turn_atk(types: Array) -> void:
   182		for t in types:
   183			ta_wanted.erase(t)
   184			ta_wanted.append(t)
   185		while ta_wanted.size() > TA_MAX:
   186			ta_wanted.pop_front()
   187		if DisplayServer.get_name() == "headless" or ready_cb < 0:
   188			return
   189		for t in types:
   190			if ta_tex.has(t) and bw_tex.has(t):
   191				ta_order.erase(t)
   192				ta_order.append(t)
   193				bw_order.erase(t)
   194				bw_order.append(t)   # 背面頁和轉身出手頁一起刷新（Codex cat05 #3）
   195			elif not t in _ta_queue:
   196				_ta_queue.append(t)
   197		if _ta_busy or _ta_queue.is_empty():
   198			return
   199		_ta_busy = true
   200		var g0 := _gen
   201		while not _ta_queue.is_empty():
   202			var t: int = _ta_queue.pop_front()
   203			var img: Image = await _baked("ta%d" % t, func() -> Image:
   204				var pt := _ExtraPainter.new()
   205				pt.cb = ready_cb == 1
   206				pt.mode = 3
   207				pt.types = [t]
   208				var vp: SubViewport = await _paint_steps(Vector2i(COLS * CELL, 2 * CELL), pt, ATK_FRAMES * 2 * 2)
   209				return await _post_vp(vp, ATK_FRAMES * 2), Vector2i(COLS * CELL, 2 * CELL))   # 第 11 大類：直接拿視窗貼圖跑後處理，省一次讀回＋上傳
   210			if g0 != _gen:
   211				return
   212			ta_tex[t] = _mk_tex(img)
   213			ta_order.erase(t)
   214			ta_order.append(t)
   215			while ta_order.size() > TA_MAX:
   216				ta_tex.erase(ta_order.pop_front())   # 超過上限：丟最久沒用的
   217			if not bw_tex.has(t):
   218				var imb: Image = await _baked("bw%d" % t, func() -> Image:
   219					var pb := _ExtraPainter.new()
   220					pb.cb = ready_cb == 1
   221					pb.mode = 4
   222					pb.types = [t]
   223					var vpb: SubViewport = await _paint_steps(Vector2i(COLS * CELL, CELL), pb, 2 * WT_PH)
   224					return await _post_vp(vpb, WT_PH), Vector2i(COLS * CELL, CELL))
   225				if g0 != _gen:
   226					return
   227				bw_tex[t] = _mk_tex(imb)
   228				bw_order.erase(t)
   229				bw_order.append(t)
   230				while bw_order.size() > BW_MAX:
   231					bw_tex.erase(bw_order.pop_front())
   232		_ta_busy = false
   233	
   234	## 1.3.0 §5.4 往北走（背對鏡頭）：有背面走路頁就畫，回傳 true；沒有（還沒烘好、簡化介面）回 false，呼叫端照舊畫側面。
   235	func draw_back_walk(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, hurt: float, alpha: float, t: float, scale := 1.0, lean := 0.0, crouch := 1.0, cb := false) -> bool:
   236		if not bw_tex.has(type) or walk <= 0.0:
   237			return false
   238		var ph := int(fposmod(walk, TAU) / TAU * WT_PH) % WT_PH
   239		_draw_cell(ci, bw_tex[type], team * WT_PH + ph, p, type, team, face, hurt, alpha, t, scale, lean, crouch, false, 0, cb, BW_C, 0.0001 + (ph + 0.5) * TAU / WT_PH)
   240		return true
   241	
   242	## 這場要用到的兵種。缺的才烘；烘的時候呼叫端先直接畫。
   243	func ensure(types: Array) -> void:
   244		if DisplayServer.get_name() == "headless" or ready_cb < 0:
   245			return
   246		for t in types:
   247			if not loc.has(t) and not t in _queue and not t in _baking:
   248				_queue.append(t)
   249		if _busy or _queue.is_empty():
   250			return
   251		_busy = true
   252		var g0 := _gen   # 世代變了（build 清空並重設狀態）就不再碰共用狀態（Codex v120-final）
   253		while not _queue.is_empty():
   254			var chunk: Array = _queue.slice(0, TYPES_PER_PAGE)
   255			_queue = _queue.slice(chunk.size())
   256			_baking = chunk
   257			await _bake_page(chunk)
   258			if g0 != _gen:
   259				return
   260			_baking = []
   261		_busy = false
   262	
   263	func _viewport(size: Vector2i, painter: Node) -> SubViewport:
   264		var vp := SubViewport.new()
   265		vp.size = size
   266		vp.transparent_bg = true
   267		vp.render_target_update_mode = SubViewport.UPDATE_ONCE
   268		vp.add_child(painter)
   269		add_child(vp)
   270		return vp
   271	
   272	const PAINT_CHUNK := 28   # 每幀最多畫幾格（一種兵一隊的一整組影格）
   273	
   274	## 1.2.0 §15.2：分段畫進同一個視窗（第一次清空、之後累積），每幀最多 PAINT_CHUNK 格；回傳畫好的視窗（呼叫端讀回後釋放）。
   275	## 1.6.0 B01（P10.1）：烘焙各段耗時——讀回（GPU→CPU）、上傳（建貼圖）、每段畫格；[次數, 總 µs, 最大 µs]。量測用，不影響畫面。
   276	var stage_stats := {}
   277	func _stat(k: String, us: int) -> void:
   278		var e: Array = stage_stats.get(k, [0, 0, 0])
   279		stage_stats[k] = [int(e[0]) + 1, int(e[1]) + us, maxi(int(e[2]), us)]
   280	
   281	func _mk_tex(img: Image) -> ImageTexture:
   282		var t0 := Time.get_ticks_usec()
   283		var t := ImageTexture.create_from_image(img)
   284		_stat("upload", Time.get_ticks_usec() - t0)
   285		return t
   286	
   287	func stage_report() -> Dictionary:
   288		var out := {}
   289		for k in stage_stats:
   290			var e: Array = stage_stats[k]
   291			out[k] = {"n": e[0], "total_ms": snappedf(int(e[1]) / 1000.0, 0.1), "max_ms": snappedf(int(e[2]) / 1000.0, 0.1)}
   292		return out
   293	
   294	## ── 1.6.0 B09（S7）離線包 ──
   295	var pack_capture := false          # --bake-pack：照常畫，畫完存進包
   296	var pack_pages: Array = []         # 烘包時留每頁 [兵種, 原圖]（自我核對：拼回來要逐像素一樣）
   297	var pack_stats := {"hit": 0, "paint": 0}
   298	
   299	func _pack_on() -> bool:
   300		return not pack_capture and Art.paint_sig() == AtlasPack.DEFAULT_PAINT and AtlasPack.usable()
   301	
   302	## 背景執行緒讀包＋驗像素雜湊（主執行緒只等）；壞檔、錯圖回 null。cb 在請求時固定（Codex B09 r1 #3）
   303	func _load_raw(key: String, cb0: int) -> Image:
   304		var p := AtlasPack.path(cb0, key)
   305		if not ResourceLoader.exists(p):
   306			return null
   307		var t0 := Time.get_ticks_usec()
   308		var ok := [false]
   309		var task := WorkerThreadPool.add_task(func(): ok[0] = AtlasPack.verify_file(cb0, key))   # 先驗檔（位元組雜湊）再讀
   310		while not WorkerThreadPool.is_task_completed(task):
   311			await RenderingServer.frame_post_draw
   312		WorkerThreadPool.wait_for_task_completion(task)
   313		if not ok[0] or ResourceLoader.load_threaded_request(p, "Image") != OK:
   314			return null
   315		while ResourceLoader.load_threaded_get_status(p) == ResourceLoader.THREAD_LOAD_IN_PROGRESS:
   316			await RenderingServer.frame_post_draw
   317		_stat("pack_wait", Time.get_ticks_usec() - t0)   # 牆鐘時間（跨幀），不是單幀成本
   318		return ResourceLoader.load_threaded_get(p) as Image
   319	
   320	## 一次只讀一份包（暫存上限：拼頁＝一頁＋一條，約 28 MiB；Codex B09 r1 #5）
   321	var _pack_lock := false
   322	func _lock() -> void:
   323		while _pack_lock:
   324			await RenderingServer.frame_post_draw
   325		_pack_lock = true
   326	
   327	## 一張圖：預設外觀＋包能用＝讀包；否則照舊畫（make 是會 await 的做法），烘包時順便存。
   328	## await 回來世代變了（build 重來）＝回 null，不算命中也不停用包（呼叫端的世代檢查會丟掉這批；Codex B09 r1 #3）
   329	func _baked(key: String, make: Callable, size: Vector2i) -> Image:
   330		var g0 := _gen
   331		var cb0 := ready_cb
   332		if _pack_on():
   333			await _lock()
   334			var im: Image = await _load_raw(key, cb0) if g0 == _gen else null
   335			_pack_lock = false
   336			if g0 != _gen:
   337				return null
   338			if im != null and im.get_size() == size:
   339				pack_stats["hit"] += 1
   340				return im
   341			AtlasPack.fail(key, "缺檔、壞檔或像素雜湊不符" if im == null else "尺寸 %s≠%s" % [im.get_size(), size])
   342		var img: Image = await make.call()
   343		pack_stats["paint"] += 1
   344		if pack_capture and img != null:
   345			AtlasPack.save(ready_cb, key, img)
   346		return img
   347	
   348	## 一頁裡第 k 種兵的格子（2 隊 × FRAMES_PER＝56 格）抄成一條（16 欄 × 4 列）；包以兵種為單位，頁怎麼組都拼得回來
   349	static func strip_of(page: Image, k: int) -> Image:
   350		var per := 2 * FRAMES_PER
   351		var s := Image.create(COLS * CELL, int(ceil(float(per) / COLS)) * CELL, false, page.get_format())
   352		for c in per:
   353			var src := k * per + c
   354			s.blit_rect(page, Rect2i((src % COLS) * CELL, (src / COLS) * CELL, CELL, CELL), Vector2i((c % COLS) * CELL, (c / COLS) * CELL))
   355		return s
   356	
   357	static func page_from(strips: Array, rows: int) -> Image:
   358		var per := 2 * FRAMES_PER
   359		var pg := Image.create(COLS * CELL, rows * CELL, false, (strips[0] as Image).get_format())
   360		for k in strips.size():
   361			_blit_strip(pg, strips[k], k)   # 和執行時拼頁同一個函式
   362		return pg
   363	
   364	## 由兵種條拼頁：一條一條讀、在背景執行緒貼進頁、貼完就放掉（同時只有一頁＋一條在記憶體）
   365	func _assemble(types: Array, rows: int) -> Image:
   366		var g0 := _gen
   367		var cb0 := ready_cb
   368		var want := Vector2i(COLS * CELL, int(ceil(float(2 * FRAMES_PER) / COLS)) * CELL)
   369		await _lock()
   370		var page: Image = null
   371		for k in types.size():
   372			var s: Image = await _load_raw("type%d" % types[k], cb0) if g0 == _gen else null
   373			if s == null or s.get_size() != want or g0 != _gen:
   374				_pack_lock = false
   375				return null
   376			if page == null:
   377				page = Image.create(COLS * CELL, rows * CELL, false, s.get_format())
   378			var kk := k
   379			var task := WorkerThreadPool.add_task(func(): _blit_strip(page, s, kk))   # 貼格在背景執行緒
   380			while not WorkerThreadPool.is_task_completed(task):
   381				await RenderingServer.frame_post_draw
   382			WorkerThreadPool.wait_for_task_completion(task)
   383		_pack_lock = false
   384		return page if g0 == _gen else null
   385	
   386	static func _blit_strip(pg: Image, s: Image, k: int) -> void:
   387		var per := 2 * FRAMES_PER
   388		for c in per:
   389			var dst := k * per + c
   390			pg.blit_rect(s, Rect2i((c % COLS) * CELL, (c / COLS) * CELL, CELL, CELL), Vector2i((dst % COLS) * CELL, (dst / COLS) * CELL))
   391	
   392	func _paint_steps(size: Vector2i, painter: Node, total: int) -> SubViewport:
   393		painter.cell_from = 0
   394		painter.cell_to = PAINT_CHUNK
   395		var vp := _viewport(size, painter)
   396		vp.render_target_clear_mode = SubViewport.CLEAR_MODE_ONCE
   397		await RenderingServer.frame_post_draw
   398		var c0 := PAINT_CHUNK
   399		while c0 < total:
   400			var t_pf := Time.get_ticks_usec()
   401			painter.cell_from = c0
   402			painter.cell_to = c0 + PAINT_CHUNK
   403			painter.queue_redraw()
   404			vp.render_target_update_mode = SubViewport.UPDATE_ONCE
   405			await RenderingServer.frame_post_draw
   406			_stat("paint_frame", Time.get_ticks_usec() - t_pf)   # 一段畫格＋等到畫完（含當幀其他工作）
   407			c0 += PAINT_CHUNK
   408		await RenderingServer.frame_post_draw
   409		return vp
   410	
   411	func _bake_page(types: Array) -> void:
   412		var gen0 := _gen
   413		var cb := ready_cb == 1
   414		var total := types.size() * 2 * FRAMES_PER
   415		var rows := int(ceil(float(total) / COLS))
   416		var img: Image = null
   417		if _pack_on() and types.all(func(t): return AtlasPack.has(ready_cb, "type%d" % t)):
   418			img = await _assemble(types, rows)   # 1.6.0 B09：預設外觀從包裡的兵種條拼頁（背景執行緒），不畫不讀回
   419			if gen0 != _gen:
   420				return   # 拼到一半重建了：這批作廢，不停用包
   421			if img == null:
   422				AtlasPack.fail("type%s" % str(types), "拼頁失敗（缺條、錯圖）")
   423			else:
   424				pack_stats["hit"] += 1
   425		if img == null:
   426			var painter := _Painter.new()
   427			painter.cb = cb
   428			painter.types = types
   429			# 1.2.0 §15.2：一整頁（6 種×2 隊×28 格＝336 個向量角色）在同一幀畫完就是開戰前的長幀（136～215 ms，ABBA 量過不是讀回造成）。
   430			# 改成分段：每幀只畫 PAINT_CHUNK 格，視窗第一次清空、之後不清（累積），畫完整頁才讀回。
   431			var vp: SubViewport = await _paint_steps(Vector2i(COLS * CELL, rows * CELL), painter, total)
   432			img = await _post_vp(vp)   # 第 11 大類：直接拿視窗貼圖跑後處理，省一次讀回＋上傳
   433			pack_stats["paint"] += 1
   434			if pack_capture and img != null:
   435				for k in types.size():
   436					AtlasPack.save(ready_cb, "type%d" % types[k], strip_of(img, k))
   437				pack_pages.append([types.duplicate(), img])
   438		if (1 if cb else 0) != ready_cb or gen0 != _gen:
   439			return   # 烘的時候換了配色（或重建了）：這一批作廢
   440		# 新兵頁太多就丟最舊的（舊 10 種那兩頁不丟）
   441		if pages.size() >= MAX_PAGES:
   442			for i in pages.size():
   443				if pages[i] != null and int(pages[i]["types"][0]) >= D.COUNT:
   444					for t in pages[i]["types"]:
   445						if loc.has(t) and int(loc[t][0]) == i:
   446							loc.erase(t)
   447					pages[i] = null
   448					break
   449		var pn := pages.size()
   450		pages.append({"tex": _mk_tex(img), "types": types})
   451		for k in types.size():
   452			loc[types[k]] = [pn, k * 2 * FRAMES_PER]
   453	
   454	## 1.2.0 第 11 大類（§15.2 A2 後續）：畫好的視窗直接當後處理的輸入（ViewportTexture），只在最後讀回一次。
   455	## 原本是「讀回 → 建 ImageTexture 上傳 → 後處理 → 再讀回」，每頁多一次整頁讀回與上傳。讀完才釋放來源視窗。
   456	func _post_vp(src: SubViewport, per := FRAMES_PER) -> Image:
   457		var sh_path := "res://shaders/unit_bake.gdshader"
   458		if not ResourceLoader.exists(sh_path) or bool(Save.s("plain_ui")):
   459			var t_rb := Time.get_ticks_usec()
   460			var raw := src.get_texture().get_image()
   461			_stat("readback", Time.get_ticks_usec() - t_rb)
   462			src.queue_free()
   463			return raw
   464		var out := await _post_tex(src.get_texture(), src.size, per)
   465		src.queue_free()
   466		return out
   467	
   468	## V1.2 D1：烘好的整頁再跑一次後處理 shader（外輪廓＋頂亮底暗）。
   469	func _post_tex(tex: Texture2D, size: Vector2i, per: int) -> Image:
   470		var tr := TextureRect.new()
   471		tr.texture = tex
   472		tr.size = Vector2(size)
   473		var mat := ShaderMaterial.new()
   474		mat.shader = load("res://shaders/unit_bake.gdshader")
   475		mat.set_shader_parameter("cell", float(CELL))
   476		mat.set_shader_parameter("per", float(per))
   477		mat.set_shader_parameter("cols", float(COLS))
   478		mat.set_shader_parameter("sh_amt", float(Art.WASH[clampi(int(Art.paint[2]), 0, 2)]))   # V1.4 #15 漬洗
   479		mat.set_shader_parameter("hi_amt", float(Art.DRY[clampi(int(Art.paint[3]), 0, 2)]))    # 乾掃
   480		tr.material = mat
   481		var vp := _viewport(size, tr)
   482		await RenderingServer.frame_post_draw
   483		await RenderingServer.frame_post_draw
   484		var t_rb := Time.get_ticks_usec()
   485		var out := vp.get_texture().get_image()
   486		_stat("readback", Time.get_ticks_usec() - t_rb)
   487		vp.queue_free()
   488		return out
   489	
   490	func _bake_ring(cb: bool) -> void:
   491		var g0 := _gen
   492		var img: Image = await _baked("ring", func() -> Image:
   493			var painter := _RingPainter.new()
   494			painter.cb = cb
   495			var vp := _viewport(Vector2i(15 * CELL, CELL), painter)   # 1.3.0：第 15 格＝紅方八角木座（跳起來分層畫時用）   # V1.3 A3：4 種隊伍圈＋木座＋影子＋4 種合成（木座＋影子＋圈）；1.1.0 B14：合成再分王國／奇幻（底座部件烘進去）
   496			await RenderingServer.frame_post_draw
   497			await RenderingServer.frame_post_draw
   498			var im := vp.get_texture().get_image()
   499			vp.queue_free()
   500			return im, Vector2i(15 * CELL, CELL))
   501		if g0 == _gen and img != null:
   502			ring_tex = _mk_tex(img)
   503	
   504	## variant 1（劍士交替招式）和 2（第四輪新兵的專屬動作）都用第二組攻擊格：新兵沒有交替招式，那一組烘的是專屬動作。
   505	func frame_index(type: int, team: int, walk: float, atk: float, t: float, px: float, variant := 0) -> int:
   506		var base: int = int(loc[type][1]) + team * FRAMES_PER
   507		if atk > 0.0:
   508			return base + 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * mini(variant, 1) + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
   509		if walk <= Gait.POSE_DAZE + 1.0:
   510			return base + 2 + WALK_FRAMES + 1
   511		if walk <= Gait.POSE_DRAG + 1.0:
   512			return base + 2 + WALK_FRAMES
   513		if walk != 0.0:
   514			return base + 2 + int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES
   515		var ex := 2.0 if type == D.CAVALRY else 3.5   # Art._eyes 的眼睛中心 x
   516		var blink := fmod(t + ex * 0.13 + fposmod(px * 0.731, 3.7), 3.7) <= 0.12   # V1.3 A2：依位置錯開，同種兵不再一起眨眼
   517		return base + (1 if blink else 0)
   518	
   519	func draw_ring(ci: CanvasItem, p: Vector2, team: int, type: int, scale := 1.0, air := 0.0) -> void:
   520		var idx := team * 2 + (1 if (type == D.SHIELD or type == D.CAVALRY or type == 19) else 0)
   521		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
   522		if air <= 0.0:
   523			# 站在地上（絕大多數）：一次貼好預先合成的三層（效能：每隻 1 次貼圖，不是 3 次）
   524			var fan := 4 if type >= D.COUNT else 0   # 1.1.0 B14：奇幻兵用樹皮部件那一組合成格
   525			ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2((6 + fan + idx) * CELL, 0, CELL, CELL))
   526			ci.draw_set_transform_matrix(Art.base)
   527			return
   528		ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2((14 if team == 1 else 4) * CELL, 0, CELL, CELL))   # 木座（紅方八角）
   529		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale, scale), 0.0, p))
   530		Art.base_trim(ci, Vector2.ZERO, type, 1.0)   # 1.1.0 B14：跳起來（少數）才分層畫部件

