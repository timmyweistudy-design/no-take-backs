  1629	## 1.6.0 B09（S7）冷熱量測：冷＝這個程序開機第一次烘（到就緒的時間、期間最長一幀）；熱＝同一程序切色盲重建 20 次（每次最長一幀、耗時）。
  1630	## 加 --no-pack＝即時烘焙對照。用法：<exe> --path game --resolution 1280x800 -- --pack-bench=<json 絕對路徑> [--no-pack]
  1631	func _run_pack_bench(out_path: String) -> void:
  1632		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
  1633		DisplayServer.window_set_position(Vector2i(-4000, -4000))
  1634		var blank := "--bench-blank" in OS.get_cmdline_user_args()
  1635		if blank:
  1636			visible = false   # 只量烘焙本身：畫面不畫（圖集沒好時的向量替代畫法很貴，會混進來；冷、熱都一樣）
  1637		var t0 := Time.get_ticks_msec()
  1638		var last := Time.get_ticks_usec()
  1639		var longest := 0.0
  1640		var g := 0
  1641		var cold_frames: Array = []   # 冷：每幀耗時（前幾幀是引擎第一次畫——字型、shader 編譯——不是烘焙）
  1642		while sprites != null and not (sprites.is_ready(false) and not sprites._busy) and g < 3000:
  1643			g += 1
  1644			await RenderingServer.frame_post_draw
  1645			var now := Time.get_ticks_usec()
  1646			var dt := (now - last) / 1000.0
  1647			cold_frames.append(snappedf(dt, 0.1))
  1648			if g > 2:
  1649				longest = maxf(longest, dt)   # 冷的「烘焙最長幀」不算開機頭兩幀（另列 first_frames）
  1650			last = now
  1651		var cold := {"ready_ms": Time.get_ticks_msec() - t0, "longest_frame_ms": snappedf(longest, 0.1), "first_frames": cold_frames.slice(0, 2), "frames": cold_frames.size()}
  1652		var warm: Array = []
  1653		for i in 20:
  1654			var cb := i % 2 == 0
  1655			var w0 := Time.get_ticks_msec()
  1656			sprites.build(cb)
  1657			last = Time.get_ticks_usec()
  1658			longest = 0.0
  1659			g = 0
  1660			while not (sprites.is_ready(cb) and not sprites._busy) and g < 3000:
  1661				g += 1
  1662				await RenderingServer.frame_post_draw
  1663				var now2 := Time.get_ticks_usec()
  1664				longest = maxf(longest, (now2 - last) / 1000.0)
  1665				last = now2
  1666			warm.append({"cb": cb, "ms": Time.get_ticks_msec() - w0, "longest_frame_ms": snappedf(longest, 0.1)})
  1667		var AP = preload("res://scripts/ui/atlas_pack.gd")
  1668		var rep := {"blank": blank, "pack": AP.usable(), "why": AP.why, "misses": AP.misses, "cold": cold, "warm": warm, "stats": sprites.pack_stats.duplicate(), "stages": sprites.stage_report(),
  1669			"tex_mib": snappedf(Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED) / 1048576.0, 0.1), "static_mib": snappedf(Performance.get_monitor(Performance.MEMORY_STATIC) / 1048576.0, 0.1)}
  1670		var f := FileAccess.open(out_path, FileAccess.WRITE)
  1671		f.store_string(JSON.stringify(rep, "  "))
  1672		f.close()
  1673		get_tree().quit()
