index ef99d6f..1512566 100644
--- a/game/tests/suites/battle_visual.gd
+++ b/game/tests/suites/battle_visual.gd
@@ -1081,3 +1081,55 @@ func test_clutch_frame_v150() -> void:
 	ok(GS.clutch_glow(5.0, 0.3, true) == 1.0 and GS.clutch_glow(5.0, 0.3, false) < 1.0, "減少動態：不呼吸（定值）")
