     7	const DIR := "res://art/pack"
     8	const MANIFEST := "res://art/pack/manifest.json"
     9	const DEFAULT_PAINT := "00110"
    10	const FORMAT_V := 1
    11	# 會改變烘出來像素的來源（雜湊這些檔；資料夾＝裡面所有 .gd／.json／.gdshader）
    12	const SOURCES := ["res://scripts/ui/art.gd", "res://scripts/ui/units", "res://scripts/ui/pose_data.gd", "res://scripts/ui/pose_files.gd",
    13		"res://scripts/ui/palette.gd", "res://scripts/core/unit_defs.gd", "res://scripts/ui/sprite_cache.gd", "res://shaders/unit_bake.gdshader", "res://data/poses"]
    14	
    15	static var _state := -1   # -1 還沒檢查｜0 不能用｜1 能用
    16	static var why := ""      # 不能用的原因（量測、ledger 用）
    17	static var misses := 0    # 執行時讀包失敗（壞檔、尺寸不對）次數：一次就整包停用、退回即時烘
    18	
    19	static func _files(p: String, out: Array) -> void:
    20		if p.ends_with(".gd") or p.ends_with(".json") or p.ends_with(".gdshader"):
    21			out.append(p)
    22			return
    23		var d := DirAccess.open(p)
    24		if d == null:
    25			return
    26		var names: Array = Array(d.get_files())
    27		names.sort()
    28		for f in names:
    29			if f.ends_with(".gd") or f.ends_with(".json") or f.ends_with(".gdshader"):
    30				out.append(p + "/" + f)
    31	
    32	## 來源雜湊（開發環境才算得出來；匯出包裡 .gd 是二進位、讀不到原文＝回空字串）
    33	static func src_key() -> String:
    34		var files: Array = []
    35		for s in SOURCES:
    36			_files(s, files)
    37		var ctx := HashingContext.new()
    38		ctx.start(HashingContext.HASH_SHA256)
    39		var n := 0
    40		for f in files:
    41			var txt := FileAccess.get_file_as_string(f) if FileAccess.file_exists(f) else ""
    42			if txt == "":
    43				if str(f).ends_with(".gd"):
    44					return ""   # 匯出版：.gd 是二進位、讀不到原文——整個來源檢查跳過（匯出前一定重烘，見 export_check.sh），不要只雜湊一部分而誤判過期
    45				continue
    46			ctx.update(("%s\n" % f).to_utf8_buffer())
    47			ctx.update(txt.to_utf8_buffer())
    48			n += 1
    49		if n == 0:
    50			return ""
    51		return ctx.finish().hex_encode().substr(0, 16)
    52	
    53	static func env_key() -> Dictionary:
    54		return {"engine": str(Engine.get_version_info()["string"]), "renderer": RenderingServer.get_current_rendering_method(), "format": FORMAT_V}
    55	
    56	static func manifest() -> Dictionary:
    57		if not FileAccess.file_exists(MANIFEST):
    58			return {}
    59		var d = JSON.parse_string(FileAccess.get_file_as_string(MANIFEST))
    60		return d if d is Dictionary else {}
    61	
    62	## 這台機器、這份程式能不能用包（第一次問才檢查；開發環境多驗來源雜湊）
    63	static func usable() -> bool:
    64		if _state >= 0:
    65			return _state == 1
    66		_state = 0
    67		if "--no-pack" in OS.get_cmdline_user_args():
    68			why = "停用（--no-pack，量測對照）"
    69			return false
    70		var m := manifest()
    71		if m.is_empty():
    72			why = "沒有包"
    73			return false
    74		var em := env_match(m, env_key())
    75		if em != "":
    76			why = em
    77			return false
    78		var sk := src_key()
    79		if sk != "" and sk != str(m.get("src", "")):
    80			why = "來源改過（包 %s／現在 %s）：要重烘" % [m.get("src", ""), sk]
    81			return false
    82		_state = 1
    83		why = ""
    84		return true
    85	
    86	static func reset() -> void:
    87		_state = -1
    88		misses = 0
    89	
    90	static func path(cb: int, key: String) -> String:
    91		return "%s/cb%d/%s.res" % [DIR, cb, key]
    92	
    93	static func has(cb: int, key: String) -> bool:
    94		return ResourceLoader.exists(path(cb, key))
    95	
    96	static var saved_sha := {}   # 烘包時每張圖的像素雜湊（寫進清冊；測試讀回比對＝解碼差 0）
    97	
    98	static func img_sha(img: Image) -> String:
    99		var ctx := HashingContext.new()
   100		ctx.start(HashingContext.HASH_SHA256)
   101		ctx.update(("%dx%d:%d|" % [img.get_width(), img.get_height(), img.get_format()]).to_utf8_buffer())
   102		ctx.update(img.get_data())
   103		return ctx.finish().hex_encode().substr(0, 24)
   104	
   105	static func save(cb: int, key: String, img: Image) -> int:
   106		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("%s/cb%d" % [DIR, cb]))
   107		saved_sha["cb%d/%s" % [cb, key]] = img_sha(img)
   108		return ResourceSaver.save(img, path(cb, key), ResourceSaver.FLAG_COMPRESS)
   109	
   110	## 清冊的環境鍵和這台比（JSON 數字讀回來是 float）
   111	static func env_match(m: Dictionary, e: Dictionary) -> String:
   112		for k in e:
   113			var mv = m.get(k, "")
   114			var same: bool = (float(mv) == float(e[k])) if (e[k] is int or e[k] is float) and (mv is int or mv is float) else str(mv) == str(e[k])
   115			if not same:
   116				return "%s 不同（包 %s／現在 %s）" % [k, mv, e[k]]
   117		return ""
   118	
   119	static func fail(key: String, reason: String) -> void:
   120		misses += 1
   121		_state = 0
   122		why = "讀包失敗 %s：%s（整包停用、退回即時烘）" % [key, reason]
   123		push_warning(why)
     1	#!/usr/bin/env bash
     2	# 匯出成品驗收（第七輪 S3）：匯出正式版、試玩版、Linux，對成品跑 --self-check（不開視窗、不碰 Steam、不碰玩家存檔）。
     3	# 用法：GODOT=<Godot 4.6.2 Windows exe> tools/export_check.sh <輸出資料夾（WSL 路徑，空的或不存在）> [--smoke]
     4	# --smoke：只驗 Windows 正式版（開發中的快速版）。
     5	set -uo pipefail
     6	cd "$(dirname "$0")/.."
     7	GODOT="${GODOT:?要設 GODOT}"; OUT="${1:?要給輸出資料夾}"; MODE="${2:-}"
     8	[ -d "$OUT" ] && [ -n "$(ls -A "$OUT" 2>/dev/null)" ] && { echo "EXPORT FAIL：$OUT 不是空的"; exit 2; }
     9	mkdir -p "$OUT/win" "$OUT/demo" "$OUT/linux"
    10	rm -rf .godot/exported   # 第七輪：舊的匯出快取會帶到搬走的腳本，匯出成品開不起來（實際踩過：main.gd 拆出 dev_main.gd 之後）
    11	# 路徑給 Windows 版 Godot：WSL 用 wslpath、Git Bash（CI 的 Windows 執行器）用 cygpath，其他原樣（V1.0.0 T2）
    12	wp() { if [[ "$GODOT" == *.exe ]] && command -v wslpath >/dev/null 2>&1; then wslpath -w "$1"; elif [[ "$GODOT" == *.exe ]] && command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else printf '%s' "$1"; fi; }
    13	ex() {  # 預設名稱 路徑
    14	  timeout 300 "$GODOT" --headless --path "$(wp .)" --export-release "$1" "$(wp "$2")" > "$OUT/export-$3.log" 2>&1 || { echo "EXPORT FAIL：$1 匯出 exit 非 0"; exit 1; }
    15	  grep -E "SCRIPT ERROR|Parse Error" "$OUT/export-$3.log" && { echo "EXPORT FAIL：$1 匯出有腳本錯誤"; exit 1; }
    16	  [ -s "$2" ] || { echo "EXPORT FAIL：$1 沒有產生 $2"; exit 1; }
    17	}
    18	sc() {  # 執行檔 期望 demo 標記
    19	  local log="$OUT/selfcheck-$3.log"
    20	  timeout 90 "$1" --headless -- --self-check > "$log" 2>&1
    21	  local rc=$?
    22	  local line; line=$(grep -a '^SELFCHECK' "$log" | tr -d '\r')
    23	  echo "$3: $line"
    24	  [ "$rc" = "0" ] || { echo "EXPORT FAIL：$3 自我檢查 exit $rc（看 $log）"; exit 1; }
    25	  echo "$line" | grep -q "\"demo\":$2" || { echo "EXPORT FAIL：$3 試玩版標記不對"; exit 1; }
    26	  echo "$line" | grep -q '"exported":true' || { echo "EXPORT FAIL：$3 不是匯出版"; exit 1; }
    27	  echo "$line" | grep -q '"engine":"4.6.2' || { echo "EXPORT FAIL：$3 引擎版本不對"; exit 1; }
    28	  echo "$line" | grep -q '"ok":true' || { echo "EXPORT FAIL：$3 自我檢查 ok 不是 true"; exit 1; }   # V1.0.0 T2
    29	  [ -n "${EXPECT_VERSION:-}" ] && { echo "$line" | grep -q "\"version\":\"$EXPECT_VERSION\"" || { echo "EXPORT FAIL：$3 版本不是 $EXPECT_VERSION"; exit 1; }; }
    30	  grep -aE "SCRIPT ERROR" "$log" && { echo "EXPORT FAIL：$3 有腳本錯誤"; exit 1; }
    31	}
    32	# 1.6.0 B09：匯出前一定重烘預設外觀離線圖集包（包不進 git；過期的包成品裡沒人驗得出來）。要開渲染視窗（移到畫面外）；NO_PACK=1 略過（成品會即時烘）
    33	if [ "${NO_PACK:-}" != "1" ]; then
    34	  timeout 600 "$GODOT" --path "$(wp .)" --resolution 1280x800 -- --bake-pack="$(wp "$OUT/bake-pack.json")" > "$OUT/bake-pack.log" 2>&1
    35	  grep -a '^BAKEPACK OK' "$OUT/bake-pack.log" || { echo "EXPORT FAIL：離線圖集包烘失敗（看 $OUT/bake-pack.log；NO_PACK=1 可略過）"; exit 1; }
    36	fi
    37	ex "Windows Desktop" "$OUT/win/NoTakeBacks.exe" win
    38	sc "$OUT/win/NoTakeBacks.exe" false win
    39	if [ "${NO_PACK:-}" != "1" ]; then
    40	  grep -a '^SELFCHECK' "$OUT/selfcheck-win.log" | grep -q '"pack":true' || { echo "EXPORT FAIL：成品沒帶到能用的離線圖集包（看 selfcheck-win.log 的 pack_why）"; exit 1; }
    41	fi
    42	if [ "$MODE" != "--smoke" ]; then
    43	  ex "Windows Demo" "$OUT/demo/NoTakeBacksDemo.exe" demo
    44	  sc "$OUT/demo/NoTakeBacksDemo.exe" true demo
    45	  # Linux 匯出要 linux_release.x86_64 模板。本機只裝了 Windows 模板時明講略過（不是通過）；CI 的 export job 會實跑。
    46	  linux_tpl() {   # Windows 版 Godot 的模板資料夾裡有沒有 Linux 模板（WSL 與 Git Bash 都要能查）
    47	    if command -v wslpath >/dev/null 2>&1; then ls "$(wslpath -u "$(cmd.exe /c 'echo %APPDATA%' 2>/dev/null | tr -d '\r')")/Godot/export_templates/4.6.2.stable/linux_release.x86_64" >/dev/null 2>&1
    48	    else ls "${APPDATA:-/nonexistent}/Godot/export_templates/4.6.2.stable/linux_release.x86_64" >/dev/null 2>&1; fi
    49	  }
    50	  if [ -n "${LINUX_TEMPLATE_OK:-}" ] || [[ "$GODOT" != *.exe ]] || linux_tpl; then
    51	    ex "Linux" "$OUT/linux/NoTakeBacks.x86_64" linux
    52	    mkdir -p "$OUT/linux-demo"
    53	    ex "Linux Demo" "$OUT/linux-demo/NoTakeBacksDemo.x86_64" linux-demo
    54	    chmod +x "$OUT/linux/NoTakeBacks.x86_64" "$OUT/linux-demo/NoTakeBacksDemo.x86_64"
    55	    sc "$OUT/linux/NoTakeBacks.x86_64" false linux
    56	    sc "$OUT/linux-demo/NoTakeBacksDemo.x86_64" true linux-demo   # V1.0.0 T2：Linux 試玩版也要實際啟動
    57	  else
    58	    echo "LINUX SKIPPED：本機沒有 Linux 匯出模板（未驗證，不是通過）"
    59	  fi
    60	fi
    61	du -sh "$OUT"/*/ | sed 's/^/size /'
    62	# V1.0.0 R0：發版凍結紀錄（commit、各成品雜湊）
    63	{ echo "commit $(git rev-parse HEAD 2>/dev/null)"; echo "dirty $(git status --porcelain 2>/dev/null | wc -l)"; for f in "$OUT"/*/*.exe "$OUT"/*/*.x86_64 "$OUT"/*/*.pck; do [ -f "$f" ] && sha256sum "$f"; done; } > "$OUT/manifest.txt"
    64	echo "MANIFEST $OUT/manifest.txt"
    65	echo "EXPORT OK"
**S7｜圖集拆峰與預設離線包**

1. **核心問題**：把預設圖集隨包交付、特殊塗裝保留執行期生成，能否讓最長一幀低於40ms且不讀錯圖？
2. **最小範圍／不做**：一套預設外觀及色盲包、22種需求輪換、一套自訂塗裝退路；拆量繪製、後處理、讀回、解碼、上傳與釋放。不重算既有分幀成果，不烘所有塗裝排列。
3. **模組／前置**：見E7；新增包清冊、來源雜湊、錨點與姿勢版本。先量1.5.0新基準，歷史46.6ms不能充當本次實測。
4. **工作量**：工程5–9人日、素材整理0.5–1人日；假設沿用圖集格式、無新增原畫，信心中低，瓶頸尚未拆量。
5. **固定對照**：F2、F4及S3連環條；相同姿勢分別走即時／離線路徑，套C1並檢查缺格、滲色與畫風跳變。
6. **判決**：Go須C2各次最長幀<40ms、預設與即時包解碼像素差0、來源變更／壞包錯命中0，容量不超提案預算。任一超標No-Go；機器、峰值或包樣本不足則資料不足。
7. **退路／保留**：包失效回既有安全重烘；保留分段計時、驗型與需求屏障。尖峰未過即停素材放量，不以缺姿勢換速度；原畫未到用既有圖集。
8. **量產／下一門檻**：每外觀包人工核對約0.25–0.5人日，建包機時實測；下一關為正式匯出包、全22種、20次換色／塗裝與跨局釋放，磁碟容量另核准。


