  1676	## 1.6.0 B09（S7）烘離線圖集包：預設塗裝 × 一般／色盲，全部 22 種兵的頁條、轉身、待機、走路轉身、轉身出手、背面走路、腳底圈。
  1677	## 烘完自我核對（兵種條拼回整頁要逐像素一樣）、寫清冊（來源雜湊、引擎、渲染路徑）。視窗移到畫面外（不搶焦點）。
  1678	## 用法：<exe> --path game --resolution 1280x800 -- --bake-pack=<報告 json 絕對路徑>
  1679	func _run_bake_pack(report_path: String) -> void:
  1680		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
  1681		DisplayServer.window_set_position(Vector2i(-4000, -4000))
  1682		var AP = preload("res://scripts/ui/atlas_pack.gd")
  1683		var t0 := Time.get_ticks_msec()
  1684		var rep := {"ok": false}
  1685		var saved_paint: Array = Art.paint.duplicate()
  1686		Art.paint = [0, 0, 1, 1, 0, 0]   # 只收預設塗裝
  1687		sprites.pack_capture = true
  1688		AP.saved_sha.clear()
  1689		var mism := 0
  1690		var pages_checked := 0
  1691		for cb in [false, true]:
  1692			var g := 0
  1693			while sprites._busy and g < 2000:   # 等開機那次烘完（避免兩次烘交錯）
  1694				g += 1
  1695				await get_tree().process_frame
  1696			sprites.pack_pages.clear()
  1697			await sprites.build(cb)
  1698			sprites.ensure(range(D.COUNT, 22))
  1699			sprites.ensure_turn_atk(range(0, 22))
  1700			g = 0
  1701			while (sprites._busy or sprites._ta_busy) and g < 20000:
  1702				g += 1
  1703				await get_tree().process_frame
  1704			for pe in sprites.pack_pages:
  1705				var types: Array = pe[0]
  1706				var img: Image = pe[1]
  1707				var strips: Array = []
  1708				for t in types:
  1709					strips.append(load(AP.path(1 if cb else 0, "type%d" % t)))
  1710				var back: Image = sprites.page_from(strips, img.get_height() / sprites.CELL)
  1711				pages_checked += 1
  1712				if back.get_data() != img.get_data():
  1713					mism += 1
  1714		sprites.pack_capture = false
  1715		Art.paint = saved_paint
  1716		var bytes := 0
  1717		var files := 0
  1718		for cbd in ["cb0", "cb1"]:
  1719			var d := DirAccess.open(AP.DIR + "/" + cbd)
  1720			if d != null:
  1721				for f in d.get_files():
  1722					if f.ends_with(".res"):
  1723						files += 1
  1724						bytes += FileAccess.get_file_as_bytes(AP.DIR + "/" + cbd + "/" + f).size()
  1725		var man: Dictionary = AP.env_key()
  1726		man["src"] = AP.src_key()
  1727		man["paint"] = AP.DEFAULT_PAINT
  1728		man["files"] = files
  1729		man["bytes"] = bytes
  1730		man["selfcheck_pages"] = pages_checked
  1731		man["selfcheck_mismatch"] = mism
  1732		man["sha"] = AP.saved_sha.duplicate()
  1733		if mism == 0 and files > 0:
  1734			var mf := FileAccess.open(AP.MANIFEST, FileAccess.WRITE)
  1735			mf.store_string(JSON.stringify(man, "  "))
  1736			mf.close()
  1737		rep = man.duplicate()
  1738		rep["ok"] = mism == 0 and files > 0
  1739		rep["ms"] = Time.get_ticks_msec() - t0
  1740		var rf := FileAccess.open(report_path, FileAccess.WRITE)
  1741		rf.store_string(JSON.stringify(rep, "  "))
  1742		rf.close()
  1743		print("BAKEPACK ", "OK" if rep["ok"] else "FAIL", " files=", files, " MiB=", snappedf(bytes / 1048576.0, 0.1), " mismatch=", mism, " ms=", rep["ms"])
  1744		get_tree().quit(0 if rep["ok"] else 1)
