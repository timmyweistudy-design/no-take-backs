   290	## ── 1.6.0 B09（S7）離線包 ──
   291	var pack_capture := false          # --bake-pack：照常畫，畫完存進包
   292	var pack_pages: Array = []         # 烘包時留每頁 [兵種, 原圖]（自我核對：拼回來要逐像素一樣）
   293	var pack_stats := {"hit": 0, "paint": 0}
   294	
   295	func _pack_on() -> bool:
   296		return not pack_capture and Art.paint_sig() == AtlasPack.DEFAULT_PAINT and AtlasPack.usable()
   297	
   298	## 背景執行緒讀包（主執行緒只等）；壞檔回 null
   299	func _pack_load(key: String) -> Image:
   300		var p := AtlasPack.path(ready_cb, key)
   301		if not ResourceLoader.exists(p) or ResourceLoader.load_threaded_request(p, "Image") != OK:
   302			return null
   303		var t0 := Time.get_ticks_usec()
   304		while ResourceLoader.load_threaded_get_status(p) == ResourceLoader.THREAD_LOAD_IN_PROGRESS:
   305			await RenderingServer.frame_post_draw
   306		_stat("pack_wait", Time.get_ticks_usec() - t0)   # 牆鐘時間（跨幀），不是單幀成本
   307		var r = ResourceLoader.load_threaded_get(p)
   308		return r as Image
   309	
   310	## 一張圖：預設外觀＋包能用＝讀包（尺寸不對算壞包、整包停用）；否則照舊畫（make 是會 await 的做法），烘包時順便存
   311	func _baked(key: String, make: Callable, size: Vector2i) -> Image:
   312		if _pack_on():
   313			var im: Image = await _pack_load(key)
   314			if im != null and im.get_size() == size:
   315				pack_stats["hit"] += 1
   316				return im
   317			AtlasPack.fail(key, "缺檔或壞檔" if im == null else "尺寸 %s≠%s" % [im.get_size(), size])
   318		var img: Image = await make.call()
   319		pack_stats["paint"] += 1
   320		if pack_capture and img != null:
   321			AtlasPack.save(ready_cb, key, img)
   322		return img
   323	
   324	## 一頁裡第 k 種兵的格子（2 隊 × FRAMES_PER＝56 格）抄成一條（16 欄 × 4 列）；包以兵種為單位，頁怎麼組都拼得回來
   325	static func strip_of(page: Image, k: int) -> Image:
