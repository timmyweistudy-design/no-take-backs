   333	static func page_from(strips: Array, rows: int) -> Image:
   334		var per := 2 * FRAMES_PER
   335		var pg := Image.create(COLS * CELL, rows * CELL, false, (strips[0] as Image).get_format())
   336		for k in strips.size():
   337			var s: Image = strips[k]
   338			for c in per:
   339				var dst := k * per + c
   340				pg.blit_rect(s, Rect2i((c % COLS) * CELL, (c / COLS) * CELL, CELL, CELL), Vector2i((dst % COLS) * CELL, (dst / COLS) * CELL))
   341		return pg
   342	
   343	func _assemble(types: Array, rows: int) -> Image:
   344		var strips: Array = []
   345		var want := Vector2i(COLS * CELL, int(ceil(float(2 * FRAMES_PER) / COLS)) * CELL)
   346		for t in types:
   347			var s: Image = await _pack_load("type%d" % t)
   348			if s == null or s.get_size() != want:
   349				return null
   350			strips.append(s)
   351		var out: Array = [null]
   352		var task := WorkerThreadPool.add_task(func(): out[0] = page_from(strips, rows))   # 拼頁在背景執行緒
   353		while not WorkerThreadPool.is_task_completed(task):
   354			await RenderingServer.frame_post_draw
   355		WorkerThreadPool.wait_for_task_completion(task)
   356		return out[0]

