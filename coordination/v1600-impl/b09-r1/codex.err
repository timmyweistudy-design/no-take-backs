+## 1.6.0 B09（S7；P10.2）預設外觀離線圖集包：兵種條拆拼逐像素一致、環境鍵、壞包整包停用、包讀回＝烘的時候的像素（解碼差 0）、過期包不用
+func test_atlas_pack_v1600() -> void:
+	var AP = load("res://scripts/ui/atlas_pack.gd")
+	var SC = load("res://scripts/ui/sprite_cache.gd")
+	# 兵種條：一頁拆成每種一條、再拼回來要逐像素一樣（包以兵種為單位，頁怎麼組都拼得回來）
+	var per: int = 2 * SC.FRAMES_PER
+	var rows := int(ceil(float(SC.TYPES_PER_PAGE * per) / SC.COLS))
+	var page := Image.create(SC.COLS * SC.CELL, rows * SC.CELL, false, Image.FORMAT_RGBA8)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 1600
+	for c in SC.TYPES_PER_PAGE * per:
+		page.fill_rect(Rect2i((c % SC.COLS) * SC.CELL + rng.randi_range(0, 100), (c / SC.COLS) * SC.CELL + rng.randi_range(0, 100), 60, 60), Color(rng.randf(), rng.randf(), rng.randf(), 1))
+	var strips: Array = []
+	for k in SC.TYPES_PER_PAGE:
+		strips.append(SC.strip_of(page, k))
+	ok(SC.page_from(strips, rows).get_data() == page.get_data(), "兵種條拆開再拼回整頁逐像素一樣")
+	ok(SC.TYPES_PER_PAGE * SC.MAX_PAGES >= 30, "頁變小後總容量不變（≥30 種）")
+	# 環境鍵：JSON 數字讀回是 float 也算同；引擎不同＝不用
+	var e: Dictionary = AP.env_key()
+	var m: Dictionary = e.duplicate()
+	m["format"] = float(e["format"])
+	ok(AP.env_match(m, e) == "", "清冊數字是 float 也比得上")
+	m["engine"] = "4.7.0-stable"
+	ok(AP.env_match(m, e).begins_with("engine"), "引擎版本不同＝包不能用")
+	# 壞包：讀失敗一次就整包停用、退回即時烘
+	AP.reset()
+	AP.fail("type3", "測試")
+	ok(not AP.usable() and AP.misses == 1, "讀包失敗一次＝整包停用")
+	AP.reset()
+	var sc: String = FileAccess.get_file_as_string("res://scripts/ui/sprite_cache.gd")
+	ok(sc.find("Art.paint_sig() == AtlasPack.DEFAULT_PAINT") >= 0, "只有預設塗裝讀包（特殊塗裝照舊即時烘）")
+	ok(sc.find("AtlasPack.fail(key,") >= 0 and sc.find("im.get_size() == size") >= 0, "尺寸不對＝壞包")
+	var man: Dictionary = AP.manifest()
+	if man.is_empty():
+		ok(not AP.usable(), "沒有包（新複製的專案）＝照舊即時烘")
+		return
+	var stale: bool = str(man.get("src", "")) != AP.src_key()
+	if stale:
+		ok(not AP.usable() and AP.why.begins_with("來源改過"), "包過期（畫法改過）＝執行時不用、匯出前重烘")
+		return
+	ok(int(man.get("selfcheck_mismatch", -1)) == 0 and int(man.get("selfcheck_pages", 0)) > 0, "烘包自我核對：拼回的頁和畫出來的一樣")
+	var sha: Dictionary = man.get("sha", {})
+	ok(sha.size() == int(man.get("files", -1)) and sha.size() >= 100, "清冊每張圖都有像素雜湊（%d 張）" % sha.size())
+	var bad := 0
+	for k in sha:
+		var parts: PackedStringArray = str(k).split("/")
+		var img = load(AP.path(int(parts[0].substr(2)), parts[1]))
+		if not (img is Image) or AP.img_sha(img) != str(sha[k]):
+			bad += 1
+	ok(bad == 0, "包讀回的每張圖＝烘的時候的像素（解碼差 0；%d 張）" % sha.size())
+	ok(AP.usable(), "這份程式＋這台環境：包能用")
diff --git a/game/tools/dev_main.gd b/game/tools/dev_main.gd
index fbf2a14..42a6c30 100644
--- a/game/tools/dev_main.gd
+++ b/game/tools/dev_main.gd
@@ -1620,6 +1620,128 @@ func _ready() -> void:
 			_run_mem_check.call_deferred(a.substr(12))
 		elif a.begins_with("--sil="):
 			_run_sil.call_deferred(a.substr(6))
+		elif a.begins_with("--bake-pack="):
+			_run_bake_pack.call_deferred(a.substr(12))
+		elif a.begins_with("--pack-bench="):
+			_run_pack_bench.call_deferred(a.substr(13))
+
+
+## 1.6.0 B09（S7）冷熱量測：冷＝這個程序開機第一次烘（到就緒的時間、期間最長一幀）；熱＝同一程序切色盲重建 20 次（每次最長一幀、耗時）。
+## 加 --no-pack＝即時烘焙對照。用法：<exe> --path game --resolution 1280x800 -- --pack-bench=<json 絕對路徑> [--no-pack]
+func _run_pack_bench(out_path: String) -> void:
+	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
+	DisplayServer.window_set_position(Vector2i(-4000, -4000))
+	var blank := "--bench-blank" in OS.get_cmdline_user_args()
+	if blank:
+		visible = false   # 只量烘焙本身：畫面不畫（圖集沒好時的向量替代畫法很貴，會混進來；冷、熱都一樣）
+	var t0 := Time.get_ticks_msec()
+	var last := Time.get_ticks_usec()
+	var longest := 0.0
+	var g := 0
+	var cold_frames: Array = []   # 冷：每幀耗時（前幾幀是引擎第一次畫——字型、shader 編譯——不是烘焙）
+	while sprites != null and not (sprites.is_ready(false) and not sprites._busy) and g < 3000:
+		g += 1
+		await RenderingServer.frame_post_draw
+		var now := Time.get_ticks_usec()
+		var dt := (now - last) / 1000.0
+		cold_frames.append(snappedf(dt, 0.1))
+		if g > 2:
+			longest = maxf(longest, dt)   # 冷的「烘焙最長幀」不算開機頭兩幀（另列 first_frames）
+		last = now
+	var cold := {"ready_ms": Time.get_ticks_msec() - t0, "longest_frame_ms": snappedf(longest, 0.1), "first_frames": cold_frames.slice(0, 2), "frames": cold_frames.size()}
+	var warm: Array = []
+	for i in 20:
+		var cb := i % 2 == 0
+		var w0 := Time.get_ticks_msec()
+		sprites.build(cb)
+		last = Time.get_ticks_usec()
+		longest = 0.0
+		g = 0
+		while not (sprites.is_ready(cb) and not sprites._busy) and g < 3000:
+			g += 1
+			await RenderingServer.frame_post_draw
+			var now2 := Time.get_ticks_usec()
+			longest = maxf(longest, (now2 - last) / 1000.0)
+			last = now2
+		warm.append({"cb": cb, "ms": Time.get_ticks_msec() - w0, "longest_frame_ms": snappedf(longest, 0.1)})
+	var AP = preload("res://scripts/ui/atlas_pack.gd")
+	var rep := {"blank": blank, "pack": AP.usable(), "why": AP.why, "misses": AP.misses, "cold": cold, "warm": warm, "stats": sprites.pack_stats.duplicate(), "stages": sprites.stage_report(),
+		"tex_mib": snappedf(Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED) / 1048576.0, 0.1), "static_mib": snappedf(Performance.get_monitor(Performance.MEMORY_STATIC) / 1048576.0, 0.1)}
+	var f := FileAccess.open(out_path, FileAccess.WRITE)
+	f.store_string(JSON.stringify(rep, "  "))
+	f.close()
+	get_tree().quit()
+
+
+## 1.6.0 B09（S7）烘離線圖集包：預設塗裝 × 一般／色盲，全部 22 種兵的頁條、轉身、待機、走路轉身、轉身出手、背面走路、腳底圈。
+## 烘完自我核對（兵種條拼回整頁要逐像素一樣）、寫清冊（來源雜湊、引擎、渲染路徑）。視窗移到畫面外（不搶焦點）。
+## 用法：<exe> --path game --resolution 1280x800 -- --bake-pack=<報告 json 絕對路徑>
+func _run_bake_pack(report_path: String) -> void:
+	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
+	DisplayServer.window_set_position(Vector2i(-4000, -4000))
+	var AP = preload("res://scripts/ui/atlas_pack.gd")
+	var t0 := Time.get_ticks_msec()
+	var rep := {"ok": false}
+	var saved_paint: Array = Art.paint.duplicate()
+	Art.paint = [0, 0, 1, 1, 0, 0]   # 只收預設塗裝
+	sprites.pack_capture = true
+	AP.saved_sha.clear()
+	var mism := 0
+	var pages_checked := 0
+	for cb in [false, true]:
+		var g := 0
+		while sprites._busy and g < 2000:   # 等開機那次烘完（避免兩次烘交錯）
+			g += 1
+			await get_tree().process_frame
+		sprites.pack_pages.clear()
+		await sprites.build(cb)
+		sprites.ensure(range(D.COUNT, 22))
+		sprites.ensure_turn_atk(range(0, 22))
+		g = 0
+		while (sprites._busy or sprites._ta_busy) and g < 20000:
+			g += 1
+			await get_tree().process_frame
+		for pe in sprites.pack_pages:
+			var types: Array = pe[0]
+			var img: Image = pe[1]
+			var strips: Array = []
+			for t in types:
+				strips.append(load(AP.path(1 if cb else 0, "type%d" % t)))
+			var back: Image = sprites.page_from(strips, img.get_height() / sprites.CELL)
+			pages_checked += 1
+			if back.get_data() != img.get_data():
+				mism += 1
+	sprites.pack_capture = false
+	Art.paint = saved_paint
+	var bytes := 0
+	var files := 0
+	for cbd in ["cb0", "cb1"]:
+		var d := DirAccess.open(AP.DIR + "/" + cbd)
+		if d != null:
+			for f in d.get_files():
+				if f.ends_with(".res"):
+					files += 1
+					bytes += FileAccess.get_file_as_bytes(AP.DIR + "/" + cbd + "/" + f).size()
+	var man: Dictionary = AP.env_key()
+	man["src"] = AP.src_key()
+	man["paint"] = AP.DEFAULT_PAINT
+	man["files"] = files
+	man["bytes"] = bytes
+	man["selfcheck_pages"] = pages_checked
+	man["selfcheck_mismatch"] = mism
+	man["sha"] = AP.saved_sha.duplicate()
+	if mism == 0 and files > 0:
+		var mf := FileAccess.open(AP.MANIFEST, FileAccess.WRITE)
+		mf.store_string(JSON.stringify(man, "  "))
+		mf.close()
+	rep = man.duplicate()
+	rep["ok"] = mism == 0 and files > 0
+	rep["ms"] = Time.get_ticks_msec() - t0
+	var rf := FileAccess.open(report_path, FileAccess.WRITE)
+	rf.store_string(JSON.stringify(rep, "  "))
+	rf.close()
+	print("BAKEPACK ", "OK" if rep["ok"] else "FAIL", " files=", files, " MiB=", snappedf(bytes / 1048576.0, 0.1), " mismatch=", mism, " ms=", rep["ms"])
+	get_tree().quit(0 if rep["ok"] else 1)
 
 
