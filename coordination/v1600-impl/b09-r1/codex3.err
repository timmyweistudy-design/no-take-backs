   443	func _bake_page(types: Array) -> void:
   444		var gen0 := _gen
   445		var cb := ready_cb == 1
   446		var total := types.size() * 2 * FRAMES_PER
   447		var rows := int(ceil(float(total) / COLS))
   448		var img: Image = null
   449		if _pack_on() and not types.all(func(t): return AtlasPack.has(ready_cb, "type%d" % t)):
   450			AtlasPack.fail("type%s" % str(types), "缺兵種條")   # 包不完整＝整包停用（Codex B09 r2 #2）
   451		if _pack_on():
   452			img = await _assemble(types, rows)   # 1.6.0 B09：預設外觀從包裡的兵種條拼頁（背景執行緒），不畫不讀回
   453			if gen0 != _gen:
   454				return   # 拼到一半重建了：這批作廢，不停用包
   455			if img == null:
   456				AtlasPack.fail("type%s" % str(types), "拼頁失敗（缺條、錯圖）")
   457			else:
   458				pack_stats["hit"] += 1
   459		if img == null:
   460			var painter := _Painter.new()
   461			painter.cb = cb
   462			painter.types = types
   463			# 1.2.0 §15.2：一整頁（6 種×2 隊×28 格＝336 個向量角色）在同一幀畫完就是開戰前的長幀（136～215 ms，ABBA 量過不是讀回造成）。
   464			# 改成分段：每幀只畫 PAINT_CHUNK 格，視窗第一次清空、之後不清（累積），畫完整頁才讀回。
   465			var vp: SubViewport = await _paint_steps(Vector2i(COLS * CELL, rows * CELL), painter, total)
   466			img = await _post_vp(vp)   # 第 11 大類：直接拿視窗貼圖跑後處理，省一次讀回＋上傳
   467			pack_stats["paint"] += 1
   468			if pack_capture and img != null:
   469				for k in types.size():
   470					AtlasPack.save(ready_cb, "type%d" % types[k], strip_of(img, k))
   471				pack_pages.append([types.duplicate(), img])
   472		if (1 if cb else 0) != ready_cb or gen0 != _gen:
   473			return   # 烘的時候換了配色（或重建了）：這一批作廢
   474		# 新兵頁太多就丟最舊的（舊 10 種那兩頁不丟）
   475		if pages.size() >= MAX_PAGES:
   476			for i in pages.size():
   477				if pages[i] != null and int(pages[i]["types"][0]) >= D.COUNT:
   478					for t in pages[i]["types"]:
   479						if loc.has(t) and int(loc[t][0]) == i:
   480							loc.erase(t)
   481					pages[i] = null
   482					break
   483		var pn := pages.size()
   484		pages.append({"tex": _mk_tex(img), "types": types})
   485		for k in types.size():
   486			loc[types[k]] = [pn, k * 2 * FRAMES_PER]
   487	
   488	## 1.2.0 第 11 大類（§15.2 A2 後續）：畫好的視窗直接當後處理的輸入（ViewportTexture），只在最後讀回一次。
   489	## 原本是「讀回 → 建 ImageTexture 上傳 → 後處理 → 再讀回」，每頁多一次整頁讀回與上傳。讀完才釋放來源視窗。
   490	func _post_vp(src: SubViewport, per := FRAMES_PER) -> Image:
   491		var sh_path := "res://shaders/unit_bake.gdshader"
   492		if not ResourceLoader.exists(sh_path) or bool(Save.s("plain_ui")):
   493			var t_rb := Time.get_ticks_usec()
   494			var raw := src.get_texture().get_image()
   495			_stat("readback", Time.get_ticks_usec() - t_rb)
   496			src.queue_free()
   497			return raw
   498		var out := await _post_tex(src.get_texture(), src.size, per)
   499		src.queue_free()
   500		return out
   501	
   502	## V1.2 D1：烘好的整頁再跑一次後處理 shader（外輪廓＋頂亮底暗）。
   503	func _post_tex(tex: Texture2D, size: Vector2i, per: int) -> Image:
   504		var tr := TextureRect.new()
   505		tr.texture = tex
   506		tr.size = Vector2(size)
   507		var mat := ShaderMaterial.new()
   508		mat.shader = load("res://shaders/unit_bake.gdshader")
   509		mat.set_shader_parameter("cell", float(CELL))
   510		mat.set_shader_parameter("per", float(per))
   511		mat.set_shader_parameter("cols", float(COLS))
   512		mat.set_shader_parameter("sh_amt", float(Art.WASH[clampi(int(Art.paint[2]), 0, 2)]))   # V1.4 #15 漬洗
   513		mat.set_shader_parameter("hi_amt", float(Art.DRY[clampi(int(Art.paint[3]), 0, 2)]))    # 乾掃
   514		tr.material = mat
   515		var vp := _viewport(size, tr)
   516		await RenderingServer.frame_post_draw
   517		await RenderingServer.frame_post_draw
   518		var t_rb := Time.get_ticks_usec()
   519		var out := vp.get_texture().get_image()
   520		_stat("readback", Time.get_ticks_usec() - t_rb)
   521		vp.queue_free()
   522		return out
   523	
   524	func _bake_ring(cb: bool) -> void:
   525		var g0 := _gen
   526		var img: Image = await _baked("ring", func() -> Image:
   527			var painter := _RingPainter.new()
   528			painter.cb = cb
   529			var vp := _viewport(Vector2i(15 * CELL, CELL), painter)   # 1.3.0：第 15 格＝紅方八角木座（跳起來分層畫時用）   # V1.3 A3：4 種隊伍圈＋木座＋影子＋4 種合成（木座＋影子＋圈）；1.1.0 B14：合成再分王國／奇幻（底座部件烘進去）
   530			await RenderingServer.frame_post_draw
   531			await RenderingServer.frame_post_draw
   532			var im := vp.get_texture().get_image()
   533			vp.queue_free()
   534			return im, Vector2i(15 * CELL, CELL))
   535		if g0 == _gen and img != null:
   536			ring_tex = _mk_tex(img)
   537	
   538	## variant 1（劍士交替招式）和 2（第四輪新兵的專屬動作）都用第二組攻擊格：新兵沒有交替招式，那一組烘的是專屬動作。
   539	func frame_index(type: int, team: int, walk: float, atk: float, t: float, px: float, variant := 0) -> int:
   540		var base: int = int(loc[type][1]) + team * FRAMES_PER
   541		if atk > 0.0:
   542			return base + 2 + WALK_FRAMES + POSE_FRAMES + ATK_FRAMES * mini(variant, 1) + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
   543		if walk <= Gait.POSE_DAZE + 1.0:
   544			return base + 2 + WALK_FRAMES + 1
   545		if walk <= Gait.POSE_DRAG + 1.0:
   546			return base + 2 + WALK_FRAMES
   547		if walk != 0.0:
   548			return base + 2 + int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES
   549		var ex := 2.0 if type == D.CAVALRY else 3.5   # Art._eyes 的眼睛中心 x
   550		var blink := fmod(t + ex * 0.13 + fposmod(px * 0.731, 3.7), 3.7) <= 0.12   # V1.3 A2：依位置錯開，同種兵不再一起眨眼
