   377	## 一頁裡第 k 種兵的格子（2 隊 × FRAMES_PER＝56 格）抄成一條（16 欄 × 4 列）；包以兵種為單位，頁怎麼組都拼得回來
   378	static func strip_of(page: Image, k: int) -> Image:
   379		var per := 2 * FRAMES_PER
   380		var s := Image.create(COLS * CELL, int(ceil(float(per) / COLS)) * CELL, false, page.get_format())
   381		for c in per:
   382			var src := k * per + c
   383			s.blit_rect(page, Rect2i((src % COLS) * CELL, (src / COLS) * CELL, CELL, CELL), Vector2i((c % COLS) * CELL, (c / COLS) * CELL))
   384		return s
   385	
   386	static func page_from(strips: Array, rows: int) -> Image:
   387		var per := 2 * FRAMES_PER
   388		var pg := Image.create(COLS * CELL, rows * CELL, false, (strips[0] as Image).get_format())
   389		for k in strips.size():
   390			_blit_strip(pg, strips[k], k)   # 和執行時拼頁同一個函式
   391		return pg
   392	
   393	## 由兵種條拼頁：一條一條讀、在背景執行緒貼進頁、貼完就放掉（同時只有一頁＋一條在記憶體）
   394	func _assemble(types: Array, rows: int) -> Image:
   395		var g0 := _gen
   396		var cb0 := ready_cb
   397		var want := Vector2i(COLS * CELL, int(ceil(float(2 * FRAMES_PER) / COLS)) * CELL)
   398		await _lock()
   399		if not _pack_on():
   400			_pack_lock = false
   401			return null
   402		var page: Image = null
   403		for k in types.size():
   404			var s: Image = await _load_raw("type%d" % types[k], cb0) if g0 == _gen else null
   405			if s == null or s.get_size() != want or g0 != _gen:
   406				_pack_lock = false
   407				return null
   408			if page == null:
   409				page = Image.create(COLS * CELL, rows * CELL, false, s.get_format())
   410			var kk := k
   411			var task := WorkerThreadPool.add_task(func(): _blit_strip(page, s, kk))   # 貼格在背景執行緒
   412			while not WorkerThreadPool.is_task_completed(task):
   413				await RenderingServer.frame_post_draw
   414			WorkerThreadPool.wait_for_task_completion(task)
   415		_pack_lock = false
   416		return page if g0 == _gen else null
   417	
   418	static func _blit_strip(pg: Image, s: Image, k: int) -> void:
   419		var per := 2 * FRAMES_PER
   420		for c in per:
   421			var dst := k * per + c
   422			pg.blit_rect(s, Rect2i((c % COLS) * CELL, (c / COLS) * CELL, CELL, CELL), Vector2i((dst % COLS) * CELL, (dst / COLS) * CELL))
   423	
   424	func _paint_steps(size: Vector2i, painter: Node, total: int) -> SubViewport:
   425		painter.cell_from = 0
   426		painter.cell_to = PAINT_CHUNK
   427		var vp := _viewport(size, painter)
   428		vp.render_target_clear_mode = SubViewport.CLEAR_MODE_ONCE
   429		await RenderingServer.frame_post_draw
   430		var c0 := PAINT_CHUNK
   431		while c0 < total:
   432			var t_pf := Time.get_ticks_usec()
   433			painter.cell_from = c0
   434			painter.cell_to = c0 + PAINT_CHUNK
   435			painter.queue_redraw()
   436			vp.render_target_update_mode = SubViewport.UPDATE_ONCE
   437			await RenderingServer.frame_post_draw
   438			_stat("paint_frame", Time.get_ticks_usec() - t_pf)   # 一段畫格＋等到畫完（含當幀其他工作）
   439			c0 += PAINT_CHUNK
   440		await RenderingServer.frame_post_draw
   441		return vp
