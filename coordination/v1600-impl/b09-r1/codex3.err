   275		while not _queue.is_empty():
   276			var chunk: Array = _queue.slice(0, TYPES_PER_PAGE)
   277			_queue = _queue.slice(chunk.size())
   278			_baking = chunk
   279			await _bake_page(chunk)
   280			if g0 != _gen:
   281				return
   282			_baking = []
   283		_busy = false
