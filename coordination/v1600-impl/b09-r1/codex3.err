   285	func _viewport(size: Vector2i, painter: Node) -> SubViewport:
   286		var vp := SubViewport.new()
   287		vp.size = size
   288		vp.transparent_bg = true
   289		vp.render_target_update_mode = SubViewport.UPDATE_ONCE
   290		vp.add_child(painter)
   291		add_child(vp)
   292		return vp
