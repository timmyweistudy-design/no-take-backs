   575	## V1.3.1：史萊姆高光不烘進圖集，貼圖後固定畫在世界的左上（翻面不跳邊）。
   576	static func slime_shine(ci: CanvasItem, p: Vector2, type: int, scale: float, alpha: float, bob: float) -> void:
   577		if type != 13 and type != 20:
   578			return
   579		var k := 1.0 if type == 13 else 0.66
   580		var q := p + Vector2(0, bob * scale)
   581		ci.draw_set_transform_matrix(Art.base)
   582		ci.draw_circle(q + Vector2(-9.0 * k, -23.8 * k - 1.0) * scale, 3.8 * k * scale, Color(1, 1, 1, 0.6 * alpha), true, -1.0, true)
   583		ci.draw_circle(q + Vector2(-3.6 * k, -31.5 * k - 1.0) * scale, 1.8 * k * scale, Color(1, 1, 1, 0.6 * alpha), true, -1.0, true)
   584	
   585	## V1.3.1：貼額外頁的一格（小動作、受擊帽子、走路轉身）。bob＝要不要加待機呼吸。
   586	func _draw_cell(ci: CanvasItem, tex: Texture2D, idx: int, p: Vector2, type: int, team: int, face: float, hurt: float, alpha: float, t: float, scale: float, lean: float, crouch: float, bob: bool, mood := 0, cb := false, oc := 1.0, qw := 0.0) -> void:
   587		var sg := -1.0 if face < 0.0 else 1.0
   588		var by := Art.idle_bob(t, p) if bob else 0.0
   589		ci.draw_set_transform_matrix(Art.base * Transform2D(lean * sg, Vector2(scale * sg / RS, scale * crouch / RS), 0.0, p + Vector2(0, by * scale)))
   590		ci.draw_texture_rect_region(tex, Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
   591		if hurt > 0.0:
   592			ci.draw_texture_rect_region(tex, Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(4, 4, 4, hurt * 0.55 * alpha))
   593		if mood != 0:
   594			# 表情疊加（Codex v131-impl1：走路轉身、小動作原本漏畫）；轉身格的臉依 oc 往中間移
   595			ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, sg * oc, qw, 0.0, t, scale, lean, crouch, type) * Gait.body_xf(type, qw))   # 走路轉身要跟步相的離地與身體（Codex v131-impl2）
   596			Art.overlay(ci, type, team, mood, alpha, t, cb)
   597		ci.draw_set_transform_matrix(Art.base)
   598		if bob:
   599			slime_shine(ci, p, type, scale, alpha, by)   # 只在待機（跳起、壓扁時高光會對不上，不畫）
   600	
   601	## 倒棋用：只貼木座（帶透明度）。
   602	func draw_base(ci: CanvasItem, p: Vector2, scale := 1.0, a := 1.0, team := 0) -> void:
   603		ci.draw_set_transform_matrix(Art.base * Transform2D(0.0, Vector2(scale / RS, scale / RS), 0.0, p))
   604		ci.draw_texture_rect_region(ring_tex, Rect2(-RING_ORIGIN, Vector2(CELL, CELL)), Rect2((14 if team == 1 else 4) * CELL, 0, CELL, CELL), Color(1, 1, 1, a))
   605		ci.draw_set_transform_matrix(Art.base)
   606	
   607	func _rect(idx: int) -> Rect2:
   608		return Rect2((idx % COLS) * CELL, (idx / COLS) * CELL, CELL, CELL)
   609	
   610	## 量化後實際烘焙的走路相位／攻擊進度（疊加表情時用，才會跟貼圖對齊）。
   611	func quant_walk(walk: float) -> float:
   612		if walk == 0.0:
   613			return 0.0
   614		if walk < -50.0:
   615			return walk
   616		return 0.0001 + (int(fposmod(walk, TAU) / TAU * WALK_FRAMES) % WALK_FRAMES) * TAU / WALK_FRAMES
   617	
   618	func quant_atk(atk: float) -> float:
   619		if atk <= 0.0:
   620			return 0.0
   621		return (clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1) + 0.5) / ATK_FRAMES
   622	
   623	## 貼一隻角色。參數與 Art.unit 相同；待機的呼吸位移在這裡加（烘焙時是 0）。
   624	func draw_unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
   625			hurt: float, alpha: float, t: float, scale := 1.0, mood := 0, lean := 0.0, crouch := 1.0, cb := false, variant := 0, fid := -1) -> void:
   626		if hurt > 0.5 and atk <= 0.0 and walk == 0.0 and absf(face) >= 0.9 and fid_loc.has(type):
   627			# 受擊那一下帽子彈起（只在待機：帽子格是待機腿，走路、拖行、暈眩不能被蓋掉；受擊優先於小動作）
   628			_draw_cell(ci, fid_tex, int(fid_loc[type]) + team * FID_PER + FID_PER - 1, p, type, team, face, hurt, alpha, t, scale, lean, crouch, true, mood & ~Art.M_HURT, cb)   # 受擊眼已烘進這格
   629			return
   630		if fid >= 0 and hurt <= 0.0 and atk <= 0.0 and walk == 0.0 and absf(face) >= 0.9 and fid_loc.has(type):
   631			_draw_cell(ci, fid_tex, int(fid_loc[type]) + team * FID_PER + clampi(fid, 0, FID_PER - 2), p, type, team, face, hurt, alpha, t, scale, lean, crouch, true, mood, cb)
   632			return
   633		if absf(face) < 0.9 and atk <= 0.0 and walk > 0.0 and wt_loc.has(type):
   634			# 走路中轉身：依步相取格（不重設腳步）
   635			var wl: Array = wt_loc[type]
   636			var ai := 0
   637			var ph := int(fposmod(walk, TAU) / TAU * WT_PH) % WT_PH
   638			_draw_cell(ci, wt_pages[wl[0]], int(wl[1]) + team * WT_C.size() * WT_PH + ai * WT_PH + ph, p, type, team, face, hurt, alpha, t, scale, lean, crouch, false, mood, cb, float(WT_C[ai]), 0.0001 + (ph + 0.5) * TAU / WT_PH)
   639			return
   640		if absf(face) < 0.9 and has_turn(type):
   641			if atk <= 0.0:
   642				_draw_turn(ci, p, type, team, face, hurt, alpha, t, scale, lean, crouch, mood, cb)
   643				return
   644			if ta_tex.has(type):
   645				# V1.5.1 A3：轉身途中出手用轉身攻擊格（一般與交替／專屬都有），不再跳回側面
   646				var sg := -1.0 if face < 0.0 else 1.0
   647				var fi := team * ATK_FRAMES * 2 + (ATK_FRAMES if variant > 0 else 0) + clampi(int(atk * ATK_FRAMES), 0, ATK_FRAMES - 1)
   648				ci.draw_set_transform_matrix(Art.base * Transform2D(lean * sg, Vector2(scale * sg / RS, scale * crouch / RS), 0.0, p + Vector2(0, Art.idle_bob(t, p) * scale)))
   649				ci.draw_texture_rect_region(ta_tex[type], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(fi), Color(1, 1, 1, alpha))
   650				if hurt > 0.0:
   651					ci.draw_texture_rect_region(ta_tex[type], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(fi), Color(4, 4, 4, hurt * 0.55 * alpha))
   652				if mood != 0:
   653					# 表情疊加跟著這一格的轉身角度走（和 _draw_turn 一樣）
   654					ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, sg * TA_C, 0.0, quant_atk(atk), t, scale, lean, crouch, type))
   655					Art.overlay(ci, type, team, mood, alpha, t, cb)
   656				ci.draw_set_transform_matrix(Art.base)
   657				return
   658			face = 1.0 if face >= 0.0 else -1.0   # V1.5：轉身出手格還沒烘好（或交替招式）時直接轉正出手
   659		var idx := frame_index(type, team, walk, atk, t, p.x, variant)
   660		if atk > 0.0:
   661			walk = 0.0   # 攻擊影格烘焙時沒有走路相位：貼圖與疊加都當成沒在走（Codex 收尾輪 #4）
   662		var bob := Art.idle_bob(t, p) if walk == 0.0 else 0.0   # 與 Art.unit 相同：沒走路時（含攻擊）都有呼吸
   663		var xf := Art.base * Transform2D(lean * face, Vector2(scale * face / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale))
   664		ci.draw_set_transform_matrix(xf)
   665		ci.draw_texture_rect_region(pages[loc[type][0]]["tex"], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
   666		if hurt > 0.0:
   667			# V1.3 A6：受擊閃白改成整隻剪影變白（同一格再貼一次、顏色乘到飽和），不再是一顆白圓
   668			ci.draw_texture_rect_region(pages[loc[type][0]]["tex"], Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(4, 4, 4, hurt * 0.55 * alpha))
   669		if mood != 0:
   670			# 攻擊影格烘焙時沒有走路相位（Codex R5 #3）
   671			var qa := quant_atk(atk)
   672			var qw := 0.0 if qa > 0.0 else quant_walk(walk)
   673			ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, face, qw, qa, t, scale, lean, crouch, type) * Gait.body_xf(type, qw))
   674			if mood != 0:
   675				Art.overlay(ci, type, team, mood, alpha, t, cb)
   676		ci.draw_set_transform_matrix(Art.base)
   677		if walk == 0.0 and atk <= 0.0:
   678			slime_shine(ci, p, type, scale, alpha, Art.idle_bob(t, p))   # 跳起、出手壓扁時不畫（位置對不上，Codex v131-impl1）
   679	
   680	## V1.3 A1b：轉身中（|face|＜0.9）貼轉身頁：影格本身已經是轉到一半的姿勢，貼圖只翻正負、不再等比夾扁。
   681	func _draw_turn(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, hurt: float, alpha: float, t: float, scale: float, lean: float, crouch: float, mood := 0, cb := false) -> void:
   682		var af := absf(face)
   683		var j := 0 if af >= 0.67 else (1 if af >= 0.42 else 2)
   684		var idx: int = int(turn_loc[type]) + team * TURN_C.size() + j
   685		var sg := -1.0 if face < 0.0 else 1.0
   686		var bob := Art.idle_bob(t, p)
   687		ci.draw_set_transform_matrix(Art.base * Transform2D(lean * sg, Vector2(scale * sg / RS, scale * crouch / RS), 0.0, p + Vector2(0, bob * scale)))
   688		ci.draw_texture_rect_region(turn_tex, Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(1, 1, 1, alpha))
   689		if hurt > 0.0:
   690			ci.draw_texture_rect_region(turn_tex, Rect2(-origin_of(type), Vector2(CELL, CELL)), _rect(idx), Color(4, 4, 4, hurt * 0.55 * alpha))
   691		if mood != 0 and j <= 1:
   692			# 表情疊加（受擊、狂熱…）：轉身中也要有（Codex v130-impl1）；只在接近側面那一格畫，
   693			# 更窄的兩格臉已經往中間移，正側面的表情位置對不上（Codex v130-impl2），那 0.1 秒不畫
   694			# V1.3.1 P0-3：表情跟著轉過去的臉走（x 依這一格的 cos 縮）；最窄那格臉太窄（<3px），只保留貼圖、不硬塞表情
   695			ci.draw_set_transform_matrix(Art.base * Art.unit_xf(p, sg * float(TURN_C[j]), 0.0, 0.0, t, scale, lean, crouch, type))
   696			Art.overlay(ci, type, team, mood, alpha, t, cb)
   697		ci.draw_set_transform_matrix(Art.base)
   698		slime_shine(ci, p, type, scale, alpha, Art.idle_bob(t, p))
   699	
   700	## 烘焙用的畫家：一格一格呼叫 Art.unit（face＝+1，翻面由貼圖時處理）。
   701	class _Painter extends Node2D:
   702		var cb := false
   703		var types: Array = []
   704		var cell_from := 0          # 1.2.0 §15.2：分段烘焙，這一幀只畫 [cell_from, cell_to) 的格子
   705		var cell_to := 1 << 30
   706		func _draw() -> void:
   707			var Art2 = preload("res://scripts/ui/art.gd")
   708			var D2 = preload("res://scripts/core/unit_defs.gd")
   709			var saved: Transform2D = Art2.base
   710			Art2.base = Transform2D.IDENTITY
   711			var CELL2 := 192
   712			var RS2 := 1.6
   713			var W2 := 8
   714			var per := 2 + W2 + 2 + 8 + 8
   715			var cols := 16
   716			for k in types.size():
   717				var type: int = types[k]
   718				for team in 2:
   719					for f in per:
   720						var idx: int = (k * 2 + team) * per + f
   721						if idx < cell_from or idx >= cell_to:
   722							continue
   723						var cell_o := Vector2((idx % cols) * CELL2, (idx / cols) * CELL2)
   724						var walk := 0.0
   725						var atk := 0.0
   726						var vr := 0
   727						if f >= 2 and f < 2 + W2:
   728							walk = 0.0001 + (f - 2) * TAU / W2
   729						elif f == 2 + W2:
   730							walk = -100.0   # 拖行（Gait.POSE_DRAG）
# B09 圖集不卡（S7；P10.2、P10.3）

## 起點（1.5.0，同機：i7-12700H／RTX 3060 Laptop／Godot 4.6.2 Compatibility／Windows，1280×800）
`--perf`：圖集掃描烘焙最長幀 46.6 ms（歷史值重現）；分段：讀回最長 17.8 ms、上傳 5.8 ms、單段畫格（含等 GPU）190 ms；色盲重建 163 ms；戰鬥整幀 max 154／p99 101 ms。

## 做法
- 預設外觀離線包 `scripts/ui/atlas_pack.gd`：`--bake-pack` 烘預設塗裝 × 一般／色盲的全部 22 種（兵種條、轉身、待機、走路轉身、轉身出手、背面走路、腳底圈），存壓縮 Image 資源 `art/pack/cb{0,1}/*.res`（140 張、61.5 MiB），清冊記來源雜湊（畫法、姿勢、色票、後處理 shader、烘焙程式）、引擎、渲染路徑、格式、每張圖像素雜湊、自我核對（兵種條拼回整頁＝畫出來的頁）。
- 執行時 `sprite_cache._baked(key, 做法, 尺寸)`：預設塗裝＋包能用＝背景執行緒讀包（`load_threaded_request`），新兵種頁由兵種條在 WorkerThreadPool 拼頁，主執行緒只上傳；尺寸不對／讀失敗＝整包停用退回即時烘；特殊塗裝＝即時烘；開發環境來源改過＝包過期不用。
- 一頁 6 種 → 2 種（容量不變，`MAX_PAGES` 5→15）。
- 包不進 git（.gitignore）；`tools/export_check.sh` 匯出前一定重烘、成品自我檢查回報 `pack`；`NO_PACK=1` 可略。
- 量測：`--pack-bench`（冷＝開機到就緒，熱＝同程序 20 次重建；`--bench-blank` 只量烘焙、`--no-pack` 對照）；`LAYOUT_NOPACK=1`。

## 驗收（S7 判決）
最長幀 <40 ms（冷熱各 20、ABBA）、解碼像素差 0、來源變更／壞包錯命中 0、容量在預算內。
