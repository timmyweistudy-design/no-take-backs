   231				return await _post_vp(vp, ATK_FRAMES * 2), Vector2i(COLS * CELL, 2 * CELL))   # 第 11 大類：直接拿視窗貼圖跑後處理，省一次讀回＋上傳
   232			if g0 != _gen:
   233				return
   234			ta_tex[t] = _mk_tex(img)
   235			ta_order.erase(t)
   236			ta_order.append(t)
   237			while ta_order.size() > TA_MAX:
   238				ta_tex.erase(ta_order.pop_front())   # 超過上限：丟最久沒用的
   239			if not bw_tex.has(t):
   240				var imb: Image = await _baked("bw%d" % t, func() -> Image:
   241					var pb := _ExtraPainter.new()
   242					pb.cb = ready_cb == 1
   243					pb.mode = 4
   244					pb.types = [t]
   245					var vpb: SubViewport = await _paint_steps(Vector2i(COLS * CELL, CELL), pb, 2 * WT_PH)
   246					return await _post_vp(vpb, WT_PH), Vector2i(COLS * CELL, CELL))
   247				if g0 != _gen:
   248					return
   249				bw_tex[t] = _mk_tex(imb)
