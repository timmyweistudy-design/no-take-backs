   213				ta_order.erase(t)
   214				ta_order.append(t)
   215				bw_order.erase(t)
   216				bw_order.append(t)   # 背面頁和轉身出手頁一起刷新（Codex cat05 #3）
   217			elif not t in _ta_queue:
   218				_ta_queue.append(t)
