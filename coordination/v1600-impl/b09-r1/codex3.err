   321	func _pack_on() -> bool:
   322		# 簡化介面不跑後處理 shader（_post_vp），烘出來和包不同：不讀包（Codex B09 r2 #1）
   323		return not pack_capture and Art.paint_sig() == AtlasPack.DEFAULT_PAINT and not bool(Save.s("plain_ui")) and AtlasPack.usable()
