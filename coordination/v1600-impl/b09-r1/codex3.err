diff --git a/game/tests/suites/battle_visual.gd b/game/tests/suites/battle_visual.gd
index ef99d6f..9d010ff 100644
--- a/game/tests/suites/battle_visual.gd
+++ b/game/tests/suites/battle_visual.gd
@@ -1081,3 +1081,103 @@ func test_clutch_frame_v150() -> void:
 	ok(GS.clutch_glow(5.0, 0.3, true) == 1.0 and GS.clutch_glow(5.0, 0.3, false) < 1.0, "減少動態：不呼吸（定值）")
 	var bu: String = FileAccess.get_file_as_string("res://scripts/ui/battle/battle_units.gd")
 	ok(bu.find("draw_rect(fr.grow(11.0 - k * 2.5)") >= 0, "暖光只畫在木框帶上（盤外），不碰盤面")
+
+## 1.6.0 B09（S7；P10.2）預設外觀離線圖集包：兵種條拆拼逐像素一致、環境鍵、壞包整包停用、包讀回＝烘的時候的像素（解碼差 0）、過期包不用
+func test_atlas_pack_v1600() -> void:
+	var AP = load("res://scripts/ui/atlas_pack.gd")
+	var SC = load("res://scripts/ui/sprite_cache.gd")
+	# 兵種條：一頁拆成每種一條、再拼回來要逐像素一樣（包以兵種為單位，頁怎麼組都拼得回來）
+	var per: int = 2 * SC.FRAMES_PER
+	var rows := int(ceil(float(SC.TYPES_PER_PAGE * per) / SC.COLS))
+	var page := Image.create(SC.COLS * SC.CELL, rows * SC.CELL, false, Image.FORMAT_RGBA8)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 1600
+	for c in SC.TYPES_PER_PAGE * per:
+		page.fill_rect(Rect2i((c % SC.COLS) * SC.CELL + rng.randi_range(0, 100), (c / SC.COLS) * SC.CELL + rng.randi_range(0, 100), 60, 60), Color(rng.randf(), rng.randf(), rng.randf(), 1))
+	var strips: Array = []
+	for k in SC.TYPES_PER_PAGE:
+		strips.append(SC.strip_of(page, k))
+	ok(SC.page_from(strips, rows).get_data() == page.get_data(), "兵種條拆開再拼回整頁逐像素一樣")
+	ok(SC.TYPES_PER_PAGE * SC.MAX_PAGES >= 30, "頁變小後總容量不變（≥30 種）")
+	# 環境鍵：JSON 數字讀回是 float 也算同；引擎不同＝不用
+	var e: Dictionary = AP.env_key()
+	var m: Dictionary = e.duplicate()
+	m["format"] = float(e["format"])
+	ok(AP.env_match(m, e) == "", "清冊數字是 float 也比得上")
+	m["engine"] = "4.7.0-stable"
+	ok(AP.env_match(m, e).begins_with("engine"), "引擎版本不同＝包不能用")
+	# 壞包：讀失敗一次就整包停用、退回即時烘
+	AP.reset()
+	AP.fail("type3", "測試")
+	ok(not AP.usable() and AP.misses == 1, "讀包失敗一次＝整包停用")
+	AP.reset()
+	var sc: String = FileAccess.get_file_as_string("res://scripts/ui/sprite_cache.gd")
+	ok(sc.find("Art.paint_sig() == AtlasPack.DEFAULT_PAINT") >= 0, "只有預設塗裝讀包（特殊塗裝照舊即時烘）")
+	ok(sc.find("if g0 != _gen:\n\t\t\treturn null") >= 0, "讀包回來世代變了＝作廢、不停用包（重建競態）")
+	# 注入：user:// 的假包（Codex B09 r1 #6）——換錯檔（同尺寸）、檔案雜湊不符、清冊不完整、來源過期都要擋
+	var real_dir: String = AP.dir
+	AP.dir = "user://test_pack_v1600"
+	AP.saved_sha.clear()
+	AP.saved_fsha.clear()
+	var ia := Image.create(64, 64, false, Image.FORMAT_RGBA8)
+	ia.fill(Color(1, 0, 0, 1))
+	var ib := Image.create(64, 64, false, Image.FORMAT_RGBA8)
+	ib.fill(Color(0, 0, 1, 1))
+	AP.save(0, "a", ia)
+	AP.save(0, "b", ib)
+	var fake: Dictionary = AP.env_key()
+	fake["src"] = AP.src_key()
+	fake["paint"] = AP.DEFAULT_PAINT
+	fake["files"] = 2
+	fake["selfcheck_mismatch"] = 0
+	fake["selfcheck_pages"] = 1
+	fake["sha"] = AP.saved_sha.duplicate()
+	fake["fsha"] = AP.saved_fsha.duplicate()
+	var wf := func(d: Dictionary):
+		var f := FileAccess.open(AP.dir + "/manifest.json", FileAccess.WRITE)
+		f.store_string(JSON.stringify(d))
+		f.close()
+		AP.reset()
+	wf.call(fake)
+	ok(AP.usable() and AP.verify_file(0, "a") and AP.verify_file(0, "b"), "假包：清冊完整、檔案雜湊對得上＝能用")
+	ok(AP.verify_pixels(0, "a", load(AP.path(0, "a"))) and not AP.verify_pixels(0, "a", ib), "像素雜湊：讀回＝烘的；別張同尺寸的圖＝不符")
+	DirAccess.copy_absolute(ProjectSettings.globalize_path(AP.path(0, "b")), ProjectSettings.globalize_path(AP.path(0, "a")))   # 換錯檔（同尺寸）
+	ok(not AP.verify_file(0, "a"), "同尺寸換錯檔＝檔案雜湊不符、不讀")
+	var f2 := fake.duplicate(true)
+	f2["fsha"].erase("cb0/b")
+	wf.call(f2)
+	ok(not AP.usable() and AP.why.begins_with("清冊不完整"), "清冊少一筆檔案雜湊＝整包不用")
+	var f3 := fake.duplicate(true)
+	f3["src"] = "0000000000000000"
+	wf.call(f3)
+	ok(not AP.usable() and AP.why.begins_with("來源改過"), "來源雜湊不同（畫法改過）＝包過期不用")
+	var f4 := fake.duplicate(true)
+	f4["paint"] = "11220"
+	wf.call(f4)
+	ok(not AP.usable(), "清冊塗裝不是預設＝不用")
+	for k in ["a", "b"]:
+		DirAccess.remove_absolute(ProjectSettings.globalize_path(AP.path(0, k)))
+	DirAccess.remove_absolute(ProjectSettings.globalize_path(AP.dir + "/manifest.json"))
+	AP.dir = real_dir
+	AP.reset()
+	var man: Dictionary = AP.manifest()
+	if man.is_empty():
+		ok(not AP.usable(), "沒有包（新複製的專案）＝照舊即時烘")
+		return
+	var stale: bool = str(man.get("src", "")) != AP.src_key()
+	if stale:
+		ok(not AP.usable() and AP.why.begins_with("來源改過"), "包過期（畫法改過）＝執行時不用、匯出前重烘")
+		return
+	ok(int(man.get("selfcheck_mismatch", -1)) == 0 and int(man.get("selfcheck_pages", 0)) > 0, "烘包自我核對：拼回的頁和畫出來的一樣")
+	var sha: Dictionary = man.get("sha", {})
+	ok(sha.size() == int(man.get("files", -1)) and sha.size() >= 100 and (man.get("fsha", {}) as Dictionary).size() == sha.size(), "清冊每張圖都有像素與檔案雜湊（%d 張）" % sha.size())
+	ok(AP.usable(), "真包：這份程式＋這台環境能用")
+	var bad := 0
+	for k in sha:
+		var parts: PackedStringArray = str(k).split("/")
+		var cbn := int(parts[0].substr(2))
+		var img = load(AP.path(cbn, parts[1]))
+		if not (img is Image) or not AP.verify_pixels(cbn, parts[1], img) or not AP.verify_file(cbn, parts[1]):
+			bad += 1
+	ok(bad == 0, "包讀回的每張圖＝烘的時候的像素、檔案沒被換（解碼差 0；%d 張）" % sha.size())
+
diff --git a/game/tools/dev_main.gd b/game/tools/dev_main.gd
index fbf2a14..e446c57 100644
--- a/game/tools/dev_main.gd
+++ b/game/tools/dev_main.gd
@@ -1620,6 +1620,195 @@ func _ready() -> void:
 			_run_mem_check.call_deferred(a.substr(12))
 		elif a.begins_with("--sil="):
 			_run_sil.call_deferred(a.substr(6))
+		elif a.begins_with("--bake-pack="):
+			_run_bake_pack.call_deferred(a.substr(12))
+		elif a.begins_with("--pack-bench="):
+			_run_pack_bench.call_deferred(a.substr(13))
+		elif a.begins_with("--pack-selftest="):
+			_run_pack_selftest.call_deferred(a.substr(16))
+
+
+## 1.6.0 B09（Codex r2 #3）實跑：①重建中途換色盲（競態）：最後是新配色、包讀到的頁＝包裡兵種條拼的頁、沒有誤停用；
+## ②壞包：把一條換成別種（同尺寸）→ 驗檔擋下、整包停用、退回即時烘，而且即時烘的頁＝原包拼的頁（包和即時烘逐像素一樣）。
+## 用法：<exe> --path game --resolution 1280x800 -- --pack-selftest=<json 絕對路徑>
+func _run_pack_selftest(out_path: String) -> void:
+	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
+	DisplayServer.window_set_position(Vector2i(-4000, -4000))
+	var AP = preload("res://scripts/ui/atlas_pack.gd")
+	var rep := {}
+	var wait_all := func(cb: bool) -> void:
+		var g := 0
+		while not (sprites.build_done and sprites.is_ready(cb) and not sprites._busy and not sprites._ta_busy) and g < 4000:
+			g += 1
+			await RenderingServer.frame_post_draw
+	var page_eq := func(cbn: int, dir: String) -> bool:   # 目前第 0 頁（舊 10 種的第一頁）＝dir 裡的兵種條拼起來
+		var pe: Dictionary = sprites.pages[0]
+		var got: Image = (pe["tex"] as Texture2D).get_image()
+		var strips: Array = []
+		for t in pe["types"]:
+			strips.append(load("%s/cb%d/type%d.res" % [dir, cbn, t]))
+		var want: Image = sprites.page_from(strips, got.get_height() / sprites.CELL)
+		return got.get_data() == want.get_data()
+	await wait_all.call(false)
+	# ① 競態
+	AP.reset()
+	sprites.pack_stats = {"hit": 0, "paint": 0}
+	sprites.build(false)
+	for i in 3:
+		await RenderingServer.frame_post_draw
+	sprites.build(true)
+	await wait_all.call(true)
+	rep["race_ready_cb"] = sprites.is_ready(true)
+	rep["race_pack_still_on"] = AP.usable() and AP.misses == 0
+	rep["race_hits"] = sprites.pack_stats["hit"]
+	rep["race_paint"] = sprites.pack_stats["paint"]
+	rep["race_page_eq"] = page_eq.call(1, AP.DIR)
+	# ② 壞包：複製一份到 user://，把舊 10 種第一頁的一條換成同尺寸的別種
+	var bad := "user://pack_selftest"
+	for cbd in ["cb0", "cb1"]:
+		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(bad + "/" + cbd))
+		for f in DirAccess.get_files_at(AP.DIR + "/" + cbd):
+			DirAccess.copy_absolute(ProjectSettings.globalize_path(AP.DIR + "/" + cbd + "/" + f), ProjectSettings.globalize_path(bad + "/" + cbd + "/" + f))
+	DirAccess.copy_absolute(ProjectSettings.globalize_path(AP.DIR + "/manifest.json"), ProjectSettings.globalize_path(bad + "/manifest.json"))
+	var t0: int = sprites.pages[0]["types"][0]
+	DirAccess.copy_absolute(ProjectSettings.globalize_path(bad + "/cb0/type%d.res" % (t0 + 1)), ProjectSettings.globalize_path(bad + "/cb0/type%d.res" % t0))
+	AP.dir = bad
+	AP.reset()
+	sprites.pack_stats = {"hit": 0, "paint": 0}
+	sprites.build(false)
+	await wait_all.call(false)
+	rep["bad_detected"] = AP.misses >= 1 and not AP.usable()
+	rep["bad_why"] = AP.why
+	rep["bad_fell_back_paint"] = sprites.pack_stats["paint"] > 0
+	rep["bad_ready"] = sprites.is_ready(false)
+	AP.dir = AP.DIR
+	rep["paint_eq_pack"] = page_eq.call(0, AP.DIR)   # 退回即時烘的頁＝原包拼的頁
+	rep["ok"] = bool(rep["race_ready_cb"]) and bool(rep["race_pack_still_on"]) and int(rep["race_hits"]) > 0 and bool(rep["race_page_eq"]) and bool(rep["bad_detected"]) and bool(rep["bad_fell_back_paint"]) and bool(rep["bad_ready"]) and bool(rep["paint_eq_pack"])
+	AP.reset()
+	var f := FileAccess.open(out_path, FileAccess.WRITE)
+	f.store_string(JSON.stringify(rep, "  "))
+	f.close()
+	print("PACKSELFTEST ", "OK" if rep["ok"] else "FAIL", " ", JSON.stringify(rep))
+	get_tree().quit(0 if rep["ok"] else 1)
+
+
+## 1.6.0 B09（S7）冷熱量測：冷＝這個程序開機第一次烘（到「全部就緒」build_done 的時間、期間每幀）；熱＝同一程序切色盲重建 20 次。
+## 屏障＝build_done（腳底圈、舊 10 種、轉身／待機／走路轉身全好）＋沒有在烘的新兵頁、轉身出手（Codex B09 r1 #4）。
+## 每次記：最長幀（全部幀，含開機頭兩幀）、頭兩幀另列、暫存記憶體峰值（相對開始時）。--bench-blank＝畫面不畫（只量烘焙）；預設有畫面（玩家實際承受：含圖集沒好時的向量替代畫法）。
+## 加 --no-pack＝即時烘焙對照。用法：<exe> --path game --resolution 1280x800 -- --pack-bench=<json 絕對路徑> [--no-pack] [--bench-blank]
+func _bench_wait(cb: bool) -> Dictionary:
+	var t0 := Time.get_ticks_msec()
+	var last := Time.get_ticks_usec()
+	var frames: Array = []
+	var m0 := Performance.get_monitor(Performance.MEMORY_STATIC)
+	var mpk := m0
+	var t_0 := Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED)
+	var tpk := t_0
+	var g := 0
+	while sprites != null and not (sprites.build_done and sprites.is_ready(cb) and not sprites._busy and not sprites._ta_busy) and g < 3000:
+		g += 1
+		await RenderingServer.frame_post_draw
+		var now := Time.get_ticks_usec()
+		frames.append(snappedf((now - last) / 1000.0, 0.1))
+		last = now
+		mpk = maxf(mpk, Performance.get_monitor(Performance.MEMORY_STATIC))
+		tpk = maxf(tpk, Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED))
+	return {"tex_peak_over_mib": snappedf((tpk - t_0) / 1048576.0, 0.1), "tex_peak_mib": snappedf(tpk / 1048576.0, 0.1), "ms": Time.get_ticks_msec() - t0, "longest_frame_ms": frames.max() if not frames.is_empty() else 0.0, "first2": frames.slice(0, 2),
+		"after2_max": frames.slice(2).max() if frames.size() > 2 else 0.0, "frames": frames.size(), "temp_peak_mib": snappedf((mpk - m0) / 1048576.0, 0.1)}
+
+func _run_pack_bench(out_path: String) -> void:
+	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
+	DisplayServer.window_set_position(Vector2i(-4000, -4000))
+	var blank := "--bench-blank" in OS.get_cmdline_user_args()
+	if blank:
+		visible = false   # 只量烘焙本身：畫面不畫
+	var cold: Dictionary = await _bench_wait(false)
+	var warm: Array = []
+	for i in 20:
+		var cb := i % 2 == 0
+		sprites.build(cb)
+		var w: Dictionary = await _bench_wait(cb)
+		w["cb"] = cb
+		warm.append(w)
+	var AP = preload("res://scripts/ui/atlas_pack.gd")
+	var rep := {"blank": blank, "pack": AP.usable(), "why": AP.why, "misses": AP.misses, "cold": cold, "warm": warm, "stats": sprites.pack_stats.duplicate(), "stages": sprites.stage_report(),
+		"tex_mib": snappedf(Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED) / 1048576.0, 0.1), "static_mib": snappedf(Performance.get_monitor(Performance.MEMORY_STATIC) / 1048576.0, 0.1)}
+	var f := FileAccess.open(out_path, FileAccess.WRITE)
+	f.store_string(JSON.stringify(rep, "  "))
+	f.close()
+	get_tree().quit()
+
+## 1.6.0 B09（S7）烘離線圖集包：預設塗裝 × 一般／色盲，全部 22 種兵的頁條、轉身、待機、走路轉身、轉身出手、背面走路、腳底圈。
+## 烘完自我核對（兵種條拼回整頁要逐像素一樣）、寫清冊（來源雜湊、引擎、渲染路徑）。視窗移到畫面外（不搶焦點）。
+## 用法：<exe> --path game --resolution 1280x800 -- --bake-pack=<報告 json 絕對路徑>
+func _run_bake_pack(report_path: String) -> void:
+	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
+	DisplayServer.window_set_position(Vector2i(-4000, -4000))
+	var AP = preload("res://scripts/ui/atlas_pack.gd")
+	var t0 := Time.get_ticks_msec()
+	var rep := {"ok": false}
+	var saved_paint: Array = Art.paint.duplicate()
+	Art.paint = [0, 0, 1, 1, 0, 0]   # 只收預設塗裝
+	sprites.pack_capture = true
+	AP.saved_sha.clear()
+	AP.saved_fsha.clear()
+	var mism := 0
+	var pages_checked := 0
+	for cb in [false, true]:
+		var g := 0
+		while sprites._busy and g < 2000:   # 等開機那次烘完（避免兩次烘交錯）
+			g += 1
+			await get_tree().process_frame
+		sprites.pack_pages.clear()
+		await sprites.build(cb)
+		sprites.ensure(range(D.COUNT, 22))
+		sprites.ensure_turn_atk(range(0, 22))
+		g = 0
+		while (sprites._busy or sprites._ta_busy) and g < 20000:
+			g += 1
+			await get_tree().process_frame
+		for pe in sprites.pack_pages:
+			var types: Array = pe[0]
+			var img: Image = pe[1]
+			var strips: Array = []
+			for t in types:
+				strips.append(load(AP.path(1 if cb else 0, "type%d" % t)))
+			var back: Image = sprites.page_from(strips, img.get_height() / sprites.CELL)
+			pages_checked += 1
+			if back.get_data() != img.get_data():
+				mism += 1
+	sprites.pack_capture = false
+	Art.paint = saved_paint
+	var bytes := 0
+	var files := 0
+	for cbd in ["cb0", "cb1"]:
+		var d := DirAccess.open(AP.DIR + "/" + cbd)
+		if d != null:
+			for f in d.get_files():
+				if f.ends_with(".res"):
+					files += 1
+					bytes += FileAccess.get_file_as_bytes(AP.DIR + "/" + cbd + "/" + f).size()
+	var man: Dictionary = AP.env_key()
+	man["src"] = AP.src_key()
+	man["paint"] = AP.DEFAULT_PAINT
+	man["files"] = files
+	man["bytes"] = bytes
+	man["selfcheck_pages"] = pages_checked
+	man["selfcheck_mismatch"] = mism
+	man["sha"] = AP.saved_sha.duplicate()
+	man["fsha"] = AP.saved_fsha.duplicate()
+	if mism == 0 and files > 0:
+		var mf := FileAccess.open(AP.MANIFEST, FileAccess.WRITE)
+		mf.store_string(JSON.stringify(man, "  "))
+		mf.close()
+	rep = man.duplicate()
+	rep["ok"] = mism == 0 and files > 0
+	rep["ms"] = Time.get_ticks_msec() - t0
+	var rf := FileAccess.open(report_path, FileAccess.WRITE)
+	rf.store_string(JSON.stringify(rep, "  "))
+	rf.close()
+	print("BAKEPACK ", "OK" if rep["ok"] else "FAIL", " files=", files, " MiB=", snappedf(bytes / 1048576.0, 0.1), " mismatch=", mism, " ms=", rep["ms"])
+	get_tree().quit(0 if rep["ok"] else 1)
 
 
 ## V1.0.0 角色：剪影辨識表。22 種兵（含召喚物）站成兩排：上排原尺寸、下排 50%；平塗背景，tools/gen/sil_report.py 轉灰階、
diff --git a/game/tools/export_check.sh b/game/tools/export_check.sh
index 0a492a3..7e7ee09 100644
--- a/game/tools/export_check.sh
+++ b/game/tools/export_check.sh
@@ -29,8 +29,16 @@ sc() {  # 執行檔 期望 demo 標記
   [ -n "${EXPECT_VERSION:-}" ] && { echo "$line" | grep -q "\"version\":\"$EXPECT_VERSION\"" || { echo "EXPORT FAIL：$3 版本不是 $EXPECT_VERSION"; exit 1; }; }
   grep -aE "SCRIPT ERROR" "$log" && { echo "EXPORT FAIL：$3 有腳本錯誤"; exit 1; }
 }
+# 1.6.0 B09：匯出前一定重烘預設外觀離線圖集包（包不進 git；過期的包成品裡沒人驗得出來）。要開渲染視窗（移到畫面外）；NO_PACK=1 略過（成品會即時烘）
+if [ "${NO_PACK:-}" != "1" ]; then
+  timeout 600 "$GODOT" --path "$(wp .)" --resolution 1280x800 -- --bake-pack="$(wp "$OUT/bake-pack.json")" > "$OUT/bake-pack.log" 2>&1
+  grep -a '^BAKEPACK OK' "$OUT/bake-pack.log" || { echo "EXPORT FAIL：離線圖集包烘失敗（看 $OUT/bake-pack.log；NO_PACK=1 可略過）"; exit 1; }
+fi
 ex "Windows Desktop" "$OUT/win/NoTakeBacks.exe" win
 sc "$OUT/win/NoTakeBacks.exe" false win
+if [ "${NO_PACK:-}" != "1" ]; then
+  grep -a '^SELFCHECK' "$OUT/selfcheck-win.log" | grep -q '"pack":true' || { echo "EXPORT FAIL：成品沒帶到能用的離線圖集包（看 selfcheck-win.log 的 pack_why）"; exit 1; }
+fi
 if [ "$MODE" != "--smoke" ]; then
   ex "Windows Demo" "$OUT/demo/NoTakeBacksDemo.exe" demo
   sc "$OUT/demo/NoTakeBacksDemo.exe" true demo
diff --git a/game/tools/layout_check.sh b/game/tools/layout_check.sh
index abe7d66..2f207bd 100755
--- a/game/tools/layout_check.sh
+++ b/game/tools/layout_check.sh
@@ -32,7 +32,7 @@ run_combo() {
   local combo=$1 lang sc st d
   IFS=: read -r lang sc st <<< "$combo"
   d="$OUT/${lang}_${sc}${st:+_${st//,/-}}"; mkdir -p "$d"
-  timeout 600 "$EXE" --path "$(winpath .)" --resolution 1280x800 -- --shot="$(winpath "$d")" --shot-lang=$lang --shot-text=$sc ${st:+--shot-state=$st} ${LAYOUT_SHOTS:+--shot-only=$LAYOUT_SHOTS} ${LAYOUT_FIXED:+--shot-fixed} --shot-prefix="shot_${lang}_${sc}${st:+_${st//,/-}}__" --layout-check > "$d/run.log" 2>&1 \
+  timeout 600 "$EXE" --path "$(winpath .)" --resolution 1280x800 -- --shot="$(winpath "$d")" --shot-lang=$lang --shot-text=$sc ${st:+--shot-state=$st} ${LAYOUT_SHOTS:+--shot-only=$LAYOUT_SHOTS} ${LAYOUT_FIXED:+--shot-fixed} ${LAYOUT_NOPACK:+--no-pack} --shot-prefix="shot_${lang}_${sc}${st:+_${st//,/-}}__" --layout-check > "$d/run.log" 2>&1 \
     || { echo "LAYOUT FAIL：$lang $sc% 截圖程式 exit 非 0" >> "$FAILS"; kill_win "$d"; return; }
   grep -E "SCRIPT ERROR|Parse Error" "$d/run.log" >/dev/null && { echo "LAYOUT FAIL：$lang $sc% 有腳本錯誤" >> "$FAILS"; return; }
   grep -q "^SHOTFAIL" "$d/run.log" && { echo "LAYOUT FAIL：$lang $sc% 截圖存檔失敗：$(grep SHOTFAIL "$d/run.log" | head -3 | tr '\n' ' ')" >> "$FAILS"; return; }

