   309	func stage_report() -> Dictionary:
   310		var out := {}
   311		for k in stage_stats:
   312			var e: Array = stage_stats[k]
   313			out[k] = {"n": e[0], "total_ms": snappedf(int(e[1]) / 1000.0, 0.1), "max_ms": snappedf(int(e[2]) / 1000.0, 0.1)}
   314		return out
