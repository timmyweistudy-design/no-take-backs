coordination/v1600-impl/b09-r1/diff2.patch:17:+## 1.6.0 B09（S7；P10.2）預設外觀離線圖集包：開發時（或匯出前）用 `--bake-pack` 把預設塗裝的圖集烘好存成壓縮 Image 資源，
     1	#!/usr/bin/env bash
     2	# 匯出成品驗收（第七輪 S3）：匯出正式版、試玩版、Linux，對成品跑 --self-check（不開視窗、不碰 Steam、不碰玩家存檔）。
     3	# 用法：GODOT=<Godot 4.6.2 Windows exe> tools/export_check.sh <輸出資料夾（WSL 路徑，空的或不存在）> [--smoke]
     4	# --smoke：只驗 Windows 正式版（開發中的快速版）。
     5	set -uo pipefail
     6	cd "$(dirname "$0")/.."
     7	GODOT="${GODOT:?要設 GODOT}"; OUT="${1:?要給輸出資料夾}"; MODE="${2:-}"
     8	[ -d "$OUT" ] && [ -n "$(ls -A "$OUT" 2>/dev/null)" ] && { echo "EXPORT FAIL：$OUT 不是空的"; exit 2; }
     9	mkdir -p "$OUT/win" "$OUT/demo" "$OUT/linux"
    10	rm -rf .godot/exported   # 第七輪：舊的匯出快取會帶到搬走的腳本，匯出成品開不起來（實際踩過：main.gd 拆出 dev_main.gd 之後）
    11	# 路徑給 Windows 版 Godot：WSL 用 wslpath、Git Bash（CI 的 Windows 執行器）用 cygpath，其他原樣（V1.0.0 T2）
    12	wp() { if [[ "$GODOT" == *.exe ]] && command -v wslpath >/dev/null 2>&1; then wslpath -w "$1"; elif [[ "$GODOT" == *.exe ]] && command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else printf '%s' "$1"; fi; }
    13	ex() {  # 預設名稱 路徑
    14	  timeout 300 "$GODOT" --headless --path "$(wp .)" --export-release "$1" "$(wp "$2")" > "$OUT/export-$3.log" 2>&1 || { echo "EXPORT FAIL：$1 匯出 exit 非 0"; exit 1; }
    15	  grep -E "SCRIPT ERROR|Parse Error" "$OUT/export-$3.log" && { echo "EXPORT FAIL：$1 匯出有腳本錯誤"; exit 1; }
    16	  [ -s "$2" ] || { echo "EXPORT FAIL：$1 沒有產生 $2"; exit 1; }
    17	}
    18	sc() {  # 執行檔 期望 demo 標記
    19	  local log="$OUT/selfcheck-$3.log"
    20	  timeout 90 "$1" --headless -- --self-check > "$log" 2>&1
    21	  local rc=$?
    22	  local line; line=$(grep -a '^SELFCHECK' "$log" | tr -d '\r')
    23	  echo "$3: $line"
    24	  [ "$rc" = "0" ] || { echo "EXPORT FAIL：$3 自我檢查 exit $rc（看 $log）"; exit 1; }
    25	  echo "$line" | grep -q "\"demo\":$2" || { echo "EXPORT FAIL：$3 試玩版標記不對"; exit 1; }
    26	  echo "$line" | grep -q '"exported":true' || { echo "EXPORT FAIL：$3 不是匯出版"; exit 1; }
    27	  echo "$line" | grep -q '"engine":"4.6.2' || { echo "EXPORT FAIL：$3 引擎版本不對"; exit 1; }
    28	  echo "$line" | grep -q '"ok":true' || { echo "EXPORT FAIL：$3 自我檢查 ok 不是 true"; exit 1; }   # V1.0.0 T2
    29	  [ -n "${EXPECT_VERSION:-}" ] && { echo "$line" | grep -q "\"version\":\"$EXPECT_VERSION\"" || { echo "EXPORT FAIL：$3 版本不是 $EXPECT_VERSION"; exit 1; }; }
    30	  grep -aE "SCRIPT ERROR" "$log" && { echo "EXPORT FAIL：$3 有腳本錯誤"; exit 1; }
    31	}
    32	# 1.6.0 B09：匯出前一定重烘預設外觀離線圖集包（包不進 git；過期的包成品裡沒人驗得出來）。要開渲染視窗（移到畫面外）；NO_PACK=1 略過（成品會即時烘）
    33	if [ "${NO_PACK:-}" != "1" ]; then
    34	  timeout 600 "$GODOT" --path "$(wp .)" --resolution 1280x800 -- --bake-pack="$(wp "$OUT/bake-pack.json")" > "$OUT/bake-pack.log" 2>&1
    35	  grep -a '^BAKEPACK OK' "$OUT/bake-pack.log" || { echo "EXPORT FAIL：離線圖集包烘失敗（看 $OUT/bake-pack.log；NO_PACK=1 可略過）"; exit 1; }
    36	fi
    37	ex "Windows Desktop" "$OUT/win/NoTakeBacks.exe" win
    38	sc "$OUT/win/NoTakeBacks.exe" false win
    39	if [ "${NO_PACK:-}" != "1" ]; then
    40	  grep -a '^SELFCHECK' "$OUT/selfcheck-win.log" | grep -q '"pack":true' || { echo "EXPORT FAIL：成品沒帶到能用的離線圖集包（看 selfcheck-win.log 的 pack_why）"; exit 1; }
    41	fi
    42	if [ "$MODE" != "--smoke" ]; then
    43	  ex "Windows Demo" "$OUT/demo/NoTakeBacksDemo.exe" demo
    44	  sc "$OUT/demo/NoTakeBacksDemo.exe" true demo
    45	  # Linux 匯出要 linux_release.x86_64 模板。本機只裝了 Windows 模板時明講略過（不是通過）；CI 的 export job 會實跑。
    46	  linux_tpl() {   # Windows 版 Godot 的模板資料夾裡有沒有 Linux 模板（WSL 與 Git Bash 都要能查）
    47	    if command -v wslpath >/dev/null 2>&1; then ls "$(wslpath -u "$(cmd.exe /c 'echo %APPDATA%' 2>/dev/null | tr -d '\r')")/Godot/export_templates/4.6.2.stable/linux_release.x86_64" >/dev/null 2>&1
    48	    else ls "${APPDATA:-/nonexistent}/Godot/export_templates/4.6.2.stable/linux_release.x86_64" >/dev/null 2>&1; fi
    49	  }
    50	  if [ -n "${LINUX_TEMPLATE_OK:-}" ] || [[ "$GODOT" != *.exe ]] || linux_tpl; then
    51	    ex "Linux" "$OUT/linux/NoTakeBacks.x86_64" linux
    52	    mkdir -p "$OUT/linux-demo"
    53	    ex "Linux Demo" "$OUT/linux-demo/NoTakeBacksDemo.x86_64" linux-demo
    54	    chmod +x "$OUT/linux/NoTakeBacks.x86_64" "$OUT/linux-demo/NoTakeBacksDemo.x86_64"
    55	    sc "$OUT/linux/NoTakeBacks.x86_64" false linux
    56	    sc "$OUT/linux-demo/NoTakeBacksDemo.x86_64" true linux-demo   # V1.0.0 T2：Linux 試玩版也要實際啟動
    57	  else
    58	    echo "LINUX SKIPPED：本機沒有 Linux 匯出模板（未驗證，不是通過）"
    59	  fi
    60	fi
    61	du -sh "$OUT"/*/ | sed 's/^/size /'
    62	# V1.0.0 R0：發版凍結紀錄（commit、各成品雜湊）
    63	{ echo "commit $(git rev-parse HEAD 2>/dev/null)"; echo "dirty $(git status --porcelain 2>/dev/null | wc -l)"; for f in "$OUT"/*/*.exe "$OUT"/*/*.x86_64 "$OUT"/*/*.pck; do [ -f "$f" ] && sha256sum "$f"; done; } > "$OUT/manifest.txt"
    64	echo "MANIFEST $OUT/manifest.txt"
    65	echo "EXPORT OK"
  1630	
  1631	## 1.6.0 B09（Codex r2 #3）實跑：①重建中途換色盲（競態）：最後是新配色、包讀到的頁＝包裡兵種條拼的頁、沒有誤停用；
  1632	## ②壞包：把一條換成別種（同尺寸）→ 驗檔擋下、整包停用、退回即時烘，而且即時烘的頁＝原包拼的頁（包和即時烘逐像素一樣）。
  1633	## 用法：<exe> --path game --resolution 1280x800 -- --pack-selftest=<json 絕對路徑>
  1634	func _run_pack_selftest(out_path: String) -> void:
  1635		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
  1636		DisplayServer.window_set_position(Vector2i(-4000, -4000))
  1637		var AP = preload("res://scripts/ui/atlas_pack.gd")
  1638		var rep := {}
  1639		var wait_all := func(cb: bool) -> void:
  1640			var g := 0
  1641			while not (sprites.build_done and sprites.is_ready(cb) and not sprites._busy and not sprites._ta_busy) and g < 4000:
  1642				g += 1
  1643				await RenderingServer.frame_post_draw
  1644		var page_eq := func(cbn: int, dir: String) -> bool:   # 目前第 0 頁（舊 10 種的第一頁）＝dir 裡的兵種條拼起來
  1645			var pe: Dictionary = sprites.pages[0]
  1646			var got: Image = (pe["tex"] as Texture2D).get_image()
  1647			var strips: Array = []
  1648			for t in pe["types"]:
  1649				strips.append(load("%s/cb%d/type%d.res" % [dir, cbn, t]))
  1650			var want: Image = sprites.page_from(strips, got.get_height() / sprites.CELL)
  1651			return got.get_data() == want.get_data()
  1652		await wait_all.call(false)
  1653		# ① 競態
  1654		AP.reset()
  1655		sprites.pack_stats = {"hit": 0, "paint": 0}
  1656		sprites.build(false)
  1657		for i in 3:
  1658			await RenderingServer.frame_post_draw
  1659		sprites.build(true)
  1660		await wait_all.call(true)
  1661		rep["race_ready_cb"] = sprites.is_ready(true)
  1662		rep["race_pack_still_on"] = AP.usable() and AP.misses == 0
  1663		rep["race_hits"] = sprites.pack_stats["hit"]
  1664		rep["race_paint"] = sprites.pack_stats["paint"]
  1665		rep["race_page_eq"] = page_eq.call(1, AP.DIR)
  1666		# ② 壞包：複製一份到 user://，把舊 10 種第一頁的一條換成同尺寸的別種
  1667		var bad := "user://pack_selftest"
  1668		for cbd in ["cb0", "cb1"]:
  1669			DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(bad + "/" + cbd))
  1670			for f in DirAccess.get_files_at(AP.DIR + "/" + cbd):
  1671				DirAccess.copy_absolute(ProjectSettings.globalize_path(AP.DIR + "/" + cbd + "/" + f), ProjectSettings.globalize_path(bad + "/" + cbd + "/" + f))
  1672		DirAccess.copy_absolute(ProjectSettings.globalize_path(AP.DIR + "/manifest.json"), ProjectSettings.globalize_path(bad + "/manifest.json"))
  1673		var t0: int = sprites.pages[0]["types"][0]
  1674		DirAccess.copy_absolute(ProjectSettings.globalize_path(bad + "/cb0/type%d.res" % (t0 + 1)), ProjectSettings.globalize_path(bad + "/cb0/type%d.res" % t0))
  1675		AP.dir = bad
  1676		AP.reset()
  1677		sprites.pack_stats = {"hit": 0, "paint": 0}
  1678		sprites.build(false)
  1679		await wait_all.call(false)
  1680		rep["bad_detected"] = AP.misses >= 1 and not AP.usable()
  1681		rep["bad_why"] = AP.why
  1682		rep["bad_fell_back_paint"] = sprites.pack_stats["paint"] > 0
  1683		rep["bad_ready"] = sprites.is_ready(false)
  1684		AP.dir = AP.DIR
  1685		rep["paint_eq_pack"] = page_eq.call(0, AP.DIR)   # 退回即時烘的頁＝原包拼的頁
  1686		rep["ok"] = bool(rep["race_ready_cb"]) and bool(rep["race_pack_still_on"]) and int(rep["race_hits"]) > 0 and bool(rep["race_page_eq"]) and bool(rep["bad_detected"]) and bool(rep["bad_fell_back_paint"]) and bool(rep["bad_ready"]) and bool(rep["paint_eq_pack"])
  1687		AP.reset()
  1688		var f := FileAccess.open(out_path, FileAccess.WRITE)
  1689		f.store_string(JSON.stringify(rep, "  "))
  1690		f.close()
  1691		print("PACKSELFTEST ", "OK" if rep["ok"] else "FAIL", " ", JSON.stringify(rep))
  1692		get_tree().quit(0 if rep["ok"] else 1)
  1693	
  1694	
  1695	## 1.6.0 B09（S7）冷熱量測：冷＝這個程序開機第一次烘（到「全部就緒」build_done 的時間、期間每幀）；熱＝同一程序切色盲重建 20 次。
  1696	## 屏障＝build_done（腳底圈、舊 10 種、轉身／待機／走路轉身全好）＋沒有在烘的新兵頁、轉身出手（Codex B09 r1 #4）。
  1697	## 每次記：最長幀（全部幀，含開機頭兩幀）、頭兩幀另列、暫存記憶體峰值（相對開始時）。--bench-blank＝畫面不畫（只量烘焙）；預設有畫面（玩家實際承受：含圖集沒好時的向量替代畫法）。
  1698	## 加 --no-pack＝即時烘焙對照。用法：<exe> --path game --resolution 1280x800 -- --pack-bench=<json 絕對路徑> [--no-pack] [--bench-blank]
  1699	func _bench_wait(cb: bool) -> Dictionary:
  1700		var t0 := Time.get_ticks_msec()
  1701		var last := Time.get_ticks_usec()
  1702		var frames: Array = []
  1703		var m0 := Performance.get_monitor(Performance.MEMORY_STATIC)
  1704		var mpk := m0
  1705		var t_0 := Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED)
  1706		var tpk := t_0
  1707		var g := 0
  1708		while sprites != null and not (sprites.build_done and sprites.is_ready(cb) and not sprites._busy and not sprites._ta_busy) and g < 3000:
  1709			g += 1
  1710			await RenderingServer.frame_post_draw
  1711			var now := Time.get_ticks_usec()
  1712			frames.append(snappedf((now - last) / 1000.0, 0.1))
  1713			last = now
  1714			mpk = maxf(mpk, Performance.get_monitor(Performance.MEMORY_STATIC))
  1715			tpk = maxf(tpk, Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED))
  1716		return {"tex_peak_over_mib": snappedf((tpk - t_0) / 1048576.0, 0.1), "tex_peak_mib": snappedf(tpk / 1048576.0, 0.1), "ms": Time.get_ticks_msec() - t0, "longest_frame_ms": frames.max() if not frames.is_empty() else 0.0, "first2": frames.slice(0, 2),
  1717			"after2_max": frames.slice(2).max() if frames.size() > 2 else 0.0, "frames": frames.size(), "temp_peak_mib": snappedf((mpk - m0) / 1048576.0, 0.1)}
  1718	
  1719	func _run_pack_bench(out_path: String) -> void:
  1720		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
  1721		DisplayServer.window_set_position(Vector2i(-4000, -4000))
  1722		var blank := "--bench-blank" in OS.get_cmdline_user_args()
  1723		if blank:
  1724			visible = false   # 只量烘焙本身：畫面不畫
  1725		var cold: Dictionary = await _bench_wait(false)
  1726		var warm: Array = []
  1727		for i in 20:
  1728			var cb := i % 2 == 0
  1729			sprites.build(cb)
  1730			var w: Dictionary = await _bench_wait(cb)
  1731			w["cb"] = cb
  1732			warm.append(w)
  1733		var AP = preload("res://scripts/ui/atlas_pack.gd")
  1734		var rep := {"blank": blank, "pack": AP.usable(), "why": AP.why, "misses": AP.misses, "cold": cold, "warm": warm, "stats": sprites.pack_stats.duplicate(), "stages": sprites.stage_report(),
  1735			"tex_mib": snappedf(Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED) / 1048576.0, 0.1), "static_mib": snappedf(Performance.get_monitor(Performance.MEMORY_STATIC) / 1048576.0, 0.1)}
  1736		var f := FileAccess.open(out_path, FileAccess.WRITE)
  1737		f.store_string(JSON.stringify(rep, "  "))
  1738		f.close()
  1739		get_tree().quit()
  1740	
  1741	## 1.6.0 B09（S7）烘離線圖集包：預設塗裝 × 一般／色盲，全部 22 種兵的頁條、轉身、待機、走路轉身、轉身出手、背面走路、腳底圈。
  1742	## 烘完自我核對（兵種條拼回整頁要逐像素一樣）、寫清冊（來源雜湊、引擎、渲染路徑）。視窗移到畫面外（不搶焦點）。
  1743	## 用法：<exe> --path game --resolution 1280x800 -- --bake-pack=<報告 json 絕對路徑>
  1744	func _run_bake_pack(report_path: String) -> void:
  1745		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
  1746		DisplayServer.window_set_position(Vector2i(-4000, -4000))
