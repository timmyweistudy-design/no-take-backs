+	ok(g._tw_route()["path"] == "cr", "重複點：已選過不改")
+	# 結果頁：岔口時按「爬下一層」＝先開岔路
+	SV.data["tower_route"] = {"v": 1, "floor": 10, "path": "cr", "seals": 3, "done": 9}
