     1	extends RefCounted
     2	## 1.4.0 §11.1（1.3.0 延伸、stash 補完）：無盡塔——一路往上打，每層一種突變（沿用每日挑戰的 8 種）、地圖與 AI 性格輪換，
     3	## 敵方預算每層多一點（上限 +60）；輸一場就結束，記最高層數（本機）。每層的規則與敵陣只由層數決定（固定種子、跨機器一樣）。
     4	const Daily = preload("res://scripts/game/daily.gd")
     5	const AI = preload("res://scripts/core/ai_army.gd")
     6	const BONUS_STEP := 4     # 每層敵方多 4 金
     7	const BONUS_MAX := 60
     8	
     9	static func spec(floor_no: int) -> Dictionary:
    10		var f := maxi(1, floor_no)
    11		var mut := posmod(f - 1, Daily.MUTATORS)
    12		return {"floor": f, "mut": mut, "map": 3 if mut == 3 else posmod(f * 5 + 2, 6), "style": posmod(f * 3 + 1, 5),
    13			"level": clampi((f - 1) / 6, 0, 2), "seed": 70000 + posmod(f * 7919, 1000003), "bonus": mini(BONUS_MAX, (f - 1) * BONUS_STEP)}
    14	
    15	## 這一層的規則：每日挑戰的規則（自由部署、單局、突變）再加敵方預算。
    16	static func make_rules(sp: Dictionary, mask: int):
    17		var r = Daily.make_rules(sp, mask)
    18		var RS = load("res://scripts/core/ruleset.gd")
    19		r.budget = [int(r.budget_of(0)), mini(RS.BUDGET_MAX, int(r.budget_of(1)) + int(sp["bonus"]))]   # 大地圖本來就接近上限：加碼夾在合法範圍內
    20		if int(sp.get("route", 0)) != 0:
    21			# 1.6.0 B17：路線加減在封頂之後算（休整一定有效；契約到上限就沒有加碼，卡片照實寫；Codex B17 r1）
    22			r.budget[1] = clampi(int(r.budget[1]) + int(sp["route"]), RS.BUDGET_MIN, RS.BUDGET_MAX)
    23		r.handicap = int(r.budget[1]) != int(r.budget[0])   # 兩邊預算不同要開讓子，否則 budget_of 兩邊都取藍方（stash 原本漏了，測試抓到）
    24		return r
    25	
    26	static func enemy(sp: Dictionary, r):
    27		return Daily.enemy(sp, r)
    28	
    29	## 記最高層：過了第 f 層＝最高至少 f。回傳 [新最高, 是否刷新]。
    30	static func record(best: int, cleared_floor: int) -> Array:
    31		return [maxi(best, cleared_floor), cleared_floor > best]
    32	
    33	## 續局：下一次要打的層（0＝沒有進行中的塔）。贏了＝下一層、輸了＝清掉；壞資料＝0。
    34	static func next_run(run: int, floor_no: int, won: bool) -> int:
    35		return floor_no + 1 if won else 0
    36	
    37	static func sanitize_run(v) -> int:
    38		return clampi(int(v), 0, 100000) if (v is int or v is float) else 0
    39	
    40	## ── 1.6.0 B17（P7.1、P7.2；S6）塔分岔＋完整續塔 ──
    41	## 每過三層（打完第 3、6、9…層）要選一次路：契約（接下來三層敵方 +CONTRACT_BONUS 金，每過一層記一枚契約章）／休整（下一層敵方 −REST_CUT 金）。
    42	## 路線狀態（存檔 tower_route）＝{v, floor（下一次要打的層，0＝沒有進行中）, path（每個岔口的選擇：c＝契約、r＝休整、-＝舊存檔沒有紀錄）, seals（契約章）, done（已結算到第幾層）}。
    43	## 一切只由 path 與層數決定（沒有亂數）：兩台機器同一條路線雜湊一樣、重啟不重抽；結算記 done，同一層不重領。
    44	## 舊存檔只有 tower_run（層數）：遷移成同一層、過去的岔口記 "-"（不猜當時選了什麼，也不補問）。
    45	const FORK_EVERY := 3
