  2686		var eff: Array = []
  2687		for k in Tower.CONTRACT_SPAN:
  2688			eff.append(Tower.route_effect(f + k, Tower.CONTRACT_BONUS, mask))
  2689		if eff.all(func(x): return int(x) == Tower.CONTRACT_BONUS):
  2690			return L.t("tw_fork_c_d", [Tower.CONTRACT_SPAN, Tower.CONTRACT_BONUS])
  2691		if eff.all(func(x): return int(x) == 0):
  2692			return L.t("tw_fork_c_cap", [Tower.CONTRACT_SPAN])
  2693		var parts: PackedStringArray = []
  2694		for x in eff:
  2695			parts.append("+%d" % int(x))
  2696		return L.t("tw_fork_c_part", ["／".join(parts)])
  2697	
  2698	func _draw_tower_fork() -> void:
  2699		_dim(0.6)
  2700		var rt := _tw_route()
  2701		var f := int(rt["floor"])
  2702		var cd := fork_contract_text(f, RS.mask(false))
  2703		var cards := [["c", L.t("tw_fork_c"), cd], ["r", L.t("tw_fork_r"), L.t("tw_fork_r_d", [-Tower.route_effect(f, -Tower.REST_CUT, RS.mask(false))])]]
  2704		var ch := 0.0
  2705		for c in cards:
  2706			ch = maxf(ch, 16.0 + tz("B") * 1.4 + text_h(str(c[2]), tz("S"), 300) + 16.0)
  2707		var P := modal_rect(760, 12.0 + h1_help_h(L.t("tw_fork_help", [f]), tz("S"), 680) + GAP_L + ch + GAP_L + 44.0 + GAP_L)
