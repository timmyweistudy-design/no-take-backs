    49	static func new_route() -> Dictionary:
    50		return {"v": ROUTE_V, "floor": 1, "path": "", "seals": 0, "done": 0}
    51	
    52	## 這一層開打前要先選路嗎（第 4、7、10…層開打前；這個岔口還沒選）
    53	static func fork_due(st: Dictionary) -> bool:
    54		var f := int(st.get("floor", 0))
    55		return f > 1 and (f - 1) % FORK_EVERY == 0 and str(st.get("path", "")).length() < (f - 1) / FORK_EVERY
    56	
    57	## 選路：只在該選的時候生效（重複點、晚到的點擊＝原樣回傳）
    58	static func choose(st: Dictionary, c: String) -> Dictionary:
    59		if not fork_due(st) or not c in ["c", "r"]:
    60			return st
    61		var out := st.duplicate(true)
    62		out["path"] = str(st["path"]) + c
    63		return out
    64	
    65	## 第 k 個岔口（0 起）之後的第一層＝k*3+4
    66	static func _fork_floor(k: int) -> int:
    67		return (k + 1) * FORK_EVERY + 1
    68	
    69	## 這一層吃到的路線加減：[敵方加減金, 是不是契約層]
    70	static func route_adj(path: String, floor_no: int) -> Array:
    71		var adj := 0
    72		var contract := false
    73		for k in path.length():
    74			var f0 := _fork_floor(k)
    75			if path[k] == "c" and floor_no >= f0 and floor_no < f0 + CONTRACT_SPAN:
    76				adj += CONTRACT_BONUS
    77				contract = true
    78			elif path[k] == "r" and floor_no == f0:
    79				adj -= REST_CUT
    80		return [adj, contract]
    81	
    82	## 帶路線的這一層：spec 的敵方加碼再加減（夾在 0 以上），附 contract
    83	static func spec_route(st: Dictionary, floor_no: int) -> Dictionary:
    84		var sp := spec(floor_no)
    85		var ra := route_adj(str(st.get("path", "")), floor_no)
    86		sp["bonus"] = maxi(0, int(sp["bonus"]) + int(ra[0]))
    87		sp["contract"] = bool(ra[1])
    88		return sp
    89	
    90	## 結算一層（只一次）：回 [新狀態, 有沒有變]。贏＝下一層、契約層加一枚章；輸＝路線結束（floor 0，章數照留在這次結果裡）。
    91	static func settle(st: Dictionary, floor_no: int, won: bool) -> Array:
    92		if floor_no <= int(st.get("done", 0)) or floor_no != int(st.get("floor", 0)):
    93			return [st, false]
    94		var out := st.duplicate(true)
    95		out["done"] = floor_no
    96		if won:
    97			out["floor"] = floor_no + 1
    98			if bool(route_adj(str(st.get("path", "")), floor_no)[1]):
    99				out["seals"] = int(st.get("seals", 0)) + 1
   100		else:
   101			out["floor"] = 0
   102		return [out, true]
   103	
   104	## 路線雜湊（S6：兩台機器同一條路線一樣）
   105	static func route_hash(st: Dictionary) -> String:
   106		return ("%d|%s|%d" % [int(st.get("v", ROUTE_V)), str(st.get("path", "")), int(st.get("floor", 0))]).sha256_text().substr(0, 12)
   107	
   108	## 舊存檔：只有 tower_run（下一次要打的層）。過去的岔口記 "-"（不猜歷史），done＝前一層（不能重領）。
   109	static func migrate_old(run: int) -> Dictionary:
   110		if run <= 0:
   111			return {"v": ROUTE_V, "floor": 0, "path": "", "seals": 0, "done": 0}
   112		return {"v": ROUTE_V, "floor": run, "path": "-".repeat((run - 1) / FORK_EVERY), "seals": 0, "done": run - 1}
   113	
   114	static func _int_in(v, lo: float, hi: float) -> bool:
   115		return (v is int or (v is float and float(v) == floorf(float(v)))) and float(v) >= lo and float(v) <= hi
   116	
   117	## 存檔讀回：逐欄驗型；壞了回 null（呼叫端用 tower_run 遷移）。路線長度不能超過層數允許的岔口數。
   118	static func sanitize_route(v):
   119		if not v is Dictionary:
   120			return null
   121		if not _int_in(v.get("v"), 1, ROUTE_V) or not _int_in(v.get("floor"), 0, FLOOR_MAX) or not _int_in(v.get("seals"), 0, FLOOR_MAX) or not _int_in(v.get("done"), 0, FLOOR_MAX):
   122			return null
   123		var p = v.get("path")
   124		if not p is String or p.length() > FLOOR_MAX / FORK_EVERY:
   125			return null
   126		for ch in p:
   127			if not ch in ["c", "r", "-"]:
   128				return null
   129		var f := int(v["floor"])
   130		var forks_max := maxi(0, (maxi(f, int(v["done"]) + 1) - 1) / FORK_EVERY)
   131		if p.length() > forks_max:
   132			return null
   133		return {"v": int(v["v"]), "floor": f, "path": p, "seals": int(v["seals"]), "done": int(v["done"])}
