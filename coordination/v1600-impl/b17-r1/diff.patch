+const FORK_EVERY := 3
+const CONTRACT_BONUS := 8
+const CONTRACT_SPAN := 3
+const REST_CUT := 8
+const ROUTE_V := 1
+const FLOOR_MAX := 100000
+
+static func new_route() -> Dictionary:
+	return {"v": ROUTE_V, "floor": 1, "path": "", "seals": 0, "done": 0}
