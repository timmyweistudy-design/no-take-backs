## 結果頁的無盡塔按鈕：照正式結算，不照畫面上這一場（覆盤、重播）→ [文字鍵, 下一次的層]
static func tower_button(result: int, floor_no: int) -> Array:
	if result == 0:
		return ["tw_next", floor_no + 1]
	if result == 1:
		return ["tw_again", 1]
	return []

## 遠征牌上的入口：有進行中的塔就從那一層繼續（回標題也保留，方案 §11.11）
func _tower_open() -> void:
	if _demo():
		_toast(L.t("demo_locked"), true)
		return
	var rt := _tw_route()
	if int(rt["floor"]) <= 0:
		rt = Tower.new_route()   # 沒有進行中的塔：開一條新路線
		_tw_save_route(rt)
	elif int(rt["floor"]) > 1:
		_toast(L.t("tw_resume", [int(rt["floor"])]))
	if Tower.fork_due(rt):
		overlay = "tower_fork"   # 1.6.0 B17（P7.1）：這一層開打前先選路
		_focus = 0
		return
	_tower_start(int(rt["floor"]))

## 1.6.0 B17：目前的路線（存檔的 tower_route；沒有就從 tower_run 遷移，不猜歷史）
func _tw_route() -> Dictionary:
	var rt = Tower.sanitize_route(Save.data.get("tower_route"))
	return rt if rt != null else Tower.migrate_old(int(Save.data.get("tower_run", 0)))

## 寫路線（tower_run 同步給舊版）；寫檔失敗照實說（記憶體裡照樣往下，Save 會重試）
func _tw_save_route(rt: Dictionary) -> bool:
	Save.data["tower_route"] = rt
	Save.data["tower_run"] = int(rt["floor"])
	if Save.save_data():
		return true
	_toast(L.t("save_failed"), true)
	return false

## 岔口：選契約或休整（重複點、晚到的點擊不改路線）。選完存檔、直接開打這一層。
func _tw_choose(c: String) -> void:
	var rt := _tw_route()
	if not Tower.fork_due(rt):
		return
	rt = Tower.choose(rt, c)
	_tw_save_route(rt)
	overlay = ""
	_tower_start(int(rt["floor"]))

func _draw_tower_fork() -> void:
	_dim(0.6)
	var rt := _tw_route()
	var f := int(rt["floor"])
	var ce := Tower.route_effect(f, Tower.CONTRACT_BONUS, RS.mask(false))   # 封頂後實際加多少（到上限＝0，照實寫）
	var cd := L.t("tw_fork_c_d", [Tower.CONTRACT_SPAN, Tower.CONTRACT_BONUS]) if ce >= Tower.CONTRACT_BONUS else L.t("tw_fork_c_cap", [Tower.CONTRACT_SPAN])
	var cards := [["c", L.t("tw_fork_c"), cd], ["r", L.t("tw_fork_r"), L.t("tw_fork_r_d", [-Tower.route_effect(f, -Tower.REST_CUT, RS.mask(false))])]]
	var ch := 0.0
	for c in cards:
		ch = maxf(ch, 16.0 + tz("B") * 1.4 + text_h(str(c[2]), tz("S"), 300) + 16.0)
	var P := modal_rect(760, 12.0 + h1_help_h(L.t("tw_fork_help", [f]), tz("S"), 680) + GAP_L + ch + GAP_L + 44.0 + GAP_L)
	_panel(P)
	var y := _h1_help(Vector2(640, P.position.y + 12), L.t("tw_fork_title"), L.t("tw_fork_help", [f]), tz("S"), 680) + GAP_L
	for i in 2:
		var c: Array = cards[i]
		var r := Rect2(640 - 340 + i * 350, y, 330, ch)
		var key: String = c[0]
		_btn(r, "", func(): _tw_choose(key), Tower.fork_due(rt))   # 兩條路同等份量（不設主鈕；主鈕的圓鈕裝飾會壓到卡片字）
		_text(r.position + Vector2(165, 16), str(c[1]), tz("B"), INK if last_btn_paper else Color.WHITE, true, true, 300)
		_text(r.position + Vector2(165, 16 + tz("B") * 1.4), str(c[2]), tz("S"), INK if last_btn_paper else TXT_DIM, true, false, 300)
	_btn(Rect2(560, P.end.y - GAP_L - 44.0, 160, 44), L.t("back"), func(): overlay = "")
	screen_register("result", "tw_fork_c")   # 從結果頁／遠征牌進來的選擇框：照結果類上限檢查（Codex B17 r1）

func _tower_start(floor_no: int) -> void:
	if _demo():
		_toast(L.t("demo_locked"), true)
		return
	var rt := _tw_route()
	if int(rt["floor"]) != floor_no:
		rt = Tower.new_route()   # 不是路線上的這一層（例如規則不合法退回第 1 層）：重開一條
		rt["floor"] = floor_no
		rt["done"] = floor_no - 1
		rt["path"] = "-".repeat((floor_no - 1) / Tower.FORK_EVERY)
	var sp: Dictionary = Tower.spec_route(rt, floor_no)
	var r = Tower.make_rules(sp, RS.mask(false))
	if not r.validate().is_empty():
		_toast(L.t("ch_bad"), true)   # 規則不合法＝提示並回第 1 層（方案 §11.11）
		if floor_no > 1:
			Save.data["tower_run"] = 0
			_tower_start(1)
		return
	set("daily_spec", {})        # 從每日挑戰／每日練習直接進塔：不帶每日狀態（不記每日紀錄、不跳過塔結算，Codex cat11 #1）
	set("daily_practice", false)
	rules = r
	challenge_army = Tower.enemy(sp, r)   # 這一層固定的敵陣（走挑戰碼那條路）
	overlay = ""
	_start_mode(Mode.VS_AI)
	tower_on = true
	tower_floor = int(sp["floor"])
	tower_result = -1
	if _tw_save_route(rt):   # 續局寫進存檔（中途關遊戲也從這一層繼續，Codex cat11 #3）
		_toast(L.t("tw_head", [tower_floor, L.t("daily_mut_%d" % int(sp["mut"]))]) + (L.t("tw_contract_tag") if bool(sp.get("contract", false)) else ""))
	# 寫不進：留著「存檔失敗」提示（不被開層提示蓋掉；Codex B17 r1）

func _tower_finish(w: int) -> void:
	if not tower_on or mode != Mode.VS_AI or play_kind != "official":
		return
	var best := int(Save.data.get("tower_best", 0))
	var st: Array = Tower.settle(_tw_route(), tower_floor, w == 0)   # 1.6.0 B17：結算只一次（done）；路線＋tower_run 一起寫
	if bool(st[1]):
		Save.data["tower_route"] = st[0]
	Save.data["tower_run"] = int(_tw_route()["floor"])
	tower_result = 0 if w == 0 else 1
	if w == 0:
		var r: Array = Tower.record(best, tower_floor)
		Save.data["tower_best"] = r[0]
		_toast(L.t("tw_floor_clear", [tower_floor]))
	else:
		_toast(L.t("tw_over", [tower_floor, best]))
extends RefCounted
## V1.1 D2：每日挑戰＋每週突變。純函式，不碰畫面（遊戲、測試共用）。
## 不改模擬：只用現有規則參數（預算、隻數、每種上限、卡池、地圖、縱深、局長、雙方手動技能）＋AI 用固定種子組敵陣。
## 日期用 UTC 日數，跨時區同一天同一題。紀錄鍵＝日數＋VER：AI 或這份產生器一改就升 VER（測試 test_daily_v11 釘住幾天的敵陣，改了會紅）。

const VER := 1
const MUTATORS := 8
const KEEP_DAYS := 10          # 存檔只留最近幾天的最佳紀錄
const CMD = preload("res://scripts/core/cmd_defs.gd")
const Presets = preload("res://scripts/game/presets.gd")
const MapDefs = preload("res://scripts/core/map_defs.gd")
const AI = preload("res://scripts/core/ai_army.gd")

static func today() -> int:
	return int(Time.get_unix_time_from_system()) / 86400

## 這一天的題目規格。mut＝這週的突變（每 7 天換一個），map／style 每天換。
static func spec(day: int) -> Dictionary:
	var mut := posmod(day / 7, MUTATORS)
	var map_id := 3 if mut == 3 else posmod(day * 5 + 1, 6)
	return {"day": day, "key": "%d-v%d" % [day, VER], "mut": mut, "map": map_id, "style": posmod(day * 7 + 3, 5),
		"level": 1, "seed": 90000 + posmod(day * 2654435761, 1000003)}

static func pool_of(types: Array) -> int:
	var p := 0
	for t in types:
		p |= 1 << int(t)
	return p

## 把突變套到一組（已經是自由部署、單局的）規則上。r＝RuleSet。
static func apply(r, sp: Dictionary) -> void:
	r.map_id = int(sp["map"])
	r.map_size = 1
	r.ai_style = int(sp["style"])
	r.ai_level = int(sp["level"])
	r.ai_pool_same = false
	r.rounds = 1
	r.preset = "custom"
	var kingdom := (1 << 10) - 1
	var fantasy := ((1 << 20) - 1) & ~kingdom
	var pool := kingdom
	match int(sp["mut"]):
		0:   # 貼臉肉搏：近戰卡池、最深縱深、60 秒
			pool = pool_of([0, 1, 3, 4, 5, 7, 8, 9])
			r.depth = 7500
			r.ticks = 1200
		1:   # 精兵演武：只能 8 隻、每種 1 隻、高預算
			r.unit_cap = 8
			r.type_cap = 1
			r.budget = [140, 140]
		2:   # 人海戰術：40 隻、只有便宜的兵
			pool = pool_of([0, 1, 2, 5, 8])
			r.unit_cap = 40
		3:   # 禁魔死鬥：冰原、不開技能（map 已在 spec 固定）
			pass
		4:   # 百家爭鳴：每種 1 隻、預算 150
			r.type_cap = 1
			r.budget = [150, 150]
		5:   # 閃電決戰：60 秒、雙方技能全開（護盾、戰吼、隕石）
			r.ticks = 1200
			var m5 := (1 << CMD.AEGIS) | (1 << CMD.WARCRY) | (1 << CMD.METEOR)
			r.cmd_mask = [m5, m5]
		6:   # 孤軍深入：最深縱深、低預算、每種最多 2 隻
			r.depth = 7500
			r.budget = [70, 70]
			r.type_cap = 2
		7:   # 神仙打架：奇幻卡池、高預算、隻數少、技能全開
			pool = fantasy
			r.budget = [150, 150]
			r.unit_cap = 12
			var m7 := (1 << CMD.AEGIS) | (1 << CMD.HEAL) | (1 << CMD.METEOR)
			r.cmd_mask = [m7, m7]
	r.pool = [pool, pool]

## 成績比較：剩餘戰力高的好，一樣就花得少的好。rec＝[剩餘%, 花費]。
static func better(a: Array, b: Array) -> bool:
	if b.is_empty():
		return true
	return int(a[0]) > int(b[0]) or (int(a[0]) == int(b[0]) and int(a[1]) < int(b[1]))

## 記一場（贏了才記）。回傳 true＝新紀錄。best＝存檔的 daily_best（會被修改、只留最近 KEEP_DAYS 天）。
static func record(best: Dictionary, sp: Dictionary, rem: int, spent: int) -> bool:
	var k: String = sp["key"]
	var cur: Array = best.get(k, [])
	var nw := better([rem, spent], cur)
	if nw:
		best[k] = [rem, spent]
	var keys: Array = best.keys()
	keys.sort_custom(func(a, b): return int(str(a).get_slice("-", 0)) > int(str(b).get_slice("-", 0)))
	for i in range(KEEP_DAYS, keys.size()):
		best.erase(keys[i])
	return nw


## 這一天的完整規則（自由部署、16×9、單局；再套突變）。mask＝能用的兵種（正式版全開）。
static func make_rules(sp: Dictionary, mask: int):
	var r = Presets.make("standard", "ai", mask)
	r.deploy = "free"
	r.spacing = 800
	r.depth = 6000
	r.fullfield = 0
	var s: Array = MapDefs.SIZE_SUGGEST[1]
	r.budget = [int(s[0]), int(s[0])]
	r.unit_cap = int(s[1])
	r.ticks = int(s[2])
	apply(r, sp)
	return r

## 這一天的敵陣：普通 AI＋固定種子，跟遊戲流程無關（不吃玩家陣型、不吃全域亂數），跨機器一樣。
static func enemy(sp: Dictionary, r):
	var g := RandomNumberGenerator.new()
	g.seed = int(sp["seed"])
	var p1: int = r.pool_of(1)
	if r.ai_style != 0:
		p1 = AI.style_pool(p1, r.ai_style, g)
	return AI.build(1, r.budget_of(1), g, -1, p1, r)["army"]

