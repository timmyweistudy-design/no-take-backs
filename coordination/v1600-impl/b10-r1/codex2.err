  1985	## 預烘成 32×32 小圖（兩格：一塊／兩塊），每隻受傷的兵只多 1 次貼圖（1.1.0 教訓：每幀逐隻向量畫 p95 多 20%）。召喚物不掉漆。
  1986	static var _chip_tex: Texture2D = null
  1987	static func chip_tex() -> Texture2D:
  1988		if _chip_tex != null:
  1989			return _chip_tex
  1990		var img := Image.create(64, 32, false, Image.FORMAT_RGBA8)
  1991		img.fill(Color(0, 0, 0, 0))
  1992		var wood := Color(0.93, 0.82, 0.6, 0.95)
  1993		var edge := Color(0.32, 0.2, 0.1, 0.8)
  1994		for cell in 2:
  1995			var spots: Array = [[Vector2(12, 14), 5.0]] if cell == 0 else [[Vector2(12, 12), 5.0], [Vector2(20, 21), 4.0]]
  1996			for sp in spots:
  1997				var c: Vector2 = sp[0] + Vector2(cell * 32, 0)
  1998				var r: float = sp[1]
  1999				for y in range(int(c.y - r - 1), int(c.y + r + 2)):
  2000					for x in range(int(c.x - r - 1), int(c.x + r + 2)):
  2001						var d := Vector2(x, y).distance_to(c) + (0.8 if (x + y) % 3 == 0 else 0.0)   # 不規則的剝落邊
  2002						if d <= r - 1.0:
  2003							img.set_pixel(x, y, wood)
  2004						elif d <= r:
  2005							img.set_pixel(x, y, edge)
  2006		_chip_tex = ImageTexture.create_from_image(img)
  2007		return _chip_tex
