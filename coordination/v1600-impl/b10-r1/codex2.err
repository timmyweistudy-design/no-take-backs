  1367	func _hp_arc(p: Vector2, u, ha: float) -> void:
  1368		var c := p + Vector2(0, Art.BASE_EDGE * 0.5) * UNIT_SCALE
  1369		var rx := 21.0 * UNIT_SCALE
  1370		var ry := 10.5 * UNIT_SCALE
  1371		var a0 := PI * 0.12
  1372		var a1 := PI * 0.88
