## 角色的局部座標轉換（以腳底為原點、face＝+1 畫）：呼吸／走路起伏、前撲、傾身、壓扁拉長、翻面。
## lean＝額外傾角（騎兵衝鋒前傾）、crouch＝縱向縮放（刺客潛行蹲身）。
static func unit_xf(p: Vector2, face: float, walk: float, atk: float, t: float, scale := 1.0, lean := 0.0, crouch := 1.0, gtype := 0) -> Transform2D:
	# 外層（位置、起伏、翻面、縮放、額外傾身／蹲身）× 內層（攻擊姿勢，face＝+1 空間）。
	# 精靈圖快取烘焙的是內層，貼圖時套外層，所以兩條路的順序完全一樣（Codex R5 #3）。
	var ps := pose(atk, gtype)
	var bob := idle_bob(t, p) if walk == 0.0 else -Gait.air(gtype, walk)
	var outer := Transform2D(lean * face, Vector2(scale * face, scale * crouch), 0.0, p + Vector2(0, bob * scale))
	return outer * Transform2D(ps[1], Vector2(ps[2], ps[3]), 0.0, Vector2(ps[4], 0))


## 單位：p＝腳底；face＝±1；walk＝走路相位（0＝沒走）；atk＝攻擊動作進度 0～1（見上）；hurt＝受擊閃白 0～1；
## alpha＝透明度（潛行）；t＝時間（待機呼吸）；scale＝縮放；mood＝表情疊加（M_*）；lean／crouch 見 unit_xf。
static func unit(ci: CanvasItem, p: Vector2, type: int, team: int, face: float, walk: float, atk: float,
		hurt: float, alpha: float, t: float, scale := 1.0, cb := false, mood := 0, lean := 0.0, crouch := 1.0, variant := 0) -> void:
	var tc := team_color(team, cb)
	_team_now = team
	var w: float = pose(atk, type)[0]
	if atk > 0.0:
		walk = 0.0   # 和精靈圖一致：攻擊格沒有走路相位
	_xf = base * unit_xf(p, face, walk, atk, t, scale, lean, crouch, type)
	_b_now = Transform2D.IDENTITY
	if turn_c < 1.0:
		_xf0 = _xf
		# 史萊姆轉向鏡頭時微微拉高（Antigravity v130-impl1：只有眼睛動看不出在轉）
		var sy := 1.0 + 0.06 * (1.0 - turn_c) if type == 13 else 1.0
		_xf = _xf * Transform2D(0.0, Vector2(turn_body_w(type) * (0.97 if type == 13 else 1.0), sy), 0.0, Vector2.ZERO)
	_cur_xf = _xf
	ci.draw_set_transform_matrix(_xf)
	# 以 face＝+1 畫（水平鏡像由 transform 處理）
	if type == D.CAVALRY:
		_cavalry(ci, tc, walk, w, alpha, t, atk > 0.0 and not calm)
	elif type >= D.COUNT:
		_fantasy(ci, type, tc, walk, w, alpha, t, atk > 0.0 and not calm, variant)
	else:
		_infantry(ci, type, tc, walk, w, alpha, t, atk > 0.0 and not calm, variant)
	if hurt > 0.0:
		# 受擊閃白：在身體位置疊一層白
		ci.draw_circle(Vector2(0, -26), 14.0, Color(1, 1, 1, hurt * 0.55 * alpha), true, -1.0, true)
	if mood != 0:
		overlay(ci, type, team, mood, alpha, t, cb)
	ci.draw_set_transform_matrix(base)


## 表情與狀態疊加：呼叫前畫布轉換要已經是這隻角色的局部座標（face＝+1 空間）。
static func overlay(ci: CanvasItem, type: int, team: int, mood: int, a: float, t: float, cb := false) -> void:
	if mood & M_HAPPY:
		mood &= ~M_HURT   # V1.3.1：歡呼優先於受擊眼
	var ec := Vector2(2.0, -43.0) if type == D.CAVALRY else (Vector2(5.5, -33.5) if type == D.ASSASSIN else Vector2(3.5, -32.0))
	if type >= D.COUNT:
		if not FEATURE_EYES.has(type):
			return   # 寶箱怪、羊、沙漏等臉在別處，不疊通用表情
		ec = FEATURE_EYES[type]
	var eyes := [ec + Vector2(-3.0 if type != D.ASSASSIN else -2.5, 0), ec + Vector2(4.0 if type != D.ASSASSIN else 2.5, 0)]
	var skin := Color("#2b2140") if type == D.ASSASSIN else SKIN
	match type:   # V1.3.1：新加表情的兵種，蓋眼睛用自己臉的顏色（Codex v131-impl2：通用膚色會變異色圓斑）
		11:
			skin = Color("#3a3346")
		14:
			skin = team_color(team, cb).lightened(0.3)
		17, 21:
			skin = Color("#f5f0e0")
	if mood & (M_HAPPY | M_SURPRISE | M_GRIM):
		for e in eyes:
const BOSS_SIL_PX := 3.0   # 1.6.0 B10（P4.4）：巨獸外框多加的畫面像素
func focus_scale(id: int) -> float:
	return FOCUS_SCALE if follow_id >= 0 and id == follow_id else 1.0

## 1.6.0 B08（P3.3、S4）：兵偶頭胸框（戰場座標）——跳字不蓋。腳底點往上 FACE_BOT～FACE_TOP（×HK×巨獸／跟拍縮放），半寬 FACE_HW。
## 站姿的頭胸對截圖量過（14～54、半寬 17，--face-debug 畫得出來）；再包住姿勢起伏（Codex B08 r1 #2）：跳步 ≤10px、走路起伏 4、
## 幽靈上下漂 ≤5.5、衝鋒前傾 ≤15°（頭頂橫移約 ±17px）→ 上緣多 12、左右各多 6（HK 單位）。
const FACE_TOP := 66.0
const FACE_BOT := 14.0
const FACE_HW := 23.0
func face_rects() -> Dictionary:
	var out := {}
	if view == null:
		return out
	for u in view.units:
		if not u.alive or u.hidden:
			continue
		var sc: float = (BossD.DRAW_SCALE if u.boss else 1.0) * focus_scale(u.id) * HK
		var p: Vector2 = _upos(u) + _open_drop(u)
		out[u.id] = Rect2(p + Vector2(-FACE_HW, -FACE_TOP) * sc, Vector2(FACE_HW * 2.0, FACE_TOP - FACE_BOT) * sc)
	return out

## 交戰區：和敵兵相距 ≤1.5 格的兵的外接框，往外一格、夾在盤內；沒有交戰＝整個盤。
func engage_rect() -> Rect2:
	var board := Rect2(ORIGIN, fld_size)
	if view == null:
		return board
	var ps: Array = [[], []]
	for u in view.units:
		if u.alive and not u.hidden:
			ps[u.team].append(_upos(u))
	var r := Rect2()
	var any := false
	var lim := (CS * 1.5) * (CS * 1.5)
	for a: Vector2 in ps[0]:
		for b: Vector2 in ps[1]:
			if a.distance_squared_to(b) <= lim:
				var pair := Rect2(a, Vector2.ZERO).expand(b)
				r = pair if not any else r.merge(pair)
				any = true
	if not any:
		return board
	return r.grow(CS).intersection(board)

func _draw_face_debug() -> void:
	var fr: Dictionary = face_rects()
	for id in fr:
		draw_rect(fr[id], Color(1, 0, 1, 0.9), false, 1.5)
	draw_rect(engage_rect(), Color(0, 1, 1, 0.9), false, 2.0)
	for f in fx:
		if f["kind"] == "text" and f.has("dr"):
				D.DRUMMER:   # 鼓手：頭邊冒音符
					var nk := fmod(time * 1.6 + u.id * 0.3, 1.0)
					_icon("sound", p + Vector2(18 + nk * 8, -48 - nk * 22 - hop), 14.0, Color(1.0, 0.85, 0.4, 1.0 - nk))
				D.BERSERKER:   # 狂戰士：雙斧互敲的火花圈
					var bk := absf(sin((time + u.id * 0.05) * PI / 0.45))
					_hand_ring(p + Vector2(0, -50 - hop), 8.0 + bk * 6.0, Color(1.0, 0.55, 0.2, 0.8 * bk), 2.5)
				D.MEDIC:   # 醫者：綠色小十字往上飄
					var mk := fmod(time * 1.2 + u.id * 0.4, 1.0)
					var mc := p + Vector2(-16, -44 - mk * 24 - hop)
					draw_line(mc - Vector2(4, 0), mc + Vector2(4, 0), Color(0.5, 1.0, 0.55, 1.0 - mk), 2.5)
					draw_line(mc - Vector2(0, 4), mc + Vector2(0, 4), Color(0.5, 1.0, 0.55, 1.0 - mk), 2.5)
		p.y -= hop
		if u.hidden:
			Art.mimic_closed(self, p, u.team, face, alpha, time, cbm(), UNIT_SCALE)   # 偽裝中的寶箱怪
			continue
		if u.type == F8.GHOST:
			alpha *= 0.9
			p.y -= 3.0 + 2.5 * sin(time * 2.2 + u.id * 0.9)   # V1.1 A4：幽靈上下漂
			if moving and live and not bool(Save.s("reduce_fx")):
				# V1.0.0 角色（剪影辨識）：移動時身後一串淡煙（貼著身體，0.3 格內），和史萊姆、盾兵的剪影分開
				for k5 in 3:
					var ph5 := fmod(time * 2.5 + k5 * 0.33 + u.id * 0.17, 1.0)
					draw_circle(p + Vector2(-face * (10.0 + ph5 * 12.0), -14.0 + ph5 * 4.0), 5.0 * (1.0 - ph5) * UNIT_SCALE, Color(0.85, 0.9, 1.0, 0.35 * (1.0 - ph5) * alpha), true, -1.0, true)
		# 待機小動作（V9 P2）：重心換腳、偶爾縮一下身子
		if live and walk == 0.0 and at == 0.0:
			var tq := _pose_t(time)   # 1.2.0 第 5 大類 C：待機小動作走定格
			lean += sin(tq * 1.1 + u.id * 1.7) * 0.018
			var idle_k := fmod(tq + u.id * 1.37, 7.3)
			if idle_k < 0.3:
				crouch *= 1.0 - sin(idle_k / 0.3 * PI) * 0.05
			# 1.2.0 第 5 大類 D 個性動作：王國＝偶爾上發條（左右扭 0.4 秒）；奇幻＝呼吸膨縮（各兵相位不同）
			if u.type < D.COUNT:
				var wk := fmod(tq + u.id * 2.71, 9.7)
				if wk < 0.4:
					lean += sin(wk / 0.4 * TAU * 2.0) * 0.05
			else:
				crouch *= 1.0 + 0.03 * sin(tq * 2.0 + u.id * 1.3)
		if live:
			face = _face_of(u)
			# V1.3.1 P0-2：出手前先轉完。前搖一開始就面向目標（不改命中時間），出手中途目標換邊也維持到收招
			if at > 0.0:
				# 鎖定的是「這一擊」：連擊換到下一擊時重新取方向（Codex v131-impl1）
				if not atk_face.has(u.id) or int(atk_face[u.id][0]) != hit_now:
					atk_face[u.id] = [hit_now, signf(u.fx) if u.fx != 0 else (1.0 if face >= 0.0 else -1.0), float(face_now.get(u.id, face)), _disp_tick()]
				# V1.5.1 A3：前搖時從原本朝向轉過去（2 個畫面 tick，跟著暫停與倍速走），轉身途中出手用轉身攻擊格，不再瞬間跳回側面
				var tgt_f: float = float(atk_face[u.id][1])
				var f0: float = float(atk_face[u.id][2]) if atk_face[u.id].size() > 2 else tgt_f
				var kf := clampf((_disp_tick() - float(atk_face[u.id][3] if atk_face[u.id].size() > 3 else _disp_tick())) / 2.0, 0.0, 1.0)
				if signf(f0) == tgt_f and absf(f0) >= 0.9:
					face = tgt_f
				else:
					# 經過正面轉過去：寬度不低於 0.45（不壓成一條線），過半就朝向目標（不背對目標揮空，Antigravity v151-i1 #4）
					var lf := lerpf(f0, tgt_f, kf)
					# 從第一格就朝目標（轉身格的方向），寬度從轉到一半慢慢回到側面（Codex v151-i2：前半不再朝舊方向蓄力）
					face = tgt_f * (maxf(absf(lf), 0.45) if (kf >= 0.5 or signf(f0) == tgt_f) else 0.45)   # 同方向只是轉完剩下的角度
				face_now[u.id] = face
			elif atk_face.has(u.id):
				atk_face.erase(u.id)
			var tdk := _turn_dust_k(u)
			if tdk > 0.0 and not rfx:
				# V1.3 A1a：翻面時腳下踩出一小團塵土（畫在身體下面）
				for i in 3:
					var dx := (float(i) - 1.0) * (6.0 + (1.0 - tdk) * 8.0)
					draw_circle(p + Vector2(dx, 1.0 - (1.0 - tdk) * 3.0) , (2.0 + (1.0 - tdk) * 2.5) * UNIT_SCALE, Color(0.85, 0.75, 0.55, 0.55 * tdk), true, -1.0, true)
		if u.stealth > 0:
			# 潛行：身後兩道暗紫殘影
			for g in 2:
				var gp := p + Vector2(-(8 + g * 8) * face, 0)
				draw_circle(gp + Vector2(0, -22), 11.0 - g * 2.0, Color(0.3, 0.15, 0.45, 0.22 - g * 0.08), true, -1.0, true)
				_unit(gp, u.type, u.team, face, 0.0, 0.0, 0.0, 0.14 - g * 0.06, time, UNIT_SCALE)
		if live and walk <= Gait.POSE_DAZE + 1.0:
			# 暈眩：頭上轉圈的星星
			for sk0 in 3:
				var sa0 := time * 5.0 + sk0 * TAU / 3.0
				_icon("star", p + Vector2(cos(sa0) * 15.0, -60.0 * hk_of(u) + sin(sa0) * 5.0), 13.0, Color("#ffd166"))
		# V1.3.1 P1：待機小動作。站著沒事（沒走、沒出手、沒暈、還在打）時，每隻約 30～60 秒做一次、1.2 秒，依 id 錯開
		var fid := -1
		if live and not moving and at == 0.0 and u.stun <= 0 and not s.finished and mood == 0 and not bool(Save.s("reduce_fx")):
			var per := 30.0 + float((u.id * 7919) % 30)
			var tm := fmod(time + u.id * 3.7, per)
			if tm < 1.2:
				fid = mini(3, int(tm / 1.2 * 4.0))
		var ut := _pose_t(time) if (live and walk == 0.0 and at == 0.0) else time   # 1.2.0 第 5 大類 C：待機時整隻（含呼吸起伏）走定格時間（Codex cat05 #3）
		# 1.3.0 §5.4 依移動方向選視角：走路且不出手時，往南＝3/4 正面走路格、往北＝3/4 背面走路格（沒烘好就照舊側面）
		# 1.4.0 §5.3：整體壓縮蓄力（前搖）→ 出手時拉長，再回原形；只動畫面（命中 tick 不變，at 是展示時鐘算的）
		if bool(Save.s("reduce_motion")):
			pass   # 減少動態：不壓縮拉長（Codex cat05 #5）
		elif live and at > 0.0 and at < Art.ATK_WINDUP:
			crouch *= 1.0 - SQUASH * sin(at / Art.ATK_WINDUP * PI * 0.5)
		elif live and at >= Art.ATK_WINDUP and at < Art.ATK_STRIKE + 0.1:
			crouch *= 1.0 + STRETCH * sin(clampf((at - Art.ATK_WINDUP) / (Art.ATK_STRIKE + 0.1 - Art.ATK_WINDUP), 0.0, 1.0) * PI)
		if u.id == follow_id:
			mag_pose = [face, hurt, mood]   # 1.3.0 §2 放大鏡小窗用同一幀的表情
		var hd := heading_of(u.id, u.mx, u.my, live and walk > 0.0 and at == 0.0 and hurt <= 0.0 and not u.boss)
		var usc: float = UNIT_SCALE * (BossD.DRAW_SCALE if u.boss else 1.0) * focus_scale(u.id)
		var chip := (2 if u.hp * 4 < u.max_hp else 1) if (live and not u.hidden and not u.summon and u.max_hp > 0 and u.hp * 2 < u.max_hp) else 0   # 1.3.0 §5.2 受傷掉漆
		var drawn := false
		var cache_ok: bool = sprites != null and sprites.is_ready(cbm()) and not bool(Save.s("plain_ui"))
		if hd < 0 and cache_ok:
			drawn = sprites.draw_back_walk(self, p, u.type, u.team, face, walk, hurt, alpha, ut, usc, lean, crouch, cbm())
			if drawn and chip > 0:
				_chip_at(p, u.type, face, usc, chip, alpha)   # 背面也有掉漆（Codex cat05 #4）
		if not drawn:
			# 往南：只有圖集有走路轉身頁時才用 3/4 正面（沒有就照舊側面，不讓向量畫只橫縮；Codex cat05 #6）
			var front_ok: bool = hd > 0 and cache_ok and sprites.wt_loc.has(u.type)
			var fdraw: float = (signf(face) if face != 0.0 else 1.0) * HEAD_FRONT_C if front_ok else face
			if u.boss and not bool(Save.s("plain_ui")):
				# 1.6.0 B10（P4.4）巨獸外框加粗：先墊一層往外擴的墨色剪影（畫面約 +3px），再正常畫
				Art.sil_w = BOSS_SIL_PX / usc
				Art.unit(self, p, u.type, u.team, fdraw, walk, at, 0.0, alpha, ut, usc, cbm(), 0, lean, crouch, variant)
				Art.sil_w = 0.0
			_unit(p, u.type, u.team, fdraw, walk, at, hurt, alpha, ut, usc, mood, lean, crouch, variant, fid, chip)
		if live and not u.hidden and hd == 0:   # 南北走的轉身／背面頁不疊側面配件（Codex cat05 #4）
			_spring_acc(p, u.type, u.team, face, usc, crouch, lean, walk, at, alpha, u.id, ut)   # 1.4.0 §5.2 即時配件（延遲回彈）
		if live and not u.hidden and hd == 0:   # 南北走的那隻不補畫（補畫只有側面，會疊出另一個輪廓；Codex cat05 #5）
			xray.append([p, [u.type, u.team, face, walk, at, alpha, lean, crouch, variant], usc])
		# 揮擊殘影（第三輪 R1、S4 依兵種分開）
		if live and at >= Art.ATK_WINDUP and at < Art.ATK_STRIKE + 0.12:
			var sk := clampf((at - Art.ATK_WINDUP) / (Art.ATK_STRIKE + 0.12 - Art.ATK_WINDUP), 0.0, 1.0)
			_draw_smear(p, u.type, u.team, face, sk, alpha, variant, 1.0)
		# 衝鋒就緒的金色拖尾（第三輪 R3）
		if u.type == D.CAVALRY and moving and u.charge >= D.CHARGE_NEED:
			var tip := p + Vector2(face * 26.0, -44.0)
			for k in 4:
				var q0 := tip - Vector2(face * k * 8.0, 0)
				var q1 := tip - Vector2(face * (k + 1) * 8.0, 0)
				draw_line(q0, q1, Color(1.0, 0.86, 0.3, (0.8 - k * 0.2) * alpha), 3.0 - k * 0.5, true)
	_draw_xray(xray)
	while prop_i < fld_props.size():
		MapArt.draw_prop(self, ORIGIN, fld_props[prop_i], time)
		prop_i += 1
	for pp in pot_draw:
		draw_circle(pp, 6.5, Art.OUT, true, -1.0, true)
		draw_circle(pp, 5.0, Color("#2a2533"), true, -1.0, true)
		draw_circle(pp + Vector2(3, -5), 2.0, Color(1, 0.8, 0.3), true, -1.0, true)
	pot_draw.clear()
	# 施放者在飛行途中陣亡：已經離手的箭／炸彈照樣飛到（Antigravity v150-i1 #1）
	if live:
		var dtd := _disp_tick()
		for u in s.units:
			if u.alive or not proj_tgt.has(u.id) or not atk_hit.has(u.id):
				continue
			var phd := proj_phase(atk_hit[u.id], dtd, u.type, view.delay, proj_tgt[u.id])
			if float(phd[2]) >= 0.0 and proj_tgt[u.id].has(int(phd[1])):
				var ptd = view.unit_by_id(proj_tgt[u.id][int(phd[1])])
				if ptd != null:
					var sgd: float = signf(_upos(ptd).x - _upos(u).x) if _upos(ptd).x != _upos(u).x else 1.0
					proj_draw.append([u.type, u.team, _upos(u) + proj_launch(u.type, sgd) * UNIT_SCALE, _upos(ptd) + Vector2(0, -22 if u.type != D.BOMBER else -10), float(phd[2])])
	for pj in proj_draw:
		_draw_projectile(int(pj[0]), int(pj[1]), pj[2], pj[3], float(pj[4]))
	proj_draw.clear()
	if dim:
		return
	# 第三層：小旗、血條、狀態（永遠畫在最上面）
	var bar_faces: Dictionary = face_rects() if live else {}
	for u in list:
		var p: Vector2 = pc[u.id] if live else ORIGIN + Vector2(u.x, u.y) * CS / 1000.0
		if live:
			_draw_v8_top(s, u, p)
		if u.hidden:
			continue   # 偽裝中的寶箱不插小旗、不畫血條
		var fh: int = -58 if u.type == D.CAVALRY else (-70 if u.type == F8.GOLEM or u.type == F8.SPRITE else (-62 if u.type == F8.DOLL else -50))
		Art.flag(self, p + Vector2(-12, fh * hk_of(u)), u.team, cbm())
		if u.stun > 0:
			# 暈眩：三顆金色菱形繞著頭轉
			var hc := p + Vector2(0, (-70 if u.type == D.CAVALRY else -62) * hk_of(u))
			for j in 3:
				var an := time * 5.0 + j * TAU / 3.0
				var dc := hc + Vector2(cos(an) * 13, sin(an) * 4)
				var sz := 4.0 + sin(an) * 1.0
				draw_colored_polygon(PackedVector2Array([dc + Vector2(0, -sz), dc + Vector2(sz * 0.7, 0), dc + Vector2(0, sz), dc + Vector2(-sz * 0.7, 0)]), Color(1, 0.85, 0.25))
		if live and s.rally[u.team]:
			_hand_ring(p + Vector2(0, -24), 22.0, Color(1, 0.45, 0.2, 0.35 + 0.15 * sin(time * 8)), 2.5)
		if live and "breach" in u and u.breach > 0:
			# 破陣（第四輪 §4.4）：盾面黑色 Z 字裂紋＋血條右邊一個帶黑邊的亮橘裂盾圖示，持續到破陣結束（Antigravity：原本太小看不到）
			var cp := p + Vector2(12 * (signf(u.fx) if u.fx != 0 else 1.0), -26)
			draw_polyline(PackedVector2Array([cp + Vector2(-4, -11), cp + Vector2(2, -4), cp + Vector2(-3, 2), cp + Vector2(3, 10)]), Color(0.08, 0.06, 0.1, 0.95), 3.0, true)
			var ic := p + Vector2(24, -60)
			var lh := PackedVector2Array([ic + Vector2(-8, -9), ic + Vector2(-1, -9), ic + Vector2(-3, 1), ic + Vector2(-1, 9), ic + Vector2(-8, 4)])
			var rh := PackedVector2Array([ic + Vector2(1, -9), ic + Vector2(8, -9), ic + Vector2(8, 4), ic + Vector2(1, 9), ic + Vector2(3, 1)])
			for hp in [lh, rh]:
				var cl: PackedVector2Array = hp.duplicate()
				cl.append(hp[0])
				draw_polyline(cl, Art.OUT, 3.0, true)
				draw_colored_polygon(hp, Color("#ff6a2a"))
		if live and "aura" in u and u.aura > 0 and u.type != D.DRUMMER:
			# 鼓舞：2 顆亮金小菱形沿腳底圈往上飄（不畫大圈，避免畫面太吵；Antigravity：原本的小金點看不到）
			for j in 2:
				var ph := fmod(time * 0.9 + j * 0.5 + u.id * 0.13, 1.0)
				var dp := p + Vector2((-1.0 if j == 0 else 1.0) * 14.0, 2.0 - ph * 22.0)
				var ds := 3.6
				var dpoly := PackedVector2Array([dp + Vector2(0, -ds), dp + Vector2(ds * 0.7, 0), dp + Vector2(0, ds), dp + Vector2(-ds * 0.7, 0)])
				draw_colored_polygon(dpoly, Color(1, 0.86, 0.3, 0.95 * (1.0 - ph)))
		if live and u.type == D.DRUMMER and s.tick < 60 and u.alive:
			# 開戰前 3 秒畫完整的戰鼓範圍
			_hand_ring(p, D.DRUM_RANGE * CS / 1000.0, Color(1, 0.85, 0.35, 0.35), 2.0)
		if s.frenzy:
			draw_circle(p + Vector2(8, -58 - sin(time * 12 + u.id) * 2), 3.0, Color(1, 0.5, 0.1, 0.9), true, -1.0, true)
		if u.boss:
			_boss_bars(p, u)   # V1.4 #12：巨獸一直顯示大血條＋前臂、背甲兩條部位血條
			continue
		# 第七輪 D1：血條只在需要看時才畫（受傷 3 秒內、跟拍、低血量）
		var hurt_recent: bool = hurt_t.has(u.id) and time - float(hurt_t[u.id]) < 3.0
		# V1.3 C：選中（跟拍）的那隻就算滿血也畫，不然點了會以為血條壞了
		var hb: String = str(Save.s("hp_bars"))   # V1.5：血條 受傷時／一直／只看選取的／關
		var show_hb: bool = (u.hp < u.max_hp and (not live or hurt_recent or u.hp * 100 <= u.max_hp * 35)) if hb == "hurt" else (hb == "all")
		if (show_hb and hb != "sel" and hb != "off") or (live and u.id == follow_id and hb != "off"):
			var w := 28.0
			var top := p + Vector2(-w / 2, (-66 if u.type == D.CAVALRY else (-76 if u.type == F8.GOLEM or u.type == F8.SPRITE else -58)) * hk_of(u))
			var ha := hp_bar_alpha(u.id, _focus_ids, u.hp * 100 <= u.max_hp * 35) if live and state == St.BATTLE else 1.0   # 1.5.0 §7：非焦點兵血條淡一些
			if live and hp_bar_blocks(Rect2(top - Vector2(9 if cbm() else 1, 1), Vector2(w + (10 if cbm() else 2), 6)), u.id, bar_faces):
				_hp_arc(p, u, ha)   # 1.6.0 B10（P4.4 全兵種血條避讓）：頭頂血條會疊到別隻的頭胸 → 改畫在自己底座前緣半圓弧
				continue
			draw_rect(Rect2(top - Vector2(1, 1), Vector2(w + 2, 6)), Color(Art.OUT, Art.OUT.a * maxf(ha, 0.8)))
			draw_rect(Rect2(top, Vector2(w * u.hp / u.max_hp, 4)), Color(Art.team_color(u.team, cbm()).lightened(0.25), ha))
			if cbm():
				# 色盲模式：血條左邊加隊伍形狀（藍＝●、紅＝◆），不只靠顏色（R8）
				var mk := top + Vector2(-8, 2)   # 8px 標記＋黑邊（第三輪 V5）
				if u.team == 0:
					draw_circle(mk, 5.5, Art.OUT, true, -1.0, true)
					draw_circle(mk, 4.0, Art.team_color(0, true), true, -1.0, true)
				else:
					draw_colored_polygon(PackedVector2Array([mk + Vector2(0, -6.5), mk + Vector2(6.5, 0), mk + Vector2(0, 6.5), mk + Vector2(-6.5, 0)]), Art.OUT)
					draw_colored_polygon(PackedVector2Array([mk + Vector2(0, -4.5), mk + Vector2(4.5, 0), mk + Vector2(0, 4.5), mk + Vector2(-4.5, 0)]), Art.team_color(1, true))
	if not live:
		return
	var relics := 0
	for g in dying:
		var k: float = g["t"] / 1.0
		_draw_death(g, k)
		if RELIC.has(int(g["type"])) and relics < 4:   # 遺物獨立於屍體透明度，同畫面最多 4 組（Antigravity v131-impl3）
			_draw_relic(int(g["type"]), g["pos"], float(g["face"]), k, int(g["team"]))
			relics += 1
		if k >= 1.0:
			continue   # 倒棋躺著的那段：靈魂、塵土都已經結束
		if k < 0.3:
			for i in 6:
				var ang := i * TAU / 6
				draw_circle(g["pos"] + Vector2(cos(ang), sin(ang) * 0.5) * (8 + k * 70) + Vector2(0, -16), 4 * (1 - k), Color(1, 1, 1, 0.35), true, -1.0, true)
		Art.soul(self, g["pos"] + Vector2(sin(k * 9) * 4, -24 - k * 70), 0.75 * (1.0 - k))

## V1.3 A5：倒棋的兵種與倒的方向（＋往前、−往後，弧度）。其他兵種保留專屬死法（化煙、化開、碎裂…）。
const TOPPLE := {D.CAVALRY: 1.5, D.SWORD: 1.5, D.SHIELD: 1.5, D.DRUMMER: 1.5, D.BERSERKER: -1.5, D.PIKE: -1.5, D.ARCHER: -1.5, D.BOMBER: -1.5, D.MEDIC: -1.5, 18: -1.5}
