coordination/v1600-impl/ledger.md:37:- 預設外觀離線包 `scripts/ui/atlas_pack.gd`：`--bake-pack` 烘預設塗裝 × 一般／色盲全部 22 種，存壓縮 Image 資源 `art/pack/cb{0,1}/*.res`（140 張、61.5 MiB，不進 git）；清冊記來源雜湊（開發環境缺檔也算進去）、引擎、渲染路徑、格式、每張像素雜湊與檔案位元組雜湊、自我核對。執行時預設外觀在背景執行緒驗檔（位元組雜湊）＋讀包，新兵種頁由兵種條在背景拼頁，主執行緒只上傳；任何不符（缺條、錯圖、尺寸、清冊不全、來源過期）＝整包停用、退回即時烘；特殊塗裝、簡化介面＝即時烘。一頁 6 種→2 種（容量不變）。
coordination/v1600-impl/ledger.md:42:- 限制：開發機沒包或包過期＝照舊即時烘（長幀照 1.5.0）；改了畫法、色票、姿勢要重烘包（`--bake-pack`，約 25 秒）；即時烘路徑也用雙緩衝，貼圖峰值 574 MiB（只有特殊塗裝、簡化介面、沒包時走）。
extends "res://scripts/ui/units/kit.gd"
## 由 art.gd 拆出（V9 P1，行為不變）

## variant：0 一般招式、1 交替招式（劍士上挑；其他兵種同一般）。第三輪 R4。
## 第四輪：variant 2＝新兵的專屬動作（長槍兵拒騎頓槍、投彈兵被貼身拿點火棒敲、醫者舉杖施法、鼓手大力敲、狂戰士雙斧高舉）。
static func _infantry(ci: CanvasItem, type: int, tc: Color, walk: float, w: float, a: float, t: float, angry := false, variant := 0) -> void:
	# 腿（V9 P2）：腳踩地不動，上半身另外起伏；腿從腰連到腳，分隔不會斷開
	var ft: Array = Gait.feet(type, walk)
	var bx: Transform2D = Gait.body_xf(type, walk)
	var hip_y := -9.0 + bx.origin.y
	var legc := Color("#4a3b5c")
	_line(ci, Vector2(-3.5, hip_y), Vector2(-4 + ft[0], -4.0 - ft[1]), legc, 3.4, a)
	_c(ci, Vector2(-4 + ft[0], -3.0 - ft[1]), 3.6, legc, a)
	_line(ci, Vector2(3.5, hip_y), Vector2(4 + ft[2], -3.0 - ft[3]), legc, 3.4, a)
	_c(ci, Vector2(4 + ft[2], -2.0 - ft[3]), 3.6, legc, a)
	_push_body(ci, bx)
	var wk := Gait.ph(walk)
	var sway: float = Gait.swing(type, walk)
	var fl := sin(wk + 1.0) * 2.5 if wk != 0.0 else 0.0   # 披風延遲擺動
	# 第七輪 C2：小披風分隊，藍方圓角、紅方燕尾（除了圍巾已經很明顯的刺客與騎兵）
	if not back:
		_inf_back_items(ci, type, tc, fl, w, sway, variant, a)   # 背後的東西先畫（被身體擋住）
	# 身體（圓胖的上衣，隊伍色；狂戰士赤膊，隊伍色只留在獸皮披肩與褲頭；醫者白袍）
	var bw0 := 13.0 if type == D.SHIELD else 10.5   # 第七輪 C1-2：盾兵身體加寬
	var body := PackedVector2Array()
	for i in 13:
		var ang := PI + i * PI / 12.0
		body.append(Vector2(cos(ang) * bw0, -16 + sin(ang) * 9.0))
	if type == D.MEDIC:
		body.append(Vector2(13, -5)); body.append(Vector2(-13, -5))   # 第七輪 C1-8：A 字長袍
	else:
		body.append(Vector2(bw0 - 0.5, -5)); body.append(Vector2(-bw0 + 0.5, -5))
	_poly(ci, body, SKIN.darkened(0.06) if type == D.BERSERKER else (Color("#f4f1ea") if type == D.MEDIC else tc), a)
	if type == D.BERSERKER:
		# 第七輪 C1-10：披肩加寬＋交叉肩帶＋整條褲頭，隊伍色面積拉大
		_poly(ci, PackedVector2Array([Vector2(-12, -24), Vector2(-2, -27), Vector2(12, -15), Vector2(5, -8), Vector2(-3, -15), Vector2(-11, -13)]), tc, a, false)
		_poly(ci, PackedVector2Array([Vector2(8, -24), Vector2(11, -21), Vector2(-7, -7), Vector2(-10, -10)]), tc.darkened(0.15), a, false)
		_poly(ci, PackedVector2Array([Vector2(-10, -14), Vector2(10, -14), Vector2(10, -5), Vector2(-10, -5)]), tc, a, false)
	elif type == D.MEDIC:
		_poly(ci, PackedVector2Array([Vector2(-12, -11), Vector2(12, -11), Vector2(13, -5), Vector2(-13, -5)]), tc, a, false)   # 白袍下擺露出隊伍色
		_poly(ci, PackedVector2Array([Vector2(-10, -24), Vector2(-3, -26), Vector2(8, -22), Vector2(10, -16), Vector2(0, -19), Vector2(-11, -15)]), tc, a)   # 第七輪 C1-8：大面積隊伍色披肩
	ci.draw_line(Vector2(-9, -11), Vector2(9, -11), Color(OUT, 0.35 * a), 2.0, true)   # 腰帶
	if not back:
		_trinket(ci, type, tc, a)   # 1.3.0 §5.3 個性小物（烘進圖集，零每幀成本）
	if back:
		_inf_back_items(ci, type, tc, fl, w, sway, variant, a)   # V1.5 背面：披風、箭筒、火罐包、遠側斧都在身上看得到
	# 頭（V1.3 A1b：轉身時頭不壓扁）
	var hy := -33.0
	_part(ci, 0.0, 0.0)
	_c(ci, Vector2(0, hy), 11.5, SKIN, a)
	if back and type != D.ASSASSIN:
		# V1.5 背面：後腦勺是頭髮（帽子、頭盔之後照樣蓋上去），兩側露一點耳朵
		_c(ci, Vector2(0, hy - 1.0), 11.0, Color("#6b4a2e"), a)
		_c(ci, Vector2(-11.0 * turn_c, hy + 2.0), 2.2, SKIN.darkened(0.08), a)
	# 臉（朝右）
	if type != D.ASSASSIN:
		_eyes(ci, Vector2(3.5, hy + 1), a, t, angry)
	# 兵種特徵
	match type:
		D.SWORD:
			# 頭盔＋羽飾
			_hat_on(ci)   # V1.3.1：受擊時帽子彈起（只在受擊影格）
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.05, PI * 1.95, 18, Color(OUT, a), 6.5, true)
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 1.05, PI * 1.95, 18, Color(STEEL, a), 4.0, true)
			_part_at(ci, 3.0)   # V1.5：羽飾轉正時移到頭頂正中
			# 1.6.0 B10（P4.1）：羽飾加高成冠（剪影頭頂多一道往後掃的尖，和圓頭步兵分開）
			_poly(ci, PackedVector2Array([Vector2(-3, hy - 11), Vector2(-1, hy - 22), Vector2(4, hy - 28), Vector2(8, hy - 25), Vector2(4, hy - 10)]), tc.lightened(0.2), a)
			_part(ci, 0.0, 0.0)
			_hat_off(ci)
			_part_end(ci)
			# 劍：斜舉的亮刃（攻擊時往前揮）
			# 前搖往後拉 35°、揮擊揮到 +60° 以上
			# V1.3.1：前搖（也是勝利姿勢）劍往後只拉到接近垂直、手往前推，刃不再切過右眼（原本 w×0.9 會穿臉）
			var ang := -0.7 + (w * 0.55 if w < 0.0 else w * 1.5) + sway   # 第十輪 F3：揮幅加大；1.6.0 B10（P4.1）：待機劍往前上方斜伸（剪影往右突出，和直立杖、圓團分開），揮到底的角度不變
			if variant == 1:
				# 上挑：前搖把劍壓低到身前下方，揮擊時往上撩過頭頂
				ang = 0.6 + (-w * 0.35 if w < 0.0 else -w * 2.6)
			# 第七輪 C1-1：隊伍色短領巾；劍身加寬、十字護手
			_poly(ci, PackedVector2Array([Vector2(-9, -24), Vector2(8, -24), Vector2(6, -20), Vector2(-3, -19), Vector2(-5, -14), Vector2(-9, -17)]), tc.lightened(0.15), a, true)
			_part(ci, -8.0, 1.0)   # V1.3 A1b：劍透視縮短、留在臉的前方（V1.3.1 錨點檢查：最窄格 -4 仍穿眼，改 -8）
			var hand := Vector2(9 + (-w * 5.0 if w < 0.0 and variant != 1 else 0.0), -17 + sway * 8.0)
			var dir := Vector2(cos(ang), sin(ang))
			var tip := hand + dir * 34.0   # 1.6.0 B10（P4.1）：劍刃 24→34、加寬，往前上方斜伸（剪影多一道斜線）
			var side := dir.orthogonal() * 4.2
			# V1.5：握柄＋柄頭在手後、護手在刃根（手往前 3.5px），拳頭蓋住握柄——不再像刀刃插在圓點上被切斷
			_grip(ci, hand, dir, 6.0, a)
			var root := hand + dir * 3.5
			_poly(ci, PackedVector2Array([root + side, tip + side * 0.3, tip + dir * 3.0, tip - side * 0.3, root - side]), Color("#f4f7ff"), a)
			_line(ci, root - dir.orthogonal() * 7.0, root + dir.orthogonal() * 7.0, GOLD, 3.0, a)
			_fist(ci, hand, dir, a)
			_part_end(ci)
		D.SHIELD:
			# 圓頭盔＋面罩
			_hat_on(ci)   # V1.3.1：受擊時帽子彈起（只在受擊影格）
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 0.95, PI * 2.05, 20, Color(OUT, a), 7.0, true)
			ci.draw_arc(Vector2(0, hy), 12.0, PI * 0.95, PI * 2.05, 20, Color(STEEL_D, a), 4.5, true)
			_line(ci, Vector2(-9, hy - 3), Vector2(11, hy - 3), STEEL_D, 2.0, a)
			_hat_off(ci)
			_part(ci, -3.0, 0.0)   # V1.3 A1b：大盾朝前，轉向鏡頭時不跟著變窄（Antigravity v130-impl1）
			# 大方盾（佔身體一半寬，正面）
			var push := (w * 12.0 if w > 0.0 else w * 5.0) + sway * 14.0 + 3.0   # V1.3：盾往外 3px，剪影不再是圓膠囊（Antigravity v130-impl1）   # 盾擊：揮擊時整面盾往前推（第三輪 R4）；走路時盾微晃
			# 第七輪 C1-2：盾放大（遮身體六成）、上寬下尖、深鐵色外框，混戰時不會融進隊伍色塊
			var sh := PackedVector2Array([Vector2(1 + push, -43), Vector2(21 + push, -41), Vector2(21 + push, -14), Vector2(11 + push, -2), Vector2(1 + push, -14)])
			_poly(ci, sh, Color("#4a5468"), a)
			var shi := PackedVector2Array([Vector2(4 + push, -39), Vector2(18 + push, -38), Vector2(18 + push, -15), Vector2(11 + push, -6), Vector2(4 + push, -15)])
			if back:
				# V1.5 背面：看到的是盾背：木板＋兩條皮帶（隊伍色徽章在另一面）
				_poly(ci, shi, WOOD, a, false)
				for sy in [-32.0, -21.0]:
					_line(ci, Vector2(4 + push, sy), Vector2(18 + push, sy + 1.0), Color("#5b3a1e"), 2.4, a)
## V1.2 D2：大圖（圖鑑、MVP）站在木製圓底座上，像桌上的棋偶公仔（V1.5.1 抽出來給圖鑑烘焙版大圖共用）
func _unit_base(p: Vector2, scale: float) -> void:
	if true:
		var bw := 30.0 * scale
		var bh := 9.0 * scale
		draw_set_transform_matrix(ui_xf * Transform2D(0.0, Vector2(1, bh / bw), 0.0, p + Vector2(0, 2 * scale)))
		draw_circle(Vector2(0, 3 * scale * bw / bh), bw * 1.04, Color(0, 0, 0, 0.3), true, -1.0, true)
		draw_circle(Vector2.ZERO, bw, Color("#5a3b22"), true, -1.0, true)
		draw_circle(Vector2(0, -2.2 * scale * bw / bh), bw * 0.96, Color("#8a5f37"), true, -1.0, true)
		draw_arc(Vector2(0, -2.2 * scale * bw / bh), bw * 0.96, PI * 1.1, PI * 1.9, 24, Color(1, 0.9, 0.7, 0.35), 2.0, true)
		draw_set_transform_matrix(ui_xf)

## 在一個框（或圓）的正中間畫一隻兵（使用者回報：圖鑑頁籤的人物沒有在格子正中間）。
## 角色的腳在原點、頭頂約在 -50（騎兵含騎士約 -54），視覺中心在腳上方 24（騎兵 26）× 縮放。
static func unit_center_feet(center: Vector2, type: int, scale: float) -> Vector2:
	return center + Vector2(0, (26.0 if type == D.CAVALRY else 24.0) * scale)

func _unit_in(r: Rect2, type: int, team: int, alpha := 1.0, scale := 0.6) -> void:
