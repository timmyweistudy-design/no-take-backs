exec
/bin/bash -lc "python3 - <<'PY'
import wave, pathlib, math, struct
p=pathlib.Path('build/cg/b20/game/audio')
for n in ['obj_paper','obj_stamp','wood_light','k_click']:
 with wave.open(str(p/(n+'.wav')),'rb') as w:
  b=w.readframes(w.getnframes()); xs=struct.unpack('<'+'h'*(len(b)//2),b)
  print(n,w.getframerate(),w.getnchannels(),w.getsampwidth(),w.getnframes(), 'rms',round(20*math.log10((sum(x*x for x in xs)/len(xs))**.5/32768),2))
PY
