  1132	func _brush_line(a: Vector2, b: Vector2, col: Color, seed_i: int) -> void:
  1133		var n := 10
  1134		var nrm := (b - a).orthogonal().normalized()
  1135		for i in n:
  1136			if i >= 6 and (seed_i * 7 + i * 13) % 5 == 0:
  1137				continue   # 飛白：收筆段偶爾斷開
  1138			var t0 := float(i) / n
  1139			var t1 := float(i + 1) / n
  1140			var wv := 1.2 + 3.6 * sin(PI * (t0 + t1) * 0.5) * (1.0 - 0.35 * t0)
  1141			var wob := nrm * sin(t0 * 7.0 + seed_i) * 0.8
  1142			draw_line(a.lerp(b, t0) + wob, a.lerp(b, t1) + wob, col, wv, true)
