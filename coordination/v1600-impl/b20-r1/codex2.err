   145	
   146	## V1.3.1 P2：每種兵自己的「聲音」：同一個音效，依兵種換音高（小隻高、大隻低），出手、倒下聽得出是誰。
   147	const UNIT_PITCH := [1.0, 0.9, 1.08, 0.88, 1.12, 0.95, 1.05, 1.1, 1.0, 0.86, 1.18, 1.15, 0.92, 1.2, 1.12, 1.16, 1.22, 0.97, 1.1, 0.82, 1.25, 1.06]   # 收斂在 0.82～1.25（Antigravity v131-impl3：1.4 太尖）
   148	func play_unit(name: String, vol: float, type: int) -> void:
   149		play(name, vol, float(UNIT_PITCH[type]) if type >= 0 and type < UNIT_PITCH.size() else 1.0)
   150	
   151	func play_pitched(name: String, vol: float, pitch: float) -> void:
   152		play(name, vol, pitch)
   153	
   154	func play(name: String, vol := 1.0, pitch := 1.0) -> void:
   155		var gain := gain_for(name)
   156		if not streams.has(name) or gain <= 0.0:
   157			return
   158		if int(PRIO.get(name, 0)) >= 2 and not name.begins_with("k_"):
   159			duck(0.7)
   160		var now := Time.get_ticks_msec()
   161		var r: Array = recent.get(name, [])
   162		r = r.filter(func(t): return now - t < 80)
   163		if r.size() >= 2:
   164			return
   165		r.append(now)
   166		recent[name] = r
   167		var pr: int = PRIO.get(name, 1)
   168		if same_playing(players.map(func(q): return q.playing), _name_of, name) >= SAME_MAX:
   169			return   # V1.0.0 A2：同一個音效同時最多 SAME_MAX 路（混戰時同一種聲音疊太多會爆音）
   170		var busy: Array = []
   171		var prios: Array = []
   172		var starts: Array = []
   173		for i in players.size():
   174			busy.append(players[i].playing)
   175			prios.append(_prio_of.get(i, 0))
   176			starts.append(_started.get(i, 0))
   177		var ch := pick_channel(busy, prios, starts, pr)
   178		if ch < 0:
   179			return
   180		var p := players[ch]
   181		p.stop()
   182		p.bus = BUS_UI if is_ui(name) else pan_bus(pan_hint, mono)   # 1.4.0 §9.2：戰場音效依單位位置分左右（單聲道設定時不分）
   183		p.stream = _pick_variant(name)
   184		p.pitch_scale = pitch * (1.0 + rng.randf_range(-0.05, 0.05) if pitch != 1.0 else 1.0 + rng.randf_range(-0.1, 0.1))   # 兵種音高再加 ±5% 微擾，同音高齊發不會共鳴
   185		p.volume_db = linear_to_db(maxf(0.0001, gain * vol)) + trim_db(p.stream)   # V1.2.1 E2：個別音檔響度修正
   186		p.play()
   187		_prio_of[ch] = pr
   188		_started[ch] = now
   189		_name_of[ch] = name
   190	
   191	const SAME_MAX := 3
   192	var _name_of := {}
   193	## 純函式（測試用）：正在播這個名字的聲道數
   194	static func same_playing(playing: Array, names: Dictionary, name: String) -> int:
   195		var n := 0
   196		for i in playing.size():
   197			if playing[i] and str(names.get(i, "")) == name:
   198				n += 1
   199		return n
   200	
   201	## V1.2.1 E2：tools/gen/audio_trim.py 量出的個別音檔修正（dB），依檔名查。
   202	static var _trim := {}
   203	static func trim_db(st) -> float:
   204		if _trim.is_empty():
   205			var f := FileAccess.get_file_as_string("res://data/audio_trim.json")
   206			var j = JSON.parse_string(f) if f != "" else null
   207			_trim = j["trim"] if j is Dictionary and j.has("trim") else {"_": 0.0}
   208		if st == null or not ("resource_path" in st):
   209			return 0.0
   210		return float(_trim.get(str(st.resource_path).get_file(), 0.0))
   211	
   212	static func is_ui(name: String) -> bool:
   213		return name.begins_with("k_") or name.begins_with("ui_") or name.begins_with("obj_")   # 1.6.0 B20：器物聲（翻紙、蓋印）走介面音量
   214	
   215	## 這個音效走哪一條音量（介面音或音效）。
   216	func gain_for(name: String) -> float:
   217		return ui_vol if is_ui(name) else sfx_vol
   218	
   219	## 變體：隨機挑一個，但不和上一次相同（只有一個就用它）。
   220	func _pick_variant(name: String):
   221		var vs: Array = variants.get(name, [streams[name]])
   222		if vs.size() <= 1:
   223			return vs[0]
   224		var last := int(_last_var.get(name, -1))
   225		var k := rng.randi_range(0, vs.size() - 1) if last < 0 else rng.randi_range(0, vs.size() - 2)
