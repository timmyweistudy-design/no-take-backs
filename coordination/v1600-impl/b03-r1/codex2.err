  1373			ty += 70.0
  1374			_text(Vector2(cr.position.x + cw * 0.5, ty), L.t("ps_name_%d" % st), ts(16), Color(0.2, 0.13, 0.08), true, true, tw2)
  1375			ty += ts(16) * 1.4
