+const CONTACT_A := 0.4
+# 1.6.0 B03：攤在桌上的紙（結果紙）在桌燈下的色調——把 L* 從 1.5.0 的約 86 壓到紙的中階（量測見 tools/tone_check.py）
+const PAPER_DESK_TONE := Color(0.72, 0.68, 0.62)
+# 1.6.0 B03：盤外桌面壓暗（只在盤框外，盤內隊色 ΔE＝0）
+const OFF_BOARD_DIM := 0.18
