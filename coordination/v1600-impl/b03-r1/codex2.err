+## 1.6.0 B03（S2；P1.1～P1.3）：桌位表單一來源、主材質、接觸影、結果 HUD 收合
+func test_table_seats_v1600() -> void:
+	var TS = load("res://scripts/ui/table_seats.gd")
+	var PAL = load("res://scripts/ui/palette.gd")
+	var UB = load("res://scripts/ui/ui_base.gd")
+	ok(TS.BOARD.position == UB.ORIGIN and TS.BOARD.size == UB.FIELD, "桌位表的盤面＝ORIGIN、FIELD（同一個盤）")
+	var sl: Dictionary = TS.right_slots()
+	ok(sl.has("owner") and sl.has("cup") and sl.has("clock"), "右緣三槽：上老闆、中茶杯、下棋鐘")
+	var fr: Rect2 = TS.frame_rect()
+	for k in sl:
+		var r: Rect2 = sl[k]
+		ok(r.position.x - fr.end.x >= TS.SLOT_GAP and r.end.x <= TS.SCREEN.x and r.size.x >= TS.SLOT_W_MIN and r.size.x <= TS.SLOT_W, "槽 %s：距盤框 ≥16、不出螢幕、寬 88～104" % k)
+	ok(not (sl["owner"] as Rect2).intersects(sl["cup"]) and not (sl["cup"] as Rect2).intersects(sl["clock"]), "三槽不重疊")
+	ok(TS.right_slots(Rect2(100, 100, 1100, 576)).is_empty(), "盤太寬、桌緣放不下槽＝回空（呼叫端照 HIDE_ORDER 退）")
+	var rep: Dictionary = TS.spec_report()
+	ok(not bool(rep["board_ok"]) and float(rep["edge_r"]) == 112.0, "規格符合度如實回報（盤含框 1056 > 1040、右桌緣 112；B06 決定縮盤）")
+	var nr: Rect2 = TS.result_note_rect()
+	ok(nr.end.x <= TS.RESULT_PAPER.position.x - TS.SLOT_GAP and nr.size.y <= TS.RESULT_NOTE_MAX.y, "局內便條在結果紙外左下、不壓紙")
+	for m in [PAL.MAT_WALNUT, PAL.MAT_PAPER, PAL.MAT_WAX, PAL.MAT_CHALK, PAL.MAT_BRASS]:
+		ok(m.size() == 3, "主材質三色（Base／Shadow／Highlight）")
+	ok(PAL.CONTACT_OFF == Vector2(3, 4) and PAL.CONTACT_FEATHER == 6.0 and PAL.CONTACT_A >= 0.35 and PAL.CONTACT_A <= 0.45, "接觸影 (3,4)、羽化 6、α 0.35～0.45")
+	var ub: String = FileAccess.get_file_as_string("res://scripts/ui/ui_base.gd")
+	ok(ub.find("func _contact_shadow(") >= 0 and ub.find("Seats.right_slots()") >= 0 and ub.find("Vector2(1236, 432)") < 0, "接觸影共用函式；茶杯、沙漏照桌位表（不再寫死座標）")
+	ok(ub.find("if int(get(\"state\")) != St.TITLE and str(get(\"overlay\")) == \"\":") >= 0, "有棋盤的頁、沒開疊層時盤外桌面壓暗")
+	# 肖像鈕：從真實 _input 進入（輸入契約）——點鈕＝開合、點展開紙卡不點穿不收合（Codex B03 r1 #6）
+	var GS = load("res://scripts/ui/game_screens.gd")
+	var g = GS.new()
+	g.state = g.St.PLACE
+	g.overlay = ""
+	g.mode = g.Mode.VS_AI
+	g.shot_dir = ""
+	g.time = 10.0
+	var slot: Rect2 = sl["owner"]
+	var cw := minf(384.0 - 24.0, 420.0)   # 敵區寬 384（16×64 的右 6 欄）
+	g.foe_card_r = Rect2(slot.position.x - cw - 10.0, slot.position.y, cw, 300)
+	ok(g.foe_card_r.position.x >= TS.BOARD.position.x and g.foe_card_r.end.x < slot.position.x, "展開紙卡浮在槽左邊、不出盤左緣、不蓋到槽")
+	g.foe_tag_r = slot
+	g.foe_tag_open = true
+	g._btns.clear()
+	g._btns.append({"r": slot, "cb": func(): g.foe_tag_open = not g.foe_tag_open, "en": true})
+	g._btns_gen = g._gen
+	for dn in [true, false]:
+		var e0: InputEventMouseButton = _im_ev("mouse", dn)
+		e0.position = g.foe_card_r.get_center()
+		g._input(e0)
+	g._process_cmds()
+	ok(g.foe_tag_open and not g.painting and g.drag_from.x < 0, "真實輸入：點在展開紙卡上不點穿、不收合")
+	g._btns_gen = g._gen
+	for dn in [true, false]:
+		var e1: InputEventMouseButton = _im_ev("mouse", dn)
+		e1.position = slot.get_center()
+		g._input(e1)
+	g._process_cmds()
+	ok(not g.foe_tag_open, "真實輸入：點右緣肖像鈕＝收合")
+	g.foe_tag_open = false
+	ok(g._deploy_tool("foe") and g.foe_tag_open, "手把 RT＋View＝開合（同一個狀態）")
+	g.free()
+	var gp: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_place.gd")
+	ok(gp.find("_draw_foe_slot(slots[\"owner\"], zone)") >= 0 and gp.find("func _draw_foe_card(") >= 0, "敵情翻牌收合成右緣上槽肖像鈕、展開才浮出紙卡")
+	var bv: String = FileAccess.get_file_as_string("res://scripts/ui/battle_view.gd")
+	ok(bv.find("if state == St.RESULT:\n\t\treturn   # 1.6.0 B03") >= 0, "結果頁背後戰力尺、棋鐘收合")
+	var gr: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_result.gd")
+	ok(gr.find("_mat_box(r, \"card2\", PAL.PAPER_DESK_TONE)") >= 0 and gr.find("_contact_shadow(r, 4.0, 0.45)") >= 0, "結果紙：桌燈色調＋共用接觸影")
diff --git a/game/tools/tone_check.py b/game/tools/tone_check.py
new file mode 100644
index 0000000..c5efdc7
--- /dev/null
+++ b/game/tools/tone_check.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""1.6.0 B03（S2）三代表頁的灰階三階＋盤內不變量測。
+用法：PYTHONPATH=../build/pylibnp python3 tools/tone_check.py <新版面輸出夾> [舊版對照夾] [--strip 輸出.png]
+  兩個資料夾底下都是 <組合>/<畫面>.png（layout_check 的輸出結構）。
+量什麼（L*，CIE 1976，0～100；區域照 scripts/ui/table_seats.gd 的桌位表）：
+  桌：右緣桌面（上槽與中槽之間的空桌） ≤25
+  紙：結果紙中段、擺陣盤面中段（「中階紙與盤」） 35～65
+  主層：主鈕（開戰、下一局）只列數值（主層看「亮或高對比實心」，紅漆鈕靠對比不靠亮度）
+  盤內不變：同固定時鐘的舊截圖，盤面內逐像素比（擺陣頁遮掉 1.5.0 吊在盤上的敵情翻牌）；差異像素 0＝ΔE 0
+--strip：左舊｜中新｜右新灰階的三頁流程條（並列審片用）。
+最後一行：TONE OK／TONE FAIL <理由>。"""
+import os, sys
+import numpy as np
+from PIL import Image
+
+PAGES = {
+    "01_title.png": {"desk": (20, 640, 40, 100), "paper": (560, 350, 160, 100)},        # 標題：左下桌角；中階＝示範棋盤（標題的木牌是主層鈕）
+    "02_place.png": {"desk": (1186, 232, 88, 120), "paper": (300, 300, 300, 200), "main": (960, 700, 280, 28), "board": True},
+    "05_result.png": {"desk": (1186, 232, 88, 120), "paper": (240, 300, 260, 60), "main": (330, 660, 200, 22)},
+}
+BOARD = (150, 120, 980, 530)   # 盤面內側（戰鬥是桌邊視角，盤緣幾列會露出桌面，取內側）
+OLD_TAG = (760, 90, 400, 110)   # 1.5.0 吊在盤右上的翻牌（含吊繩；英文 150% 兩行更寬更高）
+
+def lstar(a):
+    a = a.astype(float) / 255.0
+    lin = np.where(a <= 0.04045, a / 12.92, ((a + 0.055) / 1.055) ** 2.4)
+    y = lin @ np.array([0.2126, 0.7152, 0.0722])
+    return np.where(y > 0.008856, 116 * np.cbrt(y) - 16, 903.3 * y)
+
+NOISE = 3   # 容許 ≤3/255：同一份程式固定時鐘重拍兩次逐像素完全一致（差 0）；1.5→1.6 盤內有 236 點差 2/255（ΔE<1、看不出，來源未查明，B03 ledger）
+
+def contrast(c1, c2):
+    def rl(c):
+        c = np.asarray(c, float) / 255.0
+        lin = np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)
+        return float(lin @ np.array([0.2126, 0.7152, 0.0722]))
+    a, b = rl(c1), rl(c2)
+    return (max(a, b) + 0.05) / (min(a, b) + 0.05)
+
+def crop(a, r):
+    x, y, w, h = r
+    return a[y:y + h, x:x + w]
+
+def main():
+    args = [x for x in sys.argv[1:] if not x.startswith("--")]
+    strip = sys.argv[sys.argv.index("--strip") + 1] if "--strip" in sys.argv else ""
+    if strip in args:
+        args.remove(strip)
+    new = args[0]
+    old = args[1] if len(args) > 1 else ""
+    fails = []
+    rows = []
+    combos = sorted(c for c in os.listdir(new) if os.path.isdir(os.path.join(new, c)))
+    if not combos:
+        fails.append("沒有任何組合（輸出夾是空的）")
+    for combo in combos:
+        for page, zones in PAGES.items():
+            p = os.path.join(new, combo, page)
+            if not os.path.isfile(p):
+                fails.append("%s 缺 %s" % (combo, page))   # 缺頁＝失敗（Codex B03 r1 #4）
+                continue
+            a = np.asarray(Image.open(p).convert("RGB"))
+            L = lstar(a)
+            d = float(np.median(crop(L, zones["desk"])))
+            pp = float(np.median(crop(L, zones["paper"])))
+            line = "%s %s 桌 %.1f 紙 %.1f" % (combo, page, d, pp)
+            if "main" in zones:
+                # 主層：紅漆主鈕靠對比不靠亮度——主鈕中位色對旁邊桌面的對比 ≥3:1（Codex B03 r1 #5）
+                mc = np.median(crop(a, zones["main"]).reshape(-1, 3), axis=0)
+                dc = np.median(crop(a, zones["desk"]).reshape(-1, 3), axis=0)
+                cr = contrast(mc, dc)
+                line += " 主鈕 L*%.1f 對桌 %.1f:1" % (float(np.median(crop(L, zones["main"]))), cr)
+                if cr < 3.0:
+                    fails.append("%s/%s 主鈕對桌 %.1f<3" % (combo, page, cr))
+            if d > 25.0:
+                fails.append("%s/%s 桌 %.1f>25" % (combo, page, d))
+            if not (35.0 <= pp <= 65.0) and "plain" not in combo:
+                fails.append("%s/%s 紙 %.1f 不在 35～65" % (combo, page, pp))
+            if old and zones.get("board"):
+                for name in (page, "03_battle.png"):
+                    bp, np_ = os.path.join(old, combo, name), os.path.join(new, combo, name)
+                    if not (os.path.isfile(bp) and os.path.isfile(np_)):
+                        if os.path.isdir(os.path.join(old, combo)):
+                            fails.append("%s 盤內比對缺 %s" % (combo, name))   # 有對照組就一定要比到
+                        continue
+                    b0 = np.asarray(Image.open(bp).convert("RGB")).astype(int)
+                    b1 = np.asarray(Image.open(np_).convert("RGB")).astype(int)
+                    sd = b1 - b0
+                    keep = np.ones(sd.shape[:2], bool)
+                    if name == "02_place.png":
+                        x, y, w, h = OLD_TAG
+                        keep[y:y + h, x:x + w] = False
+                    full = (np.abs(sd).max(axis=2) > NOISE) & keep
+                    n = int(crop(full, BOARD).sum())
+                    # 整盤偏色：每點都 ≤NOISE 但整片往同一方向偏（例如半透明壓暗蓋到盤上），平均有號差 ≥0.5 就算（Codex B03 r1 #5）
+                    shift = float(np.abs(crop(sd, BOARD)[crop(keep, BOARD)].mean(axis=0)).max())
+                    line += " ｜盤內差 %s %d px、平均偏 %.2f" % (name, n, shift)
+                    if n or shift >= 0.5:
+                        fails.append("%s/%s 盤內差 %d px、平均偏 %.2f" % (combo, name, n, shift))
+            rows.append(line)
+    for r in rows:
+        print(r)
+    if strip and old:
+        tiles = []
+        for page in PAGES:
+            q, n2 = os.path.join(old, "zh_TW_100", page), os.path.join(new, "zh_TW_100", page)
+            if os.path.isfile(q) and os.path.isfile(n2):
+                a0 = Image.open(q).convert("RGB").resize((640, 400))
+                a1 = Image.open(n2).convert("RGB").resize((640, 400))
+                tiles.append([a0, a1, a1.convert("L").convert("RGB")])
+        if tiles:
+            W = Image.new("RGB", (1920, 400 * len(tiles)))
+            for i, t in enumerate(tiles):
+                for j, im in enumerate(t):
+                    W.paste(im, (640 * j, 400 * i))
+            W.save(strip)
+            print("流程條", strip)
+    print("TONE OK" if not fails else "TONE FAIL " + "；".join(fails[:8]) + ("…共 %d 筆" % len(fails) if len(fails) > 8 else ""))
+    sys.exit(1 if fails else 0)
+
+if __name__ == "__main__":
+    main()

exec
/bin/bash -lc "nl -ba game/tools/tone_check.py; nl -ba game/scripts/ui/screens/game_place.gd | sed -n '1290,1405p'; nl -ba game/scripts/ui/ui_base.gd | sed -n '1170,1220p'; rg -n 'B03|B06|B08|放大鏡|棋鐘|P1.1|P1.5' docs/2026-11-15-v1.6.0-plan.md; ls coordination/v1600-impl/b03-r1; rg -n 'foe_card_r|foe_tag_r|foe_tag_open|_deploy_tool\\(\"foe\"' game/scripts/ui" in /mnt/c/Users/timmy/projects/no-take-backs
