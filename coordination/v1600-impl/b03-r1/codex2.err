    64	            d = float(np.median(crop(L, zones["desk"])))
    65	            pp = float(np.median(crop(L, zones["paper"])))
    66	            line = "%s %s 桌 %.1f 紙 %.1f" % (combo, page, d, pp)
    67	            if "main" in zones:
    68	                # 主層：紅漆主鈕靠對比不靠亮度——主鈕中位色對旁邊桌面的對比 ≥3:1（Codex B03 r1 #5）
    69	                mc = np.median(crop(a, zones["main"]).reshape(-1, 3), axis=0)
    70	                dc = np.median(crop(a, zones["desk"]).reshape(-1, 3), axis=0)
    71	                cr = contrast(mc, dc)
    72	                line += " 主鈕 L*%.1f 對桌 %.1f:1" % (float(np.median(crop(L, zones["main"]))), cr)
    73	                if cr < 3.0:
    74	                    fails.append("%s/%s 主鈕對桌 %.1f<3" % (combo, page, cr))
    75	            if d > 25.0:
    76	                fails.append("%s/%s 桌 %.1f>25" % (combo, page, d))
    77	            if not (35.0 <= pp <= 65.0) and "plain" not in combo:
    78	                fails.append("%s/%s 紙 %.1f 不在 35～65" % (combo, page, pp))
    79	            if old and zones.get("board"):
    80	                for name in (page, "03_battle.png"):
    81	                    bp, np_ = os.path.join(old, combo, name), os.path.join(new, combo, name)
    82	                    if not (os.path.isfile(bp) and os.path.isfile(np_)):
    83	                        if os.path.isdir(os.path.join(old, combo)):
    84	                            fails.append("%s 盤內比對缺 %s" % (combo, name))   # 有對照組就一定要比到
    85	                        continue
    86	                    b0 = np.asarray(Image.open(bp).convert("RGB")).astype(int)
    87	                    b1 = np.asarray(Image.open(np_).convert("RGB")).astype(int)
    88	                    sd = b1 - b0
    89	                    keep = np.ones(sd.shape[:2], bool)
    90	                    if name == "02_place.png":
    91	                        x, y, w, h = OLD_TAG
    92	                        keep[y:y + h, x:x + w] = False
    93	                    full = (np.abs(sd).max(axis=2) > NOISE) & keep
    94	                    n = int(crop(full, BOARD).sum())
    95	                    # 整盤偏色：每點都 ≤NOISE 但整片往同一方向偏（例如半透明壓暗蓋到盤上），平均有號差 ≥0.5 就算（Codex B03 r1 #5）
    96	                    shift = float(np.abs(crop(sd, BOARD)[crop(keep, BOARD)].mean(axis=0)).max())
    97	                    line += " ｜盤內差 %s %d px、平均偏 %.2f" % (name, n, shift)
    98	                    if n or shift >= 0.5:
    99	                        fails.append("%s/%s 盤內差 %d px、平均偏 %.2f" % (combo, name, n, shift))
   100	            rows.append(line)
   101	    for r in rows:
   102	        print(r)
   103	    if strip and old:
   104	        tiles = []
   105	        for page in PAGES:
   106	            q, n2 = os.path.join(old, "zh_TW_100", page), os.path.join(new, "zh_TW_100", page)
   107	            if os.path.isfile(q) and os.path.isfile(n2):
   108	                a0 = Image.open(q).convert("RGB").resize((640, 400))
   109	                a1 = Image.open(n2).convert("RGB").resize((640, 400))
   110	                tiles.append([a0, a1, a1.convert("L").convert("RGB")])
   111	        if tiles:
   112	            W = Image.new("RGB", (1920, 400 * len(tiles)))
   113	            for i, t in enumerate(tiles):
   114	                for j, im in enumerate(t):
   115	                    W.paste(im, (640 * j, 400 * i))
   116	            W.save(strip)
   117	            print("流程條", strip)
   118	    print("TONE OK" if not fails else "TONE FAIL " + "；".join(fails[:8]) + ("…共 %d 筆" % len(fails) if len(fails) > 8 else ""))
   119	    sys.exit(1 if fails else 0)
   120	
   121	if __name__ == "__main__":
   122	    main()
