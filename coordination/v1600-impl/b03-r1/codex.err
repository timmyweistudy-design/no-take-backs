+func test_table_seats_v1600() -> void:
+	var TS = load("res://scripts/ui/table_seats.gd")
+	var PAL = load("res://scripts/ui/palette.gd")
+	var UB = load("res://scripts/ui/ui_base.gd")
+	ok(TS.BOARD.position == UB.ORIGIN and TS.BOARD.size == UB.FIELD, "桌位表的盤面＝ORIGIN、FIELD（同一個盤）")
+	var sl: Dictionary = TS.right_slots()
+	ok(sl.has("owner") and sl.has("cup") and sl.has("clock"), "右緣三槽：上老闆、中茶杯、下棋鐘")
+	var fr: Rect2 = TS.frame_rect()
+	for k in sl:
+		var r: Rect2 = sl[k]
+		ok(r.position.x - fr.end.x >= TS.SLOT_GAP and r.end.x <= TS.SCREEN.x and r.size.x >= TS.SLOT_W_MIN and r.size.x <= TS.SLOT_W, "槽 %s：距盤框 ≥16、不出螢幕、寬 88～104" % k)
+	ok(not (sl["owner"] as Rect2).intersects(sl["cup"]) and not (sl["cup"] as Rect2).intersects(sl["clock"]), "三槽不重疊")
+	ok(TS.right_slots(Rect2(100, 100, 1100, 576)).is_empty(), "盤太寬、桌緣放不下槽＝回空（呼叫端照 HIDE_ORDER 退）")
+	var rep: Dictionary = TS.spec_report()
+	ok(not bool(rep["board_ok"]) and float(rep["edge_r"]) == 112.0, "規格符合度如實回報（盤含框 1056 > 1040、右桌緣 112；B06 決定縮盤）")
+	var nr: Rect2 = TS.result_note_rect()
+	ok(nr.end.x <= TS.RESULT_PAPER.position.x - TS.SLOT_GAP and nr.size.y <= TS.RESULT_NOTE_MAX.y, "局內便條在結果紙外左下、不壓紙")
+	for m in [PAL.MAT_WALNUT, PAL.MAT_PAPER, PAL.MAT_WAX, PAL.MAT_CHALK, PAL.MAT_BRASS]:
+		ok(m.size() == 3, "主材質三色（Base／Shadow／Highlight）")
+	ok(PAL.CONTACT_OFF == Vector2(3, 4) and PAL.CONTACT_FEATHER == 6.0 and PAL.CONTACT_A >= 0.35 and PAL.CONTACT_A <= 0.45, "接觸影 (3,4)、羽化 6、α 0.35～0.45")
+	var ub: String = FileAccess.get_file_as_string("res://scripts/ui/ui_base.gd")
+	ok(ub.find("func _contact_shadow(") >= 0 and ub.find("Seats.right_slots()") >= 0 and ub.find("Vector2(1236, 432)") < 0, "接觸影共用函式；茶杯、沙漏照桌位表（不再寫死座標）")
+	ok(ub.find("if int(get(\"state\")) != St.TITLE:") >= 0, "有棋盤的頁盤外桌面壓暗")
+	var gp: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_place.gd")
+	ok(gp.find("_draw_foe_slot(slots[\"owner\"], zone)") >= 0 and gp.find("func _draw_foe_card(") >= 0, "敵情翻牌收合成右緣上槽肖像鈕、展開才浮出紙卡")
+	var bv: String = FileAccess.get_file_as_string("res://scripts/ui/battle_view.gd")
+	ok(bv.find("if state == St.RESULT:\n\t\treturn   # 1.6.0 B03") >= 0, "結果頁背後戰力尺、棋鐘收合")
+	var gr: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_result.gd")
+	ok(gr.find("_mat_box(r, \"card2\", PAL.PAPER_DESK_TONE)") >= 0 and gr.find("_contact_shadow(r, 4.0, 0.45)") >= 0, "結果紙：桌燈色調＋共用接觸影")
diff --git a/game/tools/tone_check.py b/game/tools/tone_check.py
new file mode 100644
index 0000000..a9dbaed
--- /dev/null
+++ b/game/tools/tone_check.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""1.6.0 B03（S2）三代表頁的灰階三階＋盤內不變量測。
+用法：PYTHONPATH=../build/pylibnp python3 tools/tone_check.py <新版面輸出夾> [舊版對照夾] [--strip 輸出.png]
+  兩個資料夾底下都是 <組合>/<畫面>.png（layout_check 的輸出結構）。
+量什麼（L*，CIE 1976，0～100；區域照 scripts/ui/table_seats.gd 的桌位表）：
+  桌：右緣桌面（上槽與中槽之間的空桌） ≤25
+  紙：結果紙中段、擺陣盤面中段（「中階紙與盤」） 35～65
+  主層：主鈕（開戰、下一局）只列數值（主層看「亮或高對比實心」，紅漆鈕靠對比不靠亮度）
+  盤內不變：同固定時鐘的舊截圖，盤面內逐像素比（擺陣頁遮掉 1.5.0 吊在盤上的敵情翻牌）；差異像素 0＝ΔE 0
+--strip：左舊｜中新｜右新灰階的三頁流程條（並列審片用）。
+最後一行：TONE OK／TONE FAIL <理由>。"""
+import os, sys
+import numpy as np
+from PIL import Image
+
+PAGES = {
+    "01_title.png": {"desk": (20, 640, 40, 100), "paper": (560, 350, 160, 100)},        # 標題：左下桌角；中階＝示範棋盤（標題的木牌是主層鈕）
+    "02_place.png": {"desk": (1186, 232, 88, 120), "paper": (300, 300, 300, 200), "main": (960, 700, 280, 28), "board": True},
+    "05_result.png": {"desk": (1186, 232, 88, 120), "paper": (240, 300, 260, 60), "main": (330, 660, 200, 22)},
+}
+BOARD = (150, 120, 980, 530)   # 盤面內側（戰鬥是桌邊視角，盤緣幾列會露出桌面，取內側）
+OLD_TAG = (760, 90, 400, 110)   # 1.5.0 吊在盤右上的翻牌（含吊繩；英文 150% 兩行更寬更高）
+
+def lstar(a):
+    a = a.astype(float) / 255.0
+    lin = np.where(a <= 0.04045, a / 12.92, ((a + 0.055) / 1.055) ** 2.4)
+    y = lin @ np.array([0.2126, 0.7152, 0.0722])
+    return np.where(y > 0.008856, 116 * np.cbrt(y) - 16, 903.3 * y)
+
+def crop(a, r):
+    x, y, w, h = r
+    return a[y:y + h, x:x + w]
+
+def main():
+    args = [x for x in sys.argv[1:] if not x.startswith("--")]
+    strip = sys.argv[sys.argv.index("--strip") + 1] if "--strip" in sys.argv else ""
+    if strip in args:
+        args.remove(strip)
+    new = args[0]
+    old = args[1] if len(args) > 1 else ""
+    fails = []
+    rows = []
+    for combo in sorted(os.listdir(new)):
+        for page, zones in PAGES.items():
+            p = os.path.join(new, combo, page)
+            if not os.path.isfile(p):
+                continue
+            a = np.asarray(Image.open(p).convert("RGB"))
+            L = lstar(a)
+            d = float(np.median(crop(L, zones["desk"])))
+            pp = float(np.median(crop(L, zones["paper"])))
+            m = float(np.median(crop(L, zones["main"]))) if "main" in zones else -1
+            line = "%s %s 桌 %.1f 紙 %.1f%s" % (combo, page, d, pp, (" 主鈕 %.1f" % m) if m >= 0 else "")
+            if d > 25.0:
+                fails.append("%s/%s 桌 %.1f>25" % (combo, page, d))
+            if not (35.0 <= pp <= 65.0) and "plain" not in combo:
+                fails.append("%s/%s 紙 %.1f 不在 35～65" % (combo, page, pp))
+            if old and zones.get("board"):
+                q = os.path.join(old, combo, page)
+                for bp in ([q, q.replace("02_place", "03_battle")] if os.path.isfile(q) else []):
+                    np_ = bp.replace(os.path.join(old, combo), os.path.join(new, combo))
+                    if not os.path.isfile(np_):
+                        continue
+                    b0 = np.asarray(Image.open(bp).convert("RGB")).astype(int)
+                    b1 = np.asarray(Image.open(np_).convert("RGB")).astype(int)
+                    full = np.abs(b0 - b1).max(axis=2) > 3   # ≤3/255 是繪製雜訊（同固定時鐘重拍也有）
+                    if "02_place" in bp:
+                        x, y, w, h = OLD_TAG
+                        full[y:y + h, x:x + w] = False
+                    diff = crop(full, BOARD)
+                    n = int(diff.sum())
+                    line += " ｜盤內差 %s %d px" % (os.path.basename(bp), n)
+                    if n:
+                        fails.append("%s/%s 盤內差 %d px" % (combo, os.path.basename(bp), n))
+            rows.append(line)
+    for r in rows:
+        print(r)
+    if strip and old:
+        tiles = []
+        for page in PAGES:
+            q, n2 = os.path.join(old, "zh_TW_100", page), os.path.join(new, "zh_TW_100", page)
+            if os.path.isfile(q) and os.path.isfile(n2):
+                a0 = Image.open(q).convert("RGB").resize((640, 400))
+                a1 = Image.open(n2).convert("RGB").resize((640, 400))
+                tiles.append([a0, a1, a1.convert("L").convert("RGB")])
+        if tiles:
+            W = Image.new("RGB", (1920, 400 * len(tiles)))
+            for i, t in enumerate(tiles):
+                for j, im in enumerate(t):
+                    W.paste(im, (640 * j, 400 * i))
+            W.save(strip)
+            print("流程條", strip)
+    print("TONE OK" if not fails else "TONE FAIL " + "；".join(fails[:8]) + ("…共 %d 筆" % len(fails) if len(fails) > 8 else ""))
+
+if __name__ == "__main__":
+    main()

exec
/bin/bash -lc 'cat coordination/v1600-impl/b03-plan.md && cat docs/art-spec-v160.md && cat docs/2026-11-15-v1.6.0-plan.md' in /mnt/c/Users/timmy/projects/no-take-backs
 succeeded in 0ms:
# B03 三代表頁像同一張桌（S2；P1.1～P1.3、§1 數值、結果 HUD 收合）

方案 §4 B03；切片 S2（`coordination/v1600p/r3-agy.md`）。只改 `01_title`、`02_place`（含共用盤面的戰鬥）、`05_result` 三頁；全站推廣是 B06。

## 量測起點（1.5.0，繁中 100%，L*）
| 頁 | 桌角 | 中心 | 判讀 |
|---|---|---|---|
| 01_title | 14.8 | 39.7 | 已在三階內 |
| 02_place | 21.1 | 44.9 | 已在三階內 |
| 05_result | 12.3 | **86.4** | 紙太亮（目標 35～65） |

## 做法
1. **主材質表**（`palette.gd`）：胡桃木、暖米厚紙、紅蠟、粉筆、舊銅各 Base／Shadow／Highlight；主光 `LIGHT_DEG` 35°；接觸影 `CONTACT_OFF` (3,4)、`CONTACT_FEATHER` 6、`CONTACT_A` 0.4；結果紙的桌上色調 `PAPER_DESK_TONE`（用量測把紙壓到 L* 55～62）。
2. **桌位表**（新 `scripts/ui/table_seats.gd`，單一來源）：盤框、右緣三槽（上老闆肖像鈕｜中茶杯／木籌｜下棋鐘／放大鏡）、槽距 16、槽寬 104（放不下時依空間收窄，最小 88；再放不下依 `HIDE_ORDER` 隱藏裝飾）、結果紙張、局內便條釘位（紙外左下，≤260×120）、首開便條（標題左區 ≤35%）。
   - **偏差**：目前盤框右緣 1168，桌緣只剩 112 px（規格要 ≥120＋槽 104）。縮盤會改到全部戰鬥畫面，屬 B06；B03 槽寬收窄到 88～96，B06 並列審片再決定縮盤。
3. **接觸影** `_contact_shadow(r)`（`ui_base.gd`）：偏移 (3,4)、羽化 6（三層疊）、`DIM_INK` α0.4。三頁的紙卡、木牌、茶杯、沙漏改用它（原本各寫各的 (5,7)／(6,8)／(6,9)）。
4. **擺陣**：茶杯、沙漏從寫死座標改成桌位表的中、下槽；敵情名牌預設收合成上槽的肖像鈕（點開才浮出原本的紙卡），不再壓棋盤右上；盤外桌面壓暗 18%（只在盤框外）。
5. **結果**：紙張改用 `PAPER_DESK_TONE`；背後戰場 HUD（戰力尺、棋鐘秒數）在結果狀態收合不畫。
6. **量測工具** `tools/tone_check.py`：三頁固定區域的 L*（桌角、紙、主鈕）＋盤內像素差（ΔE＝0 用同固定時鐘的 1.5.0 截圖逐像素比，遮掉舊名牌位置）＋流程條三聯圖（左 1.5｜中 1.6｜右灰階）。
7. **規格凍結** `docs/art-spec-v160.md`。
8. 測試 `test_table_seats_v1600`。

## 驗收（S2 判決）
三頁光向一致、無浮貼；桌 ≤25、紙 35～65、主鈕 ≥75 或高對比；盤內 ΔE 0；新增紋理 0（全程式繪製）、烘焙不變；24 組 0；英文 150% 裁切 0；固定時鐘不超出 1.5.0 容差（超出逐張解釋）。
# 1.6.0 全站美術規格（B03 凍結；數值的單一來源在程式）

方案 `docs/2026-11-15-v1.6.0-plan.md` §1。這份只記規則與量法；數字以程式為準：色票 `game/scripts/ui/palette.gd`（主材質、主光、接觸影）、桌位 `game/scripts/ui/table_seats.gd`、量測 `game/tools/tone_check.py`。

## §1 主光與接觸影
- 主光左上 35° 暖白（`LIGHT_DEG`）。所有桌上物件底緣接觸影＝偏移 `CONTACT_OFF` (3, 4) px、羽化 `CONTACT_FEATHER` 6 px（三層由寬到窄疊）、`DIM_INK` α `CONTACT_A` 0.4。程式一律呼叫 `ui_base._contact_shadow(r)`，不自己寫偏移。簡化介面＝一層硬影。
- 有棋盤的頁（擺陣、戰鬥、結果）桌面再壓暗 `OFF_BOARD_DIM` 18%；盤面畫在桌面之上，所以只暗到盤外，盤內隊色 ΔE＝0。

## §2 主材質（Base／Shadow／Highlight）
胡桃木 `MAT_WALNUT`、暖米厚紙 `MAT_PAPER`、紅蠟 `MAT_WAX`、粉筆 `MAT_CHALK`、舊銅 `MAT_BRASS`（數值見 palette.gd）。攤在桌上的紙（結果紙）乘 `PAPER_DESK_TONE`，把 L* 從 1.5.0 的約 86 壓到中階。

## §3 桌位表
- 盤面 1024×576（含框 1056）；規格上限 1040、左右桌緣各 ≥120——**目前不符**（盤框右緣 1168，桌緣 112），縮盤會改到全部戰鬥畫面，B06 用並列審片決定。
- 右緣三槽（上：老闆肖像鈕＝敵情翻牌收合｜中：茶杯或木籌｜下：棋鐘裝飾＝沙漏、放大鏡），距盤框 16 px；槽寬 104，桌緣不夠時收窄到 ≥88（目前 92），再不夠依 `HIDE_ORDER` 隱藏（杯墊→木籌→棋鐘裝飾）。
- 結果紙 880×610 居中；背後戰場 HUD（戰力尺、棋鐘）收合，只留木條與左上模式。局內便條釘位：紙外左下桌緣（≤260×120，實際寬受紙左邊桌面限制）。首開便條：標題左區 ≤35% 屏寬。

## §4 三階明度（L*，`tools/tone_check.py`）
| 層 | 範圍 | 量哪裡 |
|---|---|---|
| 背景暗木 | ≤25 | 右緣上槽與中槽之間的空桌；標題左下桌角 |
| 中階紙與盤 | 35～65 | 結果紙中段、擺陣盤面中段、標題示範棋盤 |
| 主層（兵偶、主鈕、勝負章） | ≥75 或高對比實心 | 紅漆主鈕 L* 約 47，靠對紙／對桌的對比，不靠亮度 |
簡化介面不量紙（平塗色另有規則：紙 #e8dcc0／字 #2a1e15；木 #3a2b1e／字 #f3ead6）。

## §5 字色
淺紙底一律深墨（對紙 ≥4.5:1）；深木、紅漆底用暖米白。紙面上的亮字由版面檢查「淺紙白字」擋（B02）。紙變暗時（桌燈下的結果紙），金色標題字改用 `ACCENT.darkened(0.78)`。

## §6 量測與並列審片
固定時鐘（`LAYOUT_FIXED=1`）拍三頁 → `PYTHONPATH=../build/pylibnp python3 tools/tone_check.py <新> <1.5.0 對照> --strip 流程條.png`：桌／紙門檻、盤內逐像素差（>3/255 才算，擺陣頁遮掉 1.5.0 吊在盤上的翻牌）、左 1.5｜中 1.6｜右灰階的流程條。
# 落子無悔 1.6.0 方案：「同一張桌」（定稿，2026-11-15；R5 兩方「有條件」，條件已寫進 §3、§4、§8）

> 討論紀錄 `coordination/v1600p/`（提示詞五步 `p1`～`p5`、R0 資料包 `r0-brief.md`＋`shots/`、R1～R3 三方稿、R2 裁決 `r2-decision.md`）。名稱注意：`docs/history/2026-11-10-v1.6.0-*`、`coordination/v160*` 是舊內部 V1.6.0。
> 只規劃、不實作。簽核（R5）只代表「方案足以進入實作」，不代表遊戲、美感、效能或真人測試已過。

## 0. 給使用者的一頁
**一句話**：1.5.0 把每一頁變簡單了；1.6.0 讓這些頁「坐在同一張棋館木桌上」——同一盞燈、同一套木和紙、東西放在固定的位置——同時讓混戰看得懂、輸了能研究、熟手有路可走。

**玩起來會怎樣（代表旅程）**
- 第一次開：一張「入館簽到」便條放在桌上選語言與字大小，收起後就是標題；標題的示範戰場照舊在右邊打。點「對戰」看到桌上三張主牌，不是六張一樣的紙條。
- 擺陣：大廳變成攤在桌上的「對戰挑戰簿」，翻三頁就開戰；擺陣、戰鬥、結果都在同一張桌，燈從左上照，茶杯、棋鐘、老闆的位置每頁都一樣。
- 戰鬥：戰團上方一條「勢」箭頭告訴你哪邊在推；沒跟拍時遊戲自動挑一對正在交手的兵給你看；跳字會讓開兵的臉。劍士、騎兵轉身時不再瞬間翻面。
- 輸了：敗因卡→看第一隻倒下→改一隻兵重打→左右兩局攤在「覆盤帳本」上比；帳本分清楚「看到的」和「已驗證的」。
- 打了 20 小時：無盡塔每三層可選「契約」或「休整」，同一座塔會走出不同的路；對 AI 可以打換邊雙局。

**不做（這版）**：大畫布推拉鏡頭、聯賽、完整模擬快照、15 秒精華匯出、四時段光線、看棋模式（選配再評）。

## 1. 全站美術統一規格摘要（P1、P2 的底座；B03 產出 `docs/art-spec-v160.md` 凍結，數值在 B03 用固定圖驗過才定稿）
**主光與接觸影**：左上 35° 暖白；所有桌上物件底緣接觸影＝偏移 (3, 4) px（1280×800 基準）、羽化 6 px、顏色 `PAL.DIM_INK` α 0.35～0.45；木偶底座另加 1 px 頂面高光（α 0.25）。
**三階明度**（灰階 0～100%）：背景暗木 ≤25%｜中階紙與盤 35～65%｜主層（兵偶、主鈕、勝負章）≥75% 亮或高對比實心。盤內隊色 ΔE＝0。
**主材質表**（初值；延伸 `scripts/ui/palette.gd`，Base／Shadow／Highlight；B03 用灰階量測後微調，仍要落在三階區間）：
| 材質 | Base | Shadow | Highlight | 灰階目標 | 顆粒 |
|---|---|---|---|---|---|
| 胡桃木桌 | #5b4632 | #3a2b1e | #7a5e44 | ≤25% | 木紋週期 48～64 px |
| 暖米厚紙 | #e8dcc0 | #cbbd9c | #f6efdf | 35～65%（壓低現行約 85%） | 纖維 2～3 px |
| 紅蠟 | #a8231c | #7a1812 | #c94a3a | 主層高對比 | 無紋理 |
| 粉筆 | #f5eedc α0.62 | #cfc6b0 | — | 線條 | 抖動 0.5～0.8 px |
| 舊銅 | #b8913f | #7a5a22 | #d4ae55 | 主層點綴 | 磨損 1 px |
**簡化介面**：保留輪廓與雙階色塊（紙＝#e8dcc0／字＝#2a1e15；木＝#3a2b1e／字＝#f3ead6），關紋理與漸暈；邊框對底 ≥3:1；不出現純黑底系統窗。
**字色**：淺紙底一律深墨（#2a1e15，對紙 ≥4.5:1）；深木、紅漆底用暖米白（#f3ead6）；彩色徽章（勝負緞帶、認證）字對底 ≥4.5:1，色盲模式同。三階字全走 `tz()`；英文 150% 放不下＝改寫、換行、撐格，裝飾讓位，不縮字、不加 R14 豁免。
**桌位表**（單一來源；1280×800）：
- 擺陣／戰鬥：棋盤最大寬 1040 px、左右各留 ≥120 px 桌緣；右緣三槽寬 104 px、距盤 ≥16 px——上：老闆**肖像鈕**（敵情翻牌預設收合成肖像鈕，展開才浮出紙卡）｜中：茶杯或木籌擇一｜下：棋鐘或放大鏡（放大鏡縮成 96 px 直徑，不壓盤框）。窄到放不下時依序隱藏：杯墊→木籌→棋鐘裝飾。
- 結果：紙張居中，背後戰場 HUD（戰力條、剩餘秒數）收合；局內便條固定釘位在紙張外的左下桌緣（最大 260×120 px），不壓紙。
- 首開：入館便條在標題左區（≤35% 屏），和局內便條分開定義。
**基線升版（時序）**：B03 Go 之後，用「左 1.5｜中 1.6｜右灰階」並列審片**逐批解鎖** B06 → B08 → B10（各批固定時鐘仍以 1.5.0 基線＋容差把關，超出的畫面要逐張在 ledger 解釋為「主動改版」）；**P1＋P3＋P4 全部完工**並過四層觀片、K1、K2 後，主持人**一次性**登記「1.6.0 新基線」，保留 1.5.0 對照。之後才放量 P5、P12 的美術。

## 2. 方向（14 個；細項 ID＝P*.n）
每項：證據｜現況｜價值｜範圍｜不做。驗收細節在 §5；R1 原文與完整規格表見 `r1-*.md`、R3 切片見 `r3-*.md`。

### P1 同一張桌與微縮棋盤（必做・底座）
證據：流程條 `shots/strip/flow_zh_TW_100.jpg` 標題、大廳、擺陣、戰鬥、結果光向與材質各自為政；`22_lobby` 白紙佔約 92% 屏、灰階約 85%（Hydrogen）。現況：已有桌物語彙（便箋、木活字、方印），無全站契約。價值：使用者第 1 點「大作、不電腦感」的底座。
- P1.1 桌位表＋右側三槽（§1）——S2 切片。
- P1.2 左上主光＋底緣接觸影全站統一；棋盤外桌緣漸暈只在盤外。
- P1.3 主材質表單一來源；紙、木、蠟、粉筆、銅的色盤與顆粒。
- P1.4 地形微縮：各地形斜邊與落影（橋墩、木牆、冰緣）、清峽谷桌外雜訊；通行格與輪廓一致。
- P1.5 便條固定釘位（1.5.0 §13 的結果頁便條在此解）。
不做：大畫布推拉；四時段光。

### P2 去表單化與紙面字（必做・底座）
證據：導覽頁 `v16_01`（新玩法導覽）與異變實驗室紙面鈕白字；`22_lobby`、`zh-028` 首開、卡片面板 `zh-002～005` 是深框＋紙條清單；英文 150% 重災頁。現況：字級表、R14 已有；三階字、紙面字規則沒做。
- P2.1 三階排印映射 `tz()`；每頁 ≤3 級字。
- P2.2 紙面字色規則＋偵測：版面檢查補「淺紙上的細描邊白字」（1.5.0 檢查器盲點：描邊讓對比算過）。
- P2.3 英文 150% 重災頁改寫（`08f`、`23`、`58`、`89`、`10_codex`、`60_reward`、`01_title` Playroom 標籤）。
- P2.4 大廳挑戰簿（S1 切片）：簿紙灰階 45～65%、暗木框 12～15%、木撥片、手把 ≤3 步開戰。
- P2.5 按任務減選擇：覆盤分「改動／讀結果」、出題分「編輯／驗證」。
不做：中文直排木牌（延後，等 P1 定後再評）。

### P3 戰局一眼看懂（必做）
證據：尖峰幀 `v150_03f`（34 隻、4 段跳字）、`18_battle_new`（36）、`87d_boss_battle`（41）跳字與短標壓臉、BOSS 被血條擋。現況：跟拍兵＋目標記號、數字跳字無泡泡、非焦點血條淡（1.5.0）。
- P3.1「勢」箭頭（S4）；P3.2 自動焦點＋鏡頭仲裁（手動優先、倒帶不補）；P3.3 跳字分層與避讓（≤15% 交戰區、盤內 ≥12px）；P3.4 特效明度與面積上限（單一特效灰階 ≤80%、面積 ≤交戰區 4%，畫在兵偶頭肩輪廓之後；音符、閃光、十字改虛線邊或低佔比）；P3.5 語意保護：P1 的盤外退色與地形落影不碰隊色與通行格（P1 與 P3 的分工）。
不做：導播鏡位 2.0。

### P4 木偶剪影與底座（必做）
證據：縮圖 `shots/thumb/460x215_*` 兵像芝麻點；混戰同色同形。現況：圓／八角底座、隊色。
- P4.1 劍士、騎兵剪影先行（頭身、武器外形）→ 全兵種；P4.2 色盲旗形（頭頂圓旗／燕尾旗）；P4.3 底座斜邊厚度與頂面木紋；P4.4 BOSS 輪廓加粗；**全兵種**血條避讓——疊壓他兵頭臉時合併或移到底座前緣半圓弧。
不做：新兵種。

### P5 木偶動態與桌偶儀式（應做；S3 切片定路線）
證據：動態沒有連環條（R0 缺口）；轉身是鏡像切換（1.4.0 轉向中繼、背走已有）。
- P5.1 五方向步相（原畫路線）或程式轉身退路（預備壓縮→側緣過渡→微彈）——S3 擇一；P5.2 重心起伏、頓幀、受擊後仰；P5.3 疲累姿勢；P5.4 桌偶儀式：落桌微彈、開戰敲桌、收盤（可跳過、不吞輸入）；P5.5 1.5.0 基準連環條＋自動連拍工具（S3 前置）。
不做：兩條路線同時量產。

### P6 覆盤棋課（必做）
證據：敗因卡＋看第一隻倒下（1.5.0）；`review_changes`、`review_run`、三秒 GIF、幽靈比較**已存在**（Codex E02）。
- P6.1 證據分層：敗因文字「觀察」；改陣重算後才標「此條件下已驗證」；P6.2 配對棋課紀錄（原局碼、單一改動、改局碼、比較摘要；重啟還原；S5）；P6.3 覆盤帳本樣式（左頁原陣／改陣對照、右頁戰力折線＋紅蠟轉折）；P6.4 書籤跳轉（關鍵事件旗）；P6.5 宣紙戰報美化＋棋譜本從結果「更多」叫出。
不做：完整模擬快照、15 秒精華匯出。

### P7 長局與路線（應做）
- P7.1 塔分岔（每三層契約／休整；S6）；P7.2 完整續塔（新 run 欄位、舊 `tower_run` 遷移不猜歷史）；P7.3 AI 換邊雙局（沿 `SwapDuel`；第二局玩家擺紅方）；P7.4 棋譜集（名局收冊）。
不做：聯賽（延後）。

### P8 第一幕與門面（應做；S9）
- P8.1 首開入館便條（≤35% 屏、不壓示範戰場）；P8.2 卡片面板改桌上三主牌＋更多抽屜；P8.3 商店拍攝 Preset（戰鬥 zoom 1.25、前排拉開距離）；P8.4 實機錄影清單（擺陣落子、開戰、跟拍、敗因）。
保留：標題三區構成（三方都列為保留）。

### P9 朋友桌（選配）
- P9.1 三局拆招茶局（首局盲擺，後兩局各只改一隻；先封者輪替；勝 2 和 1）；P9.2 封陣與記分的中斷重啟；P9.3 反制回顧（只列雙方改動與一個可點事件，不宣稱因果）。

### P10 素材不拖住開戰（必做・底座；S7）
- P10.1 烘焙拆峰量測（各階段耗時、就緒標記）；P10.2 預設外觀離線圖集（鍵含繪圖、shader、色票、姿勢、引擎、渲染路徑、色盲）；P10.3 全選容量與准入（新增常駐 ≤64MiB、暫存 ≤32MiB，提案預算）。

### P11 驗收提速與基線升版（必做・底座；S8）
- P11.1 耗時切分與案例 ID 對帳；P11.2 就緒屏障＋畫面直達（與完整走訪對照）；P11.3 有界 PNG 編碼佇列；P11.4 差分擴驗規則（共享樣式、字型、導航、模擬→擴大全量）；P11.5 左中右升版管線（並列圖自動產出、主持人登記）。

### P12 棋館的人與聲音（依賴交付；剪影與聲音先做）
- P12.1 老闆剪影＋煙斗、茶杯道具（原稿到再換臉）；P12.2 常客 2 位桌角反應（同時 ≤1、可關、倒帶不補）；P12.3 器物聲三類（木棋、翻紙、蓋印；合成占位，真錄音同名替換）；P12.4 連勝桌況 B2（遠征第 1→7 戰盤外燈光收窄、木籌增加；盤內不動）。

### P13 舊器物精修（應做）
- P13.1 棋譜本壞資料隔離與恢復、滿六筆明示替換；P13.2 出題錯誤落點與保留草稿；P13.3 木偶展台（只用 P5 已驗方向）；P13.4 收藏與無障礙長字串；P13.5 競猜木籌（押注區桌物化、獎勵印在結算獎章）。

### P14 情報取捨（選配）
- P14.1 問路要付兵錢（布陣前花五金問一路兵種）；P14.2 情報承諾（敵陣先凍結、不退款不重抽）；P14.3 價格是否成決策（真人 5 人 6 題）。新規則走版本分流。

## 3. 依賴、共同預算、切片決策
- **順序（無環；R5 定）**：**B01**（量測、存檔範本）→ **B02**（紙面字，獨立小批可錯開）→ **B03** 代表頁（S2 Go）→ **B09** 容量准入（S7 Go）→ 並列審片逐批解鎖 **B06**（全站桌）→ **B08**（混戰）→ **B10** 兩兵種剪影 → **B13a** 全兵種剪影＋**一次登記 1.6.0 新基線**（P1＋P3＋P4）。動態另一條線：B11 轉身（S3）→ B12 大型驗證 → B13b 全兵種轉身——**剪影量產與新基線不等轉身 Go**。P2、P6、P7、P8 平行接在 B03／B04／B01 之後；P12 美術、P13 展台在 B13a／B13b 之後。原型可並行；量產門檻＝該批前置 Go＋B09 容量准入。
- **共同資源**：圖集容量（P4、P5、P12）由 P10 准入；戰場明度（P1、P3、P4）一次升版；入口：P7 走遠征、P9／P14 走遊戲間（遊戲間卡片 ≤6）、P6 走結果→覆盤；標題不加入口。
- **切片決策**：S1～S9 見 `r2-decision.md`；S3 決定 P5 走原畫或程式退路（原畫未到先驗程式路線）；S8 信心低——不過就保留耗時表，提速不擋其他方向。

## 3.1 版本與資料契約（K0、K5 的具體內容）
- **舊場**：舊場次位元組、舊 digest、FINGERPRINT b8fe741bcbfcf800、golden／compat／mirror 族不變；畫面狀態（焦點、勢、儀式、桌位）不進模擬。
- **新規則**（P7 契約、P9 茶局、P14 情報）只重組既有規則參數者不升 `RULES_VERSION`；新增判定（P14 扣款）升規則版本，並驗平衡、三星解（`star_check`、`trial_check`）、代碼往返相容。
- **版本矩陣**（R5）：
| 資料 | 版本鍵 | 讀到較新版本 | 讀到較舊版本 | 壞資料 |
|---|---|---|---|---|
| 存檔欄位 | `SAVE_VERSION`＋欄位 schema | 唯讀提示、不覆寫 | 遷移（逐欄驗型） | 隔離 `quarantine`、原檔不動 |
| 規則碼／分享碼 | `RULES_VERSION`、`EXT_VERSION` | 拒絕並說明「需要新版」 | 照舊版規則跑（版本分流） | 拒絕、不猜 |
| 棋課證據（P6） | 證據版本＋原局碼雜湊＋規則版本 | 只顯示、不重算 | 標「舊版證據」可重算 | 隔離該筆 |
| 塔路線（P7） | run 版本＋塔種子 | 唯讀 | 舊整數 run 照舊路線 | 回固定塔、保留原檔 |
- **讀取／拒絕**：新存檔欄位（`tower_run_v2`、`tower_route`、`lesson_pairs`、`tea_session`、`intel_session`）逐欄驗型；版本號較新＝唯讀提示不覆寫；壞資料隔離到 `quarantine`（1.0.0 起既有機制），原檔不動；舊樣本（1.5.0 存檔）原樣讀回。
- **會話邊界**（P7、P9、P14、P6 各自）：開局→**承諾**（敵陣、路線、陣型、規則、結算 ID 寫檔）→戰鬥→結算（只一次）→續玩→回退；每個邊界中斷、重啟、重複回呼、寫檔失敗各一個測試；模式之間不共用會話資料。B01 交付**存檔遷移與會話邊界測試範本**（`tests/suites/save.gd` 新範本），P6、P7、P9、P14 都用它。
- **塔退路**：B15 No-Go 時新 run 欄位保留但不讀，玩家照舊固定塔；已存的新 run 不刪。

## 3.2 輸入與截圖登記（K1 的具體內容）
新互動都要在 `test_input_matrix` 範本上加案例，並登記 `game/tools/screens.json` 新截圖入口：
| 案例 ID | 互動 | 必測 |
|---|---|---|
| IN-160-01 | 挑戰簿翻頁、撥片、返回 | 手把焦點恢復、同幀第二輸入、跨轉場 |
| IN-160-02 | 首開便條、卡片面板主牌與抽屜 | 停用、返回、手把 |
| IN-160-03 | 勢箭頭開關、自動焦點 vs 手動跟拍 | 手動搶權、倒帶不補、簡化預設關 |
| IN-160-04 | 覆盤帳本：改一子、書籤跳轉 | 跨轉場、取消、重啟 |
| IN-160-05 | 塔分岔卡、續塔 | 重複點、重啟、寫檔失敗 |
| IN-160-06 | 老闆肖像鈕、常客開關 | 停用、手把 |
| IN-160-07 | 桌偶儀式跳過 | 跳過不吞輸入、不改模擬 |
| IN-160-08 | 茶局封陣交接、情報購買 | 偷看、重按、倒帶 |
六把尺全站覆蓋：B06 依 `game/tools/screens.json` 200 畫面逐頁列批次歸屬（雙人／遠征／自由大廳、圖鑑、設定、出題台、暫停／確認彈窗都要有歸屬），B04 寫明英文頁籤縮寫與保寬退路。

