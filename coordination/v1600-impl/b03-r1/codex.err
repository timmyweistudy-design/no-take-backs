  1199	func _boss_note(key: String, host := "") -> void:
  1200		if overlay != host or shot_dir != "" or layout_probe:
  1201			return
  1202		if not preload("res://scripts/game/guide.gd").is_new(Save.data, "note_" + key):
  1203			return
  1204		note_key = key
  1205		note_ret = host
  1206		overlay = "boss_note"
  1207		_focus = 0
  1208	
  1209	func _close_boss_note() -> void:
  1210		preload("res://scripts/game/guide.gd").see(Save.data, "note_" + note_key)
  1211		Save.save_data()
  1212		overlay = note_ret
  1213		note_ret = ""
