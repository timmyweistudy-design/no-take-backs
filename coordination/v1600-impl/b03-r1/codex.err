   861			draw_rect(Rect2(cr.position + Vector2(3, 3), cr.size), Color(DIM_INK, 0.5))
   862			draw_rect(cr, Color("#e9d9b8"))
   863			draw_rect(Rect2(cr.position, Vector2(cr.size.x, 3)), Color(1, 0.97, 0.88, 0.7))
   864			draw_rect(cr, Color("#5a3a22"), false, 2.0)
   865			draw_rect(cr.grow(-4), Color("#8a6a48", 0.7), false, 1.0)   # 最後一輪（Codex 看圖 #6）：鐘面內框，像有厚度的木盒
   866			draw_rect(Rect2(cr.position.x, cr.end.y - 3, cr.size.x, 3), Color(DIM_INK, 0.35))
   867			draw_rect(Rect2(640 - 9, 0, 18, 3), Color("#c9a24a"))
   868			# 1.4.0 §7.2：數字是木活字；最後 10 秒每換一秒數字跳一下＋輕輕一聲（減少動態不跳）
   869			if secs != clock_last:
