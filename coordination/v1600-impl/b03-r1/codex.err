  1220		_hand_mode = true
  1221		var lines := wrap_lines(txt, sz, w - 72)
  1222		_hand_mode = false
  1223		var lh := sz * line_h(lines.size())
  1224		var bh := maxf(44.0, tz("B") * 1.9)
  1225		var P := modal_rect(w, 32.0 + lines.size() * lh + 8.0 + tz("B") * 1.4 + GAP_L + bh + 24.0)
