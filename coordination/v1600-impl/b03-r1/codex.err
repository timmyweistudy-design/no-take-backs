     1	#!/usr/bin/env python3
     2	"""1.6.0 B03（S2）三代表頁的灰階三階＋盤內不變量測。
     3	用法：PYTHONPATH=../build/pylibnp python3 tools/tone_check.py <新版面輸出夾> [舊版對照夾] [--strip 輸出.png]
     4	  兩個資料夾底下都是 <組合>/<畫面>.png（layout_check 的輸出結構）。
     5	量什麼（L*，CIE 1976，0～100；區域照 scripts/ui/table_seats.gd 的桌位表）：
     6	  桌：右緣桌面（上槽與中槽之間的空桌） ≤25
     7	  紙：結果紙中段、擺陣盤面中段（「中階紙與盤」） 35～65
     8	  主層：主鈕（開戰、下一局）只列數值（主層看「亮或高對比實心」，紅漆鈕靠對比不靠亮度）
     9	  盤內不變：同固定時鐘的舊截圖，盤面內逐像素比（擺陣頁遮掉 1.5.0 吊在盤上的敵情翻牌）；差異像素 0＝ΔE 0
    10	--strip：左舊｜中新｜右新灰階的三頁流程條（並列審片用）。
    11	最後一行：TONE OK／TONE FAIL <理由>。"""
    12	import os, sys
    13	import numpy as np
    14	from PIL import Image
    15	
    16	PAGES = {
    17	    "01_title.png": {"desk": (20, 640, 40, 100), "paper": (560, 350, 160, 100)},        # 標題：左下桌角；中階＝示範棋盤（標題的木牌是主層鈕）
    18	    "02_place.png": {"desk": (1186, 232, 88, 120), "paper": (300, 300, 300, 200), "main": (960, 700, 280, 28), "board": True},
    19	    "05_result.png": {"desk": (1186, 232, 88, 120), "paper": (240, 300, 260, 60), "main": (330, 660, 200, 22)},
    20	}
    21	BOARD = (150, 120, 980, 530)   # 盤面內側（戰鬥是桌邊視角，盤緣幾列會露出桌面，取內側）
    22	OLD_TAG = (760, 90, 400, 110)   # 1.5.0 吊在盤右上的翻牌（含吊繩；英文 150% 兩行更寬更高）
    23	
    24	def lstar(a):
    25	    a = a.astype(float) / 255.0
    26	    lin = np.where(a <= 0.04045, a / 12.92, ((a + 0.055) / 1.055) ** 2.4)
    27	    y = lin @ np.array([0.2126, 0.7152, 0.0722])
    28	    return np.where(y > 0.008856, 116 * np.cbrt(y) - 16, 903.3 * y)
    29	
    30	def crop(a, r):
    31	    x, y, w, h = r
    32	    return a[y:y + h, x:x + w]
    33	
    34	def main():
    35	    args = [x for x in sys.argv[1:] if not x.startswith("--")]
    36	    strip = sys.argv[sys.argv.index("--strip") + 1] if "--strip" in sys.argv else ""
    37	    if strip in args:
    38	        args.remove(strip)
    39	    new = args[0]
    40	    old = args[1] if len(args) > 1 else ""
    41	    fails = []
    42	    rows = []
    43	    for combo in sorted(os.listdir(new)):
    44	        for page, zones in PAGES.items():
    45	            p = os.path.join(new, combo, page)
    46	            if not os.path.isfile(p):
    47	                continue
    48	            a = np.asarray(Image.open(p).convert("RGB"))
    49	            L = lstar(a)
    50	            d = float(np.median(crop(L, zones["desk"])))
    51	            pp = float(np.median(crop(L, zones["paper"])))
    52	            m = float(np.median(crop(L, zones["main"]))) if "main" in zones else -1
    53	            line = "%s %s 桌 %.1f 紙 %.1f%s" % (combo, page, d, pp, (" 主鈕 %.1f" % m) if m >= 0 else "")
    54	            if d > 25.0:
    55	                fails.append("%s/%s 桌 %.1f>25" % (combo, page, d))
    56	            if not (35.0 <= pp <= 65.0) and "plain" not in combo:
    57	                fails.append("%s/%s 紙 %.1f 不在 35～65" % (combo, page, pp))
    58	            if old and zones.get("board"):
    59	                q = os.path.join(old, combo, page)
    60	                for bp in ([q, q.replace("02_place", "03_battle")] if os.path.isfile(q) else []):
    61	                    np_ = bp.replace(os.path.join(old, combo), os.path.join(new, combo))
    62	                    if not os.path.isfile(np_):
    63	                        continue
    64	                    b0 = np.asarray(Image.open(bp).convert("RGB")).astype(int)
    65	                    b1 = np.asarray(Image.open(np_).convert("RGB")).astype(int)
    66	                    full = np.abs(b0 - b1).max(axis=2) > 3   # ≤3/255 是繪製雜訊（同固定時鐘重拍也有）
    67	                    if "02_place" in bp:
    68	                        x, y, w, h = OLD_TAG
    69	                        full[y:y + h, x:x + w] = False
    70	                    diff = crop(full, BOARD)
    71	                    n = int(diff.sum())
    72	                    line += " ｜盤內差 %s %d px" % (os.path.basename(bp), n)
    73	                    if n:
    74	                        fails.append("%s/%s 盤內差 %d px" % (combo, os.path.basename(bp), n))
    75	            rows.append(line)
    76	    for r in rows:
    77	        print(r)
    78	    if strip and old:
    79	        tiles = []
    80	        for page in PAGES:
    81	            q, n2 = os.path.join(old, "zh_TW_100", page), os.path.join(new, "zh_TW_100", page)
    82	            if os.path.isfile(q) and os.path.isfile(n2):
    83	                a0 = Image.open(q).convert("RGB").resize((640, 400))
    84	                a1 = Image.open(n2).convert("RGB").resize((640, 400))
    85	                tiles.append([a0, a1, a1.convert("L").convert("RGB")])
    86	        if tiles:
    87	            W = Image.new("RGB", (1920, 400 * len(tiles)))
    88	            for i, t in enumerate(tiles):
    89	                for j, im in enumerate(t):
    90	                    W.paste(im, (640 * j, 400 * i))
    91	            W.save(strip)
    92	            print("流程條", strip)
    93	    print("TONE OK" if not fails else "TONE FAIL " + "；".join(fails[:8]) + ("…共 %d 筆" % len(fails) if len(fails) > 8 else ""))
    94	
    95	if __name__ == "__main__":
    96	    main()

