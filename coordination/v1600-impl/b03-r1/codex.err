   812			var sk := Rect2(bx + split - 6, 30, 12, 46)
   813			draw_rect(Rect2(sk.position + Vector2(2, 2), sk.size), Color(DIM_INK, 0.5))
   814			draw_rect(sk, Color("#8a6a2a"))
   815			draw_rect(sk.grow(-2), Color("#d4ae55"))
   816			draw_rect(Rect2(sk.position + Vector2(3, 3), Vector2(3, sk.size.y - 6)), Color(1, 0.96, 0.8, 0.6))
   817			for ry in [sk.position.y + 4.0, sk.end.y - 4.0]:
   818				draw_circle(Vector2(sk.get_center().x, ry), 2.2, Color("#5a4214"))   # 最後一輪（Codex 看圖 #6）：滑塊上下兩顆鉚釘＝卡在尺上的固定方式
   819		# 戰力條狀態（第三輪 V6）：狂熱整條加橘框；背水那端加火焰圖示與脈衝框
   820		if view.frenzy and not view.finished:
   821			draw_rect(Rect2(bx - 4, 38, bw + 8, 30), Color(1, 0.45, 0.1, 0.7 + 0.3 * sin(time * 6)), false, 3)
   822		for tm2 in 2:
   823			if view.rally[tm2] and not view.finished:
   824				var ex := bx if tm2 == 0 else bx + bw - 40
   825				draw_rect(Rect2(ex, 42, 40, 22), Color(1, 0.5, 0.15, 0.35 + 0.25 * sin(time * 8)), false, 2.5)
   826				_flame(Vector2(ex + 20 + (-30 if tm2 == 0 else 30), 53), 1.0)
   827		# 色盲配色的亮橘底用深色字（對比 ≥7:1）
   828		var lc := Color.WHITE
   829		_text(Vector2(bx + 8, 42), L.t("hud_power", [roundi(p0 * 100.0 / (view.budget_of(0) * 1000))]), ts(15), lc, false, true)
   830		var rt: String = L.t("hud_power", [roundi(p1 * 100.0 / (view.budget_of(1) * 1000))])
   831		var rtw := font_bold.get_string_size(rt, HORIZONTAL_ALIGNMENT_LEFT, -1, ts(15)).x
   832		# V1.2.1 F5：深色字只在字底下真的是亮橘條時用；紅方戰力低、字底下是藍條或空槽時改白字描邊
   833		var on_orange: bool = cbm() and state == St.BATTLE and split <= bw - 8.0 - rtw - 4.0   # 結果頁有暗幕，深字不清楚
   834		var rc := Color("#141820") if on_orange else Color.WHITE
