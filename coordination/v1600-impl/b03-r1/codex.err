  1197	## 精華三連：一段播完（或場次結束）就跳下一段；最後一段播完照常進結果。
  1198	func _hl_seg(i: int) -> void:
  1199		hl_i = i
  1200		var t := int(hl_reel[i])
  1201		hl_end = t + DirR.SEG_LEN - DirR.SEG_PRE
  1202		call("_seek_async", maxi(0, t - DirR.SEG_PRE))
  1203	
  1204	func _hl_reel_tick() -> bool:
  1205		if hl_reel.is_empty() or view == null or seek_target >= 0 or state != St.BATTLE:
  1206			return false
  1207		if view.tick >= hl_end or view.finished:
  1208			if hl_i + 1 < hl_reel.size():
  1209				_hl_seg(hl_i + 1)
  1210				return true
  1211			hl_reel = []
  1212		return false
