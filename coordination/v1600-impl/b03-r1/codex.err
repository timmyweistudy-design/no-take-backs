   800		else:
   801			_box(Rect2(bx - 4, 36, bw + 8, 34), Art.OUT, TH_EDGE, 6.0, 2.0)
   802		draw_rect(Rect2(bx, 40, split, 26), Art.team_color(0, cbm()))
   803		draw_rect(Rect2(bx + split, 40, bw - split, 26), Art.team_color(1, cbm()))
   804		draw_rect(Rect2(bx, 40, bw, 7), Color(1, 1, 1, 0.14))      # 上緣高光
   805		draw_line(Vector2(bx + split, 38), Vector2(bx + split, 68), Color.WHITE, 3.0)   # 交界線
   806		draw_line(Vector2(bx + bw / 2, 32), Vector2(bx + bw / 2, 74), Color(1, 1, 1, 0.55), 2)
   807		if craft_hud:
   808			for tk in range(1, 10):   # 木尺刻度（每 10%）
   809				var tx := bx + bw * tk / 10.0
   810				draw_line(Vector2(tx, 33), Vector2(tx, 37 if tk != 5 else 39), Color("#4a3018"), 1.5)
