diff --git a/game/scripts/ui/table_seats.gd b/game/scripts/ui/table_seats.gd
new file mode 100644
index 0000000..48ee3da
--- /dev/null
+++ b/game/scripts/ui/table_seats.gd
@@ -0,0 +1,55 @@
+extends RefCounted
+## 1.6.0 B03（P1.1）桌位表：桌上每樣東西放哪裡的單一來源（1280×800 基準；docs/art-spec-v160.md §3）。
+## 只放幾何，不畫圖；擺陣、戰鬥、結果、標題都從這裡拿位置，測試直接驗數字。
+
+const SCREEN := Vector2(1280, 800)
+const BOARD := Rect2(128, 100, 1024, 576)        # 盤面（＝ui_base ORIGIN、FIELD）
+const BOARD_FRAME := 16.0                        # 盤框外露寬
+const BOARD_MAX_W := 1040.0                      # 規格上限（含框）；目前 1056，縮盤留給 B06 並列審片決定
+const EDGE_MIN := 120.0                          # 規格：左右桌緣各 ≥120
+const SLOT_GAP := 16.0                           # 右緣槽距盤框 ≥16
+const SLOT_W := 104.0                            # 右緣槽寬（規格）
+const SLOT_W_MIN := 88.0                         # 桌緣不夠寬時收窄到這裡；再不夠就依 HIDE_ORDER 隱藏裝飾
+const SLOT_TOP := 108.0
+const SLOT_BOTTOM := 772.0
+const SLOTS := ["owner", "cup", "clock"]         # 上：老闆肖像鈕（敵情翻牌）｜中：茶杯或木籌｜下：棋鐘或沙漏、放大鏡
+const HIDE_ORDER := ["coaster", "chips", "clock_deco"]   # 窄到放不下時依序隱藏
+const OWNER_H := 112.0                           # 上槽（肖像鈕）高
+const RESULT_PAPER := Rect2(200, 100, 880, 610)  # 結果紙
+const RESULT_NOTE_MAX := Vector2(260, 120)       # 局內便條：紙外左下桌緣
+const FIRST_NOTE_MAX_FRAC := 0.35                # 首開便條：標題左區 ≤35% 屏寬
+
+static func frame_rect(board := BOARD) -> Rect2:
+	return board.grow(BOARD_FRAME)
+
+## 右緣桌面可用寬（盤框右緣到螢幕邊，扣槽距）
+static func right_room(board := BOARD) -> float:
+	return SCREEN.x - frame_rect(board).end.x - SLOT_GAP
+
+## 右緣三槽 {名稱: Rect2}；放不下（< SLOT_W_MIN）回空字典（呼叫端照 HIDE_ORDER 退）
+static func right_slots(board := BOARD) -> Dictionary:
+	var w := minf(SLOT_W, right_room(board) - 4.0)   # 右邊留 4px 不貼螢幕
+	if w < SLOT_W_MIN:
+		return {}
+	var x := frame_rect(board).end.x + SLOT_GAP
+	var mid_h := 150.0
+	var top := Rect2(x, SLOT_TOP, w, OWNER_H)
+	var bot_h := 96.0
+	var bot := Rect2(x, SLOT_BOTTOM - bot_h, w, bot_h)
+	var mid := Rect2(x, (top.end.y + bot.position.y - mid_h) * 0.5, w, mid_h)
+	return {"owner": top, "cup": mid, "clock": bot}
+
+## 規格符合度（ledger／測試用）：盤寬、左右桌緣、槽寬
+static func spec_report(board := BOARD) -> Dictionary:
+	var fr := frame_rect(board)
+	return {"board_w": fr.size.x, "board_ok": fr.size.x <= BOARD_MAX_W, "edge_l": fr.position.x, "edge_r": SCREEN.x - fr.end.x,
+		"edge_ok": fr.position.x >= EDGE_MIN and SCREEN.x - fr.end.x >= EDGE_MIN, "slot_w": minf(SLOT_W, right_room(board) - 4.0)}
+
+## 局內便條釘位：結果紙外左下桌緣（寬不超過紙左邊的桌面）
+static func result_note_rect(paper := RESULT_PAPER) -> Rect2:
+	var w := minf(RESULT_NOTE_MAX.x, paper.position.x - 2.0 * SLOT_GAP)
+	return Rect2(SLOT_GAP, paper.end.y - RESULT_NOTE_MAX.y, w, RESULT_NOTE_MAX.y)
+
+## 首開便條：標題左區
+static func first_note_max_w() -> float:
+	return SCREEN.x * FIRST_NOTE_MAX_FRAC
diff --git a/game/scripts/ui/ui_base.gd b/game/scripts/ui/ui_base.gd
index a523798..717e3fe 100644
--- a/game/scripts/ui/ui_base.gd
+++ b/game/scripts/ui/ui_base.gd
@@ -147,6 +147,7 @@ const CARD_X0 := 12.0
 const CARD_GAP := 6.0
 const CARD_H := 96.0
 const PAL = preload("res://scripts/ui/palette.gd")   # 1.3.0 §4 色票單一來源
+const Seats = preload("res://scripts/ui/table_seats.gd")   # 1.6.0 B03（P1.1）桌位表單一來源
 const UI_BG := PAL.UI_BG
 const PANEL := PAL.PANEL
 const ACCENT := PAL.ACCENT
@@ -1119,8 +1120,22 @@ func _draw_desk() -> void:
 	var vg := _ui_tex(TEX_VIGNETTE)
 	if vg != null:
 		draw_texture_rect(vg, Rect2(0, 0, 1280, 800), false, Color(0.11, 0.075, 0.05, 0.85))
+	# 1.6.0 B03（P1.2）：有棋盤的頁（擺陣、戰鬥、結果）盤外桌面再壓暗——盤面畫在桌面之上，所以只暗到盤外（盤內隊色 ΔE＝0）
+	if int(get("state")) != St.TITLE:
+		draw_rect(Rect2(0, 0, 1280, 800), Color(DIM_INK, PAL.OFF_BOARD_DIM))
 	_desk_props()
 
+## 1.6.0 B03（P1.2）接觸影：桌上物件底緣往右下（主光左上 35°）偏移 CONTACT_OFF、羽化 CONTACT_FEATHER（三層由寬到窄疊）。
+## 全站同一組數字（docs/art-spec-v160.md §1）；簡化介面只畫一層硬影。
+func _contact_shadow(r: Rect2, radius := 6.0, a := PAL.CONTACT_A) -> void:
+	var base := Rect2(r.position + PAL.CONTACT_OFF, r.size)
+	if bool(Save.s("plain_ui")):
+		draw_rect(base, Color(DIM_INK, a))
+		return
+	for i in 3:
+		var g: float = PAL.CONTACT_FEATHER * (1.0 - i / 3.0) * 0.5
+		draw_style_box(_flat_sb(Color(DIM_INK, a / 2.2), Color(0, 0, 0, 0), radius + g, 0.0), base.grow(g))
+
 ## 桌上小物（固定位置、低彩度、一律在畫面邊角，UI 蓋在上面也沒關係）
 func _desk_props() -> void:
 	# 墨水瓶（左下）：深色玻璃＋左上高光＋軟木塞
@@ -1146,9 +1161,13 @@ func _desk_props() -> void:
 	draw_line(Vector2(-10, 30), Vector2(104, 22), Color("#8b7355", 0.5), 1.0)
 	draw_line(Vector2(-10, 46), Vector2(100, 38), Color("#8b7355", 0.5), 1.0)
 	# 1.3.0 §1.2 茶杯（右側桌面）：熱氣三縷慢慢往上飄（減少特效時停住；截圖模式的時間是固定的，可重現）
-	var cup := Vector2(1236, 432)
-	# 桌邊斜看：杯口是扁一點的橢圓、下面露出一段杯身；右下落影（燈在左上；Antigravity cat02 #5）
-	draw_set_transform_matrix(ui_xf * Transform2D(0.0, Vector2(1.0, 0.82), 0.0, cup + Vector2(7, 20)))
+	# 1.6.0 B03（P1.1）：位置照桌位表右緣中槽；窄到沒有槽就不畫（HIDE_ORDER 第一個讓位）
+	var slots: Dictionary = Seats.right_slots()
+	if slots.is_empty():
+		return
+	var cup: Vector2 = (slots["cup"] as Rect2).get_center()
+	# 桌邊斜看：杯口是扁一點的橢圓、下面露出一段杯身；右下落影（燈在左上；1.6.0 接觸影偏移 (3,4)）
+	draw_set_transform_matrix(ui_xf * Transform2D(0.0, Vector2(1.0, 0.82), 0.0, cup + Vector2(PAL.CONTACT_OFF.x, 14.0 + PAL.CONTACT_OFF.y)))
 	draw_circle(Vector2.ZERO, 22.0, Color(DIM_INK, 0.38), true, -1.0, true)
 	draw_set_transform_matrix(ui_xf)
 	draw_rect(Rect2(cup + Vector2(-20, 0), Vector2(40, 14)), PAL.CUP_BODY)   # 杯身
@@ -1165,8 +1184,9 @@ func _desk_props() -> void:
 			var yy := -k * 7.0
 			pts.append(cup + Vector2(-8 + w * 8 + sin(st_t * 1.3 + k * 0.7 + w * 2.1) * (2.0 + k * 0.6), -20 + yy))
 		draw_polyline(pts, Color(1, 1, 1, 0.10 + 0.04 * w), 2.0, true)
-	# 沙漏（右下）
-	var hg := Vector2(1240, 752)
+	# 沙漏（右緣下槽）
+	var hg: Vector2 = (slots["clock"] as Rect2).get_center() + Vector2(0, 8)
+	_contact_shadow(Rect2(hg + Vector2(-16, 27), Vector2(32, 5)), 2.0)
 	draw_rect(Rect2(hg - Vector2(16, 32), Vector2(32, 5)), Color("#7a5434"))
 	draw_rect(Rect2(hg + Vector2(-16, 27), Vector2(32, 5)), Color("#7a5434"))
 	draw_colored_polygon(PackedVector2Array([hg + Vector2(-12, -27), hg + Vector2(12, -27), hg, hg + Vector2(12, 27), hg + Vector2(-12, 27), hg]), Color(0.85, 0.9, 0.95, 0.22))
