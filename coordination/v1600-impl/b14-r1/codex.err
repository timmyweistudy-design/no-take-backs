  1080	## 點擊：只對這個畫面世代畫出來的按鈕有效。回傳執行了幾個。
  1081	## ── 1.2.0 §9.4 宣紙戰報（結果頁前 1.2 秒）──
  1082	## 盤面 0.3 秒淡成宣紙 → 陣亡點蓋 8px 朱砂小印、擊倒者到被擊倒者一道淡墨線（40%、最底層）→ 0.55 秒勝負大章蓋下 → 1.0 秒後才出結果面板。
  1083	## 點任意處／任何按鍵跳過；截圖、減少特效、重播與覆盤不播。
  1084	const INK_DUR := 1.0
  1085	func _ink_active() -> bool:
  1086		return _ink_k() < INK_DUR and (shot_dir == "" or ink_force) and not bool(Save.s("reduce_fx")) and play_kind == "official" and not bool(Save.s("plain_ui"))
  1087	
  1088	var ink_force := false   # 截圖流程專拍宣紙戰報時用
  1089	func _ink_k() -> float:
  1090		return 0.8 if ink_force else time - result_t   # 截圖專拍時停在蓋章後的瞬間（截圖等幀的實際時間不固定）
  1091	
  1092	func _draw_ink_report_field() -> void:
  1093		var k := _ink_k()
  1094		var pa := clampf(k / 0.3, 0.0, 1.0) * 0.82
  1095		var pt := _ui_tex(MAT["card2"])
  1096		var fr := Rect2(ORIGIN, fld_size)
  1097		if pt != null:
  1098			draw_texture_rect(pt, fr, false, Color(1, 1, 1, pa))
  1099		else:
  1100			draw_rect(fr, Color(Color("#e8d8c3"), pa))
