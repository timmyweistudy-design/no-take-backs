   680			return
   681		lp_t += delta
   682		if lp_t >= float(Save.s("long_press")):
   683			lp_t = -1.0
   684			# 長按：取消左鍵的拖曳，改送一次右鍵（擺陣時拿掉兵；其他畫面右鍵本來就是返回／取消）
   685			drag_new = false
   686			painting = false
   687			drag_from = Vector2i(-1, -1)
   688			if _is_free():
   689				_fp_abort_drag()
   690			_enqueue("mb", {"i": MOUSE_BUTTON_RIGHT, "pressed": true, "pos": lp_pos})
   691			_enqueue("mb", {"i": MOUSE_BUTTON_RIGHT, "pressed": false, "pos": lp_pos})
