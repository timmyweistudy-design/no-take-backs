   652	func _touch_input(ev: InputEvent) -> void:
   653		if ev is InputEventScreenTouch:
   654			if ev.pressed:
   655				touches[ev.index] = ev.position
   656			else:
   657				touches.erase(ev.index)
   658			lp_t = 0.0 if (ev.pressed and touches.size() == 1 and overlay == "") else -1.0   # 覆蓋層（例如軍令時間軸）不用長按，免得拖曳變右鍵
   659			lp_pos = ev.position
   660			return
   661		if ev is InputEventScreenDrag:
   662			var old: Vector2 = touches.get(ev.index, ev.position)
   663			touches[ev.index] = ev.position
   664			if lp_t >= 0.0 and ev.position.distance_to(lp_pos) > 12.0:
   665				lp_t = -1.0   # 拖動了就不是長按
   666			if touches.size() == 2 and (state == St.BATTLE or state == St.RESULT):
   667				var ks := touches.keys()
   668				var other: Vector2 = touches[ks[0] if ks[1] == ev.index else ks[1]]
   669				var d0: float = old.distance_to(other)
   670				var d1: float = ev.position.distance_to(other)
   671				if d0 > 8.0:
   672					_pinch_by(d1 / d0, (ev.position + other) / 2.0)
   673	
   674	func _pinch_by(f: float, at: Vector2) -> void:
   675		pinch_zoom = clampf(pinch_zoom * f, 1.0, 2.0)
   676		pinch_center = _fld_xf().affine_inverse() * at
   677	
   678	func _touch_tick(delta: float) -> void:
