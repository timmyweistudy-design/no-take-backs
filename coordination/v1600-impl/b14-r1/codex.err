 exited 2 in 50ms:
     1	extends "res://scripts/ui/battle/battle_units.gd"
     2	## 其他層在同資料夾（V9 P1 拆檔）
     3	
     4	func _on_skip() -> void:
     5		if skip_busy:
     6			return   # 防重入
     7		paused = false   # Codex r1：暫停中按直接看結果，算完要能進結算
     8		if DisplayServer.get_name() == "headless" or shot_dir != "":
     9			while not view.finished:
    10				_sim_step(false)
    11			result_delay = 9.0
    12			return
    13		skip_busy = true
    14	
    15	
    16	func _skip_step() -> void:
    17		var t0 := Time.get_ticks_msec()
    18		while not view.finished and Time.get_ticks_msec() - t0 < 10:
    19			_sim_step(false)
    20		if view.finished:
    21			skip_busy = false
    22			result_delay = 9.0
    23	
    24	
    25	## 第十輪 I4：重播的全長在背景算，算完才開始播。
    26	func _pre_join() -> void:
    27		if pre_thread != null:
    28			var v = pre_thread.wait_to_finish()
    29			pre_thread = null
    30			if v is Array:
    31				replay_total = int(v[0])
    32				replay_bm = v[1]
    33	
    34	## 不要等：還在算就留給 _pre_reap 收。
    35	func _pre_drop() -> void:
    36		if pre_thread != null:
    37			pre_old.append(pre_thread)
    38			pre_thread = null
    39	
    40	func _pre_reap() -> void:
    41		for i in range(pre_old.size() - 1, -1, -1):
    42			if not pre_old[i].is_alive():
    43				pre_old[i].wait_to_finish()
    44				pre_old.remove_at(i)
    45	
    46	func _exit_tree() -> void:
    47		if has_method("_rv_exit"):
    48			call("_rv_exit")   # 1.1.0 H1：覆盤重算、GIF 先叫停再等
    49		bg.drain()   # 1.1.0 N6：覆盤、GIF、教練、三考、出題碼的背景工作：全部叫停再等（各自 64 tick／每格內會停）
    50		_pre_join()
    51		_pre_drop()
    52		for th in pre_old:
    53			th.wait_to_finish()
    54		pre_old.clear()
    55		if ai_thread != null:
    56			ai_thread.wait_to_finish()
    57			ai_thread = null
    58	
    59	func _battle_process(delta: float) -> void:
    60		if pre_thread != null:
    61			if pre_thread.is_alive():
    62				return
    63			_pre_join()
    64		if view != null:
    65			_gait_frame(delta)   # 不能放在只有部分情況才跑的地方（Codex P2 #1）
    66		if start_hold > 0.0:
    67			var ph0 := 1.0 - start_hold
    68			start_hold -= delta
    69			var ph1 := 1.0 - start_hold
    70			for at in [0.25, 0.55, 0.85]:   # 1.2.0 §9.1：三段落子各一聲厚重落子聲（全場只有 3 聲）
    71				if ph0 < at and ph1 >= at and sfx != null:
    72					sfx.play("place_heavy", 0.75)
    73			if start_hold <= 0.0:
    74				_ceremony_knock()   # 1.6.0 B14（P5.4）落桌完＝開戰敲桌
    75			return
    76		if call("_seek_pump"):
    77			return
    78		if _hl_reel_tick():
    79			return   # 1.3.0 §2 精華三連：換段開始跳轉，這一幀不再推進（Codex cat06 #1）
    80		if skip_busy:
    81			_skip_step()
    82			return
    83		if paused:
    84			return
    85		if hitstop > 0:
    86			# 1.2.0 §9.6 展示時鐘：停頓期間欠下的模擬 tick（只算真的停頓的那段、照停頓當下的倍速換算）
    87			var used := minf(delta, hitstop)
    88			present_debt += used * speed / 0.05
