    72	## 不能拿來綁的鍵（Codex r1）：方向與確認導航、畫筆修飾鍵、選兵數字、固定快捷鍵。
    73	const RESERVED := [KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT, KEY_ESCAPE, KEY_TAB, KEY_SHIFT, KEY_CTRL, KEY_ALT, KEY_META, KEY_G, KEY_Z, KEY_Y, KEY_DELETE,
    74		KEY_A, KEY_L, KEY_BRACKETLEFT, KEY_BRACKETRIGHT,   # 1.2.0 §11.1／11.2 固定快捷鍵：對齊、複製上一陣、上／下一個書籤（Codex cat08 #3）
    75		KEY_0, KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9]
    76	
    77	static func can_bind_key(code: int) -> bool:
    78		return not code in RESERVED
    79	
    80	## 十字鍵是導航，不能綁（Codex r3）。
    81	const PAD_RESERVED := [JOY_BUTTON_DPAD_UP, JOY_BUTTON_DPAD_DOWN, JOY_BUTTON_DPAD_LEFT, JOY_BUTTON_DPAD_RIGHT,
    82		JOY_BUTTON_LEFT_STICK, JOY_BUTTON_RIGHT_STICK]   # 第十三輪：L3 殘局提示、R3 時間設定（Codex v13-r2 #2）
    83	
    84	static func can_bind_pad(code: int) -> bool:
    85		return not code in PAD_RESERVED
