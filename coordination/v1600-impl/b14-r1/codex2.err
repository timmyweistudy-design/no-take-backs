   321	
   322	## 1.3.0 §2：雙擊回全景只認盤面範圍（按鈕列、HUD 不算）。
   323	func _field_hit(p: Vector2) -> bool:
   324		if p.y <= 96.0 or p.y >= (640.0 if _replay_controls_active() else 760.0):
   325			return false
   326		for b in _btns:
   327			if (b["r"] as Rect2).has_point(p):
   328				return false   # 按鈕上雙擊不算（Codex cat06 #4）
   329		var lo: Vector2 = _cam * ORIGIN
   330		var hi: Vector2 = _cam * (ORIGIN + fld_size)
   331		return Rect2(lo, hi - lo).has_point(p)
   332	
   333	func _mb_cmd(d: Dictionary) -> void:
   334		var mb := InputEventMouseButton.new()
   335		mb.button_index = d["i"]
   336		mb.pressed = d["pressed"]
   337		mb.position = d["pos"]
   338		mouse = d["pos"]
   339		var eat_dbl := false
   340		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   341			eat_dbl = dbl_eat   # 雙擊回全景那次的放開：不論走哪條路都要清掉（Codex cat06 #4）
   342			dbl_eat = false
   343		if state == St.BATTLE and overlay == "" and mb.pressed:
   344			mag_hide = follow_id   # 1.3.0 §2：任何按下都先收起放大鏡（點到兵會在放開時重新選）
   345			hl_reel.clear()        # 精華三連播放中動了就停在這裡（交還手動）
   346			if mb.button_index == MOUSE_BUTTON_WHEEL_UP or mb.button_index == MOUSE_BUTTON_WHEEL_DOWN:
   347				cam_wheel(mb.button_index == MOUSE_BUTTON_WHEEL_UP, mouse)   # 滾輪縮放
   348				return
   349			if mb.button_index == MOUSE_BUTTON_LEFT and bool(d.get("dbl", false)) and _field_hit(mouse):
   350				cam_reset()   # 雙擊盤面回全景
   351				dbl_eat = true
   352				return
   353		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and bool(call("vol_press", mouse)):
   354			return   # 1.3.0：在音量木軌上按下＝開始拖
   355		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed and bool(call("vol_release")):
   356			_mb_release_cleanup()
   357			return   # 拖完放開：存檔，不再觸發數值鈕
   358		if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
   359			if _do_click(mouse) > 0:
   360				_mb_release_cleanup()
   361				return
   362		if state == St.PLACE and overlay == "" and (foe_card_r.has_point(mouse) or foe_tag_r.has_point(mouse)):
   363			if not mb.pressed:
   364				_mb_release_cleanup()
   365			return   # 1.5.0 §1.4：敵情翻牌與紙卡擋住底下的部署區（不點穿）
   366		if state == St.PLACE and overlay == "" and mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed and _v16_place_click(mouse):
   367			return   # V1.6 #6：標記模式
   368		if state == St.PLACE and overlay == "" and _fp_mb(d):
   369			return   # 第六輪：自由排兵處理掉了
   370		if overlay != "" or state != St.PLACE:
   371			if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
   372				_mb_release_cleanup()
   373				if overlay == "" and state == St.BATTLE and mb.button_index == MOUSE_BUTTON_LEFT:
   374					if not eat_dbl:   # 雙擊回全景的那次放開不再選兵
   375						_battle_click(mouse)   # 重播時點兵讓鏡頭跟（第三輪 F2）
   376			return
   377		var c := _cell_at(mouse)
   378		if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
   379			var k := _card_at(mouse)
   380			if k >= 0 and _card_help_rect(k).has_point(mouse):
   381				return   # 放開時由「?」按鈕處理
   382			if k >= 0:
   383				if _allowed(k):
   384					selected = k
   385					drag_new = true
   386					sfx.play("k_click", 0.7)
   387				else:
   388					_toast(L.t("err_type"), true)
   389				return
   390			if c.x < 0:
   391				return
   392			if _can_edit_existing() and _cur_army().index_at(c.x, c.y) != -1:
   393				if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
   394					_toast(L.t("err_locked"), true)
   395					return
   396				if mode == Mode.VS_AI and bool(call("wave_is_locked", c)):
   397					_toast(L.t("wv_locked"), true)   # V1.4 #11：車輪戰殘兵不能搬
   398					return
   399				drag_from = c
   400				drag_moved = false
     1	extends "res://scripts/ui/battle/battle_units.gd"
     2	## 其他層在同資料夾（V9 P1 拆檔）
     3	
     4	func _on_skip() -> void:
     5		if skip_busy:
     6			return   # 防重入
     7		paused = false   # Codex r1：暫停中按直接看結果，算完要能進結算
     8		if DisplayServer.get_name() == "headless" or shot_dir != "":
     9			while not view.finished:
    10				_sim_step(false)
    11			result_delay = 9.0
    12			return
    13		skip_busy = true
    14	
    15	
    16	func _skip_step() -> void:
    17		var t0 := Time.get_ticks_msec()
    18		while not view.finished and Time.get_ticks_msec() - t0 < 10:
    19			_sim_step(false)
    20		if view.finished:
    21			skip_busy = false
    22			result_delay = 9.0
    23	
    24	
    25	## 第十輪 I4：重播的全長在背景算，算完才開始播。
    26	func _pre_join() -> void:
    27		if pre_thread != null:
    28			var v = pre_thread.wait_to_finish()
    29			pre_thread = null
    30			if v is Array:
    31				replay_total = int(v[0])
    32				replay_bm = v[1]
    33	
    34	## 不要等：還在算就留給 _pre_reap 收。
    35	func _pre_drop() -> void:
    36		if pre_thread != null:
    37			pre_old.append(pre_thread)
    38			pre_thread = null
    39	
    40	func _pre_reap() -> void:
    41		for i in range(pre_old.size() - 1, -1, -1):
    42			if not pre_old[i].is_alive():
    43				pre_old[i].wait_to_finish()
    44				pre_old.remove_at(i)
    45	
    46	func _exit_tree() -> void:
    47		if has_method("_rv_exit"):
    48			call("_rv_exit")   # 1.1.0 H1：覆盤重算、GIF 先叫停再等
