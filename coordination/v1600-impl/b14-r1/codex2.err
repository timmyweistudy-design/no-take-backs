    87	## 改鍵：撞到別的動作就互換（不會有兩個動作同一個鍵）。
    88	static func rebind(list: Array, table: Dictionary, action: String, code: int) -> Dictionary:
    89		if (list == ACTIONS and not can_bind_key(code)) or (list == PAD_ACTIONS and not can_bind_pad(code)):
    90			return table.duplicate()
    91		var out := table.duplicate()
    92		var old := int(out.get(action, _default_of(list, action)))
    93		for a in list:
    94			if a[0] != action and int(out.get(a[0], a[1])) == code:
    95				out[a[0]] = old
    96		out[action] = code
    97		return out
    98	
    99	## 存檔讀回來的表逐項驗型（R4）：不是整數、不認得的動作都丟掉。
   100	static func sanitize(list: Array, raw) -> Dictionary:
   101		var out := {}
   102		if raw is Dictionary:
   103			for a in list:
   104				var v = raw.get(a[0])
   105				if (v is int or v is float) and (can_bind_key(int(v)) if list == ACTIONS else can_bind_pad(int(v))):
   106					out[a[0]] = int(v)
   107		return out
