   286	## 塗兵（佇列命令）：按住拖過格子連續擺。
   287	func _paint_cmd(p: Vector2) -> void:
   288		call("vol_motion", p)   # 1.3.0：音量木軌拖曳中（沒在拖就什麼都不做）
   289		if drag_from.x >= 0 and p.distance_to(drag_press_p) >= 10.0:
   290			drag_moved = true   # V1.5.1：拖出去過就不算「點一下」（拖回原點也一樣，Codex v151-i3）
   291		if _is_free():
   292			if overlay == "":
   293				_fp_motion(p)
   294			return
   295		if state != St.PLACE or overlay != "" or not painting:
   296			return
   297		if _cur_army().team != paint_team:
   298			painting = false
   299			return
   300		var c := _cell_at(p)
   301		if c.x >= 0 and _cur_army().index_at(c.x, c.y) == -1:
   302			_try_place(c)
