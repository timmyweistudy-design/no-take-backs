   169	func _keys_input(ev: InputEvent) -> bool:
   170		if keys_capture == "":
   171			return false
   172		var part := keys_capture.split(":")
   173		if ev is InputEventKey and ev.pressed and not ev.echo:
   174			if ev.keycode != KEY_ESCAPE and part[0] == "kb":
   175				if not Keymap.can_bind_key(ev.keycode):
   176					_toast(L.t("keys_reserved"), true)
   177					return true
   178				Save.settings["keys"] = Keymap.rebind(Keymap.ACTIONS, Save.s("keys"), part[1], ev.keycode)
   179				Save.save_settings()
   180			keys_capture = ""
   181			return true
   182		if ev is InputEventJoypadButton and ev.pressed and part[0] == "pad":
   183			if not Keymap.can_bind_pad(ev.button_index):
   184				_toast(L.t("keys_reserved"), true)
   185				return true
   186			Save.settings["pad"] = Keymap.rebind(Keymap.PAD_ACTIONS, Save.s("pad"), part[1], ev.button_index)
   187			Save.save_settings()
   188			keys_capture = ""
   189			return true
   190		return ev is InputEventKey or ev is InputEventJoypadButton
