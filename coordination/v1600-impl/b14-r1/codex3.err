   608	## V1.5：第一次啟動先問語言、字級、無障礙（1.6.0 B05：抽成一支，開機與截圖流程的冷啟走查共用；force＝截圖模式也照走）
   609	## 一次「按下」（鍵、滑鼠鍵、手把鍵；不含放開、連發、移動）
   610	static func _is_press(ev: InputEvent) -> bool:
   611		if ev is InputEventKey:
   612			return ev.pressed and not ev.echo
   613		if ev is InputEventMouseButton or ev is InputEventJoypadButton or ev is InputEventScreenTouch:
   614			return ev.pressed
   615		return false
   616	
   617	## 收盤只讓「確認」跳過：空白、Enter、手把 A（白名單；暫停、返回、重綁的鍵都照原意，Codex B14 r2）
   618	static func _settle_skip_ok(ev: InputEvent) -> bool:
   619		if ev is InputEventKey:
   620			return ev.keycode in [KEY_SPACE, KEY_ENTER, KEY_KP_ENTER]
   621		if ev is InputEventJoypadButton:
   622			return ev.button_index == JOY_BUTTON_A
   623		return false
   624	
   625	func _boot_first_run(force := false) -> void:
   626		if not bool(Save.s("first_done")) and (force or (shot_dir == "" and not video_mode and DisplayServer.get_name() != "headless")):
   627			overlay = "first_run"
   628	
   629	func _throttle_when_minimized() -> void:
   630		var mini: bool = DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_MINIMIZED
   631		if mini != _was_minimized:
   632			_was_minimized = mini
