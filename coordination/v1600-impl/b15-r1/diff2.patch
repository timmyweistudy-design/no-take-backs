+	_toast(L.t("ls_full", [Lesson.CAP]) if st == "full" else L.t({"ok": "ls_saved", "unsaved": "ls_unsaved", "dup": "ls_dup", "bad": "ls_bad"}[st]), st != "ok")
+	return st
