   384	func _open_review() -> void:
   385		rv_orig = last_armies[0].copy()
   386		rv_army = last_armies[0].copy()
   387		rv_enemy = last_armies[1].copy()
   388		rv_fsel = -1
   389		rv_tab = 0   # 1.6.0 B07：打開覆盤在「改動」頁
   390		if rv_orig.deploy == "free":
   391			# 編輯識別（和戰鬥編號分開，Codex 第一輪）：覆盤時每隻帶 eid，「只改一隻」依 eid 比
   392			for i in rv_orig.units.size():
   393				rv_orig.units[i]["eid"] = i
   394				rv_army.units[i]["eid"] = i
   395			# 全場：搬移時也要守敵距
   396			var ep: Array = []
   397			for u in rv_enemy.units:
   398				ep.append(Army.pos_of(u))
   399			if rv_orig.depth > rv_orig.fw / 2:
   400				rv_army.enemy_pos = ep
   401				rv_orig.enemy_pos = ep.duplicate()
   402		rv_sel = Vector2i(-1, -1)
   403		_rv_dirty()
   404		_rv_base_start()
   405		_open("review")
   406	
   407	## 跟原本比改了幾隻（換兵種、移位、拿掉、新增都算一隻）。
   408	static func review_changes(orig, now) -> int:
   409		if orig.deploy == "free":
   410			var ma := {}
   411			for u in orig.units:
   412				ma[int(u.get("eid", -1))] = [int(u["type"]), int(u["x"]), int(u["y"])]
   413			var n := 0
   414			var seen := {}
   415			for u in now.units:
   416				var e := int(u.get("eid", -1))
   417				seen[e] = true
   418				if not ma.has(e) or ma[e] != [int(u["type"]), int(u["x"]), int(u["y"])]:
   419					n += 1
   420			for e in ma:
   421				if not seen.has(e):
   422					n += 1
   423			return n
   424		var a := {}
   425		var b := {}
   426		for u in orig.units:
   427			a["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   428		for u in now.units:
   429			b["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   430		var gone := 0
   431		var added := 0
   432		for k in a:
   433			if not b.has(k) or b[k] != a[k]:
   434				gone += 1
   435		for k in b:
   436			if not a.has(k) or a[k] != b[k]:
   437				added += 1
   438		return maxi(gone, added)
   439	
   440	func _rv_try(edit: Callable) -> void:
   441		var before = rv_army.copy()
   442		edit.call()
   443		if review_changes(rv_orig, rv_army) > 1:
   444			rv_army = before
   445			_toast(L.t("rv_one"), true)
   550		for v in rv_army.units:
   551			if rv_orig.index_at(v["col"], v["row"]) == -1:
   552				return L.t("rv_added", [L.t("unit_%d" % int(v["type"]))])
   553		return ""
   554	
   555	## 重算「如果」：同一個對手、改過的陣型，用確定性模擬直接跑到結束。
   556	## ctl（1.1.0 H1）：背景用 {"stop", "until"}；每 64 tick 看一次，停了回 {"cancel": true}。沒給就照舊一次跑完。
   557	static func review_run(a0, a1, p_rules = null, cmds: Array = [], ctl := {}) -> Dictionary:
   558		var s = Sim.new(a0.copy(), a1.copy(), p_rules)
   559		if s.cmd_on:
   560			s.cmd_play(cmds)
   561		s.fast = true
   562		if ctl.is_empty():
   563			s.run_to_end()
   564		else:
   565			while not s.finished:
   566				s.step()
   567				if s.tick & 63 == 0 and PZ._stopped(ctl):
   568					return {"cancel": true}
   569			if PZ._stopped(ctl):
   570				return {"cancel": true}
   571		var rem := roundi(s.power(s.winner) * 100.0 / (s.budget_of(s.winner) * 1000)) if s.winner >= 0 else 0
   572		return {"winner": s.winner, "rem": rem, "log": s.power_log, "log2": s.power_log2, "b": [s.budget_of(0), s.budget_of(1)], "ticks": s.tick}
   573	
   574	## V1.4 #1 時光機：兩條戰力紀錄第一次不一樣的 tick（兩隊戰力交錯存放）。完全一樣回 -1。
   575	static func diverge_tick(a: PackedInt64Array, b: PackedInt64Array) -> int:
   576		var n := mini(a.size(), b.size())
   577		for i in n:
   578			if a[i] != b[i]:
   579				return i / 2 + 1   # 模擬先加 tick 才記戰力：第一筆是 tick 1（Codex v140-i1）
   580		return -1 if a.size() == b.size() else n / 2 + 1
   581	
   582	## 1.2.0 §15.1：打開覆盤時「原本那一場」的基準重算也放背景（原本在主執行緒同步跑一整場，最壞約 7.5 秒畫面卡住）。
   583	## 基準算好之前：原本那條顯示「計算中」、重算鈕不能按（分岔 tick 要和基準比）。headless／截圖照舊同步（確定性）。
   584	var rv_base_thread: Thread = null
   585	var rv_base_err := ""   # 1.2.0（Codex cat01 #1）：""／"slow"（逾時）／"fail"（開不了執行緒）→ 顯示原因＋「重算原本」鈕
   586	func _rv_base_start() -> void:
   587		if rv_base_thread != null:
   588			bg.retire(rv_base_thread)
   589			rv_base_thread = null
   590		rv_base = {}
   591		rv_base_err = ""
   592		if not _async_ok():
   593			rv_base = review_run(rv_orig, rv_enemy, battle_rules, last_cmds)
   594			return
   595		var a: Variant = rv_orig.copy()
   596		var e: Variant = rv_enemy.copy()
   597		var r: Variant = battle_rules.copy() if battle_rules != null else null
   598		var lg: Array = last_cmds.duplicate(true)
   599		var ctl: Dictionary = BgPool.make_ctl(RV_LIMIT_MS)
   600		rv_base_thread = bg.start(func(): return review_run(a, e, r, lg, ctl), ctl)
   601		if rv_base_thread == null:
   602			rv_base_err = "fail"   # 開不了執行緒：不退回主執行緒無期限重算（Codex cat01 #1），顯示失敗、可以再按
   603	
   604	func _rv_base_poll() -> void:
   605		if rv_base_thread == null:
   606			return
   607		if overlay != "review":
   608			bg.retire(rv_base_thread)
   609			rv_base_thread = null
   610			return
   611		if not rv_base_thread.is_alive():
   612			var res: Dictionary = bg.take(rv_base_thread)
   613			rv_base_thread = null
   614			if bool(res.get("cancel", false)):
   615				rv_base_err = "slow"   # 逾時：顯示「算太久」＋重算鈕（不是永遠停在計算中）
   616				return
   617			rv_base = res
   618			if not rv_result.is_empty():
   619				_rv_set_result(rv_result)   # 先算好的「如果」要重新和基準比分岔點
   620	
   621	func _rv_set_result(res: Dictionary) -> void:
   622		if rv_result.is_empty() and not res.is_empty():
   623			rv_tab = 1   # 1.6.0 B07：重算好了＝自動翻到「讀結果」
   624			rv_focus_main = true   # 焦點交給讀結果頁的「播放如果」（不落到棋盤；Codex r1 #3）
   625		rv_result = res
   626		rv_div = diverge_tick(rv_base.get("log2", PackedInt64Array()), res.get("log2", PackedInt64Array())) if not res.is_empty() else -1
   627	
   628	## 第七輪 M3：覆盤重算開背景執行緒（模擬是純計算），畫面不卡；算的時候按鈕不能再按（防重入）。
   629	var rv_thread: Thread = null
   630	var rv_gen := 0          # 陣型改一次加一；算完時世代不同就丟掉（Codex r1：舊陣型的結果不能配新陣型）
   631	var rv_thread_gen := 0
   632	
   633	func _rv_dirty() -> void:
   634		rv_result = {}
   635		rv_div = -1
   636		rv_gen += 1
   637	
   638	## 1.1.0 H1：可取消、有期限（RV_LIMIT_MS）；改了陣型或離開覆盤就叫停，停了的交給 bg（BgPool）背景回收（不在主執行緒等）。
   639	## 開不了執行緒就提示、可以再按。
   640	const RV_LIMIT_MS := 20000
   641	var rv_ctl := {}
   642	func _rv_recalc() -> void:
   643		if rv_thread != null:
   644			return
   645		if DisplayServer.get_name() == "headless" or shot_dir != "":
   646			_rv_set_result(review_run(rv_army, rv_enemy, battle_rules, last_cmds))
   647			return
   648		var a: Variant = rv_army.copy()
   649		var e: Variant = rv_enemy.copy()
   650		var r: Variant = battle_rules.copy() if battle_rules != null else null
   651		var lg: Array = last_cmds.duplicate(true)
   652		var ctl: Dictionary = BgPool.make_ctl(RV_LIMIT_MS)
   653		var t: Thread = bg.start(func(): return review_run(a, e, r, lg, ctl), ctl)
   654		if t == null:
   655			_toast(L.t("rv_fail"), true)
   656			return
   657		rv_ctl = ctl
   658		rv_thread_gen = rv_gen
   659		rv_thread = t
   660	
   661	func _rv_cancel() -> void:
   662		if rv_thread != null:
   663			bg.retire(rv_thread)   # 叫停、交給共用回收（N6）
   664			rv_thread = null
   665	
   666	func _rv_poll() -> void:
   667		_rv_base_poll()
   668		_ls_poll()
   669		if rv_thread != null and (overlay != "review" or rv_thread_gen != rv_gen):
   670			_rv_cancel()   # 離開覆盤或改了陣型：舊的不用算完
   671			return
   672		if rv_thread != null and not rv_thread.is_alive():
   673			var res: Dictionary = bg.take(rv_thread)
   674			rv_thread = null
   675			if bool(res.get("cancel", false)):
   676				_toast(L.t("rv_slow"), true)   # 只有逾時會走到這（離開、改陣型在上面就收掉了）
   677				return
   678			if rv_thread_gen == rv_gen:
   679				_rv_set_result(res)
   680	
   681	## 結束時：叫停再等（64 tick 內會停）；GIF 也叫停。
   682	func _rv_exit() -> void:
   683		_rv_cancel()
   684		if ls_thread != null:
   685			bg.retire(ls_thread)
   686			ls_thread = null
   687			ls_check.erase(ls_thread_id)
   688		if rv_base_thread != null:
   689			bg.retire(rv_base_thread)
   690			rv_base_thread = null
   691		gif_ctl["stop"] = true   # 真正的等待在 bg.drain()（battle_view._exit_tree）
   692	
   693	func _rv_play() -> void:
   694		rv_last = [rv_army.copy(), rv_enemy.copy()]
   695		_replay_snapshot()
   696		replay_snap["overlay"] = "review"
   697		replay_marks = []
   698		overlay = ""
