   473		var res: Dictionary = CO.search(b0, e0, null, {}, CO.LIMIT, {"until": 1})
   474		ok(not bool(res.get("found", false)) and str(res.get("status", "")) == "timeout", "期限已過：不會回 found（含證據跑一半）", str(res))
   475		var g = load("res://scripts/ui/game_screens.gd").new()
