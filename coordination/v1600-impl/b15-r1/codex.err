   381	var rv_focus_main := false   # 1.6.0 B07：翻頁後這一幀把焦點放到該頁主鈕
   382	var rv_tab := 0     # 1.6.0 B07（P2.5）：覆盤按任務分兩頁：0＝改動（換兵、重算）、1＝讀結果（兩條走勢、分岔、播放）
