   487	
   488	## 1.2.0 第 11 大類：手把部署工具（按住 RT＋Y 翻轉、＋十字 ←→ 平移、＋LB 複製上一陣；沒按 RT 照原本按鍵）
   489	func test_pad_tools_v120() -> void:
   490		var SV = load("res://scripts/game/save.gd")
   491		var keep: Dictionary = SV.data.duplicate(true)
   492		var g = load("res://scripts/ui/game_screens.gd").new()
   493		g.sfx = FakeSfx.new()
   494		g._start_mode(g.Mode.VS_AI)
   495		var a = g.armies[0]
   496		a.units.clear()
   497		a.place(0, 5, 0)
   498		g._update_gen()   # 遊戲裡每幀都會更新畫面世代；測試先更新，排進佇列的命令才不會被當成上一個畫面的
   499		var rt := InputEventJoypadMotion.new()
   500		rt.device = 0
   501		rt.axis = JOY_AXIS_TRIGGER_RIGHT
   502		rt.axis_value = 1.0
   503		Input.use_accumulated_input = false
   504		Input.parse_input_event(rt)
   505		Input.flush_buffered_events()
   506		var y := InputEventJoypadButton.new()
   507		y.device = 0
   508		y.button_index = JOY_BUTTON_Y
   509		y.pressed = true
   510		ok(g._pad_tool(y) and int(g.armies[0].units[0]["row"]) == 0, "RT＋Y 先排進佇列（不插隊）")
   511		g._process_cmds()
   512		ok(int(g.armies[0].units[0]["row"]) == 8, "佇列執行：整軍上下翻轉（列 0→8）", str(g.armies[0].units))
   513		var lt := InputEventJoypadButton.new()
   514		lt.device = 0
   515		lt.button_index = JOY_BUTTON_DPAD_LEFT
   516		lt.pressed = true
   517		ok(g._pad_tool(lt), "RT＋← 排進佇列")
   518		g._process_cmds()
   519		ok(int(g.armies[0].units[0]["col"]) == 4, "RT＋←：整軍後退一欄")
   520		var aa := InputEventJoypadButton.new()
   521		aa.device = 0
   522		aa.button_index = JOY_BUTTON_A
   523		aa.pressed = true
   524		ok(not g._pad_tool(aa), "RT＋A 不是工具（照原本落子）")
   525		rt.axis_value = 0.0
   526		Input.parse_input_event(rt)
   527		Input.flush_buffered_events()
   528		Input.use_accumulated_input = true
   529		ok(not g._pad_tool(y) and int(g.armies[0].units[0]["row"]) == 8, "沒按 RT：Y 照原本（不翻轉）")
   530		g.free()
   531		SV.data = keep
   532	
   533	## 1.6.0 B15（P6.1～P6.2；S5）覆盤棋課：四類（換兵、移位、新增、拿掉）各 5 例存→讀回→重算 20/20 一致；
   534	## 八種失敗邊界（版本不符、壞筆、取消、重啟、過期重算、容量滿、重複保存、寫檔失敗）；正式副作用 0（存檔除了 lessons 以外不變）。
   535	func test_lesson_v1600() -> void:
   536		var LS = load("res://scripts/game/lesson.gd")
   537		var SV = load("res://scripts/game/save.gd")
   538		var RV = load("res://scripts/ui/replay_view.gd")
   539		var base = Army.new(0, 300)
   540		for p in [[0, 3, 2], [3, 4, 4], [1, 2, 6], [2, 1, 3], [0, 3, 7]]:
   541			base.place(p[0], p[1], p[2])
   542		var en = Army.new(1, 300)
   543		for p in [[0, 12, 4], [2, 13, 2], [1, 12, 6], [0, 11, 3]]:
   544			en.place(p[0], p[1], p[2])
   545		var edits := {
   546			"swap": [func(a): a.remove_at(3, 2); a.place(1, 3, 2), func(a): a.remove_at(4, 4); a.place(0, 4, 4), func(a): a.remove_at(2, 6); a.place(2, 2, 6), func(a): a.remove_at(1, 3); a.place(3, 1, 3), func(a): a.remove_at(3, 7); a.place(2, 3, 7)],
   547			"move": [func(a): a.move(3, 2, 5, 2), func(a): a.move(4, 4, 5, 4), func(a): a.move(2, 6, 4, 6), func(a): a.move(1, 3, 0, 3), func(a): a.move(3, 7, 5, 8)],
   548			"add": [func(a): a.place(0, 5, 1), func(a): a.place(1, 5, 5), func(a): a.place(2, 0, 0), func(a): a.place(3, 4, 8), func(a): a.place(0, 2, 4)],
   549			"remove": [func(a): a.remove_at(3, 2), func(a): a.remove_at(4, 4), func(a): a.remove_at(2, 6), func(a): a.remove_at(1, 3), func(a): a.remove_at(3, 7)],
   550		}
   551		var list: Array = []
   552		var kinds_ok := 0
   553		for k in LS.KINDS:
   554			for f in edits[k]:
   555				var alt = base.copy()
   556				f.call(alt)
   557				if RV.review_changes(base, alt) == 1 and LS.kind_of(base, alt) == k:
   558					kinds_ok += 1
   559				var r0: Dictionary = RV.review_run(base, en, null, [])
   560				var r1: Dictionary = RV.review_run(alt, en, null, [])
   561				var e: Dictionary = LS.make(base, alt, en, null, [], r0, r1, RV.diverge_tick(r0["log2"], r1["log2"]))
   562				list = LS.add(list, e)[0]
   563		ok(kinds_ok == 20 and list.size() == 20, "四類各 5 例都判對類別、都只改一隻（%d／20、存了 %d 則）" % [kinds_ok, list.size()])
   564		# 重啟：存檔來回序列化（JSON 整數變浮點）＋sanitize 後讀回、各自重算，結果和存的一樣
   565		var d: Dictionary = JSON.parse_string(JSON.stringify({"lessons": list}))
   566		SV.sanitize_extras(d)
   567		var back: Array = d["lessons"]
   568		var same := 0
   569		for e in back:
   570			var r: Dictionary = LS.restore(e)
   571			if r["ok"] and not r["stale"] and LS.same_result(e, RV.review_run(r["orig"], r["enemy"], r["rules"], r["cmds"]), RV.review_run(r["alt"], r["enemy"], r["rules"], r["cmds"])) and LS.kind_of(r["orig"], r["alt"]) == e["k"]:
   572				same += 1
   573		ok(back.size() == 20 and same == 20, "重啟（存檔來回＋驗型）後讀回重算 20/20 一致（%d）" % same)
   574		# 全場陣型：讀回後重新配編輯識別，類別照樣判得出來
   575		var fa = Army.new(0, 100)   # 規則預算 100（碼裡預算要和規則一致）
   576		fa.deploy = "free"
   577		var fe := 0
   578		for p in [[0, 1500, 2000], [3, 2500, 4000], [1, 1000, 6000]]:
   579			fe += 1 if fa.place_xy(p[0], p[1], p[2]) else 0
   580		if fe == 3:
   581			for i in fa.units.size():
   582				fa.units[i]["eid"] = i
   583			var fb = fa.copy()
   584			fb.move_xy(1, 2600, 4200)
   585			var rr = RSET.standard()
   586			rr.deploy = "free"   # 全場陣型要帶自由部署規則才編得成碼（同遊戲裡的 battle_rules）
   587			var ef_en = Army.new(1, 100)
   588			ef_en.deploy = "free"
   589			ef_en.place_xy(0, 10500, 4000)
   590			var r0f: Dictionary = RV.review_run(fa, ef_en, rr, [])
   591			var ef: Dictionary = LS.make(fa, fb, ef_en, rr, [], r0f, RV.review_run(fb, ef_en, rr, []), -1)
   592			var rf: Dictionary = LS.restore(ef)
   593			ok(ef["k"] == "move" and rf["ok"] and LS.kind_of(rf["orig"], rf["alt"]) == "move", "全場陣型：移位讀回後仍判成移位（編輯識別重新配對）", str([ef["k"], rf.get("why"), str(ef["o"]).substr(0, 5)]))
   594		else:
   595			ok(false, "全場陣型樣本擺不進去（%d／3）" % fe)
   596		var e0: Dictionary = back[0]
   597		# ① 版本不符
   598		var ev: Dictionary = e0.duplicate(true)
   599		ev["v"] = LS.VERSION + 1
   600		ok(LS.valid(ev) and LS.restore(ev)["why"] == "ver", "版本比遊戲新：讀得進清單但不還原（ver）")
   601		# ② 壞筆：碼被改、型別亂、缺欄
   602		var eb: Dictionary = e0.duplicate(true)
   603		eb["a"] = str(eb["a"]).substr(0, str(eb["a"]).length() - 1) + "x"
   604		var junk: Array = [eb, {"id": 3}, "x", null, {"v": 1, "id": "0123456789abcdef", "o": "a", "a": "b", "k": "swap", "ro": [0, 0, 0], "ra": [0, 0]}, e0]
   605		var sj: Array = LS.sanitize(junk)
   606		ok(sj[0].size() == 1 and int(sj[1]) == 5 and LS.sanitize("garbage")[0].is_empty() and LS.sanitize(null)[0].is_empty(), "壞筆：竄改、缺欄、亂型別都丟掉，好的留下（丟 %d）" % int(sj[1]))
   607		var ep: Dictionary = e0.duplicate(true)
   608		var other: Dictionary = back[1]
   609		ep["a"] = other["a"]
   610		ep["o"] = back[19]["o"]
   611		ep["id"] = (str(ep["o"]) + "|" + str(ep["a"])).sha256_text().substr(0, 16)
   612		ok(LS.valid(ep), "配對檢查樣本合格")
   613		# ⑥ 容量滿、⑦ 重複保存
   614		var full: Array = []
   615		for i in LS.CAP:
   616			var o := "O%d" % i
   617			full.append({"v": 1, "id": (o + "|A").sha256_text().substr(0, 16), "o": o, "a": "A", "k": "add", "ro": [1, 50, 100], "ra": [0, 20, 120], "div": 10})
   618		var rf2: Array = LS.add(full, e0)
