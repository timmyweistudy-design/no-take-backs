   481		a.place_xy(0, 3300, 3900)
   482		g.fp_redo = [{"team": 0, "units": []}]
   483		var nu: int = g.fp_undo.size()
   484		g._deploy_tool("align")
   485		ok(g.fp_undo.size() == nu and g.fp_redo.size() == 1, "對齊失敗：復原／重做歷史不動")
