   143			return false   # 先限範圍再轉整數（超大浮點不能溢位繞過「版本比遊戲新」）
   144		if str(e["o"]).length() > CODE_MAX or str(e["a"]).length() > CODE_MAX or str(e["id"]).length() != 16:
   145			return false
   146		if not str(e["k"]) in KINDS:
