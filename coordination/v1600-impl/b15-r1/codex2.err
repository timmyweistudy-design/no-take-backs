   183		if not o.get("ok", false) or not a.get("ok", false):
   184			return {"ok": false, "why": "code"}
   185		var ro = o.get("rules")
   186		var ra = a.get("rules")
   187		if o["a1"].to_code() != a["a1"].to_code() or int(o["a1"].budget) != int(a["a1"].budget) or int(o["a0"].budget) != int(a["a0"].budget) or (ro == null) != (ra == null) or (ro != null and ro.to_code() != ra.to_code()) or o.get("cmds", []) != a.get("cmds", []):
   188			return {"ok": false, "why": "pair"}
   189		var orig = o["a0"]
   190		var alt = a["a0"]
   191		if orig.deploy == "free":
   192			assign_eids(orig, alt)
   193		return {"ok": true, "why": "", "orig": orig, "alt": alt, "enemy": o["a1"], "rules": ro, "cmds": o.get("cmds", []), "stale": bool(o.get("mismatch", false)) or bool(a.get("mismatch", false))}
