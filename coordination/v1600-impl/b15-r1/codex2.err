   533	## 1.6.0 B15（P6.1～P6.2；S5）覆盤棋課：四類（換兵、移位、新增、拿掉）各 5 例存→讀回→重算 20/20 一致；
   534	## 八種失敗邊界（版本不符、壞筆、取消、重啟、過期重算、容量滿、重複保存、寫檔失敗）；正式副作用 0（存檔除了 lessons 以外不變）。
   535	func test_lesson_v1600() -> void:
   536		var LS = load("res://scripts/game/lesson.gd")
   537		var SV = load("res://scripts/game/save.gd")
   538		var RV = load("res://scripts/ui/replay_view.gd")
   539		var base = Army.new(0, 300)
   540		for p in [[0, 3, 2], [3, 4, 4], [1, 2, 6], [2, 1, 3], [0, 3, 7]]:
   541			base.place(p[0], p[1], p[2])
   542		var en = Army.new(1, 300)
   543		for p in [[0, 12, 4], [2, 13, 2], [1, 12, 6], [0, 11, 3]]:
   544			en.place(p[0], p[1], p[2])
   545		var edits := {
   546			"swap": [func(a): a.remove_at(3, 2); a.place(1, 3, 2), func(a): a.remove_at(4, 4); a.place(0, 4, 4), func(a): a.remove_at(2, 6); a.place(2, 2, 6), func(a): a.remove_at(1, 3); a.place(3, 1, 3), func(a): a.remove_at(3, 7); a.place(2, 3, 7)],
   547			"move": [func(a): a.move(3, 2, 5, 2), func(a): a.move(4, 4, 5, 4), func(a): a.move(2, 6, 4, 6), func(a): a.move(1, 3, 0, 3), func(a): a.move(3, 7, 5, 8)],
   548			"add": [func(a): a.place(0, 5, 1), func(a): a.place(1, 5, 5), func(a): a.place(2, 0, 0), func(a): a.place(3, 4, 8), func(a): a.place(0, 2, 4)],
   549			"remove": [func(a): a.remove_at(3, 2), func(a): a.remove_at(4, 4), func(a): a.remove_at(2, 6), func(a): a.remove_at(1, 3), func(a): a.remove_at(3, 7)],
   550		}
   551		var list: Array = []
   552		var kinds_ok := 0
   553		for k in LS.KINDS:
   554			for f in edits[k]:
   555				var alt = base.copy()
   556				f.call(alt)
   557				if RV.review_changes(base, alt) == 1 and LS.kind_of(base, alt) == k:
   558					kinds_ok += 1
   559				var r0: Dictionary = RV.review_run(base, en, null, [])
   560				var r1: Dictionary = RV.review_run(alt, en, null, [])
   561				var e: Dictionary = LS.make(base, alt, en, null, [], r0, r1, RV.diverge_tick(r0["log2"], r1["log2"]))
   562				list = LS.add(list, e)[0]
   563		var ut_ok := 0
   564		for e in list:
   565			var ut: Array = e["u"]
   566			ut_ok += 1 if (e["k"] == "add" and ut[0] == -1 and ut[1] >= 0) or (e["k"] == "remove" and ut[0] >= 0 and ut[1] == -1) or (e["k"] == "swap" and ut[0] >= 0 and ut[1] >= 0 and ut[0] != ut[1]) or (e["k"] == "move" and ut[0] >= 0 and ut[0] == ut[1]) else 0
   567		ok(ut_ok == 20, "每則記下改了哪種兵（%d／20）" % ut_ok)
   568		ok(kinds_ok == 20 and list.size() == 20, "四類各 5 例都判對類別、都只改一隻（%d／20、存了 %d 則）" % [kinds_ok, list.size()])
   569		# 重啟：存檔來回序列化（JSON 整數變浮點）＋sanitize 後讀回、各自重算，結果和存的一樣
   570		var d: Dictionary = JSON.parse_string(JSON.stringify({"lessons": list}))
   571		SV.sanitize_extras(d)
   572		var back: Array = d["lessons"]
   573		var same := 0
   574		for e in back:
   575			var r: Dictionary = LS.restore(e)
   576			if r["ok"] and not r["stale"] and LS.same_result(e, RV.review_run(r["orig"], r["enemy"], r["rules"], r["cmds"]), RV.review_run(r["alt"], r["enemy"], r["rules"], r["cmds"])) and LS.kind_of(r["orig"], r["alt"]) == e["k"]:
   577				same += 1
   578		ok(back.size() == 20 and same == 20, "重啟（存檔來回＋驗型）後讀回重算 20/20 一致（%d）" % same)
   579		# 全場陣型：讀回後重新配編輯識別，類別照樣判得出來
   580		var fa = Army.new(0, 100)   # 規則預算 100（碼裡預算要和規則一致）
   581		fa.deploy = "free"
   582		var fe := 0
   583		for p in [[0, 1500, 2000], [3, 2500, 4000], [1, 1000, 6000]]:
   584			fe += 1 if fa.place_xy(p[0], p[1], p[2]) else 0
   585		if fe == 3:
   586			for i in fa.units.size():
   587				fa.units[i]["eid"] = i
   588			var fb = fa.copy()
   589			fb.move_xy(1, 2600, 4200)
   590			var rr = RSET.standard()
   591			rr.deploy = "free"   # 全場陣型要帶自由部署規則才編得成碼（同遊戲裡的 battle_rules）
   592			var ef_en = Army.new(1, 100)
   593			ef_en.deploy = "free"
   594			ef_en.place_xy(0, 10500, 4000)
   595			var r0f: Dictionary = RV.review_run(fa, ef_en, rr, [])
   596			var ef: Dictionary = LS.make(fa, fb, ef_en, rr, [], r0f, RV.review_run(fb, ef_en, rr, []), -1)
   597			var rf: Dictionary = LS.restore(ef)
   598			ok(ef["k"] == "move" and rf["ok"] and LS.kind_of(rf["orig"], rf["alt"]) == "move", "全場陣型：移位讀回後仍判成移位（編輯識別重新配對）", str([ef["k"], rf.get("why"), str(ef["o"]).substr(0, 5)]))
   599		else:
   600			ok(false, "全場陣型樣本擺不進去（%d／3）" % fe)
   601		# 帶規則的碼（NTB3：換地圖、改預算的那一型），讀回重算一致
   602		var rr3 = RSET.standard()
   603		rr3.budget = [120, 120]   # 改預算＝非標準規則，走 NTB3
   604		var rb0 = Army.new(0, 120)
   605		var rb1 = Army.new(1, 120)
   606		rb0.place(0, 3, 2); rb0.place(3, 4, 4)
   607		rb1.place(0, 12, 4); rb1.place(2, 13, 2)
   608		var rb2 = rb0.copy()
   609		rb2.remove_at(3, 2); rb2.place(1, 3, 2)
   610		var e3: Dictionary = LS.make(rb0, rb2, rb1, rr3, [], RV.review_run(rb0, rb1, rr3, []), RV.review_run(rb2, rb1, rr3, []), -1)
   611		var r3: Dictionary = LS.restore(e3)
   612		ok(r3["ok"] and r3["rules"] != null and LS.same_result(e3, RV.review_run(r3["orig"], r3["enemy"], r3["rules"], r3["cmds"]), RV.review_run(r3["alt"], r3["enemy"], r3["rules"], r3["cmds"])), "帶規則的碼（改預算）：讀回重算一致", str([r3.get("why"), str(e3["o"]).substr(0, 4)]))
   613		# 敵方預算不同的兩個碼＝不是同一組（Codex B15 r1）
   614		var BCx = load("res://scripts/game/battle_code.gd")
   615		var enb = en.copy()
   616		enb.budget = 250
   617		var ex: Dictionary = back[0].duplicate(true)
   618		ex["a"] = BCx.encode(LS.restore(back[0])["alt"], enb, null, [])
   619		ex["id"] = (str(ex["o"]) + "|" + str(ex["a"])).sha256_text().substr(0, 16)
   620		ok(LS.restore(ex)["why"] == "pair", "兩個碼的敵方預算不同：不當成同一組")
   621		var ebig: Dictionary = back[0].duplicate(true)
   622		ebig["v"] = 1.0e30
   623		ok(not LS.valid(ebig), "超大版本號不能溢位繞過")
   624		var e0: Dictionary = back[0]
   625		# ① 版本不符
   626		var ev: Dictionary = e0.duplicate(true)
   627		ev["v"] = LS.VERSION + 1
   628		ok(LS.valid(ev) and LS.restore(ev)["why"] == "ver", "版本比遊戲新：讀得進清單但不還原（ver）")
   629		# ② 壞筆：碼被改、型別亂、缺欄
   630		var eb: Dictionary = e0.duplicate(true)
   631		eb["a"] = str(eb["a"]).substr(0, str(eb["a"]).length() - 1) + "x"
   632		var junk: Array = [eb, {"id": 3}, "x", null, {"v": 1, "id": "0123456789abcdef", "o": "a", "a": "b", "k": "swap", "ro": [0, 0, 0], "ra": [0, 0]}, e0]
   633		var sj: Array = LS.sanitize(junk)
   634		ok(sj[0].size() == 1 and int(sj[1]) == 5 and LS.sanitize("garbage")[0].is_empty() and LS.sanitize(null)[0].is_empty(), "壞筆：竄改、缺欄、亂型別都丟掉，好的留下（丟 %d）" % int(sj[1]))
   635		var ep: Dictionary = e0.duplicate(true)
   636		var other: Dictionary = back[1]
   637		ep["a"] = other["a"]
   638		ep["o"] = back[19]["o"]
   639		ep["id"] = (str(ep["o"]) + "|" + str(ep["a"])).sha256_text().substr(0, 16)
   640		ok(LS.valid(ep), "配對檢查樣本合格")
   641		# ⑥ 容量滿、⑦ 重複保存
   642		var full: Array = []
   643		for i in LS.CAP:
   644			var o := "O%d" % i
   645			full.append({"v": 1, "id": (o + "|A").sha256_text().substr(0, 16), "o": o, "a": "A", "k": "add", "ro": [1, 50, 100], "ra": [0, 20, 120], "div": 10})
   646		var rf2: Array = LS.add(full, e0)
   647		ok(rf2[1] == "full" and rf2[0].size() == LS.CAP, "容量滿：不加、不擠掉舊的")
   648		var rd: Array = LS.add(back, e0)
   649		ok(rd[1] == "dup" and rd[0].size() == back.size(), "重複保存：同一組不重複記")
   650		ok(LS.sanitize(full + [e0])[0].size() == LS.CAP, "存檔裡超過容量：只留前 %d 則" % LS.CAP)
   651		# 畫面流程：真的覆盤 → 改一隻 → 重算 → 記進棋課；過期重算、取消、寫檔失敗、正式副作用
   652		var GS = load("res://scripts/ui/game_screens.gd")
   653		var g = GS.new()
   654		g.sfx = FakeSfx.new()
   655		var keep: Dictionary = SV.data.duplicate(true)
   656		SV.data.erase("lessons")
   657		g.last_armies = [base.copy(), en.copy()]
   658		g.last_cmds = []
   659		g.battle_rules = null
   660		g._open_review()
   661		var before: Dictionary = SV.data.duplicate(true)
   662		ok(not g._rv_can_save(), "還沒重算不能記")
   663		g.rv_army.remove_at(3, 2)
   664		g._rv_dirty()
   665		g._rv_recalc()
   666		ok(g._rv_can_save(), "重算完成、只改一隻：可以記")
   667		g._rv_dirty()
   668		ok(not g._rv_can_save(), "過期重算：改了陣型（世代換了）就不能記舊結果")
   669		g._rv_recalc()
   670		SV.fail_inject = {"tmp": 1}
   671		var st1: String = g._rv_save_lesson()
   672		ok(st1 == "unsaved" and SV.has_unsaved() and SV.data.get("lessons", []).size() == 1, "寫檔失敗：留在記憶體、標未存、照實說（%s）" % st1)
   673		ok(SV.retry_pending() and not SV.has_unsaved(), "寫檔失敗後重試寫進去")
   674		ok(g._rv_save_lesson() == "dup", "畫面上再按一次＝已經記過")
   675		var after: Dictionary = SV.data.duplicate(true)
   676		var lessons_now: Array = after.get("lessons", [])
   677		after.erase("lessons")
   678		ok(var_to_str(after) == var_to_str(before), "正式副作用 0：存檔除了棋課以外一個欄位都沒變（統計、進度、成就、紀錄、日誌）")
   679		# 棋課本：重算核對、取消
   680		g.rv_tab = 2
   681		g._ls_check(lessons_now[0])
   682		ok(g.ls_check.get(lessons_now[0]["id"]) == "ok", "棋課本：重算核對和記下時一致", str(g.ls_check))
   683		g._ls_done(lessons_now[0], false, [{"cancel": true}, {}])
   684		ok(not g.ls_check.has(lessons_now[0]["id"]), "取消：不留半套狀態")
   685		var stl: Dictionary = lessons_now[0].duplicate(true)
   686		g._ls_done(stl, true, [{}, {}])
   687		ok(g.ls_check.get(stl["id"]) == "stale", "規則版本不同：標出來（照現在規則重算，不拿存的當真）")
   688		# 分頁：每頁筆數照字級與高度算（大字級少、至少 1、最多 5），最後一列鈕不超過返回列
   689		ok(GS.ls_per_page(260.0, 15) >= 2 and GS.ls_per_page(260.0, 27) <= GS.ls_per_page(260.0, 15) and GS.ls_per_page(600.0, 27) == 1 and GS.ls_per_page(260.0, 27) * (27 * 1.5 * 3.0 + 60.0) <= 370.0, "棋課本每頁筆數照字級算（15→%d、27→%d）" % [GS.ls_per_page(260.0, 15), GS.ls_per_page(260.0, 27)])
   690		SV.data["lessons"] = lessons_now
   691		# 看如果：走看對戰代碼的路，覆盤收掉、變成觀看
   692		g._ls_watch(lessons_now[0])
