   156	static func sanitize(raw) -> Array:
   157		var out: Array = []
   158		var bad := 0
   159		if not raw is Array:
   160			return [out, 0 if raw == null else 1]
   161		var ids := {}
   162		for e in raw:
   163			if out.size() >= CAP or not valid(e) or ids.has(str(e["id"])):
   164				bad += 1
   165				continue
   166			ids[str(e["id"])] = true
   167			var uu = e.get("u", [-1, -1])
   168			var ut: Array = [-1, -1]
   169			if uu is Array and uu.size() == 2 and _is_int(uu[0]) and _is_int(uu[1]) and int(uu[0]) >= -1 and int(uu[0]) < 64 and int(uu[1]) >= -1 and int(uu[1]) < 64:
   170				ut = [int(uu[0]), int(uu[1])]   # 兵種名只是顯示用：壞了就不顯示，不丟整則
   171			out.append({"v": int(e["v"]), "id": str(e["id"]), "o": str(e["o"]), "a": str(e["a"]), "k": str(e["k"]),
   172				"ro": [int(e["ro"][0]), int(e["ro"][1]), int(e["ro"][2])], "ra": [int(e["ra"][0]), int(e["ra"][1]), int(e["ra"][2])], "div": int(e.get("div", -1)), "u": ut})
   173		return [out, bad]
