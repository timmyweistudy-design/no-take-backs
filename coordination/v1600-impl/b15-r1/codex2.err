   124	static func _is_int(x) -> bool:
   125		return x is int or (x is float and float(x) == floorf(float(x)))
   126	
   127	static func _trio(v) -> bool:
   128		if not v is Array or v.size() != 3:
   129			return false
   130		for x in v:
   131			if not _is_int(x) or absf(float(x)) > 1.0e7:
   132				return false
   133		return int(v[0]) >= -1 and int(v[0]) <= 1 and int(v[1]) >= 0 and int(v[1]) <= 100 and int(v[2]) >= 0 and int(v[2]) < 1000000
   134	
   135	static func valid(e) -> bool:
   136		if not e is Dictionary:
   137			return false
   138		for k in ["id", "o", "a", "k"]:
   139			if not e.get(k) is String:
   140				return false
   141		var vv = e.get("v")
