   924		if ls_thread != null:
   925			return
   926		var r := Lesson.restore(e)
   927		if not r["ok"]:
   928			ls_check[e["id"]] = "bad"
   929			return
   930		ls_check[e["id"]] = "busy"
   931		var o = r["orig"]
   932		var a = r["alt"]
   933		var en = r["enemy"]
   934		var ru = r["rules"]
   935		var cm: Array = r["cmds"]
   936		if not _async_ok() or shot_dir != "":
   937			_ls_done(e, bool(r["stale"]), [review_run(o, en, ru, cm), review_run(a, en, ru, cm)])
   938			return
   939		var ctl: Dictionary = BgPool.make_ctl(RV_LIMIT_MS * 2)
   940		ls_thread = bg.start(func(): return [review_run(o, en, ru, cm, ctl), review_run(a, en, ru, cm, ctl)], ctl)
   941		if ls_thread == null:
   942			ls_check.erase(e["id"])
   943			_toast(L.t("rv_fail"), true)
   944			return
   945		ls_thread_id = e["id"]
   946		ls_thread_e = e
   947		ls_thread_stale = bool(r["stale"])
   948	
   949	func _ls_done(e: Dictionary, stale: bool, res: Array) -> void:
   950		if bool(res[0].get("cancel", false)) or bool(res[1].get("cancel", false)):
   951			ls_check.erase(e["id"])
   952			_toast(L.t("rv_slow"), true)
   953			return
   954		if stale:
   955			ls_check[e["id"]] = "stale"
   956		else:
   957			ls_check[e["id"]] = "ok" if Lesson.same_result(e, res[0], res[1]) else "diff"
   958	
   959	func _ls_poll() -> void:
   960		if ls_thread == null:
   961			return
   962		if overlay != "review" or rv_tab != 2:
   963			bg.retire(ls_thread)   # 離開棋課本＝取消（不留半套結果）
   964			ls_thread = null
   965			ls_check.erase(ls_thread_id)
   966			return
   967		if not ls_thread.is_alive():
   968			var res = bg.take(ls_thread)
   969			ls_thread = null
   970			if res is Array and res.size() == 2:
   971				_ls_done(ls_thread_e, ls_thread_stale, res)
   972			else:
   973				ls_check.erase(ls_thread_id)
   974	
   975	## 看「如果」那一場：走看對戰代碼的路（全新一局的情境，不動目前這局的陣型、規則、軍令）
   976	func _ls_watch(e: Dictionary) -> void:
   977		var r := Lesson.restore(e)
   978		if not r["ok"]:
   979			ls_check[e["id"]] = "bad"
   980			_toast(L.t("ls_bad"), true)
   981			return
   982		_rv_exit()
   983		overlay = ""
   984		_watch_code_str(str(e["a"]))   # 走看對戰代碼的同一條路：試玩版鎖定兵種／地圖、規則版本提示都在裡面（Codex B15 r1）
   985	
   986	func _ls_delete(id: String) -> void:
   987		Save.data["lessons"] = Lesson.remove(_ls_list(), id)
   988		ls_check.erase(id)
   989		if not Save.save_data():
   990			_toast(L.t("ls_unsaved"), true)
   991	
   992	## V1.4 #1：原本那條時間線（同一組敵陣、原本的我方陣、同樣的軍令紀錄），從頭建一份。
   993	func _tm_new_ghost() -> void:
   994		tm_ghost = Sim.new(rv_orig.copy(), rv_enemy.copy(), battle_rules)
   995		if tm_ghost.cmd_on:
   996			tm_ghost.cmd_play(last_cmds)
   997		tm_ghost.fast = true
   998	
   999	## 讓原本的時間線跟上畫面上的 tick；跳回較早的時間就重建再追（模擬是確定性的，追到同一 tick 狀態一樣）。
  1000	func _tm_sync() -> void:
  1001		if tm_ghost == null or view == null:
  1002			return
  1003		if tm_ghost.tick > view.tick:
  1004			_tm_new_ghost()
  1005		var guard := 0
  1006		while tm_ghost.tick < view.tick and not tm_ghost.finished and guard < 20000:
  1007			tm_ghost.step()
  1008			guard += 1
  1009	
  1010	## V1.4 #1：在走勢圖上畫分岔點（墨色虛線＋小三角）。
  1011	func _rv_div_mark(r: Rect2, span: int) -> void:
  1012		if rv_div < 0 or span <= 0:
  1013			return
  1014		var x := r.position.x + r.size.x * clampf(float(rv_div) / float(span), 0.0, 1.0)
  1015		_chalk_line(Vector2(x, r.position.y - 2), Vector2(x, r.end.y + 2), Color("#ffd166"), 2.6, 6.0)
  1016		# 1.4.0 §8.3 批註本：分岔點在兩條墨線上各用硃筆圈一下
  1017		if not bool(Save.s("plain_ui")):
  1018			var chh := (r.size.y - tz("S") * 1.5 - 12.0) * 0.5
  1019			for cy in [r.position.y + chh * 0.5, r.end.y - chh * 0.5]:
  1020				draw_arc(Vector2(x, cy), 11.0, 0.4, TAU - 0.3, 24, Color(1, 0.9, 0.75, 0.4), 4.0, true)
  1021				draw_arc(Vector2(x, cy), 11.0, 0.4, TAU - 0.3, 24, Color(PAL.TRINKET_RED, 0.9), 2.2, true)
  1022		draw_colored_polygon(PackedVector2Array([Vector2(x - 5, r.position.y - 8), Vector2(x + 5, r.position.y - 8), Vector2(x, r.position.y - 1)]), ACCENT)
  1023	
  1024	func _rv_has_sel() -> bool:
  1025		if rv_orig.deploy == "free":
  1026			return rv_fsel >= 0 and rv_fsel < rv_army.units.size()
  1027		return rv_sel.x >= 0
  1028	
  1029	## 第六輪：自由陣型的小戰場。一般＝左邊自己的部署區（可點）＋右邊紅方部署區（小、只看）；
  1030	## 全場＝整個戰場一張圖，兩隊都畫。原位置留半透明殘影＋虛線，看得出搬了多遠。
  1031	var _rv_map := {}   # 自己這張圖的 {o: 左上, s: 每單位幾像素}
  1032	
  1033	func _rv_free_board(g0: Vector2) -> void:
  1034		var full: bool = rv_orig.depth > rv_orig.fw / 2
  1035		var s := 0.028 if full else 0.038
  1036		s = minf(s, 450.0 / float(rv_orig.fw if full else rv_orig.depth + Army.EDGE))   # 大地圖別蓋到右邊的控制列（Codex #9）
  1037		s = minf(s, 340.0 / float(rv_orig.fh))
  1038		var wpx: float = (rv_orig.fw if full else rv_orig.depth + Army.EDGE) * s
  1039		var r := Rect2(g0, Vector2(wpx, rv_orig.fh * s))
  1040		draw_rect(r, Color(0.25, 0.4, 0.2))
   530		g.free()
   531		SV.data = keep
