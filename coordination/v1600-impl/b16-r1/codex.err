    38	static func split(raw) -> Array:
    39		var out: Array = []
    40		var bad: Array = []
    41		if raw == null:
    42			return [out, bad]
    43		if not raw is Array:
    44			bad.append(JSON.stringify(raw).left(CODE_MAX + 400))
    45			return [out, bad]
    46		var seen := {}
    47		for e in raw:
    48			var g = _entry(e)
    49			if g == null:
    50				bad.append(JSON.stringify(e).left(CODE_MAX + 400))
    51			elif out.size() < MAX and not seen.has(g["c"]):
    52				seen[g["c"]] = true
    53				out.append(g)
    54		return [out, bad]
    55	
    56	## 隔離區驗型：只收字串、去重、最多 BAD_MAX（新的在前）
    57	static func sanitize_bad(raw) -> Array:
    58		var out: Array = []
    59		if raw is Array:
    60			for x in raw:
    61				if x is String and x.length() <= CODE_MAX + 400 and not x in out:
    62					out.append(x)
    63		return out.slice(0, BAD_MAX)
