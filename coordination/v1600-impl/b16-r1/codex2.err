     1	extends RefCounted
     2	## 1.2.0 §11.8 名局棋譜本：把重播碼（對戰代碼）收成冊，最多 MAX 筆（新的在前，滿了丟最舊的）。
     3	## 每筆 {"c": 代碼, "n": 標題（日期＋結果）, "note": 老闆批註（這場的關鍵時刻）, "t": 收進來的時間}。純資料。
     4	const MAX := 6
     5	const CODE_MAX := 6000
     6	
     7	static func add(book: Array, code: String, title: String, note: String, now: int) -> Array:
     8		var out: Array = []
     9		for e in book:
    10			if e is Dictionary and str(e.get("c", "")) != code:
    11				out.append(e)
    12		out.push_front({"c": code, "n": title.left(80), "note": note.left(120), "t": now})
    13		return out.slice(0, MAX)
    14	
    15	static func remove(book: Array, i: int) -> Array:
    16		var out := book.duplicate(true)
    17		if i >= 0 and i < out.size():
    18			out.remove_at(i)
    19		return out
    20	
    21	## 存檔讀進來時逐筆驗型。壞的不丟：交給 split 隔離（1.6.0 B16）。
    22	static func sanitize(raw) -> Array:
    23		return split(raw)[0]
    24	
    25	const BAD_MAX := 6
    26	const BattleCode = preload("res://scripts/game/battle_code.gd")
    27	
    28	static func _entry(e):
    29		if not (e is Dictionary and e.get("c") is String and str(e["c"]).length() <= CODE_MAX and str(e["c"]) != ""):
    30			return null
    31		if not BattleCode.decode(str(e["c"])).get("ok", false):
    32			return null   # 代碼讀不出來（壞碼）：隔離，不放進冊子（不然「看」會失敗）
    33		var t = e.get("t", 0)
    34		var ti := int(t) if ((t is int or t is float) and absf(float(t)) < 1.0e12) else 0
    35		return {"c": str(e["c"]), "n": str(e.get("n", "")).left(80), "note": str(e.get("note", "")).left(120), "t": ti}
    36	
    37	const SCAN_MAX := 32   # 讀檔時最多看幾筆（巨量資料不拖垮讀檔；Codex B16 r1）
    38	const BAD_TEXT := CODE_MAX + 400
    39	
    40	## 壞的那筆留原文：只取 c／n／note 三個字串欄（截到上限），不把巢狀資料整個序列化
    41	static func _raw_of(e) -> String:
    42		if e is String:
    43			return e.left(BAD_TEXT)
    44		if e is Dictionary:
    45			var o := {}
    46			for k in ["c", "n", "note"]:
    47				var v = e.get(k)
    48				o[k] = v.left(CODE_MAX) if v is String else type_string(typeof(v))
    49			return JSON.stringify(o).left(BAD_TEXT)
    50		return type_string(typeof(e))
    51	
    52	## 1.6.0 B16（P13.1）壞資料隔離：回 [好的, 壞的原文字串]。玩家可以複製出來救、或清掉。
    53	static func split(raw) -> Array:
    54		var out: Array = []
    55		var bad: Array = []
    56		if not raw is Array:
    57			bad.append(_raw_of(raw))   # 不是陣列（含明確存成 null）：整個欄位隔離
    58			return [out, bad]
    59		var seen := {}
    60		var n := 0
    61		for e in raw:
    62			n += 1
    63			if n > SCAN_MAX:
    64				bad.append("+%d" % (raw.size() - SCAN_MAX))   # 太多筆：多的不看，記一筆數量
    65				break
    66			if e is Dictionary and e.get("c") is String and seen.has(e["c"]):
    67				continue   # 重複的好碼不再解碼
    68			var g = _entry(e)
    69			if g == null:
    70				bad.append(_raw_of(e))
    71			elif out.size() < MAX:
    72				seen[g["c"]] = true
    73				out.append(g)
    74		return [out, bad]
    75	
    76	## 隔離區驗型：只收字串、去重、最多 BAD_MAX（新的在前）
    77	static func sanitize_bad(raw) -> Array:
    78		var out: Array = []
    79		if raw is Array:
    80			for x in raw:
    81				if x is String and x.length() <= BAD_TEXT and not x in out:
    82					out.append(x)
    83		return out.slice(0, BAD_MAX)
    84	
    85	## 加一場之前先問：dup（已收過，會移到最上面）／full（滿了，會擠掉最舊的那筆）／ok
    86	static func add_check(book: Array, code: String) -> String:
    87		for e in book:
    88			if e is Dictionary and str(e.get("c", "")) == code:
    89				return "dup"
    90		return "full" if book.size() >= MAX else "ok"
