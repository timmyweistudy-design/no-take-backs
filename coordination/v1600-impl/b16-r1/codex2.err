+	var seen := {}
+	var n := 0
 	for e in raw:
-		if out.size() >= MAX:
+		n += 1
+		if n > SCAN_MAX:
+			bad.append("+%d" % (raw.size() - SCAN_MAX))   # 太多筆：多的不看，記一筆數量
 			break
-		if e is Dictionary and e.get("c") is String and str(e["c"]).length() <= CODE_MAX and str(e["c"]) != "":
-			out.append({"c": str(e["c"]), "n": str(e.get("n", "")).left(80), "note": str(e.get("note", "")).left(120), "t": int(e.get("t", 0)) if (e.get("t") is int or e.get("t") is float) else 0})
-	return out
+		if e is Dictionary and e.get("c") is String and seen.has(e["c"]):
+			continue   # 重複的好碼不再解碼
+		var g = _entry(e)
+		if g == null:
+			bad.append(_raw_of(e))
+		elif out.size() < MAX:
+			seen[g["c"]] = true
+			out.append(g)
+	return [out, bad]
+
+## 隔離區驗型：只收字串、去重、最多 BAD_MAX（新的在前）
+static func sanitize_bad(raw) -> Array:
+	var out: Array = []
+	if raw is Array:
+		for x in raw:
+			if x is String and x.length() <= BAD_TEXT and not x in out:
+				out.append(x)
+	return out.slice(0, BAD_MAX)
+
+## 加一場之前先問：dup（已收過，會移到最上面）／full（滿了，會擠掉最舊的那筆）／ok
+static func add_check(book: Array, code: String) -> String:
+	for e in book:
+		if e is Dictionary and str(e.get("c", "")) == code:
+			return "dup"
+	return "full" if book.size() >= MAX else "ok"
