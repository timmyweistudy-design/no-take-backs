   962			if layout_probe:
   963				probe_deco("stitch", sr, rd, "inside")   # 1.2.0 元件契約：縫線登記成宿主內的裝飾
   964			var dash := 6.0
   965			var xx := sr.position.x
   966			while xx < sr.end.x - dash:
   967				draw_line(Vector2(xx, sr.position.y), Vector2(xx + dash * 0.6, sr.position.y), sc, 1.0)
   968				draw_line(Vector2(xx, sr.end.y), Vector2(xx + dash * 0.6, sr.end.y), sc, 1.0)
   969				xx += dash
   970		elif plaque:
   971			var pt := Color(0.86, 0.36, 0.2) if primary else Color.WHITE
   972			if not enabled:
   973				pt = Color(0.78, 0.75, 0.7, 0.85)   # 停用＝褪色淺灰木牌（字照樣讀得到，不是一塊深色髒塊）
   974			elif sel_on and not primary:
   975				pt = Color(1.0, 0.84, 0.66)
   976			if enabled and (hover or focus):
   977				pt = Color(minf(pt.r * 1.1, 1.3), minf(pt.g * 1.1, 1.3), minf(pt.b * 1.1, 1.3))
   978			_mat_box(rd, "plaque", pt)
   979			if sel_on and enabled and tint.a > 0.0:
   980				draw_rect(rd.grow(-4 if rd.size.y >= 40.0 else -2), Color(Color("#9b281b"), 0.9), false, 2.5 if rd.size.y >= 40.0 else 1.5)   # 選中：朱砂框（矮按鈕框往外、變細，不壓到 150% 的字）
   981			if primary and enabled and rd.size.x >= 120.0 and not btn_no_wax:
