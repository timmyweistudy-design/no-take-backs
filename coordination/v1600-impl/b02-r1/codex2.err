  1073	static func plain_ui_now() -> bool:
  1074		return bool(Save.s("plain_ui"))
  1075	
  1076	## 主按鈕的流光（可關）。
  1077	func _btn_shine(r: Rect2) -> void:
  1078		if bool(Save.s("reduce_fx")):
  1079			return
  1080		var k := fposmod(time * 0.45, 1.0)
  1081		if k > 0.5:
  1082			return
  1083		var x: float = r.position.x + (r.size.x + 60.0) * (k * 2.0) - 30.0
  1084		# V1.2：斜的、窄的、淡的流光（直的半透明帶在截圖裡像破圖）
  1085		var sk := r.size.y * 0.5
  1086		var pts := PackedVector2Array([Vector2(x, r.end.y - 3), Vector2(x + 14, r.end.y - 3), Vector2(x + 14 + sk, r.position.y + 3), Vector2(x + sk, r.position.y + 3)])
  1087		var clip := PackedVector2Array()
  1088		for pp in pts:
  1089			clip.append(Vector2(clampf(pp.x, r.position.x + 3, r.end.x - 3), pp.y))
  1090		if clip[1].x > clip[0].x or clip[2].x > clip[3].x:
  1091			draw_colored_polygon(clip, Color(1, 1, 1, 0.09))
  1092	
  1093	## V1.2 B3：材質貼圖（tools/gen/gen_ui_tex.py 生成）。木紋是灰階，用原本的底色染，配色不變、多了木紋與上亮下暗的斜角。
  1094	const TEX_WOOD := "res://art/ui/wood.png"
  1095	## 1.2.0 §1.3 元件庫 2.0 的材質（tools/gen/materials.py 產生，manifest：art/mat/manifest.json）
  1096	const MAT := {"plaque": "res://art/mat/nine_plaque.png", "card1": "res://art/mat/nine_card1.png", "card2": "res://art/mat/nine_card2.png",
  1097		"card3": "res://art/mat/nine_card3.png", "walnut": "res://art/mat/tile_walnut.png", "tab_indigo": "res://art/mat/nine_tab_indigo.png",
  1098		"tab_madder": "res://art/mat/nine_tab_madder.png", "tab_linen": "res://art/mat/nine_tab_linen.png", "wax_red": "res://art/mat/wax_red.png"}
  1099	const MAT_INSET := {"plaque": 3.0, "tab_indigo": 3.0, "tab_madder": 3.0, "tab_linen": 3.0, "card1": 6.0, "card2": 6.0, "card3": 7.0}   # 1.2.0：內容內距＝毛邊寬（不是 9 宮格邊界）
  1100	const MAT_MARGIN := {"plaque": 14.0, "card1": 20.0, "card2": 20.0, "card3": 22.0, "tab_indigo": 13.0, "tab_madder": 13.0, "tab_linen": 13.0}
  1101	## 1.2.0 §1.1 桌面世界：整個畫面底下是一張老胡桃木桌（螢幕座標，鏡頭之前畫）。
  1102	## 光從左上來：左上一層暖光、右下一層暖暗；四角暖暗角；桌上固定 5 件低彩度小物（不搶焦點）。簡化介面時退回平塗。
  1103	func _draw_desk() -> void:
  1104		if bool(Save.s("plain_ui")):
  1105			draw_rect(Rect2(0, 0, 1280, 800), Color("#3a281c"))
  1106			return
  1107		var wt := _ui_tex(MAT["walnut"])
  1108		if wt == null:
  1109			draw_rect(Rect2(0, 0, 1280, 800), Color("#3a281c"))
  1110			return
  1235		if not _tex_cache.has(path):
  1236			_tex_cache[path] = load(path) if ResourceLoader.exists(path) else null
  1237		if _tex_cache[path] == null and layout_probe and not path in probe_missing:
  1238			probe_missing.append(path)
  1239		return _tex_cache[path]
  1240	
  1241	## V1.2：頂部資訊列：深木紋＋下緣一條亮線與落影（沒有貼圖時照舊平塗）。
  1242	func _hud_bar(r: Rect2) -> void:
  1243		if bool(Save.s("plain_ui")) or not _tex_box(r.grow_individual(8, 8, 8, 0), "wood", Color(0.3, 0.21, 0.15, 0.97)):
  1244			draw_rect(r, UI_BG)
  1245			return
  1246		draw_rect(Rect2(r.position.x, r.end.y - 2, r.size.x, 2), Color(0.55, 0.42, 0.28, 0.9))
  1247		draw_rect(Rect2(r.position.x, r.end.y, r.size.x, 4), Color(0, 0, 0, 0.25))
  1248	
  1249	## V1.2：木製框（九宮格、四角銅釘、中間透明），面板、戰場、大廳沙盤預覽共用。grow＝往外擴多少。
  1250	func _wood_frame(r: Rect2, grow := 8.0, key := "frame") -> void:
  1251		var fx := _ui_tex(TEX_FRAME)
  1252		if fx == null or bool(Save.s("plain_ui")):
  1253			return
  1254		var sb: StyleBoxTexture = _sb_cache.get(key)
  1255		if sb == null:
  1256			sb = StyleBoxTexture.new()
  1257			sb.texture = fx
  1258			for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
  1259				sb.set_texture_margin(side, 22.0)
  1260			sb.draw_center = false
  1261			_sb_cache[key] = sb
  1262		draw_style_box(sb, r.grow(grow))
  1263	
  1264	## 材質方塊：kind＝wood（染色）／groove（染色）／paper（原色）。沒有貼圖時退回平塗。
  1265	func _tex_box(r: Rect2, kind: String, tint := Color.WHITE) -> bool:
  1266		if bool(Save.s("plain_ui")):
  1267			# 1.2.0（Codex cat02 #8）：簡化介面一律退回平塗（同位置、同內距探針），不貼材質
  1268			var flat: Color = {"wood": TH_WOOD, "groove": Color(0.12, 0.09, 0.07), "paper": Color("#efe4cc")}[kind]
  1269			draw_rect(r, Color(flat.r * tint.r, flat.g * tint.g, flat.b * tint.b, tint.a))
  1270			if layout_probe:
  1271				probe_faces.append([r, kind == "paper"])   # 1.6.0 B02：直接畫的紙面／木面也登記（淺紙白字檢查；Codex v1600 B02 #1）
  1272			if layout_probe and minf(r.size.x, r.size.y) >= 20.0:
  1273				var ins0: Array = {"wood": [3.0, 3.0, 3.0, 4.0], "paper": [5.0, 5.0, 5.0, 5.0], "groove": [3.0, 3.0, 3.0, 3.0]}[kind]
  1274				probe_boxes.append({"r": r, "inner": r.grow_individual(-ins0[0], -ins0[1], -ins0[2], -ins0[3])})
  1275			return true
  1276		var path: String = {"wood": TEX_WOOD, "groove": TEX_GROOVE, "paper": TEX_PAPER}[kind]
  1277		var tx := _ui_tex(path)
  1278		if tx == null:
  1279			return false
  1280		if layout_probe:
  1281			probe_faces.append([r, kind == "paper"])   # 1.6.0 B02：直接畫的紙面／木面也登記（淺紙白字檢查；Codex v1600 B02 #1）
  1282		tint = qcol(tint)   # V1.2.1 F1：量化後當鍵，淡出時不會每幀多一個樣式
  1283		var k := "t|%s|%s" % [kind, tint.to_html()]
  1284		var sb: StyleBoxTexture = _sb_cache.get(k)
  1285		if sb == null:
  1286			_sb_room()
  1287			sb = StyleBoxTexture.new()
  1288			sb.texture = tx
  1289			var m := 10.0 if kind != "paper" else 14.0
  1290			sb.texture_margin_left = m
  1291			sb.texture_margin_right = m
  1292			sb.texture_margin_top = m
  1293			sb.texture_margin_bottom = m
  1294			# 羊皮紙整張拉伸（紋理不能無縫平鋪，平鋪會出現直條接縫）；木紋、凹槽平鋪保持紋理比例
  1295			var mode := StyleBoxTexture.AXIS_STRETCH_MODE_STRETCH if kind == "paper" else StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
  1296			sb.axis_stretch_horizontal = mode
  1297			sb.axis_stretch_vertical = mode
  1298			sb.modulate_color = tint
  1299			_sb_cache[k] = sb
  1300		draw_style_box(sb, r)
  1301		if layout_probe and minf(r.size.x, r.size.y) >= 20.0:
  1302			# V1.2.1 F1：登記材質的內容內距（gen_ui_tex.py 的實際斜邊：木紋上 3／下 4／左右 3，紙 5，凹槽 3），字不能壓進去
  1303			var ins: Array = {"wood": [3.0, 3.0, 3.0, 4.0], "paper": [5.0, 5.0, 5.0, 5.0], "groove": [3.0, 3.0, 3.0, 3.0]}[kind]
  1304			probe_boxes.append({"r": r, "inner": r.grow_individual(-ins[0], -ins[1], -ins[2], -ins[3])})
  1305		return true
