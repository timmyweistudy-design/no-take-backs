  1333	## V1.2.1 F1：樣式快取的顏色量化（透明度 16 級、RGB 8 位元），鍵和實際樣式用同一個值。
  1334	static func qcol(c: Color) -> Color:
  1335		return Color(roundf(c.r * 255.0) / 255.0, roundf(c.g * 255.0) / 255.0, roundf(c.b * 255.0) / 255.0, roundf(clampf(c.a, 0.0, 1.0) * 15.0) / 15.0)
  1336	
  1337	const SB_CACHE_MAX := 512
  1338	## 快取滿了整個清掉（用到再建；每個樣式只是幾個欄位，重建很便宜）。
  1339	func _sb_room() -> void:
  1340		if _sb_cache.size() >= SB_CACHE_MAX:
  1341			_sb_cache.clear()
