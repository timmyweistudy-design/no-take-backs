  1053			lines = wrap_lines(label, sz, r.size.x - 10, primary)
  1054		_probe_btn_label = true   # 版面檢查：這段是按鈕自己的標籤（不用位置猜，Antigravity 實作第 2 輪抓到猜錯的情況）
  1055		_probe_btn_rect = r
