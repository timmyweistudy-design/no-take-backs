   897	static func _wcag(a: Color, b: Color) -> float:
   898		var f := func(v: float) -> float: return v / 12.92 if v <= 0.04045 else pow((v + 0.055) / 1.055, 2.4)
   899		var la: float = 0.2126 * f.call(a.r) + 0.7152 * f.call(a.g) + 0.0722 * f.call(a.b)
   900		var lb: float = 0.2126 * f.call(b.r) + 0.7152 * f.call(b.g) + 0.0722 * f.call(b.b)
   901		return (maxf(la, lb) + 0.05) / (minf(la, lb) + 0.05)
