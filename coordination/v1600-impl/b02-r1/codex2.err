   189	## 顏色 p 到線段 a–b（RGB 空間）的距離：判斷是不是兩色的混色（反鋸齒）。
   190	static func seg_dist(p: Color, a: Color, b: Color) -> float:
   191		var pv := Vector3(p.r, p.g, p.b)
   192		var av := Vector3(a.r, a.g, a.b)
   193		var bv := Vector3(b.r, b.g, b.b)
   194		var ab := bv - av
   195		var t := 0.0 if ab.length_squared() < 1e-6 else clampf((pv - av).dot(ab) / ab.length_squared(), 0.0, 1.0)
   196		return pv.distance_to(av + ab * t)
   197	
   198	## 一段字是否算大字（WCAG：24px 以上，或粗體 18.66px 以上；以 1280×800 顯示尺寸算）。
   199	static func large_text(size: int, bold: bool) -> bool:
   200		return size >= 24 or (bold and size >= 19)
   201	
   202	## F5：截圖上的文字對比。有足夠描邊的字比「字對描邊」，其他比「字對背景」（半透明字先疊在背景上）。
   203	func _contrast_issues(img: Image) -> Dictionary:
   204		var bad: Array = []
   205		var warn: Array = []
   206		if img == null:
   207			return {"bad": bad, "warn": warn}
   208		var sx := img.get_width() / 1280.0
   209		var sy := img.get_height() / 800.0
   210		for t in probe_texts:
   211			if t.get("field", false) or not t.has("c") or t.get("anim", false):   # 鍵帽字母等符號仍要檢查對比，只有淡出特效字不檢查
   212				continue
   213			var c: Color = t["c"]
   214			var oc: Color = t["oc"]
   215			var size := int(t["size"])
   216			var need := 3.0 if large_text(size, bool(t.get("bold", false))) else 4.5
   217			var outlined: bool = oc.a >= 0.6 and float(t["ow"]) >= float(text_outline_w(size)) * 0.9
   218			var bgc = text_bg(img, t["r"], c, oc, sx, sy)
   219			var dis: bool = bool(t.get("dis", false))
   220			if bgc == null:
   221				(warn if dis else bad).append({"type": "背景未知", "s": t["s"]})   # 背景不可靠一律不算通過
   222				continue
   223			var over := func(fg: Color, bk: Color) -> Color: return Color(fg.r * fg.a + bk.r * (1.0 - fg.a), fg.g * fg.a + bk.g * (1.0 - fg.a), fg.b * fg.a + bk.b * (1.0 - fg.a))
   224			var ceff: Color = over.call(c, bgc)
   225			var ratio := contrast(ceff, bgc)
   226			if outlined:
   227				# 描邊字（裁決 R8）：描邊先疊在背景上、字再疊在描邊上；「字對背景」「描邊對背景」「字對描邊」取最好的
   228				var oeff: Color = over.call(oc, bgc)
   229				ratio = maxf(ratio, maxf(contrast(oeff, bgc), contrast(over.call(c, oeff), oeff)))
   230			# 1.6.0 B02（P2.2）：淺紙面按鈕上的亮字（白、淺灰）靠細描邊「算過」對比，實際糊成一片（異變實驗室、新玩法導覽）。
   231			# 用畫的時候登記的紙面範圍判（取樣器刻意取最壞的背景點，會把字旁的亮邊當背景，誤報太多）
   232			if LayoutRules.paper_white(rel_lum(c), dis, bool(t.get("field", false)), (t.get("gr", t["r"]) as Rect2).get_center(), probe_faces, int(t.get("fz", probe_faces.size()))):
   233				bad.append({"type": "淺紙白字", "s": t["s"], "fg": c.to_html(false), "at": [int(t["r"].position.x), int(t["r"].position.y)]})
   234				continue
   235			if ratio >= need:
   236				continue
   237			var item := {"type": "對比不足", "s": t["s"], "ratio": snappedf(ratio, 0.01), "need": need, "fg": c.to_html(false), "bg": (bgc as Color).to_html(false), "at": [int(t["r"].position.x), int(t["r"].position.y)]}   # 1.4.0：帶字色、取樣背景與位置（查錯用）
   238			if dis:
   239				warn.append(item)   # 只有登記為停用的元件另報（WCAG 豁免停用元件）
   240			else:
   241				bad.append(item)
   242		return {"bad": bad, "warn": warn}
