  1307	## 1.2.0 §1.3：元件庫 2.0 的材質框（9 宮格或平鋪）。kind 見 MAT；回傳有沒有畫（缺圖就退回呼叫端的平塗）。
  1308	func _mat_box(r: Rect2, kind: String, tint := Color.WHITE) -> bool:
  1309		var tx := _ui_tex(MAT[kind])
  1310		if tx == null:
  1311			return false
  1312		tint = qcol(tint)
  1313		var k := "m|%s|%s" % [kind, tint.to_html()]
  1314		var sb: StyleBoxTexture = _sb_cache.get(k)
  1315		if sb == null:
  1316			_sb_room()
  1317			sb = StyleBoxTexture.new()
  1318			sb.texture = tx
  1319			var m: float = MAT_MARGIN.get(kind, 0.0)
  1320			for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
  1321				sb.set_texture_margin(side, m)
  1322			var tile: bool = not MAT_MARGIN.has(kind)
  1323			sb.axis_stretch_horizontal = StyleBoxTexture.AXIS_STRETCH_MODE_TILE if tile else StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
  1324			sb.axis_stretch_vertical = sb.axis_stretch_horizontal
  1325			sb.modulate_color = tint
  1326			_sb_cache[k] = sb
  1327		draw_style_box(sb, r)
  1328		if layout_probe and MAT_MARGIN.has(kind) and minf(r.size.x, r.size.y) >= 20.0:
  1329			var ins: float = MAT_INSET.get(kind, 4.0)   # 毛邊實際寬度（materials.py 的 edge 減 2px 透明）：字不能壓進去
  1330			probe_boxes.append({"r": r, "inner": r.grow(-ins)})
  1331		return true
