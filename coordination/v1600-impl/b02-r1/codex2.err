  1343	## 圓角方塊（StyleBox 快取，不每幀配新物件）。
  1344	## V1.2 B3：夠大、夠不透明的實心方塊改用木紋材質（用 bg 染色），外框線另外畫在上面；小東西與半透明的陰影維持平塗。
  1345	func _box(r: Rect2, bg: Color, border := Color(0, 0, 0, 0), radius := 6.0, bw := 0.0) -> void:
  1346		if bg.a >= 0.6 and minf(r.size.x, r.size.y) >= 20.0 and not bool(Save.s("plain_ui")) and _tex_box(r, "wood", Color(bg.r * 1.28, bg.g * 1.28, bg.b * 1.28, bg.a)):
  1347			if bw > 0.0 and border.a > 0.0:
  1348				_box(r, Color(0, 0, 0, 0), border, radius, bw)
  1349			return
  1350		draw_style_box(_flat_sb(bg, border, radius, bw), r)
  1351		if layout_probe and bg.a >= 0.6 and bg.get_luminance() < 0.35:
  1352			probe_faces.append([r, false])   # 1.6.0 B02：紙上的深色平塗框（數值框、下拉選單）裡白字是對的
  1353	
  1354	## 平塗方塊的樣式（量化後快取；測試可以直接呼叫，不必在繪製階段）。
  1355	func _flat_sb(bg: Color, border: Color, radius: float, bw: float) -> StyleBoxFlat:
  1356		bg = qcol(bg)
  1357		border = qcol(border)
  1358		var k := "%s|%s|%d|%d" % [bg.to_html(), border.to_html(), int(radius), int(bw * 10)]
  1359		var sb: StyleBoxFlat = _sb_cache.get(k)
  1360		if sb == null:
   145				all += 1
   146				var dc := absf(p.r - c.r) + absf(p.g - c.g) + absf(p.b - c.b)
   147				var do := absf(p.r - oc.r) + absf(p.g - oc.g) + absf(p.b - oc.b) if oc.a > 0.0 else 9.0
   148				if dc > 0.30 and do > 0.30:
   149					bg.append(p)
   150				x += step
   151			y += step
   152		if all == 0 or float(bg.size()) / all < 0.15:
   153			# 小字（例如單一數字）字框裡幾乎都是字：改取字框外圍一圈當背景
   154			bg = []
   155			for k in 24:
   156				var a := k * TAU / 24.0
   157				var pp := r.get_center() + Vector2(cos(a) * (r.size.x / 2.0 + 3.0), sin(a) * (r.size.y / 2.0 + 3.0))
   158				var px := clampi(int(pp.x * sx), 0, img.get_width() - 1)
   159				var py := clampi(int(pp.y * sy), 0, img.get_height() - 1)
   160				var p2 := img.get_pixel(px, py)
   161				if absf(p2.r - c.r) + absf(p2.g - c.g) + absf(p2.b - c.b) > 0.30:
   162					bg.append(p2)
   163			if bg.size() < 8:
   164				return null
   165		# 反鋸齒的邊緣像素是字色和背景的混色，不是背景：先用中位數估主背景，排除落在混色線上的像素
   166		var tmp := bg.duplicate()
   167		tmp.sort_custom(func(a, b): return rel_lum(a) < rel_lum(b))
   168		var med: Color = tmp[tmp.size() / 2]
   169		var segs: Array = [[c, med]]
   170		if oc.a > 0.0:
   171			segs.append([oc, med])
   172			segs.append([c, oc])
   173		var keep: Array = []
   174		for p in bg:
   175			var on_blend := false
   176			for sg in segs:
   177				if seg_dist(p, sg[0], sg[1]) < 0.06:
   178					on_blend = true
   179					break
   180			if not on_blend or seg_dist(p, med, med) < 0.06:
   181				keep.append(p)
   182		if keep.size() >= 6:
   183			bg = keep
   184		# 取「最接近字色亮度」那一側的 20% 分位：紙紋、木紋上局部低對比的地方也算進去（Codex v121-impl1：中位數會漏）
   185		var lt := rel_lum(c)
   186		bg.sort_custom(func(a, b): return absf(rel_lum(a) - lt) < absf(rel_lum(b) - lt))
   187		return bg[int(bg.size() * 0.2)]
