+	ok(gs.find("probe_paper.clear()") >= 0 and gs.find("probe_unpaper.clear()") >= 0, "每幀清空紙面登記")
+	var dm: String = FileAccess.get_file_as_string("res://tools/dev_main.gd")
+	ok(dm.find("\"淺紙白字\"") >= 0 and dm.find("for ur in probe_unpaper:") >= 0, "版面檢查有淺紙白字違規、深色小牌除外")
+	var fixes := {
+		"res://scripts/ui/screens/game_menus.gd": "(_ink(Color.WHITE) if pp else Color.WHITE) if on else TXT_DIM",
+		"res://scripts/ui/replay_view.gd": "(_ink(ACCENT) if pp else ACCENT) if can",
+		"res://scripts/ui/screens/game_modes.gd": "(_ink(ACCENT) if pp else ACCENT) if rl_sel.x >= 0",
+		"res://scripts/ui/screens/game_place.gd": "probe_unpaper.append(tr)",
+	}
+	for f in fixes:
+		ok(FileAccess.get_file_as_string(f).find(fixes[f]) >= 0, "%s：紙面字修正在位" % f.get_file())
+	var gv: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_v16.gd")
+	ok(gv.find("_ink_mode = last_btn_paper   # 1.6.0 B02") >= 0 and gv.find("var pp := last_btn_paper   # 1.6.0 B02") >= 0 and gv.find("probe_unpaper.append(tr)   # 朱漆木牌") >= 0, "導覽列、一陣三考卡片用墨字；「新」小牌（朱漆）除外")
+	ok(PAL != null, "色票載入")
diff --git a/game/tools/dev_main.gd b/game/tools/dev_main.gd
index 3c7e092..5adc106 100644
--- a/game/tools/dev_main.gd
+++ b/game/tools/dev_main.gd
@@ -227,6 +227,22 @@ func _contrast_issues(img: Image) -> Dictionary:
 			# 描邊字（裁決 R8）：描邊先疊在背景上、字再疊在描邊上；「字對背景」「描邊對背景」「字對描邊」取最好的
 			var oeff: Color = over.call(oc, bgc)
 			ratio = maxf(ratio, maxf(contrast(oeff, bgc), contrast(over.call(c, oeff), oeff)))
+		# 1.6.0 B02（P2.2）：淺紙面按鈕上的亮字（白、淺灰）靠細描邊「算過」對比，實際糊成一片（異變實驗室、新玩法導覽）。
+		# 用畫的時候登記的紙面範圍判（取樣器刻意取最壞的背景點，會把字旁的亮邊當背景，誤報太多）
+		if rel_lum(c) > 0.45 and not dis and not t.get("field", false):
+			var gc: Vector2 = (t.get("gr", t["r"]) as Rect2).get_center()
+			var on_paper := false
+			for pr in probe_paper:
+				if (pr as Rect2).has_point(gc):
+					on_paper = true
+					break
+			for ur in probe_unpaper:
+				if (ur as Rect2).has_point(gc):
+					on_paper = false
+					break
+			if on_paper:
+				bad.append({"type": "淺紙白字", "s": t["s"], "fg": c.to_html(false), "at": [int(t["r"].position.x), int(t["r"].position.y)]})
+				continue
 		if ratio >= need:
 			continue
 		var item := {"type": "對比不足", "s": t["s"], "ratio": snappedf(ratio, 0.01), "need": need, "fg": c.to_html(false), "bg": (bgc as Color).to_html(false), "at": [int(t["r"].position.x), int(t["r"].position.y)]}   # 1.4.0：帶字色、取樣背景與位置（查錯用）
