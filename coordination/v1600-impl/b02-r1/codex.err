## 宣告「接下來畫的字在這個格子裡」（R11）：非按鈕的格子（價錢小方塊、徽章、分頁字）用。
func probe_cell_begin(face: Rect2) -> void:
	_probe_face = face
	_probe_cell_seq += 1
	_probe_cell_id = "cell%d" % _probe_cell_seq

func probe_cell_end() -> void:
	_probe_face = Rect2()
	_probe_cell_id = ""

func _text(p: Vector2, s: String, size: int, c: Color, center := false, bold := false, maxw := 0.0, outline := Color(0, 0, 0, -1)) -> void:
	if _ink_mode:
		c = Color(_ink(c), c.a) if _ink_keep_a else _ink(c)
	elif outline.a < 0.0 and not (size >= 24 or (bold and size >= 19)) and c.s >= 0.25 and not (c.get_luminance() < 0.35 and c.s < 0.8):   # 深色低彩度的浮雕字不動
		c = Color(_legible(Color(c, 1.0)), c.a)   # V1.2.1 F5：深描邊上的彩色小字自動提亮到 4.5:1
	if maxw > 0.0:
		size = fit(s, size, maxw, bold)
	var lines := wrap_lines(s, size, maxw, bold) if maxw > 0.0 else s.split("\n")
	for i in lines.size():
		var fnt := _font_for(lines[i], size, bold)
		var w := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x if center else 0.0
		var q := p + Vector2(-w / 2, i * size * line_h(lines.size()) + size * 0.85)
		if mag_on and _probe_ui and size < 26 and c.a > 0.3:
			var mw := w if center else fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
			if Rect2(q.x, q.y - size * 0.95, mw, size * 1.2).grow(4.0 if bool(get("pad_mode")) else 0.0).has_point(mag_point()):
				mag_hit = [lines[i], size, bold]
		var oc := Color(INK, c.a * 0.85) if outline.a < 0.0 else outline
		# V1.2：深色、低彩度的「墨色字」（印在紙或布條上）不描深邊，改淺色浮雕；先決定樣式再登記探針（Codex v120-impl2）
		var emboss := outline.a < 0.0 and (_ink_mode or (c.get_luminance() < 0.35 and c.s < 0.8))
		if emboss:
			oc = Color(0, 0, 0, 0)
		var ow := text_outline_w(size)
		var sh := text_shadow_dy(size)
		# 版面探針（第五輪補洞）：介面層與戰場層都量、低透明度（>0.05）也量；戰場字標 field
		# V1.2 A3：外框算進描邊外擴（左右上各半個描邊、下方再加陰影位移），換字與換框才不會靜靜爆框
		if layout_probe and c.a > 0.05 and lines[i].strip_edges() != "":
			var ww := fnt.get_string_size(lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size).x
			var ex := ow * 0.5 if oc.a > 0.0 else 0.0
			# 直向：原本的框（1.1 倍字高）已經留了上下各約 0.05 字高的空，描邊與陰影只算超出的部分
			var ey := maxf(0.0, ex - size * 0.05)
			var eb := maxf(0.0, ey + (sh if oc.a > 0.0 else 0.0) - size * 0.05)
			probe_texts.append({"r": Rect2(q.x - ex, q.y - size * 0.85 - ey, ww + ex * 2.0, size * 1.1 + ey + eb), "size": size, "s": lines[i], "field": not _probe_ui, "a": c.a, "btn": _probe_btn_label, "own": _probe_btn_rect,
				"c": c, "oc": oc, "ow": ow if oc.a > 0.0 else 0.0, "bold": bold, "glyph": _probe_glyph, "anim": _probe_anim, "dis": _probe_dis,
				"gr": Rect2(q.x, q.y - size * 0.80, ww, size * 0.98),
				"face": _probe_face if _probe_face.size.x > 0.0 else null, "cell": _probe_cell_id, "ink": Rect2(q + ink_line(fnt, lines[i], size).position, ink_line(fnt, lines[i], size).size)})   # V1.2.1：字形框（不含描邊外擴、陰影與行距），九宮格內距用   # V1.2.1 F5：對比檢查要實際字色與描邊
		if emboss:
			draw_string(fnt, q + Vector2(0, 1), lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, Color(1.0, 0.96, 0.86, 0.45 * c.a))
		if oc.a > 0.0:
			# V1.2 A3：先畫柔和的下方陰影，再畫深焦茶描邊（取代純黑），最後正文
			draw_string_outline(fnt, q + Vector2(0, sh), lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, ow, Color(INK_SHADOW, oc.a * 0.55))
			draw_string_outline(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, ow, oc)
		draw_string(fnt, q, lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, size, c)


## V1.2 A3：描邊依字級減薄（小字描太粗會糊）、陰影位移依字級（純函式，測試與探針共用）。
## V1.2：木製框（九宮格、四角銅釘、中間透明），面板、戰場、大廳沙盤預覽共用。grow＝往外擴多少。
func _wood_frame(r: Rect2, grow := 8.0, key := "frame") -> void:
	var fx := _ui_tex(TEX_FRAME)
	if fx == null or bool(Save.s("plain_ui")):
		return
	var sb: StyleBoxTexture = _sb_cache.get(key)
	if sb == null:
		sb = StyleBoxTexture.new()
		sb.texture = fx
		for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
			sb.set_texture_margin(side, 22.0)
		sb.draw_center = false
		_sb_cache[key] = sb
	draw_style_box(sb, r.grow(grow))

## 材質方塊：kind＝wood（染色）／groove（染色）／paper（原色）。沒有貼圖時退回平塗。
func _tex_box(r: Rect2, kind: String, tint := Color.WHITE) -> bool:
	if bool(Save.s("plain_ui")):
		# 1.2.0（Codex cat02 #8）：簡化介面一律退回平塗（同位置、同內距探針），不貼材質
		var flat: Color = {"wood": TH_WOOD, "groove": Color(0.12, 0.09, 0.07), "paper": Color("#efe4cc")}[kind]
		draw_rect(r, Color(flat.r * tint.r, flat.g * tint.g, flat.b * tint.b, tint.a))
		if layout_probe and minf(r.size.x, r.size.y) >= 20.0:
			var ins0: Array = {"wood": [3.0, 3.0, 3.0, 4.0], "paper": [5.0, 5.0, 5.0, 5.0], "groove": [3.0, 3.0, 3.0, 3.0]}[kind]
			probe_boxes.append({"r": r, "inner": r.grow_individual(-ins0[0], -ins0[1], -ins0[2], -ins0[3])})
		return true
	var path: String = {"wood": TEX_WOOD, "groove": TEX_GROOVE, "paper": TEX_PAPER}[kind]
	var tx := _ui_tex(path)
	if tx == null:
		return false
	tint = qcol(tint)   # V1.2.1 F1：量化後當鍵，淡出時不會每幀多一個樣式
	var k := "t|%s|%s" % [kind, tint.to_html()]
	var sb: StyleBoxTexture = _sb_cache.get(k)
	if sb == null:
		_sb_room()
		sb = StyleBoxTexture.new()
		sb.texture = tx
		var m := 10.0 if kind != "paper" else 14.0
		sb.texture_margin_left = m
		sb.texture_margin_right = m
		sb.texture_margin_top = m
		sb.texture_margin_bottom = m
		# 羊皮紙整張拉伸（紋理不能無縫平鋪，平鋪會出現直條接縫）；木紋、凹槽平鋪保持紋理比例
		var mode := StyleBoxTexture.AXIS_STRETCH_MODE_STRETCH if kind == "paper" else StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
		sb.axis_stretch_horizontal = mode
		sb.axis_stretch_vertical = mode
		sb.modulate_color = tint
		_sb_cache[k] = sb
	draw_style_box(sb, r)
	if layout_probe and minf(r.size.x, r.size.y) >= 20.0:
		# V1.2.1 F1：登記材質的內容內距（gen_ui_tex.py 的實際斜邊：木紋上 3／下 4／左右 3，紙 5，凹槽 3），字不能壓進去
		var ins: Array = {"wood": [3.0, 3.0, 3.0, 4.0], "paper": [5.0, 5.0, 5.0, 5.0], "groove": [3.0, 3.0, 3.0, 3.0]}[kind]
		probe_boxes.append({"r": r, "inner": r.grow_individual(-ins[0], -ins[1], -ins[2], -ins[3])})
	return true

## 1.2.0 §1.3：元件庫 2.0 的材質框（9 宮格或平鋪）。kind 見 MAT；回傳有沒有畫（缺圖就退回呼叫端的平塗）。
func _mat_box(r: Rect2, kind: String, tint := Color.WHITE) -> bool:
	var tx := _ui_tex(MAT[kind])
	if tx == null:
		return false
	tint = qcol(tint)
	var k := "m|%s|%s" % [kind, tint.to_html()]
	var sb: StyleBoxTexture = _sb_cache.get(k)
	if sb == null:
		_sb_room()
		sb = StyleBoxTexture.new()
		sb.texture = tx
		var m: float = MAT_MARGIN.get(kind, 0.0)
		for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
			sb.set_texture_margin(side, m)
		var tile: bool = not MAT_MARGIN.has(kind)
		sb.axis_stretch_horizontal = StyleBoxTexture.AXIS_STRETCH_MODE_TILE if tile else StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
		sb.axis_stretch_vertical = sb.axis_stretch_horizontal
		sb.modulate_color = tint
		_sb_cache[k] = sb
	draw_style_box(sb, r)
	if layout_probe and MAT_MARGIN.has(kind) and minf(r.size.x, r.size.y) >= 20.0:
		var ins: float = MAT_INSET.get(kind, 4.0)   # 毛邊實際寬度（materials.py 的 edge 減 2px 透明）：字不能壓進去
		probe_boxes.append({"r": r, "inner": r.grow(-ins)})
	return true

## V1.2.1 F1：樣式快取的顏色量化（透明度 16 級、RGB 8 位元），鍵和實際樣式用同一個值。
static func qcol(c: Color) -> Color:
	return Color(roundf(c.r * 255.0) / 255.0, roundf(c.g * 255.0) / 255.0, roundf(c.b * 255.0) / 255.0, roundf(clampf(c.a, 0.0, 1.0) * 15.0) / 15.0)

const SB_CACHE_MAX := 512
## 快取滿了整個清掉（用到再建；每個樣式只是幾個欄位，重建很便宜）。
func _sb_room() -> void:
	if _sb_cache.size() >= SB_CACHE_MAX:
		_sb_cache.clear()

## 圓角方塊（StyleBox 快取，不每幀配新物件）。
## V1.2 B3：夠大、夠不透明的實心方塊改用木紋材質（用 bg 染色），外框線另外畫在上面；小東西與半透明的陰影維持平塗。
func _box(r: Rect2, bg: Color, border := Color(0, 0, 0, 0), radius := 6.0, bw := 0.0) -> void:
	if bg.a >= 0.6 and minf(r.size.x, r.size.y) >= 20.0 and not bool(Save.s("plain_ui")) and _tex_box(r, "wood", Color(bg.r * 1.28, bg.g * 1.28, bg.b * 1.28, bg.a)):
		if bw > 0.0 and border.a > 0.0:
			_box(r, Color(0, 0, 0, 0), border, radius, bw)
		"clock":   # 暫停＝棋鐘：上緣兩顆黃銅按鈕
			for fx in [0.3, 0.7]:
				var bc := Vector2(r.position.x + r.size.x * fx, r.position.y - 4)
				draw_rect(Rect2(bc - Vector2(14, 6), Vector2(28, 10)), brass_d)
				draw_rect(Rect2(bc - Vector2(12, 5), Vector2(24, 6)), brass)

func _panel(r: Rect2) -> void:
	probe_panel(r)
	_dim(0.62)
	_box(Rect2(r.position + Vector2(5, 7), r.size).grow(4), Color(DIM_INK, 0.45), Color(0, 0, 0, 0), 14.0)      # 陰影（1.2.0：光源左上 → 影子往右下）
	_box(r, PANEL, Color(0, 0, 0, 0), 10.0)
	if not bool(Save.s("plain_ui")):
		_mat_box(r.grow(-6), "walnut", Color(0.62, 0.6, 0.58))   # 1.2.0 §2：面板底是胡桃木紋（壓暗，字照樣看得清）
	# V1.2 B3：深木外框＋四角銅釘（九宮格貼圖）；沒有貼圖時退回舊的細框
	var fx := _ui_tex(TEX_FRAME)
	if fx != null and not bool(Save.s("plain_ui")):
		var sb: StyleBoxTexture = _sb_cache.get("frame")
		if sb == null:
			sb = StyleBoxTexture.new()
			sb.texture = fx
			for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
				sb.set_texture_margin(side, 22.0)
			sb.draw_center = false
			_sb_cache["frame"] = sb
		draw_style_box(sb, r.grow(8))
	else:
		_box(r, Color(0, 0, 0, 0), TH_EDGE, 10.0, 3.0)
	if panel_obj != "" and not bool(Save.s("plain_ui")):
		_obj_deco(r, panel_obj)
		if layout_probe:
			probe_decos.append({"id": "obj_%s" % panel_obj, "kind": "obj", "r": obj_extent(r, panel_obj), "host_r": r, "edge": "screen"})   # 1.3.0：器物裝飾不能出畫面（Codex cat08 #3）
		obj_open_r = r
		obj_open_kind = panel_obj


func _open(name: String) -> void:
	if overlay.begins_with("hub_"):
		nav_stack.append(overlay)   # 卡片面板開著時直接開下一頁（例如結果頁「試煉」）：記得回面板
	overlay = name
	_focus = 0

## V1.5.1 返回目的地：打開下一層之前記下「從哪來」，返回鈕、Esc、手把 B 都走 _nav_back（使用者回報：返回都跳回主畫面）。
## 卡片面板（hub）畫出來時清空堆疊；開戰也清空。nav_hub＝最後經過的卡片面板，打完回標題時重新打開它。
var nav_stack: Array = []
var nav_hub := ""

var nav_focus := {}   # V1.0.0：卡片面板 → 上次點的那張卡（返回時焦點回原卡）
func _nav_push(from: String) -> void:
	nav_stack.append(from)

func _nav_back(fallback := "") -> void:
	var res := L.t("sb_win") if w == 0 else (L.t("sb_lose") if w == 1 else L.t("sb_draw"))
	var title := "%s　%s" % [Time.get_date_string_from_system(), res]
	var marks: Array = _key_marks() if not report.is_empty() else []
	var note := L.t("sb_note_none") if marks.is_empty() else L.t("sb_note", [str(marks[marks.size() - 1]["label"])])
	Save.data["songbook"] = SB.add(Save.data.get("songbook", []), code, title, note, int(Time.get_unix_time_from_system()))
	if Save.save_data():
		_toast(L.t("sb_added"))
	else:
		_toast(L.t("save_failed"), true)
	overlay = "songbook"
	_focus = 0

func _draw_songbook() -> void:
	_boss_note("songbook", "songbook")   # 1.2.0 §12.2：這個系統第一次出現時一張便條
	_dim(0.6)
	var book: Array = Save.data.get("songbook", [])
	var rowh := 12.0 + tz("B") * 1.3 + tz("S") * 1.3 + 12.0
	var P := modal_rect(760, 12.0 + h1_help_h(L.t("sb_help", [SB.MAX]), tz("S"), 680) + GAP_L + maxf(1.0, book.size()) * (rowh + 8.0) + GAP_L + 44.0 + GAP_L)
	_panel(P)
	var y := _h1_help(Vector2(640, P.position.y + 12), L.t("sb_title"), L.t("sb_help", [SB.MAX]), tz("S"), 680) + GAP_L
	if book.is_empty():
		_text(Vector2(640, y + 10), L.t("sb_empty"), tz("S"), Color(1, 1, 1, 0.88), true, false, 680)   # Antigravity cat08 #4：空狀態要讀得到
	for i in book.size():
		var e: Dictionary = book[i]
		var r := Rect2(P.position.x + 30, y, P.size.x - 60, rowh)
		# Antigravity cat08 #3：每筆是一張夾在冊子裡的紙頁（墨字），不是深色資料列
		var paper_ok: bool = not bool(Save.s("plain_ui")) and _tex_box(r, "paper")
		if not paper_ok:
			draw_rect(r, Color(0, 0, 0, 0.18))
		_ink_mode = paper_ok
		_text(r.position + Vector2(14, 10), str(e["n"]), tz("B"), INK if paper_ok else Color.WHITE, false, true, r.size.x - 270)
		_text(r.position + Vector2(14, 10 + tz("B") * 1.3), str(e["note"]), tz("S"), INK if paper_ok else TXT_DIM, false, false, r.size.x - 270)
		_ink_mode = false
		var c := str(e["c"])
		var idx := i
		_btn(Rect2(r.end.x - 244, r.position.y + (rowh - 44.0) / 2.0, 120, 44), L.t("sb_watch"), func(): overlay = ""; _watch_code_str(c))
		_btn(Rect2(r.end.x - 116, r.position.y + (rowh - 44.0) / 2.0, 104, 44), L.t("sb_del"), func(): Save.data["songbook"] = SB.remove(Save.data.get("songbook", []), idx); Save.save_data())
		y += rowh + 8.0
	_btn(Rect2(560, P.end.y - GAP_L - 44.0, 160, 44), L.t("back"), func(): overlay = "")

## 1.3.0 §2 精華：最多三段、去重、終局排最後；不足兩個獨立事件只出一段（director_rules.pick_reel）。
func _highlights() -> Array:
	var marks: Array = _key_marks() if not report.is_empty() else []
	var ft := maxi(0, int(sim.tick) - 30) if (sim != null and sim.winner >= 0) else -1
	var out: Array = DirR.pick_reel(marks, ft)
	for m in out:
		if bool(m.get("final", false)):
			m["label"] = "%s %ds" % [L.t("sh_final"), int(sim.tick) / 20]
	return out

func _hl_reel_go(hl: Array) -> void:
	var ts: Array = []
	for m in hl:
		ts.append(int(m["t"]))
	overlay = ""
	call("_replay")
	hl_reel = ts
	_hl_seg(0)

func _hl_go(t: int) -> void:
	overlay = ""
	call("_replay")
	call("_seek_async", maxi(0, t - 20))

func _draw_share() -> void:
	_dim(0.6)
extends "res://scripts/ui/game_screens.gd"
const LayoutRules = preload("res://scripts/ui/layout_rules.gd")
## V1.5.2：自己畫框、不用 _panel 的覆蓋層（漏登記守衛的已知例外）：AI 思考中只畫轉圈
const PANELLESS_OVERLAYS := ["ai_busy"]
## V1.5.2 漏登記守衛：每個覆蓋層必須登記到的角色（有標題緞帶的要有 1 條緞帶＋1 個面板；彈窗至少 1 個面板）。
## 由各覆蓋層的繪圖函式靜態整理；之後新增覆蓋層要加進來，否則守衛只會要求面板。
const DECK_CAP := 0.7
const DECK_MIN_PX := 9.0
const OVERLAY_RIBBON := ["trials", "puzzle_hint", "puzzle_plan", "profile", "nemeses", "paint", "hub_play", "hub_gauntlet", "hub_challenge", "hub_collect", "first_run", "restore", "clear_data", "ghosts", "ga_info", "weekly", "relay", "playroom", "wager", "draft", "reward", "ban", "codes", "gauntlet_resume", "wave_codes", "tutorial", "puzzles", "lobby", "settings", "keys", "credits", "gauntlet_pick", "codex", "review", "demo_end", "share", "rush_end", "coach", "rift", "notebook", "daily_top", "editor", "trio", "trio_result", "coop_hand", "tour", "nb_cmp", "rift_lab", "rush_menu", "coop_sum", "fb_cat", "nb_words", "daily_past", "songbook", "campaign"]
const OVERLAY_PANEL := ["postcard", "pause_menu", "confirm", "fs_confirm", "leave", "slots"]
## 開發工具入口（第七輪 H3，原 scripts/ui/main.gd）：自動截圖、版面報告、商店膠囊圖、實機影片、效能與記憶體量測。
## 匯出設定排除 tools/，所以出貨版沒有這些；從專案路徑帶對應參數啟動時由 scripts/ui/main.gd 換成這一支。


## 商店膠囊圖（N6）：用目前視窗大小構圖——先畫標題帶，再把兩軍放在標題下方對衝，中間有分界線與對射的箭。
## 只有遊戲標題文字（Steam 規定）。手感輪（收尾批）調整：標題帶不壓角色、中央不留白、小尺寸放大標題與角色、兩側留邊。
func _draw_capsule() -> void:
	# 膠囊圖（第三輪 M1）：左藍右紅 15° 斜切＋中央裂縫與對撞星芒、兩邊各 3 隻放大的角色、標題金邊立體投影。
	var vs := get_viewport_rect().size
	var tall := vs.y > vs.x
	var tiny := get_window().size.y < 300
	var blue := Color("#1b3b6f")
	var red := Color("#6f1d2b")
	var mid := vs.x / 2
	var slant := tan(deg_to_rad(15.0)) * vs.y / 2
	draw_rect(Rect2(Vector2.ZERO, vs), red)
	draw_colored_polygon(PackedVector2Array([Vector2(0, 0), Vector2(mid + slant, 0), Vector2(mid - slant, vs.y), Vector2(0, vs.y)]), blue)
	# 速度線
	for k in 14:
		var yy := vs.y * (0.08 + k * 0.066)
		var ln := vs.x * (0.12 + 0.06 * (k % 3))
		draw_line(Vector2(vs.x * 0.02, yy), Vector2(vs.x * 0.02 + ln, yy), Color(1, 1, 1, 0.07), maxf(2.0, vs.y * 0.006), true)
		draw_line(Vector2(vs.x * 0.98 - ln, yy + vs.y * 0.03), Vector2(vs.x * 0.98, yy + vs.y * 0.03), Color(1, 1, 1, 0.07), maxf(2.0, vs.y * 0.006), true)
	# 標題帶
	var big := int(vs.y * (0.11 if tall else (0.30 if tiny else 0.19)))
	var band_y := vs.y * (0.04 if tall else 0.03)
	# 中央裂縫（鋸齒）：從標題帶下方開始，不穿過字（Antigravity S7）
	var crack := PackedVector2Array()
	var cy0 := band_y + big * 1.12 + int(big * 0.34) * 1.3
	for k in 9:
		var t := k / 8.0
		var yy2 := lerpf(cy0, vs.y, t)
		var x := lerpf(mid + slant, mid - slant, yy2 / vs.y) + (8.0 if k % 2 == 0 else -8.0) * vs.y / 430.0
		crack.append(Vector2(x, yy2))
	draw_polyline(crack, Color(1, 0.95, 0.75, 0.9), maxf(3.0, vs.y * 0.012), true)
	var tt: String = L.t("title")
	var tw := font_bold.get_string_size(tt, HORIZONTAL_ALIGNMENT_LEFT, -1, big).x
	var tp := Vector2(mid - tw / 2, band_y + big * 0.9)
	var dep := maxf(3.0, big * 0.06)
	for d in 4:
		draw_string(font_bold, tp + Vector2(1, 1) * dep * (d + 1) / 4.0, tt, HORIZONTAL_ALIGNMENT_LEFT, -1, big, Color(0.12, 0.05, 0.02, 0.95))
	draw_string_outline(font_bold, tp, tt, HORIZONTAL_ALIGNMENT_LEFT, -1, big, int(maxf(6.0, big * 0.12)), Color("#3a2205"))
	draw_string_outline(font_bold, tp, tt, HORIZONTAL_ALIGNMENT_LEFT, -1, big, int(maxf(3.0, big * 0.06)), Color("#d4a017"))
	draw_string(font_bold, tp, tt, HORIZONTAL_ALIGNMENT_LEFT, -1, big, Color("#ffe8a3"))
	var sub := int(big * (0.42 if tiny else 0.30))
	_text(Vector2(mid, band_y + big * 1.12), "No Take-Backs", sub, Color(1, 1, 1, 0.97), true, true)
	# 角色：兩邊各 3 隻，前排最大、最靠中線
	var top := band_y + big * 1.12 + sub * 1.4
	var bottom := vs.y * 0.97
	var sc := (bottom - top) / (70.0 if tiny else 95.0)
	if tall:
		sc = minf(sc, vs.x / 118.0)
	var left := [[D.ARCHER, 0.13, 0.80], [D.CAVALRY, 0.27, 0.92], [D.SWORD, 0.40, 1.0]]
	var right := [[D.ASSASSIN, 0.87, 0.80], [D.SHIELD, 0.73, 0.92], [D.SWORD, 0.60, 1.0]]
	if tall:
		# 直式：每邊兩隻、放大，後排的往上放，填滿中段
		left = [[D.CAVALRY, 0.14, 0.74], [D.SWORD, 0.29, 1.0]]
		right = [[D.ASSASSIN, 0.86, 0.74], [D.SWORD, 0.71, 1.0]]
	if tiny:
		left = [[D.CAVALRY, 0.22, 0.95], [D.SWORD, 0.40, 1.0]]
		right = [[D.SHIELD, 0.78, 0.95], [D.SWORD, 0.60, 1.0]]
	var items: Array = []
	for it in left:
		items.append([it, 0])
	for it in right:
		items.append([it, 1])
	for e in items:
		var it: Array = e[0]
		var team: int = e[1]
		var k: float = it[2]
		var s2 := sc * k
		var p := Vector2(vs.x * float(it[1]), bottom - (1.0 - k) * (bottom - top) * 0.55)
		var face := 1.0 if team == 0 else -1.0
		Art.ring(self, p, team, it[0], false, s2)
		var mood := Art.M_SPARKLE if it[0] == D.CAVALRY else Art.M_BROWS
		var at := 0.42 if k >= 0.99 else (0.25 if it[0] == D.ARCHER else 0.0)
		Art.unit(self, p, it[0], team, face, 0.0, at, 0.0, 1.0, 1.3, s2, false, mood, 0.2 if it[0] == D.CAVALRY else 0.0)
	# 中央對撞星芒
	var cc := Vector2(mid, bottom - (22.0 if tall else 30.0) * sc)   # 星芒在前排兩隻的武器交會處
	var r0 := minf(45.0 * vs.y / 430.0, (11.0 if tall else 16.0) * sc) * (0.7 if tiny else 1.0)
	for layer in 2:
		var pts := PackedVector2Array()
		var rr := r0 * (1.0 - layer * 0.45)
		for i in 24:
			var an := i * TAU / 24.0
			pts.append(cc + Vector2(cos(an), sin(an)) * (rr if i % 2 == 0 else rr * 0.42))
		draw_colored_polygon(pts, Color(1, 0.9, 0.5, 0.95) if layer == 0 else Color.WHITE)
func _capture_capsule() -> void:
	await get_tree().process_frame
	await get_tree().process_frame
