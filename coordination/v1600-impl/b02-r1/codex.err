 ## V1.1 E2：新測試只要登記在 FILES；ORDER 只保留舊執行順序，沒列到的依 FILES 順序接在後面。
 const ORDER := ["test_cat_pull", "test_modes_v9", "test_flows_v9", "test_v10_fixes", "test_v10_input", "test_v10_feel", "test_v10_demo", "test_unit_brief", "test_no_unlock", "test_cmd_sim", "test_cmd_ui", "test_star_solutions", "test_trial_rules_valid", "test_maps_v9", "test_maps_mirror_v9", "test_gait_v9", "test_gait_driver_v9", "test_army_rules", "test_turn_placement", "test_determinism_and_mirror", "test_termination", "test_traits", "test_rule_fixes", "test_suspense", "test_codes_and_snake", "test_rally", "test_nav_r1", "test_puzzle_solutions", "test_codex", "test_event_routes", "test_ui_consumers", "test_sfx_priority", "test_save_migration", "test_play_effects", "test_input_queue", "test_golden", "test_crowd_readability", "test_replay_tools", "test_counter_lib", "test_seek_clutch", "test_clutch_effects", "test_new_units", "test_roster_ui", "test_rules_v5", "test_sandbox_v5", "test_battle_code_v5", "test_rules_e2e_v5", "test_lobby_reopen_v5", "test_free_v6", "test_free_skip_v6", "test_review_free_v6", "test_to_free_keeps_units_v6", "test_free_review_fixes_v6", "test_save_v7", "test_harness_v7", "test_code_fuzz_v7", "test_keymap_v7", "test_replay_back_v7", "test_steam_v7", "test_fantasy_legacy_v8", "test_fantasy_rules_v8", "test_fantasy_regress_v8", "test_fantasy_mirror_v8", "test_fantasy_codes_v8", "test_fantasy_game_v8", "test_fantasy_codex_text_matches_stats"]
diff --git a/game/tests/suites/ui.gd b/game/tests/suites/ui.gd
index 42eb520..57afd33 100644
--- a/game/tests/suites/ui.gd
+++ b/game/tests/suites/ui.gd
@@ -2672,3 +2672,27 @@ func test_lobby_fold_r14_v150() -> void:
 	ok(lv.find("L.t(\"lb_reset\")") < 0, "「重置回標準」拿掉（和頂緣「標準」紙籤同一件事）")
 	ok(lv.find("\"cmd_params\")") >= 0 and lv.find("btn_group = \"sb_params\"") >= 0, "所選物件的參數條＝一個控制")
 	ok(lv.find("LOBBY_TABS[lobby_tab] == \"lb_tab_cmd\" and lobby_r.cmd_on") >= 0, "折頁豁免只剩軍令頁開啟時")
+
+## 1.6.0 B02（P2.2）：紙面字色規則＋偵測——淺紙面按鈕上的亮字由版面檢查擋下（偵測器靠畫的時候登記的紙面範圍）
+func test_paper_ink_v1600() -> void:
+	var UB = load("res://scripts/ui/ui_base.gd")
+	var PAL = load("res://scripts/ui/palette.gd")
+	for c in [Color.WHITE, Color("#f0c040"), Color(1, 0.75, 0.7)]:
+		ok(UB._ink(c).get_luminance() < 0.45, "紙上墨色：%s 壓成深色" % c.to_html(false))
+	var ub: String = FileAccess.get_file_as_string("res://scripts/ui/ui_base.gd")
+	ok(ub.find("if layout_probe and last_btn_paper:") >= 0 and ub.find("probe_paper.append(hit)") >= 0, "紙面按鈕在探針模式登記範圍")
+	var gs: String = FileAccess.get_file_as_string("res://scripts/ui/game_screens.gd")
+	ok(gs.find("probe_paper.clear()") >= 0 and gs.find("probe_unpaper.clear()") >= 0, "每幀清空紙面登記")
+	var dm: String = FileAccess.get_file_as_string("res://tools/dev_main.gd")
+	ok(dm.find("\"淺紙白字\"") >= 0 and dm.find("for ur in probe_unpaper:") >= 0, "版面檢查有淺紙白字違規、深色小牌除外")
+	var fixes := {
+		"res://scripts/ui/screens/game_menus.gd": "(_ink(Color.WHITE) if pp else Color.WHITE) if on else TXT_DIM",
+		"res://scripts/ui/replay_view.gd": "(_ink(ACCENT) if pp else ACCENT) if can",
+		"res://scripts/ui/screens/game_modes.gd": "(_ink(ACCENT) if pp else ACCENT) if rl_sel.x >= 0",
+		"res://scripts/ui/screens/game_place.gd": "probe_unpaper.append(tr)",
+	}
+	for f in fixes:
+		ok(FileAccess.get_file_as_string(f).find(fixes[f]) >= 0, "%s：紙面字修正在位" % f.get_file())
+	var gv: String = FileAccess.get_file_as_string("res://scripts/ui/screens/game_v16.gd")
+	ok(gv.find("_ink_mode = last_btn_paper   # 1.6.0 B02") >= 0 and gv.find("var pp := last_btn_paper   # 1.6.0 B02") >= 0 and gv.find("probe_unpaper.append(tr)   # 朱漆木牌") >= 0, "導覽列、一陣三考卡片用墨字；「新」小牌（朱漆）除外")
+	ok(PAL != null, "色票載入")
diff --git a/game/tools/dev_main.gd b/game/tools/dev_main.gd
index 3c7e092..5adc106 100644
--- a/game/tools/dev_main.gd
+++ b/game/tools/dev_main.gd
@@ -227,6 +227,22 @@ func _contrast_issues(img: Image) -> Dictionary:
 			# 描邊字（裁決 R8）：描邊先疊在背景上、字再疊在描邊上；「字對背景」「描邊對背景」「字對描邊」取最好的
 			var oeff: Color = over.call(oc, bgc)
 			ratio = maxf(ratio, maxf(contrast(oeff, bgc), contrast(over.call(c, oeff), oeff)))
+		# 1.6.0 B02（P2.2）：淺紙面按鈕上的亮字（白、淺灰）靠細描邊「算過」對比，實際糊成一片（異變實驗室、新玩法導覽）。
+		# 用畫的時候登記的紙面範圍判（取樣器刻意取最壞的背景點，會把字旁的亮邊當背景，誤報太多）
+		if rel_lum(c) > 0.45 and not dis and not t.get("field", false):
+			var gc: Vector2 = (t.get("gr", t["r"]) as Rect2).get_center()
+			var on_paper := false
+			for pr in probe_paper:
+				if (pr as Rect2).has_point(gc):
+					on_paper = true
+					break
+			for ur in probe_unpaper:
+				if (ur as Rect2).has_point(gc):
+					on_paper = false
+					break
+			if on_paper:
+				bad.append({"type": "淺紙白字", "s": t["s"], "fg": c.to_html(false), "at": [int(t["r"].position.x), int(t["r"].position.y)]})
+				continue
 		if ratio >= need:
 			continue
 		var item := {"type": "對比不足", "s": t["s"], "ratio": snappedf(ratio, 0.01), "need": need, "fg": c.to_html(false), "bg": (bgc as Color).to_html(false), "at": [int(t["r"].position.x), int(t["r"].position.y)]}   # 1.4.0：帶字色、取樣背景與位置（查錯用）

