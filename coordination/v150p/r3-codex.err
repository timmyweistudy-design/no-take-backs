## V1.1 D2：每日挑戰＋每週突變。純函式，不碰畫面（遊戲、測試共用）。
## 不改模擬：只用現有規則參數（預算、隻數、每種上限、卡池、地圖、縱深、局長、雙方手動技能）＋AI 用固定種子組敵陣。
## 日期用 UTC 日數，跨時區同一天同一題。紀錄鍵＝日數＋VER：AI 或這份產生器一改就升 VER（測試 test_daily_v11 釘住幾天的敵陣，改了會紅）。

const VER := 1
const MUTATORS := 8
const KEEP_DAYS := 10          # 存檔只留最近幾天的最佳紀錄
const CMD = preload("res://scripts/core/cmd_defs.gd")
const Presets = preload("res://scripts/game/presets.gd")
const MapDefs = preload("res://scripts/core/map_defs.gd")
const AI = preload("res://scripts/core/ai_army.gd")

static func today() -> int:
	return int(Time.get_unix_time_from_system()) / 86400

## 這一天的題目規格。mut＝這週的突變（每 7 天換一個），map／style 每天換。
static func spec(day: int) -> Dictionary:
	var mut := posmod(day / 7, MUTATORS)
	var map_id := 3 if mut == 3 else posmod(day * 5 + 1, 6)
	return {"day": day, "key": "%d-v%d" % [day, VER], "mut": mut, "map": map_id, "style": posmod(day * 7 + 3, 5),
		"level": 1, "seed": 90000 + posmod(day * 2654435761, 1000003)}

static func pool_of(types: Array) -> int:
	var p := 0
	for t in types:
		p |= 1 << int(t)
	return p

## 把突變套到一組（已經是自由部署、單局的）規則上。r＝RuleSet。
static func apply(r, sp: Dictionary) -> void:
	r.map_id = int(sp["map"])
	r.map_size = 1
	r.ai_style = int(sp["style"])
	r.ai_level = int(sp["level"])
	r.ai_pool_same = false
	r.rounds = 1
	r.preset = "custom"
	var kingdom := (1 << 10) - 1
	var fantasy := ((1 << 20) - 1) & ~kingdom
	var pool := kingdom
	match int(sp["mut"]):
		0:   # 貼臉肉搏：近戰卡池、最深縱深、60 秒
			pool = pool_of([0, 1, 3, 4, 5, 7, 8, 9])
			r.depth = 7500
			r.ticks = 1200
		1:   # 精兵演武：只能 8 隻、每種 1 隻、高預算
			r.unit_cap = 8
			r.type_cap = 1
			r.budget = [140, 140]
		2:   # 人海戰術：40 隻、只有便宜的兵
			pool = pool_of([0, 1, 2, 5, 8])
			r.unit_cap = 40
		3:   # 禁魔死鬥：冰原、不開技能（map 已在 spec 固定）
			pass
		4:   # 百家爭鳴：每種 1 隻、預算 150
			r.type_cap = 1
			r.budget = [150, 150]
		5:   # 閃電決戰：60 秒、雙方技能全開（護盾、戰吼、隕石）
			r.ticks = 1200
			var m5 := (1 << CMD.AEGIS) | (1 << CMD.WARCRY) | (1 << CMD.METEOR)
			r.cmd_mask = [m5, m5]
		6:   # 孤軍深入：最深縱深、低預算、每種最多 2 隻
			r.depth = 7500
			r.budget = [70, 70]
			r.type_cap = 2
		7:   # 神仙打架：奇幻卡池、高預算、隻數少、技能全開
			pool = fantasy
			r.budget = [150, 150]
			r.unit_cap = 12
			var m7 := (1 << CMD.AEGIS) | (1 << CMD.HEAL) | (1 << CMD.METEOR)
			r.cmd_mask = [m7, m7]
	r.pool = [pool, pool]

## 成績比較：剩餘戰力高的好，一樣就花得少的好。rec＝[剩餘%, 花費]。
extends RefCounted
## 1.2.0 §11.8 名局棋譜本：把重播碼（對戰代碼）收成冊，最多 MAX 筆（新的在前，滿了丟最舊的）。
## 每筆 {"c": 代碼, "n": 標題（日期＋結果）, "note": 老闆批註（這場的關鍵時刻）, "t": 收進來的時間}。純資料。
const MAX := 6
const CODE_MAX := 6000

static func add(book: Array, code: String, title: String, note: String, now: int) -> Array:
	var out: Array = []
	for e in book:
		if e is Dictionary and str(e.get("c", "")) != code:
			out.append(e)
	out.push_front({"c": code, "n": title.left(80), "note": note.left(120), "t": now})
	return out.slice(0, MAX)

static func remove(book: Array, i: int) -> Array:
	var out := book.duplicate(true)
	if i >= 0 and i < out.size():
		out.remove_at(i)
	return out

## 存檔讀進來時逐筆驗型（壞的丟掉）
static func sanitize(raw) -> Array:
	var out: Array = []
	if not raw is Array:
		return out
	for e in raw:
		if out.size() >= MAX:
			break
		if e is Dictionary and e.get("c") is String and str(e["c"]).length() <= CODE_MAX and str(e["c"]) != "":
			out.append({"c": str(e["c"]), "n": str(e.get("n", "")).left(80), "note": str(e.get("note", "")).left(120), "t": int(e.get("t", 0)) if (e.get("t") is int or e.get("t") is float) else 0})
	return out
