	20: [HOP, 11.0, 0.0, 0.0, 0.0, 2.5, 0.0],      # 小史萊姆
	21: [BIPED, 13.0, 2.5, 0.10, 0.30, 0.0, 4.0],  # 骷髏：喀喀搖擺
