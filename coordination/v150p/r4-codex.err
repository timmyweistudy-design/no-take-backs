## 1.1.0 A19：圖集有界快取的量測。依序模擬「每場帶不同新兵」：每輪要求 3 種奇幻兵（含召喚物）＋轉身出手格，
## 記每輪後的貼圖記憶體與烘焙期間最長一幀；全部 12 種奇幻兵輪過兩次（第二次會丟舊頁），看峰值有沒有被頁數上限壓住。
func _perf_atlas_sweep() -> Dictionary:
	if sprites == null:
		return {}
	var fan: Array = range(D.COUNT, 22)
	var rounds: Array = []
	var peak := 0.0
	var worst_frame := 0.0
	for rep in 2:
		for i in range(0, fan.size(), 3):
			var want: Array = fan.slice(i, i + 3)
			var t0 := Time.get_ticks_msec()
			sprites.ensure(want)
			sprites.ensure_turn_atk(want)
			var last := Time.get_ticks_usec()
			var longest := 0.0
			var guard := 0
			while (sprites._busy or sprites._ta_busy) and guard < 600:
				guard += 1
				await RenderingServer.frame_post_draw
				var now := Time.get_ticks_usec()
				longest = maxf(longest, (now - last) / 1000.0)
				last = now
			var mem := Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED) / 1048576.0
			peak = maxf(peak, mem)
			worst_frame = maxf(worst_frame, longest)
			rounds.append({"types": want, "ms": Time.get_ticks_msec() - t0, "tex_mib": snappedf(mem, 0.1), "longest_frame_ms": snappedf(longest, 0.1),
				"pages": sprites.pages.filter(func(p): return p != null).size(), "ta": sprites.ta_tex.size()})
	return {"peak_tex_mib": snappedf(peak, 0.1), "worst_bake_frame_ms": snappedf(worst_frame, 0.1), "max_pages": sprites.MAX_PAGES, "ta_max": sprites.TA_MAX, "rounds": rounds}

## 繪圖效能量測（第二輪 R2、第三輪 T3）：
## ・啟動時間（引擎啟動到量測開始）、色盲切換的圖集重建時間
## ・48 隻（每邊 24，量測專用的 160 金預算，五兵種混合）打完整場，展示速度 4 倍（約 25 秒內走到狂熱與結束）
## ・每幀的 draw／process／GPU／整幀時間：全場、非狂熱、狂熱分開統計，含 p99；記錄硬體、引擎版本、commit（--perf-commit=）
## 用法：<exe> --path game --resolution 1280x800 -- --perf=<輸出 json 絕對路徑> [--perf-commit=<hash>]
func _run_perf() -> void:
	var boot_ms := Time.get_ticks_msec()
	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)   # V1.1：量效能時視窗移到畫面外（不打擾、也不是最小化，照常繪圖）
	DisplayServer.window_set_position(Vector2i(-4000, -4000))
	await get_tree().process_frame
	var waited := 0
	while sprites != null and not sprites.is_ready(cbm()) and waited < 240:
		await get_tree().process_frame
		waited += 1
	var ready_ms := Time.get_ticks_msec()
	# 色盲切換：圖集重建要多久
	Save.settings["colorblind"] = true
	var t_cb := Time.get_ticks_msec()
	_rebuild_sprites()
	waited = 0
	while sprites != null and not sprites.is_ready(true) and waited < 240:
		await get_tree().process_frame
		waited += 1
	var cb_ms := Time.get_ticks_msec() - t_cb
	Save.settings["colorblind"] = shot_state.has("cb")
	_rebuild_sprites()
	waited = 0
	while sprites != null and not sprites.is_ready(false) and waited < 240:
		await get_tree().process_frame
		waited += 1
	var vp := get_viewport().get_viewport_rid()
	RenderingServer.viewport_set_measure_render_time(vp, true)
	var a0 := Army.new(0, 160)
	var spec := [D.SHIELD, D.SWORD, D.ARCHER, D.CAVALRY, D.ASSASSIN, D.ARCHER, D.SWORD, D.ARCHER]
	for r in 9:
		for c in 6:
			if a0.count() < 24:
				var t: int = spec[(r * 6 + c) % spec.size()]
				if D.cost(t) <= a0.left():
					a0.place(t, 5 - c, r)
	var a1 = a0.mirrored()
	mode = Mode.VS_AI
	_begin_battle(a0, a1, "replay")   # 量測不寫進度
	speed = 4.0
	var rows: Array = []   # [draw, proc, gpu, frame, frenzy]
	var units_start: int = view.alive_count(0) + view.alive_count(1)
	var last := Time.get_ticks_usec()
	var guard := 0
	while state == St.BATTLE and guard < 40000:
		guard += 1
		await RenderingServer.frame_post_draw
		var now := Time.get_ticks_usec()
		rows.append([perf_draw_us / 1000.0, perf_proc_us / 1000.0, RenderingServer.viewport_get_measured_render_time_gpu(vp), (now - last) / 1000.0, view.frenzy])
		last = now
	var pick := func(col: int, which: int) -> Array:
		var o: Array = []
		for r2 in rows:
			if which == 0 or (which == 1 and not r2[4]) or (which == 2 and r2[4]):
				o.append(r2[col])
		return o
	var sect := func(which: int) -> Dictionary:
		return {"frames": pick.call(0, which).size(), "draw_ms": _pstats(pick.call(0, which)), "process_ms": _pstats(pick.call(1, which)),
			"gpu_ms": _pstats(pick.call(2, which)), "frame_ms": _pstats(pick.call(3, which))}
	var tex_battle := snappedf(Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED) / 1048576.0, 0.1)   # 對戰時（掃圖集之前）
	var atlas := await _perf_atlas_sweep()
	var commit := ""
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--perf-commit="):
			commit = a.substr(14)
	var out := {
		"hardware": {"cpu": OS.get_processor_name(), "cores": OS.get_processor_count(), "gpu": RenderingServer.get_video_adapter_name(),
			"os": OS.get_name(), "engine": Engine.get_version_info()["string"], "resolution": str(get_viewport().get_visible_rect().size)},
		"mem_static_mib": snappedf(Performance.get_monitor(Performance.MEMORY_STATIC) / 1048576.0, 0.1), "mem_static_max_mib": snappedf(Performance.get_monitor(Performance.MEMORY_STATIC_MAX) / 1048576.0, 0.1),
		"tex_mem_mib": tex_battle,   # V1.3.1：資源驗收（方案 §0）；1.1.0：取對戰時的值，圖集掃描的峰值另記在 atlas_sweep
		"commit": commit, "boot_ms": ready_ms, "boot_to_measure_ms": boot_ms, "colorblind_rebuild_ms": cb_ms,
		"units_start": units_start, "display_speed": 4.0, "battle_ticks": sim.tick, "reached_frenzy": sim.tick >= Sim.FRENZY_TICK,
		"all": sect.call(0), "normal": sect.call(1), "frenzy": sect.call(2), "atlas_sweep": atlas,
		"note": "frame_ms 受垂直同步限制（約 16.7）；實際成本看 draw＋process＋gpu。展示速度 4 倍時每幀處理的模擬 tick 比正常多，屬於偏嚴的量法"}
	var f := FileAccess.open(perf_path, FileAccess.WRITE)
	f.store_string(JSON.stringify(out, "  "))
	f.close()
	print("PERF ", JSON.stringify(out))
	get_tree().quit()

func _pstats(a: Array) -> Dictionary:
	var b := a.duplicate()
	b.sort()
	if b.is_empty():
		return {}
	return {"p50": snappedf(b[b.size() / 2], 0.01), "p95": snappedf(b[int(b.size() * 0.95)], 0.01), "p99": snappedf(b[mini(b.size() - 1, int(b.size() * 0.99))], 0.01), "max": snappedf(b[-1], 0.01)}


## 動作／表情樣品（R5 截圖驗證用）：每個兵種一列：待機、前搖、揮擊、後搖、受擊、狂熱、專屬（衝鋒／潛行／頂住）、勝利。
var anim_gallery := false
extends SceneTree
## 角色圖集檢查（第七輪 C0）：要真的繪圖，不能 headless。
## "<Godot win exe>" --path <game> --script res://tools/atlas_check.gd -- --out=<輸出資料夾（Windows 路徑）>
## 產出：contact.png（全部兵種、兩隊的待機＋攻擊姿勢）、silhouette.png（塗黑剪影）、gray.png（灰階）、atlas.json：
##  clipped：有幾格碰到格子邊界（超框）；team_ratio：隊伍色占不透明像素比例；iou_max：和其他兵種的剪影最大重疊；
##  繪圖基準 cell 160px。ok＝沒有超框。
const SC = preload("res://scripts/ui/sprite_cache.gd")
const Art = preload("res://scripts/ui/art.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const F8 = preload("res://scripts/core/fantasy_defs.gd")
var out := "."
var cache
var cb_frames := 0

func _initialize() -> void:
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--out="):
			out = a.substr(6)
	cache = SC.new()
	root.add_child(cache)
	_run.call_deferred()

func _r(ty: int, tm: int, f: int) -> Rect2i:
	var r: Rect2 = cache._rect(int(cache.loc[ty][1]) + tm * SC.FRAMES_PER + f)
	return Rect2i(r)

func _img(ty: int) -> Image:
	var pn: int = cache.loc[ty][0]
	if not _imgs.has(pn):
		_imgs[pn] = cache.pages[pn]["tex"].get_image()
	return _imgs[pn]

var _imgs := {}

func _run() -> void:
	await cache.build(false)
	var everything: Array = []
	for t0 in F8.DRAW_TOTAL:
		everything.append(t0)
	await cache.ensure(everything)
	while cache._busy:
		await process_frame
	var per: int = SC.FRAMES_PER
	var N: int = F8.DRAW_TOTAL
	var res := {"types": [], "ok": true}
	var masks := []
	var contact := Image.create(SC.CELL * 6, SC.CELL * N, false, Image.FORMAT_RGBA8)
	var sil := Image.create(SC.CELL * N, SC.CELL, false, Image.FORMAT_RGBA8)
	var gray := Image.create(SC.CELL * 2, SC.CELL * N, false, Image.FORMAT_RGBA8)
	contact.fill(Color("#5c7a3a"))
	sil.fill(Color.WHITE)
	gray.fill(Color("#777777"))
	for ty in N:
		var clipped := 0
		for tm in 2:
			for f in per:
				var img: Image = _img(ty)
				var r := _r(ty, tm, f)
				for k in SC.CELL:
					if img.get_pixelv(r.position + Vector2i(k, 0)).a > 0.2 or img.get_pixelv(r.position + Vector2i(k, SC.CELL - 1)).a > 0.2 or img.get_pixelv(r.position + Vector2i(0, k)).a > 0.2 or img.get_pixelv(r.position + Vector2i(SC.CELL - 1, k)).a > 0.2:
						clipped += 1
						break
		var ratio := []
		for tm2 in 2:
			var tc: Color = Art.team_color(tm2)
			var r2 := _r(ty, tm2, 0)
			var opaque := 0
			var team := 0
			for y in SC.CELL:
				for x in SC.CELL:
					var c := _img(ty).get_pixelv(r2.position + Vector2i(x, y))
					if c.a < 0.5:
						continue
					opaque += 1
					var dh := absf(c.h - tc.h)
					dh = minf(dh, 1.0 - dh)
					if dh < 0.05 and c.s > 0.3 and c.v > 0.3:
						team += 1
			ratio.append(snappedf(float(team) / maxf(1.0, opaque), 0.001))
		var mask := PackedByteArray()
		mask.resize(SC.CELL * SC.CELL)
		var r3 := _r(ty, 0, 0)
		for y2 in SC.CELL:
			for x2 in SC.CELL:
				var on: bool = _img(ty).get_pixelv(r3.position + Vector2i(x2, y2)).a > 0.5
				mask[y2 * SC.CELL + x2] = 1 if on else 0
				if on:
					sil.set_pixel(ty * SC.CELL + x2, y2, Color.BLACK)
		masks.append(mask)
		for col in 6:
			var tmc: int = col % 2
			var fr: int = [0, 0, 12 + 3, 12 + 3, 20 + 3, 20 + 3][col]
			contact.blend_rect(_img(ty), _r(ty, tmc, fr), Vector2i(col * SC.CELL, ty * SC.CELL))
		for tm3 in 2:
			var r4 := _r(ty, tm3, 0)
			for y3 in SC.CELL:
				for x3 in SC.CELL:
					var c3 := _img(ty).get_pixelv(r4.position + Vector2i(x3, y3))
					if c3.a > 0.5:
						gray.set_pixel(tm3 * SC.CELL + x3, ty * SC.CELL + y3, Color(c3.get_luminance(), c3.get_luminance(), c3.get_luminance()))
func _draft_new() -> void:
	var r := RandomNumberGenerator.new()
	r.randomize()
	if shot_dir != "" and bool(get("shot_fixed")):
		r.seed = 20261111   # 1.2.0 §14.6：視覺回歸模式固定（同一份程式重拍要一致）
	var ids: Array = range(10)
	df_pool = []
	while df_pool.size() < 8:
		var k: int = ids[r.randi() % ids.size()]
		ids.erase(k)
		df_pool.append(k)
	df_pool.sort()
	df_mine = []
	df_ai = []
	overlay = "draft"

func _draft_take(t: int) -> void:
	if t in df_mine or t in df_ai or df_mine.size() >= 4:
		return
	df_mine.append(t)
	# AI 抽：剩下的裡面最貴的戰鬥兵優先（簡單、可預期）
	var best := -1
	for x in df_pool:
		if x in df_mine or x in df_ai:
			continue
		if best < 0 or D.cost(int(x)) > D.cost(best):
			best = int(x)
	if best >= 0 and df_ai.size() < 4:
		df_ai.append(best)

static func draft_mask(list: Array) -> int:
	return PlayroomRules.draft_mask(list)   # 1.1.0 A22：純邏輯搬到 scripts/game/playroom_rules.gd

func _draft_go() -> void:
	var r = RuleSet.standard()
	var m0 := draft_mask(df_mine)
	var m1 := draft_mask(df_ai)
	if not RuleSet.has_combat(m0) or not RuleSet.has_combat(m1):
		_toast(L.t("df_no_combat"), true)
		return
	r.pool = [m0, m1]
	r.ai_pool_same = false   # 電腦用自己抽到的牌（Codex v140-i2）
	r.rounds = 1
	rules = r
	challenge_army = null
	overlay = ""
	_start_mode(Mode.VS_AI)

func _draw_draft() -> void:
	_dim(0.6)
const SwapDuel = preload("res://scripts/game/swap_duel.gd")
var swap_on := false
var sw_pts := [0, 0]    # 玩家 A、B 的分數（剩餘戰力百分比合計）
var sw_dead := [0, 0]   # 玩家 A、B 兩局合計倒下數

func _swap_start() -> void:
	var r = RuleSet.standard()
	var dm: int = RS.mask(_demo())
	r.pool = [int(r.pool_of(0)) & dm, int(r.pool_of(1)) & dm]   # 標準卡池再扣掉試玩版沒有的兵（Codex cat10 #5）
	r.rounds = 3   # 用三戰兩勝的局數上限，實際由換邊雙局在第 2 局結束
	rules = r
	challenge_army = null
	overlay = ""
	_start_mode(Mode.DUEL)
	swap_on = true
	sw_pts = [0, 0]
	sw_dead = [0, 0]
	_toast(L.t("sw_intro"))

## 每局正式打完（_finish_battle）：記分；第 2 局後系列結束
func _swap_settle() -> void:
	if not swap_on or mode != Mode.DUEL or play_kind != "official" or sim == null:
		return
	var r: Array = SwapDuel.settle(sw_pts, sw_dead, round_no, sim)
	sw_pts = r[0]
	sw_dead = r[1]
	series_over = round_no >= SwapDuel.ROUNDS

## 擺陣頂部：誰是哪一色（第 2 局換過來）
func _swap_who() -> String:
	return L.t("sw_who", [L.t("blue") if SwapDuel.owner(round_no, 0) == 0 else L.t("red"), L.t("red") if SwapDuel.owner(round_no, 0) == 0 else L.t("blue")])

## 結果頁第一條事實
func _swap_fact() -> String:
	if not series_over:
		return L.t("sw_round", [int(sw_pts[0]), int(sw_pts[1])])
	var v := SwapDuel.verdict(sw_pts, sw_dead)
	return L.t("sw_final", [int(sw_pts[0]), int(sw_pts[1]), L.t("sw_a") if v == 0 else (L.t("sw_b") if v == 1 else L.t("sw_tie"))])

extends RefCounted
## 1.1.0 A22：遊戲間（賭局、輪抽、車輪戰、週賽）的純邏輯，從 game_playroom.gd 搬出來（畫面腳本留同名包裝，呼叫端不變）。
## 只放不碰畫面、存檔、節點的函式；UI 分派與繼承鏈不動。

const WG_NARROW := 34   # 觀戰競猜：剩餘 < 34% 算險勝
const WG_CRUSH := 67    # ≥ 67% 算碾壓

static func wager_band(rem: int) -> int:
	return 0 if rem < WG_NARROW else (1 if rem < WG_CRUSH else 2)

static func draft_mask(list: Array) -> int:
	var m := 0
	for t in list:
		m |= 1 << int(t)
	return m

static func wave_code(codes: Array) -> String:
	var b := Marshalls.utf8_to_base64(JSON.stringify({"v": 1, "w": codes}))
	return "NTW1.%s.%s" % [b, b.sha256_text().substr(0, 6)]

static func wave_decode(c: String) -> Array:
	var parts := c.strip_edges().split(".")
	if c.length() > 60000 or parts.size() != 3 or parts[0] != "NTW1" or parts[1].sha256_text().substr(0, 6) != parts[2]:
		return []
	var d = JSON.parse_string(Marshalls.base64_to_utf8(parts[1]))
	if not d is Dictionary or not d.get("w") is Array:
		return []
	var w: Array = d["w"]
	if w.is_empty() or w.size() > 3:
		return []
	for x in w:
		if not x is String or not str(x).get_slice(".", 0) in ["NTB2", "NTB3", "NTB4", "NTB7"]:
			return []
	return w

static func wave_has_lock(units: Array, lock: Array) -> bool:
	for u in lock:
		var hit := false
		for v in units:
			if v.has("col") and int(v["col"]) == int(u["col"]) and int(v["row"]) == int(u["row"]) and int(v["type"]) == int(u["type"]):
				hit = true
				break
		if not hit:
			return false
	return true

static func week_no(unix: int) -> int:
	return int(floor((unix / 86400.0 - 4.0) / 7.0))

