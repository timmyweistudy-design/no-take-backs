   650	func _input(ev: InputEvent) -> void:
   651		if ev is InputEventMouseMotion:
   652			mouse = ev.position
   653			pad_mode = false
   654			hover_card = _card_at(mouse)
   655			_enqueue("paint", mouse)   # 一律排入，由執行端判斷有沒有在塗兵（同一幀按下再拖過也不漏格，Codex S3）
   656			return
   657		if ev is InputEventMouseButton:
   658			mouse = ev.position
   659			if overlay == "codex" and ev.pressed and (ev.button_index == MOUSE_BUTTON_WHEEL_UP or ev.button_index == MOUSE_BUTTON_WHEEL_DOWN):
   660				_scroll_at(mouse, -48.0 if ev.button_index == MOUSE_BUTTON_WHEEL_UP else 48.0)   # 圖鑑捲動（第三輪 U1）
   661				return
   662			_enqueue("mb", {"i": ev.button_index, "pressed": ev.pressed, "pos": ev.position})
   663			return
   664		if ev is InputEventKey and ev.pressed:
   665			if not ev.echo or ev.keycode in [KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT]:
   666				_enqueue("key", ev.keycode)
   667			return
   668		if ev is InputEventJoypadButton and ev.pressed:
   669			pad_mode = true
   670			var map := {JOY_BUTTON_DPAD_UP: KEY_UP, JOY_BUTTON_DPAD_DOWN: KEY_DOWN, JOY_BUTTON_DPAD_LEFT: KEY_LEFT,
   671				JOY_BUTTON_DPAD_RIGHT: KEY_RIGHT, JOY_BUTTON_A: KEY_ENTER, JOY_BUTTON_B: KEY_ESCAPE, JOY_BUTTON_X: KEY_BACKSPACE,
   672				JOY_BUTTON_START: KEY_SPACE, JOY_BUTTON_Y: KEY_TAB, JOY_BUTTON_LEFT_SHOULDER: KEY_Q, JOY_BUTTON_RIGHT_SHOULDER: KEY_E,
   673				JOY_BUTTON_BACK: KEY_F1}
   674			if map.has(ev.button_index):
   675				_enqueue("key", map[ev.button_index])
   676			return
   677		if ev is InputEventJoypadMotion and ev.axis == JOY_AXIS_RIGHT_Y and overlay == "codex" and absf(ev.axis_value) > 0.3:
   678			pad_mode = true
   679			_scroll_by("left", ev.axis_value * 24.0)   # 右搖桿捲圖鑑左欄
   680			return
