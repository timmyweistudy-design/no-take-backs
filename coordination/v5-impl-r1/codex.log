    20		var s = Sim.new(d["a0"], d["a1"])
    21		s.fast = true
    22		s.run_to_end()
    23		return {"ok": true, "w": s.winner, "t": s.tick, "fp": s.fingerprint, "p0": s.power(0), "p1": s.power(1)}
