   137	# ───────── 數值調整 ─────────
   138	static func _step_in(v: int, opts: Array, d: int) -> int:
   139		var i := opts.find(v)
   140		if i < 0:
   141			i = 0
   142		return opts[clampi(i + d, 0, opts.size() - 1)]
