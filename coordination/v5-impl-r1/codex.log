   107	static func momentum(ui, rect: Rect2, log2: PackedInt64Array, b0: int, b1: int, marks: Array, total_ticks := 0) -> Array:
   108		var cb: bool = ui.cbm()
   109		var n := log2.size() / 2
   110		var mid := rect.position.y + rect.size.y / 2
   111		ui.draw_rect(rect, Color(0, 0, 0, 0.25))
   112		ui.draw_line(Vector2(rect.position.x, mid), Vector2(rect.end.x, mid), Color(1, 1, 1, 0.35), 1.0)
   113		if n <= 1:
   114			return []
   115		var span := maxi(n, total_ticks)
   116		var cols := int(minf(rect.size.x, 240.0))
   117		var ys: Array = []
   118		var last := 0.5
   119		for k in cols + 1:
   120			var t := mini(n - 1, int(float(k) / cols * (span - 1)))
   121			if float(k) / cols * (span - 1) > n - 1:
   122				break
   123			var p0 := float(log2[2 * t]) / maxf(1.0, b0)
