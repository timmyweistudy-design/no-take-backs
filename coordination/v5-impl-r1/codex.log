    60	## 跳到某個 tick：同一組陣型從頭快轉（確定性模擬，結果一定一樣），畫面與音效狀態清空重建。
    61	func _seek(target: int) -> void:
    62		var armies2: Array = rv_last if play_kind == "review" and not rv_last.is_empty() else last_armies
    63		sim = Sim.new(armies2[0].copy(), armies2[1].copy(), battle_rules)
    64		ev_count = {}
    65		var keep_ct := -1   # 最後時刻在第幾 tick 觸發：快轉時用同一個條件重算，不靠先前的播放紀錄（Codex S7 #2）
    66		battle_marks.clear()
    67		var stop := maxi(0, target - ViewBuffer.DELAY)
    68		while sim.tick < stop and not sim.finished:
    69			sim.step()
    70			for ev in sim.events:   # 快轉時也要累計戰報次數與時間軸標記（Codex S5 #4：共用同一個收集函式）
    71				if ev.has("src"):
    72					var s = sim.unit_by_id(ev["src"])
    73					var key := "%s%d" % [ev["kind"], s.team]
    74					ev_count[key] = int(ev_count.get(key, 0)) + 1
    75				_collect_mark(ev, sim, sim.tick)
    76			if keep_ct < 0 and not sim.finished and clutch_cond(sim):
    77				keep_ct = sim.tick
    78		var had_clutch := keep_ct >= 0
    79		view = ViewBuffer.new(sim)
    80		prev_pos.clear()
    81		for u in view.units:
    82			prev_pos[u.id] = Vector2(u.x, u.y)
    83		fx.clear()
    84		dying.clear()
    85		graves.clear()
    86		atk_hit.clear()
    87		atk_seq.clear()
    88		atk_t.clear()
    89		hurt_t.clear()
    90		hurt_dir.clear()
    91		brace_t.clear()
    92		accum = 0.0
    93		result_delay = 0.0
    94		clutch_t = 0.0
    95		slow_left = 0.0
    96		hitstop = 0.0
    97		# 演出狀態依目標時間重建（Codex S5 #5）：最後時刻是否已發生、是否已進狂熱、音樂
    98		slow_used = had_clutch
    99		clutch_tick = keep_ct if had_clutch else -1
   100		if had_clutch:
   101			battle_marks.append({"tick": keep_ct, "kind": "clutch", "team": -1})
   102		_pump_view()
   103		# 畫面推到剛好第 target tick（原本停在 target−DELAY）
   104		while view.tick < target and not view.finished:
   105			_sim_step(false)
   106		frenzy_seen = view.frenzy
   107		if sfx != null:
   108			sfx.play_music("music_frenzy" if view.frenzy else "music_battle")
