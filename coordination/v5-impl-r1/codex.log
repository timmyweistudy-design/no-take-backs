  1065			total = 1000 * 1000
  1066			lg = PackedInt64Array()
  1067			for t in power_log2.size() / 2:
  1068				lg.append(power_log2[2 * t] * 1000 / budgets[0] - power_log2[2 * t + 1] * 1000 / budgets[1])
