  1500					bits.append("%s×%d" % [L.t("unit_%d" % t), gone[t]])
  1501				removed_banner = L.t("removed_by_rules", ["、".join(bits)])
  1502				removed_banner_t = 4.0
  1503			return ""
  1504		var tmp := Army.new(armies[0].team, armies[0].budget)
  1505		var why := tmp.load_code(code)
  1506		if why != "":
  1507			return why
  1508		for u in tmp.units:
  1509			if not _allowed(int(u["type"])):
