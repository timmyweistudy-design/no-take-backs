   189	## 跟原本比改了幾隻（換兵種、移位、拿掉、新增都算一隻）。
   190	static func review_changes(orig, now) -> int:
   191		var a := {}
   192		var b := {}
   193		for u in orig.units:
   194			a["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   195		for u in now.units:
   196			b["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
   197		var gone := 0
   198		var added := 0
   199		for k in a:
   200			if not b.has(k) or b[k] != a[k]:
   201				gone += 1
   202		for k in b:
   203			if not a.has(k) or a[k] != b[k]:
   204				added += 1
   205		return maxi(gone, added)
   206	
   207	func _rv_try(edit: Callable) -> void:
   208		var before = rv_army.copy()
   209		edit.call()
   210		if review_changes(rv_orig, rv_army) > 1:
   211			rv_army = before
   212			_toast(L.t("rv_one"), true)
   213			return
   214		rv_result = {}
   215	
   216	func _rv_cell(c: Vector2i) -> void:
   217		if rv_sel.x >= 0 and rv_army.index_at(rv_sel.x, rv_sel.y) != -1 and rv_army.index_at(c.x, c.y) == -1:
   218			var from := rv_sel
   219			_rv_try(func(): rv_army.move(from.x, from.y, c.x, c.y))
   220			rv_sel = c
   221			return
   222		rv_sel = c
   223	
   224	func _rv_set_type(t: int) -> void:
   225		if rv_sel.x < 0:
   226			return
   227		# 在副本上換，買不起或不合法就保留原兵並提示（Codex S5 #3：原本會變成直接刪兵）
   228		var c := rv_sel
   229		var trial = rv_army.copy()
   230		trial.remove_at(c.x, c.y)
   231		if t >= 0:
   232			var why: String = trial.check_place(t, c.x, c.y)
   233			if why != "":
   234				_toast(L.t("rv_cant", [L.t("unit_%d" % t)]), true)
   235				return
   236			trial.place(t, c.x, c.y)
   237		if review_changes(rv_orig, trial) > 1:
   238			_toast(L.t("rv_one"), true)
   239			return
   240		rv_army = trial
   241		rv_result = {}
   242	
   243	## 改了什麼（給畫面顯示）：例如「弓箭手 → 劍士（第 3 列第 5 欄）」
   244	func review_desc() -> String:
   245		for u in rv_orig.units:
   246			var i: int = rv_army.index_at(u["col"], u["row"])
   247			if i == -1:
   248				# 被移走或拿掉
   249				for v in rv_army.units:
   250					if rv_orig.index_at(v["col"], v["row"]) == -1 and int(v["type"]) == int(u["type"]):
   251						return L.t("rv_moved", [L.t("unit_%d" % int(u["type"])), int(u["row"]) + 1, int(u["col"]) + 1, int(v["row"]) + 1, int(v["col"]) + 1])
   252				return L.t("rv_removed", [L.t("unit_%d" % int(u["type"])), int(u["row"]) + 1, int(u["col"]) + 1])
   253			if int(rv_army.units[i]["type"]) != int(u["type"]):
   254				return L.t("rv_swapped", [L.t("unit_%d" % int(u["type"])), L.t("unit_%d" % int(rv_army.units[i]["type"])), int(u["row"]) + 1, int(u["col"]) + 1])
