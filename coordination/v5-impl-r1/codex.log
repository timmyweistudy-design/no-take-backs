  1090				var lead: int = lg[t] * sign
  1091				if lead < lock_thr:
  1092					lock_t = t + 1
  1093				if -lead > swing:
  1094					swing = -lead
  1095		var ratio := lock_t * 1000 / maxi(1, lg.size())
