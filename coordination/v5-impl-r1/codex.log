    33	static func _read(path: String, defaults: Dictionary) -> Dictionary:
    34		var out := defaults.duplicate(true)
    35		for p in [path, path + ".bak"]:
    36			if not FileAccess.file_exists(p):
    37				continue
    38			var txt := FileAccess.get_file_as_string(p)
    39			var parsed = JSON.parse_string(txt)
    40			if typeof(parsed) == TYPE_DICTIONARY:
    41				for k in parsed:
    42					out[k] = parsed[k]
    43				return out
    44		return out
    45	
    46	## 逐版遷移（純函式，測試用）：舊進度一律保留；不認得的欄位也保留（新版遊戲寫的存檔被舊版讀到時不會被刪掉）。
    47	## 比目前新的版本：原樣回傳，不降版。
    48	static func migrate(d: Dictionary) -> Dictionary:
    49		var out := d.duplicate(true)
    50		var v := int(out.get("schema_version", out.get("version", 1)))
    51		if v > SAVE_VERSION:
    52			return out
    53		if v < 2:
    54			# 1 → 2：欄位名 version 改成 schema_version；加 unit_wins
    55			out.erase("version")
    56			v = 2
    57		if v < 3:
    58			# 2 → 3：解鎖改看獨立的累計場數，初值＝原本的正式場數（已解鎖的兵不會被收回）
    59			var st = out.get("stats", {})
    60			out["unlock_games"] = int(st.get("games", 0)) if st is Dictionary else 0
    61			v = 3
    62		if not out.get("unit_wins", {}) is Dictionary:
    63			out["unit_wins"] = {}
    64		# 我的預設：逐筆驗型、限長、最多 5 組（Codex 第一輪）
    65		var ps: Array = []
    66		var raw = out.get("rule_presets", [])
    67		if raw is Array:
    68			for e in raw:
    69				if e is Dictionary and e.get("name") is String and e.get("code") is String and str(e["code"]).length() <= 2000 and ps.size() < MAX_PRESETS:
    70					ps.append({"name": str(e["name"]).substr(0, 24), "code": str(e["code"])})
    71		out["rule_presets"] = ps
    72		if not out.get("last_rules", {}) is Dictionary:
    73			out["last_rules"] = {}
    74		if not out.get("custom_stats", {}) is Dictionary:
    75			out["custom_stats"] = {"wins": 0, "games": 0}
    76		for k in DEFAULT_SAVE:
    77			if not out.has(k):
    78				out[k] = DEFAULT_SAVE[k].duplicate(true) if DEFAULT_SAVE[k] is Dictionary or DEFAULT_SAVE[k] is Array else DEFAULT_SAVE[k]
    79		out["schema_version"] = v
    80		return out
