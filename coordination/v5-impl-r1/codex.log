  1070		var lock_thr := total * 20 / 100
  1071		var changes := 0
  1072		var side := 0
  1073		for t in range(100, lg.size()):
  1074			var d: int = lg[t]
  1075			var s := 0
  1076			if d > thr:
  1077				s = 1
  1078			elif d < -thr:
