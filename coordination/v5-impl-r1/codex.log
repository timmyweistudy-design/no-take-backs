    70	
    71	func hand_cap() -> int:
    72		if rules != null:
    73			var cap: int = rules.turn_cap(current)
    74			if rules.carry and is_snake():
    75				return cap * (hands_done[current] + 1) - (armies[current].spent() - spent_this_turn)
    76			return cap
    77		if rule == "cap10":
    78			return 10
    79		if rule == "snake5c":
    80			# 第 k 手最多花到累計 20×k；以「這一手開始前」的花費計算，這一手的花費由 turn_left 扣
    81			return 20 * (hands_done[current] + 1) - (armies[current].spent() - spent_this_turn)
    82		return 20
    83	
    84	func turn_left() -> int:
    85		return mini(hand_cap() - spent_this_turn, armies[current].left())
    86	
    87	func check_place(t: int, col: int, row: int) -> String:
    88		if done():
    89			return "擺放已結束"
    90		if D.cost(t) > hand_cap() - spent_this_turn:
    91			return "這一手最多花 %d 金" % hand_cap()
    92		var a = armies[current]
    93		# 第五輪防卡死：輪流落子的最後一手還沒有戰鬥兵，就只能擺戰鬥兵
    94		if rules != null and is_snake() and a.guard_combat and not a.has_combat() and D.is_support(t) and hands_done[current] >= hands_max() - 1:
    95			return "最後一手要擺戰鬥兵"
    96		return a.check_place(t, col, row)
    97	
    98	func place(t: int, col: int, row: int) -> bool:
    99		if check_place(t, col, row) != "":
   100			return false
   101		armies[current].place(t, col, row)
   102		commands.append({"team": current, "type": t, "col": col, "row": row, "turn": turn_index})
   103		spent_this_turn += D.cost(t)
   104		placed_this_turn += 1
   105		if turn_left() < _min_cost() or not armies[current].can_afford_any():
   106			end_turn()
   107		return true
   108	
   109	func can_end_turn() -> bool:
   110		return placed_this_turn > 0 or turn_left() < _min_cost()
   111	
   112	## 結束這一手。還沒擺任何兵、又買得起時不能結束（買得起就不能跳過）。
   113	func end_turn() -> bool:
   114		if placed_this_turn == 0 and turn_left() >= _min_cost() and armies[current].can_afford_any():
   115			return false
   116		var prev := current
   117		spent_this_turn = 0
   118		placed_this_turn = 0
   119		if is_snake():
   120			hands_done[current] += 1
   121			if hands_done[current] >= hands_max() or not armies[current].can_afford_any():
   122				stopped[current] = true
   123			turn_index += 1
   124			if turn_index < hands_max() * 2:
   125				current = _who(turn_index)
   126			else:
   127				stopped[0] = true
   128				stopped[1] = true
   129		else:
   130			if not armies[current].can_afford_any():
   131				stopped[current] = true
   132			current = 1 - current
   133		_skip_if_stuck()
   134		if current != prev:
   135			handoffs += 1
   136		return true
   137	
   138	func _skip_if_stuck() -> void:
   139		for _i in 12:
   140			if done():
   141				return
   142			if not armies[current].can_afford_any():
   143				stopped[current] = true
   144			if not stopped[current]:
   145				return
   146			if is_snake():
   147				turn_index += 1
   148				if turn_index >= hands_max() * 2:
   149					stopped[0] = true
   150					stopped[1] = true
   151					return
   152				current = _who(turn_index)
   153			else:
   154				current = 1 - current
