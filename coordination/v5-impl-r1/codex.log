    60	static func build(team: int, budget: int, rng: RandomNumberGenerator, template := -1, pool := -1, rules = null):
    61		if pool < 0:
    62			pool = RS.all_pool()
    63		var a = Army.new(team, budget)
    64		if rules != null:
    65			a.apply_rules(rules, team)
    66			a.budget = budget
    67			a.pool = pool
    68		var el := eligible_templates(pool)
    69		if template >= 0 and not template_ok(template, pool):
    70			template = -1   # 指定的模板用到未開放的兵種：改從可用的模板抽（Codex 實作審查 #3）
    71		if el.is_empty() and template < 0:
    72			# 第五輪：奇怪的卡池（例如只有刺客＋醫者）沒有合格模板 → 用落子 AI 的選兵邏輯在卡池內組陣
    73			var AIT = load("res://scripts/core/ai_turns.gd")
    74			return {"army": AIT.fill_army(a, rng, 1, []), "name": "—"}
    75		var ti := template if template >= 0 else int(el[rng.randi_range(0, el.size() - 1)])
    76		var w: Array = TEMPLATES[ti]["w"]
    77		var picks: Array = []
    78		var guard := 0
    79		while a.left() >= D.cheapest() and picks.size() < a.unit_cap and guard < 200:
    80			guard += 1
    81			var total := 0
    82			for t in D.COUNT:
    83				if RS.has(pool, t) and D.cost(t) <= a.left() - _cost_sum(picks) and w[t] > 0 and _cap_ok(a, picks, t):
    84					total += w[t]
    85			if total == 0:
    86				break
    87			var r := rng.randi_range(1, total)
    88			for t in D.COUNT:
    89				if RS.has(pool, t) and D.cost(t) <= a.left() - _cost_sum(picks) and w[t] > 0 and _cap_ok(a, picks, t):
    90					r -= w[t]
    91					if r <= 0:
    92						picks.append(t)
    93						break
    94			if _cost_sum(picks) > a.left():
    95				picks.pop_back()
    96				break
    97		# 先放盾兵、劍士，再放其他（讓前排先佔中間）
    98		picks.sort_custom(func(p, q): return PLACE_ORDER.find(p) < PLACE_ORDER.find(q))
    99		for t in picks:
   100			_place_pref(a, t)
   101		if rules != null and a.can_afford_any():
   102			# 自訂規則：模板比例填完還有錢（單種上限、小卡池）→ 落子 AI 補滿
   103			var AIT2 = load("res://scripts/core/ai_turns.gd")
   104			AIT2.fill_army(a, rng, 1, [])
   105		return {"army": a, "name": TEMPLATES[ti]["name"]}
