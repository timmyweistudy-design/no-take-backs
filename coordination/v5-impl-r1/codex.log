   107	static func _cap_ok(a, picks: Array, t: int) -> bool:
   108		if a.type_cap <= 0:
   109			return true
   110		return picks.count(t) < a.type_cap
   111	
   112	static func _cost_sum(picks: Array) -> int:
   113		var s := 0
   114		for t in picks:
   115			s += D.cost(t)
   116		return s
   117	
   118	static func _place_pref(a, t: int) -> void:
   119		var rows: Array = ROW_EDGE if t == D.CAVALRY else ROW_CENTER
   120		var cols: Array = PREF_COLS[t] + [5, 4, 3, 2, 1, 0]
   121		for c in cols:
   122			var col: int = c if a.team == 0 else Army.COLS - 1 - c
   123			for r in rows:
   124				if a.place(t, col, r):
   125					return
   570		if not _allowed(t):
   571			return L.t("err_type")
   572		if mode == Mode.DUEL and tp != null:
   573			var why: String = tp.check_place(t, c.x, c.y)
   574			return _err_key(why)
   575		if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() + 1 > gauntlet_changes:
   576			return L.t("err_changes")
   577		return _err_key(_cur_army().check_place(t, c.x, c.y))
   578	
   579	
   580	func _err_key(why: String) -> String:
   581		if why == "":
   582			return ""
   583		if why.begins_with("只能放"):
   584			return L.t("err_zone")
   585		if why.begins_with("這格"):
   586			return L.t("err_taken")
   587		if why.begins_with("最多"):
   588			return L.t("err_max", [_cur_army().unit_cap])
   589		if why.begins_with("這種兵最多"):
   590			return L.t("err_type_cap", [_cur_army().type_cap])
   591		if why.begins_with("這種兵不在"):
   592			return L.t("err_type")
   593		if why.begins_with("要留錢"):
   594			return L.t("err_reserve")
   595		if why.begins_with("最後一手"):
   596			return L.t("err_last_hand")
   597		if why.begins_with("錢不夠"):
   598			return L.t("err_gold")
   599		if why.begins_with("這一手"):
   600			return L.t("err_hand", [tp.hand_cap() if tp else 10])
   601		return why
