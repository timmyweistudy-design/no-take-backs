   173			return "格式不對"
   174		if parts[1].sha256_text().substr(0, 4) != parts[2]:
   175			return "校驗碼不符"
   176		var b64 := parts[1].replace("-", "+").replace("_", "/")
   177		while b64.length() % 4 != 0:
   178			b64 += "="
   179		var b := Marshalls.base64_to_raw(b64)
   180		if b.size() < 2 or b[0] != CODE_VERSION or b.size() != 2 + b[1] * 2:
   181			return "版本或長度不對"
