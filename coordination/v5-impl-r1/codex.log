   820		ok(games_1 == 1 and snap.call() == after_official and g.play_kind == "replay", "重播 3 次：場次、勝場、兵種勝場、成就、系列比分都不變", "%s → %s" % [after_official, snap.call()])
   821		play.call("official")
   822		ok(int(SV.data["stats"]["games"]) == 2, "重播之後再打正式的一場，照常記錄")
   823		# 覆盤播放：只看不算（副作用矩陣 review）
