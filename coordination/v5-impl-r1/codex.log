   419					types[u.type] = true
   420			if types.size() == 5:
   421				_ach("ALL_TYPES")
   422			# 圖鑑老兵筆記：派這個兵種贏一場 +1（第二輪方案 R3）
   423			for t in CX.record_win(Save.data, types.keys()):
   424				ach_queue.append(L.t("codex_unlocked", [L.t("unit_%d" % t)]))
   425			if int(ev_count.get("charge%d" % w, 0)) >= 5:
   426				_ach("CHARGE_5")
   427			if int(ev_count.get("backstab%d" % w, 0)) >= 3:
   428				_ach("BACKSTAB_3")
   429		if mode == Mode.VS_AI and w == 0 and difficulty == 2:
   430			_ach("HARD_WIN")
   431		if mode == Mode.DUEL and tp != null and series_over:
   432			_ach("NO_TAKEBACKS")
   433		if series_over and ((mode == Mode.DUEL and (wins == [2, 0] or wins == [0, 2])) or (mode == Mode.VS_AI and wins == [2, 0])):
   434			_ach("SWEEP")
   435		if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
   436			var stars := int(report.get("stars", 0))
   437			var ps: Dictionary = Save.data.get("puzzle_stars", {})
   438			if stars > int(ps.get(puzzle_id, 0)):
   439				ps[puzzle_id] = stars
   440			Save.data["puzzle_stars"] = ps
   441			if mode == Mode.TUTORIAL and w == 0:
   442				var idx := 0
   443				for i in PZ.tutorials().size():
   444					if PZ.tutorials()[i]["id"] == puzzle_id:
   445						idx = i
   446				Save.data["tutorial"] = maxi(int(Save.data.get("tutorial", 0)), idx + 1)
   447				if int(Save.data["tutorial"]) >= PZ.tutorials().size():
   448					_ach("TUTORIAL")
   449			if stars == 3:
   450				_ach("PUZZLE_3STAR")
   451			var all_done := true
   452			for p in PZ.puzzles():
   453				if int(ps.get(p["id"], 0)) == 0:
   454					all_done = false
   455			if all_done:
   456				_ach("PUZZLE_ALL")
   457		if mode == Mode.GAUNTLET:
   458			if w == 0:
   459				if gauntlet_stage >= 7:
   460					_ach("GAUNTLET")
   461					Save.data["gauntlet_best"] = 7
   462			else:
   463				Save.data["gauntlet_best"] = maxi(int(Save.data.get("gauntlet_best", 0)), gauntlet_stage - 1)
   464		_save()
