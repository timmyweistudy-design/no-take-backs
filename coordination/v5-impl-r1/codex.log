    82	static func _write(path: String, d: Dictionary) -> bool:
    83		var tmp := path + ".tmp"
    84		var f := FileAccess.open(tmp, FileAccess.WRITE)
    85		if f == null:
    86			return false
    87		var txt := JSON.stringify(d, "\t")
    88		f.store_string(txt)
    89		f.close()
    90		# 讀回驗證：內容不完整（磁碟滿、被中斷）就不覆蓋正式檔
    91		if FileAccess.get_file_as_string(tmp) != txt:
    92			return false
    93		if FileAccess.file_exists(path):
    94			DirAccess.copy_absolute(path, path + ".bak")
    95		return DirAccess.rename_absolute(tmp, path) == OK
