    53	## 最後時刻（優化方案 F1）：雙方剩餘戰力都 ≤30% 且差距 ≤15%；或雙方各剩 ≤3 隻且差距 ≤15%。
    54	## 最後時刻的條件（view 與 sim 都有 budget／power／alive_count，重播跳轉時用同一個條件重算，Codex S7 #2）。
    55	static func clutch_cond(s) -> bool:
    56		var tot := float(s.budget * 1000)
    57		var p0: float = s.power(0) * 100.0 / tot
    58		var p1: float = s.power(1) * 100.0 / tot
    59		return absf(p0 - p1) <= 15.0 and ((p0 <= 30.0 and p1 <= 30.0) or (s.alive_count(0) <= 3 and s.alive_count(1) <= 3))
    60	
    61	## with_fx＝false（直接看結果、重播跳轉補播）只記狀態與標記，不放慢動作、不播音效、不出橫幅（Codex S8 #2）。
    62	func _check_clutch(with_fx := true) -> void:
    63		if slow_used or view.finished:
    64			return
    65		if clutch_cond(view):
    66			slow_used = true
    67			clutch_tick = view.tick
    68			battle_marks.append({"tick": view.tick, "kind": "clutch", "team": -1})
    69			if not with_fx:
    70				return
    71			if bool(Save.s("slowmo")):
    72				slow_left = 8.0
