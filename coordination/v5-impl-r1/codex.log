  1494				if not keep.place(t, int(u["col"]), int(u["row"])):
  1495					gone[t] = int(gone.get(t, 0)) + 1
  1496			armies[0].units = keep.units
  1497			if not gone.is_empty():
  1498				var bits: Array = []
