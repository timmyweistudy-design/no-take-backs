   794		g.mode = g.Mode.VS_AI
   795		g.difficulty = 1
   796		var keys := ["official", "replay", "review"]
   797		var mx_ok := true
   798		for k in keys:
   799			mx_ok = mx_ok and g.PLAY_EFFECTS.has(k)
   800		ok(mx_ok and g.PLAY_EFFECTS["official"]["progress"] and not g.PLAY_EFFECTS["replay"]["progress"] and not g.PLAY_EFFECTS["review"]["series"], "副作用矩陣：三種播放都有定義、只有正式會寫")
   801		var a0 = army_from(0, [[D.SWORD, 5, 4], [D.CAVALRY, 4, 2], [D.ARCHER, 1, 4]])
   802		var a1 = army_from(1, [[D.SWORD, 5, 4]])
   803		var play := func(kind: String) -> void:
   804			if kind == "official":
