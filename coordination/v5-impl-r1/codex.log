     1	extends SceneTree
     2	## 第五輪 P0：效能探測。人數上限、一局時間要依這裡的數字定，不憑感覺。
     3	## 情境：標準 24＋24、大軍 32／40／48 隻、支援兵密集、困難 AI 候選模擬。
     4	## 模擬直接塞兵（繞過 MAX_UNITS），只量模擬本身；畫面 fps 另用截圖模式量。
     5	## 用法：godot --headless --path game --script res://tools/perf_probe.gd
     6	const Sim = preload("res://scripts/core/battle_sim.gd")
     7	const Army = preload("res://scripts/core/army.gd")
     8	const D = preload("res://scripts/core/unit_defs.gd")
     9	const AI = preload("res://scripts/core/ai_army.gd")
    10	const HardAI = preload("res://scripts/core/hard_ai.gd")
    11	
    12	static func fill(team: int, n: int, rng: RandomNumberGenerator, types: Array) -> Army:
    13		var a := Army.new(team, 1000)
    14		var cells: Array = []
    15		for c in Army.ZONE:
    16			for r in Army.ROWS:
    17				cells.append(Vector2i(c if team == 0 else Army.COLS - 1 - c, r))
    18		for i in range(cells.size() - 1, 0, -1):
    19			var j := rng.randi_range(0, i)
    20			var t = cells[i]; cells[i] = cells[j]; cells[j] = t
    21		for i in mini(n, cells.size()):
    22			a.units.append({"type": types[rng.randi_range(0, types.size() - 1)], "col": cells[i].x, "row": cells[i].y})
    23		return a
    24	
    25	static func bench(n: int, types: Array, reps: int) -> Dictionary:
    26		var tot := 0
    27		var worst := 0
    28		var ticks := 0
    29		for k in reps:
    30			var rng := RandomNumberGenerator.new()
    31			rng.seed = 777 + k * 31 + n
    32			var s = Sim.new(fill(0, n, rng, types), fill(1, n, rng, types))
    33			s.fast = true
    34			var t0 := Time.get_ticks_usec()
    35			s.run_to_end()
    36			var us := Time.get_ticks_usec() - t0
    37			tot += us
    38			worst = maxi(worst, us)
    39			ticks += s.tick
    40		return {"n": n, "avg_ms": tot / reps / 1000, "worst_ms": worst / 1000, "avg_ticks": ticks / reps, "us_per_tick": tot / maxi(1, ticks)}
    41	
    42	func _init() -> void:
    43		var all: Array = []
    44		for t in D.COUNT:
    45			all.append(t)
    46		var out := {}
    47		for n in [24, 32, 40, 48]:
    48			out["mixed_%d" % n] = bench(n, all, 6)
    49		out["support_40"] = bench(40, [D.SWORD, D.SHIELD, 7, 8, 7, 8], 6)   # 醫者 7、鼓手 8 密集
    50		out["archers_40"] = bench(40, [D.ARCHER, D.ARCHER, D.SHIELD], 6)
    51		# 困難 AI：候選陣型各和玩家上一局模擬一場（標準 24 隻）
    52		var rng := RandomNumberGenerator.new()
    53		rng.seed = 99
    54		var known: Array = AI.build(0, 100, rng)["army"].units
    55		var t0 := Time.get_ticks_usec()
    56		for k in 5:
    57			HardAI.build(known, [], rng)
    58		out["hard_ai_build_ms"] = (Time.get_ticks_usec() - t0) / 5 / 1000
    59		print("PERF ", JSON.stringify(out))
    60		quit()
     1	#!/usr/bin/env python3
     2	"""字型涵蓋檢查（第五輪 §5.3）：遊戲會顯示的字（strings.csv、puzzles.json、codex.json、credits.txt、程式裡的字）
     3	都要在思源黑體子集裡；不然那幾個字會靜靜 fallback 成系統字型（循徑拾光踩過的坑）。缺字 exit 1。
     4	標題字 ThenKhung 原字型本來就沒有的字由思源黑體 Bold 補，不算缺字。"""
     5	import os, glob, sys
     6	from fontTools.ttLib import TTFont
     7	root = os.path.join(os.path.dirname(__file__), "..")
     8	chars = set()
     9	for pat in ["data/*.csv", "data/*.json", "data/*.txt", "scripts/**/*.gd"]:
    10	    for f in glob.glob(os.path.join(root, pat), recursive=True):
    11	        chars.update(open(f, encoding="utf-8").read())
    12	need = sorted(c for c in chars if c.isprintable() and not c.isspace() and ord(c) >= 0x20)
    13	bad = []
    14	for w in ["Regular", "Bold"]:
    15	    cmap = TTFont(os.path.join(root, "fonts", f"NotoSansTC-{w}-sub.otf")).getBestCmap()
    16	    miss = [c for c in need if ord(c) not in cmap]
    17	    if miss:
    18	        bad.append(f"{w} 缺 {len(miss)} 字：{''.join(miss[:40])}")
    19	print("FONTCOVER", "OK" if not bad else "；".join(bad), f"（{len(need)} 字）")
    20	sys.exit(1 if bad else 0)
#!/usr/bin/env bash
# 版面檢查（第三輪 T4）：用 Windows 版 Godot 跑截圖模式，兩種語言 × 三種字級，彙整 layout.jsonl。
# 用法：tools/layout_check.sh <Godot 執行檔> <輸出資料夾（WSL 路徑）>
set -uo pipefail
cd "$(dirname "$0")/.."
EXE="$1"; OUT="$2"
rm -rf "$OUT"; mkdir -p "$OUT"
for lang in zh_TW en; do
  for sc in 100 125 150; do
    d="$OUT/${lang}_${sc}"; mkdir -p "$d"
    timeout 300 "$EXE" --path "$(wslpath -w .)" --resolution 1280x800 -- --shot="$(wslpath -w "$d")" --shot-lang=$lang --shot-text=$sc --layout-check > "$d/run.log" 2>&1 \
      || { echo "LAYOUT FAIL：$lang $sc% 截圖程式 exit 非 0"; exit 1; }
    grep -E "SCRIPT ERROR|Parse Error" "$d/run.log" >/dev/null && { echo "LAYOUT FAIL：$lang $sc% 有腳本錯誤"; exit 1; }
  done
done
EXPECT=$(grep -o '_snap("[^"]*")' scripts/ui/main.gd | wc -l)
NAMES=$(grep -o '_snap("[^"]*")' scripts/ui/main.gd | sed 's/_snap("//; s/")//' | sort | tr '\n' ',')
python3 - "$OUT" "$EXPECT" "$NAMES" <<'PY'
import json,sys,glob,os
out=sys.argv[1]; expect=int(sys.argv[2]); names=set(x for x in sys.argv[3].split(',') if x); total=0; rows=[]
for f in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    for line in open(f,encoding='utf-8'):
        d=json.loads(line); total+=len(d['violations']); rows.append(d)
warns=sum(len(d.get('warnings',[])) for d in rows)
# 第五輪：每組都要剛好是 main.gd 列出的那些畫面（不能用重複畫面湊張數）
for f2 in sorted(glob.glob(os.path.join(out,'*','layout.jsonl'))):
    got=[json.loads(l)['shot'] for l in open(f2,encoding='utf-8')]
    if sorted(got)!=sorted(names) or len(set(got))!=len(got):
        print('LAYOUT FAIL：%s 的畫面集合不對（少了 %s、多了 %s）' % (f2, sorted(names-set(got)), sorted(set(got)-names))); sys.exit(1)
by={}
for d in rows: by.setdefault((d['lang'],d['scale']),[]).append(d['median_size'])
print('LAYOUT 截圖 %d 張、違規 %d' % (len(rows), total))
for d in rows:
    for v in d['violations']: print('  %s %s %d%%：%s' % (d['shot'], d['lang'], d['scale'], v))
for lang in ['zh_TW','en']:
    if (lang,100) in by and (lang,150) in by:
        a=sorted(by[(lang,100)]); b=sorted(by[(lang,150)])
        print('  %s 中位字級 100%%=%s 150%%=%s' % (lang, a[len(a)//2], b[len(b)//2]))
runs=glob.glob(os.path.join(out,'*','layout.jsonl'))
if len(runs)!=6 or len(rows)!=6*expect:
    print('LAYOUT FAIL：應有 6 組 × %d 張，實得 %d 組、%d 張（截圖沒跑完也算失敗）' % (expect, len(runs), len(rows))); sys.exit(1)
sys.exit(1 if total else 0)
PY
