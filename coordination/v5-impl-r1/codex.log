    45	
    46	## 第 i 手輪到誰（Thue‑Morse 公平輪序；前 10 手＝SNAKE）。
    47	func _who(i: int) -> int:
    48		var b := 0
    49		var x := i
    50		while x > 0:
    51			b ^= x & 1
    52			x >>= 1
    53		return b if first == 0 else 1 - b
    54	
    55	## 這一隊現在最便宜能買的兵（標準路徑＝全域最便宜 4 金，和 1.3.0 相同）。
    56	func _min_cost() -> int:
    57		if rules == null:
    58			return D.cheapest()
    59		var a = armies[current]
    60		return a.cheapest_combat() if (a.guard_combat and not a.has_combat()) else a.cheapest_in_pool()
    61	
    62	func is_snake() -> bool:
    63		return rule.begins_with("snake")
    64	
    65	func _order() -> Array:
    66		return SNAKE
    67	
    68	func done() -> bool:
