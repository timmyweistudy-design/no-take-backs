   134		for k in ys.size():
   135			var x := rect.position.x + k * dx
   136			var y: float = rect.end.y - rect.size.y * ys[k]
   137			if y < mid:
   138				ui.draw_rect(Rect2(x, y, dx + 0.5, mid - y), team_col(0, cb) * Color(1, 1, 1, 0.85))
   139			else:
   140				var rr := Rect2(x, mid, dx + 0.5, y - mid)
   141				ui.draw_rect(rr, team_col(1, cb) * Color(1, 1, 1, 0.85))
   142		if cb:
   143			for k in ys.size():
   144				if ys[k] < 0.5:
   145					pass
   146		# 標記：最多 3 個，依時間排，標籤往左右讓開
   147		var fs: int = ui.tz("C")
   148		var used: Array = []
   149		var shown := 0
   150		for m in marks:
   151			if shown >= 3:
   152				break
   153			var x := rect.position.x + rect.size.x * clampf(float(m["t"]) / maxf(1.0, span - 1), 0.0, 1.0)
   154			var lab := str(m["label"])
   155			var w: float = ui._width(lab, fs) + 8
   156			var lx := clampf(x - w / 2, rect.position.x, rect.end.x - w)
   157			var row := 0
   158			for u in used:
   159				if absf(u - lx) < w + 6:
   160					row += 1
   161			if row > 1:
   162				continue   # 最多兩排標籤（上方只留了兩排空間）
   163			used.append(lx)
   164			ui.draw_line(Vector2(x, rect.position.y), Vector2(x, rect.end.y), Color("#ffd166"), 1.5)
