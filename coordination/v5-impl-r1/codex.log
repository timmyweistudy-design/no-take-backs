   604	## 遠征：跟上一戰的陣型比，新出現的「兵種＋格子」數（移動也算一次）。
   605	func _gauntlet_diff() -> int:
   606		if gauntlet_prev.is_empty():
   607			return 0
   608		var a := {}
   609		for u in gauntlet_prev:
   610			a["%d,%d,%d" % [u["type"], u["col"], u["row"]]] = true
   611		var d := 0
   612		for u in armies[0].units:
   613			if not a.has("%d,%d,%d" % [u["type"], u["col"], u["row"]]):
   614				d += 1
   615		return d
