    11	
    12	func _battle_process(delta: float) -> void:
    13		if paused:
    14			return
    15		if hitstop > 0:
    16			hitstop -= delta
    17			return
    18		var rate := speed
    19		if slow_left > 0:
    20			rate *= 0.5
    21			slow_left -= delta
    22		accum += delta * rate
    23		while accum >= 0.05 and not view.finished:
    24			accum -= 0.05
    25			var was_slow := slow_left > 0
    26			_sim_step(true)
    27			if slow_left > 0 and not was_slow:
    28				break   # 這一 tick 觸發慢動作：剩下的累積留到下一幀用慢速消耗（Codex S8 #3）
    29		# 播完之後展示時鐘繼續走（不再推進快照）：最後一格的位置插值與最後一擊的後搖要演完（Codex R5 #1）
    30		# 最後時刻只在 _sim_step 每個畫面 tick 判定（Codex S8 #1：每幀也判會讓觸發 tick 跟幀率有關）
    31		if slow_left > 0:
    32			_update_action_focus()
    33		sfx.set_muffled(slow_left > 0 and not view.finished)
    34		# 分軌音樂依戰況混音（第三輪 S1）
    35		var tot2 := float(view.budget * 1000)
    36		var close := absf(view.power(0) - view.power(1)) * 100.0 / tot2 <= 15.0
    37		sfx.set_layer_targets(sfx.layer_targets(close, slow_left > 0 and not view.finished))
    38		# 鏡頭只有一個決策點（Codex S5 #6）：跟拍優先於最後時刻框選，兩者都沒有才回到全景
    39		if follow_id >= 0:
    40			pass   # 由 _follow_update 決定
    41		elif slow_left > 0 and not view.finished:
    42			_frame_alive(delta)
    43		else:
    44			zoom_target = 1.0
    45			zoom_center = zoom_center.lerp(ORIGIN + FIELD / 2, minf(1.0, delta * 3))
    46		zoom = lerpf(zoom, zoom_target, delta * 3)
