  1747	static func legal_army(a, r, team: int) -> String:
  1748		var seen := {}
  1749		var spent := 0
  1750		var per := {}
  1751		for u in a.units:
  1752			var t := int(u["type"])
  1753			var c := int(u["col"])
  1754			var row := int(u["row"])
  1755			var lc := c if team == 0 else 15 - c
  1756			if lc < 0 or lc > 5 or row < 0 or row > 8:
  1757				return "出界"
  1758			if seen.has(Vector2i(c, row)):
  1759				return "重複格"
  1760			seen[Vector2i(c, row)] = true
  1761			if (r.pool_of(team) >> t) & 1 == 0:
  1762				return "不在卡池 %d" % t
  1763			per[t] = int(per.get(t, 0)) + 1
  1764			if r.type_cap > 0 and per[t] > r.type_cap:
  1765				return "超過單種上限"
  1766			spent += D.cost(t)
  1767		if spent > r.budget_of(team):
  1768			return "超過預算"
  1769		if a.units.size() > r.unit_cap:
  1770			return "超過人數"
  1771		return ""
