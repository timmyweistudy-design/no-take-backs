## V9 地圖資料（純資料＋整數）：左半邊的矩形清單，右半邊自動鏡像，所以公平性由建構保證。
## 座標用千分比（x：0＝左邊界、1000＝中線；y：0＝上、1000＝下），依大小換算到 0.5 格的格點。
const Terrain = preload("res://scripts/core/terrain.gd")

const FREE := 0
const BLOCK := 1
const SLOW := 2
const FAST := 3

const SIZES := [[12, 7], [16, 9], [18, 10]]   # 格數：小、中（標準）、大
const STD_SIZE := 1
const SIZE_SUGGEST := [[60, 16, 1200], [100, 24, 1800], [130, 30, 2400]]   # 建議 金、人數、tick

const PLAIN := 0
const RIVER := 1
const FOREST := 2
const ICE := 3
const LAVA := 4
const CANYON := 5

## 後面的矩形蓋掉前面。名稱鍵在 strings.csv：map_<key>。biome 給畫面用。
const MAPS := [
	{"key": "plain", "biome": "grass", "rects": []},
	# 雙橋河谷：中央河流＋上下兩座橋（橋寬 18%）
	{"key": "river", "biome": "river", "rects": [
		[BLOCK, 880, 0, 1000, 170], [BLOCK, 880, 400, 1000, 600], [BLOCK, 880, 830, 1000, 1000],
	]},
	# 林間小徑：零散樹叢分出多條路，中間泥塘
	{"key": "forest", "biome": "forest", "rects_small": [
		[SLOW, 640, 380, 860, 620],
		[BLOCK, 760, 130, 840, 260], [BLOCK, 760, 740, 840, 870], [BLOCK, 920, 430, 1000, 570],
	], "rects": [
		[SLOW, 640, 380, 860, 620],
		[BLOCK, 760, 90, 840, 250], [BLOCK, 920, 280, 1000, 420], [BLOCK, 760, 750, 840, 910], [BLOCK, 920, 580, 1000, 720],
	]},
	# 冰湖雪原：中央冰面快、上下雪地慢；冰面靠我方一端有碎冰，逼人繞行匯流
	{"key": "ice", "biome": "ice", "rects": [
		[SLOW, 460, 0, 1000, 240], [SLOW, 460, 760, 1000, 1000],
		[FAST, 640, 240, 1000, 760],
		[BLOCK, 780, 410, 860, 590],
	]},
	# 熔岩裂谷：岩塊與熔岩分割，中央灰燼減速
	{"key": "lava", "biome": "lava", "rects_small": [
		[SLOW, 800, 320, 1000, 680],
		[BLOCK, 800, 0, 900, 210], [BLOCK, 800, 790, 900, 1000], [BLOCK, 920, 430, 1000, 570],
	], "rects": [
		[SLOW, 800, 320, 1000, 680],
		[BLOCK, 800, 0, 900, 300], [BLOCK, 800, 700, 900, 1000], [BLOCK, 920, 430, 1000, 570],
	]},
	# 古道峽谷：兩座大崖把三線隔開，上下石道長而快，中央沙地短而慢
	{"key": "canyon", "biome": "canyon", "rects": [
		[FAST, 620, 0, 1000, 260], [FAST, 620, 740, 1000, 1000],
		[SLOW, 620, 380, 1000, 620],
		[BLOCK, 720, 260, 1000, 380], [BLOCK, 720, 620, 1000, 740],
	]},
]

static var _cache := {}

static func width(size: int) -> int:
	return int(SIZES[size][0]) * 1000

static func height(size: int) -> int:
	return int(SIZES[size][1]) * 1000

## 回傳 Terrain；平原回 null（平原的場地大小不需要地形）。
static func terrain(map_id: int, size: int):
	if map_id == PLAIN:
		return null
	var k := map_id * 10 + size
	if not _cache.has(k):
		var mp: Dictionary = MAPS[map_id]
		_cache[k] = Terrain.new(mp.get("rects_small", mp["rects"]) if size == 0 else mp["rects"], width(size), height(size))   # 小地圖通道要另外留寬
	return _cache[k]

## 進規則摘要：地形內容一變，舊代碼就會回報不一致。
static func digest(map_id: int, size: int) -> String:
	var t = terrain(map_id, size)
	return "plain" if t == null else t.digest()
extends RefCounted

## 第十輪 R1：試玩版開放的地圖（平原、雙橋河谷、冰湖雪原）與試煉（第 1、3 關）、殘局前 5 關。
const DEMO_MAPS := [0, 1, 3]
const DEMO_TRIALS := [0, 2]
const DEMO_PUZZLES := 5
## 規則大廳的預設組合與徽章（第五輪 §3.5）。純函式，不碰畫面。
## kind："ai"（對 AI 快速對戰）、"duel"（同機雙人）。
## unlocked：玩家已解鎖的卡池遮罩（對 AI 用；雙人不看個人進度，只受試玩版限制）。

const D = preload("res://scripts/core/unit_defs.gd")
const F8 = preload("res://scripts/core/fantasy_defs.gd")
const RSET = preload("res://scripts/core/ruleset.gd")

const IDS := ["standard", "classic5", "fantasy", "small", "big", "single"]
const BADGE_CERT := "cert"       # 平衡認證（綠）
const BADGE_FUN := "fun"         # 娛樂變體（黃）
const BADGE_LAB := "lab"         # 沙盒（紫）
# 第六輪：自由排兵的標準間距與縱深。全因子篩選 9 組全過（v6-screen/REPORT.md）；完整驗收 0.8×7.5 差 2 項沒過、
# 0.8×6 全部通過（v6-accept-800-6000/REPORT.md）→ 定 0.8 格＋6 格。縱深 6.5～7.5 仍可在大廳自選（娛樂變體）。
const FREE_SPACING := 800
const FREE_DEPTH := 6000

static func make(id: String, kind: String, unlocked: int):
	var r = RSET.standard(unlocked & RSET.all_pool())   # 標準只含舊 10 種
	r.preset = id
	r.rounds = 3
	r.place_rule = "snake5"
	# 第六輪（方案 §9-5）：大廳預設「自由排兵」；格子留在部署分頁當選項
	r.deploy = "free"
	r.spacing = FREE_SPACING
	r.depth = FREE_DEPTH
	match id:
		"standard":
			if kind == "duel":
				r.pool = [31, 31]       # 雙人標準＝經典 5 種（唯一驗證過公平的組合）
		"classic5":
			r.pool = [31, 31]
		"fantasy":
			var fp := fantasy_pool(unlocked)
			r.pool = [fp, fp]
		"small":
			r.budget = [50, 50]
			r.unit_cap = 12
			r.ticks = 1200
		"big":
			r.budget = [180, 180]
			r.unit_cap = 40
			r.ticks = 2400
		"single":
			# 單兵種對決：只開 1 種戰鬥兵（劍士）＋1 種支援兵（醫者）；卡池分頁可以換
			r.pool = [(1 << D.SWORD) | (1 << D.MEDIC), (1 << D.SWORD) | (1 << D.MEDIC)]
	if kind == "duel":
		r.ai_pool_same = true
	return r

## 奇幻兵團預設（第八輪）：解鎖的奇幻軍優先，不足 10 種由舊兵補（先補戰鬥兵，免得全是奇襲兵開不了戰）。
static func fantasy_pool(unlocked: int) -> int:
	var p := 0
	var n := 0
	for t in range(D.COUNT, D.total()):
		if RSET.has(unlocked, t):
			p |= 1 << t
			n += 1
	for t in [D.SWORD, D.SHIELD, D.ARCHER, D.CAVALRY, D.ASSASSIN, D.PIKE, D.BOMBER, D.BERSERKER, D.MEDIC, D.DRUMMER]:
		if n >= RSET.ROSTER_MAX:
			break
		if RSET.has(unlocked, t):
			p |= 1 << t
			n += 1
	return p

## 卡池是不是「前 N 種、N≥5」（第四輪 AI 驗收只驗過經典 5 種到全部 10 種的前綴卡池）。
static func is_prefix(p: int) -> bool:
	return p >= 31 and (p & (p + 1)) == 0

## 徽章：動到沙盒＝沙盒；驗證過的組合＝平衡認證；其他＝娛樂變體。
## 對 AI：100 金、24 隻、不限單種、90 秒、前綴卡池（第四輪驗收的條件）。
## 雙人：再加上經典 5 種＋snake5（第四輪 snake5 三種 AI 強度都在 45～55%）。
static func badge(r, kind: String) -> String:
	if r.is_sandbox():
		return BADGE_LAB
	if r.cmd_on():
		return BADGE_FUN    # 第十二輪：手動技能沒有平衡認證
	var base: bool = r.budget_of(0) == 100 and r.budget_of(1) == 100 and r.unit_cap == 24 and r.type_cap == 0 and r.ticks == 1800
	# 第六輪：部署也要是驗過的——格子，或自由＋預設的間距與縱深；全場一律算娛樂變體
	base = base and deploy_certified(r)
	if kind == "ai":
		return BADGE_CERT if base and is_prefix(r.pool_of(0)) and r.pool_of(1) == r.pool_of(0) else BADGE_FUN
	return BADGE_CERT if base and r.pool_of(0) == 31 and r.pool_of(1) == 31 and r.place_rule == "snake5" and not r.carry else BADGE_FUN

static func deploy_certified(r) -> bool:
	if r.fullfield != 0 or not r.map_is_default():
		return false   # V9：地圖是娛樂變體，平衡認證只給平原中型
	return r.deploy == "grid" or (r.spacing == FREE_SPACING and r.depth == FREE_DEPTH)

## 算不算「標準紀錄」（標準戰績、標準成就；Codex 實作第 1 輪：和「平衡認證」分開判定）。
## 除了認證條件，系列也要是標準的：三戰兩勝、保留陣型、沒有讓子；對 AI 卡池兩邊相同；雙人 snake5、不累積。
static func is_standard_record(r, kind: String) -> bool:
	if badge(r, kind) != BADGE_CERT:
		return false
	if r.rounds != 3 or not r.keep_formation or r.handicap:
		return false
	if kind == "ai":
		return r.ai_pool_same
	return r.place_rule == "snake5" and not r.carry

## 部署限制是不是「標準」（前 N 種卡池、24 隻、不限單種、100 金）：對戰代碼可以用舊格式 NTB2、AI 不額外補兵。
static func deploy_standard(r) -> bool:
	return r.unit_cap == 24 and r.type_cap == 0 and r.budget_of(0) == 100 and r.budget_of(1) == 100 and is_prefix(r.pool_of(0)) and r.pool_of(1) == r.pool_of(0)
