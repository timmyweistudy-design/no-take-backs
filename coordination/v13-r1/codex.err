			KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
				if _btns_gen == _gen and _focus >= 0 and _focus < _btns.size() and _btns[_focus]["en"]:   # 按鈕清單要是這個畫面的
					sfx.play("k_click", 0.7)
					_btns[_focus]["cb"].call()
			KEY_PAGEUP, KEY_PAGEDOWN:
