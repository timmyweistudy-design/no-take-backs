+
+## 第十三輪：時序殘局的施放時間（戰鬥中不能按，照這裡設定的秒數放）。每格 0.5 秒。
+func _draw_plan_panel(R: Rect2) -> void:
+	var pz := PZ.get_puzzle(puzzle_id)
+	var c: Dictionary = pz["cmd"]
+	_box(R, Color(0, 0, 0, 0.45), TH_EDGE, 8.0, 1.5)
+	var nm: String = L.t("cmd_%d" % int(c["skill"]))
+	var en_list: Array = []
+	for e in c.get("enemy", []):
+		en_list.append(L.t("plan_enemy_item", [_fmt_num(int(e[0]) / 20.0), L.t("cmd_%d" % int(e[1]))]))
+	var head := L.t("plan_head", [nm])
+	if not en_list.is_empty():
+		head += "　" + L.t("plan_enemy", [", ".join(en_list)])
+	_text(R.position + Vector2(10, 6), head, tz("C"), ACCENT, false, false, R.size.x - 20)
+	var lim: int = int(pz.get("goal_ticks", Sim.MAX_TICKS)) - 10
+	var rows: int = puzzle_plan.size()
+	var rh: float = minf(40.0, (R.size.y - tz("C") * 1.6 - 10) / maxf(1.0, rows))
+	for i in rows:
+		var y: float = R.position.y + tz("C") * 1.6 + 6 + i * rh
+		var idx := i
+		_text(Vector2(R.position.x + 12, y + 6), L.t("plan_row", [i + 1, _fmt_num(int(puzzle_plan[i]) / 20.0)]), tz("S"), Color.WHITE, false, true, 200)
+		_btn(Rect2(R.end.x - 104, y, 44, rh - 4), "◀", func(): _plan_nudge(idx, -10), int(puzzle_plan[idx]) > CmdD.START_TICKS)
+		_btn(Rect2(R.end.x - 54, y, 44, rh - 4), "▶", func(): _plan_nudge(idx, 10), int(puzzle_plan[idx]) < lim)
+
+func _plan_nudge(i: int, d: int) -> void:
+	var pz := PZ.get_puzzle(puzzle_id)
+	var lim: int = int(pz.get("goal_ticks", Sim.MAX_TICKS)) - 10
+	puzzle_plan[i] = clampi(int(puzzle_plan[i]) + d, CmdD.START_TICKS, lim)
+	sfx.play("k_click", 0.6)
