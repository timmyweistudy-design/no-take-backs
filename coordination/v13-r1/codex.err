extends SceneTree
## 第十三輪：主題試煉第 11～30 關量產。依規格（tools/gen/trial_specs.py）：
##   ① 用規則變形＋敵方卡池、固定種子讓 AI 組敵陣，凍結成資料 ② 走遊戲同一條路開關（_start_trial、_build_ai）
##   ③ 多起點爬山收集過關解（技能關：敵方照遊戲一樣自動施放）④ 從前緣挑三星解，訂剩餘％與花費％門檻
## godot --headless --path game --script res://tools/balance/trial_forge.gd -- --in=<規格.json> [--id=10] [--iters=600]
const Sim = preload("res://scripts/core/battle_sim.gd")
const D = preload("res://scripts/core/unit_defs.gd")
const P = preload("res://scripts/game/puzzles.gd")
const AI = preload("res://scripts/core/ai_army.gd")
const RS = preload("res://scripts/core/ruleset.gd")
const GM = preload("res://scripts/ui/screens/game_modes.gd")
const FAKE = preload("res://tests/test_base.gd")

func judge(g, spec: Array, e) -> Dictionary:
	var a = g.armies[0].copy()
	a.units = []
	for u in spec:
		a.place_xy(int(u[0]), a.world_x(int(u[1])), int(u[2]))
	if a.units.is_empty() or not a.has_combat():
		return {"won": false, "rem": 0, "spent": 0, "pct": 0, "diff": -1000000}
	var s = Sim.new(a.copy(), e.copy(), g.rules)
	if s.cmd_on:
		s.cmd_auto = [false, true]   # 和遊戲一樣：對 AI 時紅方自動放，玩家不放也要拿得到星
	s.fast = true
	s.run_to_end()
	return {"won": s.winner == 0, "rem": P.rem_pct(s.power(0), s.budget_of(0)), "spent": a.spent(), "pct": a.spent() * 100 / a.budget,
		"diff": s.power(0) - s.power(1), "real": a.units.map(func(u): return [int(u["type"]), a.world_x(int(u["x"])), int(u["y"])])}

func rand_spec(types: Array, g, r: RandomNumberGenerator) -> Array:
	var out: Array = []
	var a = g.armies[0]
	var left: int = a.budget
	for k in 30:
		var t: int = types[r.randi_range(0, types.size() - 1)]
		if D.cost(t) > left:
			continue
		out.append([t, 200 + r.randi_range(0, 110) * 50, 400 + r.randi_range(0, (a.fh - 800) / 50) * 50])
		left -= D.cost(t)
	return out

func mutate(sp: Array, types: Array, g, r: RandomNumberGenerator) -> Array:
	var s2: Array = sp.duplicate(true)
	var fh: int = g.armies[0].fh
	var op := r.randi_range(0, 3)
	if s2.is_empty():
		op = 3
	match op:
		0:
			var i := r.randi_range(0, s2.size() - 1)
			s2[i][1] = clampi(int(s2[i][1]) + r.randi_range(-20, 20) * 50, 200, 5800)
			s2[i][2] = clampi(int(s2[i][2]) + r.randi_range(-20, 20) * 50, 300, fh - 300)
		1:
			s2[r.randi_range(0, s2.size() - 1)][0] = types[r.randi_range(0, types.size() - 1)]
		2:
			s2.remove_at(r.randi_range(0, s2.size() - 1))
		3:
			s2.append([types[r.randi_range(0, types.size() - 1)], 200 + r.randi_range(0, 110) * 50, 400 + r.randi_range(0, (fh - 800) / 50) * 50])
	return s2

func score(j: Dictionary, w: int) -> int:
	if not bool(j["won"]):
		return -10000000 + int(j["diff"]) / 10
	return 10000000 + int(j["rem"]) * (10 - w) * 10 - int(j["pct"]) * w * 10

func _init() -> void:
	var args := {}
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--") and "=" in a:
			var kv := a.substr(2).split("=", true, 1)
			args[kv[0]] = kv[1]
	var specs: Array = JSON.parse_string(FileAccess.get_file_as_string(str(args.get("in", ""))))
	var want := int(args.get("id", "-1"))
	var iters := int(args.get("iters", "600"))
	var g = load("res://scripts/ui/game_screens.gd").new()
	g.sfx = FAKE.FakeSfx.new()
	g.time = 1.0
	load("res://scripts/game/save.gd").data_locked = true
	for sp in specs:
		var i: int = int(sp["i"])
		if want >= 0 and i != want:
			continue
		var x: Dictionary = sp.duplicate(true)
		# ① 敵陣：規則變形＋敵方卡池，固定種子
		var r = g._trial_rules(i, x)
		var ep := 0
		for t in x["enemy_pool"]:
			ep |= 1 << int(t)
		r.pool[1] = ep
		var rr := RandomNumberGenerator.new()
		rr.seed = 13000 + i
		var ea = AI.build(1, r.budget_of(1), rr, -1, ep, r)["army"]
		x["enemy"] = ea.units.map(func(u): return [int(u["type"]), int(u["x"]), int(u["y"])])
		x.erase("enemy_pool")
		GM._trial_x[i] = x
		g._start_trial(i)
		g._build_ai()
		var e = g.armies[1].copy()
		var types: Array = RS.types_of(g.armies[0].pool)
		# ③ 爬山
		var found: Array = []
		var rng := RandomNumberGenerator.new()
		rng.seed = 880 + i
		for restart in 6:
			var w: int = [2, 5, 8, 0, 3, 6][restart]
			var cur: Array = rand_spec(types, g, rng)
			var cj := judge(g, cur, e)
			var cs := score(cj, w)
			for it in iters / 6:
				var c2: Array = mutate(cur, types, g, rng)
				var j2 := judge(g, c2, e)
				if bool(j2["won"]):
					found.append(j2)
				var s2 := score(j2, w)
				if s2 >= cs:
					cur = c2
					cj = j2
					cs = s2
		var out := {"i": i, "found": found.size(), "spec": x}
		if not found.is_empty():
			# ④ 前緣上挑「剩餘＋省下」最大的當三星解
			var pick: Dictionary = found[0]
			var bv := -99999
			for f in found:
				var v: int = int(f["rem"]) + (100 - int(f["pct"]))
				if v > bv:
					bv = v
					pick = f
			x["rem"] = maxi(5, int(pick["rem"]) / 5 * 5)
			x["spend"] = clampi(ceili(int(pick["spent"]) * 100.0 / g.armies[0].budget), 40, 100)
			x["best"] = pick["real"]
			out["pick"] = {"rem": pick["rem"], "pct": pick["pct"], "spent": pick["spent"]}
			out["spec"] = x
		print("TFORGE ", JSON.stringify(out))
	g.free()
	quit()
extends SceneTree
## 第十三輪：殘局量產。讀草稿（敵陣、固定兵、預算、可用兵種、目標），自動：
##   ① 什麼都不放會不會過 ② 隨機擺法過關率 ③ 多種子爬山收集所有過關解 → 前緣（花費少、剩餘多）
##   ④ 從前緣挑三星解並訂門檻 ⑤ 拿掉主角兵種還過不過 ⑥ 兩組不同的標準解 ⑦ 鄰格容錯 ⑧ 戰鬥長度
## 判定一律走 puzzles.gd 的 play()／outcome()，和遊戲同一套。
## godot --headless --path game --script res://tools/balance/puzzle_forge.gd -- --in=<草稿.json> [--id=x] [--iters=1600] [--seeds=3]
const P = preload("res://scripts/game/puzzles.gd")
const D = preload("res://scripts/core/unit_defs.gd")

var _cache := {}

func key_of(pz: Dictionary, ex: Array, plan: Array) -> String:
	var s: Array = ex.duplicate(true)
	s.sort()
	return pz["id"] + JSON.stringify(s) + JSON.stringify(plan)

func run(pz: Dictionary, ex: Array, plan: Array) -> Dictionary:
	var k := key_of(pz, ex, plan)
	if _cache.has(k):
		return _cache[k]
	var r := P.play(pz, ex, plan, false)
	_cache[k] = r
	return r

func legal(pz: Dictionary, ex: Array) -> bool:
	return P.check_extra(pz, ex) == ""

func random_extra(pz: Dictionary, allowed: Array, rng: RandomNumberGenerator, fill := 1.0) -> Array:
	var ex: Array = []
	var left: int = int(int(pz["budget"]) * fill)
	for k in 14:
		var t: int = allowed[rng.randi_range(0, allowed.size() - 1)]
		if D.cost(t) > left:
			continue
		for tries in 12:
			var c := [t, rng.randi_range(0, 5), rng.randi_range(0, 8)]
			var e2: Array = ex.duplicate(true)
			e2.append(c)
			if legal(pz, e2):
				ex = e2
				left -= D.cost(t)
				break
	return ex

func spent_of(ex: Array) -> int:
	var s := 0
	for e in ex:
		s += D.cost(int(e[0]))
	return s

func mutate(pz: Dictionary, ex: Array, allowed: Array, rng: RandomNumberGenerator) -> Array:
	for tries in 8:
		var e2: Array = ex.duplicate(true)
		var op := rng.randi_range(0, 4)
		if e2.is_empty():
			op = 3
		match op:
			0, 4:
				var i := rng.randi_range(0, e2.size() - 1)
				e2[i][1] = clampi(int(e2[i][1]) + rng.randi_range(-2, 2), 0, 5)
				e2[i][2] = clampi(int(e2[i][2]) + rng.randi_range(-2, 2), 0, 8)
			1:
				e2[rng.randi_range(0, e2.size() - 1)][0] = allowed[rng.randi_range(0, allowed.size() - 1)]
			2:
				e2.remove_at(rng.randi_range(0, e2.size() - 1))
			3:
				e2.append([allowed[rng.randi_range(0, allowed.size() - 1)], rng.randi_range(0, 5), rng.randi_range(0, 8)])
		if legal(pz, e2):
			return e2
	return ex

func mutate_plan(pz: Dictionary, plan: Array, rng: RandomNumberGenerator) -> Array:
	if plan.is_empty():
		return plan
	var p2: Array = plan.duplicate()
	var i := rng.randi_range(0, p2.size() - 1)
	var lim: int = int(pz.get("goal_ticks", 1800)) - 10
	p2[i] = clampi(int(p2[i]) + rng.randi_range(-12, 12) * 10, 60, lim)
	p2.sort()
	return p2

## 目標：先過關，再在「剩餘戰力」和「省錢」之間依 w 取捨。
func score(r: Dictionary, budget: int, w: int) -> int:
	if r.has("illegal"):
		return -100000000
	if not bool(r["ok"]):
		return -1000000 + int(r.get("ticks", 0))
	return 1000000 + int(r["rem"]) * (10 - w) * 10 - int(r["spent"]) * 100 * w * 10 / maxi(1, budget)

func climb(pz: Dictionary, allowed: Array, iters: int, seed_: int, found: Array) -> int:
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_
	var first := -1
	var evals := 0
	var budget: int = int(pz["budget"])
	for restart in 4:
		var w: int = [2, 5, 8, 0][restart]
		var cur := random_extra(pz, allowed, rng)
		var plan: Array = P.default_plan(pz)
		var r := run(pz, cur, plan)
		var cs := score(r, budget, w)
		for it in iters / 4:
			var c2: Array = cur
			var p2: Array = plan
			if not plan.is_empty() and rng.randi_range(0, 2) == 0:
				p2 = mutate_plan(pz, plan, rng)
			else:
				c2 = mutate(pz, cur, allowed, rng)
			var r2 := run(pz, c2, p2)
			evals += 1
			if bool(r2.get("ok", false)):
				found.append({"u": c2, "p": p2, "rem": int(r2["rem"]), "spent": int(r2["spent"]), "ticks": int(r2["ticks"])})
				if first < 0:
					first = evals
			var s2 := score(r2, budget, w)
			if s2 >= cs:
				cur = c2
				plan = p2
				cs = s2
	return first

## 前緣：沒有別的解同時更省又剩更多。
func frontier(found: Array) -> Array:
	var out: Array = []
	for a in found:
		var dom := false
		for b in found:
			if (int(b["spent"]) <= int(a["spent"]) and int(b["rem"]) >= int(a["rem"])) and (int(b["spent"]) < int(a["spent"]) or int(b["rem"]) > int(a["rem"])):
				dom = true
				break
		if not dom:
			var dup := false
			for o in out:
				if int(o["spent"]) == int(a["spent"]) and int(o["rem"]) == int(a["rem"]):
					dup = true
			if not dup:
				out.append(a)
	out.sort_custom(func(a, b): return int(a["spent"]) < int(b["spent"]))
	return out

func multiset(ex: Array) -> String:
	var t: Array = []
	for e in ex:
		t.append(int(e[0]))
	t.sort()
	return str(t)

func tolerance(pz: Dictionary, sol: Dictionary) -> int:
	var tot := 0
	var good := 0
	for i in sol["u"].size():
		for d in [[1, 0], [-1, 0], [0, 1], [0, -1]]:
			var ex: Array = sol["u"].duplicate(true)
			ex[i][1] = int(ex[i][1]) + d[0]
			ex[i][2] = int(ex[i][2]) + d[1]
			if not legal(pz, ex):
				continue
			tot += 1
			if bool(run(pz, ex, sol["p"]).get("ok", false)):
				good += 1
	return good * 100 / maxi(1, tot)

func forge(pz: Dictionary, iters: int, seeds: int) -> Dictionary:
	var allowed: Array = []
	for v in pz["allowed"]:
		allowed.append(int(v))
	var m := {}
	m["empty_ok"] = bool(run(pz, [], P.default_plan(pz)).get("ok", false))
	var rng := RandomNumberGenerator.new()
	rng.seed = 99
	var ok_n := 0
	for k in 120:
		if bool(run(pz, random_extra(pz, allowed, rng), P.default_plan(pz)).get("ok", false)):
			ok_n += 1
	m["rand_pct"] = ok_n * 100 / 120
	var found: Array = []
	var firsts: Array = []
	for s in seeds:
		firsts.append(climb(pz, allowed, iters, 1000 + s * 77, found))
	m["first"] = firsts
	m["found"] = found.size()
	if found.is_empty():
		return {"metrics": m}
	var fr := frontier(found)
	m["frontier"] = fr.map(func(f): return [f["spent"], f["rem"]])
	var budget: int = int(pz["budget"])
	var pick: Dictionary = fr[0]
	var bv := -99999
	for f in fr:
		var v: int = int(f["rem"]) + (budget - int(f["spent"])) * 100 / maxi(1, budget)
		if v > bv:
			bv = v
			pick = f
	var star3: int = int(pick["spent"])
	var star2: int = maxi(5, int(pick["rem"]) / 5 * 5)
	m["ticks"] = int(pick["ticks"])
	m["tol"] = tolerance(pz, pick)
	# 兩組標準解：三星解＋兵種組合不同的過關解（沒有就挑位置差最多的）
	var sols: Array = [pick["u"]]
	var plans: Array = [pick["p"]]
	var alt = null
	for f in found:
		if multiset(f["u"]) != multiset(pick["u"]):
			alt = f
			break
	if alt == null:
		for f in found:
			if JSON.stringify(f["u"]) != JSON.stringify(pick["u"]):
				alt = f
				break
	if alt != null:
		sols.append(alt["u"])
		plans.append(alt["p"])
	m["kinds"] = {}
	for f in found:
		m["kinds"][multiset(f["u"])] = true
	m["kinds"] = m["kinds"].size()
	# 主角必要：拿掉主角兵種再找一次
	if pz.has("unit") and allowed.size() > 1:
		var without: Array = allowed.filter(func(t): return t != int(pz["unit"]))
		var f2: Array = []
		climb(pz, without, iters / 2, 4242, f2)
		m["hero_free_ok"] = f2.size()
	var out := {"star2": star2, "star3": star3, "solutions": sols, "best": {"u": pick["u"], "p": pick["p"]}, "metrics": m}
	if pz.has("cmd"):
		out["sol_plans"] = plans
	return out

func _init() -> void:
	var args := {}
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--") and "=" in a:
			var kv := a.substr(2).split("=", true, 1)
			args[kv[0]] = kv[1]
	var drafts: Array = JSON.parse_string(FileAccess.get_file_as_string(str(args.get("in", ""))))
	var want := str(args.get("id", ""))
	var shard := int(args.get("shard", "0"))
	var shards := int(args.get("shards", "1"))
	for i in drafts.size():
		var pz: Dictionary = drafts[i]
		if (want != "" and pz["id"] != want) or (want == "" and i % shards != shard):
			continue
		pz["star2"] = 0
		pz["star3"] = 999
		var t0 := Time.get_ticks_msec()
		var res := forge(pz, int(args.get("iters", "1600")), int(args.get("seeds", "3")))
		res["id"] = pz["id"]
		res["ms"] = Time.get_ticks_msec() - t0
		print("FORGE ", JSON.stringify(res))
	quit()

