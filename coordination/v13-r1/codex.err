				if state == St.BATTLE and overlay == "":
					_toggle_pause()
				elif k == KEY_TAB:
					_move_focus(1)
			KEY_ESCAPE:
				if overlay == "ai_busy":
					pass      # 第十輪 I4：AI 計算中不能取消
				elif overlay != "":
					overlay = ""
