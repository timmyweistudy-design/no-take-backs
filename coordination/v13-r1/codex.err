# ── 對戰代碼 ──
func _copy_battle_code() -> void:
	var armies2: Array = rv_last if play_kind == "review" and not rv_last.is_empty() else last_armies
	DisplayServer.clipboard_set(BattleCode.encode(armies2[0], armies2[1], battle_rules, last_cmds))
	_toast(L.t("bc_copied"))

func _watch_battle_code() -> void:
	_watch_code_str(DisplayServer.clipboard_get())

## 手把：剪貼簿沒有代碼時改開 Steam 鍵盤；沒有 Steam 就提示（第七輪 N4）。
func _watch_code_str(code: String) -> void:
	var r := BattleCode.decode(code)
	if not r["ok"]:
		if code == DisplayServer.clipboard_get() and _ask_code(L.t("bc_watch"), _watch_code_str):
			return
		_toast(L.t("bc_bad"), true)
		return
	# 試玩版：對戰代碼裡有正式版才有的兵種就不播（Codex 實作審查 #2）
	if _demo():
		if r["rules"] != null and not r["rules"].map_id in Presets.DEMO_MAPS:
			_toast(L.t("bc_demo_locked"), true)
			return
		for a in [r["a0"], r["a1"]]:
			for u in a.units:
				if not RS.available(int(u["type"]), true):
					_toast(L.t("bc_demo_locked"), true)
					return
	if r["mismatch"]:
		_toast(L.t("bc_mismatch"))
	last_cmds = r.get("cmds", [])
	watch_code(r["a0"], r["a1"], r.get("rules"))

## 看一場對戰代碼：當成全新的一局初始化（Codex S5 #2：原本沿用舊的陣型、比分、局數）
func watch_code(a0, a1, p_rules = null) -> void:
	mode = Mode.VS_AI
	rules = p_rules
	battle_rules = p_rules
	ai_name = ""
	overlay = ""
	armies = [a0.copy(), a1.copy()]
	wins = [0, 0]
	round_no = 1
	series_over = false
	last_player_formation = []
	last_armies = [a0.copy(), a1.copy()]
	rv_last = []
	_begin_battle(a0.copy(), a1.copy(), "replay")
	watch_mode = true


# ── 覆盤 ──
var rv_fsel := -1   # 第六輪：自由陣型覆盤選中的那一隻（索引）

func _open_review() -> void:
	rv_orig = last_armies[0].copy()
	rv_army = last_armies[0].copy()
	rv_enemy = last_armies[1].copy()
	rv_fsel = -1
	if rv_orig.deploy == "free":
		# 編輯識別（和戰鬥編號分開，Codex 第一輪）：覆盤時每隻帶 eid，「只改一隻」依 eid 比
		for i in rv_orig.units.size():
			rv_orig.units[i]["eid"] = i
			rv_army.units[i]["eid"] = i
		# 全場：搬移時也要守敵距
		var ep: Array = []
		for u in rv_enemy.units:
			ep.append(Army.pos_of(u))
		if rv_orig.depth > rv_orig.fw / 2:
			rv_army.enemy_pos = ep
			rv_orig.enemy_pos = ep.duplicate()
	rv_sel = Vector2i(-1, -1)
	_rv_dirty()
	rv_base = review_run(rv_orig, rv_enemy, battle_rules, last_cmds)
	_open("review")

## 跟原本比改了幾隻（換兵種、移位、拿掉、新增都算一隻）。
static func review_changes(orig, now) -> int:
	if orig.deploy == "free":
		var ma := {}
		for u in orig.units:
			ma[int(u.get("eid", -1))] = [int(u["type"]), int(u["x"]), int(u["y"])]
		var n := 0
		var seen := {}
		for u in now.units:
			var e := int(u.get("eid", -1))
			seen[e] = true
			if not ma.has(e) or ma[e] != [int(u["type"]), int(u["x"]), int(u["y"])]:
				n += 1
		for e in ma:
			if not seen.has(e):
				n += 1
		return n
	var a := {}
	var b := {}
	for u in orig.units:
		a["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
	for u in now.units:
		b["%d,%d" % [u["col"], u["row"]]] = int(u["type"])
	var gone := 0
	var added := 0
	for k in a:
		if not b.has(k) or b[k] != a[k]:
			gone += 1
	for k in b:
		if not a.has(k) or a[k] != b[k]:
			added += 1
	return maxi(gone, added)

func _rv_try(edit: Callable) -> void:
	var before = rv_army.copy()
	edit.call()
	if review_changes(rv_orig, rv_army) > 1:
		rv_army = before
		_toast(L.t("rv_one"), true)
		return
	_rv_dirty()

func _rv_cell(c: Vector2i) -> void:
	if rv_sel.x >= 0 and rv_army.index_at(rv_sel.x, rv_sel.y) != -1 and rv_army.index_at(c.x, c.y) == -1:
		var from := rv_sel
		_rv_try(func(): rv_army.move(from.x, from.y, c.x, c.y))
		rv_sel = c
		return
	rv_sel = c

## 第六輪：自由陣型覆盤——點小戰場：點到兵就選它；選了之後點空地就搬過去。
func _rv_free_click(w: Vector2i) -> void:
	var hit: int = rv_army.index_near(w.x, w.y, 450)
	if hit >= 0:
		rv_fsel = hit
		return
	if rv_fsel < 0:
		return
	var trial = rv_army.copy()
	if not trial.move_xy(rv_fsel, trial.world_x(Army.quant(trial.own_x(w.x))), Army.quant(w.y)):
		_toast(L.t("err_zone"), true)
		return
	if review_changes(rv_orig, trial) > 1:
		_toast(L.t("rv_one"), true)
		return
	rv_army = trial
	_rv_dirty()

func _rv_free_set_type(t: int) -> void:
	if rv_fsel < 0 or rv_fsel >= rv_army.units.size():
		return
	var trial = rv_army.copy()
	var u: Dictionary = trial.units[rv_fsel]
	var p := Vector2i(int(u["x"]), int(u["y"]))
	trial.units.remove_at(rv_fsel)
	if t >= 0:
		trial.guard_combat = false
		if trial.check_place_xy(t, p.x, p.y) != "":
	for u in rv_orig.units:
		var i: int = rv_army.index_at(u["col"], u["row"])
		if i == -1:
			# 被移走或拿掉
			for v in rv_army.units:
				if rv_orig.index_at(v["col"], v["row"]) == -1 and int(v["type"]) == int(u["type"]):
					return L.t("rv_moved", [L.t("unit_%d" % int(u["type"])), int(u["row"]) + 1, int(u["col"]) + 1, int(v["row"]) + 1, int(v["col"]) + 1])
			return L.t("rv_removed", [L.t("unit_%d" % int(u["type"])), int(u["row"]) + 1, int(u["col"]) + 1])
		if int(rv_army.units[i]["type"]) != int(u["type"]):
			return L.t("rv_swapped", [L.t("unit_%d" % int(u["type"])), L.t("unit_%d" % int(rv_army.units[i]["type"])), int(u["row"]) + 1, int(u["col"]) + 1])
	for v in rv_army.units:
		if rv_orig.index_at(v["col"], v["row"]) == -1:
			return L.t("rv_added", [L.t("unit_%d" % int(v["type"])), int(v["row"]) + 1, int(v["col"]) + 1])
	return ""

## 重算「如果」：同一個對手、改過的陣型，用確定性模擬直接跑到結束。
static func review_run(a0, a1, p_rules = null, cmds: Array = []) -> Dictionary:
	var s = Sim.new(a0.copy(), a1.copy(), p_rules)
	if s.cmd_on:
		s.cmd_play(cmds)
	s.fast = true
	s.run_to_end()
	var rem := roundi(s.power(s.winner) * 100.0 / (s.budget_of(s.winner) * 1000)) if s.winner >= 0 else 0
	return {"winner": s.winner, "rem": rem, "log": s.power_log, "log2": s.power_log2, "b": [s.budget_of(0), s.budget_of(1)], "ticks": s.tick}

## 第七輪 M3：覆盤重算開背景執行緒（模擬是純計算），畫面不卡；算的時候按鈕不能再按（防重入）。
var rv_thread: Thread = null
var rv_gen := 0          # 陣型改一次加一；算完時世代不同就丟掉（Codex r1：舊陣型的結果不能配新陣型）
var rv_thread_gen := 0

func _rv_dirty() -> void:
	rv_result = {}
	rv_gen += 1

func _rv_recalc() -> void:
	if rv_thread != null:
		return
	if DisplayServer.get_name() == "headless" or shot_dir != "":
		rv_result = review_run(rv_army, rv_enemy, battle_rules, last_cmds)
		return
	var a: Variant = rv_army.copy()
	var e: Variant = rv_enemy.copy()
	var r: Variant = battle_rules.copy() if battle_rules != null else null
	rv_thread_gen = rv_gen
	rv_thread = Thread.new()
	var lg: Array = last_cmds.duplicate(true)
	rv_thread.start(func(): return review_run(a, e, r, lg))

func _rv_poll() -> void:
	if rv_thread != null and not rv_thread.is_alive():
		var res: Dictionary = rv_thread.wait_to_finish()
		rv_thread = null
		if rv_thread_gen == rv_gen:
			rv_result = res

func _rv_play() -> void:
	rv_last = [rv_army.copy(), rv_enemy.copy()]
	_replay_snapshot()
	replay_snap["overlay"] = "review"
	replay_marks = []
	overlay = ""
	_begin_battle(rv_army.copy(), rv_enemy.copy(), "review")

func _draw_review() -> void:
	# 第五輪 §4.4：左＝自己的部署區（可改）＋紅方站位（半透明參考）；右＝換兵按鈕（標價）、重算、兩條上下對齊的戰力走勢。
	_panel(Rect2(100, 60, 1080, 680))
	_h1(Vector2(640, 62), L.t("rv_title"))
	_text(Vector2(640, 70 + tz("H1") * 1.3), L.t("rv_hint_free" if rv_orig.deploy == "free" else "rv_hint"), tz("S"), Color(1, 1, 1, 0.75), true, false, 960)
	var cs := 40.0
	var g0 := Vector2(130, 168)
	_text(g0 - Vector2(0, tz("C") * 1.5), L.t("rv_you_free" if rv_orig.deploy == "free" else "rv_you"), tz("C"), Charts.team_col(0, cbm()), false, true, 236)   # 不壓到右邊「對手站位」
	# 第五輪：紀錄分欄。平衡認證的規則（或沒有規則的模式）＝標準戰績；其他自訂規則記在自訂戰績；沙盒什麼都不記。
	var kind := "duel" if mode == Mode.DUEL else "ai"
	var badge: String = Presets.badge(rules, kind) if rules != null else Presets.BADGE_CERT
	if badge == Presets.BADGE_LAB:
		_save()
		return
	var standard: bool = rules == null or Presets.is_standard_record(rules, kind)
	if free_intro:
		Save.data["free_intro_done"] = true
		free_intro = false
	Save.data["unlock_games"] = int(Save.data.get("unlock_games", 0)) + 1   # 只是累計場數（判斷新玩家用），不解鎖任何東西
	var me_won := w == 0 or (mode == Mode.DUEL and w >= 0)
	var stat_key := "stats" if standard else "custom_stats"
	var st: Dictionary = Save.data.get(stat_key, {"wins": 0, "games": 0})
	st["games"] = int(st.get("games", 0)) + 1
	if w == 0 and mode != Mode.DUEL:
		st["wins"] = int(st.get("wins", 0)) + 1
	Save.data[stat_key] = st
	_v8_achievements(w)   # 奇幻軍是娛樂變體，要放在「自訂規則提前返回」之前（Codex 第 3 輪）
	# 圖鑑老兵筆記：派這個兵種贏一場 +1（第二輪方案 R3）。第十輪 B4：自訂規則、奇幻軍也算（放在提前返回之前）
	var types := {}
	if me_won:
		for u in sim.units:
			if u.team == w:
				types[D.report_type(u.type)] = true
		CX.record_win(Save.data, types.keys())
	if not standard:
		# 自訂規則專屬成就（標準成就只看標準局）
		if me_won and mode == Mode.VS_AI and w == 0:
			if rules.budget_of(0) <= 50:
				_ach("CUSTOM_LOWGOLD")
			if rules.budget_of(0) < rules.budget_of(1):
				_ach("CUSTOM_UNDERDOG")
		if me_won and rules.unit_cap >= 36:
			_ach("CUSTOM_BIG")
		_save()
		return
	if me_won:
		_ach("FIRST_WIN")
		if sim.alive_count(w) == 1:
			_ach("LONE_HERO")
		if int(report["sus"]["max_swing_pct"]) >= 15:
			_ach("COMEBACK")
		if sim.power(w) * 100 / (sim.budget * 1000) <= 5:
			_ach("CLOSE_CALL")
		if sim.tick >= Sim.FRENZY_TICK:
			_ach("FRENZY_WIN")
		if types.size() == 5:
			_ach("ALL_TYPES")
		if int(ev_count.get("charge%d" % w, 0)) >= 5:
			_ach("CHARGE_5")
		if int(ev_count.get("backstab%d" % w, 0)) >= 3:
			_ach("BACKSTAB_3")
	if mode == Mode.VS_AI and w == 0 and difficulty == 2:
		_ach("HARD_WIN")
	if mode == Mode.DUEL and tp != null and series_over:
		_ach("NO_TAKEBACKS")
	if series_over and ((mode == Mode.DUEL and (wins == [2, 0] or wins == [0, 2])) or (mode == Mode.VS_AI and wins == [2, 0])):
		_ach("SWEEP")
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
		var stars := int(report.get("stars", 0))
		var ps: Dictionary = Save.data.get("puzzle_stars", {})
		if stars > int(ps.get(puzzle_id, 0)):
			ps[puzzle_id] = stars
		Save.data["puzzle_stars"] = ps
		if mode == Mode.TUTORIAL and w == 0:
			var idx := 0
			for i in PZ.tutorials().size():
				if PZ.tutorials()[i]["id"] == puzzle_id:
					idx = i
			Save.data["tutorial"] = maxi(int(Save.data.get("tutorial", 0)), idx + 1)
			if int(Save.data["tutorial"]) >= PZ.tutorials().size():
				_ach("TUTORIAL")
		if stars == 3:
			_ach("PUZZLE_3STAR")
		var all_done := true
		for p in PZ.puzzles():
			if int(ps.get(p["id"], 0)) == 0:
				all_done = false
		if all_done:
			_ach("PUZZLE_ALL")
		var cleared := 0
		var perfect := 0
		for p2 in PZ.all_puzzles():
			cleared += 1 if int(ps.get(p2["id"], 0)) > 0 else 0
			perfect += 1 if int(ps.get(p2["id"], 0)) >= 3 else 0
	elif mode == Mode.VS_AI or mode == Mode.GAUNTLET:
		kind = "ai"
	return RS.ntypes_for(kind, classic, _demo())



## 第五輪：這一場的卡池遮罩（R1 前＝前 N 種）。
func _pool() -> int:
	if rules != null:
		return rules.pool_of(0)
	if mode == Mode.GAUNTLET:
		return _gauntlet_pool()
	return RuleSet.prefix_pool(_ntypes())



func _allowed(t: int) -> bool:
	if rules != null and (mode == Mode.VS_AI or mode == Mode.DUEL):
		return RuleSet.has(_cur_army().pool, t)
	if mode == Mode.GAUNTLET:
		return RuleSet.has(_gauntlet_pool(), t)
	if t >= _ntypes() and (t < D.COUNT or not (mode == Mode.TUTORIAL or mode == Mode.PUZZLE)):
		return false
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE:
		for x in PZ.get_puzzle(puzzle_id)["allowed"]:
			if int(x) == t:
				return true
		return false
	return true



## 遠征的出戰名單（第八輪）：上次對 AI 用的名單，拿掉沒解鎖的；沒有就是解鎖的舊兵。
func _gauntlet_pool() -> int:
	var base := RuleSet.prefix_pool(_ntypes())
	# 第八輪：開打前在「遠征用哪支軍隊」選的，整趟沿用；存檔被改壞就當沒選
	var chosen = Save.data.get("gauntlet_pool", 0)
	if (chosen is int or chosen is float) and int(chosen) > 0:
		var cp: int = int(chosen) & RS.mask(_demo())
		if RuleSet.has_combat(cp) and RuleSet.pool_count(cp) <= RuleSet.ROSTER_MAX:
			return cp
func _mb_cmd(d: Dictionary) -> void:
	var mb := InputEventMouseButton.new()
	mb.button_index = d["i"]
	mb.pressed = d["pressed"]
	mb.position = d["pos"]
	mouse = d["pos"]
	if mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
		if _do_click(mouse) > 0:
			_mb_release_cleanup()
			return
	if state == St.PLACE and overlay == "" and _fp_mb(d):
		return   # 第六輪：自由排兵處理掉了
	if overlay != "" or state != St.PLACE:
		if not mb.pressed:   # 放開滑鼠一定要清掉拖曳／塗兵狀態，即使上面蓋著覆蓋層
			_mb_release_cleanup()
			if overlay == "" and state == St.BATTLE and mb.button_index == MOUSE_BUTTON_LEFT:
				_battle_click(mouse)   # 重播時點兵讓鏡頭跟（第三輪 F2）
		return
	var c := _cell_at(mouse)
	if mb.button_index == MOUSE_BUTTON_LEFT and mb.pressed:
		var k := _card_at(mouse)
		if k >= 0 and _card_help_rect(k).has_point(mouse):
			return   # 放開時由「?」按鈕處理
		if k >= 0:
			if _allowed(k):
				selected = k
				drag_new = true
				sfx.play("k_click", 0.7)
			else:
				_toast(L.t("err_type"), true)
			return
		if c.x < 0:
			return
		if _can_edit_existing() and _cur_army().index_at(c.x, c.y) != -1:
			if (mode == Mode.TUTORIAL or mode == Mode.PUZZLE) and PZ.is_fixed(PZ.get_puzzle(puzzle_id), c.x, c.y):
				_toast(L.t("err_locked"), true)
				return
			drag_from = c
		else:
			painting = true
			paint_team = _cur_army().team
			_try_place(c)
	elif mb.button_index == MOUSE_BUTTON_LEFT and not mb.pressed:
		if drag_new and c.x >= 0:
			_try_place(c)
		elif drag_from.x >= 0:
			if c.x < 0:
				_try_remove(drag_from)
			elif c != drag_from:
				if mode == Mode.GAUNTLET and gauntlet_stage > 1 and _gauntlet_diff() >= gauntlet_changes:
					_toast(L.t("err_changes"), true)
				elif not _cur_army().move(drag_from.x, drag_from.y, c.x, c.y):
					_toast(L.t("err_zone"), true)
				else:
					sfx.play("place_light")
		drag_new = false
		painting = false
		drag_from = Vector2i(-1, -1)
	elif mb.button_index == MOUSE_BUTTON_RIGHT and mb.pressed and c.x >= 0:
		_try_remove(c)



