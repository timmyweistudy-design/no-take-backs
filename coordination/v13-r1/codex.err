	var pr = _puzzle_rules()
	if pr != null and pr.map_id != 0:
		return pr
	return null

## 這關要護送／斬首的單位：[模擬 id, "protect"／"kill"]，沒有回 [-1, ""]。
func _goal_mark() -> Array:
	if mode != Mode.PUZZLE or puzzle_id == "":
		return [-1, ""]
	var pz := PZ.get_puzzle(puzzle_id)
	var g := PZ.goal(pz)
	if g != "protect" and g != "kill":
		return [-1, ""]
	var c: Array = pz["goal_unit"]
	var team := 0 if g == "protect" else 1
	return [team * 1000 + int(c[1]) * 16 + int(c[0]), g]

## 依這一場的規則同步場地。每幀畫面開頭呼叫。
func _sync_field() -> void:
	var r = _field_rules()
	var m: int = r.map_id if r != null else 0
	var z: int = r.map_size if r != null else MapDefs.STD_SIZE
	if m == fld_map and z == fld_sz:
		return
	fld_map = m
	fld_sz = z
	fld_w = MapDefs.width(z)
	fld_h = MapDefs.height(z)
	fld_size = Vector2(fld_w / 1000.0 * CS, fld_h / 1000.0 * CS)
	fld_props = MapArt.props(m, z)
	_map_tex()   # 一換圖就先烘，開場那幾格才看得到地形

## 把場地放進固定的戰場框：等比容納，置中留邊。
func _fld_xf() -> Transform2D:
	if fld_sz == MapDefs.STD_SIZE:
		return Transform2D.IDENTITY
	var k: float = minf(FIELD.x / fld_size.x, FIELD.y / fld_size.y)
	return Transform2D(0.0, Vector2(k, k), 0.0, ORIGIN + (FIELD - fld_size * k) / 2.0 - ORIGIN * k)

func _map_tex() -> Texture2D:
	if map_art == null:
		map_art = MapArt.new()
		add_child.call_deferred(map_art)
		return null
	if fld_map == 0:
		return null
	if not map_art.is_inside_tree():
		return null
	return map_art.texture(fld_map, fld_sz)
const CARD_Y := 694.0
const CARD_W := 80.0     # 第四輪：一排 10 張窄卡（方案 D），起點 x＝CARD_X0
const CARD_X0 := 12.0
const CARD_GAP := 6.0
const CARD_H := 96.0
const UI_BG := Color(0.11, 0.08, 0.06, 0.95)
## 第八輪上層：巫毒連線、大招前搖、時停減傷。
func _draw_v8_top(s, u, p: Vector2) -> void:
	if u.type == F8.DOLL and u.link >= 0 and u.link < s.units.size() and s.units[u.link].alive:
		var q := _upos(s.units[u.link])
		var col := Color(1.0, 0.42, 0.7, 0.55 + 0.2 * sin(time * 6.0))
		draw_dashed_line(p + Vector2(0, -26), q + Vector2(0, -26), Color(1.0, 0.7, 0.9, 0.3), 4.5, 7.0)
		draw_dashed_line(p + Vector2(0, -26), q + Vector2(0, -26), col, 2.0, 7.0)
	if u.windup > 0:
		var k := 1.0 - float(u.windup) / F8.WINDUP
		var rc := Color("#ffe08a") if u.type == F8.SPRITE else (Color("#c77dff") if u.type == F8.BONE else (Color("#9ad1ff") if u.type == F8.CAT else Color("#d9c9a3")))
		draw_arc(p + Vector2(0, -24), 26.0, -PI / 2, -PI / 2 + TAU * k, 28, Color(Art.OUT, 0.7), 5.0, true)
		draw_arc(p + Vector2(0, -24), 26.0, -PI / 2, -PI / 2 + TAU * k, 28, rc, 3.0, true)
	if u.guard > 0:
		draw_arc(p + Vector2(0, -24), 20.0, 0, TAU, 24, Color(1.0, 0.88, 0.5, 0.65), 2.5, true)



## 這隻兵附近（60px 內）有幾隻活著的兵，不算自己。
func _crowd_at(u) -> int:
	var n := 0
	var p := _upos(u)
	for v in view.units:
		if v.alive and v.id != u.id and _upos(v).distance_squared_to(p) < 3600.0:
			n += 1
	return n



## 暫停時點一隻兵看狀態（第七輪 A6）。
func _draw_unit_info() -> void:
	if not paused or follow_id < 0 or view == null:
		return
	var u = view.unit_by_id(follow_id)
	if u == null:
		return
	var tname := L.t("ui_none")
	if u.target >= 0 and u.target < view.units.size() and view.units[u.target].alive:
		tname = L.t("unit_%d" % view.units[u.target].type)
	var lines: Array = [
		"%s（%s）" % [L.t("unit_%d" % u.type), L.t("blue") if u.team == 0 else L.t("red")],
		L.t("ui_hp", [u.hp, u.max_hp]),
		L.t("ui_target", [tname]),
		L.t("ui_cd", ["%.1f" % (u.cd / 80.0)]),
		L.t("ui_stats", [u.dmg_dealt, u.kills]),
	]
	var R := Rect2(980, 96, 286, 16 + lines.size() * tz("S") * 1.4)
	draw_rect(R, Color(TH_WOOD_D, 0.94))
	draw_rect(R, Color(Art.team_color(u.team, cbm()), 0.9), false, 2.0)
	for i in lines.size():
		_text(R.position + Vector2(10, 8 + i * tz("S") * 1.4), lines[i], tz("S"), Color.WHITE, false, i == 0, 266)



func _update_action_focus() -> void:
	var sum := Vector2.ZERO
	var n := 0
	for u in view.units:
		if u.alive and ((hurt_t.has(u.id) and time - hurt_t[u.id] < 0.8) or (atk_t.has(u.id) and time - atk_t[u.id] < 0.8)):
			sum += _upos(u)
			n += 1
	action_focus = sum / n if n > 0 else zoom_center



func _draw_field() -> void:
	var free_f: bool = rules != null and rules.is_free() and (mode == Mode.VS_AI or mode == Mode.DUEL)   # 第六輪：自由排兵不畫格子
	var fbi: Dictionary = MapArt.BIOME.get(MapDefs.MAPS[fld_map]["biome"], {})
	if fld_map != 0:
		MapArt.draw_outfield(self, Rect2(ORIGIN, FIELD), str(MapDefs.MAPS[fld_map]["biome"]))
	draw_rect(Rect2(ORIGIN - Vector2(10, 10), fld_size + Vector2(20, 20)), Color(fbi.get("frame", "#5b4632")))
	if fld_map != 0:
		var mt := _map_tex()
		if mt != null:
			draw_texture_rect(mt, Rect2(ORIGIN, fld_size), false)
		else:
			draw_rect(Rect2(ORIGIN, fld_size), Color(fbi.get("base", "#6f9a4a")))
		if rules != null and rules.time_of != 0:
			draw_rect(Rect2(ORIGIN, fld_size), _tone())
		_draw_field_frame()
		return
	var f_rows: int = fld_h / 1000
extends "res://scripts/ui/lobby_view.gd"
## 第六輪：自由排兵的操作與畫面（docs/2026-11-03-free-placement-plan-v6.md §4）。格子模式完全不經過這裡。
##   滑鼠：點空地＝放一隻；在空地按住拖＝畫筆（放開才確定，右鍵／Esc 取消）；Shift＝直線；在兵上按住拖＝搬它；
##        Ctrl 拖＝框選，之後拖選取的任一隻＝整群剛體平移；右鍵點／拖＝刪除；Delete 刪選取、M 上下翻轉；G 對齊；Ctrl+Z／Y。
##   手把：左搖桿平滑游標、十字鍵 0.5 格、A 放（按住＝畫筆）、X 清除（按住連續）、Y 畫筆／直線、L3 對齊、R3 緊密／標準、B 取消。
##   觸控：Godot 會把觸控轉成滑鼠；觸控時預覽點畫在手指上方 40px（手指會遮住）。

const PICK_R := 350            # 點選既有兵的半徑（小於最小間距的一半，Antigravity 第二輪）
const TOUCH_LIFT := 40.0

var fp_tool := "brush"         # brush／line／select
var fp_snap := false           # 工具列的「對齊」常駐開關（按住 G＝暫時）
var fp_dense := true           # 畫筆間距：true＝最小間距、false＝1.0 格
var fp_stroke: Array = []      # 預覽中的點 [type, x, y]
var fp_stroking := false
var fp_line := false           # 這一筆是直線
var fp_start := Vector2i.ZERO  # 直線起點（世界座標）
var fp_last := Vector2i.ZERO   # 畫筆上一個取樣點
var fp_full := false           # 錢／人數／這一手用完（後面的點截斷）
var fp_full_why := ""
var fp_fine := false           # 畫筆上一點放不下，改小步找          # gold／cap／hand
var fp_zone_key := -1          # 敵兵禁區點陣的快取鍵
var fp_zone_rects: Array = []
var fp_gesture_at := -1.0      # 新手手勢開始的時間（−1＝不播）
var fp_probe = null            # 預覽用的軍隊副本
var fp_drag := -1              # 正在搬的那一隻
var fp_drag_from := Vector2i.ZERO
