func _enemy_visible() -> bool:
	if mode == Mode.TUTORIAL or mode == Mode.PUZZLE or mode == Mode.GAUNTLET:
		return true
	if mode == Mode.DUEL:
		return tp != null
	return false



func _ai_pool(r: RandomNumberGenerator) -> int:
	var p1: int = rules.pool_of(1) if rules != null else _pool()
	if rules != null and rules.ai_style != 0:
		p1 = AI.style_pool(p1, rules.ai_style, r)
	return p1

## 第十輪 I4：困難 AI 第二局起要模擬候選陣型，放背景算，畫面不凍住。回傳 true＝已交給背景。
func _build_ai_async() -> bool:
	if not _async_ok() or difficulty != 2 or round_no <= 1 or get("challenge_army") != null:
		return false
	var r := RandomNumberGenerator.new()
	r.seed = rng.randi()
	var p1: int = _ai_pool(r)
	var known: Array = last_player_formation.duplicate(true)
	var lib: Array = _counter_lib()
	var rr = rules.copy() if rules != null else null
	ai_thread = Thread.new()
	ai_thread.start(func(): return HardAI.build(known, lib, r, p1, rr))
	overlay = "ai_busy"
	return true

func _ai_poll() -> void:
	if ai_thread == null or ai_thread.is_alive():
		return
	armies[1] = ai_thread.wait_to_finish()
	ai_thread = null
	ai_name = L.t("diff_hard")
	overlay = ""
	call("_on_start_go")

## 組 AI 的陣型（第六輪：明牌全場時在擺放開始就組好）。
func _build_ai() -> void:
	if get("challenge_army") != null:
		armies[1] = get("challenge_army").copy()     # 挑戰碼：對手就是朋友排好的陣
		ai_name = L.t("ch_name")
		return
	var tid = get("trial_id")
	if tid != null and int(tid) >= 0:
		var te = call("_trial_enemy")   # 第十三輪：新試煉是固定敵陣
		if te != null:
			armies[1] = te
			ai_name = call("trial_name", int(tid))
			return
	if true:
		var r := RandomNumberGenerator.new()
		r.seed = rng.randi()
		var p1: int = _ai_pool(r)
		match difficulty:
			0:
				armies[1] = AIT.build_full(1, r, 0, [], p1, rules)
				ai_name = L.t("diff_easy")
			1:
				var res = AI.build(1, rules.budget_of(1) if rules != null else 100, r, -1, p1, rules)
				armies[1] = res["army"]
				ai_name = "%s・%s" % [L.t("diff_normal"), res["name"]]
			_:
				armies[1] = _hard_ai(r, p1)
				ai_name = L.t("diff_hard")



## 困難 AI：第 1 局沒有資訊，用會讀對方的落子 AI 自己組；之後讀你上一局的陣型，
## 先查離線反制庫（組成最接近的原型），查不到就用啟發式反制。不偷看你這一局。
func _hard_ai(r: RandomNumberGenerator, pool: int) -> Army:
	# 第四輪：候選陣型各和你上一局的陣型模擬一場，挑最好的（scripts/core/hard_ai.gd）
	var known: Array = last_player_formation if round_no > 1 else []
	return HardAI.build(known, _counter_lib(), r, pool, rules)



func _counter_lib() -> Array:
	if not FileAccess.file_exists("res://data/counter_lib.json"):
		return []
	return counter_lib_entries(JSON.parse_string(FileAccess.get_file_as_string("res://data/counter_lib.json")))



## 反制庫版本檢查（第三輪 A3）：規則版本或數值摘要對不上就不用（退回啟發式），避免用到過期的反制。
static func counter_lib_entries(p) -> Array:
	if not p is Dictionary:
		return []
	if str(p.get("rules", "")) != D.RULES_VERSION or str(p.get("digest", "")) != D.data_digest():
		push_warning("counter_lib.json 的規則版本或數值摘要和遊戲不同，困難 AI 改用啟發式")
		return []
	var e = p.get("entries", [])
	return e if e is Array else []







## 即時模式按鈕：每幀重新登記，滑鼠或焦點都能按。
## V9 P5 按鈕：圓角木牌、上緣高光、下緣陰影；按下縮一點回彈、懸停亮、焦點金框；主按鈕有流光。
func _btn(r: Rect2, label: String, action: Callable, enabled := true, primary := false, tint := Color(0, 0, 0, 0)) -> void:
	var idx := _btns.size()
	_btns.append({"r": r, "cb": action, "en": enabled, "snd": "k_confirm" if primary else ("k_back" if label == L.t("back") or label == L.t("menu") else "k_click")})
	var hover := r.has_point(mouse) and not pad_mode
	var focus := pad_mode and idx == _focus
	var bg := TH_WOOD_L if not primary else TH_PRIMARY
	if tint.a > 0:
		bg = tint
	if not enabled:
		bg = Color(0.2, 0.17, 0.15)
	elif hover or focus:
		bg = bg.lightened(0.16)
		if hover:
			_hover_now = idx
	var pressed := hover and enabled and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
	var rd := r.grow(-minf(r.size.x, r.size.y) * 0.025) if pressed else r
	_box(rd, bg, TH_EDGE.darkened(0.25) if tint.a <= 0.0 or tint.a > 0.6 else Color(0, 0, 0, 0), 7.0, 1.5)
	if tint.a <= 0.0 or tint.a > 0.6:
		draw_line(rd.position + Vector2(6, 1.5), rd.position + Vector2(rd.size.x - 6, 1.5), Color(1, 1, 1, 0.16), 1.5)
		draw_line(rd.position + Vector2(6, rd.size.y - 1.5), rd.end - Vector2(6, 1.5), Color(0, 0, 0, 0.3), 2.0)
	if primary and enabled:
		_btn_shine(rd)
	if focus:
		_box(rd.grow(1), Color(0, 0, 0, 0), ACCENT, 8.0, 3.0)
	if layout_probe:
		probe_btns.append(r)
		if label == "":
			probe_ctrls.append(r)   # 空白標籤的按鈕（卡片、頁籤）：裡面自己畫的字算按鈕內容
	var sz := fit(label, ts(18) if r.size.y >= 40 else ts(15), r.size.x - 10, primary)
	var lines := wrap_lines(label, sz, r.size.x - 10, primary)
	var h := lines.size() * sz * line_h(lines.size())
	_probe_btn_label = true   # 版面檢查：這段是按鈕自己的標籤（不用位置猜，Antigravity 實作第 2 輪抓到猜錯的情況）
	_probe_btn_rect = r
	_text(r.get_center() - Vector2(0, h / 2 - sz * 0.03), "\n".join(lines), sz, Color.WHITE if enabled else Color(1, 1, 1, 0.4), true, primary)
	_probe_btn_label = false

